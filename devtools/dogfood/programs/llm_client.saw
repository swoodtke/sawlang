// A small LLM chat client for an OpenAI-compatible server (LM Studio-style):
// GET /v1/models and POST /v1/chat/completions, HTTP/1.1 over a plain TCP
// socket, JSON both ways. This is the Saw port of
// devtools/dogfood/programs/llm_client.py, covering its non-interactive,
// non-tool subset (design 215 stages A-C): one-shot chat, --list-models,
// model auto-pick, --stream, and the flag surface that does not need a
// tool loop or a REPL.
//
// Out of scope on purpose: the interactive REPL and slash commands,
// --tools/--allow-writes and the tool layer, and --timeout (std.net has no
// read deadline yet, so a hung server hangs this client rather than timing
// out — this is where a per-call deadline would plug in if std grew one).
//
// Saw has no std.json, so both directions are hand-rolled here: outbound
// strings are escaped per RFC 8259, and inbound JSON is read with an
// anchored scan (find "choices", then "message"/"delta", then "content")
// rather than a general parser, which is enough for this envelope shape.

import std.net.{TcpStream, IoError}
import std.data.*
import std.env.{Env}
import std.file
import std.path.{Path}

// =============================================================================
// Errors
// =============================================================================

struct ClientError { message: String }

extension ClientError: Printable {
    func format(&self, into: &var StringBuilder) { try! into.append(self.message) }
}

extension ClientError: Error {}

// =============================================================================
// JSON — outbound (escaping) and inbound (anchored scan)
// =============================================================================

// Encodes one Unicode scalar as the \u00XX escape's hex digit at nibble
// value `n` (0..15), returned as the scalar of the ASCII hex character.
func hex_digit_scalar(n: Int) -> Int {
    if n < 10 { return 48 + n }
    return 87 + n
}

// Appends `s` to `b` as a double-quoted, RFC 8259-escaped JSON string.
// Bytes >= 0x80 pass through as UTF-8: `chars()` decodes the source string's
// scalars and `append_scalar` re-encodes each one, which is the identity on
// the valid-UTF-8 domain a `String` already guarantees.
func append_json_string(b: &var StringBuilder, s: String) {
    try! b.append("\"")
    for ch in s.chars() {
        if ch == 34 {
            try! b.append("\\\"")
        } else if ch == 92 {
            try! b.append("\\\\")
        } else if ch == 10 {
            try! b.append("\\n")
        } else if ch == 13 {
            try! b.append("\\r")
        } else if ch == 9 {
            try! b.append("\\t")
        } else if ch == 8 {
            try! b.append("\\b")
        } else if ch == 12 {
            try! b.append("\\f")
        } else if ch < 0x20 {
            try! b.append("\\u00")
            let _ = try! b.append_scalar(scalar: hex_digit_scalar(ch / 16))
            let _ = try! b.append_scalar(scalar: hex_digit_scalar(ch % 16))
        } else {
            let _ = try! b.append_scalar(scalar: ch)
        }
    }
    try! b.append("\"")
}

// Finds the first occurrence of `needle` in `s` at or after `from`, or
// `None`. Saw's String has no built-in substring search, so this is the
// hand-rolled scan every other lookup below is built on.
func find_sub(s: String, needle: String, from: Int) -> Int? {
    let n = s.len()
    let m = needle.len()
    if m == 0 { return from }
    if from > n - m { return None }
    var i = from
    while i + m <= n {
        var j = 0
        var ok = true
        while j < m {
            if s.byte_at(i + j) != needle.byte_at(j) {
                ok = false
                break
            }
            j += 1
        }
        if ok { return i }
        i += 1
    }
    return None
}

// Advances past ASCII whitespace and (optionally) a single JSON ':'.
func skip_ws_colon(s: String, from: Int) -> Int {
    var j = from
    let n = s.len()
    while j < n {
        let b = s.byte_at(j)
        if b == 32 || b == 9 || b == 10 || b == 13 || b == 58 {
            j += 1
        } else {
            break
        }
    }
    return j
}

func skip_ws(s: String, from: Int) -> Int {
    var j = from
    let n = s.len()
    while j < n {
        let b = s.byte_at(j)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            j += 1
        } else {
            break
        }
    }
    return j
}

func hex_value(b: Int) -> Int? {
    if b >= 48 && b <= 57 { return b - 48 }
    if b >= 97 && b <= 102 { return b - 97 + 10 }
    if b >= 65 && b <= 70 { return b - 65 + 10 }
    return None
}

// Reads exactly 4 hex digits starting at `at`, returning (value, next).
func parse_hex4(s: String, at: Int) -> (Int, Int)? {
    if at + 4 > s.len() { return None }
    var v = 0
    var j = 0
    while j < 4 {
        guard let d = hex_value(s.byte_at(at + j) as Int) else { return None }
        v = v * 16 + d
        j += 1
    }
    return (v, at + 4)
}

// Parses a JSON string literal starting exactly at the opening quote,
// unescaping `\" \\ \/ \n \r \t \b \f` and `\uXXXX` (including surrogate
// pairs — the only way a plain ASCII string can carry an emoji). Runs of
// unescaped bytes are copied out with `substring`, which stays UTF-8-safe
// because the cut points are always the ASCII '"' or '\' bytes.
func parse_json_string(s: String, start: Int) -> (String, Int)? {
    let n = s.len()
    if start >= n || s.byte_at(start) != 34 { return None }
    var i = start + 1
    var run_start = i
    var out = StringBuilder()
    while i < n {
        let b = s.byte_at(i)
        if b == 34 {
            if i > run_start { try! out.append(s.substring(run_start, i)) }
            return (out.build(), i + 1)
        }
        if b == 92 {
            if i > run_start { try! out.append(s.substring(run_start, i)) }
            i += 1
            if i >= n { return None }
            let e = s.byte_at(i)
            if e == 34 {
                try! out.append("\"")
                i += 1
            } else if e == 92 {
                try! out.append("\\")
                i += 1
            } else if e == 47 {
                try! out.append("/")
                i += 1
            } else if e == 110 {
                try! out.append("\n")
                i += 1
            } else if e == 114 {
                try! out.append("\r")
                i += 1
            } else if e == 116 {
                try! out.append("\t")
                i += 1
            } else if e == 98 {
                let _ = try! out.append_scalar(scalar: 8)
                i += 1
            } else if e == 102 {
                let _ = try! out.append_scalar(scalar: 12)
                i += 1
            } else if e == 117 {
                i += 1
                guard let (cp, ni) = parse_hex4(s, i) else { return None }
                i = ni
                if cp >= 0xD800 && cp <= 0xDBFF {
                    if i + 1 < n && s.byte_at(i) == 92 && s.byte_at(i + 1) == 117 {
                        guard let (cp2, ni2) = parse_hex4(s, i + 2) else { return None }
                        if cp2 >= 0xDC00 && cp2 <= 0xDFFF {
                            let scalar = 0x10000 + ((cp - 0xD800) * 0x400) + (cp2 - 0xDC00)
                            let _ = try! out.append_scalar(scalar: scalar)
                            i = ni2
                        } else {
                            return None
                        }
                    } else {
                        return None
                    }
                } else if cp >= 0xDC00 && cp <= 0xDFFF {
                    return None
                } else {
                    let _ = try! out.append_scalar(scalar: cp)
                }
            } else {
                return None
            }
            run_start = i
        } else {
            i += 1
        }
    }
    return None
}

// Extracts EVERY string value of `"key": "..."` in `obj`, in order. Used
// for /v1/models' `"id"` fields.
func extract_all(obj: String, key: String) -> Result<Vector<String>, ClientError> {
    let needle: String = "\"{key}\""
    var out: Vector<String> = []
    var pos = 0
    var found = find_sub(obj, needle, pos)
    while let idx = found {
        let value_at = skip_ws_colon(obj, idx + needle.len())
        if let parsed = parse_json_string(obj, value_at) {
            try! out.push(parsed.0)
            pos = parsed.1
        } else {
            pos = idx + needle.len()
        }
        found = find_sub(obj, needle, pos)
    }
    return move out
}

// The one non-generic scan this client actually needs: a chat-completion
// envelope's reply text, reached through "choices" -> "message" (non-stream)
// or "delta" (stream) -> "content". Anchoring on "choices" first (and only
// searching onward from there) is what keeps a decoy "content" key planted
// earlier in the envelope from being mistaken for the reply. `None` means
// "no content on this object" (an empty `choices`, a null content, or a
// usage-only frame) rather than an error — the caller decides whether that
// is fine.
func extract_content(obj: String) -> String? {
    let choices_key: String = "\"choices\""
    guard let choices_idx = find_sub(obj, choices_key, 0) else { return None }
    let after_choices = skip_ws_colon(obj, choices_idx + choices_key.len())
    if after_choices >= obj.len() || obj.byte_at(after_choices) != 91 { return None }
    let after_bracket = skip_ws(obj, after_choices + 1)
    if after_bracket < obj.len() && obj.byte_at(after_bracket) == 93 { return None }

    let message_key: String = "\"message\""
    let delta_key: String = "\"delta\""
    let message_idx = find_sub(obj, message_key, choices_idx)
    let delta_idx = find_sub(obj, delta_key, choices_idx)
    var holder_idx: Int? = None
    var holder_len = 0
    if let mi = message_idx {
        holder_idx = mi
        holder_len = message_key.len()
    }
    if let di = delta_idx {
        if let mi = holder_idx {
            if di < mi {
                holder_idx = di
                holder_len = delta_key.len()
            }
        } else {
            holder_idx = di
            holder_len = delta_key.len()
        }
    }
    guard let hi = holder_idx else { return None }

    let content_key: String = "\"content\""
    guard let content_idx = find_sub(obj, content_key, hi + holder_len) else { return None }
    let value_at = skip_ws_colon(obj, content_idx + content_key.len())
    if value_at >= obj.len() || obj.byte_at(value_at) != 34 { return None }
    guard let parsed = parse_json_string(obj, value_at) else { return None }
    return parsed.0
}

// =============================================================================
// HTTP — a plain-socket client: build request, send, read status/headers,
// then the body under either framing a server may use.
// =============================================================================

struct HttpHead {
    status: Int
    content_length: Int?
    chunked: Bool
}

func build_request(method: String, path: String, host: String, port: Int, body: String?) -> String {
    var b = StringBuilder()
    try! b.append(method)
    try! b.append(" ")
    try! b.append(path)
    try! b.append(" HTTP/1.1\r\n")
    try! b.append("Host: ")
    try! b.append(host)
    try! b.append(":")
    try! b.append(port)
    try! b.append("\r\n")
    try! b.append("Connection: close\r\n")
    try! b.append("Accept: application/json\r\n")
    if let payload = body {
        try! b.append("Content-Type: application/json\r\n")
        try! b.append("Content-Length: ")
        try! b.append(payload.len())
        try! b.append("\r\n\r\n")
        try! b.append(payload)
    } else {
        try! b.append("\r\n")
    }
    return b.build()
}

// Every suspending TcpStream operation is MATCHED and its failure becomes a
// `ClientError` naming the host, the port and the operation — a network client
// that cannot reach its server should say so, not panic. (This is the file's
// designed shape, restored by design 247: while DF-215f was open, moving a
// suspending call's Ok payload out of a `match` arm released it twice, so
// `TcpStream.connect` came back a broken socket and a `Data` out of
// `TcpStream.read` was an Arc over-release. `try!` was the workaround, since a
// `try` hoist's temp had been take-read since design 218 stage 2.)
func send_request(host: String, port: Int, method: String, path: String, body: String?) -> Result<TcpStream, ClientError> {
    var stream = match TcpStream.connect(host, port) {
        case Ok(s) -> move s,
        case Err(e) -> {
            return ClientError(message: "could not connect to {host}:{port}: {e}")
        }
    }
    let req = build_request(method, path, host, port, body)
    match stream.write(req) {
        case Ok(_) -> { },
        case Err(e) -> {
            return ClientError(message: "could not send {method} {path} to {host}:{port}: {e}")
        }
    }
    return move stream
}

func read_chunk(stream: &var TcpStream) -> Result<Data, ClientError> {
    match stream.read() {
        case Ok(chunk) -> move chunk,
        case Err(e) -> ClientError(message: "reading the response failed: {e}")
    }
}

func find_crlf(d: &Data, from: Int) -> Int? {
    var i = from
    let n = d.len()
    while i + 1 < n {
        if d[i] == 13u8 && d[i + 1] == 10u8 { return i }
        i += 1
    }
    return None
}

func find_header_end(d: &Data) -> Int? {
    var i = 0
    let n = d.len()
    while i + 3 < n {
        if d[i] == 13u8 && d[i + 1] == 10u8 && d[i + 2] == 13u8 && d[i + 3] == 10u8 {
            return i + 4
        }
        i += 1
    }
    return None
}

func data_to_string(d: Data) -> Result<String, ClientError> {
    match d.to_string() {
        case Ok(s) -> s,
        case Err(e) -> ClientError(message: "response was not valid UTF-8: {e}")
    }
}

// Reads until the blank line that ends the response headers, parses the
// status line and the two framing headers this client understands, and
// returns whatever body bytes arrived in the same reads as the headers.
func read_head(stream: &var TcpStream) -> Result<(HttpHead, Data), ClientError> {
    var buf = try! Data(capacity: 512)
    var header_end: Int? = None
    while header_end.is_none() {
        let chunk = try read_chunk(&var stream)
        if chunk.len() == 0 {
            return ClientError(message: "connection closed before the response headers arrived")
        }
        try! buf.append(chunk)
        header_end = find_header_end(&buf)
    }
    guard let end = header_end else { return ClientError(message: "unreachable") }
    let head_bytes = buf.slice(0, end)
    guard let hb = head_bytes else { return ClientError(message: "unreachable") }
    let head_text = try data_to_string(hb)

    let lines = try! head_text.split(separator: "\r\n")
    if lines.len() == 0 { return ClientError(message: "empty response") }
    let status_line = lines[0]
    let sp1 = find_sub(status_line, " ", 0)
    guard let s1 = sp1 else { return ClientError(message: "malformed status line: {status_line}") }
    let rest = status_line.substring(s1 + 1, status_line.len())
    let sp2 = find_sub(rest, " ", 0)
    let status_text = if let s2 = sp2 { rest.substring(0, s2) } else { rest }
    guard let status = status_text.to_int() else {
        return ClientError(message: "malformed status line: {status_line}")
    }

    var content_length: Int? = None
    var chunked = false
    var i = 1
    while i < lines.len() {
        let line = lines[i]
        let colon = find_sub(line, ": ", 0)
        if let c = colon {
            let name = line.substring(0, c).to_lowercase()
            let value = line.substring(c + 2, line.len())
            if name == "content-length" {
                content_length = value.to_int()
            } else if name == "transfer-encoding" {
                if find_sub(value.to_lowercase(), "chunked", 0).is_some() { chunked = true }
            }
        }
        i += 1
    }

    let remainder = buf.slice(end, buf.len())
    guard let rem = remainder else { return ClientError(message: "unreachable") }
    return (HttpHead(status: status, content_length: content_length, chunked: chunked), rem)
}

// Decodes one full chunked body (used for a non-streaming response that
// happens to use chunked framing — the streaming path has its own
// incremental decoder below, since it must not wait for the final chunk
// before printing).
func decode_chunked_all(stream: &var TcpStream, initial: Data) -> Result<Data, ClientError> {
    var raw = initial
    var out = try! Data(capacity: 256)
    while true {
        var line_end = find_crlf(&raw, 0)
        while line_end.is_none() {
            let more = try read_chunk(&var stream)
            if more.len() == 0 { return ClientError(message: "connection closed mid chunk size") }
            try! raw.append(more)
            line_end = find_crlf(&raw, 0)
        }
        guard let le = line_end else { return ClientError(message: "unreachable") }
        let size_bytes = raw.slice(0, le)
        guard let sb = size_bytes else { return ClientError(message: "unreachable") }
        let size_text = try data_to_string(sb)
        let size = try parse_chunk_size(size_text)
        let after_size = raw.slice(le + 2, raw.len())
        guard var next_raw = after_size else { return ClientError(message: "unreachable") }
        raw = move next_raw
        if size == 0 { return move out }
        while raw.len() < size + 2 {
            let more = try read_chunk(&var stream)
            if more.len() == 0 { return ClientError(message: "connection closed mid chunk data") }
            try! raw.append(more)
        }
        let piece = raw.slice(0, size)
        guard let p = piece else { return ClientError(message: "unreachable") }
        try! out.append(p)
        let after_data = raw.slice(size + 2, raw.len())
        guard var rest = after_data else { return ClientError(message: "unreachable") }
        raw = move rest
    }
}

func parse_chunk_size(text: String) -> Result<Int, ClientError> {
    var t = text
    let semi = find_sub(t, ";", 0)
    if let s = semi { t = t.substring(0, s) }
    t = t.trim()
    guard let v = t.to_uint(radix: 16) else {
        return ClientError(message: "malformed chunk size: {text}")
    }
    return v as Int
}

// Reads the whole body under either framing this client understands.
// `content_length` present and not chunked reads exactly that many bytes;
// `chunked` decodes the chunk framing; otherwise it reads until the peer
// closes (the `Connection: close` this client always sends makes that a
// legal way to signal end-of-body too).
func read_full_body(stream: &var TcpStream, remainder: Data, head: HttpHead) -> Result<Data, ClientError> {
    if head.chunked {
        return decode_chunked_all(&var stream, remainder)
    }
    if let want = head.content_length {
        var body = remainder
        while body.len() < want {
            let more = try read_chunk(&var stream)
            if more.len() == 0 {
                return ClientError(message: "connection closed before the response body was complete")
            }
            try! body.append(more)
        }
        let exact = body.slice(0, want)
        guard let e = exact else { return ClientError(message: "unreachable") }
        return move e
    }
    var body = remainder
    while true {
        let more = try read_chunk(&var stream)
        if more.len() == 0 { return move body }
        try! body.append(more)
    }
}

func read_response(stream: &var TcpStream) -> Result<(Int, String), ClientError> {
    let head_and_rem = try read_head(&var stream)
    let head = head_and_rem.0
    let remainder = head_and_rem.1
    let body = try read_full_body(&var stream, remainder, head)
    let text = try data_to_string(body)
    return (head.status, text)
}

func status_error(method: String, path: String, host: String, port: Int, status: Int, body: String) -> ClientError {
    let detail = if body.len() > 500 { body.substring(0, 500) } else { body }
    return ClientError(message: "{method} {path} on {host}:{port} -> HTTP {status}: {detail}")
}

// =============================================================================
// Client operations
// =============================================================================

func fetch_models(host: String, port: Int) -> Result<Vector<String>, ClientError> {
    var stream = try send_request(host, port, "GET", "/v1/models", None)
    let status_and_text = try read_response(&var stream)
    let status = status_and_text.0
    let text = status_and_text.1
    if status != 200 {
        return status_error("GET", "/v1/models", host, port, status, text)
    }
    return extract_all(text, "id")
}

func pick_model(host: String, port: Int) -> Result<String, ClientError> {
    let ids = try fetch_models(host, port)
    var i = 0
    while i < ids.len() {
        let low = ids[i].to_lowercase()
        if find_sub(low, "embed", 0).is_none() { return ids[i] }
        i += 1
    }
    return ClientError(message: "no chat model on the server (saw: {ids.join(", ")})")
}

func build_chat_payload(model: String, system_prompt: String?, user_prompt: String, stream: Bool, temperature: Float?, max_tokens: Int?) -> String {
    var b = StringBuilder()
    try! b.append("\{\"model\":")
    append_json_string(&var b, model)
    try! b.append(",\"messages\":[")
    if let sp = system_prompt {
        try! b.append("\{\"role\":\"system\",\"content\":")
        append_json_string(&var b, sp)
        try! b.append("\},")
    }
    try! b.append("\{\"role\":\"user\",\"content\":")
    append_json_string(&var b, user_prompt)
    try! b.append("\}]")
    try! b.append(",\"stream\":")
    try! b.append(if stream { "true" } else { "false" })
    if stream {
        try! b.append(",\"stream_options\":\{\"include_usage\":true\}")
    }
    if let t = temperature {
        try! b.append(",\"temperature\":")
        try! b.append("{t}")
    }
    if let m = max_tokens {
        try! b.append(",\"max_tokens\":")
        try! b.append(m)
    }
    try! b.append("\}")
    return b.build()
}

func chat_once(host: String, port: Int, payload: String) -> Result<String, ClientError> {
    var stream = try send_request(host, port, "POST", "/v1/chat/completions", payload)
    let status_and_text = try read_response(&var stream)
    let status = status_and_text.0
    let text = status_and_text.1
    if status != 200 {
        return status_error("POST", "/v1/chat/completions", host, port, status, text)
    }
    guard let content = extract_content(text) else {
        return ClientError(message: "the response carried no message content: {text}")
    }
    return content
}

// Streams the reply, printing each content delta as it arrives — each SSE
// `data:` line is decoded and printed as soon as its owning HTTP chunk has
// been read off the socket, never waiting for the whole response.
func run_stream(stream: &var TcpStream, initial: Data) -> Result<String, ClientError> {
    var raw = initial
    var line_buf = try! Data(capacity: 256)
    var reply = StringBuilder()
    var done = false
    while not done {
        var line_end = find_crlf(&raw, 0)
        while line_end.is_none() {
            let more = try read_chunk(&var stream)
            if more.len() == 0 { return ClientError(message: "connection closed mid stream") }
            try! raw.append(more)
            line_end = find_crlf(&raw, 0)
        }
        guard let le = line_end else { return ClientError(message: "unreachable") }
        let size_bytes = raw.slice(0, le)
        guard let sb = size_bytes else { return ClientError(message: "unreachable") }
        let size_text = try data_to_string(sb)
        let size = try parse_chunk_size(size_text)
        let after_size = raw.slice(le + 2, raw.len())
        guard var next_raw = after_size else { return ClientError(message: "unreachable") }
        raw = move next_raw
        if size == 0 {
            done = true
            break
        }
        while raw.len() < size + 2 {
            let more = try read_chunk(&var stream)
            if more.len() == 0 { return ClientError(message: "connection closed mid stream data") }
            try! raw.append(more)
        }
        let piece = raw.slice(0, size)
        guard let p = piece else { return ClientError(message: "unreachable") }
        try! line_buf.append(p)
        let after_data = raw.slice(size + 2, raw.len())
        guard var rest = after_data else { return ClientError(message: "unreachable") }
        raw = move rest

        var nl = find_byte(&line_buf, 10u8, 0)
        while not done {
            guard let n = nl else { break }
            let line_bytes = line_buf.slice(0, n)
            guard let lb = line_bytes else { return ClientError(message: "unreachable") }
            let line = try data_to_string(lb)
            if process_sse_line(line, &var reply) { done = true }
            let after_line = line_buf.slice(n + 1, line_buf.len())
            guard var rest2 = after_line else { return ClientError(message: "unreachable") }
            line_buf = move rest2
            nl = find_byte(&line_buf, 10u8, 0)
        }
    }
    print("")
    return reply.build()
}

func find_byte(d: &Data, target: UInt8, from: Int) -> Int? {
    var i = from
    let n = d.len()
    while i < n {
        if d[i] == target { return i }
        i += 1
    }
    return None
}

// Handles one decoded SSE line, printing a content delta as it lands.
// Returns `true` when the line was `data: [DONE]` — the caller stops.
func process_sse_line(raw_line: String, reply: &var StringBuilder) -> Bool {
    var line = raw_line
    if line.len() > 0 && line.byte_at(line.len() - 1) == 13 {
        line = line.substring(0, line.len() - 1)
    }
    if not starts_with(line, "data:") { return false }
    var data_part = line.substring(5, line.len())
    data_part = data_part.trim()
    if data_part == "[DONE]" { return true }
    guard let piece = extract_content(data_part) else { return false }
    if piece.len() > 0 {
        print(piece)
        try! reply.append(piece)
    }
    return false
}

func starts_with(s: String, prefix: String) -> Bool {
    if prefix.len() > s.len() { return false }
    var i = 0
    while i < prefix.len() {
        if s.byte_at(i) != prefix.byte_at(i) { return false }
        i += 1
    }
    return true
}

func chat_stream(host: String, port: Int, payload: String) -> Result<String, ClientError> {
    var stream = try send_request(host, port, "POST", "/v1/chat/completions", payload)
    let head_and_rem = try read_head(&var stream)
    let head = head_and_rem.0
    let remainder = head_and_rem.1
    if head.status != 200 {
        let body = try read_full_body(&var stream, remainder, head)
        let text = try data_to_string(body)
        return status_error("POST", "/v1/chat/completions", host, port, head.status, text)
    }
    return run_stream(&var stream, remainder)
}

func read_system_prompt(path_str: String) -> Result<String, ClientError> {
    var f = match file.File.open(Path(s: path_str)) {
        case Ok(x) -> move x,
        case Err(e) -> { return ClientError(message: "could not read {path_str}: {e}") }
    }
    let data = match f.read() {
        case Ok(d) -> move d,
        case Err(e) -> { return ClientError(message: "could not read {path_str}: {e}") }
    }
    return data_to_string(data)
}

// =============================================================================
// Flags
// =============================================================================

struct ParsedArgs {
    host: String
    port: Int
    model: String?
    stream: Bool
    list_models: Bool
    system_prompt_file: String?
    temperature: Float?
    max_tokens: Int?
    prompt: String
}

func parse_args(args: Vector<String>) -> Result<ParsedArgs, ClientError> {
    var host: String = "Mac-Studio.local"
    var port = 1234
    var model: String? = None
    var stream = false
    var list_models = false
    var system_prompt_file: String? = None
    var temperature: Float? = None
    var max_tokens: Int? = None
    var words: Vector<String> = []

    var i = 1
    while i < args.len() {
        let a = args[i]
        if a == "--host" {
            i += 1
            if i >= args.len() { return ClientError(message: "--host needs a value") }
            host = args[i]
        } else if a == "--port" {
            i += 1
            if i >= args.len() { return ClientError(message: "--port needs a value") }
            guard let p = args[i].to_int() else {
                return ClientError(message: "--port expects a number, got {args[i]}")
            }
            port = p
        } else if a == "--model" {
            i += 1
            if i >= args.len() { return ClientError(message: "--model needs a value") }
            model = args[i]
        } else if a == "--stream" {
            stream = true
        } else if a == "--list-models" {
            list_models = true
        } else if a == "--system-prompt" {
            i += 1
            if i >= args.len() { return ClientError(message: "--system-prompt needs a value") }
            system_prompt_file = args[i]
        } else if a == "--temperature" {
            i += 1
            if i >= args.len() { return ClientError(message: "--temperature needs a value") }
            guard let t = args[i].to_float() else {
                return ClientError(message: "--temperature expects a number, got {args[i]}")
            }
            temperature = t
        } else if a == "--max-tokens" {
            i += 1
            if i >= args.len() { return ClientError(message: "--max-tokens needs a value") }
            guard let m = args[i].to_int() else {
                return ClientError(message: "--max-tokens expects a number, got {args[i]}")
            }
            max_tokens = m
        } else if a.len() >= 2 && a.byte_at(0) == 45 && a.byte_at(1) == 45 {
            return ClientError(message: "unknown flag: {a}")
        } else {
            try! words.push(a)
        }
        i += 1
    }

    var prompt_builder = StringBuilder()
    var first = true
    var wi = 0
    while wi < words.len() {
        if not first { try! prompt_builder.append(" ") }
        try! prompt_builder.append(words[wi])
        first = false
        wi += 1
    }

    return ParsedArgs(
        host: host, port: port, model: model, stream: stream,
        list_models: list_models, system_prompt_file: system_prompt_file,
        temperature: temperature, max_tokens: max_tokens,
        prompt: prompt_builder.build())
}

// =============================================================================
// main
// =============================================================================

func main() -> Result<Void, ClientError> {
    let argv = try! Env.args()
    let parsed = try parse_args(move argv)

    if parsed.list_models {
        let ids = try fetch_models(parsed.host, parsed.port)
        var i = 0
        while i < ids.len() {
            print(ids[i])
            i += 1
        }
        return
    }

    var model = ""
    if let m = parsed.model {
        model = m
    } else {
        model = try pick_model(parsed.host, parsed.port)
    }

    var system_prompt: String? = None
    if let path = parsed.system_prompt_file {
        system_prompt = try read_system_prompt(path)
    }

    if parsed.prompt.len() == 0 {
        return ClientError(message: "usage: llm_client [flags] <prompt words...>")
    }

    let payload = build_chat_payload(
        model: model, system_prompt: system_prompt, user_prompt: parsed.prompt,
        stream: parsed.stream, temperature: parsed.temperature, max_tokens: parsed.max_tokens)

    if parsed.stream {
        let _ = try chat_stream(parsed.host, parsed.port, payload)
    } else {
        let reply = try chat_once(parsed.host, parsed.port, payload)
        print(reply)
    }
    return
}
