// w1-pipeline: three-stage channel pipeline (producer -> transformer -> sink)
//
// Spec: devtools/dogfood/specs/w1-pipeline.md

import std.channel.{Channel}
import std.task.*

enum PMsg {
    case Value(v: Int),
    case Done
}

enum TMsg {
    case Forwarded(v: Int),
    case Final(h: Int)
}

func produce(out: Channel<PMsg>) {
    var i = 1
    while i <= 5000 {
        try! out.send(PMsg.Value(v: i))
        i = i + 1
    }
    try! out.send(PMsg.Done)
}

func transform(inch: Channel<PMsg>, outch: Channel<TMsg>) {
    var h = 0
    var going = true
    while going {
        let msg = try! inch.receive()
        match msg {
            case Value(v) -> {
                h = (h * 31 + v) % 1000000007
                if v % 7 == 0 {
                    try! outch.send(TMsg.Forwarded(v: v))
                }
            },
            case Done -> {
                try! outch.send(TMsg.Final(h: h))
                going = false
            }
        }
    }
}

func sink(inch: Channel<TMsg>) {
    var count = 0
    var h = 0
    var going = true
    while going {
        let msg = try! inch.receive()
        match msg {
            case Forwarded(v) -> {
                count = count + 1
            },
            case Final(hh) -> {
                h = hh
                going = false
            }
        }
    }
    print("forwarded {}", count)
    print("hash {}", h)
    print("done")
}

func main() {
    let ch1 = Channel<PMsg>()
    let ch2 = Channel<TMsg>()
    var group = TaskGroup()
    let p = group.spawn(produce(ch1))
    let t = group.spawn(transform(ch1, ch2))
    let s = group.spawn(sink(ch2))
    p.join()
    t.join()
    s.join()
}
