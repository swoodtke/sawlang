//! The compiler output determinism harness (design 126 R2), in Saw.
//!
//! Compiling one unchanged source twice must produce byte-identical LLVM IR.
//! That was NOT true before design 126: two `set`-of-`str` iterations reached
//! emission order (the codegen type topological sort, and closure-environment
//! field order), and two generated names were derived from `id()` — a memory
//! address. Python randomizes string hashing per process, so a single run always
//! looked self-consistent and the defect was invisible without a cross-run
//! comparison.
//!
//! Each sampled source is compiled twice, in fresh processes, under DIFFERENT
//! `PYTHONHASHSEED` values, and the emitted `.ll` files are compared as bytes.
//! Any difference is a determinism bug. Zero is the acceptance bar.
//!
//! Design 220 unit 3 (D4): when `test_runner_last` carries a fresh manifest
//! entry for a file, that side of the pair is REUSED instead of recompiled —
//! one fresh compile under a differing seed, byte-compared against the
//! suite's own optimized-IR artifact. A mismatch never reports on its own;
//! it triggers a three-way verify (fresh recompiles at both seeds) that
//! distinguishes true nondeterminism from a VIOLATED INVARIANT (the reused
//! artifact does not match what its own recorded seed produces fresh) from a
//! transient race — so a cache bug can only cost time or produce a red that
//! names itself, never a silent pass. No manifest present (a clean checkout,
//! or a generation predating this scheme) is byte-for-byte the pre-220
//! behavior: every file compiles fresh both sides.
//!
//! This is the design-155 port of `tools/irdet.py`, and the first devtool
//! written in Saw. The TOOL is Saw; the compiler it checks is not — it drives
//! the Python `sawc`, and will keep doing so for the whole rewrite track. Run it
//! from the repository root:
//!
//!     .build/irdetbin [-n COUNT] [--all] [-v] [-j JOBS]
//!                     [--python PATH] [--only-files FILE] [--jsonl FILE]

import std.process.{Command}
import std.file.{File}
import std.path.{Path}
import std.directory.{Directory}
import std.data.{Data}
import std.env.{Env}
import std.time.{Instant}

// The named constants below are FUNCTIONS because a `static` may only hold a
// compile-time constant and a String owns a heap buffer (DF-155c). Naming them
// is still the point; the calls fold away.

// Two seeds that produce different `str` hashing. `0` would DISABLE
// randomization, which would mask exactly the class of bug this harness exists
// to catch.
func seed_a() -> String { "1" }
func seed_b() -> String { "424242" }

/// The compiler under test, relative to the repository root.
func sawc_path() -> String { "sawc/sawc.py" }
/// The interpreter that runs it by default. The repo's virtualenv is the one
/// with llvmlite in it; a machine that installed the dependencies globally (CI
/// does) has no virtualenv and falls back to whatever `python3` resolves to.
func venv_python() -> String { ".venv/bin/python" }
func system_python() -> String { "python3" }

/// Where the two per-file compiles put their IR. Checks run in parallel, so each
/// compile gets its own `-o` base here: the default `.build/<stem>` would
/// collide across concurrent tasks, and across two same-stem files in different
/// subdirectories.
func build_dir() -> String { ".build" }
func scratch_dir() -> String { ".build/irdet" }

// How many examples `-n` samples when it is not given a number.
static DEFAULT_COUNT: Int = 40
// How many checks run at once by default. Python read the core count and used
// `min(10, cores - 2)`; Saw has no way to ask (DF-155b), so this is a fixed
// number in the same band — the work is subprocess-bound, so being a little off
// the core count costs little, and `-j` is exact when it matters.
static DEFAULT_JOBS: Int = 8

// Process exit codes. `2` is the usage error every CLI reports.
static EXIT_OK: Int = 0
static EXIT_FAILED: Int = 1
static EXIT_USAGE: Int = 2

/// What one file's check proved.
enum Verdict: UInt8 {
    /// The IR compares equal — either two fresh compiles (no manifest hit)
    /// or a reused artifact against one fresh compile (design 220 D4), or a
    /// transient mismatch resolved by the three-way verify's fresh pair.
    case Ok = 0
    /// The file does not build standalone, so there was no IR to compare.
    case Skip = 1
    /// Two FRESH compiles disagreed — a determinism bug, reported exactly as
    /// before design 220 (design 220 D4's "true nondeterminism" outcome).
    case Mismatch = 2
    /// design 220 D4: a reused artifact does not match a fresh recompile at
    /// its OWN recorded seed (`fresh-A != artifact`) — a stale stamp or an
    /// in-process-vs-subprocess divergence (design 115's audited bit-identity
    /// broken), never absorbed into `Mismatch`. Its own failure category, so
    /// a cache bug can only cost time or produce a red that names itself.
    case Invariant = 3
}

extension Verdict {
    /// The name this verdict carries in a `--jsonl` record. It is wire text a
    /// remote worker reads back (design 160), so these four strings are ABI —
    /// `tools/irdet_remote.py` matches "mismatch" and "invariant" by name.
    func wire_name(&self) -> String {
        match self {
            case Ok -> "ok",
            case Skip -> "skip",
            case Mismatch -> "mismatch",
            case Invariant -> "invariant"
        }
    }
}

/// One file's verdict, as it comes back out of a worker task. Every field is
/// `Send`, which is what lets a task carry one across an OS thread.
struct Check {
    verdict: Verdict
    detail: String
    /// Whether this verdict came from a reused artifact rather than two
    /// fresh compiles (design 220 D4) — purely for the reuse-rate report,
    /// never read to decide pass/fail.
    reused: Bool
}

/// The command line, once it has been understood.
struct Options {
    count: Int
    all: Bool
    verbose: Bool
    plan: Bool
    help: Bool
    jobs: Int
    python: String
    only_files: String?
    jsonl: String?
}

func usage() {
    print("usage: irdet [-n COUNT] [--all] [-v] [-j JOBS] [--python PATH]")
    print("             [--only-files FILE] [--jsonl FILE]")
    print("")
    print("  -n, --count COUNT   how many examples to sample (default {DEFAULT_COUNT})")
    print("  --all               sweep every compilable example instead of sampling")
    print("  -v, --verbose       name each skipped file")
    print("  --plan              print the files this run would check, and stop")
    print("  -j, --jobs N        concurrent checks (default {DEFAULT_JOBS})")
    print("  --python PATH       the interpreter that runs sawc")
    print("  --only-files FILE   check exactly the repo-relative paths listed in")
    print("                      FILE, one per line (how a remote worker is given")
    print("                      its shard)")
    print("  --jsonl FILE        append one JSON record per checked file, flushed")
    print("                      as it lands")
}

/// The interpreter to run `sawc` with: the repo virtualenv when it is there,
/// and the system `python3` otherwise.
func default_python() -> String {
    if File.exists(Path(s: venv_python())) {
        venv_python()
    } else {
        system_python()
    }
}

/// Does `flag` expect the next argument to be its value? Asking BEFORE reaching
/// for that argument is what lets a typo be reported as the unknown option it
/// is, rather than as a missing value for something that does not exist.
func takes_value(flag: String) -> Bool {
    // Parenthesized so the operator may wrap: a newline is insignificant inside
    // `(...)` and ends the statement outside it (design 129).
    (flag == "-n" || flag == "--count" ||
     flag == "-j" || flag == "--jobs" ||
     flag == "--python" || flag == "--only-files" || flag == "--jsonl")
}

/// Parse the command line. `None` means the arguments were unusable and the
/// reason has already been printed; the caller exits 2.
func parse_options(argv: &Vector<String>) -> Options? {
    var count = DEFAULT_COUNT
    var all = false
    var verbose = false
    var plan = false
    var help = false
    var jobs = DEFAULT_JOBS
    var python = default_python()
    var only_files: String? = None
    var jsonl: String? = None

    // argv[0] is this program.
    var i = 1
    while i < argv.len() {
        guard let flag = argv.get(i) else {
            break
        }

        if flag == "--all" {
            all = true
            i = i + 1
        } else if flag == "-v" || flag == "--verbose" {
            verbose = true
            i = i + 1
        } else if flag == "--plan" {
            plan = true
            i = i + 1
        } else if flag == "-h" || flag == "--help" {
            help = true
            i = i + 1
        } else if not takes_value(flag) {
            print("irdet: unknown option `{flag}`")
            usage()
            return None
        } else {
            guard let value = argv.get(i + 1) else {
                print("irdet: {flag} needs a value")
                return None
            }
            if flag == "-n" || flag == "--count" {
                guard let n = value.to_int() else {
                    print("irdet: {flag} needs a number, got `{value}`")
                    return None
                }
                count = n
            } else if flag == "-j" || flag == "--jobs" {
                guard let n = value.to_int() else {
                    print("irdet: {flag} needs a number, got `{value}`")
                    return None
                }
                if n < 1 {
                    print("irdet: {flag} needs at least 1, got {n}")
                    return None
                }
                jobs = n
            } else if flag == "--python" {
                python = value
            } else if flag == "--only-files" {
                only_files = value
            } else {
                jsonl = value
            }
            i = i + 2
        }
    }

    Options(count: count, all: all, verbose: verbose, plan: plan, help: help,
            jobs: jobs, python: python, only_files: only_files, jsonl: jsonl)
}

/// Every tracked `examples/*.saw`, sorted. Asking git rather than walking the
/// tree is what keeps an uncommitted scratch file out of a gate. `None` means
/// git could not answer.
func tracked_examples() -> Vector<String>? {
    var c = Command(program: "git")
    c.arg("ls-files")
    c.arg("examples/*.saw")
    guard let listed = c.output() else {
        return None
    }
    if not listed.success() {
        return None
    }

    let lines = listed.stdout.split("\n")
    var files = Vector<String>()
    var i = 0
    while i < lines.len() {
        if let line = lines.get(i) {
            let trimmed = line.trim()
            if not trimmed.is_empty() {
                files.push(trimmed)
            }
        }
        i = i + 1
    }
    files.sort()
    move files
}

/// The repo-relative paths listed in `path`, one per line — how a remote worker
/// is handed its shard. `None` means the list itself could not be read, which is
/// a failure of the run and not of the compiler.
func read_file_list(path: String) -> Vector<String>? {
    guard let text = read_text(path) else {
        return None
    }
    let lines = text.split("\n")
    var files = Vector<String>()
    var i = 0
    while i < lines.len() {
        if let line = lines.get(i) {
            let trimmed = line.trim()
            if not trimmed.is_empty() {
                files.push(trimmed)
            }
        }
        i = i + 1
    }
    move files
}

/// A whole file as text, or `None` when it could not be read or is not UTF-8.
func read_text(path: String) -> String? {
    var f = match File.open(Path(s: path)) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return None }
    }
    let bytes = match f.read() {
        case Ok(data) -> move data,
        case Err(_) -> { return None }
    }
    match bytes.to_string() {
        case Ok(text) -> text,
        case Err(_) -> None
    }
}

/// A whole file's raw bytes, or `None` when it could not be read. Unlike
/// `read_text` this never rejects non-UTF-8 content — an `.ll` artifact is
/// compared byte-for-byte, not read as text.
func read_data_file(path: String) -> Data? {
    var f = match File.open(Path(s: path)) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return None }
    }
    match f.read() {
        case Ok(data) -> move data,
        case Err(_) -> None
    }
}

/// Error / skip examples never reach codegen, so they have no IR to compare.
///
/// The rule is the DIRECTIVE the suite itself reads (`test_runner.py`) rather
/// than a path or filename convention — error tests live both in
/// `examples/errors/` and scattered through `examples/`. A file that cannot be
/// read at all counts as one too: there is nothing here to check either way.
func is_negative_test(rel: String) -> Bool {
    guard let text = read_text(rel) else {
        return true
    }
    text.contains("// EXPECT: error") || text.contains("// EXPECT: skip")
}

/// The `-n` sample: an even stride over the sorted list.
///
/// Deterministic BY CONSTRUCTION rather than by a seeded shuffle, so a failure
/// always reproduces, and a stride spreads the sample over the whole tree
/// instead of clustering it — which a random draw only manages on average. Like
/// any fixed sample it rotates only when the corpus changes, which is why the
/// final gate is `--all` and not this (design 141 found two nondeterministic
/// emission orders that had sat in the tree until two unrelated new examples
/// reshuffled the sample onto one of them).
func sample(files: &Vector<String>, count: Int) -> Vector<String> {
    var picked = Vector<String>()
    let total = files.len()
    if count >= total {
        var i = 0
        while i < total {
            if let f = files.get(i) {
                picked.push(f)
            }
            i = i + 1
        }
        return move picked
    }
    var k = 0
    while k < count {
        if let f = files.get(k * total / count) {
            picked.push(f)
        }
        k = k + 1
    }
    move picked
}

/// The `-o` base for one compile: `.build/irdet/<task>_s<seed>_<stem>`. Unique
/// per task AND per seed — see scratch_dir() for why the default base will not do.
func scratch_base(rel: String, seed: String, task_id: Int) -> String {
    let stem = Path(s: rel).stem() ?? "unnamed"
    var out = StringBuilder()
    out.append(scratch_dir())
    out.append("/")
    out.append(task_id)
    out.append("_s")
    out.append(seed)
    out.append("_")
    out.append(stem)
    out.build()
}

/// Compile `rel` to IR in a fresh process; the emitted bytes, or `None` when the
/// file does not build standalone (module-path dependencies, host-only, ...).
func emit_ir(rel: String, seed: String, task_id: Int, python: String) -> Data? {
    let base = scratch_base(rel, seed, task_id)
    var name = StringBuilder()
    name.append(base)
    name.append(".ll")
    let ll = Path(s: name.build())

    // A stale file from an interrupted run must not be mistaken for this one's.
    if File.exists(ll) {
        let _ = File.remove(ll)
    }

    var c = Command(program: python)
    c.arg(sawc_path())
    c.arg(rel)
    c.arg("--emit-ir")
    c.arg("-o")
    c.arg(base)
    // The whole point of the harness: the two compiles differ ONLY in how
    // Python seeds its string hashing.
    c.env("PYTHONHASHSEED", seed)
    // Some of these compiles are expected to fail — that is what a skip IS — and
    // their diagnostics are not ours to print, so they go into the capture with
    // stdout and are dropped with it.
    c.merge_stderr()

    guard let done = c.output() else {
        return None
    }
    if not done.success() {
        return None
    }
    if not File.exists(ll) {
        return None
    }

    var f = match File.open(ll) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return None }
    }
    let bytes = match f.read() {
        case Ok(data) -> move data,
        case Err(_) -> { return None }
    }
    let _ = File.remove(ll)
    move bytes
}

/// Byte-for-byte equality — the whole verdict.
func same_bytes(a: &Data, b: &Data) sync -> Bool {
    let n = a.len()
    if n != b.len() {
        return false
    }
    var i = 0
    while i < n {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    true
}

// ===========================================================================
// The suite manifest (design 220 D4). test_runner.py's suite compiles a
// SUCCESS/PANIC test's optimized IR under a recorded per-worker seed and, on
// an unchanged tree, hardlinks it forward run to run. `test_runner_last` is
// the published symlink; resolving it ONCE here (rather than re-reading it
// per file) means a suite run that republishes mid-irdet-run can never mix
// two generations' artifacts into one decision.
//
// With no manifest present (a clean checkout, or a generation that predates
// this scheme), every lookup below answers `None` and every file falls
// through to `check_one_compile_both` — byte-for-byte today's behavior.
// ===========================================================================

/// One manifest entry: the worker seed that produced the artifact, and the
/// artifact's filename (always directly under the run directory, whether it
/// was compiled fresh or hardlinked forward — see test_runner.py's
/// `try_carry_forward`).
struct ManifestEntry {
    seed: String
    ll_name: String
}

/// `test_runner_last`'s target directory (e.g. `.build/test_runner_167.../`),
/// or `None` if the symlink is absent — no completed suite run yet. Shells
/// out to `readlink` because Saw has no symlink-resolution call of its own;
/// a single-level read is all D2's layout ever needs (the symlink's target is
/// always a bare run-directory name, never a further symlink).
func resolve_last_run_dir() -> String? {
    var c = Command(program: "readlink")
    c.arg(".build/test_runner_last")
    guard let done = c.output() else {
        return None
    }
    if not done.success() {
        return None
    }
    let target = done.stdout.trim()
    if target.is_empty() {
        return None
    }
    var out = StringBuilder()
    out.append(".build/")
    out.append(target)
    out.build()
}

/// Parses `<run_dir>/manifest.tsv` (test_runner.py's `write_manifest`):
/// `path\tseed\tll_name\tmtime` per line, `#`-prefixed lines are comments.
/// `None` when the file is absent or unreadable — the manifest is optional
/// infrastructure, never a hard requirement (D4).
func read_manifest(run_dir: String) -> Map<String, ManifestEntry>? {
    var path = StringBuilder()
    path.append(run_dir)
    path.append("/manifest.tsv")
    guard let text = read_text(path.build()) else {
        return None
    }
    var entries = Map<String, ManifestEntry>()
    let lines = text.split("\n")
    var i = 0
    while i < lines.len() {
        if let line = lines.get(i) {
            let trimmed = line.trim()
            if not trimmed.is_empty() && not trimmed.starts_with("#") {
                let parts = trimmed.split("\t")
                if parts.len() == 4 {
                    if let rel_path = parts.get(0) {
                        if let seed = parts.get(1) {
                            if let ll_name = parts.get(2) {
                                entries.insert(rel_path,
                                    ManifestEntry(seed: seed, ll_name: ll_name))
                            }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    move entries
}

/// A seed that differs from `recorded` (D4: "a seed drawn to differ from the
/// recorded one"). Saw has no general RNG (DF-155b's platform gap extends
/// here), so this is DETERMINISTIC rather than a true random draw — a
/// distinct value per file (via `task_id`), reproducible across runs of the
/// same corpus, which for a determinism-audit harness is a reasonable trade:
/// a replay of a red irdet run reproduces exactly rather than re-rolling.
func differing_seed(recorded: String, task_id: Int) -> String {
    var candidate = (task_id * 2654435761 + 104729) % 2000000000
    if candidate == 0 {
        candidate = 1
    }
    var s = candidate.to_string()
    if s == recorded {
        s = if recorded == "1" { "2" } else { "1" }
    }
    s
}

/// Check one file with NO manifest hit: the original two-fresh-compiles path,
/// unchanged since before design 220. The two seed compiles stay SEQUENTIAL
/// inside the task; the parallelism is across files, which are independent.
func check_one_compile_both(index: Int, rel: String, python: String) -> Check {
    var first = emit_ir(rel, seed_a(), index, python)
    if let a = move first {
        var second = emit_ir(rel, seed_b(), index, python)
        if let b = move second {
            if same_bytes(&a, &b) {
                Check(verdict: Verdict.Ok, detail: "", reused: false)
            } else {
                Check(verdict: Verdict.Mismatch,
                      detail: "{a.len()} vs {b.len()} bytes", reused: false)
            }
        } else {
            Check(verdict: Verdict.Skip, detail: "", reused: false)
        }
    } else {
        Check(verdict: Verdict.Skip, detail: "", reused: false)
    }
}

/// Check one file that HAS a fresh manifest entry (design 220 D4): one fresh
/// compile under a differing seed, byte-compared against the reused
/// artifact. On any mismatch, the three-way verify — fresh recompiles at
/// BOTH the recorded seed and the differing one, in subprocesses — decides
/// which of the three D4 outcomes this is, and the verdict NEVER comes from
/// the reused artifact alone past this point.
func check_one_reuse(index: Int, rel: String, entry: ManifestEntry,
                     run_dir: String, python: String) -> Check {
    var artifact_path = StringBuilder()
    artifact_path.append(run_dir)
    artifact_path.append("/")
    artifact_path.append(entry.ll_name)
    guard let artifact = read_data_file(artifact_path.build()) else {
        // The manifest named an artifact that is not actually there —
        // fall back rather than trusting a dangling entry.
        return check_one_compile_both(index, rel, python)
    }

    let seed_b = differing_seed(entry.seed, index)
    guard let fresh = emit_ir(rel, seed_b, index, python) else {
        return check_one_compile_both(index, rel, python)
    }

    if same_bytes(&fresh, &artifact) {
        return Check(verdict: Verdict.Ok, detail: "", reused: true)
    }

    // Mismatch: never reported from this one comparison alone. Recompile
    // BOTH sides fresh, in subprocesses, before concluding anything.
    guard let fresh_a = emit_ir(rel, entry.seed, index, python) else {
        return check_one_compile_both(index, rel, python)
    }
    guard let fresh_b = emit_ir(rel, seed_b, index, python) else {
        return check_one_compile_both(index, rel, python)
    }

    if same_bytes(&fresh_a, &artifact) {
        if same_bytes(&fresh_a, &fresh_b) {
            // fresh-A == fresh-B == artifact: the earlier mismatch was
            // transient (e.g. the artifact raced a prune) — counted, but the
            // verdict comes from the fresh pair, which agree.
            Check(verdict: Verdict.Ok,
                  detail: "reuse-fallback: transient mismatch against the artifact, fresh pair agrees",
                  reused: false)
        } else {
            // fresh-A == artifact, fresh-A != fresh-B: true nondeterminism,
            // reported exactly as the compile-both path already does.
            Check(verdict: Verdict.Mismatch,
                  detail: "{fresh_a.len()} vs {fresh_b.len()} bytes", reused: false)
        }
    } else {
        // fresh-A != artifact: the artifact does not match what its OWN
        // recorded seed produces fresh — a violated invariant, never
        // absorbed into Mismatch or a silent pass.
        Check(verdict: Verdict.Invariant,
              detail: "recorded artifact is {artifact.len()} byte(s); a fresh recompile at its own seed ({entry.seed}) is {fresh_a.len()} byte(s)",
              reused: false)
    }
}

/// The dispatcher: a fresh manifest hit takes the reuse path, everything else
/// (no manifest, or no entry for this file) takes the original one.
func check_one(index: Int, rel: String, entry: ManifestEntry?,
               run_dir: String?, python: String) -> Check {
    if let e = entry {
        if let dir = run_dir {
            return check_one_reuse(index, rel, e, dir, python)
        }
    }
    check_one_compile_both(index, rel, python)
}

/// A string as a JSON scalar body. Only the two characters JSON forbids raw need
/// touching; a repo-relative path and a byte-count detail contain neither, but a
/// record that is not valid JSON would be read back as a missing verdict rather
/// than as a bug here.
func json_escaped(s: String) -> String {
    s.replace("\\", "\\\\").replace("\"", "\\\"")
}

/// Append one JSON record for a checked file, flushed as it lands.
///
/// A remote test worker (design 160) TAILS this file while the check is still
/// running, which is what makes a shard stream its verdicts back instead of
/// arriving in one lump at the end — so the record has to be on disk by the time
/// this returns, and the keys have to be the ones the worker reads. They are
/// written in sorted order, matching what the Python tool emitted.
func append_record(path: String, rel: String, result: &Check) {
    var line = StringBuilder()
    line.append("\{\"detail\": \"")
    line.append(json_escaped(result.detail))
    line.append("\", \"kind\": \"file\", \"path\": \"")
    line.append(json_escaped(rel))
    line.append("\", \"status\": \"")
    line.append(result.verdict.wire_name())
    line.append("\"\}\n")

    var f = match File.open_append(Path(s: path)) {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("irdet: cannot write {path}: {e}")
            return
        }
    }
    match f.write(line.build().to_data()) {
        case Ok(_) -> {},
        case Err(e) -> print("irdet: cannot write {path}: {e}")
    }
}

func main() -> Int {
    let argv = Env.args()
    guard let opts = parse_options(&argv) else {
        return EXIT_USAGE
    }
    // Asking for the usage message is not a usage ERROR.
    if opts.help {
        usage()
        return EXIT_OK
    }

    // The file set: a worker's shard verbatim, or the tracked examples with the
    // negative tests filtered out.
    var files = Vector<String>()
    if let listed = opts.only_files {
        guard let shard = read_file_list(listed) else {
            print("irdet: cannot read the file list `{listed}`")
            return EXIT_FAILED
        }
        files = move shard
    } else {
        guard let tracked = tracked_examples() else {
            print("irdet: `git ls-files` failed")
            return EXIT_FAILED
        }
        var candidates = Vector<String>()
        var i = 0
        while i < tracked.len() {
            if let rel = tracked.get(i) {
                if not is_negative_test(rel) {
                    candidates.push(rel)
                }
            }
            i = i + 1
        }
        if opts.all {
            files = move candidates
        } else {
            files = sample(&candidates, opts.count)
        }
    }

    // `--plan` prints the file set and checks nothing. Which examples are
    // negative tests is THIS tool's rule, so anything that needs to split the
    // corpus (the two-machine driver, tools/irdet_remote.py) asks rather than
    // reimplementing it — two copies of the rule would be two rules.
    if opts.plan {
        var p = 0
        while p < files.len() {
            if let rel = files.get(p) {
                print(rel)
            }
            p = p + 1
        }
        return EXIT_OK
    }

    // Both levels: `.build` may not exist yet either. An Err here is almost
    // always "it is already there", which is the state we wanted.
    let _ = Directory.create(Path(s: build_dir()))
    let _ = Directory.create(Path(s: scratch_dir()))

    // design 220 D4: resolved and read ONCE, before any check starts — see
    // `resolve_last_run_dir`'s own docstring for why a fixed generation
    // matters. Absent (either half) means every file falls through to
    // `check_one_compile_both`, byte-for-byte today's behavior. `manifest`
    // is read from repeatedly below (once per file, across the whole run) —
    // `is_some()` + `!` are both BORROWS (design 218 DF-218a / the payload
    // borrow rule), so this never consumes it, unlike `if let`.
    let manifest_run_dir = resolve_last_run_dir()
    var manifest: Map<String, ManifestEntry>? = None
    if let dir = manifest_run_dir {
        manifest = read_manifest(dir)
    }
    if manifest.is_some() {
        let count = manifest!.len()
        print("irdet: suite manifest found ({count} entries)")
    } else {
        print("irdet: no suite manifest -- every file compiles fresh both sides, as before design 220")
    }

    let started = Instant.now()

    // Files are independent, so the checks fan out — in WAVES of at most
    // `opts.jobs`. The old spawn-everything loop relied on `Command.run()`
    // BLOCKING its worker thread, which capped children at the worker count
    // by accident; since design 182 `run()` parks instead, so an unbounded
    // spawn launches every example's compile as a concurrent child process
    // (DF-182f: the full corpus put the machine at loadavg >700). Joining
    // each wave before spawning the next bounds the children in flight to
    // the number the flag always promised.
    var group = TaskGroup(threads: opts.jobs)
    var checked = 0
    var skipped = 0
    var mismatched = 0
    var invariant_violations = 0
    var reused = 0
    var index = 0
    while index < files.len() {
        var wave = Vector<Task<Check>>()
        var w = 0
        while w < opts.jobs && index + w < files.len() {
            guard let rel = files.get(index + w) else {
                break
            }
            // The lookup happens HERE, in the main task, and only the
            // looked-up entry (an owned, Copy-tier value — two Strings)
            // crosses into the spawned task, never the Map itself: an MT
            // TaskGroup borrow would need `Send`, and a lone entry sidesteps
            // the question entirely.
            var entry: ManifestEntry? = None
            if manifest.is_some() {
                entry = manifest!.get(rel)
            }
            let h = group.spawn(
                check_one(index + w, rel, entry, manifest_run_dir, opts.python))
            wave.push(move h)
            w = w + 1
        }

        // Handles are move-only, so they come back out by popping. Draining
        // into a second vector reverses the order once, and popping THAT
        // walks the wave in input order — which is what keeps the report, the
        // JSONL stream and the exit status independent of which task happened
        // to finish first.
        var pending = Vector<Task<Check>>()
        while wave.len() > 0 {
            if let h = wave.pop() {
                pending.push(move h)
            }
        }

        while pending.len() > 0 {
        guard let handle = pending.pop() else {
            break
        }
        let result = handle.join()
        let rel = files.get(index) ?? "<unknown>"

        if result.reused {
            reused = reused + 1
        }
        match result.verdict {
            case Ok -> { checked = checked + 1 },
            case Skip -> {
                skipped = skipped + 1
                if opts.verbose {
                    print("  skip (does not build standalone): {rel}")
                }
            },
            case Mismatch -> {
                checked = checked + 1
                mismatched = mismatched + 1
                print("  MISMATCH: {rel} ({result.detail})")
            },
            case Invariant -> {
                checked = checked + 1
                invariant_violations = invariant_violations + 1
                print("  VIOLATED INVARIANT: {rel} ({result.detail})")
            }
        }
        if let sink = opts.jsonl {
            append_record(sink, rel, &result)
        }
        index = index + 1
        }
    }

    let elapsed = started.elapsed().as_millis()
    let whole = elapsed / 1000
    let tenths = (elapsed % 1000) / 100
    print("irdet: compiled {checked} example(s) under differing PYTHONHASHSEED ({skipped} skipped, {whole}.{tenths}s)")
    if reused > 0 {
        print("irdet: {reused}/{checked} reused a suite artifact instead of a second fresh compile")
    }

    if invariant_violations > 0 {
        print("irdet: {invariant_violations} file(s) VIOLATED THE REUSE INVARIANT (a reused artifact did not match a fresh recompile at its own recorded seed)")
    }
    if mismatched > 0 {
        print("irdet: {mismatched} file(s) produced NON-REPRODUCIBLE IR")
    }
    if mismatched > 0 || invariant_violations > 0 {
        return EXIT_FAILED
    }
    if checked == 0 {
        // A compile failure counts as a skip, so an interpreter without llvmlite
        // skips the entire corpus — and this used to print OK, a final gate
        // reporting success having verified nothing.
        print("irdet: NOTHING WAS CHECKED -- every candidate failed to compile.")
        print("irdet: the interpreter running sawc was `{opts.python}`; point")
        print("irdet: --python at one that can import llvmlite.")
        return EXIT_FAILED
    }
    print("irdet: OK -- every sampled example compiled to byte-identical IR")
    EXIT_OK
}
