//! The compiler output determinism harness (design 126 R2), in Saw.
//!
//! Compiling one unchanged source twice must produce byte-identical LLVM IR.
//! That was NOT true before design 126: two `set`-of-`str` iterations reached
//! emission order (the codegen type topological sort, and closure-environment
//! field order), and two generated names were derived from `id()` — a memory
//! address. Python randomizes string hashing per process, so a single run always
//! looked self-consistent and the defect was invisible without a cross-run
//! comparison.
//!
//! Each sampled source is compiled twice, in fresh processes, under DIFFERENT
//! `PYTHONHASHSEED` values, and the emitted `.ll` files are compared as bytes.
//! Any difference is a determinism bug. Zero is the acceptance bar.
//!
//! This is the design-155 port of `tools/irdet.py`, and the first devtool
//! written in Saw. The TOOL is Saw; the compiler it checks is not — it drives
//! the Python `sawc`, and will keep doing so for the whole rewrite track. Run it
//! from the repository root:
//!
//!     .build/irdetbin [-n COUNT] [--all] [-v] [-j JOBS]
//!                     [--python PATH] [--only-files FILE] [--jsonl FILE]

import std.process.{Command}
import std.file.{File}
import std.path.{Path}
import std.directory.{Directory}
import std.data.{Data}
import std.env.{Env}
import std.time.{Instant}

// The named constants below are FUNCTIONS because a `static` may only hold a
// compile-time constant and a String owns a heap buffer (DF-155c). Naming them
// is still the point; the calls fold away.

// Two seeds that produce different `str` hashing. `0` would DISABLE
// randomization, which would mask exactly the class of bug this harness exists
// to catch.
func seed_a() -> String { "1" }
func seed_b() -> String { "424242" }

/// The compiler under test, relative to the repository root.
func sawc_path() -> String { "sawc/sawc.py" }
/// The interpreter that runs it by default. The repo's virtualenv is the one
/// with llvmlite in it; a machine that installed the dependencies globally (CI
/// does) has no virtualenv and falls back to whatever `python3` resolves to.
func venv_python() -> String { ".venv/bin/python" }
func system_python() -> String { "python3" }

/// Where the two per-file compiles put their IR. Checks run in parallel, so each
/// compile gets its own `-o` base here: the default `.build/<stem>` would
/// collide across concurrent tasks, and across two same-stem files in different
/// subdirectories.
func build_dir() -> String { ".build" }
func scratch_dir() -> String { ".build/irdet" }

// How many examples `-n` samples when it is not given a number.
static DEFAULT_COUNT: Int = 40
// How many checks run at once by default. Python read the core count and used
// `min(10, cores - 2)`; Saw has no way to ask (DF-155b), so this is a fixed
// number in the same band — the work is subprocess-bound, so being a little off
// the core count costs little, and `-j` is exact when it matters.
static DEFAULT_JOBS: Int = 8

// Process exit codes. `2` is the usage error every CLI reports.
static EXIT_OK: Int = 0
static EXIT_FAILED: Int = 1
static EXIT_USAGE: Int = 2

/// What one file's two compiles proved.
enum Verdict: UInt8 {
    /// Both compiles produced the same bytes.
    case Ok = 0
    /// The file does not build standalone, so there was no IR to compare.
    case Skip = 1
    /// The two compiles disagreed — a determinism bug.
    case Mismatch = 2
}

extension Verdict {
    /// The name this verdict carries in a `--jsonl` record. It is wire text a
    /// remote worker reads back (design 160), so these three strings are ABI.
    func wire_name(&self) -> String {
        match self {
            case Ok -> "ok",
            case Skip -> "skip",
            case Mismatch -> "mismatch"
        }
    }
}

/// One file's verdict, as it comes back out of a worker task. Every field is
/// `Send`, which is what lets a task carry one across an OS thread.
struct Check {
    verdict: Verdict
    detail: String
}

/// The command line, once it has been understood.
struct Options {
    count: Int
    all: Bool
    verbose: Bool
    plan: Bool
    help: Bool
    jobs: Int
    python: String
    only_files: String?
    jsonl: String?
}

func usage() {
    print("usage: irdet [-n COUNT] [--all] [-v] [-j JOBS] [--python PATH]")
    print("             [--only-files FILE] [--jsonl FILE]")
    print("")
    print("  -n, --count COUNT   how many examples to sample (default {DEFAULT_COUNT})")
    print("  --all               sweep every compilable example instead of sampling")
    print("  -v, --verbose       name each skipped file")
    print("  --plan              print the files this run would check, and stop")
    print("  -j, --jobs N        concurrent checks (default {DEFAULT_JOBS})")
    print("  --python PATH       the interpreter that runs sawc")
    print("  --only-files FILE   check exactly the repo-relative paths listed in")
    print("                      FILE, one per line (how a remote worker is given")
    print("                      its shard)")
    print("  --jsonl FILE        append one JSON record per checked file, flushed")
    print("                      as it lands")
}

/// The interpreter to run `sawc` with: the repo virtualenv when it is there,
/// and the system `python3` otherwise.
func default_python() -> String {
    if File.exists(Path(s: venv_python())) {
        venv_python()
    } else {
        system_python()
    }
}

/// Does `flag` expect the next argument to be its value? Asking BEFORE reaching
/// for that argument is what lets a typo be reported as the unknown option it
/// is, rather than as a missing value for something that does not exist.
func takes_value(flag: String) -> Bool {
    // Parenthesized so the operator may wrap: a newline is insignificant inside
    // `(...)` and ends the statement outside it (design 129).
    (flag == "-n" || flag == "--count" ||
     flag == "-j" || flag == "--jobs" ||
     flag == "--python" || flag == "--only-files" || flag == "--jsonl")
}

/// Parse the command line. `None` means the arguments were unusable and the
/// reason has already been printed; the caller exits 2.
func parse_options(argv: &Vector<String>) -> Options? {
    var count = DEFAULT_COUNT
    var all = false
    var verbose = false
    var plan = false
    var help = false
    var jobs = DEFAULT_JOBS
    var python = default_python()
    var only_files: String? = None
    var jsonl: String? = None

    // argv[0] is this program.
    var i = 1
    while i < argv.len() {
        guard let flag = argv.get(i) else {
            break
        }

        if flag == "--all" {
            all = true
            i = i + 1
        } else if flag == "-v" || flag == "--verbose" {
            verbose = true
            i = i + 1
        } else if flag == "--plan" {
            plan = true
            i = i + 1
        } else if flag == "-h" || flag == "--help" {
            help = true
            i = i + 1
        } else if not takes_value(flag) {
            print("irdet: unknown option `{flag}`")
            usage()
            return None
        } else {
            guard let value = argv.get(i + 1) else {
                print("irdet: {flag} needs a value")
                return None
            }
            if flag == "-n" || flag == "--count" {
                guard let n = value.to_int() else {
                    print("irdet: {flag} needs a number, got `{value}`")
                    return None
                }
                count = n
            } else if flag == "-j" || flag == "--jobs" {
                guard let n = value.to_int() else {
                    print("irdet: {flag} needs a number, got `{value}`")
                    return None
                }
                if n < 1 {
                    print("irdet: {flag} needs at least 1, got {n}")
                    return None
                }
                jobs = n
            } else if flag == "--python" {
                python = value
            } else if flag == "--only-files" {
                only_files = value
            } else {
                jsonl = value
            }
            i = i + 2
        }
    }

    Options(count: count, all: all, verbose: verbose, plan: plan, help: help,
            jobs: jobs, python: python, only_files: only_files, jsonl: jsonl)
}

/// Every tracked `examples/*.saw`, sorted. Asking git rather than walking the
/// tree is what keeps an uncommitted scratch file out of a gate. `None` means
/// git could not answer.
func tracked_examples() -> Vector<String>? {
    var c = Command(program: "git")
    c.arg("ls-files")
    c.arg("examples/*.saw")
    guard let listed = c.output() else {
        return None
    }
    if not listed.success() {
        return None
    }

    let lines = listed.stdout.split("\n")
    var files = Vector<String>()
    var i = 0
    while i < lines.len() {
        if let line = lines.get(i) {
            let trimmed = line.trim()
            if not trimmed.is_empty() {
                files.push(trimmed)
            }
        }
        i = i + 1
    }
    files.sort()
    move files
}

/// The repo-relative paths listed in `path`, one per line — how a remote worker
/// is handed its shard. `None` means the list itself could not be read, which is
/// a failure of the run and not of the compiler.
func read_file_list(path: String) -> Vector<String>? {
    guard let text = read_text(path) else {
        return None
    }
    let lines = text.split("\n")
    var files = Vector<String>()
    var i = 0
    while i < lines.len() {
        if let line = lines.get(i) {
            let trimmed = line.trim()
            if not trimmed.is_empty() {
                files.push(trimmed)
            }
        }
        i = i + 1
    }
    move files
}

/// A whole file as text, or `None` when it could not be read or is not UTF-8.
func read_text(path: String) -> String? {
    var f = match File.open(Path(s: path)) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return None }
    }
    let bytes = match f.read() {
        case Ok(data) -> move data,
        case Err(_) -> { return None }
    }
    match bytes.to_string() {
        case Ok(text) -> text,
        case Err(_) -> None
    }
}

/// Error / skip examples never reach codegen, so they have no IR to compare.
///
/// The rule is the DIRECTIVE the suite itself reads (`test_runner.py`) rather
/// than a path or filename convention — error tests live both in
/// `examples/errors/` and scattered through `examples/`. A file that cannot be
/// read at all counts as one too: there is nothing here to check either way.
func is_negative_test(rel: String) -> Bool {
    guard let text = read_text(rel) else {
        return true
    }
    text.contains("// EXPECT: error") || text.contains("// EXPECT: skip")
}

/// The `-n` sample: an even stride over the sorted list.
///
/// Deterministic BY CONSTRUCTION rather than by a seeded shuffle, so a failure
/// always reproduces, and a stride spreads the sample over the whole tree
/// instead of clustering it — which a random draw only manages on average. Like
/// any fixed sample it rotates only when the corpus changes, which is why the
/// final gate is `--all` and not this (design 141 found two nondeterministic
/// emission orders that had sat in the tree until two unrelated new examples
/// reshuffled the sample onto one of them).
func sample(files: &Vector<String>, count: Int) -> Vector<String> {
    var picked = Vector<String>()
    let total = files.len()
    if count >= total {
        var i = 0
        while i < total {
            if let f = files.get(i) {
                picked.push(f)
            }
            i = i + 1
        }
        return move picked
    }
    var k = 0
    while k < count {
        if let f = files.get(k * total / count) {
            picked.push(f)
        }
        k = k + 1
    }
    move picked
}

/// The `-o` base for one compile: `.build/irdet/<task>_s<seed>_<stem>`. Unique
/// per task AND per seed — see scratch_dir() for why the default base will not do.
func scratch_base(rel: String, seed: String, task_id: Int) -> String {
    let stem = Path(s: rel).stem() ?? "unnamed"
    var out = StringBuilder()
    out.append(scratch_dir())
    out.append("/")
    out.append(task_id)
    out.append("_s")
    out.append(seed)
    out.append("_")
    out.append(stem)
    out.build()
}

/// Compile `rel` to IR in a fresh process; the emitted bytes, or `None` when the
/// file does not build standalone (module-path dependencies, host-only, ...).
func emit_ir(rel: String, seed: String, task_id: Int, python: String) -> Data? {
    let base = scratch_base(rel, seed, task_id)
    var name = StringBuilder()
    name.append(base)
    name.append(".ll")
    let ll = Path(s: name.build())

    // A stale file from an interrupted run must not be mistaken for this one's.
    if File.exists(ll) {
        let _ = File.remove(ll)
    }

    var c = Command(program: python)
    c.arg(sawc_path())
    c.arg(rel)
    c.arg("--emit-ir")
    c.arg("-o")
    c.arg(base)
    // The whole point of the harness: the two compiles differ ONLY in how
    // Python seeds its string hashing.
    c.env("PYTHONHASHSEED", seed)
    // Some of these compiles are expected to fail — that is what a skip IS — and
    // their diagnostics are not ours to print, so they go into the capture with
    // stdout and are dropped with it.
    c.merge_stderr()

    guard let done = c.output() else {
        return None
    }
    if not done.success() {
        return None
    }
    if not File.exists(ll) {
        return None
    }

    var f = match File.open(ll) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return None }
    }
    let bytes = match f.read() {
        case Ok(data) -> move data,
        case Err(_) -> { return None }
    }
    let _ = File.remove(ll)
    move bytes
}

/// Byte-for-byte equality — the whole verdict.
func same_bytes(a: &Data, b: &Data) sync -> Bool {
    let n = a.len()
    if n != b.len() {
        return false
    }
    var i = 0
    while i < n {
        if a[i] != b[i] {
            return false
        }
        i = i + 1
    }
    true
}

/// Check one file. The two seed compiles stay SEQUENTIAL inside the task; the
/// parallelism is across files, which are independent.
func check_one(index: Int, rel: String, python: String) -> Check {
    var first = emit_ir(rel, seed_a(), index, python)
    if let a = move first {
        var second = emit_ir(rel, seed_b(), index, python)
        if let b = move second {
            if same_bytes(&a, &b) {
                Check(verdict: Verdict.Ok, detail: "")
            } else {
                Check(verdict: Verdict.Mismatch,
                      detail: "{a.len()} vs {b.len()} bytes")
            }
        } else {
            Check(verdict: Verdict.Skip, detail: "")
        }
    } else {
        Check(verdict: Verdict.Skip, detail: "")
    }
}

/// A string as a JSON scalar body. Only the two characters JSON forbids raw need
/// touching; a repo-relative path and a byte-count detail contain neither, but a
/// record that is not valid JSON would be read back as a missing verdict rather
/// than as a bug here.
func json_escaped(s: String) -> String {
    s.replace("\\", "\\\\").replace("\"", "\\\"")
}

/// Append one JSON record for a checked file, flushed as it lands.
///
/// A remote test worker (design 160) TAILS this file while the check is still
/// running, which is what makes a shard stream its verdicts back instead of
/// arriving in one lump at the end — so the record has to be on disk by the time
/// this returns, and the keys have to be the ones the worker reads. They are
/// written in sorted order, matching what the Python tool emitted.
func append_record(path: String, rel: String, result: &Check) {
    var line = StringBuilder()
    line.append("\{\"detail\": \"")
    line.append(json_escaped(result.detail))
    line.append("\", \"kind\": \"file\", \"path\": \"")
    line.append(json_escaped(rel))
    line.append("\", \"status\": \"")
    line.append(result.verdict.wire_name())
    line.append("\"\}\n")

    var f = match File.open_append(Path(s: path)) {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("irdet: cannot write {path}: {e}")
            return
        }
    }
    match f.write(line.build().to_data()) {
        case Ok(_) -> {},
        case Err(e) -> print("irdet: cannot write {path}: {e}")
    }
}

func main() -> Int {
    let argv = Env.args()
    guard let opts = parse_options(&argv) else {
        return EXIT_USAGE
    }
    // Asking for the usage message is not a usage ERROR.
    if opts.help {
        usage()
        return EXIT_OK
    }

    // The file set: a worker's shard verbatim, or the tracked examples with the
    // negative tests filtered out.
    var files = Vector<String>()
    if let listed = opts.only_files {
        guard let shard = read_file_list(listed) else {
            print("irdet: cannot read the file list `{listed}`")
            return EXIT_FAILED
        }
        files = move shard
    } else {
        guard let tracked = tracked_examples() else {
            print("irdet: `git ls-files` failed")
            return EXIT_FAILED
        }
        var candidates = Vector<String>()
        var i = 0
        while i < tracked.len() {
            if let rel = tracked.get(i) {
                if not is_negative_test(rel) {
                    candidates.push(rel)
                }
            }
            i = i + 1
        }
        if opts.all {
            files = move candidates
        } else {
            files = sample(&candidates, opts.count)
        }
    }

    // `--plan` prints the file set and checks nothing. Which examples are
    // negative tests is THIS tool's rule, so anything that needs to split the
    // corpus (the two-machine driver, tools/irdet_remote.py) asks rather than
    // reimplementing it — two copies of the rule would be two rules.
    if opts.plan {
        var p = 0
        while p < files.len() {
            if let rel = files.get(p) {
                print(rel)
            }
            p = p + 1
        }
        return EXIT_OK
    }

    // Both levels: `.build` may not exist yet either. An Err here is almost
    // always "it is already there", which is the state we wanted.
    let _ = Directory.create(Path(s: build_dir()))
    let _ = Directory.create(Path(s: scratch_dir()))

    let started = Instant.now()

    // Files are independent, so the checks fan out; each task's work is two
    // subprocesses, so the workers spend their time waiting rather than
    // competing for the CPU.
    var group = TaskGroup(threads: opts.jobs)
    var spawned = Vector<TaskHandle<Check>>()
    var i = 0
    while i < files.len() {
        guard let rel = files.get(i) else {
            break
        }
        let h = group.spawn(check_one(i, rel, opts.python))
        spawned.push(move h)
        i = i + 1
    }

    // Handles are move-only, so they come back out by popping. Draining into a
    // second vector reverses the order once, and popping THAT walks the files in
    // input order — which is what keeps the report, the JSONL stream and the
    // exit status independent of which task happened to finish first.
    var pending = Vector<TaskHandle<Check>>()
    while spawned.len() > 0 {
        if let h = spawned.pop() {
            pending.push(move h)
        }
    }

    var checked = 0
    var skipped = 0
    var mismatched = 0
    var index = 0
    while pending.len() > 0 {
        guard let handle = pending.pop() else {
            break
        }
        let result = handle.join()
        let rel = files.get(index) ?? "<unknown>"

        match result.verdict {
            case Ok -> { checked = checked + 1 },
            case Skip -> {
                skipped = skipped + 1
                if opts.verbose {
                    print("  skip (does not build standalone): {rel}")
                }
            },
            case Mismatch -> {
                checked = checked + 1
                mismatched = mismatched + 1
                print("  MISMATCH: {rel} ({result.detail})")
            }
        }
        if let sink = opts.jsonl {
            append_record(sink, rel, &result)
        }
        index = index + 1
    }

    let elapsed = started.elapsed().as_millis()
    let whole = elapsed / 1000
    let tenths = (elapsed % 1000) / 100
    print("irdet: compiled {checked} example(s) twice under differing PYTHONHASHSEED ({skipped} skipped, {whole}.{tenths}s)")

    if mismatched > 0 {
        print("irdet: {mismatched} file(s) produced NON-REPRODUCIBLE IR")
        return EXIT_FAILED
    }
    if checked == 0 {
        // A compile failure counts as a skip, so an interpreter without llvmlite
        // skips the entire corpus — and this used to print OK, a final gate
        // reporting success having verified nothing.
        print("irdet: NOTHING WAS CHECKED -- every candidate failed to compile.")
        print("irdet: the interpreter running sawc was `{opts.python}`; point")
        print("irdet: --python at one that can import llvmlite.")
        return EXIT_FAILED
    }
    print("irdet: OK -- every sampled example compiled to byte-identical IR")
    EXIT_OK
}
