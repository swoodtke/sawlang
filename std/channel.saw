//! `Channel<T>`: an unbounded queue of messages between tasks.
//!
//! A `Channel` is a `Copy` handle onto one shared queue: copying the handle
//! shares the queue, and the last handle to drop destroys whatever is still
//! queued and frees it. Any holder may send, receive or close.
//!
//! ```saw-fragment
//! import std.channel.{Channel}
//!
//! func produce(orders: Channel<Int>) {
//!     try! orders.send(7)
//!     try! orders.close()            // the producer says it is finished
//! }
//!
//! func consume(orders: Channel<Int>) -> Int {
//!     var total = 0
//!     var going = true
//!     while going {
//!         match orders.receive() {
//!             case Ok(order) -> { total = total + order },
//!             case Err(_) -> { going = false }   // closed and drained
//!         }
//!     }
//!     total
//! }
//! ```
//!
//! In a task, `receive` suspends the task, never the thread: a waiting
//! receiver parks on the channel's readiness word and costs nothing until a
//! `send` or a `close` on that channel sets it. In thread context, a
//! `Thread.spawn` body or a `blocking` function, the same call blocks the
//! calling thread instead (a pair: spec, Blocking functions). Disconnection is
//! explicit, since a handle carries no sender or receiver role and so no count
//! of producers exists: a channel nobody closes and nobody sends to is a
//! deadlock.

import std.mem.{drop_in_place}
import std.systemerror.{SystemError}
import std.task.{__saw_park_channel}
import std.taskgroup.{__saw_exec_chan_wake}

extern "C" {
    // The runtime's one-word lock, zero = unlocked (runtime/ABI.md).
    func __saw_rt_lock_acquire(state: UnsafePointer<Int>)
    func __saw_rt_lock_release(state: UnsafePointer<Int>)
    // 0, or the negated portable tag of a refused initialization
    // (runtime/ABI.md).
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<UInt8>) -> Int
    func __saw_rt_pthread_cond_init_default(c: UnsafePointer<UInt8>) -> Int
    func pthread_mutex_lock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_unlock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_destroy(m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_wait(c: UnsafePointer<UInt8>, m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_broadcast(c: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_destroy(c: UnsafePointer<UInt8>) -> Int32
}

// The block and every queue node are allocated at this alignment, which no
// message type exceeds. A refused allocation reports the request as made:
// the size is the node's or the block's own `sizeof`.
static CHANNEL_ALIGN: Int = 16

// A thread blocked in `receive` waits on a mutex and a condition variable, each
// in a conservative slot of this many bytes: `pthread_mutex_t` is 64 bytes
// at most on the hosted targets, and `pthread_cond_t` 48 (runtime/ABI.md).
static CHANNEL_GATE_SLOT: Int = 64

// The block every handle of one channel points at. Every field but
// `refcount` is read and written under `lock`; `refcount` is atomic.
//
// `ready` is the readiness word: a receiver parks on it by its negated
// address, and the executor resumes the receiver once it is nonzero, so a
// send wakes only this channel's receivers. Invariant, kept under `lock`:
// `ready != 0` exactly when `count > 0` or `closed` (design 230).
//
// `head` and `tail` are meaningful only while `count > 0`.
//
// `gate` is the mutex and condition variable a thread blocked in `receive`
// waits on, made by the first such wait, or null; `waiters` counts
// the threads waiting there, and is atomic (`wait_ready`).
struct ChannelBlock<T> {
    lock: Int
    refcount: Int
    count: Int
    head: UnsafePointer<ChannelNode<T>>
    tail: UnsafePointer<ChannelNode<T>>
    ready: Int
    closed: Bool
    gate: UnsafePointer<UInt8>
    waiters: Int
}

// One queued message. `next` is meaningful only for a node that is not the
// tail.
struct ChannelNode<T> {
    next: UnsafePointer<ChannelNode<T>>
    value: T
}

/// Why a channel operation could not be carried out.
///
/// `Closed` is reported by `receive` once a closed channel has been drained,
/// and by `send` and `close` on a channel that is already closed. `Cancelled`
/// is reported by `receive` when the waiting task was cancelled. `Alloc`
/// carries the allocator's own refusal when a queue node or a blocked
/// receiver's gate cannot be made. `System` carries the operating system's
/// refusal of that gate's lock.
public enum ChannelError {
    /// The channel was closed with `close()` and, for `receive`, drained.
    case Closed,
    /// The waiting task was cancelled. `receive` reports it before it looks at
    /// the queue, so a cancelled consumer stops rather than taking one more
    /// message; nothing is dequeued and the channel is untouched.
    case Cancelled,
    /// The allocator refused memory the channel needed, with the size and
    /// alignment it was asked for: a queue node for `send`, or the gate a
    /// thread blocked in `receive` waits on.
    case Alloc(e: AllocError),
    /// The operating system refused the mutex or condition variable that a
    /// thread blocked in `receive` waits on, naming the operation and why.
    /// Nothing is dequeued, and a later `receive` tries again.
    case System(e: SystemError)
}

extension ChannelError {
    /// Returns a short description of the failure.
    public func describe(&self) -> String {
        match self {
            case Closed -> "channel is closed",
            case Cancelled -> "the receiving task was cancelled",
            case Alloc(_) -> "the channel could not allocate memory",
            case System(_) -> "the operating system refused the channel's lock"
        }
    }
}

extension ChannelError: Printable {
    /// Writes the description, followed by the allocator's refusal for
    /// `Alloc` and the operating system's for `System`.
    public func format(&self, into: &var StringBuilder) {
        match self {
            case Alloc(e) -> {
                try! into.append(self.describe())
                try! into.append(": ")
                e.format(into: &var into)
            },
            case System(e) -> {
                try! into.append(self.describe())
                try! into.append(": ")
                e.format(into: &var into)
            },
            case _ -> try! into.append(self.describe())
        }
    }
}

extension ChannelError: Error {}

/// A handle onto an unbounded queue of `T` messages, shared by every copy of
/// the handle.
///
/// Copying a handle is a refcount increment. `T` must be `Send`, since a
/// message may be received on another thread than the one that sent it.
public struct Channel<T: Send> {
    private block: UnsafePointer<ChannelBlock<T>>
}

// A handle points at a block whose queue is guarded by its own lock and whose
// count is atomic, so it may cross threads whenever its messages may.
extension Channel<T: Send>: UnsafeSend {}
extension Channel<T: Send>: UnsafeSync {}

extension Channel<T: Send> {
    /// Creates an empty, open channel.
    ///
    /// Returns `Err(AllocError)` when the allocator refuses the queue's block.
    public init() unsafe -> Result<Channel<T>, AllocError> {
        let size = sizeof<ChannelBlock<T>>()
        guard let raw = GlobalAllocator().alloc(size, CHANNEL_ALIGN) else {
            return AllocError(size: size, align: CHANNEL_ALIGN)
        }
        let block = raw as UnsafePointer<ChannelBlock<T>>
        let none = 0 as UnsafePointer<ChannelNode<T>>
        block[0] = ChannelBlock<T>(lock: 0, refcount: 1, count: 0, head: none, tail: none, ready: 0,
                                   closed: false, gate: 0 as UnsafePointer<UInt8>, waiters: 0)
        Channel<T>(block: block)
    }

    /// Enqueues `v`, waking the receivers waiting on this channel.
    ///
    /// `v` is consumed whatever the answer. The two failures leave the queue
    /// as it was, and `v` is destroyed:
    ///
    /// - `Err(Closed)`: the channel has been closed.
    /// - `Err(Alloc(e))`: the allocator refused the queue node.
    public func send(&self, v: T) -> Result<Void, ChannelError> {
        self.enqueue(move v)
    }

    /// Closes the channel: no further message is accepted, and every receiver
    /// waiting on it is woken.
    ///
    /// Messages already queued are not lost: a receive hands them out before
    /// it reports `Closed`. Closing a channel that is already closed returns
    /// `Err(Closed)`, so a close that races another one can be ignored with
    /// `let _ =` without being silent.
    public func close(&self) unsafe -> Result<Void, ChannelError> {
        let block = self.block
        self.lock_queue()
        if block[0].closed {
            self.unlock_queue()
            return ChannelError.Closed
        }
        block[0].closed = true
        self.publish_ready()
        self.unlock_queue()
        __saw_exec_chan_wake()
        self.wake_threads()
        return
    }

    /// Takes the next message if one is queued, answering at once either way.
    ///
    /// - `Ok(Some(v))`: a message, dequeued.
    /// - `Ok(None)`: nothing yet. Would-block is the normal answer to a poll,
    ///   not an error.
    /// - `Err(Closed)`: the channel is closed and drained, so no message will
    ///   ever arrive.
    ///
    /// Never suspends; `receive()` is the spelling that waits.
    public func try_receive(&self) unsafe -> Result<T?, ChannelError> {
        var drained = false
        let got = self.take(&var drained)
        if drained {
            return ChannelError.Closed
        }
        return move got
    }

    /// Waits for the next message.
    ///
    /// A task suspends while the queue is empty, and its executor's thread
    /// runs the other tasks meanwhile. In a `Thread.spawn` body or a
    /// `blocking` function the call blocks the calling thread instead. A
    /// `main` that calls it suspends, and so runs the executor.
    ///
    /// - `Ok(v)`: a message, dequeued.
    /// - `Err(Closed)`: the channel has been closed and everything queued
    ///   before the close has been handed out, so no message will arrive.
    /// - `Err(Cancelled)`: the waiting task was cancelled. A cancelled receive
    ///   dequeues nothing.
    /// - `Err(Alloc(e))`: the allocator refused the gate a blocked thread
    ///   waits on.
    /// - `Err(System(e))`: the operating system refused that gate's mutex or
    ///   condition variable.
    ///
    /// The two refusals leave the queue as it was, and the next receive tries
    /// the gate again. A channel nobody closes and nobody sends to never wakes
    /// its receiver.
    public func receive(&self) -> Result<T, ChannelError> {
        // The cancel check comes first on every pass, ahead of the queue
        // read, so a consumer that is stopping takes no further message.
        while not cancelled() {
            var drained = false
            if let v = self.take(&var drained) {
                return move v
            }
            if drained {
                return ChannelError.Closed
            }
            __saw_park_channel(self.park_word())
        }
        return ChannelError.Cancelled
    }

    public func receive(&self) blocking -> Result<T, ChannelError> {
        var drained = false
        var got = self.take(&var drained)
        while got.is_none() && not drained {
            try self.wait_ready()
            got = self.take(&var drained)
        }
        guard let v = move got else {
            return ChannelError.Closed
        }
        move v
    }

    // Blocks this thread until the readiness word is set. The waiter counts
    // itself and then reads the word, and a writer publishes the word and
    // then reads the count (`wake_threads`), all sequentially consistent, so
    // a writer that counts no waiter wrote a word the waiter's read sees. A
    // writer that counts one broadcasts under the gate's mutex, which the
    // waiter holds from its read until the wait releases it, so the
    // broadcast cannot fall between the two.
    func wait_ready(&self) unsafe -> Result<Void, ChannelError> {
        let block = self.block
        let gate = try self.open_gate()
        let cond = ((gate as Int) + CHANNEL_GATE_SLOT) as UnsafePointer<UInt8>
        let waiters = (&block[0].waiters) as UnsafePointer<Int>
        let word = (&block[0].ready) as UnsafePointer<Int>
        let _ = pthread_mutex_lock(gate)
        let _ = __saw_atomic_add_i64_seq_cst(waiters, 1)
        while __saw_atomic_load_i64_seq_cst(word) == 0 {
            let _ = pthread_cond_wait(cond, gate)
        }
        let _ = __saw_atomic_add_i64_seq_cst(waiters, -1)
        let _ = pthread_mutex_unlock(gate)
        return
    }

    // The gate a blocked `receive` waits on, made under the queue's lock by
    // the first wait. Its store happens before that waiter counts itself, so
    // a writer that counts a waiter finds the gate made. A refusal releases
    // the lock and frees what was made, leaving no gate, so the next wait
    // tries again.
    func open_gate(&self) unsafe -> Result<UnsafePointer<UInt8>, ChannelError> {
        let block = self.block
        self.lock_queue()
        if (block[0].gate as Int) == 0 {
            let size = 2 * CHANNEL_GATE_SLOT
            guard let raw = GlobalAllocator().alloc(size, CHANNEL_ALIGN) else {
                self.unlock_queue()
                return ChannelError.Alloc(e: AllocError(size: size, align: CHANNEL_ALIGN))
            }
            let gate = raw as UnsafePointer<UInt8>
            let mutex_status = __saw_rt_pthread_mutex_init_default(gate)
            if mutex_status != 0 {
                let failure = SystemError.of("pthread_mutex_init", 0 - mutex_status)
                GlobalAllocator().dealloc(raw as UnsafePointer<Int8>, size, CHANNEL_ALIGN)
                self.unlock_queue()
                return ChannelError.System(e: move failure)
            }
            let cond = ((gate as Int) + CHANNEL_GATE_SLOT) as UnsafePointer<UInt8>
            let cond_status = __saw_rt_pthread_cond_init_default(cond)
            if cond_status != 0 {
                let failure = SystemError.of("pthread_cond_init", 0 - cond_status)
                let _ = pthread_mutex_destroy(gate)
                GlobalAllocator().dealloc(raw as UnsafePointer<Int8>, size, CHANNEL_ALIGN)
                self.unlock_queue()
                return ChannelError.System(e: move failure)
            }
            block[0].gate = gate
        }
        let made = block[0].gate
        self.unlock_queue()
        made
    }

    // Wakes every thread blocked in `receive` on this channel, after a change
    // to the readiness word: nothing to do unless one waits (`wait_ready`).
    //
    // ENTRY POINTS:
    //   close
    //   enqueue
    func wake_threads(&self) unsafe {
        let block = self.block
        let waiters = (&block[0].waiters) as UnsafePointer<Int>
        if __saw_atomic_load_i64_seq_cst(waiters) == 0 {
            return
        }
        let gate = block[0].gate
        let cond = ((gate as Int) + CHANNEL_GATE_SLOT) as UnsafePointer<UInt8>
        let _ = pthread_mutex_lock(gate)
        let _ = pthread_cond_broadcast(cond)
        let _ = pthread_mutex_unlock(gate)
    }

    // The park word a receiver records: the readiness word's negated address.
    // A word is 8-aligned and never at address 0, so the value is below -1,
    // apart from every other park word (std.taskgroup).
    func park_word(&self) unsafe -> Int {
        let block = self.block
        0 - ((&block[0].ready) as UnsafePointer<Int> as Int)
    }

    // The head message, or `None` when the queue is empty. `drained` is set
    // when the queue is empty and closed, read under the same lock as the
    // emptiness, so a racing `send` or `close` cannot make the two disagree.
    func take(&self, drained: &var Bool) unsafe -> T? {
        let block = self.block
        self.lock_queue()
        if block[0].count == 0 {
            drained = block[0].closed
            self.unlock_queue()
            return None
        }
        let node = block[0].head
        let at = (&node[0].value) as UnsafePointer<T>
        let value = move at[0]
        block[0].count -= 1
        if block[0].count > 0 {
            block[0].head = node[0].next
        }
        self.publish_ready()
        self.unlock_queue()
        free_node(node)
        move value
    }

    // Links `v` at the tail. A closed channel and a refused node leave the
    // queue untouched, and `v`, unmoved, is destroyed at the return.
    func enqueue(&self, v: T) unsafe -> Result<Void, ChannelError> {
        let block = self.block
        self.lock_queue()
        if block[0].closed {
            self.unlock_queue()
            return ChannelError.Closed
        }
        let size = sizeof<ChannelNode<T>>()
        guard let raw = GlobalAllocator().alloc(size, CHANNEL_ALIGN) else {
            self.unlock_queue()
            return ChannelError.Alloc(e: AllocError(size: size, align: CHANNEL_ALIGN))
        }
        let node = raw as UnsafePointer<ChannelNode<T>>
        node[0] = ChannelNode<T>(next: 0 as UnsafePointer<ChannelNode<T>>, value: move v)
        if block[0].count == 0 {
            block[0].head = node
        } else {
            let last = block[0].tail
            last[0].next = node
        }
        block[0].tail = node
        block[0].count += 1
        self.publish_ready()
        self.unlock_queue()
        // A receiver's executor may be blocked in the reactor's poll on
        // another thread, and sees the word only once that wait ends.
        __saw_exec_chan_wake()
        self.wake_threads()
        return
    }

    // The one place the readiness invariant is written, with the lock held,
    // after every change to what a waiting receiver would find. The executor
    // reads the word without the lock, maybe on another thread, so the store
    // is atomic and pairs with `park_wakes`' load (std.taskgroup).
    //
    // ENTRY POINTS:
    //   close
    //   enqueue
    //   take
    func publish_ready(&self) unsafe {
        let block = self.block
        let word = (&block[0].ready) as UnsafePointer<Int>
        if block[0].count > 0 || block[0].closed {
            __saw_atomic_store_i64_seq_cst(word, 1)
        } else {
            __saw_atomic_store_i64_seq_cst(word, 0)
        }
    }

    func lock_queue(&self) unsafe {
        let block = self.block
        __saw_rt_lock_acquire((&block[0].lock) as UnsafePointer<Int>)
    }

    func unlock_queue(&self) unsafe {
        let block = self.block
        __saw_rt_lock_release((&block[0].lock) as UnsafePointer<Int>)
    }
}

// Frees a node whose value has been moved out or destroyed.
func free_node<T>(node: UnsafePointer<ChannelNode<T>>) unsafe {
    GlobalAllocator().dealloc(node as UnsafePointer<Int8>, sizeof<ChannelNode<T>>(), CHANNEL_ALIGN)
}

/// `Channel` copies by reference count.
extension Channel<T: Send>: Copy {
    /// Releases this handle. The last handle destroys every message still
    /// queued and frees the queue.
    public func deinit(&var self) unsafe {
        let block = self.block
        let old = __saw_atomic_sub_i64_release((&block[0].refcount) as UnsafePointer<Int>, 1)
        if old < 1 {
            panic("over-release of a Channel handle (refcount underflow)")
        }
        if old == 1 {
            // Every other handle's last use happens-before the teardown, and
            // no handle survives to take the lock.
            __saw_atomic_fence_acquire()
            while block[0].count > 0 {
                let node = block[0].head
                drop_in_place((&node[0].value) as UnsafePointer<T>)
                block[0].count -= 1
                if block[0].count > 0 {
                    block[0].head = node[0].next
                }
                free_node(node)
            }
            let gate = block[0].gate
            if (gate as Int) != 0 {
                let cond = ((gate as Int) + CHANNEL_GATE_SLOT) as UnsafePointer<UInt8>
                let _ = pthread_cond_destroy(cond)
                let _ = pthread_mutex_destroy(gate)
                GlobalAllocator().dealloc(gate as UnsafePointer<Int8>, 2 * CHANNEL_GATE_SLOT, CHANNEL_ALIGN)
            }
            GlobalAllocator().dealloc(block as UnsafePointer<Int8>, sizeof<ChannelBlock<T>>(),
                                      CHANNEL_ALIGN)
        }
    }

    /// Retains the queue and returns a second handle to it.
    public func copy(&self) unsafe -> Channel<T> {
        let block = self.block
        // A live handle keeps the block alive, so monotonic is enough.
        let _ = __saw_atomic_add_i64((&block[0].refcount) as UnsafePointer<Int>, 1)
        Channel<T>(block: block)
    }
}
