//! `Env`: the program's command-line arguments, and its executable's path.

import std.string.{string_from_bytes}
import std.systemerror.{SystemError, SystemErrorKind}
import std.utf8.{utf8_error_offset}

// The `argc` and `argv` the C entry received, which the compiler keeps for
// the program (sawc/rt/ABI.md, "Program arguments").
extern "C" {
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>
    // The running executable's path, as macOS records it (dyld(3)), and the
    // path with every symbolic link resolved, in a buffer realpath(3) mallocs.
    func _NSGetExecutablePath(buf: UnsafePointer<Int8>, size: UnsafePointer<UInt32>) -> Int32
    func realpath(path: UnsafePointer<Int8>, resolved: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
}

/// The program's environment, as static methods; never constructed.
public struct Env {
    private unused: Int
}

extension Env {
    /// Returns every command-line argument, in order, the program's own name
    /// first.
    ///
    /// Returns `Err(AllocError)` when the vector cannot grow. Panics if an
    /// argument is not valid UTF-8, which no `String` may hold, or if the
    /// allocator refuses an argument's `String`.
    public static func args() -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let count = Env.argument_count()
        var i = 0
        while i < count {
            try result.push(Env.argument(i))
            i = i + 1
        }
        return move result
    }

    /// Returns the running program's executable file, as an absolute path
    /// with every symbolic link resolved.
    ///
    /// It names the file the program runs from however it was started: by a
    /// bare name found through `PATH`, or through a symbolic link, where the
    /// first argument names neither. Returns `Err(SystemError)`, of kind
    /// `Unknown` when the path cannot be read or resolved, as when the file
    /// was removed while the program runs, and `ResourcesExhausted` when the
    /// path's buffer cannot be allocated. Panics if the path is not valid
    /// UTF-8.
    /// macOS only: the path comes from `_NSGetExecutablePath`.
    public static func executable_path() unsafe -> Result<String, SystemError> {
        var size: UInt32 = 0
        let none = 0 as UnsafePointer<Int8>
        let _ = _NSGetExecutablePath(none, (&size) as UnsafePointer<UInt32>)
        guard let buffer = malloc((size as Int) + 1) else {
            return SystemError.raised("executable_path", SystemErrorKind.ResourcesExhausted)
        }
        // A failure here is `Unknown`, with no errno read: std sees only the
        // tags a runtime op returns, never errno after a bare libc call
        // (sawc/rt/ABI.md), and for the running binary's own file it means the
        // file went away while it runs, which no caller handles by its cause.
        if _NSGetExecutablePath(buffer, (&size) as UnsafePointer<UInt32>) != 0 {
            free(buffer)
            return SystemError.raised("executable_path", SystemErrorKind.Unknown)
        }
        guard let resolved = realpath(buffer, none) else {
            free(buffer)
            return SystemError.raised("realpath", SystemErrorKind.Unknown)
        }
        free(buffer)
        let length = c_string_length(resolved)
        if let offset = utf8_error_offset(resolved, length) {
            free(resolved)
            panic("Env.executable_path: the path is not valid UTF-8 (byte {})", offset)
        }
        let text = string_from_bytes(resolved, length)
        free(resolved)
        return text
    }

    static func argument_count() -> Int {
        __saw_rt_get_argc() as Int
    }

    // The argument at `index` as a new `String`. Panics if `index` is outside
    // `0..<argument_count()` or the argument is not UTF-8.
    static func argument(index: Int) unsafe -> String {
        let count = Env.argument_count()
        if index < 0 || index >= count {
            panic("Env.argument: index out of range: {} (count {})", index, count)
        }
        let argv = __saw_rt_get_argv()
        let text = argv[index]
        let length = c_string_length(text)
        if let offset = utf8_error_offset(text, length) {
            panic("Env.args: argument {} is not valid UTF-8 (byte {})", index, offset)
        }
        string_from_bytes(text, length)
    }
}

// The number of bytes before the NUL that ends the C string at `text`.
func c_string_length(text: UnsafePointer<Int8>) unsafe -> Int {
    var n = 0
    while text[n] != 0 {
        n = n + 1
    }
    n
}
