//! `Env`: the program's command-line arguments.

import std.string.{string_from_bytes}
import std.utf8.{utf8_error_offset}

// The `argc` and `argv` the C entry received, which the compiler keeps for
// the program (sawc/rt/ABI.md, "Program arguments").
extern "C" {
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>
}

/// The program's environment, as static methods; never constructed.
public struct Env {
    private unused: Int
}

extension Env {
    /// Returns every command-line argument, in order, the program's own name
    /// first.
    ///
    /// Returns `Err(AllocError)` when the vector cannot grow. Panics if an
    /// argument is not valid UTF-8, which no `String` may hold, or if the
    /// allocator refuses an argument's `String`.
    public static func args() -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let count = Env.argument_count()
        var i = 0
        while i < count {
            try result.push(Env.argument(i))
            i = i + 1
        }
        return move result
    }

    static func argument_count() -> Int {
        __saw_rt_get_argc() as Int
    }

    // The argument at `index` as a new `String`. Panics if `index` is outside
    // `0..<argument_count()` or the argument is not UTF-8.
    static func argument(index: Int) unsafe -> String {
        let count = Env.argument_count()
        if index < 0 || index >= count {
            panic("Env.argument: index out of range: {} (count {})", index, count)
        }
        let argv = __saw_rt_get_argv()
        let text = argv[index]
        let length = c_string_length(text)
        if let offset = utf8_error_offset(text, length) {
            panic("Env.args: argument {} is not valid UTF-8 (byte {})", index, offset)
        }
        string_from_bytes(text, length)
    }
}

// The number of bytes before the NUL that ends the C string at `text`.
func c_string_length(text: UnsafePointer<Int8>) unsafe -> Int {
    var n = 0
    while text[n] != 0 {
        n = n + 1
    }
    n
}
