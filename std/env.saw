//! `Env`: the program's command-line arguments, its environment variables,
//! and its executable's path.

import std.path.{Path}
import std.string.{string_from_bytes}
import std.systemerror.{SystemError, SystemErrorKind}
import std.utf8.{utf8_error_offset}

// The `argc` and `argv` the C entry received, which the compiler keeps for
// the program (runtime/ABI.md, "Program arguments").
extern "C" {
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>
    // The running executable's resolved path in a buffer the caller frees, or
    // NULL; where a host finds it is the runtime's business (runtime/ABI.md,
    // "The executable's path").
    func __saw_rt_executable_path() -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func getenv(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    // Each returns 0, or a negated portable tag (runtime/ABI.md).
    func __saw_rt_env_set(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int) -> Int
    func __saw_rt_env_unset(name: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_chdir(path: UnsafePointer<Int8>) -> Int
    // The working directory in a buffer the caller frees, or NULL with the
    // positive tag stored through `status_out` (runtime/ABI.md).
    func __saw_rt_fs_getcwd(status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?
}

/// The program's environment, as static methods; never constructed.
public struct Env {
    private unused: Int
}

extension Env {
    /// Returns every command-line argument, in order, the program's own name
    /// first.
    ///
    /// Returns `Err(AllocError)` when the vector cannot grow. Panics if an
    /// argument is not valid UTF-8, which no `String` may hold, or if the
    /// allocator refuses an argument's `String`.
    public static func args() -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let count = Env.argument_count()
        var i = 0
        while i < count {
            if let text = Env.argument(i) {
                try result.push(text)
            }
            i = i + 1
        }
        return move result
    }

    /// Returns the running program's executable file, as an absolute path
    /// with every symbolic link resolved.
    ///
    /// It names the file the program runs from however it was started: by a
    /// bare name found through `PATH`, or through a symbolic link, where the
    /// first argument names neither. Returns `Err(SystemError)` of kind
    /// `Unknown` when the path cannot be read, resolved or allocated: when
    /// the file was removed while the program runs, on Linux too, where its
    /// link then reads `… (deleted)`; and on a target with no executable
    /// file, such as a kernel. Panics if the path is not valid UTF-8.
    public static func executable_path() unsafe -> Result<String, SystemError> {
        // NULL is `Unknown`, with no errno read: std sees only the tags a
        // runtime op returns, never errno after the fact (runtime/ABI.md), and
        // for the running binary's own file no caller handles it by its cause.
        guard let resolved = __saw_rt_executable_path() else {
            return SystemError.raised("executable_path", SystemErrorKind.Unknown)
        }
        let length = c_string_length(resolved)
        if let offset = utf8_error_offset(resolved, length) {
            free(resolved)
            panic("Env.executable_path: the path is not valid UTF-8 (byte {})", offset)
        }
        let text = string_from_bytes(resolved, length)
        free(resolved)
        return text
    }

    /// Returns how many command-line arguments there are, the program's own
    /// name included.
    public static func argument_count() -> Int {
        __saw_rt_get_argc() as Int
    }

    /// Returns the argument at `index`, or `None` when `index` is outside
    /// `0..<argument_count()`. Panics if the argument is not valid UTF-8,
    /// which no `String` may hold.
    public static func argument(index: Int) unsafe -> String? {
        if index < 0 || index >= Env.argument_count() {
            return None
        }
        let argv = __saw_rt_get_argv()
        let text = argv[index]
        let length = c_string_length(text)
        if let offset = utf8_error_offset(text, length) {
            panic("Env.args: argument {} is not valid UTF-8 (byte {})", index, offset)
        }
        string_from_bytes(text, length)
    }

    /// Returns the value of the environment variable `name`, or `None` when
    /// it is not set. Panics if the value is not valid UTF-8.
    public static func get(name: String) unsafe -> String? {
        if name.index_of(0).is_some() {
            return None
        }
        guard let value = getenv(name.c_bytes()) else {
            return None
        }
        let length = c_string_length(value)
        if let offset = utf8_error_offset(value, length) {
            panic("Env.get: the value is not valid UTF-8 (byte {})", offset)
        }
        string_from_bytes(value, length)
    }

    /// Returns whether the environment variable `name` is set, even to an
    /// empty value.
    public static func contains(name: String) unsafe -> Bool {
        if name.index_of(0).is_some() {
            return false
        }
        if let _ = getenv(name.c_bytes()) {
            true
        } else {
            false
        }
    }

    /// Sets the environment variable `name` to `value`, replacing a value
    /// already there unless `overwrite` is false, which leaves it and still
    /// succeeds.
    ///
    /// Returns `Err(SystemError)` with the reason setenv(3) refused: an empty
    /// name, or one holding `=`, is `InvalidArgument`, as is any text holding
    /// a NUL byte, which no environment entry can.
    public static func set(name: String, value: String, overwrite: Bool = true) unsafe -> Result<Void, SystemError> {
        if name.index_of(0).is_some() || value.index_of(0).is_some() {
            return SystemError.raised("setenv", SystemErrorKind.InvalidArgument)
        }
        let flag = if overwrite { 1 } else { 0 }
        let status = __saw_rt_env_set(name.c_bytes(), value.c_bytes(), flag)
        if status != 0 {
            return SystemError.of("setenv", 0 - status)
        }
        return
    }

    /// Removes the environment variable `name`; removing one that is not set
    /// succeeds.
    ///
    /// Returns `Err(SystemError)` with the reason unsetenv(3) refused: an
    /// empty name, or one holding `=` or a NUL byte, is `InvalidArgument`.
    public static func unset(name: String) unsafe -> Result<Void, SystemError> {
        if name.index_of(0).is_some() {
            return SystemError.raised("unsetenv", SystemErrorKind.InvalidArgument)
        }
        let status = __saw_rt_env_unset(name.c_bytes())
        if status != 0 {
            return SystemError.of("unsetenv", 0 - status)
        }
        return
    }

    /// Returns the process's current working directory.
    ///
    /// Returns `Err(SystemError)` with the reason getcwd(3) failed, such as
    /// `NotFound` when the directory was removed or `PermissionDenied` when a
    /// directory above it cannot be read. Panics if the path is not valid
    /// UTF-8.
    public static func cwd() unsafe -> Result<Path, SystemError> {
        var status = 0
        guard let found = __saw_rt_fs_getcwd((&status) as UnsafePointer<Int>) else {
            return SystemError.of("getcwd", status)
        }
        let length = c_string_length(found)
        if let offset = utf8_error_offset(found, length) {
            free(found)
            panic("Env.cwd: the path is not valid UTF-8 (byte {})", offset)
        }
        let text = string_from_bytes(found, length)
        free(found)
        return Path(s: text)
    }

    /// Makes `path` the process's current working directory.
    ///
    /// Returns `Err(SystemError)` with the reason chdir(2) refused, such as
    /// `NotFound` or `PermissionDenied`; text holding a NUL byte is
    /// `InvalidArgument`.
    public static func set_cwd(path: Path) unsafe -> Result<Void, SystemError> {
        let text = path.as_string()
        if text.index_of(0).is_some() {
            return SystemError.raised("chdir", SystemErrorKind.InvalidArgument)
        }
        let status = __saw_rt_fs_chdir(text.c_bytes())
        if status != 0 {
            return SystemError.of("chdir", 0 - status)
        }
        return
    }
}

// The number of bytes before the NUL that ends the C string at `text`.
func c_string_length(text: UnsafePointer<Int8>) unsafe -> Int {
    var n = 0
    while text[n] != 0 {
        n = n + 1
    }
    n
}
