//! `Env`: the program's command-line arguments, its environment variables,
//! and its executable's path.
//!
//! Every text the operating system hands back is checked as UTF-8, which a
//! `String` always holds: an argument, a value or a path that is not is an
//! `Err` of kind `InvalidUtf8`, never a panic.

import std.path.{Path, system_text}
import std.systemerror.{SystemError, SystemErrorKind}

// The `argc` and `argv` the C entry received, which the compiler keeps for
// the program (runtime/ABI.md, "Program arguments").
extern "C" {
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>
    // The running executable's resolved path in a buffer the caller frees, or
    // NULL with the positive tag stored through `status_out`; where a host
    // finds it is the runtime's business (runtime/ABI.md, "The executable's
    // path").
    func __saw_rt_executable_path(status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    // Every environment access goes through the runtime, which serializes
    // them with one lock (runtime/ABI.md). Set and unset return 0, or a
    // negated portable tag; get returns a copy the caller frees, or NULL
    // with 0 (not set) or a positive tag stored through `status_out`.
    func __saw_rt_env_set(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int) -> Int
    func __saw_rt_env_unset(name: UnsafePointer<Int8>) -> Int
    func __saw_rt_env_get(name: UnsafePointer<Int8>, status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?
    func __saw_rt_env_contains(name: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_chdir(path: UnsafePointer<Int8>) -> Int
    // The working directory in a buffer the caller frees, or NULL with the
    // positive tag stored through `status_out` (runtime/ABI.md).
    func __saw_rt_fs_getcwd(status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?
}

/// The program's environment, as static methods; never constructed.
public struct Env {
    private unused: Int
}

extension Env {
    /// Returns every command-line argument, in order, the program's own name
    /// first.
    ///
    /// Returns `Err(SystemError)` when an argument is not valid UTF-8, which
    /// no `String` may hold (`InvalidUtf8`), or when the vector cannot grow
    /// (`ResourcesExhausted`). Panics if the allocator refuses an argument's
    /// `String`.
    public static func args() -> Result<Vector<String>, SystemError> {
        var result = Vector<String>()
        let count = Env.argument_count()
        var i = 0
        while i < count {
            if let text = try Env.argument(i) {
                match result.push(text) {
                    case Ok(_) -> {},
                    case Err(_) -> return SystemError.raised("args", SystemErrorKind.ResourcesExhausted)
                }
            }
            i = i + 1
        }
        return move result
    }

    /// Returns the running program's executable file, as an absolute path
    /// with every symbolic link resolved.
    ///
    /// It names the file the program runs from however it was started: by a
    /// bare name found through `PATH`, or through a symbolic link, where the
    /// first argument names neither. Returns `Err(SystemError)` with the
    /// cause when the path cannot be read, resolved or allocated: `NotFound`
    /// when the file was removed while the program runs (on Linux too, where
    /// its link then reads `… (deleted)`) and on a target with no executable
    /// file, such as a kernel, and `ResourcesExhausted` when the path cannot
    /// be allocated, and `InvalidUtf8` when the path is not valid UTF-8.
    public static func executable_path() unsafe -> Result<String, SystemError> {
        var status = 0
        guard let resolved = __saw_rt_executable_path((&status) as UnsafePointer<Int>) else {
            return SystemError.of("executable_path", status)
        }
        let decoded = system_text("executable_path", resolved, c_string_length(resolved))
        free(resolved)
        return decoded
    }

    /// Returns how many command-line arguments there are, the program's own
    /// name included.
    public static func argument_count() -> Int {
        __saw_rt_get_argc() as Int
    }

    /// Returns the argument at `index`, or `None` when `index` is outside
    /// `0..<argument_count()`.
    ///
    /// Returns `Err(SystemError)` of kind `InvalidUtf8` when the argument is
    /// not valid UTF-8, which no `String` may hold.
    public static func argument(index: Int) unsafe -> Result<String?, SystemError> {
        if index < 0 || index >= Env.argument_count() {
            return None
        }
        let argv = __saw_rt_get_argv()
        let text = argv[index]
        let decoded = try system_text("args", text, c_string_length(text))
        return decoded
    }

    /// Returns the value of the environment variable `name`, or `None` when
    /// it is not set; a name holding a NUL byte names no variable.
    ///
    /// Returns `Err(SystemError)` when the value is not valid UTF-8
    /// (`InvalidUtf8`), or with the reason the runtime could not copy it,
    /// such as `ResourcesExhausted`.
    public static func get(name: String) unsafe -> Result<String?, SystemError> {
        var status = 0
        var found: UnsafePointer<Int8>? = None
        if borrow let key = name.c_string() {
            found = __saw_rt_env_get(key, (&status) as UnsafePointer<Int>)
        } else {
            return None
        }
        guard let value = found else {
            if status != 0 {
                return SystemError.of("getenv", status, name)
            }
            return None
        }
        let decoded = system_text("getenv", name, value, c_string_length(value))
        free(value)
        let text = try decoded
        return text
    }

    /// Returns whether the environment variable `name` is set, even to an
    /// empty value.
    public static func contains(name: String) unsafe -> Bool {
        if borrow let key = name.c_string() {
            __saw_rt_env_contains(key) != 0
        } else {
            false
        }
    }

    /// Sets the environment variable `name` to `value`, replacing a value
    /// already there unless `overwrite` is false, which leaves it and still
    /// succeeds.
    ///
    /// Returns `Err(SystemError)` with the reason setenv(3) refused: an empty
    /// name, or one holding `=`, is `InvalidArgument`, as is any text holding
    /// a NUL byte, which no environment entry can.
    public static func set(name: String, value: String, overwrite: Bool = true) unsafe -> Result<Void, SystemError> {
        let flag = if overwrite { 1 } else { 0 }
        if borrow let key = name.c_string() {
            if borrow let text = value.c_string() {
                let status = __saw_rt_env_set(key, text, flag)
                if status != 0 {
                    return SystemError.of("setenv", 0 - status, name)
                }
                return
            }
        }
        return SystemError.raised("setenv", SystemErrorKind.InvalidArgument, name)
    }

    /// Removes the environment variable `name`; removing one that is not set
    /// succeeds.
    ///
    /// Returns `Err(SystemError)` with the reason unsetenv(3) refused: an
    /// empty name, or one holding `=` or a NUL byte, is `InvalidArgument`.
    public static func unset(name: String) unsafe -> Result<Void, SystemError> {
        if borrow let key = name.c_string() {
            let status = __saw_rt_env_unset(key)
            if status != 0 {
                return SystemError.of("unsetenv", 0 - status, name)
            }
            return
        } else {
            return SystemError.raised("unsetenv", SystemErrorKind.InvalidArgument, name)
        }
    }

    /// Returns the process's current working directory.
    ///
    /// Returns `Err(SystemError)` with the reason getcwd(3) failed, such as
    /// `NotFound` when the directory was removed or `PermissionDenied` when a
    /// directory above it cannot be read, and `InvalidUtf8` when the path is
    /// not valid UTF-8, which no `Path` can hold yet (SL-902).
    public static func cwd() unsafe -> Result<Path, SystemError> {
        var status = 0
        guard let found = __saw_rt_fs_getcwd((&status) as UnsafePointer<Int>) else {
            return SystemError.of("getcwd", status)
        }
        let decoded = system_text("getcwd", found, c_string_length(found))
        free(found)
        return Path(s: try decoded)
    }

    /// Makes `path` the process's current working directory.
    ///
    /// Returns `Err(SystemError)` with the reason chdir(2) refused, such as
    /// `NotFound` or `PermissionDenied`; text holding a NUL byte is
    /// `InvalidArgument`.
    public static func set_cwd(path: Path) unsafe -> Result<Void, SystemError> {
        let text = path.as_string()
        if borrow let name = text.c_string() {
            let status = __saw_rt_fs_chdir(name)
            if status != 0 {
                return SystemError.of("chdir", 0 - status, text)
            }
            return
        } else {
            return SystemError.raised("chdir", SystemErrorKind.InvalidArgument, text)
        }
    }
}

// The number of bytes before the NUL that ends the C string at `text`.
public(package) func c_string_length(text: UnsafePointer<Int8>) unsafe -> Int {
    var n = 0
    while text[n] != 0 {
        n = n + 1
    }
    n
}
