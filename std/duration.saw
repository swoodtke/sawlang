//! Spans of time.
//!
//! A `Duration` is a magnitude, held as whole nanoseconds in a UInt64. Build one
//! with `Duration.ns`, `us`, `ms` or `secs`; read it back with the `as_*`
//! accessors. Durations compare and print.
//!
//! `Duration` is in the prelude and needs no import, because `sleep` is in the
//! prelude and this is the only type it takes. Nothing here allocates and
//! nothing here touches the OS.

// The backing is unsigned: a span has no negative values, and each constructor
// panics rather than wrap a request into a shorter span.
static NANOS_PER_MICRO: UInt64 = 1000
static NANOS_PER_MILLI: UInt64 = 1_000_000
static NANOS_PER_SEC: UInt64 = 1_000_000_000
static CENTIS_PER_SEC: UInt64 = 100
// The largest argument each constructor can scale without leaving the u64
// nanosecond range: UInt64.max divided by that constructor's unit.
static MAX_MICROS: UInt64 = 18_446_744_073_709_551
static MAX_MILLIS: UInt64 = 18_446_744_073_709
static MAX_SECS: UInt64 = 18_446_744_073

/// A span of time, held as whole nanoseconds.
///
/// Build one with `Duration.ns`, `us`, `ms` or `secs`. Durations compare and
/// print.
public struct Duration {
    private nanos: UInt64
}

extension Duration {
    /// Returns a span of `n` nanoseconds.
    public static func ns(n: UInt64) -> Duration {
        Duration(nanos: n)
    }

    /// Returns a span of `n` whole microseconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public static func us(n: UInt64) -> Duration {
        if n > MAX_MICROS {
            panic("Duration.us: {} microseconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_MICRO)
    }

    /// Returns a span of `n` whole milliseconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public static func ms(n: UInt64) -> Duration {
        if n > MAX_MILLIS {
            panic("Duration.ms: {} milliseconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_MILLI)
    }

    /// Returns a span of `n` whole seconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public static func secs(n: UInt64) -> Duration {
        if n > MAX_SECS {
            panic("Duration.secs: {} seconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_SEC)
    }

    /// Returns the whole seconds in the span, truncating.
    public func as_secs(&self) -> UInt64 {
        self.nanos / NANOS_PER_SEC
    }

    /// Returns the whole milliseconds in the span, truncating.
    public func as_millis(&self) -> UInt64 {
        self.nanos / NANOS_PER_MILLI
    }

    /// Returns the whole microseconds in the span, truncating.
    public func as_micros(&self) -> UInt64 {
        self.nanos / NANOS_PER_MICRO
    }

    /// Returns the span in nanoseconds, the unit it is stored in.
    public func as_nanos(&self) -> UInt64 {
        self.nanos
    }
}

/// Durations order by length.
@synthesize
extension Duration: Comparable {
}

/// Durations print as a number and a unit.
extension Duration: Printable {
    /// Writes the span using the largest unit at or below its magnitude.
    ///
    /// Seconds carry two fractional digits; smaller units are whole. A span of
    /// 1_420_000_000ns writes as `1.42s`, and 230_000_000ns as `230ms`, then
    /// `5us`, then `42ns`.
    public func format(&self, into: &var StringBuilder) {
        // Each part written is below `Int.max`: the whole seconds of a UInt64
        // span are, and every smaller unit is printed only under a second.
        let ns = self.nanos
        if ns >= NANOS_PER_SEC {
            let whole = ns / NANOS_PER_SEC
            let frac = (ns % NANOS_PER_SEC) / (NANOS_PER_SEC / CENTIS_PER_SEC)
            try! into.append(whole as Int)
            try! into.append(".")
            if frac < 10 {
                try! into.append("0")
            }
            try! into.append(frac as Int)
            try! into.append("s")
            return
        }
        if ns >= NANOS_PER_MILLI {
            try! into.append((ns / NANOS_PER_MILLI) as Int)
            try! into.append("ms")
            return
        }
        if ns >= NANOS_PER_MICRO {
            try! into.append((ns / NANOS_PER_MICRO) as Int)
            try! into.append("us")
            return
        }
        try! into.append(ns as Int)
        try! into.append("ns")
    }
}
