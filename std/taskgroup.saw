//! The cooperative executor: the run queue tasks are resumed from, the handles
//! a spawn returns, and each thread's background group, which `Task.spawn`
//! spawns into.
//!
//! A task is a coroutine frame the compiler lays out. The executor reaches a
//! frame only through its `FrameDescriptor`: it resumes the frame, reads the
//! park word the frame recorded through its `TaskContext`, and releases the
//! frame's storage once its root returns `Poll.Ready`. The result and the
//! cancel word live in the task's cell, which outlives the frame, so a handle
//! never addresses the frame itself.
//!
//! A group made with `TaskGroup(threads: N)`, N of two or more, is a worker
//! pool instead: N `Thread.spawn` workers serve its run queue from its first
//! spawn until its teardown, and the shared sweep leaves its frames alone.

import std.mem.{copy_bytes, drop_in_place}
import std.panic.{PANIC_REPORT}
import std.systemerror.{SystemError}
import std.task.{Thread}

// A pool's run-queue lock and its idle workers' condition variable. Both live
// in one block the group owns, each in a conservative slot: `pthread_mutex_t`
// is 64 bytes at most on the hosted targets, and `pthread_cond_t` 48
// (runtime/ABI.md).
extern "C" {
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<UInt8>) -> Int
    func __saw_rt_pthread_cond_init_default(c: UnsafePointer<UInt8>) -> Int
    func pthread_mutex_lock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_unlock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_trylock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_destroy(m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_wait(c: UnsafePointer<UInt8>, m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_broadcast(c: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_destroy(c: UnsafePointer<UInt8>) -> Int32
}

static QUEUE_GATE_SLOT: Int = 64
static QUEUE_GATE_ALIGN: Int = 16

extern "C" {
    func __saw_rt_clock_monotonic_nanos() -> Int64
    // The reactor seams that can fail return 0 or the negated portable tag,
    // with the raw code beside it in `__saw_rt_last_raw_code` (runtime/ABI.md).
    func __saw_rt_reactor_create(r_out: UnsafePointer<Int>) -> Int
    func __saw_rt_reactor_destroy(r: Int)
    func __saw_rt_reactor_poll(r: Int, timeout_ms: Int, count_out: UnsafePointer<Int>) -> Int
    func __saw_rt_reactor_register(r: Int, fd: Int, write: Int, token: Int) -> Int
    func __saw_rt_last_raw_code() -> Int
    func __saw_rt_reactor_unregister(r: Int, fd: Int, write: Int)
    func __saw_rt_reactor_wake(r: Int)
    func __saw_rt_sleep_ns(ns: UInt64)
    // The calling thread's executor word: its record's address, 0 when it has
    // none; the store answers -1 when the runtime cannot keep it (runtime/ABI.md).
    func __saw_rt_thread_executor() -> Int
    func __saw_rt_set_thread_executor(record: Int) -> Int
}

// The park word vocabulary: what a frame records through `TaskContext.park`
// before it returns `Pending`, and what a slot is decided by between resumes.
//
//   == 1    a timer, whose deadline is the context's `deadline` word
//   == 0    ready: resume on the next sweep (`yield_now`, a budget yield)
//   == -1   a descriptor's readiness, armed through `__saw_exec_io_register`,
//           and bounded by the context's `deadline` when that is nonzero;
//           the reactor's poll latches the word to 0 when the descriptor is
//           ready, so a latched park reads as a ready one
//    < -1   a multiple of 4: a channel's readiness word, by its negated
//           address
//    < -1   odd: a thread control block's handshake word, by its negated
//           address less one: a join, ready once the thread's exit leaves
//           the word negative
//    < -1   2 more than a multiple of 4: an offload job, by its negated
//           handle less two: the job's completion, ready once its C call
//           has returned; the job's pipe is armed through
//           `__saw_exec_io_register`, so the call's end rouses the poll
//
// The negated-address reasons are told apart by the low bits alone, since a
// word and a job are each aligned to at least 4. A value above 1 names no
// park, and a frame that records one is refused. A cancel wakes a park of
// any reason but a join or an offload's completion (`park_wakes`), the two
// waits a cancel does not end; each other reason has its own lowering and
// its own executor half. `PARK_UNSET` is written before every resume, so a
// frame that reports `Pending` without recording a park is caught rather
// than read as stale (SL:coroutines §3.3).
static PARK_READY: Int = 0
static PARK_TIMER: Int = 1
static PARK_FD: Int = -1
static PARK_UNSET: Int = Int.min

// The wait a park word names, by the vocabulary above.
enum ParkReason {
    case Ready,
    case Timer,
    case Descriptor,
    case Channel,
    case Join,
    case Offload,
    // `PARK_UNSET`: nothing recorded since the last resume.
    case Unset,
    // Above 1: no park the executor performs.
    case Unknown
}

// The one decoding of a park word's reason.
//
// ENTRY POINTS:
//   park_wakes
//   idle
//   channel_parked
//   group_parks
//   worker_turn
//   dump_status
func park_reason(park: Int) -> ParkReason {
    if park == PARK_UNSET {
        return ParkReason.Unset
    }
    if park == PARK_READY {
        return ParkReason.Ready
    }
    if park == PARK_TIMER {
        return ParkReason.Timer
    }
    if park == PARK_FD {
        return ParkReason.Descriptor
    }
    if park > PARK_TIMER {
        return ParkReason.Unknown
    }
    let low = (0 - park) % 4
    if low == 0 {
        return ParkReason.Channel
    }
    if low == 2 {
        return ParkReason.Offload
    }
    ParkReason.Join
}

// Whether the executor waits on park word `park` by blocking in the reactor's
// poll until a deadline or a descriptor: a timer, a descriptor, and an
// offload's completion, whose pipe the poll watches.
func polls_for(park: Int) -> Bool {
    match park_reason(park) {
        case Timer -> true,
        case Descriptor -> true,
        case Offload -> true,
        case _ -> false
    }
}

/// The park word of a wait for offload job `job` to finish, which an offload
/// park records: ready once the job's C call has returned, and never woken by
/// a cancel, since nothing can interrupt the call.
public func __saw_exec_offload_park(job: Int) -> Int {
    // The word is the job's negated handle less two, which `park_reason` and
    // `offload_job` read back. A job is a heap block, so its handle is aligned
    // to at least 4 and the word cannot be a channel's or a join's.
    //
    // ENTRY POINTS:
    //   coro_lower_park's offload park (`__saw_park_offload`)
    if job % 4 != 0 {
        panic("executor: offload job {} is not aligned to 4, so no park word can name it", job)
    }
    0 - job - 2
}

// The offload job an offload park word `park` names.
func offload_job(park: Int) -> Int {
    0 - park - 2
}

// The handshake word a join's park word `park` names.
func joined_word(park: Int) unsafe -> UnsafePointer<Int> {
    (0 - park - 1) as UnsafePointer<Int>
}

// The park word of a join of the thread whose handshake word is at `word`:
// the word's negated address less one, which `park_reason` and
// `joined_word` read back. A task's `Thread.join` parks on it, and a pool's
// teardown on a thread that drives tasks drives on it, so both wait for a
// thread's exit the one way and neither blocks the thread's other tasks.
//
// ENTRY POINTS:
//   Thread.join
//   drive_on_exit
public(package) func __saw_exec_join_park(word: UnsafePointer<Int>) unsafe -> Int {
    0 - (word as Int) - 1
}

/// What one resume of a frame reports.
public enum Poll {
    /// The frame's root returned, and its result is in the result slot.
    case Ready,
    /// The frame parked, and recorded why through its context's park word.
    case Pending
}

/// The record every resume of a task's frames is handed: where the task
/// parks, where its cancel word is, and which task it is.
///
/// A frame driving a child passes the same context down, so a park anywhere
/// in the task records the root's word.
public struct TaskContext {
    /// The task's park word.
    park: UnsafePointer<Int>
    /// The task's cancel word, which `cancelled()` reads.
    cancel: UnsafePointer<Bool>
    /// The task's identity, for the task backtrace.
    task: Int
    /// The monotonic instant, in nanoseconds, that the task's timer park, or
    /// its bounded descriptor park, waits until; 0 when its park has none.
    ///
    /// It is 64 bits on every target, so a deadline never narrows to fit the
    /// park word. The backend reaches each field by its offset, so the order
    /// is free.
    deadline: UInt64
}

/// The constant record the compiler emits for each frame type, through which
/// the executor reaches a frame of that type.
///
/// `resume` runs the frame to its next park or its end; it stands in for the
/// backend's `__saw_frame_resume` helper, which takes the same operands, until
/// frames are lowered. A task's storage is `size` bytes at alignment `align`,
/// and its root's result, `result_size` bytes at alignment `result_align`,
/// sits `result_offset` bytes in; `drop_result` destroys a result in place.
/// `backtrace` is the frame type's index in the backtrace table.
///
/// Both function values are `sync`: a resume reports a park as `Pending`
/// rather than suspending its caller, and a drop never suspends, so the
/// handles that reach them stay callable from `sync` code.
public struct FrameDescriptor {
    resume: (UnsafePointer<UInt8>, UnsafePointer<TaskContext>) unsafe sync -> Poll
    size: Int
    align: Int
    result_offset: Int
    result_size: Int
    result_align: Int
    drop_result: (UnsafePointer<UInt8>) unsafe sync -> Void
    backtrace: Int
}

/// Where a handle came from, which decides whether dropping it is a fate.
///
/// A `Task.spawn` handle is the task's only consumer, so it must be joined,
/// detached or cancelled; a `group.spawn` handle may be dropped, because its
/// group is a declared consumer.
public enum TaskProvenance {
    /// Minted by `Task.spawn`.
    case Singleton,
    /// Minted by `group.spawn`.
    case Group
}

// A spawned task's cell: its context, park and cancel words, and the storage
// its result is moved into when the frame finishes. One heap block holds the
// cell and, at `result`, its result bytes, so every address the context hands
// out is stable for the task's life (design 134).
struct TaskCell {
    context: TaskContext
    park: Int
    cancel: Bool
    // No handle will take the result: its handle detached, or was dropped
    // before the task finished.
    unclaimed: Bool
    // A result was moved in and is neither taken nor dropped yet.
    holding: Bool
    // 0 while the task lives; 1 once its root returned `Ready`, written ahead
    // of its slot's `done`: the word a join driving the executor waits on
    // (`await_task`). Read and written atomically, since a pool's worker
    // writes it.
    finished: Int
    descriptor: UnsafePointer<FrameDescriptor>
    result: UnsafePointer<UInt8>
    bytes: Int
    align: Int
}

// One run-queue entry. `generation` is half of the (slot, generation) pair a
// handle records, so a handle to a task whose slot was reused is recognisably
// stale. `active` marks a frame being resumed: on this thread's stack, where
// a nested sweep skips it, since resuming it would re-enter a live coroutine;
// or, in a pool, on a worker, which claimed it under the run-queue lock.
struct TaskSlot {
    frame: UnsafePointer<UInt8>?
    cell: UnsafePointer<TaskCell>?
    generation: Int
    done: Bool
    active: Bool
    // While `active`, the executor record of the thread resuming the frame,
    // set with the claim: the dump reads no frame another thread is changing.
    runner: Int
    // A frame the executor allocated and frees; `main`'s frame is the
    // entry's own.
    owned: Bool
    // The address of the task's cancel word escaped through `cancel_addr`,
    // as an `Int` that carries no generation, so the slot keeps its cell for
    // the group's life and is never reused.
    pinned: Bool
}

// The (slot, generation) pair an enqueue hands back.
struct TaskTicket {
    slot: Int
    generation: Int
}

/// A scope for spawned tasks: every task spawned into a group finishes before
/// the group is destroyed.
///
/// A group made with `TaskGroup()` runs its tasks on the one cooperative
/// scheduler, beside every other such group's, whenever it runs: under a
/// suspending `main`, at a `join`, at a group's teardown, and while a test
/// driver waits for its frame's timer. A group made with
/// `TaskGroup(threads: N)`, N of two or more, runs them on a pool of N worker
/// threads, started at its first spawn, which run alongside the thread that
/// owns the group until the group is destroyed. A group may live in a
/// suspending function's frame and stay there across its suspensions. It is
/// `NoMove`, because its tasks and its workers reach it through its address.
public struct TaskGroup {
    private slots: Vector<TaskSlot>
    private free: Vector<Int>
    // The link in its owner thread's list of groups (`ExecutorRecord.groups`):
    // the next registered group's address, 0 at the end, and whether this
    // group is in the list.
    private next: Int
    private registered: Bool
    // The address of the executor record of the thread that registered the
    // group, whose list holds it; 0 until then.
    private owner: Int
    // The `group.spawn` handles still claiming their task's result, which the
    // teardown requires to be none (`check_no_outstanding`). It goes down only
    // when a handle lets go of the result, at its join or its drop
    // (`Task.let_go`), never at `cancel`: a cancelled handle still reaches the
    // group when it is joined or dropped. Read and written atomically, and
    // read at the teardown after a pool's workers have joined.
    private outstanding: Int
    // The pool's worker count; 1 for the cooperative engine.
    private threads: Int
    // The address of the pool's run-queue lock and condition variable, or 0
    // for the cooperative engine, whose run queue its owner record's latch
    // guards instead (`lock_queue`).
    private lock: Int
    // The executor word of the thread holding the pool's lock, 0 while it is
    // free: how the panic path's dump tells a lock its own thread holds from
    // one another thread does. Read and written atomically.
    private holder: Int
    // Set under the lock: `started` by the first spawn, which then starts the
    // workers, and `stopping` once, by the teardown, after which a worker
    // leaves as soon as no task is live.
    private started: Bool
    private stopping: Bool
    // The workers blocked in the reactor's poll rather than on the condition
    // variable, under the lock: a spawn and a completion poke the reactor
    // only while one is.
    private pollers: Int
    // 0, until the worker that finishes a stopping pool's last live task
    // writes 1, ahead of that slot's `done`: the word a teardown driving the
    // executor waits on (`drain_pool`). Read and written atomically.
    private drained: Int
    // The workers' handles, joined at the teardown. Only the owning thread
    // touches them, so they need no lock.
    private crew: Vector<Thread<Void>>
}

extension TaskGroup {
    /// Creates an empty group, whose tasks run on the shared cooperative
    /// scheduler.
    public init() -> TaskGroup {
        TaskGroup(slots: Vector<TaskSlot>(), free: Vector<Int>(), next: 0, registered: false, owner: 0,
                  outstanding: 0, threads: 1, lock: 0, holder: 0, started: false, stopping: false,
                  pollers: 0, drained: 0, crew: Vector<Thread<Void>>())
    }

    /// Creates an empty group whose tasks run on a pool of `threads` worker
    /// threads.
    ///
    /// The pool starts at the group's first spawn, so a group that never
    /// spawns starts no thread, and runs until the group is destroyed. Its
    /// tasks run alongside the thread that owns the group, in parallel, so
    /// every value a spawned frame carries must be `Send`. `threads: 1` or
    /// less is the cooperative engine, exactly as `TaskGroup()` is. Returns
    /// `Err(AllocError)` if the pool's lock cannot be allocated. A worker
    /// thread the operating system refuses panics at the first spawn, naming
    /// the error.
    public init(threads: Int) unsafe -> Result<TaskGroup, AllocError> {
        if threads <= 1 {
            return TaskGroup()
        }
        let size = QUEUE_GATE_SLOT * 2
        guard let raw = GlobalAllocator().alloc(size, QUEUE_GATE_ALIGN) else {
            return AllocError(size: size, align: QUEUE_GATE_ALIGN)
        }
        let gate = raw as UnsafePointer<UInt8>
        // A refused initialization is no allocation failure, and `AllocError`
        // is all this constructor reports, so it panics with the cause.
        if __saw_rt_pthread_mutex_init_default(gate) != 0 {
            panic("TaskGroup(threads:): initializing its lock failed (errno {})", __saw_rt_last_raw_code())
        }
        if __saw_rt_pthread_cond_init_default(gate + QUEUE_GATE_SLOT) != 0 {
            panic("TaskGroup(threads:): initializing its condition variable failed (errno {})",
                  __saw_rt_last_raw_code())
        }
        return TaskGroup(slots: Vector<TaskSlot>(), free: Vector<Int>(), next: 0, registered: false,
                         owner: 0, outstanding: 0, threads: threads, lock: raw as Int, holder: 0,
                         started: false, stopping: false, pollers: 0, drained: 0,
                         crew: Vector<Thread<Void>>())
    }

    /// Returns the number of task slots the group holds: its live tasks, plus
    /// the finished ones whose handle is still waiting to join the result,
    /// plus those whose cancel address `cancel_addr` handed out, which are
    /// never reused.
    public func count(&self) -> Int {
        if self.lock == 0 {
            return self.slots.len() - self.free.len()
        }
        queue_count(&self)
    }
}

// A pool's `count`, read under its lock.
func queue_count(group: &TaskGroup) unsafe -> Int {
    // Through an address, since a worker writes the queue while this reads it.
    let at = (&group) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>
    lock_queue(at)
    let n = at[0].slots.len() - at[0].free.len()
    unlock_queue(at)
    n
}

// The run-queue lock and the condition variable beside it, of the pool at
// `at`.
func queue_mutex(at: UnsafePointer<TaskGroup>) unsafe -> UnsafePointer<UInt8> {
    at[0].lock as UnsafePointer<UInt8>
}

func queue_cond(at: UnsafePointer<TaskGroup>) unsafe -> UnsafePointer<UInt8> {
    (at[0].lock + QUEUE_GATE_SLOT) as UnsafePointer<UInt8>
}

// Takes the run-queue lock of the group at `at`: a pool's own mutex, or, for
// a cooperative group, its owner record's latch (`ExecutorRecord.latch`),
// which another thread's walk takes before it reads the group. Every write of
// a pool's slots, free list, `started`, `stopping` and `pollers` is made with
// it held, and every write of a registered cooperative group's slots, and
// every free of a cell or frame either reaches, too: the one funnel the
// cross-thread walks rely on (`walk_take`).
//
// A cooperative group's section holds bookkeeping only. A resume, a result's
// drop and any I/O run outside it, so a walk never waits on user code, and a
// drop that reaches another group's lock cannot meet this one. The latch is
// not recursive: no section calls another.
//
// A pool's state is reached through the group's address, never through a
// `&TaskGroup` or `&var TaskGroup` parameter whose call spans a lock: such a
// parameter promises that nothing else writes the group while the call runs,
// and a worker does. A run-queue write that takes one (`place`, `complete`,
// `recycle`) is called with the lock already held.
//
// ENTRY POINTS:
//   enqueue_pooled
//   enqueue
//   resume_slot
//   queue_count
//   group_on_this_stack
//   drain_pool
//   shutdown_crew
//   await_task
//   exec_worker (and worker_turn, worker_resume, which drop and retake it)
//   Task.join
//   Task.cancel_addr
//   Task.cancel
//   Task.detach
//   Task.deinit
func lock_queue(at: UnsafePointer<TaskGroup>) unsafe {
    if at[0].lock != 0 {
        let _ = pthread_mutex_lock(queue_mutex(at))
        store_word((&at[0].holder) as UnsafePointer<Int>, __saw_rt_thread_executor())
    } else if at[0].owner != 0 {
        latch_take(at[0].owner as UnsafePointer<ExecutorRecord>)
    }
}

func unlock_queue(at: UnsafePointer<TaskGroup>) unsafe {
    if at[0].lock != 0 {
        store_word((&at[0].holder) as UnsafePointer<Int>, 0)
        let _ = pthread_mutex_unlock(queue_mutex(at))
    } else if at[0].owner != 0 {
        latch_give(at[0].owner as UnsafePointer<ExecutorRecord>)
    }
}

// The group's teardown is its structured join: every live task is driven to
// completion where the group was born, other groups' tasks advancing beside
// them, and then each slot is released. Nothing is cancelled. A group torn
// down while one of its own tasks is further up this thread's stack can never
// finish, since that task continues only once the teardown returns, so it
// panics before the sweep (`on_this_stack`); the check after the sweep is the
// backstop that keeps a frame that has not returned `Ready` from being
// released (SL:coroutines §3.1). The outstanding-handle check sits between the
// join and the release: a handle a task's own frame held was dropped by that
// task's code during the join, and nothing a late handle reads is freed yet.
//
// A pool's teardown is the same join, made by its workers: it says no more
// work is coming, the workers finish every live task and leave, and it joins
// them (`shutdown_crew`). Only then is anything released. On a thread that
// drives tasks, the teardown runs them until the pool drains first
// (`drain_pool`), as the cooperative branch's join does.
extension TaskGroup: NoCopy {
    public func deinit(&var self) unsafe {
        if self.lock != 0 {
            let at = (&self) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>
            drain_pool(at)
            shutdown_crew(at)
        } else if self.registered {
            let me = (&self) as UnsafePointer<TaskGroup> as Int
            if group_on_this_stack(me as UnsafePointer<TaskGroup>, -1) {
                panic("TaskGroup: the group is torn down while one of its tasks is running further up this thread's stack")
            }
            exec_run(me, -1, 0)
            if self.has_live() {
                panic("TaskGroup: the group is torn down while one of its tasks is running further up this thread's stack")
            }
        }
        check_no_outstanding(&self)
        self.unregister()
        self.release_slots()
        if self.lock != 0 {
            // Every worker has joined, so nothing waits on either.
            let gate = self.lock as UnsafePointer<UInt8>
            let _ = pthread_cond_destroy(gate + QUEUE_GATE_SLOT)
            let _ = pthread_mutex_destroy(gate)
            GlobalAllocator().dealloc(gate as UnsafePointer<Int8>, QUEUE_GATE_SLOT * 2, QUEUE_GATE_ALIGN)
        }
    }
}

// A group may be destroyed only once every `group.spawn` handle to it has let
// go of its task's result. A handle that still claims one, a cancelled one
// included, reads or writes the group when it is joined or dropped, so one
// still outstanding here would reach freed storage later; the borrow check
// refuses the routes it sees, and this catches the rest, a handle minted
// through a borrow window among them.
//
// ENTRY POINTS:
//   TaskGroup.deinit
func check_no_outstanding(group: &TaskGroup) unsafe {
    let n = __saw_atomic_load_i64_seq_cst((&group.outstanding) as UnsafePointer<Int>)
    if n < 0 {
        panic("TaskGroup: a task handle's fate was counted more than once")
    }
    if n == 1 {
        panic("TaskGroup: destroyed while 1 task handle still refers to it; join or drop each `group.spawn` handle before its group ends")
    }
    if n != 0 {
        panic("TaskGroup: destroyed while {} task handles still refer to it; join or drop each `group.spawn` handle before its group ends",
              n)
    }
}

// A `group.spawn` handle to the group at `group` was minted.
//
// ENTRY POINTS:
//   Task.__saw_spawn
func handle_minted(group: UnsafePointer<TaskGroup>) unsafe {
    let _ = __saw_atomic_add_i64_seq_cst((&group[0].outstanding) as UnsafePointer<Int>, 1)
}

// A `group.spawn` handle to the group at `group` let go of its task's result.
// The caller's `released` flag makes this run once per handle, so a joined
// handle that is dropped later counts down nothing more.
//
// ENTRY POINTS:
//   Task.let_go
func handle_released(group: UnsafePointer<TaskGroup>) unsafe {
    let _ = __saw_atomic_add_i64_seq_cst((&group[0].outstanding) as UnsafePointer<Int>, -1)
}

// A group is a scope whose tasks hold its address, so it lives where its
// constructor built it (design 124).
extension TaskGroup: NoMove {}

// One thread's executor state. A cooperative group belongs to the thread
// that registers it, at its first spawn, and that thread's sweeps read only
// its own record's groups, so a frame runs only on the thread that drives its
// group. The fields another thread reads, the walks', are read and written
// atomically through their addresses, and its groups are read only under its
// `latch`.
//
// A record is never freed: a walk on another thread may be reading it at any
// time. Once its thread ends it is reusable, and a later thread claims it.
struct ExecutorRecord {
    // The address of the first group this thread registered, threaded through
    // each group's `next`, or 0.
    groups: Int
    // How many times this thread has handed itself to the executor and waits
    // there: in a sweep, in a pool's join or in a pool's teardown. These nest,
    // so it is a depth. A pool worker's deadlock walk reads it, since nothing
    // in a run queue says whether the thread is running code of its own,
    // which could send, or waiting (`quiescent_now`). A worker counts as
    // waiting for its whole life, since the frames it runs are on its pool's
    // run queue, where the walk sees them.
    waiting: Int
    // How many sweeps are open on this thread's stack: above zero, the
    // thread drives tasks, so a wait it makes drives them too rather than
    // blocking it (`await_task`, `drain_pool`). Only its own thread reads it.
    sweeps: Int
    // The address of this thread's background group, the one its
    // `Task.spawn`s spawn into, or 0 before the first. The group is built
    // once per record and kept with it, emptied at each thread's end, so a
    // walk holding its address still finds a group there. Only the record's
    // own thread reads this field.
    background: Int
    // The next record in `EXEC_RECORDS`, written once, before the record is
    // published.
    next: Int
    // 1 while a running thread owns the record, 0 once it may be claimed.
    live: Int
    // The lock over the record's group list, the lifetime of every group on
    // it and each cooperative group's run queue (`lock_queue`): 0 while free,
    // otherwise the holder's mark, which is the record's own address while a
    // section holds it, and `WALK_HOLDER` while a walk does.
    latch: Int
    // How many resumes this record's thread has finished, written by that
    // thread alone: a walk that sees any record's count move did not read
    // one moment (`quiescent_now`).
    turns: Int
    // The address of the context of the task whose turn this thread is
    // running, or 0 outside every turn: the task `cancelled()` answers for
    // in code no frame lowers. Only the record's own thread reads or writes
    // it (`begin_turn`).
    current: Int
}

// A walk's mark in a latch, which is no record's address.
static WALK_HOLDER: Int = -1

// How many tries a walk makes at a lock before it naps, and how many naps of
// `WALK_NAP_NANOS` before it gives the lock up as busy: a bound far past any
// section's bookkeeping, which never waits on anything.
static WALK_SPINS: Int = 64
static WALK_NAPS: Int = 100
static WALK_NAP_NANOS: UInt64 = 100_000

// Takes `record`'s latch for a section of `lock_queue`, waiting while a walk
// or another section holds it. A walk holds it for a bounded read and never
// for I/O, so the wait is short. The mark is the record's address whichever
// thread takes it, which costs no thread-local lookup, so a section that
// nested would wait on itself: none does.
//
// ENTRY POINTS:
//   lock_queue (a cooperative group's sections)
//   register
//   TaskGroup.unregister
func latch_take(record: UnsafePointer<ExecutorRecord>) unsafe {
    let word = (&record[0].latch) as UnsafePointer<Int>
    let mark = record as Int
    var tries = 0
    while not __saw_atomic_cmpxchg_i64_seq_cst(word, 0, mark) {
        tries = tries + 1
        if tries >= WALK_SPINS {
            __saw_rt_sleep_ns(WALK_NAP_NANOS)
            tries = 0
        }
    }
}

func latch_give(record: UnsafePointer<ExecutorRecord>) unsafe {
    store_word((&record[0].latch) as UnsafePointer<Int>, 0)
}

// The outcome of a walk's attempt at a lock.
enum WalkLock {
    // Held now, until the walk gives it back.
    case Taken,
    // Held by the walking thread itself, mid-section: never read.
    case Mine,
    // Held by another thread past the walk's bound.
    case Busy
}

// The cross-thread walks' one way into another thread's memory: `record`'s
// latch, tried WALK_SPINS times between naps, at most WALK_NAPS naps, and
// never while the walk holds another lock. A latch the calling thread's own
// section holds is `Mine` at once: the panic path's dump reaches it when a
// section panics, and the record is mid-change. A walk that holds the latch
// takes a pool's lock on it only through `walk_take_pool`, which never waits.
//
// ENTRY POINTS:
//   quiescent_now
//   dump_walk
func walk_take(record: UnsafePointer<ExecutorRecord>) unsafe -> WalkLock {
    let word = (&record[0].latch) as UnsafePointer<Int>
    let me = __saw_rt_thread_executor()
    var naps = 0
    while naps <= WALK_NAPS {
        var tries = 0
        while tries < WALK_SPINS {
            if __saw_atomic_cmpxchg_i64_seq_cst(word, 0, WALK_HOLDER) {
                return WalkLock.Taken
            }
            if me != 0 && load_word(word) == me {
                return WalkLock.Mine
            }
            tries = tries + 1
        }
        if naps < WALK_NAPS {
            __saw_rt_sleep_ns(WALK_NAP_NANOS)
        }
        naps = naps + 1
    }
    WalkLock.Busy
}

func walk_give(record: UnsafePointer<ExecutorRecord>) unsafe {
    store_word((&record[0].latch) as UnsafePointer<Int>, 0)
}

// A walk's try at the lock of the pool at `g`, made while it holds the latch
// of the record the pool is registered in, so it never waits: a pool lock is
// held across a result's drop, which may reach a cooperative group's latch.
// The deadlock walk reads a busy pool as one whose workers are acting; the
// dump retries the record with no lock held (`dump_record`).
func walk_take_pool(g: UnsafePointer<TaskGroup>) unsafe -> WalkLock {
    var tries = 0
    while tries < WALK_SPINS {
        if pthread_mutex_trylock(queue_mutex(g)) == 0 {
            store_word((&g[0].holder) as UnsafePointer<Int>, __saw_rt_thread_executor())
            return WalkLock.Taken
        }
        tries = tries + 1
    }
    let me = __saw_rt_thread_executor()
    if me != 0 && load_word((&g[0].holder) as UnsafePointer<Int>) == me {
        return WalkLock.Mine
    }
    WalkLock.Busy
}

func walk_give_pool(g: UnsafePointer<TaskGroup>) unsafe {
    store_word((&g[0].holder) as UnsafePointer<Int>, 0)
    let _ = pthread_mutex_unlock(queue_mutex(g))
}

// Counts one finished resume on `record`, the resuming thread's own.
func count_turn(record: UnsafePointer<ExecutorRecord>) unsafe {
    let word = (&record[0].turns) as UnsafePointer<Int>
    store_word(word, load_word(word) + 1)
}

// The sum of every record's resume count.
func turns_now() unsafe -> Int {
    var n = 0
    var at = EXEC_RECORDS.load()
    while at != 0 {
        let r = at as UnsafePointer<ExecutorRecord>
        n = n + load_word((&r[0].turns) as UnsafePointer<Int>)
        at = r[0].next
    }
    n
}

// Every executor record the process has made, newest first, threaded through
// each record's `next`; the head record's address, or 0. Records are only
// added, so a walk may follow the list without a lock.
static EXEC_RECORDS: Atomic<Int> = Atomic(0)

// Reads the word at `at`, sequentially consistent.
func load_word(at: UnsafePointer<Int>) unsafe -> Int {
    __saw_atomic_load_i64_seq_cst(at)
}

// Writes `value` into the word at `at`, sequentially consistent.
func store_word(at: UnsafePointer<Int>, value: Int) unsafe {
    __saw_atomic_store_i64_seq_cst(at, value)
}

// The calling thread's executor record, claimed the first time it asks.
func this_executor() unsafe -> UnsafePointer<ExecutorRecord> {
    let current = __saw_rt_thread_executor()
    if current != 0 {
        return current as UnsafePointer<ExecutorRecord>
    }
    let record = claim_record()
    if __saw_rt_set_thread_executor(record as Int) != 0 {
        panic("executor: the runtime cannot keep this thread's executor record (no thread-specific word)")
    }
    // Before any task exists, so a panic with one in flight has its dump.
    install_panic_report()
    record
}

// A reusable record, or a fresh one added to `EXEC_RECORDS`. A reusable one
// was published empty by its last owner before it became claimable
// (`__saw_exec_thread_exiting`), so the claim takes it as it is. One whose
// groups list is not empty still holds a group another thread may tear
// down, and is passed over.
func claim_record() unsafe -> UnsafePointer<ExecutorRecord> {
    var cur = EXEC_RECORDS.load()
    while cur != 0 {
        let r = cur as UnsafePointer<ExecutorRecord>
        let live = (&r[0].live) as UnsafePointer<Int>
        let empty = load_word((&r[0].groups) as UnsafePointer<Int>) == 0
        if empty && __saw_atomic_cmpxchg_i64_seq_cst(live, 0, 1) {
            return r
        }
        cur = r[0].next
    }
    let size = sizeof<ExecutorRecord>()
    let align = alignof<ExecutorRecord>()
    let raw = exec_alloc(size, align, "executor")
    let fresh = raw as UnsafePointer<ExecutorRecord>
    fresh[0] = ExecutorRecord(groups: 0, waiting: 0, sweeps: 0, background: 0, next: 0, live: 1, latch: 0,
                              turns: 0, current: 0)
    var linked = false
    while not linked {
        let head = EXEC_RECORDS.load()
        fresh[0].next = head
        linked = EXEC_RECORDS.compare_exchange(head, raw as Int)
    }
    fresh
}

// The calling thread is about to end: `Thread.__saw_exit`'s call, after its
// background group is closed and ahead of the live-thread count dropping. Its
// record, if it has one, is published empty first, and claimable after that,
// so a walk that reads a claimable record finds nothing waiting in it (the run
// probe `executor_records_reused`). A group still registered in it stays
// there, read by the walk, until whichever thread tears it down unlinks it.
public(package) func __saw_exec_thread_exiting() unsafe {
    let current = __saw_rt_thread_executor()
    if current == 0 {
        return
    }
    let r = current as UnsafePointer<ExecutorRecord>
    store_word((&r[0].waiting) as UnsafePointer<Int>, 0)
    r[0].sweeps = 0
    store_word((&r[0].live) as UnsafePointer<Int>, 0)
}

/// Returns how many executor records the process has made: at most one per
/// thread that was ever running at once and drove a task group.
///
/// A std-internal count, for the executor's tests.
public func __saw_exec_record_count() unsafe -> Int {
    var n = 0
    var cur = EXEC_RECORDS.load()
    while cur != 0 {
        n = n + 1
        cur = (cur as UnsafePointer<ExecutorRecord>)[0].next
    }
    n
}

// The calling thread hands itself to the executor (a sweep, a pool join, a
// pool teardown), and `leave_executor` ends it. The outermost of each counts
// the thread in `WAITING_THREADS`.
func enter_executor(record: UnsafePointer<ExecutorRecord>) unsafe {
    let before = __saw_atomic_add_i64_seq_cst((&record[0].waiting) as UnsafePointer<Int>, 1)
    if before == 0 {
        let _ = WAITING_THREADS.fetch_add(1)
    }
}

func leave_executor(record: UnsafePointer<ExecutorRecord>) unsafe {
    let before = __saw_atomic_add_i64_seq_cst((&record[0].waiting) as UnsafePointer<Int>, -1)
    if before == 1 {
        let _ = WAITING_THREADS.fetch_add(-1)
    }
}

// The executor's side of the hidden-allocation boundary (design 234): a spawn
// is a form, with no expression a `try` could sit on, so a refused allocation
// of the executor's panics, naming the operation the author wrote.
//
// ENTRY POINTS:
//   `exec_alloc`
//   `alloc_or_fault`
func exec_fault(what: String, e: AllocError) -> Never {
    panic("{}: {}", what, e)
}

// `size` bytes at `align`, for operation `what`.
func exec_alloc(size: Int, align: Int, what: String) unsafe -> UnsafePointer<Int8> {
    if let raw = GlobalAllocator().alloc(size, align) {
        return raw
    }
    exec_fault(what, AllocError(size: size, align: align))
}

// A growth of the executor's bookkeeping, for operation `what`.
func alloc_or_fault(r: Result<Void, AllocError>, what: String) {
    match r {
        case Ok(_) -> {},
        case Err(e) -> exec_fault(what, e)
    }
}

func round_up(n: Int, align: Int) -> Int {
    (n + align - 1) / align * align
}

/// Allocates the storage of a task whose root frame `descriptor` describes,
/// for the compiler's spawn lowering to write the root's arguments into.
///
/// Panics if the allocation is refused.
public func __saw_exec_task_box(descriptor: UnsafePointer<FrameDescriptor>) unsafe -> UnsafePointer<UInt8> {
    exec_alloc(descriptor[0].size, descriptor[0].align, "Task.spawn") as UnsafePointer<UInt8>
}

// A fresh cell for a task of `descriptor`, ready to run.
func new_cell(descriptor: UnsafePointer<FrameDescriptor>) unsafe -> UnsafePointer<TaskCell> {
    var align = alignof<TaskCell>()
    let result_align = descriptor[0].result_align
    if result_align > align {
        align = result_align
    }
    let header = round_up(sizeof<TaskCell>(), align)
    let bytes = header + descriptor[0].result_size
    let raw = exec_alloc(bytes, align, "Task.spawn")
    let cell = raw as UnsafePointer<TaskCell>
    let result = (raw as Int + header) as UnsafePointer<UInt8>
    let context = TaskContext(park: 0 as UnsafePointer<Int>, cancel: 0 as UnsafePointer<Bool>,
                              task: raw as Int, deadline: 0)
    cell[0] = TaskCell(context: context, park: PARK_READY, cancel: false, unclaimed: false,
                       holding: false, finished: 0, descriptor: descriptor, result: result,
                       bytes: bytes, align: align)
    let park = (&cell[0].park) as UnsafePointer<Int>
    let cancel = (&cell[0].cancel) as UnsafePointer<Bool>
    cell[0].context.park = park
    cell[0].context.cancel = cancel
    cell
}

// Destroys the result `cell` holds, if any.
func drop_held_result(cell: UnsafePointer<TaskCell>) unsafe {
    if cell[0].holding {
        cell[0].holding = false
        let drop = cell[0].descriptor[0].drop_result
        drop(cell[0].result)
    }
}

func free_cell(cell: UnsafePointer<TaskCell>) unsafe {
    drop_held_result(cell)
    let bytes = cell[0].bytes
    let align = cell[0].align
    GlobalAllocator().dealloc(cell as UnsafePointer<Int8>, bytes, align)
}

// What a run-queue write gave up and its caller finishes once the lock is
// released (`retire`): a result's drop runs user code, which must not run
// under a cooperative group's latch. `cell` is 0 for nothing; with `free`
// the cell is unlinked from its slot and freed whole, without it the slot
// keeps the cell (a pinned one) and only its result is dropped.
struct Retired {
    cell: Int
    free: Bool
}

func retired_none() -> Retired {
    Retired(cell: 0, free: false)
}

func retire(r: Retired) unsafe {
    if r.cell == 0 {
        return
    }
    let cell = r.cell as UnsafePointer<TaskCell>
    if r.free {
        free_cell(cell)
    } else {
        drop_held_result(cell)
    }
}

extension TaskGroup {
    // Whether (`slot`, `generation`) no longer names the task it was minted
    // for. Every handle operation asks first, so a stale handle never reaches
    // a successor's state.
    func stale(&self, slot: Int, generation: Int) -> Bool {
        if slot < 0 || slot >= self.slots.len() {
            return true
        }
        self.slots[slot].generation != generation
    }

    func is_done(&self, slot: Int) -> Bool {
        self.slots[slot].done
    }

    // The cell of live slot `slot`.
    func cell_at(&self, slot: Int) unsafe -> UnsafePointer<TaskCell> {
        if let cell = self.slots[slot].cell {
            return cell
        }
        panic("TaskGroup: slot {} holds no task", slot)
    }

    // Whether `slot` can be resumed now: live, not on this thread's stack,
    // and woken (`park_wakes`).
    func runnable(&self, slot: Int) unsafe -> Bool {
        let s = self.slots[slot]
        if s.done || s.active {
            return false
        }
        let cell = self.cell_at(slot)
        park_wakes((&cell[0].context) as UnsafePointer<TaskContext>)
    }

    func has_live(&self) -> Bool {
        var i = 0
        while i < self.slots.len() {
            if not self.slots[i].done {
                return true
            }
            i = i + 1
        }
        false
    }

    // Whether a task other than the one in `slot` is live.
    func live_besides(&self, slot: Int) -> Bool {
        var i = 0
        while i < self.slots.len() {
            if i != slot && not self.slots[i].done {
                return true
            }
            i = i + 1
        }
        false
    }
}

// Whether the frame of slot `s` is being resumed on the stack of the thread
// whose executor record is `me`, further up than the caller: a cooperative
// task its owner resumes, or the pool task a worker resumes. Such a frame
// continues only once every drive opened above it returns, so a wait for it
// made on that thread never ends, and the deadlock walk counts it as waiting
// rather than as code that can run.
//
// ENTRY POINTS:
//   group_on_this_stack (Task.join, TaskGroup.deinit)
//   group_parks
func on_this_stack(s: TaskSlot, me: Int) -> Bool {
    not s.done && s.active && s.runner == me
}

// Whether slot `slot` of the cooperative group at `at`, or with `slot`
// negative any of its slots, is further up the calling thread's stack
// (`on_this_stack`), read under the group's lock.
func group_on_this_stack(at: UnsafePointer<TaskGroup>, slot: Int) unsafe -> Bool {
    let me = __saw_rt_thread_executor()
    lock_queue(at)
    var found = false
    var i = 0
    while i < at[0].slots.len() {
        let s = at[0].slots[i]
        if (slot < 0 || i == slot) && on_this_stack(s, me) {
            found = true
        }
        i = i + 1
    }
    unlock_queue(at)
    found
}

// The run queue's writes are `&var self` methods on `TaskGroup`, called on a
// group reached through its address as `g[0].place(..)`. None is called
// across a resume: the frame being resumed may reach the same group through
// its address.

extension TaskGroup {
    // Puts the frame at `frame` on this group's run queue with a fresh cell.
    // `owned` says the executor frees the frame when its root finishes. The
    // group is in its final storage: its owner thread's list records its
    // address until `unregister`.
    func enqueue(&var self, descriptor: UnsafePointer<FrameDescriptor>,
                 frame: UnsafePointer<UInt8>, owned: Bool) unsafe -> TaskTicket {
        register(&var self)
        let cell = new_cell(descriptor)
        let at = (&self) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>
        if self.lock == 0 {
            // Under the latch: a growth frees the old `slots` buffer, which a
            // walk on another thread may be reading.
            var g = at
            lock_queue(at)
            let ticket = g[0].place(frame, cell, owned)
            unlock_queue(at)
            return ticket
        }
        enqueue_pooled(at, frame, cell, owned)
    }
}

// A pool's enqueue: the slot is placed under the lock, the workers are told,
// and the first spawn starts them, outside the lock. Only the owning thread
// spawns into a pool, since a handle or a reference to the group is not
// `Send`, so `started` needs no compare-and-swap.
func enqueue_pooled(at: UnsafePointer<TaskGroup>, frame: UnsafePointer<UInt8>, cell: UnsafePointer<TaskCell>,
                    owned: Bool) unsafe -> TaskTicket {
    var g = at
    lock_queue(at)
    let ticket = g[0].place(frame, cell, owned)
    let start = not g[0].started
    g[0].started = true
    let poke = queue_changed(at)
    unlock_queue(at)
    if poke {
        poke_reactor()
    }
    if start {
        start_crew(&var g[0], at as Int)
    }
    ticket
}

// Wakes the pool's workers waiting on its condition variable, with its lock
// held, after a change one of them may act on, and answers whether a worker
// is blocked in the reactor's poll instead, which the caller then pokes once
// the lock is released.
func queue_changed(at: UnsafePointer<TaskGroup>) unsafe -> Bool {
    let _ = pthread_cond_broadcast(queue_cond(at))
    at[0].pollers > 0
}

extension TaskGroup {
    // Claims a reclaimed slot, or grows by one. A reused slot keeps the
    // generation its recycle advanced to.
    func place(&var self, frame: UnsafePointer<UInt8>, cell: UnsafePointer<TaskCell>,
               owned: Bool) unsafe -> TaskTicket {
        var slot = -1
        if let reused = self.free.pop() {
            slot = reused
        }
        if slot < 0 {
            slot = self.slots.len()
            // The free list never outgrows the slots, so reserving here is what
            // keeps `recycle` from needing to allocate.
            alloc_or_fault(self.free.reserve(slot + 1), "Task.spawn")
            let fresh = TaskSlot(frame: None, cell: None, generation: 1, done: true, active: false, runner: 0,
                                 owned: false, pinned: false)
            alloc_or_fault(self.slots.push(fresh), "Task.spawn")
        }
        let generation = self.slots[slot].generation
        let entry = TaskSlot(frame: frame, cell: cell, generation: generation, done: false,
                             active: false, runner: 0, owned: owned, pinned: false)
        self.slots[slot] = entry
        TaskTicket(slot: slot, generation: generation)
    }
}

extension TaskGroup {
    // Retires `slot`: its generation advances, so every handle to the task that
    // left goes stale, and its cell is unlinked for the caller to free (`retire`)
    // and the slot freed for the next spawn. A pinned slot keeps its cell, whose
    // result the caller drops, and is never reused: a peer may still write the
    // cancel word whose address it was handed (`Task.cancel_addr`).
    func recycle(&var self, slot: Int) unsafe -> Retired {
        let cell = self.cell_at(slot)
        let next = self.slots[slot].generation + 1
        self.slots[slot].generation = next
        if self.slots[slot].pinned {
            return Retired(cell: cell as Int, free: false)
        }
        self.slots[slot].cell = None
        alloc_or_fault(self.free.push(slot), "Task.spawn")
        Retired(cell: cell as Int, free: true)
    }
}

extension TaskGroup {
    // The root of `slot` returned `Ready`. Its result moves into the cell and the
    // frame's storage is released, the one place a frame is. The cell holds the
    // result while a handle may still join it, whatever its size, `Void` included,
    // so "holds a result" never depends on the result's bytes. A task no handle
    // claims gives up its slot here, its result dropped by the caller (`retire`),
    // which keeps a group's slots bounded by its live tasks and the finished ones
    // a live handle still claims. A frame has no drop glue, so only a frame whose
    // own code reached its end holds nothing that still needs destroying
    // (SL:coroutines §3.1).
    func complete(&var self, slot: Int) unsafe -> Retired {
        let s = self.slots[slot]
        let cell = self.cell_at(slot)
        let descriptor = cell[0].descriptor
        if let frame = s.frame {
            if s.owned {
                let from = (frame as Int + descriptor[0].result_offset) as UnsafePointer<Int8>
                copy_bytes(from, cell[0].result as UnsafePointer<Int8>, descriptor[0].result_size)
                cell[0].holding = true
                GlobalAllocator().dealloc(frame as UnsafePointer<Int8>, descriptor[0].size,
                                          descriptor[0].align)
            }
        }
        self.slots[slot].frame = None
        // Ahead of `done`, which the deadlock walk reads first: a walk that finds
        // the slot done finds the word set when it reads the driving join's park
        // again (`quiescent_now`).
        let _ = __saw_atomic_add_i64_seq_cst((&cell[0].finished) as UnsafePointer<Int>, 1)
        self.slots[slot].done = true
        if cell[0].unclaimed || not cell[0].holding {
            return self.recycle(slot)
        }
        retired_none()
    }
}

extension TaskGroup {
    // The handle to `slot` lets go of the task's result without taking it. A task
    // that has finished gives up its slot now, its result dropped by the caller
    // (`retire`); a live one is marked, and `complete` does both when it
    // finishes. A stale handle's slot has moved on, and nothing is done.
    //
    // ENTRY POINTS:
    //   Task.detach
    //   Task.deinit
    func unclaim_slot(&var self, slot: Int, generation: Int) unsafe -> Retired {
        if self.stale(slot, generation) {
            return retired_none()
        }
        let cell = self.cell_at(slot)
        cell[0].unclaimed = true
        if self.slots[slot].done {
            return self.recycle(slot)
        }
        retired_none()
    }
}

extension TaskGroup {
    // Asks every live task in this group to stop.
    func cancel_every_live(&var self) unsafe {
        var i = 0
        while i < self.slots.len() {
            if not self.slots[i].done {
                request_cancel(self.cell_at(i))
            }
            i = i + 1
        }
    }
}

// Asks the task of `cell` to stop. Only the cancel word is written: the park
// word stays what the task's last park recorded, and the wake is the
// executor's, read when it next decides what can run (`park_wakes`).
//
// ENTRY POINTS:
//   Task.cancel
//   TaskGroup.cancel_every_live
func request_cancel(cell: UnsafePointer<TaskCell>) unsafe {
    cell[0].cancel = true
}

// Whether the park recorded through `cx` can be resumed now: when it is a
// ready one, a descriptor park the reactor latched included; when its task
// has been asked to stop, for every reason but the two below, so a cancelled task
// reaches its cancel path at its next turn and each park it makes after that
// resumes at once, a timer's long before its deadline (SL:coroutines §3.1);
// when it is a timer whose deadline has passed; when it is a bounded
// descriptor park whose deadline has passed; when it is a channel's
// readiness word that is set; when it is a join whose thread has exited; and
// when it is an offload whose C call has returned. A cancel wakes neither of
// the last two: a thread cannot be asked to stop and a C call cannot be
// interrupted, so a woken wait would only park again, at once, until it ends.
//
// The readiness word is read atomically: a `Thread.spawn` body or a pool
// worker may set it from another thread, and this load pairs with
// `publish_ready`'s store, so a set
// word brings the message's queue writes with it. Both are sequentially
// consistent, which the poke handshake also needs (`poke_reactor`).
//
// The cancel word is read here, after the resume that parked has returned,
// so the park's record and its arm both precede the read: a cancel that
// arrives before the record, between the record and the arm, or after both
// is seen at this read, and nothing a cancel writes can be overwritten by a
// later record (SL:coroutines R3).
//
// A channel park registers nothing anywhere: the park word itself is the
// registration, and every resume overwrites it with `PARK_UNSET` first. It is
// read only while its task is live and parked, when the receiver's handle,
// held in the parked frame, keeps the word allocated.
//
// ENTRY POINTS:
//   TaskGroup.runnable
//   should_stop (a drive point's own park)
//   idle
func park_wakes(cx: UnsafePointer<TaskContext>) unsafe -> Bool {
    let park = park_word(cx)
    let reason = park_reason(park)
    if reason == ParkReason.Join {
        return __saw_atomic_load_i64_seq_cst(joined_word(park)) < 0
    }
    if reason == ParkReason.Offload {
        return __saw_exec_offload_done(offload_job(park))
    }
    if reason == ParkReason.Ready || cx[0].cancel[0] {
        return true
    }
    if reason == ParkReason.Descriptor {
        let deadline = cx[0].deadline
        return deadline != 0 && monotonic_now() >= deadline
    }
    if reason == ParkReason.Channel {
        let word = (0 - park) as UnsafePointer<Int>
        return __saw_atomic_load_i64_seq_cst(word) != 0
    }
    reason == ParkReason.Timer && monotonic_now() >= cx[0].deadline
}

// The park word recorded through `cx`, read atomically: the reactor's poll
// latches a descriptor park from whichever thread polls, a pool worker's
// among them.
func park_word(cx: UnsafePointer<TaskContext>) unsafe -> Int {
    __saw_atomic_load_i64_seq_cst(cx[0].park)
}

func monotonic_now() -> UInt64 {
    __saw_rt_clock_monotonic_nanos() as UInt64
}

extension TaskGroup {
    // Releases every slot's cell, dropping any result nobody took. A slot still
    // holding a frame means a frame would be released before its root returned
    // `Ready`, which would lose that frame's live values unseen. It runs once the
    // group is unlinked (`unregister`), so no walk can reach a cell it frees, and
    // a result's drop runs under no lock.
    //
    // ENTRY POINTS:
    //   TaskGroup.deinit
    //   __saw_exec_close_background
    func release_slots(&var self) unsafe {
        var i = 0
        while i < self.slots.len() {
            if self.slots[i].frame.is_some() {
                panic("TaskGroup: a task's frame was released before its root returned Ready")
            }
            if let cell = self.slots[i].cell {
                free_cell(cell)
                let next = self.slots[i].generation + 1
                self.slots[i].cell = None
                self.slots[i].generation = next
            }
            i = i + 1
        }
    }
}

// Links `group` into the calling thread's list, once, which makes the
// calling thread its owner.
func register(group: &var TaskGroup) unsafe {
    if group.registered {
        return
    }
    let record = this_executor()
    let head = (&record[0].groups) as UnsafePointer<Int>
    latch_take(record)
    group.owner = record as Int
    group.next = load_word(head)
    store_word(head, (&group) as UnsafePointer<TaskGroup> as Int)
    group.registered = true
    latch_give(record)
}

extension TaskGroup {
    // Unlinks this group from its owner's list, fixing its predecessor's `next`,
    // under the owner's latch: once it returns, no walk is reading the group or
    // can reach it, so its storage may go.
    func unregister(&var self) unsafe {
        if not self.registered {
            return
        }
        let record = self.owner as UnsafePointer<ExecutorRecord>
        latch_take(record)
        self.registered = false
        unlink_group(record, (&self) as UnsafePointer<TaskGroup> as Int, self.next)
        latch_give(record)
    }
}

// Removes the group at `me`, whose successor is `after_me`, from `record`'s
// list, with its latch held.
func unlink_group(record: UnsafePointer<ExecutorRecord>, me: Int, after_me: Int) unsafe {
    let list = (&record[0].groups) as UnsafePointer<Int>
    let head = load_word(list)
    if head == me {
        store_word(list, after_me)
        return
    }
    var cur = head
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let after = g[0].next
        if after == me {
            g[0].next = after_me
            return
        }
        cur = after
    }
}

// Runs the frame at `frame` to its next park or its end: the one place the
// executor calls into a frame. Its body is the descriptor's `resume` stand-in
// until the backend's `__saw_frame_resume(descriptor, frame, context)`
// exists; the call then becomes that helper's, with the same three operands,
// since Saw code cannot call a raw code pointer (SL:coroutines §3.1).
func resume_frame(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                  context: UnsafePointer<TaskContext>) unsafe -> Poll {
    let resume = descriptor[0].resume
    resume(frame, context)
}

// Opens a turn of the task whose context is at `context` on `record`'s
// thread, the calling one: until the matching `end_turn`, `cancelled()` in
// code no frame lowers answers for that task. Returns the task the thread
// named before, which `end_turn` restores. A drive made inside the turn opens
// and ends turns of its own before it returns, so the turns nest as the
// thread's waits do and each end restores the task its caller is running. A
// turn covers the resume and, when the task finished, its completion's
// bookkeeping, since an unclaimed result dropped there is the finished
// task's own teardown. A panic aborts, so no turn is ever left open past one.
//
// ENTRY POINTS:
//   resume_slot
//   worker_resume
//   drive_frame
func begin_turn(record: UnsafePointer<ExecutorRecord>, context: UnsafePointer<TaskContext>) unsafe -> Int {
    let outer = record[0].current
    record[0].current = context as Int
    outer
}

func end_turn(record: UnsafePointer<ExecutorRecord>, outer: Int) unsafe {
    record[0].current = outer
}

// Whether the task whose turn the calling thread is running has been asked
// to stop: false outside every turn, a thread that never drove a task's
// included. The body of `__saw_cancel_requested`, which a lowered frame reads
// through its own context instead.
public(package) func __saw_exec_cancel_requested() unsafe -> Bool {
    let r = __saw_rt_thread_executor()
    if r == 0 {
        return false
    }
    let cx = (r as UnsafePointer<ExecutorRecord>)[0].current
    if cx == 0 {
        return false
    }
    (cx as UnsafePointer<TaskContext>)[0].cancel[0]
}

// Resumes `slot` of the group at `g` once, then records what it reported.
//
// Nothing is borrowed from the group across the resume: the frame may spawn,
// which grows `slots`, and a join inside it runs a nested sweep over this
// same group. `active` keeps that sweep off this frame.
//
// The claim and the outcome are each a section of the group's latch, and the
// resume runs between them with no lock held: a walk on another thread sees
// the slot parked, with its park word and the word it names alive, or active.
// `record` is the sweeping thread's, which counts the resume.
func resume_slot(at: UnsafePointer<TaskGroup>, slot: Int, record: UnsafePointer<ExecutorRecord>) unsafe {
    var g = at
    lock_queue(at)
    let s = g[0].slots[slot]
    let cell = g[0].cell_at(slot)
    guard let frame = s.frame else {
        unlock_queue(at)
        return
    }
    g[0].slots[slot].active = true
    g[0].slots[slot].runner = record as Int
    cell[0].park = PARK_UNSET
    unlock_queue(at)
    let context = (&cell[0].context) as UnsafePointer<TaskContext>
    let outer = begin_turn(record, context)
    let poll = resume_frame(cell[0].descriptor, frame, context)
    lock_queue(at)
    count_turn(record)
    g[0].slots[slot].active = false
    var retired = retired_none()
    match poll {
        case Ready -> { retired = g[0].complete(slot) },
        case Pending -> {
            if cell[0].park == PARK_UNSET {
                // The section's writes are done, so the latch goes back first
                // and the panic's dump names this task.
                unlock_queue(at)
                panic("executor: a task reported Pending without recording a park")
            }
        }
    }
    unlock_queue(at)
    retire(retired)
    end_turn(record, outer)
}

// Whether the sweep `sweep` was asked for is finished: with `waiter` nonzero,
// when the drive point's park recorded through the context at that address
// wakes; otherwise, with `term_group` 0, when no group of `record`'s thread has
// a live task; with `term_slot` negative, when that group has none; otherwise
// when that task is done, or its slot has moved on to a successor.
func should_stop(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int,
                 record: UnsafePointer<ExecutorRecord>) unsafe -> Bool {
    if waiter != 0 {
        return park_wakes(waiter as UnsafePointer<TaskContext>)
    }
    if term_group != 0 {
        let g = term_group as UnsafePointer<TaskGroup>
        if term_slot >= 0 {
            return g[0].stale(term_slot, term_gen) || g[0].is_done(term_slot)
        }
        return not g[0].has_live()
    }
    var cur = load_word((&record[0].groups) as UnsafePointer<Int>)
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        if g[0].lock == 0 && g[0].has_live() {
            return false
        }
        cur = g[0].next
    }
    true
}

// The sweep a join, a group's teardown and the entry executor run: until the
// task, the group or every group named is finished (`should_stop`).
func exec_run(term_group: Int, term_slot: Int, term_gen: Int) unsafe {
    sweep(term_group, term_slot, term_gen, 0)
}

// The scheduler sweep, shared by every drive point: resumes woken frames
// round-robin across every cooperative group the calling thread registered
// until `should_stop` says the sweep is finished, and when a pass wakes
// nothing, waits for the earliest timer (`idle`). Another thread's groups are
// that thread's to run, and a pool's frames are its workers', so the sweep
// never resumes either.
//
// A nested sweep (a task joins a task) skips every frame active on this
// thread's stack, and returns when every live frame is one of those and it
// has no timer of its own to wait for, ceding to the sweep further up.
func sweep(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int) unsafe {
    let record = this_executor()
    enter_executor(record)
    record[0].sweeps += 1
    sweep_passes(term_group, term_slot, term_gen, waiter, record)
    record[0].sweeps -= 1
    leave_executor(record)
}

func sweep_passes(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int,
                  record: UnsafePointer<ExecutorRecord>) unsafe {
    while not should_stop(term_group, term_slot, term_gen, waiter, record) {
        var resumed = false
        var cur = load_word((&record[0].groups) as UnsafePointer<Int>)
        while cur != 0 {
            let g = cur as UnsafePointer<TaskGroup>
            var i = 0
            while g[0].lock == 0 && i < g[0].slots.len() {
                if g[0].runnable(i) {
                    resume_slot(g, i, record)
                    resumed = true
                    if should_stop(term_group, term_slot, term_gen, waiter, record) {
                        return
                    }
                }
                i = i + 1
            }
            cur = g[0].next
        }
        if not resumed && not idle(waiter, record) {
            return
        }
    }
}

// A pass woke nothing: blocks in the reactor's poll, which latches each
// descriptor that becomes ready, until the earliest deadline among the timers
// and the bounded descriptor parks off this thread's stack, the drive point's
// park at `waiter` among them, or with no deadline at all when only unbounded
// descriptor parks and offloads wait, and answers true; answers false when there is no
// such park and no channel park either, since every live frame is then on
// this thread's stack. A frame parked on a wait this executor does not
// perform is refused rather than spun on, since nothing here would ever wake
// it.
//
// With no timer or descriptor to wait for and a channel park left, the
// deadlock walk decides (`check_quiescent`): it reports when nothing in the
// process can run, and otherwise this blocks in the reactor's poll and
// answers true, since the word's writer is then code running on another
// thread: a `Thread.spawn` body or a pool's task, whose `send` and `close`
// poke the reactor and whose exit pokes it too (`poke_reactor`). While either
// can run, the walk finds nothing to report, so this waits. A join waits the
// same way, for the poke its thread's exit makes after it sets the word, and
// a join or a teardown on a pool driven here (`drive_on_word`) waits for the
// poke a worker makes once the word is set. A pool's frames are its workers'
// to wait for, and another thread's groups that thread's, so neither is read
// here.
func idle(waiter: Int, record: UnsafePointer<ExecutorRecord>) unsafe -> Bool {
    var waits = false
    var channel = false
    var earliest = UInt64.max
    if waiter != 0 {
        let w = waiter as UnsafePointer<TaskContext>
        if park_wakes(w) {
            return true
        }
        let park = park_word(w)
        if polls_for(park) {
            waits = true
            if bounded_by(park, w[0].deadline) {
                earliest = w[0].deadline
            }
        } else if park < PARK_FD {
            channel = true
        }
    }
    let lead = "executor"
    var cur = load_word((&record[0].groups) as UnsafePointer<Int>)
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        var i = 0
        while g[0].lock == 0 && i < g[0].slots.len() {
            let s = g[0].slots[i]
            if not s.done && not s.active {
                let cell = g[0].cell_at(i)
                let cx = (&cell[0].context) as UnsafePointer<TaskContext>
                // The clock moved on since the pass, or a deadline it read as
                // future has passed: the next pass resumes the frame.
                if park_wakes(cx) {
                    return true
                }
                let park = park_word(cx)
                if not waits_on(park) {
                    refuse_park(&lead, "a task", park)
                }
                if polls_for(park) {
                    waits = true
                    let deadline = cell[0].context.deadline
                    if bounded_by(park, deadline) && deadline < earliest {
                        earliest = deadline
                    }
                } else {
                    channel = true
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
    // A writer pokes only a reactor that exists, so a channel wait publishes
    // one and then looks again. Every later look follows the publication, and
    // a writer either set its word before it, which that look sees, or reads
    // the reactor after it and pokes.
    if channel && REACTOR.load() == 0 {
        let _ = host_reactor()
        return true
    }
    if waits {
        if earliest == UInt64.max {
            // Only unbounded descriptor parks wait, so nothing but a
            // descriptor becoming ready can wake one.
            idle_poll(-1)
        } else {
            wait_until(earliest)
        }
        return true
    }
    if channel {
        check_quiescent(waiter, false, record)
        idle_poll(-1)
        return true
    }
    false
}

// How many pools have started their workers and not yet joined them.
static LIVE_POOLS: Atomic<Int> = Atomic(0)

// How many threads wait inside the executor: those whose record's `waiting`
// is above zero, a pool's workers among them.
static WAITING_THREADS: Atomic<Int> = Atomic(0)

// The longest an idle wait blocks in the reactor's poll while several threads
// may poll it, in milliseconds: while a pool's workers are live, or while more
// than one thread waits inside the executor.
//
// Several threads then poll one reactor, and a wait need not end where it
// should. The poll that receives a descriptor's event may be another
// thread's, which latches the word and returns, while the thread that
// schedules that frame stays blocked (the run probe
// `executor_threads_share_the_reactor`); and a poke is released only to the
// pollers already blocked, so a waiter between its last look and its poll
// can miss one. A `cancel_addr` write pokes nothing at all. Each costs this
// long at most.
static SHARED_POLL_CAP_MILLIS: Int = 50

// Blocks in the reactor's poll for up to `millis` milliseconds, forever when
// negative, but never longer than `SHARED_POLL_CAP_MILLIS` while several
// threads may poll.
//
// ENTRY POINTS:
//   idle
//   wait_until
//   pool_wait
func idle_poll(millis: Int) unsafe {
    var bound = millis
    let shared = LIVE_POOLS.load() > 0 || WAITING_THREADS.load() > 1
    if shared && (bound < 0 || bound > SHARED_POLL_CAP_MILLIS) {
        bound = SHARED_POLL_CAP_MILLIS
    }
    reactor_poll(bound)
}

// The confirmation nap between the deadlock walk's two looks.
static QUIESCENT_NAP_NANOS: UInt64 = 1_000_000

// Whether no code in this process can run any more, with at least one task
// parked on a channel's readiness word that is clear: the quiescent state the
// deadlock report keys on (design 230).
//
// Whether a sender will ever exist for a channel is not decidable, but a
// readiness word is published only by running code, so the walk asks only
// whether any code can run, by elimination. Each of these ends it:
//   * a running `Thread.spawn` body (`LIVE_THREADS`), read before any
//     readiness word: a body that sends and then exits lowers the count after
//     its send, so a walk that reads the count as zero sees the word set;
//   * a live frame that is not active and whose park wakes now (`park_wakes`:
//     ready, latched, cancelled, a deadline passed, a set readiness word);
//   * a frame parked on a timer or a descriptor, since its deadline or the
//     reactor can wake it;
//   * any other park that is not a channel's, a join and an offload among
//     them: a joined thread sets its word before it lowers `LIVE_THREADS`,
//     and an offloaded call ends on its own thread, so neither waits for
//     good, and the walk reads neither's object;
//   * a frame active on another thread's stack: a pool task a worker is
//     resuming, or a cooperative task its owner is;
//   * from a pool worker, a thread outside the executor (a live record that
//     is not `waiting`): a pool's workers are no `Thread.spawn` bodies to
//     `LIVE_THREADS`, so the walk has to learn some other way that the
//     threads owning the groups are waiting rather than computing toward a
//     send.
// A frame active on the walking thread's own stack (`on_this_stack`), a
// cooperative task or the pool task the walking worker resumes, counts as
// blocked: it is waiting in a nested join or drive on the very sweep that
// asks, so it cannot run before that sweep returns, and the spec reports this
// state rather than waiting forever. The drive point's own park at `waiter`,
// on no run queue, is classified as any slot's is, and read again after the
// groups: a join or teardown driven on a pool's word sees that word set
// before the slot's `done`, so a walk that found the slot done finds the word
// set at that second read.
//
// The walk reads every thread's groups, since a task on any of them may be
// the sender, each record under its latch and each pool under its own lock
// (`walk_take`), so nothing it reads can be freed under it and no parked task
// can be resumed while it looks. A lock it cannot take counts as code that
// can run: its holder is acting. Groups are read one after another, so a task
// could run between two of them and the walk see it parked in both; every
// resume is counted in its thread's record, and a walk across which any
// count moved counts as code that ran.
//
// ENTRY POINTS:
//   check_quiescent
func quiescent_now(waiter: Int, on_worker: Bool, walker: UnsafePointer<ExecutorRecord>) unsafe -> Bool {
    if LIVE_THREADS.load() != 0 {
        return false
    }
    if on_worker && some_thread_runs() {
        return false
    }
    let turns = turns_now()
    var parked = false
    if waiter != 0 {
        let w = waiter as UnsafePointer<TaskContext>
        if not channel_parked(w) {
            return false
        }
        parked = true
    }
    var at = EXEC_RECORDS.load()
    while at != 0 {
        let record = at as UnsafePointer<ExecutorRecord>
        if walk_take(record) != WalkLock.Taken {
            return false
        }
        let found = record_parks(record, walker as Int)
        walk_give(record)
        if found == RecordParks.Runs {
            return false
        }
        if found == RecordParks.Channel {
            parked = true
        }
        at = record[0].next
    }
    if waiter != 0 && park_wakes(waiter as UnsafePointer<TaskContext>) {
        return false
    }
    if turns_now() != turns {
        return false
    }
    parked
}

// What one record's groups say to the deadlock walk.
enum RecordParks {
    // A task can run, or a lock was busy.
    case Runs,
    // No live task.
    case Empty,
    // Every live task is parked on a clear channel word, or active on the
    // walking thread's own stack, and one at least is parked.
    case Channel
}

// The deadlock walk over `record`'s groups, with its latch held, made by the
// thread whose executor record is `walker`.
func record_parks(record: UnsafePointer<ExecutorRecord>, walker: Int) unsafe -> RecordParks {
    var parked = false
    var cur = load_word((&record[0].groups) as UnsafePointer<Int>)
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let pooled = g[0].lock != 0
        if pooled && walk_take_pool(g) != WalkLock.Taken {
            return RecordParks.Runs
        }
        let found = group_parks(g, walker)
        if pooled {
            walk_give_pool(g)
        }
        if found == RecordParks.Runs {
            return RecordParks.Runs
        }
        if found == RecordParks.Channel {
            parked = true
        }
        cur = g[0].next
    }
    if parked {
        return RecordParks.Channel
    }
    RecordParks.Empty
}

// The deadlock walk over the group at `g`, its lock held, made by the thread
// whose executor record is `walker`. An active slot runs on another thread,
// unless it is on the walker's own stack.
func group_parks(g: UnsafePointer<TaskGroup>, walker: Int) unsafe -> RecordParks {
    var parked = false
    var i = 0
    while i < g[0].slots.len() {
        let s = g[0].slots[i]
        if not s.done {
            if s.active && not on_this_stack(s, walker) {
                return RecordParks.Runs
            }
            if not s.active {
                let cell = g[0].cell_at(i)
                let cx = (&cell[0].context) as UnsafePointer<TaskContext>
                // Every reason but a channel's is a wait that ends without a
                // send (a join's thread or an offload's call finishes), so it
                // counts as code that can run, and its object is never read.
                if park_reason(park_word(cx)) != ParkReason.Channel || not channel_parked(cx) {
                    return RecordParks.Runs
                }
                parked = true
            }
        }
        i = i + 1
    }
    if parked {
        return RecordParks.Channel
    }
    RecordParks.Empty
}

// Whether a thread that owns an executor record is running code of its own
// rather than waiting inside the executor.
func some_thread_runs() unsafe -> Bool {
    var at = EXEC_RECORDS.load()
    while at != 0 {
        let record = at as UnsafePointer<ExecutorRecord>
        let live = load_word((&record[0].live) as UnsafePointer<Int>) != 0
        if live && load_word((&record[0].waiting) as UnsafePointer<Int>) == 0 {
            return true
        }
        at = record[0].next
    }
    false
}

// Whether the park recorded through `cx` is a channel's readiness word that
// is clear, with its task not cancelled: the one park the deadlock walk counts
// as waiting for good.
func channel_parked(cx: UnsafePointer<TaskContext>) unsafe -> Bool {
    if park_wakes(cx) {
        return false
    }
    let park = park_word(cx)
    park_reason(park) == ParkReason.Channel
}

// Set by the first deadlock report, so a second engine reaching the same
// state stays quiet while the first one ends the process.
static DEADLOCK_REPORTED: Atomic<Int> = Atomic(0)

// The deadlock report: panics when the walk finds the process quiescent
// twice, a nap apart, and returns otherwise. The second look costs a real
// deadlock a nap and confirms what the first saw: a word set or a thread
// started between them, which no count of resumes records, ends it.
//
// ENTRY POINTS:
//   idle
//   pool_wait (`on_worker`)
func check_quiescent(waiter: Int, on_worker: Bool, walker: UnsafePointer<ExecutorRecord>) unsafe {
    if not quiescent_now(waiter, on_worker, walker) {
        return
    }
    __saw_rt_sleep_ns(QUIESCENT_NAP_NANOS)
    if not quiescent_now(waiter, on_worker, walker) {
        return
    }
    if not DEADLOCK_REPORTED.compare_exchange(0, 1) {
        return
    }
    if POOL_DRIVES.load() > 0 {
        panic("deadlock: every task is waiting to receive from a channel, or to join a `TaskGroup(threads:)` task that is, and nothing in this program can send. A join or a pool's teardown made inside a task runs the thread's other tasks until it returns, so the waits begun inside it return first. A producer that is finished must say so with close()")
    }
    panic("deadlock: every task is waiting to receive from a channel, and nothing in this program can send. A channel has no sender count — every handle is the same handle — so a producer that is finished must say so with close(), and a receive on a closed, drained channel returns Err(Closed) instead of waiting")
}

// Whether park word `park` waits until the context's `deadline`: a timer
// always does, and a descriptor park when its deadline is nonzero.
func bounded_by(park: Int, deadline: UInt64) -> Bool {
    park == PARK_TIMER || (park == PARK_FD && deadline != 0)
}

// Whether the executor performs the wait park word `park` records. A ready
// park needs none; a cancel wakes every reason but a join and an offload
// (`park_wakes`).
func waits_on(park: Int) -> Bool {
    park == PARK_READY || park == PARK_TIMER || (park <= PARK_FD && park != PARK_UNSET)
}

// Panics for park word `park`, a wait the executor does not perform, which
// `subject` recorded: `lead` opens the message.
func refuse_park(lead: &String, subject: String, park: Int) -> Never {
    panic("{}: {} recorded park word {}, which names no park", lead, subject, park)
}

// The process-wide reactor instance, created on first use; 0 until then
// (runtime/ABI.md, "The IO reactor").
static REACTOR: Atomic<Int> = Atomic(0)

// The process-wide reactor. A thread that loses the race to publish its new
// instance destroys it and takes the winner's.
//
// A reactor that cannot be made (descriptor exhaustion, say) leaves the
// executor nothing to wait in, and no caller has an error channel, so it
// panics with the cause; an instance every poll returns from at once would
// make the executor spin through every timed wait.
func host_reactor() unsafe -> Int {
    let current = REACTOR.load()
    if current != 0 {
        return current
    }
    var fresh = 0
    if __saw_rt_reactor_create((&fresh) as UnsafePointer<Int>) != 0 {
        panic("reactor: creating the reactor failed (errno {})", __saw_rt_last_raw_code())
    }
    if REACTOR.compare_exchange(0, fresh) {
        return fresh
    }
    __saw_rt_reactor_destroy(fresh)
    REACTOR.load()
}

// Rouses every thread blocked in the reactor's poll, when a reactor exists,
// so it looks again at what changed. A program that never waited makes none,
// so its channel traffic costs neither a descriptor nor an allocation.
//
// The poke and the look form one handshake with `idle`, which publishes the
// reactor before its last look: the writer stores its change and then reads
// `REACTOR`, the waiter stores `REACTOR` and then reads the change, all
// sequentially consistent, so at least one of the two sees the other's store.
// Release and acquire alone would allow both to miss.
//
// ENTRY POINTS:
//   __saw_exec_chan_wake
//   __saw_exec_thread_finished
//   enqueue_pooled
//   worker_resume
//   Task.cancel
func poke_reactor() {
    let r = REACTOR.load()
    if r != 0 {
        __saw_rt_reactor_wake(r)
    }
}

// How many `Thread.spawn` bodies are running. No run queue knows about one, and
// one may send to a channel a task waits on, so the deadlock walk reports
// nothing and `idle` waits while it is nonzero (design 230). Raised at the
// spawn before the thread exists, and lowered by the thread's exit once its
// body's effects are done, as the last thing the thread does. A pool's
// workers are not counted while they serve it (`start_crew`).
//
// The lowering needs only a release and the walk's read only an acquire. Both
// are sequentially consistent instead, as `Atomic` is: stronger, and the poke
// handshake with `idle` needs it (`poke_reactor`).
static LIVE_THREADS: Atomic<Int> = Atomic(0)

// Counts one more running `Thread.spawn` body: the spawn lowering's call,
// made before the thread is started. Only that lowering moves the count. A
// spawn the operating system refuses takes it back with
// `__saw_exec_thread_finished`.
public(package) func __saw_exec_thread_started() {
    let _ = LIVE_THREADS.fetch_add(1)
}

// Counts one running `Thread.spawn` body fewer, then wakes an executor blocked
// in the reactor's poll so its deadlock walk looks again: the last call a
// spawned thread makes, after its body's effects.
public(package) func __saw_exec_thread_finished() {
    // Sequentially consistent, so at least a release of everything the body
    // did, and ordered ahead of the poke's read (`poke_reactor`).
    let _ = LIVE_THREADS.fetch_add(-1)
    poke_reactor()
}

// A channel's readiness word changed: `send` and `close` call this after they
// publish it, so a receiver's executor blocked in the reactor's poll on
// another thread sees the word at once rather than at its next timeout.
public(package) func __saw_exec_chan_wake() {
    poke_reactor()
}

// The pool (SL:coroutines A17a). One mutex-protected run queue, the group's
// own slots, served by the group's workers: a worker claims a runnable frame
// under the lock by marking its slot active, resumes it with the lock
// released, and takes the lock again to record what it reported. Every
// address a resume needs is the frame's or its cell's, never one into
// `slots`, so the owning thread may grow the queue while a frame runs. A
// worker with nothing to run waits on the condition variable while nothing
// outside the lock can make a frame runnable, and in the reactor's poll while
// something can: a timer, a descriptor, a channel's readiness word, a cancel.

// Starts the pool of `group`, whose address is `addr`: its first spawn's last
// step, outside the lock, on the owning thread.
//
// A worker is a `Thread.spawn` body but no user thread: whatever it runs is a
// frame in this group, which the deadlock walk reads directly. So it is taken
// back out of `LIVE_THREADS` once started, where the count would keep every
// program with a pool from reporting a deadlock; `shutdown_crew` puts it back
// ahead of the join, whose thread exit takes it out again.
//
// The group has no error channel at a spawn, so a thread the operating
// system refuses panics, naming the error.
//
// The workers it starts write the group while this runs, so it reads and
// writes only `threads` and `crew`, which no worker touches.
func start_crew(group: &var TaskGroup, addr: Int) unsafe {
    let n = group.threads
    alloc_or_fault(group.crew.reserve(n), "TaskGroup(threads:)")
    let _ = LIVE_POOLS.fetch_add(1)
    var i = 0
    while i < n {
        match Thread.spawn({ [addr] in exec_worker(addr) }) {
            case Ok(worker) -> {
                let _ = LIVE_THREADS.fetch_add(-1)
                // The handle's fate is the teardown's join: the group
                // declares a `deinit` (`shutdown_crew`).
                alloc_or_fault(group.crew.push(move worker), "TaskGroup(threads:)")
            },
            case Err(e) -> {
                panic("TaskGroup(threads: {}): starting worker thread {} failed (errno {}): {}", n, i + 1,
                      __saw_rt_last_raw_code(), e)
            }
        }
        i = i + 1
    }
}

// Retires the pool of the group at `at`, from its teardown: no more work is
// coming, every worker finishes the live tasks and leaves once none is left,
// and each is joined, once. Nothing is cancelled. A pool that never started
// has nothing to tell and nothing to join.
//
// The owning thread waits inside the executor meanwhile, so a worker whose
// tasks are all parked on channels nothing can send to reports it. A
// teardown on a thread that drives tasks has already run them until the pool
// drained (`drain_pool`), and runs them on while each worker's exit finishes
// (`join_crew`).
func shutdown_crew(at: UnsafePointer<TaskGroup>) unsafe {
    var g = at
    if not g[0].started {
        return
    }
    let record = this_executor()
    enter_executor(record)
    lock_queue(at)
    g[0].stopping = true
    let poke = queue_changed(at)
    unlock_queue(at)
    if poke {
        poke_reactor()
    }
    join_crew(&var g[0].crew)
    g[0].started = false
    let _ = LIVE_POOLS.fetch_add(-1)
    leave_executor(record)
}

// Runs the calling thread's tasks until the stopping pool at `at` has no live
// task, when the thread drives tasks: a pool dropped inside a task would
// otherwise block every other task on its thread until the pool's tasks
// finish, and forever when one of them waits on such a task. The teardown's
// first step; on a thread that drives nothing, the teardown blocks as it
// always has (`shutdown_crew`).
func drain_pool(at: UnsafePointer<TaskGroup>) unsafe {
    var g = at
    if not g[0].started {
        return
    }
    let record = this_executor()
    if record[0].sweeps == 0 {
        return
    }
    lock_queue(at)
    g[0].stopping = true
    let live = g[0].has_live()
    let poke = queue_changed(at)
    unlock_queue(at)
    if poke {
        poke_reactor()
    }
    if live {
        drive_on_word((&g[0].drained) as UnsafePointer<Int>)
    }
}

// How many drives on a pool's word (`drive_on_word`) are open, on any thread.
// A worker that finishes a task pokes the reactor while one is, since the
// driving thread may be blocked in the poll waiting for that word; the deadlock
// report names such a wait when one is open.
static POOL_DRIVES: Atomic<Int> = Atomic(0)

// Runs the calling thread's tasks until the word at `word`, which a pool's
// worker writes once, is nonzero: a nested sweep whose drive point is parked
// on that word as a channel's readiness word, so `idle` and the deadlock walk
// read it as they read any drive point's park. A cancel does not end it, as it
// does not end a join.
//
// The frame that asked stays on this thread's stack until the word is set, so
// the waits begun inside the drive, a join's or a teardown's, return first.
//
// ENTRY POINTS:
//   await_task
//   drain_pool
func drive_on_word(word: UnsafePointer<Int>) unsafe {
    let _ = POOL_DRIVES.fetch_add(1)
    var park = 0 - (word as Int)
    var cancel = false
    var context = TaskContext(park: (&park) as UnsafePointer<Int>, cancel: (&cancel) as UnsafePointer<Bool>,
                              task: 0, deadline: 0)
    sweep(0, -1, 0, (&context) as UnsafePointer<TaskContext> as Int)
    let _ = POOL_DRIVES.fetch_add(-1)
}

// Joins each of a stopping pool's workers, putting each back in
// `LIVE_THREADS` first, since its thread's exit takes it out again.
//
// This is the group's `Deinit` barrier, which cannot park, so the reap is a
// plain call rather than `Thread.join`. A worker's exit closes its own
// background group first, which may wait on a join or an offloaded call, so
// on a thread that drives tasks each worker's exit is driven for
// (`drive_on_exit`) before its reap, which is then prompt; elsewhere the reap
// blocks the thread until the worker ends.
func join_crew(crew: &var Vector<Thread<Void>>) unsafe {
    let drives = this_executor()[0].sweeps > 0
    while let worker = crew.pop() {
        var held = move worker
        let _ = LIVE_THREADS.fetch_add(1)
        if drives {
            drive_on_exit(held.__saw_exit_word())
        }
        held.__saw_reap()
    }
}

// Runs the calling thread's tasks until the thread whose handshake word is at
// `word` has exited: a nested sweep whose drive point is parked on that
// thread's join park (`__saw_exec_join_park`), so `idle` and the deadlock walk
// read it as they read a task's `Thread.join`, and the thread's exit pokes the
// reactor once the word is set (`__saw_exec_thread_finished`). A cancel does
// not end it, as it does not end a join.
func drive_on_exit(word: UnsafePointer<Int>) unsafe {
    var park = __saw_exec_join_park(word)
    var cancel = false
    var context = TaskContext(park: (&park) as UnsafePointer<Int>, cancel: (&cancel) as UnsafePointer<Bool>,
                              task: 0, deadline: 0)
    while load_word(word) >= 0 {
        sweep(0, -1, 0, (&context) as UnsafePointer<TaskContext> as Int)
    }
}

// Waits for task (`slot`, `generation`) of the pool at `at` to finish, or its
// slot to move on. The waiter is the owning thread, since a handle is not
// `Send`. On a thread that drives tasks it runs them meanwhile, until the
// task's `finished` word is set (`drive_on_word`), as a join on the
// cooperative engine does; elsewhere it waits inside the executor, on the
// condition variable every resume's outcome is broadcast on.
func await_task(at: UnsafePointer<TaskGroup>, slot: Int, generation: Int) unsafe {
    let record = this_executor()
    if record[0].sweeps > 0 {
        lock_queue(at)
        var word = 0
        if not at[0].stale(slot, generation) && not at[0].is_done(slot) {
            let cell = at[0].cell_at(slot)
            word = (&cell[0].finished) as UnsafePointer<Int> as Int
        }
        unlock_queue(at)
        if word != 0 {
            drive_on_word(word as UnsafePointer<Int>)
        }
        return
    }
    enter_executor(record)
    lock_queue(at)
    while not at[0].stale(slot, generation) && not at[0].is_done(slot) {
        let _ = pthread_cond_wait(queue_cond(at), queue_mutex(at))
    }
    unlock_queue(at)
    leave_executor(record)
}

// One worker's life: turns until the pool is stopping and nothing is live.
// The lock is held throughout, except across a resume and a wait. The worker
// counts as waiting inside the executor throughout (`ExecutorRecord.waiting`).
func exec_worker(addr: Int) unsafe {
    let at = addr as UnsafePointer<TaskGroup>
    let record = this_executor()
    enter_executor(record)
    lock_queue(at)
    while worker_turn(at, record) {}
    unlock_queue(at)
    leave_executor(record)
}

// One look at the run queue, with the lock held: resumes the first frame
// whose park wakes, or waits for one to, and answers false once the worker
// is to leave. `record` is the worker's own.
func worker_turn(at: UnsafePointer<TaskGroup>, record: UnsafePointer<ExecutorRecord>) unsafe -> Bool {
    var g = at
    let lead = "TaskGroup(threads:)"
    var live = false
    var waits = false
    var channel = false
    var busy = false
    var earliest = UInt64.max
    var i = 0
    while i < g[0].slots.len() {
        let s = g[0].slots[i]
        if not s.done {
            live = true
            if s.active {
                busy = true
            } else {
                let cell = g[0].cell_at(i)
                let cx = (&cell[0].context) as UnsafePointer<TaskContext>
                if park_wakes(cx) {
                    worker_resume(at, i, record)
                    return true
                }
                let park = park_word(cx)
                if not waits_on(park) {
                    refuse_park(&lead, "a task", park)
                }
                if polls_for(park) {
                    waits = true
                    let deadline = cell[0].context.deadline
                    if bounded_by(park, deadline) && deadline < earliest {
                        earliest = deadline
                    }
                } else {
                    channel = true
                }
            }
        }
        i = i + 1
    }
    if not live && g[0].stopping {
        return false
    }
    if not waits && not channel {
        // Nothing live, or only frames a peer is resuming: a spawn, the
        // teardown and every resume's outcome broadcast.
        let _ = pthread_cond_wait(queue_cond(at), queue_mutex(at))
        return true
    }
    // A writer pokes only a reactor that exists, so a channel wait publishes
    // one and then looks again, as `idle` does.
    if channel && REACTOR.load() == 0 {
        unlock_queue(at)
        let _ = host_reactor()
        lock_queue(at)
        return true
    }
    g[0].pollers += 1
    unlock_queue(at)
    pool_wait(waits, earliest, channel && not waits && not busy)
    lock_queue(at)
    g[0].pollers -= 1
    true
}

// Resumes `slot` of the pool at `at`, claimed under the lock, which is
// released for the resume and held again when this returns. The worker's own
// `record` counts the resume, with the lock held again.
func worker_resume(at: UnsafePointer<TaskGroup>, slot: Int, record: UnsafePointer<ExecutorRecord>) unsafe {
    var g = at
    let s = g[0].slots[slot]
    let cell = g[0].cell_at(slot)
    if let frame = s.frame {
        g[0].slots[slot].active = true
        g[0].slots[slot].runner = record as Int
        cell[0].park = PARK_UNSET
        let context = (&cell[0].context) as UnsafePointer<TaskContext>
        let descriptor = cell[0].descriptor
        unlock_queue(at)
        let outer = begin_turn(record, context)
        let poll = resume_frame(descriptor, frame, context)
        lock_queue(at)
        count_turn(record)
        g[0].slots[slot].active = false
        var finished = false
        match poll {
            case Ready -> {
                // Ahead of the slot's `done`, as `complete` writes the
                // task's own word (`quiescent_now`).
                if g[0].stopping && not g[0].live_besides(slot) {
                    store_word((&g[0].drained) as UnsafePointer<Int>, 1)
                }
                // A pool's walk only tries its lock, so an unclaimed result
                // may be dropped with it held.
                retire(g[0].complete(slot))
                finished = true
            },
            case Pending -> {
                if cell[0].park == PARK_UNSET {
                    // As the cooperative resume does: the lock goes back
                    // first, so the panic's dump names this task.
                    unlock_queue(at)
                    panic("executor: a task reported Pending without recording a park")
                }
            }
        }
        end_turn(record, outer)
        // A join waits for a completion on the condition variable, and a
        // peer that saw this frame active waits there for its outcome. A
        // stopping pool's last completion is what its polling workers leave
        // on, so they are poked out of the poll. A join or a teardown driving
        // the executor on another thread waits in the poll for a completion,
        // and is poked too; the count is read after the words were written,
        // and the drive reads the words after it raised the count, so one of
        // the two sees the other (`drive_on_word`).
        let polling = queue_changed(at)
        let driven = finished && POOL_DRIVES.load() > 0
        if driven || (polling && finished && g[0].stopping) {
            unlock_queue(at)
            poke_reactor()
            lock_queue(at)
        }
    }
}

// An idle worker's wait, with the lock released: until the earliest deadline
// among its group's parks, a descriptor's readiness, a poke, or the pool's
// poll cap, whichever is first (`idle_poll`). When every live task of the
// group is parked on a channel and no peer is resuming one, the deadlock walk
// looks first.
func pool_wait(waits: Bool, earliest: UInt64, walk: Bool) unsafe {
    if walk {
        check_quiescent(0, true, this_executor())
    }
    if waits && earliest != UInt64.max {
        wait_until(earliest)
    } else {
        idle_poll(-1)
    }
}

// The unit of the reactor poll's timeout, a millisecond, in nanoseconds.
static POLL_TICK_NANOS: UInt64 = 1_000_000
// The longest single idle poll, in milliseconds. epoll takes its timeout as
// a C `int`, so a longer deadline is waited for in polls of this length.
static IDLE_POLL_CAP_MILLIS: Int = 60_000

// The executor's idle wait: blocks this thread in the reactor's poll until
// the monotonic clock reaches `deadline`, or until the reactor is woken. The
// timeout is rounded up to whole milliseconds, since a sub-millisecond rest
// rounded down would be a zero timeout, and a poll that returns before the
// deadline costs one more pass of the sweep, which polls again.
func wait_until(deadline: UInt64) unsafe {
    let now = monotonic_now()
    if now >= deadline {
        return
    }
    let rest = deadline - now
    var millis = IDLE_POLL_CAP_MILLIS
    if rest < (IDLE_POLL_CAP_MILLIS as UInt64) * POLL_TICK_NANOS {
        millis = ((rest + POLL_TICK_NANOS - 1) / POLL_TICK_NANOS) as Int
    }
    idle_poll(millis)
}

// The portable tag of a poll a signal cut short (runtime/ABI.md).
static POLL_INTERRUPTED_TAG: Int = 4

// Blocks this thread in the reactor's poll for up to `millis` milliseconds,
// forever when negative. Every caller looks again at what changed once it
// returns, so a poll a signal cut short is an early return like any other.
// Any other failure is a broken instance, which nothing can recover from, so
// it panics with the cause.
func reactor_poll(millis: Int) unsafe {
    var count = 0
    let status = __saw_rt_reactor_poll(host_reactor(), millis, (&count) as UnsafePointer<Int>)
    if status != 0 && status != 0 - POLL_INTERRUPTED_TAG {
        panic("reactor: polling the reactor failed (errno {})", __saw_rt_last_raw_code())
    }
}

// The executor halves the park lowerings call (SL:coroutines §3.1). Each park
// records its park word, and a deadline when it has one, before it calls
// anything here, so a wake that arrives during an arm finds the record.

/// The monotonic instant `nanos` nanoseconds from now, in nanoseconds: the
/// deadline a timer park records in its context. A span past the clock's end
/// saturates there, since no clock reaches it.
public func __saw_exec_timer_deadline(nanos: UInt64) -> UInt64 {
    let now = monotonic_now()
    if nanos > UInt64.max - now {
        return UInt64.max
    }
    now + nanos
}

/// Arms the reactor for descriptor `fd`'s readiness, for reading when `dir`
/// is 0 and for writing when it is 1, so that it wakes the task whose park
/// word is at address `token`: the arm of a descriptor park and of an offload
/// park, made after the park records its word.
///
/// Panics if the arm fails, naming the descriptor, the direction and the
/// platform's error code.
public func __saw_exec_io_register(fd: Int, dir: Int, token: Int) unsafe {
    // The one arm funnel. The park value its park recorded is published
    // through `token` again, atomically, before the arm, so every latch the
    // reactor's poll makes, from any thread, lands after it and is never
    // erased by it (SL-355). The value is the park's own: a descriptor park's
    // `PARK_FD`, which the poll latches, or an offload's completion word, which
    // it leaves alone, since only the C call's end makes that park ready.
    //
    // A failed arm panics: no park has an error channel to send it down, and
    // there is nothing to recover, since the descriptor was closed under the
    // park or was never pollable. A silent failure would park the task
    // forever, which reads exactly like a lost wake.
    //
    // `token` is a task's park word, which lives as long as the task; a park
    // that ends without its event withdraws the registration before the task
    // can end (`__saw_exec_io_unregister`).
    //
    // ENTRY POINTS:
    //   coro_lower_park's descriptor park (`__saw_park_fd`, `__saw_park_fd_until`)
    //   coro_lower_park's offload park (`__saw_park_offload`)
    let word = token as UnsafePointer<Atomic<Int>>
    let recorded = __saw_atomic_load_i64_seq_cst(token as UnsafePointer<Int>)
    word[0].store(recorded)
    let status = __saw_rt_reactor_register(host_reactor(), fd, dir, token)
    if status != 0 {
        let direction = if dir != 0 { "write" } else { "read" }
        panic("reactor: arming fd {} for {} readiness failed (errno {})", fd, direction,
              __saw_rt_last_raw_code())
    }
}

// Withdraws the registration a descriptor park armed for `fd` in direction
// `dir`, from a park that ended without its event: a cancel or a deadline.
// The reactor carries the task's park-word address, so a registration left
// behind would latch a word the task no longer parks on, or one in a freed
// cell. Withdrawing an already-fired or never-armed registration does
// nothing.
public(package) func __saw_exec_io_unregister(fd: Int, dir: Int) unsafe {
    __saw_rt_reactor_unregister(host_reactor(), fd, dir)
}

// Whether the monotonic clock has reached `deadline`, in nanoseconds.
public(package) func __saw_exec_deadline_passed(deadline: UInt64) -> Bool {
    monotonic_now() >= deadline
}

// The offload job seams. `job` is the handle `__saw_rt_offload_start`
// returned, which the offloaded call's frame keeps until its take frees the
// job (runtime/ABI.md, "Blocking-extern offload").
extern "C" {
    func __saw_rt_offload_done(job: Int) -> Int
    func __saw_rt_offload_pipe_fd(job: Int) -> Int
}

/// The read end of offload job `job`'s completion pipe, which an offload park
/// arms through `__saw_exec_io_register` after it records its word.
public func __saw_exec_offload_pipe(job: Int) -> Int {
    // The registration is never withdrawn: the park ends only once the call
    // has returned, and the take then closes this descriptor, which removes
    // it from the reactor, before the task can park again or its cell can be
    // freed.
    __saw_rt_offload_pipe_fd(job)
}

/// Whether offload job `job`'s C call has returned, which an offload asks
/// before it parks and after every wake, so that only a finished job reaches
/// the take that joins the job's thread, cancelled task or not.
public func __saw_exec_offload_done(job: Int) -> Bool {
    __saw_rt_offload_done(job) != 0
}

/// The calling thread's background group, the one `Task.spawn` spawns into,
/// built on the thread's first call.
///
/// Each thread has its own, so only the thread that spawned a background
/// task ever runs it. Panics if the group cannot be allocated.
public func __saw_exec_background() unsafe -> UnsafePointer<TaskGroup> {
    let record = this_executor()
    let current = record[0].background
    if current != 0 {
        return current as UnsafePointer<TaskGroup>
    }
    let raw = exec_alloc(sizeof<TaskGroup>(), alignof<TaskGroup>(), "Task.spawn")
    let g = raw as UnsafePointer<TaskGroup>
    g[0] = TaskGroup()
    record[0].background = raw as Int
    g
}

/// Closes the calling thread's background group as the thread ends: at
/// `main`'s return, and at the end of every `Thread.spawn` body. Every live
/// member is cancelled, then joined, then released.
///
/// Cancel first, because a background task may loop until asked to stop;
/// join after, because a cancelled task still finishes through its own code,
/// which is where its values are destroyed. A task parked where a cancel does
/// not wake it, such as a join of a thread, holds the close open until that
/// wait ends. Does nothing when the thread never spawned a background task.
/// The group is left empty, for the next thread that takes this record.
public func __saw_exec_close_background() unsafe {
    let current = __saw_rt_thread_executor()
    if current == 0 {
        return
    }
    let addr = (current as UnsafePointer<ExecutorRecord>)[0].background
    if addr == 0 {
        return
    }
    var g = addr as UnsafePointer<TaskGroup>
    g[0].cancel_every_live()
    exec_run(addr, -1, 0)
    // Unlinked first, so no walk reads a cell the release frees.
    g[0].unregister()
    g[0].release_slots()
    // Its storage stays with the record (`ExecutorRecord.background`); only
    // its run queue is given back.
    drop_in_place(g)
    g[0] = TaskGroup()
}

/// Runs a suspending `main` whose frame is at `frame`: its root and every task
/// it spawns are driven until `main` returns, and then the background group
/// is closed.
///
/// The frame is the caller's, and keeps `main`'s result where the frame's
/// descriptor says. This is the body of `std.task`'s `__saw_exec_run_main`,
/// the entry the compiler calls.
public func __saw_exec_drive_main(descriptor: UnsafePointer<FrameDescriptor>,
                                  frame: UnsafePointer<UInt8>) unsafe {
    var root = TaskGroup()
    let ticket = root.enqueue(descriptor, frame, false)
    let at = (&root) as UnsafePointer<TaskGroup> as Int
    ENTRY_GROUP.store(at)
    exec_run(at, ticket.slot, ticket.generation)
    if not root.is_done(ticket.slot) {
        panic("executor: `main` cannot finish: every live task is waiting")
    }
    ENTRY_GROUP.store(0)
    __saw_exec_close_background()
}

/// Runs the frame at `frame`, whose root `descriptor` describes, to its end
/// on this thread, leaving the root's result in the frame: the lowering of
/// the test driver `__saw_drive`, written at `site`, which then moves the
/// result out.
///
/// Panics if the frame parks on a wait the executor does not perform yet
/// (`drive_frame`).
public func __saw_exec_drive(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                             site: String) unsafe {
    drive_frame(descriptor, frame, &site)
}

/// Runs the frame at `frame` to its end as `__saw_exec_drive` does, then
/// destroys the root's result in place, and returns how many times the frame
/// reported `Pending`: the lowering of the test driver `__saw_drive_steps`,
/// written at `site`, whose result nobody takes.
///
/// Panics if the frame parks on a wait the executor does not perform yet
/// (`drive_frame`).
public func __saw_exec_drive_steps(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                                   site: String) unsafe -> Int {
    let steps = drive_frame(descriptor, frame, &site)
    let drop = descriptor[0].drop_result
    drop((frame as Int + descriptor[0].result_offset) as UnsafePointer<UInt8>)
    steps
}

// A drive point's loop (SL:coroutines §4, A4b and A11): the frame is resumed
// with a context of its own until its root returns, and each `Pending` is
// counted. A ready yield is resumed at once, so a drive point never cedes to
// the run queue for one. Any other park hands its wait to the shared sweep:
// other tasks run meanwhile, and the drive resumes once its own park wakes
// (t8). A wait the executor does not perform yet panics, naming the reason
// and the site, rather than spin, which would mask a lost wake.
func drive_frame(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                 site: &String) unsafe -> Int {
    var park = PARK_UNSET
    var cancel = false
    var context = TaskContext(park: (&park) as UnsafePointer<Int>, cancel: (&cancel) as UnsafePointer<Bool>,
                              task: frame as Int, deadline: 0)
    let cx = (&context) as UnsafePointer<TaskContext>
    let word = cx[0].park
    let record = this_executor()
    var steps = 0
    while true {
        // A turn per resume, so the sweep below runs as the drive's caller,
        // not as the driven frame.
        let outer = begin_turn(record, cx)
        let poll = resume_frame(descriptor, frame, cx)
        end_turn(record, outer)
        if poll == Poll.Ready {
            return steps
        }
        steps = steps + 1
        let parked = word[0]
        if parked == PARK_UNSET {
            panic("{}: the driven frame reported Pending without recording a park", site)
        }
        if parked != PARK_READY {
            if not waits_on(parked) {
                refuse_park(&site, "the driven frame", parked)
            }
            sweep(0, -1, 0, cx as Int)
        }
        word[0] = PARK_UNSET
    }
    steps
}

/// A handle to a spawned task, carrying its result type `T`.
///
/// `group.spawn(f())` and `Task.spawn(f())` return one, a `Task<Void>` when
/// `f` returns nothing. `join` waits for the task and takes its result. A
/// handle from `Task.spawn` must be joined, detached or cancelled before it is
/// dropped; a handle from `group.spawn` may be dropped. Dropping a handle
/// gives its task's result up: the result is dropped when the task finishes,
/// or at once if it already has. A group destroyed while one of its handles
/// is neither joined nor dropped panics.
public struct Task<T> {
    private group: UnsafePointer<TaskGroup>
    private slot: Int
    private generation: Int
    private provenance: TaskProvenance
    // Whether `join`, `detach` or `cancel` has run, which the destructor of a
    // `Task.spawn` handle reads.
    private consumed: UnsafeMutableInterior<Bool>
    // Whether the handle let go of its task's result: `join` took it, or
    // `detach` or the drop gave it up. Until then the task's slot keeps the
    // result for this handle.
    private released: UnsafeMutableInterior<Bool>
}

extension Task<T> {
    // The compiler's spawn lowering: puts the frame at `frame`, its arguments
    // written, on `group`'s run queue, and hands back its handle.
    public static func __saw_spawn(group: UnsafePointer<TaskGroup>,
                                   descriptor: UnsafePointer<FrameDescriptor>,
                                   frame: UnsafePointer<UInt8>,
                                   provenance: TaskProvenance) unsafe -> Task<T> {
        if descriptor[0].result_size != sizeof<T>() {
            panic("Task.spawn: the frame's result is {} bytes, and the task's is {}",
                  descriptor[0].result_size, sizeof<T>())
        }
        let ticket = group[0].enqueue(descriptor, frame, true)
        if provenance == TaskProvenance.Group {
            handle_minted(group)
        }
        Task<T>(group: group, slot: ticket.slot, generation: ticket.generation,
                provenance: provenance, consumed: UnsafeMutableInterior(false),
                released: UnsafeMutableInterior(false))
    }

    // Refuses, before the group is touched, a handle to a cooperative group
    // used on a thread other than the one whose record holds the group. That
    // thread alone runs the group and writes its run queue, which takes no
    // lock, so another thread could neither finish the task nor touch its slot
    // safely. A pool's run queue is locked and its workers finish its tasks,
    // so its handles work from any thread. Safe code cannot get here, since a
    // handle is not `Send`; a handle carried across threads by address can (the
    // run probe `task_handle_used_on_another_thread`).
    //
    // ENTRY POINTS:
    //   Task.join
    //   Task.cancel_addr
    //   Task.cancel
    //   Task.detach
    //   Task.deinit
    func check_home_thread(&self, what: String, verb: String) unsafe {
        let g = self.group
        if g[0].lock == 0 && g[0].owner != __saw_rt_thread_executor() {
            panic("{}: this task belongs to another thread's group; {} a task on the thread that spawned it", what,
                  verb)
        }
    }

    // Writes the handle's fate: `join`, `cancel` and `detach` each mark it,
    // and the drop of a `Task.spawn` handle panics without it.
    func consume(&self) unsafe {
        self.consumed.ptr()[0] = true
    }

    // Lets go of the task's result once, giving back a `group.spawn` handle's
    // count on its group (`handle_released`), and answers whether the handle
    // had let go already, so only the first of `join`, `detach` and the drop
    // acts on the slot.
    //
    // ENTRY POINTS:
    //   Task.join
    //   Task.detach
    //   Task.deinit
    func let_go(&self) unsafe -> Bool {
        if self.released.ptr()[0] {
            return true
        }
        self.released.ptr()[0] = true
        if self.provenance == TaskProvenance.Group {
            handle_released(self.group)
        }
        false
    }

    /// Waits for the task to finish and returns its result, moving it out of
    /// the task.
    ///
    /// Inside a task, this thread runs its other tasks meanwhile, whether the
    /// group is cooperative or a pool; a join made outside every task waits
    /// for a pool's task with the thread blocked. The joining task stays on
    /// its thread's stack until the join returns, so a join made inside it
    /// returns first, and a join of a task that is itself waiting further up
    /// the stack could never finish: it panics at once. A pool keeps running
    /// after the join. A task yields its result once, so joining a second
    /// time, or after `detach`, panics, a `Task<Void>` included.
    public func join(&self) unsafe -> T {
        self.check_home_thread("Task.join", "join")
        self.consume()
        if self.let_go() {
            panic("Task.join: this task's result was already joined")
        }
        var g = self.group
        if g[0].lock == 0 {
            if g[0].stale(self.slot, self.generation) {
                panic("Task.join: this task's result was already joined")
            }
            // A task further up this stack continues only once this join
            // returns, so the join is refused before the sweep; the check
            // after it is the backstop.
            if group_on_this_stack(g, self.slot) {
                panic("Task.join: the task cannot finish while this join waits for it")
            }
            exec_run(g as Int, self.slot, self.generation)
        } else {
            await_task(g, self.slot, self.generation)
        }
        // Each refusal gives the lock back first, so the panic's dump reads
        // this thread's groups.
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            unlock_queue(g)
            panic("Task.join: this task's result was already joined")
        }
        if not g[0].is_done(self.slot) {
            unlock_queue(g)
            panic("Task.join: the task cannot finish while this join waits for it")
        }
        let cell = g[0].cell_at(self.slot)
        cell[0].holding = false
        let at = cell[0].result as UnsafePointer<T>
        let value = move at[0]
        let retired = g[0].recycle(self.slot)
        unlock_queue(g)
        retire(retired)
        move value
    }

    /// Returns the address of this task's cancel word, as an `Int`, which is
    /// how another task cancels this one: a `Task` cannot cross a spawn, but
    /// the address can. The receiver cancels by writing through it,
    /// `(addr as UnsafePointer<Bool>)[0] = true`.
    ///
    /// The write wakes nothing: the task sees it at its next `cancelled()`
    /// check or the next time the executor looks at its park, which on a pool
    /// is within its poll cap. Use `cancel()` where the handle is at hand.
    /// Taking the address keeps the task's slot for the group's life, so a
    /// write landing after the task finished is defined and does nothing.
    /// Panics once the task's result was joined.
    public func cancel_addr(&self) unsafe -> Int {
        self.check_home_thread("Task.cancel_addr", "take the cancel address of")
        var g = self.group
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            unlock_queue(g)
            panic("Task.cancel_addr: this task's result was already joined")
        }
        g[0].slots[self.slot].pinned = true
        let cell = g[0].cell_at(self.slot)
        unlock_queue(g)
        (&cell[0].cancel) as UnsafePointer<Bool> as Int
    }

    /// Asks the task to stop.
    ///
    /// Cancellation is cooperative: the task observes it through `cancelled()`
    /// and returns through its own code. A task parked in `sleep` or any other
    /// wait is woken to do so. Cancelling a finished task does nothing, and
    /// its result stays for a `join`.
    public func cancel(&self) unsafe {
        self.check_home_thread("Task.cancel", "cancel")
        self.consume()
        let g = self.group
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            unlock_queue(g)
            return
        }
        request_cancel(g[0].cell_at(self.slot))
        unlock_queue(g)
        // A pool's worker may be waiting in the reactor's poll for this very
        // park; the cooperative engine reads the word at its next look.
        if g[0].lock != 0 {
            poke_reactor()
        }
    }

    /// Hands the task to the process and gives up its result.
    ///
    /// The task keeps running, and its result is dropped when it finishes.
    /// Panics on a `group.spawn` handle, whose task ends with its group.
    public func detach(&self) unsafe {
        if self.provenance == TaskProvenance.Group {
            panic("Task.detach: this handle came from `group.spawn`, and a group task's fate is its group's scope — drop the handle instead, or use `Task.spawn` for a detachable task")
        }
        self.check_home_thread("Task.detach", "detach")
        self.consume()
        if self.let_go() {
            return
        }
        let g = self.group
        lock_queue(g)
        // Stage 0 workaround (SL:hazards S4): canonical: self.group[0].unclaim_slot(self.slot, self.generation)
        let slot = self.slot
        let generation = self.generation
        let retired = self.group[0].unclaim_slot(slot, generation)
        unlock_queue(g)
        retire(retired)
    }
}

extension Task<T>: NoCopy {
    /// Panics if a `Task.spawn` handle was neither joined, detached nor
    /// cancelled. A `group.spawn` handle drops silently.
    ///
    /// A handle that has not let go of its task's result gives it up here:
    /// the result is dropped now if the task has finished, or when it does.
    public func deinit(&var self) unsafe {
        if self.provenance == TaskProvenance.Singleton && not self.consumed.ptr()[0] {
            panic("Task was dropped without being joined, detached or cancelled — `join()` waits for it and takes its result, `detach()` hands it to the process, `cancel()` asks it to stop")
        }
        // A handle that already let go reaches nothing, wherever it is dropped.
        if not self.released.ptr()[0] {
            self.check_home_thread("Task", "drop the handle to")
        }
        if self.let_go() {
            return
        }
        let g = self.group
        lock_queue(g)
        // Stage 0 workaround (SL:hazards S4): canonical: self.group[0].unclaim_slot(self.slot, self.generation)
        let slot = self.slot
        let generation = self.generation
        let retired = self.group[0].unclaim_slot(slot, generation)
        unlock_queue(g)
        retire(retired)
    }
}

// =============================================================================
// The task dump (design 158)
// =============================================================================
//
// A parked task is one allocation, its root's frame, with every child it drives
// embedded at a fixed offset and every frame's state word naming where it
// stopped. The compiler writes down what each state means in `__saw_bt_table`
// (compiler/coro/src/bttable.saw is the format's other half), so a task's
// logical stack is a static table walk from its frame's address: no unwinder
// and no allocation, which is what lets the dump run on the panic path, under
// an allocator that has refused. Every piece of a line goes straight to the
// output seam, and nothing is assembled first.

extern "C" {
    func __saw_rt_write(ptr: UnsafePointer<Int8>, len: Int) -> Int
    func __saw_rt_write_error(ptr: UnsafePointer<Int8>, len: Int)
    func __saw_rt_output_lock()
    func __saw_rt_output_unlock()
    // The backend defines it beside the table it returns.
    func __saw_bt_table_address() -> UnsafePointer<UInt8>
}

// The table's field offsets, in bytes, as the encoder writes them.
static BT_MAGIC: Int = 0x4257_4153
static BT_HDR_FRAME_COUNT: Int = 8
static BT_HDR_FRAMES: Int = 12
static BT_HDR_STATES: Int = 16
static BT_HDR_STRTAB: Int = 20
static BT_FRAME_REC_SIZE: Int = 24
static BT_FRAME_NAME: Int = 4
static BT_FRAME_FILE: Int = 8
static BT_FRAME_FIRST: Int = 12
static BT_FRAME_STATES: Int = 16
static BT_FRAME_STATE_OFF: Int = 20
static BT_STATE_REC_SIZE: Int = 12
static BT_STATE_CHILD: Int = 4
static BT_STATE_CHILD_OFF: Int = 8

// A logical stack deeper than this, or a walk over more groups and records
// than this, is a corrupt structure rather than a program: the dump may run
// once something has already gone wrong, so every walk here is bounded.
static BT_MAX_DEPTH: Int = 64
static BT_MAX_GROUPS: Int = 1024
// How far a name's terminating NUL is looked for: a bound on a bad table.
static BT_MAX_NAME: Int = 256

// The address of the group the entry executor runs a suspending `main` in, or
// 0. `main` is the program rather than a task, so the dump leaves its group
// out, as Stage 0's does.
static ENTRY_GROUP: Atomic<Int> = Atomic(0)

// Installs the task dump as the report the panic sink writes after a panic's
// message, once per process (std.panic). It is never freed: a panic on any
// thread may read it at any time.
func install_panic_report() unsafe {
    if PANIC_REPORT.load() != 0 {
        return
    }
    let size = sizeof<(UnsafePointer<Int8>, Int) unsafe sync -> Void>()
    let align = alignof<(UnsafePointer<Int8>, Int) unsafe sync -> Void>()
    let raw = exec_alloc(size, align, "executor")
    let at = raw as UnsafePointer<(UnsafePointer<Int8>, Int) unsafe sync -> Void>
    at[0] = { message: UnsafePointer<Int8>, length: Int in report_on_panic(message, length) }
    if not PANIC_REPORT.compare_exchange(0, raw as Int) {
        GlobalAllocator().dealloc(raw, size, align)
    }
}

// The panic path's report: the message, then the dump, on standard error.
// The output lock is taken first and never given back, so neither lands
// inside another thread's `print` line; the panic seam that ends the process
// takes it again on this thread. A panic the walk raises takes the plain seam
// (std.panic), so nothing raises here while the lock is held.
func report_on_panic(message: UnsafePointer<Int8>, length: Int) unsafe {
    __saw_rt_output_lock()
    __saw_rt_write_error(message, length)
    let _ = write_task_dump(true)
}

/// Writes every live task's logical backtrace to standard output: the body of
/// `std.task`'s `dump_tasks`.
///
/// Panics if standard output refuses the dump, as `print` does.
public(package) func __saw_exec_dump_tasks() unsafe {
    // Held across the whole dump, so no other thread's `print` lands inside
    // it, and given back before the failure is raised (SL-768).
    __saw_rt_output_lock()
    let status = write_task_dump(false)
    __saw_rt_output_unlock()
    if status != 0 {
        panic("dump_tasks: failed printing to stdout: {}", SystemError.of("write", 0 - status))
    }
}

// Where a dump's bytes go.
struct DumpSink {
    // Standard error, for the panic path; standard output otherwise.
    to_error: Bool
    // 0, or the negated tag of the first write standard output refused,
    // after which nothing more is written.
    status: Int
    // Whether bytes collect in `buf` rather than reach the output: the walk
    // writes nothing while it holds a lock, so a blocked output never stalls
    // the thread whose latch it holds.
    buffered: Bool
    // The collecting buffer's address, length and capacity, 0 before the
    // first byte.
    buf: Int
    len: Int
    cap: Int
    // The allocator refused the buffer's growth: what it holds is short.
    refused: Bool
}

// The buffer's first capacity, in bytes.
static DUMP_FIRST_BYTES: Int = 4096

// Writes the dump: on standard error from the panic path, where nothing is
// written when no task is live, and on standard output otherwise. Returns 0,
// or the negated tag of the first write standard output refused.
//
// One walk collects every group's lines into a buffer, each record under its
// latch, and counts them, and only then is the header written, with the
// count of the lines that follow, and the buffer after it. Each group is read
// at its own moment, which is why the header still says the snapshot is
// unsynchronized. When the allocator refuses the
// buffer, the dump streams instead: a counting walk and a writing walk, so
// the count may disagree with the lines, and the header says so.
func write_task_dump(to_error: Bool) unsafe -> Int {
    let table = __saw_bt_table_address()
    var sink = DumpSink(to_error: to_error, status: 0, buffered: true, buf: 0, len: 0, cap: 0, refused: false)
    let live = dump_walk(&var sink, table, true)
    if sink.refused {
        dump_buffer_free(&var sink)
        return stream_task_dump(&var sink, table)
    }
    sink.buffered = false
    if live == 0 && sink.len == 0 {
        if not to_error {
            dump_text(&var sink, "saw tasks: none live\n")
        }
        dump_buffer_free(&var sink)
        return sink.status
    }
    dump_text(&var sink, "saw tasks: ")
    dump_int(&var sink, live)
    if to_error {
        dump_text(&var sink, " live (as-of panic, unsynchronized)\n")
    } else {
        dump_text(&var sink, " live (unsynchronized snapshot)\n")
    }
    let collected = sink.buf
    let length = sink.len
    if length > 0 {
        dump_write(&var sink, collected as UnsafePointer<Int8>, length)
    }
    dump_buffer_free(&var sink)
    sink.status
}

// The dump with no buffer to collect in: a counting walk, then the header,
// then a walk that writes each group's lines with that group's lock held.
func stream_task_dump(sink: &var DumpSink, table: UnsafePointer<UInt8>) unsafe -> Int {
    sink.buffered = false
    let live = dump_walk(&var sink, table, false)
    if live == 0 {
        if not sink.to_error {
            dump_text(&var sink, "saw tasks: none live\n")
        }
        return sink.status
    }
    dump_text(&var sink, "saw tasks: ")
    dump_int(&var sink, live)
    if sink.to_error {
        dump_text(&var sink, " live (as-of panic, unsynchronized; counted apart from the lines)\n")
    } else {
        dump_text(&var sink, " live (unsynchronized snapshot; counted apart from the lines)\n")
    }
    let _ = dump_walk(&var sink, table, true)
    sink.status
}

func dump_buffer_free(sink: &var DumpSink) unsafe {
    if sink.buf != 0 {
        GlobalAllocator().dealloc(sink.buf as UnsafePointer<Int8>, sink.cap, 1)
    }
    sink.buf = 0
    sink.len = 0
    sink.cap = 0
}

// Counts the live tasks of every executor record's groups, the registry the
// deadlock walk reads, writing each one's lines when `emit` is set. Groups are
// numbered from 1 in walk order, newest-registered first.
func dump_walk(sink: &var DumpSink, table: UnsafePointer<UInt8>, emit: Bool) unsafe -> Int {
    let entry = ENTRY_GROUP.load()
    var live = 0
    var number = 0
    var visited = 0
    var at = EXEC_RECORDS.load()
    while at != 0 && visited < BT_MAX_GROUPS {
        let record = at as UnsafePointer<ExecutorRecord>
        live = live + dump_record(&var sink, table, record, entry, &var number, &var visited, emit)
        visited = visited + 1
        at = record[0].next
    }
    live
}

// The live tasks of `record`'s groups, read with its latch held, each group
// numbered from `number` on. A record whose latch the dump cannot take is one
// line, numbered as a group. A pool whose lock is busy while the dump
// collects makes it give the record back, nap and read it again from the
// start, so no latch is held while it waits; past the walk's bound, or while
// streaming, where written lines cannot be taken back, the pool is one line.
func dump_record(sink: &var DumpSink, table: UnsafePointer<UInt8>, record: UnsafePointer<ExecutorRecord>,
                 entry: Int, number: &var Int, visited: &var Int, emit: Bool) unsafe -> Int {
    var naps = 0
    while true {
        let taken = walk_take(record)
        if taken != WalkLock.Taken {
            number = number + 1
            if emit {
                dump_not_read(&var sink, number, taken)
            }
            return 0
        }
        let mark_len = sink.len
        let mark_number = number
        let mark_visited = visited
        let retry = sink.buffered && naps < WALK_NAPS
        var live = 0
        var again = false
        var cur = load_word((&record[0].groups) as UnsafePointer<Int>)
        while not again && cur != 0 && visited < BT_MAX_GROUPS {
            visited = visited + 1
            let g = cur as UnsafePointer<TaskGroup>
            if cur != entry {
                number = number + 1
                if g[0].lock == 0 {
                    live = live + dump_group(&var sink, table, g, number, emit)
                } else {
                    let pool = walk_take_pool(g)
                    if pool == WalkLock.Taken {
                        live = live + dump_group(&var sink, table, g, number, emit)
                        walk_give_pool(g)
                    } else if pool == WalkLock.Busy && retry {
                        again = true
                    } else if emit {
                        dump_not_read(&var sink, number, pool)
                    }
                }
            }
            cur = g[0].next
        }
        walk_give(record)
        if not again {
            return live
        }
        sink.len = mark_len
        number = mark_number
        visited = mark_visited
        __saw_rt_sleep_ns(WALK_NAP_NANOS)
        naps = naps + 1
    }
    0
}

// The line for group `number`, which the dump could not read: its lock was
// held past the walk's bound by another thread, or by this one mid-change.
func dump_not_read(sink: &var DumpSink, number: Int, lock: WalkLock) unsafe {
    dump_text(&var sink, "  task group ")
    dump_int(&var sink, number)
    if lock == WalkLock.Mine {
        dump_text(&var sink, " not read: busy on this thread\n")
    } else {
        dump_text(&var sink, " not read: busy on another thread\n")
    }
}

// The live tasks of the group at `g`, numbered `number`, each one's lines
// written when `emit` is set.
func dump_group(sink: &var DumpSink, table: UnsafePointer<UInt8>, g: UnsafePointer<TaskGroup>, number: Int,
                emit: Bool) unsafe -> Int {
    var live = 0
    var i = 0
    while i < g[0].slots.len() {
        let s = g[0].slots[i]
        if not s.done {
            live = live + 1
            if emit {
                dump_task(&var sink, table, number, i, &s)
            }
        }
        i = i + 1
    }
    live
}

// One task's line, then its stack, innermost frame first: a reader looks for
// where a task is stopped, not where it started. A task running on the
// dumping thread is suspended further up its stack, and its frames show its
// last suspension; one running on another thread has no stack here, since
// its frames change as the dump would read them.
func dump_task(sink: &var DumpSink, table: UnsafePointer<UInt8>, number: Int, slot: Int, s: &TaskSlot) unsafe {
    dump_text(&var sink, "  task group ")
    dump_int(&var sink, number)
    dump_text(&var sink, " slot ")
    dump_int(&var sink, slot)
    dump_text(&var sink, " gen ")
    dump_int(&var sink, s.generation)
    dump_text(&var sink, " ")
    guard let cell = s.cell else {
        dump_text(&var sink, "unrecorded\n")
        return
    }
    dump_status(&var sink, s.active, cell)
    dump_text(&var sink, "\n")
    if s.active && s.runner != __saw_rt_thread_executor() {
        return
    }
    if let frame = s.frame {
        bt_write_stack(&var sink, table, cell[0].descriptor[0].backtrace, frame as Int)
    }
}

// Why a task is not running, in the executor's own vocabulary: `active` is a
// frame on some thread's stack, and otherwise the park its cell records says.
func dump_status(sink: &var DumpSink, active: Bool, cell: UnsafePointer<TaskCell>) unsafe {
    if active {
        dump_text(&var sink, "running")
        return
    }
    let park = park_word((&cell[0].context) as UnsafePointer<TaskContext>)
    match park_reason(park) {
        case Ready -> dump_text(&var sink, "ready"),
        case Timer -> dump_text(&var sink, "sleeping"),
        case Descriptor -> dump_text(&var sink, "io-parked"),
        case Join -> dump_text(&var sink, "joining"),
        case Channel -> dump_text(&var sink, "channel-parked"),
        case Offload -> dump_text(&var sink, "offload-parked"),
        // A frame that reported `Pending` and recorded no park, which the
        // executor is panicking about as this runs.
        case _ -> dump_text(&var sink, "unrecorded")
    }
}

// Writes `length` bytes of the dump, or collects them while the sink is
// buffered.
func dump_write(sink: &var DumpSink, ptr: UnsafePointer<Int8>, length: Int) unsafe {
    if sink.buffered {
        dump_collect(&var sink, ptr, length)
    } else if sink.to_error {
        __saw_rt_write_error(ptr, length)
    } else if sink.status == 0 {
        sink.status = __saw_rt_write(ptr, length)
    }
}

// Appends `length` bytes to the sink's buffer, doubling it as it fills; a
// growth the allocator refuses marks the sink, and nothing more collects.
func dump_collect(sink: &var DumpSink, ptr: UnsafePointer<Int8>, length: Int) unsafe {
    if sink.refused {
        return
    }
    if sink.len + length > sink.cap {
        var target = if sink.cap == 0 { DUMP_FIRST_BYTES } else { sink.cap * 2 }
        while target < sink.len + length {
            target = target * 2
        }
        guard let fresh = GlobalAllocator().alloc(target, 1) else {
            sink.refused = true
            return
        }
        if sink.buf != 0 {
            copy_bytes(sink.buf as UnsafePointer<Int8>, fresh, sink.len)
            GlobalAllocator().dealloc(sink.buf as UnsafePointer<Int8>, sink.cap, 1)
        }
        sink.buf = fresh as Int
        sink.cap = target
    }
    copy_bytes(ptr, (sink.buf + sink.len) as UnsafePointer<Int8>, length)
    sink.len = sink.len + length
}

func dump_text(sink: &var DumpSink, text: String) unsafe {
    dump_write(&var sink, text.c_bytes(), text.len())
}

// Writes `value` as decimal digits, most significant first, one write each,
// so nothing needs a buffer. A negative value, which no line, slot,
// generation or count is, prints `?`: negating `Int.min` would trap inside
// the panic reporter.
func dump_int(sink: &var DumpSink, value: Int) unsafe {
    if value < 0 {
        dump_text(&var sink, "?")
        return
    }
    var scale = 1
    while value / scale >= 10 {
        scale = scale * 10
    }
    let digits = "0123456789"
    let at = digits.c_bytes() as Int
    var rest = value
    while scale > 0 {
        let digit = rest / scale
        dump_write(&var sink, (at + digit) as UnsafePointer<Int8>, 1)
        rest = rest - digit * scale
        scale = scale / 10
    }
}

// A frame of a task's logical stack: its index in the table and its address.
struct BtFrameAt {
    index: Int
    addr: Int
}

// The little-endian u32 `offset` bytes into the table.
func bt_u32(table: UnsafePointer<UInt8>, offset: Int) unsafe -> Int {
    ((table as Int + offset) as UnsafePointer<UInt32>)[0] as Int
}

// Whether `index` names a frame the table describes. A frame whose index the
// table does not hold is never read through, since its state word's offset
// would come from outside the table.
func bt_known_frame(table: UnsafePointer<UInt8>, index: Int) unsafe -> Bool {
    index >= 0 && index < bt_u32(table, BT_HDR_FRAME_COUNT)
}

func bt_frame_record(table: UnsafePointer<UInt8>, index: Int) unsafe -> Int {
    bt_u32(table, BT_HDR_FRAMES) + index * BT_FRAME_REC_SIZE
}

// The offset of the state record frame `at` is in, or -1 when the table does
// not describe the frame or its state word.
func bt_state_record(table: UnsafePointer<UInt8>, at: BtFrameAt) unsafe -> Int {
    if not bt_known_frame(table, at.index) {
        return -1
    }
    let rec = bt_frame_record(table, at.index)
    let state = ((at.addr + bt_u32(table, rec + BT_FRAME_STATE_OFF)) as UnsafePointer<Int>)[0]
    if state < 0 || state >= bt_u32(table, rec + BT_FRAME_STATES) {
        return -1
    }
    bt_u32(table, BT_HDR_STATES) + (bt_u32(table, rec + BT_FRAME_FIRST) + state) * BT_STATE_REC_SIZE
}

// The child frame `at`'s state drives, or `at` itself when the state parks
// the frame, or names nothing.
func bt_child(table: UnsafePointer<UInt8>, at: BtFrameAt) unsafe -> BtFrameAt {
    let rec = bt_state_record(table, at)
    if rec < 0 {
        return at
    }
    // Biased by one in the encoding: 0 is "parks itself", not "frame 0".
    let child = bt_u32(table, rec + BT_STATE_CHILD)
    if child == 0 {
        return at
    }
    BtFrameAt(index: child - 1, addr: at.addr + bt_u32(table, rec + BT_STATE_CHILD_OFF))
}

// How many logical frames the stack rooted at `root` has, the root included.
func bt_depth(table: UnsafePointer<UInt8>, root: BtFrameAt) unsafe -> Int {
    var at = root
    var depth = 1
    while depth < BT_MAX_DEPTH {
        let next = bt_child(table, at)
        if next.index == at.index && next.addr == at.addr {
            return depth
        }
        at = next
        depth = depth + 1
    }
    depth
}

// Writes the stack rooted at frame `index` of the table, at `addr`, innermost
// frame first. Re-walking from the root per level is quadratic in a depth
// bounded at BT_MAX_DEPTH, and buys a walk with no storage at all.
func bt_write_stack(sink: &var DumpSink, table: UnsafePointer<UInt8>, index: Int, addr: Int) unsafe {
    if bt_u32(table, 0) != BT_MAGIC {
        return
    }
    let root = BtFrameAt(index: index, addr: addr)
    var level = bt_depth(table, root) - 1
    while level >= 0 {
        var at = root
        var step = 0
        while step < level {
            at = bt_child(table, at)
            step = step + 1
        }
        bt_write_frame(&var sink, table, at)
        level = level - 1
    }
}

// One frame line: `    at FILE:LINE in NAME`.
func bt_write_frame(sink: &var DumpSink, table: UnsafePointer<UInt8>, at: BtFrameAt) unsafe {
    if not bt_known_frame(table, at.index) {
        dump_text(&var sink, "    at <unknown frame>\n")
        return
    }
    let rec = bt_frame_record(table, at.index)
    let state = bt_state_record(table, at)
    dump_text(&var sink, "    at ")
    bt_write_name(&var sink, table, bt_u32(table, rec + BT_FRAME_FILE))
    if state >= 0 {
        dump_text(&var sink, ":")
        dump_int(&var sink, bt_u32(table, state))
    }
    dump_text(&var sink, " in ")
    bt_write_name(&var sink, table, bt_u32(table, rec + BT_FRAME_NAME))
    dump_text(&var sink, "\n")
}

// Writes the NUL-terminated name at offset `offset` of the string table; the
// empty name, offset 0, prints `?`.
func bt_write_name(sink: &var DumpSink, table: UnsafePointer<UInt8>, offset: Int) unsafe {
    if offset == 0 {
        dump_text(&var sink, "?")
        return
    }
    let base = table as Int + bt_u32(table, BT_HDR_STRTAB) + offset
    var n = 0
    while n < BT_MAX_NAME && ((base + n) as UnsafePointer<UInt8>)[0] != 0 {
        n = n + 1
    }
    dump_write(&var sink, base as UnsafePointer<Int8>, n)
}
