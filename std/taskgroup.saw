//! The cooperative executor: the run queue tasks are resumed from, the handles
//! a spawn returns, and the background group `Task.spawn` spawns into.
//!
//! A task is a coroutine frame the compiler lays out. The executor reaches a
//! frame only through its `FrameDescriptor`: it resumes the frame, reads the
//! park word the frame recorded through its `TaskContext`, and releases the
//! frame's storage once its root returns `Poll.Ready`. The result and the
//! cancel word live in the task's cell, which outlives the frame, so a handle
//! never addresses the frame itself.
//!
//! A group made with `TaskGroup(threads: N)`, N of two or more, is a worker
//! pool instead: N `Thread.spawn` workers serve its run queue from its first
//! spawn until its teardown, and the shared sweep leaves its frames alone.

import std.mem.{copy_bytes, drop_in_place}
import std.task.{Thread}

// A pool's run-queue lock and its idle workers' condition variable. Both live
// in one block the group owns, each in a conservative slot: `pthread_mutex_t`
// is 64 bytes at most on the hosted targets, and `pthread_cond_t` 48
// (runtime/ABI.md).
extern "C" {
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<UInt8>) -> Int
    func __saw_rt_pthread_cond_init_default(c: UnsafePointer<UInt8>) -> Int
    func pthread_mutex_lock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_unlock(m: UnsafePointer<UInt8>) -> Int32
    func pthread_mutex_destroy(m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_wait(c: UnsafePointer<UInt8>, m: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_broadcast(c: UnsafePointer<UInt8>) -> Int32
    func pthread_cond_destroy(c: UnsafePointer<UInt8>) -> Int32
}

static QUEUE_GATE_SLOT: Int = 64
static QUEUE_GATE_ALIGN: Int = 16

extern "C" {
    func __saw_rt_clock_monotonic_nanos() -> Int64
    // The reactor seams that can fail return 0 or the negated portable tag,
    // with the raw code beside it in `__saw_rt_last_raw_code` (runtime/ABI.md).
    func __saw_rt_reactor_create(r_out: UnsafePointer<Int>) -> Int
    func __saw_rt_reactor_destroy(r: Int)
    func __saw_rt_reactor_poll(r: Int, timeout_ms: Int, count_out: UnsafePointer<Int>) -> Int
    func __saw_rt_reactor_register(r: Int, fd: Int, write: Int, token: Int) -> Int
    func __saw_rt_last_raw_code() -> Int
    func __saw_rt_reactor_unregister(r: Int, fd: Int, write: Int)
    func __saw_rt_reactor_wake(r: Int)
    func __saw_rt_sleep_ns(ns: UInt64)
}

// The park word vocabulary: what a frame records through `TaskContext.park`
// before it returns `Pending`, and what a slot is decided by between resumes.
//
//   == 1    a timer, whose deadline is the context's `deadline` word
//   == 0    ready: resume on the next sweep (`yield_now`, a budget yield)
//   == -1   a descriptor's readiness, armed through `__saw_exec_io_register`,
//           and bounded by the context's `deadline` when that is nonzero;
//           the reactor's poll latches the word to 0 when the descriptor is
//           ready, so a latched park reads as a ready one
//    < -1   a channel's readiness word, by its negated address
//
// A value above 1 names no park, and a frame that records one is refused.
// The executor waits on a ready park, a timer, a descriptor and a channel's
// readiness word, and wakes a park of any reason whose task is cancelled
// (`park_wakes`); each other reason has its own lowering and its own executor
// half. `PARK_UNSET` is written before every resume, so a frame that reports
// `Pending` without recording a park is caught rather than read as stale
// (SL:coroutines §3.3).
static PARK_READY: Int = 0
static PARK_TIMER: Int = 1
static PARK_FD: Int = -1
static PARK_UNSET: Int = Int.min

/// What one resume of a frame reports.
public enum Poll {
    /// The frame's root returned, and its result is in the result slot.
    case Ready,
    /// The frame parked, and recorded why through its context's park word.
    case Pending
}

/// The record every resume of a task's frames is handed: where the task
/// parks, where its cancel word is, and which task it is.
///
/// A frame driving a child passes the same context down, so a park anywhere
/// in the task records the root's word.
public struct TaskContext {
    /// The task's park word.
    park: UnsafePointer<Int>
    /// The task's cancel word, which `cancelled()` reads.
    cancel: UnsafePointer<Bool>
    /// The task's identity, for the task backtrace.
    task: Int
    /// The monotonic instant, in nanoseconds, that the task's timer park, or
    /// its bounded descriptor park, waits until; 0 when its park has none.
    ///
    /// It is 64 bits on every target, so a deadline never narrows to fit the
    /// park word. The backend reaches each field by its offset, so the order
    /// is free.
    deadline: UInt64
}

/// The constant record the compiler emits for each frame type, through which
/// the executor reaches a frame of that type.
///
/// `resume` runs the frame to its next park or its end; it stands in for the
/// backend's `__saw_frame_resume` helper, which takes the same operands, until
/// frames are lowered. A task's storage is `size` bytes at alignment `align`,
/// and its root's result, `result_size` bytes at alignment `result_align`,
/// sits `result_offset` bytes in; `drop_result` destroys a result in place.
/// `backtrace` is the frame type's index in the backtrace table.
///
/// Both function values are `sync`: a resume reports a park as `Pending`
/// rather than suspending its caller, and a drop never suspends, so the
/// handles that reach them stay callable from `sync` code.
public struct FrameDescriptor {
    resume: (UnsafePointer<UInt8>, UnsafePointer<TaskContext>) unsafe sync -> Poll
    size: Int
    align: Int
    result_offset: Int
    result_size: Int
    result_align: Int
    drop_result: (UnsafePointer<UInt8>) unsafe sync -> Void
    backtrace: Int
}

/// Where a handle came from, which decides whether dropping it is a fate.
///
/// A `Task.spawn` handle is the task's only consumer, so it must be joined,
/// detached or cancelled; a `group.spawn` handle may be dropped, because its
/// group is a declared consumer.
public enum TaskProvenance {
    /// Minted by `Task.spawn`.
    case Singleton,
    /// Minted by `group.spawn`.
    case Group
}

// A spawned task's cell: its context, park and cancel words, and the storage
// its result is moved into when the frame finishes. One heap block holds the
// cell and, at `result`, its result bytes, so every address the context hands
// out is stable for the task's life (design 134).
struct TaskCell {
    context: TaskContext
    park: Int
    cancel: Bool
    // No handle will take the result: its handle detached, or was dropped
    // before the task finished.
    unclaimed: Bool
    // A result was moved in and is neither taken nor dropped yet.
    holding: Bool
    descriptor: UnsafePointer<FrameDescriptor>
    result: UnsafePointer<UInt8>
    bytes: Int
    align: Int
}

// One run-queue entry. `generation` is half of the (slot, generation) pair a
// handle records, so a handle to a task whose slot was reused is recognisably
// stale. `active` marks a frame being resumed: on this thread's stack, where
// a nested sweep skips it, since resuming it would re-enter a live coroutine;
// or, in a pool, on a worker, which claimed it under the run-queue lock.
struct TaskSlot {
    frame: UnsafePointer<UInt8>?
    cell: UnsafePointer<TaskCell>?
    generation: Int
    done: Bool
    active: Bool
    // A frame the executor allocated and frees; `main`'s frame is the
    // entry's own.
    owned: Bool
    // The address of the task's cancel word escaped through `cancel_addr`,
    // as an `Int` that carries no generation, so the slot keeps its cell for
    // the group's life and is never reused.
    pinned: Bool
}

// The (slot, generation) pair an enqueue hands back.
struct TaskTicket {
    slot: Int
    generation: Int
}

/// A scope for spawned tasks: every task spawned into a group finishes before
/// the group is destroyed.
///
/// A group made with `TaskGroup()` runs its tasks on the one cooperative
/// scheduler, beside every other such group's, whenever it runs: under a
/// suspending `main`, at a `join`, at a group's teardown, and while a test
/// driver waits for its frame's timer. A group made with
/// `TaskGroup(threads: N)`, N of two or more, runs them on a pool of N worker
/// threads, started at its first spawn, which run alongside the thread that
/// owns the group until the group is destroyed. A group may live in a
/// suspending function's frame and stay there across its suspensions. It is
/// `NoMove`, because its tasks and its workers reach it through its address.
public struct TaskGroup {
    private slots: Vector<TaskSlot>
    private free: Vector<Int>
    // The ambient list link: the next registered group's address, 0 at the
    // end, and whether this group is in the list.
    private next: Int
    private registered: Bool
    // The `group.spawn` handles still claiming their task's result, which the
    // teardown requires to be none (`check_no_outstanding`). It goes down only
    // when a handle lets go of the result, at its join or its drop
    // (`Task.let_go`), never at `cancel`: a cancelled handle still reaches the
    // group when it is joined or dropped. Read and written atomically, and
    // read at the teardown after a pool's workers have joined.
    private outstanding: Int
    // The pool's worker count; 1 for the cooperative engine.
    private threads: Int
    // The address of the pool's run-queue lock and condition variable, or 0
    // for the cooperative engine, which takes no lock (`queue_mutex`).
    private lock: Int
    // Set under the lock: `started` by the first spawn, which then starts the
    // workers, and `stopping` once, by the teardown, after which a worker
    // leaves as soon as no task is live.
    private started: Bool
    private stopping: Bool
    // The workers blocked in the reactor's poll rather than on the condition
    // variable, under the lock: a spawn and a completion poke the reactor
    // only while one is.
    private pollers: Int
    // The workers' handles, joined at the teardown. Only the owning thread
    // touches them, so they need no lock.
    private crew: Vector<Thread<Void>>
}

extension TaskGroup {
    /// Creates an empty group, whose tasks run on the shared cooperative
    /// scheduler.
    public init() -> TaskGroup {
        TaskGroup(slots: Vector<TaskSlot>(), free: Vector<Int>(), next: 0, registered: false,
                  outstanding: 0, threads: 1, lock: 0, started: false, stopping: false, pollers: 0,
                  crew: Vector<Thread<Void>>())
    }

    /// Creates an empty group whose tasks run on a pool of `threads` worker
    /// threads.
    ///
    /// The pool starts at the group's first spawn, so a group that never
    /// spawns starts no thread, and runs until the group is destroyed. Its
    /// tasks run alongside the thread that owns the group, in parallel, so
    /// every value a spawned frame carries must be `Send`. `threads: 1` or
    /// less is the cooperative engine, exactly as `TaskGroup()` is. Returns
    /// `Err(AllocError)` if the pool's lock cannot be allocated. A worker
    /// thread the operating system refuses panics at the first spawn, naming
    /// the error.
    public init(threads: Int) unsafe -> Result<TaskGroup, AllocError> {
        if threads <= 1 {
            return TaskGroup()
        }
        let size = QUEUE_GATE_SLOT * 2
        guard let raw = GlobalAllocator().alloc(size, QUEUE_GATE_ALIGN) else {
            return AllocError(size: size, align: QUEUE_GATE_ALIGN)
        }
        let gate = raw as UnsafePointer<UInt8>
        // A refused initialization is no allocation failure, and `AllocError`
        // is all this constructor reports, so it panics with the cause.
        if __saw_rt_pthread_mutex_init_default(gate) != 0 {
            panic("TaskGroup(threads:): initializing its lock failed (errno {})", __saw_rt_last_raw_code())
        }
        if __saw_rt_pthread_cond_init_default(gate + QUEUE_GATE_SLOT) != 0 {
            panic("TaskGroup(threads:): initializing its condition variable failed (errno {})",
                  __saw_rt_last_raw_code())
        }
        return TaskGroup(slots: Vector<TaskSlot>(), free: Vector<Int>(), next: 0, registered: false,
                         outstanding: 0, threads: threads, lock: raw as Int, started: false,
                         stopping: false, pollers: 0, crew: Vector<Thread<Void>>())
    }

    /// Returns the number of task slots the group holds: its live tasks, plus
    /// the finished ones whose handle is still waiting to join the result,
    /// plus those whose cancel address `cancel_addr` handed out, which are
    /// never reused.
    public func count(&self) -> Int {
        if self.lock == 0 {
            return self.slots.len() - self.free.len()
        }
        queue_count(&self)
    }
}

// A pool's `count`, read under its lock.
func queue_count(group: &TaskGroup) unsafe -> Int {
    // Through an address, since a worker writes the queue while this reads it.
    let at = (&group) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>
    lock_queue(at)
    let n = at[0].slots.len() - at[0].free.len()
    unlock_queue(at)
    n
}

// The run-queue lock and the condition variable beside it, of the pool at
// `at`.
func queue_mutex(at: UnsafePointer<TaskGroup>) unsafe -> UnsafePointer<UInt8> {
    at[0].lock as UnsafePointer<UInt8>
}

func queue_cond(at: UnsafePointer<TaskGroup>) unsafe -> UnsafePointer<UInt8> {
    (at[0].lock + QUEUE_GATE_SLOT) as UnsafePointer<UInt8>
}

// Takes the run-queue lock of the group at `at`; nothing on the cooperative
// engine, which has no second thread to take it against. Every read and write
// of a pool's slots, free list, `started`, `stopping` and `pollers` is made
// with it held, except the deadlock walk's, which says so.
//
// A pool's state is reached through the group's address, never through a
// `&TaskGroup` or `&var TaskGroup` parameter whose call spans a lock: such a
// parameter promises that nothing else writes the group while the call runs,
// and a worker does. A run-queue write that takes one (`place`, `complete`,
// `recycle`) is called with the lock already held.
func lock_queue(at: UnsafePointer<TaskGroup>) unsafe {
    if at[0].lock != 0 {
        let _ = pthread_mutex_lock(queue_mutex(at))
    }
}

func unlock_queue(at: UnsafePointer<TaskGroup>) unsafe {
    if at[0].lock != 0 {
        let _ = pthread_mutex_unlock(queue_mutex(at))
    }
}

// The group's teardown is its structured join: every live task is driven to
// completion where the group was born, other groups' tasks advancing beside
// them, and then each slot is released. Nothing is cancelled. The sweep skips every frame active on this thread's
// stack, so a group torn down while one of its own tasks is further up the
// stack would release a frame that has not returned `Ready`; it panics
// instead (SL:coroutines §3.1). The outstanding-handle check sits between the
// join and the release: a handle a task's own frame held was dropped by that
// task's code during the join, and nothing a late handle reads is freed yet.
//
// A pool's teardown is the same join, made by its workers: it says no more
// work is coming, the workers finish every live task and leave, and it joins
// them (`shutdown_crew`). Only then is anything released.
extension TaskGroup: NoCopy {
    public func deinit(&var self) unsafe {
        if self.lock != 0 {
            shutdown_crew((&self) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>)
        } else if self.registered {
            let me = (&self) as UnsafePointer<TaskGroup> as Int
            exec_run(me, -1, 0)
            if self.has_live() {
                panic("TaskGroup: the group is torn down while one of its tasks is running further up this thread's stack")
            }
        }
        check_no_outstanding(&self)
        unregister(&var self)
        release_slots(&var self)
        if self.lock != 0 {
            // Every worker has joined, so nothing waits on either.
            let gate = self.lock as UnsafePointer<UInt8>
            let _ = pthread_cond_destroy(gate + QUEUE_GATE_SLOT)
            let _ = pthread_mutex_destroy(gate)
            GlobalAllocator().dealloc(gate as UnsafePointer<Int8>, QUEUE_GATE_SLOT * 2, QUEUE_GATE_ALIGN)
        }
    }
}

// A group may be destroyed only once every `group.spawn` handle to it has let
// go of its task's result. A handle that still claims one, a cancelled one
// included, reads or writes the group when it is joined or dropped, so one
// still outstanding here would reach freed storage later; the borrow check
// refuses the routes it sees, and this catches the rest, a handle minted
// through a borrow window among them.
//
// ENTRY POINTS:
//   TaskGroup.deinit
func check_no_outstanding(group: &TaskGroup) unsafe {
    let n = __saw_atomic_load_i64_seq_cst((&group.outstanding) as UnsafePointer<Int>)
    if n < 0 {
        panic("TaskGroup: a task handle's fate was counted more than once")
    }
    if n == 1 {
        panic("TaskGroup: destroyed while 1 task handle still refers to it; join or drop each `group.spawn` handle before its group ends")
    }
    if n != 0 {
        panic("TaskGroup: destroyed while {} task handles still refer to it; join or drop each `group.spawn` handle before its group ends",
              n)
    }
}

// A `group.spawn` handle to the group at `group` was minted.
//
// ENTRY POINTS:
//   Task.__saw_spawn
func handle_minted(group: UnsafePointer<TaskGroup>) unsafe {
    let _ = __saw_atomic_add_i64_seq_cst((&group[0].outstanding) as UnsafePointer<Int>, 1)
}

// A `group.spawn` handle to the group at `group` let go of its task's result.
// The caller's `released` flag makes this run once per handle, so a joined
// handle that is dropped later counts down nothing more.
//
// ENTRY POINTS:
//   Task.let_go
func handle_released(group: UnsafePointer<TaskGroup>) unsafe {
    let _ = __saw_atomic_add_i64_seq_cst((&group[0].outstanding) as UnsafePointer<Int>, -1)
}

// A group is a scope whose tasks hold its address, so it lives where its
// constructor built it (design 124).
extension TaskGroup: NoMove {}

// The ambient scheduler's list of every group with tasks, threaded through
// each group's `next`; the head group's address, or 0.
static EXEC_HEAD: Atomic<Int> = Atomic(0)

// The background group's address once the first `Task.spawn` built it, or 0.
static BACKGROUND: Atomic<Int> = Atomic(0)

// The executor's side of the hidden-allocation boundary (design 234): a spawn
// is a form, with no expression a `try` could sit on, so a refused allocation
// of the executor's panics, naming the operation the author wrote.
//
// ENTRY POINTS:
//   `exec_alloc`
//   `alloc_or_fault`
func exec_fault(what: String, e: AllocError) -> Never {
    panic("{}: {}", what, e)
}

// `size` bytes at `align`, for operation `what`.
func exec_alloc(size: Int, align: Int, what: String) unsafe -> UnsafePointer<Int8> {
    if let raw = GlobalAllocator().alloc(size, align) {
        return raw
    }
    exec_fault(what, AllocError(size: size, align: align))
}

// A growth of the executor's bookkeeping, for operation `what`.
func alloc_or_fault(r: Result<Void, AllocError>, what: String) {
    match r {
        case Ok(_) -> {},
        case Err(e) -> exec_fault(what, e)
    }
}

func round_up(n: Int, align: Int) -> Int {
    (n + align - 1) / align * align
}

/// Allocates the storage of a task whose root frame `descriptor` describes,
/// for the compiler's spawn lowering to write the root's arguments into.
///
/// Panics if the allocation is refused.
public func __saw_exec_task_box(descriptor: UnsafePointer<FrameDescriptor>) unsafe -> UnsafePointer<UInt8> {
    exec_alloc(descriptor[0].size, descriptor[0].align, "Task.spawn") as UnsafePointer<UInt8>
}

// A fresh cell for a task of `descriptor`, ready to run.
func new_cell(descriptor: UnsafePointer<FrameDescriptor>) unsafe -> UnsafePointer<TaskCell> {
    var align = alignof<TaskCell>()
    let result_align = descriptor[0].result_align
    if result_align > align {
        align = result_align
    }
    let header = round_up(sizeof<TaskCell>(), align)
    let bytes = header + descriptor[0].result_size
    let raw = exec_alloc(bytes, align, "Task.spawn")
    let cell = raw as UnsafePointer<TaskCell>
    let result = (raw as Int + header) as UnsafePointer<UInt8>
    let context = TaskContext(park: 0 as UnsafePointer<Int>, cancel: 0 as UnsafePointer<Bool>,
                              task: raw as Int, deadline: 0)
    cell[0] = TaskCell(context: context, park: PARK_READY, cancel: false, unclaimed: false,
                       holding: false, descriptor: descriptor, result: result, bytes: bytes,
                       align: align)
    let park = (&cell[0].park) as UnsafePointer<Int>
    let cancel = (&cell[0].cancel) as UnsafePointer<Bool>
    cell[0].context.park = park
    cell[0].context.cancel = cancel
    cell
}

// Destroys the result `cell` holds, if any.
func drop_held_result(cell: UnsafePointer<TaskCell>) unsafe {
    if cell[0].holding {
        cell[0].holding = false
        let drop = cell[0].descriptor[0].drop_result
        drop(cell[0].result)
    }
}

func free_cell(cell: UnsafePointer<TaskCell>) unsafe {
    drop_held_result(cell)
    let bytes = cell[0].bytes
    let align = cell[0].align
    GlobalAllocator().dealloc(cell as UnsafePointer<Int8>, bytes, align)
}

extension TaskGroup {
    // Whether (`slot`, `generation`) no longer names the task it was minted
    // for. Every handle operation asks first, so a stale handle never reaches
    // a successor's state.
    func stale(&self, slot: Int, generation: Int) -> Bool {
        if slot < 0 || slot >= self.slots.len() {
            return true
        }
        self.slots[slot].generation != generation
    }

    func is_done(&self, slot: Int) -> Bool {
        self.slots[slot].done
    }

    // The cell of live slot `slot`.
    func cell_at(&self, slot: Int) unsafe -> UnsafePointer<TaskCell> {
        if let cell = self.slots[slot].cell {
            return cell
        }
        panic("TaskGroup: slot {} holds no task", slot)
    }

    // Whether `slot` can be resumed now: live, not on this thread's stack,
    // and woken (`park_wakes`).
    func runnable(&self, slot: Int) unsafe -> Bool {
        let s = self.slots[slot]
        if s.done || s.active {
            return false
        }
        let cell = self.cell_at(slot)
        park_wakes((&cell[0].context) as UnsafePointer<TaskContext>)
    }

    func has_live(&self) -> Bool {
        var i = 0
        while i < self.slots.len() {
            if not self.slots[i].done {
                return true
            }
            i = i + 1
        }
        false
    }
}

// The run queue's writes are free functions over `&var TaskGroup`, so a group
// reached through its address is written through one argument, `&var g[0]`,
// and never through a method call on an indexed receiver. None is called
// across a resume: the frame being resumed may reach the same group through
// its address (SL:hazards S15).

// Puts the frame at `frame` on `group`'s run queue with a fresh cell. `owned`
// says the executor frees the frame when its root finishes. `group` is the
// group's final storage: the ambient list records its address until
// `unregister`.
func enqueue(group: &var TaskGroup, descriptor: UnsafePointer<FrameDescriptor>,
             frame: UnsafePointer<UInt8>, owned: Bool) unsafe -> TaskTicket {
    register(&var group)
    let cell = new_cell(descriptor)
    if group.lock == 0 {
        return place(&var group, frame, cell, owned)
    }
    enqueue_pooled((&group) as UnsafePointer<TaskGroup> as Int as UnsafePointer<TaskGroup>, frame, cell,
                   owned)
}

// A pool's enqueue: the slot is placed under the lock, the workers are told,
// and the first spawn starts them, outside the lock. Only the owning thread
// spawns into a pool, since a handle or a reference to the group is not
// `Send`, so `started` needs no compare-and-swap.
func enqueue_pooled(at: UnsafePointer<TaskGroup>, frame: UnsafePointer<UInt8>, cell: UnsafePointer<TaskCell>,
                    owned: Bool) unsafe -> TaskTicket {
    var g = at
    lock_queue(at)
    // Stage 0 workaround (SL:hazards S15): canonical: g[0].place(frame, cell, owned)
    let ticket = place(&var g[0], frame, cell, owned)
    let start = not g[0].started
    g[0].started = true
    let poke = queue_changed(at)
    unlock_queue(at)
    if poke {
        poke_reactor()
    }
    if start {
        start_crew(&var g[0], at as Int)
    }
    ticket
}

// Wakes the pool's workers waiting on its condition variable, with its lock
// held, after a change one of them may act on, and answers whether a worker
// is blocked in the reactor's poll instead, which the caller then pokes once
// the lock is released.
func queue_changed(at: UnsafePointer<TaskGroup>) unsafe -> Bool {
    let _ = pthread_cond_broadcast(queue_cond(at))
    at[0].pollers > 0
}

// Claims a reclaimed slot, or grows by one. A reused slot keeps the
// generation its recycle advanced to.
func place(group: &var TaskGroup, frame: UnsafePointer<UInt8>, cell: UnsafePointer<TaskCell>,
           owned: Bool) unsafe -> TaskTicket {
    var slot = -1
    if let reused = group.free.pop() {
        slot = reused
    }
    if slot < 0 {
        slot = group.slots.len()
        // The free list never outgrows the slots, so reserving here is what
        // keeps `recycle` from needing to allocate.
        alloc_or_fault(group.free.reserve(slot + 1), "Task.spawn")
        let fresh = TaskSlot(frame: None, cell: None, generation: 1, done: true, active: false,
                             owned: false, pinned: false)
        alloc_or_fault(group.slots.push(fresh), "Task.spawn")
    }
    let generation = group.slots[slot].generation
    let entry = TaskSlot(frame: frame, cell: cell, generation: generation, done: false,
                         active: false, owned: owned, pinned: false)
    group.slots[slot] = entry
    TaskTicket(slot: slot, generation: generation)
}

// Retires `slot`: its generation advances, so every handle to the task that
// left goes stale, and its cell is freed for the next spawn. A pinned slot
// keeps its cell, its result dropped, and is never reused: a peer may still
// write the cancel word whose address it was handed (`Task.cancel_addr`).
func recycle(group: &var TaskGroup, slot: Int) unsafe {
    let cell = group.cell_at(slot)
    let next = group.slots[slot].generation + 1
    group.slots[slot].generation = next
    if group.slots[slot].pinned {
        drop_held_result(cell)
        return
    }
    free_cell(cell)
    group.slots[slot].cell = None
    alloc_or_fault(group.free.push(slot), "Task.spawn")
}

// The root of `slot` returned `Ready`. Its result moves into the cell and the
// frame's storage is released, the one place a frame is. The cell holds the
// result while a handle may still join it, whatever its size, `Void` included,
// so "holds a result" never depends on the result's bytes. A task no handle
// claims drops its result here and gives up its slot, which keeps a group's
// slots bounded by its live tasks and the finished ones a live handle still
// claims. A frame has no drop glue, so only a frame whose own code reached its end
// holds nothing that still needs destroying (SL:coroutines §3.1).
func complete(group: &var TaskGroup, slot: Int) unsafe {
    let s = group.slots[slot]
    let cell = group.cell_at(slot)
    let descriptor = cell[0].descriptor
    if let frame = s.frame {
        if s.owned {
            let from = (frame as Int + descriptor[0].result_offset) as UnsafePointer<Int8>
            copy_bytes(from, cell[0].result as UnsafePointer<Int8>, descriptor[0].result_size)
            cell[0].holding = true
            GlobalAllocator().dealloc(frame as UnsafePointer<Int8>, descriptor[0].size,
                                      descriptor[0].align)
        }
    }
    group.slots[slot].frame = None
    group.slots[slot].done = true
    if cell[0].unclaimed {
        drop_held_result(cell)
    }
    if not cell[0].holding {
        recycle(&var group, slot)
    }
}

// The handle to `slot` lets go of the task's result without taking it. A task
// that has finished drops its result and gives up its slot now; a live one is
// marked, and `complete` does both when it finishes. A stale handle's slot has
// moved on, and nothing is done.
//
// ENTRY POINTS:
//   Task.detach
//   Task.deinit
func unclaim_slot(group: &var TaskGroup, slot: Int, generation: Int) unsafe {
    if group.stale(slot, generation) {
        return
    }
    let cell = group.cell_at(slot)
    cell[0].unclaimed = true
    if group.slots[slot].done {
        recycle(&var group, slot)
    }
}

// Asks every live task in `group` to stop.
func cancel_every_live(group: &var TaskGroup) unsafe {
    var i = 0
    while i < group.slots.len() {
        if not group.slots[i].done {
            request_cancel(group.cell_at(i))
        }
        i = i + 1
    }
}

// Asks the task of `cell` to stop. Only the cancel word is written: the park
// word stays what the task's last park recorded, and the wake is the
// executor's, read when it next decides what can run (`park_wakes`).
//
// ENTRY POINTS:
//   Task.cancel
//   cancel_every_live
func request_cancel(cell: UnsafePointer<TaskCell>) unsafe {
    cell[0].cancel = true
}

// Whether the park recorded through `cx` can be resumed now: when it is a
// ready one, a descriptor park the reactor latched included; when its task
// has been asked to stop, whatever the park's reason, so a cancelled task
// reaches its cancel path at its next turn and each park it makes after that
// resumes at once, a timer's long before its deadline (SL:coroutines §3.1);
// when it is a timer whose deadline has passed; when it is a bounded
// descriptor park whose deadline has passed; and when it is a channel's
// readiness word that is set.
//
// The readiness word is read atomically: a `Thread.spawn` body or a pool
// worker may set it from another thread, and this load pairs with
// `publish_ready`'s store, so a set
// word brings the message's queue writes with it. Both are sequentially
// consistent, which the poke handshake also needs (`poke_reactor`).
//
// The cancel word is read here, after the resume that parked has returned,
// so the park's record and its arm both precede the read: a cancel that
// arrives before the record, between the record and the arm, or after both
// is seen at this read, and nothing a cancel writes can be overwritten by a
// later record (SL:coroutines R3).
//
// A channel park registers nothing anywhere: the park word itself is the
// registration, and every resume overwrites it with `PARK_UNSET` first. It is
// read only while its task is live and parked, when the receiver's handle,
// held in the parked frame, keeps the word allocated.
//
// ENTRY POINTS:
//   TaskGroup.runnable
//   should_stop (a drive point's own park)
//   idle
func park_wakes(cx: UnsafePointer<TaskContext>) unsafe -> Bool {
    let park = park_word(cx)
    if park == PARK_READY || cx[0].cancel[0] {
        return true
    }
    if park == PARK_FD {
        let deadline = cx[0].deadline
        return deadline != 0 && monotonic_now() >= deadline
    }
    if park < PARK_FD && park != PARK_UNSET {
        let word = (0 - park) as UnsafePointer<Int>
        return __saw_atomic_load_i64_seq_cst(word) != 0
    }
    park == PARK_TIMER && monotonic_now() >= cx[0].deadline
}

// The park word recorded through `cx`, read atomically: the reactor's poll
// latches a descriptor park from whichever thread polls, a pool worker's
// among them.
func park_word(cx: UnsafePointer<TaskContext>) unsafe -> Int {
    __saw_atomic_load_i64_seq_cst(cx[0].park)
}

func monotonic_now() -> UInt64 {
    __saw_rt_clock_monotonic_nanos() as UInt64
}

// Releases every slot's cell, dropping any result nobody took. A slot still
// holding a frame means a frame would be released before its root returned
// `Ready`, which would lose that frame's live values unseen.
func release_slots(group: &var TaskGroup) unsafe {
    var i = 0
    while i < group.slots.len() {
        if group.slots[i].frame.is_some() {
            panic("TaskGroup: a task's frame was released before its root returned Ready")
        }
        if let cell = group.slots[i].cell {
            free_cell(cell)
            let next = group.slots[i].generation + 1
            group.slots[i].cell = None
            group.slots[i].generation = next
        }
        i = i + 1
    }
}

// Links `group` into the ambient list, once.
func register(group: &var TaskGroup) unsafe {
    if group.registered {
        return
    }
    group.next = EXEC_HEAD.load()
    EXEC_HEAD.store((&group) as UnsafePointer<TaskGroup> as Int)
    group.registered = true
}

// Unlinks `group` from the ambient list, fixing its predecessor's `next`.
func unregister(group: &var TaskGroup) unsafe {
    if not group.registered {
        return
    }
    group.registered = false
    let me = (&group) as UnsafePointer<TaskGroup> as Int
    let after_me = group.next
    let head = EXEC_HEAD.load()
    if head == me {
        EXEC_HEAD.store(after_me)
        return
    }
    var cur = head
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let after = g[0].next
        if after == me {
            g[0].next = after_me
            return
        }
        cur = after
    }
}

// Runs the frame at `frame` to its next park or its end: the one place the
// executor calls into a frame. Its body is the descriptor's `resume` stand-in
// until the backend's `__saw_frame_resume(descriptor, frame, context)`
// exists; the call then becomes that helper's, with the same three operands,
// since Saw code cannot call a raw code pointer (SL:coroutines §3.1).
func resume_frame(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                  context: UnsafePointer<TaskContext>) unsafe -> Poll {
    let resume = descriptor[0].resume
    resume(frame, context)
}

// Resumes `slot` of the group at `g` once, then records what it reported.
//
// Nothing is borrowed from the group across the resume: the frame may spawn,
// which grows `slots`, and a join inside it runs a nested sweep over this
// same group. `active` keeps that sweep off this frame.
func resume_slot(at: UnsafePointer<TaskGroup>, slot: Int) unsafe {
    var g = at
    let s = g[0].slots[slot]
    let cell = g[0].cell_at(slot)
    if let frame = s.frame {
        g[0].slots[slot].active = true
        cell[0].park = PARK_UNSET
        let context = (&cell[0].context) as UnsafePointer<TaskContext>
        let poll = resume_frame(cell[0].descriptor, frame, context)
        g[0].slots[slot].active = false
        match poll {
            // Stage 0 workaround (SL:hazards S15): canonical: g[0].complete(slot)
            case Ready -> complete(&var g[0], slot),
            case Pending -> {
                if cell[0].park == PARK_UNSET {
                    panic("executor: a task reported Pending without recording a park")
                }
            }
        }
    }
}

// Whether the sweep `sweep` was asked for is finished: with `waiter` nonzero,
// when the drive point's park recorded through the context at that address
// wakes; otherwise, with `term_group` 0, when no group has a live task; with
// `term_slot` negative, when that group has none; otherwise when that task is
// done, or its slot has moved on to a successor.
func should_stop(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int) unsafe -> Bool {
    if waiter != 0 {
        return park_wakes(waiter as UnsafePointer<TaskContext>)
    }
    if term_group != 0 {
        let g = term_group as UnsafePointer<TaskGroup>
        if term_slot >= 0 {
            return g[0].stale(term_slot, term_gen) || g[0].is_done(term_slot)
        }
        return not g[0].has_live()
    }
    var cur = EXEC_HEAD.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        if g[0].lock == 0 && g[0].has_live() {
            return false
        }
        cur = g[0].next
    }
    true
}

// The sweep a join, a group's teardown and the entry executor run: until the
// task, the group or every group named is finished (`should_stop`).
func exec_run(term_group: Int, term_slot: Int, term_gen: Int) unsafe {
    sweep(term_group, term_slot, term_gen, 0)
}

// How many times a thread has handed itself to the executor and is waiting
// there: in a sweep, in a pool's join, or in a pool's teardown. These nest, so
// it is a depth. The deadlock walk run on a pool worker reads it, because
// nothing in a run queue says whether the thread that owns the groups is
// running code of its own, which could send, or waiting (`quiescent_now`).
static IN_EXECUTOR: Atomic<Int> = Atomic(0)

// The scheduler sweep, shared by every drive point: resumes woken frames
// round-robin across every cooperative group in the ambient list until
// `should_stop` says the sweep is finished, and when a pass wakes nothing,
// waits for the earliest timer (`idle`). A pool's frames are its workers', so
// the sweep never resumes one.
//
// A nested sweep (a task joins a task) skips every frame active on this
// thread's stack, and returns when every live frame is one of those and it
// has no timer of its own to wait for, ceding to the sweep further up.
func sweep(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int) unsafe {
    let _ = IN_EXECUTOR.fetch_add(1)
    sweep_passes(term_group, term_slot, term_gen, waiter)
    let _ = IN_EXECUTOR.fetch_add(-1)
}

func sweep_passes(term_group: Int, term_slot: Int, term_gen: Int, waiter: Int) unsafe {
    while not should_stop(term_group, term_slot, term_gen, waiter) {
        var resumed = false
        var cur = EXEC_HEAD.load()
        while cur != 0 {
            let g = cur as UnsafePointer<TaskGroup>
            var i = 0
            while g[0].lock == 0 && i < g[0].slots.len() {
                if g[0].runnable(i) {
                    resume_slot(g, i)
                    resumed = true
                    if should_stop(term_group, term_slot, term_gen, waiter) {
                        return
                    }
                }
                i = i + 1
            }
            cur = g[0].next
        }
        if not resumed && not idle(waiter) {
            return
        }
    }
}

// A pass woke nothing: blocks in the reactor's poll, which latches each
// descriptor that becomes ready, until the earliest deadline among the timers
// and the bounded descriptor parks off this thread's stack, the drive point's
// park at `waiter` among them, or with no deadline at all when only unbounded
// descriptor parks wait, and answers true; answers false when there is no
// such park and no channel park either, since every live frame is then on
// this thread's stack. A frame parked on a wait this executor does not
// perform is refused rather than spun on, since nothing here would ever wake
// it.
//
// With no timer or descriptor to wait for and a channel park left, the
// deadlock walk decides (`check_quiescent`): it reports when nothing in the
// process can run, and otherwise this blocks in the reactor's poll and
// answers true, since the word's writer is then code running on another
// thread: a `Thread.spawn` body or a pool's task, whose `send` and `close`
// poke the reactor and whose exit pokes it too (`poke_reactor`). While either
// can run, the walk finds nothing to report, so this waits. A pool's frames
// are its workers' to wait for, so they are not read here.
func idle(waiter: Int) unsafe -> Bool {
    var waits = false
    var channel = false
    var earliest = UInt64.max
    if waiter != 0 {
        let w = waiter as UnsafePointer<TaskContext>
        if park_wakes(w) {
            return true
        }
        let park = park_word(w)
        if park == PARK_TIMER || park == PARK_FD {
            waits = true
            if bounded_by(park, w[0].deadline) {
                earliest = w[0].deadline
            }
        }
        if park < PARK_FD {
            channel = true
        }
    }
    let lead = "executor"
    var cur = EXEC_HEAD.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        var i = 0
        while g[0].lock == 0 && i < g[0].slots.len() {
            let s = g[0].slots[i]
            if not s.done && not s.active {
                let cell = g[0].cell_at(i)
                let cx = (&cell[0].context) as UnsafePointer<TaskContext>
                // The clock moved on since the pass, or a deadline it read as
                // future has passed: the next pass resumes the frame.
                if park_wakes(cx) {
                    return true
                }
                let park = park_word(cx)
                if not waits_on(park) {
                    refuse_park(&lead, "a task", park)
                }
                if park == PARK_TIMER || park == PARK_FD {
                    waits = true
                    let deadline = cell[0].context.deadline
                    if bounded_by(park, deadline) && deadline < earliest {
                        earliest = deadline
                    }
                } else {
                    channel = true
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
    // A writer pokes only a reactor that exists, so a channel wait publishes
    // one and then looks again. Every later look follows the publication, and
    // a writer either set its word before it, which that look sees, or reads
    // the reactor after it and pokes.
    if channel && REACTOR.load() == 0 {
        let _ = host_reactor()
        return true
    }
    if waits {
        if earliest == UInt64.max {
            // Only unbounded descriptor parks wait, so nothing but a
            // descriptor becoming ready can wake one.
            idle_poll(-1)
        } else {
            wait_until(earliest)
        }
        return true
    }
    if channel {
        check_quiescent(waiter, false)
        idle_poll(-1)
        return true
    }
    false
}

// How many pools have started their workers and not yet joined them.
static LIVE_POOLS: Atomic<Int> = Atomic(0)

// The longest an idle wait blocks in the reactor's poll while a pool's
// workers are live, in milliseconds.
//
// Several threads then poll one reactor, and a wait need not end where it
// should. The poll that receives a descriptor's event may be another
// thread's, which latches the word and returns, while the thread that
// schedules that frame stays blocked; and a poke is released only to the
// pollers already blocked, so a waiter between its last look and its poll
// can miss one. A `cancel_addr` write pokes nothing at all. Each costs this
// long at most.
static POOL_POLL_CAP_MILLIS: Int = 50

// Blocks in the reactor's poll for up to `millis` milliseconds, forever when
// negative, but never longer than `POOL_POLL_CAP_MILLIS` while a pool is
// live.
//
// ENTRY POINTS:
//   idle
//   wait_until
//   pool_wait
func idle_poll(millis: Int) unsafe {
    var bound = millis
    if LIVE_POOLS.load() > 0 && (bound < 0 || bound > POOL_POLL_CAP_MILLIS) {
        bound = POOL_POLL_CAP_MILLIS
    }
    reactor_poll(bound)
}

// The confirmation nap between the deadlock walk's two looks.
static QUIESCENT_NAP_NANOS: UInt64 = 1_000_000

// Whether no code in this process can run any more, with at least one task
// parked on a channel's readiness word that is clear: the quiescent state the
// deadlock report keys on (design 230).
//
// Whether a sender will ever exist for a channel is not decidable, but a
// readiness word is published only by running code, so the walk asks only
// whether any code can run, by elimination. Each of these ends it:
//   * a running `Thread.spawn` body (`LIVE_THREADS`), read before any
//     readiness word: a body that sends and then exits lowers the count after
//     its send, so a walk that reads the count as zero sees the word set;
//   * a live frame that is not active and whose park wakes now (`park_wakes`:
//     ready, latched, cancelled, a deadline passed, a set readiness word);
//   * a frame parked on a timer or a descriptor, since its deadline or the
//     reactor can wake it;
//   * any other park that is not a channel's;
//   * a frame a pool worker is resuming;
//   * from a pool worker, a thread outside the executor (`IN_EXECUTOR`): a
//     pool's workers are no `Thread.spawn` bodies to this count, so the walk
//     has to learn some other way that the thread owning the groups is
//     waiting rather than computing toward a send.
// A cooperative frame active on the walking thread's stack counts as blocked:
// it is waiting in a nested join or drive on the very sweep that asks, so it
// cannot run before that sweep returns, and the spec reports this state
// rather than waiting forever. Seen from a worker, every active frame is on
// another thread's stack and counts as running. The drive point's own park at
// `waiter`, on no run queue, is classified as any slot's is.
//
// A pool's slots are read without its lock, as every other group's are: the
// walk is a report, read twice.
//
// ENTRY POINTS:
//   check_quiescent
func quiescent_now(waiter: Int, on_worker: Bool) unsafe -> Bool {
    if LIVE_THREADS.load() != 0 {
        return false
    }
    if on_worker && IN_EXECUTOR.load() == 0 {
        return false
    }
    var parked = false
    if waiter != 0 {
        let w = waiter as UnsafePointer<TaskContext>
        if not channel_parked(w) {
            return false
        }
        parked = true
    }
    var cur = EXEC_HEAD.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let pooled = g[0].lock != 0
        var i = 0
        while i < g[0].slots.len() {
            let s = g[0].slots[i]
            if not s.done {
                if s.active && (pooled || on_worker) {
                    return false
                }
                if not s.active {
                    let cell = g[0].cell_at(i)
                    if not channel_parked((&cell[0].context) as UnsafePointer<TaskContext>) {
                        return false
                    }
                    parked = true
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
    parked
}

// Whether the park recorded through `cx` is a channel's readiness word that
// is clear, with its task not cancelled: the one park the deadlock walk counts
// as waiting for good.
func channel_parked(cx: UnsafePointer<TaskContext>) unsafe -> Bool {
    if park_wakes(cx) {
        return false
    }
    let park = park_word(cx)
    park < PARK_FD && park != PARK_UNSET
}

// Set by the first deadlock report, so a second engine reaching the same
// state stays quiet while the first one ends the process.
static DEADLOCK_REPORTED: Atomic<Int> = Atomic(0)

// The deadlock report: panics when the walk finds the process quiescent
// twice, a nap apart, and returns otherwise. The walk reads unsynchronized
// state, which is fine for a report and not for an abort, so a real deadlock
// costs one more look and a false one would need the same misreading twice.
//
// ENTRY POINTS:
//   idle
//   pool_wait (`on_worker`)
func check_quiescent(waiter: Int, on_worker: Bool) unsafe {
    if not quiescent_now(waiter, on_worker) {
        return
    }
    __saw_rt_sleep_ns(QUIESCENT_NAP_NANOS)
    if not quiescent_now(waiter, on_worker) {
        return
    }
    if not DEADLOCK_REPORTED.compare_exchange(0, 1) {
        return
    }
    panic("deadlock: every task is waiting to receive from a channel, and nothing in this program can send. A channel has no sender count — every handle is the same handle — so a producer that is finished must say so with close(), and a receive on a closed, drained channel returns Err(Closed) instead of waiting")
}

// Whether park word `park` waits until the context's `deadline`: a timer
// always does, and a descriptor park when its deadline is nonzero.
func bounded_by(park: Int, deadline: UInt64) -> Bool {
    park == PARK_TIMER || (park == PARK_FD && deadline != 0)
}

// Whether the executor performs the wait park word `park` records. A ready
// park needs none; a cancel wakes a park of any reason (`park_wakes`).
func waits_on(park: Int) -> Bool {
    park == PARK_READY || park == PARK_TIMER || (park <= PARK_FD && park != PARK_UNSET)
}

// Panics for park word `park`, a wait the executor does not perform, which
// `subject` recorded: `lead` opens the message.
func refuse_park(lead: &String, subject: String, park: Int) -> Never {
    panic("{}: {} recorded park word {}, which names no park", lead, subject, park)
}

// The process-wide reactor instance, created on first use; 0 until then
// (runtime/ABI.md, "The IO reactor").
static REACTOR: Atomic<Int> = Atomic(0)

// The process-wide reactor. A thread that loses the race to publish its new
// instance destroys it and takes the winner's.
//
// A reactor that cannot be made (descriptor exhaustion, say) leaves the
// executor nothing to wait in, and no caller has an error channel, so it
// panics with the cause; an instance every poll returns from at once would
// make the executor spin through every timed wait.
func host_reactor() unsafe -> Int {
    let current = REACTOR.load()
    if current != 0 {
        return current
    }
    var fresh = 0
    if __saw_rt_reactor_create((&fresh) as UnsafePointer<Int>) != 0 {
        panic("reactor: creating the reactor failed (errno {})", __saw_rt_last_raw_code())
    }
    if REACTOR.compare_exchange(0, fresh) {
        return fresh
    }
    __saw_rt_reactor_destroy(fresh)
    REACTOR.load()
}

// Rouses every thread blocked in the reactor's poll, when a reactor exists,
// so it looks again at what changed. A program that never waited makes none,
// so its channel traffic costs neither a descriptor nor an allocation.
//
// The poke and the look form one handshake with `idle`, which publishes the
// reactor before its last look: the writer stores its change and then reads
// `REACTOR`, the waiter stores `REACTOR` and then reads the change, all
// sequentially consistent, so at least one of the two sees the other's store.
// Release and acquire alone would allow both to miss.
//
// ENTRY POINTS:
//   __saw_exec_chan_wake
//   __saw_exec_thread_finished
//   enqueue_pooled
//   worker_resume
//   Task.cancel
func poke_reactor() {
    let r = REACTOR.load()
    if r != 0 {
        __saw_rt_reactor_wake(r)
    }
}

// How many `Thread.spawn` bodies are running. No run queue knows about one, and
// one may send to a channel a task waits on, so the deadlock walk reports
// nothing and `idle` waits while it is nonzero (design 230). Raised at the
// spawn before the thread exists, and lowered by the thread's exit once its
// body's effects are done, as the last thing the thread does. A pool's
// workers are not counted while they serve it (`start_crew`).
//
// The lowering needs only a release and the walk's read only an acquire. Both
// are sequentially consistent instead, as `Atomic` is: stronger, and the poke
// handshake with `idle` needs it (`poke_reactor`).
static LIVE_THREADS: Atomic<Int> = Atomic(0)

// Counts one more running `Thread.spawn` body: the spawn lowering's call,
// made before the thread is started. Only that lowering moves the count. A
// spawn the operating system refuses takes it back with
// `__saw_exec_thread_finished`.
public(package) func __saw_exec_thread_started() {
    let _ = LIVE_THREADS.fetch_add(1)
}

// Counts one running `Thread.spawn` body fewer, then wakes an executor blocked
// in the reactor's poll so its deadlock walk looks again: the last call a
// spawned thread makes, after its body's effects.
public(package) func __saw_exec_thread_finished() {
    // Sequentially consistent, so at least a release of everything the body
    // did, and ordered ahead of the poke's read (`poke_reactor`).
    let _ = LIVE_THREADS.fetch_add(-1)
    poke_reactor()
}

// A channel's readiness word changed: `send` and `close` call this after they
// publish it, so a receiver's executor blocked in the reactor's poll on
// another thread sees the word at once rather than at its next timeout.
public(package) func __saw_exec_chan_wake() {
    poke_reactor()
}

// The pool (SL:coroutines A17a). One mutex-protected run queue, the group's
// own slots, served by the group's workers: a worker claims a runnable frame
// under the lock by marking its slot active, resumes it with the lock
// released, and takes the lock again to record what it reported. Every
// address a resume needs is the frame's or its cell's, never one into
// `slots`, so the owning thread may grow the queue while a frame runs. A
// worker with nothing to run waits on the condition variable while nothing
// outside the lock can make a frame runnable, and in the reactor's poll while
// something can: a timer, a descriptor, a channel's readiness word, a cancel.

// Starts the pool of `group`, whose address is `addr`: its first spawn's last
// step, outside the lock, on the owning thread.
//
// A worker is a `Thread.spawn` body but no user thread: whatever it runs is a
// frame in this group, which the deadlock walk reads directly. So it is taken
// back out of `LIVE_THREADS` once started, where the count would keep every
// program with a pool from reporting a deadlock; `shutdown_crew` puts it back
// ahead of the join, whose thread exit takes it out again.
//
// The group has no error channel at a spawn, so a thread the operating
// system refuses panics, naming the error.
//
// The workers it starts write the group while this runs, so it reads and
// writes only `threads` and `crew`, which no worker touches.
func start_crew(group: &var TaskGroup, addr: Int) unsafe {
    let n = group.threads
    alloc_or_fault(group.crew.reserve(n), "TaskGroup(threads:)")
    let _ = LIVE_POOLS.fetch_add(1)
    var i = 0
    while i < n {
        // Stage 0 workaround (SL:hazards S2): canonical: match Thread.spawn({ [addr] in exec_worker(addr) }) {
        let spawned = Thread.spawn({ [addr] in exec_worker(addr) })
        match spawned {
            case Ok(worker) -> {
                let _ = LIVE_THREADS.fetch_add(-1)
                // The handle's fate is the teardown's join: the group
                // declares a `deinit` (`shutdown_crew`).
                alloc_or_fault(group.crew.push(move worker), "TaskGroup(threads:)")
            },
            case Err(e) -> {
                panic("TaskGroup(threads: {}): starting worker thread {} failed (errno {}): {}", n, i + 1,
                      __saw_rt_last_raw_code(), e)
            }
        }
        i = i + 1
    }
}

// Retires the pool of the group at `at`, from its teardown: no more work is
// coming, every worker finishes the live tasks and leaves once none is left,
// and each is joined, once. Nothing is cancelled. A pool that never started
// has nothing to tell and nothing to join.
//
// The owning thread waits inside the executor meanwhile, so a worker whose
// tasks are all parked on channels nothing can send to reports it.
func shutdown_crew(at: UnsafePointer<TaskGroup>) unsafe {
    var g = at
    if not g[0].started {
        return
    }
    let _ = IN_EXECUTOR.fetch_add(1)
    lock_queue(at)
    g[0].stopping = true
    let poke = queue_changed(at)
    unlock_queue(at)
    if poke {
        poke_reactor()
    }
    join_crew(&var g[0].crew)
    g[0].started = false
    let _ = LIVE_POOLS.fetch_add(-1)
    let _ = IN_EXECUTOR.fetch_add(-1)
}

// Joins each of a stopping pool's workers, putting each back in
// `LIVE_THREADS` first, since its thread's exit takes it out again.
func join_crew(crew: &var Vector<Thread<Void>>) unsafe {
    var joining = true
    while joining {
        // Stage 0 workaround (SL:hazards S2): canonical: while let worker = crew.pop() { var held = move worker; LIVE_THREADS.fetch_add(1); held.join() }
        let next = crew.pop()
        if let worker = move next {
            var held = move worker
            let _ = LIVE_THREADS.fetch_add(1)
            held.join()
        } else {
            joining = false
        }
    }
}

// Waits for task (`slot`, `generation`) of the pool at `at` to finish, or its
// slot to move on, on the condition variable every resume's outcome is
// broadcast on. The waiter is the owning thread, since a handle is not
// `Send`, so no worker is ever in here; it waits inside the executor.
func await_task(at: UnsafePointer<TaskGroup>, slot: Int, generation: Int) unsafe {
    let _ = IN_EXECUTOR.fetch_add(1)
    lock_queue(at)
    while not at[0].stale(slot, generation) && not at[0].is_done(slot) {
        let _ = pthread_cond_wait(queue_cond(at), queue_mutex(at))
    }
    unlock_queue(at)
    let _ = IN_EXECUTOR.fetch_add(-1)
}

// One worker's life: turns until the pool is stopping and nothing is live.
// The lock is held throughout, except across a resume and a wait.
func exec_worker(addr: Int) unsafe {
    let at = addr as UnsafePointer<TaskGroup>
    lock_queue(at)
    while worker_turn(at) {}
    unlock_queue(at)
}

// One look at the run queue, with the lock held: resumes the first frame
// whose park wakes, or waits for one to, and answers false once the worker
// is to leave.
func worker_turn(at: UnsafePointer<TaskGroup>) unsafe -> Bool {
    var g = at
    let lead = "TaskGroup(threads:)"
    var live = false
    var waits = false
    var channel = false
    var busy = false
    var earliest = UInt64.max
    var i = 0
    while i < g[0].slots.len() {
        let s = g[0].slots[i]
        if not s.done {
            live = true
            if s.active {
                busy = true
            } else {
                let cell = g[0].cell_at(i)
                let cx = (&cell[0].context) as UnsafePointer<TaskContext>
                if park_wakes(cx) {
                    worker_resume(at, i)
                    return true
                }
                let park = park_word(cx)
                if not waits_on(park) {
                    refuse_park(&lead, "a task", park)
                }
                if park == PARK_TIMER || park == PARK_FD {
                    waits = true
                    let deadline = cell[0].context.deadline
                    if bounded_by(park, deadline) && deadline < earliest {
                        earliest = deadline
                    }
                } else {
                    channel = true
                }
            }
        }
        i = i + 1
    }
    if not live && g[0].stopping {
        return false
    }
    if not waits && not channel {
        // Nothing live, or only frames a peer is resuming: a spawn, the
        // teardown and every resume's outcome broadcast.
        let _ = pthread_cond_wait(queue_cond(at), queue_mutex(at))
        return true
    }
    // A writer pokes only a reactor that exists, so a channel wait publishes
    // one and then looks again, as `idle` does.
    if channel && REACTOR.load() == 0 {
        unlock_queue(at)
        let _ = host_reactor()
        lock_queue(at)
        return true
    }
    g[0].pollers += 1
    unlock_queue(at)
    pool_wait(waits, earliest, channel && not waits && not busy)
    lock_queue(at)
    g[0].pollers -= 1
    true
}

// Resumes `slot` of the pool at `at`, claimed under the lock, which is
// released for the resume and held again when this returns.
func worker_resume(at: UnsafePointer<TaskGroup>, slot: Int) unsafe {
    var g = at
    let s = g[0].slots[slot]
    let cell = g[0].cell_at(slot)
    if let frame = s.frame {
        g[0].slots[slot].active = true
        cell[0].park = PARK_UNSET
        let context = (&cell[0].context) as UnsafePointer<TaskContext>
        let descriptor = cell[0].descriptor
        unlock_queue(at)
        let poll = resume_frame(descriptor, frame, context)
        lock_queue(at)
        g[0].slots[slot].active = false
        var finished = false
        match poll {
            case Ready -> {
                // Stage 0 workaround (SL:hazards S15): canonical: g[0].complete(slot)
                complete(&var g[0], slot)
                finished = true
            },
            case Pending -> {
                if cell[0].park == PARK_UNSET {
                    panic("executor: a task reported Pending without recording a park")
                }
            }
        }
        // A join waits for a completion on the condition variable, and a
        // peer that saw this frame active waits there for its outcome. A
        // stopping pool's last completion is what its polling workers leave
        // on, so they are poked out of the poll.
        let polling = queue_changed(at)
        if polling && finished && g[0].stopping {
            unlock_queue(at)
            poke_reactor()
            lock_queue(at)
        }
    }
}

// An idle worker's wait, with the lock released: until the earliest deadline
// among its group's parks, a descriptor's readiness, a poke, or the pool's
// poll cap, whichever is first (`idle_poll`). When every live task of the
// group is parked on a channel and no peer is resuming one, the deadlock walk
// looks first.
func pool_wait(waits: Bool, earliest: UInt64, walk: Bool) unsafe {
    if walk {
        check_quiescent(0, true)
    }
    if waits && earliest != UInt64.max {
        wait_until(earliest)
    } else {
        idle_poll(-1)
    }
}

// The unit of the reactor poll's timeout, a millisecond, in nanoseconds.
static POLL_TICK_NANOS: UInt64 = 1_000_000
// The longest single idle poll, in milliseconds. epoll takes its timeout as
// a C `int`, so a longer deadline is waited for in polls of this length.
static IDLE_POLL_CAP_MILLIS: Int = 60_000

// The executor's idle wait: blocks this thread in the reactor's poll until
// the monotonic clock reaches `deadline`, or until the reactor is woken. The
// timeout is rounded up to whole milliseconds, since a sub-millisecond rest
// rounded down would be a zero timeout, and a poll that returns before the
// deadline costs one more pass of the sweep, which polls again.
func wait_until(deadline: UInt64) unsafe {
    let now = monotonic_now()
    if now >= deadline {
        return
    }
    let rest = deadline - now
    var millis = IDLE_POLL_CAP_MILLIS
    if rest < (IDLE_POLL_CAP_MILLIS as UInt64) * POLL_TICK_NANOS {
        millis = ((rest + POLL_TICK_NANOS - 1) / POLL_TICK_NANOS) as Int
    }
    idle_poll(millis)
}

// The portable tag of a poll a signal cut short (runtime/ABI.md).
static POLL_INTERRUPTED_TAG: Int = 4

// Blocks this thread in the reactor's poll for up to `millis` milliseconds,
// forever when negative. Every caller looks again at what changed once it
// returns, so a poll a signal cut short is an early return like any other.
// Any other failure is a broken instance, which nothing can recover from, so
// it panics with the cause.
func reactor_poll(millis: Int) unsafe {
    var count = 0
    let status = __saw_rt_reactor_poll(host_reactor(), millis, (&count) as UnsafePointer<Int>)
    if status != 0 && status != 0 - POLL_INTERRUPTED_TAG {
        panic("reactor: polling the reactor failed (errno {})", __saw_rt_last_raw_code())
    }
}

// The executor halves the park lowerings call (SL:coroutines §3.1). Each park
// records its park word, and a deadline when it has one, before it calls
// anything here, so a wake that arrives during an arm finds the record.

/// The monotonic instant `nanos` nanoseconds from now, in nanoseconds: the
/// deadline a timer park records in its context. A span past the clock's end
/// saturates there, since no clock reaches it.
public func __saw_exec_timer_deadline(nanos: UInt64) -> UInt64 {
    let now = monotonic_now()
    if nanos > UInt64.max - now {
        return UInt64.max
    }
    now + nanos
}

/// Arms the reactor for descriptor `fd`'s readiness, for reading when `dir`
/// is 0 and for writing when it is 1, so that it wakes the task whose park
/// word is at address `token`: the arm of a descriptor park and of an offload
/// park, made after the park records its word.
///
/// Panics if the arm fails, naming the descriptor, the direction and the
/// platform's error code.
public func __saw_exec_io_register(fd: Int, dir: Int, token: Int) unsafe {
    // The one arm funnel. The park value is written through `token` before
    // the arm, so every latch the reactor's poll makes, from any thread, lands
    // after it and is never erased by it (SL-355).
    //
    // A failed arm panics: no park has an error channel to send it down, and
    // there is nothing to recover, since the descriptor was closed under the
    // park or was never pollable. A silent failure would park the task
    // forever, which reads exactly like a lost wake.
    //
    // `token` is a task's park word, which lives as long as the task; a park
    // that ends without its event withdraws the registration before the task
    // can end (`__saw_exec_io_unregister`).
    //
    // ENTRY POINTS:
    //   coro_lower_park's descriptor park (`__saw_park_fd`, `__saw_park_fd_until`)
    //   coro_lower_park's offload park (`__saw_park_offload`)
    let word = token as UnsafePointer<Atomic<Int>>
    // Stage 0 workaround (SL:hazards S15): canonical: word[0].store(PARK_FD)
    store_park(&word[0], PARK_FD)
    let status = __saw_rt_reactor_register(host_reactor(), fd, dir, token)
    if status != 0 {
        let direction = if dir != 0 { "write" } else { "read" }
        panic("reactor: arming fd {} for {} readiness failed (errno {})", fd, direction,
              __saw_rt_last_raw_code())
    }
}

// Stores park value `value` into the park word `word`.
func store_park(word: &Atomic<Int>, value: Int) {
    word.store(value)
}

// Withdraws the registration a descriptor park armed for `fd` in direction
// `dir`, from a park that ended without its event: a cancel or a deadline.
// The reactor carries the task's park-word address, so a registration left
// behind would latch a word the task no longer parks on, or one in a freed
// cell. Withdrawing an already-fired or never-armed registration does
// nothing.
public(package) func __saw_exec_io_unregister(fd: Int, dir: Int) unsafe {
    __saw_rt_reactor_unregister(host_reactor(), fd, dir)
}

// Whether the monotonic clock has reached `deadline`, in nanoseconds.
public(package) func __saw_exec_deadline_passed(deadline: UInt64) -> Bool {
    monotonic_now() >= deadline
}

// The offload job seams. `job` is the handle `__saw_rt_offload_start`
// returned, which the offloaded call's frame keeps until its take frees the
// job (runtime/ABI.md, "Blocking-extern offload").
extern "C" {
    func __saw_rt_offload_done(job: Int) -> Int
    func __saw_rt_offload_pipe_fd(job: Int) -> Int
}

/// The read end of offload job `job`'s completion pipe, which an offload park
/// arms through `__saw_exec_io_register` after it records its word.
public func __saw_exec_offload_pipe(job: Int) -> Int {
    // The registration is not withdrawn on a cancel exit: the take closes
    // this descriptor, which removes it from the reactor, before the task can
    // park again or its cell can be freed.
    __saw_rt_offload_pipe_fd(job)
}

/// Whether offload job `job`'s C call has returned, which an offload asks
/// before it parks and after every wake, so that only a finished job, or a
/// cancelled task, reaches the take that joins the job's thread.
public func __saw_exec_offload_done(job: Int) -> Bool {
    __saw_rt_offload_done(job) != 0
}

/// The process-wide group `Task.spawn` spawns into, built on the first call.
///
/// Panics if the group cannot be allocated.
public func __saw_exec_background() unsafe -> UnsafePointer<TaskGroup> {
    let current = BACKGROUND.load()
    if current != 0 {
        return current as UnsafePointer<TaskGroup>
    }
    let size = sizeof<TaskGroup>()
    let align = alignof<TaskGroup>()
    let raw = exec_alloc(size, align, "Task.spawn")
    let g = raw as UnsafePointer<TaskGroup>
    g[0] = TaskGroup()
    if BACKGROUND.compare_exchange(0, raw as Int) {
        return g
    }
    // A peer published first; nothing was enqueued into this one.
    drop_in_place(g)
    GlobalAllocator().dealloc(raw, size, align)
    BACKGROUND.load() as UnsafePointer<TaskGroup>
}

/// Closes the background group at `main`'s return: every live member is
/// cancelled, then joined, then released.
///
/// Cancel first, because a background task may loop until asked to stop;
/// join after, because a cancelled task still finishes through its own code,
/// which is where its values are destroyed. Does nothing when no task was
/// ever spawned into the group.
public func __saw_exec_close_background() unsafe {
    let addr = BACKGROUND.load()
    if addr == 0 {
        return
    }
    var g = addr as UnsafePointer<TaskGroup>
    // Stage 0 workaround (SL:hazards S15): canonical: g[0].cancel_every_live()
    cancel_every_live(&var g[0])
    exec_run(addr, -1, 0)
    // Stage 0 workaround (SL:hazards S15): canonical: g[0].release_slots()
    release_slots(&var g[0])
    // Stage 0 workaround (SL:hazards S15): canonical: g[0].unregister()
    unregister(&var g[0])
}

/// Runs a suspending `main` whose frame is at `frame`: its root and every task
/// it spawns are driven until `main` returns, and then the background group
/// is closed.
///
/// The frame is the caller's, and keeps `main`'s result where the frame's
/// descriptor says. This is the body of `std.task`'s `__saw_exec_run_main`,
/// the entry the compiler calls.
public func __saw_exec_drive_main(descriptor: UnsafePointer<FrameDescriptor>,
                                  frame: UnsafePointer<UInt8>) unsafe {
    var root = TaskGroup()
    let ticket = enqueue(&var root, descriptor, frame, false)
    let at = (&root) as UnsafePointer<TaskGroup> as Int
    exec_run(at, ticket.slot, ticket.generation)
    if not root.is_done(ticket.slot) {
        panic("executor: `main` cannot finish: every live task is waiting")
    }
    __saw_exec_close_background()
}

/// Runs the frame at `frame`, whose root `descriptor` describes, to its end
/// on this thread, leaving the root's result in the frame: the lowering of
/// the test driver `__saw_drive`, written at `site`, which then moves the
/// result out.
///
/// Panics if the frame parks on a wait the executor does not perform yet
/// (`drive_frame`).
public func __saw_exec_drive(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                             site: String) unsafe {
    drive_frame(descriptor, frame, &site)
}

/// Runs the frame at `frame` to its end as `__saw_exec_drive` does, then
/// destroys the root's result in place, and returns how many times the frame
/// reported `Pending`: the lowering of the test driver `__saw_drive_steps`,
/// written at `site`, whose result nobody takes.
///
/// Panics if the frame parks on a wait the executor does not perform yet
/// (`drive_frame`).
public func __saw_exec_drive_steps(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                                   site: String) unsafe -> Int {
    let steps = drive_frame(descriptor, frame, &site)
    let drop = descriptor[0].drop_result
    drop((frame as Int + descriptor[0].result_offset) as UnsafePointer<UInt8>)
    steps
}

// A drive point's loop (SL:coroutines §4, A4b and A11): the frame is resumed
// with a context of its own until its root returns, and each `Pending` is
// counted. A ready yield is resumed at once, so a drive point never cedes to
// the run queue for one. Any other park hands its wait to the shared sweep:
// other tasks run meanwhile, and the drive resumes once its own park wakes
// (t8). A wait the executor does not perform yet panics, naming the reason
// and the site, rather than spin, which would mask a lost wake.
func drive_frame(descriptor: UnsafePointer<FrameDescriptor>, frame: UnsafePointer<UInt8>,
                 site: &String) unsafe -> Int {
    var park = PARK_UNSET
    var cancel = false
    var context = TaskContext(park: (&park) as UnsafePointer<Int>, cancel: (&cancel) as UnsafePointer<Bool>,
                              task: frame as Int, deadline: 0)
    let cx = (&context) as UnsafePointer<TaskContext>
    let word = cx[0].park
    var steps = 0
    while resume_frame(descriptor, frame, cx) == Poll.Pending {
        steps = steps + 1
        let parked = word[0]
        if parked == PARK_UNSET {
            panic("{}: the driven frame reported Pending without recording a park", site)
        }
        if parked != PARK_READY {
            if not waits_on(parked) {
                refuse_park(&site, "the driven frame", parked)
            }
            sweep(0, -1, 0, cx as Int)
        }
        word[0] = PARK_UNSET
    }
    steps
}

/// A handle to a spawned task, carrying its result type `T`.
///
/// `group.spawn(f())` and `Task.spawn(f())` return one, a `Task<Void>` when
/// `f` returns nothing. `join` waits for the task and takes its result. A
/// handle from `Task.spawn` must be joined, detached or cancelled before it is
/// dropped; a handle from `group.spawn` may be dropped. Dropping a handle
/// gives its task's result up: the result is dropped when the task finishes,
/// or at once if it already has. A group destroyed while one of its handles
/// is neither joined nor dropped panics.
public struct Task<T> {
    private group: UnsafePointer<TaskGroup>
    private slot: Int
    private generation: Int
    private provenance: TaskProvenance
    // Whether `join`, `detach` or `cancel` has run, which the destructor of a
    // `Task.spawn` handle reads.
    private consumed: UnsafeMutableInterior<Bool>
    // Whether the handle let go of its task's result: `join` took it, or
    // `detach` or the drop gave it up. Until then the task's slot keeps the
    // result for this handle.
    private released: UnsafeMutableInterior<Bool>
}

extension Task<T> {
    // The compiler's spawn lowering: puts the frame at `frame`, its arguments
    // written, on `group`'s run queue, and hands back its handle.
    public static func __saw_spawn(group: UnsafePointer<TaskGroup>,
                                   descriptor: UnsafePointer<FrameDescriptor>,
                                   frame: UnsafePointer<UInt8>,
                                   provenance: TaskProvenance) unsafe -> Task<T> {
        if descriptor[0].result_size != sizeof<T>() {
            panic("Task.spawn: the frame's result is {} bytes, and the task's is {}",
                  descriptor[0].result_size, sizeof<T>())
        }
        var g = group
        // Stage 0 workaround (SL:hazards S15): canonical: group[0].enqueue(descriptor, frame, true)
        let ticket = enqueue(&var g[0], descriptor, frame, true)
        if provenance == TaskProvenance.Group {
            handle_minted(group)
        }
        Task<T>(group: group, slot: ticket.slot, generation: ticket.generation,
                provenance: provenance, consumed: UnsafeMutableInterior(false),
                released: UnsafeMutableInterior(false))
    }

    // Writes the handle's fate: `join`, `cancel` and `detach` each mark it,
    // and the drop of a `Task.spawn` handle panics without it.
    func consume(&self) unsafe {
        self.consumed.ptr()[0] = true
    }

    // Lets go of the task's result once, giving back a `group.spawn` handle's
    // count on its group (`handle_released`), and answers whether the handle
    // had let go already, so only the first of `join`, `detach` and the drop
    // acts on the slot.
    //
    // ENTRY POINTS:
    //   Task.join
    //   Task.detach
    //   Task.deinit
    func let_go(&self) unsafe -> Bool {
        if self.released.ptr()[0] {
            return true
        }
        self.released.ptr()[0] = true
        if self.provenance == TaskProvenance.Group {
            handle_released(self.group)
        }
        false
    }

    /// Waits for the task to finish and returns its result, moving it out of
    /// the task.
    ///
    /// On a cooperative group the scheduler runs on this thread meanwhile, so
    /// other tasks advance; on a pool, the pool is already running the task,
    /// so this thread only waits, and the pool keeps running afterwards. A
    /// task yields its result once, so joining a second time, or after
    /// `detach`, panics, a `Task<Void>` included.
    public func join(&self) unsafe -> T {
        self.consume()
        if self.let_go() {
            panic("Task.join: this task's result was already joined")
        }
        var g = self.group
        if g[0].lock == 0 {
            if g[0].stale(self.slot, self.generation) {
                panic("Task.join: this task's result was already joined")
            }
            exec_run(g as Int, self.slot, self.generation)
        } else {
            await_task(g, self.slot, self.generation)
        }
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            panic("Task.join: this task's result was already joined")
        }
        if not g[0].is_done(self.slot) {
            panic("Task.join: the task cannot finish while this join waits for it")
        }
        let cell = g[0].cell_at(self.slot)
        cell[0].holding = false
        let at = cell[0].result as UnsafePointer<T>
        let value = move at[0]
        // Stage 0 workaround (SL:hazards S15): canonical: g[0].recycle(self.slot)
        recycle(&var g[0], self.slot)
        unlock_queue(g)
        move value
    }

    /// Returns the address of this task's cancel word, as an `Int`, which is
    /// how another task cancels this one: a `Task` cannot cross a spawn, but
    /// the address can. The receiver cancels by writing through it,
    /// `(addr as UnsafePointer<Bool>)[0] = true`.
    ///
    /// The write wakes nothing: the task sees it at its next `cancelled()`
    /// check or the next time the executor looks at its park, which on a pool
    /// is within its poll cap. Use `cancel()` where the handle is at hand.
    /// Taking the address keeps the task's slot for the group's life, so a
    /// write landing after the task finished is defined and does nothing.
    /// Panics once the task's result was joined.
    public func cancel_addr(&self) unsafe -> Int {
        var g = self.group
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            panic("Task.cancel_addr: this task's result was already joined")
        }
        g[0].slots[self.slot].pinned = true
        let cell = g[0].cell_at(self.slot)
        unlock_queue(g)
        (&cell[0].cancel) as UnsafePointer<Bool> as Int
    }

    /// Asks the task to stop.
    ///
    /// Cancellation is cooperative: the task observes it through `cancelled()`
    /// and returns through its own code. A task parked in `sleep` or any other
    /// wait is woken to do so. Cancelling a finished task does nothing, and
    /// its result stays for a `join`.
    public func cancel(&self) unsafe {
        self.consume()
        let g = self.group
        lock_queue(g)
        if g[0].stale(self.slot, self.generation) {
            unlock_queue(g)
            return
        }
        request_cancel(g[0].cell_at(self.slot))
        unlock_queue(g)
        // A pool's worker may be waiting in the reactor's poll for this very
        // park; the cooperative engine reads the word at its next look.
        if g[0].lock != 0 {
            poke_reactor()
        }
    }

    /// Hands the task to the process and gives up its result.
    ///
    /// The task keeps running, and its result is dropped when it finishes.
    /// Panics on a `group.spawn` handle, whose task ends with its group.
    public func detach(&self) unsafe {
        if self.provenance == TaskProvenance.Group {
            panic("Task.detach: this handle came from `group.spawn`, and a group task's fate is its group's scope — drop the handle instead, or use `Task.spawn` for a detachable task")
        }
        self.consume()
        if self.let_go() {
            return
        }
        var g = self.group
        lock_queue(g)
        // Stage 0 workaround (SL:hazards S15): canonical: self.group[0].unclaim_slot(self.slot, self.generation)
        unclaim_slot(&var g[0], self.slot, self.generation)
        unlock_queue(g)
    }
}

extension Task<T>: NoCopy {
    /// Panics if a `Task.spawn` handle was neither joined, detached nor
    /// cancelled. A `group.spawn` handle drops silently.
    ///
    /// A handle that has not let go of its task's result gives it up here:
    /// the result is dropped now if the task has finished, or when it does.
    public func deinit(&var self) unsafe {
        if self.provenance == TaskProvenance.Singleton && not self.consumed.ptr()[0] {
            panic("Task was dropped without being joined, detached or cancelled — `join()` waits for it and takes its result, `detach()` hands it to the process, `cancel()` asks it to stop")
        }
        if self.let_go() {
            return
        }
        var g = self.group
        lock_queue(g)
        // Stage 0 workaround (SL:hazards S15): canonical: self.group[0].unclaim_slot(self.slot, self.generation)
        unclaim_slot(&var g[0], self.slot, self.generation)
        unlock_queue(g)
    }
}
