//! `Mutex<T>`: mutual exclusion for state several threads share.
//!
//! A mutex is two inline words beside its payload: the lock and its owner. It
//! allocates nothing, frees nothing, and needs no constructor to be valid:
//! zero means unlocked with no owner, so a `static` holds one with no
//! initializer at all.
//!
//! ```saw-fragment
//! import std.mutex.{Mutex}
//!
//! static REGISTRY: Mutex<Int>          // .bss: an idle mutex costs no bytes
//!
//! func record(n: Int) {
//!     borrow var total = REGISTRY.lock() { total = total + n }
//! }
//! ```
//!
//! The lock word is the runtime's: `os_unfair_lock` on macOS and a futex on
//! Linux, both zero when unlocked. A contended `lock` blocks the calling
//! thread, so prefer a `Channel` where a task would otherwise wait.

extern "C" {
    // Acquire and release one platform word, zero = unlocked (runtime/ABI.md).
    // The protocol is the runtime's, so std never knows which host it is on.
    func __saw_rt_lock_acquire(state: UnsafePointer<Int>)
    func __saw_rt_lock_release(state: UnsafePointer<Int>)
    // The calling thread's identity: nonzero, and distinct between any two
    // threads alive at once.
    func pthread_self() -> Int
}

/// A value guarded by a lock.
///
/// `lock()` lends the payload for a `borrow` window under the lock, and
/// releases it when the window closes. The window cannot suspend: a task can
/// resume on another worker, and the lock would then be released by a thread
/// that does not own it.
///
/// `NoCopy`: a copied mutex is two mutexes guarding two payloads. It is not
/// `NoMove`, since a move needs exclusive access and no thread can hold the
/// lock across one. It is `Sync` when `T` is `Send`, and a bare `static` of
/// one is legal when `T` is valid at zero.
///
/// Locking is not reentrant. A thread that takes a mutex it already holds,
/// through another name for it or from a task it runs inside the window,
/// panics rather than waiting for itself.
public struct Mutex<T> {
    private state: UnsafeMutableInterior<Int>,
    // The holding thread's identity, or zero. Only the holder writes its own
    // identity here, and it clears it before releasing, so a thread that
    // finds its own identity holds the lock.
    private owner: Atomic<Int>,
    private value: UnsafeMutableInterior<T>
}

// The lock serializes every access, so no two threads ever hold the payload
// at once.
extension Mutex<T: Send>: UnsafeSync {}

// Zero is an unlocked word with no owner over a zeroed payload.
extension Mutex<T: ZeroInit>: ZeroInit {}

// No hand-written `deinit`: the word owns no OS resource and no block.
extension Mutex<T>: NoCopy {}

extension Mutex<T> {
    /// Wraps `value` behind a fresh unlocked mutex.
    ///
    /// Allocates nothing, so it cannot fail. A `static` does not need this:
    /// declare it without an initializer and the zero pattern is already an
    /// unlocked mutex over a zeroed payload.
    public init(value: T) unsafe -> Mutex<T> {
        Mutex<T>(state: UnsafeMutableInterior(0), owner: Atomic(0), value: UnsafeMutableInterior(move value))
    }

    /// Blocks until the lock is free, then lends the payload for the window.
    ///
    /// The lock is released when the window closes, on every way out. A
    /// contended lock blocks the calling thread, a task's thread included,
    /// and runs none of its other tasks meanwhile. That wait always ends: the
    /// window cannot suspend, so the holder is a thread or a task inside a
    /// window that runs to its end without ceding, and never a suspended task
    /// waiting on the blocked thread's tasks. Panics when the calling thread
    /// already holds the lock.
    public func lock(&self) unsafe sync borrows(sync) -> &var T {
        let caller = pthread_self()
        if self.owner.load() == caller {
            panic("Mutex.lock: this thread already holds the lock — a lock is not reentrant, and it was reached again through another name or by a task run inside its window")
        }
        self.acquire(caller)
        lend self.value.ptr()[0]
        self.release()
    }

    // The caller checks the owner first, with a message of its own: a thread
    // waiting for a lock it holds would never wake. The message is a literal so
    // that the panic path allocates nothing.
    func acquire(&self, caller: Int) unsafe sync {
        __saw_rt_lock_acquire(self.state.ptr())
        self.owner.store(caller)
    }

    func release(&self) unsafe sync {
        self.owner.store(0)
        __saw_rt_lock_release(self.state.ptr())
    }
}

extension Mutex<T: ExplicitCopy> {
    /// Returns a copy of the payload, read under the lock.
    ///
    /// Panics when the calling thread already holds the lock.
    public func get(&self) unsafe -> T {
        let caller = pthread_self()
        if self.owner.load() == caller {
            panic("Mutex.get: this thread already holds the lock — a lock is not reentrant, and it was reached again through another name or by a task run inside its window")
        }
        self.acquire(caller)
        let snapshot = self.value.ptr()[0].copy()
        self.release()
        move snapshot
    }
}
