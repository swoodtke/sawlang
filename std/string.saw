//! `String`: immutable, reference-counted UTF-8 text.
//!
//! A `String` value is one pointer, to the bytes of a heap block laid out as
//! `{ refcount, len, bytes, NUL }`, with the two header words at negative
//! offsets. The bytes are NUL-terminated, so the pointer is a C string as it
//! stands, and `len` is authoritative: an interior NUL is counted. A block is
//! never written after it is built.
//!
//! Copying a `String` retains its block and the last drop releases it. The
//! refcount is atomic: a retain adds with relaxed ordering, a release
//! subtracts with release ordering, and the release that reaches zero issues
//! an acquire fence before it frees the block. A string literal is a static
//! block whose refcount is `-1`. That count is read with a relaxed atomic load
//! before any atomic read-modify-write, so a literal is never retained,
//! released or written, and a literal costs no allocation.

import std.mem.{copy_bytes}

// The String layer's blocks go straight to the runtime's allocation seams, as
// Stage 0's synthesized helpers do, so a program whose only Strings are
// literals reaches no allocator type.
extern "C" {
    func __saw_rt_alloc(size: Int, align: Int) -> UnsafePointer<Int8>?
    func __saw_rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int)
}

// The header's two words sit just below the bytes: the refcount, then the
// length.
static REFCOUNT_SLOT: Int = -2
static LENGTH_SLOT: Int = -1
static HEADER_WORDS: Int = 2
// A literal's refcount. A block holding it is static and may be read-only.
static IMMORTAL: Int = -1
static BLOCK_ALIGN: Int = 16
static NUL: Int8 = 0

/// Immutable UTF-8 text, shared by reference count.
///
/// Copying a `String` is a refcount increment, and a literal is free to copy.
public struct String {
    private bytes: UnsafePointer<Int8>
}

// The literal role: a literal's static block, its refcount IMMORTAL, as a
// String. The compiler emits the block and calls this through the lang-item
// table; nothing allocates.
func string_literal(bytes: UnsafePointer<Int8>) unsafe -> String {
    String(bytes: bytes)
}

// The bytes role: where a format argument's or a message's bytes are read.
func string_bytes(text: &String) unsafe -> UnsafePointer<Int8> {
    text.bytes
}

// The length role: how many of those bytes there are, read from the header,
// so an interior NUL is printed rather than ending the text.
func string_length(text: &String) unsafe -> Int {
    text.len()
}

// The equality role: what `==`, `!=` and a string-literal pattern compare
// with, byte for byte. The bytes are read in range of both lengths, so no
// bounds check, and no panic path, is reached from a comparison.
func string_equals(left: &String, right: &String) unsafe -> Bool {
    let n = left.len()
    if n != right.len() {
        return false
    }
    var i = 0
    while i < n {
        if left.bytes[i] != right.bytes[i] {
            return false
        }
        i = i + 1
    }
    true
}

// The ordering role: what `<`, `<=`, `>` and `>=` compare with. Bytes are
// unsigned, so this is code-point order for UTF-8, and a proper prefix is
// `Less`.
func string_compare(left: &String, right: &String) unsafe -> Ordering {
    let left_len = left.len()
    let right_len = right.len()
    let shorter = if left_len < right_len { left_len } else { right_len }
    var i = 0
    while i < shorter {
        let a = UInt8.from(truncating: left.bytes[i]) as Int
        let b = UInt8.from(truncating: right.bytes[i]) as Int
        if a < b {
            return Ordering.Less
        }
        if a > b {
            return Ordering.Greater
        }
        i = i + 1
    }
    if left_len < right_len {
        return Ordering.Less
    }
    if left_len > right_len {
        return Ordering.Greater
    }
    Ordering.Equal
}

/// Returns a new `String` holding a copy of the `count` bytes at `source`.
///
/// Panics if the allocation is refused: every String producer returns a plain
/// `String`, so the String layer has no error channel for it.
public(package) func string_from_bytes(source: UnsafePointer<Int8>, count: Int) unsafe -> String {
    let header_bytes = HEADER_WORDS * sizeof<Int>()
    let total = header_bytes + count + 1
    guard let block = __saw_rt_alloc(total, BLOCK_ALIGN) else {
        panic("String: allocation of {} bytes (align {}) failed", total, BLOCK_ALIGN)
    }
    let words = block as UnsafePointer<Int>
    words[0] = 1
    words[1] = count
    let bytes = (&block[header_bytes]) as UnsafePointer<Int8>
    var i = 0
    while i < count {
        bytes[i] = source[i]
        i = i + 1
    }
    bytes[count] = NUL
    String(bytes: bytes)
}

// A scratch byte buffer of `count` (> 0) bytes, for a producer that builds a
// String's bytes before `string_from_scratch` copies them into a block.
func scratch_buffer(count: Int) unsafe -> UnsafePointer<Int8> {
    guard let block = __saw_rt_alloc(count, 1) else {
        panic("String: allocation of {} bytes (align {}) failed", count, 1)
    }
    block
}

// The String holding the first `count` scratch bytes; frees the scratch.
func string_from_scratch(scratch: UnsafePointer<Int8>, count: Int) unsafe -> String {
    let result = string_from_bytes(scratch, count)
    __saw_rt_dealloc(scratch, count, 1)
    result
}

// Copies `count` bytes of `source` from `from` into `target` at `at`; returns
// the offset after them.
func copy_into_scratch(target: UnsafePointer<Int8>, at: Int, source: UnsafePointer<Int8>, from: Int, count: Int) unsafe -> Int {
    copy_bytes((&source[from]) as UnsafePointer<Int8>, (&target[at]) as UnsafePointer<Int8>, count)
    at + count
}

extension String {
    /// Returns the number of bytes, read from the header.
    public func len(&self) unsafe -> Int {
        let words = self.bytes as UnsafePointer<Int>
        words[LENGTH_SLOT]
    }

    // The bytes, NUL-terminated as they stand, so a C string while this
    // `String` is alive. An interior NUL ends the C string early; a caller
    // handing it to the system checks for one first.
    public(package) func c_bytes(&self) unsafe -> UnsafePointer<Int8> {
        self.bytes
    }

    /// Returns whether the string holds no bytes.
    public func is_empty(&self) -> Bool {
        self.len() == 0
    }

    /// Returns the byte at `index`. Panics if `index` is outside `0..<len()`.
    public func byte_at(&self, index: Int) unsafe -> Byte {
        if index < 0 || index >= self.len() {
            panic("String.byte_at: index out of range: {} (len {})", index, self.len())
        }
        Byte(UInt8.from(truncating: self.bytes[index]))
    }

    // The iterator holds its own retain on the String, so
    // `for b in make_string().bytes()` keeps the bytes alive for the whole loop.
    /// Returns an iterator over the string's bytes, in order.
    public func bytes(&self) -> StringBytes {
        StringBytes(s: self, index: 0, length: self.len())
    }

    // A String always holds valid UTF-8, so a decode error is unreachable; on a
    // buffer corrupted by unsafe code the iterator stops (`StringScalars.next`).
    /// Returns an iterator over the Unicode scalar values the string's UTF-8
    /// encodes, in order.
    public func scalars(&self) -> StringScalars {
        StringScalars(s: self, index: 0, length: self.len())
    }

    // Decodes the UTF-8 sequence starting at byte `at` (`len` is the string's
    // length) into `(scalar, width)`: width 1 to 4 and the scalar's value, or
    // width 0 for a malformed sequence (an invalid lead, a bad or short
    // continuation, an overlong form, a surrogate, or past U+10FFFF). Scalar
    // assembly multiplies by 64, 4096 and 262144 for the 6-, 12- and 18-bit
    // shifts.
    func decode_at(&self, at: Int, len: Int) -> (Int, Int) {
        let b0 = self.byte_at(at) as Int
        if b0 < 128 {
            // 0x00..0x7F: ASCII.
            return (b0, 1)
        }
        if b0 < 194 {
            // 0x80..0xBF: a continuation byte cannot lead. 0xC0/0xC1 (192/193)
            // could only ever encode an overlong ASCII byte.
            return (0, 0)
        }
        if b0 < 224 {
            // 0xC2..0xDF: two-byte sequence.
            if at + 1 >= len {
                return (0, 0)
            }
            let b1 = self.byte_at(at + 1) as Int
            if b1 < 128 || b1 > 191 {
                return (0, 0)
            }
            return ((b0 - 192) * 64 + (b1 - 128), 2)
        }
        if b0 < 240 {
            // 0xE0..0xEF: three-byte sequence. The first continuation's bounds
            // tighten to forbid an overlong form (0xE0) and the UTF-16
            // surrogates D800..DFFF (0xED).
            if at + 2 >= len {
                return (0, 0)
            }
            let b1 = self.byte_at(at + 1) as Int
            var lo = 128
            var hi = 191
            if b0 == 224 {
                lo = 160
            }
            if b0 == 237 {
                hi = 159
            }
            if b1 < lo || b1 > hi {
                return (0, 0)
            }
            let b2 = self.byte_at(at + 2) as Int
            if b2 < 128 || b2 > 191 {
                return (0, 0)
            }
            return ((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128), 3)
        }
        if b0 < 245 {
            // 0xF0..0xF4: four-byte sequence. The first continuation's bounds
            // tighten to forbid an overlong form (0xF0) and anything past
            // U+10FFFF (0xF4).
            if at + 3 >= len {
                return (0, 0)
            }
            let b1 = self.byte_at(at + 1) as Int
            var lo = 128
            var hi = 191
            if b0 == 240 {
                lo = 144
            }
            if b0 == 244 {
                hi = 143
            }
            if b1 < lo || b1 > hi {
                return (0, 0)
            }
            let b2 = self.byte_at(at + 2) as Int
            if b2 < 128 || b2 > 191 {
                return (0, 0)
            }
            let b3 = self.byte_at(at + 3) as Int
            if b3 < 128 || b3 > 191 {
                return (0, 0)
            }
            return ((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128), 4)
        }
        // 0xF5..0xFF: no lead byte here encodes a scalar at or below U+10FFFF.
        return (0, 0)
    }

    /// Returns whether the string begins with the bytes of `prefix`.
    public func starts_with(&self, prefix: String) -> Bool {
        let n = prefix.len()
        if n > self.len() {
            return false
        }
        var i = 0
        while i < n {
            if self.byte_at(i) != prefix.byte_at(i) {
                return false
            }
            i = i + 1
        }
        true
    }

    /// Returns whether the string ends with the bytes of `suffix`.
    public func ends_with(&self, suffix: String) -> Bool {
        let n = suffix.len()
        let offset = self.len() - n
        if offset < 0 {
            return false
        }
        var i = 0
        while i < n {
            if self.byte_at(offset + i) != suffix.byte_at(i) {
                return false
            }
            i = i + 1
        }
        true
    }

    /// Returns whether `needle` occurs anywhere in the string. The empty
    /// string occurs in every string.
    public func contains(&self, needle: String) -> Bool {
        self.find(&needle, 0) >= 0
    }

    // The offset of the first occurrence of `needle` at or after `from`, or
    // -1. A needle longer than the rest of the string never matches.
    func find(&self, needle: &String, from: Int) -> Int {
        let n = needle.len()
        let last = self.len() - n
        var i = from
        while i <= last {
            var j = 0
            while j < n && self.byte_at(i + j) == needle.byte_at(j) {
                j = j + 1
            }
            if j == n {
                return i
            }
            i = i + 1
        }
        return -1
    }

    /// Returns the string without its leading whitespace (space, tab,
    /// newline, carriage return).
    public func trim_start(&self) -> String {
        let n = self.len()
        var start = 0
        while start < n && is_whitespace_byte(self.byte_at(start)) {
            start = start + 1
        }
        if start == 0 {
            return self
        }
        self.substring(start, n)
    }

    /// Returns the string without its trailing whitespace (space, tab,
    /// newline, carriage return).
    public func trim_end(&self) -> String {
        let n = self.len()
        var end = n
        while end > 0 && is_whitespace_byte(self.byte_at(end - 1)) {
            end = end - 1
        }
        if end == n {
            return self
        }
        self.substring(0, end)
    }

    /// Returns the string without leading or trailing whitespace.
    public func trim(&self) -> String {
        self.trim_start().trim_end()
    }

    /// Returns the offset of the first byte equal to `b`, or `None`. A `Byte`
    /// and an integer literal both pass as `b` (`index_of(47)`).
    public func index_of(&self, b: UInt8) -> Int? {
        let n = self.len()
        var i = 0
        while i < n {
            if self.byte_at(i) == b {
                return i
            }
            i = i + 1
        }
        None
    }

    /// Returns the offset of the last byte equal to `b`, or `None`.
    public func last_index_of(&self, b: UInt8) -> Int? {
        var i = self.len() - 1
        while i >= 0 {
            if self.byte_at(i) == b {
                return i
            }
            i = i - 1
        }
        None
    }

    /// Splits the string on every occurrence of `separator`.
    ///
    /// Adjacent separators yield empty pieces, and a string with no separator
    /// (or an empty `separator`, or an empty string) is a one-element vector
    /// holding the whole string. Returns `Err(AllocError)` when the vector's
    /// buffer is refused.
    public func split(&self, separator: String) -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let n = self.len()
        let sep_len = separator.len()
        if sep_len == 0 || n == 0 {
            try result.push(self)
            return move result
        }
        var start = 0
        var at = self.find(&separator, 0)
        while at >= 0 {
            try result.push(self.substring(start, at))
            start = at + sep_len
            at = self.find(&separator, start)
        }
        try result.push(self.substring(start, n))
        return move result
    }

    /// Returns the bytes in `start..<end` as a new `String`.
    ///
    /// Panics if the range is reversed or reaches outside `0..len()`. An empty
    /// range is legal and yields `""`.
    public func substring(&self, start: Int, end: Int) -> String {
        let n = self.len()
        if start < 0 || end > n || start > end {
            panic("String.substring: range out of range: {}..{} (len {})", start, end, n)
        }
        if start == end {
            return ""
        }
        self.copy_range(start, end - start)
    }

    // A new String of the `count` bytes from `start`, which the caller has
    // bounds-checked.
    func copy_range(&self, start: Int, count: Int) unsafe -> String {
        string_from_bytes((&self.bytes[start]) as UnsafePointer<Int8>, count)
    }

    /// Returns the string with each ASCII letter in uppercase.
    ///
    /// Bytes outside `a`-`z`, including every byte of a multi-byte character,
    /// are kept as they are.
    public func to_uppercase(&self) unsafe -> String {
        self.map_ascii_case(97, 122, -32)
    }

    /// Returns the string with each ASCII letter in lowercase.
    ///
    /// Bytes outside `A`-`Z`, including every byte of a multi-byte character,
    /// are kept as they are.
    public func to_lowercase(&self) unsafe -> String {
        self.map_ascii_case(65, 90, 32)
    }

    // Copies the string, adding `delta` to each byte in `low...high`. The
    // bytes are signed, so a non-ASCII byte is negative and never in range.
    func map_ascii_case(&self, low: Int8, high: Int8, delta: Int8) unsafe -> String {
        let n = self.len()
        if n == 0 {
            return ""
        }
        let scratch = scratch_buffer(n)
        var i = 0
        while i < n {
            let c = self.bytes[i]
            if c >= low && c <= high {
                scratch[i] = c + delta
            } else {
                scratch[i] = c
            }
            i = i + 1
        }
        return string_from_scratch(scratch, n)
    }

    /// Returns the string with every non-overlapping occurrence of `old`
    /// replaced by `new`, scanning left to right.
    ///
    /// An empty `old` or an empty string replaces nothing, so the result is
    /// the string itself.
    public func replace(&self, old: String, new: String) unsafe -> String {
        let n = self.len()
        let old_len = old.len()
        let new_len = new.len()
        if old_len == 0 || n == 0 {
            return self
        }
        var count = 0
        var at = self.find(&old, 0)
        while at >= 0 {
            count = count + 1
            at = self.find(&old, at + old_len)
        }
        if count == 0 {
            return self
        }
        let total = n - count * old_len + count * new_len
        if total == 0 {
            return ""
        }
        let scratch = scratch_buffer(total)
        var out = 0
        var start = 0
        at = self.find(&old, 0)
        while at >= 0 {
            out = copy_into_scratch(scratch, out, self.bytes, start, at - start)
            out = copy_into_scratch(scratch, out, new.bytes, 0, new_len)
            start = at + old_len
            at = self.find(&old, start)
        }
        out = copy_into_scratch(scratch, out, self.bytes, start, n - start)
        return string_from_scratch(scratch, total)
    }

    /// Returns whether the two strings hold the same bytes, as `==` answers.
    public func equals(&self, other: String) -> Bool {
        string_equals(&self, &other)
    }

    /// Compares the two strings byte by byte, as the ordering operators do.
    public func compare(&self, other: String) -> Ordering {
        string_compare(&self, &other)
    }

    /// Parses the whole string as a signed decimal, or `None`.
    ///
    /// Nothing is trimmed: an empty string, any byte other than an optional
    /// leading `+` or `-` and digits, and a value outside `Int.min...Int.max`
    /// are all `None`.
    public func to_int(&self) -> Int? {
        self.parse_signed(10)
    }

    /// Parses the whole string as a signed number in `radix` (2 to 36), or
    /// `None`, on the terms of `to_int()`. No `0x` or `0b` prefix is read.
    public func to_int(&self, radix: Int) -> Int? {
        if radix < 2 || radix > 36 {
            return None
        }
        self.parse_signed(radix)
    }

    // The digits accumulate as a non-positive magnitude, because two's
    // complement has one more negative value than positive: `Int.min` parses
    // without an overflowing intermediate.
    func parse_signed(&self, radix: Int) -> Int? {
        let n = self.len()
        if n == 0 {
            return None
        }
        var i = 0
        var negative = false
        let first = self.byte_at(0) as Int
        if first == MINUS_BYTE {
            negative = true
            i = 1
        } else if first == PLUS_BYTE {
            i = 1
        }
        if i >= n {
            return None
        }
        var acc = 0
        while i < n {
            let d = digit_value(self.byte_at(i) as Int)
            if d < 0 || d >= radix {
                return None
            }
            let m = acc &* radix
            if acc != 0 && m / radix != acc {
                return None
            }
            let next = m &- d
            if next > m {
                return None
            }
            acc = next
            i = i + 1
        }
        if negative {
            return acc
        }
        let positive = 0 &- acc
        if positive < 0 {
            return None
        }
        positive
    }

    /// Parses the whole string as an unsigned decimal, or `None`.
    ///
    /// Nothing is trimmed: an empty string, a leading `-`, any other byte than
    /// an optional leading `+` and digits, and a value above `UInt.max` are
    /// all `None`.
    public func to_uint(&self) -> UInt? {
        self.parse_unsigned(10)
    }

    /// Parses the whole string as an unsigned number in `radix` (2 to 36), or
    /// `None`, on the terms of `to_uint()`. No `0x` or `0b` prefix is read.
    public func to_uint(&self, radix: Int) -> UInt? {
        if radix < 2 || radix > 36 {
            return None
        }
        self.parse_unsigned(radix)
    }

    // The digits accumulate with wrapping arithmetic, and a divide-back and a
    // carry test catch an overflow past `UInt.max`.
    func parse_unsigned(&self, radix: Int) -> UInt? {
        let n = self.len()
        if n == 0 {
            return None
        }
        var i = 0
        let first = self.byte_at(0) as Int
        if first == PLUS_BYTE {
            i = 1
        } else if first == MINUS_BYTE {
            return None
        }
        if i >= n {
            return None
        }
        let r = radix as UInt
        var acc: UInt = 0
        while i < n {
            let d = digit_value(self.byte_at(i) as Int)
            if d < 0 || d >= radix {
                return None
            }
            let m = acc &* r
            if acc != (0 as UInt) && m / r != acc {
                return None
            }
            let next = m &+ (d as UInt)
            if next < m {
                return None
            }
            acc = next
            i = i + 1
        }
        acc
    }
}

static PLUS_BYTE: Int = 43
static MINUS_BYTE: Int = 45
static DIGIT_ZERO: Int = 48
static DIGIT_NINE: Int = 57
static LOWER_A: Int = 97
static LOWER_Z: Int = 122
static UPPER_A: Int = 65
static UPPER_Z: Int = 90
static FIRST_LETTER_DIGIT: Int = 10

// Space, tab, newline, carriage return.
func is_whitespace_byte(b: Byte) -> Bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

// The value of an ASCII digit byte in a radix up to 36, or -1.
func digit_value(b: Int) -> Int {
    if b >= DIGIT_ZERO && b <= DIGIT_NINE {
        b - DIGIT_ZERO
    } else if b >= LOWER_A && b <= LOWER_Z {
        b - LOWER_A + FIRST_LETTER_DIGIT
    } else if b >= UPPER_A && b <= UPPER_Z {
        b - UPPER_A + FIRST_LETTER_DIGIT
    } else {
        -1
    }
}

/// Strings copy by reference count.
extension String: Copy {
    /// Retains the block and returns a second reference to it.
    ///
    /// A literal's block is immortal: its count is read with a relaxed atomic
    /// load and never written.
    public func copy(&self) unsafe -> String {
        let words = self.bytes as UnsafePointer<Int>
        let count = (&words[REFCOUNT_SLOT]) as UnsafePointer<Int>
        if __saw_atomic_load_i64_relaxed(count) != IMMORTAL {
            let _ = __saw_atomic_add_i64(count, 1)
        }
        String(bytes: self.bytes)
    }

    /// Releases the block, freeing it when this was the last reference.
    public func deinit(&var self) unsafe {
        let words = self.bytes as UnsafePointer<Int>
        let count = (&words[REFCOUNT_SLOT]) as UnsafePointer<Int>
        // Another thread's retain may race this read, so it is atomic
        // (SL:open-questions D24).
        if __saw_atomic_load_i64_relaxed(count) == IMMORTAL {
            return
        }
        let old = __saw_atomic_sub_i64_release(count, 1)
        if old < 1 {
            panic("String: over-release of a String reference (refcount underflow)")
        }
        if old == 1 {
            __saw_atomic_fence_acquire()
            let header_bytes = HEADER_WORDS * sizeof<Int>()
            let block = count as UnsafePointer<Int8>
            __saw_rt_dealloc(block, header_bytes + words[LENGTH_SLOT] + 1, BLOCK_ALIGN)
        }
    }
}

/// Strings compare byte by byte.
extension String: Equatable {
    /// Returns whether the two strings hold the same bytes.
    public func equals(&self, other: &String) -> Bool {
        string_equals(&self, &other)
    }
}

/// Strings order byte by byte, which is code-point order for UTF-8.
extension String: Comparable {
    /// Compares the two strings byte by byte; a proper prefix is `Less`.
    public func compare(&self, other: &String) -> Ordering {
        string_compare(&self, &other)
    }
}

/// Strings hash their bytes, which is what `==` compares.
extension String: Hashable {
    /// Feeds each byte into `h`, in order, with no length prefix.
    public func hash(&self, h: &var Hasher) {
        let n = self.len()
        var i = 0
        while i < n {
            h.write_int(self.byte_at(i) as Int)
            i = i + 1
        }
    }
}

/// A string renders as its own bytes.
extension String: Printable {
    /// Appends the string's bytes to `into`.
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self)
    }
}

// Both iterators hold the source String by value: String is Copy, so the
// field retains it and the synthesized deinit releases it. That retain keeps a
// temporary receiver's bytes alive across every `next()` in
// `for c in make_string().scalars()`.
/// The iterator `String.bytes()` returns: each byte of the string, in order.
public struct StringBytes {
    private s: String
    private index: Int
    private length: Int
}

extension StringBytes: Iterator {
    type Item = Byte

    /// Returns the next byte, or `None` past the last one.
    public func next(&var self) -> Byte? {
        if self.index < self.length {
            let at = self.index
            let b = self.s.byte_at(at)
            self.index = at + 1
            b
        } else {
            None
        }
    }
}

/// The iterator `String.scalars()` returns: each Unicode scalar value the
/// string's UTF-8 encodes, in order.
public struct StringScalars {
    private s: String
    private index: Int
    private length: Int
}

extension StringScalars: Iterator {
    type Item = Scalar

    /// Returns the next scalar, or `None` past the last one.
    public func next(&var self) -> Scalar? {
        if self.index >= self.length {
            return None
        }
        let at = self.index
        let length = self.length
        let d = self.s.decode_at(at, length)
        if d.1 == 0 {
            // Malformed: unreachable for a String, which always holds valid
            // UTF-8. On a buffer unsafe code corrupted, stop rather than loop
            // or trap.
            self.index = length
            return None
        }
        self.index = at + d.1
        // `decode_at` rejects surrogates and anything past U+10FFFF, so this
        // construction cannot fail.
        try! Scalar(value: d.0)
    }
}

// The block is immutable and its count atomic, so a String may cross threads
// and be shared between them; the pointer field alone blocks the derivation.
extension String: UnsafeSend {}
extension String: UnsafeSync {}

/// The error a decode reports when bytes are not UTF-8.
///
/// `offset` is the byte index at which the first malformed sequence begins;
/// the bytes before it decode cleanly. It renders as
/// `invalid UTF-8 at byte offset 6`.
public struct Utf8Error {
    /// Byte index of the first malformed sequence.
    offset: Int
}

extension Utf8Error: Error {
    /// Writes the offset of the first malformed sequence.
    public func format(&self, into: &var StringBuilder) {
        try! into.append("invalid UTF-8 at byte offset ")
        try! into.append(self.offset)
    }
}
