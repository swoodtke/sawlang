//! `String`: immutable, reference-counted UTF-8 text.
//!
//! A `String` value is one pointer, to the bytes of a heap block laid out as
//! `{ refcount, len, bytes, NUL }`, with the two header words at negative
//! offsets. The bytes are NUL-terminated, so the pointer is a C string as it
//! stands, and `len` is authoritative: an interior NUL is counted. A block is
//! never written after it is built.
//!
//! Copying a `String` retains its block and the last drop releases it. The
//! refcount is atomic: a retain adds with relaxed ordering, a release
//! subtracts with release ordering, and the release that reaches zero issues
//! an acquire fence before it frees the block. A string literal is a static
//! block whose refcount is `-1`. That count is read with a plain load before
//! any atomic operation, so a literal is never retained, released or written,
//! and a literal costs no allocation.

// The String layer's blocks go straight to the runtime's allocation seams, as
// Stage 0's synthesized helpers do, so a program whose only Strings are
// literals reaches no allocator type.
extern "C" {
    func __saw_rt_alloc(size: Int, align: Int) -> UnsafePointer<Int8>?
    func __saw_rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int)
}

// The header's two words sit just below the bytes: the refcount, then the
// length.
static REFCOUNT_SLOT: Int = -2
static LENGTH_SLOT: Int = -1
static HEADER_WORDS: Int = 2
// A literal's refcount. A block holding it is static and may be read-only.
static IMMORTAL: Int = -1
static BLOCK_ALIGN: Int = 16
static NUL: Int8 = 0

/// Immutable UTF-8 text, shared by reference count.
///
/// Copying a `String` is a refcount increment, and a literal is free to copy.
public struct String {
    private bytes: UnsafePointer<Int8>
}

// The literal role: a literal's static block, its refcount IMMORTAL, as a
// String. The compiler emits the block and calls this through the lang-item
// table; nothing allocates.
func string_literal(bytes: UnsafePointer<Int8>) unsafe -> String {
    String(bytes: bytes)
}

// The bytes role: where a format argument's or a message's bytes are read.
func string_bytes(text: &String) unsafe -> UnsafePointer<Int8> {
    text.bytes
}

// The equality role: what `==`, `!=` and a string-literal pattern compare
// with, byte for byte. The bytes are read in range of both lengths, so no
// bounds check, and no panic path, is reached from a comparison.
func string_equals(left: &String, right: &String) unsafe -> Bool {
    let n = left.len()
    if n != right.len() {
        return false
    }
    var i = 0
    while i < n {
        if left.bytes[i] != right.bytes[i] {
            return false
        }
        i = i + 1
    }
    true
}

// The ordering role: what `<`, `<=`, `>` and `>=` compare with. Bytes are
// unsigned, so this is code-point order for UTF-8, and a proper prefix is
// `Less`.
func string_compare(left: &String, right: &String) unsafe -> Ordering {
    let left_len = left.len()
    let right_len = right.len()
    let shorter = if left_len < right_len { left_len } else { right_len }
    var i = 0
    while i < shorter {
        let a = UInt8.from(truncating: left.bytes[i]) as Int
        let b = UInt8.from(truncating: right.bytes[i]) as Int
        if a < b {
            return Ordering.Less
        }
        if a > b {
            return Ordering.Greater
        }
        i = i + 1
    }
    if left_len < right_len {
        return Ordering.Less
    }
    if left_len > right_len {
        return Ordering.Greater
    }
    Ordering.Equal
}

/// Returns a new `String` holding a copy of the `count` bytes at `source`.
///
/// Panics if the allocation is refused: every String producer returns a plain
/// `String`, so the String layer has no error channel for it.
public(package) func string_from_bytes(source: UnsafePointer<Int8>, count: Int) unsafe -> String {
    let header_bytes = HEADER_WORDS * sizeof<Int>()
    let total = header_bytes + count + 1
    guard let block = __saw_rt_alloc(total, BLOCK_ALIGN) else {
        panic("String: allocation of {} bytes (align {}) failed", total, BLOCK_ALIGN)
    }
    let words = block as UnsafePointer<Int>
    words[0] = 1
    words[1] = count
    let bytes = (&block[header_bytes]) as UnsafePointer<Int8>
    var i = 0
    while i < count {
        bytes[i] = source[i]
        i = i + 1
    }
    bytes[count] = NUL
    String(bytes: bytes)
}

extension String {
    /// Returns the number of bytes, read from the header.
    public func len(&self) unsafe -> Int {
        let words = self.bytes as UnsafePointer<Int>
        words[LENGTH_SLOT]
    }

    /// Returns whether the string holds no bytes.
    public func is_empty(&self) -> Bool {
        self.len() == 0
    }

    /// Returns the byte at `index`. Panics if `index` is outside `0..<len()`.
    public func byte_at(&self, index: Int) unsafe -> Byte {
        if index < 0 || index >= self.len() {
            panic("String.byte_at: index out of range: {} (len {})", index, self.len())
        }
        Byte(UInt8.from(truncating: self.bytes[index]))
    }

    /// Returns whether the string begins with the bytes of `prefix`.
    public func starts_with(&self, prefix: String) -> Bool {
        let n = prefix.len()
        if n > self.len() {
            return false
        }
        var i = 0
        while i < n {
            if self.byte_at(i) != prefix.byte_at(i) {
                return false
            }
            i = i + 1
        }
        true
    }

    /// Returns the bytes in `start..<end` as a new `String`.
    ///
    /// Panics if the range is reversed or reaches outside `0..len()`. An empty
    /// range is legal and yields `""`.
    public func substring(&self, start: Int, end: Int) -> String {
        let n = self.len()
        if start < 0 || end > n || start > end {
            panic("String.substring: range out of range: {}..{} (len {})", start, end, n)
        }
        if start == end {
            return ""
        }
        self.copy_range(start, end - start)
    }

    // A new String of the `count` bytes from `start`, which the caller has
    // bounds-checked.
    func copy_range(&self, start: Int, count: Int) unsafe -> String {
        string_from_bytes((&self.bytes[start]) as UnsafePointer<Int8>, count)
    }

    /// Returns whether the two strings hold the same bytes, as `==` answers.
    public func equals(&self, other: String) -> Bool {
        string_equals(&self, &other)
    }

    /// Compares the two strings byte by byte, as the ordering operators do.
    public func compare(&self, other: String) -> Ordering {
        string_compare(&self, &other)
    }

    /// Parses the whole string as an unsigned decimal, or `None`.
    ///
    /// Nothing is trimmed: an empty string, a leading `-`, any other byte than
    /// an optional leading `+` and digits, and a value above `UInt.max` are
    /// all `None`.
    public func to_uint(&self) -> UInt? {
        self.parse_unsigned(10)
    }

    /// Parses the whole string as an unsigned number in `radix` (2 to 36), or
    /// `None`, on the terms of `to_uint()`. No `0x` or `0b` prefix is read.
    public func to_uint(&self, radix: Int) -> UInt? {
        if radix < 2 || radix > 36 {
            return None
        }
        self.parse_unsigned(radix)
    }

    // The digits accumulate with wrapping arithmetic, and a divide-back and a
    // carry test catch an overflow past `UInt.max`.
    func parse_unsigned(&self, radix: Int) -> UInt? {
        let n = self.len()
        if n == 0 {
            return None
        }
        var i = 0
        let first = self.byte_at(0) as Int
        if first == PLUS_BYTE {
            i = 1
        } else if first == MINUS_BYTE {
            return None
        }
        if i >= n {
            return None
        }
        let r = radix as UInt
        var acc: UInt = 0
        while i < n {
            let d = digit_value(self.byte_at(i) as Int)
            if d < 0 || d >= radix {
                return None
            }
            let m = acc &* r
            if acc != (0 as UInt) && m / r != acc {
                return None
            }
            let next = m &+ (d as UInt)
            if next < m {
                return None
            }
            acc = next
            i = i + 1
        }
        acc
    }
}

static PLUS_BYTE: Int = 43
static MINUS_BYTE: Int = 45
static DIGIT_ZERO: Int = 48
static DIGIT_NINE: Int = 57
static LOWER_A: Int = 97
static LOWER_Z: Int = 122
static UPPER_A: Int = 65
static UPPER_Z: Int = 90
static FIRST_LETTER_DIGIT: Int = 10

// The value of an ASCII digit byte in a radix up to 36, or -1.
func digit_value(b: Int) -> Int {
    if b >= DIGIT_ZERO && b <= DIGIT_NINE {
        b - DIGIT_ZERO
    } else if b >= LOWER_A && b <= LOWER_Z {
        b - LOWER_A + FIRST_LETTER_DIGIT
    } else if b >= UPPER_A && b <= UPPER_Z {
        b - UPPER_A + FIRST_LETTER_DIGIT
    } else {
        -1
    }
}

/// Strings copy by reference count.
extension String: Copy {
    /// Retains the block and returns a second reference to it.
    ///
    /// A literal's block is immortal: its count is read with a plain load and
    /// never written.
    public func copy(&self) unsafe -> String {
        let words = self.bytes as UnsafePointer<Int>
        if words[REFCOUNT_SLOT] != IMMORTAL {
            let count = (&words[REFCOUNT_SLOT]) as UnsafePointer<Int>
            let _ = __saw_atomic_add_i64(count, 1)
        }
        String(bytes: self.bytes)
    }

    /// Releases the block, freeing it when this was the last reference.
    public func deinit(&var self) unsafe {
        let words = self.bytes as UnsafePointer<Int>
        if words[REFCOUNT_SLOT] == IMMORTAL {
            return
        }
        let count = (&words[REFCOUNT_SLOT]) as UnsafePointer<Int>
        let old = __saw_atomic_sub_i64_release(count, 1)
        if old < 1 {
            panic("String: over-release of a String reference (refcount underflow)")
        }
        if old == 1 {
            __saw_atomic_fence_acquire()
            let header_bytes = HEADER_WORDS * sizeof<Int>()
            let block = count as UnsafePointer<Int8>
            __saw_rt_dealloc(block, header_bytes + words[LENGTH_SLOT] + 1, BLOCK_ALIGN)
        }
    }
}

/// Strings compare byte by byte.
extension String: Equatable {
    /// Returns whether the two strings hold the same bytes.
    public func equals(&self, other: &String) -> Bool {
        string_equals(&self, &other)
    }
}

/// Strings order byte by byte, which is code-point order for UTF-8.
extension String: Comparable {
    /// Compares the two strings byte by byte; a proper prefix is `Less`.
    public func compare(&self, other: &String) -> Ordering {
        string_compare(&self, &other)
    }
}

/// Strings hash their bytes, which is what `==` compares.
extension String: Hashable {
    /// Feeds each byte into `h`, in order, with no length prefix.
    public func hash(&self, h: &var Hasher) {
        let n = self.len()
        var i = 0
        while i < n {
            h.write_int(self.byte_at(i) as Int)
            i = i + 1
        }
    }
}

/// A string renders as its own bytes.
extension String: Printable {
    /// Appends the string's bytes to `into`.
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self)
    }
}

// The block is immutable and its count atomic, so a String may cross threads
// and be shared between them; the pointer field alone blocks the derivation.
extension String: UnsafeSend {}
extension String: UnsafeSync {}
