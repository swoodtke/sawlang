//! `File`: a file opened for reading, or created for writing or appending.
//!
//! Every operation is synchronous: none suspends, so the calling thread waits
//! in the system call until it returns. A write is unbuffered, and `close`
//! reports what closing the file found; the deinit only releases the
//! descriptor (SL:hazards S28).

import std.data.{Data}
import std.path.{Path}
import std.systemerror.{SystemError, SystemErrorKind, system_error_kind}

extern "C" {
    // Each returns its natural non-negative result (a descriptor, a byte
    // count, an offset) or a negated portable tag (runtime/ABI.md).
    func __saw_rt_fs_open(path: UnsafePointer<Int8>, mode: Int, perm: Int) -> Int
    func __saw_rt_fs_read(fd: Int, buf: UnsafePointer<Int8>, count: Int) -> Int
    func __saw_rt_fs_write(fd: Int, buf: UnsafePointer<Int8>, count: Int) -> Int
    func __saw_rt_fs_lseek(fd: Int, offset: Int, whence: Int) -> Int
    // Each returns 0, or a negated portable tag.
    func __saw_rt_fs_unlink(path: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_rename(old: UnsafePointer<Int8>, new: UnsafePointer<Int8>) -> Int
    func access(path: UnsafePointer<Int8>, mode: Int32) -> Int32
    // No runtime seam closes a descriptor, so the C library's close(2) does.
    func close(fd: Int32) -> Int32
}

// The runtime's portable open modes; the runtime translates each into its
// host's flag bits.
enum OpenMode: UInt8 {
    case Read = 0,
    case WriteTruncate = 1,
    case Append = 2
}

// Where an lseek(2) offset is measured from: POSIX's `SEEK_SET`, `SEEK_CUR`
// and `SEEK_END`, which the seam passes on unchanged.
enum SeekOrigin: UInt8 {
    case Start = 0,
    case Current = 1,
    case End = 2
}

// The creation permission, which an open that creates nothing ignores, and
// the one a created file gets: 0644.
static NO_PERMISSION: Int = 0
static CREATED_PERMISSION: Int = 420
// The descriptor of a closed file, which the deinit leaves alone.
static CLOSED: Int = -1

/// A file opened for reading or created for writing, its descriptor
/// released when it is destroyed.
public struct File {
    private descriptor: Int
}

extension File {
    /// Opens the file at `path` for reading.
    ///
    /// Returns `Err(SystemError)` with the reason open(2) refused. A path
    /// holding a NUL byte, which no system path can, is `InvalidArgument`.
    public static func open(path: Path) unsafe -> Result<File, SystemError> {
        File.opened(path, OpenMode.Read, NO_PERMISSION)
    }

    /// Creates the file at `path` for writing, emptying a file already there.
    ///
    /// Returns `Err(SystemError)` with the reason open(2) refused, or
    /// `InvalidArgument` as `open` does.
    public static func create(path: Path) unsafe -> Result<File, SystemError> {
        File.opened(path, OpenMode.WriteTruncate, CREATED_PERMISSION)
    }

    /// Opens the file at `path` for appending, creating it when it is absent;
    /// each write lands at the end of the file.
    ///
    /// Returns `Err(SystemError)` with the reason open(2) refused, or
    /// `InvalidArgument` as `open` does.
    public static func open_append(path: Path) unsafe -> Result<File, SystemError> {
        File.opened(path, OpenMode.Append, CREATED_PERMISSION)
    }

    // The one open(2) call `open`, `create` and `open_append` share.
    // The check ahead of `c_string()!` is the absent path, so the `!` never
    // panics.
    static func opened(path: Path, mode: OpenMode, permission: Int) unsafe -> Result<File, SystemError> {
        let text = path.as_string()
        if text.index_of(0).is_some() {
            return SystemError.raised("open", SystemErrorKind.InvalidArgument)
        }
        let fd = __saw_rt_fs_open(borrow text.c_string()!, (mode as UInt8) as Int, permission)
        if fd < 0 {
            return SystemError.of("open", 0 - fd)
        }
        File(descriptor: fd)
    }

    /// Reads the rest of the file, from the current position up to the length
    /// lseek(2) reports when the read begins.
    ///
    /// A file that grows during the read is cut at that length, and the bytes
    /// written past it are left for a later `read`. A pipe or FIFO has no
    /// length to report, so reading one is the `Err` of its lseek(2).
    ///
    /// An empty `Ok` means nothing was left. Returns `Err(SystemError)` with
    /// the cause of a failing lseek(2) or read(2); `UnexpectedEnd` when the
    /// file ends before the length lseek(2) reported, as when it shrinks
    /// during the read; and `ResourcesExhausted` when the bytes cannot be
    /// allocated.
    public func read(&var self) unsafe -> Result<Data, SystemError> {
        let here = __saw_rt_fs_lseek(self.descriptor, 0, (SeekOrigin.Current as UInt8) as Int)
        if here < 0 {
            return SystemError.of("lseek", 0 - here)
        }
        let end = __saw_rt_fs_lseek(self.descriptor, 0, (SeekOrigin.End as UInt8) as Int)
        if end < 0 {
            return SystemError.of("lseek", 0 - end)
        }
        let back = __saw_rt_fs_lseek(self.descriptor, here, (SeekOrigin.Start as UInt8) as Int)
        if back < 0 {
            return SystemError.of("lseek", 0 - back)
        }
        // Bound in place: a copy would be a second reference, and `spare()`
        // refuses a shared block.
        guard var data = Data.reserved(end - here) else {
            return SystemError.raised("read", SystemErrorKind.ResourcesExhausted)
        }
        // A read may return fewer bytes than asked, so it repeats until the
        // block is full; a signal's interruption is retried, not reported.
        while data.spare_count() > 0 {
            let wanted = data.spare_count()
            let into = data.spare()
            let n = __saw_rt_fs_read(self.descriptor, into, wanted)
            if n > 0 {
                data.grow(n)
            } else if n == 0 {
                return SystemError.raised("read", SystemErrorKind.UnexpectedEnd)
            } else if not file_interrupted(0 - n) {
                return SystemError.of("read", 0 - n)
            }
        }
        data
    }

    /// Writes all of `data` at the current position, and returns how many
    /// bytes that was.
    ///
    /// The bytes reach the file before it returns: nothing is buffered. A
    /// write that takes fewer bytes than offered repeats with the rest, and a
    /// signal's interruption is retried. Returns `Err(SystemError)` with the
    /// cause of a failing write(2).
    public func write(&self, data: Data) unsafe -> Result<Int, SystemError> {
        let total = data.count()
        guard let bytes = data.first_byte() else {
            return 0
        }
        var done = 0
        while done < total {
            let from = (&bytes[done]) as UnsafePointer<Int8>
            let n = __saw_rt_fs_write(self.descriptor, from, total - done)
            if n > 0 {
                done = done + n
            } else if n == 0 {
                return SystemError.raised("write", SystemErrorKind.UnexpectedEnd)
            } else if not file_interrupted(0 - n) {
                return SystemError.of("write", 0 - n)
            }
        }
        done
    }

    /// Moves the position to `offset` bytes from the start of the file, and
    /// returns the new position.
    ///
    /// Returns `Err(SystemError)` with the cause of a failing lseek(2): a
    /// negative result position is `InvalidArgument`.
    public func seek_start(&self, offset: Int) unsafe -> Result<Int, SystemError> {
        self.sought(offset, SeekOrigin.Start)
    }

    /// Moves the position by `offset` bytes, forward when positive, and
    /// returns the new position from the start of the file. Errors as
    /// `seek_start` does.
    public func seek_current(&self, offset: Int) unsafe -> Result<Int, SystemError> {
        self.sought(offset, SeekOrigin.Current)
    }

    /// Moves the position to `offset` bytes from the end of the file, and
    /// returns the new position from the start. Errors as `seek_start` does.
    public func seek_end(&self, offset: Int) unsafe -> Result<Int, SystemError> {
        self.sought(offset, SeekOrigin.End)
    }

    /// Returns the current position, in bytes from the start of the file.
    ///
    /// Returns `Err(SystemError)` with the cause of a failing lseek(2), as
    /// for a pipe.
    public func position(&self) unsafe -> Result<Int, SystemError> {
        self.sought(0, SeekOrigin.Current)
    }

    // The one lseek(2) call the seeks and `position` share.
    func sought(&self, offset: Int, origin: SeekOrigin) unsafe -> Result<Int, SystemError> {
        let result = __saw_rt_fs_lseek(self.descriptor, offset, (origin as UInt8) as Int)
        if result < 0 {
            return SystemError.of("lseek", 0 - result)
        }
        result
    }

    /// Returns whether a file or directory exists at `path` and the process
    /// may reach it; a path holding a NUL byte names nothing.
    public static func exists(path: Path) unsafe -> Bool {
        let text = path.as_string()
        if text.index_of(0).is_some() {
            return false
        }
        access(text.c_bytes(), 0 as Int32) == (0 as Int32)
    }

    /// Removes the file at `path`.
    ///
    /// Returns `Err(SystemError)` with the cause of a failing unlink(2), or
    /// `InvalidArgument` for a path holding a NUL byte.
    public static func remove(path: Path) unsafe -> Result<Void, SystemError> {
        let text = path.as_string()
        if text.index_of(0).is_some() {
            return SystemError.raised("unlink", SystemErrorKind.InvalidArgument)
        }
        let status = __saw_rt_fs_unlink(text.c_bytes())
        if status != 0 {
            return SystemError.of("unlink", 0 - status)
        }
        return
    }

    /// Renames or moves the file at `from_path` to `to_path`, replacing a file
    /// already there.
    ///
    /// Returns `Err(SystemError)` with the cause of a failing rename(2), or
    /// `InvalidArgument` for a path holding a NUL byte.
    public static func rename(from_path: Path, to_path: Path) unsafe -> Result<Void, SystemError> {
        let old = from_path.as_string()
        let new = to_path.as_string()
        if old.index_of(0).is_some() || new.index_of(0).is_some() {
            return SystemError.raised("rename", SystemErrorKind.InvalidArgument)
        }
        let status = __saw_rt_fs_rename(old.c_bytes(), new.c_bytes())
        if status != 0 {
            return SystemError.of("rename", 0 - status)
        }
        return
    }

    /// Closes the file now, and reports what close(2) found.
    ///
    /// The descriptor is released either way, and the deinit then closes
    /// nothing. Returns `Err(SystemError)` when close(2) fails, its kind
    /// `Unknown` since no runtime seam reports a close's cause, and
    /// `InvalidArgument` for a file already closed.
    public func close(&var self) unsafe -> Result<Void, SystemError> {
        if self.descriptor < 0 {
            return SystemError.raised("close", SystemErrorKind.InvalidArgument)
        }
        let fd = self.descriptor
        self.descriptor = CLOSED
        if close(fd as Int32) != 0 {
            return SystemError.raised("close", SystemErrorKind.Unknown)
        }
        return
    }
}

// Whether a portable tag reports a call a signal interrupted.
func file_interrupted(tag: Int) -> Bool {
    match system_error_kind(tag) {
        case Interrupted -> true,
        case _ -> false
    }
}

extension File: NoCopy {
    // Releases the descriptor `close` has not. Every write has already reached
    // the file, so a skipped or failed close here loses no data; a caller that
    // needs the status calls `close` (SL:hazards S28).
    public func deinit(&var self) {
        if self.descriptor >= 0 {
            let _ = close(self.descriptor as Int32)
        }
    }
}
