//! `SystemError`: an operating-system operation that failed, and why.
//!
//! A runtime seam reports a failure as the negated portable tag of
//! `runtime/ABI.md`'s error table, and this module reads that tag as a
//! `SystemErrorKind`. The error carries the operation's name, the path,
//! program or name the operation was given when it had one, the kind, and the
//! platform's own error number behind it. It renders the same on every host
//! except where the kind is `Unknown`: there the number is the only account of
//! the cause, so the text names it.

extern "C" {
    // The raw platform code behind the tag the last failing seam call on this
    // thread returned (runtime/ABI.md, `__saw_rt_last_raw_code`).
    func __saw_rt_last_raw_code() -> Int
}

/// What kind of failure an operating-system operation reported.
///
/// The kinds are the runtime's portable tags, plus `UnexpectedEnd` and
/// `InvalidUtf8`, which the standard library raises itself. Several platform codes share one kind (`EACCES` and `EPERM` are
/// both `PermissionDenied`), and `Unknown` is a failure the portable set has
/// no word for.
public enum SystemErrorKind {
    /// The operation would have blocked, and the descriptor is non-blocking.
    case WouldBlock,
    /// A connection is still being established.
    case InProgress,
    /// The socket is already connected.
    case AlreadyConnected,
    /// A signal interrupted the call.
    case Interrupted,
    /// The peer reset the connection.
    case ConnectionReset,
    /// Nothing was listening at the address.
    case ConnectionRefused,
    /// The connection was aborted before it was established.
    case ConnectionAborted,
    /// The write end has no reader left.
    case BrokenPipe,
    /// The socket is not connected.
    case NotConnected,
    /// No such file, directory or host.
    case NotFound,
    /// The caller is not allowed to do this.
    case PermissionDenied,
    /// The thing being created is already there.
    case AlreadyExists,
    /// The address is already bound.
    case AddressInUse,
    /// The system rejected an argument.
    case InvalidArgument,
    /// A system resource ran out: descriptors, memory or disk space.
    case ResourcesExhausted,
    /// A failure the portable set has no word for.
    case Unknown,
    /// The host cannot be reached.
    case HostUnreachable,
    /// The network cannot be reached.
    case NetworkUnreachable,
    /// The operation ran out of time.
    case TimedOut,
    /// The host is down.
    case HostDown,
    /// The network is down.
    case NetworkDown,
    /// The descriptor is closed or was never open.
    case InvalidDescriptor,
    /// The device or disk failed the transfer.
    case InputOutputFailed,
    /// The data ended before the length the operation was promised, as when a
    /// file shrinks while it is read.
    case UnexpectedEnd,
    /// The file is not a program this system can execute: neither a binary
    /// it runs nor a script naming its interpreter on a `#!` line.
    case NotExecutable,
    /// The operating system gave text that is not valid UTF-8, such as a
    /// file name or an environment variable's value, which no `String` may
    /// hold.
    case InvalidUtf8
}

// The runtime's portable tags (runtime/ABI.md, "Errors"). Tag 0 is success
// and is never reported.
static TAG_WOULD_BLOCK: Int = 1
static TAG_IN_PROGRESS: Int = 2
static TAG_ALREADY_CONNECTED: Int = 3
static TAG_INTERRUPTED: Int = 4
static TAG_CONNECTION_RESET: Int = 5
static TAG_CONNECTION_REFUSED: Int = 6
static TAG_CONNECTION_ABORTED: Int = 7
static TAG_BROKEN_PIPE: Int = 8
static TAG_NOT_CONNECTED: Int = 9
static TAG_NOT_FOUND: Int = 10
static TAG_PERMISSION_DENIED: Int = 11
static TAG_ALREADY_EXISTS: Int = 12
static TAG_ADDRESS_IN_USE: Int = 13
static TAG_INVALID_ARGUMENT: Int = 14
static TAG_RESOURCES_EXHAUSTED: Int = 15
static TAG_HOST_UNREACHABLE: Int = 17
static TAG_NETWORK_UNREACHABLE: Int = 18
static TAG_TIMED_OUT: Int = 19
static TAG_HOST_DOWN: Int = 20
static TAG_NETWORK_DOWN: Int = 21
static TAG_INVALID_DESCRIPTOR: Int = 22
static TAG_INPUT_OUTPUT_FAILED: Int = 23
static TAG_NOT_EXECUTABLE: Int = 24

/// Returns the kind a portable tag names: `Unknown` for the catch-all tag,
/// and for a tag a newer runtime reports that this table does not know.
public(package) func system_error_kind(tag: Int) -> SystemErrorKind {
    if tag == TAG_WOULD_BLOCK {
        SystemErrorKind.WouldBlock
    } else if tag == TAG_IN_PROGRESS {
        SystemErrorKind.InProgress
    } else if tag == TAG_ALREADY_CONNECTED {
        SystemErrorKind.AlreadyConnected
    } else if tag == TAG_INTERRUPTED {
        SystemErrorKind.Interrupted
    } else if tag == TAG_CONNECTION_RESET {
        SystemErrorKind.ConnectionReset
    } else if tag == TAG_CONNECTION_REFUSED {
        SystemErrorKind.ConnectionRefused
    } else if tag == TAG_CONNECTION_ABORTED {
        SystemErrorKind.ConnectionAborted
    } else if tag == TAG_BROKEN_PIPE {
        SystemErrorKind.BrokenPipe
    } else if tag == TAG_NOT_CONNECTED {
        SystemErrorKind.NotConnected
    } else if tag == TAG_NOT_FOUND {
        SystemErrorKind.NotFound
    } else if tag == TAG_PERMISSION_DENIED {
        SystemErrorKind.PermissionDenied
    } else if tag == TAG_ALREADY_EXISTS {
        SystemErrorKind.AlreadyExists
    } else if tag == TAG_ADDRESS_IN_USE {
        SystemErrorKind.AddressInUse
    } else if tag == TAG_INVALID_ARGUMENT {
        SystemErrorKind.InvalidArgument
    } else if tag == TAG_RESOURCES_EXHAUSTED {
        SystemErrorKind.ResourcesExhausted
    } else if tag == TAG_HOST_UNREACHABLE {
        SystemErrorKind.HostUnreachable
    } else if tag == TAG_NETWORK_UNREACHABLE {
        SystemErrorKind.NetworkUnreachable
    } else if tag == TAG_TIMED_OUT {
        SystemErrorKind.TimedOut
    } else if tag == TAG_HOST_DOWN {
        SystemErrorKind.HostDown
    } else if tag == TAG_NETWORK_DOWN {
        SystemErrorKind.NetworkDown
    } else if tag == TAG_INVALID_DESCRIPTOR {
        SystemErrorKind.InvalidDescriptor
    } else if tag == TAG_INPUT_OUTPUT_FAILED {
        SystemErrorKind.InputOutputFailed
    } else if tag == TAG_NOT_EXECUTABLE {
        SystemErrorKind.NotExecutable
    } else {
        SystemErrorKind.Unknown
    }
}

extension SystemErrorKind {
    /// Returns a short description, the one `SystemError` renders.
    public func describe(&self) -> String {
        match self {
            case WouldBlock -> "would block",
            case InProgress -> "in progress",
            case AlreadyConnected -> "already connected",
            case Interrupted -> "interrupted",
            case ConnectionReset -> "connection reset",
            case ConnectionRefused -> "connection refused",
            case ConnectionAborted -> "connection aborted",
            case BrokenPipe -> "broken pipe",
            case NotConnected -> "not connected",
            case NotFound -> "not found",
            case PermissionDenied -> "permission denied",
            case AlreadyExists -> "already exists",
            case AddressInUse -> "address in use",
            case InvalidArgument -> "invalid argument",
            case ResourcesExhausted -> "resources exhausted",
            case Unknown -> "other error",
            case HostUnreachable -> "host unreachable",
            case NetworkUnreachable -> "network unreachable",
            case TimedOut -> "timed out",
            case HostDown -> "host is down",
            case NetworkDown -> "network is down",
            case InvalidDescriptor -> "invalid descriptor",
            case InputOutputFailed -> "input/output failed",
            case UnexpectedEnd -> "unexpected end of data",
            case NotExecutable -> "not an executable",
            case InvalidUtf8 -> "not valid UTF-8"
        }
    }
}

/// An operating-system operation that failed: which one, what it was given,
/// and its kind.
///
/// It renders as `open "saw.toml" failed (not found)`: the operation, the
/// path, program or name it was given in quotes, then the kind's description.
/// An operation with no such subject, such as a read of a file already open,
/// leaves the quotes out: `read failed (input/output failed)`. A NUL byte in
/// a subject renders as `\0`. A failure of kind `Unknown` also names the
/// platform's error number, `rename "a" failed (other error, errno 18)`, since
/// no portable word says what happened.
public struct SystemError {
    private operation: String
    private subject: String?
    private kind: SystemErrorKind
    private code: Int
}

extension SystemError {
    // THE CODE FUNNEL: the error a failing seam reported for `operation` as
    // the portable `tag`, with the raw code the runtime stamped beside it. The
    // stamp is per thread and any later classifying seam call replaces it, so
    // every caller builds the error immediately after the failing call, as a
    // local, before any cleanup, and returns or uses that local afterwards.
    // An operation that was given a path, a program or a name passes it as
    // the subject (SL-898): a retain of a string the caller already holds,
    // so the error path allocates nothing.
    // ENTRY POINTS:
    //     Channel.open_gate
    //     Directory.list
    //     Directory.create
    //     Directory.remove
    //     Env.get
    //     Env.set
    //     Env.unset
    //     Env.cwd
    //     Env.set_cwd
    //     Env.executable_path
    //     File.opened
    //     File.read
    //     File.write
    //     File.sought
    //     File.remove
    //     File.rename
    //     Path.canonical
    //     Command.wait
    //     Command.spawn_seam
    //     std.process.process_spawn_failure
    //     std.process.process_outcome
    //     std.process.process_drain_pipe
    //     Thread.__saw_started
    //     std.panic.print_failure
    //     std.taskgroup.dump_tasks
    public(package) static func of(operation: String, tag: Int) -> SystemError {
        SystemError(operation: operation, subject: None, kind: system_error_kind(tag),
                    code: __saw_rt_last_raw_code())
    }

    // The funnel for an operation given `subject`.
    public(package) static func of(operation: String, tag: Int, subject: String) -> SystemError {
        SystemError(operation: operation, subject: subject, kind: system_error_kind(tag),
                    code: __saw_rt_last_raw_code())
    }

    // An error the standard library raises itself, with no tag behind it.
    public(package) static func raised(operation: String, kind: SystemErrorKind) -> SystemError {
        SystemError(operation: operation, subject: None, kind: kind, code: 0)
    }

    // The same for an operation given `subject`.
    public(package) static func raised(operation: String, kind: SystemErrorKind, subject: String) -> SystemError {
        SystemError(operation: operation, subject: subject, kind: kind, code: 0)
    }

    /// Returns the kind of the failure.
    public func kind(&self) -> SystemErrorKind {
        self.kind
    }

    /// Returns the path, program or name the failed operation was given, or
    /// `None` for an operation given none, such as a read of a file already
    /// open.
    public func subject(&self) -> String? {
        self.subject
    }

    /// Returns the platform's error number behind the failure, for a log:
    /// `0` when there is none, as for a failure the standard library raised
    /// itself. Branch on `kind`, which reads the same on every host.
    public func code(&self) -> Int {
        self.code
    }
}

extension SystemError: Error {
    /// Writes the operation, the quoted subject when there is one, and the
    /// kind's description, and for an `Unknown` failure the platform's error
    /// number when there is one.
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self.operation)
        if let subject = self.subject {
            try! into.append(" \"")
            append_subject(&var into, subject)
            try! into.append("\"")
        }
        try! into.append(" failed (")
        try! into.append(self.kind.describe())
        let unnamed = match self.kind {
            case Unknown -> true,
            case _ -> false
        }
        if unnamed && self.code != 0 {
            try! into.append(", errno ")
            try! into.append(self.code)
        }
        try! into.append(")")
    }
}

// Writes an error's `subject` as it is, but each NUL byte as `\0`, which a
// reader of the text can see and a C reader of it would take as the end. The
// common subject holds no NUL and goes in one append; neither path allocates
// past the builder's own buffer.
public(package) func append_subject(into: &var StringBuilder, subject: String) {
    var clean = true
    var i = 0
    while i < subject.len() {
        if subject.byte_at(i) == 0 {
            clean = false
        }
        i = i + 1
    }
    if clean {
        try! into.append(subject)
        return
    }
    var k = 0
    while k < subject.len() {
        let b = subject.byte_at(k)
        if b == 0 {
            try! into.append("\\0")
        } else {
            try! into.append(b)
        }
        k = k + 1
    }
}
