//! Cooperative tasks: where a task cedes, and the park points it cedes at.
//!
//! `yield_now` cedes to the other ready tasks, `sleep` parks for a span, and
//! `cancelled` reads whether the running task has been asked to stop. `sleep`
//! and `cancelled` are in the prelude; `yield_now` needs `import std.task`.

/// Cedes to the other ready tasks; the caller resumes once they have had a
/// turn.
///
/// A task that only computes cedes on its own at loop back edges, so this is
/// for the points the compiler's budget does not reach.
public func yield_now() {
    __saw_park_ready()
}

/// Parks the running task for at least `duration`.
public func sleep(duration: Duration) {
    __saw_park_timer(timer_nanos(duration))
}

/// Returns whether the running task has been asked to stop.
///
/// Cancellation is cooperative: nothing stops a task but its own code, which
/// asks here where it chooses to. Outside a task the answer is `false`.
public func cancelled() -> Bool {
    __saw_cancel_requested()
}

// A span past `Int.max` nanoseconds (about 292 years on a 64-bit host)
// saturates: no observer can tell the two apart, and refusing would make
// `sleep` panic on a valid `Duration`.
func timer_nanos(duration: Duration) -> Int {
    let ns = duration.as_nanos()
    if ns >= (Int.max as UInt64) {
        return Int.max
    }
    ns as Int
}

// The park points (SL:coroutines §3.1). Each is a lang item whose calls
// suspend, and the coroutine lowering replaces each call with its park, so a
// body here runs only when a call reached code generation unlowered.

// A ready yield: the task stays runnable and resumes at its next turn.
public(package) func __saw_park_ready() {
    panic("std.task: a ready park reached code generation unlowered")
}

// A timer: the task resumes once `nanos` nanoseconds have passed.
public(package) func __saw_park_timer(nanos: Int) {
    panic("std.task: a timer park reached code generation unlowered")
}

// Readiness of descriptor `fd`, for reading when `write` is 0 and for
// writing when it is 1.
public(package) func __saw_park_fd(fd: Int, write: Int) {
    panic("std.task: a descriptor park reached code generation unlowered")
}

// Readiness of descriptor `fd`, as `__saw_park_fd`, or the monotonic instant
// `deadline_nanos`, whichever comes first.
public(package) func __saw_park_fd_until(fd: Int, write: Int, deadline_nanos: Int) {
    panic("std.task: a descriptor park reached code generation unlowered")
}

// A channel's readiness word, named by its negated address.
public(package) func __saw_park_channel(word: Int) {
    panic("std.task: a channel park reached code generation unlowered")
}

// Offload job `job`'s completion.
public(package) func __saw_park_offload(job: Int) {
    panic("std.task: an offload park reached code generation unlowered")
}

// Whether the running task's cancel word is set. It parks nothing; inside a
// coroutine frame the lowering reads the word, and outside one no task is
// running, so the answer is this body's.
public(package) func __saw_cancel_requested() -> Bool {
    false
}
