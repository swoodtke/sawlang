//! `Vector<T, A>`: a growable array that owns its elements and allocates
//! through `A`, `GlobalAllocator` by default.
//!
//! `v[i]` is a place: the element is read or written where it sits, and a
//! value read of it follows the element's copy tier. An index out of range
//! panics; `get` is its optional copy, and `find` lends the element only when
//! it is there. Every operation that can run out of memory reports it as
//! `Err(AllocError)` and leaves the vector as it was.
//! `Vector` is ExplicitCopy: a transfer is `move v` or `v.copy()`, and `copy()`
//! exists when the element is ExplicitCopy.

import std.mem.{drop_in_place}
import std.string.{joined_strings}

static FIRST_SLOTS: Int = 4

// The run length `sort_by` insertion-sorts before it starts merging.
static SORT_RUN: Int = 20

/// A growable array of `T`, allocated through `A`.
public struct Vector<T, A: Allocator = GlobalAllocator> {
    private buffer: UnsafePointer<T>?
    private length: Int
    private capacity: Int
}

// The buffer pointer blocks the derivation, but it is the vector's own
// storage: moving or sharing a vector is safe exactly when moving or sharing
// its elements and its allocator is.
extension Vector<T: Send, A: Send>: UnsafeSend {}
extension Vector<T: Sync, A: Sync>: UnsafeSync {}

extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Creates an empty vector, which allocates nothing until an element
    /// arrives.
    public init() unsafe -> Vector<T, A> {
        Vector<T, A>(buffer: None, length: 0, capacity: 0)
    }

    /// Creates an empty vector with room for `capacity` elements.
    ///
    /// Returns `Err(AllocError)` when `A` refuses. A non-positive `capacity`
    /// allocates nothing.
    public init(capacity: Int) unsafe -> Result<Vector<T, A>, AllocError> {
        if capacity <= 0 {
            return Vector<T, A>(buffer: None, length: 0, capacity: 0)
        }
        let bytes = capacity * sizeof<T>()
        if let raw = A().alloc(bytes, alignof<T>()) {
            return Vector<T, A>(buffer: raw as UnsafePointer<T>, length: 0, capacity: capacity)
        }
        return AllocError(size: bytes, align: alignof<T>())
    }

    /// Returns the number of elements.
    public func len(&self) -> Int {
        self.length
    }

    /// Returns whether the vector holds no elements.
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    // The start and length of the elements a `&[T]` of the whole vector
    // views, for the compiler's whole-container coercion (SL-988): null and 0
    // for a vector with no buffer, whose view reaches no element. The start
    // travels as bytes because the coercion reads its two words alone.
    func view_parts(&self) unsafe -> (UnsafePointer<UInt8>, Int) {
        guard let buf = self.buffer else {
            return (0 as UnsafePointer<UInt8>, 0)
        }
        (buf as UnsafePointer<UInt8>, self.length)
    }

    // The same for a `&var [T]`: a vector's elements are its own, so nothing
    // separates first.
    func writable_view_parts(&var self) unsafe -> (UnsafePointer<UInt8>, Int) {
        self.view_parts()
    }

    /// Lends the element at `index` where it sits.
    ///
    /// A read of `v[i]` copies the element out, and a write replaces it in
    /// place. Panics if `index` is outside `0..<len()`.
    @synthesize(shared)
    public func [](&var self, index: Int) unsafe borrows -> &var T {
        if index < 0 || index >= self.length {
            panic("Vector.[]: index out of range: {} (len {})", index, self.length)
        }
        guard let buf = self.buffer else {
            panic("Vector.[]: buffer is empty")
        }
        lend buf[index]
    }

    /// Lends the element at `index` where it sits, or nothing when `index` is
    /// outside `0..<len()`.
    ///
    /// The absent path opens no window, so the vector is free to use there.
    @synthesize(shared)
    public func find(&var self, index: Int) unsafe borrows -> &var T? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        lend buf[index]
    }

    /// Replaces the element at `index`, destroying the one it overwrites.
    /// Panics if `index` is outside `0..<len()`; `value` is consumed either
    /// way.
    public func set(&var self, index: Int, value: T) unsafe {
        if index < 0 || index >= self.length {
            panic("Vector.set: index out of range: {} (len {})", index, self.length)
        }
        if let buf = self.buffer {
            let old = move buf[index]
            buf[index] = move value
            let _ = move old
        }
    }

    // A dynamic-index exchange the Law of Exclusivity must refuse as
    // `swap(&v[i], &v[j])`. It is byte-level, with no element-typed temporary,
    // so no retain or deinit runs and `T` needs no bound.
    /// Exchanges the elements at `i` and `j`.
    ///
    /// The two values change slots without a copy or a deinit, so any element
    /// type swaps, a NoCopy one included. Swapping an index with itself does
    /// nothing. Panics if either index is outside `0..<len()`.
    public func swap(&var self, i: Int, j: Int) unsafe {
        if i == j {
            return
        }
        // Checked one at a time so the message names the index that is out.
        if i < 0 || i >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", i, self.length)
        }
        if j < 0 || j >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", j, self.length)
        }
        if let buf = self.buffer {
            let size = sizeof<T>()
            let first = (&buf[i]) as UnsafePointer<Int8>
            let second = (&buf[j]) as UnsafePointer<Int8>
            var k = 0
            while k < size {
                let held = first[k]
                first[k] = second[k]
                second[k] = held
                k = k + 1
            }
        }
    }

    /// Replaces the element at `index` with `value` and returns the element
    /// it held, which the caller now owns.
    ///
    /// Panics if `index` is outside `0..<len()`; `value` is consumed either
    /// way.
    public func swap_out(&var self, index: Int, value: T) unsafe -> T {
        if index < 0 || index >= self.length {
            panic("Vector.swap_out: index out of range: {} (len {})", index, self.length)
        }
        guard let buf = self.buffer else {
            panic("Vector.swap_out: buffer is empty")
        }
        let old = move buf[index]
        buf[index] = move value
        move old
    }

    /// Appends `value`.
    ///
    /// Returns `Err(AllocError)` when the buffer must grow and `A` refuses; the
    /// vector is then unchanged and `value` is destroyed.
    public func push(&var self, value: T) unsafe -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self.reserve_slots(wanted) {
            return AllocError(size: self.grow_target(wanted) * sizeof<T>(), align: alignof<T>())
        }
        guard let buf = self.buffer else {
            panic("Vector.push: buffer is empty")
        }
        // The slot at `length` is uninitialized, so this placement releases
        // no prior occupant.
        buf[self.length] = move value
        self.length = self.length + 1
        return
    }

    /// Makes room for `additional` more elements, so that many pushes cannot
    /// fail. Returns `Err(AllocError)` when `A` refuses. Panics if
    /// `additional` is negative.
    public func reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        if additional < 0 {
            panic("Vector.reserve: additional {} is negative", additional)
        }
        let wanted = self.length + additional
        if not self.reserve_slots(wanted) {
            return AllocError(size: self.grow_target(wanted) * sizeof<T>(), align: alignof<T>())
        }
        return
    }

    /// Removes the last element and returns it, or `None` when the vector is
    /// empty.
    public func pop(&var self) unsafe -> T? {
        if self.length == 0 {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        self.length = self.length - 1
        // The slot is past the new length, so ownership leaves here.
        move buf[self.length]
    }

    /// Removes every element, destroying each, last first, and keeps the
    /// capacity.
    public func clear(&var self) {
        while self.length > 0 {
            let _ = self.pop()
        }
    }

    // The capacity a growth to `wanted` elements allocates: double, from a
    // floor, unless more was asked for.
    func grow_target(&self, wanted: Int) -> Int {
        let doubled = if self.capacity == 0 { FIRST_SLOTS } else { self.capacity * 2 }
        if doubled < wanted {
            wanted
        } else {
            doubled
        }
    }

    // Makes room for `wanted` elements. False means `A` refused and the
    // vector is untouched, which every caller relies on to report
    // all-or-nothing.
    func reserve_slots(&var self, wanted: Int) unsafe -> Bool {
        if self.capacity >= wanted {
            return true
        }
        let target = self.grow_target(wanted)
        guard let fresh = A().alloc(target * sizeof<T>(), alignof<T>()) else {
            return false
        }
        if let old = self.buffer {
            // Each element changes address, so a growth is refused where it
            // is instantiated at a `NoMove` element (spec, Placement into
            // heap storage).
            let slots = fresh as UnsafePointer<T>
            var i = 0
            while i < self.length {
                slots[i] = move old[i]
                i = i + 1
            }
            A().dealloc(old as UnsafePointer<Int8>, self.capacity * sizeof<T>(), alignof<T>())
        }
        self.buffer = fresh as UnsafePointer<T>
        self.capacity = target
        true
    }
}

// Each closure is non-escaping, so it may capture enclosing locals by
// reference, and is lent the element as `&T` where it sits, so no method
// carries a copy bound. The vector is held for the whole call, so the closure
// cannot grow it under a lent element.
extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Calls `body` with each element in order, lent as `&T`.
    ///
    /// Nothing is copied, so a move-only element type is visitable.
    public func each(&self, body: (&T) -> Void) unsafe {
        guard let buf = self.buffer else {
            return
        }
        var i = 0
        while i < self.length {
            body(&buf[i])
            i = i + 1
        }
    }

    /// Calls `body` with each index and its element, lent as `&T`, in order.
    public func each_indexed(&self, body: (Int, &T) -> Void) unsafe {
        guard let buf = self.buffer else {
            return
        }
        var i = 0
        while i < self.length {
            body(i, &buf[i])
            i = i + 1
        }
    }

    /// Returns a new vector of `transform`'s result for each element, in
    /// order, allocated through the same `A`.
    ///
    /// The element is lent to `transform` as `&T`. Returns `Err(AllocError)`
    /// when the new vector cannot grow; the partial result is destroyed.
    public func map<U>(&self, transform: (&T) -> U) unsafe -> Result<Vector<U, A>, AllocError> {
        var result = Vector<U, A>()
        guard let buf = self.buffer else {
            return move result
        }
        var i = 0
        while i < self.length {
            try result.push(transform(&buf[i]))
            i = i + 1
        }
        return move result
    }

    // The accumulator moves through `combine` at every step, so an
    // ExplicitCopy one is never duplicated. It is `Acc` because `A` is the
    // allocator.
    /// Folds the elements from first to last: each call of `combine` takes the
    /// accumulator so far and the element, lent as `&T`, and returns the next
    /// accumulator. Returns the last one, or `initial` when the vector is
    /// empty.
    public func fold<Acc>(&self, initial: Acc, combine: (Acc, &T) -> Acc) unsafe -> Acc {
        var acc = move initial
        guard let buf = self.buffer else {
            return move acc
        }
        var i = 0
        while i < self.length {
            acc = combine(move acc, &buf[i])
            i = i + 1
        }
        move acc
    }

    /// Sorts the elements in place by `compare`, which is lent the two
    /// comparands as `&T`.
    ///
    /// The sort is stable: equal elements keep their order. It makes
    /// O(n log n) calls of `compare` and O(n log² n) element swaps, and
    /// allocates nothing.
    public func sort_by(&var self, compare: (&T, &T) -> Ordering) unsafe {
        merge_sort(&var self, &ClosureOrder<T>(), compare)
    }

    // Exchanges the blocks `low..<middle` and `middle..<high` by swapping
    // equal-length pieces, Gries and Mills's block swap.
    func rotate(&var self, low: Int, middle: Int, high: Int) unsafe {
        var left = middle - low
        var right = high - middle
        while left != right {
            if left > right {
                self.swap_blocks(middle - left, middle, right)
                left = left - right
            } else {
                self.swap_blocks(middle - left, middle + right - left, left)
                right = right - left
            }
        }
        self.swap_blocks(middle - left, middle, left)
    }

    // Swaps the `count` elements from `first` with the `count` from `second`.
    func swap_blocks(&var self, first: Int, second: Int, count: Int) unsafe {
        var k = 0
        while k < count {
            self.swap(first + k, second + k)
            k = k + 1
        }
    }
}

// The order a sort asks one question of: whether `left` orders strictly
// after `right`. `compare` travels beside the order rather than inside it: a
// non-escaping function value cannot be held in a field, and an order that
// called through one in `sort`'s instantiation would make `sort` non-sync,
// since a call through a function value counts as a possible suspension.
// `NaturalOrder` never calls it, so `sort` stays sync-callable.
trait SortOrder {
    type Element
    func greater(&self, left: &Element, right: &Element, compare: (&Element, &Element) -> Ordering) -> Bool
}

// `sort`'s order: `T`'s own `>`.
struct NaturalOrder<T: Comparable> {}

extension NaturalOrder<T: Comparable>: SortOrder {
    type Element = T
    func greater(&self, left: &T, right: &T, compare: (&T, &T) -> Ordering) -> Bool {
        left > right
    }
}

// `sort_by`'s order: the caller's comparator.
struct ClosureOrder<T> {}

extension ClosureOrder<T>: SortOrder {
    type Element = T
    func greater(&self, left: &T, right: &T, compare: (&T, &T) -> Ordering) -> Bool {
        compare(&left, &right) == Ordering.Greater
    }
}

// A bottom-up merge sort whose merges are in place (SymMerge, Kim and Kutzner
// 2004): insertion-sorted runs of SORT_RUN elements, then merges of doubling
// width. Nothing is allocated, which keeps the signature free of an
// `AllocError`, and every element moves by the byte-level `swap`, so none is
// duplicated. Only "strictly greater" is ever asked, and an element passes
// another only when it is strictly greater, which is what keeps equal
// elements in order.
func merge_sort<O: SortOrder, A: Allocator>(v: &var Vector<O.Element, A>, order: &O,
                                            compare: (&O.Element, &O.Element) -> Ordering) {
    let count = v.len()
    var start = 0
    while start < count {
        let stop = if start + SORT_RUN < count { start + SORT_RUN } else { count }
        insertion_sort(&var v, start, stop, &order, compare)
        start = stop
    }
    var width = SORT_RUN
    while width < count {
        var low = 0
        while low + width < count {
            let middle = low + width
            let high = if middle + width < count { middle + width } else { count }
            // Two runs already in order need no merge, so sorted input costs
            // one comparison per run.
            if greater_at(&v, middle - 1, middle, &order, compare) {
                sym_merge(&var v, low, middle, high, &order, compare)
            }
            low = high
        }
        width = width * 2
    }
}

// Whether the element at `i` orders strictly after the one at `j`.
func greater_at<O: SortOrder, A: Allocator>(v: &Vector<O.Element, A>, i: Int, j: Int, order: &O,
                                            compare: (&O.Element, &O.Element) -> Ordering) unsafe -> Bool {
    guard let left = v.buffer else {
        return false
    }
    let right = left
    order.greater(&left[i], &right[j], compare)
}

// Sorts `low..<high`; an element moves only past a strictly greater
// predecessor.
func insertion_sort<O: SortOrder, A: Allocator>(v: &var Vector<O.Element, A>, low: Int, high: Int, order: &O,
                                                compare: (&O.Element, &O.Element) -> Ordering) {
    var i = low + 1
    while i < high {
        var j = i
        while j > low && greater_at(&v, j - 1, j, &order, compare) {
            v.swap(j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
}

// Merges the sorted runs `low..<middle` and `middle..<high` in place. It
// splits both runs at a point found by binary search, rotates the two inner
// pieces past each other and recurses on each side, so the depth is
// O(log n). Ties resolve toward the left run, which is the stability rule.
func sym_merge<O: SortOrder, A: Allocator>(v: &var Vector<O.Element, A>, low: Int, middle: Int, high: Int,
                                           order: &O, compare: (&O.Element, &O.Element) -> Ordering) {
    if middle - low == 1 {
        // The one left element goes before the first right element that is
        // not strictly less than it.
        var i = middle
        var j = high
        while i < j {
            let h = i + (j - i) / 2
            if greater_at(&v, low, h, &order, compare) {
                i = h + 1
            } else {
                j = h
            }
        }
        var k = low
        while k < i - 1 {
            v.swap(k, k + 1)
            k = k + 1
        }
        return
    }
    if high - middle == 1 {
        // The one right element goes before the first left element that is
        // strictly greater than it.
        var i = low
        var j = middle
        while i < j {
            let h = i + (j - i) / 2
            if not greater_at(&v, h, middle, &order, compare) {
                i = h + 1
            } else {
                j = h
            }
        }
        var k = middle
        while k > i {
            v.swap(k, k - 1)
            k = k - 1
        }
        return
    }
    let half = low + (high - low) / 2
    let span = half + middle
    var start = low
    var bound = middle
    if middle > half {
        start = span - high
        bound = half
    }
    let last = span - 1
    while start < bound {
        let c = start + (bound - start) / 2
        if not greater_at(&v, c, last - c, &order, compare) {
            start = c + 1
        } else {
            bound = c
        }
    }
    let stop = span - start
    if start < middle && middle < stop {
        v.rotate(start, middle, stop)
    }
    if low < start && start < half {
        sym_merge(&var v, low, start, half, &order, compare)
    }
    if half < stop && stop < high {
        sym_merge(&var v, half, stop, high, &order, compare)
    }
}

// `get` copies an element out, so the bound is declared where a caller reads
// it rather than inferred from the body.
extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    /// Returns a copy of the element at `index`, or `None` when `index` is
    /// outside `0..<len()`.
    ///
    /// The element must be Copy; `find` reaches any element where it sits.
    public func get(&self, index: Int) unsafe -> T? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        buf[index]
    }

    // `next()` hands the consumer an owned element, so a bitwise read of an
    // owning element would give it two owners. The iterator borrows the vector
    // itself, not its buffer, so the `for` statement is its window and a
    // mutation in the body is an exclusivity error.
    /// Returns an iterator over the vector's elements (`for x in v.iter()`).
    ///
    /// Each element is yielded as an owned copy, which is what requires
    /// `T: Copy`. The iterator borrows the vector for the whole loop, so the
    /// body may read it but not add to it, remove from it or replace it.
    public func iter(&self) borrows -> VectorIterator<T, A> {
        VectorIterator<T, A>(vector: lends self, index: 0)
    }

    /// Returns an iterator yielding `(index, element)` pairs.
    ///
    /// Because elements are yielded by value, `T` must be `Copy`. Like
    /// `iter()`, it borrows the vector for the whole loop.
    public func enumerated(&self) borrows -> EnumeratedIterator<T, A> {
        EnumeratedIterator<T, A>(vector: lends self, index: 0)
    }
}

extension Vector<String> {
    /// Returns the strings in order with `separator` between each adjacent
    /// pair.
    ///
    /// An empty vector yields `""` and a one-element vector yields its element.
    public func join(&self, separator: String) -> String {
        joined_strings(&self, &separator)
    }
}

extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    /// Duplicates the vector and every element through the same allocator.
    ///
    /// Panics if `A` refuses: `copy()` is the ExplicitCopy hook, whose
    /// signature has no error channel.
    public func copy(&self) unsafe -> Vector<T, A> {
        match self.copy_elements() {
            case Ok(copied) -> move copied,
            case Err(_) -> panic("Vector.copy: {}", AllocError(size: self.length * sizeof<T>(), align: alignof<T>()))
        }
    }

    // The copy policy is the type's for every `T`, a move-only element's
    // included, so this is every vector's destructor though the conformance's
    // `copy()` exists only where `T` is ExplicitCopy. Elements popped or moved
    // out have left `length`, so they are never visited; the buffer goes back
    // to this vector's own `A`.
    public func deinit(&var self) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                drop_in_place((&buf[i]) as UnsafePointer<T>)
                i = i + 1
            }
            let raw = buf as UnsafePointer<Int8>
            A().dealloc(raw, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// The reporting twin of `copy`; its `try_` name awaits DF-257b's ruling.
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the vector and every element through the same allocator.
    ///
    /// Returns `Err(AllocError)` when `A` refuses. The whole buffer is
    /// reserved first, so the result is a complete copy or nothing.
    public func try_copy(&self) unsafe -> Result<Vector<T, A>, AllocError> {
        self.copy_elements()
    }

    // Every vector duplicate is made here, as an append onto an empty vector.
    //
    // ENTRY POINTS:
    //   copy
    //   try_copy
    func copy_elements(&self) unsafe -> Result<Vector<T, A>, AllocError> {
        var result = Vector<T, A>()
        // An empty vector may still hold a buffer (after `pop`, `clear` or
        // `reserve`), which its copy has no use for.
        guard let source = self.buffer else {
            return move result
        }
        try result.append_copies(source, self.length)
        move result
    }
}

extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Appends a copy of every element of `other`, in order.
    ///
    /// A whole `Vector`, `[T; N]` or `Data` passes as `&v`. The room is
    /// reserved before the first copy, so on `Err(AllocError)`, when the
    /// buffer must grow and `A` refuses, the vector is unchanged. Appending a
    /// vector to itself, `v.append(&v)`, is a compile error: `&v` holds `v`
    /// shared for the call, and `append` needs it exclusively.
    public func append(&var self, other: &[T]) unsafe -> Result<Void, AllocError> {
        let count = other.len()
        if count == 0 {
            return
        }
        self.append_copies((&other[0]) as UnsafePointer<T>, count)
    }

    // Every run of element copies onto a vector's end is made here: one
    // reservation, then each slot written in place, with no push and no bounds
    // check per element. For a type copied by its bits, `copy()` is a plain
    // load of them, so the optimizer turns the loop into a bulk copy at
    // `memcpy` speed; any other type runs its copy glue per element (SL-961).
    // The length is set once at the end, which is sound because a panic in an
    // element's `copy()` ends the process, so no partly written vector is ever
    // dropped. `source` must not point into this vector, whose buffer the
    // reservation may move; the Law of Exclusivity keeps every entry from it.
    //
    // ENTRY POINTS:
    //   copy_elements
    //   append
    func append_copies(&var self, source: UnsafePointer<T>, count: Int) unsafe -> Result<Void, AllocError> {
        if count == 0 {
            return
        }
        try self.reserve(count)
        guard let buf = self.buffer else {
            panic("Vector.append: buffer is empty")
        }
        let target = buf + self.length
        var i = 0
        while i < count {
            // The slot is past the length, so this placement releases nothing.
            target[i] = source[i].copy()
            i = i + 1
        }
        self.length = self.length + count
        return
    }
}

// `>` is the one question `T`'s order is asked. The comparator handed down
// beside `NaturalOrder` is never called.
extension Vector<T: Comparable, A: Allocator = GlobalAllocator> {
    /// Sorts the elements in ascending order by `T`'s `Comparable` order.
    ///
    /// The sort is stable: equal elements keep their order. It makes
    /// O(n log n) comparisons and O(n log² n) element swaps, and allocates
    /// nothing. No element is copied, so a NoCopy element type sorts.
    public func sort(&var self) {
        merge_sort(&var self, &NaturalOrder<T>(), { a, b in Ordering.Equal })
    }
}

// Holds the vector itself, lent, and reads `length` and `buffer` through it on
// every `next()`. Lend the root, never the buffer: a snapshot of the buffer
// pointer is what the vector can invalidate (SL-321).
//
// `public` only because `Vector.iter()` is public and a public signature may
// not name a private type; a borrowing struct cannot be held, so its only use
// is the head of a `for`.
/// The iterator `Vector.iter()` returns; it lives only as the head of a `for`.
public borrows struct VectorIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// `next()` yields an element the consumer owns, so it spells `.copy()`; a bare
// slot read would be a second owner. The bound is `ExplicitCopy` because the
// body spells the copy; `iter()` keeps the stricter `T: Copy` at the producer.
extension VectorIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = T

    /// Returns a copy of the next element, or `None` past the last one.
    public func next(&var self) unsafe -> T? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                buf[idx].copy()
            } else {
                None
            }
        } else {
            None
        }
    }
}

// Same shape and visibility reason as `VectorIterator`.
/// The iterator `Vector.enumerated()` returns; it lives only as the head of a
/// `for`.
public borrows struct EnumeratedIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// The yielded pair owns its element: `.copy()` for the same reason as above.
extension EnumeratedIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = (Int, T)

    /// Returns the next index paired with a copy of its element, or `None`
    /// past the last one.
    public func next(&var self) unsafe -> (Int, T)? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                (idx, buf[idx].copy())
            } else {
                None
            }
        } else {
            None
        }
    }
}

// THE SLICE OPERATIONS: `s.get(i)`, `s.sort()`, `s.fill(value)` and
// `s.copy()` on a `&[T]` or a `&var [T]` are each a call of one function
// here, which the compiler makes in the method call's place, so a slice of
// any container reaches the one body (SL-988). `len()`, `s[i]`, `s[a..b]` and
// `swap(i, j)` are the compiler's own and need no body. Nothing else calls
// these, so none is public.
//
// ENTRY POINTS:
//   slice_get
//   slice_sort
//   slice_fill
//   slice_copy

// A new `Vector` holding a copy of each element, in order. Like every
// `copy()`, it panics when the allocator refuses.
func slice_copy<T: ExplicitCopy>(s: &[T]) -> Vector<T> {
    var out = try! Vector<T>(capacity: s.len())
    var i = 0
    while i < s.len() {
        try! out.push(s[i].copy())
        i = i + 1
    }
    move out
}

// A copy of the element at `index`, or `None` outside `0..<s.len()`.
func slice_get<T: Copy>(s: &[T], index: Int) -> T? {
    if index < 0 || index >= s.len() {
        return None
    }
    s[index]
}

// Every element replaced by a copy of `value`, each one it overwrites
// destroyed. The last slot takes `value` itself, so a fill makes one copy
// fewer than the slice has elements.
func slice_fill<T: ExplicitCopy>(s: &var [T], value: T) {
    let count = s.len()
    if count == 0 {
        return
    }
    var i = 0
    while i < count - 1 {
        s[i] = value.copy()
        i = i + 1
    }
    s[count - 1] = move value
}

// `merge_sort` over a slice: insertion-sorted runs, then in-place merges of
// doubling width. Every element moves by `swap`, so none is copied and
// nothing is allocated, and an element passes another only when it is
// strictly greater, which keeps equal elements in order.
func slice_sort<T: Comparable>(s: &var [T]) {
    let count = s.len()
    var start = 0
    while start < count {
        let stop = if start + SORT_RUN < count { start + SORT_RUN } else { count }
        slice_insertion_sort(&var s, start, stop)
        start = stop
    }
    var width = SORT_RUN
    while width < count {
        var low = 0
        while low + width < count {
            let middle = low + width
            let high = if middle + width < count { middle + width } else { count }
            // Two runs already in order need no merge, so sorted input costs
            // one comparison per run.
            if slice_greater(&s, middle - 1, middle) {
                slice_sym_merge(&var s, low, middle, high)
            }
            low = high
        }
        width = width * 2
    }
}

// Whether the element at `i` orders strictly after the one at `j`.
func slice_greater<T: Comparable>(s: &[T], i: Int, j: Int) -> Bool {
    s[i] > s[j]
}

// Sorts `low..<high`; an element moves only past a strictly greater
// predecessor.
func slice_insertion_sort<T: Comparable>(s: &var [T], low: Int, high: Int) {
    var i = low + 1
    while i < high {
        var j = i
        while j > low && slice_greater(&s, j - 1, j) {
            s.swap(j - 1, j)
            j = j - 1
        }
        i = i + 1
    }
}

// `sym_merge` over a slice: the runs `low..<middle` and `middle..<high`
// merged in place, ties resolving toward the left run.
func slice_sym_merge<T: Comparable>(s: &var [T], low: Int, middle: Int, high: Int) {
    if middle - low == 1 {
        // The one left element goes before the first right element that is
        // not strictly less than it.
        var i = middle
        var j = high
        while i < j {
            let h = i + (j - i) / 2
            if slice_greater(&s, low, h) {
                i = h + 1
            } else {
                j = h
            }
        }
        var k = low
        while k < i - 1 {
            s.swap(k, k + 1)
            k = k + 1
        }
        return
    }
    if high - middle == 1 {
        // The one right element goes before the first left element that is
        // strictly greater than it.
        var i = low
        var j = middle
        while i < j {
            let h = i + (j - i) / 2
            if not slice_greater(&s, h, middle) {
                i = h + 1
            } else {
                j = h
            }
        }
        var k = middle
        while k > i {
            s.swap(k, k - 1)
            k = k - 1
        }
        return
    }
    let half = low + (high - low) / 2
    let span = half + middle
    var start = low
    var bound = middle
    if middle > half {
        start = span - high
        bound = half
    }
    let last = span - 1
    while start < bound {
        let c = start + (bound - start) / 2
        if not slice_greater(&s, c, last - c) {
            start = c + 1
        } else {
            bound = c
        }
    }
    let stop = span - start
    if start < middle && middle < stop {
        slice_rotate(&var s, start, middle, stop)
    }
    if low < start && start < half {
        slice_sym_merge(&var s, low, start, half)
    }
    if half < stop && stop < high {
        slice_sym_merge(&var s, half, stop, high)
    }
}

// `Vector.rotate` over a slice: Gries and Mills's block swap.
func slice_rotate<T>(s: &var [T], low: Int, middle: Int, high: Int) {
    var left = middle - low
    var right = high - middle
    while left != right {
        if left > right {
            slice_swap_blocks(&var s, middle - left, middle, right)
            left = left - right
        } else {
            slice_swap_blocks(&var s, middle - left, middle + right - left, left)
            right = right - left
        }
    }
    slice_swap_blocks(&var s, middle - left, middle, left)
}

// Swaps the `count` elements from `first` with the `count` from `second`.
func slice_swap_blocks<T>(s: &var [T], first: Int, second: Int, count: Int) {
    var k = 0
    while k < count {
        s.swap(first + k, second + k)
        k = k + 1
    }
}
