//! `Vector<T, A>`: a growable array that owns its elements and allocates
//! through `A`, `GlobalAllocator` by default.
//!
//! `v[i]` is a place: the element is read or written where it sits, and a
//! value read of it follows the element's copy tier. An index out of range
//! panics; `get` is its optional copy, and `find` lends the element only when
//! it is there. Every operation that can run out of memory reports it as
//! `Err(AllocError)` and leaves the vector as it was.
//! `Vector` is ExplicitCopy: a transfer is `move v` or `v.copy()`, and `copy()`
//! exists when the element is ExplicitCopy.

import std.mem.{drop_in_place}

static FIRST_SLOTS: Int = 4

/// A growable array of `T`, allocated through `A`.
public struct Vector<T, A: Allocator = GlobalAllocator> {
    private buffer: UnsafePointer<T>?
    private length: Int
    private capacity: Int
}

// The buffer pointer blocks the derivation, but it is the vector's own
// storage: moving or sharing a vector is safe exactly when moving or sharing
// its elements and its allocator is.
extension Vector<T: Send, A: Send>: UnsafeSend {}
extension Vector<T: Sync, A: Sync>: UnsafeSync {}

extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Creates an empty vector, which allocates nothing until an element
    /// arrives.
    public init() unsafe -> Vector<T, A> {
        Vector<T, A>(buffer: None, length: 0, capacity: 0)
    }

    /// Creates an empty vector with room for `capacity` elements.
    ///
    /// Returns `Err(AllocError)` when `A` refuses. A non-positive `capacity`
    /// allocates nothing.
    public init(capacity: Int) unsafe -> Result<Vector<T, A>, AllocError> {
        if capacity <= 0 {
            return Vector<T, A>(buffer: None, length: 0, capacity: 0)
        }
        let bytes = capacity * sizeof<T>()
        if let raw = A().alloc(bytes, alignof<T>()) {
            return Vector<T, A>(buffer: raw as UnsafePointer<T>, length: 0, capacity: capacity)
        }
        return AllocError(size: bytes, align: alignof<T>())
    }

    /// Returns the number of elements.
    public func len(&self) -> Int {
        self.length
    }

    /// Returns whether the vector holds no elements.
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Lends the element at `index` where it sits.
    ///
    /// A read of `v[i]` copies the element out, and a write replaces it in
    /// place. Panics if `index` is outside `0..<len()`.
    @synthesize(shared)
    public func [](&var self, index: Int) unsafe borrows -> &var T {
        if index < 0 || index >= self.length {
            panic("Vector.[]: index out of range: {} (len {})", index, self.length)
        }
        guard let buf = self.buffer else {
            panic("Vector.[]: buffer is empty")
        }
        lend buf[index]
    }

    /// Lends the element at `index` where it sits, or nothing when `index` is
    /// outside `0..<len()`.
    ///
    /// The absent path opens no window, so the vector is free to use there.
    @synthesize(shared)
    public func find(&var self, index: Int) unsafe borrows -> &var T? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        lend buf[index]
    }

    /// Replaces the element at `index`, destroying the one it overwrites.
    /// Panics if `index` is outside `0..<len()`; `value` is consumed either
    /// way.
    public func set(&var self, index: Int, value: T) unsafe {
        if index < 0 || index >= self.length {
            panic("Vector.set: index out of range: {} (len {})", index, self.length)
        }
        if let buf = self.buffer {
            let old = move buf[index]
            buf[index] = move value
            let _ = move old
        }
    }

    // A dynamic-index exchange the Law of Exclusivity must refuse as
    // `swap(&v[i], &v[j])`. It is byte-level, with no element-typed temporary,
    // so no retain or deinit runs and `T` needs no bound.
    /// Exchanges the elements at `i` and `j`.
    ///
    /// The two values change slots without a copy or a deinit, so any element
    /// type swaps, a NoCopy one included. Swapping an index with itself does
    /// nothing. Panics if either index is outside `0..<len()`.
    public func swap(&var self, i: Int, j: Int) unsafe {
        if i == j {
            return
        }
        // Checked one at a time so the message names the index that is out.
        if i < 0 || i >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", i, self.length)
        }
        if j < 0 || j >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", j, self.length)
        }
        if let buf = self.buffer {
            let size = sizeof<T>()
            let first = (&buf[i]) as UnsafePointer<Int8>
            let second = (&buf[j]) as UnsafePointer<Int8>
            var k = 0
            while k < size {
                let held = first[k]
                first[k] = second[k]
                second[k] = held
                k = k + 1
            }
        }
    }

    /// Replaces the element at `index` with `value` and returns the element
    /// it held, which the caller now owns.
    ///
    /// Panics if `index` is outside `0..<len()`; `value` is consumed either
    /// way.
    public func swap_out(&var self, index: Int, value: T) unsafe -> T {
        if index < 0 || index >= self.length {
            panic("Vector.swap_out: index out of range: {} (len {})", index, self.length)
        }
        guard let buf = self.buffer else {
            panic("Vector.swap_out: buffer is empty")
        }
        let old = move buf[index]
        buf[index] = move value
        move old
    }

    /// Appends `value`.
    ///
    /// Returns `Err(AllocError)` when the buffer must grow and `A` refuses; the
    /// vector is then unchanged and `value` is destroyed.
    public func push(&var self, value: T) unsafe -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self.reserve_slots(wanted) {
            return AllocError(size: self.grow_target(wanted) * sizeof<T>(), align: alignof<T>())
        }
        guard let buf = self.buffer else {
            panic("Vector.push: buffer is empty")
        }
        // The slot at `length` is uninitialized, so this placement releases
        // no prior occupant.
        buf[self.length] = move value
        self.length = self.length + 1
        return
    }

    /// Makes room for `additional` more elements, so that many pushes cannot
    /// fail. Returns `Err(AllocError)` when `A` refuses. Panics if
    /// `additional` is negative.
    public func reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        if additional < 0 {
            panic("Vector.reserve: additional {} is negative", additional)
        }
        let wanted = self.length + additional
        if not self.reserve_slots(wanted) {
            return AllocError(size: self.grow_target(wanted) * sizeof<T>(), align: alignof<T>())
        }
        return
    }

    /// Removes the last element and returns it, or `None` when the vector is
    /// empty.
    public func pop(&var self) unsafe -> T? {
        if self.length == 0 {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        self.length = self.length - 1
        // The slot is past the new length, so ownership leaves here.
        move buf[self.length]
    }

    /// Removes every element, destroying each, last first, and keeps the
    /// capacity.
    public func clear(&var self) {
        while self.length > 0 {
            let _ = self.pop()
        }
    }

    // The capacity a growth to `wanted` elements allocates: double, from a
    // floor, unless more was asked for.
    func grow_target(&self, wanted: Int) -> Int {
        let doubled = if self.capacity == 0 { FIRST_SLOTS } else { self.capacity * 2 }
        if doubled < wanted {
            wanted
        } else {
            doubled
        }
    }

    // Makes room for `wanted` elements. False means `A` refused and the
    // vector is untouched, which every caller relies on to report
    // all-or-nothing.
    func reserve_slots(&var self, wanted: Int) unsafe -> Bool {
        if self.capacity >= wanted {
            return true
        }
        let target = self.grow_target(wanted)
        guard let fresh = A().alloc(target * sizeof<T>(), alignof<T>()) else {
            return false
        }
        if let old = self.buffer {
            // Each element changes address, so a growth is refused where it
            // is instantiated at a `NoMove` element (spec, Placement into
            // heap storage).
            let slots = fresh as UnsafePointer<T>
            var i = 0
            while i < self.length {
                slots[i] = move old[i]
                i = i + 1
            }
            A().dealloc(old as UnsafePointer<Int8>, self.capacity * sizeof<T>(), alignof<T>())
        }
        self.buffer = fresh as UnsafePointer<T>
        self.capacity = target
        true
    }
}

// Each closure is non-escaping, so it may capture enclosing locals by
// reference, and is lent the element as `&T` where it sits, so no method
// carries a copy bound. The vector is held for the whole call, so the closure
// cannot grow it under a lent element.
extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Calls `body` with each element in order, lent as `&T`.
    ///
    /// Nothing is copied, so a move-only element type is visitable.
    public func each(&self, body: (&T) -> Void) unsafe {
        guard let buf = self.buffer else {
            return
        }
        var i = 0
        while i < self.length {
            body(&buf[i])
            i = i + 1
        }
    }

    /// Calls `body` with each index and its element, lent as `&T`, in order.
    public func each_indexed(&self, body: (Int, &T) -> Void) unsafe {
        guard let buf = self.buffer else {
            return
        }
        var i = 0
        while i < self.length {
            body(i, &buf[i])
            i = i + 1
        }
    }

    /// Returns a new vector of `transform`'s result for each element, in
    /// order, allocated through the same `A`.
    ///
    /// The element is lent to `transform` as `&T`. Returns `Err(AllocError)`
    /// when the new vector cannot grow; the partial result is destroyed.
    public func map<U>(&self, transform: (&T) -> U) unsafe -> Result<Vector<U, A>, AllocError> {
        var result = Vector<U, A>()
        guard let buf = self.buffer else {
            return move result
        }
        var i = 0
        while i < self.length {
            try result.push(transform(&buf[i]))
            i = i + 1
        }
        return move result
    }

    // The accumulator moves through `combine` at every step, so an
    // ExplicitCopy one is never duplicated. It is `Acc` because `A` is the
    // allocator.
    /// Folds the elements from first to last: each call of `combine` takes the
    /// accumulator so far and the element, lent as `&T`, and returns the next
    /// accumulator. Returns the last one, or `initial` when the vector is
    /// empty.
    public func fold<Acc>(&self, initial: Acc, combine: (Acc, &T) -> Acc) unsafe -> Acc {
        var acc = move initial
        guard let buf = self.buffer else {
            return move acc
        }
        var i = 0
        while i < self.length {
            acc = combine(move acc, &buf[i])
            i = i + 1
        }
        move acc
    }

    // The same insertion sort as `sort`, but the comparands are lent where
    // they sit, so `T` needs no copy bound.
    /// Sorts the elements in place by `compare`, which is lent the two
    /// comparands as `&T`.
    ///
    /// The sort is stable: equal elements keep their order.
    public func sort_by(&var self, compare: (&T, &T) -> Ordering) unsafe {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 {
                guard let left = self.buffer else {
                    return
                }
                let right = left
                if compare(&left[j - 1], &right[j]) != Ordering.Greater {
                    break
                }
                self.swap(j - 1, j)
                j = j - 1
            }
            i = i + 1
        }
    }
}

// `get` copies an element out, so the bound is declared where a caller reads
// it rather than inferred from the body.
extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    /// Returns a copy of the element at `index`, or `None` when `index` is
    /// outside `0..<len()`.
    ///
    /// The element must be Copy; `find` reaches any element where it sits.
    public func get(&self, index: Int) unsafe -> T? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let buf = self.buffer else {
            return None
        }
        buf[index]
    }

    // `next()` hands the consumer an owned element, so a bitwise read of an
    // owning element would give it two owners. The iterator borrows the vector
    // itself, not its buffer, so the `for` statement is its window and a
    // mutation in the body is an exclusivity error.
    /// Returns an iterator over the vector's elements (`for x in v.iter()`).
    ///
    /// Each element is yielded as an owned copy, which is what requires
    /// `T: Copy`. The iterator borrows the vector for the whole loop, so the
    /// body may read it but not add to it, remove from it or replace it.
    public func iter(&self) borrows -> VectorIterator<T, A> {
        VectorIterator<T, A>(vector: lends self, index: 0)
    }

    /// Returns an iterator yielding `(index, element)` pairs.
    ///
    /// Because elements are yielded by value, `T` must be `Copy`. Like
    /// `iter()`, it borrows the vector for the whole loop.
    public func enumerated(&self) borrows -> EnumeratedIterator<T, A> {
        EnumeratedIterator<T, A>(vector: lends self, index: 0)
    }
}

extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    /// Duplicates the vector and every element through the same allocator.
    ///
    /// Panics if `A` refuses: `copy()` is the ExplicitCopy hook, whose
    /// signature has no error channel.
    public func copy(&self) unsafe -> Vector<T, A> {
        var result = Vector<T, A>()
        if not result.reserve_slots(self.length) {
            panic("Vector.copy: {}", AllocError(size: self.length * sizeof<T>(), align: alignof<T>()))
        }
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                match result.push(buf[i].copy()) {
                    case Ok(_) -> {},
                    case Err(e) -> panic("Vector.copy: {}", e)
                }
                i = i + 1
            }
        }
        move result
    }

    // The copy policy is the type's for every `T`, a move-only element's
    // included, so this is every vector's destructor though the conformance's
    // `copy()` exists only where `T` is ExplicitCopy. Elements popped or moved
    // out have left `length`, so they are never visited; the buffer goes back
    // to this vector's own `A`.
    public func deinit(&var self) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                drop_in_place((&buf[i]) as UnsafePointer<T>)
                i = i + 1
            }
            let raw = buf as UnsafePointer<Int8>
            A().dealloc(raw, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// The reporting twin of `copy`; its `try_` name awaits DF-257b's ruling.
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the vector and every element through the same allocator.
    ///
    /// Returns `Err(AllocError)` when `A` refuses. The whole buffer is
    /// reserved first, so the result is a complete copy or nothing.
    public func try_copy(&self) unsafe -> Result<Vector<T, A>, AllocError> {
        var result = Vector<T, A>()
        try result.reserve(self.length)
        guard let buf = self.buffer else {
            return move result
        }
        var i = 0
        while i < self.length {
            // The reservation holds every element, so this push allocates
            // nothing.
            try result.push(buf[i].copy())
            i = i + 1
        }
        return move result
    }
}

// Insertion sort: no scratch buffer, and stable because an element moves only
// past a strictly greater predecessor. Elements move by the byte-level `swap`,
// so none is duplicated; the comparands are read by value, hence `T: Copy`.
extension Vector<T: Comparable + Copy, A: Allocator = GlobalAllocator> {
    /// Sorts the elements in ascending order by `T`'s `Comparable` order.
    ///
    /// The sort is stable: equal elements keep their order.
    public func sort(&var self) {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 && self.greater_at(j - 1, j) {
                self.swap(j - 1, j)
                j = j - 1
            }
            i = i + 1
        }
    }

    func greater_at(&self, i: Int, j: Int) -> Bool {
        if let a = self.get(i) {
            if let b = self.get(j) {
                return a > b
            }
        }
        false
    }
}

// Holds the vector itself, lent, and reads `length` and `buffer` through it on
// every `next()`. Lend the root, never the buffer: a snapshot of the buffer
// pointer is what the vector can invalidate (SL-321).
//
// `public` only because `Vector.iter()` is public and a public signature may
// not name a private type; a borrowing struct cannot be held, so its only use
// is the head of a `for`.
/// The iterator `Vector.iter()` returns; it lives only as the head of a `for`.
public borrows struct VectorIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// `next()` yields an element the consumer owns, so it spells `.copy()`; a bare
// slot read would be a second owner. The bound is `ExplicitCopy` because the
// body spells the copy; `iter()` keeps the stricter `T: Copy` at the producer.
extension VectorIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = T

    /// Returns a copy of the next element, or `None` past the last one.
    public func next(&var self) unsafe -> T? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                buf[idx].copy()
            } else {
                None
            }
        } else {
            None
        }
    }
}

// Same shape and visibility reason as `VectorIterator`.
/// The iterator `Vector.enumerated()` returns; it lives only as the head of a
/// `for`.
public borrows struct EnumeratedIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// The yielded pair owns its element: `.copy()` for the same reason as above.
extension EnumeratedIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = (Int, T)

    /// Returns the next index paired with a copy of its element, or `None`
    /// past the last one.
    public func next(&var self) unsafe -> (Int, T)? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                (idx, buf[idx].copy())
            } else {
                None
            }
        } else {
            None
        }
    }
}
