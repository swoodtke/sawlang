        to.write_int(self)
    }
}

extension Int64: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<Int64, DecodeError> {
        from.read_int()
    }
}

extension UInt: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        to.write_uint(self as UInt64)
    }
}

extension UInt: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<UInt, DecodeError> {
        let v = try from.read_uint_max(max: UInt.max as UInt64)
        return v as UInt
    }
}

extension UInt8: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
