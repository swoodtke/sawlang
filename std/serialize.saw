extension UInt16: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        to.write_uint(self as UInt64)
    }
}

extension UInt16: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<UInt16, DecodeError> {
        let v = try from.read_uint_max(max: UInt16.max as UInt64)
        return v as UInt16
    }
