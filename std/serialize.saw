// An absent Optional is the null item.
extension Optional<T: Serialize>: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        match self {
            case Some(borrow let v) -> v.serialize(to: &var to),
            case None -> to.write_null()
        }
    }
}

extension Optional<T: Deserialize>: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<T?, DecodeError> {
        if try from.at_null() {
            try from.read_null()
            return None
        }
        let v = try T.deserialize(from: &var from)
        return move v
    }
}

// A vector is an array of its items.
extension Vector<T: Serialize, A: Allocator = GlobalAllocator>: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        let n = self.len()
        try to.begin_array(n)
        var i = 0
        while i < n {
            try borrow self[i].serialize(to: &var to)
            i = i + 1
        }
        return
    }
}

extension Vector<T: Deserialize, A: Allocator = GlobalAllocator>: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<Vector<T, A>, DecodeError> {
        let n = try from.begin_array()
        var out = Vector<T, A>()
        var i = 0
        while i < n {
            let v = try T.deserialize(from: &var from)
            match out.push(move v) {
                case Ok(_) -> {},
                case Err(_) -> { return DecodeError(offset: from.offset(), fault: DecodeFault.Alloc) }
            }
            i = i + 1
        }
        return move out
    }
}
