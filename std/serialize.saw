extension UInt64: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        to.write_uint(self)
    }
}

extension UInt64: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<UInt64, DecodeError> {
