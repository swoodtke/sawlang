//! `Command`: a program run as a child process, and waited for.
//!
//! The child is spawned with a real argument vector, never a shell command
//! line, so each argument reaches it as one element, whatever bytes it holds.
//! `wait` blocks the calling thread until the child exits and never suspends.
//! `output` is cooperative: it parks the task on the child's pipe and on its
//! exit, so siblings run for the child's whole life. `env` sets a variable in
//! the child's environment only. A `Command` holds no
//! process, so its deinit has nothing to wait for (SL:hazards S28).
//!
//! A wait that is cancelled leaves its child running. The child's record is
//! kept on a process-wide list, and each later spawn reaps the children on it
//! that have exited, so a cancelled `output` leaves no zombie behind.

import std.data.{Data}
import std.mutex.{Mutex}
import std.systemerror.{SystemError, SystemErrorKind, system_error_kind}
import std.task.{io_wait, sleep, yield_now}

extern "C" {
    // A job handle (`> 0`) or a negated portable tag; `argv` is the program's
    // name, then its arguments, then NULL (runtime/ABI.md, "Process spawn").
    func __saw_rt_proc_spawn(path: UnsafePointer<Int8>, argv: UnsafePointer<UnsafePointer<Int8>>, flags: Int) -> Int
    // The same spawn with `envp`, a NULL-terminated array of `NAME=VALUE`
    // entries the child gets on top of this process's environment, each
    // replacing an inherited variable of its name.
    func __saw_rt_proc_spawn_env(path: UnsafePointer<Int8>, argv: UnsafePointer<UnsafePointer<Int8>>, envp: UnsafePointer<UnsafePointer<Int8>>, flags: Int) -> Int
    // The raw POSIX wait status of a child that has exited, `-WouldBlock`
    // while it runs, or another negated tag; every answer but `-WouldBlock`
    // destroys the job.
    func __saw_rt_proc_try_wait(job: Int) -> Int
    // Reads up to `len` bytes of the child's captured stdout: the count (0 at
    // end of stream) or a negated tag. The pipe blocks for as long as the child
    // stays silent, so the call is offloaded to a worker thread and the task
    // parks; `buf` outlives the call, which a cancelled task still waits for.
    blocking func __saw_rt_proc_read_stdout(job: Int, buf: UnsafePointer<Int8>, len: Int) -> Int
    // A descriptor readable once the child has exited, owned by the job, or a
    // negated tag when this child cannot be waited for by descriptor.
    func __saw_rt_proc_wait_fd(job: Int) -> Int
    // Drops the job without waiting: the child keeps running, and one that
    // exits later is never reaped. Std calls it when a drain fails, which
    // must close the pipe, and when the orphan list cannot take the job.
    func __saw_rt_proc_release(job: Int)
    // Parks the calling thread for the given nanoseconds.
    func __saw_rt_sleep_ns(ns: UInt64)
    // The io budget (runtime/common/op_budget.saw): a tick answers nonzero
    // once a run of operations that never parked has used the budget up.
    func __saw_rt_op_budget_tick() -> Int
    func __saw_rt_op_budget_reset()
}

// The spawn seam's redirection bits (runtime/ABI.md, "Process spawn"). With
// none set, the child inherits standard input, output and error.
static NO_REDIRECTION: Int = 0
// The child's standard output goes into a pipe the job owns.
static CAPTURE_STDOUT: Int = 1
// The child's standard error goes wherever its standard output goes.
static MERGE_STDERR: Int = 2
// The exit code the spawn's child reports when it cannot execute the program.
static EXEC_FAILED: Int32 = 127
// The poll interval of `wait`, in nanoseconds: short at first, since most
// children are quick, doubling to a ceiling that bounds how late an exit is
// noticed.
static POLL_START_NS: UInt64 = 1_000_000
static POLL_MAX_NS: UInt64 = 32_000_000
// The same poll for a parked wait, in milliseconds, used only when the host
// cannot hand out a wait descriptor for the child.
static PARK_POLL_START_MS: UInt64 = 1
static PARK_POLL_MAX_MS: UInt64 = 32
static ARGV_END_BYTE: Int8 = 0
// `=`, which ends an environment entry's name, so a name may not hold one.
static NAME_END: Byte = 61
// The most one read of the child's stdout takes.
static DRAIN_CHUNK: Int = 4096
// The answer of a drain that std itself refused, by the growth of the captured
// bytes. It is below every negated tag, so it never collides with one.
static DRAIN_REFUSED: Int = -1000
// The exit-wait descriptor is waited on for reading, with no deadline.
static READ_INTEREST: Int = 0
static PARK_NO_DEADLINE: UInt64 = 0
// The first capacity of the orphan list, in jobs.
static ORPHANS_FIRST_CAPACITY: Int = 8

// The jobs whose child was still running when the wait for it ended. Zero is
// the empty list, so a static holds it with no initializer.
struct ProcessOrphans {
    // The address of a heap block of `capacity` job handles, 0 while none.
    jobs: Int
    count: Int
    capacity: Int
}

// Guarded by a `Mutex`: spawns run on any thread, and the sweep only polls, so
// the lock is never held across a wait.
static PROCESS_ORPHANS: Mutex<ProcessOrphans>

/// A program to run as a child process, with its arguments.
public struct Command {
    private program: String
    private args: Vector<String>
    // Whether the child's standard error follows its standard output.
    private merged_stderr: Bool
    // The child's environment overrides, one `NAME=VALUE` entry per name.
    private environment: Vector<String>
    // Whether `env` was given a name or value no environment entry can
    // carry, which the spawn reports.
    private bad_environment: Bool
}

/// What a command that ran to completion printed on standard output, and how
/// it exited.
public struct CommandOutput {
    /// The child's standard output, decoded as UTF-8.
    stdout: String
    /// The child's exit code: 128 plus the signal's number for a child a
    /// signal killed, so only a normal exit with code 0 is 0.
    exit_code: Int32
}

extension CommandOutput {
    /// Returns whether the child exited with code 0.
    public func success(&self) -> Bool {
        self.exit_code == 0
    }
}

extension Command {
    /// Creates a command that runs `program`, found on `PATH` when it names no
    /// directory, with no arguments.
    public init(program: String) -> Command {
        Command(program: program, args: Vector<String>(), merged_stderr: false,
                environment: Vector<String>(), bad_environment: false)
    }

    /// Adds one argument, which the child receives as exactly one element of
    /// its argument vector.
    ///
    /// Returns `Err(AllocError)` when the argument list cannot grow.
    public func arg(&var self, argument: String) -> Result<Void, AllocError> {
        self.args.push(argument)
    }

    /// Sets the environment variable `name` to `value` for the child only;
    /// this process's own environment is unchanged.
    ///
    /// The child inherits this process's environment, with each variable set
    /// here added or replacing the inherited value. Setting one name twice
    /// keeps the later value, so the child sees each name once. Like an
    /// argument, the name and value reach the child as given, with nothing
    /// expanded.
    ///
    /// Returns `Err(AllocError)` when the entry cannot be stored. A name that
    /// is empty or holds `=`, or a name or value holding a NUL byte, is no
    /// environment entry, and `wait()` and `output()` then report
    /// `InvalidArgument` without launching anything.
    public func env(&var self, name: String, value: String) -> Result<Void, AllocError> {
        if name.is_empty() || name.contains("=") || process_holds_nul(name) || process_holds_nul(value) {
            self.bad_environment = true
            return
        }
        var entry = StringBuilder()
        try entry.append(name)
        try entry.append("=")
        try entry.append(value)
        let text = entry.build()
        var i = 0
        while i < self.environment.len() {
            let existing = self.environment.get(i) ?? ""
            if process_names(existing, name) {
                self.environment.set(i, text)
                return
            }
            i = i + 1
        }
        self.environment.push(text)
    }

    /// Sends the child's standard error wherever its standard output goes: into
    /// the captured text under `output()`, and to this process's own standard
    /// output under `wait()`, as `2>&1` does in a shell.
    ///
    /// Without it, `output()` captures standard output while standard error
    /// still reaches the terminal. The capture holds both streams in the order
    /// the child wrote them.
    public func merge_stderr(&var self) {
        self.merged_stderr = true
    }

    /// Runs the program and blocks the calling thread until it exits, and
    /// returns its exit code.
    ///
    /// A child killed by a signal reports 128 plus the signal's number, so it
    /// never reads as success. Returns `Err(SystemError)` when the program
    /// cannot be launched: the spawn's cause, `LaunchFailed` when the child
    /// cannot execute it, and `InvalidArgument` for a program or argument
    /// holding a NUL byte, which no argument vector can carry, or for a
    /// variable `env` could not set (see `env`). A program
    /// that itself exits 127 reads as `LaunchFailed` too.
    public func wait(&self) unsafe -> Result<Int32, SystemError> {
        let flags = self.redirection(false)
        let job = try self.spawned(flags)
        let status = process_reaped(job)
        if status < 0 {
            return SystemError.of("wait", 0 - status)
        }
        let code = process_exit_code(status)
        if code == EXEC_FAILED {
            return SystemError.raised("exec", SystemErrorKind.LaunchFailed)
        }
        code
    }

    /// Runs the program and captures its standard output, parking the task
    /// until the child exits.
    ///
    /// Cooperative: the drain parks on the child's pipe and the wait on its
    /// exit, so sibling tasks run for the child's whole life and no executor
    /// thread waits. A `sync` function cannot call it, and neither can a
    /// `Thread.spawn` body, which has no executor to resume a parked task.
    ///
    /// The child's standard error is inherited unless `merge_stderr()` was
    /// called. Returns the captured text and the exit code (see
    /// `CommandOutput`), or `Err(SystemError)` when no complete output exists:
    /// the causes `wait()` reports (a program that itself exits 127 reads as
    /// `LaunchFailed` too, as it does there), a read of the child's pipe that failed,
    /// standard output that is not UTF-8 (`InvalidArgument`), and a capture
    /// that could not grow (`ResourcesExhausted`). A task cancelled while it
    /// waits for the child to exit gets `Interrupted`: cancellation ends the
    /// wait, not the child, which keeps running; a later spawn reaps it once it
    /// has exited. A read of the pipe is not cut short, so the cancel is seen
    /// once the child closes it.
    public func output(&self) unsafe -> Result<CommandOutput, SystemError> {
        let flags = self.redirection(true)
        let job = try self.spawned(flags)
        let data = match process_drained(job) {
            case Ok(bytes) -> bytes,
            case Err(failure) -> {
                // A pipe that cannot be read leaves a child that may never
                // exit, so dropping the job beats waiting on it. Release closes
                // the pipe, so a child still writing dies of SIGPIPE, which an
                // orphaned job holding the read end open would not do; std has
                // no seam to close it alone.
                __saw_rt_proc_release(job)
                return failure
            }
        }
        // The park loop is this body's own, not a helper's: a refusal in a
        // thread body names `Command.output` and the primitive it parks on.
        // The task waits on the child's wait descriptor, and a child the host
        // cannot hand one for is polled on a doubling sleep of the task.
        var nap = PARK_POLL_START_MS
        var status = __saw_rt_proc_try_wait(job)
        while process_running(status) {
            if cancelled() {
                process_abandon(job)
                return SystemError.raised("output", SystemErrorKind.Interrupted)
            }
            let descriptor = __saw_rt_proc_wait_fd(job)
            if descriptor >= 0 {
                match io_wait(descriptor, READ_INTEREST, PARK_NO_DEADLINE) {
                    case Cancelled -> {
                        process_abandon(job)
                        return SystemError.raised("output", SystemErrorKind.Interrupted)
                    },
                    case _ -> {
                        // A park ceded to the scheduler, so the run of
                        // operations that never parked starts over.
                        __saw_rt_op_budget_reset()
                    }
                }
            } else {
                sleep(Duration.ms(nap))
                if nap < PARK_POLL_MAX_MS {
                    nap = nap * 2
                }
            }
            status = __saw_rt_proc_try_wait(job)
        }
        // A wait that never parked must not keep its siblings from running.
        if __saw_rt_op_budget_tick() != 0 {
            yield_now()
        }
        if status < 0 {
            return SystemError.of("wait", 0 - status)
        }
        let code = process_exit_code(status)
        if code == EXEC_FAILED {
            return SystemError.raised("exec", SystemErrorKind.LaunchFailed)
        }
        match data.to_string() {
            case Ok(text) -> CommandOutput(stdout: text, exit_code: code),
            case Err(_) -> SystemError.raised("output", SystemErrorKind.InvalidArgument)
        }
    }

    // The redirection bits a spawn asks for: the pipe when `capture`, and the
    // merge when `merge_stderr()` was called.
    func redirection(&self, capture: Bool) -> Int {
        var flags = NO_REDIRECTION
        if capture {
            flags = flags | CAPTURE_STDOUT
        }
        if self.merged_stderr {
            flags = flags | MERGE_STDERR
        }
        flags
    }

    // Spawns the child with `flags` and returns its job handle, or the cause
    // the spawn gave.
    func spawned(&self, flags: Int) unsafe -> Result<Int, SystemError> {
        if process_holds_nul(self.program) || self.bad_environment {
            return SystemError.raised("spawn", SystemErrorKind.InvalidArgument)
        }
        let count = self.args.len()
        let slots = count + 2
        let size = slots * sizeof<UnsafePointer<Int8>>()
        let align = alignof<UnsafePointer<Int8>>()
        guard let block = GlobalAllocator().alloc(size, align) else {
            return SystemError.raised("spawn", SystemErrorKind.ResourcesExhausted)
        }
        let argv = block as UnsafePointer<UnsafePointer<Int8>>
        argv[0] = self.program.c_bytes()
        var i = 0
        while i < count {
            let argument = self.args.get(i) ?? ""
            if process_holds_nul(argument) {
                GlobalAllocator().dealloc(block, size, align)
                return SystemError.raised("spawn", SystemErrorKind.InvalidArgument)
            }
            argv[i + 1] = argument.c_bytes()
            i = i + 1
        }
        // The NULL that ends the vector, written as zero bytes: there is no
        // null-pointer literal.
        var k = 0
        let end = (slots - 1) * sizeof<UnsafePointer<Int8>>()
        while k < sizeof<UnsafePointer<Int8>>() {
            block[end + k] = ARGV_END_BYTE
            k = k + 1
        }
        process_sweep()
        let answer = self.spawn_seam(argv, flags)
        GlobalAllocator().dealloc(block, size, align)
        answer
    }

    // Spawns through the plain seam, or, for a command with environment
    // overrides, through the one that takes an `envp` built from them.
    func spawn_seam(&self, argv: UnsafePointer<UnsafePointer<Int8>>, flags: Int) unsafe -> Result<Int, SystemError> {
        if self.environment.is_empty() {
            let job = __saw_rt_proc_spawn(self.program.c_bytes(), argv, flags)
            if job < 0 {
                return SystemError.of("spawn", 0 - job)
            }
            return job
        }
        let count = self.environment.len()
        let slots = count + 1
        let size = slots * sizeof<UnsafePointer<Int8>>()
        let align = alignof<UnsafePointer<Int8>>()
        guard let block = GlobalAllocator().alloc(size, align) else {
            return SystemError.raised("spawn", SystemErrorKind.ResourcesExhausted)
        }
        let envp = block as UnsafePointer<UnsafePointer<Int8>>
        var i = 0
        while i < count {
            let entry = self.environment.get(i) ?? ""
            envp[i] = entry.c_bytes()
            i = i + 1
        }
        // The NULL that ends the array, as `argv`'s is written.
        var k = 0
        let end = count * sizeof<UnsafePointer<Int8>>()
        while k < sizeof<UnsafePointer<Int8>>() {
            block[end + k] = ARGV_END_BYTE
            k = k + 1
        }
        let job = __saw_rt_proc_spawn_env(self.program.c_bytes(), argv, envp, flags)
        if job < 0 {
            let failure = SystemError.of("spawn", 0 - job)
            GlobalAllocator().dealloc(block, size, align)
            return move failure
        }
        GlobalAllocator().dealloc(block, size, align)
        job
    }
}

// Ends the wait for `job`'s child without ending the child. A child that has
// exited is reaped here; one still running goes on the orphan list for a later
// sweep. The list's block cannot grow only when the allocator refuses, and then
// the job is released, which leaves that one exit unreaped.
func process_abandon(job: Int) unsafe {
    if not process_running(__saw_rt_proc_try_wait(job)) {
        return
    }
    let kept = borrow var orphans = PROCESS_ORPHANS.lock() {
        orphans_push(&var orphans, job)
    }
    if not kept {
        __saw_rt_proc_release(job)
    }
}

// Reaps every orphan whose child has exited. Only polls, so a running child
// costs one `waitpid` and nothing waits.
func process_sweep() unsafe {
    borrow var orphans = PROCESS_ORPHANS.lock() {
        orphans_sweep(&var orphans)
    }
}

// Adds `job` to the list, growing its block; false when the block cannot grow.
func orphans_push(list: &var ProcessOrphans, job: Int) unsafe sync -> Bool {
    if list.count == list.capacity {
        var wider = ORPHANS_FIRST_CAPACITY
        if list.capacity > 0 {
            wider = list.capacity * 2
        }
        let size = wider * sizeof<Int>()
        let align = alignof<Int>()
        guard let block = GlobalAllocator().alloc(size, align) else {
            return false
        }
        let fresh = block as UnsafePointer<Int>
        let old = list.jobs as UnsafePointer<Int>
        var i = 0
        while i < list.count {
            fresh[i] = old[i]
            i = i + 1
        }
        if list.capacity > 0 {
            GlobalAllocator().dealloc(old as UnsafePointer<Int8>, list.capacity * sizeof<Int>(), align)
        }
        list.jobs = fresh as Int
        list.capacity = wider
    }
    let jobs = list.jobs as UnsafePointer<Int>
    jobs[list.count] = job
    list.count = list.count + 1
    true
}

// Drops each orphan whose child has exited (the poll reaps it and destroys the
// job), keeping the running ones in order, and frees the block once it is empty.
func orphans_sweep(list: &var ProcessOrphans) unsafe sync {
    if list.count == 0 {
        return
    }
    let jobs = list.jobs as UnsafePointer<Int>
    var kept = 0
    var i = 0
    while i < list.count {
        let job = jobs[i]
        if process_running(__saw_rt_proc_try_wait(job)) {
            jobs[kept] = job
            kept = kept + 1
        }
        i = i + 1
    }
    list.count = kept
    if kept == 0 {
        GlobalAllocator().dealloc(jobs as UnsafePointer<Int8>, list.capacity * sizeof<Int>(), alignof<Int>())
        list.jobs = 0
        list.capacity = 0
    }
}

// The raw wait status of `job`'s child once it has exited, or the negated tag
// of a failing reap, polling on a doubling sleep of the calling thread.
func process_reaped(job: Int) unsafe -> Int {
    var nap = POLL_START_NS
    var answer = __saw_rt_proc_try_wait(job)
    while process_running(answer) {
        __saw_rt_sleep_ns(nap)
        if nap < POLL_MAX_NS {
            nap = nap * 2
        }
        answer = __saw_rt_proc_try_wait(job)
    }
    answer
}

// Everything the child writes to its captured stdout, read until it closes the
// pipe. Each read lands in the captured bytes' own spare room, which the worker
// thread writes while the task is parked: the block is heap storage, so it
// outlives the call, and no raw pointer stays in the suspended frame (a
// multi-threaded group must be able to move the frame). A read that fails is
// the failure, never the bytes read before it.
func process_drained(job: Int) unsafe -> Result<Data, SystemError> {
    var collected = Data()
    var refusal = 0
    var draining = true
    while draining {
        match collected.reserve(DRAIN_CHUNK) {
            case Ok(_) -> {},
            case Err(_) -> {
                refusal = DRAIN_REFUSED
                draining = false
            }
        }
        if draining {
            let n = __saw_rt_proc_read_stdout(job, collected.spare(), DRAIN_CHUNK)
            if n > 0 {
                collected.grow(n)
            } else {
                if n < 0 {
                    refusal = n
                }
                draining = false
            }
        }
    }
    if refusal == DRAIN_REFUSED {
        return SystemError.raised("read", SystemErrorKind.ResourcesExhausted)
    }
    if refusal < 0 {
        // The worker thread classified the failure, so no raw code is stamped
        // on this one.
        return SystemError.raised("read", system_error_kind(0 - refusal))
    }
    collected
}

// Whether a reap's answer says the child is still running: `-WouldBlock`.
func process_running(answer: Int) -> Bool {
    if answer >= 0 {
        return false
    }
    match system_error_kind(0 - answer) {
        case WouldBlock -> true,
        case _ -> false
    }
}

// The exit code a raw POSIX wait status stands for, as a shell reports it:
// the exit byte for a normal exit, 128 plus the signal for a child a signal
// killed, and 128 plus the stop signal for a stopped one, so only a normal
// exit 0 is 0.
func process_exit_code(status: Int) -> Int32 {
    let low = status & 0x7F
    let high = (status >> 8) & 0xFF
    if low == 0 {
        Int32.from(truncating: high)
    } else if low == 0x7F {
        Int32.from(truncating: 128 + high)
    } else {
        Int32.from(truncating: 128 + low)
    }
}

// Whether the `NAME=VALUE` entry is the one for `name`: `PATH=/bin` names
// `PATH` and not `PAT`.
func process_names(entry: String, name: String) -> Bool {
    let n = name.len()
    entry.len() > n && entry.byte_at(n) == NAME_END && entry.starts_with(name)
}

// Whether `text` holds a NUL byte, which would end its C string early.
func process_holds_nul(text: String) -> Bool {
    var i = 0
    while i < text.len() {
        if text.byte_at(i) == 0 {
            return true
        }
        i = i + 1
    }
    false
}

extension Command: NoCopy {}
