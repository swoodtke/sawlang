// main spawns a child, then runs its own sleep loop: the child runs eagerly
// whenever main parks, so the two loops' output interleaves. Both sleep 10 ms
// and main sleeps first in each round, so its deadline is the earlier one, and
// expired sleepers wake earliest deadline first; that fixes the order whether
// the executor looks between the two deadlines or after both.
// EXPECT: success
// EXPECT-OUTPUT:
// 0
// 100
// 1
// 101
// 2
// 102
// 7

func child() -> Int {
    var i = 100
    while i < 103 {
        print(i)
        sleep(Duration.ms(10))
        i = i + 1
    }
    return 7
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(child())
    var i = 0
    while i < 3 {
        print(i)
        sleep(Duration.ms(10))
        i = i + 1
    }
    print(h.join())
}
