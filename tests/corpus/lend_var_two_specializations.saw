// An accessor whose shared and exclusive bodies differ is written twice
// (SL:borrowing §4): a `&self` accessor that runs no gate and a `&var self`
// accessor that runs it. Each is an ordinary body, and the declared receiver
// says which roots may call it (§3).
//
// Neither body tests which flavor it serves: there is no mode test inside one
// body (§9), so the gate is in the tree of the exclusive accessor alone, and
// the shared accessor is an honestly non-mutating `&self` body that a `let`
// root may call.
//
// What this pins: a pure READ, the getitem derived from the shared accessor
// (§5.2), works through a `let` root and a `&Grid` and runs no gate at all. A
// WRITE is the setitem derived from the exclusive accessor, so it runs the gate
// exactly once and needs a `var` root. A compound write is a getitem then a
// setitem (§5.1), so it too runs the gate once.
// EXPECT: success
// EXPECT-OUTPUT:
// shared read through a let root: 3
// gates after that read: 0
// second shared read: 4
// gates still: 0
// after a write: cell 99, gates 1
// after a compound write: cell 7, gates 2
// forwarded read: 7, gates 2
// -- done

struct Grid {
    cells: [Int; 4],
    gates: Int
}

extension Grid {
    // The flavor-dependent work. It is `&var self`, so naming it at all is what
    // makes a body a mutating one, which is why only the exclusive accessor
    // calls it: the shared accessor is checked as a `&self` body and could not
    // contain this call.
    func run_gate(&var self) {
        self.gates = self.gates + 1
    }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 {
            panic("Grid.[]: index out of range")
        }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 {
            panic("Grid.[]: index out of range")
        }
        self.run_gate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int {
        self.gates
    }
}

// A `&Grid` parameter is the same shared receiver a `let` root is, so a read
// through one goes through the shared accessor too.
func forwarded_read(g: &Grid) -> Int {
    g[1]
}

func main() {
    let frozen = Grid(cells: [1, 2, 3, 4], gates: 0)
    print("shared read through a let root: {frozen[2]}")
    print("gates after that read: {frozen.gates_seen()}")
    print("second shared read: {frozen[3]}")
    print("gates still: {frozen.gates_seen()}")

    var live = Grid(cells: [1, 2, 3, 4], gates: 0)
    live[0] = 99
    print("after a write: cell {live[0]}, gates {live.gates_seen()}")
    live[1] += 5
    print("after a compound write: cell {live[1]}, gates {live.gates_seen()}")

    print("forwarded read: {forwarded_read(&live)}, gates {live.gates_seen()}")
    print("-- done")
}
