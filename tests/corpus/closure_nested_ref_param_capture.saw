// A closure nested inside another closure captures the outer one's reference
// parameter as a borrow, so a write through it lands in the referent.
//
// `{ &var c in inner({ bump(&var c) }) }`: the inner closure captures `c`, a
// `&var Int` binding, and hands it on as an argument. A capture by value would
// still give the closure the right result, since its own reads follow the
// write, so the oracle is the root the reference points at, after the call.
// EXPECT: success
// EXPECT-OUTPUT:
// explicit borrow capture: root 42
// argument face: root 42
// shared read: root 1 saw 1

func outer(body: (&var Int) sync -> Int) -> Int {
    var n = 1
    let _ = body(&var n)
    return n
}

func read_outer(body: (&Int) sync -> Int) -> Int {
    let n = 1
    return body(&n)
}

func inner(body: () sync -> Int) -> Int { body() }
func bump(x: &var Int) { x = x + 41 }
func peek(x: &Int) -> Int { x }

func main() {
    // The control: the borrow capture written out.
    print("explicit borrow capture: root {}",
          outer({ &var c in inner({ [&var c] in c = c + 41; c }) }))

    // The argument spelling of the same write: no assignment names `c`, and
    // the write still reaches the root.
    print("argument face: root {}",
          outer({ &var c in inner({ bump(&var c); c }) }))

    // A shared reference parameter, read through the nested capture.
    print("shared read: root 1 saw {}",
          read_outer({ &c in inner({ peek(&c) }) }))
}
