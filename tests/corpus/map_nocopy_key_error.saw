// A Map key may be of any copy tier (spec, Map; SL-598): a NoCopy key is hashed
// and compared in place, through `&Self`, so nothing copies it. Stage 0 still
// refuses a move-only key (design 65's L19), a rule the spec has since dropped.
// `Counted`'s synthesized `Equatable` and `Hashable` reach the key where it sits.
// Each key is dropped exactly once: the stored key an overwrite replaces, the
// stored key and the consumed probe of a `remove`, a probe that `find` only
// borrows at its own scope's end, and the rest with the map.
// EXPECT: success
// EXPECT-OUTPUT:
// len 2
// drop key 1
// replaced 100
// found 200
// probe kept 2
// drop key 2
// drop key 2
// removed 200
// len 1
// drop key 2
// drop key 1

struct Counted { id: Int }
extension Counted: NoCopy {
    func deinit(&var self) { print("drop key {}", self.id) }
}
@synthesize
extension Counted: Equatable {}
@synthesize
extension Counted: Hashable {}

func main() {
    var m = Map<Counted, Int>()
    let _ = try! m.insert(Counted(id: 1), 100)
    let _ = try! m.insert(Counted(id: 2), 200)
    print("len {}", m.len())
    let old = try! m.insert(Counted(id: 1), 101)
    print("replaced {}", old!)
    let probe = Counted(id: 2)
    print("found {}", borrow m.find(&probe)!)
    print("probe kept {}", probe.id)
    let gone = m.remove(Counted(id: 2))
    print("removed {}", gone!)
    print("len {}", m.len())
}
