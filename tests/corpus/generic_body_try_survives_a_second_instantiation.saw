// DF-257c, CLOSED by design 246 unit B: a propagating `try` inside a GENERIC
// body was resolved once and reused across monomorphizations, so the SECOND
// instantiation extracted through the first's `Result` type and codegen emitted
// IR that did not verify:
//
//   internal compiler error at std/alloc.saw:20:9 (ReturnStatement):
//     Type of #1 arg mismatch: i8** != {i1, i8*}*
//
// PRE-EXISTING and nothing to do with fallible constructors: the callee here is
// a static factory, so this shape has been writable since Result generics
// landed. Design 234 found it because the flip multiplies exactly this — a
// generic container body calling a now-fallible allocation and propagating it.
//
// What made the two instantiations indistinguishable was the LLVM
// REPRESENTATION. `_generate_try_expr` falls back to matching a registered
// `Result$…` enum BY LLVM TYPE when the annotation does not name one, and two
// payload-carrying enums used to be LITERAL structs — structurally equal
// whenever their payloads shared a layout, so the fallback picked whichever it
// found first. Design 246 unit B makes a payload-carrying enum an IDENTIFIED
// struct, and identified types compare by NAME, so
// `Result$Cell$Int$AllocError` and `Result$Cell$String$AllocError` are two
// types and the fallback lands on the right one. The per-instantiation
// annotation the original finding asked for is still the better answer; this
// row is what would catch its absence again.
//
// EXPECT: success
// EXPECT-OUTPUT:
// 7
// 9

struct Cell<T> {
    v: T
}

extension Cell<T> {
    static func make(seed: T) -> Result<Cell<T>, AllocError> {
        return Cell<T>(v: seed)
    }
}

struct Holder<U> {
    tag: Int
}

extension Holder<U> {
    func build(&self, x: U) -> Result<Int, AllocError> {
        let c = try Cell<U>.make(seed: x)
        return self.tag
    }
}

func main() {
    let h = Holder<Int>(tag: 7)
    print("{try! h.build(3)}")

    // The second instantiation of `build`. Alone, either one compiles.
    let h2 = Holder<String>(tag: 9)
    let n2 = try! h2.build("s")
    print("{n2}")
}
