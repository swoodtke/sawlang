// Design 227 + 224: the COMPOUND chained assignment `x?.n += f()` whose RHS
// SUSPENDS. The success twin of `expr_suspend_optchain_assign.saw`, with the
// same order: the RHS runs first on every path, suspension included; on the
// non-None path the field is read, the operator applied and the result
// written back, and a None head skips only that write (SL:borrowing §2.2).
// EXPECT: success
// EXPECT-OUTPUT:
// 100
// 1
// -1
// 2

static CALLS: Atomic<Int> = Atomic(0)

struct Point { x: Int, y: Int }

func s(n: Int) -> Int {
    CALLS.fetch_add(1)
    __saw_suspend()
    n
}

func doassign(o: Point?) -> Int {
    var local = o
    local?.x += s(99)         // Void?; RHS suspends on every path
    if let p = local { return p.x }
    return -1
}

func main() {
    print(__saw_drive(doassign(Point(x: 1, y: 2))))   // 100 (1 + 99)
    print(CALLS.load())                               // 1
    print(__saw_drive(doassign(None)))                // -1 (write skipped)
    print(CALLS.load())                               // 2 (the RHS ran)
}
