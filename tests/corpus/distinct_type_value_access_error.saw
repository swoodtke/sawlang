// Design 61 L16: `.value` (or any member) on a distinct `type` over a non-struct
// underlying is NOT a language feature — the spec labels the `.value` accessor
// planned/illustrative. It used to ICE in codegen ("Cannot find field value in
// struct with type i64"); it must be a clean typechecker error naming the alias.
// A distinct type flows to its underlying type implicitly, so it is used
// directly (no accessor needed).
// The error now also suggests the explicit projection cast (design 63).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: x as Int

type MyInt = Int

func main() {
    let x: MyInt = 5
    print(x.value)
}
