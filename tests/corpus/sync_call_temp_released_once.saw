// Every SYNC-path temp is released exactly once — a by-value owning argument
// to a METHOD, and a call-result temp used as a RECEIVER, beside the
// free-function control.
//
// No coroutine is involved. Three values are created here and each one's
// deinit runs, at the end of the statement that built it. The free-function
// argument (`takeres(mk(1))`) always worked and is the control — it proves the
// position is releasable and fixes the expected ORDER; the method argument
// (`s.take(mk(2))`) and the temp receiver (`mk(3).n`) used to leak (DF-217m).
//
// Found by sweep S2 while probing the suspending positions: the suspending
// twin of each shape already released exactly once, i.e. the coro path was
// CORRECT and the plain path was the one that leaked — the reverse of the
// DF-217h class beside it, which is why it needed its own pin rather than
// riding one, and why the coro path was the oracle for the fix.
// EXPECT: success
// EXPECT-OUTPUT:
// deinit 1
// free fn arg -> 1
// deinit 2
// method arg -> 2
// deinit 3
// temp receiver field -> 3
// done

struct Res { n: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.n}") }
}

struct Sink { tag: Int }
extension Sink {
    func take(&self, r: Res) -> Int { r.n }
}

func takeres(r: Res) -> Int { r.n }

func mk(n: Int) -> Res { Res(n: n) }

func main() {
    let a = takeres(mk(1))
    print("free fn arg -> {a}")
    let s = Sink(tag: 0)
    let b = s.take(mk(2))
    print("method arg -> {b}")
    let c = mk(3).n
    print("temp receiver field -> {c}")
    print("done")
}
