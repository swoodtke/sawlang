// A `borrow var` block over `v[i]` bounds-checks its index: Vector's place
// accessor panics out of range (SL:borrowing §4). Unchecked, the binding would
// be a mutable reference past the end of the buffer, and the body's own
// ordinary mutation a heap WRITE out of bounds from safe code (design 122).
// EXPECT: panic

func main() {
    var v: Vector<Int> = [10, 20]
    borrow var e = v[1] { e += 5 }
    print(v.get(1)!)                             // 25 — in range, mutation lands
    borrow var e = v[99] { e += 5 }    // past the end -> panic
}
