// Refused: Box/Arc forwarding is dropped (SL-712), so a payload method is reached with `borrow p.value().m()`.
// An `Arc` forwards no payload method: `ac.peek()` names a `&self` method of
// the payload `Counter`, which the `Arc` does not declare, and is refused at
// that first call. `shared.lock()` on an `Arc<Mutex<Int>>` is the same shape;
// the spelling that compiles is `borrow var c = shared.value().lock() { … }`.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `peek` is a method of the payload

import std.mutex.{Mutex}
struct Counter {
    n: Int
}

extension Counter {
    func peek(&self) -> Int {
        self.n
    }
}

func main() {
    // Forward an ordinary &self method through Arc<Counter>.
    let ac = try! Arc<Counter>(value: Counter(n: 42))
    print(ac.peek())   // 42

    // Forward Mutex.lock through Arc<Mutex<Int>> and mutate under the lock.
    let shared = try! Arc<Mutex<Int>>(value: Mutex<Int>(value: 0))
    var i = 0
    while i < 7 {
        borrow var c = shared.lock() {
            c = c + 1
            true
        }
        i = i + 1
    }
    borrow var c = shared.lock() {
        print(c)   // 7
        true
    }
}
