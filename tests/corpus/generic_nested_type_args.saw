// A generic function instantiated with two different *nested* generic type
// arguments must produce two distinct monomorphizations.
// Before the canonical mangler, codegen's _type_to_string ignored a struct's
// type args, so identity<Crate<Int>> and identity<Crate<String>> both mangled to
// "identity$Crate" and collided on a single instantiation -> the second call
// reused the first (Crate<Int>) body and miscompiled.
// See todo_jul26.md must-fix #4 (three divergent manglers; types.py dropped type args).
// EXPECT: success
// EXPECT-OUTPUT:
// 42
// hi

struct Crate<T> {
    value: T
}

func identity<T>(x: T) -> T {
    x
}

func main() {
    let a = identity<Crate<Int>>(Crate<Int>(value: 42))
    let b = identity<Crate<String>>(Crate<String>(value: "hi"))
    print(a.value)
    print(b.value)
}
