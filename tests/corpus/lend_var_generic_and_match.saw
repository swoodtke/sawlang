// A GENERIC pair of accessors whose shared and exclusive bodies differ, and a
// pair whose place is a MATCH-ARM PAYLOAD. Differing bodies are both written
// (SL:borrowing §4), so each instantiation has a `&self` accessor and a `&var
// self` one, and only the exclusive one runs the gate.
//
// The match-arm payload lend (a slot enum's `Filled` arm) composes with a gate
// the same way: the prologue runs before the match, so the gate is in the
// exclusive accessor, and the arm lends the payload where it sits. Its payload
// is bound as a place with `borrow let` or `borrow var`, since a plain
// `case Filled(v)` would copy it (§2.4, §2.7). A read of a present slot copies
// the lend out with `!` (§2.2).
// EXPECT: success
// EXPECT-OUTPUT:
// Int read 7, gates 0
// Int write 8, gates 1
// String read ada, gates 0
// String write ada!, gates 1
// slot read 5, gates 0
// slot write 6, gates 1
// empty slot: absent, gates 1
// -- done

struct Holder<T> {
    a: T,
    b: T,
    gates: Int
}

extension Holder<T> {
    func run_gate(&var self) {
        self.gates = self.gates + 1
    }

    public func [](&self, i: Int) borrows -> &T {
        if i < 0 || i >= 2 {
            panic("Holder.[]: index out of range")
        }
        if i == 0 {
            lend self.a
        } else {
            lend self.b
        }
    }

    public func [](&var self, i: Int) borrows -> &var T {
        if i < 0 || i >= 2 {
            panic("Holder.[]: index out of range")
        }
        self.run_gate()
        if i == 0 {
            lend self.a
        } else {
            lend self.b
        }
    }

    public func gates_seen(&self) -> Int {
        self.gates
    }
}

enum Slot {
    case Empty,
    case Filled(v: Int)
}

struct Table {
    slots: [Slot; 3],
    gates: Int
}

extension Table {
    func run_gate(&var self) {
        self.gates = self.gates + 1
    }

    public func at(&self, i: Int) borrows -> &Int? {
        if i < 0 || i >= 3 {
            return None
        }
        match self.slots[i] {
            case Filled(borrow let v) -> { lend v },
            case Empty -> { return None }
        }
    }

    public func at(&var self, i: Int) borrows -> &var Int? {
        if i < 0 || i >= 3 {
            return None
        }
        self.run_gate()
        match self.slots[i] {
            case Filled(borrow var v) -> { lend v },
            case Empty -> { return None }
        }
    }

    public func gates_seen(&self) -> Int {
        self.gates
    }
}

func main() {
    var nums = Holder<Int>(a: 7, b: 0, gates: 0)
    print("Int read {nums[0]}, gates {nums.gates_seen()}")
    nums[0] += 1
    print("Int write {nums[0]}, gates {nums.gates_seen()}")

    var names = Holder<String>(a: "ada", b: "", gates: 0)
    print("String read {names[0]}, gates {names.gates_seen()}")
    names[0] = "ada!"
    print("String write {names[0]}, gates {names.gates_seen()}")

    var t = Table(slots: [Slot.Filled(v: 5), Slot.Empty, Slot.Empty], gates: 0)
    print("slot read {borrow t.at(0)!}, gates {t.gates_seen()}")
    borrow var t.at(0)! += 1
    print("slot write {borrow t.at(0)!}, gates {t.gates_seen()}")

    var absent = true
    if (borrow let e = t.at(1) { if let _ = e { true } else { false } }) {
        absent = false
    }
    print("empty slot: absent, gates {t.gates_seen()}")
    assert(absent, "the Empty slot lent something")
    print("-- done")
}
