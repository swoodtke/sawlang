// Design 165: appending a Data to itself, and the neighbouring aliasing cases.
//
// `d.append(d)` is the case a copy-on-write buffer has to be asked about. The
// argument is a retain, so the storage is shared when `append` runs; the gate
// separates BEFORE the copy, which leaves the source buffer owned by the
// argument alone and nothing writing to it while it is read. Getting the order
// wrong here reads a buffer that `grow` has already freed, or copies from the
// destination it is halfway through filling.
// EXPECT: success
// EXPECT-OUTPUT:
// self-append 1,2,1,2
// slice-append 10,20,30,20,30
// shared-append 7,9 sibling 7
// grow-append 5,5,5,5
import std.data.*

func show(d: &Data) -> String {
    var out = StringBuilder()
    var i = 0
    while i < d.len() {
        if i > 0 {
            try! out.append(",")
        }
        try! out.append(d.get(i)! as Int)
        i = i + 1
    }
    out.build()
}

func main() {
    var a = try! Data(capacity: 4)
    try! a.push(1)
    try! a.push(2)
    try! a.append(a)
    print("self-append {show(&a)}")

    // A slice of self: the argument holds a retain AND a narrower window.
    var b = try! Data(capacity: 4)
    try! b.push(10)
    try! b.push(20)
    try! b.push(30)
    try! b.append(b.slice(1, 3)!)
    print("slice-append {show(&b)}")

    // Appending into storage a sibling shares: the sibling keeps its bytes.
    var c = try! Data(capacity: 4)
    try! c.push(7)
    let sibling = c.copy()
    var tail = try! Data(capacity: 4)
    try! tail.push(9)
    try! c.append(move tail)
    print("shared-append {show(&c)} sibling {show(&sibling)}")

    // Separation and growth in the same call, twice over.
    var e = try! Data(capacity: 2)
    try! e.push(5)
    try! e.append(e)
    try! e.append(e)
    print("grow-append {show(&e)}")
}
