// A `borrows` accessor declared `&var self` with `@synthesize(shared)` serves
// BOTH borrow flavors: the attribute derives the `(&self) borrows -> &T` twin
// (SL:borrowing §4); bare `borrow` picks the shared twin and `borrow var` the
// exclusive accessor. Modes are declared, never inferred from use (§1, §3).
//
// So `print(borrow b[0][1].count)` borrows `b` shared and
// `borrow var b[0][1].count += 10` borrows it exclusively, out of one declared
// pair. A `&self` accessor with an epilogue (`peek`) may read its receiver but
// not write it, and a `&var self.field` written under a `&self` receiver is a
// hard error (`errors/var_ref_into_shared_self.saw`). A `let` root takes a
// shared borrow.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 12
// b
// 42
// 1
// closings 2
// deep 7

struct Cell {
    count: Int
    tag: String
}

struct Row {
    cells: [Cell; 2]
}

struct Bag {
    rows: [Row; 2]
    hits: Int
}

extension Row {
    // The shared twin serves `borrow r[i]`; `borrow var r[i]` uses this body.
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Cell {
        if i < 0 || i >= 2 {
            panic("Row.[]: index out of range")
        }
        lend self.cells[i]
    }
}

extension Bag {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Row {
        if i < 0 || i >= 2 {
            panic("Bag.[]: index out of range")
        }
        lend self.rows[i]
    }

    // An epilogue on a `&self` accessor. It may READ the receiver but not
    // write it, since `&self` is read-only all the way down (SL:borrowing §9),
    // so the closing count lives in a caller-side counter.
    public func peek(&self, i: Int) borrows -> &Row {
        if i < 0 || i >= 2 {
            panic("Bag.peek: index out of range")
        }
        lend self.rows[i]
        print("closings {self.hits}")
    }
}

func bump(c: &var Cell) {
    c.count = c.count + 30
}

func main() {
    var b = Bag(rows: [Row(cells: [Cell(count: 1, tag: "a"),
                                   Cell(count: 2, tag: "b")]),
                       Row(cells: [Cell(count: 3, tag: "c"),
                                   Cell(count: 4, tag: "d")])],
                hits: 2)

    // Shared borrow through the synthesized twins: the place becomes a value at `.count`.
    print("{borrow b[0][1].count}")

    // Exclusive borrow through the declared `&var self` accessors.
    borrow var b[0][1].count += 10
    print("{borrow b[0][1].count}")

    // Value read of a Copy field through two chained windows.
    let tag = borrow b[0][1].tag
    print("{tag}")

    // A place handed to a call as a `&var` reference: the window spans the call.
    bump(borrow var b[0][1])
    print("{borrow b[0][1].count}")
    print("{borrow b[0][0].count}")

    // The epilogue runs when the window closes.
    let _ = borrow b.peek(1)[0].count

    // A `let` root is fine for a SHARED borrow.
    let frozen = Bag(rows: [Row(cells: [Cell(count: 7, tag: "x"),
                                        Cell(count: 8, tag: "y")]),
                            Row(cells: [Cell(count: 9, tag: "z"),
                                        Cell(count: 10, tag: "w")])],
                     hits: 0)
    print("deep {borrow frozen[0][0].count}")
}
