// `__saw_drive` on a suspending body that returns Void (design 102 item 1 sweep). A
// driven Void frame has no `__result` slot, so the `__saw_drive_<f>` helper must NOT
// read `__f.__result` — it loops to completion and returns Void. This ICE'd
// ("struct __Frame_work has no field __result") before the fix.
// EXPECT: success
// EXPECT-OUTPUT: 3

import std.task.*
static COUNTER: Atomic<Int> = Atomic(0)

func work(n: Int) {
    yield_now()
    COUNTER.fetch_add(n)
    yield_now()
    COUNTER.fetch_add(1)
}

func main() {
    __saw_drive(work(2))   // adds 2 then 1
    print(COUNTER.load())
}
