// design 52 Part 0: a suspension in ONE branch of an `if`. The CFG split routes
// the then/else branches to separate state blocks that reconverge at a merge
// state; only the taken branch's suspension executes. Both paths are exercised:
// `pick(true)` suspends once (then-branch), `pick(false)` suspends twice
// (else-branch), and each returns the branch's computed value.
// EXPECT: success
// EXPECT-OUTPUT:
// 11
// 1
// 22
// 2

func pick(hi: Bool) -> Int {
    var r = 0
    if hi {
        __saw_suspend()
        r = 11
    } else {
        __saw_suspend()
        __saw_suspend()
        r = 22
    }
    r                    // merge state: r set on whichever branch ran
}

func main() {
    print(__saw_drive(pick(true)))         // 11
    print(__saw_drive_steps(pick(true)))   // 1 suspension (then-branch)
    print(__saw_drive(pick(false)))        // 22
    print(__saw_drive_steps(pick(false)))  // 2 suspensions (else-branch)
}
