// Design 174 — DF-174c, FIXED. A nested optional type has a POSTFIX spelling.
// The type always existed and behaved correctly (see
// optional_generic_nested_reads.saw), but nothing could name it, so no function
// could take or return one. Of the three candidates the finding tried:
//
//   Int??              THIS FILE — `?` nests in type position now
//   Optional<Int?>     the generic spelling, the same type (design 176 unit 9)
//   (Int?)?            still a distinct 1-tuple-ish type; not a spelling of this
//
// `??` reaches the parser as ONE token (the nil-coalescing operator's), so the
// type grammar counts it as two layers rather than making the lexer stop fusing
// it — which is what keeps both lexers byte-identical and lexdiff untouched.
// EXPECT: success
// EXPECT-OUTPUT:
// some 5
// inner-absent
// outer-absent
// -- done

// The helper every two-layer read wants, and could not have.
func report(label: String, o: Int??) {
    if let inner = o {
        if let value = inner { print("{label} {value}") } else { print("inner-absent") }
    } else {
        print("outer-absent")
    }
}

func main() {
    let some: Int? = 5
    let none: Int? = None
    var v = Vector<Int?>()
    try! v.push(some)
    try! v.push(none)

    report("some", v.get(0))
    report("none", v.get(1))
    report("gone", v.get(9))
    print("-- done")
}
