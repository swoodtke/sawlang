// Move-state is keyed by binding IDENTITY, not name (design 15 rule 2). The
// outer `f` is moved, but an inner scope declares its own distinct binding;
// using it is fine because it has fresh (unmoved) state. (Design 100 forbids a
// non-derived SAME-name shadow, so the inner binding is named distinctly — the
// move-state-per-identity guarantee is what this exercises.)
// EXPECT: success
// EXPECT-OUTPUT:
// 2

struct FileHandle {
    fd: Int
}

extension FileHandle: NoCopy {
    func deinit(&var self) {}
}

func consume(h: FileHandle) {}

func main() {
    let f = FileHandle(fd: 1)
    consume(move f)          // outer f moved-from
    let cond = true
    if cond {
        let inner = FileHandle(fd: 2)   // distinct binding, fresh move-state
        print(inner.fd)                 // OK -> 2
    }
}
