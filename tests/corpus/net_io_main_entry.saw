// design 76 (A4): a suspending `main` that does IO directly is wrapped in the
// entry executor, which parks in the reactor on an io wait and resumes when the
// fd is ready. `connect` to a listener on loopback starts a nonblocking connect
// and parks for write-readiness, which the reactor reports as soon as the
// handshake completes; `accept` then finds the connection already queued.
// Exercises the entry-executor reactor path with no group and no sibling.
// Loopback only.
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 2

import std.net.{TcpListener, TcpStream}

func main() {
    let listener = try! TcpListener.listen(0)
    let port = try! listener.local_port()
    print(1)
    let client = try! TcpStream.connect("127.0.0.1", port)   // parks until connected
    let served = try! listener.accept()
    print(2)
    let _ = move served
    let _ = move client
}
