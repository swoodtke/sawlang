// design 91: PRECISE reactor wakeup — a reader parked on fd A must NOT be woken
// by fd B's readiness event. Two readers park on two DIFFERENT socketpairs. Only
// fd A's writer fires; the reactor must wake EXACTLY reader A (its (fd,dir)
// event), leaving reader B parked until its own writer fires. A wake is
// invisible from outside std (a read woken with no data parks again), so the
// observable proof is that each reader resolves to its own byte, in order;
// counting spurious wakes takes a pin inside the reactor (SL-890).
// Deterministic (spawn-slot order makes both readers park before the writer
// runs; join drains fully), socketpair-only, time-bounded.
// EXPECT: success
// EXPECT-OUTPUT:
// 65
// 66

import std.net.{TcpStream}

func reader(stream: TcpStream) -> Int {
    let got = try! stream.read()       // park until readable
    got[0] as Int
}

func writer(stream: TcpStream, text: String) -> Int {
    try! stream.write(text)
    return 1
}

func main() {
    let (ra, wa) = try! TcpStream.pair()     // ra = reader A reads; wa = wake A
    let (rb, wb) = try! TcpStream.pair()     // rb = reader B reads; wb = wake B
    var group = TaskGroup()
    let rA = group.spawn(reader(move ra))
    let rB = group.spawn(reader(move rb))
    let wA = group.spawn(writer(move wa, "A"))   // fire ONLY fd A ('A')
    let a = rA.join()                  // both readers park; only fd A fires -> only A wakes
    let wB = group.spawn(writer(move wb, "B"))   // now fire fd B ('B')
    let b = rB.join()
    print(a)                           // 65
    print(b)                           // 66
    let _ = wA.join()
    let _ = wB.join()
}
