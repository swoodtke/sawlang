// design 85: THREE nested suspending calls in sequence in one spawned worker, each
// parking — read (park) -> write (park) -> read (park). Exercises multiple worker
// RE-ENTRIES: sub-frame 1 parks+completes, sub-frame 2 is entered/parks+completes,
// sub-frame 3 likewise — an arbitrary-length sequence of possibly-parking nested
// calls. Lock-step over a socketpair so each read yields exactly one byte;
// deterministic on the exchanged byte values.
// EXPECT: success
// EXPECT-OUTPUT:
// 241
// 65

import std.net.{TcpStream}

func read_one(stream: &TcpStream) -> Int {
    let chunk = try! stream.read()         // park until a byte arrives
    chunk.get(0)! as Int
}

func write_byte(stream: &TcpStream, b: String) -> Int {
    try! stream.write(b)                   // park until writable
    1
}

// Three parking nested calls in a row.
func server(stream: TcpStream) -> Int {
    let b1 = read_one(&stream)             // park 1: receive 'x' (120)
    let _ = write_byte(&stream, "A")       // park 2: send 'A' (65)
    let b2 = read_one(&stream)             // park 3: receive 'y' (121)
    return b1 + b2                         // 120 + 121 = 241
}

func client(stream: TcpStream) -> Int {
    let _ = write_byte(&stream, "x")
    let a = read_one(&stream)              // read 'A'
    let _ = write_byte(&stream, "y")
    return a                               // 65
}

func main() {
    let (s0, s1) = TcpStream.pair()
    var group = TaskGroup()
    let hs = group.spawn(server(move s0))
    let hc = group.spawn(client(move s1))
    print(hs.join())     // 241 = both received bytes summed
    print(hc.join())     // 65 = the 'A' the server sent back
}
