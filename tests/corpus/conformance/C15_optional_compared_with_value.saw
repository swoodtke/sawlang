// Conformance row C15 — `==` and `!=` of an Optional with a bare value of its
// payload type
//
// `s == want` with `s: T?` and `want: T` means "s holds a value, and it equals
// want". Both operands are compared in place: no `Some` is built around the
// bare side, nothing is copied, and neither operand is destroyed early or
// twice. Per payload tier the cells are the bare side (a local, a parameter, a
// `&` parameter, a field, an index, a call's result) against a present equal
// Optional, a present unequal one and an absent one. Each row prints `==` of
// equal values, `!=` of unequal ones, `==` of an absent one and `!=` of an
// absent one: true true false true. The NoCopy `Tag` prints each destruction.
// The last row, `right_changes`, is a comparison whose right operand changes the
// Optional its left operand names: it sees the value from before the call.
// EXPECT: success
// EXPECT-OUTPUT:
// int true
// literal true
// binding true
// differs true
// s_local true true false true
// s_param true true false true
// s_ref true true false true
// s_field true true false true
// s_index true true false true
// s_call true true false true
// t_local true true false true
// t_param true true false true
// t_ref true true false true
// t_field true true false true
// t_index true true false true
// t_call true true false true
// e_local true true false true
// e_param true true false true
// e_ref true true false true
// e_field true true false true
// e_index true true false true
// e_call true true false true
// e_right true true false true
// b_local true true false true
// b_param true true false true
// b_ref true true false true
// b_field true true false true
// b_index true true false true
// b_call true true false true
// drop i7
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// g_local true true false true
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// drop i7
// g_param true true false true
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// drop i7
// g_ref true true false true
// drop i7
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// g_field true true false true
// drop i7
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// g_index true true false true
// drop i7
// drop i7
// drop i7
// drop i8
// drop i7
// drop i7
// g_call true true false true
// o_local true true false true
// o_call true true false true
// right_changes true 9 false 1 true false false 3

// ---- the four shapes the defect was reported with

func same_binding(id: Int) -> Bool {
    let s: String? = "i{id}"
    let want = "i{id}"
    s == want
}

func differs(id: Int) -> Bool {
    let s: String? = "i{id}"
    let want = "j{id}"
    s != want
}

func same_literal(id: Int) -> Bool {
    let s: String? = "i{id}"
    s == "i7"
}

func same_int(id: Int) -> Bool {
    let n: Int? = id
    let want = id
    n == want
}

// ---- String

func s_mk(n: Int) -> String {
    "i{n}"
}
func s_opt(n: Int) -> String? {
    if n == 0 { return None }
    return s_mk(n)
}
struct SHolder { w: String }
extension SHolder: NoCopy {}
func s_local(n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    let want = s_mk(7)
    if ne { return s != want }
    return s == want
}
func s_param_in(want: String, n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    if ne { return s != want }
    return s == want
}
func s_param(n: Int, ne: Bool) -> Bool {
    s_param_in(s_mk(7), n, ne)
}
func s_ref_in(want: &String, n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    if ne { return s != want }
    return s == want
}
func s_ref(n: Int, ne: Bool) -> Bool {
    let w = s_mk(7)
    return s_ref_in(&w, n, ne)
}
func s_field(n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    let h = SHolder(w: s_mk(7))
    if ne { return s != h.w }
    return s == h.w
}
func s_index(n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    var v = Vector<String>()
    try! v.push(s_mk(7))
    if ne { return s != v[0] }
    return s == v[0]
}
func s_call(n: Int, ne: Bool) -> Bool {
    let s = s_opt(n)
    if ne { return s != s_mk(7) }
    return s == s_mk(7)
}

