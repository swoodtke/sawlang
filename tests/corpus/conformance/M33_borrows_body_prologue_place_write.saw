// Conformance row M33 — a place write in the PROLOGUE of a `&self` borrows body
// is refused (language changed)
//
// `&self` is read-only all the way down (SL:borrowing §9), and a `borrows`
// accessor's body is ordinary code under its receiver: before and after the
// `lend` it may read `self` but not write it. `Log.at` bumps a counter reached
// through `self` in its prologue, which is a write through a shared borrow, so
// the accessor is refused where it is declared, whatever the use site does.
//
// An accessor that has to touch its receiver before lending declares
// `&var self`, and then every borrow through it charges the root exclusively
// (§3). An accessor that means to count only writes spells the two flavors as
// two accessors (§4).
//
// The read in `reads` is a shared borrow through the declared
// `@synthesize(shared)` twin of `Counters.[]`, so the prologue write is the one
// refusal.
//
// SL:borrowing §9 retires the writes design 200 let a `&self` receiver make
// through storage it reaches, so this row is a refusal.
//
//
//
// EXPECT: error

struct Counters { hits: [Int; 2] }

extension Counters {
    @synthesize(shared)
    func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Counters.[]: index out of range") }
        lend self.hits[i]
    }
}

struct Log { counters: Counters, slots: [Int; 4] }

extension Log {
    func at(&self, i: Int) borrows -> &Int {
        self.counters[0] += 1
        if i < 0 || i >= 4 { panic("Log.at: index out of range") }
        lend self.slots[i]
    }
    func reads(&self) -> Int { self.counters[0] }
}

func main() {
    var l = Log(counters: Counters(hits: [0, 0]), slots: [7, 8, 9, 10])
    print("slot {borrow l.at(1)}")
    print("slot {borrow l.at(2)}")
    print("reads {l.reads()}")
}
