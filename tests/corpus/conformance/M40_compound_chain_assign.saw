// Conformance row M40 — `o?.n += v` is the compound spelling of design 111's
// chain assignment (DF-225l)
//
// `o?.n = v` writes the payload field in place iff every hop is non-None.
// The right side runs first on every path, and a short-circuit skips only
// the write (SL:borrowing §2.2). The compound form means the same thing
// about the same storage: on the Some path the field is read, the operator
// applied and the result written back.
//
// Both halves of the contract are pinned here: the write lands on the Some
// path, and on the None path the right-hand side still runs (the call bumps
// `calls` again) while the write does not, exactly as for `=`.
// EXPECT: success
// EXPECT-OUTPUT: some 6 calls 1
// EXPECT-OUTPUT: empty calls 2

struct Cell { n: Int }

func rhs(log: &var Int) -> Int {
    log = log + 1
    return 5
}

func main() {
    var calls = 0

    var some: Cell? = Cell(n: 1)
    some?.n += rhs(log: &var calls)
    print("some {some!.n} calls {calls}")

    var empty: Cell? = None
    empty?.n += rhs(log: &var calls)
    print("empty calls {calls}")
}
