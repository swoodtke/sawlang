// Conformance row K49 — an MT group's task feeds a task of a DIFFERENT,
// single-threaded group
//
// K48's guarantee with main taken out of it. The DF-224b sweep's first
// hypothesis was that the main task's wake path was broken; it is not, and
// this row is what falsifies it — the observer here is an ordinary cooperative
// task in its own group, and it saw exactly as little progress as main did.
// The two engines have to compose, because a program that opts one group into
// threads does not thereby opt out of the cooperative scheduler for the rest.
//
// The consumer's wait is bounded only to fail loudly on genuine breakage: 20s
// where the real wait is microseconds, so a loaded machine never reaches it
// (TESTING.md, "Waiting in a multi-threaded test").
//
// EXPECT: success
// EXPECT-OUTPUT:
// consumer got 7

import std.channel.{Channel}
import std.task.*
import std.time.{Instant}

static WAIT_MS: UInt64 = 20000

func feed(inbox: Channel<Int>, v: Int) {
    try! inbox.send(v)
}

func consume(inbox: Channel<Int>) unsafe -> Int {
    let start = Instant.now()
    while true {
        if let v = try! inbox.try_receive() {
            return v
        }
        if start.elapsed().as_millis() >= WAIT_MS {
            panic("consume: the pool task never delivered")
        }
        yield_now()
    }
    return -1
}

func main() {
    let inbox = try! Channel<Int>()
    var cooperative = TaskGroup()
    var workers = try! TaskGroup(threads: 2)
    let c = cooperative.spawn(consume(inbox.copy()))
    let h = workers.spawn(feed(inbox.copy(), 7))
    let got = c.join()
    h.join()
    print("consumer got {}", got)
}
