// Conformance row M41 — a write through `&self` into storage the receiver
// reaches through an indirection is refused, at every accessor spelling
// (language changed: SL:borrowing §9)
//
// `&self` is read-only all the way down. A write through a pointer the receiver
// holds is a write through a shared borrow: another holder of the same `&x` may
// be reading that heap buffer while the write lands or reallocates it. So the
// design-200 carve-out is gone, whatever spelling reaches the storage, and
// whether the write is plain or compound. Interior mutation goes only through
// cell types (`Mutex`, `Atomic`).
//
// Five accessors, ten writes, every one refused: `Vector`'s setitem and compound
// subscript, `Map`'s place and compound subscript, a hand-written NAMED accessor
// over a `Vector` under `borrow var`, `Data`'s element, and a NESTED chain
// through two heap containers. The reads beside them are legal: each goes
// through a shared accessor (`get`, or a `&self` twin), so the writes are the
// only refusals. M32 is the `Vector` row of the same rule, and M42 the inline
// `[T; N]` one.
// EXPECT: error
// Declaring each writing method `&var self` instead is the same program made
// legal, which is what the carve-out's callers now write.

import std.data.*

struct Board { grid: Vector<Int> }

@synthesize
extension Board: ExplicitCopy {}

extension Board {
    func stamp(&self) { self.grid[0] = 100 }
    func bump(&self) { self.grid[0] += 1 }
    func head(&self) -> Int { self.grid.get(0)! }
}

struct Reg { m: Map<String, Int> }

extension Reg: NoCopy {}

extension Reg {
    func stamp(&self) { borrow var e = self.m["a"] { e = 100 } }
    func bump(&self) { self.m["a"] += 1 }
    func at(&self) -> Int { self.m.get("a")! }
}

struct Slotted { cells: Vector<Int> }

extension Slotted: NoCopy {}

extension Slotted {
    @synthesize(shared)
    public func slot(&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= self.cells.len() { panic("Slotted.slot: out of range") }
        lend self.cells[i]
    }
}

struct Owner { s: Slotted }

extension Owner: NoCopy {}

extension Owner {
    func stamp(&self) { borrow var self.s.slot(0) = 100 }
    func bump(&self) { borrow var self.s.slot(0) += 1 }
    func at(&self) -> Int { borrow self.s.slot(0) }
}

struct Buf { d: Data }

extension Buf: NoCopy {}

extension Buf {
    func bump(&self) { self.d[0] += 5 }
    func at(&self) -> UInt8 { self.d.get(0)! }
}

struct Cell { n: Int }
struct Row { cells: Vector<Cell> }

@synthesize
extension Cell: ExplicitCopy {}
@synthesize
extension Row: ExplicitCopy {}

struct Grid { rows: Vector<Row> }

@synthesize
extension Grid: ExplicitCopy {}

extension Grid {
    func bump(&self) { borrow var self.rows[0].cells[0].n += 100 }
    func at(&self) -> Int { borrow self.rows[0].cells[0].n }
}

func main() {
    let b = Board(grid: [1, 2, 3])
    b.stamp()
    b.bump()
    print("vector {b.head()}")

    let seed = {"a": 1}
    let r = Reg(m: move seed)
    r.stamp()
    r.bump()
    print("map {r.at()}")

    let inner = Slotted(cells: [1, 2, 3])
    let o = Owner(s: move inner)
    o.stamp()
    o.bump()
    print("named {o.at()}")

    var raw = Data()
    try! raw.push(1)
    try! raw.push(2)
    let buf = Buf(d: move raw)
    buf.bump()
    print("data {buf.at()}")

    let row = Row(cells: [Cell(n: 1)])
    let g = Grid(rows: [move row])
    g.bump()
    print("nested {g.at()}")
}
