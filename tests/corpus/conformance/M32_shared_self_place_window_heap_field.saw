// Conformance row M32 — a place write through heap indirection at `&self` is
// refused (language changed)
//
// `&self` is read-only all the way down (SL:borrowing §9). A `Vector` field's
// heap buffer is shared by every holder of `&x`, so a write through it from a
// `&self` method is a write through a shared borrow: another holder may be
// reading `rows[0]` while a push reallocates it. Each method below takes an
// exclusive borrow of storage reached through `self`, and each is refused:
//
//   `widen`       a `&var self` method call through an element (row M28)
//   `bump_head`   a compound assignment through two nested borrows
//   `stamp_tail`  a store through two nested borrows
//
// The reads beside them are shared borrows, which `&self` allows. Interior
// mutation goes only through cell types (`Mutex`, `Atomic`, a cell-carrying
// `(&self) borrows -> &var T`, §3); the fix for these methods is a `&var self`
// receiver.
//
// SL:borrowing §9 names this row and M28 as refusals, annotated "language
// changed".
// EXPECT: error

struct Rows { rows: Vector<Vector<Int>> }

extension Rows: NoCopy {}

extension Rows {
    func widen(&self) { try! borrow var self.rows[0].push(9) }
    func bump_head(&self) { borrow var self.rows[0][0] += 100 }
    func stamp_tail(&self) { borrow var self.rows[0][2] = 55 }
    func width(&self) -> Int { borrow self.rows[0].len() }
    func head(&self) -> Int { borrow self.rows[0][0] }
    func tail(&self) -> Int { borrow self.rows[0][2] }
}

func main() {
    var r = Rows(rows: [[1, 2]])
    r.widen()
    r.bump_head()
    r.stamp_tail()
    print("width {r.width()}")
    print("head {r.head()}")
    print("tail {r.tail()}")
}
