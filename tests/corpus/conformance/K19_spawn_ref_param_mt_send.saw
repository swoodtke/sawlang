// Conformance row K19 — a reference argument into a MULTI-THREADED group
//
// The fence design 201 leaves standing. A single-threaded group's task runs on
// the thread that spawned it, so the extent rule is the whole argument; a
// `threads: N` group hands the frame to a worker, and a reference is not
// `Send`. The refusal comes from the Send gate rather than from a rule about
// references — which is the right reason: what fails is the thread crossing,
// not the extent.
//
// A regression row: this is the error the tree already printed, kept honest
// after the confinement refusal that used to run first was retired.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot spawn `bump` into a multi-threaded `TaskGroup(threads: ...)`
// EXPECT-ERROR-CONTAINS: parameter `n` of type `&var Int` is not `Send`

import std.task.*

func bump(n: &var Int) -> Int {
    yield_now()
    n = n + 1
    n
}

func main() {
    var n = 7
    var group = try! TaskGroup(threads: 2)
    let h = group.spawn(bump(&var n))
    print("task saw {h.join()}")
}
