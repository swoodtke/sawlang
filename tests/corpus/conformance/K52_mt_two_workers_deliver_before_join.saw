// Conformance row K52 — TWO tasks of one MT group both deliver before either
// is joined
//
// The plural cell. K48 has one producer, which a fix could satisfy by running
// the group on the joining thread; this one has two, spawned back to back into
// a `threads: 2` group, and main consumes both before touching a handle. What
// it pins is that the pool is a POOL — the second task is not waiting for the
// first to be joined — and it is the row a regression to any
// one-task-at-a-time drain would fail while K48 still passed.
//
// Asserted on the SUM, never on arrival order: the two workers race and the
// row would be a flake if it cared which value came first.
//
// EXPECT: success
// EXPECT-OUTPUT:
// main got 30

import std.channel.{Channel}
import std.task.*
import std.time.{Instant}

static WAIT_MS: UInt64 = 2000

func feed(inbox: Channel<Int>, v: Int) {
    try! inbox.send(v)
}

func wait_for(inbox: Channel<Int>) unsafe -> Int? {
    let start = Instant.now()
    while start.elapsed().as_millis() < WAIT_MS {
        if let v = try! inbox.try_receive() {
            return v
        }
        yield_now()
    }
    return None
}

func main() {
    let inbox = try! Channel<Int>()
    var workers = try! TaskGroup(threads: 2)
    let a = workers.spawn(feed(inbox.copy(), 10))
    let b = workers.spawn(feed(inbox.copy(), 20))
    var total = 0
    var got = 0
    while got < 2 {
        if let v = wait_for(inbox.copy()) {
            total = total + v
            got = got + 1
        } else {
            got = 2
        }
    }
    a.join()
    b.join()
    print("main got {}", total)
}
