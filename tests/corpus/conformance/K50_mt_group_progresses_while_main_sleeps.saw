// Conformance row K50 — an MT group's tasks progress while main SLEEPS
//
// The cell that says the guarantee is about the group being LIVE, not about
// any one wake path: main is not waiting on the worker at all here, it is
// asleep on a timer, and the question is only whether the worker exists yet.
// Measured pre-fix (the DF-224b sweep's `e/main_sleeploop_mt`): a 400 ms nap
// elapsed with the worker never started, because `__drain_mt` spawns AND joins
// its OS threads inside one call and nothing outside a join makes that call.
//
// The flag is an `Arc<Mutex<Int>>` — the sanctioned cross-thread share (row
// K13) — and main reads it after each nap until it is set, so no nap length is
// a guess at how long the worker takes. The naps are bounded only to fail
// loudly on genuine breakage: 20s where the real wait is microseconds, so a
// loaded machine never reaches it (TESTING.md, "Waiting in a multi-threaded
// test").
//
// EXPECT: success
// EXPECT-OUTPUT:
// ran during the nap: 1

import std.mutex.*

static NAP_MS: UInt64 = 10
static NAP_LIMIT: Int = 2000

func mark(flag: Arc<Mutex<Int>>) {
    let _ = borrow var c = flag.value().lock() {
        c = 1
        c
    }
}

func main() {
    let flag = try! Arc<Mutex<Int>>(value: Mutex<Int>(value: 0))
    var workers = try! TaskGroup(threads: 2)
    let h = workers.spawn(mark(flag.copy()))
    var seen = 0
    var naps = 0
    while seen == 0 {
        if naps >= NAP_LIMIT {
            panic("main: the pool task never ran while main slept")
        }
        sleep(Duration.ms(NAP_MS))
        naps = naps + 1
        seen = borrow var c = flag.value().lock() { c }
    }
    h.join()
    print("ran during the nap: {}", seen)
}
