// Conformance row R21 — type alias laundering a reference into a return type
//
// The alias in RETURN position, its value built by the alias's construction
// so the reference-position walk is the only refusal, and it resolves the
// alias to the reference it names.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: the return type of `f` may not be a reference
// EXPECT-ERROR-CONTAINS: A `type` alias is not a way past that rule

type R = &Int
func f(x: &Int) -> R { R(&x) }
func main() {
    var a = 1
    print(f(&a))
}
