// Conformance row V109 — a `move` in a `while` CONDITION is checked against the
// LOOP's liveness, not as straight-line code
//
// SL-262. A `while` condition is the one head that RE-EVALUATES: it runs again
// on the loop's back edge, so a move written there consumes, on the second
// evaluation, a binding the first one already consumed. The move checker asked
// the loop-carried question of the loop's BODY only — `_check_loop_body` took
// its "was this already moved" snapshot AFTER the condition — so this whole
// class was accepted in silence.
//
// The guarantee it broke is the language's plainest: a value is destroyed
// exactly once. The program below destroyed `r` once per iteration and exited
// 0, printing `drop old` three times; its driven twin, where SL-234 makes the
// frame relinquish its claim once per condition evaluation, aborted inside the
// runtime instead (`panic at frame.saw:82: Slot.take: slot is empty`). Neither
// is a behaviour to match — the program has no correct meaning — so the answer
// is a refusal, and the same refusal in both twins.
//
// The condition now sits INSIDE `_check_loop_body`'s window, which makes every
// depth one rule: the move may be the whole condition, an `&&`/`||` operand, a
// nested call argument or a comparison operand, and all of them are the same
// error at the same anchor. V110 holds the accept side.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: use of moved variable `r` across loop iterations
// EXPECT-ERROR-CONTAINS: this move is in the loop's CONDITION

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("drop {}", self.name) }
}

func consume_bool(r: Res) -> Bool { true }

func while_falls_through() -> Int {
    var r = Res(name: "old")
    var n = 0
    while consume_bool(move r) {
        n = n + 1
        if n > 2 { break }
    }
    n
}

func main() { print("n {while_falls_through()}") }
