// Conformance row M42 — a `&self` method may not write an INLINE `[T; N]`
// element of its receiver, in either spelling
//
// `&self` is read-only all the way down (SL:borrowing §9), and an inline
// array field is the plainest case: its elements live inside the receiver,
// so a write through `&self`, plain or compound, would change a value the
// caller may hold immutably, such as the `let b` below. Row M41 is the same
// refusal for storage reached through a heap indirection.
//
// The spec's `Board` snippet means an inline `[Cell; 9]` field, and this row
// writes one in both spellings. The accessor spelling of the same rule (a
// `borrows` field type, seven positions) is row M31. Declaring the method
// `&var self` makes the write legal, and then it needs a `var` root.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot assign to storage reached through a `&self` receiver
// EXPECT-ERROR-CONTAINS: cannot use compound assignment on storage reached through a `&self` receiver

struct Board { grid: [Int; 3] }

extension Board {
    func stamp(&self) { self.grid[0] = 100 }
    func bump(&self) { self.grid[0] += 100 }
}

func main() {
    let b = Board(grid: [1, 2, 3])
    b.stamp()
    b.bump()
    print(b.grid[0])
}
