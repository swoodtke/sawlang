// Conformance row K48 — a task spawned into a `threads: N` group RUNS before
// anybody joins it
//
// The headline cell of the DF-224b wake matrix, and the shape two independent
// fresh writers reached for within hours: spawn a producer into a
// multi-threaded group, then read what it produced. Every other member of the
// family already behaves this way — a cooperative group's tasks progress
// whenever main suspends, and the 21b `Thread.spawn {}` engine is live by
// construction — so `threads: N` was the ONLY fork-join member, and its
// workers existed nowhere outside a `join()`/`Deinit` drain.
//
// The wait is BOUNDED on the wall clock so the pre-fix behavior, a wait with
// no end, fails loudly instead of hanging. The bound is 20s where the real
// wait is microseconds, so it fires on genuine breakage and never on a loaded
// machine (TESTING.md, "Waiting in a multi-threaded test").
//
// EXPECT: success
// EXPECT-OUTPUT:
// main got 3

import std.channel.{Channel}
import std.task.*
import std.time.{Instant}

static WAIT_MS: UInt64 = 20000

func feed(inbox: Channel<Int>, v: Int) {
    try! inbox.send(v)
}

func wait_for(inbox: Channel<Int>) unsafe -> Int {
    let start = Instant.now()
    while true {
        if let v = try! inbox.try_receive() {
            return v
        }
        if start.elapsed().as_millis() >= WAIT_MS {
            panic("main: the pool task never delivered before the join")
        }
        yield_now()
    }
    return 0
}

func main() {
    let inbox = try! Channel<Int>()
    var workers = try! TaskGroup(threads: 2)
    let h = workers.spawn(feed(inbox.copy(), 3))
    print("main got {}", wait_for(inbox.copy()))
    h.join()
}
