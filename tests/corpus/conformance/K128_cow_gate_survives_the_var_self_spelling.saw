// Conformance row K128 — a copy-on-write gate lives only in the exclusive
// accessor, so it costs a READ nothing (SL:borrowing §4)
//
// When the shared and exclusive bodies differ, both are written: the `&var self`
// accessor separates shared storage before it lends, and the `&self` one does
// not. `Data` is the language's worked example (§4).
//
// There is no mode test inside one body (§9). The gate is a `&var self` call on
// `self`, so it can live only in the `&var self` accessor; a single `&var self`
// accessor with no shared twin would charge every read's root exclusively (§3),
// and `let frozen = load()` plus `frozen[0]` would stop compiling.
//
// A plain read is the getitem derived from the `&self` accessor (§5.2), so it
// borrows the receiver shared, works on a `let` binding, and runs no gate. A
// write is the setitem derived from the `&var self` accessor, and a compound
// write is a getitem then a setitem (§5.1), so each runs the gate once.
//
// Both halves are here: a hand-written accessor with a visible gate counter, and
// `Data` itself, where the observable is the SHARING PARTNER's bytes.
// EXPECT: success
// EXPECT-OUTPUT:
// let read 10, gates 0
// var read 10, gates 0
// var write 11, gates 1
// Data: frozen read 7, no var needed
// Data: after buf[0] = 90 -> frozen 7, buf 90
// Data: two readers of one buffer see 7 and 7
// -- done
import std.data.*

struct Bag { cells: [Int; 4], gates: Int }

extension Bag {
    func separate(&var self) { self.gates = self.gates + 1 }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("Bag.[]: index out of range") }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.[]: index out of range") }
        self.separate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

func main() {
    let frozen = Bag(cells: [10, 20, 30, 40], gates: 0)
    print("let read {frozen[0]}, gates {frozen.gates_seen()}")

    var b = Bag(cells: [10, 20, 30, 40], gates: 0)
    print("var read {b[0]}, gates {b.gates_seen()}")
    b[0] += 1
    print("var write {b[0]}, gates {b.gates_seen()}")

    var built = try! Data(capacity: 2)
    try! built.push(7u8)
    try! built.push(8u8)

    let frozen_data = built
    print("Data: frozen read {frozen_data[0]}, no var needed")

    var buf = frozen_data
    buf[0] = 90u8
    print("Data: after buf[0] = 90 -> frozen {frozen_data[0]}, buf {buf[0]}")

    let second = frozen_data
    print("Data: two readers of one buffer see {frozen_data[0]} and {second[0]}")
    print("-- done")
}
