// Conformance row K129 — a FORWARDED lend reaches the inner accessor at the
// OUTER accessor's declared mode (SL:borrowing §2.7, §3)
//
// `lend self.inner[i]` hands another accessor's place on, with no `borrow`
// keyword on the operand (§2.7). The inner borrow opens for as long as the
// outer lend is open, and which inner accessor it reaches follows from the
// outer declaration: inside a `&self` accessor the receiver is shared, so only
// the inner `&self` accessor can serve it — no gate, no separation; inside a
// `&var self` accessor the lend is `&var`, so it needs the inner exclusive one.
//
// A shared read of a nested copy-on-write buffer therefore copies nothing. The
// forwarding accessors are written in pairs where the bodies differ (§4), and
// `Blob` derives its shared twin with `@synthesize(shared)`, since its body is
// valid under both signatures: typechecked again under `&self`, its operand
// reaches `Data`'s shared accessor, which does not separate (§4).
//
// The refusal cell is
//   `errors/forwarded_lend_cannot_upgrade_an_inner_shared_lend.saw` — an outer
//     `-> &var T` backed by an inner `-> &T` is refused AT THE LEND, since a
//     read-only place cannot back a writable lend.
// Nothing is inferred from a body: the modes are the declarations' (§1, §3).
// EXPECT: success
// EXPECT-OUTPUT:
// shared forward reads 3, inner gates 0
// exclusive forward writes 4, inner gates 1
// shared forward reads again 4, inner gates 1
// nested CoW: outer read 7, partner still 7
// -- done
import std.data.*

struct Inner { cells: [Int; 2], gates: Int }

extension Inner {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        self.run_gate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

struct Outer { inner: Inner }

extension Outer {
    public func [](&self, i: Int) borrows -> &Int {
        lend self.inner[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        lend self.inner[i]
    }

    public func inner_gates(&self) -> Int { self.inner.gates_seen() }
}

// The nested copy-on-write case: a `Data` reached through a forwarding
// accessor. A shared read must not separate, so the partner sharing the buffer
// keeps its bytes AND its identity.
struct Blob { bytes: Data }

@synthesize extension Blob: Copy {}

extension Blob {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var UInt8 {
        lend self.bytes[i]
    }
}

func main() {
    var o = Outer(inner: Inner(cells: [3, 4], gates: 0))
    print("shared forward reads {o[0]}, inner gates {o.inner_gates()}")
    o[0] += 1
    print("exclusive forward writes {o[0]}, inner gates {o.inner_gates()}")
    print("shared forward reads again {o[0]}, inner gates {o.inner_gates()}")

    var built = try! Data(capacity: 2)
    try! built.push(7u8)
    try! built.push(8u8)
    let partner = built
    let blob = Blob(bytes: partner)
    print("nested CoW: outer read {blob[0]}, partner still {partner[0]}")
    print("-- done")
}
