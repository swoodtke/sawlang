// Conformance row X33 — two exclusive windows on an AUTO-Copy struct (String member)
//
// The AUTOMATIC Copy tier, which is what hid DF-188f: a receiver
// that copies for free had nothing for the copy-policy error to trip on, so
// two windows in one call compiled and both writes went into copies. The
// accessor is declared `&var self`, so each `borrow var` charges `r`
// exclusively (SL:borrowing §3) and the two borrows conflict on every tier.
// EXPECT: error

struct Rec { tag: String, a: Int, b: Int }
extension Rec {
    func at(&var self, i: Int) borrows -> &var Int {
        if i == 0 {
            lend self.a
        } else {
            lend self.b
        }
    }
}
func swap2(x: &var Int, y: &var Int) {
    let t = x
    x = y
    y = t
}
func main() {
    var r = Rec(tag: "t", a: 1, b: 2)
    swap2(borrow var r.at(0), borrow var r.at(1))
    print("a={r.a} b={r.b}")
}
