// Conformance row M23 — writing through the `&T` a shared borrow hands out
//
// `borrow let` binds a read-only place (SL:borrowing §2.1, §3), so a write
// through the binding is refused. The writable twin is `borrow var`, and a
// bare `borrow` is shared the same way (§2.2).
// EXPECT: error

func main() {
    var v: Vector<Int> = [1, 2, 3]
    let r = borrow let e = v[0] { e = 9; e }
    print(r)
}
