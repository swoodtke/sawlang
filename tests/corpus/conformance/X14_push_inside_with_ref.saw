// Conformance row X14 — `v.push` inside a shared element borrow of the same vector
//
// A reallocating `push` inside a SHARED element borrow: `borrow let` on `v[0]`
// charges the root shared (SL:borrowing §3, §4), and `push` needs it exclusively.
// The `try!` keeps the `push` itself legal, so the borrow is the one refusal.
// EXPECT: error

func main() {
    var v: Vector<Int> = [1, 2, 3]
    let r = borrow let e = v[0] {
        try! v.push(9)
        e
    }
    print(r)
}
