// Conformance row K123 — EVERY window opener reads the accessor's DECLARED
// mode, and the use site narrows within it (SL-333 R1/R3)
//
// The rule quantifies over "every position where a place window opens", so it
// is a FUNNEL with a matrix (obligation 1): `place_uses._window_call` is the one
// chokepoint, and its docstring names the seven author-visible entries. This
// file is the matrix's PERMITTED half — each entry opened at a mode the
// declaration allows — and `errors/shared_lend_write_refused_at_every_opener.saw`
// is its refused half, cell for cell.
//
//   entry                                   `-> &var T`        `-> &T`
//   1  subscript read/chain  `b[i].n`       shared   (here)    shared (here)
//   2  named accessor        `b.at(i).n`    shared   (here)    shared (here)
//   3  write through either  `b[i].n += 1`  exclusive(here)    REFUSED
//   4  `?.` chain assignment `b.get(i)?.n=` exclusive(here)    REFUSED
//   5  `!` head              `b.get(i)!.n`  either   (here)    shared (here)
//   6  `match`/`if let` on a place          shared   (here)    shared (here)
//   7  reference argument    `&var b[i]`    exclusive(here)    REFUSED
//   8  forwarded `lend b[i]` inside another accessor           (here; R7)
//
// (Seven openers, eight rows: the write and the reference argument are two
// spellings of the same entry in the funnel and two different things to a
// reader, so both are listed.)
// EXPECT: success
// EXPECT-OUTPUT:
// 1 subscript read 10
// 2 named read 20
// 3 write 11
// 4 chain write 21
// 5 forced read 11
// 6 match sees Filled
// 7 ref arg 12
// 8 forwarded 12
// read-only: subscript 10, named 10, forced 10, match Filled
// -- done

enum Slot { case Empty, case Filled(n: Int) }

struct Cell { n: Int }

struct Bag { cells: [Int; 4], slots: [Slot; 2], pairs: [Cell; 2] }

extension Bag {
    // The WRITABLE declaration: a use site may open either flavor.
    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.[]: index out of range") }
        lend self.cells[i]
    }

    public func at(&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.at: index out of range") }
        lend self.cells[i]
    }

    public func get(&var self, i: Int) borrows -> &var Int? {
        if i < 0 || i >= 4 { return None }
        lend self.cells[i]
    }

    public func slot(&var self, i: Int) borrows -> &var Slot {
        if i < 0 || i >= 2 { panic("Bag.slot: index out of range") }
        lend self.slots[i]
    }

    public func pair(&var self, i: Int) borrows -> &var Cell? {
        if i < 0 || i >= 2 { return None }
        lend self.pairs[i]
    }

    // Entry 8: a FORWARDED lend. It carries THIS specialization's mode, so the
    // shared copy reaches `[]` shared and the exclusive one reaches it
    // exclusively (R7).
    public func forwarded(&var self, i: Int) borrows -> &var Int {
        lend self.cells[i]
    }
}

// The READ-ONLY declaration: every use site opens a shared window, and nothing
// may widen it.
struct View { cells: [Int; 4], slots: [Slot; 2], pairs: [Cell; 2] }

extension View {
    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("View.[]: index out of range") }
        lend self.cells[i]
    }

    public func at(&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("View.at: index out of range") }
        lend self.cells[i]
    }

    public func get(&self, i: Int) borrows -> &Int? {
        if i < 0 || i >= 4 { return None }
        lend self.cells[i]
    }

    public func slot(&self, i: Int) borrows -> &Slot {
        if i < 0 || i >= 2 { panic("View.slot: index out of range") }
        lend self.slots[i]
    }
}

func bump(n: &var Int) { n = n + 1 }

func main() {
    var b = Bag(cells: [10, 20, 30, 40],
                slots: [Slot.Filled(n: 1), Slot.Empty],
                pairs: [Cell(n: 5), Cell(n: 6)])

    print("1 subscript read {b[0]}")
    print("2 named read {b.at(1)}")

    b[0] += 1
    print("3 write {b[0]}")

    b.pair(1)?.n = 21
    print("4 chain write {b.pair(1)!.n}")

    print("5 forced read {b.get(0)!}")

    match b.slot(0) {
        case Filled(_) -> { print("6 match sees Filled") },
        case Empty -> { print("6 match sees Empty") }
    }

    bump(&var b[0])
    print("7 ref arg {b.forwarded(0)}")
    print("8 forwarded {b.forwarded(0)}")

    // A `let` root may still READ through a writable accessor: the body mutates
    // nothing outside the place it lends, so it is shared-eligible (R4).
    let v = View(cells: [10, 20, 30, 40],
                 slots: [Slot.Filled(n: 1), Slot.Empty],
                 pairs: [Cell(n: 5), Cell(n: 6)])
    let matched = match v.slot(0) {
        case Filled(_) -> "Filled",
        case Empty -> "Empty"
    }
    print("read-only: subscript {v[0]}, named {v.at(0)}, forced {v.get(0)!}, match {matched}")
    print("-- done")
}
