// Conformance row K123 — EVERY borrow form reads the accessor's DECLARED mode
// (SL:borrowing §1, §3)
//
// Modes are declared, never inferred. The binding keyword is a capability on the
// place: a bare `borrow` (or `borrow let`) gives a read-only place and is always
// allowed, and `borrow var` gives a writable one and needs a `&var` lend. The
// ROOT charge follows the declaration alone: the `&var self` accessors below
// hold their root exclusively for every row, reads included, and the `&self`
// ones hold it shared. This file is the matrix's PERMITTED half, and
// `errors/shared_lend_write_refused_at_every_opener.saw` is its refused half.
//
//   form                                          `-> &var T`   `-> &T`
//   1  subscript read       `borrow b[i]`         read  (here)  read (here)
//   2  named accessor read  `borrow b.at(i)`      read  (here)  read (here)
//   3  write                `borrow var b[i] += 1` write (here) REFUSED
//   4  `?.` chain assignment `borrow var b.pair(i)?.n = …`  (here)  REFUSED
//   5  `!` head             `borrow b.get(i)!`    read  (here)  read (here)
//   6  `match` on a borrow block `borrow let s = b.slot(i)`  (here)  (here)
//   7  reference argument   `bump(borrow var b[i])` write (here) REFUSED
//   8  a `lend` inside another accessor           (here)
//
// A plain `b[i]` on `Bag` is no read at all: getitem derives only from a `&self`
// accessor (§5.2), and `Bag` declares none, so every read is written `borrow`.
// `View`'s plain `v[0]` is the derived getitem.
// EXPECT: success
// EXPECT-OUTPUT:
// 1 subscript read 10
// 2 named read 20
// 3 write 11
// 4 chain write 21
// 5 forced read 11
// 6 match sees Filled
// 7 ref arg 12
// 8 forwarded 12
// read-only: subscript 10, named 10, forced 10, match Filled
// -- done

enum Slot { case Empty, case Filled(n: Int) }

struct Cell { n: Int }

struct Bag { cells: [Int; 4], slots: [Slot; 2], pairs: [Cell; 2] }

extension Bag {
    // The WRITABLE declaration: every borrow through it charges the root
    // exclusively, and `borrow var` may write.
    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.[]: index out of range") }
        lend self.cells[i]
    }

    public func at(&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.at: index out of range") }
        lend self.cells[i]
    }

    public func get(&var self, i: Int) borrows -> &var Int? {
        if i < 0 || i >= 4 { return None }
        lend self.cells[i]
    }

    public func slot(&var self, i: Int) borrows -> &var Slot {
        if i < 0 || i >= 2 { panic("Bag.slot: index out of range") }
        lend self.slots[i]
    }

    public func pair(&var self, i: Int) borrows -> &var Cell? {
        if i < 0 || i >= 2 { return None }
        lend self.pairs[i]
    }

    // Row 8: a `lend` of the receiver's own storage inside another accessor,
    // borrowed here through the writable declaration, so the read below
    // charges `b` exclusively like every other row.
    public func forwarded(&var self, i: Int) borrows -> &var Int {
        lend self.cells[i]
    }
}

// The READ-ONLY declaration: every borrow through it charges the root shared,
// and nothing may widen it to a write.
struct View { cells: [Int; 4], slots: [Slot; 2], pairs: [Cell; 2] }

extension View {
    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("View.[]: index out of range") }
        lend self.cells[i]
    }

    public func at(&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("View.at: index out of range") }
        lend self.cells[i]
    }

    public func get(&self, i: Int) borrows -> &Int? {
        if i < 0 || i >= 4 { return None }
        lend self.cells[i]
    }

    public func slot(&self, i: Int) borrows -> &Slot {
        if i < 0 || i >= 2 { panic("View.slot: index out of range") }
        lend self.slots[i]
    }
}

func bump(n: &var Int) { n = n + 1 }

func main() {
    var b = Bag(cells: [10, 20, 30, 40],
                slots: [Slot.Filled(n: 1), Slot.Empty],
                pairs: [Cell(n: 5), Cell(n: 6)])

    print("1 subscript read {borrow b[0]}")
    print("2 named read {borrow b.at(1)}")

    borrow var b[0] += 1
    print("3 write {borrow b[0]}")

    borrow var b.pair(1)?.n = 21
    print("4 chain write {borrow b.pair(1)!.n}")

    print("5 forced read {borrow b.get(0)!}")

    borrow let s = b.slot(0) { match s {
        case Filled(_) -> { print("6 match sees Filled") },
        case Empty -> { print("6 match sees Empty") }
    } }

    bump(borrow var b[0])
    print("7 ref arg {borrow b.forwarded(0)}")
    print("8 forwarded {borrow b.forwarded(0)}")

    // A `let` root READS through the read-only declaration: its `&self`
    // accessors charge the root shared (§3).
    let v = View(cells: [10, 20, 30, 40],
                 slots: [Slot.Filled(n: 1), Slot.Empty],
                 pairs: [Cell(n: 5), Cell(n: 6)])
    let matched = borrow let s = v.slot(0) { match s {
        case Filled(_) -> "Filled",
        case Empty -> "Empty"
    } }
    print("read-only: subscript {v[0]}, named {borrow v.at(0)}, forced {borrow v.get(0)!}, match {matched}")
    print("-- done")
}
