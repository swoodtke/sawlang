// Conformance row T18 — `m[k]` on an absent key
//
// A plain `m[k]` is getitem: it copies the value out, and panics when the
// key is absent (SL:borrowing §5.1). The optional form is `m.get(k)`;
// `Map.[]` does not return an optional, so there is no `!` to write (§9).
// EXPECT: panic

func main() {
    var m = {"a": 1}
    print(m["zz"])
}
