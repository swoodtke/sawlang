// Conformance row C05 — enum payload-deep `==` reaching a payload type's
// hand-written conformance
//
// `Wrap`'s Equatable is the compiler's payload-deep body, which compares the
// active variant's payload by recursing on `Tag` — the same borrow C04 reaches
// through a struct field, one container over. Under `other: &Self` (design 239)
// the payload's own body receives a reference, so the recursion is sound at
// every container kind for one reason rather than per kind.
// EXPECT: success
// EXPECT-OUTPUT:
// ne
// drop 3
// drop 9

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
extension Tag: Equatable {
    func equals(&self, other: &Self) -> Bool {
        self.id == other.id
    }
}

enum Wrap { case Has(t: Tag) }
extension Wrap: NoCopy {}
@synthesize
extension Wrap: Equatable {}

func main() {
    let a = Wrap.Has(t: Tag(id: 9))
    let b = Wrap.Has(t: Tag(id: 3))
    if a == b { print("eq") }
    if a != b { print("ne") }
}
