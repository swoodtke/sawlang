// Conformance row G14 — `main` may not return an `Int?`
//
// The near miss: `Int?` looks like it carries a status and an "it failed", and
// it is not one of the four. `Result<Int, E>` is the shape that says the same
// thing and can also say WHY — which is why the diagnostic names it.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `main` must return `Void`, `Int`, `Result<Void, E>` or `Result<Int, E>`
// EXPECT-ERROR-CONTAINS: `Int?`

func main() -> Int? {
    None
}
