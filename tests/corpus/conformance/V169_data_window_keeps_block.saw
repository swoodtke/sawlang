// Conformance row V169 — a `Data` window cut by `slice` is O(1) and keeps
// its parent's block alive: it outlives the `Data` it was cut from, that
// binding's replacement and a write to it, which separates the writer and not
// the window, and the block is freed once, by its last owner (SL:borrowing §6).
// EXPECT: success
// EXPECT-OUTPUT:
// 3 2 4
// 3 2 4
// 100 3 2
// 2 3
import std.data.{Data}

func make(n: Int) -> Data {
    var d = Data()
    var i = 0
    while i < n {
        try! d.push(UInt8.from(truncating: i + 1))
        i += 1
    }
    d
}

func middle() -> Data {
    let whole = make(6)
    whole.slice(1, 4)!
}

func main() {
    let w = middle()
    print("{} {} {}", w.len(), w[0], w[2])
    var d = make(5)
    let x = d.slice(1, 4)!
    d = make(1)
    print("{} {} {}", x.len(), x[0], x[2])
    var e = make(4)
    let y = e.slice(1, 3)!
    e[0] = 100
    print("{} {} {}", e[0], e[2], y[0])
    print("{} {}", y[0], y[1])
}
