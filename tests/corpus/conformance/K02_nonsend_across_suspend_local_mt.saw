// Conformance row K02 — a non-Send across-suspend local in an MT group
//
// A frame crosses between worker threads at every suspension, so a non-Send
// LOCAL held across one is refused as firmly as a non-Send parameter.
//
// Re-authored against design 186: the audit used `Vector<Int>`, which IS `Send`
// now — the container ruling makes `Vector<T>` Send exactly when `T` is. A
// closure is never `Send`, so a `Vector` of them is the non-Send local.
//
// The element type renders `escaping` (DF-216e): a closure written as a generic
// ARGUMENT fills a container slot that outlives the frame that built it, so it
// is escaping wherever it is written, and the constructor spelling now says so
// as the annotation spelling always did.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot spawn `work` into a multi-threaded
// EXPECT-ERROR-CONTAINS: local `v` of type `Vector<() sync escaping -> Int, GlobalAllocator>` is held across a suspension but is not `Send`

import std.task.*

func work(n: Int) -> Int {
    var v = Vector<() sync -> Int>()
    try! v.push({ 1 })
    yield_now()
    v.len() + n
}

func main() {
    var group = try! TaskGroup(threads: 2)
    let h = group.spawn(work(1))
    print(h.join())
}
