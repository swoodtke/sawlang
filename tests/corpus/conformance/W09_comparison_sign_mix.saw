// Conformance row W09 — a COMPARISON over a signed and an unsigned operand of
// the same width is refused (design 195 rule 1, matrix row 4)
//
// The worst of the four rule-1 rows. `i < u` has no answer that is right for
// both operands: read as signed, a large `UInt` is negative; read as unsigned,
// a negative `Int` is enormous. Picking one silently is how a bounds test
// passes for a value that is out of bounds.
//
// PROBE (Aug 10, before the fix): `i < u` COMPILED, and `-1 < 3` answered
// `less` off a SIGNED compare — the left operand's interpretation applied to
// both. No warning, no diagnostic.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: requires both operands to have the same type
// EXPECT-ERROR-CONTAINS: `Int`
// EXPECT-ERROR-CONTAINS: `UInt`

func under(i: Int, u: UInt) -> Bool {
    i < u
}

func main() {
    print(under(-1, 3))
}
