// Conformance row K17 — a `&var` argument still live when the loop body ends
//
// One textual spawn, N live borrows. The body spawns with `&var total` and
// never joins, so every iteration adds another task holding the one root
// exclusively — the Law of Exclusivity violated by ITERATION rather than by a
// second line. Design 189 asks the question at the end of a loop body for the
// capture; design 201 puts the argument under the same question.
//
// The accept side is one line away and is pinned in K14 and in
// examples/spawn_capture_join_releases.saw: join the handle inside the body and
// each iteration's borrow is released before the next one opens.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: this task's `&var total` argument is still live when the loop body ends
// EXPECT-ERROR-CONTAINS: the next iteration would open a second exclusive borrow of the same root

import std.task.*

func bump(n: &var Int, k: Int) -> Int {
    yield_now()
    n = n + k
    n
}

func main() {
    var total = 0
    var group = TaskGroup()
    for i in 0..4 {
        let h = group.spawn(bump(&var total, i))
    }
    print("total {total}")
}
