// Design 72 M1: `.swap(i, j)` swaps two elements of a fixed array in place
// (the dynamic-index escape hatch, mirroring Vector.swap). Bounds-checked.
// EXPECT: success
// EXPECT-OUTPUT:
// 40
// 10
// 30
// 20
func main() {
    var a = [10, 20, 30, 40]
    a.swap(0, 3)            // -> [40, 20, 30, 10]
    print(a[0])            // 40
    print(a[3])            // 10

    // dynamic indices
    var i = 1
    var j = 2
    a.swap(i, j)           // -> [40, 30, 20, 10]
    print(a[1])            // 30
    print(a[2])            // 20
}
