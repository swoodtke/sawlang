// Acceptance: `Mutex.lock()` is `borrows(sync)` (SL:borrowing §2.5, §8), so
// its borrow cannot span a suspension; a block body that only calls
// suspension-free helpers is accepted and runs.
// EXPECT: success
// EXPECT-OUTPUT:
// 6

import std.mutex.{Mutex}
func double(n: Int) -> Int {
    n * 2
}

func main() {
    let m = Mutex<Int>(value: 3)
    borrow var c = m.lock() {
        c = double(c)
        true
    }
    print(m.get())   // 6 (design 123: `get` is no longer optional)
}
