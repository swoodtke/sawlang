// A fixed array of trivially-copyable elements stays trivially copyable
// (design 33, today's behavior unchanged): `let b = a` bitwise-copies the whole
// array, and the two are independent.
// EXPECT: success
// EXPECT-OUTPUT:
// 100
// 1
// 3

func main() {
    var a = [1, 2, 3]
    let b = a          // trivial array: silent bitwise copy, no move needed
    a[0] = 100
    print(a[0])        // 100
    print(b[0])        // 1  (b independent of a)
    print(b[2])        // 3
}
