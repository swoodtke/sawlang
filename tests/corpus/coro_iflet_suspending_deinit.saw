// design 62 G2: drop-flag exactness for the hoisted temp. The suspending call
// returns an owning `Res?`; the hoisted `Res?` temp's payload must deinit EXACTLY
// ONCE on BOTH branches — once when the Some path consumes/holds it, and never on
// the None path (the temp is None, its drop flag reads not-live). The deinit oracle
// prints 900+id, so the single `907` proves exactly-once for worker(7) and the
// absence of any deinit for worker(0).
//
// design 124: the payload drops at worker(7)'s own completion — the first
// `join()` drives it to Done, and the release runs before that join returns.
// EXPECT: success
// EXPECT-OUTPUT:
// 907
// 7
// -1

import std.task.*
struct Res { id: Int }
extension Res: NoCopy { func deinit(&var self) { print(900 + self.id) } }

func maybe_res(n: Int) -> Res? {
    yield_now()
    if n > 0 {
        return Res(id: n)
    }
    return None
}

func worker(n: Int) -> Int {
    if let r = maybe_res(n) {
        return r.id       // Some: payload lives in the frame, dropped once
    }
    return -1             // None: nothing to drop
}

func main() {
    var group = TaskGroup()
    let h1 = group.spawn(worker(7))    // Some(Res(7))
    let h2 = group.spawn(worker(0))    // None
    print(h1.join())   // 7
    print(h2.join())   // -1
    // worker(7)'s Res(7) dropped exactly once (907) at its completion; worker(0)
    // never built one
}
