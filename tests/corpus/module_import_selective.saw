// Test selective import - only specified symbols accessible
// EXPECT: success
// EXPECT-OUTPUT: 42
// EXPECT-OUTPUT: 40
import modules.utils.{double, Point}

func main() {
    // double and Point are directly accessible
    let result = double(21)
    print(result)  // 42

    let p1 = Point(x: 10, y: 20)
    let p2 = Point(x: 5, y: 5)
    let p3 = p1.add(p2)
    print(p3.magnitude())  // 40

    // Note: triple is NOT accessible - would need utils.triple() or add to import list
}
