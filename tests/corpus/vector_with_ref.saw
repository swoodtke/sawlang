// The scoped, no-copy element borrow: a `borrow let`/`borrow var` block over
// `v[i]` (SL:borrowing §2.1, §9). The binding reaches the element in place;
// the vector's root is charged for the whole block (so it can neither be
// reallocated nor the element invalidated), and the borrow is a lend
// (nothing retained). The block's value flows out.
// EXPECT: success
// EXPECT-OUTPUT:
// 20
// 99
// 3

func main() {
    var v: Vector<Int> = [10, 20, 30]

    // Shared borrow: the block's value is the element, copied out.
    let x = borrow let e = v[1] { e }
    print(x)              // 20

    // Exclusive borrow: mutate in place through the `borrow var` binding.
    borrow var e = v[1] { e += 79 }
    print(v.get(1)!)     // 99

    // The vector is intact and unchanged in length after the borrows.
    print(v.len())       // 3
}
