// DF-217i, FIXED by design 219 wave C: a generic body no longer evades the
// copy-tier rules — `let a = sink(x); let b = sink(x)` on an abstract `T`
// infers a `Copy` requirement, and the call site discharges it.
//
// Instantiated at a NoCopy type this used to print THREE deinits for ONE value
// and read the payload after two of them: a use-after-free out of fully safe
// code with no `unsafe` anywhere. The concrete twin of the same body was
// refused all along, so the abstract `T` was being treated as the MOST
// permissive tier where it should be treated as the least.
//
// Sweep S1 widened it and wave C closes every row: a bound does not help,
// nesting multiplies the releases, generic METHODS leak identically, and a
// generic COROUTINE launders across a suspend because the post-transform
// re-check sees only abstract `T`. The requirement is a property of the
// AUTHORED body, inferred once while it is checked, so all four refuse at the
// call — see `conformance/V36`-`V40` for the row-by-row ledger.
//
// The refusal names the tier from the ARGUMENT's side ("move-only") rather
// than repeating the conformance spelling, because the reader's question at a
// call site is what this type can do, not what it declared.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: requires `T` to be `Copy`

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("DEINIT {self.name}") }
}

func sink<T>(a: T) -> Int { 1 }

func twice<T>(x: T) -> Int {
    let a = sink(x)
    let b = sink(x)
    a + b
}

func main() {
    let r = Res(name: "r1")
    print("n {twice(move r)}")
    print("after")
}
