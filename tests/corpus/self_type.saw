// Test Self type in trait method return types
// EXPECT: success
// EXPECT-OUTPUT:
// 84

trait Copyable {
    func copy(&self) -> Self
}
struct Point {
    x: Int
    y: Int
}
extension Point: Copyable {
    func copy(&self) -> Point {
        Point(x: self.x, y: self.y)
    }
}
func main() {
    let p1 = Point(x: 42, y: 0)
    let p2 = p1.copy()
    print(p1.x + p2.x)
}
