// The discard-form family matrix (DF-217l / DF-217n): every form that
// discards an OWNED value releases it exactly once. One row per form:
//   1. `let _ = <owned>`             — immediate release (always worked)
//   2. `match ... case Two(_, _)`    — both unclaimed fields drop (DF-217n)
//   3. `match ... case Two(v, _)`    — mixed: `v` at arm end, `_` after it
//   4. `if let _ = move opt`         — the blessed consume (DF-217l)
// A part no binding takes dies when the construct that took it completes,
// after the body (SL-513 ruling B); a named binding drops at its arm's end.
// This file's twin in `examples/` pins Stage 0, which drops a `_` part at arm
// entry instead (SL:hazards C11). The oracle is a NoCopy deinit that prints.
//
// Row 2's ORDER is reverse-declaration — `B` then `A` — since DF-218y (ruled
// Aug 22: discard order is reverse-declaration everywhere). It read forward
// here until then, which was an artifact of dropping each field where it was
// extracted rather than a contract: the enum's own synthesized deinit is
// reverse (design 128), so the forward loop was the one drop path in the
// language that disagreed with the rest of it — and with its own driven twin,
// which releases the payload as a whole value through that deinit.
// Row 3 is unaffected: it discards a single field, so it has no order.
// EXPECT: success
// EXPECT-OUTPUT:
// before let _
// DEINIT L1
// after let _
// two discarded
// DEINIT B
// DEINIT A
// kept C
// DEINIT C
// DEINIT D
// if let _ ran
// DEINIT O1
// done

struct Res { name: String }

extension Res: NoCopy {
    func deinit(&var self) {
        print("DEINIT {self.name}")
    }
}

enum Pair {
    case Two(a: Res, b: Res),
    case Zero
}
extension Pair: NoCopy {}

func main() {
    print("before let _")
    let _ = Res(name: "L1")
    print("after let _")

    let p = Pair.Two(a: Res(name: "A"), b: Res(name: "B"))
    match p {
        case Two(_, _) -> print("two discarded"),
        case Zero -> print("zero")
    }

    let q = Pair.Two(a: Res(name: "C"), b: Res(name: "D"))
    match q {
        case Two(v, _) -> print("kept {v.name}"),
        case Zero -> print("zero")
    }

    var o: Res? = Res(name: "O1")
    if let _ = move o {
        print("if let _ ran")
    }
    print("done")
}
