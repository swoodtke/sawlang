// design 76 (A4): TCP echo over the loopback interface (127.0.0.1, ephemeral
// port) inside a TaskGroup — the full listen/accept/connect/read/write surface.
// The server accepts a connection (parking until one arrives), reads, and echoes;
// the client connects (parking until writable), sends "hey", and reads it back.
// Deterministic on byte-count + content. Loopback only — no external network.
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 1

import std.net.{TcpListener, TcpStream}

func server(listener: TcpListener) -> Int {
    let stream = try! listener.accept()     // parks until the client connects
    let chunk = try! stream.read()          // parks until the client sends
    let n = chunk.len()
    try! stream.write(move chunk)           // echo the bytes back
    return n
}

func client(port: Int) -> Int {
    // design 184: the literal parses in std.net and never sees a resolver.
    let stream = try! TcpStream.connect("127.0.0.1", port)   // parks until connected
    try! stream.write("hey")
    let echo = try! stream.read()           // parks until the echo arrives
    if (try! echo.to_string()) == "hey" { 1 } else { 0 }
}

func main() {
    let listener = try! TcpListener.listen(0)
    let port = try! listener.local_port()
    var group = TaskGroup()
    let hs = group.spawn(server(move listener))
    let hc = group.spawn(client(port))
    print(hs.join())    // 3 bytes echoed
    print(hc.join())    // 1 = content round-tripped
}
