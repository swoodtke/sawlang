// Test automatic deinit calls at scope exit
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 2
// 1

struct Counter {
    id: Int
}
extension Counter: NoCopy {
    func deinit(&var self) {
        print(self.id)
    }
}
func main() {
    let c1 = Counter(id: 1)
    let c2 = Counter(id: 2)
    let c3 = Counter(id: 3)
    // deinit should be called in reverse order: 3, 2, 1
}
