// The positive half of the DF-163d refusals: every position a reference is
// still allowed to appear, in one file, so tightening the rule further has to
// say so out loud.
//
// A reference is a call ARGUMENT and nothing else -- plus the implicit lend a
// `borrows` accessor makes. So: `&`/`&var` arguments to a function and to a
// method, a re-borrow forwarded onward (design 106), a reference argument to a
// GENERIC call (whose type argument is the value type -- refusing `f<&Int>` must
// never refuse `f(&x)`), a `borrow let` binding read out as its block's
// value (SL:borrowing §2.1), and a `borrows` accessor's read and write under
// `borrow`/`borrow var`, whose root charge follows its `&var self` (§3).
// EXPECT: success
// EXPECT-OUTPUT:
// 7
// 8
// 12
// 5
// 8
// 20
// 21

struct Cell { n: Int }

struct Bin { c: Cell, v: Vector<Int> }

extension Bin: NoCopy {}

extension Bin {
    func slot(&var self) borrows -> &var Cell { lend self.c }
}

extension Cell {
    func plus(&self, other: &Int) -> Int { self.n + other }
}

func read_one(x: &Int) -> Int { x }

func bump(x: &var Int) { x += 1 }

func forward(r: &var Int) { bump(&var r) }

func peek<T: Copy>(r: &T) -> T { r }

func main() {
    var n = 7
    print("{read_one(&n)}")
    bump(&var n)
    print("{n}")

    var m = 11
    forward(&var m)
    print("{m}")

    let k = 3
    let c = Cell(n: 2)
    print("{c.plus(&k)}")

    print("{peek<Int>(&n)}")

    var v: Vector<Int> = [20, 30]
    print("{borrow let e = v[0] { e }}")

    var b = Bin(c: Cell(n: 20), v: move v)
    borrow var b.slot().n += 1
    print("{borrow b.slot().n}")
}
