// A shared borrow binds its element READ-ONLY. Every read works, at every
// nesting depth and on a `let` root, through the `@synthesize(shared)` twins
// (SL:borrowing §4). A write through bare `borrow` is refused (§2.2), so a
// write says `borrow var` and needs a `var` root.
//
//
// The enum element: `flip` is a `&var self` method, so `borrow var v[0].flip()`
// borrows the vector's element exclusively, which is why the `var` root below
// is required and the `let` root in
// errors/place_window_enum_method_let_root.saw is refused. The enum's
// `&self` method reads through the vector's shared accessor.
// EXPECT: success
// EXPECT-OUTPUT:
// flipped green
// frozen red
// nested read 2
// nested write 12
// -- done

enum Light { case Red, case Green }

extension Light {
    func flip(&var self) {
        match self {
            case Red -> { self = Light.Green },
            case Green -> { self = Light.Red }
        }
    }
    func name(&self) -> String {
        match self { case Red -> "red", case Green -> "green" }
    }
}

struct Cell { count: Int }
struct Row { cells: [Cell; 2] }
struct Bag { rows: [Row; 2] }

extension Row {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Cell {
        if i < 0 || i >= 2 { panic("Row.[]: index out of range") }
        lend self.cells[i]
    }
}

extension Bag {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Row {
        if i < 0 || i >= 2 { panic("Bag.[]: index out of range") }
        lend self.rows[i]
    }
}

func lights() -> Vector<Light> {
    var v = Vector<Light>()
    try! v.push(Light.Red)
    move v
}

func main() {
    var v = lights()
    borrow var v[0].flip()
    print("flipped {v[0].name()}")

    // A shared read over the same vector, on an immutable root.
    let frozen = lights()
    print("frozen {frozen[0].name()}")

    var b = Bag(rows: [Row(cells: [Cell(count: 1), Cell(count: 2)]),
                       Row(cells: [Cell(count: 3), Cell(count: 4)])])
    print("nested read {b[0][1].count}")
    borrow var b[0][1].count += 10
    print("nested write {b[0][1].count}")
    print("-- done")
}
