import modules.qualname_static_dep

func main() unsafe {
    qualname_static_dep.ARR[1] = 41
    print("{qualname_static_dep.ARR[1]}")
    qualname_static_dep.ARR[1] += 1
    print("{qualname_static_dep.ARR[1]}")
    qualname_static_dep.CELL.v = 7
    print("{qualname_static_dep.CELL.v}")
    qualname_static_dep.CELL.v += 1
    print("{qualname_static_dep.CELL.v}")
}
