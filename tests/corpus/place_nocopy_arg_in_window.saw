// Calling a method on a PLACE and handing it `&var` to a NoCopy LOCAL works:
// the window's body is code the author wrote in the enclosing scope, so it
// captures that scope's bindings BY BORROW (DF-169h).
//
// It used to be ``cannot copy value of type `Sink` which implements NoCopy``,
// anchored at the subscript, though the program copies no `Sink` anywhere —
// the window lowers to a closure and the local was captured by value. A `&var`
// PARAMETER forwarded into the same window was always fine (its plain capture
// copies the POINTER), which is why the design-169 derived `Vector` walk never
// hit it and why `v[i].serialize(to: &var enc)` over a locally-built encoder
// was the shape that did.
//
// Both spellings feed the same sink.
// EXPECT: success
// EXPECT-OUTPUT:
// forwarded param: 1
// place receiver: 2
// value receiver: 3

struct Sink { n: Int }

extension Sink: NoCopy {}

struct Item { code: String }

extension Item {
    func feed(&self, into: &var Sink) {
        into.n = into.n + 1
    }
}

// A `&var` parameter forwarded into the window: this half already works.
func feed_all(items: &Vector<Item>, into: &var Sink) {
    var i = 0
    while i < items.len() {
        items[i].feed(into: &var into)
        i = i + 1
    }
}

func main() {
    var items = Vector<Item>()
    try! items.push(Item(code: "a"))
    var s = Sink(n: 0)

    feed_all(&items, &var s)
    print("forwarded param: {}", s.n)

    // The receiver is a place and the argument names a NoCopy local.
    items[0].feed(into: &var s)
    print("place receiver: {}", s.n)

    // Reading the element out first is what compiles today.
    let one = items[0]
    one.feed(into: &var s)
    print("value receiver: {}", s.n)
}
