// EXPECT: success
// EXPECT-OUTPUT:
// 10

// Simple test of optional struct

struct Point {
    x: Int
    y: Int
}

func main() {
    // Optional struct with implicit wrapping
    let p: Point? = Point(x: 10, y: 20)

    // Force unwrap and access field
    let unwrapped: Point = p!
    print(unwrapped.x)
}
