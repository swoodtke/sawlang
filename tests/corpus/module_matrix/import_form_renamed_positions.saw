// Position matrix (design 235), grid 1 "Import forms x name positions" —
// form: `as`-RENAMED qualifier (`import mod.lib as lf`). Same shape as
// import_form_qualified_positions.saw — a renamed qualifier is still a
// qualifier, so (c) an extension receiver and (f) a match pattern are
// N/A for the same grammar reason (both need a bare name; a rename does
// not make one).
//
// EXPECT: success
// EXPECT-OUTPUT:
// annotation = 5
// expression = 6
// generic bound = widget
// existential = widget
// interpolation = 8
// default param = 7
// default param override = 2

import modules.importforms.lib as lf

// (a) annotation
func take(w: lf.Widget) -> Int { w.n }

// (d) generic bound
func show<T: lf.Named>(t: &T) -> String { t.label() }

// (e) existential
func show_any(t: &any lf.Named) -> String { t.label() }

// (h) default parameter value
func with_default(n: Int = lf.DEFAULT_N) -> Int { n }

func main() {
    // (a) annotation
    let w: lf.Widget = lf.Widget(n: 5)
    print("annotation = {take(w)}")

    // (b) expression
    let w2 = lf.make_widget(6)
    print("expression = {w2.n}")

    print("generic bound = {show(&w)}")
    print("existential = {show_any(&w)}")

    // (g) interpolation — the RENAMED qualifier inside the braces
    print("interpolation = {lf.make_widget(8).n}")

    print("default param = {with_default()}")
    print("default param override = {with_default(2)}")
}
