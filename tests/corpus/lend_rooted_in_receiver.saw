// The ACCEPT side of design 188 unit 3. "The lent place must be storage reached
// through the receiver" has to keep every shape a `borrows` accessor is FOR, so
// all four are exercised here:
//
//   * a field of the receiver (`lend self.a`)
//   * an element of a container the receiver owns (`lend self.cells[i]`) — this
//     is the ordinary accessor, and the one std's own types are written as
//   * a MATCH-ARM payload of a borrowed receiver element, bound with `borrow
//     var` (SL:borrowing §2.7), which is how a slot-enum container gets an
//     accessor at all
//   * an INDIRECTION out of the receiver. `Vector.[]` lends `buf[index]` where
//     `buf` came out of `self.buffer`, and `Data.[]` lends through a pointer
//     local cast from `self.byte_ptr()`. Neither place is `self.…` on its face
//     and both are the receiver's own heap, which no more dies with the
//     accessor than a field does — so the reads and writes below, which run
//     through exactly those two accessors, are the carve-out's regression test.
//
// EXPECT: success
// EXPECT-OUTPUT: field=8
// EXPECT-OUTPUT: element=20
// EXPECT-OUTPUT: payload=33
// EXPECT-OUTPUT: vector=7
// EXPECT-OUTPUT: data=9

import std.data.*

struct Cell {
    n: Int
}

enum Slot {
    case Filled(c: Cell),
    case Empty
}

struct Board {
    a: Cell,
    cells: Vector<Cell>,
    slots: Vector<Slot>
}

extension Board: NoCopy {}

extension Board {
    func head(&var self) borrows -> &var Cell {
        lend self.a
    }

    func cell(&var self, i: Int) borrows -> &var Cell {
        if i < 0 || i >= self.cells.len() { panic("Board.cell: out of range") }
        lend self.cells[i]
    }

    func slot(&var self, i: Int) borrows -> &var Cell? {
        if i < 0 || i >= self.slots.len() { return None }
        borrow var entry = self.slots[i] {
            match entry {
                case Filled(borrow var c) -> { lend c },
                case Empty -> { return None }
            }
        }
    }
}

func main() {
    var cells: Vector<Cell> = []
    try! cells.push(Cell(n: 10))
    var slots: Vector<Slot> = []
    try! slots.push(Slot.Filled(c: Cell(n: 30)))
    var b = Board(a: Cell(n: 1), cells: move cells, slots: move slots)

    borrow var b.head().n += 7
    print("field={borrow b.head().n}")

    borrow var b.cell(0).n += 10
    print("element={borrow b.cell(0).n}")

    borrow var b.slot(0)!.n += 3
    print("payload={borrow b.slot(0)!.n}")

    var v: Vector<Int> = [1, 2]
    v[0] += 6
    print("vector={v[0]}")

    var d = Data()
    try! d.push(1)
    d[0] = 9
    print("data={d[0]}")
}
