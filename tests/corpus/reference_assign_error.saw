// Design 110: whole-referent replacement `x = v` is legal through a `&var`
// reference but stays BANNED through an immutable `&` reference (read-only).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot assign through immutable reference

func replaceValue(y: &Int) {
    y = 42  // Error: `&Int` is read-only, cannot replace the referent
}

func main() {
    var x = 10
    replaceValue(&x)
}
