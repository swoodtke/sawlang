// Design 216 gave `map`/`each`/`fold` a `(&T)` element and no `sync` constraint,
// and this file used to read that as "a suspending transform works". It does not,
// and never did: the suspension ran OUTSIDE every frame, where `yield_now()`
// codegens to nothing. Design 275 U1 measured it — four `declined` SITE rows and
// three `declined` FRAME rows in the discovery ledger, the whole of the corpus's
// silent-decline worklist — and U2 refuses it.
//
// THE MECHANISM, read off the ledger's two tables together: the driven root
// `traverse` has an EMPTY cause set, because its three suspending helpers are
// called from inside CLOSURE LITERALS. The effect graph raises the conservative
// closure-call cause on the METHOD (`Vector.map`) and records no direct
// `traverse -> slow_double` edge, so the closure walk never reaches the helpers,
// no frame is built for any of them, and their `yield_now()` runs in nobody's
// frame. The values printed were right either way, which is what let this sit in
// the corpus as a passing test with the limitation written in its own header.
//
// The refusal is the shape table's `ClosureExpr` REFUSE row (`sawc/coro_shapes.py`),
// raised by the ONE rejector at the closure the author wrote. What design 216
// really claims — a `(&T)` element parameter, no copy bound, move-only elements
// traversed — is unaffected and is covered by
// `vector_closures_over_nocopy_elements.saw`.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: appears inside a CLOSURE BODY in driven `traverse`
// EXPECT-ERROR-CONTAINS: vector_closure_suspending_transform.saw:41:42

import std.task.*

func slow_double(n: Int) -> Int {
    yield_now()
    n * 2
}

func traverse() -> Int {
    var v = Vector<Int>()
    try! v.push(10)
    try! v.push(20)
    try! v.push(30)

    // A suspending transform: refused at the closure, not silently dropped.
    let doubled = try! v.map<Int>({ n in slow_double(n) })
    doubled.len()
}

func main() {
    var g = TaskGroup()
    let t = g.spawn(traverse())
    let _ = t.join()
}
