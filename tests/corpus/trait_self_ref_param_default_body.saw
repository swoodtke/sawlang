// A trait DEFAULT BODY receives a `&Self` parameter as the reference it is, and
// forwards it to a sibling requirement as design 106's ordinary re-borrow —
// which, like every reference argument in Saw, is SPELLED (`&other`).
//
// DF-239a's second face was filed against the unspelled forward, on the reading
// that the per-conformer compile had substituted `&Self` to the bare value. It
// had not: `Bag_doubled` really does take `%Bag*`, and the unspelled forward is
// the same error a plain `&Bag` parameter gives — Saw has no implicit re-borrow
// at any type. This file pins the working spelling.
// EXPECT: success
// EXPECT-OUTPUT: 14
trait Merges {
    func merge(&self, other: &Self) -> Int
    func doubled(&self, other: &Self) -> Int {
        self.merge(&other) * 2
    }
}

struct Bag {
    n: Int
}

extension Bag: Merges {
    func merge(&self, other: &Self) -> Int { self.n + other.n }
}

func main() {
    let x = Bag(n: 3)
    let y = Bag(n: 4)
    print(x.doubled(&y))
}
