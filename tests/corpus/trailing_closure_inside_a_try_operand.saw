// A trailing closure is an argument of the call it follows, inside a `try`
// operand exactly as outside one: `try! jobs.map { j in j.label() }` calls
// `map` with the closure, and so do the `try` and `try?` forms. The first line
// printed is the control, the same call with the closure parenthesized.
//
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 1
// 1
// 1

struct Job { name: String }
extension Job: NoCopy {}

extension Job {
    func label(&self) -> String { self.name }
}

func fresh() -> Vector<Job> {
    var v = Vector<Job>()
    try! v.push(Job(name: "alpha"))
    move v
}

// The control: the same call with the closure parenthesized.
func parenthesized() -> Int {
    let jobs = fresh()
    let labels = try! jobs.map<String>({ j in j.label() })
    return labels.len()
}

// The three cells: one per `try` variant, each with a trailing closure.
func forced() -> Int {
    let jobs = fresh()
    let labels = try! jobs.map { j in j.label() }
    return labels.len()
}

func optional_variant() -> Int {
    let jobs = fresh()
    let labels = try? jobs.map { j in j.label() }
    return labels!.len()
}

func propagating() -> Result<Int, AllocError> {
    let jobs = fresh()
    let labels = try jobs.map { j in j.label() }
    return labels.len()
}

func main() {
    print(parenthesized())
    print(forced())
    print(optional_variant())
    print(try! propagating())
}
