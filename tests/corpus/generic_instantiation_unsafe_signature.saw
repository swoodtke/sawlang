// DF-217k, FIXED by design 219 wave C: design 130's signature rule is DERIVED
// per instance, so a generic instantiated at an unsafe type must say so.
//
// `idn<T>` at `T = UnsafePointer<Int8>` RECEIVES and RETURNS a value of unsafe
// type and used to compile with no `unsafe` in its effect slot; the concrete
// twin was refused at the declaration all along. The instantiated signature is
// the one a reader of the call site sees, and it was lying about its domain.
//
// Memory-safe as it stood — the caller rule still fired, which is why this was
// declaration hygiene rather than a soundness hole — but design 130's whole
// claim is that unsafety is TYPE-CARRIED and visible in the signature, and a
// monomorphized signature is a signature. The refusal anchors at the CALL,
// where the type argument that makes the signature unsafe is written; the
// template stays exempt when it was already unsafe on its own terms.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: not declared `unsafe`

func idn<T>(x: T) -> T { move x }

func make_ptr() unsafe -> UnsafePointer<Int8> {
    0 as UnsafePointer<Int8>
}

func caller() unsafe -> Int {
    let p = idn(make_ptr())
    p as Int
}

func main() {
    print("n {caller()}")
}
