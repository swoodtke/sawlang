// When an accessor's shared and exclusive bodies differ, both are written
// (SL:borrowing §4): a `&self` accessor for reads and a `&var self` one for
// writes, each an ordinary body.
//
// A read goes through the shared accessor, since a plain read is the getitem
// derived from it (§5.2), and a write through the exclusive one. So the gate
// lives only in the body that may write `self`. The printed transcript is the
// proof: a read says `shared path` and leaves `gates` alone, a write says
// nothing and bumps it.
// EXPECT: success
// EXPECT-OUTPUT:
// shared path
// read 3, gates 0
// shared path
// read through a ref 1, gates 0
// wrote, gates 1
// shared path
// read back 42, gates 1
// -- done

struct Grid {
    cells: [Int; 4],
    gates: Int
}

extension Grid {
    func run_gate(&var self) {
        self.gates = self.gates + 1
    }

    func note_shared(&self) {
        print("shared path")
    }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 {
            panic("Grid.[]: index out of range")
        }
        self.note_shared()
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 {
            panic("Grid.[]: index out of range")
        }
        self.run_gate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int {
        self.gates
    }
}

func read_through_ref(g: &Grid) -> Int {
    g[0]
}

func main() {
    var g = Grid(cells: [1, 2, 3, 4], gates: 0)
    print("read {g[2]}, gates {g.gates_seen()}")
    print("read through a ref {read_through_ref(&g)}, gates {g.gates_seen()}")
    g[2] = 42
    print("wrote, gates {g.gates_seen()}")
    print("read back {g[2]}, gates {g.gates_seen()}")
    print("-- done")
}
