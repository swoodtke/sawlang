//               "signature": "public func tally(&var self, i: Int) borrows -> &var Int",
//               "visibility": "public",
//               "generics": [],
//               "params": [
//                 {
//                   "name": "i",
//                   "label": "i",
//                   "type": "Int"
//                 }
//               ],
//               "returns": "&var Int",
//               "effect": "sync",
//               "self": "borrows-var",
//               "static": false,
//               "doc": "The element at `i`, counting the visit -- EXCLUSIVE-ONLY.",
//               "line": 175
//             }
//           ],
//           "doc": null,
//           "line": 149,
//           "module": "doc_emit_borrows"
//         },
//         {
//           "kind": "struct",
//           "name": "Bag",
//           "signature": "struct Bag",
//           "visibility": "private",
//           "unsafe": false,
//           "generics": [],
//           "conformances": [],
//           "fields": [],
//           "doc": null,
//           "line": 147,
//           "module": "doc_emit_borrows"
//         }
//       ]
//     }
//   ]
// }

struct Bag { items: [Int; 4], visits: Int }

extension Bag {
    /// The element at `i`, as a place.
    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 {
            panic("Bag.[]: index out of range")
        }
        lend self.items[i]
    }

    /// The element at `i` if it exists -- an optional place.
    public func get(&var self, i: Int) borrows -> &var Int? {
        if i < 0 || i >= 4 {
            return None
        }
        lend self.items[i]
    }

    /// The element at `i`, READ-ONLY -- a shared lend.
    public func peek(&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 {
            panic("Bag.peek: index out of range")
        }
        lend self.items[i]
    }

    /// The element at `i`, counting the visit -- EXCLUSIVE-ONLY.
    public func tally(&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 {
            panic("Bag.tally: index out of range")
        }
        lend self.items[i]
        self.visits = self.visits + 1
    }
}
