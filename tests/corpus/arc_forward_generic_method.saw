// Refused: Box/Arc forwarding is dropped (SL-712), so a payload method is reached with `borrow p.value().m()`.
// A METHOD-GENERIC payload method is not forwarded either: `cell.apply(body)`
// on an `Arc<Cell<Int>>` names a method of the payload, not of the `Arc`, and
// is refused at that first call, inside `run`. Every later call in the file,
// through `Arc` and through `Box`, inferred or explicit type arguments alike,
// is the same refused shape; each compiles as `borrow p.value().apply(…)`.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `apply` is a method of the payload

struct Cell<T> {
    value: T
}

extension Cell<T> {
    func apply<R>(&self, body: (T) sync -> R) -> R {
        body(self.value)
    }
}

struct Tag {
    name: String
}

extension Tag {
    func map<R>(&self, body: (String) sync -> R) -> R {
        body(self.name)
    }
}

// The method's type argument is this function's own type parameter: codegen
// substitutes `R` against the active monomorphization context, then mangles.
func run<R>(cell: Arc<Cell<Int>>, body: (Int) sync -> R) -> R {
    cell.apply(body)
}

func main() {
    let ints = try! Arc<Cell<Int>>(value: Cell<Int>(value: 21))
    print(ints.apply({ n in n * 2 }))            // inferred R = Int
    print(ints.apply<String>({ n in "v{n}" }))   // explicit R = String

    let words = try! Arc<Cell<String>>(value: Cell<String>(value: "hello"))
    print(words.apply({ s in s.len() }))
    print(words.apply({ s in s.to_uppercase() }))

    let tag = try! Box<Tag>.make(Tag(name: "saw"))
    print(tag.map({ s in s.len() }))
    print(tag.map({ s in "tag={s}" }))

    print(run(ints, { n in n + 1 }))
    print(run(ints, { n in "n{n}" }))
}
