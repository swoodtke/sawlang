// Test: nested field assignment through an array element mutates real storage
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 77

struct Inner { v: Int }
struct Outer { inner: Inner }

func main() {
    var a = [Outer(inner: Inner(v: 1)), Outer(inner: Inner(v: 2))]
    let i = 1
    a[i].inner.v = 77
    print(a[0].inner.v)   // 1 (untouched)
    print(a[1].inner.v)   // 77
}
