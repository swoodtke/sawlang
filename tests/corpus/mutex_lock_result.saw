// A `borrow var` block over `Mutex.lock()` yields what the critical section
// computed (review M1): a block is an expression whose value is its tail
// (SL:borrowing §2.1), so a value computed under the lock is carried out of
// it, and a block that computes nothing is a statement. Reached directly and
// through `Arc<Mutex<T>>`, the Arc forward DF-123c pins. The tail's type is
// the block's own: Int, Bool or String here.
// EXPECT: success
// EXPECT-OUTPUT:
// 10
// 6
// true
// n=6
// 11
// 30
// hello 30

import std.mutex.{Mutex}

func main() {
    let m = Mutex<Int>(value: 5)
    print(borrow var n = m.lock() { n * 2 })        // yields Int
    borrow var n = m.lock() { n = n + 1 }           // yields nothing
    print(m.get())
    print(borrow var n = m.lock() { n > 0 })        // yields Bool
    print(borrow var n = m.lock() { "n={n}" })      // yields String

    let shared = try! Arc<Mutex<Int>>(value: Mutex<Int>(value: 10))
    print(borrow var n = shared.lock() { n + 1 })   // forwarded, yields Int
    borrow var n = shared.lock() { n = n * 3 }      // forwarded, yields nothing
    print(borrow var n = shared.lock() { n })

    // A String computed under the lock outlives the critical section.
    let greeting = borrow var n = shared.lock() { "hello {n}" }
    print(greeting)
}
