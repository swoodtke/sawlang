// A `case Has(_)` payload dies when the match completes, after the arm, on both
// twins (SL:hazards C11, SL-513 ruling B).
//
// A `_` payload binding names no value to own, so no cleanup scope holds it.
// The discarded part is released when the construct that consumed it completes,
// not where it is extracted: the arm's output comes first and the DEINIT line
// follows it. The driven twin takes the same answer, because its hoisted
// scrutinee temp is take-read and the ordinary consume model applies to it
// (design 247).
//
// MATRIX. The rows are the arm shapes that claim nothing, plus the control that
// claims, plus both lowerings:
//
//   discard   — `case Has(_)`, the original cell, lowered IN PLACE (the head
//               was the only suspending part, so the construct itself spans
//               nothing once it is hoisted)
//   wildcard  — `case _` over an owning variant, where the whole scrutinee dies
//               with the match
//   split     — `case Has(_)` where the ARM suspends too, so the match is
//               CFG-split and the release rides the construct's exit
//   named     — the control: an arm that binds by name keeps the arm's END on
//               BOTH twins, because the binding is live for the arm
//
// The neighbouring shapes are pinned separately: the mixed `case Both(v, _)`
// (coro_mixed_match_payload_released_at_extraction.saw) and a multi-field
// all-`_` payload's field ORDER
// (coro_discarded_match_payload_field_drop_order.saw).
// EXPECT: success
// EXPECT-OUTPUT:
// -- sync
// NEW t1
// arm
// DEINIT t1
// scope closed
// -- driven
// NEW t1
// arm
// DEINIT t1
// scope closed
// -- sync wildcard
// NEW t2
// arm
// DEINIT t2
// scope closed
// -- driven wildcard
// NEW t2
// arm
// DEINIT t2
// scope closed
// -- sync split
// NEW t3
// arm
// DEINIT t3
// scope closed
// -- driven split
// NEW t3
// arm
// DEINIT t3
// scope closed
// -- sync named
// NEW t4
// arm
// DEINIT t4
// scope closed
// -- driven named
// NEW t4
// arm
// DEINIT t4
// scope closed

import std.task.{yield_now}

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("DEINIT {self.name}") }
}

struct Tag { cell: Arc<Res> }
@synthesize
extension Tag: Copy {}

enum Held { case Has(x: Tag) }

func mk_tag(id: Int) -> Tag {
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func mk_tag_s(id: Int) -> Tag {
    yield_now()
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func sync_discard() {
    match Held.Has(x: mk_tag(1)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func driven_discard() {
    match Held.Has(x: mk_tag_s(1)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func sync_wildcard() {
    match Held.Has(x: mk_tag(2)) {
        case _ -> { print("arm") }
    }
    print("scope closed")
}

func driven_wildcard() {
    match Held.Has(x: mk_tag_s(2)) {
        case _ -> { print("arm") }
    }
    print("scope closed")
}

func sync_split() {
    match Held.Has(x: mk_tag(3)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func driven_split() {
    match Held.Has(x: mk_tag_s(3)) {
        case Has(_) -> {
            yield_now()
            print("arm")
        }
    }
    print("scope closed")
}

func sync_named() {
    match Held.Has(x: mk_tag(4)) {
        case Has(v) -> { print("arm") }
    }
    print("scope closed")
}

func driven_named() {
    match Held.Has(x: mk_tag_s(4)) {
        case Has(v) -> { print("arm") }
    }
    print("scope closed")
}

func main() {
    print("-- sync")
    sync_discard()
    print("-- driven")
    __saw_drive(driven_discard())
    print("-- sync wildcard")
    sync_wildcard()
    print("-- driven wildcard")
    __saw_drive(driven_wildcard())
    print("-- sync split")
    sync_split()
    print("-- driven split")
    __saw_drive(driven_split())
    print("-- sync named")
    sync_named()
    print("-- driven named")
    __saw_drive(driven_named())
}
