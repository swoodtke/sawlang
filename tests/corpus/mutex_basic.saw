// Mutex<T>: mutual-exclusion wrapper. `lock()` lends `&var` access to the
// guarded payload to a `borrow var` block (SL:borrowing §8); get() copies it.
// (Single task here; the cross-task counter lands with spawn in this stage.)
//
// Design 123 (review H7): `get` is not optional, and a block's `false` has
// one meaning. Construction panics on allocator exhaustion, so there is no
// inert mutex whose `lock()` would skip the critical section and whose `get`
// would answer `None`: the only `false` a caller sees is the one the block's
// body computed, as its value (SL:borrowing §2.1).
//
// EXPECT: success
// EXPECT-OUTPUT:
// 5
// 50
// true
// false

import std.mutex.{Mutex}
func main() {
    let m = Mutex<Int>(value: 0)

    var i = 0
    while i < 5 {
        borrow var c = m.lock() {
            c = c + 1
            true
        }
        i = i + 1
    }
    print(m.get())   // 5

    // Mutate by a larger step, still under the lock.
    borrow var c = m.lock() {
        c = c * 10
        true
    }
    print(m.get())   // 50

    // The block's own answers, both of them, and neither one ambiguous.
    print(borrow var c = m.lock() { c > 0 })     // true
    print(borrow var c = m.lock() { c < 0 })     // false
}
