// EXPECT: success
// EXPECT-OUTPUT:
// 3

func main() {
    // Conditional loop as expression - returns Int?
    var i = 0
    let found = while i < 10 {
        if i == 3 {
            break i
        }
        i = i + 1
    }

    // Use if let to unwrap
    if let value = found {
        print(value)
    }
}
