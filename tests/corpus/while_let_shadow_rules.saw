// Design 233: a `while let` binding takes design 100's shadowing rule verbatim,
// because it IS an `if let` binding — a scrutinee that does not MENTION the
// shadowed enclosing binding is a plain shadow error. (The derived spelling
// `while let c = c.next()` is covered in while_let_drain.saw.)
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `x` shadows the binding declared at

func opt(n: Int) sync -> Int? {
    if n > 2 { return None }
    return n
}

func main() {
    let x = 7
    var n = 0
    while let x = opt(n) {
        n = n + 1
    }
    print("{x}")
}
