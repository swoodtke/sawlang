// Test glob import - all symbols directly accessible
// EXPECT: success
// EXPECT-OUTPUT: 42
// EXPECT-OUTPUT: 30
// EXPECT-OUTPUT: 40
import modules.utils.*

func main() {
    // With glob import, symbols are directly accessible (no utils. prefix)
    let result = double(21)
    print(result)  // 42

    let t = triple(10)
    print(t)  // 30

    // Structs too
    let p1 = Point(x: 10, y: 20)
    let p2 = Point(x: 5, y: 5)
    let p3 = p1.add(p2)
    print(p3.magnitude())  // 40
}
