// What a `&self` method may still call on a field.
//
// `&self` is read-only all the way down (SL:borrowing §9): storage inside the
// receiver and storage it reaches through a pointer alike. What remains is a
// `&self` method on an interior-mutable field (a cell), which writes the
// caller's storage because the receiver travels by pointer, and a shared read
// through indirection. A write through a `Vector` field at `&self` is refused
// (`conformance/M32_shared_self_place_window_heap_field.saw`, which covers row
// M28); the fix is a `&var self` receiver, section 3 below.
//
// What is NOT exempt — a wrapper's `&var self` method reached through `&self`
// storage — is pinned by `examples/errors/interior_cell_wrapper_var_self.saw`.
// EXPECT: success
// EXPECT-OUTPUT: counter 2
// EXPECT-OUTPUT: spinlock held false, sum 4
// EXPECT-OUTPUT: row width 3
// EXPECT-OUTPUT: bag size 3
import std.spinlock.*

// 1. INTERIOR MUTABILITY. A receiver carrying a cell arrives by pointer even at
//    `&self` (design 149, generalized by 186), so the cell it bumps is the
//    caller's.
struct Counter { n: Atomic<Int> }

extension Counter: NoCopy {}

extension Counter {
    func bump(&self) { let _old = self.n.fetch_add(1) }
    func read(&self) -> Int { self.n.load() }
}

// 2. The same thing one level up: a `&self` method on an interior-mutable
//    FIELD, called from a `&self` body. `is_locked` and `lock` both write or
//    read the caller's lock rather than a copy's.
struct Shared { cell: SpinLock<Int> }

extension Shared: NoCopy {}

extension Shared {
    func probe(&self) -> Bool { self.cell.is_locked() }
    func add(&self, v: Int) -> Int { borrow var n = self.cell.lock() { n = n + v; n } }
}

// 3. INDIRECTION. A `&self` method READS a `Vector` field's heap elements through
//    a shared borrow; a write through them takes `&var self` (SL:borrowing §9).
struct Rows { rows: Vector<Vector<Int>> }

extension Rows: NoCopy {}

extension Rows {
    func widen(&var self) { try! borrow var self.rows[0].push(9) }
    func width(&self) -> Int { borrow self.rows[0].len() }
}

// 4. The fix the diagnostic names: declare the method `&var self`.
struct Bag { cells: Vector<Int> }

extension Bag: NoCopy {}

extension Bag {
    func fill(&var self) { try! self.cells.push(9) }
    func size(&self) -> Int { self.cells.len() }
}

func main() {
    let c = Counter(n: Atomic(0))
    c.bump()
    c.bump()
    print("counter {c.read()}")

    let s = Shared(cell: SpinLock<Int>(value: 0))
    print("spinlock held {s.probe()}, sum {s.add(4)}")

    var r = Rows(rows: [[1, 2]])
    r.widen()
    print("row width {r.width()}")

    var b = Bag(cells: [1, 2])
    b.fill()
    print("bag size {b.size()}")
}
