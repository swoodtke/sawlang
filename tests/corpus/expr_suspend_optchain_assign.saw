// Design 120, stage 2: a chained-assignment whose RHS suspends —
// `x?.y = f()`. The RHS runs first on every path, suspension included, and
// the write happens only when every optional hop is non-None (SL:borrowing
// §2.2). The counter proves the RHS ran on the None head too.
// EXPECT: success
// EXPECT-OUTPUT:
// 99
// 1
// -1
// 2

static CALLS: Atomic<Int> = Atomic(0)

struct Point { x: Int, y: Int }

func s(n: Int) -> Int {
    CALLS.fetch_add(1)
    __saw_suspend()
    n
}

func doassign(o: Point?) -> Int {
    var local = o
    local?.x = s(99)          // Void?; RHS suspends on every path
    if let p = local { return p.x }
    return -1
}

func main() {
    print(__saw_drive(doassign(Point(x: 1, y: 2))))   // 99 (write ran)
    print(CALLS.load())                               // 1
    print(__saw_drive(doassign(None)))                // -1 (write skipped)
    print(CALLS.load())                               // 2 (the RHS ran)
}
