// A pair of accessors (a `&self` one and a `&var self` one, SL:borrowing §4)
// used inside a COROUTINE body, and the FORWARDED lend through such a pair.
//
// Coroutines: what has to work is a borrow OPENED inside a suspending body, on
// either side of a suspension, through either accessor. A borrow may be held
// across a suspension unless its accessor is `borrows(sync)` (§2.5); these
// borrows each last one statement.
//
// The forwarded lend: `lend self.inner[i]` hands another accessor's place on
// with no `borrow` keyword (§2.7). Inside the `&self` accessor the receiver is
// shared, so the operand reaches `Inner`'s `&self` accessor; inside the `&var
// self` accessor it must lend `&var Int`, so it reaches `Inner`'s exclusive one.
// So a shared read through `Outer` reaches `Inner` SHARED and runs no gate at
// all, and only the write does. The gate counts below say so: one read, one
// write and one more read cost one gate run.
// EXPECT: success
// EXPECT-OUTPUT:
// task results 12 22
// forwarded read 3, inner gates 0
// forwarded write 4, inner gates 1
// -- done
import std.task.*

struct Grid { cells: [Int; 4], gates: Int }

extension Grid {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        self.run_gate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

// A window on both sides of a suspension, in both flavors.
func tally(n: Int) -> Int {
    var g = Grid(cells: [1, 2, 3, 4], gates: 0)
    yield_now()
    g[0] += n
    yield_now()
    g[0] + g.gates_seen()
}

struct Inner { cells: [Int; 2], gates: Int }

extension Inner {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        self.run_gate()
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

struct Outer { inner: Inner }

extension Outer {
    // Each forwards the inner accessor's place. The shared receiver can reach
    // only `Inner`'s `&self` accessor, and the writable lend needs `Inner`'s
    // exclusive one, so the inner accessor is reached at the outer one's mode.
    public func [](&self, i: Int) borrows -> &Int {
        lend self.inner[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        lend self.inner[i]
    }

    public func inner_gates(&self) -> Int { self.inner.gates_seen() }
}

func main() {
    var group = TaskGroup()
    let a = group.spawn(tally(10))
    let b = group.spawn(tally(20))
    print("task results {a.join()} {b.join()}")

    var o = Outer(inner: Inner(cells: [3, 4], gates: 0))
    // A SHARED read of the outer place reaches the inner accessor SHARED, so
    // the inner gate does not run at all.
    print("forwarded read {o[0]}, inner gates {o.inner_gates()}")
    o[0] += 1
    print("forwarded write {o[0]}, inner gates {o.inner_gates()}")
    print("-- done")
}
