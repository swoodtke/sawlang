// Atomic<Int> static counter (design 41 item 4): const-initialized from
// `Atomic(0)`, mutated through interior-mutable methods from main. The
// no-mutation rule keys on assignment, so these METHOD calls are the sanctioned
// mutation path. Also exercises Atomic<Int> as a struct field.
// EXPECT: success
// EXPECT-OUTPUT:
// 0
// 5
// 99
// true
// 7
// 3
// 13

static COUNTER: Atomic<Int> = Atomic(0)

struct Stats { hits: Atomic<Int> }

// An `Atomic` field is NoCopy (design 202), so the holder states its policy —
// a copied `Stats` would be a second `hits` word, counting on its own.
extension Stats: NoCopy {}

// A static struct with an interior-mutable Atomic field: mutating the field
// through the immutable static must hit the global, not a copy.
static GLOBAL_STATS: Stats = Stats(hits: Atomic(10))

func main() {
    let old = COUNTER.fetch_add(5)   // returns previous value 0
    print(old)                       // 0
    print(COUNTER.load())            // 5
    COUNTER.store(99)
    print(COUNTER.load())            // 99
    let ok = COUNTER.compare_exchange(99, 7)
    print(ok)                        // true
    print(COUNTER.load())            // 7

    // Atomic<Int> usable as a struct field.
    let s = Stats(hits: Atomic(1))
    s.hits.fetch_add(2)
    print(s.hits.load())             // 3

    // Interior-mutable field of a static struct: writes hit the global.
    GLOBAL_STATS.hits.fetch_add(3)
    print(GLOBAL_STATS.hits.load())  // 13
}
