// Assignment targets that write through storage the container already holds,
// in place (SL:borrowing §2.2). Four spellings, each a `borrow` statement:
//
//   borrow var e = m[k] { e = v }      panics on an absent key (§9.1, K7)
//   borrow var c.slot(i) = v           a NAMED accessor, whole-value write
//   borrow var m.find(&k)?.field = v   a conditional write, skipped if absent
//   borrow var v.find(i)?.field = v    the same, through Vector's find (§2.4)
//
// A conditional write's `?` skips only the write: the right side is evaluated
// first either way (§2.2), so the absent `v.find(9)` still calls `loud`. The
// statement types `Void?`, which `guard let _ =` tests (§9.1, K9). Reads
// through the `&var self` accessor are bare `borrow`s (§2.2, §3).
// EXPECT: success
// EXPECT-OUTPUT:
// forced 5
// named 99
// named field 7
// chain 42
// chain absent skipped
// named chain 8
// rhs evaluated
// absent write skipped
// -- done

struct Cell { value: Int }
struct Carrier { slots: Vector<Cell> }
extension Carrier: NoCopy {}

extension Carrier {
    public func slot(&var self, i: Int) borrows -> &var Cell {
        if i < 0 || i >= self.slots.len() { panic("Carrier.slot: index out of range") }
        lend self.slots[i]
    }
}

func loud(n: Int) -> Int {
    print("rhs evaluated")
    n
}

func main() {
    // 1. The whole-value write through `m[k]`'s place, which panics if absent.
    var m = Map<String, Int>()
    let _ = m.insert("k", 1)
    borrow var e = m["k"] { e = 5 }
    print("forced {m.get("k") ?? -1}")

    // 2. A NAMED accessor as a target, whole value and then a field of it.
    var slots = Vector<Cell>()
    try! slots.push(Cell(value: 1))
    try! slots.push(Cell(value: 2))
    var c = Carrier(slots: move slots)
    borrow var c.slot(1) = Cell(value: 99)
    print("named {borrow c.slot(1).value}")
    borrow var c.slot(0).value = 7
    print("named field {borrow c.slot(0).value}")

    // 3. A conditional write through Map's `find`.
    var cells = Map<String, Cell>()
    let _ = cells.insert("x", Cell(value: 1))
    borrow var cells.find(&"x")?.value = 42
    print("chain {cells.get("x")!.value}")

    guard let _ = borrow var cells.find(&"nope")?.value = 7 else {
        print("chain absent skipped")

        // 4. The same through Vector's `find`, and an absent write whose RHS runs.
        var v = Vector<Cell>()
        try! v.push(Cell(value: 1))
        borrow var v.find(0)?.value = 8
        print("named chain {v[0].value}")
        borrow var v.find(9)?.value = loud(3)
        print("absent write skipped")
        print("-- done")
        return
    }
    print("unreachable")
}
