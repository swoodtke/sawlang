// Declaring BOTH copy traits on one type is refused (SL-641).
//
// A type has one copy policy, and the pair leaves a reader asking whether
// its values copy silently or need `.copy()`: `Copy` says the first, and
// `ExplicitCopy` declared alone says the second. The ruling reverses design
// 219, which read the second declaration as redundant; the frozen compiler
// keeps that reading, and the examples/ original pins it.
//
// The refusal names the second conformance, `ExplicitCopy`, in the head of
// the extension that declares both. Declaring `Copy` alone keeps every
// transfer below and runs the hook at each, the silent one and the spelled
// one, and an `ExplicitCopy` bound still takes the type, since every Copy
// type meets it.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: a second copy policy beside `Copy`

struct Buf {
    value: Int
}

extension Buf: Copy, ExplicitCopy {
    func copy(&self) -> Buf {
        Buf(value: self.value)
    }
    func deinit(&var self) {
    }
}

func main() {
    let a = Buf(value: 1)
    print(a.value)

    // The silent transfer runs the hook; the spelled one calls the same body.
    let b = a
    print(b.value)
    let c = a.copy()
    print(c.value)
}
