// EXPECT: success
// EXPECT-OUTPUT: Hello, World!
// EXPECT-OUTPUT: The answer is 42
// EXPECT-OUTPUT: 10 + 20 = 30
// EXPECT-OUTPUT: Pi is approximately 3.14159
// EXPECT-OUTPUT: Flag is true
// EXPECT-OUTPUT: Double: 84
// EXPECT-OUTPUT: 42
// EXPECT-OUTPUT: 4242
// EXPECT-OUTPUT: Just a plain string
// EXPECT-OUTPUT: Point: x=5, y=10
// EXPECT-OUTPUT: Length: 3

// String interpolation test

struct Point {
    x: Int
    y: Int
}

extension Point {
    func get_x(&self) -> Int {
        self.x
    }
}

struct Counter {
    value: Int
}

extension Counter {
    func len(&self) -> Int {
        self.value
    }
}

func main() {
    // Basic string interpolation
    let name = "World"
    let greeting = "Hello, {name}!"
    print(greeting)

    // Integer interpolation
    let x = 42
    print("The answer is {x}")

    // Multiple interpolations
    let a = 10
    let b = 20
    print("{a} + {b} = {a + b}")

    // Float interpolation
    let pi = 3.14159
    print("Pi is approximately {pi}")

    // Boolean interpolation
    let flag = true
    print("Flag is {flag}")

    // Expression in interpolation
    print("Double: {x * 2}")

    // Empty parts
    print("{x}")
    print("{x}{x}")

    // Plain string (no interpolation) still works
    let plain = "Just a plain string"
    print(plain)

    // Struct field access in interpolation
    let p = Point(x: 5, y: 10)
    print("Point: x={p.x}, y={p.y}")

    // Method call in interpolation
    let c = Counter(value: 3)
    print("Length: {c.len()}")
}
