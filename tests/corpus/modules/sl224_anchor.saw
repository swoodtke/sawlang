// SL-224: the DEFINING module of a coroutine-transform rejection. The entry
// module drives `spin` across the module boundary, so the frame is built for
// THIS file's function and the refusal below belongs to THIS file — which is
// the whole point of the test that imports it.
//
// The vehicle was a `for` over a non-range iterable with a suspension inside,
// one of the 21 raise sites that passed no `source_file` at all. Design 275 U3
// (SL-317) gave that shape its split, so the vehicle is now a suspending call
// inside a CLOSURE BODY — the shape table's other REFUSE row (SL-316), raised
// through the same `_FrameBuilder._error` and therefore asking the same
// question of the same funnel.
import std.task.{yield_now}

public func spin(v: Vector<Int>) -> Int {
    var total = 0
    v.each { [&var total] x in
        yield_now()
        total = total + x
    }
    total
}
