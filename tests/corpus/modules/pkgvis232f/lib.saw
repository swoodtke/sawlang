// DF-232f fixture: the package's entry module. It reaches its SIBLING's
// `public(package)` symbol — the direction that must keep working — and
// re-exports the result through a genuinely `public` surface.
//
// The sibling import uses the MAPPED name (`pkgvis`), which is how a file
// inside a --module-path package names another file of the same package.
//
// This import is `public` ON PURPOSE — it ATTEMPTS the widening that
// `module_path_reexport_no_widen_error.saw` pins as impossible. A facade
// re-exporting a package-private sibling symbol must NOT publish it: the
// re-export carries the NARROWER tier. If that ever stopped holding, this one
// line would silently republish everything a package's facade names, which is
// exactly what kcore's facade does for 108 narrowed names.
public import pkgvis.secret.{pkg_secret}

public func lib_answer() -> Int {
    pkg_secret() * 6
}
