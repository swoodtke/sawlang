// DF-232f fixture: a package-internal symbol. `public(package)` means every
// SIBLING file of this mapped package may name it and NOTHING outside may —
// which is the whole claim the two probes check, one direction each.

public(package) func pkg_secret() -> Int {
    7
}

// The public surface of the same file, so the negative probe's refusal is
// clearly about the TIER and not about the module being unreachable.
public func secret_is_reachable() -> Int {
    1
}
