// DF-232j sweep fixture (two-hop shape): the package-internal symbol.
// `public(package)` means every SIBLING file of this mapped package may name
// it and NOTHING outside may.

public(package) func pkg_secret() -> Int {
    7
}

// The public surface of the same file, so a refusal is clearly about the TIER
// and not about the module being unreachable.
public func secret_is_reachable() -> Int {
    1
}
