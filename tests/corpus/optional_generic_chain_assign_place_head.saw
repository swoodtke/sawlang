// The statement form of a conditional write,
// `borrow var m.find(&k)?.value = v`, writes through the lent place when the
// key is present, and `?` skips only the write when it is absent
// (SL:borrowing §2.2). The right side is evaluated first either way, and the
// statement types `Void?`, so `guard let _ =` tells the paths apart (K9).
//
// The write lands in the map's own storage, never in a copy of the entry,
// because the borrow lends the place itself.
// EXPECT: success
// EXPECT-OUTPUT:
// present 42
// absent skipped
// -- done

struct Cell { value: Int }

func main() {
    var m = Map<String, Cell>()
    let _ = m.insert("x", Cell(value: 1))

    borrow var m.find(&"x")?.value = 42
    let present = m.get("x")!.value
    print("present {present}")

    // The absent path writes nothing.
    guard let _ = borrow var m.find(&"nope")?.value = 7 else {
        print("absent skipped")
        print("-- done")
        return
    }
    print("unreachable")
}
