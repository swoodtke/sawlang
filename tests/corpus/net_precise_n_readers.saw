// design 91: N readers parked on N distinct fds, each fd fired INDIVIDUALLY —
// only the fired one may wake. Three readers park on three socketpairs; then each
// fd's writer fires in turn (fd0, fd1, fd2), each followed by joining that reader.
// When fd i fires, readers j != i (still parked, no data) must stay asleep. A
// wake is invisible from outside std (a read woken with no data parks again), so
// the observable proof is that every reader resolves to its own fd's byte, in
// order; counting spurious wakes takes a pin inside the reactor (SL-890).
// Spawn-slot order makes all readers park before the first writer runs;
// join drains fully. Socketpair-only, time-bounded, deterministic on content.
// EXPECT: success
// EXPECT-OUTPUT:
// 10
// 20
// 30

import std.net.{TcpStream}
import std.data.{Data}

func reader(stream: TcpStream) -> Int {
    let got = try! stream.read()
    got[0] as Int
}

func writer(stream: TcpStream, b: Int) -> Int {
    var bytes = Data()
    try! bytes.push(b as Byte)
    try! stream.write(move bytes)
    return 1
}

func main() {
    let (r0, w0) = try! TcpStream.pair()
    let (r1, w1) = try! TcpStream.pair()
    let (r2, w2) = try! TcpStream.pair()
    var group = TaskGroup()
    let h0 = group.spawn(reader(move r0))
    let h1 = group.spawn(reader(move r1))
    let h2 = group.spawn(reader(move r2))
    // Fire fd 0 only, drain reader 0: readers 1 and 2 stay parked (precise).
    let x0 = group.spawn(writer(move w0, 10))
    let a = h0.join()
    // Fire fd 1 only, drain reader 1: reader 2 stays parked.
    let x1 = group.spawn(writer(move w1, 20))
    let b = h1.join()
    // Fire fd 2 only, drain reader 2.
    let x2 = group.spawn(writer(move w2, 30))
    let c = h2.join()
    print(a)                  // 10
    print(b)                  // 20
    print(c)                  // 30
    let _ = x0.join()
    let _ = x1.join()
    let _ = x2.join()
}
