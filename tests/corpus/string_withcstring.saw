// String.c_string: a lent borrow of the String's NUL-terminated bytes as an
// UnsafePointer<Int8>. The refcounted String payload is already NUL-terminated,
// so the pointer is passed directly (no copy), and it is valid only for the
// window of the borrow, which is the safety story. Here the window is the call
// to the libc `strlen`, whose result flows straight out as an Int.
// EXPECT: success
// EXPECT-OUTPUT:
// 5
// 13
// 0

extern "C" {
    func strlen(s: UnsafePointer<Int8>) -> Int
}

func c_length(text: String) unsafe -> Int {
    strlen(text.c_string()!)
}

func main() {
    let n = c_length("hello")
    print(n)                    // 5

    // Works on an interpolated (owned, heap) String too.
    let greeting = "Hello, World!"
    let m = c_length(greeting)
    print(m)                    // 13

    // Empty string: NUL-terminated, strlen sees length 0.
    let z = c_length("")
    print(z)                    // 0
}
