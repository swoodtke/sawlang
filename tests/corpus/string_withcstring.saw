// String.withCString<R> (brief 38 item 3 + brief 40 item 9 / C6): a scoped,
// non-escaping borrow of the String's NUL-terminated bytes as an
// UnsafePointer<Int8>. The refcounted String payload is already NUL-terminated,
// so the pointer is passed directly (no copy). The closure is non-escaping
// (brief 29 default) — it cannot outlive the call — which is the safety story.
//
// `withCString` is now VALUE-RETURNING: `R` is a method-level generic type
// parameter (the C6 fix — method-level generics on a non-generic-type
// extension), so the borrow's result flows straight out with no capture-and
// -write workaround. Here we return the libc `strlen` of the pointer as Int.
// EXPECT: success
// EXPECT-OUTPUT:
// 5
// 13
// 0

extern "C" {
    func strlen(s: UnsafePointer<Int8>) -> Int
}

func main() {
    let n = "hello".withCString<Int> { ptr in strlen(ptr) }
    print(n)                    // 5

    // Works on an interpolated (owned, heap) String too.
    let greeting = "Hello, World!"
    let m = greeting.withCString<Int> { ptr in strlen(ptr) }
    print(m)                    // 13

    // Empty string: NUL-terminated, strlen sees length 0.
    let z = "".withCString<Int> { ptr in strlen(ptr) }
    print(z)                    // 0
}
