// An inline `try ... catch { }` gives a `let` its value inside a loop of a
// suspending function, and the catch's tail consumes a local. The tail is a
// value tail, and the move in it clears the local's drop flag on that path
// alone: an iteration that fails hands `r` to `take`, and none releases it a
// second time.
// EXPECT: success
// EXPECT-OUTPUT:
// 2

import std.task.{yield_now}

struct Res { name: String }
extension Res: NoCopy {}

struct Bad { why: String }
extension Bad: Error {
    func format(&self, into: &var StringBuilder) { try! into.append(self.why) }
}

func note(r: &Res) -> Int { r.name.len() }

func take(r: Res) -> Int { 1 }

func fallible(k: Int) -> Result<Int, Bad> {
    if k < 0 { return Bad(why: "neg") }
    k
}

func run(items: Vector<Int>) -> Int {
    yield_now()
    var total = 0
    for i in items.iter() {
        var r = Res(name: "item")
        if note(&r) + i < 0 { return -1 }
        let got = try fallible(0 - i) catch { take(move r) }
        total = total + got
    }
    total
}

func main() {
    print(__saw_drive(run([1, 2])))   // both fail -> catch each time -> 1 + 1
}
