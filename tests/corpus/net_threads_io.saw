// design 76 (A4) + design 75 (A2): the IO reactor under a MULTI-THREADED
// TaskGroup. Each worker task reads from its own socket and parks on
// read-readiness until `main` writes one byte to the peer; an idle worker polls
// the reactor (bounded timeout) and wakes the io-parked frames. Only owning
// streams cross the suspension, so the Send-on-frames gate is satisfied.
// Deterministic on the summed result, time-bounded. Loopback only.
// EXPECT: success
// EXPECT-OUTPUT:
// 2

import std.net.{TcpStream}

func waiter(stream: TcpStream) -> Int {
    let got = try! stream.read()    // parks until the peer's byte arrives
    got.len()
}

func main() {
    let (a1, b1) = try! TcpStream.pair()
    let (a2, b2) = try! TcpStream.pair()
    var group = try! TaskGroup(threads: 2)
    let h1 = group.spawn(waiter(move a1))
    let h2 = group.spawn(waiter(move a2))
    try! b1.write("x")
    try! b2.write("y")
    print(h1.join() + h2.join())    // 2 (both io-parked frames woke)
    let _ = move b1
    let _ = move b2
}
