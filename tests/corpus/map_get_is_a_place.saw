// `Map.get` is the optional COPY and `Map.find` the conditional LEND
// (SL:borrowing §2.4, §5.1, §9.1 K14). `get` copies the value out, following
// its copy tier, so it serves Copy reads and presence tests; a write, or a
// move-only value, goes through `find`, whose place is reached where it sits.
//
// Through `find`, an absent key opens no borrow, and a write through the lent
// place writes the stored value. A move-only value is reached through the
// borrow and never copied out.
// EXPECT: success
// EXPECT-OUTPUT:
// read 1
// absent
// present
// window 11
// retained tag-a a
// nocopy through the window 5
// nocopy still there 5
// -- done

struct Res { n: Int }
extension Res: NoCopy {}

struct Counted { count: Int, tag: String }

extension Res {
    func peek(&self) -> Int { self.n }
}

func main() {
    var m = Map<String, Int>()
    let _ = m.insert("k", 1)
    print("read {m.get("k") ?? -1}")

    // `get` copies, so a presence test through it is a test of the copy.
    if let _ = m.get("nope") { print("present") } else { print("absent") }
    if let _ = m.get("k") { print("present") } else { print("absent") }

    // An exclusive borrow through the conditional lend.
    var c = Map<String, Counted>()
    let _ = c.insert("x", Counted(count: 1, tag: "a"))
    borrow var c.find(&"x")!.count += 10
    print("window {borrow c.find(&"x")!.count}")

    // `get` copies the entry, retaining its string: the map keeps its own.
    let tag = c.get("x")!.tag
    print("retained tag-{tag} {c.get("x")!.tag}")

    // A move-only value is reached THROUGH the borrow and never copied out.
    var r = Map<String, Res>()
    let _ = r.insert("only", Res(n: 5))
    print("nocopy through the window {borrow r.find(&"only")!.peek()}")
    print("nocopy still there {borrow r.find(&"only")!.peek()}")
    print("-- done")
}
