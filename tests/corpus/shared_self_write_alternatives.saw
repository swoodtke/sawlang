// The positive half of the `&self` write rule: what a method that writes the
// receiver's storage is declared as, and what an accessor that genuinely counts
// its reads is declared as.
//
// `&self` is read-only all the way down (SL:borrowing §9). A field, a nested
// field, an inline `[T; N]` element and an element in a `Vector`'s heap buffer
// are all refused through `&self`: another holder of the shared borrow may be
// reading the buffer while a write lands or reallocates it. So `put`, which
// writes an element, declares `&var self`. Interior mutation through a shared
// borrow goes only through cell types (`Mutex`, `Atomic`).
//
// An accessor whose epilogue mutates the receiver declares `&var self` and has
// no `&self` twin. Every borrow through it then charges the root exclusively,
// reads included (§3), so a `let` root refuses it, and a plain `g[1]` is not a
// getitem, since getitem derives only from a `&self` accessor (§5.2): each read
// is written `borrow g[1]`.
// EXPECT: success
// EXPECT-OUTPUT:
// through the buffer 40
// counted 7
// reads 2
// -- done

struct Grid { cells: Vector<Int>, reads: Int }
extension Grid: NoCopy {}

extension Grid {
    // Writing an element writes the receiver's storage, so it takes `&var self`.
    func put(&var self, i: Int, v: Int) {
        self.cells[i] = v
    }

    // An epilogue that counts reads is what `&var self` is for.
    func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= self.cells.len() { panic("Grid.[]: index out of range") }
        lend self.cells[i]
        self.reads = self.reads + 1
    }
}

func main() {
    var cells = Vector<Int>()
    try! cells.push(10)
    try! cells.push(7)
    var g = Grid(cells: move cells, reads: 0)

    g.put(0, v: 40)
    print("through the buffer {g.cells[0]}")

    print("counted {borrow g[1]}")
    let _ = borrow g[0]
    print("reads {g.reads}")
    print("-- done")
}
