// design 89-b: nested groups on the ONE ambient scheduler + task-joins-task.
// A task of the OUTER group (`middle`) creates an INNER group and joins its
// children from WITHIN the task — the join parks `middle` and the shared
// scheduler runs the other tasks meanwhile (SL-1161). Inner and outer children
// interleave on the single scheduler, one turn each in spawn order, and both
// scopes join. Deterministic.
// EXPECT: success
// EXPECT-OUTPUT:
// 20
// 21
// 10
// 11

import std.task.*
func leaf(id: Int) -> Int {
    yield_now()
    print(id)
    id
}

func middle() -> Int {
    var inner = TaskGroup()
    let a = inner.spawn(leaf(10))
    let b = inner.spawn(leaf(11))
    a.join() + b.join()   // a task joining its own child tasks
}

func main() {
    var outer = TaskGroup()
    let m = outer.spawn(middle())
    let x = outer.spawn(leaf(20))
    let y = outer.spawn(leaf(21))
    let _ = m.join()
    let _ = y.join()
    let _ = x.join()
}
