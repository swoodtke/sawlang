// Two by-reference accesses to one root in one call, at least one a `borrows`
// place, are an exclusivity error: a borrow charges its ROOT, and `Pair.at`
// takes `&var self`, so each `borrow var p.at(i)` charges `p` exclusively for
// the call (SL:borrowing §2.2, §3). The two places are disjoint fields, but the
// charge is on the root, so the pair conflicts on every copy tier — here a
// receiver that copies for free, where opening the second access on a copy
// would silently lose both writes. Lending two places of one root at once is
// the job of an `unsafe` tuple-lending accessor (§7).
// EXPECT: error
//
// A shared twin would not help: it lends `&Int`, and `setboth` writes through
// both arguments, which needs a writable lend (§3).

struct Pair {
    a: Int,
    b: Int
}

extension Pair {
    func at(&var self, i: Int) borrows -> &var Int {
        if i == 0 { lend self.a } else { lend self.b }
    }
}

func setboth(x: &var Int, y: &var Int) {
    x = 50
    y = 60
}

func main() {
    var p = Pair(a: 1, b: 2)
    setboth(borrow var p.at(0), borrow var p.at(1))
    print("a={p.a} b={p.b}")
}
