// `Wrap<T>(value: from)` moves an init's parameter into the struct the init
// returns, so the value belongs to the caller's struct and the init's epilogue
// does not release it. The oracle is the deinit count: exactly one teardown
// per value.
// EXPECT: success
// EXPECT-OUTPUT:
// 7
// gone 7

struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("gone {self.id}") }
}

struct Wrap<T> { value: T }

extension Wrap<T> {
    init(from: T) -> Wrap<T> { Wrap<T>(value: from) }
}

func main() {
    let r = Res(id: 7)
    let w = Wrap<Res>(from: move r)
    print(w.value.id)
}
