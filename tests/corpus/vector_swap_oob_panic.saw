// Design 130 accessor rule (M5): `Vector.swap` panics out of range. It was a
// silent no-op, so a caller with a bad index got an unswapped vector and no way
// to find out.
// EXPECT: panic
// DF-249a: the two indices are checked separately, so the message names the
// one that is out of range (99) rather than the pair.
// EXPECT-PANIC-CONTAINS: Vector.swap: index out of range: 99 (len 3)

func main() {
    var v: Vector<Int> = [10, 20, 30]
    v.swap(0, 2)
    print(v.get(0)!)             // 30 — in range still swaps
    v.swap(0, 99)                // past the end -> panic
}
