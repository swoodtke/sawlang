// design 149 unit (d): `SpinLock` requires real target atomics. A riscv32
// list without the `A` extension lowers a compare-and-swap to an `__atomic_*`
// libcall — a call into a C runtime a freestanding target does not have, and
// which where it exists is usually itself implemented with a lock. Saying so is
// the whole point: a silent fallback hands somebody a lock that does not lock.
//
// COMPILE-FLAGS: --freestanding --target riscv32-unknown-none-elf --target-features +m,-a,+c
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `SpinLock` needs target atomics
// EXPECT-ERROR-CONTAINS: add `+a` to the `--target-features` list

import std.spinlock.*

static COUNT: SpinLock<Int>

@export("kmain")
func kmain() -> Int {
    borrow var n = COUNT.lock() {
        n = n + 1
        n
    }
}
