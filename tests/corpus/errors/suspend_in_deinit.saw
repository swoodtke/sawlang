// design 44 (governing rule): `deinit` stays a `sync` context — suspending in a
// destructor breaks deterministic destruction. A `__saw_suspend()` in a deinit body
// is a compile error via the design-22 effect check (no transform involved).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot suspend in `deinit` context
// EXPECT-ERROR-CONTAINS: __saw_suspend

struct Resource {
    value: Int
}

extension Resource: NoCopy {
    func deinit(&var self) {
        __saw_suspend()
    }
}

func main() {
    let r = Resource(value: 42)
}
