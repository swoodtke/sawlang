// K132: no use-after-free in safe code. `for` is a borrow scope
// (SL:borrowing §2.6): the head `v.iter()` is borrowed for the whole loop,
// and `iter` is a `&self` accessor, so `v` is held shared until the
// statement ends (§3). A `push` in the body needs `v` exclusively, and is
// refused.
//
// The refusal is the whole guarantee: a `push` that reallocated the buffer
// would leave the rest of the loop reading freed memory, in safe sync code
// with no `unsafe` in the source. The iterator reads the length and buffer
// through its reference on every `next`, so nothing is snapshotted and
// nothing goes stale while the borrow holds.
//
// `let _ =` keeps the `push` itself legal, so the borrow is the one refusal.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: exclusive access violation
// EXPECT-ERROR-CONTAINS: `v` cannot be accessed by reference here
// EXPECT-ERROR-CONTAINS: borrows `v` for the whole of the `for` statement

func main() {
    var v: Vector<Int> = [1, 2, 3, 4]
    var seen = 0
    for x in v.iter() {
        seen = seen + x
        var k = 0
        while k < 64 {
            let _ = v.push(100 + k)
            k = k + 1
        }
    }
    print("seen = {}", seen)
    print("count = {}", v.len())
}
