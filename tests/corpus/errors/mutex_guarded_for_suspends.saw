// K141's refusal half: a suspension inside a `for` over the guarded
// collection, inside the `Mutex.lock()` borrow, is refused.
//
// `Mutex.lock()` is declared `borrows(sync)` (SL:borrowing §2.5, §8), so the
// lock's borrow cannot be held across a suspension. The `for` inside the block
// works with the borrow's guarantees intact; the suspending `step` call in its
// body is what is refused, and the refusal names the accessor. Nothing extends
// the lock's borrow past the block.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot be held across a suspension

import std.mutex.{Mutex}
import std.task.{yield_now}

func step(x: Int) -> Int {
    yield_now()
    x
}

func main() {
    var v: Vector<Int> = [1, 2, 3]
    let guarded = Mutex(value: move v)
    let a = borrow var items = guarded.lock() {
        var total = 0
        for x in items.iter() { total = total + step(x) }
        total
    }
    print("{a}")
}
