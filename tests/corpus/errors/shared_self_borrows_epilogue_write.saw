// A `&self` accessor's body is `&self` code on both sides of its `lend`, so
// its epilogue may not write `self`: `&self` is read-only all the way down
// (SL:borrowing §9). A shared accessor serves a read through a `let` root
// (§3), so the epilogue's write here would mutate `frozen`, which is declared
// immutable, on every read.
//
// An epilogue that means to count reads declares the accessor `&var self`,
// which needs a mutable root, so a read through a `let` root is refused
// (§3); `errors/exclusive_only_accessor_on_let_root.saw` pins that half.
//
// The accessor lends read-only (`&self ... borrows -> &Int`), the declaration
// this rule is about, and `frozen[0]` is the getitem derived from it (§5.2).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot use compound assignment on storage reached through a `&self` receiver

struct Grid { cells: Vector<Int>, reads: Int }
extension Grid: NoCopy {}

extension Grid {
    func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= self.cells.len() { panic("Grid.[]: index out of range") }
        lend self.cells[i]
        self.reads += 1
    }
}

func main() {
    var cells = Vector<Int>()
    cells.push(10)
    let frozen = Grid(cells: move cells, reads: 0)
    print("{frozen[0]}")
}
