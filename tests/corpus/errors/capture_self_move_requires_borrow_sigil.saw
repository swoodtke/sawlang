// The `move` half of the same rule (design 218 §4). A consuming `self` receiver
// is an owned binding and takes the ordinary implicit value capture with no list
// at all, so `[move self]` names a transfer no borrow receiver can make.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `self` may be captured only as a borrow

func run_int(body: () sync -> Int) -> Int { body() }

struct Counter { n: Int }

extension Counter {
    func read(&self) -> Int { run_int({ [move self] in self.n + 1 }) }
}

func main() {
    let c = Counter(n: 5)
    print("{}", c.read())
}
