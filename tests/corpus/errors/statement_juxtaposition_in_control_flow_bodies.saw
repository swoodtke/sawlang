// SL-347 R3 — bare JUXTAPOSITION is refused: the CONTROL-FLOW bodies.
//
// The `if`, `else`, `while` and `for` rows of the position matrix. Each body
// reaches the statement-end chokepoint through the same `parse_block` funnel
// its siblings do; these four are here so a body reached from a control-flow
// head is shown to be covered too.
//
// Each row sits in its own TOP-LEVEL declaration (the parse loop batches one
// error per declaration) and names a DIFFERENT pair of first tokens.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `var`, the second with `sum`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `let`, the second with `return`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `i`, the second with `break`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `total`, the second with `continue`
// EXPECT-ERROR-CONTAINS: write `;` where they meet

// ROW 4 — an `if` body.
func if_body_row(k: Int) {
    if k > 0 { var sum = k sum += 1 }
}

// ROW 5 — an `else` body.
func else_body_row(k: Int) -> Int {
    if k > 0 { k } else { let e = 2 return e }
}

// ROW 6 — a `while` body.
func while_body_row() {
    var i = 0
    while i < 3 { i += 1 break }
}

// ROW 7 — a `for` body.
func for_body_row() {
    var total = 0
    for k in 0..3 { total += k continue }
}

func main() {
    if_body_row(1)
}
