// A `sync func` context that directly calls a suspending function is rejected
// by the design-22 effect check.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot suspend in `sync func` declaration
// EXPECT-ERROR-CONTAINS: __saw_test_suspend

func suspends() {
    __saw_test_suspend()
}

func handler() sync {
    suspends()
}

func main() {}
