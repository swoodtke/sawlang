// design 149 unit (c): an exported seam is checked against the signature
// sawc/rt/ABI.md freezes for it. A runtime is a link-time swap, so a seam that
// disagrees with the document links cleanly and misbehaves at run time — which
// is the one failure mode the whole `__saw_rt_*` boundary exists to prevent.
//
// The signatures are read out of ABI.md itself, so the document cannot drift
// from what the compiler enforces.
//
// COMPILE-FLAGS: --runtime-provider -c
// EXPECT: error
// EXPECT-ERROR-CONTAINS: does not match the runtime ABI
// EXPECT-ERROR-CONTAINS: it returns `word` where the ABI returns `i64`
// EXPECT-ERROR-CONTAINS: sawc/rt/ABI.md freezes this contract
// EXPECT-ERROR-CONTAINS: it takes 1 parameter(s) where the ABI takes 2
// EXPECT-ERROR-CONTAINS: parameter 1 is `i32` where the ABI takes `i64`
// EXPECT-ERROR-CONTAINS: parameter 1 is `i32` where the ABI takes `word`

// ABI.md: `__saw_rt_clock_monotonic_nanos() -> Int64`. `Int` is 32 bits on a
// 32-bit target, so this is a real difference and not a spelling.
@export("__saw_rt_clock_monotonic_nanos")
func k_clock() -> Int {
    0
}

// ABI.md: `__saw_rt_write(ptr: i8*, len: word) -> void`.
@export("__saw_rt_write")
func k_write(ptr: UnsafePointer<Int8>) unsafe {
}

// ABI.md: `__saw_rt_sleep_ns(ns: i64) -> void`. A span is a u64 nanosecond
// count on every target, so a 32-bit parameter is a real difference.
@export("__saw_rt_sleep_ns")
func k_sleep(ns: Int32) {
}

// ABI.md: `__saw_rt_reactor_destroy(r: ptr) -> void`. Pointer-width, which is
// what `word` means and what `Int32` is not.
@export("__saw_rt_reactor_destroy")
func k_reactor_destroy(r: Int32) {
}

func main() {
    print("unreachable")
}
