// DF-188c case (ii), reconsidered by SL-795. A borrow capture reaches a
// `threads: N` worker only by riding a closure into the task's frame, and the
// refusal this file pinned came from the closure: no closure was `Send`. Now a
// closure's type carries the `Send` and `Sync` its captures prove, and a
// spawned root's function-typed parameter is judged by the closure the site
// passes. `[&var n]` of an `Int` proves both, since `&var T` crosses when `T`
// is `Send` (SL-788's reference rule), and the spawn-borrow rules keep `n`
// alive and exclusive to the task until the join. So the spawn is accepted.
// Stage 0 still refuses it, which annotations.tsv records.
//
// EXPECT: success
// EXPECT-OUTPUT: task saw 8

import std.task.*

func run(f: () -> Int) -> Int {
    yield_now()
    f()
}

func main() {
    var n = 7
    var group = try! TaskGroup(threads: 2)
    let h = group.spawn(run({ [&var n] in n = n + 1; n }))
    print("task saw {h.join()}")
}
