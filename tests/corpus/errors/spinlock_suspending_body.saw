// A critical section cannot suspend. `SpinLock.lock()` is `borrows(sync)`
// (SL:borrowing §2.5, §8), so a suspension inside its `borrow var` block is a
// compile error naming the accessor, rather than a livelock: a suspended task
// keeps the lock while the executor runs somebody else, and that somebody may
// be the task spinning for it.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot be held across a suspension

import std.spinlock.*
import std.task.*

static COUNT: SpinLock<Int>

func main() {
    borrow var n = COUNT.lock() {
        yield_now()
        n = n + 1
    }
    print("done")
}
