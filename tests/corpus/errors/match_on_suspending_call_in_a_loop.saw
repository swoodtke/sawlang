// SL-273's minimal repro, kept as the regression test for it.
//
// A match arm PAYLOAD BINDING used to be lost when the arm carried a `break`
// for a loop that suspends: `internal compiler error ... Undefined variable: e`
// on a correct program. The scrutinee here is an ordinary NON-suspending call,
// deliberately — the first filing blamed the scrutinee and was wrong.
//
// What actually decided it: the coroutine transform CFG-SPLITS a match either
// because it spans a suspension OR because it carries a `break`/`continue` for
// an enclosing suspending loop (design 96 DF6), while the frame-residency
// census granted fields on the FIRST reason alone. A split relocates the arm
// bodies into their own resume states, and an arm's payload binding — which
// exists only in the dispatch — could reach one only through a field it had not
// been given. `if let` never fell the same way because its split decision and
// its residency both read the one `_coro_split` stamp; `_FrameBuilder._is_split`
// is now that single authority for `if` / `match` / `try`-`catch` too.
//
// The loop suspends on a write, `attempt` refuses once `i` passes 1, the arm
// binds the error and prints it, and the loop breaks.
// EXPECT: success
// EXPECT-OUTPUT:
// err nope

import std.net.{TcpStream}

func attempt(n: Int) -> Result<Int, String> {
    if n > 1 { return "nope" }
    return n
}

func main() {
    let (a, b) = TcpStream.pair()
    let _ = move b
    var i = 0
    while i < 4 {
        let _ = a.write("x")        // the suspension, NOT the scrutinee
        match attempt(i) {
            case Ok(_) -> {},
            case Err(e) -> {
                print("err {}", e)
                break
            }
        }
        i = i + 1
    }
    let _ = move a
}
