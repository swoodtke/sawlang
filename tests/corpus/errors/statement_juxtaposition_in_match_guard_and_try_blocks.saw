// SL-347 R3 — bare JUXTAPOSITION is refused: a `match` arm's BLOCK body, a
// `guard … else { }` and both blocks of `try { } catch { }`.
//
// A match arm's BARE body ends at the arm's `,` — that body is an expression
// rather than a statement list, so it never reaches the chokepoint and
// `parse_match` owns the comma, unchanged. An arm's BLOCK body is an ordinary
// block and is covered, which is why the two are shown side by side here.
//
// Each row sits in its own TOP-LEVEL declaration (the parse loop batches one
// error per declaration) and names a DIFFERENT pair of first tokens.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `tag`, the second with `print`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `print`, the second with `return`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `let`, the second with `a`
// EXPECT-ERROR-CONTAINS: two statements on one line need a `;` between them: the first begins with `print`, the second with `let`
// EXPECT-ERROR-CONTAINS: write `;` where they meet

// ROW 8 — a `match` arm's BLOCK body.
func match_arm_block_row(k: Int) {
    var tag = 0
    match k {
        case 0 -> { tag = 1 print("{}", tag) },
        case _ -> { tag = 2 }
    }
}

// CONTROL for row 8, in its OWN declaration so it is parsed independently of
// the error above (which stops `match_arm_block_row` and nothing else). A BARE
// arm body is an EXPRESSION, not a statement list, so it never reaches the
// chokepoint and nothing here is refused. Note what this does NOT claim: the
// comma between arms is OPTIONAL in today's grammar — `case 0 -> 1 case _ -> 2`
// on one line compiles, here and on main — which is pre-existing and untouched
// by SL-347.
func match_bare_arm_control(k: Int) -> Int {
    match k {
        case 0 -> print("zero"),
        case _ -> print("other")
    }
    k
}

func positive(k: Int) -> Int? {
    if k > 0 { k } else { None }
}

// ROW 9 — a `guard … else { }` body.
func guard_else_row(k: Int) -> Int {
    guard let v = positive(k) else { print("neg") return 0 }
    v
}

// ROW 10 — the `try { }` block.
func try_block_row() -> Int {
    try { let a = 1 a } catch { 0 }
}

// ROW 11 — the `catch { }` block.
func catch_block_row() -> Int {
    try { 1 } catch { print("c") let n = 2 }
}

func main() {
    match_arm_block_row(0)
}
