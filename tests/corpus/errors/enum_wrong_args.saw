// Test error: wrong argument count for enum variants
// EXPECT: error
// EXPECT-ERROR-CONTAINS: variant `Success` expects 1 arguments, got 0
// EXPECT-ERROR-CONTAINS: variant `Error` expects 1 arguments, got 2

enum OperationResult {
    case Success(value: Int),
    case Error(code: Int)
}

func main() {
    // Missing required argument
    let r1 = OperationResult.Success()

    // Extra argument
    let r2 = OperationResult.Error(code: 404, extra: 123)
}
