// K142: inside a producer, only the value it returns is exempt. A borrowing
// struct is a value only as a `borrow` or `for` head, and cannot leave that
// scope (SL:borrowing §3); a producer's returning paths are the one other
// place its construction may stand, because that is the value the caller's
// head receives. Every other borrowing-typed expression in the body meets
// the ordinary rule where it is written.
//
// Rows: a stored foreign borrow (`var held = other.iter()`, after which
// `other` is mutated while `held` is live), a stored `lends self`
// construction that is no path's leaf, and a producer's result handed to a
// call.
// EXPECT: error

struct Owner { value: Int }
borrows struct It { source: &Owner, done: Bool }

extension Owner {
    func iter(&self) borrows -> It {
        It(source: lends self, done: false)
    }
    func bad(&self, other: &var Owner) borrows -> It {
        var held = other.iter()                          // ROW: a stored foreign borrow
        other.value = 99
        print(held.next()!)
        It(source: lends self, done: false)
    }
    func bad_local(&self) borrows -> It {
        let held = It(source: lends self, done: false)   // ROW: a stored construction, no path's leaf
        It(source: lends self, done: false)
    }
    func bad_arg(&self, other: &Owner) borrows -> It {
        let n = count(other.iter())                      // ROW: handed to a call
        It(source: lends self, done: n > 0)
    }
}

func count(it: &Owner) -> Int { 0 }

extension It: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.done { None } else {
            self.done = true
            self.source.value
        }
    }
}

func main() {}
