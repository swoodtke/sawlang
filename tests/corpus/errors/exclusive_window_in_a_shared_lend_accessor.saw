// A `&self` accessor body that opens an EXCLUSIVE borrow through `self` is
// refused where it is declared (SL:borrowing §3, §9).
//
// `&self` is read-only all the way down, and a `borrows` body is ordinary code
// under its receiver: the `lend` operand is the one place it names a place
// without writing `borrow` (§2.7). `Inner.plain` and `Inner.opt` are declared
// `&var self`, so any borrow through them charges their root exclusively, and
// here that root is storage reached through a shared `self`. Whether the
// caller's root is `let` or `var` does not come into it: the uses in `main`
// are shared borrows of a `let` root, which a `&self` accessor allows.
//
// Modes are declared, never inferred (§1), so the refusal does not wait for a
// use site to classify the accessor.
//
// THE CELLS, one accessor each, all declared `&self ... borrows -> &Int`:
//
//   `arg`      a `borrow var` ARGUMENT over a receiver-rooted place: the
//              callee gets `&var` to storage inside a shared receiver
//   `forced`   the same through a `!` head on a conditional lend, which
//              opens the same exclusive borrow when the place is present
//   `written`  the place as the WRITE TARGET of a statement-form
//              `borrow var`, which assigns through the lent place
//   `bumped`   the place under a COMPOUND assignment, which reads and
//              writes it in one exclusive borrow
//
// The fix each refusal points at is a `&var self` receiver on the outer
// accessor, which then charges its own root exclusively (§3); a shared read
// through `Inner` needs a shared twin, which `@synthesize(shared)` derives
// (§4). Every cell is a separate refusal; none depends on another.
//
//
// EXPECT: error

struct Inner { n: Int }

extension Inner {
    // Declared `&var self`, so every borrow through them charges the root
    // exclusively (SL:borrowing §3).
    func plain(&var self) borrows -> &var Int { lend self.n }
    func opt(&var self) borrows -> &var Int? { lend self.n }
}

func bump(n: &var Int) { n += 1 }

struct Outer { inner: Inner, n: Int }

extension Outer {
    func arg(&self) borrows -> &Int {
        bump(borrow var self.inner.plain())
        lend self.n
    }

    func forced(&self) borrows -> &Int {
        bump(borrow var self.inner.opt()!)
        lend self.n
    }

    func written(&self) borrows -> &Int {
        borrow var self.inner.plain() = 5
        lend self.n
    }

    func bumped(&self) borrows -> &Int {
        borrow var self.inner.plain() += 1
        lend self.n
    }
}

func main() {
    let o = Outer(inner: Inner(n: 1), n: 2)
    print("{borrow o.arg()}")
    print("{borrow o.forced()}")
    print("{borrow o.written()}")
    print("{borrow o.bumped()}")
}
