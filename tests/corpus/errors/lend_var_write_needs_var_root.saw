// A write through the exclusive accessor of a hand-written pair demands a
// mutable root, exactly as any other exclusive borrow does. The shared
// `(&self) borrows -> &Int` accessor and the exclusive `(&var self)` one
// have different bodies (the exclusive one runs a gate), so both are
// written (SL:borrowing §4).
//
// The setitem `frozen[0] = 9` is derived from the exclusive accessor
// (§5.2), which charges `frozen` exclusively (§3), so a `let` root refuses
// it. The same root READS fine: the getitem is derived from the shared
// accessor, so the read copies out under a shared charge. The
// declarations, not the use site, decide each mode.
//
// EXPECT: error

struct Grid { cells: [Int; 4], gates: Int }

extension Grid {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        lend self.cells[i]
    }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        self.run_gate()
        lend self.cells[i]
    }
}

func main() {
    let frozen = Grid(cells: [1, 2, 3, 4], gates: 0)
    frozen[0] = 9
    print("{frozen[0]}")
}
