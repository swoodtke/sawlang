// K145 and K212 (SL-871 unit 1): A BORROWING STRUCT'S REFERENCE FIELD IS
// `&T` OR `&var T`, AND A `&var` FIELD STANDS ALONE.
//
// A `&var` field is legal: its producer takes `&var self`, so the window
// charges the root exclusively for the struct's whole life, and each `next`
// reborrows through the struct (`Writer` below declares cleanly). What stays
// refused:
//
//   * a slice field, which no `lends self` fills;
//   * a `&var` field beside another reference field: every reference field is
//     filled with `lends self`, so the two would alias the one root, a writer
//     beside another path to it (ruled by the user, Oct 24).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: and `&[Int]` is a slice, which no `lends self` makes
// EXPECT-ERROR-CONTAINS: holds the `&var` field `bag` and the reference field `view`
// EXPECT-ERROR-CONTAINS: so both would alias the one root

struct Bag {
    private items: Vector<Int>
}
extension Bag: NoCopy {}

borrows struct Writer {
    private bag: &var Bag
    private index: Int
}

borrows struct Sliced {
    private items: &[Int]
    private index: Int
}

borrows struct Aliased {
    private bag: &var Bag
    private view: &Bag
    private index: Int
}

func main() {
    print("unreached")
}
