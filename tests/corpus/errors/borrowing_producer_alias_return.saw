// K144: a `borrows` function that returns a borrowing struct constructs it
// with `lends self` on every returning path, so the borrow it hands out is
// always of its own receiver (LANGUAGE_SPEC, Borrowing structs; SL:borrowing
// §3). A return type that is an alias is the struct it resolves to, and the
// back-conversion `Alias(<value>)` a producer writes to inhabit the alias is
// transparent: `Alias(It(source: lends self, …))` is a construction (the
// accept twin is `borrowing_rules_resolve_aliases.saw`), and
// `Alias(other.iter())` hands on another accessor's result, which borrows
// `other`, not `self`.
//
// Rows: the whole body converts a foreign result (`bad`), and a value `if`
// whose true arm constructs and whose false arm converts one (`bad_arm`).
// EXPECT: error

struct Owner { value: Int }
borrows struct It { source: &Owner, done: Bool }
type Alias = It

extension Owner {
    func iter(&self) borrows -> It {
        It(source: lends self, done: false)
    }
    func bad(&self, other: &Owner) borrows -> Alias {
        Alias(other.iter())                             // ROW: the one path converts a foreign result
    }
    func bad_arm(&self, other: &Owner, flag: Bool) borrows -> Alias {
        if flag { Alias(It(source: lends self, done: false)) }
        else { Alias(other.iter()) }                    // ROW: one arm of two
    }
}

func main() {}
