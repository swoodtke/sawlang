// `Vector.ref_at` does not exist: an element is reached in place through a
// `borrow` of `v[i]` (SL:borrowing §9), never through a returned reference.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: type `Vector` has no method `ref_at`

func main() {
    var v: Vector<Int> = [1, 2, 3]
    let p = v.ref_at(0)
    print(p[0])
}
