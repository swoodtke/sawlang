// `Mutex.lock()` is a `borrows(sync)` accessor, so the lock's borrow cannot be
// held across a suspension, and a suspending call inside the `borrow var`
// block is a compile error naming the accessor (SL:borrowing §2.5, §8): the
// async-mutex deadlock class, ruled out by construction.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot be held across a suspension

import std.mutex.{Mutex}
func block_forever() {
    __saw_test_suspend()
}

func main() {
    let m = Mutex<Int>(value: 0)
    borrow var c = m.lock() {
        block_forever()
        c = c + 1
        true
    }
}
