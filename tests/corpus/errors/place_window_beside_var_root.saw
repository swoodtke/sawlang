// EXPECT: error
//
// DF-188f's other half: not two borrows, but ONE borrow beside a `&var` of the
// same root in the same call. `Pair.at` takes `&var self` and lends `&var Int`,
// so `borrow var p.at(0)` charges `p` exclusively (SL:borrowing §3), and as an
// argument it lasts for the whole call (§2.2). `reset(&var p)` inside that call
// is a second access to `p` while the borrow holds it: were it allowed,
// `reset`'s writes would land inside a borrow that had already read the
// pre-reset value, and vanish (`a=8 b=2` where `a=107 b=200` is the answer).
//
//
// A `&var` root written straight into the same argument list is the same
// conflict said out loud (audit rows X31/X38); both spellings are refused.
// Nesting the reference inside another call is not a way past the Law once a
// borrow is open, because the borrow's extent is the whole call.

struct Pair {
    a: Int,
    b: Int
}

extension Pair {
    func at(&var self, i: Int) borrows -> &var Int {
        if i == 0 { lend self.a } else { lend self.b }
    }
}

func reset(p: &var Pair) -> Int {
    p.a = 100
    p.b = 200
    7
}

func sink(x: &var Int, y: Int) {
    x = x + y
}

func sink2(x: &var Int, p: &var Pair) {
    x = 1
    p.b = 2
}

func main() {
    var p = Pair(a: 1, b: 2)
    sink(borrow var p.at(0), reset(&var p))
    sink2(borrow var p.at(0), &var p)
    print("a={p.a} b={p.b}")
}
