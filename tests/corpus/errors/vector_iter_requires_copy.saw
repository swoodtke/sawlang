// A plain `for x in …` copies each element out of the lent reference, so the
// loop needs Copy elements (SL:borrowing §2.6). The Copy requirement sits on
// the loop, not on `iter()`, which is callable for any `T`: this loop is
// refused, not the call. Copying a NoCopy element would duplicate it into the
// loop variable and deinit it twice.
//
// Reaching a NoCopy element in place is `for borrow let r in v.iter()`.
// EXPECT: error

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.name}") }
}

func main() {
    var v = Vector<Res>()
    v.push(Res(name: "a"))
    for r in v.iter() {
        print(r.name)
    }
}
