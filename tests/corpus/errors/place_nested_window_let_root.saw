// Borrows NEST: `borrow var frozen[0][1].count += 10` is a chain of two
// reborrows, and the write reaches the outer place's storage, so both
// accessors lend exclusively and the root is charged exclusively
// (SL:borrowing §2.2, §3). A `let` root refuses it.
//
// Both accessors declare their shared twin with `@synthesize(shared)` (§4),
// so the plain read that follows is a copy under a shared charge, and the
// nested write is the one refusal. The refusal is about the root the chain
// starts at, not about the inner accessor alone.
//
// EXPECT: error

struct Cell { count: Int }
struct Row { cells: [Cell; 2] }
struct Bag { rows: [Row; 2] }

extension Row {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Cell {
        if i < 0 || i >= 2 { panic("Row.[]: index out of range") }
        lend self.cells[i]
    }
}

extension Bag {
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Row {
        if i < 0 || i >= 2 { panic("Bag.[]: index out of range") }
        lend self.rows[i]
    }
}

func main() {
    let frozen = Bag(rows: [Row(cells: [Cell(count: 1), Cell(count: 2)]),
                            Row(cells: [Cell(count: 3), Cell(count: 4)])])
    borrow var frozen[0][1].count += 10
    print("{frozen[0][1].count}")
}
