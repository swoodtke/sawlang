// K143: nothing erases a borrowing struct. A `borrows` function may return
// the bare struct it lends (SL:borrowing §3), and only as that bare return:
// a composite spelling (`It?`, `Optional<It>`, `Result<It, E>`, `(It, Int)`,
// `Vector<It>`, `Box<It>`, a distinct alias of each) is a plain return type
// that names the struct, refused as the same signature is without
// `borrows` (LANGUAGE_SPEC, Borrowing structs: "Nothing erases it").
//
// A callable is a composite too: `borrows -> () -> It` returns a closure
// that would hand the struct out of its scope, so it is refused bare and
// through an alias.
//
// `Result<It, E>` has no alias row: a type alias of an enum is refused on
// its own terms (DF-194b). `iter` is the control, a bare producer that is
// accepted, and `borrowing_producer_every_path.saw` keeps one running.
// EXPECT: error
// EXPECT-ERROR-ABSENT: internal compiler error

struct Owner { value: Int }
borrows struct It { source: &Owner, done: Bool }

struct Bad { n: Int }
extension Bad: Error {
    func format(&self, into: &var StringBuilder) { try! into.append("bad") }
}

type OptIt = It?
type OptNamedIt = Optional<It>
type TupIt = (It, Int)
type VecIt = Vector<It>
type BoxIt = Box<It>
type MkIt = () -> It

extension Owner {
    // The CONTROL: the bare producer, exempt because it is proven.
    func iter(&self) borrows -> It { It(source: lends self, done: false) }

    // ---- the composite spellings, each a plain return beside the word ----
    func opt_sugar(&self) borrows -> It? { panic("never") }
    func opt_named(&self) borrows -> Optional<It> { panic("never") }
    func result(&self) borrows -> Result<It, Bad> { panic("never") }
    func tuple(&self) borrows -> (It, Int) { panic("never") }
    func vector(&self) borrows -> Vector<It> { panic("never") }
    func box(&self) borrows -> Box<It> { panic("never") }

    // ---- the same rows through a DISTINCT ALIAS ----
    func alias_opt_sugar(&self) borrows -> OptIt { panic("never") }
    func alias_opt_named(&self) borrows -> OptNamedIt { panic("never") }
    func alias_tuple(&self) borrows -> TupIt { panic("never") }
    func alias_vector(&self) borrows -> VecIt { panic("never") }
    func alias_box(&self) borrows -> BoxIt { panic("never") }

    // ---- the CALLABLE spelling, bare and through an alias (codex r4 #1) ----
    func callable(&self) borrows -> () -> It { panic("never") }
    func alias_callable(&self) borrows -> MkIt { panic("never") }
}

func main() {
    print("unreached")
}
