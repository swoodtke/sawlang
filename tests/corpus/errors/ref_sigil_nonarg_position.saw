// A `&var` reference is only valid as a call argument (design 34, restated for
// both flavors by DF-163d): it cannot be stored or bound to a variable.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `&var` here is not a call argument, and references in Saw are PARAMETERS ONLY
// EXPECT-ERROR-CONTAINS: pass it straight to a `&var` parameter

func main() {
    var a = 5
    let r = &var a
    print(a)
}
