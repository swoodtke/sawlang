// Box payload forwarding is IMMUTABLE-only (design 42 item 1, like Arc): a
// `&var self` payload method cannot be called through the Box — aliased mutation
// of owned-through-a-handle state is what a Mutex payload exists to make safe.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot call `&var self` method `bump` through `Box`

struct Counter { n: Int }
extension Counter {
    func bump(&var self) { self.n = self.n + 1 }
}

func main() {
    let b = try! Box<Counter>.make(Counter(n: 0))
    b.bump()   // rejected: &var self forwarding through Box
}
