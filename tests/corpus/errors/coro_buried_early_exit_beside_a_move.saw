// SL-222 (review r3): a statement that BURIES an early exit inside its own
// expression, beside a `move` of a frame local. Stage 0 refuses this shape as a
// limit of its source-level coroutine transform (SL-234); the language allows
// it, and this copy states what it means: each `Res` is destroyed exactly once,
// by the callee it moved into, on the path that returns early and on the one
// that falls through.
//
// It stays in `errors/` because its examples/ twin, Stage 0's refusal test, is
// there, and corpusdiff pairs a corpus program with the twin at the same path.
// EXPECT: success
// EXPECT-OUTPUT:
// drop item1
// drop exit
// 1
// drop item1
// drop item2
// 0

import std.task.{yield_now}

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("drop {}", self.name) }
}

func note(r: &Res) -> Int { r.name.len() }

func consume_bool(r: Res) -> Bool { r.name == "exit" }

func make(i: Int, exit_at: Int) -> Res {
    if i == exit_at { Res(name: "exit") } else { Res(name: "item{i}") }
}

func sink_int(n: Int) { }

func run(items: Vector<Int>, exit_at: Int) -> Int {
    yield_now()
    for i in items.iter() {
        var r = make(i, exit_at)
        if note(&r) + i < 0 { return -1 }
        sink_int(if consume_bool(move r) { return 1 } else { 0 })
    }
    0
}

func main() {
    print(__saw_drive(run([1, 2], 2)))
    print(__saw_drive(run([1, 2], 0)))
}
