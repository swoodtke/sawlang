// An element borrow is invalidation-proof: `Vector.[]` takes `&var self`, so
// `borrow var e = v[0]` holds the WHOLE vector exclusively for the block, and
// the block cannot touch its root (SL:borrowing §3). Mutating the vector (here
// `push`, which could reallocate the buffer and dangle the element borrow)
// while the borrow is live is refused.
//
// Conformance Z01. `push` reports a refused allocation, which would give the
// block a second thing it could be refused for (design 151's discard of a
// `Result`), and a row that passes for the wrong reason has stopped testing.
// The `try!` consumes the `Result` so the exclusivity refusal is the only one
// left standing — which is the guarantee the row is for.
// EXPECT: error

func main() {
    var v: Vector<Int> = [1, 2, 3]
    borrow var e = v[0] { try! v.push(9) }
    print(v.len())
}
