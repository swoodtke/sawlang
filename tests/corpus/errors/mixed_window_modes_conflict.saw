// SL:borrowing §3 and §4 (conformance row K125, the MIXED cell): a borrow
// through an accessor's declared shared twin beside one through an accessor
// that is exclusive only, on one root, is a shared charge against an
// exclusive one, and conflicts.
//
// There is no special case. Each borrow's root charge is read from the
// accessor it calls: `Bag.[]` declares `@synthesize(shared)`, so a bare
// `borrow b[i]` picks the `&self` twin and charges `b` shared (§4); `tally`
// and `opt` take `&var self` with no twin, so every borrow through them
// charges `b` exclusively (§3). Borrows live together in one call are
// checked together (§2.2), so every pairing falls out of that one rule:
//
//   shared twin     × exclusive only      both orders, below
//   exclusive only  × exclusive only      `two_exclusive_only_windows_conflict.saw`
//   exclusive only  × plain `&root`       below
//   exclusive only  × plain `&var root`   `place_window_beside_var_root.saw`
//   shared twin     × shared twin         compiles: two shared charges compose
//
// The `!` head is here too: a conditional lend used inline to reach into its
// place (§2.2) is the same access, and joins the check the same way.
//
// `tally` and `opt` could not take a synthesized twin: their epilogues write
// `self`, so their bodies fail under the shared signature (§4).
// EXPECT: error

struct Cell { n: Int }

struct Bag { cells: [Int; 4], rows: [Cell; 2], visits: Int }

extension Bag {
    // Declares its shared twin, so a bare `borrow b[i]` charges `b` shared (§4).
    @synthesize(shared)
    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.[]: index out of range") }
        lend self.cells[i]
    }

    // Exclusive only: `&var self` with no shared twin; the epilogue writes `self`.
    public func tally(&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Bag.tally: index out of range") }
        lend self.cells[i]
        self.visits = self.visits + 1
    }

    // Exclusive only, and CONDITIONAL — reached through a `!` head.
    public func opt(&var self, i: Int) borrows -> &var Cell? {
        if i < 0 || i >= 2 { return None }
        lend self.rows[i]
        self.visits = self.visits + 1
    }

    public func visits_seen(&self) -> Int { self.visits }
}

func pair(a: &Int, b: &Int) -> Int { a + b }
func pair_cell(a: &Int, b: &Cell) -> Int { a + b.n }
func with_root(a: &Int, r: &Bag) -> Int { a + r.visits_seen() }

func main() {
    var b = Bag(cells: [10, 20, 30, 40], rows: [Cell(n: 1), Cell(n: 2)],
                visits: 0)
    print("{pair(borrow b[0], borrow b.tally(1))}")        // the shared twin first
    print("{pair(borrow b.tally(0), borrow b[1])}")        // the exclusive one first
    print("{pair_cell(borrow b[0], borrow b.opt(1)!)}")    // through a `!` head
    print("{with_root(borrow b.tally(0), &b)}")      // beside a plain `&root`
}
