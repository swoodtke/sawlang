// EXPECT: error
// EXPECT-ERROR-CONTAINS: `v` is borrowed here while the window of `[]` opened at 32:5 holds `v` exclusively until the window closes
// EXPECT-ERROR-CONTAINS: the root is reached only through the window's binding
//
// Conformance row P21's refusal half. A named window's body may not name the
// window's own root: borrowing it would put a second access to the root
// inside the open window, and `v.pop()` there is the invalidation that rule
// exists for.
//
// The shapes that read the root beside the place compile, each by ORDER: an
// assignment's right-hand side runs before its target, and an argument runs
// before the window it feeds opens (SL:borrowing §12.1), so neither access
// lands inside the window (`place_window_root_read_in_assignment_rhs.saw`).
// A named window is a block the program runs inside, with nothing to order;
// the fix there is to read the root above the block.

struct Res { id: Int }
extension Res: NoCopy {}
extension Res {
    func bump(&var self, by: Int) { self.id = self.id + by }
}

func main() {
    var v = Vector<Res>()
    try! v.push(Res(id: 1))
    try! v.push(Res(id: 2))

    // The argument runs before `v[0]`'s window opens.
    v[0].bump(by: v.len())

    // Inside the block `borrow var e` opens, `v` is the window's.
    borrow var e = v[0] {
        e.bump(by: 1)
        print(v.len())
    }
}
