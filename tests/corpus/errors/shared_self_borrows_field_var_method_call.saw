// A `&self` accessor's prologue is `&self` code, so it may not call a
// `&var self` method on a field: `&self` is read-only all the way down
// (SL:borrowing §9). A shared accessor serves a read through a `let` root
// (§3), so the call here would mutate `frozen.gate`, which is declared
// immutable, on every read.
//
// The accessor lends read-only (`&self ... borrows -> &Int`), the declaration
// this rule is about. Declaring it `&var self ... -> &var Int` instead makes
// the call legal, and the reads through `let frozen` then meet a different
// refusal, since a `&var self` accessor needs a mutable root (§3):
// `errors/exclusive_only_accessor_on_let_root.saw` pins that one.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot call `&var self` method `run` on storage reached through a `&self` receiver

struct Gate { n: Int }

extension Gate {
    func run(&var self) { self.n = self.n + 1 }
}

struct Grid { cells: [Int; 4], gate: Gate }

extension Grid {
    public func [](&self, i: Int) borrows -> &Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        self.gate.run()
        lend self.cells[i]
    }

    public func gates(&self) -> Int { self.gate.n }
}

func main() {
    let frozen = Grid(cells: [1, 2, 3, 4], gate: Gate(n: 0))
    print("{frozen[0]} {frozen[1]}")
    print("gates on a let root {frozen.gates()}")
}
