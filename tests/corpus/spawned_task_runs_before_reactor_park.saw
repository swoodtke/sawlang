// A task spawned before main's FIRST suspension gets its first turn even when
// that suspension is a REACTOR park (design 89-b: "spawn enqueues a task ...
// and it runs EAGERLY — whenever the executor runs, not only at join").
//
// DF-203a, fixed by design 206: the promise held for `sleep` and not for
// `listener.accept()`, and the difference was never timer-vs-reactor. `sleep`
// is an INTRINSIC, so the effect graph recorded it as a direct suspension
// source on `main` itself and the design-45 gate wrapped `main` in the entry
// executor. `accept` is a std METHOD, and the entry compile has no effect node
// for a std method — so `main` was judged suspension-free, never became a
// coroutine at all, and `accept`'s internal `io_wait` took the outside-frame
// lowering, which blocks the one executor thread in `poll(-1)` with a ready
// worker sitting in the run queue. Found by the design-203 dogfood chatroom
// program (its natural spelling: spawn the clients, then accept them).
//
// The output order is deterministic and worth reading: on loopback the worker's
// `connect` completes through the listen backlog and its `write` fits in the
// socket buffer, so the whole worker finishes on main's first park — BEFORE
// main returns from `accept`. `group` registers into the ambient scheduler list
// after the root, so it is swept first.
// EXPECT: success
// EXPECT-OUTPUT:
// worker connecting
// worker done
// accepted
// done

import std.net.{TcpListener, TcpStream}
import std.task.*

func worker(port: Int) -> Int {
    print("worker connecting")
    let s = try! TcpStream.connect("127.0.0.1", port)
    try! s.write("x")
    print("worker done")
    return 1
}

func main() {
    var group = TaskGroup()
    let listener = try! TcpListener.listen(0)
    let port = listener.local_port()
    let h = group.spawn(worker(port))
    let s = try! listener.accept()
    print("accepted")
    let _ = try! s.read()
    let _ = h.join()
    print("done")
}
