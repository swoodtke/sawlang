// Acceptance: a program whose main line suspends (`__saw_test_suspend` via
// background) can still contain `sync` regions. `critical` is a `sync func`
// calling only pure code, so it type-checks even though `main` itself is
// (inferred) suspending. Colorless calls: no annotation is needed on `main`.
// EXPECT: success
// EXPECT-OUTPUT:
// 42

func background() {
    __saw_test_suspend()
}

func critical() sync -> Int {
    pure_calc(21)
}

func pure_calc(n: Int) -> Int {
    n + n
}

func main() {
    background()
    print(critical())
}
