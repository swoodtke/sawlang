// design 76 (A4): a bidirectional echo over a local socketpair inside a
// TaskGroup, exercising the cooperative IO reactor. The server parks on an empty
// socket until the client writes; the client sends "hi", parks until the server
// echoes it back, then verifies the content. Deterministic on byte-counts +
// content (never on interleaving). Loopback only — no network.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 1

import std.net.{TcpStream}

func server(stream: TcpStream) -> Int {
    let chunk = try! stream.read()  // park until the client sends
    let n = chunk.len()
    try! stream.write(move chunk)   // echo the bytes back
    return n
}

func client(stream: TcpStream) -> Int {
    try! stream.write("hi")
    let echo = try! stream.read()   // park until the echo arrives
    if (try! echo.to_string()) == "hi" { 1 } else { 0 }
}

func main() {
    let (a, b) = try! TcpStream.pair()
    var group = TaskGroup()
    let hs = group.spawn(server(move b))
    let hc = group.spawn(client(move a))
    print(hs.join())    // 2 bytes echoed
    print(hc.join())    // 1 = content round-tripped
}
