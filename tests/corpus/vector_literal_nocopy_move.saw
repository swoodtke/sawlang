// A context-driven Vector literal moves owning (NoCopy) elements in, exactly
// like the array literal's move-in rules (design 54 Part 4).
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 7
// 9

struct R {
    id: Int
}

extension R: NoCopy {
    func deinit(&var self) {
    }
}

func main() {
    let a = R(id: 7)
    let b = R(id: 9)
    let v: Vector<R> = [move a, move b]
    print(v.len())            // 2
    // A NoCopy element is READ IN PLACE through the element place (design
    // 141/146); taking it out as a value would alias storage the vector owns.
    print(v[0].id)            // 7
    print(v[1].id)            // 9
}
