// Refused: Box/Arc forwarding is dropped (SL-712), so a payload method is reached with `borrow p.value().m()`.
// A `Box` forwards no payload method, as an `Arc` forwards none: `b.sum()`
// names a `&self` method of the payload `Point`, which the `Box` does not
// declare, and is refused at that first call; `b.scaled(2)` is the same shape.
// Each compiles as `borrow b.value().sum()`.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `sum` is a method of the payload

struct Point { x: Int, y: Int }

extension Point {
    func sum(&self) -> Int { self.x + self.y }
    func scaled(&self, k: Int) -> Int { (self.x + self.y) * k }
}

func main() {
    let b = try! Box<Point>.make(Point(x: 3, y: 4))
    print(b.sum())        // 7  — forwarded &self method
    print(b.scaled(2))    // 14 — forwarding with an argument
}
