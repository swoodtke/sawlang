// A `borrow let` block over `v[i]` bounds-checks its index. Vector's place
// accessor panics out of range (SL:borrowing §4), so an index past the end
// never reaches the buffer: a borrowed element is never an out-of-bounds
// heap READ from safe code. This is the spelling that reaches a NoCopy
// element in place (§9), so it is the one a caller is steered to. Repro
// shape (design 122, RS-6): a 2-element `Vector<Int>` read past the end.
//
// EXPECT: panic

func main() {
    let v: Vector<Int> = [10, 20]
    print(borrow let e = v[1] { e })     // 20 — in range, borrow works
    print(borrow let e = v[99] { e })    // past the end -> panic
}
