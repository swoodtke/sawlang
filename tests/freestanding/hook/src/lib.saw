//! `fshook` — the start-up of a runtime that owns the background group and
//! delivers events of its own between drives.
//!
//! It is `fsdrive` with a callback: after each drive, and after its wait past a
//! deadline answer, it calls the case's `fs_between_drives(n)`, as a kernel's
//! event loop runs a handler outside every drive. A no-deadline answer ends the
//! driving unless that call answers 1, which says it delivered something a task
//! may have been waiting for. Every drive is numbered on the console, as
//! `fsdrive` numbers them, and once driving stops it closes the group, prints
//! `fs drive closed drives=N` and the status, and stops the machine with the
//! status `main` returned.

import fsrt

extern "C" {
    func __saw_main() -> Int32
    func __saw_background_drive() -> Int64
    func __saw_background_close()
    func __saw_rt_clock_monotonic_nanos() -> Int64
    // The case's own export, which this start-up calls once `main` returned.
    func fs_after_main()
    // The case's callback between drives: 1 when it delivered an event.
    func fs_between_drives(n: Int) -> Int
}

static NOTHING_LIVE: Int64 = -1
static NO_DEADLINE: Int64 = 9_223_372_036_854_775_807

// How far ahead of the clock a deadline answer counts as `soon`.
static SOON_NANOS: Int64 = 150_000_000

// How long past a deadline answer the start-up waits before it drives again.
static PAST_DEADLINE_NANOS: Int64 = 5_000_000

// How many drives the start-up makes before it closes the group whatever it
// holds, so a case whose tasks never settle ends rather than spins.
static DRIVE_LIMIT: Int = 200

/// The class of drive answer `next` read at clock reading `now`.
func answer_class(next: Int64, now: Int64) -> String {
    if next == NOTHING_LIVE {
        return "nothing-live"
    }
    if next == 0 {
        return "now"
    }
    if next == NO_DEADLINE {
        return "no-deadline"
    }
    if next <= now {
        return "past"
    }
    if next - now < SOON_NANOS {
        return "soon"
    }
    "later"
}

/// Run the program and its export, then drive the background group, numbering
/// each drive and calling the case back between drives, until no task can run
/// before an event the callback has not delivered; close the group and stop
/// the machine with the status `main` returned.
@export("fs_main")
func start() {
    let status = __saw_main()
    fs_after_main()
    var drives = 0
    var go = true
    while go && drives < DRIVE_LIMIT {
        drives = drives + 1
        print("fs drive n={}", drives)
        let next = __saw_background_drive()
        print("fs drive answer={}", answer_class(next, __saw_rt_clock_monotonic_nanos()))
        if next > 0 && next != NO_DEADLINE {
            let until = next + PAST_DEADLINE_NANOS
            while __saw_rt_clock_monotonic_nanos() < until {
            }
        }
        let delivered = fs_between_drives(drives)
        if next == NOTHING_LIVE {
            go = false
        } else if next == NO_DEADLINE {
            go = delivered == 1
        }
    }
    __saw_background_close()
    print("fs drive closed drives={}", drives)
    print("fs entry status={}", status)
    fsrt.stop(status as UInt32)
}
