// What a drive made inside a task's turn answers once the calling task is the
// only one left live: the caller is on the stack, live with no deadline, so
// the answer is no-deadline, never nothing-live and never run-again.

import fscore.*
import fsdrive
import std.task.*

extern "C" {
    func __saw_background_drive() -> Int64
}

func other() {
    report("other_ran", 1)
}

func caller() {
    let next = __saw_background_drive()
    report("nested_nothing_live", if next == 0 - 1 { 1 } else { 0 })
    report("nested_run_again", if next == 0 { 1 } else { 0 })
    report("nested_no_deadline", if next == 9_223_372_036_854_775_807 { 1 } else { 0 })
}

func main() {
    report("main_entered", 1)
}

@export("fs_after_main")
func after_main() {
    let a = Task.spawn(caller())
    a.detach()
    let b = Task.spawn(other())
    b.detach()
}
