// `print`'s `{}` renders a wider-than-platform-word integer WHOLE on a 32-bit
// target (DF-238b, fixed Aug 22). It used to be truncated into the platform-Int
// parameter of `__saw_fmt_int`/`__saw_fmt_uint` and printed as its low word:
// 0x1234_0000_5678 came out 22136.
//
// riscv32 ONLY, by the `arches` key: on arm64 the platform word already is 64
// bits, so the same source has always rendered correctly there and a marker on
// it would be stale. That split is the reason this pin cannot live in
// `examples/` — `test_runner.py` builds for the 64-bit host, where the two
// widths coincide and the defect does not exist.
//
// Four rows, because the fix picks a formatter by width AND signedness: a
// positive `Int64`, the same bits as `UInt64`, a NEGATIVE `Int64` (the sign
// path of the wide itoa), and `UInt64.max` (above `Int64.max`, so a signed
// formatter would print -1 — the 64-bit restatement of DF-119b).
//
// Nothing else here is under test — the arithmetic itself is
// `cases/int_widths.saw`'s, and it passes on both targets.

import fscore.*

@export("fs_main")
func fs_main() {
    let high: Int64 = 0x1234
    let value = (high << 32) | 0x5678
    report_wide("signed", value)

    let unsigned: UInt64 = 0x1234_0000_5678u64
    report_unsigned_wide("unsigned", unsigned)

    report_wide("negative", 0 - value)
    report_unsigned_wide("max", 0xFFFF_FFFF_FFFF_FFFFu64)

    finish("wide_value_rendering")
}
