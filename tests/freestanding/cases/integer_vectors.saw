// The 64-bit integer helpers' vectors, and the checks `integer_helpers.saw` and
// its -O2 twin run on them: each helper called by its C symbol, so every row
// runs the helper itself rather than an operator LLVM may fold. Each row's
// answer was computed on the host with C's semantics, and
// `tools/test_freestanding_runner.py` computes each again; the zero-divisor
// rows hold the answers `std/builtins/integer.saw` states, and
// `Int64.min / -1` wraps (SL-948).

extern "C" {
    func __udivdi3(n: UInt64, d: UInt64) -> UInt64
    func __umoddi3(n: UInt64, d: UInt64) -> UInt64
    func __divdi3(n: Int64, d: Int64) -> Int64
    func __moddi3(n: Int64, d: Int64) -> Int64
    func __ashldi3(a: UInt64, b: Int32) -> UInt64
    func __lshrdi3(a: UInt64, b: Int32) -> UInt64
    func __ashrdi3(a: Int64, b: Int32) -> Int64
}

// The rows whose quotient, or `remainder`, the unsigned helper gets wrong,
// each printed.
public func unsigned_division_misses(remainder: Bool) -> Int {
    var misses = 0
    var row = 0
    while row < UNSIGNED_DIVISION_ROWS {
        let n = UNSIGNED_DIVISION[4 * row]
        let d = UNSIGNED_DIVISION[4 * row + 1]
        let want = UNSIGNED_DIVISION[4 * row + if remainder { 3 } else { 2 }]
        let got = if remainder { __umoddi3(n, d) } else { __udivdi3(n, d) }
        if got != want {
            print("fs miss unsigned row {} got {} want {}", row, got, want)
            misses = misses + 1
        }
        row = row + 1
    }
    misses
}

// The rows whose quotient, or `remainder`, the signed helper gets wrong, each
// printed.
public func signed_division_misses(remainder: Bool) -> Int {
    var misses = 0
    var row = 0
    while row < SIGNED_DIVISION_ROWS {
        let n = SIGNED_DIVISION[4 * row]
        let d = SIGNED_DIVISION[4 * row + 1]
        let want = SIGNED_DIVISION[4 * row + if remainder { 3 } else { 2 }]
        let got = if remainder { __moddi3(n, d) } else { __divdi3(n, d) }
        if got != want {
            print("fs miss signed row {} got {} want {}", row, got, want)
            misses = misses + 1
        }
        row = row + 1
    }
    misses
}

// The rows the shift helper `which` gets wrong (0 left, 1 right zero-filling,
// 2 right copying the sign bit), each printed.
public func shift_misses(which: Int) -> Int {
    var misses = 0
    var row = 0
    while row < SHIFT_ROWS {
        let v = SHIFTS[5 * row]
        let n = Int32.from(truncating: SHIFTS[5 * row + 1])
        let want = SHIFTS[5 * row + 2 + which]
        let got = if which == 0 {
            __ashldi3(v, n)
        } else if which == 1 {
            __lshrdi3(v, n)
        } else {
            UInt64.from(truncating: __ashrdi3(Int64.from(truncating: v), n))
        }
        if got != want {
            print("fs miss shift {} row {} got {} want {}", which, row, got, want)
            misses = misses + 1
        }
        row = row + 1
    }
    misses
}

