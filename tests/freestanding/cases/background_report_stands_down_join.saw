// The deadlock report stands down under a runtime that owns the background
// group, in thread context too: a `blocking` `main`'s join sweeps until the
// joined task finishes, and that task waits on a channel only the runtime
// could feed, so the wait goes to the runtime's reactor poll, which in this
// suite's runtime has no event to deliver and panics, saying so.
// `cooperative_deadlock` is the same join with a runtime that does not own the
// group, which reports a deadlock.

import fscore.*
import fsgroup
import std.channel.{Channel}

func drained(orders: Channel<Int>) -> Int {
    match orders.receive() {
        case Ok(order) -> order,
        case Err(_) -> 0
    }
}

func main() blocking {
    let orders = try! Channel<Int>()
    var group = TaskGroup()
    let waiter = group.spawn(drained(orders.copy()))
    report("reached_the_join", 1)
    report("never_joined", waiter.join())
}

@export("fs_after_main")
func after_main() {
    report("after_main", 1)
}
