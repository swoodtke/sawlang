// LINKING AT A FIXED LOAD ADDRESS with a custom linker script (design 238
// unit 1), asserted by the running program rather than taken on trust.
//
// `tests/freestanding/hal/<arch>/link.ld` puts `.fsmark` at ORIGIN + 64 KiB.
// This case declares an `@section(".fsmark")` static, reads its ADDRESS back,
// and checks two things:
//
//   - the OFFSET within the image is 0x1_0000 on both targets, which is a
//     claim the case can make itself because the two scripts agree about it;
//   - the ADDRESS is the target's own (0x8001_0000 / 0x4001_0000), which the
//     case cannot know, so it reports it and the runner matches per
//     architecture.
//
// And a third thing, which is what makes it a placement test rather than an
// arithmetic one: the static's VALUE reads back, so `.fsmark` was LOADED and
// not merely reserved. A section the script placed and the loader skipped
// would give the right address and a zero value.
//
// Editing an address in either script without editing the runner's expectation
// is a red case. That is the point of writing the number down twice.

import fscore.*

@section(".fsmark")
static MARK: UInt32 = 0x0FEE_D0FF

@export("fs_main")
func fs_main() unsafe {
    let address = ((&MARK) as UnsafeConstPointer<UInt32>) as UInt

    // What both scripts agree about, so the case can assert it.
    check_unsigned("fsmark_offset", address & 0x0FFF_FFFF, 0x0001_0000)
    // What differs per target, so the runner asserts it.
    report_unsigned("fsmark_address", address)
    // The section was loaded, not merely placed.
    check("fsmark_value", MARK == 0x0FEE_D0FF)

    // An ORDINARY static for contrast: no `@section`, so it lands in the
    // read-only data the script places BEFORE `.fsmark`. A build that ignored
    // the attribute would put the two together and this comparison would stop
    // holding.
    check("ordinary_static_below_fsmark",
          (((&ORDINARY) as UnsafeConstPointer<UInt32>) as UInt) < address)

    finish("link_address")
}

static ORDINARY: UInt32 = 0x1234_5678
