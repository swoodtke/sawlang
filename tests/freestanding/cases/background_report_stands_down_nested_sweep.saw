// The deadlock report stands down inside a drive too. A driven task calls a
// `sync` helper whose `TaskGroup` local's teardown keeps its nested sweep, and
// the group's task waits on a channel only the runtime could feed: the sweep
// idles inside drive 1, and the wait goes to the runtime's reactor poll, which
// in this suite's runtime has no event to deliver and panics, saying so.
// `cooperative_deadlock` is the same wait with a runtime that does not own the
// group, which reports a deadlock.

import fscore.*
import fsgroup
import std.channel.{Channel}
import std.task.*

func k(orders: Channel<Int>) -> Int {
    match orders.receive() {
        case Ok(v) -> v,
        case Err(_) -> 0 - 1
    }
}

func tear_down(orders: Channel<Int>) sync {
    var g = TaskGroup()
    let h = g.spawn(k(orders))
}

func keeper(orders: Channel<Int>) {
    report("keeper_tears_down", 1)
    tear_down(orders)
    report("keeper_after_teardown", 1)
}

func main() {
    report("main_entered", 1)
}

@export("fs_after_main")
func after_main() {
    let orders = try! Channel<Int>()
    let t = Task.spawn(keeper(orders.copy()))
    t.detach()
}
