//! `fsrt` — the freestanding suite's runtime provider (design 238 unit 1).
//!
//! `sawc/rt/ABI.md` freezes what a compiled Saw program CALLS; the compiler
//! emits those calls under every profile and the environment supplies the
//! bodies. This module is that environment, for a suite whose environment is
//! one assembly stub and nothing else.
//!
//! It is a miniature of `sos/rt/common` and is meant to be read beside it: four
//! `@export`ed seams over TWO per-side hooks, plus a bump arena behind the
//! allocating pair. What it deliberately does NOT carry is everything that made
//! sosrt an operating system's runtime — no console sink trait, no hex helpers,
//! no abort-status policy shared with a kernel. A suite needs the seams to be
//! REACHED and CHECKED, not to be reusable.
//!
//! WHO TURNS THESE ON. `@export`ing a `__saw_rt_*` name is refused unless the
//! compile declares itself a runtime provider (design 149):
//! `tools/freestanding_runner.py` passes `--runtime-provider` on the command
//! line for the sawc-driven cases, and `tests/freestanding/bladepkg` gets it
//! from `[package] runtime = true` in its own manifest — the two doors the
//! flag has, so the suite covers both. `cases/runtime_export_ungated.saw` is
//! the negative: the same export with the flag withheld.
//!
//! The signatures are machine-checked against `sawc/rt/ABI.md` (arity and
//! machine width), which is what `cases/runtime_seam_signature.saw` pins from
//! the other side.
//!
//! Nothing here suspends and nothing here names a target: the suite's
//! architecture-free scan (`tools/freestanding_runner.py`) reads this file.

// Where a byte goes, and how the machine stops. Everything below is written
// against these two and nothing else; both are supplied by the per-architecture
// boot stub (`tests/freestanding/hal/<arch>/boot.S`).
//
// (A plain comment, not `///`: an `extern` block is a container, and design 121
// attaches a doc block to a DECLARATION.)
extern "C" {
    func fs_console_write(ptr: UnsafePointer<Int8>, len: UInt)
    func fs_platform_exit(code: UInt32) -> Never
}

/// Exit statuses this runtime raises on its own behalf.
///
/// A case's own verdict codes live with the case; these two are the runtime's,
/// and they stay distinct so a transcript can tell "the program panicked" from
/// "the arena ran dry". The backing is the width `fs_platform_exit` takes, so
/// the projection at the call is one `as`.
enum ExitCode: UInt32 {
    case Panic = 64,
    case NoMemory = 65
}

/// Stop the machine carrying `code`. The clean exit is `stop(0)`.
public func stop(code: UInt32) -> Never {
    fs_platform_exit(code)
}

// =============================================================================
// The seams
// =============================================================================

/// `print`'s output primitive: `len` bytes at `ptr`, to the board's UART.
@export("__saw_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    fs_console_write(ptr, len)
}

/// The infallible-tier panic sink (design 19): report, then stop.
///
/// Check-free by construction, like the writer under it: it does no arithmetic
/// at all, so there is nothing here that could raise the panic it is in the
/// middle of reporting.
@export("__saw_rt_panic")
func rt_panic(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Never {
    fs_console_write(ptr, len)
    fs_platform_exit(ExitCode.Panic as UInt32)
}

// -----------------------------------------------------------------------------
// The bump arena
// -----------------------------------------------------------------------------
//
// Every case builds under `--no-hidden-alloc`, so nothing the COMPILER inserts
// allocates. What remains is what a case NAMES on purpose —
// `cases/runtime_seams.saw` grows a `Vector` — plus the compiler's panic path.
// An unbacked seam would turn a diagnosable panic into a wild jump.
//
// No reclamation: `dealloc` is a no-op, which is all a suite needs.

/// The arena's size, written once. Everything below derives from it.
static ARENA_BYTES: Int = 16_384

/// The region's type. Naming it is what lets `arena_capacity()` read the size
/// back with `sizeof` instead of repeating the number.
type ArenaRegion = [UInt8; ARENA_BYTES]

/// The region and the cursor over it — compound global state whose consistency
/// spans two words, which is what design 149's `unsafe static var` is for. The
/// serialization argument: every case is single-threaded, at the privilege
/// level the boot stub starts in, with no interrupt source enabled, so no
/// other agent can observe the window between the bound check and the cursor
/// store.
///
/// An all-zero static costs no image bytes (design 149) — this is 16 KiB of
/// `.bss`, not 16 KiB of ELF.
unsafe static var ARENA: ArenaRegion = [0; ARENA_BYTES]
unsafe static var ARENA_NEXT: UInt = 0

/// The arena's capacity, read off the region's own type.
func arena_capacity() -> UInt {
    sizeof<ArenaRegion>() as UInt
}

/// The region's base address.
func arena_base() unsafe -> UInt {
    ((&var ARENA) as UnsafePointer<UInt8>) as UInt
}

/// How many bytes the arena has handed out.
///
/// The suite's window onto the allocating seams: `cases/runtime_seams.saw`
/// reads it either side of an allocation the source NAMES, which is how a
/// running program proves `__saw_rt_alloc` was the thing that answered.
public func arena_used() unsafe -> UInt {
    ARENA_NEXT
}

/// Hand out `size` bytes aligned to `align`, or stop the machine.
///
/// Alignment is applied to the ABSOLUTE address rather than to the offset: a
/// `[UInt8; N]` has an alignment of one, so rounding the offset would only
/// satisfy the caller if the region itself happened to land aligned.
///
/// The bound is checked as a SUBTRACTION so a hostile `size` cannot wrap past
/// it. The padding step uses `&-` because a checked one would put a panic
/// branch inside the allocator for a subtraction that cannot go negative
/// (`rem` is a remainder of `step`, so `rem < step` always).
@export("__saw_rt_alloc")
func rt_alloc(size: UInt, align: UInt) unsafe -> UnsafePointer<Int8> {
    var step = align
    if step < 1 {
        step = 1
    }
    let base = arena_base()
    let capacity = arena_capacity()
    var offset = ARENA_NEXT
    let rem = (base &+ offset) % step
    if rem != 0 {
        offset = offset &+ (step &- rem)
    }
    if size > capacity || offset > capacity - size {
        let message = "fs: out of arena memory\n"
        fs_console_write(message, UInt.from(truncating: message.len()))
        fs_platform_exit(ExitCode.NoMemory as UInt32)
    }
    ARENA_NEXT = offset &+ size
    (base &+ offset) as UnsafePointer<Int8>
}

/// Free a block. A bump arena reclaims nothing, so this is deliberately empty.
@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: UInt, align: UInt) unsafe {
}
