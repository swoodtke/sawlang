// DF-C1 (design 77 item 4): a TaskGroup child frame OWNS closures. Each spawned
// `work` frame builds two closures (across suspensions), so the frame — boxed as
// `Box<any Resumable>` and driven by the group executor — carries opt-encoded
// closure fields. The closures capture the frame-resident `base` by value.
// EXPECT: success
// EXPECT-OUTPUT:
// 34
// 56

import std.task.*
func work(base: Int) -> Int {
    let f: () -> Int = { base * 10 }
    yield_now()
    let g: () -> Int = { base + 1 }
    yield_now()
    f() + g()
}

func main() {
    var group = TaskGroup()
    let h0 = group.spawn(work(3))
    let h1 = group.spawn(work(5))
    print(h0.join())     // 3*10 + 3+1 = 34
    print(h1.join())     // 5*10 + 5+1 = 56
}
