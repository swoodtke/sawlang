// L8 (brief 29/36): a generic function taking a `&Vector<T>` parameter — the
// exact shape the brief-29 free-function fold fallback needed. Instantiating
// `sumLen<Int>` must monomorphize the `&Vector<T>` parameter with the
// SUBSTITUTED arg (&Vector<Int>) rather than recursing in monomorphization.
// EXPECT: success
// EXPECT-OUTPUT:
// 3

// UNBOUNDED (design 219): the body only asks the vector its length, so it never
// duplicates a `T` and owes no copy bound. The `T: Copy` it used to carry proved
// nothing the body needed and refused `vlen<File>` for no reason.
func vlen<T>(v: &Vector<T>) -> Int {
    v.len()
}

func main() {
    var v = Vector<Int>()
    v.push(10)
    v.push(20)
    v.push(30)
    print(vlen<Int>(&v))
}
