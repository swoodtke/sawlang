// Design 174 (the T = U? sweep) — `Vector<T>` instantiated at an Optional.
//
// Instantiating a container at `Int?` puts an Optional through every piece of
// machinery that treats Optionals specially. The whole Vector surface is
// honest about the two layers: `get`/`pop` return `T?` at `T = Int?`, i.e. an
// `Int??` whose OUTER layer answers "was the index in range" and whose INNER
// layer is the stored value. One `if let` peels exactly the outer layer, so a
// present-but-None element and an out-of-range index stay distinguishable.
// EXPECT: success
// EXPECT-OUTPUT:
// len 3
// get0 1
// get1 -1
// get9 absent
// idx0 1
// idx1 -1
// after set idx1 7
// swap_out 1 now -1
// with_ref 3
// iter sum 110
// each -1
// each 7
// each 3
// map0 0
// fold 10
// pop 3
// len 2
// literal 3 1 -1 3
// repeat -1 -1 3
// -- done

func main() {
    var v = Vector<Int?>()
    let a: Int? = 1
    let b: Int? = None
    let c: Int? = 3
    v.push(a)
    v.push(b)
    v.push(c)
    print("len {v.len()}")

    // `get` is the conditional lend: the outer layer is presence of the SLOT.
    if let e = v.get(0) { print("get0 {e ?? -1}") } else { print("get0 absent") }
    if let e = v.get(1) { print("get1 {e ?? -1}") } else { print("get1 absent") }
    if let _ = v.get(9) { print("get9 present") } else { print("get9 absent") }

    // `v[i]` is a place; reading one out yields the element, an `Int?`.
    print("idx0 {v[0] ?? -1}")
    print("idx1 {v[1] ?? -1}")

    let d: Int? = 7
    v.set(1, d)
    print("after set idx1 {v[1] ?? -1}")

    let e2: Int? = None
    let out = v.swap_out(0, e2)
    print("swap_out {out ?? -1} now {v[0] ?? -1}")

    let r = v.with_ref(2, { x in x ?? -1 })
    print("with_ref {r}")

    var seen = 0
    for x in v.iter() {
        seen = seen + (x ?? 100)
    }
    print("iter sum {seen}")

    v.each({ x in print("each {x ?? -1}") })
    let doubled = v.map({ x in (x ?? 0) * 2 })
    print("map0 {doubled[0]}")
    print("fold {v.fold(0, { acc, x in acc + (x ?? 0) })}")

    if let p = v.pop() { print("pop {p ?? -1}") } else { print("pop empty") }
    print("len {v.len()}")

    // A literal may carry a bare `None` element: the expected element type
    // reaches the literal, so the `None` types as an `Int?`.
    let w: Vector<Int?> = [1, None, 3]
    print("literal {w.len()} {w[0] ?? -1} {w[1] ?? -1} {w[2] ?? -1}")

    // The repeat literal works at an Optional element type, bare `None` too.
    let none_arr: [Int?; 4] = [None; 4]
    let some_arr: [Int?; 3] = [c; 3]
    print("repeat {none_arr[0] ?? -1} {none_arr[3] ?? -1} {some_arr[1] ?? -1}")
    print("-- done")
}
