// A closure that borrows its enclosing frame may not be STORED, and handing it
// to a container through a `&var` parameter is a store.
//
// Design 216 unit 1's acceptance is "a closure passed straight to the call that
// RUNS it may borrow the frame" — `borrow_ok` reads that off the argument
// position. The position is not the whole answer: `out.push({ n * 2 })` is a
// call argument too, and `push` keeps what it is given. What separates the two
// is the PARAMETER TYPE, which the language already spells — a function type is
// non-escaping only at the top level of a parameter, and escaping everywhere
// else, `Vector`'s element slot included.
//
// The bit was simply missing at two positions (DF-216e). `_stamp_escaping_roles`
// walked OPTIONAL/TUPLE/ARRAY/STRUCT and not REFERENCE, so nothing under a
// `&var Vector<() sync -> Int>` parameter was ever stamped; and a constructor
// writes its generic arguments in an expression, which no declared-type walk
// reaches, so `Vector<() sync -> Int>()` bound an element type reading
// non-escaping. Both stamp now, and `stash`'s frame can no longer be captured
// into a Vector that outlives it. Companion:
// `escaping_closure_borrow_capture_local_container.saw` (the constructor half).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: escaping closure cannot capture

func stash(out: &var Vector<() sync -> Int>, n: &Int) {
    out.push({ n * 2 })
}

func build() -> Vector<() sync -> Int> {
    var fns = Vector<() sync -> Int>()
    var local = 21
    stash(&var fns, &local)
    move fns
}

func main() {
    let fns = build()
    let f = fns[0]
    print("f {f()}")
}
