// design 96 (DF6): a driven suspending fn whose loop exits via `break` inside a
// NON-spanning `if` (the break's own `if` holds no suspension) must resume
// correctly when the fn is RE-ENTERED at one call site in a caller's loop. Before
// the fix the `break` lowered in place and escaped the resume method's `while true`
// DISPATCH loop instead of the logical loop, so the second entry hung (the exact
// mechanism behind std net read()'s retained `going`-flag workaround). Both the
// top-level-if form and the else-branch-of-a-spanning-if form (read's shape) are
// covered.
// EXPECT: success
// EXPECT-OUTPUT:
// 4
// 6

// break in a top-level non-spanning `if` inside an infinite suspending loop.
func count_break(limit: Int) -> Int {
    var n = 0
    while {
        n = n + 1
        __saw_suspend()
        if n >= limit {
            break
        }
    }
    n
}

// break in the ELSE-IF of a SPANNING if (a suspension sibling) — read()'s shape:
// `if suspends {...} else if err {return} else {break}`.
func count_break_elseif(limit: Int) -> Int {
    var n = 0
    while {
        n = n + 1
        if n < limit {
            __saw_suspend()
        } else if n > 100 {
            return -1
        } else {
            break
        }
    }
    n
}

func driver() -> Int {
    var total = 0
    var i = 0
    while i < 2 {
        let r = count_break(2)          // re-entered call site
        total = total + r
        i = i + 1
    }
    total
}

func driver_elseif() -> Int {
    var total = 0
    var i = 0
    while i < 3 {
        let r = count_break_elseif(2)   // re-entered call site
        total = total + r
        i = i + 1
    }
    total
}

func main() {
    print(__saw_drive(driver()))          // 2 + 2 = 4
    print(__saw_drive(driver_elseif()))   // 2 + 2 + 2 = 6
}
