// The second form DF-175a named, and the half design 176 unit 13 did not close:
// a `&var self` METHOD CALL on `self` inside a plain `&self` method.
//
// Unit 13 scoped itself to the direct WRITE, so the whole-receiver mutation
// spelled as a method call still went through. Here the receiver arrives BY
// VALUE, so `bump()` counts in a copy that is discarded when `peek` returns and
// the caller sees nothing — the same vanishing write, through the door the
// assignment walk does not cover.
//
// The receiver must be `self` ITSELF for this rule. A `&var self` method on a
// FIELD (`self.n.fetch_add(1)`) is a different question with a real carve-out —
// design 149 receives a struct holding an `Atomic` by pointer even at `&self` —
// and stays filed as DF-176b.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot call `&var self` method `bump` on a `&self` receiver

struct Counter { hits: Int }

extension Counter {
    func bump(&var self) {
        self.hits = self.hits + 1
    }

    public func peek(&self) -> Int {
        self.bump()
        self.hits
    }
}

func main() {
    var c = Counter(hits: 0)
    print("{c.peek()}")
}
