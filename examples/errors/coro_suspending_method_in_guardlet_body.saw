// design 101 (DF7 class): a suspending METHOD call inside a `guard let ... else`
// body — a control-flow branch the coroutine state split does NOT CFG-split (it is
// lowered in place) — must be REJECTED cleanly, never silently compiled as a plain
// blocking call. Before design 101 the buried method call slipped past every
// rejection and lowered as a plain `TcpStream_read` call, a silent miscompile.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: buried suspending method call
// EXPECT-ERROR-CONTAINS: guard let
// EXPECT-ERROR-CONTAINS: coro_suspending_method_in_guardlet_body.saw:22:32

import std.net.{TcpStream}

func maybe(k: Int) -> Int? {
    if k <= 4 { k } else { None }
}

func worker(s_read: TcpStream, s_write: TcpStream) -> Int {
    var k = 0
    while k < 6 {
        k = k + 1
        guard let ok = maybe(k) else {
            let c = try! s_read.read()
            try! s_write.write(move c)
            break
        }
        k = k + ok - ok
    }
    k
}

func main() {
    let (a0, a1) = TcpStream.pair()
    var group = TaskGroup()
    let h = group.spawn(worker(move a0, move a1))
    print(h.join())
}
