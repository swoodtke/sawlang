// Design 141 decision 3 wants ONE body to serve both flavors, with the use site
// picking shared or exclusive. The compiler cannot honor that half yet: a
// `&self` receiver is passed as a copy, so storage lent out of such a body is
// storage of the copy. Rather than write through it and lose the write (which
// is what hand-written `&var self.field`-inside-`&self` still does — DF-146b),
// an exclusive window on a `&self` accessor is refused, and the error names the
// declaration that works.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: opens an EXCLUSIVE window

struct Cell {
    count: Int
}

struct Bag {
    cells: [Cell; 2]
}

extension Bag {
    public func [](&self, i: Int) borrows -> Cell {
        if i < 0 || i >= 2 {
            panic("Bag.[]: index out of range")
        }
        lend self.cells[i]
    }
}

func main() {
    var b = Bag(cells: [Cell(count: 1), Cell(count: 2)])
    print("{b[0].count}")
    b[0].count += 1
}
