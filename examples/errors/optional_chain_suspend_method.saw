// Design 111 (semantics 11): a SUSPENDING method inside an optional chain keeps
// the existing buried-suspension clean error (never a silent block). Bind the
// optional first and use `if let` + a statement call instead.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: buried suspending method call

struct S { n: Int }
extension S {
    func tick(&self) -> Int {
        yield_now()
        self.n
    }
}

func run(o: S?) -> Int? { return o?.tick() }

func main() {
    var g = TaskGroup()
    let h = g.spawn(run(S(n: 5)))
    print(h.join() ?? -1)
}
