// design 74 (A5-rest, shape 1): a BURIED suspending method call on a value inside
// a driven body (`let r = c.step()` where `Counter.step` suspends) is not yet
// supported — method sub-frame embedding (the Part-0b method twin) is the eventual
// lift. Rejected cleanly, anchored at the exact call site (design 74 A8), naming
// the workaround (drive the method directly, or wrap it in a nested free fn).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: buried suspending method call
// EXPECT-ERROR-CONTAINS: Counter.step
// EXPECT-ERROR-CONTAINS: coro_buried_suspending_method.saw:23:14

struct Counter { value: Int }
extension Counter {
    func step(&var self) -> Int {
        self.value = self.value + 1
        __suspend()
        self.value = self.value + 1
        self.value
    }
}

func outer(start: Int) -> Int {
    var c = Counter(value: start)
    let r = c.step()      // buried suspending method call
    r + 1000
}

func main() {
    print(__drive(outer(10)))
}
