// design 101 (DF7 class): a suspending METHOD call inside an `if let { ... }` body
// — a control-flow branch the coroutine state split does NOT CFG-split — must be
// REJECTED cleanly, never silently compiled as a plain blocking call. The
// suspending CONDITION of an `if let`/`guard let` IS supported (hoisted to a driven
// temp); only a suspending call in the BODY is inexpressible, and is now an honest
// error instead of the pre-design-101 silent block.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: buried suspending method call
// EXPECT-ERROR-CONTAINS: if let
// EXPECT-ERROR-CONTAINS: coro_suspending_method_in_iflet_body.saw:23:32

import std.net.{TcpStream}

func maybe(k: Int) -> Int? {
    if k <= 4 { k } else { None }
}

func worker(s_read: TcpStream, s_write: TcpStream) -> Int {
    var k = 0
    while k < 6 {
        k = k + 1
        if let ok = maybe(k) {
            let c = try! s_read.read()
            try! s_write.write(move c)
            k = k + ok - ok
        }
    }
    k
}

func main() {
    let (a0, a1) = TcpStream.pair()
    var group = TaskGroup()
    let h = group.spawn(worker(move a0, move a1))
    print(h.join())
}
