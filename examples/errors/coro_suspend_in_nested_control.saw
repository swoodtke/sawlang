// design 45: a suspension inside nested control flow (a loop/if/match body that
// spans the suspension) is NOT supported by the top-level state split -- it
// would silently become a no-op (not actually suspend). It is rejected as a
// compile error rather than miscompiled. Lifting it needs a CFG-based split (a
// later item; A5 effect-polymorphism is a separate blocker for generics).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: suspension inside nested control flow

func work() -> Int {
    var i = 0
    while i < 3 {
        __suspend()
        i = i + 1
    }
    i
}

func main() {
    print(__drive(work()))
}
