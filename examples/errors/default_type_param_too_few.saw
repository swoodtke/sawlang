// Too few type arguments with no default (design 37 item 1). `Pair<A, B>` has
// no default on `B`, so omitting it is an arity error naming the parameter.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: expected 2 type argument(s), got 1
// EXPECT-ERROR-CONTAINS: type parameter `B` has no default

struct Pair<A, B> {
    a: A
    b: B
}

func main() {
    let p = Pair<Int>(a: 1, b: 2)
    print(p.a)
}
