// Error: cannot call deinit manually
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot call `deinit` manually

struct Resource {
    value: Int
}

extension Resource: NoCopy {
    func deinit(&var self) {
        print("cleanup")
    }
}

func main() {
    var r = Resource(value: 42)
    r.deinit()  // Error: manual deinit not allowed
}
