// design 74 (A8): a coroutine-transform rejection anchors at the USER's source
// (file:line:col + snippet) via the shared error reporter — not a bare message
// pointing nowhere. Design 120 removed the old buried-in-an-operand rejection
// this test used to assert (that shape now compiles via the ANF hoist), so the
// anchoring is now exercised on suspending RECURSION — a shape the flat-frame
// model still cannot size, and so still rejects, anchored at the function.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: suspending recursion is not allowed
// EXPECT-ERROR-CONTAINS: coro_reject_anchored.saw:11:1

func slow(n: Int) -> Int {
    __saw_suspend()
    if n <= 0 {
        return 0
    }
    let r = slow(n - 1)   // suspending self-recursion: no compile-time frame size
    return r + 1
}

func main() {
    print(__saw_drive(slow(3)))
}
