// SL-333 R7 (conformance row K129, cell 3 of 3): an EXCLUSIVE-ONLY inner
// accessor makes the FORWARDING accessor exclusive-only too.
//
// R4's eligibility is closed over the forwarding graph before anything is
// lowered, and the reason is the ordinary receiver rule rather than a new one:
// the forwarded lend opens a window on `self.inner`, which is storage inside
// this accessor's own receiver, and that window borrows `self.inner`
// EXCLUSIVELY because the inner accessor's body mutates its own receiver. A
// mutation through the receiver is a mutation through the receiver, whichever
// construct spells it — so the outer accessor takes the whole of `self`
// exclusively at every use site, reads included, and is refused on a `let` root
// naming the forward.
//
// The propagation is through the RECORDED bit, never re-derived at the use site:
// that is what lets an IMPORTED or generic forwarding accessor carry the fact to
// its callers.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot read through the place window `[]` opens on immutable variable `frozen`
// EXPECT-ERROR-CONTAINS: the forwarded lend through `Inner.[]`

struct Inner { cells: [Int; 2], gates: Int }

extension Inner {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    // EXCLUSIVE-ONLY: the prologue mutates the receiver on BOTH
    // specializations, so nothing folds it away.
    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        self.run_gate()
        lend self.cells[i]
    }
}

struct Outer { inner: Inner }

extension Outer {
    public func [](&var self, i: Int) borrows -> &var Int {
        lend self.inner[i]
    }
}

func main() {
    let frozen = Outer(inner: Inner(cells: [3, 4], gates: 0))
    print("{frozen[0]}")
}
