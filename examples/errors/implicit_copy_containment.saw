// Error: struct contains ImplicitCopy field but doesn't implement ImplicitCopy
// EXPECT: error
// EXPECT-ERROR-CONTAINS: contains ImplicitCopy field

struct RefCounted {
    count: Int
}

extension RefCounted: ImplicitCopy {
    func copy(&self) -> RefCounted {
        RefCounted(count: self.count + 1)
    }
    func deinit(&var self) {
    }
}

// Container contains a ImplicitCopy field but doesn't implement ImplicitCopy itself
struct Container {
    data: RefCounted
}

func main() {
    let c = Container(data: RefCounted(count: 1))
    print(c.data.count)
}
