// Design 81: raw pointer arithmetic (not made visible by a pointer cast)
// requires the `unsafe` marker.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: raw pointer arithmetic requires the `unsafe` marker

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>?
}

func main() {
    if let p = unsafe malloc(8) {
        let q = p + 1
        print(unsafe q[0] as Int)
    }
}
