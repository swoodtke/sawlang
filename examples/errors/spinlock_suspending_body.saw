// design 149 unit (d): a critical section cannot suspend. The lock's body is a
// `sync` function type, so this is a compile error rather than a livelock — a
// suspended task keeps the lock while the executor runs somebody else, and that
// somebody may be the task spinning for it.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot suspend in a `sync` closure context
// EXPECT-ERROR-CONTAINS: yield_now

import std.spinlock
import std.task

static COUNT: SpinLock<Int>

func main() {
    COUNT.lock({ n in
        yield_now()
        n = n + 1
    })
    print("done")
}
