// DF-132a: `Vector.get` handed a move-only element out BY VALUE.
//
// Its signature was bare — `func get(&self, index: Int) -> T?`, no `T: Copy`
// bound — and its body read the element through the raw buffer with no retain.
// For a Copy element the surrounding machinery balanced that; for a
// NoCopy one there is no `copy()` to call, so the caller received an ALIAS it
// then owned and dropped while the vector still held the same element. Two
// lookups, two frees of one buffer, in safe code, with no `unsafe` anywhere.
//
// `get` is a PLACE now, so the read is judged by the element's copy tier at
// the point it stops being storage — and a move-only element is refused there,
// naming the spellings that do work.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: which is move-only — reading it out as a value would alias storage the container still owns

struct Item { name: String, payload: Vector<Int> }

extension Item: NoCopy {
    func deinit(&var self) { print("Item.deinit {self.name}") }
}

extension Item {
    init(n: String) -> Item {
        var v = Vector<Int>()
        try! v.push(41)
        Item(name: n, payload: move v)
    }
}

struct Box2 { items: Vector<Item> }

extension Box2: NoCopy {}

extension Box2 {
    init() -> Box2 {
        let v = Vector<Item>()
        Box2(items: move v)
    }

    func find(&self, want: String) -> Item? {
        var i = 0
        while i < self.items.len() {
            if let e = self.items.get(i) {
                if e.name.equals(want) { return e }
            }
            i = i + 1
        }
        None
    }
}

func main() {
    var b = Box2()
    try! b.items.push(Item(n: "one"))
    if let first = b.find("one") { print(first.payload.len()) }
    if let second = b.find("one") { print(second.payload.len()) }
}
