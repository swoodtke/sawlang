// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot `Thread.spawn`: the closure's result type `Raw` is not `Send`
// EXPECT-ERROR-CONTAINS: cannot travel back from the spawned thread to `join()`
//
// A spawned task's RESULT crosses a thread boundary — the task computes it on
// its own thread and `join()` hands it back — so it owes the same `Send` the
// captures owe. Only the captures were audited (design 193 unit 6).
//
// `Task<T: Send>: UnsafeSend` was doing the only guarding here, and it guards
// the wrong crossing: it makes the HANDLE non-Send for a non-Send `T`, which
// stops the handle from crossing a SECOND boundary and says nothing about the
// one every task makes. `Raw` holds an `UnsafePointer`, which poisons Send
// structurally; before this, the pointer travelled between threads silently.

struct Raw {
    p: UnsafePointer<Int>
}

func make_raw(n: &var Int) unsafe -> Raw {
    Raw(p: (&n) as UnsafePointer<Int>)
}

func main() {
    var n = 7
    var t = Thread.spawn { [n] in make_raw(&var n) }
    let r = t.join()
    print("unreachable")
}
