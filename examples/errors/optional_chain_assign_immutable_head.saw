// Design 111: a chained assignment's head must be a mutable place (a `var` or a
// `&var`-reachable path). Writing through a `let` binding is rejected.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot assign through optional chain: `p` is not mutable

struct Point { x: Int, y: Int }

func main() {
    let p: Point? = Point(x: 1, y: 2)
    p?.x = 9
    print(p!.x)
}
