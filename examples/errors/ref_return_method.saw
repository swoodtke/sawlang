// EXPECT: error
// EXPECT-ERROR-CONTAINS: Parse error at 14:25: method `peek` may not return a reference
// EXPECT-ERROR-CONTAINS: declare a `borrows` accessor (`... borrows -> Int`
//
// An extension method is the position where returning a reference reads most
// plausible -- "hand the caller my field" is a real thing to want. It is also
// the position Saw already answers, so the fixit is not a consolation prize:
// `borrows -> Int` with `lend` gives out the storage itself for a window,
// which is strictly more than a pointer could and stays sound (design 141).

struct Counter { n: Int }

extension Counter {
    func peek(&self) -> &Int { &self.n }
}

func main() {
    let c = Counter(n: 3)
    print("{c.peek()}")
}
