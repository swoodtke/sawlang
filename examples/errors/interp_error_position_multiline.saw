// Design 268: in a MULTI-LINE interpolated string an interpolation reports its
// own physical line AND its own source column. The line was already exact; the
// column came from counting characters of the decoded value since the last
// newline in it, so an escape earlier on that line moved it left (and a
// decoded `\n` could be mistaken for a real one — see the sibling test
// interp_error_position_after_escape.saw).
//
// `\t` costs two source columns on the second line: the `{` is at column 6 and
// the expression at 7, where the old arithmetic said 6.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot interpolate value of type `Blob`
// EXPECT-ERROR-CONTAINS: interp_error_position_multiline.saw:18:7
struct Blob { n: Int }

func main() {
    let b = Blob(n: 1)
    print("head
a\tb {b} tail")
}
