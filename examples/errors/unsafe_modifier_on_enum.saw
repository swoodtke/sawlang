// Design 130: only a `struct`, a `func` and an extension `init` carry the
// `unsafe` modifier. Every other declaration inherits its unsafety from the
// types it names, so marking one is a clean error rather than a silent no-op.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: `unsafe` may only precede `struct`, `func` or `init`

unsafe enum Mode { case Read, case Write }

func main() {
    print("hi")
}
