// Error: ImplicitCopy and ExplicitCopy are mutually exclusive on one type.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot implement both ImplicitCopy and ExplicitCopy

struct Buf {
    value: Int
}

extension Buf: ImplicitCopy, ExplicitCopy {
    func copy(&self) -> Buf {
        Buf(value: self.value)
    }
    func deinit(&var self) {
    }
}

func main() {
    let a = Buf(value: 1)
    print(a.value)
}
