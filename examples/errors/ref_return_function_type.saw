// EXPECT: error
// EXPECT-ERROR-CONTAINS: Parse error at 12:29: a function TYPE may not return a reference
// EXPECT-ERROR-CONTAINS: references in Saw are PARAMETERS ONLY
//
// The function-TYPE grammar takes the rule too, or the declaration form would
// just be a speed bump: a `(Int) sync -> &Int` parameter is how a closure that
// returns a reference would get written down and passed around. Note what stays
// legal -- a reference in a function type's PARAMETER list is the ordinary lend
// (`(&T) sync -> R` is `Vector.with_ref`'s callback); only the return is
// refused.

func apply(g: (Int) sync -> &Int, v: Int) -> Int {
    g(v)
}

func main() {
    print("{apply({ $0 }, 3)}")
}
