// Design 81: writing through a raw pointer requires the `unsafe` marker (the
// marker lifts off the lvalue onto the whole store).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: writing through a raw pointer requires the `unsafe` marker

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>?
}

func main() {
    if let p = unsafe malloc(4) {
        p[0] = 65
    }
}
