// The spec says a conformer of an `unsafe` trait requirement must declare
// the effect ("a conformer ... needs to make the promise"), but the check
// does not exist: a safe-declared body satisfies an unsafe-declared
// requirement silently. Harmless direction-wise (the impl promises MORE
// than required), but the documented rule should hold — the conformance
// below is the rejection site design 188 unit 6 gave it.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: must declare `unsafe` to conform to trait `Raw`
// EXPECT-ERROR-CONTAINS: post-parameter slot

trait Raw {
    func peek(&self) unsafe -> Int
}

struct Plain {
    n: Int
}

extension Plain: Raw {
    func peek(&self) -> Int { self.n }
}

func main() {
    let p = Plain(n: 3)
    print("{p.peek()}")
}
