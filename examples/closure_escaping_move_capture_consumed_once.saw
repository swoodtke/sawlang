// An ESCAPING closure may not consume what it captured: a `move` of its
// `[move h]` capture in the body is a compile error.
//
// The environment of an escaping closure owns its captures, every copy of the
// closure shares it, and it outlives each call. A body that hands `h` on would
// take the value out of storage the next call, every other copy and the
// environment's own teardown still see, so the user's ruling makes it a
// refusal rather than a runtime once-flag (SL-469). The non-escaping half is
// legal: a `[move h]` into a closure passed straight to a non-escaping
// parameter transfers when the body runs (V48).
//
// The pin stays XFAIL because the frozen Stage 0 compiler accepts the program
// and double-frees `h`; the checker that refuses it is sawc2's
// (`capture.escaping-consume`).
// XFAIL: DF-255a an escaping closure's env destructor releases a capture the
// body already moved out
// EXPECT: error
// EXPECT-ERROR-CONTAINS: out of an escaping closure's environment

struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.id}") }
}

func sink(r: Res) { print("sank {r.id}") }

func main() {
    let h = Res(id: 1)
    let f = { [move h] in sink(r: move h) }
    print("built")
    f()
    print("done")
}
