// Design 123: `TaskGroup(threads: N)` for N >= 2 allocates a run-queue mutex,
// and used to leave the field None when the allocator refused. That group was
// inert in the worst way available: `__run_all` guards on the lock and does
// NOTHING, so not one spawned task ran, `Deinit` dropped every frame unrun, and
// `Task.join` then force-unwrapped a result nobody had written — while
// the group reported `workers >= 2` the whole time.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: TaskGroup(threads:): allocation failed

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
}

func work(n: Int) -> Int {
    n * 2
}

func main() {
    var single = TaskGroup()
    let a = single.spawn(work(3))
    print(a.join())                     // 6 — the single-threaded engine

    // The run-queue mutex is the first allocation this constructor makes.
    __saw_rt_alloc_deny_after(0)
    var pool = TaskGroup(threads: 2)
    let b = pool.spawn(work(4))
    print(b.join())
}
