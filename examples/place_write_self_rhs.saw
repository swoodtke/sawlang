// A place WRITE whose RHS names `self`. Place lowering hoists the RHS into the
// window's closure, so this is DF-216a's ICE reached through a
// COMPILER-SYNTHESIZED closure rather than a written one: the capture analyzer
// had no `SelfExpr` case, `self` never entered the closure's captures, and
// codegen reported `'self' not found in current scope` with no source anchor.
// Design 216 gave the analyzer that case, which fixed both entry points at once
// (DF-169f and DF-216a were one mechanism).
//
// Both writes land, and the reads see them.
// EXPECT: success
// EXPECT-OUTPUT:
// field 5
// call 11

struct Counter {
    marks: Vector<Int>
    tick: Int
}

extension Counter: NoCopy {}

extension Counter {
    init() -> Counter {
        var marks = Vector<Int>()
        marks.push(0)
        Counter(marks: move marks, tick: 5)
    }

    func width(&self) -> Int { 11 }

    // The RHS is a field read off `self`.
    func from_field(&var self) {
        self.marks[0] = self.tick
    }

    // The RHS is a method call on `self`.
    func from_call(&var self) {
        self.marks[0] = self.width()
    }

    func first(&self) -> Int { self.marks[0] }
}

func main() {
    var c = Counter()
    c.from_field()
    print("field {}", c.first())
    c.from_call()
    print("call {}", c.first())
}
