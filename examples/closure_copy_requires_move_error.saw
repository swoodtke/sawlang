// An escaping closure may own a heap environment (its captures), so it is
// move-only (design 71): a bitwise copy would alias that env and double-free at
// drop. Aliasing an existing closure binding without `move` is rejected.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: which implements NoCopy

struct Res { v: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.v}") }
}

func main() {
    let r = Res(v: 7)
    let f = { [move r] in r.v }
    let g = f          // closure is move-only: must be `move f`
    print("{g()} {f()}")
}
