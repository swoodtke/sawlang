// C-family bitwise precedence, with the parse spelled out (design 50):
//   `&` binds tighter than `^` binds tighter than `|`;
//   shifts bind tighter than comparison but looser than `+ -`.
// EXPECT: success
// EXPECT-OUTPUT:
// 5
// 5
// 8
// 8
// 7
// 7
// 1
// 1

func main() {
    // a | b & c  ==  a | (b & c)
    print(1 | 6 & 4)          // 1 | (6 & 4) = 1 | 4 = 5
    print(1 | (6 & 4))        // 5

    // x << 2 + 1  ==  x << (2 + 1)   ('+' binds tighter than '<<')
    print(1 << 2 + 1)         // 1 << 3 = 8
    print(1 << (2 + 1))       // 8

    // ^ sits between & and | :  a ^ b & c == a ^ (b & c)
    print(3 ^ 6 & 5)          // 3 ^ (6 & 5) = 3 ^ 4 = 7
    print(3 ^ (6 & 5))        // 7

    // shift tighter than comparison:  1 < 2 >> 0  ==  1 < (2 >> 0)
    let r = if 1 < 2 >> 0 { 1 } else { 0 }
    print(r)                  // 1  (2>>0 = 2, 1 < 2 true)
    let r2 = if 1 < (2 >> 0) { 1 } else { 0 }
    print(r2)                 // 1
}
