// A spawn body that yields Void (design 77 item 1). The task control block used
// to carry a `{i8*, i8*, T result}` slot typed `void` for a Void body, which is
// illegal LLVM IR (an ICE). The result slot is now a 1-byte placeholder for a
// Void body: nothing is stored or read, and Task<Void>.join yields Void. Both
// the explicit-join and the drop-joins-it (deinit) paths are exercised.
// EXPECT: success
// EXPECT-OUTPUT: 15

static COUNTER: Atomic<Int> = Atomic(0)

func bump(times: Int) {
    var i = 0
    while i < times {
        COUNTER.fetch_add(1)
        i = i + 1
    }
}

func drop_path() {
    // Task dropped unjoined: its Deinit joins it before the block frees.
    var t = spawn { bump(5) }
}

func main() {
    var t0 = spawn { bump(4) }
    var t1 = spawn { bump(6) }
    t0.join()   // Task<Void>.join yields Void
    t1.join()
    drop_path()
    print(COUNTER.load())   // 4 + 6 + 5 = 15
}
