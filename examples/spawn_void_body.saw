// A spawn body that yields Void (design 77 item 1). The task control block used
// to carry a `{i8*, i8*, T result}` slot typed `void` for a Void body, which is
// illegal LLVM IR (an ICE). The result slot is now a 1-byte placeholder for a
// Void body: nothing is stored or read, and VoidThread.join yields Void.
// (Design 242 retired the third path this used to exercise — a handle dropped
// unjoined joined its thread; every fate is written now.)
// EXPECT: success
// EXPECT-OUTPUT: 15

static COUNTER: Atomic<Int> = Atomic(0)

func bump(times: Int) {
    var i = 0
    while i < times {
        COUNTER.fetch_add(1)
        i = i + 1
    }
}

func joined_in_a_callee() {
    var t = Thread.spawn { bump(5) }
    t.join()
}

func main() {
    var t0 = Thread.spawn { bump(4) }
    var t1 = Thread.spawn { bump(6) }
    t0.join()   // VoidThread.join yields Void
    t1.join()
    joined_in_a_callee()
    print(COUNTER.load())   // 4 + 6 + 5 = 15
}
