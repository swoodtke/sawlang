// A bare literal in a `Result` slot adopts the payload's fixed width, by peeling
// to the UNIQUE payload that could adopt it (DF-226e, ruled Aug 17).
//
// The sibling of DF-226d, which needed a ruling the optional case did not.
// `_apply_literal_expected_type` peels an OPTIONAL expectation to its payload
// with nothing to decide — an optional has exactly one. A `Result` has TWO, so
// case (0d) must first say which:
//
//   `Result<Int32, Bad>`    + `return 4`  -> Ok(4), the only reading
//   `Result<String, Int32>` + `return 7`  -> Err(7), the only reading
//   `Result<Int32, Int8>`   + `return 4`  -> AMBIGUOUS, refused by name
//                                            (see result_slot_literal_ambiguous_payloads.saw)
//
// Peeling to the one payload that CAN take the literal also selects the only
// variant it could have meant, because the auto-wrap that follows picks Ok/Err
// by testing the value's type against each payload. Where both could, nothing
// is peeled and `_result_autowrap_ambiguous` — which already owned design 30's
// `T == E` refusal — demands the explicit constructor, inside which the literal
// has exactly one slot and adopts normally.
//
// All of these were `ResultOkWrap`/`ResultErrWrap` codegen ICEs
// (`Can only insert i32 at [0] in {i32}: got i64`); the workaround was the
// suffix, `return 4i32`.
//
// CLOSURE BODIES: the `return` form is covered here and behaves exactly as a
// named body does. A closure's TAIL expression is NOT — not because of literal
// width, but because the closure return path has an optional auto-wrap and no
// Result one at all, so `{ x in k }` for a plain `Int32` k fails the same way a
// literal does. That is a separate pre-existing gap, filed as DF-232h.
//
// EXPECT: success
// EXPECT-OUTPUT:
// ok return = 4
// ok tail = 5
// err return = 7
// neg = -8
// opt ok = 9
// plain = 10
// method tail = 11
// closure return = 13
// generic = 20

struct Bad { code: Int }
extension Bad: Printable {
    func format(&self, into: &var StringBuilder) { try! into.append("bad") }
}
extension Bad: Error {}

// the unique payload is the Ok side, via `return`
func ok_return() -> Result<Int32, Bad> { return 4 }

// the unique payload is the Ok side, via the TAIL
func ok_tail() -> Result<Int32, Bad> { 5 }

// the unique payload is the ERR side — the peel selects Err, not Ok
func err_return() -> Result<String, Int32> { return 7 }

// a negative literal reaches the payload through the unary-minus arm
func neg_return() -> Result<Int8, Bad> { return -8 }

// an OPTIONAL Ok payload: case (0d) peels the Result, case (0c) the Optional
func opt_ok() -> Result<Int32?, Bad> { return 9 }

// a platform `Int` payload is unchanged — the literal stays platform width
func plain_ok() -> Result<Int, Bad> { return 10 }

struct Holder { v: UInt16 }
extension Holder {
    func fetch(&self) -> Result<UInt16, Bad> { 11 }
}

func run(f: (Int) sync -> Result<Int32, Bad>) -> Int32 {
    match f(0) {
        case Ok(v) -> v,
        case Err(_) -> -1i32
    }
}

// an ABSTRACT generic body peels nothing (T and E are opaque), so this
// monomorphizes exactly as it did before
func generic_ok<T>(v: T) -> Result<T, Bad> { return v }

func show(r: Result<Int32, Bad>) -> Int32 {
    match r {
        case Ok(v) -> v,
        case Err(_) -> -1i32
    }
}

func main() {
    print("ok return = {show(r: ok_return())}")
    print("ok tail = {show(r: ok_tail())}")

    match err_return() {
        case Ok(s) -> print("err return = ok {s}"),
        case Err(e) -> print("err return = {e}")
    }
    match neg_return() {
        case Ok(v) -> print("neg = {v}"),
        case Err(_) -> print("neg = err")
    }
    match opt_ok() {
        case Ok(v) -> print("opt ok = {v!}"),
        case Err(_) -> print("opt ok = err")
    }
    match plain_ok() {
        case Ok(v) -> print("plain = {v}"),
        case Err(_) -> print("plain = err")
    }

    let h = Holder(v: 0u16)
    match h.fetch() {
        case Ok(v) -> print("method tail = {v}"),
        case Err(_) -> print("method tail = err")
    }

    // a closure body's `return` behaves exactly as a named body's
    print("closure return = {run(f: { x in return 13 })}")

    match generic_ok(v: 20i32) {
        case Ok(v) -> print("generic = {v}"),
        case Err(_) -> print("generic = err")
    }
}
