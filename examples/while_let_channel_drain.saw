// Design 233 unit 2, the drain family's concurrency member, re-authored for
// design 234 §4: `Channel.try_receive` is the non-blocking half of the channel
// and now answers `Result<T?, ChannelError>`, so the natural "take everything
// that is there right now" loop is a `while let` over a `try`. The `try` peels
// the error channel and the `while let` peels the optional, which is what makes
// the two compose:
//
//     while let v = try ch.try_receive() { ... }
//
// It ends on `Ok(None)` (nothing queued right now) and PROPAGATES on
// `Err(Closed)` — a distinction the pre-234 `T?` shape could not make, where a
// closed channel and an empty one were the same answer.
//
// The consumer here is a SPAWNED task, which is what made this the first
// consumer of DF-245d: a propagating `try` in a container HEAD inside a
// suspending body used to be refused, so the file spelled `try!` and cited the
// finding. It reads the way design 234 §4 intends now — the consumer answers
// `Result<Int, ChannelError>` and a close would leave through its error
// channel. The channel is never closed here, so the loop is bounded by the
// message count and the propagation is the honest spelling of a case that
// cannot arise.
//
// The inner drain does not itself suspend, so it stays an ordinary loop nested
// inside the spanning one — its `break` targets itself, never the outer loop.
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 6

import std.task.*
import std.channel.{Channel, ChannelError}

func producer(ch: Channel<Int>) -> Int {
    var i = 0
    while i < 3 {
        try! ch.send(i + 1)   // 1, 2, 3
        yield_now()
        i = i + 1
    }
    return i
}

func consumer(ch: Channel<Int>) -> Result<Int, ChannelError> {
    var sum = 0
    var got = 0
    while got < 3 {
        var drained = 0
        while let v = try ch.try_receive() {
            sum = sum + v
            got = got + 1
            drained = drained + 1
        }
        if drained == 0 {
            yield_now()   // nothing queued: suspend and retry when rescheduled
        }
    }
    return sum
}

func main() {
    var group = TaskGroup()
    let ch = try! Channel<Int>()
    let hp = group.spawn(producer(ch.copy()))
    let hc = group.spawn(consumer(ch.copy()))
    print(hp.join())          // 3
    print(try! hc.join())     // 1 + 2 + 3
}
