// Box of a Deinit payload (design 42 item 1): the payload's `deinit` runs
// EXACTLY once, when the Box dies. Box is NoCopy — there is no silent duplicate
// to double-free — and its deinit releases the single live payload in place
// (`__saw_deinit_in_place`) before freeing the chunk. The deinit-printing payload is
// the double-free / leak oracle: exactly one "gone 5".
// EXPECT: success
// EXPECT-OUTPUT:
// made
// 5
// gone 5

struct Res { id: Int }

extension Res {
    func peek(&self) -> Int { self.id }
}

extension Res: NoCopy {
    func deinit(&var self) {
        print("gone {self.id}")
    }
}

func main() {
    let b = try! Box<Res>.make(Res(id: 5))
    print("made")
    print(b.peek())   // 5  — forwarded read of the live payload
    // b dies here -> "gone 5" prints exactly once.
}
