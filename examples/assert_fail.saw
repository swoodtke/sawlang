// EXPECT: panic
// EXPECT-PANIC-CONTAINS: assertion failed: x must equal 42

// A false `assert` panics with "panic at FILE:LINE: assertion failed: {message}"
// (design 69 unified panic-location format).
func main() {
    let x = 41
    print("checking")
    assert(x == 42, "x must equal 42")
    print("passed")  // unreachable
}
