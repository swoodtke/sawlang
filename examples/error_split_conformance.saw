// design 56 (N3): the split Error conformance spelling — `extension E: Printable
// {...}` supplies format, then an empty `extension E: Error {}` adds the Error
// refinement. Both halves compose; the erased box formats via the vtable.
// EXPECT: success
// EXPECT-OUTPUT:
// db#5

struct DbErr { code: Int }

extension DbErr: Printable {
    func format(&self, into: &var StringBuilder) {
        into.append("db#")
        into.append(self.code)
    }
}

extension DbErr: Error {}

func main() {
    let e = DbErr(code: 5)
    let b = Box<any Error>.make(e)
    print("{b}")   // db#5
}
