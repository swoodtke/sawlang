// UnsafeMemory projection (design 46): member access chains through NESTED
// structs and index projection walks fixed-array fields, each yielding a new
// UnsafeMemory<Field, Use> at base + compile-time offset without ever loading
// the aggregate. Verified observably: writes through a projected view land at
// the byte the natural-ABI layout predicts, read back through direct array
// access over the same backing store.
// EXPECT: success
// EXPECT-OUTPUT:
// 5
// 5
// 6
// 6
// 7
// 7

struct Inner {
    a: UInt32,      // +0 within Inner
    b: UInt32,      // +4 within Inner
}

struct Block {
    head:  UInt32,      // offset 0
    inner: Inner,       // offset 4  (a@+4, b@+8)
    tail:  [UInt32; 2], // offset 12 (tail[0]@12, tail[1]@16)
}

static BACKING: [UInt8; 24]

unsafe func main() {
    let base = ((&BACKING) as UnsafePointer<Int8>) as Int
    let blk = UnsafeMemory<Block, Normal>(base)
    // A UInt32-element view over the same store: element i == byte offset 4*i.
    let words = UnsafeMemory<[UInt32; 6], Normal>(base)

    blk.inner.a.write(5)     // nested field, byte offset 4  == word 1
    print(words[1].read())   // 5
    print(BACKING[4] as Int) // 5 (little-endian low byte)

    blk.inner.b.write(6)     // nested field, byte offset 8  == word 2
    print(words[2].read())   // 6
    print(BACKING[8] as Int) // 6

    blk.tail[1].write(7)     // array field element, byte offset 16 == word 4
    print(words[4].read())   // 7
    print(BACKING[16] as Int)// 7
}
