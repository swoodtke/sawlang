// XFAIL: DF-217f a suspending call inside a constructor that IS a match
// scrutinee reaches codegen unhoisted and ICEs (`Undefined function: mk_s`)
//
// Sweep S2 rows a7/a8 and the corodiff lane's first new finding. The coro
// transform's child-position funnel (`_uncond_children`) is entered from a
// hand-enumerated set of statement classes, and a `match` scrutinee is not one
// of them — so the suspending call in the scrutinee's constructor argument is
// never lifted into a frame temp and codegen meets a call to a function the
// transform has already split into resume bodies. Both constructor spellings
// reach it: an enum case's labeled payload and a struct init.
//
// The sync twin of each shape compiles and runs, and hoisting the call by hand
// (`let x = mk_s(1)` then `match Ev.Has(x: x) { ... }`) works — which is what
// makes this a missing funnel entry rather than an unsupported position. Fixed
// alongside the other statement-HEAD gaps (if/while conditions, `&&`/`||` LHS,
// for-range bounds), which share the entry list.
// EXPECT: success
// EXPECT-OUTPUT:
// val 1
// holder 2
// done

import std.task.{yield_now}

enum Ev { case Has(x: Int) }

struct Holder { n: Int }

func mk_s(id: Int) -> Int {
    yield_now()
    id
}

func enum_ctor_scrutinee() {
    match Ev.Has(x: mk_s(1)) {
        case Has(x) -> print("val {x}")
    }
}

func struct_init_scrutinee() {
    match Holder(n: mk_s(2)) {
        case _ -> print("holder 2")
    }
}

func main() {
    enum_ctor_scrutinee()
    struct_init_scrutinee()
    print("done")
}
