// A closure body's TAIL is a transfer site, exactly as its `return` is.
//
// DF-304a. `_check_closure` reconciled the tail's TYPE and called the
// value-transfer checkpoint only for the closure's CAPTURES, so a tail that
// forwarded an owned move-only binding was unchecked while `return r` one
// keyword away routed through `_check_return_statement` and WAS refused. That
// asymmetry is the finding; the fix routes the tail through the same checkpoint,
// before the Result/Optional auto-wraps, so the AUTHOR's expression is what is
// judged and the `move` goes where it is written.
//
// The tail is the same transfer the `return` performs, so it is refused in the
// same words. What the silence cost is counted in V82-V86: at a source the
// closure does not OWN — a `&var` parameter, a borrow capture, a field of an
// owned binding — the tail handed out an alias of storage somebody else
// released, and both halves ran `deinit`.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: without `move` in closure

struct Res { w: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("drop {}", self.w) }
}

func run(body: (Res) sync -> Res) -> Int {
    let made = Res(w: 7)
    let got = body(move made)
    got.w
}

func main() {
    print("n {}", run({ r in r }))
}
