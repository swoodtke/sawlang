// Design 123 / RS-1, the finding that started the brief. `Vector.push` called
// `grow()`, which returned silently when the allocator refused, and then wrote
// the element at `buf[length]` where `length == capacity` — one element PAST
// the buffer — and bumped `length` past `capacity`. Every later `get`,
// iteration and the final `deinit` read and freed out of bounds. Proven on main
// with a 2-element `Vector<Int, FailAlloc>`: `len after failed-grow push = 3`
// and `get(2)` read back the value stored off the end, exit 0, no diagnostic.
//
// Conformance row A03. Design 123 made `push` PANIC, which closed the overflow;
// design 234 hands the same refusal to the caller as a value, and the guarantee
// is unchanged — the length does not move and nothing lands past the buffer.
// The error carries the size of the request that was refused, which the panic's
// fixed text never could.
// EXPECT: success
// EXPECT-OUTPUT:
// 4
// refused: allocation of 64 bytes (align 8) failed
// 4
// 3

// Denies every allocation after the first `budget` of them, so the vector gets
// a real buffer and then loses the grow.
static BUDGET: Atomic<Int> = Atomic(1)

struct FailAlloc {}
extension FailAlloc: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        let left = BUDGET.load()
        if left <= 0 {
            return None
        }
        BUDGET.store(left - 1)
        GlobalAllocator().alloc(size, align)
    }
    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func main() {
    var v = Vector<Int, FailAlloc>()
    var i = 0
    // The first push allocates capacity 4; pushes 2-4 fit; push 5 must grow and
    // the allocator is out of budget by then.
    while i < 4 {
        try! v.push(i)
        i = i + 1
    }
    print(v.len())      // 4 — everything so far is real
    let refused = v.push(99)     // grow denied: reported, never an out-of-bounds write
    match refused {
        case Ok(_) -> print("unexpected: the push was accepted"),
        case Err(e) -> print("refused: {e}")
    }
    print(v.len())      // 4 — the length did not move
    print(v.get(3)!)    // 3 — and the element before the refusal is intact
}
