// design 85 hazard: an owning value (Arc<Res>) live across BOTH parks of a
// read-then-write worker must be dropped EXACTLY ONCE. The worker holds the moved-in
// Arc across read (park 1) and write (park 2), then reports its strong count; the
// frame owns one reference and releases it once at frame teardown. A drop-flag bug
// across the multi-park sequence would either double-drop (Res deinits twice / count
// off) or leak (never deinits). The single "deinit 7" plus strong_count == 2 is the
// exactly-once proof. Deterministic; socketpair only.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 1
// deinit 7
// 999

import std.net.{TcpStream}
struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.id}") }
}

func read_n(stream: &TcpStream) -> Int {
    let chunk = try! stream.read()
    chunk.len()
}

func write_hi(stream: &TcpStream) -> Int {
    try! stream.write("hi")
    2
}

// `a` (an Arc<Res>) is live across read (park 1) AND write (park 2).
func worker(stream: TcpStream, a: Arc<Res>) -> Int {
    let _ = read_n(&stream)            // park 1
    let _ = write_hi(&stream)          // park 2
    a.strong_count()                   // 2 = the frame's ref + the caller's k1
}

func client(stream: TcpStream) -> Int {
    let _ = write_hi(&stream)          // send "hi" so the worker's read completes
    let n = read_n(&stream)            // read the worker's echo
    if n == 2 { 1 } else { 0 }
}

func run() {
    let (s0, s1) = try! TcpStream.pair()
    let a = try! Arc<Res>(value: Res(id: 7))    // strong = 1
    let k1 = a.copy()                       // strong = 2
    var group = TaskGroup()
    let hs = group.spawn(worker(move s0, move a))   // frame owns a's ref
    let hc = group.spawn(client(move s1))
    print(hs.join())      // 2 = strong count with the frame still holding its ref
    print(hc.join())      // 1 = round-trip content ok
}   // the worker frame's Arc ref dropped at its completion (2 -> 1); then k1
    // drops (1 -> 0) -> Res deinits EXACTLY ONCE

func main() {
    run()
    print(999)
}
