// The other side of examples/exclusivity_assign_rhs_borrow.saw: what the
// assignment-RHS rule (design 193 unit 4) must NOT refuse. Each line below
// writes a path and evaluates a right-hand side that touches the same ROOT,
// and each one is well defined.
//
// EXPECT: success
// EXPECT-OUTPUT:
// disjoint 9 3
// accumulate 10
// unrelated 5
// self-read 4

struct Point {
    x: Int,
    y: Int
}

// A DISJOINT path: the borrow reaches `p.y`, the write lands on `p.x`.
func shift(y: &var Int) -> Int {
    y = y + 1
    9
}

func main() {
    var p = Point(x: 1, y: 2)
    p.x = shift(&var p.y)
    print("disjoint {p.x} {p.y}")

    // The ACCUMULATOR idiom: the RHS `move`s the target and the assignment
    // revives it (design 15 rule 3). Ownership changes hands; nothing aliases.
    var acc: Vector<Int> = [1, 2, 3]
    acc = grow(move acc)
    print("accumulate {acc[3]}")

    // A borrow of an unrelated root.
    var other = Point(x: 5, y: 0)
    p.y = shift2(&var other)
    print("unrelated {p.y}")

    // A plain READ of the written root — by value, so it is a snapshot taken
    // before the write, not a borrow held across it.
    p.x = p.y - 1
    print("self-read {p.x}")
}

func grow(v: Vector<Int>) -> Vector<Int> {
    var out = move v
    try! out.push(10)
    move out
}

func shift2(q: &var Point) -> Int {
    q.x
}
