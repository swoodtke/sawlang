// design 90: the N=3 companion to net_serve_two_connections — a server task
// accept-loops to serve THREE sequential connections with three clients in one
// TaskGroup. Exercises an arbitrary sequence of io-parks across multiple accepted
// fds (each connection closed before the next is accepted, so fd numbers are
// reused across turnover) all getting their wakeups. Deterministic on content,
// time-bounded (the runner timeout catches a wedge as a failure, not a hang).
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 1
// 1
// 1

import std.data.{Data}
import std.net.{TcpListener, TcpStream}
func serve(listener: TcpListener, n: Int) -> Int {
    var served = 0
    while served < n {
        let stream = try! listener.accept()
        var req = Data()
        var reading = true
        while reading {
            let chunk = try! stream.read()
            if chunk.len() == 0 {
                reading = false
            } else {
                req.append(move chunk)
                if (try! req.to_string()).contains("\r\n\r\n") {
                    reading = false
                }
            }
        }
        assert((try! req.to_string()).starts_with("GET / HTTP/1.1"), "bad request")
        try! stream.write("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
        served = served + 1
    }
    return served
}

func client(port: Int) -> Int {
    let stream = try! TcpStream.connect("127.0.0.1", port)
    try! stream.write("GET / HTTP/1.1\r\n\r\n")
    var resp = Data()
    var reading = true
    while reading {
        let chunk = try! stream.read()
        if chunk.len() == 0 {
            reading = false
        } else {
            resp.append(move chunk)
            if (try! resp.to_string()).contains("hello") {
                reading = false
            }
        }
    }
    let s = try! resp.to_string()
    if s.starts_with("HTTP/1.1 200 OK") && s.contains("hello") { 1 } else { 0 }
}

func main() {
    let listener = try! TcpListener.listen(0)
    let port = listener.local_port()
    var group = TaskGroup()
    let hs = group.spawn(serve(move listener, 3))
    let c0 = group.spawn(client(port))
    let c1 = group.spawn(client(port))
    let c2 = group.spawn(client(port))
    print(hs.join())     // 3 = all three connections served
    print(c0.join())     // 1
    print(c1.join())     // 1
    print(c2.join())     // 1
}
