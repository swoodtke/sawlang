// Test environment access - Env.args(), Env.get(), Env.set()
// EXPECT: success
// EXPECT-OUTPUT: SAW_TEST_VAR:
// EXPECT-OUTPUT: hello from saw
// EXPECT-OUTPUT: unset successfully

func main() {
    // Set and read a custom variable (deterministic test)
    let _ = Env.set("SAW_TEST_VAR", "hello from saw")
    if let value = Env.get("SAW_TEST_VAR") {
        print("SAW_TEST_VAR:")
        print(value)
    }

    // Unset it
    let _ = Env.unset("SAW_TEST_VAR")
    if Env.contains("SAW_TEST_VAR") {
        print("still set")
    } else {
        print("unset successfully")
    }
}
