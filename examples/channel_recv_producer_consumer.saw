// design 62 G3: producer/consumer over the first-class cooperative suspending
// `Channel.receive()` (the try_receive+yield_now loop, lowered inline by the coro
// transform against the consumer's own frame). Compare taskgroup_producer_consumer
// which spells the loop by hand; here `receive()` packages it.
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 6

import std.channel.{Channel}
func producer(ch: Channel<Int>) -> Int {
    var i = 0
    while i < 3 {
        ch.send(i + 1)   // 1, 2, 3
        yield_now()
        i = i + 1
    }
    return i             // 3
}

func consumer(ch: Channel<Int>) -> Int {
    var sum = 0
    var got = 0
    while got < 3 {
        let v = ch.receive()   // cooperative: suspends the task while empty
        sum = sum + v
        got = got + 1
    }
    return sum            // 1 + 2 + 3 = 6
}

func main() {
    var group = TaskGroup()
    let ch = Channel<Int>()
    let hp = group.spawn(producer(ch.copy()))
    let hc = group.spawn(consumer(ch.copy()))
    print(hp.join())   // 3
    print(hc.join())   // 6
}
