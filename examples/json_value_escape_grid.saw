// std.json unit 1: the string-escape grid through the TREE path — every
// RFC 8259 short escape, a `\uXXXX` BMP escape and a surrogate-pair astral
// escape all decode into a `JsonValue.Text` and re-encode back through
// `to_json_string`, read back with `as_text`. Mirrors
// `examples/json_escape_grid.saw` (the seam-level test) one layer up.
// EXPECT: success
// EXPECT-OUTPUT:
// short_escapes roundtrip: true
// short_escapes reencoded: "\"\\/\b\f\n\r\t"
// bmp_escape decoded: e9
// astral_surrogate_pair decoded: 1f600
// lone_high_surrogate: decode error at byte 1: the bytes are not a well-formed item
// nested_in_array: ["a","\n","b"]

import std.json.{JsonValue}

func check_short_escapes() {
    // '"' '\' '/' BS FF LF CR TAB, written raw into a Saw string via escapes.
    let s = "\"\\/\u{8}\u{c}\n\r\t"
    let text = match JsonValue.Text(value: s).to_json_string() {
        case Ok(t) -> t,
        case Err(e) -> { print("short_escapes: encode failed: {}", e) return }
    }
    match JsonValue.parse(text: text) {
        case Ok(v) -> {
            let back = v.as_text() ?? "?"
            print("short_escapes roundtrip: {}", back.equals(s))
            print("short_escapes reencoded: {}", text)
        },
        case Err(e) -> print("short_escapes: reparse failed: {}", e)
    }
}

func check_decodes_to_scalar(label: String, text: String) {
    match JsonValue.parse(text: text) {
        case Ok(v) -> {
            let back = v.as_text() ?? "?"
            var scalar = -1
            for c in back.chars() {
                scalar = c
            }
            print("{} decoded: {}", label, to_hex(scalar))
        },
        case Err(e) -> print("{}: {}", label, e)
    }
}

func to_hex(n: Int) -> String {
    if n == 0 {
        return "0"
    }
    var digits = Vector<Int>()
    var v = n
    while v > 0 {
        try! digits.push(v % 16)
        v = v / 16
    }
    var sb = StringBuilder()
    var i = digits.len() - 1
    while i >= 0 {
        let d = digits[i]
        if d < 10 {
            try! sb.append(Byte(UInt8.from(truncating: 48 + d)))
        } else {
            try! sb.append(Byte(UInt8.from(truncating: 97 + (d - 10))))
        }
        i = i - 1
    }
    sb.build()
}

func check_reject(label: String, text: String) {
    match JsonValue.parse(text: text) {
        case Ok(v) -> print("{}: unexpectedly accepted -> {}", label, v.as_text() ?? "?"),
        case Err(e) -> print("{}: {}", label, e)
    }
}

func check_nested_in_array() {
    // A string needing an escape, inside an array, proves the escaping path
    // composes with the recursive Array writer (not just a lone top-level
    // Text value).
    var items = Vector<JsonValue>()
    try! items.push(JsonValue.Text(value: "a"))
    try! items.push(JsonValue.Text(value: "\n"))
    try! items.push(JsonValue.Text(value: "b"))
    let v = JsonValue.Array(items: move items)
    match v.to_json_string() {
        case Ok(t) -> print("nested_in_array: {}", t),
        case Err(e) -> print("nested_in_array: encode failed: {}", e)
    }
}

func main() {
    check_short_escapes()
    check_decodes_to_scalar("bmp_escape", "\"\\u00e9\"")
    check_decodes_to_scalar("astral_surrogate_pair", "\"\\ud83d\\ude00\"")
    check_reject("lone_high_surrogate", "\"\\ud800\"")
    check_nested_in_array()
}
