    let table: [Int; 4] = [0, 1, 2, 3]
    let none_int: Int? = None
    let flag = v.len() > 0
    let flagf = v.len() < 0
    var total = 0
    var i = 0
    while i < 4 {
        let x = i
        i = i + 1
        let b = flag && (try failb(x) catch { continue })
        let n = if b { x } else { 0 }
        total = total + n
    }
    total + 100
}

