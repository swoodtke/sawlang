import std.task.{yield_now}

struct Bad { n: Int }
extension Bad: Error {
    func format(&self, into: &var StringBuilder) { try! into.append("bad") }
}
struct Pair { a: Int, b: Int }
struct Bag { n: Int }
extension Bag {
    func add(&self, x: Int) sync -> Int { self.n + x }
}

func fail(x: Int) sync -> Result<Int, Bad> { if x == 2 { return Bad(n: x) }  x }
func failb(x: Int) sync -> Result<Bool, Bad> { if x == 2 { return Bad(n: x) }  true }
func failbag(x: Int) sync -> Result<Bag, Bad> { if x == 2 { return Bad(n: x) }  Bag(n: x) }
func id(n: Int) sync -> Int { n }
func idl(n: Int) sync -> Int { n }
func read(p: &Int) sync -> Int { p }
func respond() { yield_now() }

func direct_break_while_sync(v: &Vector<Int>) sync -> Int {
    let bag = Bag(n: 0)
    let table: [Int; 4] = [0, 1, 2, 3]
    let none_int: Int? = None
    let flag = v.len() > 0
    let flagf = v.len() < 0
    var total = 0
    var i = 0
    while i < 4 {
        let x = i
        i = i + 1
        let n = try fail(x) catch { break }
        total = total + n
    }
    total + 100
}

