// An ImplicitCopy-tier enum matched by a plain local scrutinee: the match
// must NOT consume it. ImplicitCopy reads are retain-copies by policy, so
// each arm binding retains the payload and the scrutinee keeps ownership —
// the payload is released exactly ONCE, when the scrutinee's own scope ends
// (after `done`). Codegen's consume model used to be tier-blind (gated on
// `enum_has_owning`, not the copy tier): the FIRST match handed the payload
// to the arm binding, which released it at arm end while `h` was still live
// (`deinit 9` printed before `second`), and the second match walked the freed
// payload — a silent use-after-free (DF-190d, closed by design 193 unit 1).
// EXPECT: success
// EXPECT-OUTPUT:
// first
// second
// done
// deinit 9

struct Res {
    id: Int
}

extension Res: NoCopy {
    func deinit(&var self) {
        print("deinit {self.id}")
    }
}

enum Holder {
    case Full(a: Arc<Res>),
    case Nothing
}

@synthesize extension Holder: ImplicitCopy {}

func main() {
    let h = Holder.Full(a: Arc<Res>(value: Res(id: 9)))
    match h {
        case Full(a) -> { print("first") },
        case Nothing -> { print("none") }
    }
    match h {
        case Full(a) -> { print("second") },
        case Nothing -> { print("none") }
    }
    print("done")
}
