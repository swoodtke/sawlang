// DF-232l: the whole-module `public import`'s ONE product is its qualifier
// (design 229 — "the chain reaches the dependency's surface"), yet the
// qualifier is stamped `Visibility.PRIVATE` by `_bind_module_qualifier`
// ("an import is never re-exported" — a comment design 229 superseded for
// the `public import` form). So a chain reach in a VALUE position fails with
// `module ... has no symbol ...` for ordinary and mapped modules alike,
// public symbols included. `export229_facade.saw` never noticed: it
// exercises the chain only in a TYPE annotation (a path that checks no
// module visibility) plus the facade's own function.
// XFAIL: DF-232l the re-exported qualifier is bound PRIVATE, so whole-module
// re-export hands on nothing in value position. The EXPECTs state the intent.
// EXPECT: success
// EXPECT-OUTPUT: 2
import modules.export229_facade_whole

func main() {
    let w = export229_facade_whole.export229_leaf.leaf_make(n: 2)
    print(w.n)
}
