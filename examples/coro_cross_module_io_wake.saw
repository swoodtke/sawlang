// SL-208 / DF-300e face 1 (the wedge, the important one). A per-connection
// handler that parks on a socket read lives in an IMPORTED module
// (`modules.sl208_reader.handle`) and is reached from the entry-module spawn
// root. Cross-module, the callee's embedded frame ran its io_wait with the
// root's wake token (`__io_tok`) still 0 — `rt_reactor_poll` never latched a
// zero token, so the parked read never woke and the single shared reactor
// wedged (no further connection served; 30s+ page stalls in sawtracker,
// SL-205). The transform now embeds the cross-module suspending free callee
// exactly as a same-module one, so its io_wait routes to the root frame's real
// `__wake` address and every parked reader wakes.
//
// THE PARK IS FORCED, not hoped for (review r1 finding 3). Each client connects
// and then sends NOTHING until it has read the handler's `READY` greeting, so
// the handler's read is issued against a socket its peer has not written to and
// MUST park; the request that arrives afterwards is the event that has to wake
// it. Under the earlier shape — client writes the whole request on connect —
// the handler often found the bytes already buffered and never parked at all,
// which is how the BUGGY compiler passed 2 of 5 runs.
//
// So the oracle is now two-sided: on a compiler that routes the token this
// prints 3/3 every run, and on one that does not every handler is parked
// forever on a wedged reactor and the harness times out. Bounded accept loop,
// loopback, fixed contents — nothing here is timing-dependent.
// EXPECT: success
// EXPECT-OUTPUT:
// 3
// 3

import std.net.{TcpListener, TcpStream}
import std.data.{Data}
import modules.sl208_reader

// Entry-module spawn root. Its body's ONLY statement is a call to the
// cross-module suspending handler — the shape that used to wedge (the callee's
// HOME MODULE is the axis; nesting depth is not).
func handler(stream: TcpStream) -> Int {
    sl208_reader.handle(move stream)
}

func server(listener: TcpListener, n: Int) -> Int {
    var hg = TaskGroup()
    var served = 0
    var i = 0
    while i < n {
        let stream = try! listener.accept()
        let _h = hg.spawn(handler(move stream))
        served = served + 1
        i = i + 1
    }
    served
}

func client(port: Int) -> Int {
    let stream = try! TcpStream.connect("127.0.0.1", port)
    // Stage 1: wait for the greeting. Nothing is sent on this socket until it
    // arrives, which is what leaves the handler's read with nothing to read.
    var hello = Data()
    var ready = 0
    while ready == 0 {
        let chunk = try! stream.read()
        if chunk.len() == 0 { return 0 }
        try! hello.append(move chunk)
        if (try! hello.to_string()).contains("READY") { ready = 1 }
    }
    // Stage 2: the request — the bytes that must wake the parked cross-module
    // reader. A response back is proof the wakeup landed.
    try! stream.write("GET / HTTP/1.1\r\n\r\n")
    var resp = Data()
    var got = 0
    while got == 0 {
        let chunk = try! stream.read()
        if chunk.len() == 0 { return 0 }
        try! resp.append(move chunk)
        if (try! resp.to_string()).contains("hello") { got = 1 }
    }
    got
}

func main() {
    let listener = try! TcpListener.listen(0)
    let port = listener.local_port()
    var group = TaskGroup()
    let hs = group.spawn(server(move listener, 3))
    let h0 = group.spawn(client(port))
    let h1 = group.spawn(client(port))
    let h2 = group.spawn(client(port))
    let total = h0.join() + h1.join() + h2.join()
    let served = hs.join()
    print(served)   // 3 = server accepted+served all three
    print(total)    // 3 = every client's parked handler woke and answered
}
