// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 3
// 5
// 7
// 9
// 10
// 6

func main() {
    // Skip even numbers with continue
    var i = 0
    while i < 10 {
        i = i + 1
        if i == 2 {
            continue
        }
        if i == 4 {
            continue
        }
        if i == 6 {
            continue
        }
        if i == 8 {
            continue
        }
        print(i)
    }

    // Find first number > 5
    var n = 0
    while {
        n = n + 1
        if n > 5 {
            break
        }
    }
    print(n)
}
