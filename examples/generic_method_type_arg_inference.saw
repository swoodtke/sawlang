// XFAIL: DF-216c a generic METHOD cannot infer its type argument in any
// spelling, while the identical free function infers fine
//
// First filed as a labeled-argument fault; the Aug-13 labeled-call sweep
// refuted that framing — positional `h.probe(99i64)` produces the
// BYTE-IDENTICAL inference error, and explicit type arguments produce two
// further distinct wrong diagnostics (`no parameter named other` labeled,
// `takes at most 0 argument(s)` positional). The fault axis is
// METHOD-vs-FREE-FUNCTION.
//
// Mechanism: the method-side inference path is a second, independently written
// caller of the label-mapping funnel (`_infer_label_mapping`/`_bind_args`) and
// is defective as a whole — suspect the `off`-adjusted parameter slice it feeds
// the funnel. The free-function line below is the control: it is the same
// signature, the same argument and the same label, and it works. DF-217d and
// DF-217e are the other two members of this family.
// EXPECT: success
// EXPECT-OUTPUT:
// free 5
// labeled 5
// positional 5
// explicit 5
// two-param 5

struct Plain { dummy: Int }

extension Plain {
    func probe<U>(other: U) -> Int { 5 }
    func probe2<U>(seed: Int, other: U) -> Int { seed }
}

func probe_free<U>(other: U) -> Int { 5 }

func main() {
    let h = Plain(dummy: 0)
    print("free {probe_free(other: 99i64)}")
    print("labeled {h.probe(other: 99i64)}")
    print("positional {h.probe(99i64)}")
    print("explicit {h.probe<Int64>(99i64)}")
    print("two-param {h.probe2(seed: 5, other: 99i64)}")
}
