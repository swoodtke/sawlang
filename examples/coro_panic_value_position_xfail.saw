// XFAIL: DF-158a a diverging `panic` in RESULT position of a suspending body is a codegen ICE
//
// A suspending body with a non-Void return type whose result expression is a
// `panic(...)` — the tail, or an explicit `return panic(...)` — makes the coro
// transform store the panic's (nonexistent) value into the frame's `__result`,
// and codegen stores a Python `None`: `internal compiler error: 'NoneType'
// object has no attribute 'type'`. `panic` is `Never`, so the store should not
// be emitted at all — the frame is dead at that point.
//
// The same body with a `Void` return type compiles and runs correctly, and so
// does the same `panic` tail in a SYNC function, so this is specifically the
// result-store in a coroutine frame. Found while writing design 158's
// panic-time task dump, whose natural test wanted exactly this shape.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: deliberate

func boom() -> Int {
    sleep(Duration.ms(1))
    panic("deliberate")
}

func main() {
    var g = TaskGroup()
    let b = g.spawn(boom())
    print("b {}", b.join())
}
