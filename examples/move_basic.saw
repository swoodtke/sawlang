// Test basic move semantics with NoCopy type
// EXPECT: 42
// EXPECT: deinit 42

struct FileHandle {
    fd: Int
}

extension FileHandle: NoCopy {
    func deinit(var self) {
        print("deinit")
        print(self.fd)
    }
}

func main() {
    let f1 = FileHandle(fd: 42)
    let f2 = move f1  // Transfer ownership - f1 no longer valid
    print(f2.fd)
    // Only f2.deinit() should be called, not f1
}
