// A method-result temporary of a Deinit type must be destroyed after the
// statement that produced it. `makeResource().use()` builds an `R`, calls a
// method on it, and then the temporary receiver goes away -- its deinit must run.
// Correct order: "use", then "R deinit", then "after".
//
// Brief 17 item 4: the method-result temporary receiver is now registered as a
// statement-scoped temporary and destroyed (LIFO) at the end of the statement
// that produced it, so "R deinit" prints between "use" and "after".
// EXPECT: success
// EXPECT-OUTPUT:
// use
// R deinit
// after

struct R {
    id: Int
}

extension R: NoCopy {
    func deinit(&var self) {
        print("R deinit")
    }
    func use(&self) {
        print("use")
    }
}

func makeResource() -> R {
    R(id: 1)
}

func main() {
    makeResource().use()   // temporary receiver must deinit after this statement
    print("after")
}
