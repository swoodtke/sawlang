// design 95: a spawned worker that calls BOTH suspending `write` overloads —
// `write(bytes: Data)` and `write(s: String)` — on the same TcpStream, back to
// back across parks. Before design 95 the coroutine transform keyed a driven
// suspending method by `(struct, method-name)`, so the two overloads collapsed
// to ONE frame and the second call mis-typed ("field s expects String? got
// Data"). Now each overload gets its OWN frame (keyed by resolved signature), so
// both drive correctly and the bytes round-trip in order. Socketpair only — no
// bound port; deterministic on byte-count + content.
// EXPECT: success
// EXPECT-OUTPUT:
// 8
// 8

import std.data.{Data}
import std.net.{TcpStream}
func sender(stream: TcpStream) -> Int {
    try! stream.write("data:".to_data())   // Data overload  (5 bytes)
    try! stream.write("abc")               // String overload (3 bytes)
    return 8
}

func receiver(stream: TcpStream) -> Int {
    var got = Data()
    var going = true
    while going {
        let chunk = try! stream.read()     // parks internally until bytes arrive
        if chunk.len() == 0 {
            going = false                  // peer closed
        } else {
            got.append(move chunk)
            if got.len() >= 8 {
                going = false
            }
        }
    }
    if got.to_string() == "data:abc" {
        got.len()
    } else {
        0
    }
}

func main() {
    let (a, b) = TcpStream.pair()
    var group = TaskGroup()
    let hs = group.spawn(sender(move a))
    let hr = group.spawn(receiver(move b))
    print(hs.join())     // 8 bytes sent across the two overloads
    print(hr.join())     // 8 = "data:abc" round-tripped in order
}
