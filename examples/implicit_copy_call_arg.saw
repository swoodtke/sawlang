// A ImplicitCopy value passed by value as a call argument must have copy() invoked,
// just like a let-binding or assignment does. Today call args are bitwise-copied
// and copy() never runs, so "copy called" is missing from the output.
// See todo_jul26.md must-fix #1 (ImplicitCopy copy() invoked at only 3 of many
// copy sites).
// EXPECT: success
// EXPECT-OUTPUT:
// copy called
// 42
// 42

struct RefCounted {
    value: Int
}

extension RefCounted: ImplicitCopy {
    func copy(&self) -> RefCounted {
        print("copy called")
        RefCounted(value: self.value)
    }
    func deinit(&var self) {
    }
}

func consume(r: RefCounted) -> Int {
    r.value
}

func main() {
    let r = RefCounted(value: 42)
    let n = consume(r)   // passes r by value -> copy() should run
    print(n)             // 42
    print(r.value)       // 42 - r still valid because consume got a copy
}
