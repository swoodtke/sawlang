// XFAIL: DF-215f a payload moved OUT of a suspending call's `match` is
// released by the enclosing coroutine's frame anyway when the value leaves the
// function, so the caller holds a value whose deinit already ran — a
// use-after-free. On Arc-backed payloads it surfaces as the early DEINIT below
// (or an over-release panic); on `Data`/`TcpStream` payloads in the wild it
// was a SIGSEGV or a broken socket (the design-215 dogfood port hit it on
// `TcpStream.connect` and `TcpStream.read`, and `try!` in place of `match` is
// the workaround its llm_client.saw carries).
//
// The trigger needs all three legs — suspending scrutinee, a `move`-out arm,
// and the moved value LEAVING the function — and the rows remove one each:
//   returned_tail   — match IS the function's tail (auto-wrap). CORRUPTS.
//   returned_bound  — bound to a local, then `return move`d. CORRUPTS — the
//                     return form is not the variable; leaving the function is.
//   local_use       — same match, value consumed in the same function. Clean.
//   try_instead     — `try` on the same suspending call, value returned. Clean.
//   sync_control    — identical match + return, non-suspending callee. Clean.
//
// Same neighborhood as the DF-218w/DF-242a family (a frame-owned release the
// transform places without seeing what an arm moved out), but this one is a
// DOUBLE RELEASE of an owned payload, not a timing divergence.
//
// The oracle: every DEINIT must print AFTER its row's "held" line — the early
// DEINIT is the bug, printed while the caller still holds the value.
// EXPECT: success
// EXPECT-OUTPUT:
// -- returned_tail
// NEW t1
// held t1
// DEINIT t1
// -- returned_bound
// NEW t2
// held t2
// DEINIT t2
// -- local_use
// NEW t3
// held t3
// DEINIT t3
// -- try_instead
// NEW t4
// held t4
// DEINIT t4
// -- sync_control
// NEW t5
// held t5
// DEINIT t5

import std.task.{yield_now}

struct MyErr { message: String }
extension MyErr: Printable {
    func format(&self, into: &var StringBuilder) { try! into.append(self.message) }
}
extension MyErr: Error {}

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("DEINIT {self.name}") }
}

struct Holder { cell: Arc<Res> }
@synthesize
extension Holder: Copy {}

func make_holder(name: String) -> Result<Holder, MyErr> {
    let h = Holder(cell: try! Arc<Res>(value: Res(name: name)))
    print("NEW {name}")
    yield_now()
    return move h
}

func make_holder_sync(name: String) -> Result<Holder, MyErr> {
    let h = Holder(cell: try! Arc<Res>(value: Res(name: name)))
    print("NEW {name}")
    return move h
}

func wrap_tail(name: String) -> Result<Holder, MyErr> {
    match make_holder(name) {
        case Ok(h) -> move h,
        case Err(e) -> e
    }
}

func wrap_bound(name: String) -> Result<Holder, MyErr> {
    let out = match make_holder(name) {
        case Ok(h) -> move h,
        case Err(e) -> { return e }
    }
    return move out
}

func wrap_try(name: String) -> Result<Holder, MyErr> {
    let h = try make_holder(name)
    return move h
}

func wrap_sync(name: String) -> Result<Holder, MyErr> {
    match make_holder_sync(name) {
        case Ok(h) -> move h,
        case Err(e) -> e
    }
}

func row_tail() -> Result<Void, MyErr> {
    let h = try wrap_tail("t1")
    print("held t1")
    return
}

func row_bound() -> Result<Void, MyErr> {
    let h = try wrap_bound("t2")
    print("held t2")
    return
}

func row_local() -> Result<Void, MyErr> {
    let h = match make_holder("t3") {
        case Ok(payload) -> move payload,
        case Err(e) -> { return e }
    }
    print("held t3")
    return
}

func row_try() -> Result<Void, MyErr> {
    let h = try wrap_try("t4")
    print("held t4")
    return
}

func row_sync() -> Result<Void, MyErr> {
    let h = try wrap_sync("t5")
    print("held t5")
    return
}

func main() -> Result<Void, MyErr> {
    print("-- returned_tail")
    try row_tail()
    print("-- returned_bound")
    try row_bound()
    print("-- local_use")
    try row_local()
    print("-- try_instead")
    try row_try()
    print("-- sync_control")
    try row_sync()
    return
}
