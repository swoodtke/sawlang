// Design 93 x design 70/74: an INFERRED generic instantiation drives identically
// to an explicit one. `run(move s)` infers `T` from the argument, then the
// coroutine transform monomorphizes + builds a frame per instantiation — the
// per-instantiation effect re-inference keys on the INFERRED instantiation.
// EXPECT: success
// EXPECT-OUTPUT:
// 11
// 21

trait Seed { func seed(&self) -> Int }

struct Slow { n: Int }
extension Slow: Seed { func seed(&self) -> Int { self.n } }

struct Fast { m: Int }
extension Fast: Seed { func seed(&self) -> Int { self.m } }

func run<T: Seed>(w: T) -> Int {
    let base = w.seed()
    __suspend()
    base + 1
}

func main() {
    let s = Slow(n: 10)
    print(__drive(run(move s)))    // 11  (T inferred = Slow)
    let f = Fast(m: 20)
    print(__drive(run(move f)))    // 21  (T inferred = Fast)
}
