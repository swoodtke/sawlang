// An inline `catch` arm that DIVERGES rather than yielding a value.
//
// `try f() catch { return E }` handles the error by leaving the function, so
// the catch arm reaches no merge point and contributes no value to the result.
// Codegen branched to the merge anyway, which asserted inside llvmlite and came
// out as an `internal compiler error` with an EMPTY message (DF-196c, fixed by
// design 196 unit 3). The BLOCK form `try { } catch { }` has guarded this since
// it was written — this is the sibling that had not.
//
// Four rows: the diverging arm in a sync body, the same in a SUSPENDING body
// (where the `return` is the coroutine's done sequence, not a machine return),
// a `panic` arm, and the ordinary value-yielding arm beside them so the two
// paths stay covered together.
// EXPECT: success
// EXPECT-OUTPUT:
// err MyErr(99)
// ok 0
// err MyErr(99)
// ok 5
// ok 12

import std.task.*

struct MyErr { code: Int }

extension MyErr: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("MyErr(")
        try! into.append(self.code)
        try! into.append(")")
    }
}

extension MyErr: Error {}

func inner(n: Int) -> Result<Int, MyErr> {
    if n > 0 { return MyErr(code: n) }
    return 0
}

func slow_inner(n: Int) -> Result<Int, MyErr> {
    yield_now()
    if n > 0 { return MyErr(code: n) }
    return 0
}

func sync_return_arm(n: Int) -> Result<Int, MyErr> {
    let v = try inner(n) catch { return MyErr(code: 99) }
    return v
}

func driven_return_arm(n: Int) -> Result<Int, MyErr> {
    let v = try slow_inner(n) catch { return MyErr(code: 99) }
    return v
}

func driven_value_arm(n: Int) -> Result<Int, MyErr> {
    let v = try slow_inner(n) catch { 5 }
    return v
}

func panic_arm(n: Int) -> Int {
    let v = try inner(n) catch { panic("unreachable in this test") }
    v + 12
}

func show(r: Result<Int, MyErr>) {
    match r {
        case Ok(v) -> print("ok {v}"),
        case Err(e) -> print("err {e}")
    }
}

func main() {
    show(sync_return_arm(4))
    show(sync_return_arm(0))
    show(driven_return_arm(4))
    show(driven_value_arm(4))
    print("ok {panic_arm(0)}")
}
