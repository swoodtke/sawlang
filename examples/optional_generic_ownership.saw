// Design 174 (the T = U? sweep) — ownership through an Optional element type.
//
// The silent failure mode for an optional-instantiated container is a wrong
// drop count: a payload behind `Some` that never deinits (leak) or deinits
// twice (use-after-free). Both containers get it exactly right — the `None`
// elements drop nothing and each `Some` payload deinits once — and an
// ImplicitCopy payload read out of a place is a real retain, so the value
// outlives the container it came from.
// EXPECT: success
// EXPECT-OUTPUT:
// -- vector of Res?
// len 3
// -- dropping vector
// deinit 1
// deinit 2
// -- vector gone
// -- map of Res?
// map len 2
// -- dropping map
// deinit 3
// -- map gone
// r1 alpha
// r2 alpha
// after drop r1 alpha
// after drop r2 alpha
// held beta
// -- done

struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.id}") }
}

func main() {
    print("-- vector of Res?")
    var v = Vector<Res?>()
    let a: Res? = Res(id: 1)
    let b: Res? = None
    let c: Res? = Res(id: 2)
    v.push(move a)
    v.push(move b)
    v.push(move c)
    print("len {v.len()}")
    print("-- dropping vector")
    let _ = move v
    print("-- vector gone")

    print("-- map of Res?")
    var m = Map<String, Res?>()
    let d: Res? = Res(id: 3)
    let e: Res? = None
    let _ = m.insert("d", move d)
    let _ = m.insert("e", move e)
    print("map len {m.len()}")
    print("-- dropping map")
    let _ = move m
    print("-- map gone")

    // An ImplicitCopy payload read out of an optional element RETAINS, so the
    // reads stay valid after the vector is gone.
    var s = Vector<String?>()
    let text: String? = "alpha"
    s.push(text)
    let r1 = s[0] ?? "none"
    let r2 = s[0] ?? "none"
    print("r1 {r1}")
    print("r2 {r2}")
    let _ = move s
    print("after drop r1 {r1}")
    print("after drop r2 {r2}")

    // Same through the `get` conditional lend, peeling both layers.
    var w = Vector<String?>()
    let other: String? = "beta"
    w.push(other)
    var held = "none"
    if let inner = w.get(0) { held = inner ?? "none" }
    let _ = move w
    print("held {held}")
    print("-- done")
}
