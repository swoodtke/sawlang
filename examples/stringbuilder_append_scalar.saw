// StringBuilder.append(scalar: Scalar) — UTF-8 encode one Unicode scalar
// (design 245, replacing design 119's `append_scalar`). It is the encoding
// inverse of String.scalars(), so an encode/decode round-trip is the identity
// on every scalar. Validity is not in this signature at all: a `Scalar` is a
// scalar by construction, so the only failure left is the allocator.
// Boundaries at each UTF-8 length transition.
// EXPECT: success
// EXPECT-OUTPUT:
// n_7f: 1
// n_80: 2
// n_7ff: 2
// n_800: 3
// n_ffff: 3
// n_10000: 4
// n_10ffff: 4
// rt_7f: true
// rt_80: true
// rt_7ff: true
// rt_800: true
// rt_ffff: true
// rt_10000: true
// rt_10ffff: true
// bytes_80: true
// text: hé€😀

// Bytes written for the scalar with code point `code`.
func nbytes(code: Int) -> Int {
    var sb = StringBuilder()
    try! sb.append(try! Scalar(value: code))
    sb.len()
}

// Encode then decode back through scalars(): true iff the single scalar
// survives intact and the built byte length matches the reported count.
func roundtrip(code: Int) -> Bool {
    var sb = StringBuilder()
    try! sb.append(try! Scalar(value: code))
    let s = sb.build()
    if s.len() != nbytes(code) { return false }
    var got = -1
    var count = 0
    for c in s.scalars() {
        got = c.value()
        count = count + 1
    }
    count == 1 && got == code
}

func main() {
    print("n_7f: {nbytes(127)}")          // 0x7F
    print("n_80: {nbytes(128)}")          // 0x80
    print("n_7ff: {nbytes(2047)}")        // 0x7FF
    print("n_800: {nbytes(2048)}")        // 0x800
    print("n_ffff: {nbytes(65535)}")      // 0xFFFF
    print("n_10000: {nbytes(65536)}")     // 0x10000
    print("n_10ffff: {nbytes(1114111)}")  // 0x10FFFF

    print("rt_7f: {roundtrip(127)}")
    print("rt_80: {roundtrip(128)}")
    print("rt_7ff: {roundtrip(2047)}")
    print("rt_800: {roundtrip(2048)}")
    print("rt_ffff: {roundtrip(65535)}")
    print("rt_10000: {roundtrip(65536)}")
    print("rt_10ffff: {roundtrip(1114111)}")

    // 0x80 encodes to the two bytes 0xC2 0x80.
    var sb = StringBuilder()
    try! sb.append(try! Scalar(value: 128))
    let s = sb.build()
    let b0 = s.byte_at(0) as Int
    let b1 = s.byte_at(1) as Int
    print("bytes_80: {b0 == 194 && b1 == 128}")

    // The overload joins the family: bytes, digits and characters under one
    // name, picked by the argument's type.
    var text = StringBuilder()
    try! text.append("hello".byte_at(0))            // Byte -> the raw byte 'h'
    try! text.append(try! Scalar(value: 233))       // Scalar -> é
    try! text.append(try! Scalar(value: 0x20AC))    // Scalar -> €
    try! text.append(try! Scalar(value: 0x1F600))   // Scalar -> 😀
    print("text: {text.build()}")
}
