// A suspending STATIC extension method suspends exactly as an instance one does.
//
// The coroutine transform used to key a suspending method callee off its
// RECEIVER's type, and a static call has no receiver — so the method was never
// embedded as a sub-frame. Two faces, both closed by DF-184a: in the entry
// module the call did not even resolve (the closure walk reached the method
// through its effect edge and stripped the original body, leaving a call to
// something that no longer existed — reported as ``undefined variable
// `Napper` ``); in std the call resolved and the body compiled UNTRANSFORMED,
// so every suspension in it ran out of frame.
//
// The two bodies here are identical but for the receiver, and both answers must
// be 42 — one frame each, one `yield_now` each, neither blocking the executor.
// EXPECT: success
// EXPECT-OUTPUT:
// instance: 42
// static: 42

import std.task.*

struct Napper { n: Int }

extension Napper {
    func doubled(&self) -> Int {
        yield_now()
        self.n * 2
    }

    func doubling(n: Int) -> Int {
        yield_now()
        n * 2
    }
}

func via_instance() -> Int {
    let a = Napper(n: 21)
    a.doubled()
}

func via_static() -> Int {
    Napper.doubling(21)
}

func main() {
    var group = TaskGroup()
    let hi = group.spawn(via_instance())
    print("instance: {hi.join()}")
    let hs = group.spawn(via_static())
    print("static: {hs.join()}")
}
