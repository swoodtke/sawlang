// Returning an erased error from a body that SUSPENDS should work exactly as
// returning one from a sync body does.
//
// `return MyErr(code: n)` in a `Result<Int, Box<any Error>>` function is an
// ErasedErrWrap the typechecker inserts into the AST. Once a `yield_now()`
// ahead of it makes the body suspending, the coroutine transform lowers the
// return into an ASSIGNMENT into the frame's result slot — and codegen's
// `visit_ErasedErrWrap` builds the Err through
// `_create_result_err_for_return`, which reads the ENCLOSING function's return
// type and finds a state-machine step instead:
// `internal compiler error: Cannot create Result.Err outside Result-returning
// function`. Drop the `yield_now()` and the same program compiles and runs, so
// it is the suspension, not the erasure, that moves the wrap out of return
// position. A CONCRETE `Result<Int, MyErr>` across the same suspension is fine
// (`ResultErrWrap` carries its own `result_type`; the erased wrap does not).
// XFAIL: DF-192c an erased-error return in a SUSPENDING body is a codegen ICE — the wrap loses its return position to the state machine
// EXPECT: success
// EXPECT-OUTPUT:
// err MyErr(7)

import std.task.*

struct MyErr { code: Int }

extension MyErr: Printable {
    func format(&self, into: &var StringBuilder) {
        into.append("MyErr(")
        into.append(self.code)
        into.append(")")
    }
}

extension MyErr: Error {}

func fail(n: Int) -> Result<Int, Box<any Error>> {
    yield_now()
    return MyErr(code: n)
}

func main() {
    match fail(7) {
        case Ok(v) -> print("ok {v}"),
        case Err(e) -> print("err {e}")
    }
}
