// Test: assignment to a field of an array element must mutate the element
// EXPECT: success
// EXPECT-OUTPUT: 99
// XFAIL: field assignment through an array element (a[0].v = 99) is silently a no-op (brief 33 observation)

struct Cell {
    v: Int
}

func main() {
    var a = [Cell(v: 1), Cell(v: 2)]
    a[0].v = 99
    print(a[0].v)
}
