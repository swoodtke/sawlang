// XFAIL: DF-232e a 2-cycle import (`a` imports `b.{beta}`, `b` imports
// `a.{alpha}`) is not diagnosed as a cycle — `_topological_sort`
// (sawc.py:324) detects it and returns the modules in ARBITRARY order
// anyway ("the type checker will handle any errors"), so one participant
// is type-checked before the dependency that defines its names and fails
// with an ordinary-looking `undefined function` — landing on `lib`, a
// THIRD module that merely imports `a` and did nothing wrong, not on
// either cycle participant. The intended behavior is a diagnostic naming
// the cycle: `import cycle: a -> b -> a`.
//
// EXPECT: success
// EXPECT-OUTPUT: 1

import modules.graphcyc2.lib

func main() {
    print("{lib.run()}")
}
