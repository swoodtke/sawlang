// DF-232n fixture: a package whose boundary is its own `Saw.toml` root, reached
// by RELATIVE path — no `--module-path`, so nothing about the module PATH says
// which package these declarations belong to. That is the whole point: the
// package identity comes from the manifest root on disk.
//
// `pkg_secret` and `PkgBox` are the package tier; `pkg_open` beside them is
// genuinely `public`, so a refusal of the first two is about the TIER and not
// about this module being unreachable.
// EXPECT: skip

public(package) func pkg_secret() -> Int {
    7
}

public(package) struct PkgBox {
    public(package) n: Int
}

public func pkg_open() -> Int {
    11
}

// A second package-tier function, so a call and its ARGUMENT can be refused
// independently (DF-232p).
public(package) func pkg_scale(x: Int) -> Int {
    x * 2
}

// A package-tier producer of the package-tier type, which is how the DF-232o
// tests get a `PkgBox` value to carry into a module that may not name one. It
// was `public` until the Aug-21 ruling ("a public API needs public types"),
// which refuses exactly that shape at the declaration: a `public` function
// handing back a `public(package)` type hands an outside module a value it
// cannot name. The producer narrows to the tier of what it produces.
public(package) func make_box() -> PkgBox {
    PkgBox(n: 4)
}
