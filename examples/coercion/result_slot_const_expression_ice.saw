// XFAIL: DF-235a a `Result` Ok payload that is a constant EXPRESSION (not a
// bare integer literal) never adopts the payload's declared width, and
// `ResultOkWrap` codegen — which assumes the adopted width was reached —
// throws an internal compiler error building the wrap struct. See
// array_literal_const_element_ice.saw for the sibling symptom and the
// shared mechanism (`_apply_literal_expected_type` has no case for a
// `BinaryOp` constant expression).
//
// EXPECT: success
// EXPECT-OUTPUT: 24

struct Bad { code: Int }
extension Bad: Printable {
    func format(&self, into: &var StringBuilder) { into.append("bad") }
}
extension Bad: Error {}

func give() -> Result<UInt16, Bad> { return (1 << 3) | (1 << 4) }

func main() {
    match give() {
        case Ok(v) -> print("{v}"),
        case Err(_) -> print("err")
    }
}
