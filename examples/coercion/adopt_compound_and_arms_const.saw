// Position matrix (design 235), grid 1 "Adoption" — rows: value `if` arm and
// `match` arm, source S3 (const expression), for an IN-RANGE value. The
// bare-literal (S1) row for both is already covered by
// literal_coercion_positions.saw.
//
// This demonstrates the value flowing correctly when it fits; the range check
// on the same two rows is pinned by const_expression_range_checked_narrow.saw,
// which covers every position the one adoption funnel serves.
//
// The compound-assign RHS row belongs to this grid too and has its own file,
// compound_assign_const_expression.saw — it was the one position that refused a
// legal value rather than mis-storing one.
//
// EXPECT: success
// EXPECT-OUTPUT:
// if arm const = 24
// match arm const = 40

func main() {
    let cond = true
    let picked: UInt32 = if cond { (1 << 3) | (1 << 4) } else { 0 }
    print("if arm const = {picked}")

    let n = 2
    let m_arm: Int16 = match n {
        case 1 -> 10,
        case 2 -> 5 * 8,
        case _ -> 12
    }
    print("match arm const = {m_arm}")
}
