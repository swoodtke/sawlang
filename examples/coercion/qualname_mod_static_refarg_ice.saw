// XFAIL: DF-232d passing a qualifier-rooted static as a `&var` argument
// ICEs (`f(&var mod.STATIC)`) — the typechecker accepts it (no clean error
// is reported before the crash), so this is a CODEGEN gap: whatever
// generates the reference's address tries to codegen the qualifier
// `Identifier` as an ordinary runtime value, which has none. See DF-232d's
// tracker entry (Aug 20 correction) for the full corrected matrix — the
// original finding's "refs ✓" claim does not hold on today's tree.
//
// EXPECT: success
// EXPECT-OUTPUT: 20

import modules.qualname_static_dep

func bump(r: &var Int) {
    r = 20
}

func main() unsafe {
    bump(&var qualname_static_dep.X)
    print("{qualname_static_dep.X}")
}
