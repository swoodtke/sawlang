// Position matrix (design 235), grid 1 "Adoption" — row: static initializer.
// A `static` initializer is a constant expression (design 186), so a bare
// literal (S1) and a folded const expression (S3) both adopt the static's
// declared FIXED-WIDTH type, not just platform `Int` (design 186's own
// examples are all platform `Int`; this row is the fixed-width case).
//
// NOTE (DF-235b): the const-expression row demonstrates the VALUE flowing
// correctly when it fits — it does NOT demonstrate range-checking. An
// out-of-range const expression in a static initializer silently truncates
// instead of refusing (probe-confirmed; see DF-235b's tracker entry).
// EXPECT: success
// EXPECT-OUTPUT:
// bare = 100
// const = 24
// neg = -8

static BARE: Int8 = 100
static CONST_EXPR: UInt32 = (1 << 3) | (1 << 4)
static NEG: Int8 = 0 - 8

func main() {
    print("bare = {BARE}")
    print("const = {CONST_EXPR}")
    print("neg = {NEG}")
}
