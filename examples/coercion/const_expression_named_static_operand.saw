// DF-240a, closed by design 241 unit 2 (ruled Aug 21): a fixed-width ADOPTION
// SLOT is a full const position for NAME RESOLUTION, so a constant expression
// whose leaf is a module `static` adopts the slot and is range-checked there.
//
// `1 << PAGE_SHIFT` for `static PAGE_SHIFT: Int = 20` is 1048576, out of
// `UInt16`'s 0..=65535 range, and is now the same clean error the bare
// `1 << 20` gives (const_expression_range_checked_narrow.saw). It used to
// compile clean and print `0` — so the size-in-one-place idiom (DF-172j), the
// spelling the language RECOMMENDS, was the one that lost the check.
//
// The fix is one line at design 240's own funnel arm: `_stamp_const_names`
// runs over the expression before the fold, exactly as every other const
// position runs it. See const_expression_named_enum_case_operand.saw for the
// other name kind that walk supplies.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: does not fit in `UInt16`

static PAGE_SHIFT: Int = 20

func main() {
    let e: UInt16 = 1 << PAGE_SHIFT
    print("{e}")
}
