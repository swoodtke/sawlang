// A driven `case Has(_)` releases the discarded payload at EXTRACTION, where
// the sync twin releases it — DF-218w.
//
// DF-217p's scope-end migration moved this cell from "frame teardown" to "the
// end of the match statement" and stopped there. A `_` payload binding names no
// value to own, so it is registered in no cleanup scope and no scope exit can
// reach it; sync answers that by dropping it INLINE at extraction
// (codegen/match.py's consume branch, the DF-217n fix). The driven twin has no
// consume mode to be in — its scrutinee is the frame TEMP the container-head
// hoist made (`self.__headN`), not an owned local — so the temp's own release
// was what dropped the payload, one position late.
//
// DF-218w's first fix was an EDGE (E-ARM): an arm that claimed nothing of the
// scrutinee released the hoisted temp at its own start, since the payload was
// then aliased by nobody. Design 247 replaced the edge with the MODE the whole
// row wanted — the hoisted temp is take-read now, so the scrutinee reaching
// codegen is an owned temporary and the ordinary consume model drops an
// unclaimed payload inline at extraction, deciding it by the same rule as the
// sync twin instead of by a driven-only edge. The mixed `case Both(v, _)` shape
// the edge could not reach came with it, and is pinned beside this file.
//
// MATRIX. The rows are the arm shapes that claim nothing, plus the control that
// claims, plus both lowerings:
//
//   discard   — `case Has(_)`, the original cell, lowered IN PLACE (the head
//               was the only suspending part, so the construct itself spans
//               nothing once it is hoisted)
//   wildcard  — `case _` over an owning variant, where sync drops the whole
//               scrutinee at the arm's start for the same reason
//   split     — `case Has(_)` where the ARM suspends too, so the match is
//               CFG-split and the drop rides the arm's entry state
//   named     — the control: an arm that binds by name keeps the arm's END on
//               BOTH twins, because the binding is live for the arm
//
// The neighbouring shapes are pinned separately: the mixed `case Both(v, _)`
// (coro_mixed_match_payload_released_at_extraction.saw, closed with this one by
// design 247) and a multi-field all-`_` payload's field ORDER
// (coro_discarded_match_payload_field_drop_order.saw, DF-218y).
// EXPECT: success
// EXPECT-OUTPUT:
// -- sync
// NEW t1
// DEINIT t1
// arm
// scope closed
// -- driven
// NEW t1
// DEINIT t1
// arm
// scope closed
// -- sync wildcard
// NEW t2
// DEINIT t2
// arm
// scope closed
// -- driven wildcard
// NEW t2
// DEINIT t2
// arm
// scope closed
// -- sync split
// NEW t3
// DEINIT t3
// arm
// scope closed
// -- driven split
// NEW t3
// DEINIT t3
// arm
// scope closed
// -- sync named
// NEW t4
// arm
// DEINIT t4
// scope closed
// -- driven named
// NEW t4
// arm
// DEINIT t4
// scope closed

import std.task.{yield_now}

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("DEINIT {self.name}") }
}

struct Tag { cell: Arc<Res> }
@synthesize
extension Tag: Copy {}

enum Held { case Has(x: Tag) }

func mk_tag(id: Int) -> Tag {
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func mk_tag_s(id: Int) -> Tag {
    yield_now()
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func sync_discard() {
    match Held.Has(x: mk_tag(1)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func driven_discard() {
    match Held.Has(x: mk_tag_s(1)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func sync_wildcard() {
    match Held.Has(x: mk_tag(2)) {
        case _ -> { print("arm") }
    }
    print("scope closed")
}

func driven_wildcard() {
    match Held.Has(x: mk_tag_s(2)) {
        case _ -> { print("arm") }
    }
    print("scope closed")
}

func sync_split() {
    match Held.Has(x: mk_tag(3)) {
        case Has(_) -> { print("arm") }
    }
    print("scope closed")
}

func driven_split() {
    match Held.Has(x: mk_tag_s(3)) {
        case Has(_) -> {
            yield_now()
            print("arm")
        }
    }
    print("scope closed")
}

func sync_named() {
    match Held.Has(x: mk_tag(4)) {
        case Has(v) -> { print("arm") }
    }
    print("scope closed")
}

func driven_named() {
    match Held.Has(x: mk_tag_s(4)) {
        case Has(v) -> { print("arm") }
    }
    print("scope closed")
}

func main() {
    print("-- sync")
    sync_discard()
    print("-- driven")
    __saw_drive(driven_discard())
    print("-- sync wildcard")
    sync_wildcard()
    print("-- driven wildcard")
    __saw_drive(driven_wildcard())
    print("-- sync split")
    sync_split()
    print("-- driven split")
    __saw_drive(driven_split())
    print("-- sync named")
    sync_named()
    print("-- driven named")
    __saw_drive(driven_named())
}
