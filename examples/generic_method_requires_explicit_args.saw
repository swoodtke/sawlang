// Method-level generics require EXPLICIT call-site type arguments (brief 36):
// type-argument inference is out of scope, consistent with free generic
// functions. Calling a generic method without `<...>` is an error.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: requires explicit type argument

struct Box<T> { value: T }

extension Box<T> {
    func get(&self) -> T { self.value }
    func stashed<U>(&self, other: U) -> U { other }
}

func main() {
    let b = Box<Int>(value: 5)
    print(b.stashed(42))  // missing <Int> — inference not supported
}
