// Data's copy-on-write ownership transfer and the offset-aware copy —
// the two paths data.saw's historical segfault notes disclaimed, pinned.
//
// 1. Pushing into a Data that has a LIVE SLICE (refcount > 1) routes
//    _reserve_unique -> _make_unique: detach from the shared block, deep
//    copy, pre-incremented refcount so the local copy's deinit lands the
//    count at exactly 1. The slice's bytes must be unaffected.
// 2. copy() FROM A SLICE must read buffer + offset (the restored memcpy
//    fill), not the buffer head.
// EXPECT: success
// EXPECT-OUTPUT:
// ok
import std.data.*

func main() {
    var d = Data(capacity: 4)
    d.push(10)
    d.push(20)
    d.push(30)

    if let s = d.slice(1, 3) {
        // refcount is 2: every mutation of d below takes the CoW path,
        // and the growth past capacity 4 forces a reallocation too.
        d.push(40)
        d.push(50)
        d.push(60)
        d.push(70)

        assert(d.len() == 7, "d grew to {} not 7", d.len())
        assert(s.len() == 2, "slice len {} not 2", s.len())
        assert(s.get(0)! == 20, "slice[0] {} not 20", s.get(0)!)
        assert(s.get(1)! == 30, "slice[1] {} not 30", s.get(1)!)
        assert(d.get(6)! == 70, "d[6] {} not 70", d.get(6)!)

        // copy() from the SLICE: offset-aware fill.
        let c = s.copy()
        assert(c.len() == 2, "copy len {} not 2", c.len())
        assert(c.get(0)! == 20, "copy[0] {} not 20 (offset ignored?)", c.get(0)!)
        assert(c.get(1)! == 30, "copy[1] {} not 30", c.get(1)!)
    }

    // copy() from a whole (offset 0) Data.
    let w = d.copy()
    assert(w.len() == d.len(), "whole copy len mismatch")
    assert(w.get(0)! == 10, "whole copy[0] {} not 10", w.get(0)!)

    print("ok")
}
