// Data's copy-on-write separation and the offset-aware eager copy.
//
// Design 165 rebuilt this on `Arc`, so the two paths this program has always
// pinned are now one gate and one memcpy rather than a hand-rolled refcount:
//
// 1. Pushing into a `Data` that has a LIVE SLICE finds the storage shared and
//    separates it — the pushing side gets its own buffer, the slice keeps the
//    bytes it could see. (This used to be `_reserve_unique` -> `_make_unique`,
//    a deep copy that stole the block and pre-incremented a count so the local
//    copy's deinit landed it back at 1. `Arc` runs the count now.)
// 2. An eager copy FROM A SLICE must read `buffer + offset`, not the buffer
//    head. `copy()` is a retain since design 165, so `detached()` is the
//    spelling that exercises the fill.
// EXPECT: success
// EXPECT-OUTPUT:
// ok
import std.data.*

func main() {
    var d = Data(capacity: 4)
    d.push(10)
    d.push(20)
    d.push(30)

    if let s = d.slice(1, 3) {
        // The storage is shared now, so every mutation of `d` below separates
        // it, and the growth past capacity 4 reallocates on top of that.
        d.push(40)
        d.push(50)
        d.push(60)
        d.push(70)

        assert(d.len() == 7, "d grew to {} not 7", d.len())
        assert(s.len() == 2, "slice len {} not 2", s.len())
        assert(s.get(0)! == 20, "slice[0] {} not 20", s.get(0)!)
        assert(s.get(1)! == 30, "slice[1] {} not 30", s.get(1)!)
        assert(d.get(6)! == 70, "d[6] {} not 70", d.get(6)!)

        // A retain of the SLICE: same bytes, its own window.
        let r = s.copy()
        assert(r.len() == 2, "retained len {} not 2", r.len())
        assert(r.get(0)! == 20, "retained[0] {} not 20", r.get(0)!)

        // The eager copy from a slice: offset-aware fill, sized to len().
        let c = s.detached()
        assert(c.len() == 2, "detached len {} not 2", c.len())
        assert(c.get(0)! == 20, "detached[0] {} not 20 (offset ignored?)", c.get(0)!)
        assert(c.get(1)! == 30, "detached[1] {} not 30", c.get(1)!)
    }

    // The eager copy from a whole (offset 0) Data.
    let w = d.detached()
    assert(w.len() == d.len(), "whole detached len mismatch")
    assert(w.get(0)! == 10, "whole detached[0] {} not 10", w.get(0)!)

    print("ok")
}
