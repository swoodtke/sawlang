// Design 88 (D6 confinement crux): a DRIVEN-in-place frame may hold a reference
// across a suspension (the referent outlives the drive), but a SPAWNED frame may
// NOT — it is boxed onto the run queue and resumed later, so a reference into the
// spawner's stack could dangle. `group.spawn(f(&var x))` is a clean, precise
// rejection (both single- and multi-threaded groups). The referent must be
// shared as an owned value / Arc / Channel, or the function driven in place.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: is a reference into the spawner held across a suspension

import std.task.*
struct Rec { n: Int }

func bump(d: &var Rec) -> Int {
    d.n = d.n + 1
    yield_now()
    d.n
}

func main() {
    var data = Rec(n: 5)
    var group = TaskGroup()
    let h = group.spawn(bump(&var data))   // rejected: ref into spawner stack
    print(h.join())
}
