// Set<T> core (design 54): insert returns true iff newly inserted, remove
// returns true iff present, contains / len / is_empty.
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 1
// 1
// 0
// 2
// 1
// 0
// 1
// 0
// 1

func main() {
    var s = Set<Int>()
    if s.is_empty() { print(1) } else { print(0) }   // 1
    if s.insert(1) { print(1) } else { print(0) }    // 1 (new)
    if s.insert(2) { print(1) } else { print(0) }    // 1 (new)
    if s.insert(1) { print(1) } else { print(0) }    // 0 (dup)
    print(s.len())                                   // 2
    if s.contains(1) { print(1) } else { print(0) }  // 1
    if s.contains(9) { print(1) } else { print(0) }  // 0
    if s.remove(1) { print(1) } else { print(0) }    // 1 (present)
    if s.remove(1) { print(1) } else { print(0) }    // 0 (absent)
    print(s.len())                                   // 1
}
