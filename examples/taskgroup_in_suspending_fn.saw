// design 62 G1: a TaskGroup living in a SUSPENDING function's own frame. The
// group + its erased run queue are frame-resident state; `group.spawn(...)`'s
// synthesized `&group` receiver resolves to an addressable frame field
// (design-62 plain-encoded, real empty-group placeholder). The parent suspends
// (`sleep`) BETWEEN spawn and join — the child executor runs nested within a
// parent resume, driving ONLY the group's own queue.
// EXPECT: success
// EXPECT-OUTPUT:
// 42

import std.task.*
func child(n: Int) -> Int {
    yield_now()
    return n * 2
}

func orchestrate(base: Int) -> Int {
    var group = TaskGroup()
    let h1 = group.spawn(child(base))
    let h2 = group.spawn(child(base + 1))
    sleep(1)                            // parent suspends between spawn and join
    return h1.join() + h2.join()        // child(10)=20 + child(11)=22 = 42
}

func main() {
    print(__saw_drive(orchestrate(10)))     // 42
}
