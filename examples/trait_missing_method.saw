// Test error when trait method is not implemented
// EXPECT: error
// EXPECT-ERROR-CONTAINS: does not implement required method `describe`

trait Describable {
    func describe(&self) -> Int
}

struct Point {
    x: Int
    y: Int
}

// Missing implementation of describe method
extension Point: Describable {
}

func main() {
    let p = Point(x: 3, y: 4)
    print(p.x)
}
