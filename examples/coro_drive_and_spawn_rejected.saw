// design 134: one function cannot be both `__saw_drive`n and spawned.
//
// A driven frame keeps its result and cancel word in the frame itself; a spawned
// frame keeps them in the group-owned cell, so its frame carries a pointer where
// the driven layout carries the values. One function means one frame, so the two
// protocols cannot share it. `__saw_drive` is a compiler-internal test intrinsic,
// so the overlap is rejected rather than given a second layout to carry.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: is both `__saw_drive`n and spawned into a `TaskGroup`

import std.task

func work(n: Int) -> Int {
    yield_now()
    n * 2
}

func main() {
    let a = __saw_drive(work(3))
    var group = TaskGroup()
    let h = group.spawn(work(4))
    print(a + h.join())
}
