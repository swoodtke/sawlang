// Provider for `examples/crossmodule_embed_type_name_head.saw`.
//
// Every method below writes a member access whose HEAD is a TYPE NAME or a
// MODULE QUALIFIER rather than a value — `Cmd.Build`, `Anchor.helper()`,
// `deeper.deep_value()`, `Perm.from(raw:)`. Such a head is never checked as an
// expression, so it carries no `resolved_type`, and design 210's closedness
// reduction used to read that absence as "this subtree cannot answer for
// itself": it cleared the whole subtree's `embed_preserved` marks and the
// entry module re-resolved names only this module can see.

import modules.embed_typename_deeper

public enum Cmd {
    case Build
}

public enum Perm: UInt8 {
    case Read = 1,
    case Write = 2
}

public struct Anchor { public n: Int }

// Module-private on purpose: the entry module must not be able to name these.
func scan_args(handle: () -> Int) -> Int {
    handle()
}

func take(c: Cmd) -> Int {
    match c {
        case Build -> 1
    }
}

func idn<T>(v: T) -> T { v }

public extension Anchor {
    public static func helper() -> Int { 200 }

    // An enum-case literal as a CALL ARGUMENT: the head `Cmd` re-opened the
    // call, which then re-resolved the module-private `take`.
    public static func enum_literal_arg() -> Int {
        let k = scan_args({ 1 })
        take(Cmd.Build) + k
    }

    // The same head inside a GENERIC argument list.
    public static func generic_call_arg() -> Int {
        let k = scan_args({ 1 })
        match idn<Cmd>(Cmd.Build) {
            case Build -> 10 + k
        }
    }

    // A MODULE QUALIFIER head — the shape design 210's own docstring names
    // (`undefined variable `builder``), still reachable until DF-212b unit 2.
    public static func module_qualifier() -> Int {
        let k = scan_args({ 1 })
        let d = embed_typename_deeper.Deep(n: 3)
        embed_typename_deeper.deep_value() + d.twice() + k
    }

    // A STATIC method head on a type of this module.
    public static func static_head() -> Int {
        let k = scan_args({ 1 })
        Anchor.helper() + k
    }

    // An integer LIMIT head, and a raw-backed enum's `from(raw:)` head.
    public static func builtin_heads() -> Int {
        let k = scan_args({ 1 })
        let p = Perm.from(raw: 2u8)
        match p! {
            case Write -> if Int.max > 0 { 300 + k } else { 0 },
            case Read -> 0
        }
    }
}
