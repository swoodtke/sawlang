// The callee side of DF-238a's pin: one public free function with a NARROW
// fixed-width parameter, so a literal argument has a width to adopt and a
// range to be checked against.
//
// The static method and the constructor are the CONTROLS — the same literal
// through the same qualifier, on the two qualified member paths that carry the
// expected type correctly. They are here so the pin's fix cannot be a change
// that breaks them.

public struct Byte238a {
    public value: UInt8
}

public func take_byte(b: UInt8) -> Int {
    b as Int
}

extension Byte238a {
    public static func of(b: UInt8) -> Byte238a {
        Byte238a(value: b)
    }
}
