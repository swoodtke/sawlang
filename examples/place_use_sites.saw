// Design 141/146: USING a place. One `borrows` declaration serves a shared
// read and an exclusive write; the window is the smallest expression that turns
// the place back into a value; windows chain and nest.
//
// `lend` is a SUSPENSION, not a return: the accessor pauses with its frame
// alive, the caller's window code runs inside that pause, and the epilogue runs
// when the window closes. `counted` below is the oracle for that ordering.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 12
// b
// 12
// 42
// hits 2
// 1

struct Cell {
    count: Int
    tag: String
}

struct Row {
    cells: [Cell; 2]
}

struct Bag {
    rows: [Row; 2]
    hits: Int
}

extension Row {
    public func [](&var self, i: Int) borrows -> Cell {
        if i < 0 || i >= 2 {
            panic("Row.[]: index out of range")
        }
        lend self.cells[i]
    }
}

extension Bag {
    public func [](&var self, i: Int) borrows -> Row {
        if i < 0 || i >= 2 {
            panic("Bag.[]: index out of range")
        }
        lend self.rows[i]
    }

    // An EPILOGUE: everything after the `lend` runs when the window closes.
    public func counted(&var self, i: Int) borrows -> Row {
        if i < 0 || i >= 2 {
            panic("Bag.counted: index out of range")
        }
        lend self.rows[i]
        self.hits = self.hits + 1
    }

}

func bump(c: &var Cell) {
    c.count = c.count + 30
}

func main() {
    var b = Bag(rows: [Row(cells: [Cell(count: 1, tag: "a"),
                                   Cell(count: 2, tag: "b")]),
                       Row(cells: [Cell(count: 3, tag: "c"),
                                   Cell(count: 4, tag: "d")])],
                hits: 0)

    // A shared window: the place becomes a value at `.count`.
    print("{b[0][1].count}")

    // An exclusive window from the SAME declaration, picked by the use site.
    b[0][1].count += 10
    print("{b[0][1].count}")

    // A value read of a Copy field through two chained windows.
    let tag = b[0][1].tag
    print("{tag}")

    // A place handed to a call as a reference: the window spans the call.
    print("{b[0][1].count}")
    bump(&var b[0][1])
    print("{b[0][1].count}")

    // Two windows through the epilogue accessor: `hits` counts closings.
    let _ = b.counted(0)[0].count
    let _ = b.counted(1)[0].count
    print("hits {b.hits}")

    print("{b[0][0].count}")
}
