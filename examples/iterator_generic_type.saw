// Test that for loop iterator variables have correct generic type substitution
// EXPECT: success
// EXPECT-OUTPUT: 1
// EXPECT-OUTPUT: 1
// EXPECT-OUTPUT: hello
// EXPECT-OUTPUT: world

func main() {
    // Test 1: Method call on iterator variable with let binding
    let s = "a,b"
    let parts = try! s.split(",")
    for part in parts.iter() {
        let len = part.len()
        print(len)
    }

    // Test 2: Chained method calls on iterator variable
    let s2 = "  hello  ,  world  "
    let parts2 = try! s2.split(",")
    for part in parts2.iter() {
        let trimmed = part.trim()
        print(trimmed)
    }
}
