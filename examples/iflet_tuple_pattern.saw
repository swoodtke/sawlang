// Design 63 T1d: `if let`/`guard let` gain tuple patterns over an Optional
// tuple `(T, U)?`.
// EXPECT: success
// EXPECT-OUTPUT:
// 7
// 99
// 7
// -1

func maybe(b: Bool) -> (Int, Int)? {
    if b { (3, 4) } else { None }
}

func useGuard(b: Bool) -> Int {
    guard let (x, y) = maybe(b) else { return -1 }
    x + y
}

func main() {
    if let (a, c) = maybe(true) {
        print(a + c)     // 7
    } else {
        print(0)
    }

    if let (a, c) = maybe(false) {
        print(a + c)
    } else {
        print(99)        // 99
    }

    print(useGuard(true))    // 7
    print(useGuard(false))   // -1
}
