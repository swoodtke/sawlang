// Design 120, stage 2: a chained-assignment whose RHS suspends —
// `x?.y = f()`. The write happens (and the RHS runs) only when every optional
// hop is non-None; on a None head the RHS is skipped (pinned semantics 3). The
// counter proves the skip.
// EXPECT: success
// EXPECT-OUTPUT:
// 99
// 1
// -1
// 1

static CALLS: Atomic<Int> = Atomic(0)

struct Point { x: Int, y: Int }

func s(n: Int) -> Int {
    CALLS.fetch_add(1)
    __saw_suspend()
    n
}

func doassign(o: Point?) -> Int {
    var local = o
    local?.x = s(99)          // Void?; RHS suspends; skipped on None head
    if let p = local { return p.x }
    return -1
}

func main() {
    print(__saw_drive(doassign(Point(x: 1, y: 2))))   // 99 (write ran)
    print(CALLS.load())                               // 1
    print(__saw_drive(doassign(None)))                // -1 (skipped)
    print(CALLS.load())                               // 1 (unchanged)
}
