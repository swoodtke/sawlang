// Test implementing the built-in Deinit interface
// EXPECT: 42

struct Resource {
    value: Int
}

extension Resource: Deinit {
    func deinit(var self) {
        // In a real implementation, this would release resources
        print(self.value)
    }
}

func main() {
    var r = Resource(value: 42)
    // Manually call deinit for now (automatic will come in Phase 5)
    r.deinit()
}
