//               "label": "n",
//               "type": "Int"
//             }
//           ],
//           "returns": "Int",
//           "effect": "sync",
//           "self": null,
//           "static": false,
//           "doc": "Declared `sync`: the checker proved the body suspension-free.",
//           "line": 135
//         }
//       ]
//     }
//   ]
// }

/// Suspends: sleeps before answering.
public func nap(ms: Int) -> Int {
    sleep(Duration.ms(ms as UInt64))
    ms
}

/// Suspends transitively: it only calls `nap`.
public func nap_twice(ms: Int) -> Int {
    nap(ms) + nap(ms)
}

/// Sync: no suspension anywhere below it.
public func plain(n: Int) -> Int { n + 1 }

/// Declared `sync`: the checker proved the body suspension-free.
public func promised(n: Int) sync -> Int { plain(n) }

func main() {
    print(nap_twice(0) + plain(1) + promised(1))
}
