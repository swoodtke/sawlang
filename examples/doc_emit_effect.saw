//! The `--emit-docs` effect field, read off the effect graph.
//
// Design 122 unit E: `effect` is answered by the whole-program effect graph, so
// a suspending USER function reports `suspending` — directly (`nap` calls
// `sleep`) and TRANSITIVELY (`nap_twice` only calls `nap`). The docs path used
// to skip the effect fixpoint entirely, leaving every node's bit unset, so only
// names carried over from the std pre-check ever said `suspending` and every
// suspending user function was documented `sync`.

// EXPECT: docs
// COMPILE-FLAGS: --emit-docs
// EXPECT-OUTPUT:
// {
//   "schema_version": 4,
//   "modules": [
//     {
//       "name": "doc_emit_effect",
//       "source": "doc_emit_effect.saw",
//       "doc": "The `--emit-docs` effect field, read off the effect graph.",
//       "items": [
//         {
//           "kind": "func",
//           "name": "main",
//           "signature": "func main()",
//           "visibility": "private",
//           "generics": [],
//           "params": [],
//           "returns": "Void",
//           "effect": "suspending",
//           "self": null,
//           "static": false,
//           "doc": null,
//           "line": 137
//         },
//         {
//           "kind": "func",
//           "name": "nap",
//           "signature": "public func nap(ms: Int) -> Int",
//           "visibility": "public",
//           "generics": [],
//           "params": [
//             {
//               "name": "ms",
//               "label": "ms",
//               "type": "Int"
//             }
//           ],
//           "returns": "Int",
//           "effect": "suspending",
//           "self": null,
//           "static": false,
//           "doc": "Suspends: sleeps before answering.",
//           "line": 121
//         },
//         {
//           "kind": "func",
//           "name": "nap_twice",
//           "signature": "public func nap_twice(ms: Int) -> Int",
//           "visibility": "public",
//           "generics": [],
