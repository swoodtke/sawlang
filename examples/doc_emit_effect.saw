//               "name": "ms",
//               "label": "ms",
//               "type": "Int"
//             }
//           ],
//           "returns": "Int",
//           "effect": "suspending",
//           "self": null,
//           "static": false,
//           "doc": "Suspends transitively: it only calls `nap`.",
//           "line": 127
//         },
//         {
//           "kind": "func",
//           "name": "plain",
//           "signature": "public func plain(n: Int) -> Int",
//           "visibility": "public",
//           "generics": [],
//           "params": [
//             {
//               "name": "n",
//               "label": "n",
//               "type": "Int"
//             }
//           ],
//           "returns": "Int",
//           "effect": "sync",
//           "self": null,
//           "static": false,
//           "doc": "Sync: no suspension anywhere below it.",
//           "line": 132
