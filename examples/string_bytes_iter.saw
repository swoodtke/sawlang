// String.bytes() iterator (brief 38 item 2): yields the raw bytes as `Byte`,
// matching byte_at's element type, usable directly in a `for` loop. Multibyte
// content yields every underlying byte (not scalars). Design 250 made the
// element `Byte` (unsigned); it used to be `Int8`, so `é`'s bytes read negative
// and this test had to fold them back.
// EXPECT: success
// EXPECT-OUTPUT:
// 65
// 66
// 67
// 5
// 169

func main() {
    // ASCII "ABC" -> 65, 66, 67
    for b in "ABC".bytes() {
        print(b as Int)
    }

    // "café" is 5 bytes (é = 0xC3 0xA9): bytes() visits all 5.
    var count = 0
    var last = 0
    for b in "café".bytes() {
        count = count + 1
        last = b as Int                     // already unsigned: no fold
    }
    print(count)   // 5 bytes
    print(last)    // last byte of é = 0xA9 = 169
}
