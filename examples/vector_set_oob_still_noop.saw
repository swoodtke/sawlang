// Design 122 / RS-6 interaction: `set` keeps its documented tolerant contract.
// `set` filters the index itself and then delegates to `swap_out`, which gained
// an always-on bounds panic — so the panic must NOT leak through and turn an
// out-of-range `set` into an abort. Out of range stays a no-op; in range still
// replaces (and still releases the element it overwrites, design 122 unit A).
// EXPECT: success
// EXPECT-OUTPUT:
// 10
// 20
// 99
// 20
// 2

func main() {
    var v: Vector<Int> = [10, 20]
    v.set(99, 7)             // past the end — no-op, no panic
    v.set(-1, 7)             // negative — no-op, no panic
    print(v.get(0)!)         // 10, untouched
    print(v.get(1)!)         // 20, untouched

    v.set(0, 99)             // in range — replaces
    print(v.get(0)!)         // 99
    print(v.get(1)!)         // 20
    print(v.len())           // 2 — length never moved
}
