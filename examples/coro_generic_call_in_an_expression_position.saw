// SL-326, CLOSED by design 275 U2 — a suspending GENERIC free call in an
// EXPRESSION position inside a driven body. It used to be hoisted by design
// 120's ANF and never PROMOTED, so the instantiation it named had no frame and
// the hoisted call was a plain call to a suspending body inside the synthesized
// resume:
//
//   error: cannot suspend in `sync func` method: method `__Frame_main.resume`
//          calls `warp$1$Int` → yield_now (`warp$1$Int` suspends at line N)
//
// THE MECHANISM: two position sets that did not agree.
// `_promote_nested_generic_calls` walked the positions design 74 shape 3 was
// written against — a statement-level `let x = g<Args>(...)` or a bare call —
// while design 120 gave every EXPRESSION position a hoist and design 224 widened
// it again. The promotion walk is DISCOVERY and the hoist is LOWERING, and
// nothing reconciled them. U2 reconciles them by deleting the position guess:
// an edge to a generic instance is a demand whatever position the call sits in.
// The `let` cell below is the control that always compiled; the interpolation,
// argument and operand cells are the ones that did not.
//
// EXPECT: success
// EXPECT-OUTPUT:
// let 10
// interpolation 11
// argument 12
// operand 14
// done

import std.task.{yield_now}

func warp<T>(x: T, n: Int) -> Int {
    yield_now()
    n + 10
}

func take(v: Int) -> Int { v }

func main() {
    let bound = warp<Int>(1, 0)
    print("let {bound}")
    print("interpolation {warp<Int>(1, 1)}")
    print("argument {take(warp<Int>(1, 2))}")
    print("operand {1 + warp<Int>(1, 3)}")
    yield_now()
    print("done")
}
