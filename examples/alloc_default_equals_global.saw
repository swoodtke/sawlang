// Default omission is IDENTICAL to explicit Global (design 37 item 4): same
// behavior AND same type identity. A function declared over `Vector<Int>`
// accepts a `Vector<Int, Global>` argument, because `Vector<Int>` resolves to
// `Vector<Int, Global>` before mangling — one type, one monomorphization.
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 2
// 3

func total(v: Vector<Int>) -> Int {
    var sum = 0
    var i = 0
    while i < v.len() {
        if let x = v.get(i) {
            sum = sum + x
        }
        i = i + 1
    }
    sum
}

func main() {
    // Written with the default omitted.
    var a = Vector<Int>()
    a.push(1)

    // Written with the allocator spelled out — SAME type as `a`.
    var b = Vector<Int, Global>()
    b.push(2)

    print(total(move a))   // 1  — Vector<Int> accepted
    print(total(move b))   // 2  — Vector<Int, Global> accepted where Vector<Int> expected

    // And a fresh default-form vector behaves the same.
    var c = Vector<Int>()
    c.push(3)
    print(total(move c))   // 3
}
