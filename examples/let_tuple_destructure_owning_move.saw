// Design 63 T1d: destructuring `let` moves each owning component out of the
// tuple; the whole tuple is consumed (design 35 L1). Each component is dropped
// exactly once at scope end (LIFO after the print).
// EXPECT: success
// EXPECT-OUTPUT:
// 100
// 2
// 1

struct Res { v: Int }
extension Res: Deinit {
    func deinit(&var self) { print(self.v) }
}

func main() {
    let pair = (Res(v: 1), Res(v: 2))
    let (a, b) = move pair
    print(100)
    // b drops (2), then a drops (1) at scope end — exactly once each.
}
