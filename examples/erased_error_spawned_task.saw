// A task that returns an ERASED Result joins like any other task.
//
// The task's result travels through a `__ResultCell<T>`, which the group holds
// ERASED — so spawning one asks for a vtable over the cell type. At `T =
// Result<Int, Box<any Error>>` the two sides used to spell that type
// differently: the cell monomorphized under codegen's native arity-1
// `Box<any Error>` and the vtable asked for the arity-2 `Box<any Error,
// GlobalAllocator>`, so the thunk's impl lookup missed by a name and the
// compiler died with a bare `KeyError` (DF-192b). A CONCRETE error type in the
// same position spawns and joins fine, which is what made it the erasure rather
// than spawning a Result. Design 196 unit 2 routes every erased identity
// through one canonicalizer.
// EXPECT: success
// EXPECT-OUTPUT:
// err MyErr(7)

struct MyErr { code: Int }

extension MyErr: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("MyErr(")
        try! into.append(self.code)
        try! into.append(")")
    }
}

extension MyErr: Error {}

func fail(n: Int) -> Result<Int, Box<any Error>> {
    if n > 0 { return MyErr(code: n) }
    return 0
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(fail(7))
    match h.join() {
        case Ok(v) -> print("ok {v}"),
        case Err(e) -> print("err {e}")
    }
}
