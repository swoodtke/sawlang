// design 90: a server task accept-LOOPS to serve N=2 sequential connections in
// ONE TaskGroup with two clients. Before the fix this hung: the read on the 2nd
// connection never woke because a client's `connect()` park was spuriously roused
// by the reactor's coarse wake-all (on the listener's readiness) BEFORE its own
// socket was writable, and `connect` trusted that wake — writing on the still-
// unconnected socket returned ENOTCONN, so the request was never sent and the
// server blocked forever. `connect` now re-verifies and re-parks. Each connection
// read+write round-trips; server asserts every request, clients assert the reply.
// Deterministic on content, time-bounded (the runner's timeout catches a wedge).
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 1
// 1

func serve(listener: TcpListener, n: Int) -> Int {
    var served = 0
    while served < n {
        let stream = try! listener.accept()
        var req = Data()
        var reading = true
        while reading {
            let chunk = try! stream.read()
            if chunk.len() == 0 {
                reading = false
            } else {
                req.append(move chunk)
                if req.to_string().contains("\r\n\r\n") {
                    reading = false
                }
            }
        }
        assert(req.to_string().starts_with("GET / HTTP/1.1"), "bad request")
        try! stream.write("HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello")
        served = served + 1
    }
    return served
}

func client(port: Int) -> Int {
    let stream = try! TcpStream.connect("127.0.0.1", port)
    try! stream.write("GET / HTTP/1.1\r\n\r\n")
    var resp = Data()
    var reading = true
    while reading {
        let chunk = try! stream.read()
        if chunk.len() == 0 {
            reading = false
        } else {
            resp.append(move chunk)
            if resp.to_string().contains("hello") {
                reading = false
            }
        }
    }
    let s = resp.to_string()
    if s.starts_with("HTTP/1.1 200 OK") && s.contains("hello") { 1 } else { 0 }
}

func main() {
    let listener = try! TcpListener.listen(0)
    let port = listener.local_port()
    var group = TaskGroup()
    let hs = group.spawn(serve(move listener, 2))
    let c0 = group.spawn(client(port))
    let c1 = group.spawn(client(port))
    print(hs.join())     // 2 = both connections served
    print(c0.join())     // 1 = client 0 got the 200 + body
    print(c1.join())     // 1 = client 1 got the 200 + body
}
