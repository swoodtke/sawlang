/// A span measured in whole ticks.
public struct Tick {
    /// Ticks since the counter started.
    public count: Int
    /// Scratch space the documentation must not show.
    scratch: Int
}

/// Which end of a span a reading came from.
public enum Edge {
    /// The reading at the start.
    case Start,
    /// The reading at the end, carrying the tick it landed on.
    case End(at: Int)
}

/// A value with a tick count.
public trait Ticked {
    /// Returns the tick count.
    func ticks(&self) -> Int
}

/// Construction and arithmetic for `Tick`.
public extension Tick: Ticked {
    /// Builds a tick count, defaulting to the start of the counter.
    public init(count: Int = 0) -> Tick { Tick(count: count, scratch: 0) }

    /// Returns the tick count.
    public func ticks(&self) -> Int { self.count }

    /// Advances the count in place.
    public func advance(&var self, by: Int) { self.count = self.count + by }

    // Undocumented and private: absent from the emitted JSON.
    func scratch_value(&self) -> Int { self.scratch }
}

/// A count of ticks.
public type Ticks = Int

/// The tick every counter starts at.
public static FIRST_TICK: Ticks = 0

/// Returns the tick count a reading landed on.
public func reading(edge: Edge) -> Int {
    match edge {
        case Start -> FIRST_TICK,
        case End(at) -> at
    }
}

func main() {
    var t = Tick()
    t.advance(by: reading(edge: Edge.End(at: 3)))
    print(t.ticks())
}
