// Test pointer operations - using malloc/free from libc
// EXPECT: success
// EXPECT-OUTPUT:
// 65
// 66
// 67

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
}

unsafe func main() {
    // Allocate memory. `main`'s signature carries no `Unsafe*` type, so every
    // raw-pointer operation is marked `unsafe` (design 81): the binding of the
    // malloc'd pointer, and each deref read/write.
    if let ptr = malloc(100) {
        // Write values using pointer indexing
        ptr[0] = 65  // 'A'
        ptr[1] = 66  // 'B'
        ptr[2] = 67  // 'C'

        // Read values back
        print(ptr[0])
        print(ptr[1])
        print(ptr[2])

        // Free memory
        free(ptr)
    }
}
