// Type casting with the `as` keyword. Every cast here is REPRESENTABLE, so
// design 170's check never fires and each one costs what it always did — the
// widenings emit exactly the same sext/zext, and the in-range narrowings fold
// their check away because the operand is a constant.
//
// The old last case (`255u8 as Int8` printing -1) moved to
// `Int8.from(truncating:)`: reinterpreting a bit pattern is a different
// operation from converting a value, and only one of them is spelled `as` now.
// EXPECT: success
// EXPECT-OUTPUT:
// 42
// 42
// 255
// 1000
// -1

func main() {
    // Widening: Int8 -> Int32
    let x: Int8 = 42
    let y = x as Int32
    print(y)

    // Narrowing, in range: Int -> Int8
    let big: Int = 42
    let small = big as Int8
    print(small)

    // Narrowing to unsigned, in range
    let large: Int = 255
    let byte = large as UInt8
    print(byte)

    // Sign extension: Int16 -> Int
    let short: Int16 = 1000
    let long = short as Int
    print(long)

    // Unsigned to signed at the SAME width is a reinterpret, not a conversion:
    // 255 has no Int8 value, so `as` would panic. Ask for the bits by name.
    let u: UInt8 = 255
    let s = Int8.from(truncating: u)
    print(s)  // -1 (two's complement)
}
