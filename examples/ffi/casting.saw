// Test type casting with 'as' keyword
// EXPECT: success
// EXPECT-OUTPUT:
// 42
// 42
// 255
// 1000
// -1

func main() {
    // Widening: Int8 -> Int32
    let x: Int8 = 42
    let y = x as Int32
    print(y)

    // Truncating: Int -> Int8
    let big: Int = 42
    let small = big as Int8
    print(small)

    // Truncating to unsigned (should print 255, not -1)
    let large: Int = 255
    let byte = large as UInt8
    print(byte)

    // Sign extension: Int16 -> Int
    let short: Int16 = 1000
    let long = short as Int
    print(long)

    // Unsigned to signed same size (two's complement)
    let u: UInt8 = 255
    let s = u as Int8
    print(s)  // -1 (two's complement)
}
