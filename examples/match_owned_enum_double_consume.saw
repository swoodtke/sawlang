// Matching an OWNED enum consumes it — the payload binding takes ownership
// (design skill: "match on an owned enum consumes it"). Codegen marks the
// scrutinee moved, but the typechecker binds match payloads with no
// transfer checkpoint and no move-marking, so a SECOND match on the same
// owned NoCopy enum compiles silently and the payload deinits TWICE (a
// double-free). The intended behavior is a use-after-move error at the
// second match, exactly as a second `move s` would give.
// XFAIL: DF-190a match-arm payload binding bypasses the move checkpoint; owned NoCopy enum double-consumed
// EXPECT: error
// EXPECT-ERROR-CONTAINS: after it was moved

struct Res {
    id: Int
}

extension Res: NoCopy {
    func deinit(&var self) {
        print("deinit {self.id}")
    }
}

enum Slot {
    case Filled(r: Res),
    case Empty
}

extension Slot: NoCopy {}

func main() {
    let s = Slot.Filled(r: Res(id: 7))
    match s {
        case Filled(r) -> { print("got {r.id}") },
        case Empty -> { print("empty") }
    }
    match s {
        case Filled(r) -> { print("again {r.id}") },
        case Empty -> { print("empty") }
    }
}
