// Design 40 item 4 (L9): a trivial struct carrying a fixed-array field
// auto-conforms to Equatable; `==` compares the array element by element.
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 2
struct Row {
    id: Int
    cells: [Int; 3]
}

func main() {
    let a = Row(id: 1, cells: [10, 20, 30])
    let b = Row(id: 1, cells: [10, 20, 30])
    let c = Row(id: 1, cells: [10, 20, 99])

    if a == b { print(1) }        // every element equal
    if a != c { print(2) }        // last element differs
}
