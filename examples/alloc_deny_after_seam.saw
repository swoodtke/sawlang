// Design 123: the hosted default allocator carries an allocation budget so the
// three-tier failure policy can be tested where it actually bites — the types
// that take no allocator type parameter. `__saw_rt_alloc_deny_after(allow,
// deny)` permits `allow` allocations, refuses the next `deny`, then resumes
// normal service; `deny <= 0` refuses everything from then on, and a negative
// `allow` disarms. This test only proves the seam itself: denial is observed
// through `Vector.try_with_capacity`, the fallible-tier factory that predates it.
// EXPECT: success
// EXPECT-OUTPUT:
// denied
// allowed
// denied
// allowed
// 8

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int, deny: Int)
}

func try_capacity() -> Bool {
    match Vector<Int>.try_with_capacity(4) {
        case Ok(_) -> true,
        case Err(_) -> false
    }
}

func report(ok: Bool) {
    if ok {
        print("allowed")
    } else {
        print("denied")
    }
}

func main() {
    // Deny everything from here on.
    __saw_rt_alloc_deny_after(0, 0)
    report(try_capacity())              // denied

    // One allocation of headroom, then the window closes on the second.
    __saw_rt_alloc_deny_after(1, 1)
    report(try_capacity())              // allowed
    report(try_capacity())              // denied
    // Window spent: service resumed without an explicit disarm.
    report(try_capacity())              // allowed

    // Explicit disarm, then a plain vector grows normally.
    __saw_rt_alloc_deny_after(-1, 0)
    var v = Vector<Int>()
    var i = 0
    while i < 8 {
        v.push(i)
        i = i + 1
    }
    print(v.len())
}
