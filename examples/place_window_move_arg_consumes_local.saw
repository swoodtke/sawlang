// A `move` of a LOCAL inside a place window consumes it, once.
//
// `v.push(move h)` where `v` is a PLACE puts the author's `move h` inside the
// closure the window lowering writes, so the lowering owes that local a real
// transfer. Neither eager answer worked: with the drop flag cleared at capture
// the local LEAKED whenever the body did not run, and with it left alone the
// value DOUBLE-FREED whenever the body did. The window closure is
// non-escaping, so it takes the deferred transfer (DF-218h, ruled Aug 24) —
// the environment carries a pointer to the local and the body takes the value
// as it starts.
//
// Found by design 218 stage 1: a frame local is a `Slot` now, so
// `pending.push(move h)` in a driven body became a window call and irdet
// stopped compiling. The `_migrated_enc` hold-back that answered it is still in
// place (retiring it is a design-218 staging decision), so the driven row below
// exercises the legacy encoding and the two below it the window.
//
// The uniform rule across every non-escaping shape is
// `closure_move_capture_transfers_when_body_runs.saw`.
//
// ORACLE: each id is constructed once and deinits once.
// EXPECT: success
// EXPECT-OUTPUT:
// deinit 5
// deinit 4
// driven len 2
// direct len 1
// deinit 1
// binding len 2
// deinit 3
// deinit 2
import std.task.*
import std.compiler.frame.{Slot}

struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) { print("deinit {self.id}") }
}

// The shape the migration held back: `pending` is a frame local, so a `Slot`
// read would make `pending.push(move h)` a window call. Teardown is EAGER
// (design 124), so the frame releases `pending` when the task completes —
// which is why both ids print before the line that reports the length.
func driven_row() -> Int {
    var wave = Vector<Res>()
    wave.push(Res(id: 4))
    wave.push(Res(id: 5))
    var pending = Vector<Res>()
    yield_now()
    while wave.len() > 0 {
        if let h = wave.pop() {
            pending.push(move h)
        }
    }
    pending.len()
}

// The user-level shape, with no coroutine anywhere: a `Slot` is an ordinary
// place, so `s.value()` lends and the push moves into the window.
func direct_row() {
    var s = Slot<Vector<Res>>.empty()
    s.put(Vector<Res>())
    let h = Res(id: 1)
    s.value().push(move h)
    print("direct len {s.value().len()}")
    s.clear()
}

func binding_row() {
    var s = Slot<Vector<Res>>.empty()
    s.put(Vector<Res>())
    var wave = Vector<Res>()
    wave.push(Res(id: 2))
    wave.push(Res(id: 3))
    while wave.len() > 0 {
        if let h = wave.pop() {
            s.value().push(move h)
        }
    }
    print("binding len {s.value().len()}")
    s.clear()
}

func main() {
    print("driven len {__saw_drive(driven_row())}")
    direct_row()
    binding_row()
}
