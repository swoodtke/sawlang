// design 44 item 1: `__saw_suspend()` is the coroutine-transform suspension point
// and, like `__saw_test_suspend`, an effect source feeding the design-22
// suspendability inference. OUTSIDE any `__saw_drive` closure it is a no-op, so a
// program that merely mentions it (never driven) compiles and runs unchanged —
// the transform is OFF by construction until something is driven.
// EXPECT: success
// EXPECT-OUTPUT:
// 7

func work() -> Int {
    let a = 3
    __saw_suspend()
    let b = 4
    a + b
}

func main() {
    // `work` is effect-suspending but never driven, so it runs straight
    // through (suspension is a no-op here).
    print(work())
}
