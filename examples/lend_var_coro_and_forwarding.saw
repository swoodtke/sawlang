// Design 179 composition: a flavored window inside a COROUTINE frame, and the
// FORWARDED lend, which SL-333 R7 turned from a pessimization into the rule.
//
// Coroutines: the declaration lowering forces every accessor `sync`, so an
// accessor never becomes a coroutine frame itself. What has to work is a window
// OPENED inside a suspending body, on either side of a suspension, in both
// flavors. It does.
//
// The forwarded lend: `lend self.inner[i]` hands another accessor's place on,
// and `lend X` now hands it over at THIS SPECIALIZATION's mode — `&X` inside
// the shared copy, `&var X` inside the exclusive one. So a shared read through
// `Outer` reaches `Inner` SHARED and runs no gate at all, and only the write
// does. Design 179 shipped this as a known v1 limit (`lend X` was always
// `&var X`, so three gate runs served one read, one write and one more read);
// the gate counts below are what R7 costs instead.
// EXPECT: success
// EXPECT-OUTPUT:
// task results 12 22
// forwarded read 3, inner gates 0
// forwarded write 4, inner gates 1
// -- done
import std.task.*

struct Grid { cells: [Int; 4], gates: Int }

extension Grid {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 4 { panic("Grid.[]: index out of range") }
        if #lend_var { self.run_gate() }
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

// A window on both sides of a suspension, in both flavors.
func tally(n: Int) -> Int {
    var g = Grid(cells: [1, 2, 3, 4], gates: 0)
    yield_now()
    g[0] += n
    yield_now()
    g[0] + g.gates_seen()
}

struct Inner { cells: [Int; 2], gates: Int }

extension Inner {
    func run_gate(&var self) { self.gates = self.gates + 1 }

    public func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Inner.[]: index out of range") }
        if #lend_var { self.run_gate() }
        lend self.cells[i]
    }

    public func gates_seen(&self) -> Int { self.gates }
}

struct Outer { inner: Inner }

extension Outer {
    // Forwards the inner accessor's place. `lend X` becomes `__window(&X)` in
    // this accessor's SHARED specialization and `__window(&var X)` in its
    // exclusive one, so the inner accessor is reached at the outer window's own
    // mode (SL-333 R7).
    public func [](&var self, i: Int) borrows -> &var Int {
        lend self.inner[i]
    }

    public func inner_gates(&self) -> Int { self.inner.gates_seen() }
}

func main() {
    var group = TaskGroup()
    let a = group.spawn(tally(10))
    let b = group.spawn(tally(20))
    print("task results {a.join()} {b.join()}")

    var o = Outer(inner: Inner(cells: [3, 4], gates: 0))
    // A SHARED read of the outer place reaches the inner accessor SHARED, so
    // the inner gate does not run at all (SL-333 R7).
    print("forwarded read {o[0]}, inner gates {o.inner_gates()}")
    o[0] += 1
    print("forwarded write {o[0]}, inner gates {o.inner_gates()}")
    print("-- done")
}
