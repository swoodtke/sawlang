// Test implementing the built-in CustomCopy interface
// EXPECT: success
// EXPECT-OUTPUT:
// 84

struct RefCounted {
    value: Int
}
extension RefCounted: CustomCopy {
    func copy(&self) -> RefCounted {
        // In a real implementation, this would increment a refcount
        RefCounted(value: self.value)
    }
    func deinit(&var self) {
        // In a real implementation, this would decrement refcount
    }
}
func main() {
    let r1 = RefCounted(value: 42)
    let r2 = r1.copy()
    print(r1.value + r2.value)
}
