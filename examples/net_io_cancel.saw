// design 76 (A3): cancellation observed at the IO suspension point. The reader
// drains the bytes already in the socket and parks on the empty socket; `main`
// then cancels it, and the parked read wakes and reports the cancellation, so
// the reader returns through normal control flow (NO forced destroy), with
// deinit-oracle cleanup. This is the cooperative cancellation contract: a read
// checks `cancelled()` before it would park, and a cancel wakes a read that is
// already parked.
//
// design 124: `held` drops at the reader's own completion, before `join()`
// returns the byte count.
// EXPECT: success
// EXPECT-OUTPUT:
// 55
// 3

import std.net.{TcpStream}
import std.task.{yield_now}

struct Res { id: Int }
extension Res: NoCopy { func deinit(&var self) { print(self.id) } }

// The byte count of one read: 0 at EOF, -1 when the read failed or was cancelled.
// The match sits in a loop-free helper (SL-273).
func read_len(stream: &TcpStream) -> Int {
    match stream.read() {
        case Ok(chunk) -> chunk.len(),
        case Err(_) -> -1
    }
}

func reader(stream: TcpStream) -> Int {
    let held = Res(id: 55)      // deinit oracle
    var total = 0
    var going = true
    while going {
        let n = read_len(&stream)
        if n <= 0 {
            going = false               // cancelled at the park, or EOF
        } else {
            total = total + n
        }
    }
    return total
}

func main() {
    let (a, b) = try! TcpStream.pair()
    // Pre-load 3 bytes; the reader drains them, then parks on the empty socket.
    try! a.write("abc")

    var group = TaskGroup()
    let h = group.spawn(reader(move b))
    yield_now()         // the reader runs: it drains 3 bytes and parks
    h.cancel()          // the cancel wakes the parked read
    print(h.join())     // 3
}
