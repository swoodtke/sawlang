// Using a NoCopy value as an enum payload (no `move`) must be an error: the
// local binding and the enum payload would own the same resource. Enum payloads
// are one of the copy/move sites the value-transfer checkpoint now covers.
// See todo_jul26.md must-fix #1.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: NoCopy

struct FileHandle {
    fd: Int
}

extension FileHandle: NoCopy {
    func deinit(&var self) {
    }
}

enum Slot {
    case Full(handle: FileHandle),
    case Empty
}

func main() {
    let f = FileHandle(fd: 1)
    let s = Slot.Full(handle: f)   // should require `move f`
    match s {
        case Full(h) -> print(h.fd),
        case Empty -> print(0)
    }
}
