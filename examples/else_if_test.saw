// Test else if
// EXPECT: success
// EXPECT-OUTPUT:
// medium
// 2
// three

func main() {
    let x = 5

    // Basic else if chain
    if x < 3 {
        print("small")
    } else if x < 7 {
        print("medium")
    } else {
        print("large")
    }

    // else if as expression
    let result = if x == 1 {
        1
    } else if x == 5 {
        2
    } else {
        3
    }
    print(result)

    // Multiple else if
    let y = 3
    if y == 1 {
        print("one")
    } else if y == 2 {
        print("two")
    } else if y == 3 {
        print("three")
    } else {
        print("other")
    }
}
