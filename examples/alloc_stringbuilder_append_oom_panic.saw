// Design 123: `StringBuilder.append` is the infallible tier, so a refused grow
// panics and names its method. It used to call a Void-returning `grow`, ignore
// the refusal, and copy the bytes past the end of a buffer that had never
// grown — RS-1's shape, repeated verbatim in this file.
//
// The deny WINDOW (one allocation) rather than blanket denial is deliberate:
// `panic(msg)` assembles its message into a fresh allocation, so under blanket
// denial this would report the string allocator's own failure instead of
// `append`'s.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: StringBuilder.append: allocation failed

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int, deny: Int)
}

func main() {
    var b = StringBuilder(capacity: 8)
    b.append("saw")             // fits: 3 bytes + terminator
    print(b.len())              // 3

    // Refuse exactly the grow this append needs.
    __saw_rt_alloc_deny_after(0, 1)
    b.append("a much longer run of bytes")
    print(b.len())
}
