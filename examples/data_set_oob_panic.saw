// Design 130 accessor rule: `Data.set` panics out of range. It used to return a
// `Bool` nothing in the tree ever read, so a bad index wrote nothing and the
// caller carried on — the ignorable-sentinel shape design 92 rules out. `get`
// keeps its `None`-returning shape; only the direct setter panics.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: Data.set: index out of range

import std.data.*

func main() {
    var d = Data()
    d.push(10 as UInt8)
    d.push(20 as UInt8)
    d.set(0, 99 as UInt8)
    print(d.get(0)!)             // 99 — in range still writes
    if let _ = d.get(9) {
        print("unreachable")
    } else {
        print("none")            // `get` stays get-shaped
    }
    d.set(9, 7 as UInt8)         // past the end -> panic
}
