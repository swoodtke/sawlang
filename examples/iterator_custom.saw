// Test custom iterator with non-trivial logic
// EXPECT: success
// EXPECT-OUTPUT:
// 10
// 20
// 30

// Uses built-in Iterator interface from builtin.saw
// Define a custom multiplying iterator
struct Multiplier {
    current: Int
    count: Int
    factor: Int
}
extension Multiplier: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.current < self.count {
            self.current = self.current + 1
            self.current * self.factor
        } else {
            None
        }
    }
}
func main() {
    // Use custom iterator in for loop
    // Multiplier yields: 1*10, 2*10, 3*10 = 10, 20, 30
    for value in Multiplier(current: 0, count: 3, factor: 10) {
        print(value)
    }
}
