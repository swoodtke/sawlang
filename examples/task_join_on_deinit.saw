// Join-on-deinit (design 21 item 5/7): an unjoined Task is joined when it goes
// out of scope, so a task's work completes before its handle's scope exits.
// Deterministic by construction: fireAndForget never joins explicitly, but its
// Task local is dropped at return — joining the thread — so the write is
// guaranteed visible when main reads the counter afterward.
// EXPECT: success
// EXPECT-OUTPUT:
// 42

func fireAndForget(shared: Arc<Mutex<Int>>) {
    var t = spawn {
        shared.lock { &var c in
            c = c + 42
            true
        }
        true
    }
    // `t` goes out of scope here -> Task.deinit joins the thread.
}

func main() {
    let shared = Arc<Mutex<Int>>(value: Mutex<Int>(value: 0))
    fireAndForget(shared)
    shared.lock { &var c in
        print(c)   // 42, deterministic (the task finished at the join-on-deinit)
        true
    }
}
