// DF-182c: an `if let` / `guard let` over a `move` scrutinee whose continuation
// spans a suspension.
//
// Reading an owning value out of an Optional needs `move` (design 131), so this is
// the ordinary shape for consuming one — and inside a driven body it is a clean
// rejection: "`move` of the scrutinee of a suspension-spanning `if let` is not
// supported". `devtools/irdet` is written exactly this way.
//
// What blocks it: the `move` owes a frame drop-flag clear, and the split emits its
// value test as a synthesized `if let` dispatch that stores the unwrapped payload
// into a frame field. Putting the clear in both dispatch branches is the right
// order, but the STORE is a copy — which a NoCopy payload refuses outright, and an
// ExplicitCopy one would double-drop. The store has to become a move first; only
// then does the clear have a place to go.
//
// The deinit count is the assertion that matters when it lands: the value is made
// once, carried across a suspension, read, and dropped exactly once.
//
// EXPECT: success
// EXPECT-OUTPUT:
// id: 7
// deinits=1
// XFAIL: DF-182c a suspension-spanning `if let` over a `move` scrutinee is rejected by the coroutine transform

import std.task.*

static DEINITS: Atomic<Int> = Atomic(0)

struct Res {
    id: Int
}

extension Res: NoCopy {
    func deinit(&var self) {
        DEINITS.fetch_add(1)
    }
}

func make(id: Int) -> Res? {
    yield_now()
    if id > 0 {
        return Res(id: id)
    }
    None
}

func consume(id: Int) -> Int {
    var held = make(id)
    if let r = move held {
        yield_now()               // the continuation spans a suspension
        r.id
    } else {
        -1
    }
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(consume(7))
    print("id: {h.join()}")
    print("deinits={DEINITS.load()}")
}
