// Design 123: `Map.insert` is the infallible tier — its `V?` return means "was
// there a previous value", so it has nowhere to report an allocator refusal and
// panics instead. Before this it dropped the key and value on the floor,
// incremented `count` anyway, and returned `None` as if the insert had
// succeeded: the map then reported `len() == N` while `get()` answered None for
// every one of those keys.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: Map.insert: allocation failed

static BUDGET: Atomic<Int> = Atomic(64)

struct FailAlloc {}
extension FailAlloc: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        let left = BUDGET.load()
        if left <= 0 {
            return None
        }
        BUDGET.store(left - 1)
        GlobalAllocator().alloc(size, align)
    }
    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func main() {
    var m = Map<Int, Int, FailAlloc>()
    var i = 0
    while i < 6 {
        m.insert(i, i * 10)
        i = i + 1
    }
    print(m.len())          // 6 — the load factor tips on the next one

    BUDGET.store(0)
    m.insert(7, 70)         // rehash denied -> panic
    print(m.len())
}
