// design 102 item 2 (multi-threaded): a task io-parked on a permanently-idle fd in
// a `TaskGroup(threads: 2)` group is cancelled by a peer (via the Send cancel-word
// address) and unblocks. An idle worker polls the reactor on a bounded timeout, then
// its wake scan finds the parked frame cancelled and makes it runnable; the read
// re-checks `cancelled()` and returns the cancellation. Send-only frame (an owning
// stream, no buffer held across the suspend). Time-bounded — a hang is a failure.
// EXPECT: success
// EXPECT-OUTPUT: cancelled

import std.net.{TcpStream}

func parker(stream: TcpStream) -> Int {
    match stream.read() {           // parks on an idle read fd (never ready)
        case Ok(_) -> 0,
        case Err(_) -> -1           // the peer's cancel woke the parked read
    }
}

func canceller(addr: Int) unsafe -> Int {
    let p = addr as UnsafePointer<Bool>
    p[0] = true                  // peer-cancel from another worker thread
    return 0
}

func main() {
    let (a, b) = try! TcpStream.pair()        // peer `b`: never written, so `a` stays idle
    var g = try! TaskGroup(threads: 2)
    let hp = g.spawn(parker(move a))
    let addr = hp.cancel_addr()
    let _ = g.spawn(canceller(addr))
    let r = hp.join()
    if r == -1 {
        print("cancelled")
    } else {
        print("wrong {r}")
    }
    let _ = move b
}
