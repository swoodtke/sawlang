// Set<T> iteration + snapshot (design 54): the non-escaping `each` visitor
// (order-independent sum) and `to_vector()` sorted for deterministic output.
// Set.of builds a singleton. String elements exercise owning-key hashing.
// EXPECT: success
// EXPECT-OUTPUT:
// 6
// 1
// 2
// 3
// 1
// 1
// 2

func main() {
    var t = Set<Int>()
    t.insert(3)
    t.insert(1)
    t.insert(2)

    var sum = 0
    t.each { [&var sum] e in sum = sum + e }
    print(sum)                        // 6 (order-independent)

    var v = t.to_vector()
    v.sort()
    for e in v.iter() { print(e) }    // 1, 2, 3 (sorted)

    let one = Set<Int>.of(42)
    print(one.len())                  // 1
    if one.contains(42) { print(1) } else { print(0) }  // 1

    var ss = Set<String>()
    ss.insert("a")
    ss.insert("b")
    ss.insert("a")
    print(ss.len())                   // 2 (dedup)
}
