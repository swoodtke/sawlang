// Custom allocator through the public type parameter (design 37 item 4).
// `LoudAlloc` is a zero-field unit struct conforming to the stdlib `Allocator`
// trait; it forwards to `GlobalAllocator` but PRINTS on each alloc/dealloc, so dispatch
// is observable without any mutable state. A `Vector<Int, LoudAlloc>` routes
// its grow (alloc) and deinit (dealloc) through LoudAlloc, while a plain
// `Vector<Int>` (= `Vector<Int, GlobalAllocator>`) allocates through the silent GlobalAllocator —
// proving deinit routes to the ELEMENT's own allocator, not a fixed one.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// alloc 32
// 1
// dealloc 32

struct LoudAlloc {}
extension LoudAlloc: Allocator {
    unsafe func alloc(&self, size: Int, align: Int) -> UnsafePointer<Int8>? {
        print("alloc {size}")
        GlobalAllocator().alloc(size, align)
    }
    unsafe func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) {
        print("dealloc {size}")
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func main() {
    // GlobalAllocator-backed vector: alloc/dealloc are silent.
    var g = Vector<Int>()
    g.push(1)          // grow through GlobalAllocator — no print
    g.push(2)
    print(g.len())     // 2

    // LoudAlloc-backed vector: grow prints, deinit prints.
    var v = Vector<Int, LoudAlloc>()
    v.push(10)         // grow (cap 0 -> 4): "alloc 32"
    print(v.len())     // 1

    // Scope end (LIFO): v deinits first -> "dealloc 32" (LoudAlloc); then g
    // deinits silently through GlobalAllocator. Deinit routed to each vector's own A.
}
