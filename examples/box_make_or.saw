// MakeBoxOr — the fallible constructor (design 42 item 1, three-tier model tier
// 2). Success returns `Ok(Box)`; on allocator failure it returns
// `Err(AllocError)` carrying the request's size/align AND cleanly deinits the
// value (never leaks it). The failure path is forced with an always-None probe
// allocator and a deinit-printing payload — "gone 2" proves the clean drop.
// EXPECT: success
// EXPECT-OUTPUT:
// 7
// gone 2
// 8

struct Res { id: Int }
extension Res {
    func peek(&self) -> Int { self.id }
}
extension Res: Deinit {
    func deinit(&var self) { print("gone {self.id}") }
}

// Always fails: exercises the fallible factory's Err path deterministically.
struct NullAlloc {}
extension NullAlloc: Allocator {
    func alloc(&self, size: Int, align: Int) -> UnsafePointer<Int8>? { None }
    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) {}
}

func main() {
    // Success (Global, Int payload): Ok, value() reads 7.
    match Box<Int>.make_or(7) {
        case Ok(b) -> print(b.value()),   // 7
        case Err(e) -> print(e.size)
    }

    // Failure (NullAlloc, Deinit payload): the value is cleanly deinit'd inside
    // make_or's scope exit ("gone 2"), then Err carries size = sizeof(Res) = 8.
    match Box<Res, NullAlloc>.make_or(Res(id: 2)) {
        case Ok(b) -> print(b.peek()),
        case Err(e) -> print(e.size)      // gone 2, then 8
    }
}
