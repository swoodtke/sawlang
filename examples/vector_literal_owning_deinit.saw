// Design 61 L15: a Vector-context collection literal `[ov1, ov2]` with owning
// elements must move each element in exactly once (no residual temp aliasing the
// bound vector's buffer) and drop each exactly once at scope end.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 0
// 2

static DROPS: Atomic<Int> = Atomic(0)

struct Elem { id: Int }
extension Elem: Deinit {
    func deinit(&var self) { DROPS.fetch_add(1) }
}

func build() {
    let a = Elem(id: 1)
    let b = Elem(id: 2)
    let v: Vector<Elem> = [move a, move b]
    print(v.len())          // 2
    print(DROPS.load())     // 0 while alive
}

func main() {
    build()
    print(DROPS.load())     // 2 — each element dropped once at scope end
}
