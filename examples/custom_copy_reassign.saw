// Test that deinit is called before reassignment
// EXPECT: deinit 10
// EXPECT: copy called
// EXPECT: 42

struct RefCounted {
    value: Int
}

extension RefCounted: CustomCopy {
    func copy(self) -> RefCounted {
        print("copy called")
        RefCounted(value: self.value)
    }

    func deinit(var self) {
        print("deinit")
        print(self.value)
    }
}

func main() {
    let source = RefCounted(value: 42)
    var target = RefCounted(value: 10)
    target = source  // Should call deinit on old value (10), then copy from source
    print(target.value)
}
