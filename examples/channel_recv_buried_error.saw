// design 62 G3: a cooperative `receive()` buried in an expression position (not a
// top-level `let v = ch.receive()` / bare `ch.receive()`) is rejected cleanly by
// the coro transform rather than miscompiled.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: nested/expression position

import std.channel.{Channel}
func worker(ch: Channel<Int>) -> Int {
    let x = ch.receive() + 1   // receive buried in a binary expression
    return x
}

func main() {
    var group = TaskGroup()
    let ch = Channel<Int>()
    ch.send(5)
    let h = group.spawn(worker(ch.copy()))
    print(h.join())
}
