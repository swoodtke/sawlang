// A driven `case Pair(v, _)` releases the NAMED field and then the DISCARDED
// one after the arm, exactly as the sync twin does (SL:hazards C11, SL-513
// ruling B).
//
// Neither field dies at extraction. The named binding is registered in the arm's
// cleanup scope and released at the arm's end; the discarded field belongs to no
// scope and dies when the match completes, right behind it. The driven twin
// takes one code path to the same answer, because its hoisted scrutinee temp is
// take-read (`self.__headN.take()`) and so reaches codegen as an owned
// temporary under the ordinary consume model (design 247). The timing agrees by
// construction rather than by two release systems being kept apart. Its sibling
// (`coro_discarded_match_payload_released_at_extraction.saw`) reaches the same
// model through the all-`_` shapes.
// EXPECT: success
// EXPECT-OUTPUT:
// -- sync
// NEW t1
// NEW t2
// arm
// DEINIT t1
// DEINIT t2
// scope closed
// -- driven
// NEW t1
// NEW t2
// arm
// DEINIT t1
// DEINIT t2
// scope closed

import std.task.{yield_now}

struct Res { name: String }
extension Res: NoCopy {
    func deinit(&var self) { print("DEINIT {self.name}") }
}

struct Tag { cell: Arc<Res> }
@synthesize
extension Tag: Copy {}

enum Both { case Pair(a: Tag, b: Tag) }

func mk_tag(id: Int) -> Tag {
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func mk_tag_s(id: Int) -> Tag {
    yield_now()
    print("NEW t{id}")
    Tag(cell: try! Arc<Res>(value: Res(name: "t{id}")))
}

func sync_mixed() {
    match Both.Pair(a: mk_tag(1), b: mk_tag(2)) {
        case Pair(v, _) -> { print("arm") }
    }
    print("scope closed")
}

func driven_mixed() {
    match Both.Pair(a: mk_tag_s(1), b: mk_tag(2)) {
        case Pair(v, _) -> { print("arm") }
    }
    print("scope closed")
}

func main() {
    print("-- sync")
    sync_mixed()
    print("-- driven")
    __saw_drive(driven_mixed())
}
