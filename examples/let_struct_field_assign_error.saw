// Design 40 item 6 (L11): assigning to a field through a `let` binding was
// silently accepted. It must error like element assignment on a `let` array.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: cannot assign to field of immutable variable `p`
struct Point {
    x: Int
    y: Int
}

func main() {
    let p = Point(x: 1, y: 2)
    p.x = 5
    print(p.x)
}
