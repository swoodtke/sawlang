// Conformance row R41 — the explicit `[&self]` spelling joins the frame-pointer
// capture rule rather than stepping around it. A capture that lowers to a pointer
// into the enclosing frame is legal only in a closure passed directly to a
// non-escaping parameter, and writing the `&` out loud says nothing new about
// where the closure goes.
//
// Row R36 is the implicit spelling of this same refusal. Both are here because a
// new spelling that bypassed the rule would be a hole with an author's signature
// on it: the escaping env outlives the method's frame either way.
// XFAIL: DF-216g `[&self]` is not yet a spelling the grammar accepts, so this reports a parse error rather than the escape refusal
// EXPECT: error
// EXPECT-ERROR-CONTAINS: an escaping closure cannot capture `self`
// EXPECT-ERROR-CONTAINS: a method's receiver is a borrow of storage the CALLER owns

struct Counter { n: Int }

extension Counter {
    func handOut(&self) -> () -> Int {
        return { [&self] in self.n + 3 }
    }
}

func main() {
    let c = Counter(n: 5)
    let f = c.handOut()
    print("{}", f())
}
