// Conformance row C04 — a `@synthesize`d memberwise comparison that RECURSES
// into a member's hand-written conformance
//
// `Holder` writes no comparison of its own, so nothing at its declaration hints
// that a consuming body is in the tree — the memberwise emitter reaches
// `Tag.equals`/`Tag.compare` and hands each a borrow. The refusal is therefore
// TRANSITIVE: it follows members, payloads and elements into whatever
// hand-written body the comparison would actually run (DF-216b).
// XFAIL: DF-216b a `@synthesize`d memberwise comparison recurses into a member's consuming hand-written body, and the refusal must follow it
// EXPECT: error
// EXPECT-ERROR-CONTAINS: takes `other` by value, but the operator passes a borrow

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
extension Tag: Equatable {
    func equals(&self, other: Tag) -> Bool {
        let taken = move other
        self.id == taken.id
    }
}
extension Tag: Comparable {
    func compare(&self, other: Tag) -> Ordering {
        let taken = move other
        if self.id < taken.id { Ordering.Less }
        else if self.id > taken.id { Ordering.Greater }
        else { Ordering.Equal }
    }
}

struct Holder { tag: Tag }
extension Holder: NoCopy {}
@synthesize
extension Holder: Equatable {}
@synthesize
extension Holder: Comparable {}

func main() {
    let a = Holder(tag: Tag(id: 9))
    let b = Holder(tag: Tag(id: 3))
    if a == b { print("eq") }
    if a > b { print("gt") }
}
