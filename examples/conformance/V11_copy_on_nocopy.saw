// Conformance row V11 — `.copy()` on a NoCopy type
//
// `.copy()` is the ExplicitCopy tier's opt-in, so a NoCopy type does not have
// one. The existing Vector pin refuses it as a missing METHOD on a generic
// bound; this is the direct refusal on the value.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: is not Copy; `.copy()` requires a trivially-copyable, ImplicitCopy, or ExplicitCopy type

func main() {
    let b = Box<Int>.make(5)
    let c = b.copy()
    print(1)
}
