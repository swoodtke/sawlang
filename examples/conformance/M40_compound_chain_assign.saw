// Conformance row M40 — `o?.n += v` is the compound spelling of design 111's
// chain assignment (DF-225l)
//
// `o?.n = v` writes the payload field in place iff every hop is non-None, and
// skips the RHS entirely on short-circuit. The compound form means the same
// thing about the same storage and was a PARSE ERROR: the parser routed an
// OptionalEvalExpr target to the chain-assignment node on the plain branch
// only, so `o?.n += 5` died with "Invalid compound assignment target" — a
// message about the shape of a target that is fine.
//
// Both halves of the contract are pinned here: the write lands on the Some
// path, and on the None path neither the write NOR the right-hand side runs
// (the call that would bump `calls` is skipped, exactly as it is for `=`).
// XFAIL: DF-225l `o?.n += 5` is a parse error while `o?.n = 5` works — the parser's OptionalEvalExpr hoist (design 227 unit 4)
// EXPECT: success
// EXPECT-OUTPUT: some 6 calls 1
// EXPECT-OUTPUT: empty calls 1

struct Cell { n: Int }

func rhs(log: &var Int) -> Int {
    log = log + 1
    return 5
}

func main() {
    var calls = 0

    var some: Cell? = Cell(n: 1)
    some?.n += rhs(log: &var calls)
    print("some {some!.n} calls {calls}")

    var empty: Cell? = None
    empty?.n += rhs(log: &var calls)
    print("empty calls {calls}")
}
