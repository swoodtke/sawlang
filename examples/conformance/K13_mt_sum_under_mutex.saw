// Conformance row K13 — MT group accumulating into an `Arc<Mutex<Int>>`
//
// The data-race smoke row: an MT group accumulating a PER-TASK amount into a
// shared `Arc<Mutex<Int>>`, which is the sanctioned way to share mutable state
// across worker threads. The amount is the task's own parameter, so the lock
// body CAPTURES a frame-resident local of the driven function — the shape the
// coroutine transform used to refuse (DF-191a), leaving the canonical
// shared-counter idiom with no legal spelling at all: the diagnostic's way out
// was to bind the closure to a `let` first, and `Mutex.lock` takes a `sync`
// closure LITERAL.
//
// Asserted on the SUM, never on interleaving: four tasks add 1, 2, 3 and 4, so
// the total is 10 whatever order the workers run in.
// EXPECT: success
// EXPECT-OUTPUT:
// total 10

import std.mutex.*

func add(shared: Arc<Mutex<Int>>, n: Int) -> Int {
    shared.lock({ &var c in
        c = c + n
        c
    })
}

func main() {
    let shared = Arc<Mutex<Int>>(value: Mutex<Int>(value: 0))
    var group = TaskGroup(threads: 2)
    let a = group.spawn(add(shared.copy(), 1))
    let b = group.spawn(add(shared.copy(), 2))
    let c = group.spawn(add(shared.copy(), 3))
    let d = group.spawn(add(shared.copy(), 4))
    let _ = a.join()
    let _ = b.join()
    let _ = c.join()
    let _ = d.join()
    print("total {shared.lock({ &var total in total })}")
}
