// Conformance row C02 — `==` and `!=` on a NoCopy operand whose `equals` is
// hand-written
//
// The equality half of C01's rule. `Equatable.equals(&self, other: Self)` takes
// `other` by value; `==`/`!=` pass a borrow. A body that does `move other`
// destroys an operand the caller still owns (DF-216b).
// EXPECT: error
// EXPECT-ERROR-CONTAINS: takes `other` by value, but the operator passes a borrow

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
extension Tag: Equatable {
    func equals(&self, other: Tag) -> Bool {
        let taken = move other
        self.id == taken.id
    }
}

func main() {
    let a = Tag(id: 9)
    let b = Tag(id: 3)
    if a == b { print("eq") }
    if a != b { print("ne") }
}
