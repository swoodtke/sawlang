// Conformance row K19 — a reference argument into a MULTI-THREADED group
//
// A spawned task's frame is `Send` whatever its group, and a reference is
// judged by Rust's rule: `&var T` is `Send` when `T` is, so `&var Int`
// crosses to a worker thread (SL-788). The extent rule keeps `n` alive and
// out of the spawner's reach until the join, as for a single-threaded group,
// so the task's write is what the join sees.
// EXPECT: success
// EXPECT-OUTPUT:
// task saw 8

import std.task.*

func bump(n: &var Int) -> Int {
    yield_now()
    n = n + 1
    n
}

func main() {
    var n = 7
    var group = try! TaskGroup(threads: 2)
    let h = group.spawn(bump(&var n))
    print("task saw {h.join()}")
}
