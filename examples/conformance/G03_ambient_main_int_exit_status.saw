// Conformance row G03 — a suspending `main() -> Int` that also SPAWNS returns
// its value as the process exit status
//
// A spawn puts main on the ambient scheduler instead of the single-frame
// executor: main's frame is boxed erased and enqueued as the root of a scope
// that lives for the whole program. The erasure is what makes this a separate
// row — the typed `__result` is unreachable once the frame is a
// `Box<any Resumable>`, so the value has to travel out some other way.
// XFAIL: DF-220b — the ambient entry executor enqueues main's frame with a
// `__VoidCell`, so the typed result is unreachable after erasure
// EXPECT: success
// EXPECT-EXIT: 7
// EXPECT-OUTPUT: spawned 3

import std.task.{yield_now}

func work() -> Int {
    yield_now()
    3
}

func main() -> Int {
    var g = TaskGroup()
    let h = g.spawn(work())
    yield_now()
    print("spawned {h.join()}")
    7
}
