// Conformance row C09 — control: a NoCopy operand whose comparison tree is
// FULLY synthesized keeps its operators, and answers correctly
//
// A synthesized body reads fields and recurses; it never consumes anything.
// That was the carve-out DF-216b's stopgap needed so a blanket "NoCopy operands
// cannot be compared" would not make every `@synthesize`d move-only type
// incomparable. Under `other: &Self` (design 239) the carve-out is not load-
// bearing any more — C01/C02 show the HAND-WRITTEN tree comparing too — and
// this row stays as the control that the derived bodies themselves still read
// their operand through the reference rather than taking it.
// EXPECT: success
// EXPECT-OUTPUT:
// ne
// gt
// le
// drop 3
// drop 9

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
@synthesize
extension Tag: Equatable {}
@synthesize
extension Tag: Comparable {}

func main() {
    let a = Tag(id: 9)
    let b = Tag(id: 3)
    if a != b { print("ne") }
    if a > b { print("gt") }
    if b <= a { print("le") }
}
