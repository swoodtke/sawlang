// Conformance row V54 — Option A's EVERY-PATH-OR-NO-PATH rule, per field
//
// design 260 §3. `move self.<field>` is legal inside a consuming body because
// the referent is the callee's to END: the caller's binding is moved-from on
// return and releases nothing, so a partially-emptied receiver is never
// observable anywhere. What makes that flag-free is the all-paths rule — the
// end-of-body release covers exactly the fields no path moved, decided
// statically, so a field moved on SOME paths and not others is refused.
//
// The rule is PER FIELD and the fields are independent, so a CONDITIONAL SPLIT
// (field `a` on one branch, field `b` on the other) fails the test for BOTH and
// is named twice. That is v1's excluded drop-flag shape.
//
// EXPECT: error
// EXPECT-ERROR-CONTAINS: field `a` is moved out of `self` on some paths of `pick` but not others
// EXPECT-ERROR-CONTAINS: field `a` is moved out of `self` on some paths of `split` but not others
// EXPECT-ERROR-CONTAINS: field `b` is moved out of `self` on some paths of `split` but not others
// EXPECT-ERROR-CONTAINS: a consuming body decides each field on EVERY path or NO path

struct Tag { id: Int }
extension Tag: NoCopy {}

struct Pair { a: Tag, b: Tag }
extension Pair: NoCopy {}
extension Pair {
    func pick(&var self, hot: Bool) consumes -> Tag {
        if hot { move self.a } else { Tag(id: 0) }
    }
    func split(&var self, hot: Bool) consumes -> Tag {
        if hot { move self.a } else { move self.b }
    }
}

func main() {
    var p = Pair(a: Tag(id: 1), b: Tag(id: 2))
    print("{}", (move p).pick(hot: true).id)
}
