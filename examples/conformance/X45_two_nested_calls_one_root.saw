// Conformance row X45 — two nested calls borrowing one root
//
// Neither reference is written in the outer argument list, so nothing in the
// outer call names the conflict: `combine(bump(&var n), scale(&var n))` is two
// exclusive borrows of `n` live over one call expression. Probed Aug 10 before
// design 199: it compiled and answered 15, i.e. left-to-right evaluation, with
// the other order equally available. Joining a nested call's references to the
// outer access set catches the pair against each other, not only against a
// sibling written at the top level.
// XFAIL: DF-188j the Law of Exclusivity does not see a reference created by a nested call, so two nested calls may both borrow one root and the answer is argument evaluation order
// EXPECT: error
// EXPECT-ERROR-CONTAINS: exclusive access violation
// EXPECT-ERROR-CONTAINS: `n` is borrowed by a nested call in this argument list while `n` is also accessed by reference in the same call

func bump(n: &var Int) -> Int {
    n = n + 5
    n
}

func scale(n: &var Int) -> Int {
    n = n * 2
    n
}

func combine(a: Int, b: Int) -> Int { a + b }

func main() {
    var n = 0
    print(combine(bump(&var n), scale(&var n)))
}
