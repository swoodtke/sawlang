// Conformance row C03 — `==` in a MATCH-ARM GUARD on a NoCopy operand
//
// A guard is an ordinary expression position, so it reaches the same lowering
// C02 covers. The row exists because a guard is where the comparison is least
// visible — nothing about `case n if a == b` looks like a call at all. Under
// `other: &Self` (design 239) there is no transfer at any of those positions,
// so the guard compares and both operands survive it.
// EXPECT: success
// EXPECT-OUTPUT:
// different
// drop 3
// drop 9

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
extension Tag: Equatable {
    func equals(&self, other: &Self) -> Bool {
        self.id == other.id
    }
}

func main() {
    let a = Tag(id: 9)
    let b = Tag(id: 3)
    let verdict = match a.id {
        case n if a == b -> "same",
        case _ -> "different"
    }
    print(verdict)
}
