// Conformance row C07 — `==` / `>` inside a GENERIC body under a
// `T: Equatable` / `T: Comparable` bound, instantiated at a NoCopy conformer
// whose body consumes `other`
//
// The seventh position of DF-216b's matrix, and the one the operator gate
// could not see: a generic body is checked ONCE with `T` abstract (tier
// `abstract`, no conformance to inspect) and was not re-checked per
// instantiation, so `Tag` never reached the comparison chokepoint.
//
// CLOSED by design 219 wave C. The objection was that judging the type ARGUMENT
// meant six independent call-site checks rather than one funnel — and wave C
// built that funnel for the copy tier, so the comparison rule rides it: the
// body records what it NEEDS (`T`'s comparison must not consume its operand),
// and the ONE discharge point runs DF-216b's existing transitive walk on the
// concrete argument. `@synthesize`d conformers pass, `Map`'s Copy-gated keys
// pass, and the refusal reports the same sentence the concrete positions do.
//
// Row C12 — the EIGHTH position, a Copy operand the stopgap's tier condition
// excludes — stays open: it is a question about the tier condition itself, not
// about where the type is known, and `other: &Self` is its fix.
// EXPECT: error
// EXPECT-ERROR-CONTAINS: takes `other` by value, but the operator passes a borrow

struct Tag { id: Int }
extension Tag: NoCopy {
    func deinit(&var self) { print("drop {self.id}") }
}
extension Tag: Equatable {
    func equals(&self, other: Tag) -> Bool {
        let taken = move other
        self.id == taken.id
    }
}
extension Tag: Comparable {
    func compare(&self, other: Tag) -> Ordering {
        let taken = move other
        if self.id < taken.id { Ordering.Less }
        else if self.id > taken.id { Ordering.Greater }
        else { Ordering.Equal }
    }
}

func same<T: Equatable>(a: &T, b: &T) -> Bool { a == b }
func bigger<T: Comparable>(a: &T, b: &T) -> Bool { a > b }

func main() {
    let a = Tag(id: 9)
    let b = Tag(id: 3)
    if same<Tag>(&a, &b) { print("eq") }
    if bigger<Tag>(&a, &b) { print("gt") }
}
