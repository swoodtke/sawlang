// Conformance row U02 — a plain `struct UnsafeDefaults` gets no unsafe semantics
//
// The name is a CONSEQUENCE of `unsafe struct`, never a cause: a plain struct
// called `UnsafeDefaults` is an ordinary safe type and touching it declares
// nothing. Acceptance is the whole claim — the value it prints is incidental.
// EXPECT: compiles

struct UnsafeDefaults { n: Int }
func main() {
    let d = UnsafeDefaults(n: 1)
    print(d.n)
}
