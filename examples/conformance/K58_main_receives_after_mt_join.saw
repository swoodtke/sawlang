// Conformance row K58 — control: main receives after `join()` returned
//
// The fork-join contract's own cell, and the one the pre-fix engine DID keep:
// a join drains the group, so whatever its tasks sent is in the channel by the
// time the join returns. The live pool must not weaken it — `join()` still
// means "this task is complete", so a value the task sent before finishing is
// readable immediately afterwards with no further ceding.
//
// EXPECT: success
// EXPECT-OUTPUT:
// main got 6

import std.channel.{Channel}

func feed(inbox: Channel<Int>, v: Int) {
    try! inbox.send(v)
}

func main() {
    let inbox = try! Channel<Int>()
    var workers = try! TaskGroup(threads: 2)
    let h = workers.spawn(feed(inbox.copy(), 6))
    h.join()
    let got = try! inbox.receive()
    print("main got {}", got)
}
