// Design 130 accessor rule (M5): `Vector.set` panics out of range. It was a
// silent no-op, which lost twice — the caller got an unmodified vector with no
// signal, and `value` is consumed by the call either way, so the element it was
// handed was dropped on the floor.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: Vector.set: index out of range

func main() {
    var v: Vector<Int> = [10, 20]
    v.set(0, 99)
    print(v.get(0)!)             // 99 — in range still replaces
    print(v.get(1)!)             // 20 — untouched
    v.set(99, 7)                 // past the end -> panic
}
