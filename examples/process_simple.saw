// Test process execution - Command.run(), Command.output()
// EXPECT: success
// EXPECT-OUTPUT: stdout: hello
// EXPECT-OUTPUT: success: true
// XFAIL: Command.output() returns empty stdout; capture is lost in std/process.saw

func main() {
    // Test capturing output from printf (no trailing newline)
    var cmd = Command(program: "/bin/echo")
    cmd.arg("-n")
    cmd.arg("hello")

    if let result = cmd.output() {
        let out = result.stdout
        let ok = result.success()
        print("stdout: {out}")
        print("success: {ok}")
    } else {
        print("command failed")
    }
}
