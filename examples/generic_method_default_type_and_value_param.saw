// XFAIL: DF-217d a generic STATIC with BOTH a default type argument and a
// default value, called with no arguments, is an internal compiler error
//
// `func probe<U = Int>(other: U = 7)` on an extension is a STATIC (no
// receiver), and the type-spelled zero-arg call dies
// `internal compiler error: Undefined static method: Plain.probe` — the
// generic static with a default type argument never registers where the
// type-spelled lookup searches. The free-function twin on the line above
// takes the identical signature and is clean, so nothing about
// defaults-driving-inference (design 108) is at fault.
//
// RE-SPELLED Aug 18: the original pin called `h.probe()` through an
// INSTANCE, which DF-217q has since ruled a clean refusal — that spelling
// could never XPASS again, so the pin moved to the one legal call shape.
// Member of the DF-216c family (generic method calls are broken on every
// spelling).
// EXPECT: success
// EXPECT-OUTPUT:
// free 5
// method 5

struct Plain { dummy: Int }

extension Plain {
    func probe<U = Int>(other: U = 7) -> Int { 5 }
}

func probe_free<U = Int>(other: U = 7) -> Int { 5 }

func main() {
    print("free {probe_free()}")
    print("method {Plain.probe()}")
}
