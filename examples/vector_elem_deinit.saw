// Brief 14 item 5: now that `Vector<R>` for a non-Copy `R` is constructible,
// the next gap becomes expressible -- a Vector does not run its elements'
// deinit when it is dropped. Here `R` is Deinit and prints its id on cleanup;
// the element pushed into the vector should print `7` when `v` goes out of
// scope at the end of main, after the `100` marker.
//
// This does NOT yet happen (element deinits are never invoked; and for a
// non-Copy element type the whole ExplicitCopy/deinit extension is gated off),
// so the `7` line is missing. That element-deinit gap is out of scope for
// brief 14 -- tracked here as an XFAIL extending the tech-debt ledger.
// EXPECT: success
// EXPECT-OUTPUT:
// 100
// 7
// XFAIL: Vector does not run element deinits on drop (element-deinit gap, brief 14 item 5)

struct R {
    id: Int
}

extension R: Deinit {
    func deinit(&var self) {
        print(self.id)
    }
}

func main() {
    var v = Vector<R>()
    let r = R(id: 7)
    v.push(move r)
    print(100)
}
