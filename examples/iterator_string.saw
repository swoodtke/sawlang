// Test custom iterator returning String values
// EXPECT: hello
// EXPECT: world

struct Words {
    index: Int
}

extension Words: Iterator {
    type Item = String

    func next(var self) -> String? {
        if self.index < 2 {
            self.index = self.index + 1
            if self.index == 1 {
                "hello"
            } else {
                "world"
            }
        } else {
            None
        }
    }
}

func main() {
    for word in Words(index: 0) {
        print(word)
    }
}
