// DF-181a, the half design 182 could not land: `Command.output()` still holds the
// executor thread for the child's whole lifetime. Both blocking calls the design-181
// audit found are exercised here — the child writes NOTHING for a second (so the
// drain sits in `read` on a blocking pipe) and only then exits (so the reap sits in
// `waitpid`).
//
// Task B records when it first gets scheduled. It is runnable from the moment it is
// spawned, so on a cooperative `output()` its first tick lands immediately; today it
// lands at ~1000 ms.
//
// Making `output()` suspending is what fixes this. DF-182e used to be the
// blocker and is closed (design 187 unit 9): a frame holding a `Data` or a
// `Vector` across a suspension reaches a multi-threaded TaskGroup now, which is
// what `devtools/irdet` needs. Design 187 unit 11 built the rest — the drain as
// a `blocking` extern the offload runs on a worker thread, the reap on `run()`'s
// park loop as a shared method — and MEASURED this test flipping. It is still
// xfail because irdet then stops compiling on DF-187b, a pre-existing transform
// bug in a shape irdet happens to be written in; see that finding for what unit
// 11 already knows.
//
// EXPECT: success
// EXPECT-OUTPUT:
// sibling: concurrent
// captured: done
// -- done
// XFAIL: DF-181a output half - Command.output blocks the executor thread in read+waitpid (unit 11 built, blocked on DF-187b)

import std.process.*
import std.task.*
import std.time.*

static STARVED_MS: UInt64 = 400

func capture_child() -> String {
    var c = Command(program: "/bin/sh")
    c.arg("-c")
    c.arg("sleep 1; echo done")
    if let out = c.output() {
        return out.stdout.trim()
    }
    "<no output>"
}

func first_tick(start: Instant) -> UInt64 {
    start.elapsed().as_millis()
}

func main() {
    let start = Instant.now()
    var group = TaskGroup()
    let child = group.spawn(capture_child())
    let sibling = group.spawn(first_tick(start))

    let when = sibling.join()
    let text = child.join()

    if when < STARVED_MS {
        print("sibling: concurrent")
    } else {
        print("sibling: starved ({when} ms)")
    }
    print("captured: {text}")
    print("-- done")
}
