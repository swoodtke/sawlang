// XFAIL: DF-158b a suspending call in a Void body's TAIL position is rejected
//
// `func f() { yield_now() }` is a Void task body whose only statement the
// parser makes the block's TAIL EXPRESSION. The coroutine transform lowers a
// tail through `_rewrite_expr`, which has no state to split into, so the call
// is rejected as "a nested/expression position" — a message about a shape the
// author did not write. Adding any statement after it (`return`, another call)
// compiles and runs, which is the tell: the call is fine, its position in the
// block is what the transform cannot see.
//
// Void is the whole scope of the bug. A body returning a value has a real
// result to compute from its tail; a Void one has nothing to store, so the tail
// should lower exactly as a statement would. Found while writing design 158's
// slot-churn test, whose short Void task is this shape.
// EXPECT: success
// EXPECT-OUTPUT:
// ok

import std.task.*

func tail_only() {
    yield_now()
}

func main() {
    var g = TaskGroup()
    let b = g.spawn(tail_only())
    b.join()
    print("ok")
}
