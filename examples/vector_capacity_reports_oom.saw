// Conformance row A04 — `Vector(capacity:)` is a FALLIBLE CONSTRUCTOR
// (design 234, over DF-245a's `Result<Self, E>` init form): on success an owned
// vector, on allocator exhaustion an `Err` carrying the failed request's
// size/align context. It was `Vector.try_with_capacity` beside a panicking
// `Vector(capacity:)` until the flip retired the pair into one constructor.
// EXPECT: success
// EXPECT-OUTPUT:
// ok
// 3
// err
// 8000000000000000000
// 8

func main() {
    // Success path: allocate capacity, fill it, use it.
    match Vector<Int>(capacity: 4) {
        case Ok(v) -> {
            var vec = move v
            try! vec.push(10)
            try! vec.push(20)
            try! vec.push(30)
            print("ok")
            print(vec.len())     // 3
        },
        case Err(e) -> print("unexpected-err")
    }

    // Failure path (deterministic): 1e18 elements * 8 bytes/elem = 8e18 bytes,
    // which is below Int64 max (no multiply overflow) yet far beyond what the
    // hosted allocator can satisfy, so malloc returns NULL -> GlobalAllocator.alloc
    // yields None -> the factory returns Err(AllocError) with size context.
    match Vector<Int>(capacity: 1000000000000000000) {
        case Ok(v) -> {
            let vec = move v
            print("unexpected-ok")
        },
        case Err(e) -> {
            print("err")
            print(e.size)        // 8000000000000000000  (bytes requested)
            print(e.align)       // 8                     (alignof<Int>)
        }
    }
}
