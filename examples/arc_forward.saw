// Arc payload method forwarding (design 21b E2). An immutable `&self` method
// on the payload is callable through the Arc: the call borrows the control
// block's payload slot (sound — a live strong ref pins the payload).
// The `Arc<Mutex<T>>` idiom composes: arc.lock forwards to Mutex.lock.
// EXPECT: success
// EXPECT-OUTPUT:
// 42
// 7

import std.mutex.{Mutex}
struct Counter {
    n: Int
}

extension Counter {
    func peek(&self) -> Int {
        self.n
    }
}

func main() {
    // Forward an ordinary &self method through Arc<Counter>.
    let ac = Arc<Counter>(value: Counter(n: 42))
    print(ac.peek())   // 42

    // Forward Mutex.lock through Arc<Mutex<Int>> and mutate under the lock.
    let shared = Arc<Mutex<Int>>(value: Mutex<Int>(value: 0))
    var i = 0
    while i < 7 {
        shared.lock { &var c in
            c = c + 1
            true
        }
        i = i + 1
    }
    shared.lock { &var c in
        print(c)   // 7
        true
    }
}
