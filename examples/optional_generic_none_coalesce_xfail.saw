// Design 174 — DF-146l trigger site 2. A bare `None` as the `??` RHS against a
// nested optional ICEs. The LHS `m["x"]` is an `Int??`, so the RHS should adopt
// the inner type `Int?`; instead the literal reaches codegen untyped:
//
//   internal compiler error: None literal has no type information
//
// Workaround today: an annotated `let absent: Int? = None` as the RHS.
// EXPECT: success
// EXPECT-OUTPUT:
// missing inner-absent
// present 1
// -- done
// XFAIL: DF-146l None literal as a `??` RHS at a nested optional ICEs

func main() {
    var m = Map<String, Int?>()
    let a: Int? = 1
    let _ = m.insert("a", a)

    let missing = m["x"] ?? None
    if let value = missing { print("missing {value}") } else { print("missing inner-absent") }

    let present = m["a"] ?? None
    if let value = present { print("present {value}") } else { print("present inner-absent") }
    print("-- done")
}
