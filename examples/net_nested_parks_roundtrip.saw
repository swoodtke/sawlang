// design 85: the reduced repro. A spawned worker makes TWO nested suspending
// FREE-function calls in sequence — read_n (parks on an empty socket) THEN
// write_hi (parks on would-block) — the exact shape that hung before the
// variadic-`fcntl` fix (a socket whose O_NONBLOCK was set through a mis-passed
// variadic arg would intermittently BLOCK, wedging the first read). Deterministic
// byte round-trip over a socketpair: the server reads the client's "hi", echoes
// "hi" back; the client verifies the echo. Asserts counts + content, never
// interleaving. Loopback only.
// EXPECT: success
// EXPECT-OUTPUT:
// 2
// 1

import std.net.{TcpStream}

func read_n(stream: &TcpStream) -> Int {
    let chunk = try! stream.read()     // park 1: until the peer sends
    chunk.len()
}

func write_hi(stream: &TcpStream) -> Int {
    try! stream.write("hi")            // park 2: until writable
    2
}

// The worker: read (nested, parks) THEN write (nested, parks) — sub-frame 1 drives
// to completion across a park, sub-frame 2 is entered and driven across its own park.
func server(stream: TcpStream) -> Int {
    let n = read_n(&stream)          // nested sub-frame 1 (parks, then completes)
    let _ = write_hi(&stream)        // nested sub-frame 2 (entered post-re-entry)
    return n
}

func client(stream: TcpStream) -> Int {
    let _ = write_hi(&stream)        // send "hi" (nested, parks)
    let n = read_n(&stream)          // read the echo back (nested, parks)
    if n == 2 { 1 } else { 0 }
}

func main() {
    let (a, b) = try! TcpStream.pair()
    var group = TaskGroup()
    let hs = group.spawn(server(move a))
    let hc = group.spawn(client(move b))
    print(hs.join())     // 2 bytes read by the server
    print(hc.join())     // 1 = the echo round-tripped
}
