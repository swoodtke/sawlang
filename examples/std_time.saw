// std.time (design 57): Duration accessors + round-trip, Comparable ordering,
// Printable human form, monotonic Instant (non-negative elapsed), and a
// wall-clock sanity check.
// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 1420
// 1420000000
// true
// 1.42s
// 230ms
// true
// true
// true

func main() {
    // Duration round-trip and accessors.
    let d = Duration.from_millis(1420)
    print(d.secs())        // 1
    print(d.millis())      // 1420
    print(d.nanos())       // 1420000000

    let a = Duration.from_secs(2)
    print(a > d)           // true (2s > 1.42s)

    // Printable human form.
    print("{d}")           // 1.42s
    print("{Duration.from_millis(230)}")  // 230ms

    // Monotonic instant: elapsed is non-negative.
    let start = Instant.now()
    let e = start.elapsed()
    print(e.nanos() >= (0 as Int64))   // true

    // duration_since between two ordered instants.
    let later = Instant.now()
    let span = later.duration_since(start)
    print(span.nanos() >= (0 as Int64))   // true

    // Wall clock is past a fixed historical timestamp (2020-01-01 = 1577836800).
    print(unix_timestamp() > (1577836800 as Int64))   // true
}
