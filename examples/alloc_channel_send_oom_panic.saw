// Design 123 / review H8: `Channel.send` returned `Void` and wrapped the whole
// enqueue in an unguarded `if let node = alloc(...)`. On allocator exhaustion
// the message was consumed, destroyed and never delivered — no signal to the
// sender, and the receiver simply waited. That is the exact shape the
// never-hide-errors rule exists to forbid.
//
// `send` is the infallible tier and panics now; `try_send` is the twin.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: Channel.send: allocation failed

import std.channel.*

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
}

func main() {
    let ch = Channel<Int>()
    try! ch.send(1)
    print(ch.try_receive()!)        // 1 — an ordinary round trip

    // Refuse everything from here, the queue node this send needs included.
    __saw_rt_alloc_deny_after(0)
    try! ch.send(2)
    print("delivered")
}
