// EXPECT: success
// EXPECT-OUTPUT:
// 1
// 2
// 3
// 4
// 5
// 6

// The ordering operators `< <= > >=` desugar to Comparable's `compare`
// (design 48). Integer types are builtin-Comparable and lower directly.
func main() {
    if 1 < 2 { print(1) }
    if 2 > 1 { print(2) }
    if 3 <= 3 { print(3) }
    if 3 >= 3 { print(4) }
    if not (5 < 5) { print(5) }
    if not (5 > 5) { print(6) }
}
