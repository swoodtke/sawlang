// `Channel.receive()` drives correctly at ANY call depth below a spawned root —
// the skill's own guarantee ("a suspending reactor method drives correctly at
// ANY NESTING DEPTH", designs 96/104) — including through ONE helper frame,
// which is the shape every reusable wrapper takes (a semaphore type's
// `acquire()`, a protocol codec's `read_frame()`).
//
// DF-203b, fixed by design 206, and NOT in the G3 lowering the finding
// suspected. `acquire`'s only suspension is a channel `receive()`, a std
// method — and the entry compile has no effect node for a std method, so
// `acquire` was judged suspension-free and never joined the coroutine
// transform's driven closure. Design 96 had already patched the one consumer of
// that blind spot it knew about, the structural free-function scan, but that
// scan skips `is_chan_recv` calls (correctly: a receive is lowered inline, never
// as a method sub-frame), so this shape fell through both. With no frame,
// `receive()` compiled to the monomorphized library body — a
// `try_receive`/`yield_now` loop whose `yield_now` codegens to NOTHING outside a
// frame — and worker 1 spun on it at 100% forever, which is `in 0` and then
// silence. Found by the design-203 dogfood limiter program (a Limiter struct
// wrapping the channel; a free function reproduces it too, so it is the extra
// frame, not `&self`).
// EXPECT: success
// EXPECT-OUTPUT:
// in 0
// out 0
// in 1
// out 1

import std.task.*
import std.channel.{Channel}

func acquire(ch: Channel<Int>) {
    let _ = try! ch.receive()
}

func worker(id: Int, ch: Channel<Int>) {
    acquire(ch)
    print("in {}", id)
    yield_now()
    print("out {}", id)
    try! ch.send(1)
}

func main() {
    var ch = try! Channel<Int>()
    try! ch.send(1)
    var group = TaskGroup()
    var k = 0
    while k < 2 {
        let _ = group.spawn(worker(k, ch))
        k = k + 1
    }
}
