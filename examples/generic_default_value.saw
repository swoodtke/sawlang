// Design 108: a generic function/method whose type-parameter-typed parameter
// carries a DEFAULT VALUE (`func f<T>(a: Int, b: T = 0)`). This ICE'd with
// `list index out of range` (the default was never materialized at the call, so
// the call emitted too few args). Now the default type-checks against the
// INSTANTIATED `T` per call, and when `T` is otherwise undetermined the default
// DRIVES inference (`f(1)` infers `T = Int` from `b: T = 0`). Covers: default
// used / overridden, explicit type args (fixed-width Int8 adoption), a generic
// METHOD, and a defaulted generic overload inside a design-105 overload set.
// EXPECT: success
// EXPECT-OUTPUT:
// 0
// 7
// 0
// 3:0
// 3:8
// g1:0
// g1:9
// g1:0
// g2:hi

func f<T: Printable>(a: Int, b: T = 0) -> String { "{b}" }

struct Box2 { v: Int }
extension Box2 {
    func m<T: Printable>(&self, a: Int, b: T = 0) -> String { "{a}:{b}" }
}

// Defaulted generic overload in a mixed set (design 105): the generic overload
// binds `g(1)` by filling `b`, and its `T` is inferred from the default.
func g<T: Printable>(a: Int, b: T = 0) -> String { "g1:{b}" }
func g(a: String) -> String { "g2:{a}" }

func main() {
    print(f(1))          // default-drives-inference: T=Int, b=0
    print(f(1, 7))       // default overridden
    print(f<Int8>(1))    // explicit Int8; bare `0` adopts the fixed width

    let x = Box2(v: 0)
    print(x.m<Int>(3))   // generic method, default used
    print(x.m(3, 8))     // generic method, default overridden

    print(g(1))          // generic overload, default b=0
    print(g(1, 9))       // generic overload, overridden
    print(g<Int8>(1))    // explicit type arg on the generic overload
    print(g("hi"))       // concrete overload
}
