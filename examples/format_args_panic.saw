// Design 137: `panic("out of {}", what)` assembles its message from format
// arguments in stack scratch, so it still says what happened with the allocator
// refusing everything. The design-122 `panic at FILE:LINE:` prefix is unchanged.
// EXPECT: panic
// EXPECT-PANIC-CONTAINS: panic at format_args_panic.saw:26: out of frames: wanted 64, had 3 (slab (1, 2))

struct Slab { id: Int, gen: Int }
extension Slab: Printable {
    func format(&self, into: &var StringBuilder) {
        into.append("slab (")
        into.append(self.id)
        into.append(", ")
        into.append(self.gen)
        into.append(")")
    }
}

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
}

func main() {
    let s = Slab(id: 1, gen: 2)
    print("armed")
    __saw_rt_alloc_deny_after(0)
    panic("out of {}: wanted {}, had {} ({})", "frames", 64, 3, s)
}
