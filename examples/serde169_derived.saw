// design 169 unit 2: `@synthesize` derives `serialize`/`deserialize` structurally
// — every stored field, in declaration order, as one array. The walk covers the
// integer types, Bool, String, Optional, Vector, raw-backed enums, and any
// nested type that conforms. Both directions are derived here; the tiny codec
// below is just a sink to prove the round-trip.
// EXPECT: success
// EXPECT-OUTPUT:
// kind=Release port=443 name=api tag=none
// deps=2 first=toml/0.1.0
// narrow=-7/200
// unknown enum case rejected: 3

import std.data.{Data}

enum Track: UInt8 {
    case Debug = 0,
    case Release = 7
}

@synthesize
extension Track: Serialize {}

@synthesize
extension Track: Deserialize {}

struct Dep {
    name: String
    version: String
}

@synthesize
extension Dep: Serialize {}

@synthesize
extension Dep: Deserialize {}

extension Dep: NoCopy {}

struct Manifest {
    kind: Track
    port: Int
    name: String
    tag: String?
    deps: Vector<Dep>
    lo: Int8
    hi: UInt8
}

@synthesize
extension Manifest: Serialize {}

@synthesize
extension Manifest: Deserialize {}

extension Manifest: NoCopy {}

// ---------------------------------------------------------------- the sink

static TAG_ARRAY: UInt8 = 1u8
static TAG_INT: UInt8 = 2u8
static TAG_TRUE: UInt8 = 3u8
static TAG_FALSE: UInt8 = 4u8
static TAG_TEXT: UInt8 = 5u8
static TAG_NULL: UInt8 = 6u8
static INT_BIAS: Int = 128

struct MiniEncoder {
    out: Data
}

extension MiniEncoder {
    public init() -> MiniEncoder { MiniEncoder(out: Data()) }
    public func bytes(&self) -> Data { self.out.copy() }
}

extension MiniEncoder: Encoder {
    func write_uint(&var self, v: UInt) sync -> Result<Void, EncodeError> {
        self.write_int(v as Int)
    }

    func write_int(&var self, v: Int) sync -> Result<Void, EncodeError> {
        if v < -INT_BIAS || v > 65535 {
            return EncodeError(fault: EncodeFault.Unsupported)
        }
        let biased = v + INT_BIAS
        try! self.out.push(TAG_INT)
        try! self.out.push(((biased >> 8) & 255) as UInt8)
        try! self.out.push((biased & 255) as UInt8)
        return
    }

    func write_bool(&var self, v: Bool) sync -> Result<Void, EncodeError> {
        try! self.out.push(if v { TAG_TRUE } else { TAG_FALSE })
        return
    }

    func write_null(&var self) sync -> Result<Void, EncodeError> {
        try! self.out.push(TAG_NULL)
        return
    }

    func write_text(&var self, v: String) sync -> Result<Void, EncodeError> {
        let bytes = try! v.to_data()
        if bytes.len() > 255 {
            return EncodeError(fault: EncodeFault.BufferFull)
        }
        try! self.out.push(TAG_TEXT)
        try! self.out.push(bytes.len() as UInt8)
        var i = 0
        while i < bytes.len() {
            try! self.out.push(bytes[i])
            i = i + 1
        }
        return
    }

    func begin_bytes(&var self, count: Int) sync -> Result<Void, EncodeError> {
        return EncodeError(fault: EncodeFault.Unsupported)
    }

    func write_byte(&var self, b: UInt8) sync -> Result<Void, EncodeError> {
        return EncodeError(fault: EncodeFault.Unsupported)
    }

    func begin_array(&var self, count: Int) sync -> Result<Void, EncodeError> {
        if count > 255 {
            return EncodeError(fault: EncodeFault.BufferFull)
        }
        try! self.out.push(TAG_ARRAY)
        try! self.out.push(count as UInt8)
        return
    }

    func begin_map(&var self, count: Int) sync -> Result<Void, EncodeError> {
        return EncodeError(fault: EncodeFault.Unsupported)
    }
}

extension MiniEncoder: NoCopy {}

struct MiniDecoder {
    input: Data
    pos: Int
}

extension MiniDecoder {
    public init(input: Data) -> MiniDecoder { MiniDecoder(input: move input, pos: 0) }

    func fault(&self, f: DecodeFault) sync -> DecodeError {
        DecodeError(offset: self.pos, fault: f)
    }

    func next(&var self) sync -> Result<UInt8, DecodeError> {
        if self.pos >= self.input.len() {
            return self.fault(DecodeFault.Truncated)
        }
        let b = self.input[self.pos]
        self.pos = self.pos + 1
        return b
    }

    func peek(&self) sync -> Result<UInt8, DecodeError> {
        if self.pos >= self.input.len() {
            return self.fault(DecodeFault.Truncated)
        }
        return self.input[self.pos]
    }

    func expect_tag(&var self, tag: UInt8) sync -> Result<Void, DecodeError> {
        let b = try self.next()
        if b != tag {
            return self.fault(DecodeFault.TypeMismatch)
        }
        return
    }
}

extension MiniDecoder: Decoder {
    func read_uint(&var self) sync -> Result<UInt, DecodeError> {
        let v = try self.read_int()
        if v < 0 {
            return self.fault(DecodeFault.OutOfRange)
        }
        return v as UInt
    }

    func read_int(&var self) sync -> Result<Int, DecodeError> {
        try self.expect_tag(TAG_INT)
        let hi = try self.next()
        let lo = try self.next()
        return (((hi as Int) << 8) | (lo as Int)) - INT_BIAS
    }

    func read_bool(&var self) sync -> Result<Bool, DecodeError> {
        let b = try self.next()
        if b == TAG_TRUE {
            return true
        }
        if b == TAG_FALSE {
            return false
        }
        return self.fault(DecodeFault.TypeMismatch)
    }

    func read_null(&var self) sync -> Result<Void, DecodeError> {
        try self.expect_tag(TAG_NULL)
        return
    }

    func read_text(&var self) sync -> Result<String, DecodeError> {
        try self.expect_tag(TAG_TEXT)
        let n = try self.next()
        var b = StringBuilder()
        var i = 0
        while i < (n as Int) {
            let byte = try self.next()
            try! b.append_char(byte as Int8)
            i = i + 1
        }
        return b.build()
    }

    func begin_bytes(&var self) sync -> Result<Int, DecodeError> {
        return self.fault(DecodeFault.Unsupported)
    }

    func read_byte(&var self) sync -> Result<UInt8, DecodeError> {
        return self.fault(DecodeFault.Unsupported)
    }

    func begin_array(&var self) sync -> Result<Int, DecodeError> {
        try self.expect_tag(TAG_ARRAY)
        let n = try self.next()
        return n as Int
    }

    func begin_map(&var self) sync -> Result<Int, DecodeError> {
        return self.fault(DecodeFault.Unsupported)
    }

    func at_null(&var self) sync -> Result<Bool, DecodeError> {
        let b = try self.peek()
        return b == TAG_NULL
    }

    func offset(&self) sync -> Int {
        self.pos
    }

    func skip(&var self) sync -> Result<Void, DecodeError> {
        return self.fault(DecodeFault.Unsupported)
    }
}

extension MiniDecoder: NoCopy {}

func describe(c: Track) -> String {
    match c {
        case Debug -> "Debug",
        case Release -> "Release"
    }
}

func main() {
    var deps = Vector<Dep>()
    try! deps.push(Dep(name: "toml", version: "0.1.0"))
    try! deps.push(Dep(name: "semver", version: "2.0.0"))

    let m = Manifest(kind: Track.Release, port: 443, name: "api", tag: None,
                     deps: move deps, lo: -7i8, hi: 200u8)

    var enc = MiniEncoder()
    match m.serialize(to: &var enc) {
        case Ok(_) -> {},
        case Err(e) -> print("encode failed: {}", e)
    }

    var dec = MiniDecoder(input: enc.bytes())
    match Manifest.deserialize(from: &var dec) {
        case Ok(back) -> {
            let tag = back.tag ?? "none"
            print("kind={} port={} name={} tag={}",
                  describe(back.kind), back.port, back.name, tag)
            // `Dep` is NoCopy, so the element is reached as a PLACE — the field
            // read off it copies a String, which is free.
            print("deps={} first={}/{}", back.deps.len(),
                  back.deps[0].name, back.deps[0].version)
            print("narrow={}/{}", back.lo, back.hi)
        },
        case Err(e) -> print("decode failed: {}", e)
    }

    // A raw value no case carries is DATA, not a trap: it becomes a DecodeError
    // naming the byte it was read at (design 145's `from(raw:)` is partial).
    var bad = MiniEncoder()
    let _ = bad.write_int(11)
    var baddec = MiniDecoder(input: bad.bytes())
    match Track.deserialize(from: &var baddec) {
        case Ok(c) -> print("unexpectedly accepted {}", describe(c)),
        case Err(e) -> print("unknown enum case rejected: {}", e.offset)
    }
}
