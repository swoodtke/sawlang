// design 62 G1: cancellation through a frame-resident group. The suspending
// `orchestrate` spawns a child, cancels it (the `__cancel` word lives in the
// child's frame, reachable through the TaskHandle's raw pointer), and the child
// observes it cooperatively at its `cancelled()` check — returning through normal
// control flow (NO forced destroy). A parent suspension sits between spawn and join.
// EXPECT: success
// EXPECT-OUTPUT:
// 0

import std.task
func child() -> Int {
    var i = 0
    while not cancelled() {
        yield_now()
        i = i + 1
        if i > 100 {
            return -1        // safety net: cancel is observed well before this
        }
    }
    return i                 // iteration count at cancel observation
}

func orchestrate() -> Int {
    var group = TaskGroup()
    let h = group.spawn(child())
    h.cancel()               // set before the group is driven
    sleep(1)                 // parent suspends between spawn and join
    return h.join()          // child observes cancel at its first check -> 0
}

func main() {
    print(__drive(orchestrate()))   // 0
}
