// `struct dirent` name projection (design 122) — macOS.
//
// The offset of `d_name` in `struct dirent` differs per host, so it alone sits
// behind the host split; std still opens, walks and closes the directory.
// Keep in step with host_linux/dirent.saw.
//
// macOS `struct dirent`:
//   d_ino     UInt64   @0
//   d_seekoff UInt64   @8
//   d_reclen  UInt16   @16
//   d_namlen  UInt16   @18
//   d_type    UInt8    @20
//   d_name    Int8[]   @21

static DIRENT_NAME_OFFSET: Int = 21

// The NUL-terminated name inside a `struct dirent` returned by `readdir`.
// `entry` must be non-NULL (std checks readdir's own result first).
@export("__saw_rt_fs_dirent_name")
func rt_fs_dirent_name(entry: UnsafePointer<Int8>) unsafe -> UnsafePointer<Int8> {
    entry + DIRENT_NAME_OFFSET
}
