// The one-word lock seams (design 186) — macOS.
//
// `os_unfair_lock` is a single `uint32_t` and `OS_UNFAIR_LOCK_INIT` is zero,
// so the unlocked state is the zero pattern: a `static` `Mutex<T>` needs no
// initializer and an idle one lives in bss. A `pthread_mutex_t` cannot do this
// on Darwin, because its static initializer has a nonzero signature word.
//
// The word std hands over is a platform `Int` (rt/ABI.md) and the lock uses its
// low four bytes. Both hosted targets are little-endian, which is what lets one
// Saw field serve a 4-byte lock here and a 4-byte futex word on Linux.
//
// `os_unfair_lock` parks the waiting thread. It is unfair (no FIFO guarantee)
// and not recursive: taking it twice on one thread traps in libplatform rather
// than deadlocking.

extern "C" {
    func os_unfair_lock_lock(l: UnsafePointer<Int>)
    func os_unfair_lock_unlock(l: UnsafePointer<Int>)
}

@export("__saw_rt_lock_acquire")
func rt_lock_acquire(word: UnsafePointer<Int>) unsafe {
    os_unfair_lock_lock(word)
}

@export("__saw_rt_lock_release")
func rt_lock_release(word: UnsafePointer<Int>) unsafe {
    os_unfair_lock_unlock(word)
}
