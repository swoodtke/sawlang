// The global allocation seams (design 113b), authored in Saw.
//
// `__saw_rt_alloc`/`__saw_rt_dealloc` are the hosted default allocator: thin
// wrappers over libc malloc/free. `align` is ignored because malloc already
// aligns to alignof(max_align_t) (>= 16 on the hosted targets), which covers
// every Saw allocation. The seams traffic in a raw `i8*` (NULL on failure);
// std/alloc.saw's `extern` declaration adds the optional wrapping, because an
// `@export` return cannot be optional.
//
// `__saw_rt_alloc_deny_after(allow)` is the test hook for OOM paths: most of
// std (`String`, `StringBuilder`, `Data`, `Arc`, `Channel`) allocates through the
// global allocator and takes no allocator type parameter, so a test drives
// those paths by permitting `allow` more allocations and refusing the rest.
// Denial is a mode: it stays armed until a negative `allow` disarms it.
//
// Only the hosted default allocator has this hook. std never references it (a
// freestanding runtime need not provide the symbol); a test that wants it
// declares the `extern` itself. Inactive, it costs one atomic load per
// allocation (design 123).

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>
    func free(ptr: UnsafePointer<Int8>)
}

// Separate flag rather than one signed sentinel: a static initializer takes a
// plain literal, so "no limit in force" is its own zero-valued flag. When
// ACTIVE is 0 the allowance is not consulted.
static ALLOC_LIMIT_ACTIVE: Atomic<Int> = Atomic(0)
static ALLOC_ALLOW: Atomic<Int> = Atomic(0)

// Permit `allow` more allocations, then refuse every one after. A negative
// `allow` disarms the limit.
@export("__saw_rt_alloc_deny_after")
func rt_alloc_deny_after(allow: Int) {
    if allow < 0 {
        ALLOC_LIMIT_ACTIVE.store(0)
        return
    }
    ALLOC_ALLOW.store(allow)
    ALLOC_LIMIT_ACTIVE.store(1)
}

@export("__saw_rt_alloc")
func rt_alloc(size: Int, align: Int) unsafe -> UnsafePointer<Int8> {
    if ALLOC_LIMIT_ACTIVE.load() != 0 {
        let allow = ALLOC_ALLOW.load()
        if allow > 0 {
            ALLOC_ALLOW.store(allow - 1)
        } else {
            return 0 as UnsafePointer<Int8>
        }
    }
    malloc(size)
}

@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
    free(ptr)
}
