// Cooperative-scheduler fairness backstop (design 89), authored in Saw.
//
// A task that keeps completing suspending io ops without ever parking (an
// always-ready socket) would otherwise monopolize the executor. Each such op
// charges a budget; when it hits zero the io primitive force-yields once (the
// caller sees the `1`) and the budget resets. Op-count, not wall-clock, so it
// is deterministic and kernel-friendly.
//
// The budget is per thread, so each worker gets its own allowance and its own
// reset: a counter shared by N workers would couple them, and one thread's
// reset would discard another's progress (design 225). The loop-backedge budget needs no
// such care because it lives in the coroutine frame, so it is per task.
//
// Saw has no thread-local storage, so the budget lives in pthread
// thread-specific data. Both encodings are biased by one so that all-zero
// means "unset": a pthread key may legitimately be 0, and a thread that has
// never ticked reads NULL.

extern "C" {
    // pthread_key_t is `unsigned long` on macOS and `unsigned int` on glibc;
    // both are passed in a register and both fit a platform word, so the key is
    // modelled as `Int` and the create call is handed a zeroed 8-byte slot to
    // write its 4 or 8 bytes into. NULL destructor: the value is an immediate,
    // not an allocation.
    func pthread_key_create(key: UnsafePointer<Int8>, dtor: UnsafePointer<Int8>) -> Int32
    func pthread_key_delete(key: Int) -> Int32
    func pthread_getspecific(key: Int) -> Int
    func pthread_setspecific(key: Int, value: Int) -> Int32
}

// Default budget. `Atomic(0)` must be a literal in the static init, so the key
// holder's initializer below repeats the 0 — the biasing is described above.
static OP_BUDGET_DEFAULT: Int = 128

// The pthread key, created once and published by CAS, on the same pattern the
// executor's reactor singleton uses: create, try to publish, and if somebody
// else won, delete the spare and use theirs. Holds `key + 1`, so 0 means "no
// key yet" and a genuine key of 0 is not mistaken for one.
static OP_BUDGET_KEY: Atomic<Int> = Atomic(0)

func op_budget_key() unsafe -> Int {
    let cur = OP_BUDGET_KEY.load()
    if cur != 0 {
        return cur - 1
    }
    var fresh: Int = 0
    pthread_key_create((&fresh) as UnsafePointer<Int8>, 0 as UnsafePointer<Int8>)
    if OP_BUDGET_KEY.compare_exchange(0, fresh + 1) {
        return fresh
    }
    pthread_key_delete(fresh)
    OP_BUDGET_KEY.load() - 1
}

// This thread's remaining budget. A thread that has never ticked reads NULL and
// starts at the default.
func op_budget_get(key: Int) unsafe -> Int {
    let raw = pthread_getspecific(key)
    if raw == 0 {
        return OP_BUDGET_DEFAULT
    }
    raw - 1
}

func op_budget_set(key: Int, value: Int) unsafe {
    pthread_setspecific(key, value + 1)
}

@export("__saw_rt_op_budget_tick")
func rt_op_budget_tick() unsafe -> Int {
    let key = op_budget_key()
    let nv = op_budget_get(key) &- 1
    if nv <= 0 {
        op_budget_set(key, OP_BUDGET_DEFAULT)
        1
    } else {
        op_budget_set(key, nv)
        0
    }
}

@export("__saw_rt_op_budget_reset")
func rt_op_budget_reset() unsafe {
    op_budget_set(op_budget_key(), OP_BUDGET_DEFAULT)
}
