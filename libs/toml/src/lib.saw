// toml — a minimal TOML reader for Saw.toml / Saw.lock (design 64 B8, extracted
// from Blade into a real library package). Supports:
// - [section] headers
// - key = "value" string assignments
// - key = { subkey = "v", ... } one-level inline tables
// - # comments

// =============================================================================
// Error Types
// =============================================================================

public struct TomlError {
    message: String
    line: Int
}

public extension TomlError {
    init(msg: String) -> TomlError {
        TomlError(message: msg, line: 0)
    }

    init(msg: String, at_line: Int) -> TomlError {
        TomlError(message: msg, line: at_line)
    }
}

// A TOML error is a Printable error (design 56): it renders itself, so it can be
// erased into a `Box<any Error>` and propagated with `try` across error kinds.
public extension TomlError: Error {
    func format(&self, into: &var StringBuilder) {
        into.append("TOML parse error: ")
        into.append(self.message)
        if self.line > 0 {
            into.append(" (line ")
            into.append(self.line)
            into.append(")")
        }
    }
}

// =============================================================================
// TOML Data Structures
// =============================================================================

public struct TomlValue {
    key: String
    value: String
}

public extension TomlValue {
    // Typed access (design 57 dogfood): parse the stored string as an integer.
    // Returns None when the value is not a whole-string base-10 integer.
    func int_value(&self) -> Int? {
        self.value.to_int()
    }
}

// An inline table value: `key = { subkey = "v", ... }` (one level, design 64
// B1). The inner scalar pairs are stored as a Vector<TomlValue>. NoCopy with an
// empty deinit — same discipline as TomlSection (the container owns the buffer).
public struct TomlTable {
    key: String
    values: Vector<TomlValue>
}

extension TomlTable: NoCopy {
    func deinit(var self) {
        // Vector handles its own cleanup
    }
}

public extension TomlTable {
    init(k: String) -> TomlTable {
        let v = Vector<TomlValue>()
        TomlTable(key: k, values: move v)
    }

    // Get an inner value by subkey.
    func get(&self, subkey: String) -> String? {
        var i = 0
        while i < self.values.len() {
            if let val = self.values.get(i) {
                if val.key.equals(subkey) {
                    return val.value
                }
            }
            i = i + 1
        }
        None
    }

    // Add an inner scalar pair.
    func add(&var self, k: String, v: String) {
        self.values.push(TomlValue(key: k, value: v))
    }
}

public struct TomlSection {
    name: String
    values: Vector<TomlValue>
    tables: Vector<TomlTable>
}

extension TomlSection: NoCopy {
    func deinit(var self) {
        // Vector handles its own cleanup
    }
}

public extension TomlSection {
    init(section_name: String) -> TomlSection {
        let v = Vector<TomlValue>()
        let t = Vector<TomlTable>()
        TomlSection(name: section_name, values: move v, tables: move t)
    }

    // Get a scalar value by key
    func get(&self, key: String) -> String? {
        var i = 0
        while i < self.values.len() {
            if let val = self.values.get(i) {
                if val.key.equals(key) {
                    return val.value
                }
            }
            i = i + 1
        }
        None
    }

    // Add a scalar value to this section
    func add(&var self, key: String, value: String) {
        self.values.push(TomlValue(key: key, value: value))
    }

    // Add an inline-table value to this section.
    func add_table(&var self, table: TomlTable) {
        self.tables.push(move table)
    }

    // True if `key` names an inline table in this section.
    func is_table(&self, key: String) -> Bool {
        var i = 0
        while i < self.tables.len() {
            if let t = self.tables.get(i) {
                if t.key.equals(key) {
                    return true
                }
            }
            i = i + 1
        }
        false
    }

    // Look up `subkey` inside the inline table named `key`.
    func table_value(&self, key: String, subkey: String) -> String? {
        var i = 0
        while i < self.tables.len() {
            if let t = self.tables.get(i) {
                if t.key.equals(key) {
                    return t.get(subkey)
                }
            }
            i = i + 1
        }
        None
    }

    // All entry names in this section, scalars first then inline tables, in the
    // order they appear. Lets a caller enumerate e.g. every [dependencies] entry.
    func names(&self) -> Vector<String> {
        var out = Vector<String>()
        var i = 0
        while i < self.values.len() {
            if let val = self.values.get(i) {
                out.push(val.key)
            }
            i = i + 1
        }
        var j = 0
        while j < self.tables.len() {
            if let t = self.tables.get(j) {
                out.push(t.key)
            }
            j = j + 1
        }
        move out
    }

    // Typed lookup (design 57 dogfood): a value parsed as an integer, or None if
    // absent or not an integer. Built on String.to_int.
    func get_int(&self, key: String) -> Int? {
        if let s = self.get(key) {
            return s.to_int()
        }
        None
    }
}

// Parse an inline table body `{ a = "1", b = "2" }` into a TomlTable named
// `key`. Minimal (design 64 B1): one level, comma-separated `subkey = "value"`
// pairs, quotes stripped. Malformed fragments are skipped rather than erroring
// (the manifest layer validates the meaningful keys it needs).
func parse_inline_table(key: String, raw: String) -> TomlTable {
    var table = TomlTable(k: key)
    // Strip the surrounding braces, then split on commas.
    let inner = raw.substring(1, raw.len() - 1).trim()
    if inner.is_empty() {
        return move table
    }
    let parts = inner.split(",")
    for part in parts.iter() {
        let frag = part.trim()
        if frag.is_empty() {
            continue
        }
        if let eq = frag.index_of_char(61 as Int8) {  // '='
            let subkey = frag.substring(0, eq).trim()
            let raw_sub = frag.substring(eq + 1, frag.len()).trim()
            var subval = raw_sub
            if raw_sub.starts_with("\"") && raw_sub.ends_with("\"") {
                subval = raw_sub.substring(1, raw_sub.len() - 1)
            }
            table.add(subkey, subval)
        }
    }
    move table
}

public struct TomlDoc {
    sections: Vector<TomlSection>
}

extension TomlDoc: NoCopy {
    func deinit(var self) {
        // Vector handles its own cleanup
    }
}

public extension TomlDoc {
    init() -> TomlDoc {
    	let v = Vector<TomlSection>()
        TomlDoc(sections: move v)
    }

    // Parse TOML from a string
    func parse(content: String) -> Result<TomlDoc, TomlError> {
        var doc = TomlDoc()
        var current_section = TomlSection(section_name: "")

        let lines = content.split("\n")
        var line_num = 0

        for line in lines.iter() {
            line_num = line_num + 1
            let trimmed = line.trim()

            // Skip empty lines and comments
            if trimmed.is_empty() || trimmed.starts_with("#") {
                continue
            }

            // Section header: [section_name]
            if trimmed.starts_with("[") && trimmed.ends_with("]") {
                // Save previous section if it has a name
                if not current_section.name.is_empty() {
                    doc.sections.push(move current_section)
                }
                // Start new section - extract name between [ and ]
                let name = trimmed.substring(1, trimmed.len() - 1)
                current_section = TomlSection(section_name: name)
                continue
            }

            // Key-value pair: key = "value" or key = value
            if let eq_pos = trimmed.index_of_char(61 as Int8) {  // '=' is 61
                let key = trimmed.substring(0, eq_pos).trim()
                let raw_value = trimmed.substring(eq_pos + 1, trimmed.len()).trim()

                // Inline table (one level): key = { subkey = "v", ... }
                // (literal braces in the string patterns are escaped as \{ \}
                // so the interpolation lexer does not treat them as splices).
                if raw_value.starts_with("\{") && raw_value.ends_with("\}") {
                    let table = parse_inline_table(key, raw_value)
                    current_section.add_table(move table)
                } else {
                    // Handle quoted strings
                    var value = raw_value
                    if raw_value.starts_with("\"") && raw_value.ends_with("\"") {
                        value = raw_value.substring(1, raw_value.len() - 1)
                    }
                    current_section.add(key, value)
                }
            } else {
                return TomlError(msg: "Invalid line: {trimmed}", at_line: line_num)
            }
        }

        // Don't forget the last section
        let has_content = current_section.values.len() > 0 || current_section.tables.len() > 0
        if not current_section.name.is_empty() || has_content {
            doc.sections.push(move current_section)
        }

        move doc
    }

    // All section names, in document order (lets a caller enumerate e.g. every
    // [pkg.*] section of a lock file).
    func section_names(&self) -> Vector<String> {
        var out = Vector<String>()
        var i = 0
        while i < self.sections.len() {
            if let s = self.sections.get(i) {
                out.push(s.name)
            }
            i = i + 1
        }
        move out
    }

    // Get a section by name
    func get_section(&self, name: String) -> TomlSection? {
        var i = 0
        while i < self.sections.len() {
            if let section = self.sections.get(i) {
                if section.name.equals(name) {
                    return section
                }
            }
            i = i + 1
        }
        None
    }
}
