// 04_block04.toml
func useless_box_image_text() -> String {
    var b = StringBuilder()
    try! b.append("format = 1\n")
    try! b.append("\n")
    try! b.append("[image]\n")
    try! b.append("name = \"useless-box\"\n")
    try! b.append("board = \"esp32s3\"\n")
    try! b.append("tick = true\n")
    try! b.append("\n")
    try! b.append("[root]\n")
    try! b.append("package = \"stock\"\n")
    try! b.append("\n")
    try! b.append("[[setup]]                           # LEDC's clock on\n")
    try! b.append("register = \"SYSTEM.PERIP_CLK_EN0\"\n")
    try! b.append("set = 0x800\n")
    try! b.append("\n")
    try! b.append("[[setup]]                           # LEDC out of reset\n")
    try! b.append("register = \"SYSTEM.PERIP_RST_EN0\"\n")
    try! b.append("clear = 0x800\n")
    try! b.append("\n")
    try! b.append("[[setup]]                           # output enable, pads 41 and 42\n")
    try! b.append("register = \"GPIO.ENABLE1_W1TS\"\n")
    try! b.append("write = 0x600\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"gpio\"\n")
    try! b.append("package = \"sawos:drivers/svc-gpio-esp32s3\"\n")
    try! b.append("inputs = \{ gpioconfig = \"config/gpio.saw\" \}\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"pwm\"\n")
    try! b.append("package = \"sawos:drivers/svc-pwm-esp32s3\"\n")
    try! b.append("device = \{ outsel = \"GPIO.out_sel[41..=42]\", pads = \"IO_MUX.pad[41..=42]\" \}\n")
    try! b.append("inputs = \{ pwmconfig = \"config/pwm.saw\" \}\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"controller\"\n")
    try! b.append("package = \"controller\"\n")
    try! b.append("clients = \{ switch = \"gpio.gpio\", servos = \"pwm.pwm\" \}\n")
    try! b.append("on-exit = \"shutdown\"\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"heartbeat\"\n")
    try! b.append("package = \"heartbeat\"\n")
    b.build()
}

// 05_drivers_svc-uart-esp32s3_process.toml
func uart_process_text() -> String {
    var b = StringBuilder()
    try! b.append("# drivers/svc-uart-esp32s3/process.toml\n")
    try! b.append("format = 1\n")
    try! b.append("arena = 0x1000\n")
    try! b.append("ram = \"fast\"\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"system\"\n")
    try! b.append("kind = \"system\"\n")
    try! b.append("tag = 1\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"uart\"\n")
    try! b.append("kind = \"window\"\n")
    try! b.append("type = \"esp32s3-uart\"\n")
    try! b.append("tag = 2\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"uart\"\n")
    try! b.append("kind = \"line\"\n")
    try! b.append("type = \"esp32s3-uart\"\n")
    try! b.append("tag = 3\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"uart\"\n")
    try! b.append("kind = \"serve\"\n")
    try! b.append("protocol = \"uartproto\"\n")
    try! b.append("tag = 4\n")
    try! b.append("\n")
    try! b.append("[quota]\n")
    try! b.append("handles = 8\n")
    try! b.append("waiters = 1\n")
    try! b.append("\n")
    try! b.append("[build]\n")
    try! b.append("inputs = [\"uartpins\", \"uartconfig\"]\n")
    try! b.append("defaults = \{ uartconfig = \"config/default.saw\" \}   # 115200 8N1\n")
    b.build()
}

// 06_images_logger.toml
func logger_image_text() -> String {
    var b = StringBuilder()
    try! b.append("# images/logger.toml\n")
    try! b.append("format = 1\n")
    try! b.append("\n")
    try! b.append("[image]\n")
    try! b.append("name = \"logger\"\n")
    try! b.append("board = \"esp32s3\"\n")
    try! b.append("tick = true\n")
    try! b.append("\n")
    try! b.append("[root]\n")
    try! b.append("package = \"stock\"\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"gps\"\n")
    try! b.append("package = \"sawos:drivers/svc-uart-esp32s3\"\n")
    try! b.append("device = \{ uart = \"UART1\" \}\n")
    try! b.append("inputs = \{ uartpins = \"config/gps-pins.saw\", uartconfig = \"config/gps.saw\" \}\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"modem\"\n")
    try! b.append("package = \"sawos:drivers/svc-uart-esp32s3\"\n")
    try! b.append("device = \{ uart = \"UART2\" \}\n")
    try! b.append("inputs = \{ uartpins = \"config/modem-pins.saw\" \}\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"logger\"\n")
    try! b.append("package = \"logger\"\n")
    try! b.append("clients = \{ gps = \"gps.uart\", modem = \"modem.uart\" \}\n")
    try! b.append("on-exit = \"shutdown\"\n")
    b.build()
}

// 07_block07.toml
func uart_service_image_text() -> String {
    var b = StringBuilder()
    try! b.append("format = 1\n")
    try! b.append("\n")
    try! b.append("[image]\n")
    try! b.append("name = \"uart_service_ns16550\"\n")
    try! b.append("board = \"riscv32-virt\"\n")
    try! b.append("tick = false\n")
    try! b.append("\n")
    try! b.append("[root]\n")
    try! b.append("package = \"sawos:tests/uart-service\"\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"driver\"\n")
    try! b.append("package = \"sawos:drivers/svc-uart-ns16550\"\n")
    try! b.append("\n")
    try! b.append("[[process]]\n")
    try! b.append("name = \"client\"\n")
    try! b.append("package = \"sawos:tests/svc-client\"\n")
    try! b.append("\n")
    try! b.append("[rows]\n")
    try! b.append("devices = [\"UART0\"]\n")
    b.build()
}

func board_reads(failed: Int) -> Int {
    var n = failed
    let doc = read("board", board_text())
    n += expect_equal("board format", try! doc.root().integer("format"), 1)
    n += expect_equal("UART0 base", try! doc.root().table("devices")!.table("UART0")!.integer("base"), 1610612736)
    n += expect_equal("kernel len", try! doc.root().table("ram")!.table("kernel")!.integer("len"), 147456)
    n += expect_equal("slots count", try! doc.root().table("flash")!.table("slots")!.integer("count"), 4)
    n += expect_equal("ibus len", try! doc.root().table("flash")!.table("ibus")!.integer("len"), 16777216)
    n += expect_equal("reserved[0]", try! doc.root().table("lines")!.array("reserved")!.integer(0), 57)
    n += expect_text("uart input", try! doc.root().table("types")!.table("esp32s3-uart")!.array("inputs")!.string(0),
                     "uartpins")
    n += expect_equal("ENABLE1_W1TS offset",
                      try! doc.root().table("devices")!.table("GPIO")!.table("registers")!.table("ENABLE1_W1TS")!.integer("offset"), 48)
    n += expect_equal("out_sel count",
                      try! doc.root().table("devices")!.table("GPIO")!.table("arrays")!.table("out_sel")!.integer("count"), 54)
    n += expect_equal("default quota", try! doc.root().table("limits")!.table("default")!.table("quota")!.integer("handles"), 28)
    return n
}

func process_reads(failed: Int) -> Int {
    var n = failed
    let gpio = read("gpio process", gpio_process_text())
    n += expect_equal("gpio boot count", gpio.root().array("boot")!.len() as Int64, 5)
    var i = 0
    while i < gpio.root().array("boot")!.len() {
        n += expect_equal("gpio boot tag {i}", try! gpio.root().array("boot")!.table(i)!.integer("tag"),
                          (i + 1) as Int64)
        i = i + 1
    }
    n += expect_equal("gpio handles", try! gpio.root().table("quota")!.integer("handles"), 11)
    let pwm = read("pwm process", pwm_process_text())
    n += expect_equal("pwm boot count", pwm.root().array("boot")!.len() as Int64, 5)
    let uart = read("uart process", uart_process_text())
    n += expect_equal("uart handles", try! uart.root().table("quota")!.integer("handles"), 8)
    return n
}

func image_reads(failed: Int) -> Int {
    var n = failed
    let box = read("useless-box image", useless_box_image_text())
    n += expect_equal("setup count", box.root().array("setup")!.len() as Int64, 3)
    n += expect_text("pwm outsel",
                     try! box.root().array("process")!.table(1)!.table("device")!.string("outsel"),
                     "GPIO.out_sel[41..=42]")
    n += expect_equal("process count", box.root().array("process")!.len() as Int64, 4)
    let logger = read("logger image", logger_image_text())
    n += expect_equal("logger process count", logger.root().array("process")!.len() as Int64, 3)
    n += expect_text("gps uart", try! logger.root().array("process")!.table(0)!.table("device")!.string("uart"), "UART1")
    let service = read("uart-service image", uart_service_image_text())
    n += expect_equal("service process count", service.root().array("process")!.len() as Int64, 2)
    let psram = read("psram board", board_psram_text())
    n += expect_equal("psram len", try! psram.root().table("ram")!.table("psram")!.integer("len"), 8388608)
    return n
}

func main() {
    var failed = 0
    failed = board_reads(failed)
    failed = process_reads(failed)
    failed = image_reads(failed)
    assert(failed == 0, "{failed} reads failed")
    print("reads_consumer_files: ok")
}
