// The files the sawos design shows (its board description, the GPIO, PWM and
// UART process descriptions, and the useless-box, logger and UART-service
// images), copied verbatim, and the reads the sawos builder makes of them.
import toml.*

// The document `text` parses to, or a panic naming the refusal.
func read(name: String, text: String) -> TomlDoc {
    match TomlDoc.parse(text) {
        case Ok(doc) -> move doc,
        case Err(e) -> panic("{name}: refused: {e}")
    }
}

func expect_equal(what: String, got: Int64, want: Int64) -> Int {
    if got == want {
        return 0
    }
    print("FAIL {what}: {got}, want {want}")
    return 1
}

func expect_text(what: String, got: String, want: String) -> Int {
    if got == want {
        return 0
    }
    print("FAIL {what}: {got}, want {want}")
    return 1
}

// 00_hal_xtensa-esp32s3_board.toml
func board_text() -> String {
    var b = StringBuilder()
    try! b.append("# hal/xtensa-esp32s3/board.toml\n")
    try! b.append("format = 1\n")
    try! b.append("\n")
    try! b.append("[board]\n")
    try! b.append("name = \"esp32s3\"\n")
    try! b.append("triple = \"xtensa-esp-unknown-elf\"\n")
    try! b.append("tier = \"flat\"\n")
    try! b.append("hal = \"hal/xtensa-esp32s3\"\n")
    try! b.append("placement = \"in-place\"\n")
    try! b.append("modules = []\n")
    try! b.append("cflags = [\"-mcpu=esp32s3\", \"-fintegrated-as\"]     # abridged\n")
    try! b.append("\n")
    try! b.append("[emulator]\n")
    try! b.append("program = \"qemu-system-xtensa\"\n")
    try! b.append("args = [\"-machine\", \"esp32s3\", \"-nographic\", \"-semihosting\"]\n")
    try! b.append("\n")
    try! b.append("[ram.kernel]\n")
    try! b.append("use = \"kernel\"\n")
    try! b.append("speed = \"fast\"\n")
    try! b.append("base = 0x3FC8_C000\n")
    try! b.append("len = 0x2_4000              # 144 KiB\n")
    try! b.append("\n")
    try! b.append("[ram.sram]\n")
    try! b.append("use = \"process\"\n")
    try! b.append("speed = \"fast\"\n")
    try! b.append("base = 0x3FCB_0000\n")
    try! b.append("len = 0x4_0000              # 256 KiB\n")
    try! b.append("\n")
    try! b.append("[ram.default]\n")
    try! b.append("process = \"sram\"\n")
    try! b.append("pool = \"sram\"\n")
    try! b.append("\n")
    try! b.append("[flash]\n")
    try! b.append("base = 0x0\n")
    try! b.append("len = 0x80_0000             # the part's flash: 8 MiB on the Freenove N8R8\n")
    try! b.append("ibus = \{ base = 0x4200_0000, len = 0x100_0000 \}   # 16 MiB (SO-102)\n")
    try! b.append("dbus = \{ base = 0x3C00_0000, len = 0x100_0000 \}\n")
    try! b.append("root-slot = \{ base = 0x10_0000, len = 0x8_0000 \}\n")
    try! b.append("slots = \{ base = 0x18_0000, len = 0x8_0000, count = 4 \}   # 128 KiB each\n")
    try! b.append("\n")
    try! b.append("[types.esp32s3-uart]\n")
    try! b.append("inputs = [\"uartpins\"]       # each instance's pins, which a board may fix\n")
    try! b.append("\n")
    try! b.append("[devices.UART0]\n")
    try! b.append("type = \"esp32s3-uart\"\n")
    try! b.append("base = 0x6000_0000\n")
    try! b.append("len = 0x1000\n")
    try! b.append("line = 27\n")
    try! b.append("kernel = true               # the console\n")
    try! b.append("inputs = \{ uartpins = \"config/uart0-pins.saw\" \}\n")
    try! b.append("\n")
    try! b.append("[devices.UART1]\n")
    try! b.append("type = \"esp32s3-uart\"\n")
    try! b.append("base = 0x6001_0000          # placeholder: not checked against the TRM\n")
    try! b.append("len = 0x1000\n")
    try! b.append("line = 28                   # placeholder\n")
    try! b.append("\n")
    try! b.append("[devices.UART2]\n")
    try! b.append("type = \"esp32s3-uart\"\n")
    try! b.append("base = 0x6002_E000          # placeholder\n")
    try! b.append("len = 0x1000\n")
    try! b.append("line = 29                   # placeholder\n")
    try! b.append("\n")
    try! b.append("[devices.GPIO]\n")
    try! b.append("type = \"esp32s3-gpio\"\n")
    try! b.append("base = 0x6000_4000\n")
    try! b.append("len = 0x1000\n")
    try! b.append("line = 16\n")
    try! b.append("registers.ENABLE1_W1TS = \{ offset = 0x030 \}\n")
    try! b.append("arrays.out_sel = \{ offset = 0x554, stride = 4, count = 54 \}\n")
    try! b.append("\n")
    try! b.append("[devices.IO_MUX]\n")
    try! b.append("type = \"esp32s3-io-mux\"\n")
    try! b.append("base = 0x6000_9000\n")
    try! b.append("len = 0x1000\n")
    try! b.append("arrays.pad = \{ offset = 0x004, stride = 4, count = 49 \}\n")
    try! b.append("\n")
    try! b.append("[devices.LEDC]\n")
    try! b.append("type = \"esp32s3-ledc\"\n")
    try! b.append("base = 0x6001_9000\n")
    try! b.append("len = 0x1000\n")
    try! b.append("line = 35\n")
    try! b.append("\n")
    try! b.append("[devices.SYSTEM]\n")
    try! b.append("type = \"esp32s3-system\"\n")
    try! b.append("base = 0x600C_0000\n")
    try! b.append("len = 0x1000\n")
    try! b.append("registers.PERIP_CLK_EN0 = \{ offset = 0x018 \}\n")
    try! b.append("registers.PERIP_RST_EN0 = \{ offset = 0x020 \}\n")
    try! b.append("\n")
    try! b.append("[limits.default]            # set numbers only; derived ones are computed\n")
    try! b.append("processes = 8\n")
    try! b.append("waiters = 8\n")
    try! b.append("quota = \{ handles = 28, mappings = 12 \}\n")
    try! b.append("\n")
    try! b.append("[lines]\n")
    try! b.append("reserved = [57]\n")
    b.build()
}

// 01_block01.toml
func board_psram_text() -> String {
    var b = StringBuilder()
    try! b.append("[board]\n")
    try! b.append("name = \"esp32s3-r8\"\n")
    try! b.append("hal = \"hal/xtensa-esp32s3-r8\"\n")
    try! b.append("\n")
    try! b.append("[ram.psram]\n")
    try! b.append("use = \"process\"\n")
    try! b.append("speed = \"slow\"\n")
    try! b.append("base = 0x3D00_0000\n")
    try! b.append("len = 0x80_0000             # 8 MiB\n")
    try! b.append("\n")
    try! b.append("[ram.default]\n")
    try! b.append("process = \"psram\"\n")
    try! b.append("pool = \"psram\"\n")
    b.build()
}

// 02_drivers_svc-gpio-esp32s3_process.toml
func gpio_process_text() -> String {
    var b = StringBuilder()
    try! b.append("# drivers/svc-gpio-esp32s3/process.toml\n")
    try! b.append("format = 1\n")
    try! b.append("arena = 0x1000\n")
    try! b.append("ram = \"fast\"                # it services the switch's interrupt\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"system\"\n")
    try! b.append("kind = \"system\"\n")
    try! b.append("tag = 1\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"gpio\"\n")
    try! b.append("kind = \"window\"\n")
    try! b.append("type = \"esp32s3-gpio\"\n")
    try! b.append("tag = 2\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"iomux\"\n")
    try! b.append("kind = \"window\"\n")
    try! b.append("type = \"esp32s3-io-mux\"\n")
    try! b.append("tag = 3\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"gpio\"\n")
    try! b.append("kind = \"line\"\n")
    try! b.append("type = \"esp32s3-gpio\"\n")
    try! b.append("tag = 4\n")
    try! b.append("\n")
    try! b.append("[[boot]]\n")
    try! b.append("name = \"gpio\"\n")
    try! b.append("kind = \"serve\"\n")
    try! b.append("protocol = \"gpioproto\"\n")
    try! b.append("tag = 5\n")
    try! b.append("\n")
    try! b.append("[quota]\n")
    try! b.append("mappings = 2\n")
    try! b.append("handles = 11                # floor 8: 5 records, Process, 2 Mappings\n")
    try! b.append("waiters = 1\n")
    try! b.append("\n")
    try! b.append("[build]\n")
    try! b.append("inputs = [\"gpioconfig\"]\n")
    b.build()
}

