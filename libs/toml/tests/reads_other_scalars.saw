// Floats, booleans and date-times. Floats and date-times are valid TOML 1.0
// that this version refuses by name; booleans are read.
import toml.*

func accept(id: String, src: String, want: String) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            let got = "{doc}"
            if got == want {
                return 0
            }
            print("FAIL {id}: read {got}, want {want}")
            return 1
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

func refuse(id: String, src: String, kind: TomlErrorKind, line: Int, column: Int) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            print("FAIL {id}: accepted as {doc}")
            return 1
        },
        case Err(e) -> {
            if e.kind == kind && e.line == line && e.column == column {
                return 0
            }
            print("FAIL {id}: refused with {e} (kind matches: {e.kind == kind})")
            return 1
        }
    }
}

func main() {
    var failed = 0
    failed += refuse("F1", "[t]\na = +1.0\nb = 3.1415\nc = -0.01\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F2", "[t]\na = 5e+22\nb = 1e06\nc = -2E-22\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F3", "[t]\na = 6.626e-34\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F4", "[t]\na = 224_617.445_991_228\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F5", "[t]\na = inf\nb = +inf\nc = -inf\nd = nan\ne = +nan\nf = -nan\n",
                     TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F6", "[t]\na = .7\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F7", "[t]\na = 7.\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("F8", "[t]\na = 3.e+20\n", TomlErrorKind.Unsupported, 2, 5)
    // Each float form is refused where it is written, not only the first.
    failed += refuse("F5b", "[t]\na = 1\nb = nan\n", TomlErrorKind.Unsupported, 3, 5)

    failed += accept("B1", "[t]\na = true\nb = false\n", "\{t = \{a = true, b = false\}\}")
    failed += refuse("B2", "[t]\na = True\n", TomlErrorKind.Syntax, 2, 5)
    failed += accept("B3", "[package]\nruntime = \"true\"\n", "\{package = \{runtime = \"true\"\}\}")
    match TomlDoc.parse("[package]\nruntime = \"true\"\n") {
        case Ok(doc) -> {
            match doc.root().table("package")!.boolean("runtime") {
                case Ok(_) -> {
                    print("FAIL B3: boolean read a string")
                    failed += 1
                },
                case Err(e) -> {
                    if e.kind != TomlErrorKind.WrongType || e.line != 2 || e.column != 11 {
                        print("FAIL B3: boolean refused with {e}")
                        failed += 1
                    }
                }
            }
        },
        case Err(e) -> {
            print("FAIL B3: refused: {e}")
            failed += 1
        }
    }

    failed += refuse("D1", "[t]\na = 1979-05-27T07:32:00Z\nb = 1979-05-27T00:32:00-07:00\nc = 1979-05-27T00:32:00.999999-07:00\n",
                     TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("D2", "[t]\na = 1979-05-27 07:32:00Z\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("D3", "[t]\na = 1979-05-27T07:32:00\nb = 1979-05-27T00:32:00.999999\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("D4", "[t]\na = 1979-05-27\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("D5", "[t]\na = 07:32:00\nb = 00:32:00.999999\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("D6", "[t]\na = 1979-02-30\n", TomlErrorKind.Unsupported, 2, 5)
    assert(failed == 0, "{failed} rows failed")
    print("reads_other_scalars: ok")
}
