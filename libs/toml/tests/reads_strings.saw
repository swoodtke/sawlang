// Basic and literal strings; the multi-line forms are refused by name.
import toml.*

func accept(id: String, src: String, want: String) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            let got = "{doc}"
            if got == want {
                return 0
            }
            print("FAIL {id}: read {got}, want {want}")
            return 1
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

func refuse(id: String, src: String, kind: TomlErrorKind, line: Int, column: Int) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            print("FAIL {id}: accepted as {doc}")
            return 1
        },
        case Err(e) -> {
            if e.kind == kind && e.line == line && e.column == column {
                return 0
            }
            print("FAIL {id}: refused with {e} (kind matches: {e.kind == kind})")
            return 1
        }
    }
}

func main() {
    var failed = 0
    failed += accept("S1", "[t]\ns = \"plain\"\n", "\{t = \{s = \"plain\"\}\}")
    failed += accept("S2", "[t]\ns = \"b\\b t\\t n\\n f\\f r\\r q\\\" bs\\\\\"\n",
                     "\{t = \{s = \"b\\b t\\t n\\n f\\f r\\r q\\\" bs\\\\\"\}\}")
    failed += accept("S3", "[t]\ns = \"Jos\\u00E9 \\U0001F600\"\n", "\{t = \{s = \"Jos\u{E9} \u{1F600}\"\}\}")
    failed += refuse("S4", "[t]\ns = \"bad \\x41\"\n", TomlErrorKind.InvalidString, 2, 10)
    failed += accept("S5", "[t]\ns = \"say \\\"hi\\\"\"\n", "\{t = \{s = \"say \\\"hi\\\"\"\}\}")
    failed += refuse("S6", "[t]\ns = \"abc\n", TomlErrorKind.InvalidString, 2, 5)
    failed += accept("S7", "[t]\ns = \"a\tb\"\n", "\{t = \{s = \"a\\tb\"\}\}")
    failed += refuse("S8", "[t]\ns = \"a\u{7}b\"\n", TomlErrorKind.InvalidString, 2, 7)
    failed += accept("S9", "[t]\ns = \"\"\n", "\{t = \{s = \"\"\}\}")
    failed += accept("S10", "[t]\ns = \"x = y\"\n", "\{t = \{s = \"x = y\"\}\}")
    failed += refuse("S11", "[t]\ns = \"a\" junk\n", TomlErrorKind.Syntax, 2, 9)
    failed += refuse("S12", "[t]\ns = \"\"\"\nRoses are red\nViolets are blue\"\"\"\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("S13", "[t]\ns = \"\"\"\nThe quick \\\n  brown fox\"\"\"\n", TomlErrorKind.Unsupported, 2, 5)
    failed += refuse("S14", "[t]\ns = \"\"\"one line\"\"\"\n", TomlErrorKind.Unsupported, 2, 5)
    failed += accept("S15", "[t]\nwinpath = 'C:\\Users\\nodejs\\templates'\n",
                     "\{t = \{winpath = \"C:\\\\Users\\\\nodejs\\\\templates\"\}\}")
    failed += accept("S16", "[t]\nquoted = 'Tom \"Dubs\" Preston-Werner'\n",
                     "\{t = \{quoted = \"Tom \\\"Dubs\\\" Preston-Werner\"\}\}")
    failed += refuse("S17", "[t]\nlines = '''\nThe first newline is\ntrimmed in raw strings.\n'''\n",
                     TomlErrorKind.Unsupported, 2, 9)
    failed += refuse("S18", "[t]\nregex2 = '''I [dw]on't need \\d{2} apples'''\n", TomlErrorKind.Unsupported, 2, 10)
    failed += accept("S19", "[t]\ns = \"caf\u{E9} \u{1F600}\"\n", "\{t = \{s = \"caf\u{E9} \u{1F600}\"\}\}")
    assert(failed == 0, "{failed} rows failed")
    print("reads_strings: ok")
}
