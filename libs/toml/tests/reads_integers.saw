// Integers: decimal, hexadecimal, octal and binary, and the 64-bit limits.
// A hexadecimal, octal or binary literal may reach UInt64.max (the library's
// one extension beyond TOML 1.0).
import toml.*

func accept(id: String, src: String, want: String) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            let got = "{doc}"
            if got == want {
                return 0
            }
            print("FAIL {id}: read {got}, want {want}")
            return 1
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

func refuse(id: String, src: String, kind: TomlErrorKind, line: Int, column: Int) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            print("FAIL {id}: accepted as {doc}")
            return 1
        },
        case Err(e) -> {
            if e.kind == kind && e.line == line && e.column == column {
                return 0
            }
            print("FAIL {id}: refused with {e} (kind matches: {e.kind == kind})")
            return 1
        }
    }
}

// The `integer` read of `n` in `[t]` is `want`.
func signed(id: String, src: String, want: Int64) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            match doc.root().table("t")!.integer("n") {
                case Ok(n) -> {
                    if n == want {
                        return 0
                    }
                    print("FAIL {id}: integer is {n}, want {want}")
                    return 1
                },
                case Err(e) -> {
                    print("FAIL {id}: integer refused: {e}")
                    return 1
                }
            }
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

// The `unsigned` read of `n` in `[t]` is `want`.
func unsigned(id: String, src: String, want: UInt64) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            match doc.root().table("t")!.unsigned("n") {
                case Ok(n) -> {
                    if n == want {
                        return 0
                    }
                    print("FAIL {id}: unsigned is {n}, want {want}")
                    return 1
                },
                case Err(e) -> {
                    print("FAIL {id}: unsigned refused: {e}")
                    return 1
                }
            }
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

// The `integer` or `unsigned` read of `n` in `[t]` fails with `kind` at
// `line`:`column`.
func read_refused(id: String, src: String, unsigned_read: Bool, kind: TomlErrorKind,
                  line: Int, column: Int) -> Int {
    match TomlDoc.parse(src) {
        case Ok(doc) -> {
            var got: TomlError? = None
            if unsigned_read {
                match doc.root().table("t")!.unsigned("n") {
                    case Ok(_) -> {},
                    case Err(e) -> { got = e }
                }
            } else {
                match doc.root().table("t")!.integer("n") {
                    case Ok(_) -> {},
                    case Err(e) -> { got = e }
                }
            }
            if let e = got {
                if e.kind == kind && e.line == line && e.column == column {
                    return 0
                }
                print("FAIL {id}: read refused with {e} (kind matches: {e.kind == kind})")
                return 1
            }
            print("FAIL {id}: the read succeeded")
            return 1
        },
        case Err(e) -> {
            print("FAIL {id}: refused: {e}")
            return 1
        }
    }
}

func main() {
    var failed = 0
    failed += accept("N1", "[t]\nn = +99\n", "\{t = \{n = 99\}\}")
    failed += accept("N2", "[t]\nn = 42\n", "\{t = \{n = 42\}\}")
    failed += accept("N3", "[t]\nn = 0\n", "\{t = \{n = 0\}\}")
    failed += accept("N4", "[t]\nn = -17\n", "\{t = \{n = -17\}\}")
    failed += accept("N5", "[t]\nn = 1_000\n", "\{t = \{n = 1000\}\}")
    failed += accept("N6", "[t]\nn = 5_349_221\n", "\{t = \{n = 5349221\}\}")
    failed += accept("N7", "[t]\nn = 0xDEADBEEF\n", "\{t = \{n = 3735928559\}\}")
    failed += accept("N8", "[t]\nn = 0xdeadbeef\n", "\{t = \{n = 3735928559\}\}")
    failed += accept("N9", "[t]\nn = 0xdead_beef\n", "\{t = \{n = 3735928559\}\}")
    failed += accept("N10", "[t]\nn = 0o755\n", "\{t = \{n = 493\}\}")
    failed += accept("N11", "[t]\nn = 0b11010110\n", "\{t = \{n = 214\}\}")
    failed += refuse("N12", "[t]\nn = 012\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += refuse("N13", "[t]\nn = 1__2\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += refuse("N14", "[t]\nn = _1\n", TomlErrorKind.Syntax, 2, 5)
    failed += refuse("N15", "[t]\nn = 1_\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += accept("N16", "[t]\nn = -0\n", "\{t = \{n = 0\}\}")
    failed += accept("N17", "[t]\nn = 9223372036854775807\n", "\{t = \{n = 9223372036854775807\}\}")
    failed += refuse("N18", "[t]\nn = 9223372036854775808\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += accept("N19", "[t]\nn = -9223372036854775808\n", "\{t = \{n = -9223372036854775808\}\}")
    // N20 (amended): past Int64 but within 64 bits
    failed += accept("N20", "[t]\nn = 0xFFFF_FFFF_FFFF_FFFF\n", "\{t = \{n = 0xFFFFFFFFFFFFFFFF\}\}")
    failed += unsigned("N20", "[t]\nn = 0xFFFF_FFFF_FFFF_FFFF\n", UInt64.max)
    failed += read_refused("N20", "[t]\nn = 0xFFFF_FFFF_FFFF_FFFF\n", false, TomlErrorKind.OutOfRange, 2, 5)
    failed += refuse("N21", "[t]\nn = -0x10\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += refuse("N22", "[t]\nn = 0X10\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += accept("N23", "[t]\nn = \"42\"\n", "\{t = \{n = \"42\"\}\}")
    failed += read_refused("N23", "[t]\nn = \"42\"\n", false, TomlErrorKind.WrongType, 2, 5)
    failed += accept("N24", "[flash]\nbase = 0x0\n", "\{flash = \{base = 0\}\}")
    // N25 to N34: the unsigned extension
    failed += accept("N25", "[t]\nn = 0x8000_0000_0000_0000\n", "\{t = \{n = 0x8000000000000000\}\}")
    failed += unsigned("N25", "[t]\nn = 0x8000_0000_0000_0000\n", 9223372036854775808)
    failed += accept("N26", "[t]\nn = 0x7FFF_FFFF_FFFF_FFFF\n", "\{t = \{n = 9223372036854775807\}\}")
    failed += signed("N26", "[t]\nn = 0x7FFF_FFFF_FFFF_FFFF\n", Int64.max)
    failed += unsigned("N26", "[t]\nn = 0x7FFF_FFFF_FFFF_FFFF\n", 9223372036854775807)
    failed += refuse("N27", "[t]\nn = 0x1_0000_0000_0000_0000\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += accept("N28", "[t]\nn = 0o1777777777777777777777\n", "\{t = \{n = 0xFFFFFFFFFFFFFFFF\}\}")
    failed += unsigned("N28", "[t]\nn = 0o1777777777777777777777\n", UInt64.max)
    failed += refuse("N29", "[t]\nn = 0o2000000000000000000000\n", TomlErrorKind.InvalidNumber, 2, 5)
    let ones = "1111111111111111"
    failed += accept("N30", "[t]\nn = 0b{ones}{ones}{ones}{ones}\n", "\{t = \{n = 0xFFFFFFFFFFFFFFFF\}\}")
    failed += unsigned("N30", "[t]\nn = 0b{ones}{ones}{ones}{ones}\n", UInt64.max)
    failed += refuse("N31", "[t]\nn = 0b{ones}{ones}{ones}{ones}1\n", TomlErrorKind.InvalidNumber, 2, 5)
    failed += read_refused("N32", "[t]\nn = -17\n", true, TomlErrorKind.OutOfRange, 2, 5)
    failed += read_refused("N33", "[t]\nn = \"42\"\n", true, TomlErrorKind.WrongType, 2, 5)
    failed += unsigned("N34", "[t]\nn = 0xFFFF_FF80_0000_0000\n", 18446743523953737728)
    assert(failed == 0, "{failed} rows failed")
    print("reads_integers: ok")
}
