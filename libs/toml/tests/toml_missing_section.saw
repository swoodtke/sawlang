// Asking a document for a section it does not have returns None (not a crash).
import src.lib.*

func main() {
    let content = "[server]\nhost = \"localhost\"\n"

    match TomlDoc.parse(content) {
        case Ok(doc) -> {
            guard let server = doc.index_of("server") else {
                panic("expected a [server] section")
            }
            let host = doc.section_at(server).get("host") ?? "MISSING"
            assert(host.equals("localhost"), "host should be localhost")

            // A section is NoCopy, so presence is a question, not a value read.
            assert(doc.has_section("server"), "server should be present")
            assert(not doc.has_section("package"),
                   "absent section should report absent")
            if let _absent = doc.index_of("package") {
                panic("absent section should have no index, got one")
            }

            print("toml_missing_section: ok")
        },
        case Err(e) -> panic("parse should have succeeded: {e.message}")
    }
}
