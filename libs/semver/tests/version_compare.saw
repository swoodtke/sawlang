import src.lib.*

func mk(a: Int, b: Int, c: Int) -> Version {
    Version(major: a, minor: b, patch: c)
}

func main() {
    assert(mk(1, 2, 3) < mk(1, 2, 4), "patch orders")
    assert(mk(1, 2, 3) < mk(1, 3, 0), "minor outranks patch")
    assert(mk(1, 9, 9) < mk(2, 0, 0), "major outranks minor")
    assert(mk(2, 0, 0) > mk(1, 9, 9), "greater-than")
    assert(mk(1, 2, 3) == mk(1, 2, 3), "equality")
    assert(mk(1, 2, 3) <= mk(1, 2, 3), "<= on equal")
    assert(mk(1, 2, 4) >= mk(1, 2, 3), ">=")
    assert(not (mk(1, 2, 3) < mk(1, 2, 3)), "not less than self")
    print("version_compare: ok")
}
