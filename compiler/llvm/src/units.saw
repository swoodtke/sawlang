// Which codegen unit each of the program's definitions belongs to, when a
// build compiles its `.ll` per Saw module (SL-955): one unit per module, and
// the whole-program pieces (the C entry point, the backtrace table, the
// compiler's helpers, the task roots' frame descriptors) in a unit of their
// own. A definition that belongs to no module, which any module's use may
// call into being, is copied into each unit that uses it instead. So an edit
// to one module moves no other module's definitions, except a generic
// instance, which lives with its template. The splitter (split.saw) places
// what the plan does not name.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.module.{ll_closure_release_symbol, ll_code_thunk_symbol, ll_descriptor_symbol, ll_offload_thunk_symbol,
                       ll_resume_symbol, ll_static_symbol, ll_symbol, ll_thread_trampoline_symbol,
                       ll_value_thunk_symbol}
import sawllvm.prims.{ll_try_failure_symbol}
import sawmir.program.{MirProgram}
import sawmono.program.{MonoItemKind, MonoProgram}
import sawresolve.model.{ResDeclKind}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.typeops.{TcClient}

// The plan's unit for a definition copied into each unit that uses it, as
// `linkonce_odr hidden` (`ll_split_write`).
public static LL_UNIT_COPY: Int = -2

// The units a split build compiles, by name, and by symbol the unit each
// definition the plan places is in. Unit `shared` holds the whole-program
// pieces and every definition the splitter finds no other home for.
// `exports` holds the C symbol of each `@export`, function or static, in
// declaration order: what a link that optimises across the units keeps global.
public struct LlUnitPlan {
    names: Vector<String>
    owners: Map<String, Int>
    shared: Int
    exports: Vector<String>
}

extension LlUnitPlan: NoCopy {}

extension LlUnitPlan {
    // The plan of a whole-module build, which names no unit.
    public init() -> LlUnitPlan {
        LlUnitPlan(names: Vector<String>(), owners: Map<String, Int>(), shared: 0, exports: Vector<String>())
    }
}

// THE UNIT FUNNEL: the plan of `mono`'s program. A function item, a generic
// instance included, is in the unit of the module its body is written in,
// which for an instance is its template's, and so are its resume function,
// its closure release and its thread trampoline, which only its own body's
// module makes. A static is in its declaring module's unit, and a task
// root's frame descriptor, which carries the root's backtrace index, in the
// shared unit. Every other definition the backend makes for a use, which
// another module's edit could add or remove, is `LL_UNIT_COPY`: glue of any
// type, the code-address and function-value thunks taken of an item, an
// offload thunk, and a `try!`'s failure helper.
//
// ENTRY POINTS:
//   llvm_build_planned
public func ll_unit_plan(mono: &MonoProgram) -> LlUnitPlan {
    var plan = LlUnitPlan()
    try! plan.names.push("-program")
    var by_module = Vector<Int>()
    var m = 0
    while m < mono.dp.bc.mir.tc.res.module_count() {
        try! by_module.push(-1)
        m = m + 1
    }
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        let item = k
        k = k + 1
        if it.kind == MonoItemKind.Extern {
            if it.decl >= 0 {
                let name = mono.dp.bc.mir.tc.res.name_text(mono.dp.bc.mir.tc.res.decls[it.decl].name)
                let _ = try! plan.owners.insert(ll_offload_thunk_symbol(name), LL_UNIT_COPY)
            }
            continue
        }
        if it.kind != MonoItemKind.Function {
            let _ = try! plan.owners.insert(ll_symbol(&mono, item), LL_UNIT_COPY)
            continue
        }
        let home = if it.body >= 0 { mono.dp.bc.mir.funcs[it.body].module } else { -1 }
        if home < 0 {
            continue
        }
        let u = ll_module_unit(&var plan, &var by_module, &mono, home)
        let _ = try! plan.owners.insert(ll_symbol(&mono, item), u)
        let _ = try! plan.owners.insert(ll_resume_symbol(&mono, item), u)
        let _ = try! plan.owners.insert(ll_code_thunk_symbol(&mono, item), LL_UNIT_COPY)
        let _ = try! plan.owners.insert(ll_value_thunk_symbol(&mono, item), LL_UNIT_COPY)
        let _ = try! plan.owners.insert(ll_closure_release_symbol(&mono, item), u)
        let _ = try! plan.owners.insert(ll_thread_trampoline_symbol(&mono, item), u)
        if mono.is_task_root(item) || item == mono.main_item {
            let _ = try! plan.owners.insert(ll_descriptor_symbol(&mono, item), plan.shared)
        }
    }
    // A failing `try!` gets a helper per error type, which is some Result's.
    var t = 0
    while t < mono.dp.bc.mir.tc.types.count() {
        let ty = t
        t = t + 1
        if not mono.dp.bc.mir.tc.is_result(ty) || mono.dp.bc.mir.tc.ty(ty).count < 2 {
            continue
        }
        let error = mono.dp.bc.mir.tc.types.arg(ty, 1)
        let _ = try! plan.owners.insert(ll_try_failure_symbol(&mono, error), LL_UNIT_COPY)
    }
    var d = 0
    while d < mono.dp.bc.mir.tc.res.decls.len() {
        let decl = mono.dp.bc.mir.tc.res.decls[d]
        if decl.kind == ResDeclKind.Static && decl.module >= 0 {
            let u = ll_module_unit(&var plan, &var by_module, &mono, decl.module)
            let _ = try! plan.owners.insert(ll_static_symbol(&mono, d), u)
        }
        let exported = mono.dp.bc.mir.tc.export_symbols.get(d) ?? ""
        if exported.len() > 0 && (decl.kind == ResDeclKind.Static || ll_exports_item(&mono, d)) {
            try! plan.exports.push(exported)
        }
        d = d + 1
    }
    move plan
}

// Whether function declaration `d` is one of the program's exported items,
// which mono reaches only when the profile roots it.
func ll_exports_item(mono: &MonoProgram, d: Int) -> Bool {
    var j = 0
    while j < mono.export_items.len() {
        if mono.items[mono.export_items[j]].decl == d {
            return true
        }
        j = j + 1
    }
    false
}

// The unit of module `m`, made the first time a definition names it.
func ll_module_unit(plan: &var LlUnitPlan, by_module: &var Vector<Int>, mono: &MonoProgram, m: Int) -> Int {
    let have = by_module[m]
    if have >= 0 {
        return have
    }
    let u = plan.names.len()
    try! plan.names.push(mono.dp.bc.mir.tc.res.module_name(m))
    by_module[m] = u
    u
}
