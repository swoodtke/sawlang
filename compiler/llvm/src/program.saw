// The whole program as one `.ll`: a header naming the target and the link
// it needs, then the constants, the declarations, every item's function in
// item order, the C entry point and the compiler's own helpers. Nothing is
// iterated in hash order, so the text is a function of the program alone.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.attributes.{ll_function_attribute_group, ll_function_attributes}
import sawllvm.bodies.{ll_param_name}
import sawllvm.erased.{ll_drop_nothing}
import sawllvm.prims.{LL_FAIL_KINDS, LL_FAIL_PART_SIZE, LL_MESSAGE_LIMIT, LL_PART_BOOL, LL_PART_SIGNED,
                          LL_PART_UNSIGNED, ll_fail_reason, ll_fail_symbol}
import sawcoro.lower.{CORO_STATE_START}
import sawllvm.module.{LlEmitter, LlLowering, ll_descriptor_symbol, ll_export_symbol, ll_is_scalar, ll_resume_symbol,
                       ll_symbol, ll_value_type}
import sawllvm.text.{ll_quoted}
import sawparse.grammar.{Alt}
import sawresolve.model.{ResDeclKind}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MONO_KEY_DROP, MonoItem, MonoItemKind, MonoProgram}
import sawtarget.layout.{Target, TargetKind, TargetLayout}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.typeops.{TcClient}

// The program's `.ll`, or "" when the backend refused something, which the
// refusals in `mono.diags` say. `speed` is the optimisation flag the link
// manifest carries to clang; `module_triple`, when not empty, is the triple
// the module names, which the driver passes clang as `-target`.
public func llvm_emit_program(mono: &var MonoProgram, target: &var Target, lowering: LlLowering, speed: String,
                              module_triple: String) -> String {
    var e = LlEmitter(lowering: move lowering)
    // The helpers copy with it whether or not any function does.
    e.declare("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
    // A program's entry point defines the argument accessors (runtime/ABI.md,
    // "Program arguments"), which std's `extern` declarations name, and,
    // when it hands `main`'s frame to the entry executor, the descriptor call
    // the executor resumes a frame through (runtime/ABI.md, "The compiler →
    // executor boundary"). A runtime has no entry point: those belong to the
    // program it is linked into.
    if not mono.runtime {
        e.defines("__saw_rt_get_argc")
        e.defines("__saw_rt_get_argv")
        if mono.exec_item >= 0 {
            e.defines("__saw_frame_resume")
        }
        if mono.main_item < 0 {
            try! mono.problems.push("the entry module declares no `main` with a body")
            return ""
        }
    }
    // An export is defined here, so an `extern` naming its symbol is called
    // with no declaration beside the definition.
    var x = 0
    while x < mono.export_items.len() {
        let item = mono.export_items[x]
        let exported = ll_export_symbol(&mono, item)
        e.defines(exported)
        x = x + 1
    }
    var s = 0
    while s < mono.dp.bc.mir.tc.export_symbols.len() {
        let symbol = mono.dp.bc.mir.tc.export_symbols.get(s) ?? ""
        if symbol.len() > 0 && mono.dp.bc.mir.tc.res.decls[s].kind == ResDeclKind.Static {
            let node = mono.dp.bc.mir.tc.export_nodes[s]
            mono.refuse(node, "backend.not-yet", "an exported static is not in the backend slice yet")
            return ""
        }
        s = s + 1
    }
    if ll_refuse_placement(&var mono) {
        return ""
    }
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        if it.body >= 0 {
            e.emit_function(&var mono, &var target, k)
        } else if it.kind == MonoItemKind.DropGlue {
            e.emit_erased_drop(&var mono, &var target, k)
        }
        k = k + 1
    }
    var drops_nothing = false
    k = 0
    while k < mono.vtables.len() {
        let table = e.vtable(&var mono, &var target, k)
        try! e.globals.append(table)
        if mono.vtables[k].drop < 0 {
            drops_nothing = true
        }
        k = k + 1
    }
    if drops_nothing {
        try! e.defs.append(ll_drop_nothing())
    }
    // A lowered spawn site names its task root's frame descriptor, which the
    // executor reaches the task's frame through.
    k = 0
    while k < mono.items.len() {
        if mono.is_task_root(k) && e.resume_of(k) >= 0 {
            let descriptor = e.descriptor(&var mono, &var target, k)
            try! e.defs.append(descriptor)
        }
        k = k + 1
    }
    mono.current = -1
    var entry = ""
    if not mono.runtime {
        entry = e.entry_point(&var mono, &var target)
    }
    if mono.diags.len() > 0 || mono.problems.len() > 0 {
        return ""
    }
    var out = StringBuilder()
    try! out.append("; sawc2 link manifest\n")
    try! out.append("; target ")
    try! out.append(target.triple)
    try! out.append("\n; speed ")
    try! out.append(speed)
    if mono.runtime {
        try! out.append("\n; runtime none\n\n")
    } else {
        try! out.append("\n; runtime hosted\n\n")
    }
    try! out.append("target triple = \"")
    if module_triple.len() > 0 {
        try! out.append(module_triple)
    } else {
        try! out.append(target.triple)
    }
    try! out.append("\"\n\n")
    try! out.append(e.globals.build())
    try! out.append("\n")
    try! out.append(e.decls.build())
    try! out.append("\n")
    try! out.append(e.defs.build())
    try! out.append(entry)
    try! out.append(ll_helpers())
    if mono.panic_item >= 0 {
        let sink = mono.panic_item
        let symbol = e.plain_symbol(&var mono, sink)
        try! out.append(ll_fail_helpers(symbol))
    }
    try! out.append("\n\n")
    try! out.append(ll_function_attribute_group(&target, e.lowering.sanitize))
    out.build()
}

extension LlEmitter {
    // The C entry point: `main(argc, argv)` keeps both for the argument
    // accessors the compiler emits into every program (runtime/ABI.md, "Program
    // arguments"), runs the program's `main`, and exits with its `Int`, or 0
    // for a `Void` main. A plain `main` is called, then the background group
    // closed when the program spawns, since a task may still be running; one
    // with a lowered frame gets that frame on this function's stack, at state
    // 0, and is handed to the entry executor with its descriptor, its result
    // read from the frame once the executor returns, which has closed the
    // group itself.
    func entry_point(&var self, mono: &var MonoProgram, target: &var Target) -> String {
        let main = mono.items[mono.main_item]
        let f = mono.dp.bc.mir.funcs[main.body]
        let result = mono.dp.bc.mir.locals[f.local_first].ty
        let l = self.lay(&var mono, &var target, result)
        let attributes = ll_function_attributes("")
        var out = StringBuilder()
        try! out.append("@__saw_argc = internal global i32 0\n")
        try! out.append("@__saw_argv = internal global ptr null\n\n")
        try! out.append("define i32 @__saw_rt_get_argc()")
        try! out.append(attributes)
        try! out.append(" \{\n  %v = load i32, ptr @__saw_argc\n  ret i32 %v\n\}\n\n")
        try! out.append("define ptr @__saw_rt_get_argv()")
        try! out.append(attributes)
        try! out.append(" \{\n  %v = load ptr, ptr @__saw_argv\n  ret ptr %v\n\}\n\n")
        let main_item = mono.main_item
        let r = self.resume_of(main_item)
        if r >= 0 {
            try! out.append(self.descriptor(&var mono, &var target, main_item))
            try! out.append(ll_frame_resume_helper(target.closure_env_offset()))
        }
        try! out.append("define i32 @main(i32 %argc, ptr %argv)")
        try! out.append(attributes)
        try! out.append(" \{\nentry:\n")
        if r >= 0 {
            let resume = self.lowering.resumes[r]
            try! out.append("  %frame = alloca [")
            try! out.append(resume.size)
            try! out.append(" x i8], align ")
            try! out.append(resume.align)
            try! out.append("\n")
        }
        try! out.append("  store i32 %argc, ptr @__saw_argc\n  store ptr %argv, ptr @__saw_argv\n")
        let returns_int = l.kind == TargetKind.Int && mono.dp.bc.mir.tc.is_integer(result)
        if l.kind != TargetKind.Zero && not returns_int {
            mono.refuse(-1, "backend.not-yet", "a `main` returning anything but Void or Int is not in the backend slice yet")
        } else if r >= 0 {
            let resume = self.lowering.resumes[r]
            try! out.append("  store i64 ")
            try! out.append(CORO_STATE_START)
            try! out.append(", ptr %frame\n  call void ")
            // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.plain_symbol(&var mono, mono.exec_item))
            let executor = mono.exec_item
            try! out.append(self.plain_symbol(&var mono, executor))
            try! out.append("(ptr ")
            try! out.append(ll_descriptor_symbol(&mono, main_item))
            try! out.append(", ptr %frame)\n")
            if returns_int {
                try! out.append("  %result = getelementptr i8, ptr %frame, i64 ")
                try! out.append(resume.result)
                try! out.append("\n  %status = load ")
                try! out.append(ll_value_type(&l))
                try! out.append(", ptr %result\n")
            }
        } else {
            let symbol = self.plain_symbol(&var mono, main_item)
            if returns_int {
                try! out.append("  %status = call ")
                try! out.append(ll_value_type(&l))
                try! out.append(" ")
            } else {
                try! out.append("  call void ")
            }
            try! out.append(symbol)
            try! out.append("()\n")
            if mono.spawn_close_item >= 0 {
                // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.plain_symbol(&var mono, mono.spawn_close_item))
                let close = mono.spawn_close_item
                try! out.append("  call void ")
                try! out.append(self.plain_symbol(&var mono, close))
                try! out.append("()\n")
            }
        }
        if not returns_int {
            try! out.append("  ret i32 0\n")
        } else if l.bits > 32 {
            try! out.append("  %code = trunc ")
            try! out.append(ll_value_type(&l))
            try! out.append(" %status to i32\n  ret i32 %code\n")
        } else {
            try! out.append("  ret i32 %status\n")
        }
        try! out.append("\}\n\n")
        out.build()
    }

    // Item `k`'s frame descriptor, the constant record the executor reaches
    // its frame through, laid out as std's `FrameDescriptor` (runtime/ABI.md,
    // "The compiler → executor boundary"): its resume function, the frame's
    // size and alignment, the result's offset, size and alignment, a drop of
    // a result in place, and the backtrace index, -1 while there is no
    // backtrace table. The two functions are function values, a code
    // pointer and a null environment, so each code pointer is a thunk that
    // takes the environment first, as a function value's call passes it: the
    // resume's calls the resume function, and the drop's runs the result
    // type's drop glue, or nothing for a type that has none.
    func descriptor(&var self, mono: &var MonoProgram, target: &var Target, k: Int) -> String {
        let resume = self.lowering.resumes[self.resume_of(k)]
        let f = mono.dp.bc.mir.funcs[mono.items[k].body]
        let result = mono.dp.bc.mir.locals[f.local_first].ty
        let l = self.lay(&var mono, &var target, result)
        let glue = mono.glue_item(result, MONO_KEY_DROP)
        var out = StringBuilder()
        // A `Poll` is a memory value, so the function value returns it
        // through `sret`, ahead of the environment: its tag, an `i32`.
        try! out.append("define internal void ")
        try! out.append(ll_resume_value_symbol(&mono, k))
        try! out.append("(ptr %ret, ptr %env, ptr %frame, ptr %cx)")
        try! out.append(ll_function_attributes(""))
        try! out.append(" \{\nentry:\n  %poll = call i32 ")
        try! out.append(ll_resume_symbol(&mono, k))
        try! out.append("(ptr %frame, ptr %cx)\n  store i32 %poll, ptr %ret\n  ret void\n\}\n\n")
        try! out.append("define internal void ")
        try! out.append(ll_result_drop_symbol(&mono, k))
        try! out.append("(ptr %env, ptr %result)")
        try! out.append(ll_function_attributes(""))
        try! out.append(" \{\nentry:\n")
        if glue >= 0 {
            try! out.append("  call void ")
            try! out.append(self.plain_symbol(&var mono, glue))
            try! out.append("(ptr %result)\n")
        }
        try! out.append("  ret void\n\}\n\n")
        try! out.append(ll_descriptor_symbol(&mono, k))
        try! out.append(" = private unnamed_addr constant \{ ptr, ptr, i64, i64, i64, i64, i64, ptr, ptr, i64 \} \{ ptr ")
        try! out.append(ll_resume_value_symbol(&mono, k))
        try! out.append(", ptr null, i64 ")
        try! out.append(resume.size)
        try! out.append(", i64 ")
        try! out.append(resume.align)
        try! out.append(", i64 ")
        try! out.append(resume.result)
        try! out.append(", i64 ")
        try! out.append(l.size)
        try! out.append(", i64 ")
        try! out.append(if l.align > 0 { l.align } else { 1 })
        try! out.append(", ptr ")
        try! out.append(ll_result_drop_symbol(&mono, k))
        try! out.append(", ptr null, i64 -1 \}\n\n")
        out.build()
    }
}

// The symbol of item `k`'s descriptor's resume, the function value's code.
// Refuses every `@section` and `@align` the program writes, and says whether
// it refused one. The backend emits neither, and a kernel image that relies
// on where a static or function is placed, or how a static or local is
// aligned, would otherwise build and be wrong. Every attribute node is
// visited, whatever declaration or statement carries it, so no position the
// parser admits can reach emission with its attribute dropped.
//
// ENTRY POINTS:
//   llvm_emit_program
func ll_refuse_placement(mono: &var MonoProgram) -> Bool {
    var refused = false
    let count = mono.dp.bc.mir.tc.res.nodes.len()
    var id = 0
    while id < count {
        if mono.dp.bc.mir.tc.has_alt(id, Alt.Attr_Attribute_Section) {
            mono.refuse(id, "backend.not-yet",
                        "`@section` is not in the backend slice yet: nothing is placed in a named section, so the attribute would be dropped")
            refused = true
        } else if mono.dp.bc.mir.tc.has_alt(id, Alt.Attr_Attribute_Align) {
            mono.refuse(id, "backend.not-yet",
                        "`@align` is not in the backend slice yet: a static or a local is aligned only as its type asks, so the attribute would be dropped")
            refused = true
        }
        id = id + 1
    }
    refused
}

func ll_resume_value_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw resume value ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// The symbol of item `k`'s descriptor's result drop.
func ll_result_drop_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw drop result ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// `__saw_frame_resume(descriptor, frame, cx) -> Int32`, one resume of a frame
// through its descriptor's `resume` function value, called as a function
// value returning a `Poll` is (`sret`, then the environment), with the
// `Poll`'s tag as its result (runtime/ABI.md, "The compiler → executor
// boundary").
func ll_frame_resume_helper(env_offset: Int) -> String {
    var out = StringBuilder()
    try! out.append("define internal i32 @__saw_frame_resume(ptr %descriptor, ptr %frame, ptr %cx)")
    try! out.append(ll_function_attributes(""))
    try! out.append(" \{\nentry:\n  %poll.at = alloca i32, align 4\n  %resume = load ptr, ptr %descriptor\n")
    try! out.append("  %env.at = getelementptr i8, ptr %descriptor, i64 ")
    try! out.append(env_offset)
    try! out.append("\n  %env = load ptr, ptr %env.at\n")
    try! out.append("  call void %resume(ptr %poll.at, ptr %env, ptr %frame, ptr %cx)\n")
    try! out.append("  %poll = load i32, ptr %poll.at\n  ret i32 %poll\n\}\n\n")
    out.build()
}

// The compiler's own helpers (runtime/ABI.md's `__saw_*` tier, never a runtime
// seam): decimal rendering of an `i64`, signed and unsigned, and an append
// into a panic message's buffer that cuts at its limit, and the end that
// marks a cut.
func ll_helpers() -> String {
    let attributes = ll_function_attributes("")
    var out = StringBuilder()
    try! out.append("define internal i64 @__saw_render_uint(ptr %out, i64 %v)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %tmp = alloca [24 x i8], align 1\n  br label %loop\n")
    try! out.append("loop:\n  %n = phi i64 [ %v, %entry ], [ %q, %loop ]\n  %i = phi i64 [ 24, %entry ], [ %i1, %loop ]\n")
    try! out.append("  %q = udiv i64 %n, 10\n  %r = urem i64 %n, 10\n  %d = trunc i64 %r to i8\n  %c = add i8 %d, 48\n")
    try! out.append("  %i1 = sub i64 %i, 1\n  %p = getelementptr i8, ptr %tmp, i64 %i1\n  store i8 %c, ptr %p\n")
    try! out.append("  %more = icmp ne i64 %q, 0\n  br i1 %more, label %loop, label %done\n")
    try! out.append("done:\n  %len = sub i64 24, %i1\n  %src = getelementptr i8, ptr %tmp, i64 %i1\n")
    try! out.append("  call void @llvm.memcpy.p0.p0.i64(ptr %out, ptr %src, i64 %len, i1 false)\n  ret i64 %len\n\}\n\n")
    try! out.append("define internal i64 @__saw_render_int(ptr %out, i64 %v)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %neg = icmp slt i64 %v, 0\n  br i1 %neg, label %minus, label %plain\n")
    try! out.append("minus:\n  store i8 45, ptr %out\n  %mag = sub i64 0, %v\n  %rest = getelementptr i8, ptr %out, i64 1\n")
    try! out.append("  %n = call i64 @__saw_render_uint(ptr %rest, i64 %mag)\n  %len = add i64 %n, 1\n  ret i64 %len\n")
    try! out.append("plain:\n  %m = call i64 @__saw_render_uint(ptr %out, i64 %v)\n  ret i64 %m\n\}\n\n")
    // A position below zero is a closed buffer, `-1 - END`: an append cut
    // its text at END, on a UTF-8 boundary, so nothing more is written, and
    // `__saw_finish` stamps the `…` there. The scratch holds the limit's bytes
    // plus the marker and the line break.
    try! out.append("define internal i64 @__saw_append(ptr %buf, i64 %pos, ptr %src, i64 %len)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %closed = icmp slt i64 %pos, 0\n  br i1 %closed, label %keep, label %open\n")
    try! out.append("keep:\n  ret i64 %pos\n")
    try! out.append("open:\n  %room = sub i64 ")
    try! out.append(LL_MESSAGE_LIMIT)
    try! out.append(", %pos\n  %fits = icmp ule i64 %len, %room\n  br i1 %fits, label %whole, label %back\n")
    try! out.append("whole:\n  %at = getelementptr i8, ptr %buf, i64 %pos\n")
    try! out.append("  call void @llvm.memcpy.p0.p0.i64(ptr %at, ptr %src, i64 %len, i1 false)\n")
    try! out.append("  %end = add i64 %pos, %len\n  ret i64 %end\n")
    try! out.append("back:\n  %n = phi i64 [ %room, %open ], [ %n1, %step ]\n")
    try! out.append("  %none = icmp eq i64 %n, 0\n  br i1 %none, label %cut, label %test\n")
    try! out.append("test:\n  %p = getelementptr i8, ptr %src, i64 %n\n  %b = load i8, ptr %p\n")
    try! out.append("  %hi = and i8 %b, -64\n  %inside = icmp eq i8 %hi, -128\n  br i1 %inside, label %step, label %cut\n")
    try! out.append("step:\n  %n1 = sub i64 %n, 1\n  br label %back\n")
    try! out.append("cut:\n  %at2 = getelementptr i8, ptr %buf, i64 %pos\n")
    try! out.append("  call void @llvm.memcpy.p0.p0.i64(ptr %at2, ptr %src, i64 %n, i1 false)\n")
    try! out.append("  %stop = add i64 %pos, %n\n  %shut = sub i64 -1, %stop\n  ret i64 %shut\n\}\n\n")
    try! out.append("define internal i64 @__saw_finish(ptr %buf, i64 %pos)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %cut = icmp slt i64 %pos, 0\n  br i1 %cut, label %mark, label %line\n")
    try! out.append("mark:\n  %stop = sub i64 -1, %pos\n  %m0 = getelementptr i8, ptr %buf, i64 %stop\n")
    try! out.append("  store i8 -30, ptr %m0\n  %m1 = getelementptr i8, ptr %m0, i64 1\n  store i8 -128, ptr %m1\n")
    try! out.append("  %m2 = getelementptr i8, ptr %m0, i64 2\n  store i8 -90, ptr %m2\n  %marked = add i64 %stop, 3\n")
    try! out.append("  br label %line\n")
    try! out.append("line:\n  %end = phi i64 [ %marked, %mark ], [ %pos, %entry ]\n")
    try! out.append("  %nl = getelementptr i8, ptr %buf, i64 %end\n  store i8 10, ptr %nl\n")
    try! out.append("  %total = add i64 %end, 1\n  ret i64 %total\n\}\n\n")
    try! out.append("define internal i64 @__saw_append_int(ptr %buf, i64 %pos, i64 %v)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %tmp = alloca [24 x i8], align 1\n  %n = call i64 @__saw_render_int(ptr %tmp, i64 %v)\n")
    try! out.append("  %end = call i64 @__saw_append(ptr %buf, i64 %pos, ptr %tmp, i64 %n)\n  ret i64 %end\n\}\n\n")
    try! out.append("define internal i64 @__saw_append_uint(ptr %buf, i64 %pos, i64 %v)")
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %tmp = alloca [24 x i8], align 1\n  %n = call i64 @__saw_render_uint(ptr %tmp, i64 %v)\n")
    // The last line has no line break of its own: print supplies it.
    try! out.append("  %end = call i64 @__saw_append(ptr %buf, i64 %pos, ptr %tmp, i64 %n)\n  ret i64 %end\n\}")
    out.build()
}

// The failure funnel's helpers (prims.saw), each ending in the panic sink
// `sink`. Every one but the head is `noinline`, which keeps the message buffer
// and its formatting out of the checked function, so it stays small enough to
// inline, and `noreturn`, which already ranks its block unlikely. They are
// deliberately not `cold`: clang's hot/cold splitting then outlines every
// failing block into a `.cold.N` function with unwind entries of its own,
// which grows the object for no measured gain, as `!prof` weights on the check
// branches do (SL-528). A line below zero is a site with no line,
// rendered as its file alone.
func ll_fail_helpers(sink: String) -> String {
    let outlined = ll_function_attributes("noinline noreturn")
    var opening = StringBuilder()
    try! opening.append(")")
    try! opening.append(outlined)
    try! opening.append(" \{\nentry:\n  %buf = alloca [")
    let attributes = opening.build()
    var size = StringBuilder()
    try! size.append(LL_MESSAGE_LIMIT + 4)
    let buffer = size.build()
    var out = StringBuilder()
    try! out.append("\n\n@__saw_fail_at = private unnamed_addr constant [9 x i8] c\"panic at \"\n")
    try! out.append("@__saw_fail_colon = private unnamed_addr constant [2 x i8] c\": \"\n")
    try! out.append("@__saw_fail_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    try! out.append("@__saw_fail_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    var kind = 0
