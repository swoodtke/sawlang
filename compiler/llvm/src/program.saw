        let symbol = ll_fail_symbol(kind)
        let reason = ll_fail_reason(kind)
        try! out.append("@")
        try! out.append(symbol)
        try! out.append(".reason = private unnamed_addr constant [")
        try! out.append(reason.len())
        try! out.append(" x i8] c\"")
        try! out.append(reason)
        try! out.append("\"\n")
