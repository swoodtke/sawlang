// The whole program as one `.ll`: a header naming the target and the link
// it needs, then the constants, the declarations, every item's function in
// item order, the C entry point and the compiler's own helpers. Nothing is
// iterated in hash order, so the text is a function of the program alone.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.attributes.{ll_function_attribute_group, ll_function_attributes}
import sawllvm.bodies.{ll_param_name}
import sawllvm.closures.{ll_env_lead}
import sawllvm.debug.{LL_DEBUG_FIRST}
import sawllvm.erased.{ll_drop_nothing}
import sawllvm.prims.{LL_FAIL_KINDS, LL_FAIL_PART_SIZE, LL_MESSAGE_LIMIT, LL_PART_BOOL, LL_PART_SIGNED,
                          LL_PART_SIGNED_WIDE, LL_PART_UNSIGNED, LL_PART_UNSIGNED_WIDE, ll_fail_reason,
                          ll_fail_symbol}
import sawcoro.lower.{CORO_STATE_START}
import sawllvm.module.{LlEmitter, LlLowering, ll_bt_table_address, ll_descriptor_symbol, ll_export_symbol, ll_is_scalar,
                       ll_reaches_extern, ll_resume_symbol, ll_symbol, ll_value_type}
// For the extension writing `static_global`.
import sawllvm.places.{ll_local_slot}
import sawllvm.render.{ll_spelled}
import sawllvm.text.{ll_quoted}
import sawparse.grammar.{Alt}
// For the extension walking an attribute's carrier.
import sawresolve.collect.{res_is_top_level}
import sawresolve.model.{ResDeclKind}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MONO_KEY_DROP, MonoItem, MonoItemKind, MonoProgram}
import sawtarget.layout.{Target, TargetKind, TargetLayout, target_mach_o}
// For the extensions giving the placement funnel's fold and judge.
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.program.{TcProgram, TcSeams}
import sawtypecheck.typeops.{TcClient}

// The program's `.ll`, or "" when the backend refused something, which the
// refusals in `mono.diags` say. `speed` is the optimisation flag the link
// manifest carries to clang; `module_triple`, when not empty, is the triple
// the module names, which the driver passes clang as `-target`. With
// `debug`, the module carries line tables (debug.saw). `features` is the
// `--target-features` string the attribute group carries. With `object`, the
// module is a `-c` object's: it has the executable's linkage, and when the
// program declares no `main` it owes none and gets no C entry and no argument
// accessors, which only an entry point defines.
public func llvm_emit_program(mono: &var MonoProgram, target: &var Target, lowering: LlLowering, speed: String,
                              module_triple: String, debug: Bool, features: String = "",
                              object: Bool = false) -> String {
    var e = LlEmitter(lowering: move lowering)
    e.debug = debug
    e.dbg_optimized = not speed.equals("-O0")
    e.dbg_count = LL_DEBUG_FIRST
    // The integer type of a word, as `word_type` spells it for `Int`.
    var word = StringBuilder()
    try! word.append("i")
    try! word.append(target.word * 8)
    e.word = word.build()
    e.word_bits = target.word * 8
    // The helpers copy with it whether or not any function does.
    e.declare_memcpy()
    // A program's entry point defines the argument accessors (runtime/ABI.md,
    // "Program arguments"), which std's `extern` declarations name, and,
    // when it hands `main`'s frame to the entry executor, the descriptor call
    // the executor resumes a frame through (runtime/ABI.md, "The compiler →
    // executor boundary"). When std's task dump is reached, the backtrace
    // table's accessor is defined beside the table (`bt_table_global`). A
    // profile whose exports are the roots has no entry point (a runtime's
    // source and a freestanding object: those belong to whatever they are
    // linked into), and neither has a `-c` object of a program with no
    // `main`, which leaves the accessors to whatever it is linked with.
    let profile = mono.dp.bc.mir.tc.profile
    let bt_accessor = profile.backtrace_table() && ll_reaches_extern(&mono, ll_bt_table_address())
    let entry_point = profile.main_entry() && (not object || mono.main_item >= 0)
    if bt_accessor {
        e.defines(ll_bt_table_address())
    }
    if entry_point {
        e.defines("__saw_rt_get_argc")
        e.defines("__saw_rt_get_argv")
        if mono.exec_item >= 0 {
            e.defines("__saw_frame_resume")
        }
        // A checked file need not be a program, so only a build owes a
        // `main`; typecheck's entry-point funnel holds one that is declared
        // to its rules (`check_main_signature`).
        if mono.main_item < 0 {
            let entry = mono.dp.bc.mir.tc.entry_module_index()
            let root = mono.dp.bc.mir.tc.res.module(entry).root
            mono.refuse(root, "entry.missing", "the program declares no `main`: it starts at a top-level `func main()`, and a test-only `main` is not one")
            return ""
        }
    }
    // An export is defined here, so an `extern` naming its symbol is called
    // with no declaration beside the definition.
    var x = 0
    while x < mono.export_items.len() {
        let item = mono.export_items[x]
        let exported = ll_export_symbol(&mono, item)
        e.defines(exported)
        x = x + 1
    }
    if ll_placement(&var mono, &var target, &var e) {
        return ""
    }
    // An exported static is a root, and so is a placed one, which a linker
    // script may keep by its section: each has its global whether or not a
    // function reads it.
    var s = 0
    while s < mono.dp.bc.mir.tc.res.decls.len() {
        let symbol = mono.dp.bc.mir.tc.export_symbols.get(s) ?? ""
        let placed = e.decl_section.get(s) ?? ""
        if mono.dp.bc.mir.tc.res.decls[s].kind == ResDeclKind.Static && (symbol.len() > 0 || placed.len() > 0) {
            let node = mono.dp.bc.mir.tc.res.decls[s].node
            let t = mono.dp.bc.mir.tc.sigs[s].result
            let _ = e.static_global(&var mono, &var target, s, t, node)
        }
        s = s + 1
    }
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        if it.body >= 0 {
            e.emit_function(&var mono, &var target, k)
        } else if mono.function_value_glue(k) {
            e.emit_function_value_glue(&var mono, &var target, k)
        } else if it.kind == MonoItemKind.DropGlue {
            e.emit_erased_drop(&var mono, &var target, k)
        }
        k = k + 1
    }
    var drops_nothing = false
    k = 0
    while k < mono.vtables.len() {
        let table = e.vtable(&var mono, &var target, k)
        try! e.globals.append(table)
        if mono.vtables[k].drop < 0 {
            drops_nothing = true
        }
        k = k + 1
    }
    if drops_nothing {
        try! e.defs.append(ll_drop_nothing())
    }
    // A lowered spawn site names its task root's frame descriptor, which the
    // executor reaches the task's frame through.
    k = 0
    while k < mono.items.len() {
        if mono.is_task_root(k) && e.resume_of(k) >= 0 {
            let descriptor = e.descriptor(&var mono, &var target, k)
            let defined = e.debug_artificial(&mono, descriptor)
            try! e.defs.append(defined)
        }
        k = k + 1
    }
    if profile.backtrace_table() {
        let table = e.bt_table_global(target.triple, bt_accessor, profile.backtrace_section())
        try! e.globals.append(table)
    }
    mono.current = -1
    var entry = ""
    if entry_point {
        let defined = e.entry_point(&var mono, &var target)
        entry = e.debug_artificial(&mono, defined)
    }
    // Once every function is written, the error types its failing `try!`s
    // render are known, and each gets its helper.
    var h = 0
    while h < e.try_errors.len() {
        let t = e.try_errors[h]
        let helper = e.try_failure_helper(&var mono, &var target, t)
        let defined = e.debug_artificial(&mono, helper)
        try! e.defs.append(defined)
        h = h + 1
    }
    if profile.defines_every_seam() && not object {
        ll_check_provider_seams(&var mono, &e)
    }
    if mono.diags.len() > 0 || mono.problems.len() > 0 {
        return ""
    }
    var out = StringBuilder()
    try! out.append("; sawc link manifest\n")
    try! out.append("; target ")
    try! out.append(target.triple)
    try! out.append("\n; speed ")
    try! out.append(speed)
    if profile.seams() == TcSeams.Linked {
        try! out.append("\n; runtime hosted\n\n")
    } else {
        try! out.append("\n; runtime none\n\n")
    }
    try! out.append("target triple = \"")
    if module_triple.len() > 0 {
        try! out.append(module_triple)
    } else {
        try! out.append(target.triple)
    }
    try! out.append("\"\n\n")
    try! out.append(e.globals.build())
    try! out.append("\n")
    try! out.append(e.decls.build())
    try! out.append("\n")
    try! out.append(e.defs.build())
    try! out.append(entry)
    try! out.append(ll_helpers(e.word, e.wide_render))
    if mono.panic_item >= 0 {
        let sink = mono.panic_item
        let symbol = e.plain_symbol(&var mono, sink)
        let failing = e.debug_artificial(&mono, ll_fail_helpers(symbol, e.word, e.wide_render))
        try! out.append(failing)
        let renderer = mono.print_failure_item
        if renderer >= 0 {
            let renderer_symbol = e.plain_symbol(&var mono, renderer)
            let printing = e.debug_artificial(&mono, ll_print_failure_helper(renderer_symbol, e.word))
            try! out.append(printing)
        }
    }
    try! out.append("\n\n")
    try! out.append(ll_function_attribute_group(&target, e.lowering.sanitize, speed, features))
    let metadata = e.debug_metadata(&mono)
    try! out.append(metadata)
    out.build()
}

extension LlEmitter {
    // The C entry point: `main(argc, argv)` keeps both for the argument
    // accessors the compiler emits into every program (runtime/ABI.md, "Program
    // arguments"), runs the program's `main`, and exits with 0 for a `Void`
    // main, or the status `status_entry` computes from an `Int` or a `Result`.
    // A plain `main` is called, then the background group
    // closed when the program spawns, since a task may still be running; one
    // with a lowered frame gets that frame on this function's stack, at state
    // 0, and is handed to the entry executor with its descriptor, its result
    // read from the frame once the executor returns, which has closed the
    // group itself.
    func entry_point(&var self, mono: &var MonoProgram, target: &var Target) -> String {
        let main = mono.items[mono.main_item]
        let f = mono.dp.bc.mir.funcs[main.body]
        let result = mono.dp.bc.mir.locals[f.local_first].ty
        let l = self.lay(&var mono, &var target, result)
        let attributes = ll_function_attributes("")
        var out = StringBuilder()
        try! out.append("@__saw_argc = internal global i32 0\n")
        try! out.append("@__saw_argv = internal global ptr null\n\n")
        try! out.append("define i32 @__saw_rt_get_argc()")
        try! out.append(attributes)
        try! out.append(" \{\n  %v = load i32, ptr @__saw_argc\n  ret i32 %v\n\}\n\n")
        try! out.append("define ptr @__saw_rt_get_argv()")
        try! out.append(attributes)
        try! out.append(" \{\n  %v = load ptr, ptr @__saw_argv\n  ret ptr %v\n\}\n\n")
        let main_item = mono.main_item
        let r = self.resume_of(main_item)
        if r >= 0 {
            try! out.append(self.descriptor(&var mono, &var target, main_item))
            try! out.append(ll_frame_resume_helper(target.closure_env_offset(), self.word))
        }
        try! out.append("define i32 @main(i32 %argc, ptr %argv)")
        try! out.append(attributes)
        try! out.append(" \{\nentry:\n")
        if r >= 0 {
            let resume = self.lowering.resumes[r]
            try! out.append("  %frame = alloca [")
            try! out.append(resume.size)
            try! out.append(" x i8], align ")
            try! out.append(resume.align)
            try! out.append("\n")
        }
        let returns_int = l.kind == TargetKind.Int && mono.dp.bc.mir.tc.is_integer(result)
        let returns_result = mono.dp.bc.mir.tc.is_result(result)
        if returns_result || returns_int {
            let body = self.status_entry(&var mono, &var target, result, &l, r)
            try! out.append(self.allocas.build())
            try! out.append("  store i32 %argc, ptr @__saw_argc\n  store ptr %argv, ptr @__saw_argv\n")
            try! out.append(body)
            try! out.append("\}\n\n")
            return out.build()
        }
        try! out.append("  store i32 %argc, ptr @__saw_argc\n  store ptr %argv, ptr @__saw_argv\n")
        if l.kind != TargetKind.Zero {
            // Typecheck admits a `main` returning `Void`, `Int` or a `Result`
            // of either and nothing else (`check_main_signature`).
            try! mono.problems.push("a `main` returning anything but Void, Int or a Result of either reached the backend")
        } else if r >= 0 {
            try! out.append("  store ")
            try! out.append(self.word)
            try! out.append(" ")
            try! out.append(CORO_STATE_START)
            try! out.append(", ptr %frame\n  call void ")
            // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.plain_symbol(&var mono, mono.exec_item))
            let executor = mono.exec_item
            try! out.append(self.plain_symbol(&var mono, executor))
            try! out.append("(ptr ")
            try! out.append(ll_descriptor_symbol(&mono, main_item))
            try! out.append(", ptr %frame)\n")
        } else {
            let symbol = self.plain_symbol(&var mono, main_item)
            try! out.append("  call void ")
            try! out.append(symbol)
            try! out.append("()\n")
            if mono.spawn_close_item >= 0 {
                // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.plain_symbol(&var mono, mono.spawn_close_item))
                let close = mono.spawn_close_item
                try! out.append("  call void ")
                try! out.append(self.plain_symbol(&var mono, close))
                try! out.append("()\n")
            }
        }
        try! out.append("  ret i32 0\n")
        try! out.append("\}\n\n")
        out.build()
    }

    // The C entry's body past its argument stores, for a `main` returning an
    // `Int` or a `Result` of type `t`, laid out as `l`: the call, or the
    // frame handed to the executor (`r` its resume, else -1), then the
    // status `exit_status` checks the `Int` into or `main_status` reads from
    // the result. Written through the function state an item's body is, its
    // entry slots left in `allocas`. The error line follows the background
    // group's close, which a plain `main`'s call is followed by and the
    // executor does before it returns.
    func status_entry(&var self, mono: &var MonoProgram, target: &var Target, t: Int, l: &TargetLayout,
                      r: Int) -> String {
        let main_item = mono.main_item
        let main = mono.items[main_item]
        let node = mono.dp.bc.mir.tc.res.decls[main.decl].node
        self.current = main.body
        mono.current = main_item
        // The C entry has no subprogram, so nothing in it carries a location.
        self.debug_end()
        self.body = StringBuilder()
        self.allocas = StringBuilder()
        self.temps = 0
        self.labels = 0
        self.refused = false
        self.resume = -1
        self.sret = false
        let returns_result = mono.dp.bc.mir.tc.is_result(t)
        var at = ""
        var value = ""
        if r >= 0 {
            let resume = self.lowering.resumes[r]
            var state = StringBuilder()
            try! state.append(CORO_STATE_START)
            let word = self.word
            self.store(word, state.build(), "%frame")
            // Stage 0 workaround (SL:hazards S4): canonical: let executor = self.plain_symbol(&var mono, mono.exec_item)
            let exec_item = mono.exec_item
            let executor = self.plain_symbol(&var mono, exec_item)
            var call = StringBuilder()
            try! call.append("call void ")
            try! call.append(executor)
            try! call.append("(")
            try! call.append(ll_spelled("ptr", ll_descriptor_symbol(&mono, main_item)))
            try! call.append(", ptr %frame)")
            self.put(call.build())
            at = self.offset_addr("%frame", resume.result)
            if not returns_result {
                value = self.load(ll_value_type(&l), at)
            }
        } else {
            let symbol = self.plain_symbol(&var mono, main_item)
            var call = StringBuilder()
            try! call.append("call ")
            if not returns_result {
                try! call.append(ll_value_type(&l))
                try! call.append(" ")
                try! call.append(symbol)
                try! call.append("()")
                value = self.assign(call.build())
            } else if ll_is_scalar(&l) {
                at = self.slot(l.size, l.align)
                try! call.append(ll_value_type(&l))
                try! call.append(" ")
                try! call.append(symbol)
                try! call.append("()")
                let result = self.assign(call.build())
                self.store(ll_value_type(&l), result, at)
            } else {
                at = self.slot(l.size, l.align)
                try! call.append("void ")
                try! call.append(symbol)
                try! call.append("(")
                try! call.append(ll_spelled("ptr", at))
                try! call.append(")")
                self.put(call.build())
            }
            if mono.spawn_close_item >= 0 {
                // Stage 0 workaround (SL:hazards S4): canonical: let closer = self.plain_symbol(&var mono, mono.spawn_close_item)
                let close = mono.spawn_close_item
                let closer = self.plain_symbol(&var mono, close)
                var line = StringBuilder()
                try! line.append("call void ")
                try! line.append(closer)
                try! line.append("()")
                self.put(line.build())
            }
        }
        var status = ""
        if returns_result {
            status = self.main_status(&var mono, &var target, at, t, node)
        } else {
            status = self.exit_status(&var mono, value, &l, node)
        }
        var ret = StringBuilder()
        try! ret.append("ret i32 ")
        try! ret.append(status)
        self.put(ret.build())
        self.current = -1
        mono.current = -1
        self.body.build()
    }

    // Item `k`'s frame descriptor, the constant record the executor reaches
    // its frame through, laid out as std's `FrameDescriptor` (runtime/ABI.md,
    // "The compiler → executor boundary"): its resume function, the frame's
    // size and alignment, the result's offset, size and alignment, a drop of
    // a result in place, and the backtrace index, the root's frame in the
    // program's backtrace table (`bt_index_of`), where a task dump's walk of
    // the task starts. The two functions are function values, a code
    // pointer, a null environment and a null release, so each code pointer
    // is a thunk that takes the environment first, as a function value's call passes it: the
    // resume's calls the resume function, and the drop's runs the result
    // type's drop glue, or nothing for a type that has none.
    func descriptor(&var self, mono: &var MonoProgram, target: &var Target, k: Int) -> String {
        let resume = self.lowering.resumes[self.resume_of(k)]
        let f = mono.dp.bc.mir.funcs[mono.items[k].body]
        let result = mono.dp.bc.mir.locals[f.local_first].ty
        let l = self.lay(&var mono, &var target, result)
        let glue = mono.glue_item(result, MONO_KEY_DROP)
        var out = StringBuilder()
        // A `Poll` is a memory value, so the function value returns it
        // through `sret`, ahead of the environment: its tag, an `i32`.
        try! out.append("define internal void ")
        try! out.append(ll_resume_value_symbol(&mono, k))
        try! out.append("(ptr %ret, ptr %env, ptr %frame, ptr %cx)")
        try! out.append(ll_function_attributes(""))
        try! out.append(" \{\nentry:\n  %poll = call i32 ")
        try! out.append(ll_resume_symbol(&mono, k))
        try! out.append("(ptr %frame, ptr %cx)\n  store i32 %poll, ptr %ret\n  ret void\n\}\n\n")
        try! out.append("define internal void ")
        try! out.append(ll_result_drop_symbol(&mono, k))
        try! out.append("(ptr %env, ptr %result)")
        try! out.append(ll_function_attributes(""))
        try! out.append(" \{\nentry:\n")
        if glue >= 0 {
            try! out.append("  call void ")
            try! out.append(self.plain_symbol(&var mono, glue))
            try! out.append("(ptr %result)\n")
        }
        try! out.append("  ret void\n\}\n\n")
        try! out.append(ll_descriptor_symbol(&mono, k))
        let w = self.word
        try! out.append(" = private unnamed_addr constant \{ ptr, ptr, ptr, ")
        try! out.append(w)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(", ptr, ptr, ptr, ")
        try! out.append(w)
        try! out.append(" \} \{ ptr ")
        try! out.append(ll_resume_value_symbol(&mono, k))
        try! out.append(", ptr null, ptr null, ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(resume.size)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(resume.align)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(resume.result)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(l.size)
        try! out.append(", ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(if l.align > 0 { l.align } else { 1 })
        try! out.append(", ptr ")
        try! out.append(ll_result_drop_symbol(&mono, k))
        try! out.append(", ptr null, ptr null, ")
        try! out.append(w)
        try! out.append(" ")
        try! out.append(self.bt_index_of(k))
        try! out.append(" \}\n\n")
        out.build()
    }
}

// Refuses, once per seam, every `__saw_rt_*` symbol module `e` declares and
// does not define, for a program linked with none of sawc's runtime objects
// (`TcProfile.defines_every_seam`): the module's declarations are the one
// complete list of what the link must supply, the backend's own lowerings
// included, so a missing seam is named here rather than by the linker.
func ll_check_provider_seams(mono: &var MonoProgram, e: &LlEmitter) {
    let entry = mono.dp.bc.mir.tc.entry_module_index()
    let root = mono.dp.bc.mir.tc.res.module(entry).root
    var k = 0
    while k < e.externs.len() {
        let symbol = e.externs.get(k) ?? ""
        k = k + 1
        if not symbol.starts_with("__saw_rt_") {
            continue
        }
        var msg = StringBuilder()
        try! msg.append("the program reaches the runtime seam `")
        try! msg.append(symbol)
        try! msg.append("` and no `@export` defines it: a runtime provider (`--runtime`) is linked with none of sawc's runtime objects, so it defines every seam it reaches; export it with the signature runtime/ABI.md gives, or build with `-c` or `--freestanding` to leave it to what the object is linked with")
        mono.refuse(root, "provider.undefined-seam", msg.build())
    }
}

// THE PLACEMENT FUNNEL: every `@section` and `@align` the program writes,
// visited once whatever declaration or statement carries it, recorded on `e`
// for the global, define or slot it places (`static_global`, `item_section`,
// `slot_align`), or refused; says whether it refused one. A kernel image that
// relies on where a static or function is placed, or how storage is aligned,
// would otherwise build and be wrong, so an attribute node no carrier claims
// is a broken invariant, never a dropped attribute. Typecheck has judged
// every `@align` argument it folds; one the fold leaves to a layout
// (`sizeof`, `alignof`) is folded here against the target and meets the same
// judge. A frame-resident local's `@align` is coroutine lowering's refusal,
// and a section name is judged against the target's object format here.
//
// ENTRY POINTS:
//   llvm_emit_program
func ll_placement(mono: &var MonoProgram, target: &var Target, e: &var LlEmitter) -> Bool {
    var refused = false
    var claimed = Set<Int>()
    var d = 0
    while d < mono.dp.bc.mir.tc.res.decls.len() {
        let kind = mono.dp.bc.mir.tc.res.decls[d].kind
        if kind == ResDeclKind.Static || kind == ResDeclKind.Func {
            let a = mono.dp.bc.mir.tc.res.decl_attribute(d, Alt.Attr_Attribute_Align)
            if a >= 0 {
                let _ = try! claimed.insert(a)
                var subject = StringBuilder()
                try! subject.append("the static `")
                try! subject.append(mono.dp.bc.mir.tc.res.name_text(mono.dp.bc.mir.tc.res.decls[d].name))
                try! subject.append("`")
                let v = ll_align_value(&var mono, &var target, a, subject.build())
                if v > 0 {
                    let _ = try! e.decl_align.insert(d, v)
                } else {
                    refused = true
                }
            }
            let s = mono.dp.bc.mir.tc.res.decl_attribute(d, Alt.Attr_Attribute_Section)
            if s >= 0 {
                let _ = try! claimed.insert(s)
                let name = ll_section_name(&var mono, target.triple, s)
                if name.len() > 0 {
                    let _ = try! e.decl_section.insert(d, ll_quoted(name))
                } else {
                    refused = true
                }
            }
        }
        d = d + 1
    }
    var attributes = Vector<Int>()
    let count = mono.dp.bc.mir.tc.res.nodes.len()
    var id = 0
    while id < count {
        if mono.dp.bc.mir.tc.has_alt(id, Alt.Attr_Attribute_Section) || mono.dp.bc.mir.tc.has_alt(id, Alt.Attr_Attribute_Align) {
            try! attributes.push(id)
        } else if mono.dp.bc.mir.tc.has_alt(id, Alt.Stmt_AttributedLocal) {
            let local = mono.dp.bc.mir.tc.res.last_node_child(id)
            let leaf = mono.dp.bc.mir.tc.res.first_leaf(mono.dp.bc.mir.tc.res.first_node_child(local))
            let n = mono.dp.bc.mir.tc.child_count(id)
            var k = 0
            while k < n {
                let c = mono.dp.bc.mir.tc.child(id, k)
                k = k + 1
                if not mono.dp.bc.mir.tc.has_alt(c, Alt.Attr_Attribute_Align) || leaf < 0 {
                    continue
                }
                let _ = try! claimed.insert(c)
                var subject = StringBuilder()
                try! subject.append("the local `")
                try! subject.append(mono.dp.bc.mir.tc.text(mono.dp.bc.mir.tc.node_module(leaf), leaf))
                try! subject.append("`")
                let v = ll_align_value(&var mono, &var target, c, subject.build())
                if v > 0 {
                    let _ = try! e.local_align.insert(leaf, v)
                } else {
                    refused = true
                }
            }
        }
        id = id + 1
    }
    var j = 0
    while j < attributes.len() {
        let a = attributes[j]
        j = j + 1
        if not claimed.contains(a) {
            try! mono.problems.push("an `@section` or `@align` reached the backend on no declaration or local the placement funnel places")
        }
    }
    refused
}

// The alignment `@align` attribute `a` on `subject` states, folded against
// `target`'s layouts, or 0 when it is refused here.
func ll_align_value(mono: &var MonoProgram, target: &var Target, a: Int, subject: String) -> Int {
    let arg = mono.dp.bc.mir.tc.res.first_node_child(a)
    let measures = mono.dp.bc.mir.tc.layout_measures(arg)
    mono.dp.bc.mir.tc.measured_nodes = Vector<Int>()
    mono.dp.bc.mir.tc.measured_values = Vector<Int>()
    var j = 0
    while j < measures.len() {
        let measured = mono.dp.bc.mir.tc.measured_type(measures[j])
        let l = target.layout(&var mono.dp.bc.mir.tc, measured)
        try! mono.dp.bc.mir.tc.measured_nodes.push(measures[j])
        let size = mono.dp.bc.mir.tc.measures_size(measures[j])
        try! mono.dp.bc.mir.tc.measured_values.push(if size { l.size } else { l.align })
        j = j + 1
    }
    let v = mono.dp.bc.mir.tc.fold_constant(arg)
    mono.dp.bc.mir.tc.measured_nodes = Vector<Int>()
    mono.dp.bc.mir.tc.measured_values = Vector<Int>()
    if not v.ok {
        try! mono.problems.push("an `@align` argument typecheck admitted does not fold")
        return 0
    }
    let why = mono.dp.bc.mir.tc.align_refusal(subject, v.bits)
    if why.len() > 0 {
        mono.refuse(arg, "constant.align", why)
        return 0
    }
    v.bits
}

// The name `@section` attribute `s` gives, or "" when it is refused for
// `triple`: an empty name (spec, Attributes), and on a Mach-O target a name
// that is not `SEGMENT,section` with each part 1 to 16 characters, which LLVM
// would otherwise abort on rather than report (DF-225f).
func ll_section_name(mono: &var MonoProgram, triple: String, s: Int) -> String {
    let m = mono.dp.bc.mir.tc.node_module(s)
    var name = ""
    let n = mono.dp.bc.mir.tc.child_count(s)
    var k = 0
    while k < n {
        let c = mono.dp.bc.mir.tc.child(s, k)
        k = k + 1
        let text = mono.dp.bc.mir.tc.text(m, c)
        if mono.dp.bc.mir.tc.is_leaf(c) && text.starts_with("\"") && text.len() >= 2 {
            name = text.substring(1, text.len() - 1)
        }
    }
    var written = StringBuilder()
    try! written.append("`@section(\"")
    try! written.append(name)
    try! written.append("\")`")
    let spelled = written.build()
    if name.len() == 0 {
        var msg = StringBuilder()
        try! msg.append(spelled)
        try! msg.append(" names no section: a section name is not empty")
        mono.refuse(s, "section.invalid", msg.build())
        return ""
    }
    if not target_mach_o(triple) || ll_mach_o_section(name) {
        return name
    }
    var msg = StringBuilder()
    try! msg.append(spelled)
    try! msg.append(" is not a valid section on this target: ")
    if name.index_of(44).is_some() {
        try! msg.append("mach-O names a segment and a section of 1 to 16 characters each, separated by a comma")
        mono.refuse(s, "section.invalid", msg.build())
        return ""
    }
    var bare = name
    if bare.starts_with(".") {
        bare = bare.substring(1, bare.len())
    }
    try! msg.append("mach-O names a section by SEGMENT and section, separated by a comma; write the two-part form — `@section(\"__TEXT,")
    try! msg.append(bare)
    try! msg.append("\")` for code, `@section(\"__DATA,")
    try! msg.append(bare)
    try! msg.append("\")` for data")
    if name.starts_with(".") {
        try! msg.append(". The bare `")
        try! msg.append(name)
        try! msg.append("` spelling is the ELF one, which the freestanding targets take")
    }
    mono.refuse(s, "section.invalid", msg.build())
    ""
}

// Whether `name` is a Mach-O section specifier: a segment and a section, each
// 1 to 16 characters, separated by a comma, optionally followed by more
// comma-separated attributes.
func ll_mach_o_section(name: String) -> Bool {
    let first = name.index_of(44)
    guard let comma = first else {
        return false
    }
    if comma < 1 || comma > 16 {
        return false
    }
    let rest = name.substring(comma + 1, name.len())
    let end = rest.index_of(44) ?? rest.len()
    end >= 1 && end <= 16
}

// The symbol of item `k`'s descriptor's resume, the function value's code.
func ll_resume_value_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw resume value ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// The symbol of item `k`'s descriptor's result drop.
func ll_result_drop_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw drop result ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// `__saw_frame_resume(descriptor, frame, cx) -> Int32`, one resume of a frame
// through its descriptor's `resume` function value, called as a function
// value returning a `Poll` is (`sret`, then the environment), with the
// `Poll`'s tag as its result (runtime/ABI.md, "The compiler → executor
// boundary").
func ll_frame_resume_helper(env_offset: Int, word: String) -> String {
    var out = StringBuilder()
    try! out.append("define internal i32 @__saw_frame_resume(ptr %descriptor, ptr %frame, ptr %cx)")
    try! out.append(ll_function_attributes(""))
    try! out.append(" \{\nentry:\n  %poll.at = alloca i32, align 4\n  %resume = load ptr, ptr %descriptor\n")
    try! out.append("  %env.at = getelementptr i8, ptr %descriptor, ")
    try! out.append(word)
    try! out.append(" ")
    try! out.append(env_offset)
    try! out.append("\n  %env = load ptr, ptr %env.at\n")
    try! out.append("  call void %resume(ptr %poll.at, ptr %env, ptr %frame, ptr %cx)\n")
    try! out.append("  %poll = load i32, ptr %poll.at\n  ret i32 %poll\n\}\n\n")
    out.build()
}

// Helper text `template` with `$W` spelled `word`, the integer type of a
// position or a length, `$V` spelled `value`, the type of the value a
// renderer takes, and `$S` spelled `suffix`, which names the 64-bit
// renderers apart from the word's.
func ll_spell(template: String, word: String, value: String, suffix: String) -> String {
    var out = StringBuilder()
    var start = 0
    var k = 0
    let n = template.len()
    while k < n {
        if (template.byte_at(k) as Int) == 36 && k + 1 < n {
            let mark = template.byte_at(k + 1) as Int
            if mark == 87 || mark == 86 || mark == 83 {
                try! out.append(template.substring(start, k))
                if mark == 87 {
                    try! out.append(word)
                } else if mark == 86 {
                    try! out.append(value)
                } else {
                    try! out.append(suffix)
                }
                k = k + 2
                start = k
                continue
            }
        }
        k = k + 1
    }
    try! out.append(template.substring(start, n))
    out.build()
}

// The decimal renderers of a value of type `value` (`$V`), unsigned then
// signed, named with `suffix` (`$S`), each writing into scratch at `out` and
// returning the length, a `word` (`$W`).
func ll_render_helpers(word: String, value: String, suffix: String) -> String {
    let attributes = ll_function_attributes("")
    var out = StringBuilder()
    try! out.append(ll_spell("define internal $W @__saw_render_uint$S(ptr %out, $V %v)", word, value, suffix))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append("entry:\n  %tmp = alloca [24 x i8], align 1\n  br label %loop\n")
    try! out.append(ll_spell("loop:\n  %n = phi $V [ %v, %entry ], [ %q, %loop ]\n  %i = phi $W [ 24, %entry ], [ %i1, %loop ]\n", word, value, suffix))
    try! out.append(ll_spell("  %q = udiv $V %n, 10\n  %r = urem $V %n, 10\n  %d = trunc $V %r to i8\n  %c = add i8 %d, 48\n", word, value, suffix))
    try! out.append(ll_spell("  %i1 = sub $W %i, 1\n  %p = getelementptr i8, ptr %tmp, $W %i1\n  store i8 %c, ptr %p\n", word, value, suffix))
    try! out.append(ll_spell("  %more = icmp ne $V %q, 0\n  br i1 %more, label %loop, label %done\n", word, value, suffix))
    try! out.append(ll_spell("done:\n  %len = sub $W 24, %i1\n  %src = getelementptr i8, ptr %tmp, $W %i1\n", word, value, suffix))
    try! out.append(ll_spell("  call void @llvm.memcpy.p0.p0.$W(ptr %out, ptr %src, $W %len, i1 false)\n  ret $W %len\n\}\n\n", word, value, suffix))
    try! out.append(ll_spell("define internal $W @__saw_render_int$S(ptr %out, $V %v)", word, value, suffix))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %neg = icmp slt $V %v, 0\n  br i1 %neg, label %minus, label %plain\n", word, value, suffix))
    try! out.append(ll_spell("minus:\n  store i8 45, ptr %out\n  %mag = sub $V 0, %v\n  %rest = getelementptr i8, ptr %out, $W 1\n", word, value, suffix))
    try! out.append(ll_spell("  %n = call $W @__saw_render_uint$S(ptr %rest, $V %mag)\n  %len = add $W %n, 1\n  ret $W %len\n", word, value, suffix))
    try! out.append(ll_spell("plain:\n  %m = call $W @__saw_render_uint$S(ptr %out, $V %v)\n  ret $W %m\n\}\n\n", word, value, suffix))
    out.build()
}

// The appends of a rendered value of type `value` (`$V`) at position `$W`
// of a panic message's buffer, signed then unsigned, named with `suffix`.
func ll_append_helpers(word: String, value: String, suffix: String) -> String {
    let attributes = ll_function_attributes("")
    var out = StringBuilder()
    try! out.append(ll_spell("define internal $W @__saw_append_int$S(ptr %buf, $W %pos, $V %v)", word, value, suffix))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %tmp = alloca [24 x i8], align 1\n  %n = call $W @__saw_render_int$S(ptr %tmp, $V %v)\n", word, value, suffix))
    try! out.append(ll_spell("  %end = call $W @__saw_append(ptr %buf, $W %pos, ptr %tmp, $W %n)\n  ret $W %end\n\}\n\n", word, value, suffix))
    try! out.append(ll_spell("define internal $W @__saw_append_uint$S(ptr %buf, $W %pos, $V %v)", word, value, suffix))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %tmp = alloca [24 x i8], align 1\n  %n = call $W @__saw_render_uint$S(ptr %tmp, $V %v)\n", word, value, suffix))
    try! out.append(ll_spell("  %end = call $W @__saw_append(ptr %buf, $W %pos, ptr %tmp, $W %n)\n  ret $W %end\n\}", word, value, suffix))
    out.build()
}

// The compiler's own helpers (runtime/ABI.md's `__saw_*` tier, never a runtime
// seam): decimal rendering of an integer at the word's width, signed and
// unsigned, an append into a panic message's buffer that cuts at its limit,
// and the end that marks a cut, every position and length a `word`. With
// `wide`, the renderers of an integer wider than the word follow, its digit
// loop dividing 64 bits (spec, "An integer argument renders at its own
// width"); a word-wide one never does.
func ll_helpers(word: String, wide: Bool) -> String {
    let attributes = ll_function_attributes("")
    var out = StringBuilder()
    try! out.append(ll_render_helpers(word, word, ""))
    // A position below zero is a closed buffer, `-1 - END`: an append cut
    // its text at END, on a UTF-8 boundary, so nothing more is written, and
    // `__saw_finish` stamps the `…` there. The scratch holds the limit's bytes
    // plus the marker and the line break.
    try! out.append(ll_spell("define internal $W @__saw_append(ptr %buf, $W %pos, ptr %src, $W %len)", word, word, ""))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %closed = icmp slt $W %pos, 0\n  br i1 %closed, label %keep, label %open\n", word, word, ""))
    try! out.append(ll_spell("keep:\n  ret $W %pos\n", word, word, ""))
    try! out.append(ll_spell("open:\n  %room = sub $W ", word, word, ""))
    try! out.append(LL_MESSAGE_LIMIT)
    try! out.append(ll_spell(", %pos\n  %fits = icmp ule $W %len, %room\n  br i1 %fits, label %whole, label %back\n", word, word, ""))
    try! out.append(ll_spell("whole:\n  %at = getelementptr i8, ptr %buf, $W %pos\n", word, word, ""))
    try! out.append(ll_spell("  call void @llvm.memcpy.p0.p0.$W(ptr %at, ptr %src, $W %len, i1 false)\n", word, word, ""))
    try! out.append(ll_spell("  %end = add $W %pos, %len\n  ret $W %end\n", word, word, ""))
    try! out.append(ll_spell("back:\n  %n = phi $W [ %room, %open ], [ %n1, %step ]\n", word, word, ""))
    try! out.append(ll_spell("  %none = icmp eq $W %n, 0\n  br i1 %none, label %cut, label %test\n", word, word, ""))
    try! out.append(ll_spell("test:\n  %p = getelementptr i8, ptr %src, $W %n\n  %b = load i8, ptr %p\n", word, word, ""))
    try! out.append("  %hi = and i8 %b, -64\n  %inside = icmp eq i8 %hi, -128\n  br i1 %inside, label %step, label %cut\n")
    try! out.append(ll_spell("step:\n  %n1 = sub $W %n, 1\n  br label %back\n", word, word, ""))
    try! out.append(ll_spell("cut:\n  %at2 = getelementptr i8, ptr %buf, $W %pos\n", word, word, ""))
    try! out.append(ll_spell("  call void @llvm.memcpy.p0.p0.$W(ptr %at2, ptr %src, $W %n, i1 false)\n", word, word, ""))
    try! out.append(ll_spell("  %stop = add $W %pos, %n\n  %shut = sub $W -1, %stop\n  ret $W %shut\n\}\n\n", word, word, ""))
    try! out.append(ll_spell("define internal $W @__saw_finish(ptr %buf, $W %pos)", word, word, ""))
    try! out.append(attributes)
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %cut = icmp slt $W %pos, 0\n  br i1 %cut, label %mark, label %line\n", word, word, ""))
    try! out.append(ll_spell("mark:\n  %stop = sub $W -1, %pos\n  %m0 = getelementptr i8, ptr %buf, $W %stop\n", word, word, ""))
    try! out.append(ll_spell("  store i8 -30, ptr %m0\n  %m1 = getelementptr i8, ptr %m0, $W 1\n  store i8 -128, ptr %m1\n", word, word, ""))
    try! out.append(ll_spell("  %m2 = getelementptr i8, ptr %m0, $W 2\n  store i8 -90, ptr %m2\n  %marked = add $W %stop, 3\n", word, word, ""))
    try! out.append("  br label %line\n")
    try! out.append(ll_spell("line:\n  %end = phi $W [ %marked, %mark ], [ %pos, %entry ]\n", word, word, ""))
    try! out.append(ll_spell("  %nl = getelementptr i8, ptr %buf, $W %end\n  store i8 10, ptr %nl\n", word, word, ""))
    try! out.append(ll_spell("  %total = add $W %end, 1\n  ret $W %total\n\}\n\n", word, word, ""))
    // The last line has no line break of its own: print supplies it.
    try! out.append(ll_append_helpers(word, word, ""))
    if wide {
        try! out.append("\n\n")
        try! out.append(ll_render_helpers(word, "i64", "64"))
        try! out.append(ll_append_helpers(word, "i64", "64"))
    }
    out.build()
}

// The failure funnel's helper for a `print` whose line could not be written
// (prims.saw's `fail_print`): std's `print_failure`, the function `renderer`
// names, writes the cause from the write's status into this frame's scratch,
// and `__saw_fail` panics with it at the site, cut and marked as every
// message is.
func ll_print_failure_helper(renderer: String, word: String) -> String {
    var out = StringBuilder()
    try! out.append(ll_spell("\n\ndefine internal void @__saw_fail_print(ptr %file, $W %file_len, $W %line, ", word, word, ""))
    try! out.append(word)
    try! out.append(" %status)")
    try! out.append(ll_function_attributes("noinline noreturn"))
    try! out.append(" \{\nentry:\n  %cause = alloca [")
    try! out.append(LL_MESSAGE_LIMIT + 4)
    try! out.append(" x i8], align 1\n  %n = call ")
    try! out.append(word)
    try! out.append(" ")
    try! out.append(renderer)
    try! out.append("(")
    try! out.append(word)
    try! out.append(" %status, ptr %cause, ")
    try! out.append(word)
    try! out.append(" ")
    try! out.append(LL_MESSAGE_LIMIT + 4)
    try! out.append(")\n")
    try! out.append(ll_spell("  call void @__saw_fail(ptr %file, $W %file_len, $W %line, ptr %cause, $W %n)\n", word, word, ""))
    try! out.append("  unreachable\n\}")
    out.build()
}

// The failure funnel's helpers (prims.saw), each ending in the panic sink
// `sink`. Every one but the head is `noinline`, which keeps the message buffer
// and its formatting out of the checked function, so it stays small enough to
// inline, and `noreturn`, which already ranks its block unlikely. They are
// deliberately not `cold`: clang's hot/cold splitting then outlines every
// failing block into a `.cold.N` function with unwind entries of its own,
// which grows the object for no measured gain, as `!prof` weights on the check
// branches do (SL-528). A line below zero is a site with no line,
// rendered as its file alone. Every position, length and line is a `word`,
// the sink's `length: Int` among them; with `wide`, the helpers rendering an
// integer wider than the word follow.
func ll_fail_helpers(sink: String, word: String, wide: Bool) -> String {
    let outlined = ll_function_attributes("noinline noreturn")
    var opening = StringBuilder()
    try! opening.append(")")
    try! opening.append(outlined)
    try! opening.append(" \{\nentry:\n  %buf = alloca [")
    let attributes = opening.build()
    var size = StringBuilder()
    try! size.append(LL_MESSAGE_LIMIT + 4)
    let buffer = size.build()
    var out = StringBuilder()
    try! out.append("\n\n@__saw_fail_at = private unnamed_addr constant [9 x i8] c\"panic at \"\n")
    try! out.append("@__saw_fail_colon = private unnamed_addr constant [2 x i8] c\": \"\n")
    try! out.append("@__saw_fail_true = private unnamed_addr constant [4 x i8] c\"true\"\n")
    try! out.append("@__saw_fail_false = private unnamed_addr constant [5 x i8] c\"false\"\n")
    var kind = 0
    while kind < LL_FAIL_KINDS {
        let symbol = ll_fail_symbol(kind)
        let reason = ll_fail_reason(kind)
        try! out.append("@")
        try! out.append(symbol)
        try! out.append(".reason = private unnamed_addr constant [")
        try! out.append(reason.len())
        try! out.append(" x i8] c\"")
        try! out.append(reason)
        try! out.append("\"\n")
        kind = kind + 1
    }
    try! out.append(ll_spell("\ndefine internal $W @__saw_fail_head(ptr %buf, ptr %file, $W %file_len, $W %line)", word, word, ""))
    try! out.append(ll_function_attributes(""))
    try! out.append(" \{\n")
    try! out.append(ll_spell("entry:\n  %at = call $W @__saw_append(ptr %buf, $W 0, ptr @__saw_fail_at, $W 9)\n", word, word, ""))
    try! out.append(ll_spell("  %named = call $W @__saw_append(ptr %buf, $W %at, ptr %file, $W %file_len)\n", word, word, ""))
    try! out.append(ll_spell("  %known = icmp sge $W %line, 0\n  br i1 %known, label %number, label %tail\n", word, word, ""))
    try! out.append(ll_spell("number:\n  %colon = call $W @__saw_append(ptr %buf, $W %named, ptr @__saw_fail_colon, $W 1)\n", word, word, ""))
    try! out.append(ll_spell("  %lined = call $W @__saw_append_uint(ptr %buf, $W %colon, $W %line)\n  br label %tail\n", word, word, ""))
    try! out.append(ll_spell("tail:\n  %pos = phi $W [ %named, %entry ], [ %lined, %number ]\n", word, word, ""))
    try! out.append(ll_spell("  %end = call $W @__saw_append(ptr %buf, $W %pos, ptr @__saw_fail_colon, $W 2)\n", word, word, ""))
    try! out.append(ll_spell("  ret $W %end\n\}\n\n", word, word, ""))
    let site = ll_spell("(ptr %file, $W %file_len, $W %line, ptr %text, $W %text_len", word, word, "")
    let head = ll_spell("  %head = call $W @__saw_fail_head(ptr %buf, ptr %file, $W %file_len, $W %line)\n", word, word, "")
    let text = ll_spell("  %pos = call $W @__saw_append(ptr %buf, $W %head, ptr %text, $W %text_len)\n", word, word, "")
    var tail = StringBuilder()
    try! tail.append(ll_spell(", $W %done)\n  call void ", word, word, ""))
    try! tail.append(sink)
    try! tail.append(ll_spell("(ptr %buf, $W %end)\n  unreachable\n\}\n\n", word, word, ""))
    let sunk = tail.build()
    var whole = StringBuilder()
    try! whole.append(ll_spell("  %end = call $W @__saw_finish(ptr %buf", word, word, ""))
    try! whole.append(sunk)
    let finish = whole.build()
    try! out.append("define internal void @__saw_fail")
    try! out.append(site)
    try! out.append(attributes)
    try! out.append(buffer)
    try! out.append(" x i8], align 1\n")
    try! out.append(head)
    try! out.append(ll_spell("  %done = call $W @__saw_append(ptr %buf, $W %head, ptr %text, $W %text_len)\n", word, word, ""))
    try! out.append(finish)
    try! out.append(ll_fail_value_helpers(site, attributes, buffer, head, text, finish, word, word, ""))
    // A part is its kind, then a run's address and length, an integer, or a
    // Bool's byte, `LL_FAIL_PART_SIZE` bytes in all: the kind and a length
    // are words, and the value's slot holds an integer wider than the word.
    try! out.append("define internal void @__saw_fail_parts")
    try! out.append(site)
    try! out.append(ll_spell(", ptr %parts, $W %count", word, word, ""))
    try! out.append(attributes)
    try! out.append(buffer)
    try! out.append(" x i8], align 1\n")
    try! out.append(head)
    try! out.append(text)
    try! out.append("  br label %loop\n")
    try! out.append(ll_spell("loop:\n  %i = phi $W [ 0, %entry ], [ %i1, %next ]\n  %at = phi $W [ %pos, %entry ], [ %after, %next ]\n", word, word, ""))
    try! out.append(ll_spell("  %more = icmp slt $W %i, %count\n  br i1 %more, label %part, label %last\n", word, word, ""))
    try! out.append(ll_spell("part:\n  %offset = mul $W %i, ", word, word, ""))
    try! out.append(LL_FAIL_PART_SIZE)
    try! out.append(ll_spell("\n  %p = getelementptr i8, ptr %parts, $W %offset\n  %kind = load $W, ptr %p\n", word, word, ""))
    try! out.append(ll_spell("  %first = getelementptr i8, ptr %p, $W 8\n  %second = getelementptr i8, ptr %p, $W 16\n", word, word, ""))
    try! out.append(ll_spell("  switch $W %kind, label %run [ $W ", word, word, ""))
    try! out.append(LL_PART_SIGNED)
    try! out.append(ll_spell(", label %signed $W ", word, word, ""))
    try! out.append(LL_PART_UNSIGNED)
    try! out.append(ll_spell(", label %unsigned $W ", word, word, ""))
    try! out.append(LL_PART_BOOL)
    if wide {
        try! out.append(ll_spell(", label %bool $W ", word, word, ""))
        try! out.append(LL_PART_SIGNED_WIDE)
        try! out.append(ll_spell(", label %signed64 $W ", word, word, ""))
        try! out.append(LL_PART_UNSIGNED_WIDE)
        try! out.append(", label %unsigned64 ]\n")
    } else {
        try! out.append(", label %bool ]\n")
    }
    try! out.append(ll_spell("run:\n  %src = load ptr, ptr %first\n  %len = load $W, ptr %second\n", word, word, ""))
    try! out.append(ll_spell("  %ran = call $W @__saw_append(ptr %buf, $W %at, ptr %src, $W %len)\n  br label %next\n", word, word, ""))
    try! out.append(ll_spell("signed:\n  %sv = load $W, ptr %first\n", word, word, ""))
    try! out.append(ll_spell("  %sd = call $W @__saw_append_int(ptr %buf, $W %at, $W %sv)\n  br label %next\n", word, word, ""))
    try! out.append(ll_spell("unsigned:\n  %uv = load $W, ptr %first\n", word, word, ""))
    try! out.append(ll_spell("  %ud = call $W @__saw_append_uint(ptr %buf, $W %at, $W %uv)\n  br label %next\n", word, word, ""))
    if wide {
        try! out.append(ll_spell("signed64:\n  %swv = load i64, ptr %first\n", word, word, ""))
        try! out.append(ll_spell("  %swd = call $W @__saw_append_int64(ptr %buf, $W %at, i64 %swv)\n  br label %next\n", word, word, ""))
        try! out.append(ll_spell("unsigned64:\n  %uwv = load i64, ptr %first\n", word, word, ""))
        try! out.append(ll_spell("  %uwd = call $W @__saw_append_uint64(ptr %buf, $W %at, i64 %uwv)\n  br label %next\n", word, word, ""))
    }
    try! out.append("bool:\n  %byte = load i8, ptr %first\n  %yes = icmp ne i8 %byte, 0\n")
    try! out.append("  %word = select i1 %yes, ptr @__saw_fail_true, ptr @__saw_fail_false\n")
    try! out.append(ll_spell("  %size = select i1 %yes, $W 4, $W 5\n", word, word, ""))
    try! out.append(ll_spell("  %bd = call $W @__saw_append(ptr %buf, $W %at, ptr %word, $W %size)\n  br label %next\n", word, word, ""))
    try! out.append(ll_spell("next:\n  %after = phi $W [ %ran, %run ], [ %sd, %signed ], [ %ud, %unsigned ], [ %bd, %bool ]", word, word, ""))
    if wide {
        try! out.append(", [ %swd, %signed64 ], [ %uwd, %unsigned64 ]")
    }
    try! out.append("\n")
    try! out.append(ll_spell("  %i1 = add $W %i, 1\n  br label %loop\n", word, word, ""))
    try! out.append(ll_spell("last:\n  %done = phi $W [ %at, %loop ]\n", word, word, ""))
    try! out.append(finish)
    if wide {
        try! out.append(ll_fail_value_helpers(site, attributes, buffer, head, text, finish, word, "i64", "64"))
    }
    kind = 0
    while kind < LL_FAIL_KINDS {
        let symbol = ll_fail_symbol(kind)
        let reason = ll_fail_reason(kind)
        try! out.append("define internal void @")
        try! out.append(symbol)
        try! out.append(ll_spell("(ptr %file, $W %file_len, $W %line)", word, word, ""))
        try! out.append(outlined)
        try! out.append(" \{\nentry:\n")
        try! out.append(ll_spell("  call void @__saw_fail(ptr %file, $W %file_len, $W %line, ptr @", word, word, ""))
        try! out.append(symbol)
        try! out.append(ll_spell(".reason, $W ", word, word, ""))
        try! out.append(reason.len())
        try! out.append(")\n  unreachable\n\}")
        kind = kind + 1
        if kind < LL_FAIL_KINDS {
            try! out.append("\n\n")
        }
    }
    out.build()
}

// `__saw_fail_signed` and `__saw_fail_unsigned` with `suffix`, each panicking
// with its text then an integer of type `value`, rendered by the append
// helpers of the same suffix; the pieces are `ll_fail_helpers`'.
func ll_fail_value_helpers(site: String, attributes: String, buffer: String, head: String, text: String,
                           finish: String, word: String, value: String, suffix: String) -> String {
    var out = StringBuilder()
    try! out.append(ll_spell("define internal void @__saw_fail_signed$S", word, value, suffix))
    try! out.append(site)
    try! out.append(ll_spell(", $V %v", word, value, suffix))
    try! out.append(attributes)
    try! out.append(buffer)
    try! out.append(" x i8], align 1\n")
    try! out.append(head)
    try! out.append(text)
    try! out.append(ll_spell("  %done = call $W @__saw_append_int$S(ptr %buf, $W %pos, $V %v)\n", word, value, suffix))
    try! out.append(finish)
    try! out.append(ll_spell("define internal void @__saw_fail_unsigned$S", word, value, suffix))
    try! out.append(site)
    try! out.append(ll_spell(", $V %v", word, value, suffix))
    try! out.append(attributes)
    try! out.append(buffer)
    try! out.append(" x i8], align 1\n")
    try! out.append(head)
    try! out.append(text)
    try! out.append(ll_spell("  %done = call $W @__saw_append_uint$S(ptr %buf, $W %pos, $V %v)\n", word, value, suffix))
    try! out.append(finish)
    out.build()
}
