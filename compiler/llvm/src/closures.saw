// Function values (spec, Escaping-closure heap environments): three words,
// the code, the environment and the release. An escaping closure that
// captures something keeps its captures in a heap block whose word just
// before the captures is an atomic count of the values sharing it; its
// release is the closure's own teardown, which drops the captures and frees
// the block when the last value lets go. Every other value, a capture-less
// closure, a non-escaping closure's environment local (SL-805) or a
// `Thread.spawn` brace's slot, has a null release, so copying or dropping it
// does nothing: the count is touched only through a release that is not
// null. The environment word points at the captures whichever kind holds
// them, so a closure body reads its environment one way.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.attributes.{ll_function_attributes}
import sawllvm.module.{LlEmitter, ll_symbol}
import sawllvm.places.{ll_local_slot}
import sawllvm.prims.{LL_MESSAGE_LIMIT}
import sawllvm.render.{ll_spelled}
import sawllvm.text.{ll_quoted}
import sawmir.build.{mir_func_local}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MONO_KEY_DROP, MonoProgram}
import sawresolve.program.{ResProgram}
import sawtarget.layout.{Target, TargetLayout}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

extension LlEmitter {
    // THE CLOSURE CONSTRUCTION: closure value `r` written into `dest`, its
    // code, its environment and its release. An environment the building
    // function keeps in a local of its own arrives as the closure's one
    // operand, that local's address (`closure_environment`). An escaping
    // closure's captures are written into a heap block of their own
    // (`heap_environment`). Any other is written into an entry-block slot: a
    // capture-less closure's, which nothing reads, and a `Thread.spawn`
    // brace's, which its site copies to the heap in the same terminator.
    // ENTRY POINTS:
    //     aggregate_into
    public func closure_into(&var self, mono: &var MonoProgram, target: &var Target, r: Int, dest: String,
                             node: Int) {
        let rv = mono.dp.bc.mir.rvalues[r]
        let item = mono.closure_item(r)
        if item < 0 {
            self.refuse_here(&var mono, node, "a closure whose body mono did not reach")
            return
        }
        let code = self.plain_symbol(&var mono, item)
        var env = "null"
        var release = "null"
        let body = mono.items[item].body
        if mono.dp.bc.mir.closure_environment(rv.decl) {
            let lent = mono.dp.bc.mir.lists[rv.first]
            env = self.operand_value(&var mono, &var target, lent, node)
        } else {
            let env_local = mono.dp.bc.mir.funcs[body].local_first + 1
            let env_ref = mono.dp.bc.mir.locals[env_local].ty
            // A thread body takes its environment by value; its spawn site
            // moves this one to the heap (`thread_spawn`).
            let referent = mono.dp.bc.mir.tc.referent(env_ref)
            let env_type = if referent >= 0 { referent } else { env_ref }
            let el = self.lay_at(&var mono, &var target, env_type, node)
            let thread = mono.dp.bc.mir.thread_body(body)
            if rv.count > 0 && not thread {
                env = self.heap_environment(&var mono, &var target, &el, node)
                release = self.closure_release(&var mono, &var target, item, env_type, node)
            } else {
                env = self.slot(el.size, el.align)
            }
            var k = 0
            while k < rv.count {
                let o = mono.dp.bc.mir.lists[rv.first + k]
                let t = mono.dp.bc.mir.operands[o].ty
                let off = target.member_offset(&var mono.dp.bc.mir.tc, env_type, k)
                let at = self.offset_addr(env, off)
                self.operand_into(&var mono, &var target, o, at, t, node)
                k = k + 1
            }
        }
        self.store("ptr", code, dest)
        let env_at = self.offset_addr(dest, target.closure_env_offset())
        self.store("ptr", env, env_at)
        let release_at = self.offset_addr(dest, target.closure_release_offset())
        self.store("ptr", release, release_at)
    }

    // THE COMPILER'S ALLOCATION: `size` bytes at `align` from the runtime's
    // allocation seam, for a block the compiler inserts that no source
    // construct names (spec, Allocation failure: where a refusal still
    // panics); returns its address. A refused allocation panics, naming
    // `what`, since no expression carries a `Result` to report it through;
    // a `Thread.spawn` site's `Result` is for the operating system's refusal
    // of the thread.
    // ENTRY POINTS:
    //     thread_spawn
    //     heap_environment
    public func compiler_allocation(&var self, mono: &var MonoProgram, word: String, size: Int, align: Int,
                                    what: String, node: Int) -> String {
        var seam = StringBuilder()
        try! seam.append("declare ptr @__saw_rt_alloc(")
        try! seam.append(word)
        try! seam.append(", ")
        try! seam.append(word)
        try! seam.append(")")
        self.declare("__saw_rt_alloc", seam.build())
        var call = StringBuilder()
        try! call.append("call ptr @__saw_rt_alloc(")
        try! call.append(word)
        try! call.append(" ")
        try! call.append(size)
        try! call.append(", ")
        try! call.append(word)
        try! call.append(" ")
        try! call.append(align)
        try! call.append(")")
        let block = self.assign(call.build())
        var test = StringBuilder()
        try! test.append("icmp ne ptr ")
        try! test.append(block)
        try! test.append(", null")
        let made = self.assign(test.build())
        let pass = self.new_label("allocation")
        let fail = self.new_label("allocation.refused")
        self.branch(made, pass, fail)
        self.put_label(fail)
        var text = StringBuilder()
        try! text.append(what)
        try! text.append(": allocation of ")
        try! text.append(size)
        try! text.append(" bytes (align ")
        try! text.append(align)
        try! text.append(") failed")
        let message = self.text_bytes(text.build())
        self.fail_message(&var mono, node, &message)
        self.put_label(pass)
        block
    }

    // A heap environment for captures of layout `el`: a block from the
    // compiler's allocation (`compiler_allocation`), its count word set to
    // one, the value being built its only holder. Returns the captures'
    // address.
    func heap_environment(&var self, mono: &var MonoProgram, target: &var Target, el: &TargetLayout,
                          node: Int) -> String {
        let word = self.word_type(&var mono, &var target, node)
        let lead = ll_env_lead(&target, &el)
        let size = lead + el.size
        let align = ll_env_align(&target, &el)
        let block = self.compiler_allocation(&var mono, word, size, align, "closure environment", node)
        let count_at = self.offset_addr(block, lead - target.word)
        self.store(word, "1", count_at)
        self.offset_addr(block, lead)
    }

    // THE RELEASE GLUE FUNNEL: the teardown of closure item `item`'s heap
    // environment, captures of type `env_type`, `void (ptr %env)`, defined
    // once per closure body: the captures' drop glue, which drops each one
    // in reverse capture order as a tuple's parts drop (spec, Deinit), then
    // the block freed. A value's release word names it; only the last
    // release of a shared environment calls it (`function_value_drop`).
    // Returns its symbol.
    // ENTRY POINTS:
    //     closure_into
    func closure_release(&var self, mono: &var MonoProgram, target: &var Target, item: Int, env_type: Int,
                         node: Int) -> String {
        var symbol = StringBuilder()
        try! symbol.append("@\"saw closure release ")
        try! symbol.append(ll_quoted(mono.item_name(item)))
        try! symbol.append("\"")
        let name = symbol.build()
        var k = 0
        while k < self.declared.len() {
            let one = self.declared.get(k) ?? ""
            if one.equals(name) {
                return name
            }
            k = k + 1
        }
        try! self.declared.push(name)
        let word = self.word_type(&var mono, &var target, node)
        let el = self.lay_at(&var mono, &var target, env_type, node)
        let lead = ll_env_lead(&target, &el)
        var text = StringBuilder()
        try! text.append("define internal void ")
        try! text.append(name)
        try! text.append("(ptr %env)")
        try! text.append(ll_function_attributes(""))
        try! text.append(" \{\nentry:\n")
        if mono.dp.bc.mir.owns(env_type) {
            let glue = mono.glue_item(env_type, MONO_KEY_DROP)
            if glue < 0 {
                try! mono.problems.push("a closure's heap environment reached the backend with no drop glue")
                return name
            }
            try! text.append("  call void ")
            try! text.append(self.plain_symbol(&var mono, glue))
            try! text.append("(ptr %env)\n")
        }
        try! text.append("  %block = getelementptr i8, ptr %env, i64 -")
        try! text.append(lead)
        try! text.append("\n  call void @__saw_rt_dealloc(ptr %block, ")
        try! text.append(word)
        try! text.append(" ")
        try! text.append(lead + el.size)
        try! text.append(", ")
        try! text.append(word)
        try! text.append(" ")
        try! text.append(ll_env_align(&target, &el))
        try! text.append(")\n  ret void\n\}\n\n")
        self.declare("__saw_rt_dealloc", ll_dealloc_declaration(word))
        try! self.defs.append(text.build())
        name
    }

    // A function value type's drop glue or copy glue, item `k`, which mono
    // makes with no body: the release, or the bits and the retain, of
    // `function_value_drop` and `function_value_copy`.
    public func emit_function_value_glue(&var self, mono: &var MonoProgram, target: &var Target, k: Int) {
        let it = mono.items[k]
        if mono.glue_item(it.glue_type, MONO_KEY_DROP) == k {
            self.function_value_drop(&var mono, &var target, k)
        } else {
            self.function_value_copy(&var mono, &var target, k)
        }
    }

    // THE RELEASE: drop glue item `k` of a function value type, `void (ptr
    // %v)`. A null release owns nothing. Otherwise the count drops by one,
    // with release ordering, so this thread's writes to the captures happen
    // before the teardown another thread may run; the value that took it to
    // zero fences with acquire and runs the release, which drops the
    // captures exactly once. A count already at zero is an over-release,
    // which panics rather than freeing the block twice (SL-795 needs the
    // count atomic, since a `sendable` closure is released on any thread).
    // ENTRY POINTS:
    //     emit_function_value_glue
    func function_value_drop(&var self, mono: &var MonoProgram, target: &var Target, k: Int) {
        let word = self.word_type(&var mono, &var target, -1)
        var text = StringBuilder()
        try! text.append("define internal void ")
        try! text.append(ll_symbol(&mono, k))
        try! text.append("(ptr %p1)")
        try! text.append(ll_function_attributes(""))
        try! text.append(" \{\nentry:\n")
        ll_function_value_words(&var text, &target)
        try! text.append("  %owns = icmp ne ptr %release, null\n  br i1 %owns, label %owned, label %done\n")
        try! text.append("owned:\n  %count.at = getelementptr i8, ptr %env, i64 -")
        try! text.append(target.word)
        try! text.append("\n  %old = atomicrmw sub ptr %count.at, ")
        try! text.append(word)
        try! text.append(" 1 release\n  %is.last = icmp eq ")
        try! text.append(word)
        try! text.append(" %old, 1\n  br i1 %is.last, label %last, label %held\n")
        try! text.append("last:\n  fence acquire\n  call void %release(ptr %env)\n  br label %done\n")
        try! text.append("held:\n  %under = icmp slt ")
        try! text.append(word)
        try! text.append(" %old, 1\n  br i1 %under, label %over, label %done\n")
        try! text.append("over:\n")
        if mono.panic_item >= 0 {
            let site = self.fail_site(&mono, -1)
            let message = self.text_bytes("over-release of a closure environment (refcount underflow)")
            let bytes = self.fail_bytes(&message)
            try! text.append("  call void @__saw_fail(")
            try! text.append(site)
            try! text.append(", ")
            try! text.append(bytes)
            try! text.append(")\n")
        }
        try! text.append("  unreachable\n")
        try! text.append("done:\n  ret void\n\}\n\n")
        try! self.defs.append(text.build())
    }

    // THE RETAIN: copy glue item `k` of a function value type, `void (ptr
    // %p1, ptr %p2)`, the copy at `%p1` of the value at `%p2`: its three
    // words, and the count raised by one when the release is not null. The
    // count only rises while a holder keeps the block alive, so the add
    // orders nothing and is monotonic, as `Arc`'s retain is (spec, Send and
    // Sync).
    // ENTRY POINTS:
    //     emit_function_value_glue
    func function_value_copy(&var self, mono: &var MonoProgram, target: &var Target, k: Int) {
        let word = self.word_type(&var mono, &var target, -1)
        self.declare("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
        var text = StringBuilder()
        try! text.append("define internal void ")
        try! text.append(ll_symbol(&mono, k))
        try! text.append("(ptr %p1, ptr %p2)")
        try! text.append(ll_function_attributes(""))
        try! text.append(" \{\nentry:\n  call void @llvm.memcpy.p0.p0.i64(ptr %p1, ptr %p2, i64 ")
        try! text.append(3 * target.word)
        try! text.append(", i1 false)\n")
        ll_function_value_words(&var text, &target)
        try! text.append("  %owns = icmp ne ptr %release, null\n  br i1 %owns, label %owned, label %done\n")
        try! text.append("owned:\n  %count.at = getelementptr i8, ptr %env, i64 -")
        try! text.append(target.word)
        try! text.append("\n  %old = atomicrmw add ptr %count.at, ")
        try! text.append(word)
        try! text.append(" 1 monotonic\n  br label %done\n")
        try! text.append("done:\n  ret void\n\}\n\n")
        try! self.defs.append(text.build())
    }
}

// The runtime's deallocation seam, declared with `word` sizes.
public func ll_dealloc_declaration(word: String) -> String {
    var out = StringBuilder()
    try! out.append("declare void @__saw_rt_dealloc(ptr, ")
    try! out.append(word)
    try! out.append(", ")
    try! out.append(word)
    try! out.append(")")
    out.build()
}

// `%env` and `%release`, read from the function value at `%p1`.
func ll_function_value_words(text: &var StringBuilder, target: &Target) {
    try! text.append("  %env.at = getelementptr i8, ptr %p1, i64 ")
    try! text.append(target.closure_env_offset())
    try! text.append("\n  %env = load ptr, ptr %env.at\n  %release.at = getelementptr i8, ptr %p1, i64 ")
    try! text.append(target.closure_release_offset())
    try! text.append("\n  %release = load ptr, ptr %release.at\n")
}

// How far a heap environment's captures, of layout `el`, sit into its
// block: a word for the count, or the captures' own alignment when it is
// wider, so the count is the word just before them either way.
public func ll_env_lead(target: &Target, el: &TargetLayout) -> Int {
    if el.align > target.word {
        return el.align
    }
    target.word
}

// A heap environment block's alignment: the count's word, or the captures'
// when it is wider.
func ll_env_align(target: &Target, el: &TargetLayout) -> Int {
    if el.align > target.word {
        return el.align
    }
    target.word
}
