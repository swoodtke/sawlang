// `sawc build`'s compile half: the program through every stage to one
// `.ll`, its link manifest heading the IR as comment lines. The driver writes
// it to a file and runs clang on it (compiler/tests/run/README.md). The
// backend's input is coroutine lowering's program.

import sawcoro.api.{coro_append_findings, coro_lower_cut, coro_lower_for}
import sawcoro.program.{CoroProgram}
import sawlex.stagetime.{StageTime, stagetime_begin, stagetime_end}
import sawllvm.module.{LlLowering, ll_export_symbol, ll_lowering}
import sawllvm.program.{llvm_emit_program}
import sawllvm.units.{LlUnitPlan, ll_unit_plan}
import sawmono.frontimage.{FrontCut}
import sawmono.program.{MonoProgram}
import sawtarget.layout.{Target}

// How `sawc build` treats its entry file.
public struct BuildOptions {
    std_root: String
    target: String
    // The optimisation flag clang receives (`speed_level`'s spelling).
    speed: String
    // The triple the module names, the one the driver passes clang as
    // `-target`; "" names the target as sawc does.
    module_triple: String
    // The driver's three profile flags: whether the file is a source of
    // sawc's runtime (`sawc runtime` alone), whether it is built under the
    // freestanding profile, and whether it is a runtime provider (`--runtime`).
    // Std's cut, which the build starts from, is made with them, its
    // profile record (`tc_profile`) among it, and the stages read the
    // record, never these.
    runtime: Bool
    freestanding: Bool
    provider: Bool
    // `--no-hidden-alloc`: typecheck refuses the allocations the compiler
    // inserts that no source construct names.
    no_hidden_alloc: Bool
    // `--sanitize address`: every function instrumented by AddressSanitizer,
    // and each lowered frame's values poisoned outside their lifetimes.
    sanitize_address: Bool
    // Whether the module carries DWARF line tables: on unless `-g0` asks
    // otherwise, and never for a runtime source.
    debug_info: Bool
    // `--target-features`: the LLVM subtarget feature string every function
    // is compiled for, or "".
    features: String
    // `-c`: the module is an object's, which owes no `main`.
    object: Bool
}

// The `.ll` of the program whose entry file is `path` into `ir`, returning
// 0; or, when any stage refused it, the record `sawc mono --check` would
// print into `out`, returning 1. The program's layer starts from `cut`,
// std's cut for the options' std root and profile and for
// `target_front_end(options.target, options.features)`.
public func llvm_build(out: &var StringBuilder, ir: &var StringBuilder, cut: FrontCut, path: String,
                       options: &BuildOptions, names: &Vector<String>, dirs: &Vector<String>) -> Int {
    var exports = Vector<String>()
    llvm_build_exporting(out: &var out, ir: &var ir, exports: &var exports, cut: move cut, path: path,
                         options: &options, names: &names, dirs: &dirs)
}

// `llvm_build`, with the plan of the program's codegen units (`ll_unit_plan`)
// in `plan`, which `ll_split` cuts the `.ll` by.
public func llvm_build_split(out: &var StringBuilder, ir: &var StringBuilder, plan: &var LlUnitPlan, cut: FrontCut,
                             path: String, options: &BuildOptions, names: &Vector<String>,
                             dirs: &Vector<String>) -> Int {
    var exports = Vector<String>()
    llvm_build_planned(out: &var out, ir: &var ir, exports: &var exports, plan: &var plan, split: true,
                       cut: move cut, path: path, options: &options, names: &names, dirs: &dirs)
}

// `llvm_build`, with the C symbol of each function the module defines for C
// added to `exports`, in declaration order.
public func llvm_build_exporting(out: &var StringBuilder, ir: &var StringBuilder, exports: &var Vector<String>,
                                 cut: FrontCut, path: String, options: &BuildOptions, names: &Vector<String>,
                                 dirs: &Vector<String>) -> Int {
    var plan = LlUnitPlan()
    llvm_build_planned(out: &var out, ir: &var ir, exports: &var exports, plan: &var plan, split: false,
                       cut: move cut, path: path, options: &options, names: &names, dirs: &dirs)
}

// THE BUILD: the program through every stage to its `.ll` in `ir`, and with
// `split`, the plan of its codegen units in `plan`.
//
// ENTRY POINTS:
//   llvm_build_exporting
//   llvm_build_split
func llvm_build_planned(out: &var StringBuilder, ir: &var StringBuilder, exports: &var Vector<String>,
                        plan: &var LlUnitPlan, split: Bool, cut: FrontCut, path: String,
                        options: &BuildOptions, names: &Vector<String>, dirs: &Vector<String>) -> Int {
    var front = StringBuilder()
    var coro = coro_lower_cut(out: &var front, front: move cut, path: path, notes: false, names: &names,
                              dirs: &dirs, no_hidden_alloc: options.no_hidden_alloc)
    let head = front.build()
    if coro.blocked || coro.diags.len() > 0 || coro.problems.len() > 0 {
        try! out.append(head)
        coro_append_findings(out: &var out, coro: &coro)
        return 1
    }
    var target = coro.mono.target_for()
    coro.sanitize = options.sanitize_address
    coro_lower_for(&var coro, &var target)
    if coro.problems.len() > 0 {
        try! out.append(head)
        coro_append_findings(out: &var out, coro: &coro)
        return 1
    }
    stagetime_begin(StageTime.Llvm)
    let lowering = ll_lowering(&coro)
    // A runtime's source carries no line tables, whatever the flag says.
    let lines = options.debug_info && not coro.mono.dp.bc.mir.tc.profile.runtime_source()
    let text = llvm_emit_program(&var coro.mono, &var target, move lowering, options.speed, options.module_triple,
                                 lines, features: options.features, object: options.object)
    stagetime_end(StageTime.Llvm)
    if text.len() == 0 {
        try! out.append(head)
        coro_append_findings(out: &var out, coro: &coro)
        return 1
    }
    try! ir.append(text)
    if split {
        plan = ll_unit_plan(&coro.mono)
    }
    var k = 0
    while k < coro.mono.export_items.len() {
        let item = coro.mono.export_items[k]
        try! exports.push(ll_export_symbol(&coro.mono, item))
        k = k + 1
    }
    0
}
