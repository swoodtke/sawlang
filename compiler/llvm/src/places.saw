// Places and operands: a place is the address its root and projections
// name, each projection at the target's offset; an operand is a scalar's SSA
// value, or a value written into, or read from, an address.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.prims.{LL_FAIL_TRY, LL_FAIL_UNWRAP, LL_MESSAGE_LIMIT, LL_PART_RUN, LL_PART_SIGNED, LlParts,
                         ll_parts_push}
import sawllvm.module.{LlEmitter, ll_is_scalar, ll_symbol, ll_value_type}
import sawllvm.text.{ll_double_constant, ll_fit_signed, ll_integer_value, ll_quoted, ll_string_bytes}
import sawmir.model.{MirConstKind, MirOperand, MirOperandKind, MirProjKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MONO_KEY_COPY, MonoProgram}
import sawresolve.dump.{res_sort_strings}
import sawresolve.program.{ResProgram}
import saweval.program.{EvalKind, EvalValue}
import sawtarget.layout.{Target, TargetKind, TargetLayout, TargetShape, target_member_type, target_struct_fields}
import sawtypecheck.arith.{tc_arith_max, tc_arith_min, tc_float_bits}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// The integer type an enum's or an Optional's tag is stored as, layout `l`'s
// tag width: Optional's flag byte, an enum's `Int32`, a raw backing's own.
public func ll_tag_type(l: &TargetLayout) -> String {
    var out = StringBuilder()
    try! out.append("i")
    try! out.append(l.tag_bytes * 8)
    out.build()
}

// The address of MIR local `l`'s slot.
public func ll_local_slot(l: Int) -> String {
    var name = StringBuilder()
    try! name.append("%l")
    try! name.append(l)
    name.build()
}

extension LlEmitter {
    // The address place `p` names.
    public func place_addr(&var self, mono: &var MonoProgram, target: &var Target, p: Int, node: Int) -> String {
        let count = mono.dp.bc.mir.places[p].count
        self.place_prefix_addr(&var mono, &var target, p, count, node)
    }

    // The address the first `steps` projections of place `p` name.
    public func place_prefix_addr(&var self, mono: &var MonoProgram, target: &var Target, p: Int, steps: Int,
                                  node: Int) -> String {
        let pl = mono.dp.bc.mir.places[p]
        var addr = ""
        var current = -1
        if pl.local >= 0 {
            addr = ll_local_slot(pl.local)
            current = self.local_type(&mono, pl.local)
        } else {
            current = mono.dp.bc.mir.tc.sigs[pl.static_decl].result
            addr = self.static_global(&var mono, &var target, pl.static_decl, current, node)
        }
        var k = 0
        while k < steps {
            let step = mono.dp.bc.mir.projs[pl.first + k]
            k = k + 1
            match step.kind {
                case Field -> {
                    let owner = mono.dp.bc.mir.tc.nominal_decl(current)
                    let fields = target_struct_fields(&mono.dp.bc.mir.tc, owner)
                    var index = -1
                    var j = 0
                    while j < fields.len() {
                        if fields[j] == step.decl {
                            index = j
                        }
                        j = j + 1
                    }
                    let off = target.member_offset(&var mono.dp.bc.mir.tc, current, index)
                    addr = self.offset_addr(addr, off)
                },
                case Tuple -> {
                    let off = target.member_offset(&var mono.dp.bc.mir.tc, current, step.index)
                    addr = self.offset_addr(addr, off)
                },
                case Deref -> {
                    addr = self.load("ptr", addr)
                },
                case Index -> {
                    let element = self.lay_at(&var mono, &var target, step.ty, node)
                    let base_layout = target.layout(&var mono.dp.bc.mir.tc, current)
                    var index = StringBuilder()
                    try! index.append("%l")
                    try! index.append(step.index)
                    let array = base_layout.shape == TargetShape.Array
                    if not array && base_layout.kind != TargetKind.Pointer {
                        self.refuse_here(&var mono, node, "indexing a slice is not in the backend slice yet")
                        return addr
                    }
                    var base = addr
                    if not array {
                        base = self.load("ptr", addr)
                    }
                    let word = self.word
                    let i = self.load(word, index.build())
                    if array {
                        self.check_index(&var mono, i, base_layout.length, node)
                    }
                    addr = self.element_addr(base, i, element.size)
                },
                case Payload -> {
                    let off = target.payload_offset(&var mono.dp.bc.mir.tc, current, step.decl, step.index)
                    addr = self.offset_addr(addr, off)
                },
                case Force -> {
                    self.check_case(&var mono, &var target, addr, current, step.decl, node)
                    let off = target.payload_offset(&var mono.dp.bc.mir.tc, current, step.decl, step.index)
                    addr = self.offset_addr(addr, off)
                },
                case FrameSlot -> {
                    addr = self.offset_addr(addr, step.index)
                }
            }
            current = step.ty
        }
        addr
    }

    // The tag of the enum or Optional value at `addr`, of type `t`, widened
    // to i64.
    public func tag_of(&var self, mono: &var MonoProgram, target: &var Target, addr: String, t: Int,
                       node: Int) -> String {
        let l = self.lay_at(&var mono, &var target, t, node)
        let ty = ll_tag_type(&l)
        if ty.equals("i64") {
            return self.load(ty, addr)
        }
        let raw = self.load(ty, addr)
        var widen = StringBuilder()
        try! widen.append("zext ")
        try! widen.append(ty)
        try! widen.append(" ")
        try! widen.append(raw)
        try! widen.append(" to i64")
        self.assign(widen.build())
    }

    // The address of element `i`, a word, of the elements at `base`, which
    // lie `size` bytes apart.
    public func element_addr(&var self, base: String, i: String, size: Int) -> String {
        var mul = StringBuilder()
        try! mul.append("mul ")
        try! mul.append(self.word)
        try! mul.append(" ")
        try! mul.append(i)
        try! mul.append(", ")
        try! mul.append(size)
        let scaled = self.assign(mul.build())
        var gep = StringBuilder()
        try! gep.append("getelementptr i8, ptr ")
        try! gep.append(base)
        try! gep.append(", ")
        try! gep.append(self.word)
        try! gep.append(" ")
        try! gep.append(scaled)
        self.assign(gep.build())
    }

    // A fixed array's bounds check: index `i`, a word, is in `0 ..< length`,
    // or the program panics as Stage 0's does, naming both (DF-249a).
    public func check_index(&var self, mono: &var MonoProgram, i: String, length: Int, node: Int) {
        var test = StringBuilder()
        try! test.append("icmp ult ")
        try! test.append(self.word)
        try! test.append(" ")
        try! test.append(i)
        try! test.append(", ")
        try! test.append(length)
        let within = self.assign(test.build())
        let pass = self.new_label("inbounds")
        let fail = self.new_label("outofbounds")
        self.branch(within, pass, fail)
        self.put_label(fail)
        var parts = LlParts()
        var wide = i
        if self.word_bits != 64 {
            var extend = StringBuilder()
            try! extend.append("sext ")
            try! extend.append(self.word)
            try! extend.append(" ")
            try! extend.append(i)
            try! extend.append(" to i64")
            wide = self.assign(extend.build())
        }
        ll_parts_push(&var parts, LL_PART_SIGNED, wide, "")
        var tail = StringBuilder()
        try! tail.append(" (len ")
        try! tail.append(length)
        try! tail.append(")")
        let bytes = self.text_bytes(tail.build())
        let g = self.pooled(&bytes, false, 0)
        var len = StringBuilder()
        try! len.append(bytes.len())
        ll_parts_push(&var parts, LL_PART_RUN, g, len.build())
        self.fail_parts(&var mono, node, "array: index out of range: ", &parts)
        self.put_label(pass)
    }

    // A forced payload's check: the value at `addr` holds case `decl`, or
    // the program panics as Stage 0's `!` and `try!` do.
    func check_case(&var self, mono: &var MonoProgram, target: &var Target, addr: String, t: Int, decl: Int,
                    node: Int) {
        let c = target.case_of(&var mono.dp.bc.mir.tc, t, decl)
        let tag = self.tag_of(&var mono, &var target, addr, t, node)
        var cmp = StringBuilder()
        try! cmp.append("icmp eq i64 ")
        try! cmp.append(tag)
        try! cmp.append(", ")
        try! cmp.append(c.tag)
        let ok = self.assign(cmp.build())
        let pass = self.new_label("forced")
        let fail = self.new_label("unforced")
        self.branch(ok, pass, fail)
        self.put_label(fail)
        if mono.dp.bc.mir.tc.is_optional(t) {
            self.fail_check(&var mono, node, LL_FAIL_UNWRAP)
        } else {
            self.fail_check(&var mono, node, LL_FAIL_TRY)
        }
        self.put_label(pass)
    }

    // THE STATIC GLOBAL FUNNEL: the global of static `d`, of concrete type
    // `t`, written once from its evaluated value with every part at the
    // offset the target's layout gives it, or zero-filled for a static with
    // no initializer, whose all-zero value typecheck has already admitted.
    // Every static is writable storage, so none is a constant.
    // ENTRY POINTS:
    //     place_prefix_addr
    func static_global(&var self, mono: &var MonoProgram, target: &var Target, d: Int, t: Int, node: Int) -> String {
        var name = StringBuilder()
        try! name.append("@\"static ")
        try! name.append(ll_quoted(mono.dp.bc.mir.tc.res.decl_identity(d)))
        try! name.append("\"")
        let symbol = name.build()
        if self.static_seen(d) {
            return symbol
        }
        let l = self.lay_at(&var mono, &var target, t, node)
        let v = mono.static_values[d]
        var line = StringBuilder()
        try! line.append(symbol)
        try! line.append(" = internal global ")
        if v.kind == EvalKind.Missing {
            if mono.dp.bc.mir.tc.static_initializer(d) >= 0 {
                if ll_holds_float(&var mono, &var target, t) {
                    self.refuse_here(&var mono, node, "a static whose initializer holds a Float: the constant evaluator holds no Float value yet (SL-722)")
                } else {
                    self.refuse_here(&var mono, node, "a static whose initializer the constant evaluator does not hold is not in the backend slice yet")
                }
                return symbol
            }
            try! line.append("[")
            try! line.append(l.size)
            try! line.append(" x i8] zeroinitializer, align ")
            try! line.append(l.align)
        } else if ll_is_scalar(&l) && (v.kind == EvalKind.Integer || v.kind == EvalKind.Boolean) {
            try! line.append(ll_value_type(&l))
            try! line.append(" ")
            try! line.append(ll_fit_signed(v.bits, l.bits))
        } else {
            let c = self.static_part(&var mono, &var target, v, t, node)
            if not c.ok {
                return symbol
            }
            try! line.append(c.ty)
            try! line.append(" ")
            try! line.append(c.value)
            try! line.append(", align ")
            try! line.append(l.align)
        }
        try! self.globals.append(line.build())
        try! self.globals.append("\n")
        symbol
    }

    // Value `v` of type `t` as an LLVM constant whose bytes are its layout's:
    // an integer, a `Bool`, an atomic's word or a case's tag as an integer
    // of its size, and a struct, an array or a repeat as a packed run of its
    // parts with zeroed padding between them, so no LLVM layout rule moves a
    // part. A value no part of which is set is `zeroinitializer`.
    func static_part(&var self, mono: &var MonoProgram, target: &var Target, v: EvalValue, t: Int,
                     node: Int) -> LlConstant {
        let l = self.lay_at(&var mono, &var target, t, node)
        if l.kind == TargetKind.Unsupported {
            return LlConstant(ty: "", value: "", zero: true, ok: false)
        }
        match v.kind {
            case Integer -> ll_word_constant(l.size, v.bits),
            case Boolean -> ll_word_constant(l.size, v.bits),
            case Cell -> ll_word_constant(l.size, v.bits),
            case Case -> {
                let c = target.case_of(&var mono.dp.bc.mir.tc, t, v.decl)
                if c.decl < 0 || l.tag_bytes <= 0 {
                    self.refuse_here(&var mono, node, "a static holding a case of this type is not in the backend slice yet")
                    return LlConstant(ty: "", value: "", zero: true, ok: false)
                }
                let tag = ll_word_constant(l.tag_bytes, c.tag)
                var run = LlRun()
                run.add(&tag)
                run.pad(l.size - l.tag_bytes)
                run.closed()
            },
            case Aggregate -> {
                if v.decl >= 0 {
                    return self.static_struct(&var mono, &var target, v, t, &l, node)
                }
                if v.count != l.length || l.shape != TargetShape.Array {
                    self.refuse_here(&var mono, node, "a static array literal whose length is not its type's")
                    return LlConstant(ty: "", value: "", zero: true, ok: false)
                }
                var elements = Vector<LlConstant>()
                var k = 0
                while k < v.count {
                    let part = mono.static_parts[v.bits + k]
                    let c = self.static_part(&var mono, &var target, part, l.element, node)
                    if not c.ok {
                        return c
                    }
                    try! elements.push(c)
                    k = k + 1
                }
                ll_array_constant(&elements, l.length, l.size)
            },
            case Repeat -> {
                if v.count != l.length || l.shape != TargetShape.Array {
                    self.refuse_here(&var mono, node, "a static repeat whose count is not its type's length")
                    return LlConstant(ty: "", value: "", zero: true, ok: false)
                }
                let part = mono.static_parts[v.bits]
                let c = self.static_part(&var mono, &var target, part, l.element, node)
                if not c.ok {
                    return c
                }
                if c.zero {
                    // A zero region stays one zeroinitializer however long
                    // it is, so it costs the image no bytes.
                    var ty = StringBuilder()
                    try! ty.append("[")
                    try! ty.append(l.length)
                    try! ty.append(" x ")
                    try! ty.append(c.ty)
                    try! ty.append("]")
                    return LlConstant(ty: ty.build(), value: "zeroinitializer", zero: true, ok: true)
                }
                var elements = Vector<LlConstant>()
                var k = 0
                while k < v.count {
                    try! elements.push(c)
                    k = k + 1
                }
                ll_array_constant(&elements, l.length, l.size)
            },
            case _ -> {
                self.refuse_here(&var mono, node, "a static holding this value is not in the backend slice yet")
                LlConstant(ty: "", value: "", zero: true, ok: false)
            }
        }
    }

    // Struct value `v` of type `t`, laid out as `l`: each field at its offset.
    func static_struct(&var self, mono: &var MonoProgram, target: &var Target, v: EvalValue, t: Int,
                       l: &TargetLayout, node: Int) -> LlConstant {
        let fields = target_struct_fields(&mono.dp.bc.mir.tc, v.decl)
        if fields.len() != v.count || l.shape != TargetShape.Record {
            self.refuse_here(&var mono, node, "a static struct whose parts are not its fields")
            return LlConstant(ty: "", value: "", zero: true, ok: false)
        }
        var run = LlRun()
        var at = 0
        var k = 0
        while k < fields.len() {
            let written = mono.dp.bc.mir.tc.sigs[fields[k]].result
            let member = target_member_type(&var mono.dp.bc.mir.tc, t, written)
            let off = target.member_offset(&var mono.dp.bc.mir.tc, t, k)
            let part = mono.static_parts[v.bits + k]
            let c = self.static_part(&var mono, &var target, part, member, node)
            if not c.ok {
                return c
            }
            let size = target.layout(&var mono.dp.bc.mir.tc, member).size
            run.pad(off - at)
            run.add(&c)
            at = off + size
            k = k + 1
        }
        run.pad(l.size - at)
        run.closed()
    }

    // The SSA value of scalar operand `o`.
    public func operand_value(&var self, mono: &var MonoProgram, target: &var Target, o: Int, node: Int) -> String {
        let op = mono.dp.bc.mir.operands[o]
        let l = self.lay_at(&var mono, &var target, op.ty, node)
        if op.kind == MirOperandKind.Const {
            return self.const_value(&var mono, &op, &l, node)
        }
        let addr = self.place_addr(&var mono, &var target, op.place, node)
        if not ll_is_scalar(&l) {
            self.refuse_here(&var mono, node, "a memory value where a scalar is read is not in the backend slice yet")
            return "0"
        }
        self.load(ll_value_type(&l), addr)
    }

    // The address of the String operand `o` names, read in place and never a
    // retained copy: a literal's String in a slot, the value a `&String`
    // holds, or the place itself.
    public func string_addr(&var self, mono: &var MonoProgram, target: &var Target, o: Int, node: Int) -> String {
        let op = mono.dp.bc.mir.operands[o]
        if op.kind == MirOperandKind.Const {
            let tmp = self.slot(target.word, target.word)
            self.operand_into(&var mono, &var target, o, tmp, op.ty, node)
            return tmp
        }
        if mono.dp.bc.mir.tc.referent(op.ty) >= 0 {
            return self.operand_value(&var mono, &var target, o, node)
        }
        self.place_addr(&var mono, &var target, op.place, node)
    }

    // A scalar constant's spelling at its layout.
    func const_value(&var self, mono: &var MonoProgram, op: &MirOperand, l: &TargetLayout, node: Int) -> String {
        let text = mono.dp.bc.mir.tc.name_text(op.text)
        if op.const_kind == MirConstKind.Int && l.kind == TargetKind.Int {
            var out = StringBuilder()
            try! out.append(ll_fit_signed(ll_integer_value(text), l.bits))
            return out.build()
        }
        if op.const_kind == MirConstKind.Float && l.kind == TargetKind.Float {
            // Typecheck refuses an unrepresentable literal (`float.unrepresentable`), so saturated bits never reach here.
            let v = tc_float_bits(&text)
            return ll_double_constant(v.bits)
        }
        if op.const_kind == MirConstKind.Bool {
            if text.equals("true") {
                return "1"
            }
            return "0"
        }
        if op.const_kind == MirConstKind.Builtin && l.kind == TargetKind.Int && mono.dp.bc.mir.tc.is_integer(op.ty) {
            // `T.max` and `T.min`: the bound of the constant's own type.
            let signed = not mono.dp.bc.mir.tc.is_unsigned(op.ty)
            var bound = StringBuilder()
            if ll_ends_with(&text, ".max") {
                try! bound.append(ll_fit_signed(tc_arith_max(l.bits, signed), l.bits))
                return bound.build()
            }
            if ll_ends_with(&text, ".min") {
                try! bound.append(ll_fit_signed(tc_arith_min(l.bits, signed), l.bits))
                return bound.build()
            }
        }
        let at = ll_constant_site(&mono, node, text)
        var msg = StringBuilder()
        if op.const_kind == MirConstKind.Float {
            try! msg.append("a Float constant, `")
            try! msg.append(text)
            try! msg.append("`, is not in the backend slice yet")
        } else if op.const_kind == MirConstKind.String {
            try! msg.append("the string literal ")
            try! msg.append(text)
            try! msg.append(" read as a scalar is not in the backend slice yet")
        } else {
            try! msg.append("the constant `")
            try! msg.append(text)
            try! msg.append("` is not in the backend slice yet")
        }
        self.refuse_here(&var mono, at, msg.build())
        "0"
    }

    // Operand `o`, of type `t`, written into `dest`. A copy of a type with
    // copy glue runs the glue; any other copy or move is the bits.
    public func operand_into(&var self, mono: &var MonoProgram, target: &var Target, o: Int, dest: String, t: Int,
                             node: Int) {
        let op = mono.dp.bc.mir.operands[o]
        let l = self.lay_at(&var mono, &var target, t, node)
        if op.kind == MirOperandKind.Const {
            if op.const_kind == MirConstKind.String {
                self.literal_into(&var mono, &var target, &op, dest, node)
                return
            }
            if op.const_kind == MirConstKind.Unit || l.kind == TargetKind.Zero {
                return
            }
            if not ll_is_scalar(&l) {
                self.refuse_here(&var mono, node, "a memory constant is not in the backend slice yet")
                return
            }
            let v = self.const_value(&var mono, &op, &l, node)
            self.store(ll_value_type(&l), v, dest)
            return
        }
        let src = self.place_addr(&var mono, &var target, op.place, node)
        if op.kind == MirOperandKind.Copy {
            let glue = mono.glue_item(op.ty, MONO_KEY_COPY)
            if glue >= 0 {
                var line = StringBuilder()
                try! line.append("call void ")
                try! line.append(self.plain_symbol(&var mono, glue))
                try! line.append("(ptr ")
                try! line.append(dest)
                try! line.append(", ptr ")
                try! line.append(src)
                try! line.append(")")
                self.put(line.build())
                return
            }
        }
        self.copy_bits(&l, dest, src)
    }

    // The address of operand `o`'s value, of type `t`: a place's own for a
    // move or a copy of the bits, else a slot written with the value.
    public func operand_addr(&var self, mono: &var MonoProgram, target: &var Target, o: Int, t: Int,
                             node: Int) -> String {
        let op = mono.dp.bc.mir.operands[o]
        let glued = op.kind == MirOperandKind.Copy && mono.glue_item(op.ty, MONO_KEY_COPY) >= 0
        if op.kind != MirOperandKind.Const && not glued {
            return self.place_addr(&var mono, &var target, op.place, node)
        }
        let l = self.lay_at(&var mono, &var target, t, node)
        let tmp = self.slot(l.size, l.align)
        self.operand_into(&var mono, &var target, o, tmp, t, node)
        tmp
    }

    // A String literal: its static block, wrapped by the literal role.
    func literal_into(&var self, mono: &var MonoProgram, target: &var Target, op: &MirOperand, dest: String,
                      node: Int) {
        if mono.literal_item < 0 {
            self.refuse_here(&var mono, node, "a String literal with no literal role bound")
            return
        }
        let text = mono.dp.bc.mir.tc.name_text(op.text)
        let bytes = ll_string_bytes(text)
        let header = target.literal_header_bytes()
        let block = self.pooled(&bytes, true, header)
        let start = self.offset_addr(block, header)
        var line = StringBuilder()
        try! line.append("call void ")
        let role = mono.literal_item
        try! line.append(self.plain_symbol(&var mono, role))
        try! line.append("(ptr ")
        try! line.append(dest)
        try! line.append(", ptr ")
        try! line.append(start)
        try! line.append(")")
        self.put(line.build())
    }
}

// An LLVM constant: its type, its value spelled at that type, and whether
// every byte of it is zero; `ok` false when it could not be written, its
// refusal already reported.
struct LlConstant {
    ty: String
    value: String
    zero: Bool
    ok: Bool
}

// A packed struct constant built part by part, each part at the byte after
// the one before it.
struct LlRun {
    types: Vector<String>
    values: Vector<String>
    zero: Bool
}

extension LlRun: NoCopy {}

extension LlRun {
    init() -> LlRun {
        LlRun(types: Vector<String>(), values: Vector<String>(), zero: true)
    }

    func add(&var self, c: &LlConstant) {
        try! self.types.push(c.ty)
        try! self.values.push(c.value)
        if not c.zero {
            self.zero = false
        }
    }

    // `n` zero bytes of padding.
    func pad(&var self, n: Int) {
        if n <= 0 {
            return
        }
        var ty = StringBuilder()
        try! ty.append("[")
        try! ty.append(n)
        try! ty.append(" x i8]")
        try! self.types.push(ty.build())
        try! self.values.push("zeroinitializer")
    }

    func closed(&self) -> LlConstant {
        var ty = StringBuilder()
        var value = StringBuilder()
        try! ty.append("<\{")
        try! value.append("<\{")
        var k = 0
        while k < self.types.len() {
            if k > 0 {
                try! ty.append(",")
                try! value.append(",")
            }
            try! ty.append(" ")
            try! ty.append(self.types[k])
            try! value.append(" ")
            try! value.append(self.types[k])
            try! value.append(" ")
            try! value.append(self.values[k])
            k = k + 1
        }
        if self.types.len() > 0 {
            try! ty.append(" ")
            try! value.append(" ")
        }
        try! ty.append("\}>")
        try! value.append("\}>")
        if self.zero {
            return LlConstant(ty: ty.build(), value: "zeroinitializer", zero: true, ok: true)
        }
        LlConstant(ty: ty.build(), value: value.build(), zero: false, ok: true)
    }
}

// An integer of `size` bytes holding `bits`, the low bits kept.
func ll_word_constant(size: Int, bits: Int) -> LlConstant {
    var ty = StringBuilder()
    try! ty.append("i")
    try! ty.append(size * 8)
    let v = ll_fit_signed(bits, size * 8)
    var value = StringBuilder()
    try! value.append(v)
    LlConstant(ty: ty.build(), value: value.build(), zero: v == 0, ok: true)
}

// A fixed array of `length` elements, `elements`, one type each, `size`
// bytes in all.
func ll_array_constant(elements: &Vector<LlConstant>, length: Int, size: Int) -> LlConstant {
    var ty = StringBuilder()
    if length == 0 {
        try! ty.append("[0 x i8]")
        return LlConstant(ty: ty.build(), value: "zeroinitializer", zero: true, ok: true)
    }
    let element = elements[0].ty
    try! ty.append("[")
    try! ty.append(length)
    try! ty.append(" x ")
    try! ty.append(element)
    try! ty.append("]")
    var zero = true
    var value = StringBuilder()
    try! value.append("[")
    var k = 0
    while k < elements.len() {
        let c = elements[k]
        if not c.zero {
            zero = false
        }
        if k > 0 {
            try! value.append(", ")
        }
        try! value.append(c.ty)
        try! value.append(" ")
        try! value.append(c.value)
        k = k + 1
    }
    try! value.append("]")
    if zero {
        return LlConstant(ty: ty.build(), value: "zeroinitializer", zero: true, ok: true)
    }
    LlConstant(ty: ty.build(), value: value.build(), zero: false, ok: true)
}

// Whether a value of type `t` holds a Float: is one, or is a struct or an
// array with one among its parts.
func ll_holds_float(mono: &var MonoProgram, target: &var Target, t: Int) -> Bool {
    let l = target.layout(&var mono.dp.bc.mir.tc, t)
    if l.kind == TargetKind.Float {
        return true
    }
    if l.shape == TargetShape.Array {
        return ll_holds_float(&var mono, &var target, l.element)
    }
    let d = mono.dp.bc.mir.tc.nominal_decl(t)
    if l.shape != TargetShape.Record || d < 0 {
        return false
    }
    let fields = target_struct_fields(&mono.dp.bc.mir.tc, d)
    var k = 0
    while k < fields.len() {
        let written = mono.dp.bc.mir.tc.sigs[fields[k]].result
        let member = target_member_type(&var mono.dp.bc.mir.tc, t, written)
        if ll_holds_float(&var mono, &var target, member) {
            return true
        }
        k = k + 1
    }
    false
}

// Whether `text` ends in `suffix`.
func ll_ends_with(text: &String, suffix: String) -> Bool {
    let n = text.len()
    let m = suffix.len()
    if m > n {
        return false
    }
    var k = 0
    while k < m {
        if text.byte_at(n - m + k) != suffix.byte_at(k) {
            return false
        }
        k = k + 1
    }
    true
}

// Where a constant spelled `text` is written inside the statement at `node`:
// the first leaf of that spelling, depth first, so a refusal of a constant
// inside an aggregate lands on the constant; `node` when none is.
func ll_constant_site(mono: &MonoProgram, node: Int, text: String) -> Int {
    if node < 0 {
        return node
    }
    let m = mono.dp.bc.mir.tc.node_module(node)
    let found = ll_leaf_spelled(&mono, m, node, text)
    if found >= 0 { found } else { node }
}

// The first leaf under `n`, depth first, whose text in module `m` is `text`,
// or -1.
func ll_leaf_spelled(mono: &MonoProgram, m: Int, n: Int, text: String) -> Int {
    if mono.dp.bc.mir.tc.is_leaf(n) {
        if mono.dp.bc.mir.tc.text(m, n).equals(text) {
            return n
        }
        return -1
    }
    let count = mono.dp.bc.mir.tc.child_count(n)
    var k = 0
    while k < count {
        let c = mono.dp.bc.mir.tc.child(n, k)
        let found = ll_leaf_spelled(&mono, m, c, text)
        if found >= 0 {
            return found
        }
        k = k + 1
    }
    return -1
}
