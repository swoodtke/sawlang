// The LLVM backend's program (SL:architecture §3.10): one textual `.ll` for
// the whole program, written from mono's items in item order, every layout
// fact asked of the target description. The backend translates; every
// decision it consumes (which body a call reaches, which glue a drop runs,
// how a type is laid out) is already in the concrete MIR, in mono's side
// tables, or in the target.

import sawcoro.bttable.{coro_bt_frame_index, coro_bt_table, coro_bt_with_word_bits}
import sawllvm.attributes.{ll_function_attributes}
import sawcoro.program.{CoroDriveSite, CoroPoint, CoroPoison, CoroProgram, CoroResume}
import sawllvm.text.{ll_c_string, ll_quoted}
import sawmir.model.{MirDiag}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoItem, MonoItemKind, MonoProgram}
import sawtarget.layout.{Target, TargetKind, TargetLayout}

// The output being assembled, and the state of the function being written.
public struct LlEmitter {
    // Constants and statics, extern and intrinsic declarations, and function
    // definitions, each in first-use or item order.
    globals: StringBuilder
    decls: StringBuilder
    defs: StringBuilder
    declared: Vector<String>
    // The byte constants made so far, by their `c"..."` text, and whether
    // each is a String literal block.
    pool_texts: Vector<String>
    pool_blocks: Vector<Bool>
    // The statics given a global.
    statics: Vector<Int>
    // The function being written: its MIR function, its blocks' text and
    // entry allocas, the counters its SSA names and labels take, whether it
    // returns through `sret`, and whether the backend refused it. Refusals
    // go to mono's diagnostics, the program's one list.
    current: Int
    body: StringBuilder
    allocas: StringBuilder
    temps: Int
    labels: Int
    sret: Bool
    refused: Bool
    // The frames coroutine lowering lowered, and the resume function being
    // written, an index of its resumes, or -1.
    lowering: LlLowering
    resume: Int
    // The next step of the resume function's poison list to emit, and the
    // end of its run (`put_poisons`).
    poison_next: Int
    poison_end: Int
    // The integer type a word spells, the target's `Int`, and its width in
    // bits: set once per program (`llvm_emit_program`).
    word: String
    word_bits: Int
}

extension LlEmitter: NoCopy {}

// What the backend reads of coroutine lowering's program (SL:coroutines
// §3.1): by item its resume function, an index of `resumes`, or -1; each
// resume function, the points its frame parks or drives a child at, and by
// local of its body whether the frame holds it; and the lowered drive sites,
// each of whose root frames the backend reserves on its item's stack. Under
// `--sanitize address`, `sanitize` is true and every function carries
// `sanitize_address`, and `poisons` holds the resume functions' poison lists.
// `bt_table` is the program's backtrace table, its header's word width left
// for the emitter to write (`bt_table_global`), and `bt_index` by item its
// frame's index in the table, or -1; both are empty for a runtime, which has
// no table.
public struct LlLowering {
    resume_of: Vector<Int>
    resumes: Vector<CoroResume>
    points: Vector<CoroPoint>
    resident: Vector<Bool>
    drives: Vector<CoroDriveSite>
    sanitize: Bool
    poisons: Vector<CoroPoison>
    bt_table: Vector<Int>
    bt_index: Vector<Int>
}

extension LlLowering: NoCopy {}

// The backend's copy of `coro`'s lowered frames.
public func ll_lowering(coro: &CoroProgram) -> LlLowering {
    var out = LlLowering(resume_of: Vector<Int>(), resumes: Vector<CoroResume>(), points: Vector<CoroPoint>(),
                         resident: Vector<Bool>(), drives: Vector<CoroDriveSite>(), sanitize: coro.sanitize,
                         poisons: Vector<CoroPoison>(), bt_table: Vector<Int>(), bt_index: Vector<Int>())
    if not coro.mono.runtime {
        out.bt_table = coro_bt_table(&coro, 0)
        out.bt_index = coro_bt_frame_index(&coro)
    }
    var k = 0
    while k < coro.poisons.len() {
        try! out.poisons.push(coro.poisons[k])
        k = k + 1
    }
    k = 0
    while k < coro.resume_of.len() {
        try! out.resume_of.push(coro.resume_of[k])
        k = k + 1
    }
    k = 0
    while k < coro.resumes.len() {
        try! out.resumes.push(coro.resumes[k])
        k = k + 1
    }
    k = 0
    while k < coro.points.len() {
        try! out.points.push(coro.points[k])
        k = k + 1
    }
    k = 0
    while k < coro.resident.len() {
        try! out.resident.push(coro.resident[k])
        k = k + 1
    }
    k = 0
    while k < coro.drives.len() {
        try! out.drives.push(coro.drives[k])
        k = k + 1
    }
    move out
}

extension LlEmitter {
    public init(lowering: LlLowering) -> LlEmitter {
        LlEmitter(globals: StringBuilder(), decls: StringBuilder(), defs: StringBuilder(), declared: Vector<String>(),
                  pool_texts: Vector<String>(), pool_blocks: Vector<Bool>(), statics: Vector<Int>(), current: -1,
                  body: StringBuilder(), allocas: StringBuilder(), temps: 0, labels: 0, sret: false, refused: false,
                  lowering: move lowering, resume: -1, poison_next: 0, poison_end: 0,
                  word: "", word_bits: 0)
    }
}

extension LlEmitter {
    // Item `k`'s resume function, an index of the lowering's resumes, or -1
    // for an item emitted as a plain function.
    public func resume_of(&self, k: Int) -> Int {
        if k < 0 || k >= self.lowering.resume_of.len() {
            return -1
        }
        self.lowering.resume_of[k]
    }

    // THE PLAIN-CALL FUNNEL: the symbol a plain call, or a code address,
    // names for item `k`. An item with a lowered frame is emitted as its
    // resume function and nothing else, so naming its plain symbol is a
    // compiler problem, recorded here instead of reaching clang as an
    // undefined value (SL-776). Every site that names an item goes through
    // it, glue and std role items included; only a definition's own head
    // spells `ll_symbol` directly, since it defines the plain function, which
    // exists only where there is no frame.
    // ENTRY POINTS:
    //     item_call
    //     call_item_direct
    //     closure_into
    //     string_comparison
    //     string_bytes_of
    //     string_length
    //     thread_trampoline
    //     vtable
    //     operand_into
    //     literal_into
    //     repeat_into
    //     statement
    //     builtin_copy
    //     drop_moved
    //     drop_at
    //     emit_erased_drop
    //     descriptor
    //     entry_point
    //     llvm_emit_program
    public func plain_symbol(&self, mono: &var MonoProgram, k: Int) -> String {
        if self.resume_of(k) >= 0 {
            var msg = StringBuilder()
            try! msg.append("a plain call names `")
            try! msg.append(mono.item_name(k))
            try! msg.append("`, which has a lowered frame and no plain function")
            try! mono.problems.push(msg.build())
        }
        ll_symbol(&mono, k)
    }
}

extension LlEmitter {
    // Item `k`'s frame's index in the backtrace table, or -1.
    public func bt_index_of(&self, k: Int) -> Int {
        self.lowering.bt_index.get(k) ?? -1
    }

    // The backtrace table as the read-only global `__saw_bt_table`, with the
    // target's word width in its header, or "" for a runtime. It is external
    // and kept by `@llvm.used`, since nothing in the program names it and a
    // debugger finds it by its symbol; it is 8-aligned, so a walker reads its
    // words in place; and it sits in a section of its own, Mach-O's needing
    // a segment, as Stage 0 places it. With `accessor`, the function std
    // declares to read the table is defined beside it.
    public func bt_table_global(&self, triple: String, accessor: Bool) -> String {
        if self.lowering.bt_table.len() == 0 {
            return ""
        }
        let bits = self.word_bits
        let bytes = coro_bt_with_word_bits(&self.lowering.bt_table, bits)
        var out = StringBuilder()
        try! out.append("@__saw_bt_table = constant [")
        try! out.append(bytes.len())
        try! out.append(" x i8] ")
        try! out.append(ll_c_string(&bytes))
        if ll_mach_o(triple) {
            try! out.append(", section \"__TEXT,__sawbt\"")
        } else {
            try! out.append(", section \".saw_bt\"")
        }
        try! out.append(", align 8\n")
        try! out.append("@llvm.used = appending global [1 x ptr] [ptr @__saw_bt_table], section \"llvm.metadata\"\n")
        if accessor {
            // A Saw `extern` names a function, never data, so std's task
            // dump reaches the table through this accessor (SL-577).
            try! out.append("define ptr @")
            try! out.append(ll_bt_table_address())
            try! out.append("()")
            try! out.append(ll_function_attributes(""))
            try! out.append(" \{\n  ret ptr @__saw_bt_table\n\}\n")
        }
        out.build()
    }
}

// Whether `triple`'s objects are Mach-O, which names a section with its
// segment.
// The symbol std's task dump declares to read the backtrace table.
public func ll_bt_table_address() -> String {
    "__saw_bt_table_address"
}

// Whether the program reaches std's extern `symbol`: mono makes one extern
// item per C name it calls.
public func ll_reaches_extern(mono: &MonoProgram, symbol: String) -> Bool {
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        if it.kind == MonoItemKind.Extern {
            // Stage 0 workaround (SL:hazards L33): canonical: let id = mono.dp.bc.mir.tc.res.decls[it.decl].name
            let decl = mono.dp.bc.mir.tc.res.decls[it.decl]
            if mono.dp.bc.mir.tc.res.name_text(decl.name).equals(symbol) {
                return true
            }
        }
        k = k + 1
    }
    false
}

func ll_mach_o(triple: String) -> Bool {
    let tail = "-darwin"
    let size = triple.len()
    let n = tail.len()
    size >= n && triple.substring(size - n, size).equals(tail)
}

// The symbol of item `k`'s resume function.
public func ll_resume_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw resume ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// The symbol of item `k`'s frame descriptor.
public func ll_descriptor_symbol(mono: &MonoProgram, k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@\"saw frame ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// Every rule the backend refuses by.
public func ll_rules() -> Vector<String> {
    var out = Vector<String>()
    try! out.push("backend.not-yet")
    move out
}

// Layout `l` as an LLVM value type: an integer of its width, `double`, `ptr`;
// memory and zero-sized types have none, and are `[N x i8]` in storage.
public func ll_value_type(l: &TargetLayout) -> String {
    var out = StringBuilder()
    match l.kind {
        case Int -> {
            try! out.append("i")
            try! out.append(l.bits)
        },
        case Float -> try! out.append("double"),
        case Pointer -> try! out.append("ptr"),
        case _ -> {
            try! out.append("[")
            try! out.append(l.size)
            try! out.append(" x i8]")
        }
    }
    out.build()
}

// Whether a value of layout `l` travels as an SSA value.
public func ll_is_scalar(l: &TargetLayout) -> Bool {
    l.kind == TargetKind.Int || l.kind == TargetKind.Float || l.kind == TargetKind.Pointer
}

// The symbol of item `k`: an exported function's C symbol, else its dump
// name, quoted, which no other item shares. Names are derived from what the
// item is, so they never depend on discovery order.
public func ll_symbol(mono: &MonoProgram, k: Int) -> String {
    let exported = ll_export_symbol(&mono, k)
    var out = StringBuilder()
    if exported.len() > 0 {
        try! out.append("@\"")
        try! out.append(ll_quoted(exported))
        try! out.append("\"")
        return out.build()
    }
    try! out.append("@\"saw ")
    try! out.append(ll_quoted(mono.item_name(k)))
    try! out.append("\"")
    out.build()
}

// The C symbol item `k` is defined under when it is an exported function's,
// or "".
public func ll_export_symbol(mono: &MonoProgram, k: Int) -> String {
    var j = 0
    while j < mono.export_items.len() {
        if mono.export_items[j] == k {
            let d = mono.items[k].decl
            return mono.dp.bc.mir.tc.export_symbols.get(d) ?? ""
        }
        j = j + 1
    }
    ""
}

extension LlEmitter {
    // Declares `line` once, by its symbol `name`.
    public func declare(&var self, name: String, line: String) {
        var k = 0
        while k < self.declared.len() {
            let one = self.declared.get(k) ?? ""
            if one.equals(name) {
                return
            }
            k = k + 1
        }
        try! self.declared.push(name)
        try! self.decls.append(line)
        try! self.decls.append("\n")
    }

    // Records that the module defines symbol `name` itself, so an `extern`
    // naming it is called with no declaration beside the definition.
    public func defines(&var self, name: String) {
        try! self.declared.push(name)
    }

    // The global holding bytes `bytes`, made once per distinct run: a plain
    // constant, or (`block` true) a String literal's static block, the
    // String layer's literal layout of an immortal refcount, the length, the
    // bytes and a NUL (std/string.saw), whose bytes start `header` bytes in.
    public func pooled(&var self, bytes: &Vector<Int>, block: Bool, header: Int) -> String {
        let text = ll_c_string(&bytes)
        var k = 0
        while k < self.pool_texts.len() {
            let one = self.pool_texts.get(k) ?? ""
            if self.pool_blocks[k] == block && one.equals(text) {
                return ll_pool_name(k)
            }
            k = k + 1
        }
        let at = self.pool_texts.len()
        try! self.pool_texts.push(text)
        try! self.pool_blocks.push(block)
        var line = StringBuilder()
        try! line.append(ll_pool_name(at))
        if block {
            var with_nul = Vector<Int>()
            var j = 0
            while j < bytes.len() {
                try! with_nul.push(bytes[j])
                j = j + 1
            }
            try! with_nul.push(0)
            let word = header / 2
            try! line.append(" = private unnamed_addr constant \{ i")
            try! line.append(word * 8)
            try! line.append(", i")
            try! line.append(word * 8)
            try! line.append(", [")
            try! line.append(with_nul.len())
            try! line.append(" x i8] \} \{ i")
            try! line.append(word * 8)
            try! line.append(" -1, i")
            try! line.append(word * 8)
            try! line.append(" ")
            try! line.append(bytes.len())
            try! line.append(", [")
            try! line.append(with_nul.len())
            try! line.append(" x i8] ")
            try! line.append(ll_c_string(&with_nul))
            try! line.append(" \}, align 16")
        } else {
            try! line.append(" = private unnamed_addr constant [")
            try! line.append(bytes.len())
            try! line.append(" x i8] ")
            try! line.append(text)
        }
        try! self.globals.append(line.build())
        try! self.globals.append("\n")
        ll_pool_name(at)
    }

    // Whether static `d` has its global yet; records it when not.
    public func static_seen(&var self, d: Int) -> Bool {
        var k = 0
        while k < self.statics.len() {
            if self.statics[k] == d {
                return true
            }
            k = k + 1
        }
        try! self.statics.push(d)
        false
    }
}

func ll_pool_name(k: Int) -> String {
    var out = StringBuilder()
    try! out.append("@.bytes.")
    try! out.append(k)
    out.build()
}
