// Terminators and calls: a goto, return, switch or unreachable is its LLVM
// twin; a call reaches the item mono resolved it to, an extern by the C
// convention the target gives, a function value through its code and
// environment, a dispatch through its receiver's vtable, and a builtin by its fixed lowering: `print` writes each piece
// and rendered argument through the write seam, `panic` and `assert` hand
// their message's parts to the failure funnel (design 137).

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.prims.{LL_MESSAGE_LIMIT, LL_PART_BOOL, LL_PART_RUN, LL_PART_SIGNED, LL_PART_UNSIGNED, LlParts,
                      ll_parts_push}
import sawllvm.module.{LlEmitter, ll_is_scalar, ll_symbol, ll_value_type}
import sawllvm.closures.{ll_dealloc_declaration}
import sawllvm.ops.{ll_lossless}
import sawllvm.places.{ll_local_slot}
import sawllvm.render.{ll_spelled}
import sawllvm.text.{LlPieces, ll_format_pieces, ll_quoted, ll_string_bytes}
import sawllvm.attributes.{ll_function_attributes}
import sawcoro.program.{CoroPoint}
import sawmono.dump.{mono_dump_layouts}
import sawmir.model.{MirBlock, MirCall, MirCallKind, MirConstKind, MirOperand, MirOperandKind, MirSwitchKind,
                         MirTermKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MONO_KEY_COPY, MONO_KEY_DROP, MonoItem, MonoItemKind, MonoProgram, MonoThreadSpawn}
import sawresolve.program.{ResProgram}
import sawtarget.layout.{Target, TargetCClass, TargetCase, TargetKind, TargetLayout, TargetShape}
import sawtypecheck.model.{TC_FLAG_VARIADIC}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

extension LlEmitter {
    public func terminator(&var self, mono: &var MonoProgram, target: &var Target, b: &MirBlock) {
        let node = b.term_node
        match b.term {
            case Open -> self.refuse_here(&var mono, node, "an unterminated block"),
            case Goto -> self.jump(ll_block(b.target)),
            case Unreachable -> self.put("unreachable"),
            case Return -> self.ret(&var mono, &var target),
            case Switch -> self.switch_term(&var mono, &var target, &b),
            case Call -> {
                let info = mono.dp.bc.mir.calls[b.call]
                if info.kind == MirCallKind.WindowOpen && info.absent >= 0 {
                    self.conditional_open(&var mono, &var target, b.call, &info)
                    return
                }
                self.call_term(&var mono, &var target, b.call, &info)
                if info.next >= 0 {
                    self.jump(ll_block(info.next))
                } else {
                    self.put("unreachable")
                }
            }
        }
    }

    func ret(&var self, mono: &var MonoProgram, target: &var Target) {
        let t = self.local_type(&mono, 0)
        let l = self.lay(&var mono, &var target, t)
        if self.sret {
            self.memcpy("%ret", ll_local_slot(0), l.size)
            self.put("ret void")
            return
        }
        if ll_is_scalar(&l) {
            let ty = ll_value_type(&l)
            let v = self.load(ty, ll_local_slot(0))
            var line = StringBuilder()
            try! line.append("ret ")
            try! line.append(ty)
            try! line.append(" ")
            try! line.append(v)
            self.put(line.build())
            return
        }
        self.put("ret void")
    }

    func switch_term(&var self, mono: &var MonoProgram, target: &var Target, b: &MirBlock) {
        let node = b.term_node
        if b.switch_kind == MirSwitchKind.Bool {
            let v = self.operand_value(&var mono, &var target, b.operand, node)
            let bit = self.to_bit(v)
            var yes = -1
            var no = -1
            var k = 0
            while k < b.arm_count {
                let arm = mono.dp.bc.mir.arms[b.arm_first + k]
                if arm.value == 1 {
                    yes = arm.target
                } else {
                    no = arm.target
                }
                k = k + 1
            }
            if b.otherwise >= 0 {
                if yes < 0 {
                    yes = b.otherwise
                }
                if no < 0 {
                    no = b.otherwise
                }
            }
            self.branch(bit, ll_block(yes), ll_block(no))
            return
        }
        let t = mono.dp.bc.mir.places[b.place].ty
        let addr = self.place_addr(&var mono, &var target, b.place, node)
        let tag = self.tag_of(&var mono, &var target, addr, t, node)
        var other = ""
        if b.otherwise >= 0 {
            other = ll_block(b.otherwise)
        } else {
            other = self.new_label("nocase")
        }
        var line = StringBuilder()
        try! line.append("switch i64 ")
        try! line.append(tag)
        try! line.append(", label %")
        try! line.append(other)
        try! line.append(" [")
        var k = 0
        while k < b.arm_count {
            let arm = mono.dp.bc.mir.arms[b.arm_first + k]
            let c = target.case_of(&var mono.dp.bc.mir.tc, t, arm.value)
            try! line.append(" i64 ")
            try! line.append(c.tag)
            try! line.append(", label %")
            try! line.append(ll_block(arm.target))
            k = k + 1
        }
        try! line.append(" ]")
        self.put(line.build())
        if b.otherwise < 0 {
            self.put_label(other)
            self.put("unreachable")
        }
    }

    func call_term(&var self, mono: &var MonoProgram, target: &var Target, c: Int, info: &MirCall) {
        let node = info.node
        match info.kind {
            case Builtin -> self.builtin(&var mono, &var target, c, &info),
            case Value -> self.value_call(&var mono, &var target, &info),
            case Lend -> self.refuse_here(&var mono, node, "a lend outside an accessor's split"),
            case _ -> {
                if mono.dispatch_slot(c) >= 0 {
                    self.dispatch_call(&var mono, &var target, c, &info)
                    return
                }
                // A borrowing struct's window runs nothing at its close.
                if info.kind == MirCallKind.WindowClose && mono.dp.bc.mir.closes_nothing(info.target) {
                    return
                }
                let item = mono.call_item(c)
                if item < 0 {
                    self.refuse_here(&var mono, node, "a call mono did not resolve")
                    return
                }
                let callee = mono.items[item]
                if callee.kind == MonoItemKind.Extern {
                    self.extern_call(&var mono, &var target, callee.decl, &info)
                    return
                }
                // A function value's `copy()` reaches its copy glue, which
                // has no body to read a signature from: the copy of the
                // receiver's referent into the call's destination.
                if mono.function_value_glue(item) {
                    self.builtin_copy(&var mono, &var target, &info)
                    return
                }
                let _ = self.item_call(&var mono, &var target, item, &info, "")
            }
        }
    }

    // A call of item `item`, a function with a body, its result into `into`
    // when that is not empty and into the call's destination otherwise;
    // returns the type of the result, the callee's `_0`.
    func item_call(&var self, mono: &var MonoProgram, target: &var Target, item: Int, info: &MirCall,
                   into: String) -> Int {
        let callee = mono.items[item]
        let body = callee.body
        let info_f = mono.dp.bc.mir.funcs[body]
        var params = Vector<Int>()
        var j = 1
        while j <= info_f.param_count {
            try! params.push(mono.dp.bc.mir.locals[info_f.local_first + j].ty)
            j = j + 1
        }
        let result = mono.dp.bc.mir.locals[info_f.local_first].ty
        let none = Vector<String>()
        let symbol = self.plain_symbol(&var mono, item)
        self.call_with(&var mono, &var target, symbol, result, &params, &none, &info, into)
        result
    }

    // THE CONDITIONAL OPEN FUNNEL: a window open with an absent edge. The
    // prologue gives an Optional of the lent reference; on `Some` the
    // reference lands in the call's destination and the open takes its
    // present edge, and on `None` it takes the absent edge with nothing
    // written, so the absent path opens no window (spec, Conditional lends).
    // ENTRY POINTS:
    //     terminator
    func conditional_open(&var self, mono: &var MonoProgram, target: &var Target, c: Int, info: &MirCall) {
        let node = info.node
        if mono.dispatch_slot(c) >= 0 {
            self.refuse_here(&var mono, node, "a conditional borrow through a dispatch is not in the backend slice yet")
            return
        }
        let item = mono.call_item(c)
        if item < 0 || mono.items[item].kind == MonoItemKind.Extern || mono.function_value_glue(item) {
            self.refuse_here(&var mono, node, "a call mono did not resolve")
            return
        }
        let callee = mono.items[item]
        let info_f = mono.dp.bc.mir.funcs[callee.body]
        let result = mono.dp.bc.mir.locals[info_f.local_first].ty
        let rl = self.lay_at(&var mono, &var target, result, node)
        let scratch = self.slot(rl.size, rl.align)
        let _ = self.item_call(&var mono, &var target, item, &info, scratch)
        let some_name = mono.dp.bc.mir.tc.res.intern("Some")
        let optional = mono.dp.bc.mir.tc.known.optional
        let some = mono.dp.bc.mir.tc.case_named(optional, some_name)
        let present_case = target.case_of(&var mono.dp.bc.mir.tc, result, some)
        let tag = self.tag_of(&var mono, &var target, scratch, result, node)
        var test = StringBuilder()
        try! test.append("icmp eq i64 ")
        try! test.append(tag)
        try! test.append(", ")
        try! test.append(present_case.tag)
        let present = self.assign(test.build())
        let lent = self.new_label("lent")
        self.branch(present, lent, ll_block(info.absent))
        self.put_label(lent)
        let off = target.payload_offset(&var mono.dp.bc.mir.tc, result, some, 0)
        let at = self.offset_addr(scratch, off)
        let reference = self.load("ptr", at)
        if info.dest >= 0 {
            let dest = self.place_addr(&var mono, &var target, info.dest, node)
            self.store("ptr", reference, dest)
        }
        self.jump(ll_block(info.next))
    }

    // An internal call of `callee` (an SSA pointer or a symbol) returning
    // `result` and taking `params`, after `leading` arguments already
    // spelled: the call's operands as the parameters' layouts pass them, its
    // result into `into` when that is not empty, else into its destination.
    func call_with(&var self, mono: &var MonoProgram, target: &var Target, callee: String, result: Int,
                   params: &Vector<Int>, leading: &Vector<String>, info: &MirCall, into: String) {
        let node = info.node
        let ret = self.lay_at(&var mono, &var target, result, node)
        var args = StringBuilder()
        var first = true
        var dest = into
        let landing = into.len() > 0 || info.dest >= 0
        if into.len() == 0 && info.dest >= 0 {
            dest = self.place_addr(&var mono, &var target, info.dest, node)
        }
        if ret.kind == TargetKind.Memory {
            if not landing {
                dest = self.slot(ret.size, ret.align)
            }
            try! args.append("ptr ")
            try! args.append(dest)
            first = false
        }
        var k = 0
        while k < leading.len() {
            if not first {
                try! args.append(", ")
            }
            first = false
            try! args.append(leading.get(k) ?? "")
            k = k + 1
        }
        k = 0
        while k < info.arg_count && k < params.len() {
            let o = mono.dp.bc.mir.lists[info.arg_first + k]
            let pt = params[k]
            let pl = self.lay_at(&var mono, &var target, pt, node)
            k = k + 1
            if pl.kind == TargetKind.Zero {
                continue
            }
            if not first {
                try! args.append(", ")
            }
            first = false
            if ll_is_scalar(&pl) {
                let v = self.operand_value(&var mono, &var target, o, node)
                try! args.append(ll_value_type(&pl))
                try! args.append(" ")
                try! args.append(v)
            } else {
                let a = self.operand_addr(&var mono, &var target, o, pt, node)
                try! args.append("ptr ")
                try! args.append(a)
            }
        }
        var call = StringBuilder()
        try! call.append("call ")
        if ll_is_scalar(&ret) {
            try! call.append(ll_value_type(&ret))
        } else {
            try! call.append("void")
        }
        try! call.append(" ")
        try! call.append(callee)
        try! call.append("(")
        try! call.append(args.build())
        try! call.append(")")
        if ll_is_scalar(&ret) {
            let v = self.assign(call.build())
            if landing {
                self.store(ll_value_type(&ret), v, dest)
            }
        } else {
            self.put(call.build())
        }
    }

    // A call of a function value: its code pointer, called with its
    // environment first. The callee is read where it lives, never copied:
    // a copy would retain an environment nothing then releases.
    func value_call(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        let node = info.node
        let callee = mono.dp.bc.mir.operands[info.callee]
        let fty = callee.ty
        var addr = ""
        if callee.kind == MirOperandKind.Const {
            addr = self.operand_addr(&var mono, &var target, info.callee, fty, node)
        } else {
            addr = self.place_addr(&var mono, &var target, callee.place, node)
        }
        let code = self.load("ptr", addr)
        let env_at = self.offset_addr(addr, target.closure_env_offset())
        let env = self.load("ptr", env_at)
        let shape = mono.dp.bc.mir.tc.types.ty(fty)
        var params = Vector<Int>()
        var k = 0
        while k < shape.count {
            try! params.push(mono.dp.bc.mir.tc.types.arg(fty, k))
            k = k + 1
        }
        var leading = Vector<String>()
        var env_arg = StringBuilder()
        try! env_arg.append("ptr ")
        try! env_arg.append(env)
        try! leading.push(env_arg.build())
        self.call_with(&var mono, &var target, code, shape.b, &params, &leading, &info, "")
    }

    // A dispatch through `any Trait`: the function in the receiver's vtable
    // slot, called with the erased value's address as its receiver and the
    // call's other operands as the requirement's parameters pass them.
    func dispatch_call(&var self, mono: &var MonoProgram, target: &var Target, c: Int, info: &MirCall) {
        let node = info.node
        let receiver = mono.dp.bc.mir.lists[info.arg_first]
        let rt = mono.dp.bc.mir.operands[receiver].ty
        let pointer = self.operand_addr(&var mono, &var target, receiver, rt, node)
        let data = self.load("ptr", pointer)
        let code = self.dispatch_code(&var target, pointer, mono.dispatch_slot(c))
        let s = mono.dp.bc.mir.tc.sigs[info.target]
        var params = Vector<Int>()
        var k = 0
        while k < s.param_count {
            try! params.push(mono.dp.bc.mir.tc.params[s.param_first + k].ty)
            k = k + 1
        }
        var result = s.result
        if result < 0 {
            let void_decl = mono.dp.bc.mir.tc.known.void_type
            result = mono.dp.bc.mir.tc.prim(void_decl)
        }
        var rest = info
        rest.arg_first = info.arg_first + 1
        rest.arg_count = info.arg_count - 1
        var leading = Vector<String>()
        try! leading.push(ll_spelled("ptr", data))
        self.call_with(&var mono, &var target, code, result, &params, &leading, &rest, "")
    }

    // Extern `d`'s C signature (`LlExternSig`): its result's class and LLVM
    // type, and each declared parameter's layout, refused at `node` when its
    // result or a parameter crosses the C convention as an aggregate. Both
    // the extern's own calls and an offload's thunk read it, so the two
    // declare and call the extern alike.
    func extern_signature(&var self, mono: &var MonoProgram, target: &var Target, d: Int, node: Int) -> LlExternSig {
        let s = mono.dp.bc.mir.tc.sigs[d]
        let name_id = mono.dp.bc.mir.tc.res.decls[d].name
        let name = mono.dp.bc.mir.tc.res.name_text(name_id)
        let result_class = target.c_class(&var mono.dp.bc.mir.tc, s.result, true)
        let rl = self.lay(&var mono, &var target, s.result)
        var out = LlExternSig(ok: false, name: name, variadic: (s.flags & TC_FLAG_VARIADIC) != 0, result: s.result,
                              result_class: result_class, ret: rl, ret_type: "void", params: Vector<TargetLayout>(),
                              types: "")
        if result_class == TargetCClass.Direct {
            out.ret_type = ll_value_type(&rl)
        } else if result_class == TargetCClass.NullablePointer {
            out.ret_type = "ptr"
        } else if result_class == TargetCClass.Refused {
            self.refuse_here(&var mono, node, "an extern whose result crosses the C convention as an aggregate is not in the backend slice yet")
            return move out
        }
        var types = StringBuilder()
        var k = 0
        while k < s.param_count {
            let pt = mono.dp.bc.mir.tc.params[s.param_first + k].ty
            let passing = target.c_class(&var mono.dp.bc.mir.tc, pt, false)
            if passing != TargetCClass.Direct {
                self.refuse_here(&var mono, node, "an extern parameter that crosses the C convention as an aggregate is not in the backend slice yet")
                return move out
            }
            let pl = self.lay(&var mono, &var target, pt)
            if k > 0 {
                try! types.append(", ")
            }
            try! types.append(ll_value_type(&pl))
            try! out.params.push(pl)
            k = k + 1
        }
        out.types = types.build()
        out.ok = true
        move out
    }

    // An extern call by the C convention: scalars direct, a nullable pointer
    // result made an Optional, anything else refused. A variadic extern's
    // extra arguments pass by C's default promotions, an integer narrower
    // than 32 bits widened to `i32` by its signedness, and the call names the
    // callee's function type, as LLVM requires of a variadic one.
    func extern_call(&var self, mono: &var MonoProgram, target: &var Target, d: Int, info: &MirCall) {
        let node = info.node
        let sig = self.extern_signature(&var mono, &var target, d, node)
        if not sig.ok {
            return
        }
        let name = sig.name
        let variadic = sig.variadic
        let result_class = sig.result_class
        let ret_type = sig.ret_type
        var types = StringBuilder()
        try! types.append(sig.types)
        var args = StringBuilder()
        var k = 0
        while k < sig.params.len() {
            let pl = sig.params[k]
            if k > 0 {
                try! args.append(", ")
            }
            let o = mono.dp.bc.mir.lists[info.arg_first + k]
            let v = self.operand_value(&var mono, &var target, o, node)
            try! args.append(ll_value_type(&pl))
            try! args.append(" ")
            try! args.append(v)
            k = k + 1
        }
        if variadic {
            if k > 0 {
                try! types.append(", ")
            }
            try! types.append("...")
            while k < info.arg_count {
                let o = mono.dp.bc.mir.lists[info.arg_first + k]
                let at = mono.dp.bc.mir.operands[o].ty
                if target.c_class(&var mono.dp.bc.mir.tc, at, false) != TargetCClass.Direct {
                    self.refuse_here(&var mono, node, "a variadic argument that crosses the C convention as an aggregate is not in the backend slice yet")
                    return
                }
                let al = self.lay(&var mono, &var target, at)
                var ty = ll_value_type(&al)
                var v = self.operand_value(&var mono, &var target, o, node)
                if al.kind == TargetKind.Int && al.bits < 32 {
                    // Stage 0 workaround (SL:hazards S4): canonical: v = self.int_convert(v, al.bits, 32, self.signed_type(&mono, at))
                    let signed = self.signed_type(&mono, at)
                    v = self.int_convert(v, al.bits, 32, signed)
                    ty = "i32"
                }
                if k > 0 {
                    try! args.append(", ")
                }
                try! args.append(ty)
                try! args.append(" ")
                try! args.append(v)
                k = k + 1
            }
        }
        let params = types.build()
        self.declare_extern(&sig, params)
        var call = StringBuilder()
        try! call.append("call ")
        try! call.append(ret_type)
        if variadic {
            try! call.append(" (")
            try! call.append(params)
            try! call.append(")")
        }
        try! call.append(" @")
        try! call.append(name)
        try! call.append("(")
        try! call.append(args.build())
        try! call.append(")")
        if ret_type.equals("void") {
            self.put(call.build())
            return
        }
        let v = self.assign(call.build())
        if info.dest < 0 {
            return
        }
        let dest = self.place_addr(&var mono, &var target, info.dest, node)
        if result_class == TargetCClass.Direct {
            self.store(ret_type, v, dest)
            return
        }
        var cmp = StringBuilder()
        try! cmp.append("icmp ne ptr ")
        try! cmp.append(v)
        try! cmp.append(", null")
        let present = self.assign(cmp.build())
        let flag = self.to_bool(present)
        self.store("i8", flag, dest)
        let some = target.present_case(&var mono.dp.bc.mir.tc, sig.result)
        let off = target.payload_offset(&var mono.dp.bc.mir.tc, sig.result, some.decl, 0)
        let at = self.offset_addr(dest, off)
        self.store("ptr", v, at)
    }
}

// An extern's C signature: whether the backend lowers it, its symbol,
// whether it is variadic, its result's type, class, layout and LLVM type,
// each declared parameter's layout, and those parameters' LLVM types,
// comma-separated.
struct LlExternSig {
    ok: Bool
    name: String
    variadic: Bool
    result: Int
    result_class: TargetCClass
    ret: TargetLayout
    ret_type: String
    params: Vector<TargetLayout>
    types: String
}

extension LlExternSig: NoCopy {}

extension LlEmitter {
    // Declares the extern `sig` describes once, with parameter types `params`.
    func declare_extern(&var self, sig: &LlExternSig, params: String) {
        var decl = StringBuilder()
        try! decl.append("declare ")
        try! decl.append(sig.ret_type)
        try! decl.append(" @")
        try! decl.append(sig.name)
        try! decl.append("(")
        try! decl.append(params)
        try! decl.append(")")
        self.declare(sig.name, decl.build())
    }
}

// The blocking-extern offload (design 183; runtime/ABI.md, "Blocking-extern
// offload"). The runtime runs a C-ABI `word(word)` thunk on the job's thread
// and hands it the address of the job's copy of the argument words, so each
// offloaded extern gets a thunk that reads its arguments back at their
// declared types and makes the ordinary extern call. A word is 64 bits, as
// the runtime's copy of the slots reads them; widening a value into its word
// and narrowing it back are exact inverses, so the extern receives the bits
// the call computed.
extension LlEmitter {
    // An offload's start, in a resume function: each argument of the
    // extern's call `info` widened into its word of the offload's storage at
    // `(*frame).[point.slot]`, after the job word, then the job started on the
    // extern's thunk and recorded in the job word. The arguments are words of
    // the frame, which outlives the job's thread by the take's join.
    public func offload_start(&var self, mono: &var MonoProgram, target: &var Target, point: &CoroPoint,
                              info: &MirCall) {
        let node = info.node
        let sig = self.offload_signature(&var mono, &var target, point.child, node)
        if not sig.ok {
            return
        }
        let thunk = self.offload_thunk(&mono, point.child, &sig)
        var k = 0
        while k < sig.params.len() && k < info.arg_count {
            let pl = sig.params[k]
            let o = mono.dp.bc.mir.lists[info.arg_first + k]
            k = k + 1
            let v = self.operand_value(&var mono, &var target, o, node)
            let wide = self.offload_widen(v, &pl)
            let at = self.offset_addr("%frame", point.slot + k * 8)
            self.store("i64", wide, at)
        }
        var argp = "0"
        if sig.params.len() > 0 {
            let first = self.offset_addr("%frame", point.slot + 8)
            var cast = StringBuilder()
            try! cast.append("ptrtoint ptr ")
            try! cast.append(first)
            try! cast.append(" to i64")
            argp = self.assign(cast.build())
        }
        var code = StringBuilder()
        try! code.append("ptrtoint ptr ")
        try! code.append(thunk)
        try! code.append(" to i64")
        let fn = self.assign(code.build())
        // The seam stores the job straight into the storage's job word, and
        // reports a job it could not start (no memory, no pipe, no thread) as
        // a negated tag. An extern call has no error channel, so that panics
        // with the cause, as Stage 0's offload does, rather than park on a job
        // that does not exist (runtime/ABI.md).
        let job_at = self.offset_addr("%frame", point.slot)
        let word = self.word
        var declaration = StringBuilder()
        try! declaration.append("declare ")
        try! declaration.append(word)
        try! declaration.append(" @__saw_rt_offload_start(")
        try! declaration.append(word)
        try! declaration.append(", ")
        try! declaration.append(word)
        try! declaration.append(", ")
        try! declaration.append(word)
        try! declaration.append(", ptr)")
        self.declare("__saw_rt_offload_start", declaration.build())
        var call = StringBuilder()
        try! call.append("call ")
        try! call.append(word)
        try! call.append(" @__saw_rt_offload_start(")
        try! call.append(word)
        try! call.append(" ")
        try! call.append(fn)
        try! call.append(", ")
        try! call.append(word)
        try! call.append(" ")
        try! call.append(argp)
        try! call.append(", ")
        try! call.append(word)
        try! call.append(" ")
        try! call.append(sig.params.len())
        try! call.append(", ptr ")
        try! call.append(job_at)
        try! call.append(")")
        let status = self.assign(call.build())
        var test = StringBuilder()
        try! test.append("icmp eq ")
        try! test.append(word)
        try! test.append(" ")
        try! test.append(status)
        try! test.append(", 0")
        let started = self.assign(test.build())
        let pass = self.new_label("offload.started")
        let fail = self.new_label("offload.refused")
        self.branch(started, pass, fail)
        self.put_label(fail)
        var raw_declaration = StringBuilder()
        try! raw_declaration.append("declare ")
        try! raw_declaration.append(word)
        try! raw_declaration.append(" @__saw_rt_last_raw_code()")
        self.declare("__saw_rt_last_raw_code", raw_declaration.build())
        var raw_call = StringBuilder()
        try! raw_call.append("call ")
        try! raw_call.append(word)
        try! raw_call.append(" @__saw_rt_last_raw_code()")
        let raw_word = self.assign(raw_call.build())
        let bits = self.word_bits
        let raw = self.int_convert(raw_word, bits, 64, true)
        var parts = LlParts()
        ll_parts_push(&var parts, LL_PART_SIGNED, raw, "")
        let close = self.text_bytes(")")
        let g = self.pooled(&close, false, 0)
        ll_parts_push(&var parts, LL_PART_RUN, g, "1")
        self.fail_parts(&var mono, node, "blocking call: starting its offload failed (errno ", &parts)
        self.put_label(pass)
    }

    // An offload's take, in a resume function: the job in the storage's job
    // word taken, which joins its thread and frees the job, and the extern's
    // result narrowed from the word it returns into the take's destination.
    public func offload_take(&var self, mono: &var MonoProgram, target: &var Target, point: &CoroPoint,
                             info: &MirCall) {
        let node = info.node
        let sig = self.offload_signature(&var mono, &var target, point.child, node)
        if not sig.ok {
            return
        }
        let job_at = self.offset_addr("%frame", point.slot)
        let wt = self.word
        let job = self.load(wt, job_at)
        var declaration = StringBuilder()
        try! declaration.append("declare ")
        try! declaration.append(wt)
        try! declaration.append(" @__saw_rt_offload_take(")
        try! declaration.append(wt)
        try! declaration.append(")")
        self.declare("__saw_rt_offload_take", declaration.build())
        var call = StringBuilder()
        try! call.append("call ")
        try! call.append(wt)
        try! call.append(" @__saw_rt_offload_take(")
        try! call.append(wt)
        try! call.append(" ")
        try! call.append(job)
        try! call.append(")")
        let word = self.assign(call.build())
        if info.dest < 0 || sig.result_class != TargetCClass.Direct {
            return
        }
        let v = self.offload_narrow(word, &sig.ret)
        let dest = self.place_addr(&var mono, &var target, info.dest, node)
        self.store(sig.ret_type, v, dest)
    }

    // Extern item `ext`'s signature as an offload carries it: its result
    // nothing or one value, its parameters fixed in number, on a target whose
    // word is the runtime's 64-bit slot; refused at `node` otherwise.
    func offload_signature(&var self, mono: &var MonoProgram, target: &var Target, ext: Int, node: Int) -> LlExternSig {
        let d = mono.items[ext].decl
        var sig = self.extern_signature(&var mono, &var target, d, node)
        if not sig.ok {
            return move sig
        }
        if sig.variadic || sig.result_class == TargetCClass.NullablePointer || target.word != 8 {
            self.refuse_here(&var mono, node, "an offload of a variadic extern, of one returning an optional pointer, or on a target whose word is not 64 bits is not in the backend slice yet")
            sig.ok = false
        }
        move sig
    }

    // THE OFFLOAD THUNK FUNNEL: the thunk of offloaded extern item `ext`,
    // `i64 (i64 %slots)`, defined once per extern: it reads each argument
    // word from the slot array `%slots` points at, narrows it to its declared
    // type, calls the extern, and returns its result widened into a word, or
    // 0 for an extern that returns nothing. Returns the thunk's symbol.
    // ENTRY POINTS:
    //     offload_start
    func offload_thunk(&var self, mono: &MonoProgram, ext: Int, sig: &LlExternSig) -> String {
        var symbol = StringBuilder()
        try! symbol.append("@\"saw offload thunk ")
        try! symbol.append(ll_quoted(sig.name))
        try! symbol.append("\"")
        let name = symbol.build()
        var k = 0
        while k < self.declared.len() {
            let one = self.declared.get(k) ?? ""
            if one.equals(name) {
                return name
            }
            k = k + 1
        }
        try! self.declared.push(name)
        // Stage 0 workaround (SL:hazards S4): canonical: self.declare_extern(&sig, sig.types)
        let types = sig.types
        self.declare_extern(&sig, types)
        var text = StringBuilder()
        try! text.append("define internal i64 ")
        try! text.append(name)
        try! text.append("(i64 %slots)")
        try! text.append(ll_function_attributes(""))
        try! text.append(" \{\nentry:\n  %base = inttoptr i64 %slots to ptr\n")
        var args = StringBuilder()
        k = 0
        while k < sig.params.len() {
            let pl = sig.params[k]
            try! text.append("  %at.")
            try! text.append(k)
            try! text.append(" = getelementptr i64, ptr %base, i64 ")
            try! text.append(k)
            try! text.append("\n  %word.")
            try! text.append(k)
            try! text.append(" = load i64, ptr %at.")
            try! text.append(k)
            try! text.append("\n")
            var word = StringBuilder()
            try! word.append("%word.")
            try! word.append(k)
            var arg = StringBuilder()
            try! arg.append("%arg.")
            try! arg.append(k)
            let narrowed = ll_offload_narrow_text(arg.build(), word.build(), &pl)
            try! text.append(narrowed.text)
            if k > 0 {
                try! args.append(", ")
            }
            try! args.append(ll_value_type(&pl))
            try! args.append(" ")
            try! args.append(narrowed.value)
            k = k + 1
        }
        try! text.append("  ")
        if not sig.ret_type.equals("void") {
            try! text.append("%result = ")
        }
        try! text.append("call ")
        try! text.append(sig.ret_type)
        try! text.append(" @")
        try! text.append(sig.name)
        try! text.append("(")
        try! text.append(args.build())
        try! text.append(")\n")
        if sig.ret_type.equals("void") {
            try! text.append("  ret i64 0\n")
        } else {
            let widened = ll_offload_widen_text("%result.word", "%result", &sig.ret)
            try! text.append(widened.text)
            try! text.append("  ret i64 ")
            try! text.append(widened.value)
            try! text.append("\n")
        }
        try! text.append("\}\n\n")
        try! self.defs.append(text.build())
        name
    }

    // Value `v`, of layout `l`, widened into a 64-bit word.
    func offload_widen(&var self, v: String, l: &TargetLayout) -> String {
        let name = self.fresh()
        let made = ll_offload_widen_text(name, v, &l)
        if made.text.len() > 0 {
            try! self.body.append(made.text)
        }
        made.value
    }

    // Word `word` narrowed back to a value of layout `l`.
    func offload_narrow(&var self, word: String, l: &TargetLayout) -> String {
        let name = self.fresh()
        let made = ll_offload_narrow_text(name, word, &l)
        if made.text.len() > 0 {
            try! self.body.append(made.text)
        }
        made.value
    }
}

// An instruction converting an offload's value, as text, and the value it
// leaves: `text` is empty, and `value` the operand itself, when no
// conversion is needed.
struct LlOffloadValue {
    text: String
    value: String
}

// Value `v`, of layout `l`, widened into a 64-bit word named `name`: an
// integer zero-extended, a pointer's address, a Float's bits.
func ll_offload_widen_text(name: String, v: String, l: &TargetLayout) -> LlOffloadValue {
    var op = ""
    var from = ll_value_type(&l)
    if l.kind == TargetKind.Int {
        if l.bits == 64 {
            return LlOffloadValue(text: "", value: v)
        }
        op = "zext"
    } else if l.kind == TargetKind.Pointer {
        op = "ptrtoint"
    } else {
        op = "bitcast"
    }
    var text = StringBuilder()
    try! text.append("  ")
    try! text.append(name)
    try! text.append(" = ")
    try! text.append(op)
    try! text.append(" ")
    try! text.append(from)
    try! text.append(" ")
    try! text.append(v)
    try! text.append(" to i64\n")
    LlOffloadValue(text: text.build(), value: name)
}

// Word `word` narrowed into a value of layout `l` named `name`: the inverse
// of `ll_offload_widen_text`.
func ll_offload_narrow_text(name: String, word: String, l: &TargetLayout) -> LlOffloadValue {
    var op = ""
    if l.kind == TargetKind.Int {
        if l.bits == 64 {
            return LlOffloadValue(text: "", value: word)
        }
        op = "trunc"
    } else if l.kind == TargetKind.Pointer {
        op = "inttoptr"
    } else {
        op = "bitcast"
    }
    var text = StringBuilder()
    try! text.append("  ")
    try! text.append(name)
    try! text.append(" = ")
    try! text.append(op)
    try! text.append(" i64 ")
    try! text.append(word)
    try! text.append(" to ")
    try! text.append(ll_value_type(&l))
    try! text.append("\n")
    LlOffloadValue(text: text.build(), value: name)
}

// Builtins.
extension LlEmitter {
    // THE BUILTIN FUNNEL's lowering: each builtin `mono_builtin_supported`
    // admits, by its fixed lowering, `c` being the concrete call.
    // ENTRY POINTS:
    //     call_term
    func builtin(&var self, mono: &var MonoProgram, target: &var Target, c: Int, info: &MirCall) {
        let node = info.node
        let name = mono.dp.bc.mir.tc.res.name_text(info.spelling)
        if name.equals("Thread.spawn") {
            self.thread_spawn(&var mono, &var target, c, &info)
        } else if name.equals("print") {
            self.print_call(&var mono, &var target, &info)
        } else if name.equals("panic") {
            self.panic_call(&var mono, &var target, &info, 0, "")
        } else if name.equals("assert") {
            let cond = mono.dp.bc.mir.lists[info.arg_first]
            let v = self.operand_value(&var mono, &var target, cond, node)
            let bit = self.to_bit(v)
            let pass = self.new_label("asserted")
            let fail = self.new_label("assert")
            self.branch(bit, pass, fail)
            self.put_label(fail)
            self.panic_call(&var mono, &var target, &info, 1, "assertion failed: ")
            self.put_label(pass)
            var k = 1
            while k < info.arg_count {
                let o = mono.dp.bc.mir.lists[info.arg_first + k]
                self.drop_moved(&var mono, &var target, o, node)
                k = k + 1
            }
        } else if name.equals("sizeof") || name.equals("alignof") {
            let t = mono.dp.bc.mir.types[info.inst_first]
            let l = self.lay_at(&var mono, &var target, t, node)
            if info.dest >= 0 {
                let dest = self.place_addr(&var mono, &var target, info.dest, node)
                var v = StringBuilder()
                if name.equals("sizeof") {
                    try! v.append(l.size)
                } else {
                    try! v.append(l.align)
                }
                let word = self.word
                self.store(word, v.build(), dest)
            }
        } else if name.equals("init") {
            return
        } else if name.equals("len") {
            self.array_length(&var mono, &var target, &info)
        } else if name.equals("swap") {
            self.array_swap(&var mono, &var target, &info)
        } else if name.equals("copy") {
            self.builtin_copy(&var mono, &var target, &info)
        } else if name.equals("__saw_suspend") || name.equals("__saw_test_suspend") {
            // Coroutine lowering replaces every call of either in a lowered
            // frame, and refuses the frames it does not lower.
            self.refuse_here(&var mono, node, "a test suspension outside a lowered frame")
        } else {
            self.atomic(&var mono, &var target, &info, &name)
        }
    }

    // `a.len()` on a fixed array: the length its type carries, folded before
    // mono (design 148), so the receiver is never read.
    func array_length(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        let o = mono.dp.bc.mir.lists[info.arg_first]
        var t = mono.dp.bc.mir.operands[o].ty
        let referent = mono.dp.bc.mir.tc.referent(t)
        if referent >= 0 {
            t = referent
        }
        let l = self.lay_at(&var mono, &var target, t, info.node)
        if l.shape != TargetShape.Array {
            self.refuse_here(&var mono, info.node, "the builtin `len` of a slice is not in the backend slice yet")
            return
        }
        if info.dest >= 0 {
            let dest = self.place_addr(&var mono, &var target, info.dest, info.node)
            var v = StringBuilder()
            try! v.append(l.length)
            let word = self.word
            self.store(word, v.build(), dest)
        }
    }

    // `a.swap(i, j)` on a fixed array: both indices checked, `i` first as
    // Stage 0 does, then the two elements' bits exchanged through a slot. No
    // value is copied or dropped, so an owning element moves as it is, and
    // `i == j` writes the element back over itself.
    func array_swap(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        let node = info.node
        let o = mono.dp.bc.mir.lists[info.arg_first]
        let receiver = mono.dp.bc.mir.operands[o].ty
        let t = mono.dp.bc.mir.tc.referent(receiver)
        let l = self.lay_at(&var mono, &var target, t, node)
        if l.shape != TargetShape.Array {
            self.refuse_here(&var mono, node, "the builtin `swap` of a slice is not in the backend slice yet")
            return
        }
        let base = self.operand_value(&var mono, &var target, o, node)
        let first = mono.dp.bc.mir.lists[info.arg_first + 1]
        let second = mono.dp.bc.mir.lists[info.arg_first + 2]
        let i = self.operand_value(&var mono, &var target, first, node)
        let j = self.operand_value(&var mono, &var target, second, node)
        self.check_index(&var mono, i, l.length, node)
        self.check_index(&var mono, j, l.length, node)
        let el = self.lay_at(&var mono, &var target, l.element, node)
        let a = self.element_addr(base, i, el.size)
        let b = self.element_addr(base, j, el.size)
        let tmp = self.slot(el.size, el.align)
        self.copy_bits(&el, tmp, a)
        self.copy_bits(&el, a, b)
        self.copy_bits(&el, b, tmp)
    }

    // A spelled `.copy()` no declaration writes, on a wrapper (an array, an
    // Optional, a tuple) or a type copied by its parts: the referent's copy
    // glue into the call's destination, which copies each part by its own
    // `copy()` in order, or its bits when mono made no glue.
    func builtin_copy(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        let node = info.node
        let o = mono.dp.bc.mir.lists[info.arg_first]
        let receiver = mono.dp.bc.mir.operands[o].ty
        let t = mono.dp.bc.mir.tc.referent(receiver)
        let l = self.lay_at(&var mono, &var target, t, node)
        let src = self.operand_value(&var mono, &var target, o, node)
        var dest = ""
        if info.dest >= 0 {
            dest = self.place_addr(&var mono, &var target, info.dest, node)
        } else {
            dest = self.slot(l.size, l.align)
        }
        let glue = mono.glue_item(t, MONO_KEY_COPY)
        if glue < 0 {
            self.copy_bits(&l, dest, src)
            return
        }
        var line = StringBuilder()
        try! line.append("call void ")
        try! line.append(self.plain_symbol(&var mono, glue))
        try! line.append("(ptr ")
        try! line.append(dest)
        try! line.append(", ptr ")
        try! line.append(src)
        try! line.append(")")
        self.put(line.build())
    }

    // The atomic intrinsics, as LLVM atomics of the orderings their names
    // state: the String layer's refcount's four, and `Atomic<Int>`'s
    // sequentially consistent four.
    func atomic(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall, name: &String) {
        let node = info.node
        if name.equals("__saw_atomic_fence_acquire") {
            self.put("fence acquire")
            return
        }
        let p = mono.dp.bc.mir.lists[info.arg_first]
        let at = self.operand_value(&var mono, &var target, p, node)
        let seq_cst = name.equals("__saw_atomic_load_i64_seq_cst") || name.equals("__saw_atomic_store_i64_seq_cst") || name.equals("__saw_atomic_add_i64_seq_cst") || name.equals("__saw_atomic_cmpxchg_i64_seq_cst")
        if seq_cst {
            self.seq_cst_atomic(&var mono, &var target, &info, &name, at)
            return
        }
        var text = StringBuilder()
        if name.equals("__saw_atomic_load_i64_relaxed") {
            try! text.append("load atomic i64, ptr ")
            try! text.append(at)
            try! text.append(" monotonic, align 8")
        } else {
            let o = mono.dp.bc.mir.lists[info.arg_first + 1]
            let v = self.operand_value(&var mono, &var target, o, node)
            if name.equals("__saw_atomic_add_i64") {
                try! text.append("atomicrmw add ptr ")
                try! text.append(at)
                try! text.append(", i64 ")
                try! text.append(v)
                try! text.append(" monotonic")
            } else {
                try! text.append("atomicrmw sub ptr ")
                try! text.append(at)
                try! text.append(", i64 ")
                try! text.append(v)
                try! text.append(" release")
            }
        }
        let result = self.assign(text.build())
        if info.dest >= 0 {
            let dest = self.place_addr(&var mono, &var target, info.dest, node)
            self.store("i64", result, dest)
        }
    }

    // A sequentially consistent load, store, add or compare-exchange of the
    // word at `at`.
    func seq_cst_atomic(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall, name: &String,
                        at: String) {
        let node = info.node
        var text = StringBuilder()
        if name.equals("__saw_atomic_load_i64_seq_cst") {
            try! text.append("load atomic i64, ptr ")
            try! text.append(at)
            try! text.append(" seq_cst, align 8")
            let v = self.assign(text.build())
            self.atomic_result("i64", v, &var mono, &var target, &info)
            return
        }
        let o = mono.dp.bc.mir.lists[info.arg_first + 1]
        let first = self.operand_value(&var mono, &var target, o, node)
        if name.equals("__saw_atomic_store_i64_seq_cst") {
            try! text.append("store atomic i64 ")
            try! text.append(first)
            try! text.append(", ptr ")
            try! text.append(at)
            try! text.append(" seq_cst, align 8")
            self.put(text.build())
            return
        }
        if name.equals("__saw_atomic_add_i64_seq_cst") {
            try! text.append("atomicrmw add ptr ")
            try! text.append(at)
            try! text.append(", i64 ")
            try! text.append(first)
            try! text.append(" seq_cst")
            let v = self.assign(text.build())
            self.atomic_result("i64", v, &var mono, &var target, &info)
            return
        }
        let d = mono.dp.bc.mir.lists[info.arg_first + 2]
        let desired = self.operand_value(&var mono, &var target, d, node)
        try! text.append("cmpxchg ptr ")
        try! text.append(at)
        try! text.append(", i64 ")
        try! text.append(first)
        try! text.append(", i64 ")
        try! text.append(desired)
        try! text.append(" seq_cst seq_cst")
        let pair = self.assign(text.build())
        var swapped = StringBuilder()
        try! swapped.append("extractvalue \{ i64, i1 \} ")
        try! swapped.append(pair)
        try! swapped.append(", 1")
        let bit = self.assign(swapped.build())
        let flag = self.to_bool(bit)
        self.atomic_result("i8", flag, &var mono, &var target, &info)
    }

    // An atomic's result `v`, of LLVM type `ty`, stored where the call puts it.
    func atomic_result(&var self, ty: String, v: String, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        if info.dest >= 0 {
            let dest = self.place_addr(&var mono, &var target, info.dest, info.node)
            self.store(ty, v, dest)
        }
    }

    // `print`: a literal message's bytes, a String's, or a format string's
    // pieces with each argument rendered between them, as one line the line
    // seam writes whole, its line break included. Every argument is read and
    // every integer rendered before the seam is called, so no code of the
    // program runs while the seam holds the output lock, and a check that
    // fails while an argument is read panics before any of the line is out.
    // A failed write panics only after the seam returned, the lock given back
    // (runtime/ABI.md, "The output lock"). A String the call was handed by
    // `move` is the call's to drop.
    func print_call(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall) {
        let node = info.node
        var parts = LlParts()
        self.message_parts(&var mono, &var target, &info, 0, &var parts)
        let count = parts.kinds.len()
        // A part record is a pointer and a word-wide length (runtime/ABI.md).
        let record = 2 * target.word
        var table = "null"
        if count > 0 {
            table = self.slot(count * record, target.word)
        }
        var k = 0
        while k < count {
            let kind = parts.kinds[k]
            let first = parts.firsts.get(k) ?? ""
            let second = parts.seconds.get(k) ?? ""
            var run = ""
            var length = ""
            if kind == LL_PART_RUN || kind == LL_PART_BOOL {
                run = self.part_run(kind, first, second)
                length = self.part_run_length(kind, first, second)
            } else {
                run = self.slot(24, 1)
                length = self.render_integer(run, first, kind == LL_PART_SIGNED)
            }
            let at = self.offset_addr(table, k * record)
            self.store("ptr", run, at)
            let length_at = self.offset_addr(table, k * record + target.word)
            let word = self.word
            let bits = self.word_bits
            let narrow = self.int_convert(length, 64, bits, false)
            self.store(word, narrow, length_at)
            k = k + 1
        }
        let status = self.write_line(table, count)
        var failed = StringBuilder()
        try! failed.append("icmp ne ")
        try! failed.append(self.word)
        try! failed.append(" ")
        try! failed.append(status)
        try! failed.append(", 0")
        let bit = self.assign(failed.build())
        let fail = self.new_label("print.failed")
        let written = self.new_label("print.written")
        self.branch(bit, fail, written)
        self.put_label(fail)
        self.fail_print(&var mono, node, status)
        self.put_label(written)
        k = 0
        while k < info.arg_count {
            let o = mono.dp.bc.mir.lists[info.arg_first + k]
            self.drop_moved(&var mono, &var target, o, node)
            k = k + 1
        }
    }

    // `panic`, or `assert`'s failure: `lead`, then the message from operand
    // `from` on, through the failure funnel. A message with nothing to read,
    // none or one String literal, is a single constant.
    func panic_call(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall, from: Int, lead: String) {
        let node = info.node
        var literal = from >= info.arg_count
        var text = ""
        if not literal {
            let first = mono.dp.bc.mir.lists[info.arg_first + from]
            let op = mono.dp.bc.mir.operands[first]
            if op.kind == MirOperandKind.Const && op.const_kind == MirConstKind.String {
                literal = true
                text = mono.dp.bc.mir.tc.name_text(op.text)
            }
        }
        if literal {
            var message = self.text_bytes(lead)
            let bytes = ll_string_bytes(text)
            var k = 0
            while k < bytes.len() {
                try! message.push(bytes[k])
                k = k + 1
            }
            self.fail_message(&var mono, node, &message)
            return
        }
        var parts = LlParts()
        self.message_parts(&var mono, &var target, &info, from, &var parts)
        self.fail_parts(&var mono, node, lead, &parts)
    }

    // A message's parts, from operand `from` of the call on: a format
    // string's pieces with each argument read between them, or one value.
    // Every argument is read here, in order, before any part is written.
    func message_parts(&var self, mono: &var MonoProgram, target: &var Target, info: &MirCall, from: Int,
                       parts: &var LlParts) {
        if from >= info.arg_count {
            return
        }
        let node = info.node
        let first = mono.dp.bc.mir.lists[info.arg_first + from]
        let op = mono.dp.bc.mir.operands[first]
        if not (op.kind == MirOperandKind.Const && op.const_kind == MirConstKind.Format) {
            self.prepare(&var mono, &var target, first, node, &var parts)
            return
        }
        var values = LlParts()
        var k = from + 1
        while k < info.arg_count {
            let arg = mono.dp.bc.mir.lists[info.arg_first + k]
            self.prepare(&var mono, &var target, arg, node, &var values)
            k = k + 1
        }
        let pieces = ll_format_pieces(mono.dp.bc.mir.tc.name_text(op.text))
        var start = 0
        k = 0
        while k < pieces.ends.len() {
            let end = pieces.ends[k]
            var piece = Vector<Int>()
            var j = start
            while j < end {
                try! piece.push(pieces.bytes[j])
                j = j + 1
            }
            start = end
            if piece.len() > 0 {
                let g = self.pooled(&piece, false, 0)
                var len = StringBuilder()
                try! len.append(piece.len())
                ll_parts_push(&var parts, LL_PART_RUN, g, len.build())
            }
            if k < values.kinds.len() {
                let kind = values.kinds[k]
                ll_parts_push(&var parts, kind, values.firsts.get(k) ?? "", values.seconds.get(k) ?? "")
            }
            k = k + 1
        }
    }

    // Operand `o` read as a message part: a String's bytes and length, read
    // through the String roles in place (a `&String` through its
    // reference); an integer widened to i64; a Bool's byte.
    func prepare(&var self, mono: &var MonoProgram, target: &var Target, o: Int, node: Int, parts: &var LlParts) {
        let op = mono.dp.bc.mir.operands[o]
        if op.kind == MirOperandKind.Const && op.const_kind == MirConstKind.String {
            let bytes = ll_string_bytes(mono.dp.bc.mir.tc.name_text(op.text))
            let g = self.pooled(&bytes, false, 0)
            var len = StringBuilder()
            try! len.append(bytes.len())
            ll_parts_push(&var parts, LL_PART_RUN, g, len.build())
            return
        }
        var t = op.ty
        var through = ""
        let referent = mono.dp.bc.mir.tc.referent(t)
        if referent >= 0 {
            t = referent
        }
        if mono.dp.bc.mir.tc.is_string(t) {
            let text = self.string_addr(&var mono, &var target, o, node)
            let bytes = self.string_bytes_of(&var mono, text, node)
            let len_word = self.string_length(&var mono, text, node)
            let bits = self.word_bits
            let len = self.int_convert(len_word, bits, 64, false)
            ll_parts_push(&var parts, LL_PART_RUN, bytes, len)
            return
        }
        if not mono.dp.bc.mir.tc.is_integer(t) && not mono.dp.bc.mir.tc.is_bool(t) {
            let at = self.value_ref(&var mono, &var target, o, node)
            self.render_fixed(&var mono, &var target, at, t, node, &var parts)
            return
        }
        if referent >= 0 {
            through = self.operand_value(&var mono, &var target, o, node)
        }
        let l = self.lay_at(&var mono, &var target, t, node)
        var v = ""
        if through.len() > 0 {
            v = self.load(ll_value_type(&l), through)
        } else {
            v = self.operand_value(&var mono, &var target, o, node)
        }
        if mono.dp.bc.mir.tc.is_bool(t) {
            ll_parts_push(&var parts, LL_PART_BOOL, v, "")
            return
        }
        let signed = not mono.dp.bc.mir.tc.is_unsigned(t)
        let wide = self.int_convert(v, l.bits, 64, signed)
        if signed {
            ll_parts_push(&var parts, LL_PART_SIGNED, wide, "")
        } else {
            ll_parts_push(&var parts, LL_PART_UNSIGNED, wide, "")
        }
    }

    // A run part's bytes: its own, or a Bool's word.
    func part_run(&var self, kind: Int, first: String, second: String) -> String {
        if kind == LL_PART_RUN {
            return first
        }
        let bit = self.to_bit(first)
        let yes = self.text_bytes("true")
        let no = self.text_bytes("false")
        let yes_at = self.pooled(&yes, false, 0)
        let no_at = self.pooled(&no, false, 0)
        var pick = StringBuilder()
        try! pick.append("select i1 ")
        try! pick.append(bit)
        try! pick.append(", ptr ")
        try! pick.append(yes_at)
        try! pick.append(", ptr ")
        try! pick.append(no_at)
        self.assign(pick.build())
    }

    func part_run_length(&var self, kind: Int, first: String, second: String) -> String {
        if kind == LL_PART_RUN {
            return second
        }
        let bit = self.to_bit(first)
        var size = StringBuilder()
        try! size.append("select i1 ")
        try! size.append(bit)
        try! size.append(", i64 4, i64 5")
        self.assign(size.build())
    }

    // Integer `wide` (an i64) rendered in decimal into `buf`; returns the
    // length.
    func render_integer(&var self, buf: String, wide: String, signed: Bool) -> String {
        var call = StringBuilder()
        if signed {
            try! call.append("call i64 @__saw_render_int(ptr ")
        } else {
            try! call.append("call i64 @__saw_render_uint(ptr ")
        }
        try! call.append(buf)
        try! call.append(", i64 ")
        try! call.append(wide)
        try! call.append(")")
        self.assign(call.build())
    }

    // A String operand the builtin was handed by `move`, dropped through its
    // glue once its bytes are written.
    func drop_moved(&var self, mono: &var MonoProgram, target: &var Target, o: Int, node: Int) {
        let op = mono.dp.bc.mir.operands[o]
        if op.kind != MirOperandKind.Move {
            return
        }
        let glue = mono.glue_item(op.ty, MONO_KEY_DROP)
        if glue < 0 {
            return
        }
        let addr = self.place_addr(&var mono, &var target, op.place, node)
        var line = StringBuilder()
        try! line.append("call void ")
        try! line.append(self.plain_symbol(&var mono, glue))
        try! line.append("(ptr ")
        try! line.append(addr)
        try! line.append(")")
        self.put(line.build())
    }

    // The bytes and the length of the String at `text`, read through the
    // String roles.
    func string_bytes_of(&var self, mono: &var MonoProgram, text: String, node: Int) -> String {
        if mono.bytes_item < 0 {
            self.refuse_here(&var mono, node, "a String argument with no bytes role bound")
            return "null"
        }
        var call = StringBuilder()
        try! call.append("call ptr ")
        let role = mono.bytes_item
        try! call.append(self.plain_symbol(&var mono, role))
        try! call.append("(ptr ")
        try! call.append(text)
        try! call.append(")")
        self.assign(call.build())
    }

    func string_length(&var self, mono: &var MonoProgram, text: String, node: Int) -> String {
        if mono.length_item < 0 {
            self.refuse_here(&var mono, node, "a String argument with no length role bound")
            return "0"
        }
        var call = StringBuilder()
        try! call.append("call ")
        try! call.append(self.word)
        try! call.append(" ")
        let role = mono.length_item
        try! call.append(self.plain_symbol(&var mono, role))
        try! call.append("(ptr ")
        try! call.append(text)
        try! call.append(")")
        self.assign(call.build())
    }
}

// The OS-thread engine's spawn (runtime/ABI.md, "Threads"). A `Thread.spawn`
// site starts its thread on a trampoline of its own, a C-ABI `ptr (ptr)` the
// runtime calls with the site's control block.
extension LlEmitter {
    // THE THREAD SPAWN LOWERING: concrete `Thread.spawn` call `c` (SL-765).
    // The brace's environment moves from the frame that built it to the
    // heap, the form's one hidden allocation, a refused one panicking. The
    // control block, its handshake word already holding its size, takes it,
    // the live-thread count is raised, and the thread starts on the site's
    // trampoline. A refused start drops every capture, since the body never
    // ran to take them, and frees the environment. `Thread<T>.__saw_started`
    // then settles the seam's status into the site's `Result`: for a refusal
    // it frees the block, lowers the count and reports the `SystemError`, and
    // otherwise adopts the handle.
    // ENTRY POINTS:
    //     builtin
    func thread_spawn(&var self, mono: &var MonoProgram, target: &var Target, c: Int, info: &MirCall) {
        let node = info.node
        let at = mono.thread_spawn_at(c)
        let count = mono.thread_started_item
        if at < 0 || info.dest < 0 || count < 0 {
            self.refuse_here(&var mono, node, "a `Thread.spawn` site mono did not resolve")
            return
        }
        let site = mono.thread_spawns[at]
        let env_type = ll_thread_environment(&mono, &site)
        let el = self.lay_at(&var mono, &var target, env_type, node)
        let block_pointer = self.item_result(&mono, site.block)
        let block_type = mono.dp.bc.mir.tc.arg_of(block_pointer, 0)
        let word = self.word_type(&var mono, &var target, node)
        let o = mono.dp.bc.mir.lists[info.arg_first]
        let closure_type = mono.dp.bc.mir.operands[o].ty
        let closure = self.operand_addr(&var mono, &var target, o, closure_type, node)
        let frame_env_at = self.offset_addr(closure, target.closure_env_offset())
        let frame_env = self.load("ptr", frame_env_at)
        var env = "null"
        if el.size > 0 {
            let align = if el.align > 0 { el.align } else { 1 }
            env = self.compiler_allocation(&var mono, word, el.size, align, "Thread.spawn", node)
            self.memcpy(env, frame_env, el.size)
        }
        let none = Vector<String>()
        let block = self.call_item_direct(&var mono, &var target, site.block, &none, "", node)
        let env_slot = self.offset_addr(block, target.member_offset(&var mono.dp.bc.mir.tc, block_type, 1))
        self.store("ptr", env, env_slot)
        let _ = self.call_item_direct(&var mono, &var target, count, &none, "", node)
        let trampoline = self.thread_trampoline(&var mono, &var target, &site, block_type, node)
        let tid_slot = self.offset_addr(block, target.member_offset(&var mono.dp.bc.mir.tc, block_type, 0))
        var seam = StringBuilder()
        try! seam.append("declare ")
        try! seam.append(word)
        try! seam.append(" @__saw_rt_thread_spawn(ptr, ptr, ptr)")
        self.declare("__saw_rt_thread_spawn", seam.build())
        var call = StringBuilder()
        try! call.append("call ")
        try! call.append(word)
        try! call.append(" @__saw_rt_thread_spawn(ptr ")
        try! call.append(trampoline)
        try! call.append(", ptr ")
        try! call.append(block)
        try! call.append(", ptr ")
        try! call.append(tid_slot)
        try! call.append(")")
        let status = self.assign(call.build())
        var test = StringBuilder()
        try! test.append("icmp eq ")
        try! test.append(word)
        try! test.append(" ")
        try! test.append(status)
        try! test.append(", 0")
        let started = self.assign(test.build())
        let refused = self.new_label("thread.refused")
        let settled = self.new_label("thread.settled")
        self.branch(started, settled, refused)
        self.put_label(refused)
        if el.size > 0 {
            self.drop_at(&var mono, env_type, env)
            self.free_environment(word, &el, env)
        }
        self.jump(settled)
        self.put_label(settled)
        let dest = self.place_addr(&var mono, &var target, info.dest, node)
        var args = Vector<String>()
        try! args.push(ll_spelled("ptr", block))
        try! args.push(ll_spelled(word, status))
        let handed = self.call_item_direct(&var mono, &var target, site.started, &args, dest, node)
        if handed.len() > 0 {
            let result = self.item_result(&mono, site.started)
            let rl = self.lay_at(&var mono, &var target, result, node)
            self.store(ll_value_type(&rl), handed, dest)
        }
    }

    // Frees thread environment `env`, of layout `el`, whose captures were
    // taken or dropped.
    func free_environment(&var self, word: String, el: &TargetLayout, env: String) {
        self.declare("__saw_rt_dealloc", ll_dealloc_declaration(word))
        let text = ll_thread_dealloc_call(word, env, &el)
        self.put(text)
    }

    // THE THREAD TRAMPOLINE FUNNEL: the start routine of the threads the
    // site `site` describes starts, `ptr (ptr %block)`, defined once per
    // brace body item. It runs the body on the environment the block holds,
    // the body taking every capture as a parameter, stores the result in the
    // block, frees the environment, and ends in `Thread<T>.__saw_exit`: the
    // detach handshake, which destroys the result when the handle detached
    // first, and the live-thread count's decrement. Returns its symbol.
    // ENTRY POINTS:
    //     thread_spawn
    func thread_trampoline(&var self, mono: &var MonoProgram, target: &var Target, site: &MonoThreadSpawn,
                           block_type: Int, node: Int) -> String {
        var symbol = StringBuilder()
        try! symbol.append("@\"saw thread trampoline ")
        try! symbol.append(ll_quoted(mono.item_name(site.body)))
        try! symbol.append("\"")
        let name = symbol.build()
        var k = 0
        while k < self.declared.len() {
            let one = self.declared.get(k) ?? ""
            if one.equals(name) {
                return name
            }
            k = k + 1
        }
        try! self.declared.push(name)
        let word = self.word_type(&var mono, &var target, node)
        let env_type = ll_thread_environment(&mono, &site)
        let el = self.lay_at(&var mono, &var target, env_type, node)
        let result_type = self.item_result(&mono, site.body)
        let rl = self.lay_at(&var mono, &var target, result_type, node)
        let exit_type = self.item_result(&mono, site.exit)
        let xl = self.lay_at(&var mono, &var target, exit_type, node)
        let env_offset = target.member_offset(&var mono.dp.bc.mir.tc, block_type, 1)
        // A zero-sized result has no slot to store into.
        let result_offset = target.member_offset(&var mono.dp.bc.mir.tc, block_type, 3)
        let result_at = if result_offset > 0 { result_offset } else { 0 }
        var text = StringBuilder()
        try! text.append("define internal ptr ")
        try! text.append(name)
        try! text.append("(ptr %block)")
        try! text.append(ll_function_attributes(""))
        try! text.append(" \{\nentry:\n  %env.at = getelementptr i8, ptr %block, i64 ")
        try! text.append(env_offset)
        try! text.append("\n  %env = load ptr, ptr %env.at\n  %result.at = getelementptr i8, ptr %block, i64 ")
        try! text.append(result_at)
        try! text.append("\n")
        var args = StringBuilder()
        let sret = rl.kind == TargetKind.Memory
        if sret {
            try! args.append("ptr %result.at")
        }
        if ll_is_scalar(&el) {
            try! text.append("  %env.value = load ")
            try! text.append(ll_value_type(&el))
            try! text.append(", ptr %env\n")
            if sret {
                try! args.append(", ")
            }
            try! args.append(ll_value_type(&el))
            try! args.append(" %env.value")
        } else if el.kind == TargetKind.Memory {
            if sret {
                try! args.append(", ")
            }
            try! args.append("ptr %env")
        }
        try! text.append("  ")
        if ll_is_scalar(&rl) {
            try! text.append("%value = call ")
            try! text.append(ll_value_type(&rl))
        } else {
            try! text.append("call void")
        }
        try! text.append(" ")
        try! text.append(self.plain_symbol(&var mono, site.body))
        try! text.append("(")
        try! text.append(args.build())
        try! text.append(")\n")
        if ll_is_scalar(&rl) {
            try! text.append("  store ")
            try! text.append(ll_value_type(&rl))
            try! text.append(" %value, ptr %result.at\n")
        }
        if el.size > 0 {
            self.declare("__saw_rt_dealloc", ll_dealloc_declaration(word))
            try! text.append("  ")
            try! text.append(ll_thread_dealloc_call(word, "%env", &el))
            try! text.append("\n")
        }
        try! text.append("  ")
        if ll_is_scalar(&xl) {
            try! text.append("%exited = call ")
            try! text.append(ll_value_type(&xl))
        } else {
            try! text.append("call void")
        }
        try! text.append(" ")
        let exit = site.exit
        try! text.append(self.plain_symbol(&var mono, exit))
        try! text.append("(ptr %block)\n  ret ptr null\n\}\n\n")
        try! self.defs.append(text.build())
        name
    }
}

// The type of the environment a thread spawn's brace body takes by value.
func ll_thread_environment(mono: &MonoProgram, site: &MonoThreadSpawn) -> Int {
    let body = mono.items[site.body].body
    let first = mono.dp.bc.mir.funcs[body].local_first
    mono.dp.bc.mir.locals[first + 1].ty
}

// The instruction freeing thread environment `env` of layout `el`.
func ll_thread_dealloc_call(word: String, env: String, el: &TargetLayout) -> String {
    var out = StringBuilder()
    try! out.append("call void @__saw_rt_dealloc(ptr ")
    try! out.append(env)
    try! out.append(", ")
    try! out.append(word)
    try! out.append(" ")
    try! out.append(el.size)
    try! out.append(", ")
    try! out.append(word)
    try! out.append(" ")
    try! out.append(if el.align > 0 { el.align } else { 1 })
    try! out.append(")")
    out.build()
}

// MIR block `b`'s label.
public func ll_block(b: Int) -> String {
    var out = StringBuilder()
    try! out.append("bb")
    try! out.append(b)
    out.build()
}
