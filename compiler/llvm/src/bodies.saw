// One concrete function as LLVM IR: each MIR local an `alloca`, each
// statement a store into its place, each terminator its LLVM twin. Values of
// a scalar layout travel as SSA values; memory values travel by address and
// move by `memcpy`. A function returning a memory value writes it through a
// leading `sret` pointer, and a memory argument is passed by the address of a
// value the callee copies on entry.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.attributes.{ll_function_attributes, ll_param_attributes}
import sawllvm.prims.{LL_MESSAGE_LIMIT}
import sawllvm.calls.{ll_block}
import sawcoro.lower.{CORO_POLL_PENDING, CORO_POLL_READY, CORO_STATE_DONE, CORO_STATE_START}
import sawcoro.program.{CoroPoint, CoroPointKind, CoroPoisonAt, CoroResume}
import sawllvm.module.{LlEmitter, ll_descriptor_symbol, ll_export_symbol, ll_is_scalar, ll_resume_symbol, ll_symbol,
                           ll_value_type}
import sawllvm.ops.{ll_lossless}
import sawllvm.places.{ll_local_slot}
import sawmir.model.{MirBlock, MirCallKind, MirStmt, MirStmtKind, MirTermKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MONO_KEY_DROP, MonoItem, MonoProgram}
import sawtarget.layout.{Target, TargetKind, TargetLayout}
import sawtypecheck.program.{TcProgram}

// Label `word.STATE` of a resume function's state `state`.
func ll_state_label(word: String, state: Int) -> String {
    var out = StringBuilder()
    try! out.append(word)
    try! out.append(".")
    try! out.append(state)
    out.build()
}

// The name a function's parameter `j` arrives in, before its entry copy into
// the parameter's slot.
public func ll_param_name(j: Int) -> String {
    var param = StringBuilder()
    try! param.append("%p")
    try! param.append(j)
    param.build()
}

extension LlEmitter {
    // Item `k`'s concrete function, written into the definitions unless the
    // backend refused something in it.
    public func emit_function(&var self, mono: &var MonoProgram, target: &var Target, k: Int) {
        let r = self.resume_of(k)
        if r >= 0 {
            self.emit_resume(&var mono, &var target, k, r)
            return
        }
        let it = mono.items[k]
        let f = it.body
        let info = mono.dp.bc.mir.funcs[f]
        self.current = f
        mono.current = k
        self.body = StringBuilder()
        self.allocas = StringBuilder()
        self.temps = 0
        self.labels = 0
        self.refused = false
        self.resume = -1
        let ret_type = self.local_type(&mono, 0)
        let ret = self.lay_at(&var mono, &var target, ret_type, -1)
        self.sret = ret.kind == TargetKind.Memory
        // An export is defined under its C symbol with external linkage, and
        // takes and returns its narrow integers extended as C does.
        let exported = ll_export_symbol(&mono, k).len() > 0
        var head = StringBuilder()
        if exported {
            try! head.append("define ")
        } else {
            try! head.append("define internal ")
        }
        if ll_is_scalar(&ret) {
            if exported {
                let widened = self.c_extension(&mono, ret_type, &ret)
                if widened.len() > 0 {
                    try! head.append(widened)
                    try! head.append(" ")
                }
            }
            try! head.append(ll_value_type(&ret))
        } else {
            try! head.append("void")
        }
        try! head.append(" ")
        try! head.append(ll_symbol(&mono, k))
        try! head.append("(")
        var first = true
        if self.sret {
            try! head.append("ptr %ret")
            first = false
        }
        var prelude = StringBuilder()
        var j = 0
        while j < info.local_count {
            let t = self.local_type(&mono, j)
            let node = mono.dp.bc.mir.locals[info.local_first + j].node
            let l = self.lay_at(&var mono, &var target, t, node)
            try! self.allocas.append("  ")
            try! self.allocas.append(ll_local_slot(j))
            try! self.allocas.append(" = alloca ")
            if ll_is_scalar(&l) {
                try! self.allocas.append(ll_value_type(&l))
            } else {
                try! self.allocas.append("[")
                try! self.allocas.append(l.size)
                try! self.allocas.append(" x i8]")
            }
            try! self.allocas.append(", align ")
            try! self.allocas.append(l.align)
            try! self.allocas.append("\n")
            if j >= 1 && j <= info.param_count && l.kind != TargetKind.Zero {
                if not first {
                    try! head.append(", ")
                }
                first = false
                let name = ll_param_name(j)
                if ll_is_scalar(&l) {
                    try! head.append(ll_value_type(&l))
                    let widened = if exported { self.c_extension(&mono, t, &l) } else { "" }
                    if widened.len() > 0 {
                        try! head.append(" ")
                        try! head.append(widened)
                    }
                    try! prelude.append("  store ")
                    try! prelude.append(ll_value_type(&l))
                    try! prelude.append(" ")
                    try! prelude.append(name)
                    try! prelude.append(", ptr ")
                    try! prelude.append(ll_local_slot(j))
                    try! prelude.append("\n")
                } else {
                    try! head.append("ptr")
                    self.declare("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
                    try! prelude.append("  call void @llvm.memcpy.p0.p0.i64(ptr ")
                    try! prelude.append(ll_local_slot(j))
                    try! prelude.append(", ptr ")
                    try! prelude.append(name)
                    try! prelude.append(", i64 ")
                    try! prelude.append(l.size)
                    try! prelude.append(", i1 false)\n")
                }
                let attributes = ll_param_attributes(&var mono, k, j, t)
                if attributes.len() > 0 {
                    try! head.append(" ")
                    try! head.append(attributes)
                }
                try! head.append(" ")
                try! head.append(name)
            }
            j = j + 1
        }
        self.drive_storage(&var mono, k, &var prelude)
        try! head.append(")")
        try! head.append(ll_function_attributes(""))
        var b = 0
        while b < info.block_count {
            let block = mono.dp.bc.mir.blocks[info.block_first + b]
            self.put_label(ll_block(b))
            var s = block.first
            while s >= 0 {
                let stmt = mono.dp.bc.mir.stmts[s]
                self.statement(&var mono, &var target, &stmt)
                s = stmt.next
            }
            self.block_end(&var mono, &var target, &block)
            b = b + 1
        }
        if self.refused {
            return
        }
        try! self.defs.append(head.build())
        try! self.defs.append(" \{\nentry:\n")
        let slots = self.allocas.build()
        try! self.defs.append(slots)
        try! self.defs.append(prelude.build())
        try! self.defs.append("  br label %bb0\n")
        let blocks = self.body.build()
        try! self.defs.append(blocks)
        try! self.defs.append("\}\n\n")
    }

    // Item `k`'s resume function, `i32 (ptr %frame, ptr %cx)` (SL:coroutines
    // §3.1): an entry switch on the frame's state word, then the body's
    // blocks as coroutine lowering left them, every frame value reached
    // through the frame pointer. Each suspension point's block ends in its
    // point (`point_term`) instead of its call, and a return records the done
    // state and returns `Ready`. Resuming a done frame traps: the driver that
    // does it has lost track of the frame.
    func emit_resume(&var self, mono: &var MonoProgram, target: &var Target, k: Int, r: Int) {
        let it = mono.items[k]
        let f = it.body
        let info = mono.dp.bc.mir.funcs[f]
        let resume = self.lowering.resumes[r]
        self.current = f
        mono.current = k
        self.body = StringBuilder()
        self.allocas = StringBuilder()
        self.temps = 0
        self.labels = 0
        self.refused = false
        self.sret = false
        self.resume = r
        self.poison_next = resume.poison_first
        self.poison_end = resume.poison_first + resume.poison_count
        var j = 0
        while j < info.local_count {
            if self.lowering.resident[resume.resident_first + j] {
                j = j + 1
                continue
            }
            let t = self.local_type(&mono, j)
            let node = mono.dp.bc.mir.locals[info.local_first + j].node
            let l = self.lay_at(&var mono, &var target, t, node)
            try! self.allocas.append("  ")
            try! self.allocas.append(ll_local_slot(j))
            try! self.allocas.append(" = alloca ")
            if ll_is_scalar(&l) {
                try! self.allocas.append(ll_value_type(&l))
            } else {
                try! self.allocas.append("[")
                try! self.allocas.append(l.size)
                try! self.allocas.append(" x i8]")
            }
            try! self.allocas.append(", align ")
            try! self.allocas.append(l.align)
            try! self.allocas.append("\n")
            j = j + 1
        }
        var b = 0
        while b < info.block_count {
            let block = mono.dp.bc.mir.blocks[info.block_first + b]
            self.put_label(ll_block(b))
            var ordinal = 0
            var s = block.first
            while s >= 0 {
                let stmt = mono.dp.bc.mir.stmts[s]
                self.put_poisons(b, CoroPoisonAt.Statement, ordinal)
                self.statement(&var mono, &var target, &stmt)
                s = stmt.next
                ordinal = ordinal + 1
            }
            self.put_poisons(b, CoroPoisonAt.Terminator, 0)
            let p = self.point_at(&resume, b)
            if p >= 0 {
                let point = self.lowering.points[p]
                self.point_term(&var mono, &var target, &point)
            } else if block.term == MirTermKind.Return {
                self.put_state(CORO_STATE_DONE)
                self.put_poll(CORO_POLL_READY)
            } else {
                self.block_end(&var mono, &var target, &block)
            }
            b = b + 1
        }
        self.put_label("coro.done")
        self.declare("llvm.trap", "declare void @llvm.trap()")
        self.put("call void @llvm.trap()")
        self.put("unreachable")
        if self.refused {
            return
        }
        if self.poison_next != self.poison_end {
            var problem = StringBuilder()
            try! problem.append("the poison list of ")
            try! problem.append(ll_resume_symbol(&mono, k))
            try! problem.append(" names a position the function does not have")
            try! mono.problems.push(problem.build())
            return
        }
        var entry = StringBuilder()
        try! entry.append("  store ptr %frame, ptr ")
        try! entry.append(ll_local_slot(resume.frame_local))
        if resume.context_local >= 0 {
            try! entry.append("\n  store ptr %cx, ptr ")
            try! entry.append(ll_local_slot(resume.context_local))
        }
        try! entry.append("\n  %state = load i64, ptr %frame\n  switch i64 %state, label %coro.done [ i64 ")
        try! entry.append(CORO_STATE_START)
        try! entry.append(", label %bb0")
        j = 0
        while j < resume.point_count {
            let point = self.lowering.points[resume.point_first + j]
            j = j + 1
            // An offload's start and take never pend, so no state enters there.
            if point.state < 0 {
                continue
            }
            try! entry.append(" i64 ")
            try! entry.append(point.state)
            try! entry.append(", label %")
            try! entry.append(ll_state_label("coro.state", point.state))
        }
        try! entry.append(" ]\n")
        try! self.defs.append("define internal i32 ")
        try! self.defs.append(ll_resume_symbol(&mono, k))
        try! self.defs.append("(ptr %frame, ptr %cx)")
        try! self.defs.append(ll_function_attributes(""))
        try! self.defs.append(" \{\nentry:\n")
        let slots = self.allocas.build()
        try! self.defs.append(slots)
        try! self.defs.append(entry.build())
        let blocks = self.body.build()
        try! self.defs.append(blocks)
        try! self.defs.append("\}\n\n")
    }

    // The index of the point resume `resume` has at block `b`, or -1.
    func point_at(&self, resume: &CoroResume, b: Int) -> Int {
        var j = 0
        while j < resume.point_count {
            if self.lowering.points[resume.point_first + j].block == b {
                return resume.point_first + j
            }
            j = j + 1
        }
        return -1
    }

    // THE POINT FUNNEL: what a lowered frame does at a suspension point, in
    // place of the call there, and where its state re-enters. A park, of any
    // reason, records the state and returns `Pending`; re-entered, it
    // continues. Its record in the task's context and its arm are MIR its
    // block already ran, through the context local the entry points at `%cx`
    // (compiler/tests/coro/README.md, "Lowering"). A drive
    // starts the child's frame in its slot at state 0, then resumes it,
    // returning `Pending` with the state recorded while the child pends, and
    // continuing once it is `Ready`; re-entered, it resumes the child again.
    // The child's park records the root's word, so a pend passes up as it is.
    // An offload's start and take run their seam calls and continue; neither
    // pends (`offload_start`, `offload_take`).
    // ENTRY POINTS:
    //     emit_resume
    func point_term(&var self, mono: &var MonoProgram, target: &var Target, point: &CoroPoint) {
        let info = mono.dp.bc.mir.calls[point.call]
        let state = ll_state_label("coro.state", point.state)
        var next = ""
        if info.next >= 0 {
            next = ll_block(info.next)
        }
        match point.kind {
            case Drive -> {
                let drive = ll_state_label("coro.drive", point.state)
                let pend = ll_state_label("coro.pend", point.state)
                let start = self.offset_addr("%frame", point.slot)
                var zero = StringBuilder()
                try! zero.append(CORO_STATE_START)
                self.store("i64", zero.build(), start)
                self.jump(drive)
                self.put_label(drive)
                let child = self.offset_addr("%frame", point.slot)
                var call = StringBuilder()
                try! call.append("call i32 ")
                try! call.append(ll_resume_symbol(&mono, point.child))
                try! call.append("(ptr ")
                try! call.append(child)
                try! call.append(", ptr %cx)")
                let poll = self.assign(call.build())
                var test = StringBuilder()
                try! test.append("icmp eq i32 ")
                try! test.append(poll)
                try! test.append(", ")
                try! test.append(CORO_POLL_PENDING)
                let pending = self.assign(test.build())
                // A return edge with poison steps of its own leaves through a
                // block that runs them, and only then.
                let stepped = next.len() > 0 && self.poisons_ahead(point.block, CoroPoisonAt.Resume)
                let ready = if stepped { ll_state_label("coro.ready", point.state) } else { next }
                if next.len() == 0 {
                    next = self.new_label("coro.never")
                    self.branch(pending, pend, next)
                    self.put_label(next)
                    self.put("unreachable")
                } else {
                    self.branch(pending, pend, ready)
                }
                self.put_label(pend)
                self.put_poisons(point.block, CoroPoisonAt.State, 0)
                self.put_state(point.state)
                self.put_poll(CORO_POLL_PENDING)
                self.put_label(state)
                self.jump(drive)
                if stepped {
                    self.put_label(ready)
                    self.put_poisons(point.block, CoroPoisonAt.Resume, 0)
                    self.jump(next)
                }
            },
            case OffloadStart -> {
                self.offload_start(&var mono, &var target, &point, &info)
                self.continue_to(next)
            },
            case OffloadTake -> {
                self.offload_take(&var mono, &var target, &point, &info)
                self.continue_to(next)
            },
            case _ -> {
                self.put_poisons(point.block, CoroPoisonAt.State, 0)
                self.put_state(point.state)
                self.put_poll(CORO_POLL_PENDING)
                self.put_label(state)
                self.put_poisons(point.block, CoroPoisonAt.Resume, 0)
                self.continue_to(next)
            }
        }
    }

    // Whether the next step of the resume function's poison list runs at
    // `at` in block `block`.
    func poisons_at(&self, block: Int, at: CoroPoisonAt) -> Bool {
        if self.poison_next >= self.poison_end {
            return false
        }
        let step = self.lowering.poisons[self.poison_next]
        step.block == block && step.at == at
    }

    // Whether a step of the poison list still to come runs at `at` in block
    // `block`, the block being written.
    func poisons_ahead(&self, block: Int, at: CoroPoisonAt) -> Bool {
        var k = self.poison_next
        while k < self.poison_end && self.lowering.poisons[k].block == block {
            if self.lowering.poisons[k].at == at {
                return true
            }
            k = k + 1
        }
        false
    }

    // The poison-list steps that run at `at` (statement `ordinal`) in block
    // `block`, each a call of AddressSanitizer's interface on the frame's
    // bytes (`coro_poison_lists`). The list is in the order the resume
    // function is written, so its steps are emitted from a cursor, and one
    // left over when the function is done is a broken invariant.
    func put_poisons(&var self, block: Int, at: CoroPoisonAt, ordinal: Int) {
        while self.poisons_at(block, at) && self.lowering.poisons[self.poison_next].ordinal == ordinal {
            let step = self.lowering.poisons[self.poison_next]
            self.poison_next = self.poison_next + 1
            let name = if step.poison { "__asan_poison_memory_region" } else { "__asan_unpoison_memory_region" }
            var declaration = StringBuilder()
            try! declaration.append("declare void @")
            try! declaration.append(name)
            try! declaration.append("(ptr, i64)")
            self.declare(name, declaration.build())
            let addr = self.offset_addr("%frame", step.offset)
            var call = StringBuilder()
            try! call.append("call void @")
            try! call.append(name)
            try! call.append("(ptr ")
            try! call.append(addr)
            try! call.append(", i64 ")
            try! call.append(step.size)
            try! call.append(")")
            self.put(call.build())
        }
    }

    // The storage of the root frame of each lowered drive site in item `k`,
    // which the item's entry points the site's frame local at: an `alloca` of
    // the frame's size and alignment, so a drive costs no allocation
    // (compiler/tests/coro/README.md, "Drive sites").
    func drive_storage(&var self, mono: &var MonoProgram, k: Int, prelude: &var StringBuilder) {
        var j = 0
        while j < self.lowering.drives.len() {
            let d = self.lowering.drives[j]
            j = j + 1
            let r = self.resume_of(d.root)
            if d.item != k || r < 0 {
                continue
            }
            let resume = self.lowering.resumes[r]
            var name = StringBuilder()
            try! name.append("%drive.")
            try! name.append(d.frame)
            let storage = name.build()
            try! self.allocas.append("  ")
            try! self.allocas.append(storage)
            try! self.allocas.append(" = alloca [")
            try! self.allocas.append(resume.size)
            try! self.allocas.append(" x i8], align ")
            try! self.allocas.append(resume.align)
            try! self.allocas.append("\n")
            try! prelude.append("  store ptr ")
            try! prelude.append(storage)
            try! prelude.append(", ptr ")
            try! prelude.append(ll_local_slot(d.frame))
            try! prelude.append("\n")
        }
    }

    // A block's terminator. A spawn or drive terminator is what coroutine
    // lowering left of a spawn or drive site: its destination receives the
    // address of the task root's frame descriptor, which no MIR operand
    // names, and the rest of the site is ordinary MIR
    // (compiler/tests/coro/README.md, "Spawn sites" and "Drive sites"). One
    // whose root has no lowered frame was not lowered, and calling the root
    // here would run its body outside a frame.
    func block_end(&var self, mono: &var MonoProgram, target: &var Target, block: &MirBlock) {
        let rooted = block.term == MirTermKind.Call && (mono.dp.bc.mir.calls[block.call].kind == MirCallKind.Spawn || mono.dp.bc.mir.calls[block.call].kind == MirCallKind.Drive)
        if not rooted {
            self.terminator(&var mono, &var target, &block)
            return
        }
        let info = mono.dp.bc.mir.calls[block.call]
        let root = mono.call_item(block.call)
        if self.resume_of(root) < 0 || info.arg_count != 0 || info.dest < 0 || info.next < 0 {
            if info.kind == MirCallKind.Drive {
                self.refuse_here(&var mono, info.node, "a drive site whose task root has no lowered frame")
            } else {
                self.refuse_here(&var mono, info.node, "a spawn site whose task root has no lowered frame")
            }
            return
        }
        let dest = self.place_addr(&var mono, &var target, info.dest, info.node)
        self.store("ptr", ll_descriptor_symbol(&mono, root), dest)
        self.jump(ll_block(info.next))
    }

    // A jump to `label`, or `unreachable` for a call that never returns.
    func continue_to(&var self, label: String) {
        if label.len() == 0 {
            self.put("unreachable")
        } else {
            self.jump(label)
        }
    }

    // Records `state` in the frame's state word.
    func put_state(&var self, state: Int) {
        var v = StringBuilder()
        try! v.append(state)
        self.store("i64", v.build(), "%frame")
    }

    // Returns `poll` from the resume function.
    func put_poll(&var self, poll: Int) {
        var line = StringBuilder()
        try! line.append("ret i32 ")
        try! line.append(poll)
        self.put(line.build())
    }

    // The attribute a C signature gives an integer narrower than 32 bits of
    // type `t`, extended by its signedness, or "" for any other value.
    func c_extension(&self, mono: &MonoProgram, t: Int, l: &TargetLayout) -> String {
        if l.kind != TargetKind.Int || l.bits >= 32 {
            return ""
        }
        if self.signed_type(&mono, t) {
            return "signext"
        }
        "zeroext"
    }

    // A statement: an assignment writes its rvalue into its place; a drop
    // runs its type's glue when the type has one; a budget point writes
    // nothing, since coroutine lowering lowers no frame that holds one, and a
    // point outside a frame is inert.
    func statement(&var self, mono: &var MonoProgram, target: &var Target, stmt: &MirStmt) {
        match stmt.kind {
            case Budget -> {},
            case Drop -> {
                let t = mono.dp.bc.mir.places[stmt.place].ty
                let glue = mono.glue_item(t, MONO_KEY_DROP)
                if glue < 0 {
                    return
                }
                let addr = self.place_addr(&var mono, &var target, stmt.place, stmt.node)
                var line = StringBuilder()
                try! line.append("call void ")
                try! line.append(ll_symbol(&mono, glue))
                try! line.append("(ptr ")
                try! line.append(addr)
                try! line.append(")")
                self.put(line.build())
            },
            case Assign -> {
                let dest = self.place_addr(&var mono, &var target, stmt.place, stmt.node)
                self.rvalue_into(&var mono, &var target, stmt.rvalue, dest, stmt.node)
            }
        }
    }
}
