// The whole program's `.ll` cut into codegen units (SL-955), each a module
// clang compiles on its own and the link joins: every definition is in
// exactly one unit, or copied into each unit that uses it, and a unit
// reaching another's names it by a declaration. The cut reads the text `llvm_emit_program` writes, whose
// shape it relies on: a header of comments and the target triple, then one
// top-level entity per line, except a `define`, which runs to the `}` that
// opens a line.
//
// A unit's text is a function of its own definitions alone, so an edit to one
// module leaves every other module's unit byte for byte as it was (the
// object cache's premise). So every definition leaves `internal` and
// `private` linkage for `hidden`, whether or not another unit names it, and
// the program still exports nothing it did not; a `private unnamed_addr
// constant`, whose address nothing may observe, is copied into every unit that
// names it instead, and so is a definition of no module's own (glue, thunks,
// failure helpers: the plan's `LL_UNIT_COPY`), as `linkonce_odr hidden`,
// which the link keeps one of. The module's one `@llvm.used` list is cut by
// definition: a unit holds the elements it defines and no list when it
// defines none, since a declaration keeps nothing under ThinLTO, and an
// element copied into several units is refused. A unit's globals, declarations and definitions are
// written in symbol order, and the byte constants (`@.bytes.N`) and numbered
// metadata it holds are numbered within it, in the order its text first names
// them, the fixed debug nodes keeping their numbers. Each unit carries the
// named metadata, and the attribute groups and numbered metadata its text
// names. Each unit names itself as its `source_filename`, which LLVM would
// otherwise take from the path clang reads it at, so its object is a function
// of its text (ELF's file symbol, LTO bitcode); the name is distinct per unit,
// as ThinLTO's identifiers of local symbols such as `@.bytes.N` need.

import sawllvm.debug.{LL_DEBUG_FIRST}
import sawllvm.units.{LlUnitPlan}

// One unit: its name, and its module's text.
public struct LlUnit {
    name: String
    text: String
}

enum LlEntityKind {
    case Global,
    case Declare,
    case Define,
    case Attributes,
    case NamedMeta,
    case Meta
}

// One top-level entity of the module: its kind, its bytes `start..stop` (its
// last line break included), its symbol for a global, a declaration or a
// definition, and the entities its text names, a run of the splitter's
// reference pool.
struct LlEntity {
    kind: LlEntityKind
    start: Int
    stop: Int
    symbol: String
    refs_first: Int
    refs_count: Int
}

// Where an entity's text goes besides a unit's index: into every unit that
// names it, or, for one that is no global or definition, nowhere of its own.
static LL_COPY: Int = -2
static LL_UNPLACED: Int = -1

static LL_NEWLINE: Int = 10
static LL_QUOTE: Int = 34
static LL_AT: Int = 64
static LL_BANG: Int = 33
static LL_ZERO: Int = 48
static LL_OPEN_BRACE: Int = 123
static LL_CLOSE_BRACE: Int = 125
static LL_OPEN_PAREN: Int = 40
static LL_CLOSE_PAREN: Int = 41
static LL_OPEN_BRACKET: Int = 91
static LL_CLOSE_BRACKET: Int = 93
static LL_LESS: Int = 60
static LL_GREATER: Int = 62
static LL_COMMA: Int = 44
static LL_SPACE: Int = 32
static LL_PERCENT: Int = 37
static LL_SEMICOLON: Int = 59
static LL_HASH: Int = 35

// The splitter's state over one module's text.
struct LlSplit {
    entities: Vector<LlEntity>
    refs: Vector<Int>
    by_symbol: Map<String, Int>
    // By metadata number, its entity, or -1; and by attribute group number.
    meta: Vector<Int>
    attrs: Vector<Int>
    // The header's end: past the target triple's line and what precedes it.
    header_stop: Int
    // Whether the module's objects are ELF, where a copied definition is in a
    // comdat of its own, so a link keeps one copy's bytes and not only its
    // symbol; Mach-O, which has no comdats, coalesces weak definitions whole.
    comdats: Bool
    // By entity, its unit, or LL_COPY.
    owner: Vector<Int>
    // Each unit's own entities, a run of `owned` from `owned_first[u]` to
    // `owned_first[u + 1]`, and the entities every unit holds.
    owned_first: Vector<Int>
    owned: Vector<Int>
    always: Vector<Int>
    // The closure's marks, each an entity's last token, so one walk's marks
    // need no clearing before the next.
    held_mark: Vector<Int>
    asked_mark: Vector<Int>
    token: Int
    // The unit being written's own numbers: by entity a byte constant's, and
    // by module number a metadata node's, each valid where its mark is the
    // token; the next of each; and the nodes numbered but not yet read.
    pool_number: Vector<Int>
    pool_mark: Vector<Int>
    meta_number: Vector<Int>
    meta_mark: Vector<Int>
    pool_next: Int
    meta_next: Int
    meta_queue: Vector<Int>
    // The module's `@llvm.used` global, or -1; the entities its list names, in
    // list order; and the line the unit being written holds for it.
    used_entity: Int
    used_elements: Vector<Int>
    used_text: String
}

extension LlSplit: NoCopy {}

// THE SPLIT: module text `text` cut into the units `plan` names, in plan
// order, each holding at least one definition or global; or no units, with
// the problem that stopped it in `problems`.
//
// ENTRY POINTS:
//   driver_split_build
public func ll_split(text: &String, plan: &LlUnitPlan, problems: &var Vector<String>) -> Vector<LlUnit> {
    var s = LlSplit(entities: Vector<LlEntity>(), refs: Vector<Int>(), by_symbol: Map<String, Int>(),
                    meta: Vector<Int>(), attrs: Vector<Int>(), header_stop: 0, comdats: false, owner: Vector<Int>(),
                    owned_first: Vector<Int>(), owned: Vector<Int>(),
                    always: Vector<Int>(), held_mark: Vector<Int>(), asked_mark: Vector<Int>(), token: 0,
                    pool_number: Vector<Int>(), pool_mark: Vector<Int>(), meta_number: Vector<Int>(),
                    meta_mark: Vector<Int>(), pool_next: 0, meta_next: 0, meta_queue: Vector<Int>(), used_entity: -1,
                    used_elements: Vector<Int>(), used_text: "")
    var units = Vector<LlUnit>()
    let why = ll_split_entities(&var s, &text)
    if why.len() > 0 {
        try! problems.push(why)
        return move units
    }
    let unresolved = ll_split_references(&var s, &text)
    if unresolved.len() > 0 {
        try! problems.push(unresolved)
        return move units
    }
    let count = ll_split_owners(&var s, &text, &plan)
    var j = 0
    while j < s.used_elements.len() {
        if s.owner[s.used_elements[j]] < 0 {
            var msg = StringBuilder()
            try! msg.append("the splitter finds `@llvm.used` naming `")
            try! msg.append(s.entities[s.used_elements[j]].symbol)
            try! msg.append("`, a definition copied into each unit that uses it")
            try! problems.push(msg.build())
            return move units
        }
        j = j + 1
    }
    ll_split_group(&var s, count)
    var u = 0
    while u < count {
        if s.owned_first[u + 1] > s.owned_first[u] {
            let name = plan.names.get(u) ?? "-unit"
            let unit_text = ll_split_unit_text(&var s, &text, u, name)
            try! units.push(LlUnit(name: name, text: unit_text))
        }
        u = u + 1
    }
    move units
}

// Whether the bytes of `text` at `at` spell `word`.
func ll_split_at(text: &String, at: Int, word: String) -> Bool {
    if at + word.len() > text.len() {
        return false
    }
    var k = 0
    while k < word.len() {
        if text.byte_at(at + k) != word.byte_at(k) {
            return false
        }
        k = k + 1
    }
    true
}

// The offset just past the line break of the line starting at `at`.
func ll_split_line_end(text: &String, at: Int) -> Int {
    let n = text.len()
    var k = at
    while k < n && (text.byte_at(k) as Int) != LL_NEWLINE {
        k = k + 1
    }
    if k < n { k + 1 } else { k }
}

// The end of the symbol token whose `@` is at `at`: past the closing quote
// of a quoted one, which holds no quote (`ll_quoted`), else past its last
// name character.
func ll_split_symbol_end(text: &String, at: Int) -> Int {
    let n = text.len()
    var k = at + 1
    if k < n && (text.byte_at(k) as Int) == LL_QUOTE {
        k = k + 1
        while k < n && (text.byte_at(k) as Int) != LL_QUOTE {
            k = k + 1
        }
        return if k < n { k + 1 } else { k }
    }
    while k < n && ll_split_name_byte(text.byte_at(k) as Int) {
        k = k + 1
    }
    k
}

// Whether byte `b` continues an unquoted LLVM name.
func ll_split_name_byte(b: Int) -> Bool {
    (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || ll_split_digit(b) || b == 95 || b == 46 || b == 36 || b == 45
}

func ll_split_digit(b: Int) -> Bool {
    b >= LL_ZERO && b <= LL_ZERO + 9
}

// The one spelling of symbol token `symbol`: a quoted name that needs no
// quotes is the same symbol as its bare form (`@"memcpy"` is `@memcpy`), so
// it is keyed bare.
func ll_split_symbol_key(symbol: String) -> String {
    let n = symbol.len()
    if n < 4 || (symbol.byte_at(1) as Int) != LL_QUOTE || ll_split_digit(symbol.byte_at(2) as Int) {
        return symbol
    }
    var k = 2
    while k < n - 1 {
        if not ll_split_name_byte(symbol.byte_at(k) as Int) {
            return symbol
        }
        k = k + 1
    }
    var out = StringBuilder()
    try! out.append("@")
    try! out.append(symbol.substring(2, n - 1))
    out.build()
}

// The first symbol token in `start..stop`, or "".
func ll_split_first_symbol(text: &String, start: Int, stop: Int) -> String {
    var k = start
    while k < stop {
        if (text.byte_at(k) as Int) == LL_AT {
            return text.substring(k, ll_split_symbol_end(&text, k))
        }
        k = k + 1
    }
    ""
}

// The metadata number whose digits start at `at`, and the offset past them.
func ll_split_number(text: &String, at: Int, stop: Int) -> (Int, Int) {
    var id = 0
    var k = at
    while k < stop && ll_split_digit(text.byte_at(k) as Int) {
        id = id * 10 + (text.byte_at(k) as Int) - LL_ZERO
        k = k + 1
    }
    (id, k)
}

// Reads `text` into `s.entities`, recording each symbol's entity and each
// metadata number's; the reason it cannot, or "".
func ll_split_entities(s: &var LlSplit, text: &String) -> String {
    let n = text.len()
    var at = 0
    var header = true
    while at < n {
        let stop = ll_split_line_end(&text, at)
        let b = text.byte_at(at) as Int
        if b == LL_NEWLINE || b == LL_SEMICOLON {
            at = stop
            continue
        }
        if header && ll_split_at(&text, at, "target ") {
            s.header_stop = stop
            s.comdats = not text.substring(at, stop).contains("-apple-")
            at = stop
            continue
        }
        var kind = LlEntityKind.Global
        var end = stop
        var symbol = ""
        if b == LL_AT {
            symbol = text.substring(at, ll_split_symbol_end(&text, at))
        } else if ll_split_at(&text, at, "define ") {
            kind = LlEntityKind.Define
            symbol = ll_split_first_symbol(&text, at, stop)
            // A definition runs to the line its closing brace opens.
            var line = stop
            var closed = false
            while line < n && not closed {
                closed = (text.byte_at(line) as Int) == LL_CLOSE_BRACE
                line = ll_split_line_end(&text, line)
            }
            if not closed {
                return "the backend's module ends inside a definition the splitter reads"
            }
            end = line
        } else if ll_split_at(&text, at, "declare ") {
            kind = LlEntityKind.Declare
            symbol = ll_split_first_symbol(&text, at, stop)
        } else if ll_split_at(&text, at, "attributes #") {
            kind = LlEntityKind.Attributes
            let id = ll_split_number(&text, at + 12, stop).0
            while s.attrs.len() <= id {
                try! s.attrs.push(-1)
            }
            s.attrs[id] = s.entities.len()
        } else if b == LL_BANG && at + 1 < n && ll_split_digit(text.byte_at(at + 1) as Int) {
            kind = LlEntityKind.Meta
            let id = ll_split_number(&text, at + 1, stop).0
            while s.meta.len() <= id {
                try! s.meta.push(-1)
            }
            s.meta[id] = s.entities.len()
        } else if b == LL_BANG {
            kind = LlEntityKind.NamedMeta
        } else {
            var msg = StringBuilder()
            try! msg.append("the splitter reads no top-level entity at `")
            try! msg.append(text.substring(at, if stop - at > 60 { at + 60 } else { stop }))
            try! msg.append("`")
            return msg.build()
        }
        header = false
        // A definition's symbol wins over a declaration of it.
        let named = symbol.len() > 0
        let key = ll_split_symbol_key(symbol)
        if named && (kind != LlEntityKind.Declare || not s.by_symbol.contains_key(key)) {
            let _ = try! s.by_symbol.insert(key, s.entities.len())
        }
        if kind == LlEntityKind.Global && symbol.equals("@llvm.used") {
            s.used_entity = s.entities.len()
        }
        try! s.entities.push(LlEntity(kind: kind, start: at, stop: end, symbol: symbol, refs_first: 0, refs_count: 0))
        at = end
    }
    ""
}

// Records the entities each global, definition and metadata node names, and
// the attribute groups each declaration names; the first name no entity
// defines or declares, or "".
func ll_split_references(s: &var LlSplit, text: &String) -> String {
    let count = s.entities.len()
    var stamp = Vector<Int>()
    var e = 0
    while e < count {
        try! stamp.push(-1)
        e = e + 1
    }
    e = 0
    while e < count {
        let entity = s.entities[e]
        let first = s.refs.len()
        let symbolic = entity.kind == LlEntityKind.Global || entity.kind == LlEntityKind.Define
        let declaring = entity.kind == LlEntityKind.Declare
        let scans = symbolic || declaring || entity.kind == LlEntityKind.Meta || entity.kind == LlEntityKind.NamedMeta
        // The entity's own symbol or number is not a reference.
        var k = entity.start
        if entity.kind == LlEntityKind.Global {
            k = entity.start + entity.symbol.len()
        } else if entity.kind == LlEntityKind.Meta {
            k = ll_split_number(&text, entity.start + 1, entity.stop).1
        }
        while scans && k < entity.stop {
            let b = text.byte_at(k) as Int
            if b == LL_AT && declaring {
                // A declaration names only its own symbol, which a
                // definition of it may hold.
                k = ll_split_symbol_end(&text, k)
            } else if b == LL_HASH && k + 1 < entity.stop && ll_split_digit(text.byte_at(k + 1) as Int) {
                let number = ll_split_number(&text, k + 1, entity.stop)
                k = number.1
                let target = s.attrs.get(number.0) ?? -1
                if target < 0 {
                    return "the splitter finds an attribute group reference the module does not define"
                }
                if stamp[target] != e {
                    stamp[target] = e
                    try! s.refs.push(target)
                }
            } else if b == LL_AT {
                let end = ll_split_symbol_end(&text, k)
                let name = text.substring(k, end)
                guard let target = s.by_symbol.get(ll_split_symbol_key(name)) else {
                    var msg = StringBuilder()
                    try! msg.append("the splitter finds no definition or declaration of `")
                    try! msg.append(name)
                    try! msg.append("`")
                    return msg.build()
                }
                if target != e && stamp[target] != e {
                    stamp[target] = e
                    try! s.refs.push(target)
                }
                k = end
            } else if b == LL_BANG && k + 1 < entity.stop && ll_split_digit(text.byte_at(k + 1) as Int) {
                let number = ll_split_number(&text, k + 1, entity.stop)
                k = number.1
                let target = s.meta.get(number.0) ?? -1
                if target < 0 {
                    return "the splitter finds a metadata reference the module does not define"
                }
                if target != e && stamp[target] != e {
                    stamp[target] = e
                    try! s.refs.push(target)
                }
            } else if b == LL_QUOTE {
                // A string (a `c"..."` constant, a section, a metadata
                // string) names nothing.
                k = k + 1
                while k < entity.stop && (text.byte_at(k) as Int) != LL_QUOTE {
                    k = k + 1
                }
                k = k + 1
            } else {
                k = k + 1
            }
        }
        s.entities[e].refs_first = first
        s.entities[e].refs_count = s.refs.len() - first
        if e == s.used_entity {
            // The list's elements go to the units that define them
            // (`ll_split_unit_text`), so the entity itself names nothing.
            var r = 0
            while r < s.entities[e].refs_count {
                try! s.used_elements.push(s.refs[first + r])
                r = r + 1
            }
            s.entities[e].refs_count = 0
        }
        e = e + 1
    }
    ""
}

// Places every global and definition: in `plan`'s unit; copied, when the plan
// says so or it is a `private unnamed_addr constant`; else in the shared
// unit, which a placement by first user would make depend on which module
// names it first. Returns the number of units.
func ll_split_owners(s: &var LlSplit, text: &String, plan: &LlUnitPlan) -> Int {
    let count = s.entities.len()
    var e = 0
    while e < count {
        let entity = s.entities[e]
        var u = LL_UNPLACED
        // `@llvm.used` is written into each unit that defines an element.
        if e == s.used_entity {
            try! s.owner.push(u)
            e = e + 1
            continue
        }
        if entity.kind == LlEntityKind.Define || entity.kind == LlEntityKind.Global {
            let at = entity.start + entity.symbol.len()
            if let planned = plan.owners.get(entity.symbol) {
                u = if planned < 0 { LL_COPY } else { planned }
            } else if entity.kind == LlEntityKind.Global && ll_split_at(&text, at, " = private unnamed_addr constant ") {
                u = LL_COPY
            } else {
                u = plan.shared
            }
        }
        try! s.owner.push(u)
        e = e + 1
    }
    plan.names.len()
}

// Groups the entities by unit (`owned`), notes the ones every unit holds,
// and readies the closure's marks and the units' numbering.
func ll_split_group(s: &var LlSplit, units: Int) {
    let count = s.entities.len()
    var u = 0
    while u <= units {
        try! s.owned_first.push(0)
        u = u + 1
    }
    var e = 0
    while e < count {
        try! s.held_mark.push(0)
        try! s.asked_mark.push(0)
        try! s.pool_number.push(0)
        try! s.pool_mark.push(0)
        let o = s.owner[e]
        if o >= 0 {
            s.owned_first[o + 1] = s.owned_first[o + 1] + 1
        }
        if s.entities[e].kind == LlEntityKind.NamedMeta {
            try! s.always.push(e)
        }
        e = e + 1
    }
    var m = 0
    while m < s.meta.len() {
        try! s.meta_number.push(0)
        try! s.meta_mark.push(0)
        m = m + 1
    }
    u = 0
    while u < units {
        s.owned_first[u + 1] = s.owned_first[u + 1] + s.owned_first[u]
        u = u + 1
    }
    var fill = Vector<Int>()
    u = 0
    while u < units {
        try! fill.push(s.owned_first[u])
        u = u + 1
    }
    e = 0
    while e < count {
        try! s.owned.push(0)
        e = e + 1
    }
    e = 0
    while e < count {
        let o = s.owner[e]
        if o >= 0 {
            s.owned[fill[o]] = e
            fill[o] = fill[o] + 1
        }
        e = e + 1
    }
}

// The entities unit `u`'s text holds: its own globals and definitions, the
// copies they reach, the declarations, attribute groups and named metadata
// they name, and the numbered metadata all of those reach; and the attribute
// groups of each other unit's entity they name, which `needed` gets and its
// declaration repeats.
func ll_split_closure(s: &var LlSplit, u: Int, needed: &var Vector<Int>) -> Vector<Int> {
    s.token = s.token + 1
    let token = s.token
    var held = Vector<Int>()
    var k = s.owned_first[u]
    while k < s.owned_first[u + 1] {
        s.held_mark[s.owned[k]] = token
        try! held.push(s.owned[k])
        k = k + 1
    }
    k = 0
    while k < s.always.len() {
        s.held_mark[s.always[k]] = token
        try! held.push(s.always[k])
        k = k + 1
    }
    var next = 0
    while next < held.len() {
        let one = s.entities[held[next]]
        next = next + 1
        var r = 0
        while r < one.refs_count {
            let target = s.refs[one.refs_first + r]
            r = r + 1
            if s.held_mark[target] == token || s.asked_mark[target] == token {
                continue
            }
            let o = s.owner[target]
            let kind = s.entities[target].kind
            if kind == LlEntityKind.Meta || kind == LlEntityKind.Declare || kind == LlEntityKind.Attributes ||
               o == LL_COPY {
                s.held_mark[target] = token
                try! held.push(target)
            } else {
                s.asked_mark[target] = token
                try! needed.push(target)
            }
        }
    }
    k = 0
    while k < needed.len() {
        let one = s.entities[needed[k]]
        k = k + 1
        var r = 0
        while r < one.refs_count {
            let target = s.refs[one.refs_first + r]
            r = r + 1
            if s.entities[target].kind == LlEntityKind.Attributes && s.held_mark[target] != token {
                s.held_mark[target] = token
                try! held.push(target)
            }
        }
    }
    held.sort()
    move held
}

// Unit `u`'s module text: the header and its `source_filename`, `name`; its
// byte constants, other globals, declarations and definitions, then the
// declarations of what it names elsewhere, each run in symbol order; the
// attribute groups, named metadata and numbered metadata. Byte constants and
// metadata take the unit's own numbers (`ll_split_number_unit`). A unit's
// name is a module path or `-program`, which needs no escape in a quoted name.
func ll_split_unit_text(s: &var LlSplit, text: &String, u: Int, name: String) -> String {
    var needed = Vector<Int>()
    let held = ll_split_closure(&var s, u, &var needed)
    var pool = Vector<Int>()
    var globals = Vector<Int>()
    var declares = Vector<Int>()
    var defines = Vector<Int>()
    var tail = Vector<Int>()
    var k = 0
    while k < held.len() {
        let e = held[k]
        k = k + 1
        let kind = s.entities[e].kind
        if kind == LlEntityKind.Global && s.entities[e].symbol.starts_with("@.bytes.") {
            try! pool.push(e)
        } else if kind == LlEntityKind.Global {
            try! globals.push(e)
        } else if kind == LlEntityKind.Declare {
            try! declares.push(e)
        } else if kind == LlEntityKind.Define {
            try! defines.push(e)
        } else if kind == LlEntityKind.Attributes || kind == LlEntityKind.NamedMeta {
            try! tail.push(e)
        }
    }
    s.used_text = ll_split_used_text(&s, u)
    if s.used_text.len() > 0 {
        try! globals.push(s.used_entity)
    }
    ll_split_by_symbol(&s, &var globals)
    ll_split_by_symbol(&s, &var declares)
    ll_split_by_symbol(&s, &var defines)
    ll_split_by_symbol(&s, &var needed)
    ll_split_number_unit(&var s, &text, &globals, &defines, &tail)
    var out = StringBuilder()
    try! out.append(text.substring(0, s.header_stop))
    try! out.append("source_filename = \"")
    try! out.append(name)
    try! out.append("\"\n\n")
    k = 0
    while s.comdats && k < defines.len() {
        let e = defines[k]
        k = k + 1
        if s.owner[e] == LL_COPY {
            try! out.append("$")
            try! out.append(s.entities[e].symbol.substring(1, s.entities[e].symbol.len()))
            try! out.append(" = comdat any\n")
        }
    }
    // A byte constant is written at its unit number; every held one is
    // named by the unit's text, so each number has one.
    var by_number = Vector<Int>()
    k = 0
    while k < pool.len() {
        try! by_number.push(-1)
        k = k + 1
    }
    k = 0
    while k < pool.len() {
        let e = pool[k]
        k = k + 1
        if s.pool_mark[e] == s.token && s.pool_number[e] < by_number.len() {
            by_number[s.pool_number[e]] = e
        }
    }
    k = 0
    while k < by_number.len() {
        if by_number[k] >= 0 {
            ll_split_write(&var out, &s, &text, by_number[k])
        }
        k = k + 1
    }
    ll_split_write_all(&var out, &s, &text, &globals)
    ll_split_write_all(&var out, &s, &text, &declares)
    ll_split_write_all(&var out, &s, &text, &defines)
    k = 0
    while k < needed.len() {
        try! out.append(ll_split_declaration(&s, &text, needed[k]))
        try! out.append("\n")
        k = k + 1
    }
    try! out.append("\n")
    ll_split_write_all(&var out, &s, &text, &tail)
    // The numbered metadata: the fixed nodes, then the unit's own in number
    // order.
    k = 0
    while k < LL_DEBUG_FIRST && k < s.meta.len() {
        let e = s.meta[k]
        if e >= 0 && s.held_mark[e] == s.token {
            ll_split_write(&var out, &s, &text, e)
        }
        k = k + 1
    }
    k = 0
    while k < s.meta_queue.len() {
        ll_split_write(&var out, &s, &text, s.meta[s.meta_queue[k]])
        k = k + 1
    }
    out.build()
}

// Unit `u`'s `@llvm.used` line: the elements of the module's list that `u`
// defines, in the list's order, each a symbol an optimizer or a link run on
// the unit alone keeps; "" when it defines none. A unit lists only what it
// defines, since a declaration roots nothing under ThinLTO.
func ll_split_used_text(s: &LlSplit, u: Int) -> String {
    var mine = Vector<String>()
    var k = 0
    while k < s.used_elements.len() {
        if s.owner[s.used_elements[k]] == u {
            try! mine.push(s.entities[s.used_elements[k]].symbol)
        }
        k = k + 1
    }
    if mine.len() == 0 {
        return ""
    }
    var out = StringBuilder()
    try! out.append("@llvm.used = appending global [")
    try! out.append(mine.len())
    try! out.append(" x ptr] [")
    k = 0
    while k < mine.len() {
        if k > 0 {
            try! out.append(", ")
        }
        try! out.append("ptr ")
        try! out.append(mine[k])
        k = k + 1
    }
    try! out.append("], section \"llvm.metadata\"\n")
    out.build()
}

// Writes each of entities `run` (`ll_split_write`).
func ll_split_write_all(out: &var StringBuilder, s: &LlSplit, text: &String, run: &Vector<Int>) {
    var k = 0
    while k < run.len() {
        ll_split_write(&var out, &s, &text, run[k])
        k = k + 1
    }
}

// Writes entity `e` into a unit's text under the unit's numbers, a global or
// definition of its own that is `internal` or `private` as `hidden`: the
// unit's text then reads the same whether or not another unit names it. A
// copied definition is `linkonce_odr hidden`: every unit that uses it holds
// the same text, and the link keeps one.
func ll_split_write(out: &var StringBuilder, s: &LlSplit, text: &String, e: Int) {
    if e == s.used_entity {
        try! out.append(s.used_text)
        return
    }
    let entity = s.entities[e]
    var at = entity.start
    if entity.kind == LlEntityKind.Define {
        at = at + 7
    } else if entity.kind == LlEntityKind.Global {
        at = at + entity.symbol.len() + 3
    }
    let owned = entity.kind == LlEntityKind.Define || entity.kind == LlEntityKind.Global
    let linkage_end = ll_split_linkage_end(&text, at)
    let copied_code = entity.kind == LlEntityKind.Define && s.owner[e] == LL_COPY
    if owned && linkage_end > at && (s.owner[e] >= 0 || copied_code) {
        ll_split_put(&var out, &s, &text, entity.start, at)
        try! out.append(if copied_code { "linkonce_odr hidden " } else { "hidden " })
        if copied_code && s.comdats {
            // `comdat` goes after the head's attributes, before its `!dbg`
            // attachment or its body.
            let head_end = ll_split_line_end(&text, entity.start)
            var cut = head_end
            var k = linkage_end
            while k < head_end {
                if ll_split_at(&text, k, " !dbg ") || ll_split_at(&text, k, " \{\n") {
                    cut = k
                    break
                }
                k = k + 1
            }
            ll_split_put(&var out, &s, &text, linkage_end, cut)
            try! out.append(" comdat")
            ll_split_put(&var out, &s, &text, cut, entity.stop)
            return
        }
        ll_split_put(&var out, &s, &text, linkage_end, entity.stop)
        return
    }
    ll_split_put(&var out, &s, &text, entity.start, entity.stop)
}

// Sorts entities `v` by symbol: a stable merge sort, since a unit's text
// orders its runs by name, never by where the whole module put them.
func ll_split_by_symbol(s: &LlSplit, v: &var Vector<Int>) {
    let n = v.len()
    var from = Vector<Int>()
    var to = Vector<Int>()
    var k = 0
    while k < n {
        try! from.push(v[k])
        try! to.push(0)
        k = k + 1
    }
    var width = 1
    while width < n {
        var lo = 0
        while lo < n {
            let mid = if lo + width < n { lo + width } else { n }
            let hi = if lo + 2 * width < n { lo + 2 * width } else { n }
            var i = lo
            var j = mid
            var o = lo
            while o < hi {
                var left = j >= hi
                if not left && i < mid {
                    left = not ll_split_bytes_less(&s.entities[from[j]].symbol, &s.entities[from[i]].symbol)
                }
                if left {
                    to[o] = from[i]
                    i = i + 1
                } else {
                    to[o] = from[j]
                    j = j + 1
                }
                o = o + 1
            }
            lo = hi
        }
        k = 0
        while k < n {
            from[k] = to[k]
            k = k + 1
        }
        width = width * 2
    }
    k = 0
    while k < n {
        v[k] = from[k]
        k = k + 1
    }
}

// Whether `a` sorts before `b`, byte by byte, a prefix first.
func ll_split_bytes_less(a: &String, b: &String) -> Bool {
    let n = if a.len() < b.len() { a.len() } else { b.len() }
    var k = 0
    while k < n {
        let x = a.byte_at(k) as Int
        let y = b.byte_at(k) as Int
        if x != y {
            return x < y
        }
        k = k + 1
    }
    a.len() < b.len()
}

// THE UNIT NUMBERING: numbers the byte constants and metadata nodes the
// unit's text names, each the first time it is named: through its globals
// and definitions in the order they are written, then the metadata those
// reach, breadth first, then what the named metadata and the fixed nodes
// name. The numbers are a function of the unit's text alone. Nodes below
// `LL_DEBUG_FIRST` are the module's fixed ones and keep their numbers.
//
// ENTRY POINTS:
//   ll_split_unit_text
func ll_split_number_unit(s: &var LlSplit, text: &String, globals: &Vector<Int>, defines: &Vector<Int>,
                          tail: &Vector<Int>) {
    s.pool_next = 0
    s.meta_next = LL_DEBUG_FIRST
    s.meta_queue = Vector<Int>()
    var k = 0
    while k < globals.len() {
        ll_split_number_entity(&var s, &text, globals[k])
        k = k + 1
    }
    k = 0
    while k < defines.len() {
        ll_split_number_entity(&var s, &text, defines[k])
        k = k + 1
    }
    var read = 0
    while read < s.meta_queue.len() {
        let node = s.meta[s.meta_queue[read]]
        ll_split_number_entity(&var s, &text, node)
        read = read + 1
    }
    k = 0
    while k < tail.len() {
        ll_split_number_entity(&var s, &text, tail[k])
        k = k + 1
    }
    k = 0
    while k < LL_DEBUG_FIRST && k < s.meta.len() {
        let e = s.meta[k]
        if e >= 0 && s.held_mark[e] == s.token {
            ll_split_number_entity(&var s, &text, e)
        }
        k = k + 1
    }
    while read < s.meta_queue.len() {
        let node = s.meta[s.meta_queue[read]]
        ll_split_number_entity(&var s, &text, node)
        read = read + 1
    }
}

// Numbers what entity `e`'s text names that has no unit number yet.
func ll_split_number_entity(s: &var LlSplit, text: &String, e: Int) {
    let entity = s.entities[e]
    var k = entity.start
    if entity.kind == LlEntityKind.Meta {
        k = ll_split_number(&text, entity.start + 1, entity.stop).1
    }
    let stop = entity.stop
    while k < stop {
        let b = text.byte_at(k) as Int
        if b == LL_AT {
            let end = ll_split_symbol_end(&text, k)
            if ll_split_at(&text, k, "@.bytes.") {
                let target = s.by_symbol.get(text.substring(k, end)) ?? -1
                if target >= 0 && s.pool_mark[target] != s.token {
                    s.pool_mark[target] = s.token
                    s.pool_number[target] = s.pool_next
                    s.pool_next = s.pool_next + 1
                }
            }
            k = end
        } else if b == LL_BANG && k + 1 < stop && ll_split_digit(text.byte_at(k + 1) as Int) {
            let number = ll_split_number(&text, k + 1, stop)
            let id = number.0
            if id >= LL_DEBUG_FIRST && id < s.meta_mark.len() && s.meta_mark[id] != s.token {
                s.meta_mark[id] = s.token
                s.meta_number[id] = s.meta_next
                s.meta_next = s.meta_next + 1
                try! s.meta_queue.push(id)
            }
            k = number.1
        } else if b == LL_QUOTE {
            k = ll_split_string_end(&text, k, stop)
        } else {
            k = k + 1
        }
    }
}

// Appends `text[start..stop]` with each byte constant and metadata node it
// names under the unit's number.
func ll_split_put(out: &var StringBuilder, s: &LlSplit, text: &String, start: Int, stop: Int) {
    var from = start
    var k = start
    while k < stop {
        let b = text.byte_at(k) as Int
        if b == LL_AT {
            let end = ll_split_symbol_end(&text, k)
            if ll_split_at(&text, k, "@.bytes.") {
                let target = s.by_symbol.get(text.substring(k, end)) ?? -1
                if target >= 0 && s.pool_mark[target] == s.token {
                    try! out.append(text.substring(from, k))
                    try! out.append("@.bytes.")
                    try! out.append(s.pool_number[target])
                    from = end
                }
            }
            k = end
        } else if b == LL_BANG && k + 1 < stop && ll_split_digit(text.byte_at(k + 1) as Int) {
            let number = ll_split_number(&text, k + 1, stop)
            let id = number.0
            if id >= LL_DEBUG_FIRST && id < s.meta_mark.len() && s.meta_mark[id] == s.token {
                try! out.append(text.substring(from, k))
                try! out.append("!")
                try! out.append(s.meta_number[id])
                from = number.1
            }
            k = number.1
        } else if b == LL_QUOTE {
            k = ll_split_string_end(&text, k, stop)
        } else {
            k = k + 1
        }
    }
    try! out.append(text.substring(from, stop))
}

// The offset past the string whose opening quote is at `at`, which holds no
// quote (`ll_quoted`), or `stop`.
func ll_split_string_end(text: &String, at: Int, stop: Int) -> Int {
    var k = at + 1
    while k < stop && (text.byte_at(k) as Int) != LL_QUOTE {
        k = k + 1
    }
    if k < stop { k + 1 } else { stop }
}

// The end of an `internal ` or `private ` linkage word at `at`, or `at`
// itself when there is none there.
func ll_split_linkage_end(text: &String, at: Int) -> Int {
    if ll_split_at(&text, at, "internal ") {
        return at + 9
    }
    if ll_split_at(&text, at, "private ") {
        return at + 8
    }
    at
}

// The declaration a unit names entity `e` of another unit by: a function's
// `declare` with its definition's result, parameter types and attributes, or
// a global's `external` with its type and alignment. One that was `internal`
// or `private` is `hidden`, as its definition now is.
func ll_split_declaration(s: &LlSplit, text: &String, e: Int) -> String {
    let entity = s.entities[e]
    if entity.kind == LlEntityKind.Define {
        return ll_split_function_declaration(&text, entity.start, ll_split_line_end(&text, entity.start))
    }
    ll_split_global_declaration(&text, entity.start, ll_split_line_end(&text, entity.start), entity.symbol)
}

// The offset past the linkage and visibility words at `at`, and whether one
// of them makes the symbol hidden once it is exported.
func ll_split_skip_linkage(text: &String, at: Int) -> (Int, Bool) {
    let words = ["internal ", "private ", "hidden ", "weak ", "linkonce_odr ", "unnamed_addr ", "local_unnamed_addr "]
    var k = at
    var hidden = false
    var moved = true
    while moved {
        moved = false
        var w = 0
        while w < words.len() {
            if ll_split_at(&text, k, words[w]) {
                hidden = hidden || w <= 2
                k = k + words[w].len()
                moved = true
            }
            w = w + 1
        }
    }
    (k, hidden)
}

// `declare [hidden] RESULT @NAME(TYPES) ATTRIBUTES` for the definition whose
// head is the line `start..stop`: its parameters without their names, and
// what follows them up to a section, the subprogram or the body.
func ll_split_function_declaration(text: &String, start: Int, stop: Int) -> String {
    let skipped = ll_split_skip_linkage(&text, start + 7)
    let k = skipped.0
    var out = StringBuilder()
    try! out.append("declare ")
    if skipped.1 {
        try! out.append("hidden ")
    }
    var at = k
    while at < stop && (text.byte_at(at) as Int) != LL_AT {
        at = at + 1
    }
    let symbol_end = ll_split_symbol_end(&text, at)
    try! out.append(text.substring(k, symbol_end))
    try! out.append("(")
    var p = symbol_end + 1
    var depth = 0
    var piece = p
    var first = true
    var open = true
    while p < stop && open {
        let b = text.byte_at(p) as Int
        if b == LL_OPEN_PAREN || b == LL_OPEN_BRACKET || b == LL_OPEN_BRACE || b == LL_LESS {
            depth = depth + 1
        } else if depth > 0 && (b == LL_CLOSE_PAREN || b == LL_CLOSE_BRACKET || b == LL_CLOSE_BRACE || b == LL_GREATER) {
            depth = depth - 1
        } else if depth == 0 && (b == LL_COMMA || b == LL_CLOSE_PAREN) {
            let param = ll_split_unnamed_parameter(&text, piece, p)
            if param.len() > 0 {
                if not first {
                    try! out.append(", ")
                }
                try! out.append(param)
                first = false
            }
            piece = p + 1
            open = b != LL_CLOSE_PAREN
        }
        p = p + 1
    }
    try! out.append(")")
    var end = p
    while end < stop && not (ll_split_at(&text, end, " section ") || ll_split_at(&text, end, " !dbg ")
                              || ll_split_at(&text, end, " \{")) {
        end = end + 1
    }
    try! out.append(text.substring(p, end))
    out.build()
}

// The parameter at `start..stop` of a definition's head, trimmed and
// without its `%name`.
func ll_split_unnamed_parameter(text: &String, start: Int, stop: Int) -> String {
    var a = start
    while a < stop && (text.byte_at(a) as Int) == LL_SPACE {
        a = a + 1
    }
    var b = stop
    var k = a
    while k + 1 < stop {
        if (text.byte_at(k) as Int) == LL_SPACE && (text.byte_at(k + 1) as Int) == LL_PERCENT {
            b = k
        }
        k = k + 1
    }
    if a < stop && (text.byte_at(a) as Int) == LL_PERCENT {
        return ""
    }
    text.substring(a, b)
}

// `@NAME = external [hidden] global|constant TYPE[, align N]` for the global
// whose line is `start..stop`, named `symbol`.
func ll_split_global_declaration(text: &String, start: Int, stop: Int, symbol: String) -> String {
    let skipped = ll_split_skip_linkage(&text, start + symbol.len() + 3)
    let k = skipped.0
    var out = StringBuilder()
    try! out.append(symbol)
    try! out.append(" = external ")
    if skipped.1 {
        try! out.append("hidden ")
    }
    var kind_end = k
    if ll_split_at(&text, k, "constant ") {
        try! out.append("constant ")
        kind_end = k + 9
    } else if ll_split_at(&text, k, "global ") {
        try! out.append("global ")
        kind_end = k + 7
    }
    // The type: one token, or a bracketed aggregate.
    var t = kind_end
    var depth = 0
    var open = true
    while t < stop && open {
        let b = text.byte_at(t) as Int
        if b == LL_OPEN_BRACKET || b == LL_OPEN_BRACE || b == LL_LESS {
            depth = depth + 1
        } else if b == LL_CLOSE_BRACKET || b == LL_CLOSE_BRACE || b == LL_GREATER {
            depth = depth - 1
            open = depth > 0
        } else if depth == 0 && (b == LL_SPACE || b == LL_NEWLINE) {
            open = false
            t = t - 1
        }
        t = t + 1
    }
    try! out.append(text.substring(kind_end, t))
    // The alignment, when the line ends in one.
    var line_end = stop
    while line_end > start && (text.byte_at(line_end - 1) as Int) == LL_NEWLINE {
        line_end = line_end - 1
    }
    var a = line_end
    while a > start && ll_split_digit(text.byte_at(a - 1) as Int) {
        a = a - 1
    }
    if a < line_end && a >= start + 8 && ll_split_at(&text, a - 8, ", align ") {
        try! out.append(text.substring(a - 8, line_end))
    }
    out.build()
}
