// The emitter's primitives: SSA names, labels, entry-block slots, loads,
// stores, address arithmetic, the layout questions put to the target, and
// the two seams every function may reach: `__saw_rt_write` for output and,
// through the failure funnel, the panic sink.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawllvm.module.{LlEmitter, ll_is_scalar, ll_symbol, ll_value_type}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoProgram}
import sawresolve.program.{ResProgram}
import sawtarget.layout.{Target, TargetKind, TargetLayout}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}

// How many bytes a rendered panic message may hold, as Stage 0's stack
// scratch does (design 137).
public static LL_MESSAGE_LIMIT: Int = 508

extension LlEmitter {
    // A fresh SSA name.
    public func fresh(&var self) -> String {
        var out = StringBuilder()
        try! out.append("%t")
        try! out.append(self.temps)
        self.temps = self.temps + 1
        out.build()
    }

    // A fresh label, `word` then a number.
    public func new_label(&var self, word: String) -> String {
        var out = StringBuilder()
        try! out.append(word)
        try! out.append(".")
        try! out.append(self.labels)
        self.labels = self.labels + 1
        out.build()
    }

    public func put(&var self, text: String) {
        try! self.body.append("  ")
        try! self.body.append(text)
        try! self.body.append("\n")
    }

    public func put_label(&var self, name: String) {
        try! self.body.append(name)
        try! self.body.append(":\n")
    }

    // A fresh entry-block slot of `size` bytes at `align`; returns its name.
    public func slot(&var self, size: Int, align: Int) -> String {
        let name = self.fresh()
        try! self.allocas.append("  ")
        try! self.allocas.append(name)
        try! self.allocas.append(" = alloca [")
        try! self.allocas.append(size)
        try! self.allocas.append(" x i8], align ")
        try! self.allocas.append(align)
        try! self.allocas.append("\n")
        name
    }

    // Refuses what the function reaches that the backend slice does not
    // lower; the function is not emitted.
    public func refuse_here(&var self, mono: &var MonoProgram, node: Int, message: String) {
        if not self.refused {
            mono.refuse(node, "backend.not-yet", message)
        }
        self.refused = true
    }

    public func lay(&var self, mono: &var MonoProgram, target: &var Target, t: Int) -> TargetLayout {
        target.layout(&var mono.dp.bc.mir.tc, t)
    }

    // The layout of `t`, refused at `node` when the target cannot lay it out.
    public func lay_at(&var self, mono: &var MonoProgram, target: &var Target, t: Int, node: Int) -> TargetLayout {
        let l = target.layout(&var mono.dp.bc.mir.tc, t)
        if l.kind == TargetKind.Unsupported {
            var msg = StringBuilder()
            try! msg.append("the type `")
            try! msg.append(mono.dp.bc.mir.tc.type_text(t))
            try! msg.append("` is not in the backend slice yet: ")
            try! msg.append(target.reason_of(&l))
            self.refuse_here(&var mono, node, msg.build())
        }
        l
    }

    // Address `base` moved `offset` bytes on.
    public func offset_addr(&var self, base: String, offset: Int) -> String {
        if offset == 0 {
            return base
        }
        let name = self.fresh()
        var line = StringBuilder()
        try! line.append(name)
        try! line.append(" = getelementptr i8, ptr ")
        try! line.append(base)
        try! line.append(", i64 ")
        try! line.append(offset)
        self.put(line.build())
        name
    }

    public func load(&var self, ty: String, addr: String) -> String {
        let name = self.fresh()
        var line = StringBuilder()
        try! line.append(name)
        try! line.append(" = load ")
        try! line.append(ty)
        try! line.append(", ptr ")
        try! line.append(addr)
        self.put(line.build())
        name
    }

    public func store(&var self, ty: String, value: String, addr: String) {
        var line = StringBuilder()
        try! line.append("store ")
        try! line.append(ty)
        try! line.append(" ")
        try! line.append(value)
        try! line.append(", ptr ")
        try! line.append(addr)
        self.put(line.build())
    }

    // `name = text` as one instruction; returns `name`.
    public func assign(&var self, text: String) -> String {
        let name = self.fresh()
        var line = StringBuilder()
        try! line.append(name)
        try! line.append(" = ")
        try! line.append(text)
        self.put(line.build())
        name
    }

    public func memcpy(&var self, dest: String, src: String, size: Int) {
        if size == 0 {
            return
        }
        self.declare("llvm.memcpy.p0.p0.i64", "declare void @llvm.memcpy.p0.p0.i64(ptr, ptr, i64, i1)")
        var line = StringBuilder()
        try! line.append("call void @llvm.memcpy.p0.p0.i64(ptr ")
        try! line.append(dest)
        try! line.append(", ptr ")
        try! line.append(src)
        try! line.append(", i64 ")
        try! line.append(size)
        try! line.append(", i1 false)")
        self.put(line.build())
    }

    // The bits of a value of layout `l` from `src` to `dest`.
    public func copy_bits(&var self, l: &TargetLayout, dest: String, src: String) {
        if ll_is_scalar(&l) {
            let ty = ll_value_type(&l)
            let v = self.load(ty, src)
            self.store(ty, v, dest)
        } else if l.kind == TargetKind.Memory {
            self.memcpy(dest, src, l.size)
        }
    }

    // The type of local `j` of the function being written.
    public func local_type(&self, mono: &MonoProgram, j: Int) -> Int {
        let info = mono.dp.bc.mir.funcs[self.current]
        mono.dp.bc.mir.locals[info.local_first + j].ty
    }

    public func branch(&var self, cond: String, yes: String, no: String) {
        var line = StringBuilder()
        try! line.append("br i1 ")
        try! line.append(cond)
        try! line.append(", label %")
        try! line.append(yes)
        try! line.append(", label %")
        try! line.append(no)
        self.put(line.build())
    }

    public func jump(&var self, label: String) {
        var line = StringBuilder()
        try! line.append("br label %")
        try! line.append(label)
        self.put(line.build())
    }

    // An `i1` as a `Bool`, a byte.
    public func to_bool(&var self, bit: String) -> String {
        var widen = StringBuilder()
        try! widen.append("zext i1 ")
        try! widen.append(bit)
        try! widen.append(" to i8")
        self.assign(widen.build())
    }

    // A `Bool` byte as an `i1`.
    public func to_bit(&var self, byte: String) -> String {
        var cmp = StringBuilder()
        try! cmp.append("icmp ne i8 ")
        try! cmp.append(byte)
        try! cmp.append(", 0")
        self.assign(cmp.build())
    }

    // `len` bytes at `ptr` to standard output, through the runtime's write
    // seam.
    public func write_out(&var self, ptr: String, len: String) {
        self.declare("__saw_rt_write", "declare void @__saw_rt_write(ptr, i64)")
        var line = StringBuilder()
        try! line.append("call void @__saw_rt_write(ptr ")
        try! line.append(ptr)
        try! line.append(", i64 ")
        try! line.append(len)
        try! line.append(")")
        self.put(line.build())
    }

    // Constant bytes `bytes` to standard output.
    public func write_bytes(&var self, bytes: &Vector<Int>) {
        if bytes.len() == 0 {
            return
        }
        let g = self.pooled(&bytes, false, 0)
        var len = StringBuilder()
        try! len.append(bytes.len())
        self.write_out(g, len.build())
    }

    // `text`'s bytes.
    public func text_bytes(&self, text: String) -> Vector<Int> {
        var bytes = Vector<Int>()
        let n = text.len()
        var k = 0
        while k < n {
            try! bytes.push(text.byte_at(k) as Int)
            k = k + 1
        }
        move bytes
    }

}

// The failure funnel: every failing path the backend lowers ends in one call
// of a never-inlined `__saw_fail*` helper (`ll_fail_helpers`), handed
// the site's file and line and the operands its message names, then
// `unreachable`. The message buffer and its formatting live in the helper's
// frame, so a checked function keeps only its compare, its branch and this
// call, and stays small enough for clang to inline. A helper renders exactly
// the bytes the inline rendering did: `panic at FILE:LINE: `, the message cut
// on a UTF-8 boundary at `LL_MESSAGE_LIMIT` and marked `…`, a line break.
//
// ENTRY POINTS:
//   fail_check
//   fail_message
//   fail_value
//   fail_parts
extension LlEmitter {
    // A check whose message is its kind's reason alone: an overflow, a zero
    // divisor, a shift count, a forced payload.
    public func fail_check(&var self, mono: &var MonoProgram, node: Int, kind: Int) {
        let site = self.fail_site(&mono, node)
        var call = StringBuilder()
        try! call.append("call void @")
        try! call.append(ll_fail_symbol(kind))
        try! call.append("(")
        try! call.append(site)
        try! call.append(")")
        self.fail_call(&var mono, node, call.build())
    }

    // A constant message's bytes after the site.
    public func fail_message(&var self, mono: &var MonoProgram, node: Int, message: &Vector<Int>) {
        let site = self.fail_site(&mono, node)
        let text = self.fail_bytes(&message)
        var call = StringBuilder()
        try! call.append("call void @__saw_fail(")
        try! call.append(site)
        try! call.append(", ")
        try! call.append(text)
        try! call.append(")")
        self.fail_call(&var mono, node, call.build())
    }

    // `reason`, then integer `value` (an i64) in decimal, signed or not.
    public func fail_value(&var self, mono: &var MonoProgram, node: Int, reason: String, value: String,
                           signed: Bool) {
        let site = self.fail_site(&mono, node)
        let bytes = self.text_bytes(reason)
        let text = self.fail_bytes(&bytes)
        var call = StringBuilder()
        if signed {
            try! call.append("call void @__saw_fail_signed(")
        } else {
            try! call.append("call void @__saw_fail_unsigned(")
        }
        try! call.append(site)
        try! call.append(", ")
        try! call.append(text)
        try! call.append(", i64 ")
        try! call.append(value)
        try! call.append(")")
        self.fail_call(&var mono, node, call.build())
    }

    // `lead`, then each of `parts` rendered in order. The parts cross as a
    // table in this frame, `LL_FAIL_PART_SIZE` bytes each: the part's kind,
    // then a run's address and length, an integer, or a Bool's byte.
    public func fail_parts(&var self, mono: &var MonoProgram, node: Int, lead: String, parts: &LlParts) {
        let site = self.fail_site(&mono, node)
        let lead_bytes = self.text_bytes(lead)
        let text = self.fail_bytes(&lead_bytes)
        let count = parts.kinds.len()
        let table = self.slot(count * LL_FAIL_PART_SIZE, 8)
        var k = 0
        while k < count {
            let kind = parts.kinds[k]
            let first = parts.firsts.get(k) ?? ""
            let second = parts.seconds.get(k) ?? ""
            let at = self.offset_addr(table, k * LL_FAIL_PART_SIZE)
            var tag = StringBuilder()
            try! tag.append(kind)
            self.store("i64", tag.build(), at)
            let value_at = self.offset_addr(table, k * LL_FAIL_PART_SIZE + 8)
            if kind == LL_PART_RUN {
                self.store("ptr", first, value_at)
                let length_at = self.offset_addr(table, k * LL_FAIL_PART_SIZE + 16)
                self.store("i64", second, length_at)
            } else if kind == LL_PART_BOOL {
                self.store("i8", first, value_at)
            } else {
                self.store("i64", first, value_at)
            }
            k = k + 1
        }
        var call = StringBuilder()
        try! call.append("call void @__saw_fail_parts(")
        try! call.append(site)
        try! call.append(", ")
        try! call.append(text)
        try! call.append(", ptr ")
        try! call.append(table)
        try! call.append(", i64 ")
        try! call.append(count)
        try! call.append(")")
        self.fail_call(&var mono, node, call.build())
    }

    // The helpers end in the panic sink, so a program with none bound has no
    // helpers to call.
    func fail_call(&var self, mono: &var MonoProgram, node: Int, call: String) {
        if mono.panic_item < 0 {
            self.refuse_here(&var mono, node, "a panic with no panic sink bound")
            return
        }
        self.put(call)
        self.put("unreachable")
    }

    // The site's arguments, `ptr FILE, i64 LENGTH, i64 LINE`: the base name
    // and line `site_text` spells as `FILE:LINE`, or its whole text and line
    // -1, which the helpers render without a line, for a node with no source
    // position.
    func fail_site(&var self, mono: &MonoProgram, node: Int) -> String {
        let text = mono.site_text(node)
        let n = text.len()
        var colon = -1
        var k = 0
        while k < n {
            if (text.byte_at(k) as Int) == 58 {
                colon = k
            }
            k = k + 1
        }
        var line = -1
        if colon >= 0 && colon + 1 < n {
            line = 0
            k = colon + 1
            while k < n && line >= 0 {
                let digit = (text.byte_at(k) as Int) - 48
                if digit < 0 || digit > 9 {
                    line = -1
                } else {
                    line = line * 10 + digit
                }
                k = k + 1
            }
        }
        var file = self.text_bytes(text)
        if line >= 0 {
            var base = Vector<Int>()
            k = 0
            while k < colon {
                try! base.push(file[k])
                k = k + 1
            }
            file = move base
        }
        let spelled = self.fail_bytes(&file)
        var out = StringBuilder()
        try! out.append(spelled)
        try! out.append(", i64 ")
        try! out.append(line)
        out.build()
    }

    // Constant `bytes` as a helper's `ptr ADDRESS, i64 LENGTH` arguments.
    func fail_bytes(&var self, bytes: &Vector<Int>) -> String {
        let g = self.pooled(&bytes, false, 0)
        var out = StringBuilder()
        try! out.append("ptr ")
        try! out.append(g)
        try! out.append(", i64 ")
        try! out.append(bytes.len())
        out.build()
    }
}

// The kinds of check `fail_check` takes, each with a helper of its own whose
// message is the kind's reason, so a site passes only its file and line.
public static LL_FAIL_OVERFLOW: Int = 0
public static LL_FAIL_DIVIDE: Int = 1
public static LL_FAIL_SHIFT: Int = 2
public static LL_FAIL_UNWRAP: Int = 3
public static LL_FAIL_TRY: Int = 4
public static LL_FAIL_KINDS: Int = 5

// How many bytes one part takes in `fail_parts`' table.
public static LL_FAIL_PART_SIZE: Int = 24

// The helper `fail_check` calls for check kind `kind`.
public func ll_fail_symbol(kind: Int) -> String {
    if kind == LL_FAIL_OVERFLOW {
        return "__saw_fail_overflow"
    }
    if kind == LL_FAIL_DIVIDE {
        return "__saw_fail_divide"
    }
    if kind == LL_FAIL_SHIFT {
        return "__saw_fail_shift"
    }
    if kind == LL_FAIL_UNWRAP {
        return "__saw_fail_unwrap"
    }
    "__saw_fail_try"
}

// The reason check kind `kind` panics with, in Stage 0's wording.
public func ll_fail_reason(kind: Int) -> String {
    if kind == LL_FAIL_OVERFLOW {
        return "integer overflow"
    }
    if kind == LL_FAIL_DIVIDE {
        return "division by zero"
    }
    if kind == LL_FAIL_SHIFT {
        return "shift out of range"
    }
    if kind == LL_FAIL_UNWRAP {
        return "force unwrap of None"
    }
    "try! failed"
}

// What a message part is: a run of bytes (`first` its address, `second` its
// length), an integer widened to i64 (`first`), signed or not, or a Bool's
// byte (`first`). `__saw_fail_parts` reads the same codes.
public static LL_PART_RUN: Int = 0
public static LL_PART_SIGNED: Int = 1
public static LL_PART_UNSIGNED: Int = 2
public static LL_PART_BOOL: Int = 3

// A message's parts, in order.
public struct LlParts {
    kinds: Vector<Int>
    firsts: Vector<String>
    seconds: Vector<String>
}

extension LlParts: NoCopy {}

public func ll_parts() -> LlParts {
    LlParts(kinds: Vector<Int>(), firsts: Vector<String>(), seconds: Vector<String>())
}

public func ll_parts_push(parts: &var LlParts, kind: Int, first: String, second: String) {
    try! parts.kinds.push(kind)
    try! parts.firsts.push(first)
    try! parts.seconds.push(second)
}
