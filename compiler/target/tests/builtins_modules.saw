// The builtins funnel, one row per (target, profile): the std builtins modules
// a compile loads, the memory routines on every freestanding target and the
// 64-bit integer helpers where the word is 32 bits, and none hosted (SL-948).
import sawtarget.layout.{target_builtins_modules}

func row(triple: String, freestanding: Bool, want: String) {
    let modules = target_builtins_modules(triple, freestanding)
    var got = StringBuilder()
    var k = 0
    while k < modules.len() {
        if k > 0 {
            try! got.append(" ")
        }
        try! got.append(modules.get(k) ?? "")
        k = k + 1
    }
    let text = got.build()
    assert(text.equals(want), "{} freestanding={}: [{}] where the funnel owes [{}]", triple, freestanding, text,
           want)
}

func main() {
    row("arm64-apple-darwin", false, "")
    row("x86_64-unknown-linux-gnu", false, "")
    row("aarch64-unknown-linux-gnu", false, "")
    row("aarch64-unknown-none-elf", false, "")
    row("riscv32-unknown-none-elf", false, "")
    row("aarch64-unknown-none-elf", true, "builtins.memory")
    row("aarch64-unknown-linux-gnu", true, "builtins.memory")
    row("riscv32-unknown-none-elf", true, "builtins.memory builtins.integer")
    print("builtins modules: 8 rows")
}
