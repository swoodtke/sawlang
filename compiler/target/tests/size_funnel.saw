// The layout funnel accepts a size up to the cap on a type's size exactly:
// every type of the fixture is asserted at its size, on each LP64 and each
// ILP32 triple, and the fixture typechecks clean. No type here is built,
// emitted or run. Paths are the repository root's.
import sawasserts.layout.{asserts_typecheck_program}
import sawtarget.layout.{target_front_end}
import sawtypecheck.program.{TcProgram}

func check(triple: String, path: String) {
    let names = Vector<String>()
    let dirs = Vector<String>()
    let p = asserts_typecheck_program(path, "std", &names, &dirs, target_front_end(triple, ""))
    assert(p.diags.len() == 0, "{}: {} is refused", triple, path)
    assert(p.layout_asserts.len() >= 10, "{}: {} measures only {} types", triple, path, p.layout_asserts.len())
}

func main() {
    check("arm64-apple-darwin", "compiler/tests/target/size_edge.saw")
    check("aarch64-unknown-none-elf", "compiler/tests/target/size_edge.saw")
    check("riscv32-unknown-none-elf", "compiler/tests/target/size_edge.saw")
    check("xtensa-esp-unknown-elf", "compiler/tests/target/size_edge.saw")
    print("size edges accepted on 4 triples")
}
