// Lex-error cases, one per kind of error the lexer reports, each checked at
// its exact line:col and by the rule it names.
import src.lib.{lex}

// Assert that lexing `s` fails at exactly line:col, naming `rule`.
func expect_err(s: String, line: Int, col: Int, rule: String, why: String) {
    match lex(s) {
        case Ok(_) -> panic("expected a lex error ({why})"),
        case Err(e) -> {
            assert(e.line == line, "{why}: line {e.line} != {line} ({e.message})")
            assert(e.col == col, "{why}: col {e.col} != {col} ({e.message})")
            assert(e.rule.equals(rule), "{why}: rule {e.rule} != {rule} ({e.message})")
        }
    }
}

// Assert that lexing `s` fails with exactly `hint`.
func expect_hint(s: String, hint: String, why: String) {
    match lex(s) {
        case Ok(_) -> panic("expected a lex error ({why})"),
        case Err(e) -> assert(e.hint.equals(hint), "{why}: hint {e.hint} != {hint}")
    }
}

func main() {
    // An unterminated string is reported at its opening quote
    // (syntax.lex.unterminated-string), wherever the end of input comes.
    expect_err("\"abc", 1, 1, "syntax.lex.unterminated-string", "unterminated string")
    // An interpolation left open at the end of input holds no quote, so the
    // report stays at the opening quote.
    expect_err("\"a \{b", 1, 1, "syntax.lex.unterminated-string", "open interpolation, no quote")
    // An interpolation holding an odd number of quotes took the literal's
    // closing quote: reported at its `{`, whether or not a later quote closes
    // the literal.
    expect_err("\"a \{\"b\} c\"", 1, 4, "syntax.lex.unterminated-string", "a quote swallowed")
    expect_err("\"value \{x\"\nprint(msg)\n\}\n", 1, 8, "syntax.lex.unterminated-string",
               "a stray brace takes the closing quote")
    // SL:hazards C3: the quote after `//` is inside a comment, so it does not
    // count, and the report is at the opening quote, not at the `{`.
    expect_err("func main() \{ let s = \"a \{1 // comment: \"\n\}\n", 1, 23,
               "syntax.lex.unterminated-string", "C3")
    // A nested string inside an interpolation is two quotes, and a `//` inside
    // it is no comment.
    expect_err("\"a \{f(\"q\")\} b", 1, 1, "syntax.lex.unterminated-string", "nested string")

    // Escapes are reported at the escape's backslash (syntax.lex.escape).
    expect_err("\"\\q\"", 1, 2, "syntax.lex.escape", "unknown escape")
    expect_err("\"\\u41\"", 1, 2, "syntax.lex.escape", "backslash-u without a brace")
    expect_err("\"\\u\{41", 1, 2, "syntax.lex.escape", "unterminated Unicode escape")

    // Stray `#name`: unknown directive, anchored at the `#`.
    expect_err("#foo", 1, 1, "syntax.lex.directive", "unknown hash directive")
    // Bare `#` with no name: anchored at the `#`.
    expect_err("#", 1, 1, "syntax.lex.directive", "empty hash directive")
    // `#` followed by a non-name (space): also an empty-name error at the `#`.
    expect_err("# x", 1, 1, "syntax.lex.directive", "hash then space")

    // `$` with no digits: error just past the `$`.
    expect_err("$x", 1, 2, "parse-error", "dollar without digits")

    // Out-of-range suffixed literal: 256 does not fit u8 (anchored at the start).
    expect_err("256u8", 1, 1, "syntax.lex.int-range", "256u8 out of range")
    // A hex literal wider than 16 digits overflows a 64-bit integer.
    expect_err("0x1_0000_0000_0000_0000", 1, 1, "syntax.lex.int-range", "hex > 2**64-1")

    // Unexpected character (backtick is not in the grammar).
    var bt = StringBuilder()
    try! bt.append(Byte(96))      // `
    expect_err(bt.build(), 1, 1, "parse-error", "unexpected char")

    // A decimal literal past 2**64-1, anchored at its first digit.
    expect_err("18446744073709551616", 1, 1, "syntax.lex.int-range", "decimal > 2**64-1")
    // A base prefix with no digits after it: reported just past the prefix.
    expect_err("0x", 1, 3, "syntax.expr.int", "no digits after 0x")

    // A number's `_` stands between two digits (GRAMMAR.md §2.1), and is refused
    // where it stands: doubled (at the second), right after a base prefix, and
    // at the end of a digit run, beside the point included.
    expect_err("1__000", 1, 3, "syntax.expr.int", "doubled")
    expect_err("0b1__0", 1, 5, "syntax.expr.int", "doubled after a prefix")
    expect_err("1.0__5", 1, 5, "syntax.expr.float", "doubled in a float")
    expect_err("0x_FF", 1, 3, "syntax.expr.int", "after the base prefix")
    expect_err("1_", 1, 2, "syntax.expr.int", "trailing")
    expect_err("0xFF_", 1, 5, "syntax.expr.int", "trailing after hex digits")
    expect_err("1_000_", 1, 6, "syntax.expr.int", "trailing after a group")
    expect_err("1.0_", 1, 4, "syntax.expr.float", "trailing in a float")
    expect_err("1_.5", 1, 2, "syntax.expr.float", "beside the point")
    // One `_` may precede a width suffix; a second is doubled.
    expect_err("2__u8", 1, 3, "syntax.expr.int", "doubled before a suffix")
    // A base prefix is lowercase, reported at its letter.
    expect_err("0XFF", 1, 2, "syntax.expr.int", "uppercase hex prefix")
    expect_err("0B1", 1, 2, "syntax.expr.int", "uppercase binary prefix")
    expect_err("0O7", 1, 2, "syntax.expr.int", "uppercase octal prefix")
    // Each hint spells the number as it was meant.
    expect_hint("1__000", "write `1_000`", "doubled hint")
    expect_hint("0x_FF", "write `0xFF`", "prefix hint")
    expect_hint("1_.5", "write `1.5`", "point hint")
    expect_hint("2__u8", "write `2_u8`", "suffix hint")
    expect_hint("0XFF", "write `0xFF`", "uppercase hint")
    expect_hint("0x_", "", "no digits, no hint")

    // A number whose next character continues it wrongly is refused at that
    // character, rather than lexed as two tokens: a decimal digit outside a
    // binary or octal base, and a word spelled like a width suffix that is not
    // one of the eight, or that follows a float.
    expect_err("0b102", 1, 5, "syntax.expr.int", "a decimal digit in a binary number")
    expect_err("0o78", 1, 4, "syntax.expr.int", "a decimal digit in an octal number")
    expect_err("0b1_2", 1, 5, "syntax.expr.int", "a decimal digit after a separator")
    expect_err("0o8", 1, 3, "syntax.expr.int", "a decimal digit right after the prefix")
    expect_err("2u9", 1, 2, "syntax.expr.int", "not a width suffix")
    expect_err("2_u9", 1, 3, "syntax.expr.int", "not a width suffix after its `_`")
    expect_err("0xFFu9", 1, 5, "syntax.expr.int", "not a width suffix after hex digits")
    expect_err("1.5u8", 1, 4, "syntax.expr.float", "a float takes no suffix")
    expect_err("1.5_u8", 1, 4, "syntax.expr.float", "a float takes no suffix, nor its `_`")
    expect_hint("2u9", "a width suffix is one of `i8`, `i16`, `i32`, `i64`, `u8`, `u16`, `u32` and `u64`",
                "suffix hint")
    expect_hint("2_u9", "a width suffix is one of `i8`, `i16`, `i32`, `i64`, `u8`, `u16`, `u32` and `u64`",
                "suffix hint after its `_`")
    expect_hint("0b102", "", "no hint for a digit outside the base")
    expect_hint("1.5u8", "", "no hint for a float's suffix")

    // A float needs a digit before its point (syntax.lex.float-point), reported
    // at the point, wherever the `.` cannot be a tuple index's.
    expect_err(".5", 1, 1, "syntax.lex.float-point", "leading point")
    expect_err("let x = .25", 1, 9, "syntax.lex.float-point", "leading point after `=`")
    expect_err("f(1,\n.5)", 2, 1, "syntax.lex.float-point", "leading point after a line break")
    expect_hint("let x = .25", "write `0.25`", "leading point hint")

    print("errors: ok")
}
