// Integer / float / string / bool literal forms.
import src.lib.{LexResult, format_token, lex}

func lexed(s: String) -> LexResult {
    let result = lex(s)
    match result {
        case Ok(r) -> move r,
        case Err(e) -> panic("unexpected lex error at {e.line}:{e.col}: {e.message}")
    }
}

// The canonical dump line for token `i` (kind + position + escaped text).
func at(r: &LexResult, i: Int) -> String {
    if let t = r.tokens.get(i) {
        format_token(&t, &r.segments)
    } else {
        panic("no token at index {i}")
    }
}

func main() {
    // Decimal, hex (digit case preserved), binary, octal, underscores
    // stripped, float.
    let a = lexed("42 0xFf 0b1010 0o17 1_000 3.14")
    assert(at(&a, 0).equals("INT\t1:1\t42"), "decimal")
    assert(at(&a, 1).equals("INT\t1:4\t0xFf"), "hex: the digits keep their case")
    assert(at(&a, 2).equals("INT\t1:9\t0b1010"), "binary")
    assert(at(&a, 3).equals("INT\t1:16\t0o17"), "octal")
    assert(at(&a, 4).equals("INT\t1:21\t1000"), "underscores stripped")
    assert(at(&a, 5).equals("FLOAT\t1:27\t3.14"), "float")

    // Width-suffixed literals lex as a single INT with the digits as the value
    // and the suffix as the dump's 4th column (design 119 Part D). 255u8 is in
    // range (no error).
    let b = lexed("255u8 65535u16 1_000i32")
    assert(at(&b, 0).equals("INT\t1:1\t255\tu8"), "255u8 -> INT 255 u8")
    assert(at(&b, 1).equals("INT\t1:7\t65535\tu16"), "65535u16 -> INT 65535 u16")
    assert(at(&b, 2).equals("INT\t1:16\t1000\ti32"), "1_000i32 -> INT 1000 i32")

    // A `_` between two digits, in each digit run of a float too, and the one
    // `_` a width suffix may follow (GRAMMAR.md §2.1).
    let s = lexed("0xFF_FF 1_0.5 2_u8 0xFF_u8 1_000_i32")
    assert(at(&s, 0).equals("INT\t1:1\t0xFFFF"), "hex groups")
    assert(at(&s, 1).equals("FLOAT\t1:9\t10.5"), "a separator in a float's digit run")
    assert(at(&s, 2).equals("INT\t1:15\t2\tu8"), "one `_` before a suffix")
    assert(at(&s, 3).equals("INT\t1:20\t0xFF\tu8"), "one `_` before a suffix, in hex")
    assert(at(&s, 4).equals("INT\t1:28\t1000\ti32"), "groups, then one `_` before a suffix")

    // `5abc` stays INT + IDENT (no bogus suffix, no 4th column); `0xFace` is hex.
    let c = lexed("5abc 0xFace")
    assert(at(&c, 0).equals("INT\t1:1\t5"), "5abc: INT")
    assert(at(&c, 1).equals("IDENT\t1:2\tabc"), "5abc: IDENT")
    assert(at(&c, 2).equals("INT\t1:6\t0xFace"), "0xFace hex")

    // Only `i` or `u` and digits alone is spelled like a width suffix, so each
    // of these stays a number and a word, as a shorthand parameter's digits
    // and a spaced cast do (errors.saw has the refused spellings).
    let k = lexed("2u 2u8x 2u8_ 1.5f32 $0u8 x as u8")
    assert(at(&k, 1).equals("IDENT\t1:2\tu"), "2u: a word")
    assert(at(&k, 3).equals("IDENT\t1:5\tu8x"), "2u8x: a word")
    assert(at(&k, 5).equals("IDENT\t1:10\tu8_"), "2u8_: a word")
    assert(at(&k, 7).equals("IDENT\t1:17\tf32"), "1.5f32: a word")
    assert(at(&k, 8).equals("DOLLAR_PARAM\t1:21\t$0"), "$0u8: the parameter")
    assert(at(&k, 9).equals("IDENT\t1:23\tu8"), "$0u8: a word")
    assert(at(&k, 12).equals("IDENT\t1:31\tu8"), "a spaced cast")

    // Design 161 LOOKBACK: digits right after a member-access `.` are a TUPLE
    // INDEX — a bare integer that stops at a second `.` and takes no suffix.
    let e = lexed("t.0.name")
    assert(at(&e, 0).equals("IDENT\t1:1\tt"), "t.0.name: receiver")
    assert(at(&e, 1).equals("DOT\t1:2\t."), "t.0.name: index dot")
    assert(at(&e, 2).equals("INT\t1:3\t0"), "t.0.name: an index, not a float")
    assert(at(&e, 3).equals("DOT\t1:4\t."), "t.0.name: the member dot survives")
    assert(at(&e, 4).equals("IDENT\t1:5\tname"), "t.0.name: field")

    let f = lexed("t.0.1")
    assert(at(&f, 2).equals("INT\t1:3\t0"), "t.0.1: first hop")
    assert(at(&f, 3).equals("DOT\t1:4\t."), "t.0.1: two hops, not the float 0.1")
    assert(at(&f, 4).equals("INT\t1:5\t1"), "t.0.1: second hop")

    // A `.` before a digit is a tuple index after whatever can end an operand:
    // a closing bracket, `!` and `self` among them.
    let p = lexed("f().0 a[0].1 o!.2 self.3")
    assert(at(&p, 4).equals("INT\t1:5\t0"), "after `)`")
    assert(at(&p, 10).equals("INT\t1:12\t1"), "after `]`")
    assert(at(&p, 14).equals("INT\t1:17\t2"), "after `!`")
    assert(at(&p, 17).equals("INT\t1:24\t3"), "after `self`")

    let g = lexed("t.0u8")
    assert(at(&g, 2).equals("INT\t1:3\t0"), "a tuple index takes no width suffix")
    assert(at(&g, 3).equals("IDENT\t1:4\tu8"), "the suffix bytes stay an identifier")

    // Design 161 LOOKAHEAD: a `.` continues a number only when a DIGIT follows
    // it, so a method call on a literal lexes and `7.` is INT + DOT.
    let h = lexed("7.to_string()")
    assert(at(&h, 0).equals("INT\t1:1\t7"), "7.to_string(): the literal")
    assert(at(&h, 1).equals("DOT\t1:2\t."), "7.to_string(): member dot")
    assert(at(&h, 2).equals("IDENT\t1:3\tto_string"), "7.to_string(): method name")

    let i = lexed("7.")
    assert(at(&i, 0).equals("INT\t1:1\t7"), "trailing dot: INT")
    assert(at(&i, 1).equals("DOT\t1:2\t."), "trailing dot: DOT, never a float")

    // A separate lex: the lookback rule reads the PREVIOUS token, so a float has
    // to start a stream of its own to be judged as one (`7. 7.5` in one line
    // would make that second number an index off the first dot).
    let j = lexed("7.5.len")
    assert(at(&j, 0).equals("FLOAT\t1:1\t7.5"), "digit-dot-digit is still a float")
    assert(at(&j, 1).equals("DOT\t1:4\t."), "and the float's own member dot")
    assert(at(&j, 2).equals("IDENT\t1:5\tlen"), "method name after a float")

    // Keywords vs identifiers; true/false map to their own kinds.
    let d = lexed("func x let true false module")
    assert(at(&d, 0).equals("FUNC\t1:1\tfunc"), "func keyword")
    assert(at(&d, 1).equals("IDENT\t1:6\tx"), "ident")
    assert(at(&d, 2).equals("LET\t1:8\tlet"), "let keyword")
    assert(at(&d, 3).equals("TRUE\t1:12\ttrue"), "true")
    assert(at(&d, 4).equals("FALSE\t1:17\tfalse"), "false")
    assert(at(&d, 5).equals("IDENT\t1:23\tmodule"), "module is IDENT, not a keyword")

    // `borrow` is a keyword wherever it stands, beside the `borrows` effect.
    let w = lexed("borrow borrows borrowed")
    assert(at(&w, 0).equals("BORROW\t1:1\tborrow"), "borrow keyword")
    assert(at(&w, 1).equals("BORROWS\t1:8\tborrows"), "borrows keyword")
    assert(at(&w, 2).equals("IDENT\t1:16\tborrowed"), "a longer word is IDENT")

    print("literals: ok")
}
