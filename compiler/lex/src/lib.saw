// sawlex, the lexer stage of the self-hosted compiler. Its token kinds, token
// boundaries and 1-based line:col positions match `sawc/lexer.py`, the frozen
// compiler's lexer, except where GRAMMAR.md §2.1 and §2.7 say otherwise: a
// number's `_` and base prefix, `.5`, and where an unterminated string or a bad
// escape is reported. The golden fixtures in compiler/tests/lex pin them.
//
// It lexes over the source's UTF-8 BYTES while counting columns by Unicode code
// points (a column advances once per non-continuation byte), so token text is
// assembled from raw bytes and only a `\u{...}` escape re-encodes a scalar.
//
// See README.md for the canonical dump format and the kind-name mapping table.

// =============================================================================
// ASCII byte constants (named, per the no-magic-numbers style rule)
// =============================================================================

static B_TAB: Int = 9
static B_NL: Int = 10
static B_CR: Int = 13
static B_SPACE: Int = 32
static B_EXCLAIM: Int = 33
static B_QUOTE: Int = 34
static B_HASH: Int = 35
static B_DOLLAR: Int = 36
static B_PERCENT: Int = 37
static B_AMP: Int = 38
static B_LPAREN: Int = 40
static B_RPAREN: Int = 41
static B_STAR: Int = 42
static B_PLUS: Int = 43
static B_COMMA: Int = 44
static B_MINUS: Int = 45
static B_DOT: Int = 46
static B_SLASH: Int = 47
static B_D0: Int = 48
static B_D1: Int = 49
static B_D7: Int = 55
static B_D9: Int = 57
static B_COLON: Int = 58
static B_SEMI: Int = 59
static B_LT: Int = 60
static B_EQ: Int = 61
static B_GT: Int = 62
static B_QUESTION: Int = 63
static B_AT: Int = 64
static B_UP_A: Int = 65
static B_UP_B: Int = 66
static B_UP_F: Int = 70
static B_UP_O: Int = 79
static B_UP_X: Int = 88
static B_UP_Z: Int = 90
static B_LBRACKET: Int = 91
static B_BACKSLASH: Int = 92
static B_RBRACKET: Int = 93
static B_CARET: Int = 94
static B_UNDERSCORE: Int = 95
static B_LO_A: Int = 97
static B_LO_B: Int = 98
static B_LO_F: Int = 102
static B_LO_I: Int = 105
static B_LO_N: Int = 110
static B_LO_O: Int = 111
static B_LO_R: Int = 114
static B_LO_T: Int = 116
static B_LO_U: Int = 117
static B_LO_X: Int = 120
static B_LO_Z: Int = 122
static B_LBRACE: Int = 123
static B_PIPE: Int = 124
static B_RBRACE: Int = 125
static B_TILDE: Int = 126
static B_DEL: Int = 127
static B_CONT_LO: Int = 128
static B_CONT_HI: Int = 191
static B_ONE_TWENTY_SEVEN: Int = 127

// =============================================================================
// Byte helpers
// =============================================================================

// Unsigned byte value (0..255) at byte index `i` of `s`, or -1 past the end.
func ubyte(s: &String, i: Int) -> Int {
    if i < 0 || i >= s.len() {
        return -1
    }
    // Bytes are unsigned since design 250; only the widening to `Int` is left,
    // and that is load-bearing (`hex_value` and the scalar assembly work there).
    s.byte_at(i) as Int
}

// Turn an unsigned byte value (0..255) into the `Byte` a `StringBuilder.append`
// takes. `Byte` is built from its underlying `UInt8`, so the narrowing is
// spelled once, here.
func to_byte(u: Int) -> Byte {
    Byte(UInt8.from(truncating: u))
}

func is_digit(b: Int) -> Bool { b >= B_D0 && b <= B_D9 }

func is_alpha(b: Int) -> Bool {
    (b >= B_UP_A && b <= B_UP_Z) || (b >= B_LO_A && b <= B_LO_Z)
}

func is_alnum(b: Int) -> Bool { is_digit(b) || is_alpha(b) }

func is_hex(b: Int) -> Bool {
    is_digit(b) || (b >= B_LO_A && b <= B_LO_F) || (b >= B_UP_A && b <= B_UP_F)
}

// Value 0..15 of a hex digit byte (caller guarantees `is_hex(b)`).
func hex_value(b: Int) -> Int {
    if is_digit(b) { b - B_D0 }
    else if b >= B_LO_A && b <= B_LO_F { b - B_LO_A + 10 }
    else { b - B_UP_A + 10 }
}

// One lowercase hex digit for a nibble 0..15.
func hex_digit(n: Int) -> String { "0123456789abcdef".substring(n, n + 1) }

// A one-byte String from an unsigned byte value.
func char_str(u: Int) -> String {
    var sb = StringBuilder()
    try! sb.append(to_byte(u))
    sb.build()
}

// =============================================================================
// Token model. Payload-free, so automatically Equatable. Every case is a kind
// the lexer produces: the golden fixtures must show each one at least once, so
// a case nothing produces would fail the coverage check forever. `kind_name`
// gives each case its dump name, and `token_kinds` lists them all.
// =============================================================================

public enum TokenKind {
    case IntLit,
    case FloatLit,
    case StringLit,
    case InterpString,
    case Ident,
    case Func,
    case Let,
    case Var,
    case If,
    case Else,
    case Guard,
    case Return,
    case True_,
    case False_,
    case Struct,
    case Extension,
    case SelfKw,
    case Init,
    case NoneKw,
    case Enum,
    case Case,
    case Match,
    case While,
    case Break,
    case Continue,
    case Trait,
    case For,
    case In,
    case Extern,
    case As,
    case Try,
    case Catch,
    case Static,
    case Public,
    case Plus,
    case Minus,
    case Star,
    case Slash,
    case Percent,
    case Eq,
    case Neq,
    case Lt,
    case Gt,
    case Lte,
    case Gte,
    case And,
    case Or,
    case Ampersand,
    case Pipe,
    case Caret,
    case Tilde,
    case WrapAdd,
    case WrapSub,
    case WrapMul,
    case Not_,
    case Move_,
    case Unsafe_,
    case Borrow,
    case Borrows,
    case Lend,
    case Assign,
    case PlusAssign,
    case MinusAssign,
    case StarAssign,
    case SlashAssign,
    case PercentAssign,
    case AmpAssign,
    case PipeAssign,
    case CaretAssign,
    case ShlAssign,
    case ShrAssign,
    case Question,
    case DoubleQuestion,
    case Exclaim,
    case QuestionDot,
    case DotDot,
    case DotDotEq,
    case Ellipsis,
    case LParen,
    case RParen,
    case LBrace,
    case RBrace,
    case LBracket,
    case RBracket,
    case Comma,
    case Colon,
    case Semicolon,
    case Arrow,
    case Dot,
    case At,
    case HashDirective,
    case DollarParam,
    case Newline,
    case Eof
}

// Which half of an interpolated string one segment is (design 268).
public enum SegmentKind {
    case Text,
    case Expr
}

// One piece of an InterpString token's content — design 268's typed segment,
// and THE definition of the segment record form for this lexer. `read_string`
// is the only producer; `format_token` is the only consumer.
//
// - `Text`: `text` is the DECODED literal content of one run between
//   interpolations (escapes applied, so an escaped brace is an ordinary `{`/`}`
//   byte here). `line`/`col`/`offset` are unused (0).
// - `Expr`: `text` is the RAW source text between an interpolation's braces
//   (never escape-decoded — a parser sub-lexes it), and `line`/`col` are the
//   EXACT source position of its opening `{`, which is byte `offset` of the
//   lexed text. Blank `text` is a design-137 format placeholder.
//
// No content byte carries metadata: an in-band marker would collide with the
// same bytes written as content (SL-238).
//
// Segments live in ONE FLAT ARENA per lex (`LexResult.segments`) and a token
// names its own run with `seg_start`/`seg_count`. The arena is what keeps
// `Token` in the automatic Copy tier: an owning `Vector` field would make the
// whole token move-only, so every token read would become a borrow.
public struct StringSegment {
    public kind: SegmentKind
    public text: String
    public line: Int
    public col: Int
    public offset: Int
}

// A lexed token. `value` holds the token's canonical text (decoded, for a plain
// string; the RAW source spelling between the quotes, for an InterpString,
// whose parse input is its SEGMENTS; underscores stripped, for numbers).
// `suffix` is the fixed-width integer suffix (one of i8/i16/i32/i64/u8/u16/u32/
// u64) when the literal was written `255u8` / `0xFF_u8`; None for every
// non-suffixed token.
// `seg_start`/`seg_count` name this token's run in the lex's segment arena
// (design 268): `seg_count` is 0 on every token but an InterpString.
public struct Token {
    public kind: TokenKind
    public value: String
    public line: Int
    public col: Int
    public suffix: String?
    public seg_start: Int
    public seg_count: Int
}

// A lex error, positioned at 1-based line:col. The message is prose for the
// reader; `rule` is what a refusal is compared by. It is the §2.7 rule the
// refusal applies, the token production whose spelling it refuses
// (`syntax.expr.int`, `syntax.expr.float`) when no rule names it, and
// `parse-error` when neither does. `hint` suggests a fix, or is empty.
public struct LexError {
    public line: Int
    public col: Int
    public message: String
    public rule: String
    public hint: String
}

// A captured documentation-comment LINE (design 121). Doc comments are lexed as
// TRIVIA: they never enter the token stream (the default dump stays identical),
// they are recorded here. A `///` line is `kind = "doc"` (documents the following
// declaration); a `//!` line is `kind = "module"` (documents the enclosing
// module). `text` is the line body with the `///`/`//!` prefix (and one following
// space, if present) stripped; `line`/`col` are 1-based at the leading `/`.
public struct DocComment {
    public kind: String
    public text: String
    public line: Int
    public col: Int
}

// The full output of a lex: the token stream with each token's byte offset, the
// doc-comment trivia (design 121) and the string-segment arena (design 268). One
// entry point — `lex` — returns them together, because a token's
// `seg_start`/`seg_count` mean nothing without the arena they index into.
//
// `offsets[i]` is the byte offset of `tokens[i]`'s first byte, the position its
// `line`/`col` name, so a consumer never converts a column back into a byte:
// that walk is linear in the column, and quadratic over a long line's tokens.
// It sits beside the tokens rather than on `Token` because code outside the
// lexer constructs tokens (prototypes/minivm).
public struct LexResult {
    public tokens: Vector<Token>
    public offsets: Vector<Int>
    public docs: Vector<DocComment>
    public segments: Vector<StringSegment>
}

extension LexResult: NoCopy {}

// =============================================================================
// Keyword table. `module`, `import`, `export`, `package`, `parent` and `type`
// are not keywords: each is meaningful only in certain positions, so it lexes
// as IDENT and the parser decides (DF-232b).
// =============================================================================

func keyword_kind(s: String) -> TokenKind {
    match s {
        case "func" -> TokenKind.Func,
        case "let" -> TokenKind.Let,
        case "var" -> TokenKind.Var,
        case "if" -> TokenKind.If,
        case "else" -> TokenKind.Else,
        case "guard" -> TokenKind.Guard,
        case "return" -> TokenKind.Return,
        case "true" -> TokenKind.True_,
        case "false" -> TokenKind.False_,
        case "struct" -> TokenKind.Struct,
        case "extension" -> TokenKind.Extension,
        case "self" -> TokenKind.SelfKw,
        case "init" -> TokenKind.Init,
        case "None" -> TokenKind.NoneKw,
        case "enum" -> TokenKind.Enum,
        case "while" -> TokenKind.While,
        case "break" -> TokenKind.Break,
        case "continue" -> TokenKind.Continue,
        case "case" -> TokenKind.Case,
        case "match" -> TokenKind.Match,
        case "trait" -> TokenKind.Trait,
        case "for" -> TokenKind.For,
        case "in" -> TokenKind.In,
        case "extern" -> TokenKind.Extern,
        case "not" -> TokenKind.Not_,
        case "move" -> TokenKind.Move_,
        case "unsafe" -> TokenKind.Unsafe_,
        case "borrow" -> TokenKind.Borrow,
        case "borrows" -> TokenKind.Borrows,
        case "lend" -> TokenKind.Lend,
        case "as" -> TokenKind.As,
        case "try" -> TokenKind.Try,
        case "catch" -> TokenKind.Catch,
        case "static" -> TokenKind.Static,
        case "public" -> TokenKind.Public,
        case _ -> TokenKind.Ident
    }
}

// The dump KIND name for a kind.
public func kind_name(k: TokenKind) -> String {
    match k {
        case IntLit -> "INT",
        case FloatLit -> "FLOAT",
        case StringLit -> "STRING",
        case InterpString -> "INTERP_STRING",
        case Ident -> "IDENT",
        case Func -> "FUNC",
        case Let -> "LET",
        case Var -> "VAR",
        case If -> "IF",
        case Else -> "ELSE",
        case Guard -> "GUARD",
        case Return -> "RETURN",
        case True_ -> "TRUE",
        case False_ -> "FALSE",
        case Struct -> "STRUCT",
        case Extension -> "EXTENSION",
        case SelfKw -> "SELF",
        case Init -> "INIT",
        case NoneKw -> "NONE",
        case Enum -> "ENUM",
        case Case -> "CASE",
        case Match -> "MATCH",
        case While -> "WHILE",
        case Break -> "BREAK",
        case Continue -> "CONTINUE",
        case Trait -> "TRAIT",
        case For -> "FOR",
        case In -> "IN",
        case Extern -> "EXTERN",
        case As -> "AS",
        case Try -> "TRY",
        case Catch -> "CATCH",
        case Static -> "STATIC",
        case Public -> "PUBLIC",
        case Plus -> "PLUS",
        case Minus -> "MINUS",
        case Star -> "STAR",
        case Slash -> "SLASH",
        case Percent -> "PERCENT",
        case Eq -> "EQ",
        case Neq -> "NEQ",
        case Lt -> "LT",
        case Gt -> "GT",
        case Lte -> "LTE",
        case Gte -> "GTE",
        case And -> "AND",
        case Or -> "OR",
        case Ampersand -> "AMPERSAND",
        case Pipe -> "PIPE",
        case Caret -> "CARET",
        case Tilde -> "TILDE",
        case WrapAdd -> "WRAP_ADD",
        case WrapSub -> "WRAP_SUB",
        case WrapMul -> "WRAP_MUL",
        case Not_ -> "NOT",
        case Move_ -> "MOVE",
        case Unsafe_ -> "UNSAFE",
        case Borrow -> "BORROW",
        case Borrows -> "BORROWS",
        case Lend -> "LEND",
        case Assign -> "ASSIGN",
        case PlusAssign -> "PLUS_ASSIGN",
        case MinusAssign -> "MINUS_ASSIGN",
        case StarAssign -> "STAR_ASSIGN",
        case SlashAssign -> "SLASH_ASSIGN",
        case PercentAssign -> "PERCENT_ASSIGN",
        case AmpAssign -> "AMP_ASSIGN",
        case PipeAssign -> "PIPE_ASSIGN",
        case CaretAssign -> "CARET_ASSIGN",
        case ShlAssign -> "SHL_ASSIGN",
        case ShrAssign -> "SHR_ASSIGN",
        case Question -> "QUESTION",
        case DoubleQuestion -> "DOUBLE_QUESTION",
        case Exclaim -> "EXCLAIM",
        case QuestionDot -> "QUESTION_DOT",
        case DotDot -> "DOTDOT",
        case DotDotEq -> "DOTDOT_EQ",
        case Ellipsis -> "ELLIPSIS",
        case LParen -> "LPAREN",
        case RParen -> "RPAREN",
        case LBrace -> "LBRACE",
        case RBrace -> "RBRACE",
        case LBracket -> "LBRACKET",
        case RBracket -> "RBRACKET",
        case Comma -> "COMMA",
        case Colon -> "COLON",
        case Semicolon -> "SEMICOLON",
        case Arrow -> "ARROW",
        case Dot -> "DOT",
        case At -> "AT",
        case HashDirective -> "HASH_DIRECTIVE",
        case DollarParam -> "DOLLAR_PARAM",
        case Newline -> "NEWLINE",
        case Eof -> "EOF"
    }
}

// Every token kind, in declaration order. Saw has no enum reflection, so this
// list is written out; the test runner compares its length with the case count
// of `TokenKind` as declared, which is what keeps the two in step.
public func token_kinds() -> Vector<TokenKind> {
    [
        TokenKind.IntLit, TokenKind.FloatLit, TokenKind.StringLit, TokenKind.InterpString,
        TokenKind.Ident, TokenKind.Func, TokenKind.Let, TokenKind.Var, TokenKind.If,
        TokenKind.Else, TokenKind.Guard, TokenKind.Return, TokenKind.True_, TokenKind.False_,
        TokenKind.Struct, TokenKind.Extension, TokenKind.SelfKw, TokenKind.Init,
        TokenKind.NoneKw, TokenKind.Enum, TokenKind.Case, TokenKind.Match, TokenKind.While,
        TokenKind.Break, TokenKind.Continue, TokenKind.Trait, TokenKind.For, TokenKind.In,
        TokenKind.Extern, TokenKind.As, TokenKind.Try, TokenKind.Catch, TokenKind.Static,
        TokenKind.Public, TokenKind.Plus, TokenKind.Minus, TokenKind.Star, TokenKind.Slash,
        TokenKind.Percent, TokenKind.Eq, TokenKind.Neq, TokenKind.Lt, TokenKind.Gt,
        TokenKind.Lte, TokenKind.Gte, TokenKind.And, TokenKind.Or, TokenKind.Ampersand,
        TokenKind.Pipe, TokenKind.Caret, TokenKind.Tilde, TokenKind.WrapAdd, TokenKind.WrapSub,
        TokenKind.WrapMul, TokenKind.Not_, TokenKind.Move_, TokenKind.Unsafe_,
        TokenKind.Borrow, TokenKind.Borrows, TokenKind.Lend, TokenKind.Assign,
        TokenKind.PlusAssign,
        TokenKind.MinusAssign, TokenKind.StarAssign, TokenKind.SlashAssign,
        TokenKind.PercentAssign, TokenKind.AmpAssign, TokenKind.PipeAssign,
        TokenKind.CaretAssign, TokenKind.ShlAssign, TokenKind.ShrAssign, TokenKind.Question,
        TokenKind.DoubleQuestion, TokenKind.Exclaim, TokenKind.QuestionDot, TokenKind.DotDot,
        TokenKind.DotDotEq, TokenKind.Ellipsis, TokenKind.LParen, TokenKind.RParen,
        TokenKind.LBrace, TokenKind.RBrace, TokenKind.LBracket, TokenKind.RBracket,
        TokenKind.Comma, TokenKind.Colon, TokenKind.Semicolon, TokenKind.Arrow, TokenKind.Dot,
        TokenKind.At, TokenKind.HashDirective, TokenKind.DollarParam, TokenKind.Newline,
        TokenKind.Eof,
    ]
}

// =============================================================================
// Canonical dump formatting (shared by the CLI and the unit tests)
// =============================================================================

// Escape a token's byte payload for the one-line dump: backslash, the four named
// control escapes, NUL, and any other control byte as \xHH; every other byte
// (including raw UTF-8 >= 0x80) is emitted verbatim, so a record never holds a
// raw tab or newline. A final space is written \x20: tools that strip trailing
// whitespace (`git apply --whitespace=fix`, editors) would otherwise change a
// record that ends in this field.
public func escape_text(s: String) -> String {
    var out = StringBuilder()
    let n = s.len()
    var i = 0
    while i < n {
        let u = ubyte(&s, i)
        if u == B_BACKSLASH { try! out.append("\\\\") }
        else if u == B_NL { try! out.append("\\n") }
        else if u == B_TAB { try! out.append("\\t") }
        else if u == B_CR { try! out.append("\\r") }
        else if u == 0 { try! out.append("\\0") }
        else if u < B_SPACE || u == B_DEL || (u == B_SPACE && i == n - 1) {
            try! out.append("\\x")
            try! out.append(hex_digit(u / 16))
            try! out.append(hex_digit(u % 16))
        }
        else { try! out.append(to_byte(u)) }
        i = i + 1
    }
    out.build()
}

// One canonical segment field (design 268) for an INTERP_STRING record:
//
//   T:<escaped text>              a literal run (decoded content)
//   E:<line>:<col>:<escaped text> an interpolation (RAW text, the `{` position)
//
// `escape_text` never emits a tab or a newline, so the fields stay splittable.
public func format_segment(s: &StringSegment) -> String {
    var out = StringBuilder()
    match s.kind {
        case Text -> try! out.append("T:"),
        case Expr -> {
            try! out.append("E:")
            try! out.append(s.line)
            try! out.append(":")
            try! out.append(s.col)
            try! out.append(":")
        }
    }
    try! out.append(escape_text(s.text))
    out.build()
}

// One canonical record: KIND<TAB>line:col[<TAB>escaped-text][<TAB>suffix]. The
// suffix column is present only for a suffixed integer literal (e.g. `255u8`
// dumps `INT<TAB>1:1<TAB>255<TAB>u8`).
//
// An INTERP_STRING (design 268) instead continues with ONE FIELD PER TYPED
// SEGMENT, in source order, after the escaped text (which for that token is the
// literal's raw source spelling). No token carries both a suffix and segments,
// so the tail is unambiguous. `segments` is the arena the token's
// `seg_start`/`seg_count` index into — the `segments` of the lex it came from.
//
// No record ends in whitespace: an empty text with nothing after it is left
// out together with its tab (`EOF<TAB>6:1`).
public func format_token(t: &Token, segments: &Vector<StringSegment>) -> String {
    var tail = StringBuilder()
    if let sfx = t.suffix {
        try! tail.append("\t")
        try! tail.append(sfx)
    }
    var i = 0
    while i < t.seg_count {
        if let s = segments.get(t.seg_start + i) {
            try! tail.append("\t")
            try! tail.append(format_segment(&s))
        }
        i = i + 1
    }
    let rest = tail.build()
    let text = escape_text(t.value)
    var out = StringBuilder()
    try! out.append(kind_name(t.kind))
    try! out.append("\t")
    try! out.append(t.line)
    try! out.append(":")
    try! out.append(t.col)
    if text.len() > 0 || rest.len() > 0 {
        try! out.append("\t")
        try! out.append(text)
    }
    try! out.append(rest)
    out.build()
}

// One canonical doc-trivia record (design 121), one per captured `///`/`//!`
// line: DOC<TAB>line:col<TAB>kind[<TAB>escaped-text], where kind is `doc`
// (`///`) or `module` (`//!`). An empty body is left out with its tab, so the
// record never ends in whitespace.
public func format_doc(d: &DocComment) -> String {
    var out = StringBuilder()
    try! out.append("DOC\t")
    try! out.append(d.line)
    try! out.append(":")
    try! out.append(d.col)
    try! out.append("\t")
    try! out.append(d.kind)
    let text = escape_text(d.text)
    if text.len() > 0 {
        try! out.append("\t")
        try! out.append(text)
    }
    out.build()
}

// One canonical error record: ERROR<TAB>line:col<TAB>message<TAB>rule, then
// <TAB>hint when there is one. Every message is a literal in this file, and
// no field ends in whitespace.
public func format_error(e: &LexError) -> String {
    var out = StringBuilder()
    try! out.append("ERROR\t")
    try! out.append(e.line)
    try! out.append(":")
    try! out.append(e.col)
    try! out.append("\t")
    try! out.append(e.message)
    try! out.append("\t")
    try! out.append(e.rule)
    if e.hint.len() > 0 {
        try! out.append("\t")
        try! out.append(e.hint)
    }
    out.build()
}

// =============================================================================
// Integer-literal range checking (design 119: via the std checked parse)
// =============================================================================

// Bit width for a fixed-width suffix, or 0 if the string is not a valid suffix.
func suffix_width(s: String) -> Int {
    match s {
        case "i8" -> 8,
        case "i16" -> 16,
        case "i32" -> 32,
        case "i64" -> 64,
        case "u8" -> 8,
        case "u16" -> 16,
        case "u32" -> 32,
        case "u64" -> 64,
        case _ -> 0
    }
}

// Does the (already underscore-stripped, unsigned) digit string in `base`
// (2/8/10/16) fit in a `width`-bit field? Parses with the std checked unsigned
// parse (`String.to_uint`, design 119) — a value past 2^64-1 comes back None —
// then compares against the width's unsigned max via the integer-bound builtins.
// A literal is non-negative (unary minus is a separate token), so the legal
// range is the bit pattern 0..2^width-1.
func literal_fits(digits: String, base: Int, width: Int) -> Bool {
    if let v = digits.to_uint(base) {
        if width == 8 {
            v <= (UInt8.max as UInt)
        } else if width == 16 {
            v <= (UInt16.max as UInt)
        } else if width == 32 {
            v <= (UInt32.max as UInt)
        } else {
            true                // width 64: fitting in UInt IS the ceiling check
        }
    } else {
        false                   // overflowed 64 bits (or a non-base digit slipped in)
    }
}

// =============================================================================
// Number spellings (GRAMMAR.md §2.1)
// =============================================================================

// The base a prefix letter after `0` names, in either case, or 0 for none.
func prefix_base(b: Int) -> Int {
    if b == B_LO_X || b == B_UP_X { return 16 }
    if b == B_LO_B || b == B_UP_B { return 2 }
    if b == B_LO_O || b == B_UP_O { return 8 }
    0
}

func is_base_digit(b: Int, base: Int) -> Bool {
    if base == 16 { return is_hex(b) }
    if base == 2 { return b == B_D0 || b == B_D1 }
    if base == 8 { return b >= B_D0 && b <= B_D7 }
    is_digit(b)
}

// The length of the width suffix (`u8`, `i32`, ...) at byte `at` of `src`, or 0
// when there is none there or an identifier byte continues it.
func suffix_length_at(src: &String, at: Int) -> Int {
    let first = ubyte(&src, at)
    if first != B_LO_I && first != B_LO_U {
        return 0
    }
    var cand = StringBuilder()
    try! cand.append(to_byte(first))
    var k = at + 1
    while is_digit(ubyte(&src, k)) {
        try! cand.append(to_byte(ubyte(&src, k)))
        k = k + 1
    }
    let spelled = cand.build()
    if suffix_width(spelled) == 0 {
        return 0
    }
    let next = ubyte(&src, k)
    if is_alnum(next) || next == B_UNDERSCORE {
        return 0
    }
    k - at
}

// The length of the identifier at byte `at` of `src` when it is spelled like a
// width suffix, `i` or `u` and digits only, whether or not it is one of the
// eight; 0 otherwise. Directly after a number's digits no valid token can
// start with such a word, so the lexer names the mistake there rather than
// leaving two tokens for the parser.
func suffix_like_length_at(src: &String, at: Int) -> Int {
    let first = ubyte(&src, at)
    if first != B_LO_I && first != B_LO_U {
        return 0
    }
    var k = at + 1
    while is_digit(ubyte(&src, k)) {
        k = k + 1
    }
    let next = ubyte(&src, k)
    if k == at + 1 || is_alnum(next) || next == B_UNDERSCORE {
        return 0
    }
    k - at
}

// What a refused number literal reports: the id of the token production whose
// spelling it breaks, and a hint spelling the literal as it was meant.
struct NumberFix {
    rule: String
    hint: String
}

// The fix for the number literal whose first byte is at `at` of `src`. The
// hinted spelling lowercases the base prefix and keeps a `_` only between two
// digits or as the one `_` before a width suffix. A literal with no digit after
// its prefix gets no hint, since no spelling of it is a number.
func number_fix(src: &String, at: Int) -> NumberFix {
    var out = StringBuilder()
    var base = 10
    var i = at
    let letter = ubyte(&src, at + 1)
    if ubyte(&src, at) == B_D0 && prefix_base(letter) != 0 {
        base = prefix_base(letter)
        let prefix = if base == 16 { "0x" } else if base == 2 { "0b" } else { "0o" }
        try! out.append(prefix)
        i = at + 2
    }
    var digits = 0
    var after_digit = false
    var pending = false
    var is_float = false
    var going = true
    while going {
        let c = ubyte(&src, i)
        if is_base_digit(c, base) {
            if pending && after_digit {
                try! out.append("_")
            }
            try! out.append(to_byte(c))
            digits = digits + 1
            after_digit = true
            pending = false
            i = i + 1
        } else if c == B_UNDERSCORE {
            pending = true
            i = i + 1
        } else if c == B_DOT && base == 10 && not is_float && is_digit(ubyte(&src, i + 1)) {
            try! out.append(".")
            is_float = true
            after_digit = false
            pending = false
            i = i + 1
        } else {
            let sfx = if is_float { 0 } else { suffix_length_at(&src, i) }
            if sfx > 0 {
                if pending && after_digit {
                    try! out.append("_")
                }
                try! out.append(src.substring(i, i + sfx))
            }
            going = false
        }
    }
    let rule = if is_float { "syntax.expr.float" } else { "syntax.expr.int" }
    if digits == 0 {
        return NumberFix(rule: rule, hint: "")
    }
    var hint = StringBuilder()
    try! hint.append("write `")
    try! hint.append(out.build())
    try! hint.append("`")
    NumberFix(rule: rule, hint: hint.build())
}

// Whether a token of kind `k` can end an operand, so that a `.` and the digits
// after it are a tuple index (syntax.lex.tuple-index), not a float missing its
// leading digit (syntax.lex.float-point).
func ends_operand(k: TokenKind) -> Bool {
    match k {
        case IntLit -> true,
        case FloatLit -> true,
        case StringLit -> true,
        case InterpString -> true,
        case Ident -> true,
        case SelfKw -> true,
        case True_ -> true,
        case False_ -> true,
        case NoneKw -> true,
        case RParen -> true,
        case RBracket -> true,
        case RBrace -> true,
        case Question -> true,
        case Exclaim -> true,
        case DollarParam -> true,
        case HashDirective -> true,
        case _ -> false
    }
}

// Whether an interpolation's raw text holds an odd number of unescaped quotes
// outside comments. Such a segment can never lex, and GRAMMAR.md §2.7 reads
// its brace as having taken the literal's closing quote
// (syntax.lex.unterminated-string). Each counted quote opens or closes a
// nested string, and a `//` starts a comment only outside one, so the count is
// odd exactly when the text ends inside a string.
func odd_quotes(raw: &String) -> Bool {
    var in_string = false
    let n = raw.len()
    var i = 0
    while i < n {
        let b = ubyte(&raw, i)
        if b == B_BACKSLASH {
            i = i + 1
        } else if b == B_QUOTE {
            in_string = not in_string
        } else if not in_string && b == B_SLASH && ubyte(&raw, i + 1) == B_SLASH {
            while i < n && ubyte(&raw, i) != B_NL {
                i = i + 1
            }
        }
        i = i + 1
    }
    in_string
}

// =============================================================================
// The lexer
// =============================================================================

struct Lexer {
    src: String
    slen: Int
    pos: Int
    line: Int
    col: Int
    // Whether `src` is an interpolation's expression, lexed on its own
    // (`lex_segment`), which only the non-ASCII hint tells apart.
    segment: Bool
}

extension Lexer {
    // The byte `offset` places past `pos`, or -1 past the end.
    func peek_at(&self, offset: Int) -> Int {
        // Stage 0 workaround (SL:hazards S4): canonical: ubyte(&self.src, self.pos + offset) — an argument may not read the root a `&` argument borrows
        let at = self.pos + offset
        ubyte(&self.src, at)
    }

    func peek(&self) -> Int { self.peek_at(0) }
    func peek1(&self) -> Int { self.peek_at(1) }
    func peek2(&self) -> Int { self.peek_at(2) }

    // Consume and return the byte at `pos`, updating line/col. Column advances
    // once per code point: a UTF-8 continuation byte (0x80..0xBF) does not bump
    // the column, so a multi-byte character counts as a single column.
    func advance(&var self) -> Int {
        let b = self.peek()
        self.pos = self.pos + 1
        if b == B_NL {
            self.line = self.line + 1
            self.col = 1
        } else if b < B_CONT_LO || b > B_CONT_HI {
            self.col = self.col + 1
        }
        b
    }

    // A lex error at the current position. Every call passes its message as a
    // literal: the test runner reads them to require each in a golden fixture.
    func err(&self, msg: String, rule: String, hint: String) -> LexError {
        LexError(line: self.line, col: self.col, message: msg, rule: rule, hint: hint)
    }

    func err_at(&self, msg: String, rule: String, hint: String, l: Int, c: Int) -> LexError {
        LexError(line: l, col: c, message: msg, rule: rule, hint: hint)
    }

    // A token at the CURRENT position (used before advancing over operators).
    // Never a suffixed literal, so `suffix` is None.
    func tok(&self, kind: TokenKind, value: String) -> Token {
        Token(kind: kind, value: value, line: self.line, col: self.col, suffix: None,
              seg_start: 0, seg_count: 0)
    }

    func skip_whitespace(&var self) {
        while self.peek() == B_SPACE || self.peek() == B_TAB || self.peek() == B_CR {
            let _ = self.advance()
        }
    }

    // True if only whitespace precedes the current position on this line — the
    // comment about to be read is the first thing on its line. Doc comments are
    // recognized only at line start; a `///` trailing live code is ordinary
    // (design 121; mirrors the Python lexer's `_at_line_start`).
    func at_line_start(&self) -> Bool {
        var i = self.pos - 1
        while i >= 0 {
            let c = ubyte(&self.src, i)
            if c == B_NL { return true }
            if c != B_SPACE && c != B_TAB && c != B_CR { return false }
            i = i - 1
        }
        true
    }

    // Skip a `//` comment. A doc comment is captured into `docs` instead of being
    // discarded; the trivia vector is owned by `tokenize`'s caller so nothing about
    // the token stream changes.
    func skip_comment(&var self, docs: &var Vector<DocComment>) {
        if self.peek() == B_SLASH && self.peek1() == B_SLASH {
            // Design 121 doc-comment trivia. A line-leading `///` (exactly three
            // slashes) is a doc comment; a line-leading `//!` is a module-doc
            // comment. `////` (4+) and any comment trailing live code is ordinary.
            let third = self.peek2()
            let at_start = self.at_line_start()
            let is_doc = at_start && third == B_SLASH && self.peek_at(3) != B_SLASH
            let is_module = at_start && third == B_EXCLAIM
            if is_doc || is_module {
                let start_line = self.line
                let start_col = self.col
                self.advance3()               // consume '///' or '//!'
                if self.peek() == B_SPACE {
                    let _ = self.advance()    // strip one leading space
                }
                var text = StringBuilder()
                while self.peek() != -1 && self.peek() != B_NL {
                    try! text.append(to_byte(self.advance()))
                }
                var body = text.build()
                let last = body.len() - 1
                if last >= 0 && ubyte(&body, last) == B_CR {
                    body = body.substring(0, last)   // strip trailing CR
                }
                let kind = if is_module { "module" } else { "doc" }
                try! docs.push(DocComment(kind: kind, text: body, line: start_line, col: start_col))
                return
            }
            while self.peek() != -1 && self.peek() != B_NL {
                let _ = self.advance()
            }
        }
    }

    // Read the tail of a `\u{XXXX}` escape (the `\u` already consumed) and append
    // the scalar's UTF-8 bytes to `out`. Surrogates and values > 0x10FFFF are
    // rejected so string literals stay valid UTF-8. Every refusal is reported at
    // the escape's backslash, `l`:`c` (syntax.lex.escape).
    func read_unicode_escape(&var self, out: &var StringBuilder, l: Int, c: Int) -> Result<Void, LexError> {
        if self.peek() != B_LBRACE {
            return self.err_at("expected an opening brace after backslash-u in a Unicode escape",
                               "syntax.lex.escape", "", l, c)
        }
        let _ = self.advance()  // consume '{'
        var hex = StringBuilder()
        var count = 0
        var ok = true
        while self.peek() != -1 && self.peek() != B_RBRACE {
            let d = self.advance()
            try! hex.append(to_byte(d))
            count = count + 1
            if not is_hex(d) { ok = false }
        }
        if self.peek() != B_RBRACE {
            return self.err_at("unterminated Unicode escape", "syntax.lex.escape", "", l, c)
        }
        let _ = self.advance()  // consume '}'
        if count < 1 || count > 6 || not ok {
            return self.err_at("Unicode escape must contain 1-6 hexadecimal digits",
                               "syntax.lex.escape", "", l, c)
        }
        let hex_str = hex.build()
        var cp = 0
        var i = 0
        while i < hex_str.len() {
            cp = cp * 16 + hex_value(ubyte(&hex_str, i))
            i = i + 1
        }
        if cp > 1114111 {
            return self.err_at("Unicode escape is greater than the maximum scalar 0x10FFFF",
                               "syntax.lex.escape", "", l, c)
        }
        if cp >= 55296 && cp <= 57343 {
            return self.err_at("Unicode escape is a surrogate code point", "syntax.lex.escape", "", l, c)
        }
        // `cp` is already validated (<= 0x10FFFF, not a surrogate) above, so the
        // construction always succeeds here.
        let sc = try! Scalar(value: cp)
        let _ = out.append(sc)
        return
    }

    // Read a string literal, segmenting it at its interpolations (design 268).
    // An escaped brace decodes to an ordinary brace byte; the segments, not the
    // bytes, say which braces opened an interpolation.
    //
    // A plain string's `value` is its decoded content. An InterpString's `value`
    // is the RAW source spelling between the quotes (for diagnostics and the
    // dump) and its parse input is the SEGMENTS appended to `segments`, which the
    // returned token names by `seg_start`/`seg_count`. Adjacent literal runs are
    // merged and an EMPTY `Text` segment is never emitted, as in sawc/lexer.py.
    //
    // An unterminated string is reported at its opening quote, or at the `{` of
    // an interpolation whose text holds an odd number of quotes, since that
    // brace took the literal's closing quote (syntax.lex.unterminated-string).
    // A segment like that can never lex, so it is refused when its interpolation
    // closes, even where a later quote ends the literal.
    func read_string(&var self, segments: &var Vector<StringSegment>) -> Result<Token, LexError> {
        let start_line = self.line
        let start_col = self.col
        let _ = self.advance()  // consume opening quote
        let content_start = self.pos   // first byte after the opening quote
        let seg_start = segments.len()
        var out = StringBuilder()
        var has_interp = false
        var open_interp = false

        while self.peek() != -1 && self.peek() != B_QUOTE {
            if self.peek() == B_BACKSLASH {
                let esc_line = self.line
                let esc_col = self.col
                let _ = self.advance()
                let ch = self.advance()
                if ch == B_LO_N { try! out.append(to_byte(B_NL)) }
                else if ch == B_LO_T { try! out.append(to_byte(B_TAB)) }
                else if ch == B_LO_R { try! out.append(to_byte(B_CR)) }
                else if ch == B_D0 { try! out.append(to_byte(0)) }
                else if ch == B_QUOTE { try! out.append(to_byte(B_QUOTE)) }
                else if ch == B_BACKSLASH { try! out.append(to_byte(B_BACKSLASH)) }
                // `\{` / `\}` is just a brace: the segments, not a marker byte,
                // carry which braces opened an interpolation.
                else if ch == B_LBRACE { try! out.append(to_byte(B_LBRACE)) }
                else if ch == B_RBRACE { try! out.append(to_byte(B_RBRACE)) }
                else if ch == B_LO_U {
                    try self.read_unicode_escape(&var out, esc_line, esc_col)
                }
                else {
                    return self.err_at("unknown escape in a string literal", "syntax.lex.escape", "",
                                       esc_line, esc_col)
                }
            } else if self.peek() == B_LBRACE {
                // An unescaped `{` opens an interpolation: close the pending text
                // run and emit an `Expr` segment carrying the RAW text between the
                // braces plus the brace's exact position.
                has_interp = true
                let open_line = self.line
                let open_col = self.col
                let open_offset = self.pos
                let run = out.build()
                if run.len() > 0 {
                    try! segments.push(StringSegment(kind: SegmentKind.Text, text: run, line: 0, col: 0,
                                                     offset: 0))
                }
                out.clear()
                let _ = self.advance()  // consume the opening '{'
                var depth = 1
                var raw = StringBuilder()
                while self.peek() != -1 && depth > 0 {
                    let c = self.peek()
                    if c == B_LBRACE { depth = depth + 1 }
                    else if c == B_RBRACE { depth = depth - 1 }
                    // The outer braces are structure; only the interior is kept.
                    if depth > 0 { try! raw.append(to_byte(c)) }
                    let _ = self.advance()
                }
                let text = raw.build()
                if odd_quotes(&text) {
                    return self.err_at("unterminated string: this interpolation holds an odd number of quotes, so it took the literal's closing quote",
                                       "syntax.lex.unterminated-string",
                                       "write `\\\{` for a literal brace", open_line, open_col)
                }
                // An interpolation that runs to the end of input ends the loop.
                open_interp = depth > 0
                try! segments.push(StringSegment(kind: SegmentKind.Expr, text: text,
                                                 line: open_line, col: open_col, offset: open_offset))
            } else {
                try! out.append(to_byte(self.advance()))
            }
        }

        if self.peek() == -1 {
            let hint = if open_interp { "an interpolation in it is never closed either; write `\\\{` for a literal brace" } else { "" }
            return self.err_at("unterminated string: this quote opens a literal that is never closed",
                               "syntax.lex.unterminated-string", hint, start_line, start_col)
        }
        let content_end = self.pos   // the closing quote's byte index
        let _ = self.advance()  // consume closing quote
        if not has_interp {
            return Token(kind: TokenKind.StringLit, value: out.build(), line: start_line,
                         col: start_col, suffix: None, seg_start: seg_start, seg_count: 0)
        }
        let tail = out.build()
        if tail.len() > 0 {
            try! segments.push(StringSegment(kind: SegmentKind.Text, text: tail, line: 0, col: 0,
                                             offset: 0))
        }
        Token(kind: TokenKind.InterpString, value: self.src.substring(content_start, content_end),
              line: start_line, col: start_col, suffix: None,
              seg_start: seg_start, seg_count: segments.len() - seg_start)
    }

    // Positioned just after an integer's digits, tentatively read a fixed-width
    // suffix (e.g. `u8`), after one optional `_`. Returns the suffix and consumes
    // it, or returns None and consumes nothing when the following bytes are not
    // a clean suffix.
    func try_read_int_suffix(&var self) -> String? {
        let skip = if self.peek() == B_UNDERSCORE { 1 } else { 0 }
        let at = self.pos + skip
        let len = suffix_length_at(&self.src, at)
        if len == 0 {
            return None
        }
        let spelled = self.src.substring(at, at + len)
        var k = 0
        while k < skip + len {
            let _ = self.advance()
            k = k + 1
        }
        spelled
    }

    // A decimal digit outside `base` (2 or 8), met `ahead` bytes past `pos`
    // where a digit of the base could stand.
    func base_digit_error(&self, base: Int, ahead: Int) -> LexError {
        let l = self.line
        let c = self.col + ahead
        if base == 2 {
            return self.err_at("not a binary digit: a binary number's digits are `0` and `1`",
                               "syntax.expr.int", "", l, c)
        }
        self.err_at("not an octal digit: an octal number's digits are `0` to `7`", "syntax.expr.int", "", l, c)
    }

    // A word spelled like a width suffix that is not one of the eight, `ahead`
    // bytes past `pos`, directly after an integer's digits or its one `_`.
    func suffix_error(&self, ahead: Int) -> LexError {
        let l = self.line
        let c = self.col + ahead
        self.err_at("not a width suffix", "syntax.expr.int",
                    "a width suffix is one of `i8`, `i16`, `i32`, `i64`, `u8`, `u16`, `u32` and `u64`", l, c)
    }

    // A suffix, or a word spelled like one, directly after a float's digits.
    func float_suffix_error(&self) -> LexError {
        let l = self.line
        let c = self.col
        self.err_at("a float takes no suffix", "syntax.expr.float", "", l, c)
    }

    // Read `DIGIT ( "_"? DIGIT )*` in `base` (GRAMMAR.md §2.1), appending the
    // digits to `digits` without their separators; the first digit is at `pos`.
    // A `_` stands between two digits, or, when `suffix_ok`, is the one `_` a
    // width suffix may follow, which is left for `try_read_int_suffix`. Any
    // other `_` is refused where it stands; `start` is the number's first byte.
    // `suffix_ok` is false only in a float's fraction, so a suffix there is a
    // float's.
    func read_digit_run(&var self, base: Int, suffix_ok: Bool, digits: &var StringBuilder,
                        start: Int) -> Result<Void, LexError> {
        var going = true
        while going {
            let c = self.peek()
            if is_base_digit(c, base) {
                try! digits.append(to_byte(self.advance()))
            } else if is_digit(c) {
                return self.base_digit_error(base, 0)
            } else if c == B_UNDERSCORE {
                let next = self.peek1()
                let after = self.pos + 1
                if is_base_digit(next, base) {
                    let _ = self.advance()
                } else if is_digit(next) {
                    return self.base_digit_error(base, 1)
                } else if suffix_ok && suffix_length_at(&self.src, after) > 0 {
                    going = false
                } else if suffix_like_length_at(&self.src, after) > 0 {
                    if suffix_ok {
                        return self.suffix_error(1)
                    }
                    return self.float_suffix_error()
                } else {
                    let fix = number_fix(&self.src, start)
                    let l = self.line
                    let col = self.col
                    if next == B_UNDERSCORE {
                        return self.err_at("a `_` in a number separates two digits, and this one doubles another",
                                           fix.rule, fix.hint, l, col + 1)
                    }
                    return self.err_at("a `_` in a number separates two digits, so it cannot end a run of digits",
                                       fix.rule, fix.hint, l, col)
                }
            } else {
                going = false
            }
        }
        return
    }

    // `tuple_index` is design 161's one-token LOOKBACK: the caller passes true when
    // the previously emitted token is a member-access `.`, which makes this literal
    // a TUPLE INDEX — a bare decimal integer that takes no second `.`, no base
    // prefix and no width suffix. So `t.0.name` projects off element 0 and `t.0.1`
    // is two index hops rather than the float `0.1`.
    func read_number(&var self, tuple_index: Bool) -> Result<Token, LexError> {
        let start_line = self.line
        let start_col = self.col
        let start = self.pos

        if tuple_index {
            var digits = StringBuilder()
            while is_digit(self.peek()) {
                try! digits.append(to_byte(self.advance()))
            }
            let index_str = digits.build()
            if not literal_fits(index_str, 10, 64) {
                return self.err_at("integer literal out of range for a 64-bit integer", "syntax.lex.int-range", "",
                                   start_line, start_col)
            }
            return Token(kind: TokenKind.IntLit, value: index_str, line: start_line, col: start_col, suffix: None,
                         seg_start: 0, seg_count: 0)
        }

        let n = self.peek1()
        let base = if self.peek() == B_D0 { prefix_base(n) } else { 0 }

        // Based integer literals: 0x / 0b / 0o, the prefix lowercase only.
        if base != 0 {
            if n == B_UP_X || n == B_UP_B || n == B_UP_O {
                let fix = number_fix(&self.src, start)
                return self.err_at("a base prefix is lowercase: `0x`, `0b` or `0o`", fix.rule, fix.hint,
                                   start_line, start_col + 1)
            }
            let prefix_str = if base == 16 { "x" } else if base == 2 { "b" } else { "o" }
            let _ = self.advance()  // '0'
            let _ = self.advance()  // base char
            if self.peek() == B_UNDERSCORE {
                let fix = number_fix(&self.src, start)
                return self.err("a `_` in a number separates two digits, so it cannot follow the base prefix",
                                fix.rule, fix.hint)
            }
            let first = self.peek()
            if is_digit(first) && not is_base_digit(first, base) {
                return self.base_digit_error(base, 0)
            }
            if not is_base_digit(first, base) {
                return self.err("integer literal has no digits after the base prefix", "syntax.expr.int", "")
            }
            var digits = StringBuilder()
            try self.read_digit_run(base, true, &var digits, start)
            let digit_str = digits.build()
            let suffix = self.try_read_int_suffix()
            if let sfx = suffix {
                if not literal_fits(digit_str, base, suffix_width(sfx)) {
                    return self.err_at("integer literal out of range for its suffix", "syntax.lex.int-range", "",
                                       start_line, start_col)
                }
            } else {
                let at = self.pos
                if suffix_like_length_at(&self.src, at) > 0 {
                    return self.suffix_error(0)
                }
                if not literal_fits(digit_str, base, 64) {
                    return self.err_at("integer literal out of range for a 64-bit integer", "syntax.lex.int-range",
                                       "", start_line, start_col)
                }
            }
            var vb = StringBuilder()
            try! vb.append("0")
            try! vb.append(prefix_str)
            try! vb.append(digit_str)
            return Token(kind: TokenKind.IntLit, value: vb.build(), line: start_line, col: start_col, suffix: suffix,
                         seg_start: 0, seg_count: 0)
        }

        // Decimal integer or float. Design 161, the LOOKAHEAD rule: a `.`
        // continues the float only when a DIGIT follows it. Anything else ends the
        // number and leaves the dot to be lexed on its own — a member access
        // (`7.to_string()`), a range operator (`1..=9`), or a trailing dot (`7.`,
        // which the parser then reports as a missing field name). A second dot
        // ends it too.
        var val = StringBuilder()
        try self.read_digit_run(10, true, &var val, start)
        if self.peek() == B_DOT && is_digit(self.peek1()) {
            try! val.append(to_byte(self.advance()))
            try self.read_digit_run(10, false, &var val, start)
            let at = self.pos
            if suffix_like_length_at(&self.src, at) > 0 {
                return self.float_suffix_error()
            }
            return Token(kind: TokenKind.FloatLit, value: val.build(), line: start_line, col: start_col,
                         suffix: None, seg_start: 0, seg_count: 0)
        }
        let value = val.build()
        let suffix = self.try_read_int_suffix()
        if let sfx = suffix {
            if not literal_fits(value, 10, suffix_width(sfx)) {
                return self.err_at("integer literal out of range for its suffix", "syntax.lex.int-range", "",
                                   start_line, start_col)
            }
        } else {
            let at = self.pos
            if suffix_like_length_at(&self.src, at) > 0 {
                return self.suffix_error(0)
            }
            if not literal_fits(value, 10, 64) {
                return self.err_at("integer literal out of range for a 64-bit integer", "syntax.lex.int-range", "",
                                   start_line, start_col)
            }
        }
        Token(kind: TokenKind.IntLit, value: value, line: start_line, col: start_col, suffix: suffix,
              seg_start: 0, seg_count: 0)
    }

    func read_hash_directive(&var self) -> Result<Token, LexError> {
        let start_line = self.line
        let start_col = self.col
        let _ = self.advance()  // consume '#'
        var name = StringBuilder()
        while is_alnum(self.peek()) || self.peek() == B_UNDERSCORE {
            try! name.append(to_byte(self.advance()))
        }
        let name_str = name.build()
        if name_str.is_empty() {
            return self.err_at("expected a directive name after `#`", "syntax.lex.directive", "",
                               start_line, start_col)
        }
        // `#file`/`#line`/`#function` (design 98) plus `#lend_var` (design 179).
        let known = (name_str.equals("file") || name_str.equals("line")
                     || name_str.equals("function") || name_str.equals("lend_var"))
        if not known {
            return self.err_at("unknown directive after `#`", "syntax.lex.directive", "", start_line, start_col)
        }
        Token(kind: TokenKind.HashDirective, value: name_str, line: start_line, col: start_col, suffix: None,
              seg_start: 0, seg_count: 0)
    }

    func read_identifier(&var self) -> Token {
        let start_line = self.line
        let start_col = self.col
        var sb = StringBuilder()
        while is_alnum(self.peek()) || self.peek() == B_UNDERSCORE {
            try! sb.append(to_byte(self.advance()))
        }
        let value = sb.build()
        Token(kind: keyword_kind(value), value: value, line: start_line, col: start_col, suffix: None,
              seg_start: 0, seg_count: 0)
    }

    func read_dollar(&var self) -> Result<Token, LexError> {
        let start_line = self.line
        let start_col = self.col
        let _ = self.advance()  // consume '$'
        if not is_digit(self.peek()) {
            return self.err("Expected number after `$` for shorthand closure parameter", "parse-error", "")
        }
        var num = StringBuilder()
        try! num.append(to_byte(B_DOLLAR))
        while is_digit(self.peek()) {
            try! num.append(to_byte(self.advance()))
        }
        Token(kind: TokenKind.DollarParam, value: num.build(), line: start_line, col: start_col, suffix: None,
              seg_start: 0, seg_count: 0)
    }

    // Run the lexer to EOF. Doc-comment trivia is appended to `docs` (design 121),
    // every interpolated string's typed segments to `segments` (design 268), and
    // each token's byte offset to `offsets`, index for index with the result.
    func tokenize(&var self, docs: &var Vector<DocComment>, segments: &var Vector<StringSegment>,
                  offsets: &var Vector<Int>) -> Result<Vector<Token>, LexError> {
        var tokens = Vector<Token>()
        while self.pos < self.slen {
            self.skip_whitespace()
            self.skip_comment(&var docs)
            if self.pos >= self.slen {
                break
            }
            let ch = self.peek()
            // Each branch below emits at most one token, and it starts here;
            // the lexer's unit program `offsets` holds every kind to that.
            let at = self.pos

            if ch == B_NL {
                try! tokens.push(self.tok(TokenKind.Newline, "\n"))
                let _ = self.advance()
            } else if ch == B_QUOTE {
                let string_token = try self.read_string(&var segments)
                try! tokens.push(string_token)
            } else if is_digit(ch) {
                // Design 161: one-token lookback. Digits right after a member-access
                // `.` are a tuple index, not the start of a float.
                let after_dot = tokens.len() > 0 && tokens[tokens.len() - 1].kind == TokenKind.Dot
                let number_token = try self.read_number(after_dot)
                try! tokens.push(number_token)
            } else if is_alpha(ch) || ch == B_UNDERSCORE {
                try! tokens.push(self.read_identifier())
            } else if ch == B_PLUS {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.PlusAssign, "+="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Plus, "+"))
                    let _ = self.advance()
                }
            } else if ch == B_MINUS {
                if self.peek1() == B_GT {
                    try! tokens.push(self.tok(TokenKind.Arrow, "->"))
                    self.advance2()
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.MinusAssign, "-="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Minus, "-"))
                    let _ = self.advance()
                }
            } else if ch == B_STAR {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.StarAssign, "*="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Star, "*"))
                    let _ = self.advance()
                }
            } else if ch == B_SLASH {
                if self.peek1() == B_SLASH {
                    self.skip_comment(&var docs)
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.SlashAssign, "/="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Slash, "/"))
                    let _ = self.advance()
                }
            } else if ch == B_PERCENT {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.PercentAssign, "%="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Percent, "%"))
                    let _ = self.advance()
                }
            } else if ch == B_AMP {
                if self.peek1() == B_AMP {
                    try! tokens.push(self.tok(TokenKind.And, "&&"))
                    self.advance2()
                } else if self.peek1() == B_PLUS {
                    try! tokens.push(self.tok(TokenKind.WrapAdd, "&+"))
                    self.advance2()
                } else if self.peek1() == B_MINUS {
                    try! tokens.push(self.tok(TokenKind.WrapSub, "&-"))
                    self.advance2()
                } else if self.peek1() == B_STAR {
                    try! tokens.push(self.tok(TokenKind.WrapMul, "&*"))
                    self.advance2()
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.AmpAssign, "&="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Ampersand, "&"))
                    let _ = self.advance()
                }
            } else if ch == B_PIPE {
                if self.peek1() == B_PIPE {
                    try! tokens.push(self.tok(TokenKind.Or, "||"))
                    self.advance2()
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.PipeAssign, "|="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Pipe, "|"))
                    let _ = self.advance()
                }
            } else if ch == B_CARET {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.CaretAssign, "^="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Caret, "^"))
                    let _ = self.advance()
                }
            } else if ch == B_TILDE {
                try! tokens.push(self.tok(TokenKind.Tilde, "~"))
                let _ = self.advance()
            } else if ch == B_EQ {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.Eq, "=="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Assign, "="))
                    let _ = self.advance()
                }
            } else if ch == B_EXCLAIM {
                if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.Neq, "!="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Exclaim, "!"))
                    let _ = self.advance()
                }
            } else if ch == B_QUESTION {
                if self.peek1() == B_QUESTION {
                    try! tokens.push(self.tok(TokenKind.DoubleQuestion, "??"))
                    self.advance2()
                } else if self.peek1() == B_DOT {
                    try! tokens.push(self.tok(TokenKind.QuestionDot, "?."))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Question, "?"))
                    let _ = self.advance()
                }
            } else if ch == B_LT {
                if self.peek1() == B_LT && self.peek2() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.ShlAssign, "<<="))
                    self.advance3()
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.Lte, "<="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Lt, "<"))
                    let _ = self.advance()
                }
            } else if ch == B_GT {
                if self.peek1() == B_GT && self.peek2() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.ShrAssign, ">>="))
                    self.advance3()
                } else if self.peek1() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.Gte, ">="))
                    self.advance2()
                } else {
                    try! tokens.push(self.tok(TokenKind.Gt, ">"))
                    let _ = self.advance()
                }
            } else if ch == B_LPAREN {
                try! tokens.push(self.tok(TokenKind.LParen, "("))
                let _ = self.advance()
            } else if ch == B_RPAREN {
                try! tokens.push(self.tok(TokenKind.RParen, ")"))
                let _ = self.advance()
            } else if ch == B_LBRACE {
                try! tokens.push(self.tok(TokenKind.LBrace, char_str(B_LBRACE)))
                let _ = self.advance()
            } else if ch == B_RBRACE {
                try! tokens.push(self.tok(TokenKind.RBrace, char_str(B_RBRACE)))
                let _ = self.advance()
            } else if ch == B_LBRACKET {
                try! tokens.push(self.tok(TokenKind.LBracket, "["))
                let _ = self.advance()
            } else if ch == B_RBRACKET {
                try! tokens.push(self.tok(TokenKind.RBracket, "]"))
                let _ = self.advance()
            } else if ch == B_SEMI {
                try! tokens.push(self.tok(TokenKind.Semicolon, ";"))
                let _ = self.advance()
            } else if ch == B_COMMA {
                try! tokens.push(self.tok(TokenKind.Comma, ","))
                let _ = self.advance()
            } else if ch == B_COLON {
                try! tokens.push(self.tok(TokenKind.Colon, ":"))
                let _ = self.advance()
            } else if ch == B_DOT {
                if self.peek1() == B_DOT && self.peek2() == B_DOT {
                    try! tokens.push(self.tok(TokenKind.Ellipsis, "..."))
                    self.advance3()
                } else if self.peek1() == B_DOT && self.peek2() == B_EQ {
                    try! tokens.push(self.tok(TokenKind.DotDotEq, "..="))
                    self.advance3()
                } else if self.peek1() == B_DOT {
                    try! tokens.push(self.tok(TokenKind.DotDot, ".."))
                    self.advance2()
                } else {
                    // A `.` before a digit is a tuple index after an operand, and
                    // otherwise a float with no digit before its point.
                    if is_digit(self.peek1()) {
                        let last = tokens.len() - 1
                        if last < 0 || not ends_operand(tokens[last].kind) {
                            let hint = self.leading_point_hint()
                            return self.err("a float needs a digit before its point",
                                            "syntax.lex.float-point", hint)
                        }
                    }
                    try! tokens.push(self.tok(TokenKind.Dot, "."))
                    let _ = self.advance()
                }
            } else if ch == B_AT {
                try! tokens.push(self.tok(TokenKind.At, "@"))
                let _ = self.advance()
            } else if ch == B_HASH {
                let directive_token = try self.read_hash_directive()
                try! tokens.push(directive_token)
            } else if ch == B_DOLLAR {
                let dollar_token = try self.read_dollar()
                try! tokens.push(dollar_token)
            } else if ch >= B_CONT_LO {
                // Stage 0 workaround (SL:hazards S4): canonical: return self.err("…", "syntax.lex.ascii-identifier", self.non_ascii_hint())
                let hint = self.non_ascii_hint()
                return self.err("a character outside ASCII stands only in the text of a string or a comment",
                                "syntax.lex.ascii-identifier", hint)
            } else {
                return self.err("Unexpected character", "parse-error", "")
            }
            if offsets.len() < tokens.len() {
                try! offsets.push(at)
            }
        }
        try! tokens.push(self.tok(TokenKind.Eof, ""))
        try! offsets.push(self.pos)
        move tokens
    }

    // The hint for a character outside ASCII at `pos`, naming it: its UTF-8
    // lead byte says how many bytes it spans. In a segment it adds why the
    // string around the character does not make it text
    // (syntax.lex.ascii-identifier).
    func non_ascii_hint(&self) -> String {
        let lead = self.peek()
        var width = 1
        if lead >= 0xF0 {
            width = 4
        } else if lead >= 0xE0 {
            width = 3
        } else if lead >= 0xC0 {
            width = 2
        }
        let start = self.pos
        var end = start + width
        if end > self.slen {
            end = self.slen
        }
        // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.src.substring(self.pos, end))
        let spelled = self.src.substring(start, end)
        var out = StringBuilder()
        try! out.append("`")
        try! out.append(spelled)
        try! out.append("` is not ASCII, and source outside strings and comments is")
        if self.segment {
            try! out.append("; an interpolation's expression is source")
        }
        out.build()
    }

    // The hint for a float written with no digit before its point, `pos` at the
    // point: the same digits after a leading `0`.
    func leading_point_hint(&self) -> String {
        var out = StringBuilder()
        try! out.append("write `0.")
        var k = 1
        while is_digit(self.peek_at(k)) || self.peek_at(k) == B_UNDERSCORE {
            try! out.append(to_byte(self.peek_at(k)))
            k = k + 1
        }
        try! out.append("`")
        out.build()
    }

    func advance2(&var self) {
        let _ = self.advance()
        let _ = self.advance()
    }

    func advance3(&var self) {
        let _ = self.advance()
        let _ = self.advance()
        let _ = self.advance()
    }
}

// Tokenize `source`, or return the first lex error. Mirrors sawc/lexer.py's
// observable output: the token stream (terminated by an EOF token), the
// doc-comment trivia (design 121) and the string-segment arena (design 268),
// which is why no entry point has a tokens-only twin: a token's
// `seg_start`/`seg_count` index into that arena.
public func lex(source: String) -> Result<LexResult, LexError> {
    lex_as(source, false)
}

// Tokenize an interpolation's expression, lexed on its own, as `lex` does a
// file. Its positions are the segment's own.
public func lex_segment(source: String) -> Result<LexResult, LexError> {
    lex_as(source, true)
}

func lex_as(source: String, segment: Bool) -> Result<LexResult, LexError> {
    var lexer = Lexer(src: source, slen: source.len(), pos: 0, line: 1, col: 1, segment: segment)
    var docs = Vector<DocComment>()
    var segments = Vector<StringSegment>()
    var offsets = Vector<Int>()
    let toks = try lexer.tokenize(&var docs, &var segments, &var offsets)
    LexResult(tokens: move toks, offsets: move offsets, docs: move docs, segments: move segments)
}
