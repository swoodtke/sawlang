// Diagnostics and recovery: one run reports every independent error, a named
// rule reports its name, and a refusal unit parses statements and items alike.
import sawparse.src.api.{ParseOptions, parse_record, parse_source}
import sawparse.src.diag.{diagnostic_id}
import sawparse.src.parser.{Parser}

func ids(parser: &Parser) -> String {
    var out = StringBuilder()
    var k = 0
    while k < parser.diagnostics.len() {
        if k > 0 {
            try! out.append(" ")
        }
        let d = parser.diagnostics[k]
        try! out.append(diagnostic_id(&d))
        k = k + 1
    }
    out.build()
}

func expect_ids(text: String, unit: Bool, want: String) {
    let parser = parse_source("t.saw", text, unit)
    let got = ids(&parser)
    assert(got.equals(want), "diagnostics: {}", got)
}

// The `ERROR` records `sawc2 parse` prints for `text`: rule, position,
// message and hint.
func expect_record(text: String, want: String) {
    var out = StringBuilder()
    let options = ParseOptions(unit: false, dump: false, alternatives: false)
    let _ = parse_record(out: &var out, path: "t.saw", text: text, options: &options)
    let got = out.build()
    assert(got.equals(want), "diagnostic records: {}", got)
}

func main() {
    expect_ids("func f() \{\n    let a = 1\n\}\n", false, "")
    // Two statements that fail on their own lines are two diagnostics, and the
    // statement between them still parses.
    expect_ids("func f() \{\n    let = 1\n    let b = 2\n    let c = -\n\}\n", false,
               "parse-error parse-error")
    // An unclosed bracket is reported at its opener before anything the parse
    // meets on the way to it (syntax.lex.unclosed-bracket).
    expect_ids("func f() \{\n    let = 1\n    let c = (\n\}\n", false,
               "syntax.lex.unclosed-bracket parse-error parse-error")
    expect_ids("func a() \{\n    let x = 1\n\nfunc b() \{\n\}\n", false,
               "syntax.lex.unclosed-bracket parse-error")
    // A statement after a juxtaposition is skipped to its line's end.
    expect_ids("func f() \{\n    let a = 1 b\n    let c = 2\n\}\n", false,
               "syntax.rule.juxtaposition")
    // A named rule refuses by name.
    expect_ids("func f() \{\n    var _ = 1\n\}\n", false, "syntax.stmt.refused-var-discard")
    expect_ids("import m.\{a, b as a\}\n", false, "syntax.rule.import-names")
    expect_ids("func f() consumes \{\n\}\n", false, "syntax.rule.effect-slot")
    expect_ids("func f() \{\n\}\n/// orphaned\n", false, "syntax.lex.doc-attach")
    expect_ids("func f() \{\n\}\n//! late\n", false, "syntax.lex.module-doc")
    // A second run before a declaration an earlier run documents says so, and
    // names that run; a run that documents nothing, a test case's included,
    // says that instead.
    let second = "ERROR\tsyntax.lex.doc-attach\t3:1\tthis declaration already has a doc comment, at 1:1; a declaration takes one\tjoin the two runs, or make one a `//` comment\n"
    expect_record("/// one\n@test\n/// two\nfunc f() \{\n\}\n", second)
    expect_record("/// one\n\n/// two\nfunc f() \{\n\}\n", second)
    expect_record("/// one\n// plain\n/// two\nfunc f() \{\n\}\n", second)
    expect_record("func f() \{\n\}\n/// orphaned\n",
                  "ERROR\tsyntax.lex.doc-attach\t3:1\tthis doc comment documents no declaration\tmake it a `//` comment, or move it before a declaration\n")
    expect_record("/// a case\n@test \"adds\" \{\n\}\n",
                  "ERROR\tsyntax.lex.doc-attach\t1:1\tthis doc comment documents no declaration\tmake it a `//` comment, or move it before a declaration\n")
    // A run after an attribute of its declaration says it belongs above the
    // attributes; a local's attribute is no declaration's, so there the plain
    // message stands.
    expect_record("@synthesize\n/// two\nextension P: Equatable \{\}\n",
                  "ERROR\tsyntax.lex.doc-attach\t2:1\tthis doc comment documents no declaration: it stands after the declaration's attributes\tmove it above the attributes\n")
    expect_record("/// one\n@test\n/// two\n@export(\"f\")\n/// three\nfunc f() \{\}\n",
                  "ERROR\tsyntax.lex.doc-attach\t3:1\tthis declaration already has a doc comment, at 1:1; a declaration takes one\tjoin the two runs, or make one a `//` comment\nERROR\tsyntax.lex.doc-attach\t5:1\tthis doc comment documents no declaration: it stands after the declaration's attributes\tmove it above the attributes\n")
    expect_record("extension S \{\n    @synthesize(shared)\n    /// d\n    func f(&self) \{\n    \}\n\}\n",
                  "ERROR\tsyntax.lex.doc-attach\t3:5\tthis doc comment documents no declaration: it stands after the declaration's attributes\tmove it above the attributes\n")
    expect_record("func f() \{\n    @align(8)\n    /// d\n    var b = 1\n\}\n",
                  "ERROR\tsyntax.lex.doc-attach\t3:5\tthis doc comment documents no declaration\tmake it a `//` comment, or move it before a declaration\n")
    // A `{` after a complete `if` or loop on its line is refused alike, as a
    // trailing closure, and as the head restriction where a head could take it.
    expect_ids("func f() \{\n    if borrow let e = m[k] \{ e.ok \} \{ \}\n\}\n", false,
               "syntax.rule.trailing-closure")
    expect_ids("func f() \{\n    while borrow let e = m[k] \{ e.ok \} \{ \}\n\}\n", false,
               "syntax.rule.trailing-closure")
    expect_ids("func f() \{\n    for borrow let e in m \{ e.ok \} \{ \}\n\}\n", false,
               "syntax.rule.head-restriction")
    expect_ids("func f() \{\n    while c \{ e.ok \} \{ \}\n\}\n", false,
               "syntax.rule.head-restriction")
    // A lex error is the whole parse's one diagnostic, named by its lexical
    // rule when one names it.
    expect_ids("func f() \{\n    let s = \"open\n\}\n", false, "syntax.lex.unterminated-string")
    expect_ids("func f() \{\n    let x = 0XFF\n\}\n", false, "parse-error")
    // `7.` is refused where the parser sees what follows the point.
    expect_ids("func f() \{\n    let x = 7.\n\}\n", false, "syntax.lex.float-point")
    // A refusal unit takes statements and declarations, separated as statements are.
    expect_ids("func g() \{\n\}; let x = 1\n", true, "")
    expect_ids("let x = 1;\n", true, "syntax.rule.statement-separator")
}
