public static ALT_COUNT: Int = 577

// The alternative's stable name.
public func alt_name(alt: Alt) -> String {
    match alt {
        case File_Source -> "syntax.file.source",
        case File_List -> "syntax.file.list",
        case File_Item_Import -> "syntax.file.item.import",
        case File_Item_Module -> "syntax.file.item.module",
        case File_Item_StaticAssert -> "syntax.file.item.static-assert",
        case File_Item_Declaration -> "syntax.file.item.declaration",
        case File_Item_Test -> "syntax.file.item.test",
        case File_Item_RefusedExport -> "syntax.file.item.refused-export",
        case File_Item_RefusedConst -> "syntax.file.item.refused-const",
