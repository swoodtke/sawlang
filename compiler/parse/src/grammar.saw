        case Rule_RequirementBorrows -> "syntax.rule.requirement-borrows",
        case Rule_ReferencePosition -> "syntax.rule.reference-position",
        case Rule_DiscardBinding -> "syntax.rule.discard-binding",
        case Rule_TryRouteCase -> "syntax.rule.try-route-case",
        case Rule_ImportNames -> "syntax.rule.import-names",
        case Rule_InterpolationWhole -> "syntax.rule.interpolation-whole",
        case Lex_LongestMatch -> "syntax.lex.longest-match",
