        case Rule_ReceiverAndStatic -> "syntax.rule.receiver-and-static",
        case Rule_ExternAbi -> "syntax.rule.extern-abi",
        case Rule_ModuleInline -> "syntax.rule.module-inline",
        case Rule_TryBlock -> "syntax.rule.try-block",
        case Rule_TestForm -> "syntax.rule.test-form",
