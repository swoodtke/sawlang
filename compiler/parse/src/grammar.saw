// The Kind of the node the alternative builds, suffixed as GRAMMAR.md section 1
// says, or the empty string for a production that builds none.
public func alt_kind(alt: Alt) -> String {
    match alt {
        case File_Source -> "File",
        case File_List -> "",
        case File_Item_Import -> "",
        case File_Item_Module -> "",
        case File_Item_StaticAssert -> "",
        case File_Item_Declaration -> "",
        case File_Item_Test -> "",
        case File_Item_RefusedExport -> "",
        case File_Item_RefusedConst -> "",
        case File_Item_RefusedUnsafe -> "",
        case File_Item_RefusedVisibility -> "",
        case Decl_Item_Func -> "Declaration.func",
        case Decl_Item_Static -> "Declaration.static",
        case Decl_Item_Extension -> "Declaration.extension",
        case Decl_Item_Struct -> "Declaration.struct",
        case Decl_Item_Enum -> "Declaration.enum",
        case Decl_Item_Trait -> "Declaration.trait",
        case Decl_Item_TypeAlias -> "Declaration.type-alias",
        case Decl_Item_Extern -> "Declaration.extern",
        case Decl_Item_RefusedStatic -> "Declaration.refused-static",
        case Decl_Item_RefusedArrayExtension -> "Declaration.refused-array-extension",
