        case "Tuple.refused-partial-named" -> Alt.Expr_Tuple_RefusedPartialNamed,
        case "Array" -> Alt.Expr_Array,
        case "Repeat" -> Alt.Expr_Repeat,
        case "Map.empty" -> Alt.Expr_Map_Empty,
        case "Map.entries" -> Alt.Expr_Map_Entries,
        case "MapEntry" -> Alt.Expr_MapEntry,
        case "Set" -> Alt.Expr_Set,
        case "Closure" -> Alt.Expr_Closure,
        case "Capture.value" -> Alt.Expr_Capture_Value,
        case "Capture.move" -> Alt.Expr_Capture_Move,
        case "Capture.copy" -> Alt.Expr_Capture_Copy,
        case "Capture.borrow" -> Alt.Expr_Capture_Borrow,
        case "Capture.borrow-exclusive" -> Alt.Expr_Capture_BorrowExclusive,
        case "Capture.self" -> Alt.Expr_Capture_Self,
        case "Capture.self-exclusive" -> Alt.Expr_Capture_SelfExclusive,
        case "Capture.refused-self" -> Alt.Expr_Capture_RefusedSelf,
        case "ClosureParam.value" -> Alt.Expr_ClosureParam_Value,
        case "ClosureParam.ref" -> Alt.Expr_ClosureParam_Ref,
        case "ClosureParam.ref-exclusive" -> Alt.Expr_ClosureParam_RefExclusive,
        case "If" -> Alt.Expr_If,
        case "IfArm" -> Alt.Expr_ElseIf,
        case "LetArm.let" -> Alt.Expr_OptionalBinding_Let,
        case "LetArm.var" -> Alt.Expr_OptionalBinding_Var,
        case "Match" -> Alt.Expr_Match,
        case "MatchArm" -> Alt.Expr_MatchArm,
        case "While.conditional" -> Alt.Expr_While_Conditional,
        case "While.infinite" -> Alt.Expr_While_Infinite,
        case "WhileLet.let" -> Alt.Expr_WhileLet_Let,
        case "WhileLet.var" -> Alt.Expr_WhileLet_Var,
        case "WhileLet.refused-else" -> Alt.Expr_WhileLet_RefusedElse,
        case "For.plain" -> Alt.Expr_For_Plain,
        case "For.borrow" -> Alt.Expr_For_Borrow,
        case "For.refused-tuple" -> Alt.Expr_For_RefusedTuple,
        case "WildcardPat" -> Alt.Pat_Wildcard,
        case "LiteralPat.int" -> Alt.Pat_Literal_Int,
        case "LiteralPat.negative-int" -> Alt.Pat_Literal_NegativeInt,
        case "LiteralPat.string" -> Alt.Pat_Literal_String,
        case "LiteralPat.true" -> Alt.Pat_Literal_True,
        case "LiteralPat.false" -> Alt.Pat_Literal_False,
        case "RangePat.exclusive" -> Alt.Pat_Range_Exclusive,
        case "RangePat.inclusive" -> Alt.Pat_Range_Inclusive,
        case "TuplePat.positional" -> Alt.Pat_Tuple_Positional,
        case "TuplePat.refused-named" -> Alt.Pat_Tuple_RefusedNamed,
        case "VariantPat" -> Alt.Pat_Variant,
        case "NamePat" -> Alt.Pat_Name,
        case "NonePat" -> Alt.Pat_None,
        case "BorrowBlock" -> Alt.Borrow_Block,
        case "BorrowBinding.let" -> Alt.Borrow_Binding_Let,
        case "BorrowBinding.var" -> Alt.Borrow_Binding_Var,
        case "BorrowPlace.shared" -> Alt.Borrow_Place_Shared,
        case "BorrowPlace.var" -> Alt.Borrow_Place_Var,
        case "BorrowPlace.refused-let" -> Alt.Borrow_Place_RefusedLet,
        case "BorrowPlace" -> Alt.Borrow_OptionalTarget,
        case "BorrowArm.let" -> Alt.Borrow_Unwrap_Let,
        case "BorrowArm.var" -> Alt.Borrow_Unwrap_Var,
        case "ForBorrow.let" -> Alt.Borrow_For_Let,
        case "ForBorrow.var" -> Alt.Borrow_For_Var,
        case "BorrowBindPat.let" -> Alt.Pat_BorrowBinding_Let,
        case "BorrowBindPat.var" -> Alt.Pat_BorrowBinding_Var,
        case "Error.func" -> Alt.Decl_RefusedEffectPrefix_Func,
        case "Error.init" -> Alt.Decl_RefusedEffectPrefix_Init,
        case "Error.enum" -> Alt.Decl_RefusedUnsafePrefix_Enum,
        case "Error.trait" -> Alt.Decl_RefusedUnsafePrefix_Trait,
        case "Error.extension" -> Alt.Decl_RefusedUnsafePrefix_Extension,
        case "Error.symbol" -> Alt.Decl_RefusedExport_Symbol,
        case "Error.alias" -> Alt.Decl_RefusedExport_Alias,
        case "Error.glob" -> Alt.Decl_RefusedExport_Glob,
        case "Error" -> Alt.Decl_RefusedConst,
        case "Error.private" -> Alt.Decl_RefusedVisibilityPrefix_Private,
        case "Error.attributed-extension" -> Alt.Decl_RefusedVisibilityPrefix_AttributedExtension,
        case "Error.var-without-unsafe" -> Alt.Decl_RefusedStatic_VarWithoutUnsafe,
        case "Error.unsafe-without-var" -> Alt.Decl_RefusedStatic_UnsafeWithoutVar,
        case "Error.before-visibility" -> Alt.Decl_RefusedMemberStatic_BeforeVisibility,
        case "Error.method" -> Alt.Decl_RefusedMemberPrivate_Method,
        case "Error.requirement" -> Alt.Decl_RefusedMemberPrivate_Requirement,
        case "Error.var-self" -> Alt.Decl_RefusedReceiver_VarSelf,
        case "Error.by-value" -> Alt.Decl_RefusedReceiver_ByValue,
        case "Error.ref-name" -> Alt.Decl_RefusedReceiver_RefName,
        case "Error.ref-var-name" -> Alt.Decl_RefusedReceiver_RefVarName,
        case "Error.named-first" -> Alt.Type_RefusedPartialNamedTuple_NamedFirst,
        case "Error.positional-first" -> Alt.Type_RefusedPartialNamedTuple_PositionalFirst,
        case "Error.double" -> Alt.Type_RefusedCastQuestion_Double,
        case "Error.optional-then-double" -> Alt.Type_RefusedCastQuestion_OptionalThenDouble,
        case "Error.second" -> Alt.Type_RefusedCastQuestion_Second,
        case "Error.force" -> Alt.Expr_RefusedTryRoute_Force,
        case "Error.optional" -> Alt.Expr_RefusedTryRoute_Optional,
        case "Error.with-catch" -> Alt.Expr_RefusedTryRoute_WithCatch,
        case "Error.value" -> Alt.Expr_RefusedCaptureSelf_Value,
        case "Error.move" -> Alt.Expr_RefusedCaptureSelf_Move,
        case "Error.let" -> Alt.Stmt_RefusedUninitialized_Let,
        case "Error.var" -> Alt.Stmt_RefusedUninitialized_Var,
        case _ -> None
    }
}

// Every name a refusal carries: a section-13 rule, a lexical rule or a
// removed production.
public enum Rule: UInt16 {
    case Rule_GenericOrLess = 0,
    case Rule_GenericCloseSplit = 1,
    case Rule_TrailingClosure = 2,
    case Rule_HeadRestriction = 3,
    case Rule_HeadReset = 4,
    case Rule_InterpolationSegment = 5,
    case Rule_StaticHead = 6,
    case Rule_Brace = 7,
    case Rule_StatementSeparator = 8,
    case Rule_Juxtaposition = 9,
    case Rule_DeclarationSeparator = 10,
    case Rule_OperatorContinuation = 11,
    case Rule_ImplicitMember = 12,
    case Rule_LeadingMinus = 13,
    case Rule_ContinuationKeywords = 14,
    case Rule_CastTargetQuestion = 15,
    case Rule_BlockTail = 16,
    case Rule_ArmBody = 17,
    case Rule_ArmStatementEnd = 18,
    case Rule_OneCallNode = 19,
    case Rule_FlatElseIf = 20,
    case Rule_FlatChains = 21,
    case Rule_CoalesceGrouping = 22,
    case Rule_CompareChain = 23,
    case Rule_PrefixOrCast = 24,
    case Rule_TryExtent = 25,
    case Rule_PostfixPerHop = 26,
    case Rule_DepthLimit = 27,
    case Rule_BorrowForm = 28,
    case Rule_BorrowExtent = 29,
    case Rule_OptionalChainRun = 30,
    case Rule_LabelOrTuple = 31,
    case Rule_ParenType = 32,
    case Rule_PrefixTypeSuffix = 33,
    case Rule_GenericArgValue = 34,
    case Rule_DerefOrMultiply = 35,
    case Rule_TupleIndexDot = 36,
    case Rule_NamePattern = 37,
    case Rule_ContextualWords = 38,
    case Rule_EffectSlot = 39,
    case Rule_SubscriptDeclaration = 40,
    case Rule_SubscriptArguments = 41,
    case Rule_RangeOpenEnd = 42,
    case Rule_MovePlace = 43,
    case Rule_AssignmentTarget = 44,
    case Rule_AttributePosition = 45,
    case Rule_ReceiverAndStatic = 46,
    case Rule_ExternAbi = 47,
    case Rule_ModuleInline = 48,
    case Rule_TryBlock = 49,
    case Rule_TestForm = 50,
    case Rule_RefusalBody = 51,
    case Rule_RequirementBorrows = 52,
    case Rule_ReferencePosition = 53,
    case Rule_DiscardBinding = 54,
    case Rule_TryRouteCase = 55,
    case Rule_ImportNames = 56,
    case Rule_InterpolationWhole = 57,
    case Lex_LongestMatch = 58,
    case Lex_AsciiIdentifier = 59,
    case Lex_ShiftAdjacent = 60,
    case Lex_DoubleQuestion = 61,
    case Lex_TupleIndex = 62,
    case Lex_FloatPoint = 63,
    case Lex_IntRange = 64,
    case Lex_Escape = 65,
    case Lex_UnterminatedString = 66,
    case Lex_Directive = 67,
    case Lex_UnclosedBracket = 68,
    case Lex_DocAttach = 69,
    case Lex_ModuleDoc = 70,
    case Decl_RefusedEffectPrefix = 71,
    case Decl_RefusedUnsafePrefix = 72,
    case Decl_RefusedExport = 73,
    case Decl_RefusedConst = 74,
    case Decl_RefusedVisibilityPrefix = 75,
    case Decl_RefusedStatic = 76,
    case Decl_RefusedArrayExtension = 77,
    case Decl_RefusedScopedImport = 78,
    case Decl_RefusedMemberStatic = 79,
    case Decl_RefusedMemberPrivate = 80,
    case Decl_RefusedReceiver = 81,
    case Decl_RefusedEscaping = 82,
    case Type_RefusedFuncConsumes = 83,
    case Type_RefusedPartialNamedTuple = 84,
    case Type_RefusedCastQuestion = 85,
    case Generic_RefusedParamComma = 86,
    case Generic_RefusedArgComma = 87,
    case Expr_RefusedUnsafe = 88,
    case Expr_RefusedBorrowLetUnbound = 89,
    case Expr_RefusedLendVar = 90,
    case Expr_RefusedTryRoute = 91,
    case Expr_RefusedCompareChain = 92,
    case Expr_RefusedEllipsisRange = 93,
    case Expr_RefusedCaptureSelf = 94,
    case Expr_RefusedPartialNamedTuple = 95,
    case Expr_RefusedWhileLetElse = 96,
    case Expr_RefusedForTuple = 97,
    case Stmt_RefusedVarDiscard = 98,
    case Stmt_RefusedUninitialized = 99,
    case Stmt_RefusedLocalTypeAlias = 100,
    case Stmt_RefusedLocalConst = 101,
    case Stmt_RefusedCompoundSelf = 102,
    case Stmt_RefusedBareLend = 103,
    case Pat_RefusedNamedTuple = 104,
    case Pat_RefusedQualifiedVariant = 105,
    case Pat_RefusedDotVariant = 106
}

public func rule_name(rule: Rule) -> String {
    match rule {
        case Rule_GenericOrLess -> "syntax.rule.generic-or-less",
        case Rule_GenericCloseSplit -> "syntax.rule.generic-close-split",
        case Rule_TrailingClosure -> "syntax.rule.trailing-closure",
        case Rule_HeadRestriction -> "syntax.rule.head-restriction",
        case Rule_HeadReset -> "syntax.rule.head-reset",
        case Rule_InterpolationSegment -> "syntax.rule.interpolation-segment",
        case Rule_StaticHead -> "syntax.rule.static-head",
        case Rule_Brace -> "syntax.rule.brace",
        case Rule_StatementSeparator -> "syntax.rule.statement-separator",
        case Rule_Juxtaposition -> "syntax.rule.juxtaposition",
        case Rule_DeclarationSeparator -> "syntax.rule.declaration-separator",
        case Rule_OperatorContinuation -> "syntax.rule.operator-continuation",
        case Rule_ImplicitMember -> "syntax.rule.implicit-member",
        case Rule_LeadingMinus -> "syntax.rule.leading-minus",
        case Rule_ContinuationKeywords -> "syntax.rule.continuation-keywords",
        case Rule_CastTargetQuestion -> "syntax.rule.cast-target-question",
        case Rule_BlockTail -> "syntax.rule.block-tail",
        case Rule_ArmBody -> "syntax.rule.arm-body",
        case Rule_ArmStatementEnd -> "syntax.rule.arm-statement-end",
        case Rule_OneCallNode -> "syntax.rule.one-call-node",
        case Rule_FlatElseIf -> "syntax.rule.flat-else-if",
        case Rule_FlatChains -> "syntax.rule.flat-chains",
        case Rule_CoalesceGrouping -> "syntax.rule.coalesce-grouping",
        case Rule_CompareChain -> "syntax.rule.compare-chain",
        case Rule_PrefixOrCast -> "syntax.rule.prefix-or-cast",
        case Rule_TryExtent -> "syntax.rule.try-extent",
        case Rule_PostfixPerHop -> "syntax.rule.postfix-per-hop",
        case Rule_DepthLimit -> "syntax.rule.depth-limit",
        case Rule_BorrowForm -> "syntax.rule.borrow-form",
        case Rule_BorrowExtent -> "syntax.rule.borrow-extent",
        case Rule_OptionalChainRun -> "syntax.rule.optional-chain-run",
