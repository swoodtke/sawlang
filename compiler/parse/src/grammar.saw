// The first alternative that builds a node of this Kind, or None for a Kind
// no alternative builds.
public func alt_for_kind(kind: String) -> Alt? {
    match kind {
        case "File" -> Alt.File_Source,
        case "Declaration.func" -> Alt.Decl_Item_Func,
        case "Declaration.static" -> Alt.Decl_Item_Static,
        case "Declaration.extension" -> Alt.Decl_Item_Extension,
        case "Declaration.struct" -> Alt.Decl_Item_Struct,
        case "Declaration.enum" -> Alt.Decl_Item_Enum,
        case "Declaration.trait" -> Alt.Decl_Item_Trait,
        case "Declaration.type-alias" -> Alt.Decl_Item_TypeAlias,
        case "Declaration.extern" -> Alt.Decl_Item_Extern,
        case "Declaration.refused-static" -> Alt.Decl_Item_RefusedStatic,
        case "Declaration.refused-array-extension" -> Alt.Decl_Item_RefusedArrayExtension,
        case "Declaration.refused-effect-prefix" -> Alt.Decl_Item_RefusedEffectPrefix,
        case "Visibility.public" -> Alt.Decl_Visibility_Public,
        case "Visibility.package" -> Alt.Decl_Visibility_Package,
        case "Visibility.parent" -> Alt.Decl_Visibility_Parent,
        case "Import.private" -> Alt.Decl_Import_Private,
        case "Import.reexport" -> Alt.Decl_Import_Reexport,
        case "Import.refused-scoped" -> Alt.Decl_Import_RefusedScoped,
        case "ImportSymbol.name" -> Alt.Decl_ImportSymbol_Name,
        case "ImportSymbol.alias" -> Alt.Decl_ImportSymbol_Alias,
        case "ModuleDecl.file" -> Alt.Decl_Module_File,
        case "ModuleDecl.inline" -> Alt.Decl_Module_Inline,
        case "StaticAssert" -> Alt.Decl_StaticAssert,
        case "Path" -> Alt.Type_Path,
        case "Func" -> Alt.Decl_Func,
        case "Param.plain" -> Alt.Decl_Param_Plain,
        case "Param.default" -> Alt.Decl_Param_Default,
        case "Param.receiver" -> Alt.Decl_Param_Receiver,
        case "Param.refused-receiver" -> Alt.Decl_Param_RefusedReceiver,
        case "Receiver.shared" -> Alt.Decl_Receiver_Shared,
        case "Receiver.exclusive" -> Alt.Decl_Receiver_Exclusive,
        case "Struct" -> Alt.Decl_Struct,
        case "Field" -> Alt.Decl_Field,
        case "Enum" -> Alt.Decl_Enum,
        case "Case" -> Alt.Decl_Case,
        case "PayloadField" -> Alt.Decl_PayloadField,
        case "Trait" -> Alt.Decl_Trait,
        case "AssocType" -> Alt.Decl_AssocType,
        case "Requirement" -> Alt.Decl_Requirement,
        case "Extension" -> Alt.Decl_Extension,
        case "ExtensionMember.type-assign" -> Alt.Decl_ExtensionMember_TypeAssign,
        case "ExtensionMember.method" -> Alt.Decl_ExtensionMember_Method,
        case "ExtensionMember.synthesized-method" -> Alt.Decl_ExtensionMember_SynthesizedMethod,
        case "ExtensionMember.init" -> Alt.Decl_ExtensionMember_Init,
        case "ExtensionMember.refused-effect-prefix" -> Alt.Decl_ExtensionMember_RefusedEffectPrefix,
        case "ExtensionMember.refused-static" -> Alt.Decl_ExtensionMember_RefusedStatic,
        case "ExtensionMember.refused-private" -> Alt.Decl_ExtensionMember_RefusedPrivate,
        case "TypeAssign" -> Alt.Decl_TypeAssign,
        case "Method" -> Alt.Decl_Method,
        case "Init" -> Alt.Decl_Init,
        case "TypeAlias" -> Alt.Decl_TypeAlias,
        case "Static.immutable" -> Alt.Decl_Static_Immutable,
        case "Static.unsafe-var" -> Alt.Decl_Static_UnsafeVar,
        case "ExternBlock" -> Alt.Decl_ExternBlock,
        case "ExternFunc.prompt" -> Alt.Decl_ExternFunc_Prompt,
