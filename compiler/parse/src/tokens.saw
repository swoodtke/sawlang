// The parser's token stream: the lexer's tokens with byte spans, and without
// the line breaks GRAMMAR.md section 2.4 rule 1 makes insignificant.

import sawlex.src.lib.{LexResult, SegmentKind, Token, TokenKind}
import sawparse.src.source.{SourceFile}

static TOKEN_QUOTE: Int = 34
static TOKEN_BACKSLASH: Int = 92
static TOKEN_DOT: Int = 46
static TOKEN_UNDERSCORE: Int = 95
static TOKEN_DIGIT_0: Int = 48
static TOKEN_DIGIT_9: Int = 57
static TOKEN_UPPER_A: Int = 65
static TOKEN_UPPER_Z: Int = 90
static TOKEN_LOWER_A: Int = 97
static TOKEN_LOWER_Z: Int = 122

// A token as the parser reads it: its kind, its bytes in the source, and the
// line the lexer placed it on, which is how a doc comment finds what follows it.
public struct ParseToken {
    public kind: TokenKind
    public start: Int
    public end: Int
    public line: Int
    // Its run of the parser's interpolation pieces, for an interpolated string.
    public seg_start: Int
    public seg_count: Int
}

// One expression segment of an interpolated string: the source byte of its
// opening `{`, and how many bytes stand between its braces. The lexer keeps a
// segment's text raw, so those bytes are the segment's text as written.
public struct InterpPiece {
    public open: Int
    public len: Int
}

func is_digit_byte(b: Int) -> Bool { b >= TOKEN_DIGIT_0 && b <= TOKEN_DIGIT_9 }

// A byte a number literal can be spelled with; a `.` only between digits.
func is_number_byte(b: Int) -> Bool {
    let letter = (b >= TOKEN_UPPER_A && b <= TOKEN_UPPER_Z) || (b >= TOKEN_LOWER_A && b <= TOKEN_LOWER_Z)
    letter || is_digit_byte(b) || b == TOKEN_UNDERSCORE || b == TOKEN_DOT
}

// Where a token that starts at `start` ends. A literal's value is decoded, so
// its extent comes from the source: a string runs to its closing quote, and a
// number to the first byte it cannot hold, or to the next token, whichever
// comes first, since the lexer's reading of a tuple index or of `7e5` stops
// short of what the characters could spell.
func token_end(source: &SourceFile, t: &Token, start: Int, bound: Int) -> Int {
    match t.kind {
        case StringLit -> {
            var k = start + 1
            while k < source.len() && source.byte(k) != TOKEN_QUOTE {
                if source.byte(k) == TOKEN_BACKSLASH { k = k + 2 } else { k = k + 1 }
            }
            k + 1
        },
        case InterpString -> start + t.value.len() + 2,
        case IntLit -> number_end(&source, start, bound),
        case FloatLit -> number_end(&source, start, bound),
        case HashDirective -> start + t.value.len() + 1,
        case _ -> start + t.value.len()
    }
}

func number_end(source: &SourceFile, start: Int, bound: Int) -> Int {
    var k = start
    while k < bound && is_number_byte(source.byte(k)) {
        if source.byte(k) == TOKEN_DOT && not (k + 1 < bound && is_digit_byte(source.byte(k + 1))) {
            return k
        }
        k = k + 1
    }
    k
}

public func opens_bracket(kind: TokenKind) -> Bool {
    match kind {
        case LParen -> true,
        case LBracket -> true,
        case LBrace -> true,
        case _ -> false
    }
}

public func closes_bracket(kind: TokenKind) -> Bool {
    match kind {
        case RParen -> true,
        case RBracket -> true,
        case RBrace -> true,
        case _ -> false
    }
}

// Whether a line break inside this innermost bracket is insignificant.
func quiet_inside(kind: TokenKind) -> Bool {
    kind == TokenKind.LParen || kind == TokenKind.LBracket
}

// The parser's tokens for a lexed text, appended to `out`: each with its byte
// span, and without a line break whose innermost enclosing bracket is `(` or
// `[`. `source` is the text that was lexed, which starts at byte `base` of the
// file, so an interpolation segment's tokens keep the file's byte positions.
// Each interpolated string's expression segments are appended to `pieces`,
// which its token then names.
public func parser_tokens(source: &SourceFile, lexed: &LexResult, base: Int,
                          out: &var Vector<ParseToken>, pieces: &var Vector<InterpPiece>) {
    let n = lexed.tokens.len()
    var starts = Vector<Int>()
    var i = 0
    while i < n {
        let t = lexed.tokens[i]
        try! starts.push(source.offset_of(t.line, t.col))
        i = i + 1
    }
    var brackets = Vector<TokenKind>()
    var open = 0
    i = 0
    while i < n {
        let t = lexed.tokens[i]
        let start = starts[i]
        let bound = if i + 1 < n { starts[i + 1] } else { source.len() }
        let end = token_end(&source, &t, start, bound)
        let first_piece = pieces.len()
        var k = 0
        while k < t.seg_count {
            let seg = lexed.segments[t.seg_start + k]
            if seg.kind == SegmentKind.Expr {
                let at = base + source.offset_of(seg.line, seg.col)
                try! pieces.push(InterpPiece(open: at, len: seg.text.len()))
            }
            k = k + 1
        }
        var keep = true
        if t.kind == TokenKind.Newline {
            keep = open == 0 || not quiet_inside(brackets[open - 1])
        } else if opens_bracket(t.kind) {
            if open < brackets.len() {
                brackets[open] = t.kind
            } else {
                try! brackets.push(t.kind)
            }
            open = open + 1
        } else if closes_bracket(t.kind) {
            if open > 0 {
                open = open - 1
            }
        }
        if keep {
            try! out.push(ParseToken(kind: t.kind, start: base + start, end: base + end,
                                     line: t.line, seg_start: first_piece,
                                     seg_count: pieces.len() - first_piece))
        }
        i = i + 1
    }
}
