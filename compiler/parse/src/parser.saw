// The parser: bounded recursive descent over GRAMMAR.md (SL:architecture §3.2).
//
// Each construct is one method, named for its production, which builds the
// construct's node from the scratch stack of `TreeBuilder` and records every
// alternative its derivation takes, so a parse reports the same coverage the
// reference recognizer's record does. A binary tier is a loop into one flat
// node. Recursion only ever passes through `enter_level`, the one depth funnel;
// compiler/tools/depth_funnel.py proves that of every call cycle.
//
// A method returns false once it has reported an error. Nothing above it
// reports again: the error unwinds to the statement or declaration loop,
// which skips to the next boundary at the same bracket depth and goes on, so
// one run reports every independent error.

import sawlex.src.lib.{DocComment, TokenKind, lex}
import sawparse.src.source.{source_file}
import sawparse.src.diag.{Diagnostic}
import sawparse.src.grammar.{ALT_COUNT, Alt, Rule, begins_statement_only, follows_cast_list,
                             holds_closure_head, rule_named, stops_list_scan}
import sawparse.src.tokens.{InterpPiece, ParseToken, closes_bracket, opens_bracket, parser_tokens}
import sawparse.src.tree.{BuilderCheckpoint, NodeShape, TreeBuilder, put_at, trim_to}

public static PARSE_MAX_DEPTH: Int = 256
static PARSE_SPACE: Int = 32
static PARSE_UNDERSCORE: Int = 95
static PARSE_DIGIT_0: Int = 48
static PARSE_DIGIT_9: Int = 57

static PARSE_LETTER_C: Int = 67

func is_decimal_byte(b: Int) -> Bool { b >= PARSE_DIGIT_0 && b <= PARSE_DIGIT_9 }

// The value of a hexadecimal digit the lexer has already checked.
func escape_digit_value(b: Int) -> Int {
    if is_decimal_byte(b) {
        return b - PARSE_DIGIT_0
    }
    if b >= 97 {
        return b - 87
    }
    b - 55
}

// A run of `///` lines and the token it documents: the first token after its
// last line that is not a line break.
struct DocRun {
    first: Int
    last: Int
    target: Int
    attached: Bool
}

// Where a statement list stands between items: whether it holds one yet, and
// whether a `;` is waiting for the statement it joins.
struct ListState {
    any: Bool
    need: Bool
}

// A token a generic list's close split, and the token it was before, so that
// a restore can put it back (syntax.rule.generic-close-split).
struct TokenEdit {
    index: Int
    token: ParseToken
}

// What a speculative generic list came to: kept, re-read as comparisons, or
// kept and refused, which is reported (syntax.rule.generic-or-less).
enum ListOutcome {
    case Kept,
    case Compares,
    case Refused
}

// What a scan ahead of a `<` found: a token that could close a generic list
// opened there, or proof that none can (syntax.rule.generic-or-less).
enum CloserScan {
    case Unscanned,
    case Found,
    case Missing
}

// Where a statement list stood before an item that may fail: what the
// recovery loop returns it to.
struct ResumePoint {
    mark: Int
    depth: Int
    lists: Int
    head: HeadState
    head_at: Int
    head_until: TokenKind
    spine: Int
    literal_arm: Int
    shadow_brace: Int
}

// Where the parser stands with respect to a head (syntax.rule.head-restriction).
// `On` is a head's outer level, where a `{` after an operand begins the body.
// `Shadow` is the first element of a brace literal that stands at a head's
// outer level: a map or set there is still in the head, a closure body is
// not, and which of them the brace is waits on the element, so a trailing
// closure attaches and is noted, and refused should the brace be a literal.
// `Lifted` is a head read again with the restriction lifted, to see whether
// it refused what failed: a trailing closure attaches where it may, and any
// other `{` ends the head.
public enum HeadState {
    case Off,
    case On,
    case Shadow,
    case Lifted
}

// Where a statement stands: in a block, as an unbraced arm body, or as the
// first element of a brace in expression position, which may yet be a map
// key or a set element rather than a closure's first statement.
enum StatementPlace {
    case Block,
    case Arm,
    case BraceFirst
}

// The head the parser stood in before it entered another.
struct HeadFrame {
    state: HeadState
    at: Int
    until: TokenKind
}

// A head a statement noted, kept aside while a brace body inside it parses.
struct HeadNote {
    brace: Int
    start: Int
    follow: TokenKind
}

// What a `{` in expression position opens, as far as its first element
// decides (syntax.rule.brace).
enum BraceForm {
    case Closure,
    case Map,
    case Set
}

// A body of declarations one per line: a trait's, an extension's or an
// extern block's.
enum MemberBody {
    case Trait,
    case Extension,
    case Extern
}

// The member-list alternative a body records once it holds a member.
func member_list_alt(body: MemberBody) -> Alt {
    match body {
        case Trait -> Alt.Decl_TraitMembers,
        case Extension -> Alt.Decl_ExtensionMembers,
        case Extern -> Alt.Decl_ExternFuncs
    }
}

// What declares an effect slot, which decides the effects it may hold
// (syntax.rule.effect-slot, syntax.rule.requirement-borrows).
enum EffectHost {
    case Function,
    case Method,
    case Initializer,
    case Requirement
}

// An attribute's name as one bit of a set, `@export` with or without its
// symbol one name (syntax.rule.attribute-position).
func attribute_bit(alt: Alt) -> Int {
    match alt {
        case Attr_Attribute_Section -> 2,
        case Attr_Attribute_Synthesize -> 4,
        case Attr_Attribute_Align -> 8,
        case Attr_Attribute_SynthesizeShared -> 16,
        case _ -> 1
    }
}

// The attributes a declaration may carry, as a set of `attribute_bit`s; none
// for one that takes no attribute list (syntax.rule.attribute-position).
func attribute_hosts(host: Alt) -> Int {
    match host {
        case Decl_Item_Func -> 3,
        case Decl_Item_Static -> 11,
        case Decl_Item_Extension -> 4,
        case Stmt_AttributedLocal -> 8,
        case _ -> 0
    }
}

// A comma-separated list the funnel parses, which names the parser of its
// elements (`Parser.parse_list_element`); `list_shape` gives the rest of it.
enum CommaList {
    case ImportSymbols,
    case Params,
    case FuncTypeParams,
    case TupleType,
    case GenericParams,
    case GenericArgs,
    case CallArgs,
    case SubscriptArgs,
    case TupleExpr,
    case ArrayElements,
    case MapEntries,
    case SetElements,
    case TuplePattern,
    case PayloadPatterns,
    case ClosureParams,
    case Captures,
    case Fields,
    case Cases,
    case PayloadFields,
    case ExternParams,
    case TraitParents,
    case Conformances,
    case BorrowBindings
}

// What ends a list. A generic list's `>` may be the first half of a `>=` or
// `>>=` (syntax.rule.generic-close-split), a closure head ends at `in`, and a
// trait's parents and an extension's conformances at the `{` of its body, on
// their line or the next (`Body`). The funnel only tests for the closer; the
// caller consumes it.
enum ListCloser {
    case RParen,
    case RBracket,
    case RBrace,
    case GenericClose,
    case In,
    case Body
}

// What a comma after a list's last element does: nothing (`Allowed`), is a
// plain parse error (`Plain`), is refused by the list's rule (`Refused`), or is
// what makes one element a list (`RequiredForOne`), its absence refused.
enum TrailingComma {
    case Allowed,
    case Plain,
    case Refused,
    case RequiredForOne
}

// Where a list's line breaks are decided. Inside `( )`, `[ ]` and a generic
// list they are gone before the funnel sees them (GRAMMAR.md section 2.4,
// `Settled`); a closure head and an import list take them after a comma
// (`AfterComma`), and a map or set literal around each entry and before a
// comma (`AroundEntries`). Between a struct's fields or an enum's cases a
// line break separates as a comma does, and the funnel records which
// separator stood there (`Separate`, syntax.decl.list-sep).
enum LineBreaks {
    case Settled,
    case AfterComma,
    case AroundEntries,
    case Separate
}

// One row of the comma-list position matrix: a list, its closer, its
// trailing-comma policy with the rule that names a refusal of it, its line
// breaks, and whether it may hold no element.
struct ListShape {
    list: CommaList
    closer: ListCloser
    trailing: TrailingComma
    refusal: Rule?
    breaks: LineBreaks
    empty: Bool
}

// What a list the funnel parsed holds: its elements, and whether a comma
// followed the last.
struct ListCount {
    elements: Int
    trailing: Bool
}

// The count a caller hands the funnel to fill.
func no_elements() -> ListCount { ListCount(elements: 0, trailing: false) }

// THE COMMA-LIST POSITION MATRIX, one row per list. Each row is pinned by a
// case of compiler/tests/parse/golden/lists.saw and negative/lists.saw.
func list_shape(list: CommaList) -> ListShape {
    match list {
        case ImportSymbols -> ListShape(list: list, closer: ListCloser.RBrace,
                                        trailing: TrailingComma.Allowed, refusal: None,
                                        breaks: LineBreaks.AfterComma, empty: true),
        case Params -> ListShape(list: list, closer: ListCloser.RParen,
                                 trailing: TrailingComma.Allowed, refusal: None,
                                 breaks: LineBreaks.Settled, empty: true),
        case FuncTypeParams -> ListShape(list: list, closer: ListCloser.RParen,
                                         trailing: TrailingComma.Allowed, refusal: None,
                                         breaks: LineBreaks.Settled, empty: true),
        case TupleType -> ListShape(list: list, closer: ListCloser.RParen,
                                    trailing: TrailingComma.Allowed, refusal: None,
                                    breaks: LineBreaks.Settled, empty: false),
        case GenericParams -> ListShape(list: list, closer: ListCloser.GenericClose,
                                        trailing: TrailingComma.Refused,
                                        refusal: Rule.Generic_RefusedParamComma,
                                        breaks: LineBreaks.Settled, empty: false),
        case GenericArgs -> ListShape(list: list, closer: ListCloser.GenericClose,
                                      trailing: TrailingComma.Refused,
                                      refusal: Rule.Generic_RefusedArgComma,
                                      breaks: LineBreaks.Settled, empty: false),
        case CallArgs -> ListShape(list: list, closer: ListCloser.RParen,
                                   trailing: TrailingComma.Allowed, refusal: None,
                                   breaks: LineBreaks.Settled, empty: true),
        case SubscriptArgs -> ListShape(list: list, closer: ListCloser.RBracket,
                                        trailing: TrailingComma.Allowed, refusal: None,
                                        breaks: LineBreaks.Settled, empty: false),
        case TupleExpr -> ListShape(list: list, closer: ListCloser.RParen,
                                    trailing: TrailingComma.Allowed, refusal: None,
                                    breaks: LineBreaks.Settled, empty: false),
        case ArrayElements -> ListShape(list: list, closer: ListCloser.RBracket,
                                        trailing: TrailingComma.Allowed, refusal: None,
                                        breaks: LineBreaks.Settled, empty: true),
        case MapEntries -> ListShape(list: list, closer: ListCloser.RBrace,
                                     trailing: TrailingComma.Allowed, refusal: None,
                                     breaks: LineBreaks.AroundEntries, empty: false),
        case SetElements -> ListShape(list: list, closer: ListCloser.RBrace,
                                      trailing: TrailingComma.Allowed, refusal: None,
                                      breaks: LineBreaks.AroundEntries, empty: false),
        case TuplePattern -> ListShape(list: list, closer: ListCloser.RParen,
                                       trailing: TrailingComma.RequiredForOne,
                                       refusal: Rule.Pat_RefusedParen,
                                       breaks: LineBreaks.Settled, empty: true),
        case PayloadPatterns -> ListShape(list: list, closer: ListCloser.RParen,
                                          trailing: TrailingComma.Allowed, refusal: None,
                                          breaks: LineBreaks.Settled, empty: true),
        case ClosureParams -> ListShape(list: list, closer: ListCloser.In,
                                        trailing: TrailingComma.Plain, refusal: None,
                                        breaks: LineBreaks.AfterComma, empty: false),
        case Captures -> ListShape(list: list, closer: ListCloser.RBracket,
                                   trailing: TrailingComma.Allowed, refusal: None,
                                   breaks: LineBreaks.Settled, empty: false),
        case Fields -> ListShape(list: list, closer: ListCloser.RBrace,
                                 trailing: TrailingComma.Allowed, refusal: None,
                                 breaks: LineBreaks.Separate, empty: true),
        case Cases -> ListShape(list: list, closer: ListCloser.RBrace,
                                trailing: TrailingComma.Allowed, refusal: None,
                                breaks: LineBreaks.Separate, empty: true),
        case PayloadFields -> ListShape(list: list, closer: ListCloser.RParen,
                                        trailing: TrailingComma.Allowed, refusal: None,
                                        breaks: LineBreaks.Settled, empty: true),
        case ExternParams -> ListShape(list: list, closer: ListCloser.RParen,
                                       trailing: TrailingComma.Allowed, refusal: None,
                                       breaks: LineBreaks.Settled, empty: true),
        case TraitParents -> ListShape(list: list, closer: ListCloser.Body,
                                       trailing: TrailingComma.Plain, refusal: None,
                                       breaks: LineBreaks.Settled, empty: false),
        case Conformances -> ListShape(list: list, closer: ListCloser.Body,
                                       trailing: TrailingComma.Plain, refusal: None,
                                       breaks: LineBreaks.Settled, empty: false),
        case BorrowBindings -> ListShape(list: list, closer: ListCloser.Body,
                                         trailing: TrailingComma.Plain, refusal: None,
                                         breaks: LineBreaks.Settled, empty: false)
    }
}

// Whether a list's closer is a bracket, whose absence at the end of input is
// that bracket left unclosed (syntax.lex.unclosed-bracket).
func is_bracket_closer(closer: ListCloser) -> Bool {
    closer == ListCloser.RParen || closer == ListCloser.RBracket || closer == ListCloser.RBrace
}

// The diagnostic for a list whose trailing comma its policy refuses, or, for a
// comma it requires, whose one element stands without it.
func list_refusal_message(list: CommaList) -> String {
    match list {
        case GenericParams -> "a generic parameter list takes no trailing comma",
        case GenericArgs -> "a generic argument list takes no trailing comma",
        case TuplePattern -> "a pattern has no grouping parentheses",
        case ClosureParams -> "a closure's parameters take no comma after the last",
        case _ -> "this list takes no comma after its last element"
    }
}

func list_refusal_hint(list: CommaList) -> String {
    match list {
        case TuplePattern -> "write `(p,)` for a one-element tuple pattern",
        case _ -> "drop the comma"
    }
}

// The plain error for a token that neither separates a list's elements nor
// closes it.
func list_gap_message(shape: ListShape) -> String {
    if shape.breaks == LineBreaks.Separate {
        return "expected `,` or a line break before the next one, or `\}`"
    }
    match shape.closer {
        case RParen -> "expected `,` or `)` in the list",
        case RBracket -> "expected `,` or `]` in the list",
        case RBrace -> "expected `,` or `\}` in the list",
        case GenericClose -> "expected `,` or `>` in the generic list",
        case In -> "expected `,` or `in` in the closure's parameters",
        case Body -> "expected `,` or the body's `\{`"
    }
}

// Where the parser stood when a speculation began: what `restore` returns it
// to. SPECULATION LEDGER below lists each field of `Parser` and why a restore
// leaves it right.
public struct Checkpoint {
    public tree: BuilderCheckpoint
    public tokens: Int
    public pieces: Int
    public pos: Int
    public limit: Int
    public prev_end: Int
    public depth: Int
    public taken: Int
    public edits: Int
    public lists: Int
    public speculating: Int
    public trailing_comma: Int
    public rejected_list: Int
    public head: HeadState
    public head_at: Int
    public head_until: TokenKind
    public primed: Bool
    public spine: Int
    public literal_arm: Int
    public head_brace: Int
    public head_start: Int
    public head_follow: TokenKind
    public shadow_brace: Int
    public lifted_brace: Int
    public dropped: Int
}

public struct Parser {
    builder: TreeBuilder
    // The file's tokens, and after them each interpolation segment's, as it
    // is parsed, each run ending in its own Eof. The first `token_count` are
    // live; a restore lowers the count, and the slots above are reused.
    private tokens: Vector<ParseToken>
    private token_count: Int
    private pieces: Vector<InterpPiece>
    private piece_count: Int
    private docs: Vector<DocComment>
    private runs: Vector<DocRun>
    private pos: Int
    // The Eof that ends the run being parsed: the file's, or a segment's.
    private limit: Int
    // The end of the last token consumed, where a node closing now ends.
    private prev_end: Int
    private depth: Int
    diagnostics: Vector<Diagnostic>
    // Which alternatives the derivation took, and the same set in the order
    // first taken; the first `taken_count` of `taken` are live.
    private seen: Vector<Bool>
    taken: Vector<Alt>
    private taken_count: Int
    // The tokens split so far, the first `edit_count` live.
    private edits: Vector<TokenEdit>
    private edit_count: Int
    // How many generic lists are open, inside which line breaks are
    // insignificant (syntax.rule.generic-or-less).
    private lists: Int
    // How many speculations are open; none reports a diagnostic.
    private speculating: Int
    // How many diagnostics the open speculations have dropped. A speculation
    // judged by where its reading stops compares it too, since a reading that
    // recovered from an error can still stop where a sound one would.
    private dropped: Int
    // The first trailing comma a speculative list met, or -1: refused only if
    // the list is kept.
    private trailing_comma: Int
    // The `<` of the last list the statement re-read as comparisons although
    // it parsed and its reading could go on, or -1; a plain error in that
    // statement is then that rule's refusal (syntax.rule.generic-or-less).
    private rejected_list: Int
    // For each token, whether a generic list speculated at it failed to parse,
    // which it then does wherever it is retried: a retry answers at once, so
    // nested speculations do not double their cost per level.
    private failed_lists: Vector<Bool>
    // For each `<`, what the scan for a closer ahead of it found. One scan
    // answers every `<` at its bracket depth up to where it stopped, so a
    // flat run of comparisons costs one scan, not one per `<`.
    private closer_scans: Vector<CloserScan>
    // Whether the parser stands at the outer level of a head, where a `{`
    // begins the construct's body (syntax.rule.head-restriction). A bracket, an
    // interpolation segment and a nested block clear it for their contents
    // (syntax.rule.head-reset).
    private head: HeadState
    // Where the head being parsed began, and the token its construct takes
    // after it; read only while `head` is not `Off`.
    private head_at: Int
    private head_until: TokenKind
    // The `{` a head of this statement stopped at where a trailing closure
    // could have attached, or -1; the token that head began at; and the
    // token its construct takes after it: `{`, `else` or `->`, or `,` for a
    // borrow binding's head, which the body's `{` may follow instead. A refusal
    // later in the statement is that rule's when the head, read with the
    // closure attached, goes on to that token (syntax.rule.head-restriction).
    private head_brace: Int
    private head_start: Int
    private head_follow: TokenKind
    // The first trailing closure that attached in `HeadState.Shadow`, or -1.
    private shadow_brace: Int
    // The one `{` a head read in `HeadState.Lifted` attaches a closure at.
    private lifted_brace: Int
    // Whether the operand of the expression about to be parsed is already
    // on the scratch stack: a statement that parsed a postfix chain as a
    // possible assignment target, and found no assignment after it.
    private primed: Bool
    // The alternatives a statement's leading postfix chain took that a target
    // derives otherwise: the chain's own, and one per hop. The first
    // `spine_count` are live, a stack each statement pushes and pops.
    private spine_alts: Vector<Alt>
    private spine_count: Int
    // The `{` of an arm body that reads as a map or set literal, or -1: a
    // plain error inside its block is that rule's refusal (syntax.rule.arm-body).
    private literal_arm: Int
    // How many depth refusals the parse has met, speculations included, and
    // the opener of the last.
    private depth_refusals: Int
    private depth_opener: Int
}

extension Parser: NoCopy {}

public func new_parser(builder: TreeBuilder, tokens: Vector<ParseToken>,
                       pieces: Vector<InterpPiece>, docs: &Vector<DocComment>) -> Parser {
    var seen = Vector<Bool>()
    var k = 0
    while k < ALT_COUNT {
        try! seen.push(false)
        k = k + 1
    }
    var own_docs = Vector<DocComment>()
    k = 0
    while k < docs.len() {
        let d = docs[k]
        try! own_docs.push(d)
        k = k + 1
    }
    let token_count = tokens.len()
    let piece_count = pieces.len()
    var parser = Parser(builder: move builder, tokens: move tokens, token_count: token_count,
                        pieces: move pieces, piece_count: piece_count, docs: move own_docs,
                        runs: Vector<DocRun>(), pos: 0, limit: token_count - 1, prev_end: 0,
                        depth: 0, diagnostics: Vector<Diagnostic>(), seen: move seen,
                        taken: Vector<Alt>(), taken_count: 0, edits: Vector<TokenEdit>(),
                        edit_count: 0, lists: 0, speculating: 0, dropped: 0, trailing_comma: -1,
                        rejected_list: -1, failed_lists: Vector<Bool>(),
                        closer_scans: Vector<CloserScan>(), head: HeadState.Off,
                        head_at: -1, head_until: TokenKind.LBrace,
                        head_brace: -1, head_start: -1, head_follow: TokenKind.LBrace,
                        shadow_brace: -1, lifted_brace: -1, primed: false,
                        spine_alts: Vector<Alt>(), spine_count: 0, literal_arm: -1,
                        depth_refusals: 0,
                        depth_opener: -1)
    parser.find_doc_runs()
    move parser
}

// Whether a token of this kind ends a statement, and so leaves a `return`
// or `break` without an operand (GRAMMAR.md section 6.3); in an unbraced arm
// body (`arm`), `,` and `case` end one too (syntax.rule.arm-statement-end).
func ends_statement(kind: TokenKind, arm: Bool) -> Bool {
    match kind {
        case Newline -> true,
        case Semicolon -> true,
        case RBrace -> true,
        case Eof -> true,
        case Comma -> arm,
        case Case -> arm,
        case _ -> false
    }
}

// Whether a token of this kind would continue an expression whose operand
// ends before it: a postfix hop, a cast, or any binary, range or assignment
// operator (syntax.rule.block-tail).
func continues_operand(kind: TokenKind) -> Bool {
    if is_assignment(kind) || is_const_operator(kind) {
        return true
    }
    match kind {
        case Dot -> true,
        case QuestionDot -> true,
        case LParen -> true,
        case LBracket -> true,
        case Exclaim -> true,
        case As -> true,
        case WrapAdd -> true,
        case WrapSub -> true,
        case WrapMul -> true,
        case Lt -> true,
        case Gt -> true,
        case Lte -> true,
        case Gte -> true,
        case Eq -> true,
        case Neq -> true,
        case Ampersand -> true,
        case Pipe -> true,
        case Caret -> true,
        case And -> true,
        case Or -> true,
        case DoubleQuestion -> true,
        case DotDot -> true,
        case DotDotEq -> true,
        case Ellipsis -> true,
        case _ -> false
    }
}

// The alternative of a place hop, `place-hop`, for the postfix hop `hop`
// that ends an assignment's projection target.
func place_hop(hop: Alt) -> Alt {
    match hop {
        case Expr_Hop_TupleIndex -> Alt.Stmt_PlaceHop_TupleIndex,
        case Expr_Hop_Subscript -> Alt.Stmt_PlaceHop_Subscript,
        case Expr_Hop_Force -> Alt.Stmt_PlaceHop_Force,
        case _ -> Alt.Stmt_PlaceHop_Member
    }
}

// The alternative of a `chain-hop` after an optional-chain target's
// optional hop, for the postfix hop `hop` in its place.
func chain_hop(hop: Alt) -> Alt {
    match hop {
        case Expr_Hop_Optional -> Alt.Stmt_ChainHop_Optional,
        case Expr_Hop_Call -> Alt.Stmt_ChainHop_Call,
        case Expr_Hop_Trailing -> Alt.Stmt_ChainHop_Trailing,
        case _ -> Alt.Stmt_ChainHop_Member
    }
}

// The `compound-op` alternative of a compound assignment operator.
func compound_op(kind: TokenKind) -> Alt {
    match kind {
        case MinusAssign -> Alt.Stmt_CompoundOp_Subtract,
        case StarAssign -> Alt.Stmt_CompoundOp_Multiply,
        case SlashAssign -> Alt.Stmt_CompoundOp_Divide,
        case PercentAssign -> Alt.Stmt_CompoundOp_Remainder,
        case AmpAssign -> Alt.Stmt_CompoundOp_And,
        case PipeAssign -> Alt.Stmt_CompoundOp_Or,
        case CaretAssign -> Alt.Stmt_CompoundOp_Xor,
        case ShlAssign -> Alt.Stmt_CompoundOp_ShiftLeft,
        case ShrAssign -> Alt.Stmt_CompoundOp_ShiftRight,
        case _ -> Alt.Stmt_CompoundOp_Add
    }
}

// The bracket depth after a token of this kind, where `open` holds the
// openers still open, innermost at `depth - 1`. A closer pops only an opener
// of its own kind.
func track_bracket(open: &var Vector<TokenKind>, depth: Int, kind: TokenKind) -> Int {
    if opens_bracket(kind) {
        if depth < open.len() {
            open[depth] = kind
        } else {
            try! open.push(kind)
        }
        return depth + 1
    }
    if depth > 0 && closes_bracket(kind) && closes_opener(kind, open[depth - 1]) {
        return depth - 1
    }
    depth
}

func closes_opener(closer: TokenKind, opener: TokenKind) -> Bool {
    match closer {
        case RParen -> opener == TokenKind.LParen,
        case RBracket -> opener == TokenKind.LBracket,
        case RBrace -> opener == TokenKind.LBrace,
        case _ -> false
    }
}

// Whether a token of this kind begins a declaration at a top-level item's head.
func is_declaration_keyword(kind: TokenKind) -> Bool {
    match kind {
        case Func -> true,
        case Public -> true,
        case At -> true,
        case Struct -> true,
        case Enum -> true,
        case Trait -> true,
        case Extension -> true,
        case Extern -> true,
        case Static -> true,
        case Unsafe_ -> true,
        case Borrows -> true,
        case _ -> false
    }
}

// Whether a token of this kind is an operator of the constant grammar
// (GRAMMAR.md section 5.2).
func is_const_operator(kind: TokenKind) -> Bool {
    match kind {
        case Plus -> true,
        case Minus -> true,
        case Star -> true,
        case Slash -> true,
        case Percent -> true,
        case _ -> false
    }
}

// Whether a token of this kind can go on after a postfix expression, so that
// a generic list re-read before it had a reading that went on
// (syntax.rule.generic-or-less).
func continues_postfix(kind: TokenKind) -> Bool {
    (follows_cast_list(kind) || kind == TokenKind.LBracket || kind == TokenKind.Exclaim
     || kind == TokenKind.QuestionDot)
}

// Whether an alternative builds a loop: a `while` of any form, or a `for`.
func is_loop_alt(alt: Alt) -> Bool {
    match alt {
        case Expr_While_Conditional -> true,
        case Expr_While_Borrow -> true,
        case Expr_While_Infinite -> true,
        case Expr_WhileLet_Let -> true,
        case Expr_WhileLet_Var -> true,
        case Expr_For_Plain -> true,
        case Borrow_For_Let -> true,
        case Borrow_For_Var -> true,
        case _ -> false
    }
}

// Whether a token of this kind makes the statement before it an assignment.
func is_assignment(kind: TokenKind) -> Bool {
    match kind {
        case Assign -> true,
        case PlusAssign -> true,
        case MinusAssign -> true,
        case StarAssign -> true,
        case SlashAssign -> true,
        case PercentAssign -> true,
        case AmpAssign -> true,
        case PipeAssign -> true,
        case CaretAssign -> true,
        case ShlAssign -> true,
        case ShrAssign -> true,
        case _ -> false
    }
}

extension Parser {
    // ---- tokens -------------------------------------------------------------

    func current(&self) -> ParseToken { self.tokens[self.pos] }

    func kind(&self) -> TokenKind { self.tokens[self.pos].kind }

    // The kind `ahead` tokens on, or Eof past the end of the run.
    func kind_at(&self, ahead: Int) -> TokenKind {
        let at = self.pos + ahead
        if at <= self.limit { self.tokens[at].kind } else { TokenKind.Eof }
    }

    // Whether the token `ahead` tokens on is an identifier spelled `word`: a
    // contextual word, recognized only where the grammar asks for it.
    func word_at(&self, ahead: Int, word: String) -> Bool {
        let at = self.pos + ahead
        if at > self.limit || self.tokens[at].kind != TokenKind.Ident {
            return false
        }
        let t = self.tokens[at]
        self.builder.tree.source.span_is(t.start, t.end, word)
    }

    // Consumes the current token. Inside a generic list the line breaks after
    // it are insignificant, so they are passed over too, without moving where
    // a node closing now ends.
    func advance(&var self) {
        let t = self.current()
        self.prev_end = t.end
        if self.pos < self.limit {
            self.pos = self.pos + 1
        }
        if self.lists > 0 {
            while self.pos < self.limit && self.tokens[self.pos].kind == TokenKind.Newline {
                self.pos = self.pos + 1
            }
        }
    }

    // The byte where the current token starts, where a construct starting
    // here begins its span.
    func here(&self) -> Int { self.tokens[self.pos].start }

    func skip_newlines(&var self) {
        while self.kind() == TokenKind.Newline {
            self.advance()
        }
    }

    // The current token as a leaf of the construct under way.
    func take_leaf(&var self) {
        let t = self.current()
        let _ = self.builder.leaf(NodeShape.Token, t.start, t.end)
        self.advance()
    }

    // ---- the tree -----------------------------------------------------------

    func see(&var self, alt: Alt) {
        let index = (alt as UInt16) as Int
        if not self.seen[index] {
            self.seen[index] = true
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.taken, self.taken_count, alt)
            let at = self.taken_count
            put_at(&var self.taken, at, alt)
            self.taken_count = at + 1
        }
    }

    // ---- speculation ----------------------------------------------------------

    // Opens a speculation: parsing goes on from here, reporting nothing, until
    // `restore` undoes all of it or `commit` keeps it.
    // SPECULATION LEDGER:
    //     builder: restored
    //     tokens: restored
    //     token_count: restored
    //     pieces: restored by piece_count
    //     piece_count: restored
    //     docs: unchanged, because nothing writes it after the parser is built
    //     runs: unchanged, because only a declaration or a test item's head marks a doc run, attach_docs refuses to run inside a speculation, and a test head is never parsed inside one
    //     pos: restored
    //     limit: restored
    //     prev_end: restored
    //     depth: restored
    //     diagnostics: unchanged, because record drops a diagnostic while a speculation is open
    //     seen: restored
    //     taken: restored
    //     taken_count: restored
    //     edits: restored
    //     edit_count: restored
    //     lists: restored
    //     speculating: restored
    //     dropped: restored
    //     trailing_comma: restored
    //     rejected_list: restored
    //     failed_lists: kept, because a list that failed to parse fails in every context, a depth refusal being refused rather than recorded, and parse_segment clears a slot it reuses
    //     closer_scans: kept, because a scan reads only the tokens after its `<`, which no speculation has split yet, and parse_segment clears a slot it reuses
    //     head: restored
    //     head_at: restored
    //     head_until: restored
    //     head_brace: restored
    //     head_start: restored
    //     head_follow: restored
    //     shadow_brace: restored
    //     lifted_brace: restored
    //     primed: restored
    //     spine_alts: restored by spine_count
    //     spine_count: restored
    //     literal_arm: restored
    //     depth_refusals: kept, because it only counts up, so a speculation sees the refusals of those nested in it
    //     depth_opener: kept, because it names the opener a depth refusal a restore undid is reported at
    public func checkpoint(&var self) -> Checkpoint {
        let tree = self.builder.checkpoint()
        let saved = Checkpoint(tree: tree, tokens: self.token_count, pieces: self.piece_count,
                               pos: self.pos, limit: self.limit, prev_end: self.prev_end,
                               depth: self.depth, taken: self.taken_count,
                               edits: self.edit_count, lists: self.lists,
                               speculating: self.speculating,
                               trailing_comma: self.trailing_comma,
                               rejected_list: self.rejected_list, head: self.head,
                               head_at: self.head_at, head_until: self.head_until,
                               primed: self.primed, spine: self.spine_count,
                               literal_arm: self.literal_arm, head_brace: self.head_brace,
                               head_start: self.head_start, head_follow: self.head_follow,
                               shadow_brace: self.shadow_brace, lifted_brace: self.lifted_brace,
                               dropped: self.dropped)
        self.speculating = self.speculating + 1
        saved
    }

    // Undoes everything since `saved`: the nodes built, the tokens appended
    // and split, the alternatives seen and the levels taken.
    public func restore(&var self, saved: &Checkpoint) {
        self.builder.restore(&saved.tree)
        var k = self.edit_count
        while k > saved.edits {
            k = k - 1
            let edit = self.edits[k]
            self.tokens[edit.index] = edit.token
        }
        self.edit_count = saved.edits
        k = self.taken_count
        while k > saved.taken {
            k = k - 1
            let index = (self.taken[k] as UInt16) as Int
            self.seen[index] = false
        }
        self.taken_count = saved.taken
        self.token_count = saved.tokens
        self.piece_count = saved.pieces
        self.pos = saved.pos
        self.limit = saved.limit
        self.prev_end = saved.prev_end
        self.depth = saved.depth
        self.lists = saved.lists
        self.speculating = saved.speculating
        self.dropped = saved.dropped
        self.trailing_comma = saved.trailing_comma
        self.rejected_list = saved.rejected_list
        self.head = saved.head
        self.head_at = saved.head_at
        self.head_until = saved.head_until
        self.primed = saved.primed
        self.spine_count = saved.spine
        self.literal_arm = saved.literal_arm
        self.head_brace = saved.head_brace
        self.head_start = saved.head_start
        self.head_follow = saved.head_follow
        self.shadow_brace = saved.shadow_brace
        self.lifted_brace = saved.lifted_brace
    }

    // Keeps what the speculation since `saved` parsed.
    public func commit(&var self, saved: &Checkpoint) {
        self.builder.commit(&saved.tree)
        self.speculating = saved.speculating
    }

    // Closes the construct begun at `mark` into a node of `alt`'s Kind that
    // spans from `start` to the last token consumed.
    func close(&var self, mark: Int, alt: Alt, start: Int) {
        // Stage 0 workaround (SL:hazards S4): canonical: let _ = self.builder.close(mark, NodeShape.Built, alt, start, self.prev_end)
        let end = self.prev_end
        let _ = self.builder.close(mark, NodeShape.Built, alt, start, end)
    }

    // Closes a binary tier's flat node, which spans from its first operand. A
    // chain production builds its node only over a second operand, so a
    // caller closes one only once it has taken an operator.
    func close_chain(&var self, mark: Int, alt: Alt) {
        let first = self.builder.at(mark)
        let start = self.builder.node(first).start
        self.close(mark, alt, start)
    }

    // The scratch height the operand parsed next starts at, one slot lower
    // when a statement's leading chain is already there (`primed`).
    func operand_mark(&self) -> Int {
        if self.primed { self.builder.mark() - 1 } else { self.builder.mark() }
    }

    // Where the operand parsed next starts.
    func operand_start(&self) -> Int {
        if self.primed {
            let slot = self.builder.mark() - 1
            return self.builder.node_at(slot).start
        }
        self.here()
    }

    // ---- diagnostics --------------------------------------------------------

    // The one place a diagnostic is kept. Inside a speculation nothing is: a
    // speculation that fails is undone and its errors with it, and only
    // counted meanwhile (`dropped`).
    func record(&var self, d: Diagnostic) {
        if self.speculating == 0 {
            try! self.diagnostics.push(d)
        } else {
            self.dropped = self.dropped + 1
        }
    }

    func report(&var self, rule: Rule?, at: Int, message: String, hint: String) {
        let t = self.tokens[at]
        self.record(Diagnostic(rule: rule, start: t.start, end: t.end, message: message,
                               hint: hint))
    }

    // A plain parse error at the current token. Always false, so a method
    // reports and fails in one step. In a statement that re-read a generic
    // list its reading could have gone on with, the error is that rule's
    // refusal, at the list's `<` (syntax.rule.generic-or-less).
    func error(&var self, message: String) -> Bool {
        if self.head_restricted() {
            return self.refuse_head_restriction()
        }
        let list = self.rejected_list
        if list >= 0 && self.speculating == 0 {
            return self.refuse_rejected_list(list)
        }
        let brace = self.literal_arm
        if brace >= 0 && self.speculating == 0 {
            self.literal_arm = -1
            return self.refuse(Rule.Rule_ArmBody, brace,
                               "an arm body that starts with `\{` is a block",
                               "parenthesize a map or set literal: `case _ -> (\{a: 1\})`")
        }
        // Stage 0 workaround (SL:hazards S4): canonical: self.report(None, self.pos, message, "")
        let at = self.pos
        self.report(None, at, message, "")
        false
    }

    // The refusal of the generic list at `at`, which parsed and was re-read as
    // comparisons, when that reading fails and its own would have gone on.
    func refuse_rejected_list(&var self, at: Int) -> Bool {
        self.rejected_list = -1
        self.refuse(Rule.Rule_GenericOrLess, at, "these generic arguments are read as comparisons",
                    "a generic list is kept before `(`, `.` or `\{`; parenthesize a comparison")
    }

    // The lexer's refusal, at byte `at`: the whole parse, since the lexer
    // stops at its first error. `rule` is the name the lexer gives it, which
    // is a section 2.7 rule's or else no refusal's (`parse-error`, or a
    // token production's), and is reported as a plain parse error.
    public func lex_error(&var self, at: Int, message: String, rule: String, hint: String) {
        self.record(Diagnostic(rule: rule_named(rule), start: at, end: at, message: message,
                               hint: hint))
    }

    // A refusal named by `rule`, at the token `at`. A rule that refuses a
    // reading the head restriction also refuses gives way to it
    // (syntax.rule.head-restriction).
    func refuse(&var self, rule: Rule, at: Int, message: String, hint: String) -> Bool {
        let yields = rule == Rule.Rule_TrailingClosure || rule == Rule.Rule_BlockTail
        if yields && self.head_restricted() {
            return self.refuse_head_restriction()
        }
        self.report(rule, at, message, hint)
        false
    }

    // Whether the statement's noted head, read with a trailing closure at the
    // `{` it stopped at, goes on to the token its construct takes next: then
    // the head restriction refuses what failed since, and outranks every
    // other rule that refuses it. The reading goes on only when it met no
    // error: a `match`'s arms read as the closure fail and recover to their
    // `}`, which is where a sound reading stops too. Tried only on the way to
    // a refusal, and undone whatever it finds.
    func head_restricted(&var self) -> Bool {
        let at = self.head_start
        if self.speculating > 0 || self.head_brace < 0 || at < 0 || at > self.limit {
            return false
        }
        let follow = self.head_follow
        let saved = self.checkpoint()
        let clean = self.dropped
        self.lifted_brace = self.head_brace
        self.pos = at
        self.head = HeadState.Lifted
        self.lists = 0
        self.primed = false
        // The reading takes a level of its own, so that the refusal it runs
        // under never recurs through it uncharged.
        var goes = self.enter_level(at)
        if goes {
            goes = self.parse_expr()
        }
        // A borrow binding's head goes on to the next binding's `,` or to the
        // body's `{`, which `,` stands for.
        let listed = follow == TokenKind.Comma && self.kind() == TokenKind.Comma
        if goes && not listed && follow != TokenKind.Arrow {
            self.skip_newlines()
        }
        let next = if follow == TokenKind.Comma && not listed { TokenKind.LBrace } else { follow }
        goes = goes && self.kind() == next && self.dropped == clean
        self.restore(&saved)
        goes
    }

    func refuse_head_restriction(&var self) -> Bool {
        let at = self.head_brace
        self.head_brace = -1
        self.report(Rule.Rule_HeadRestriction, at,
                    "a `\{` after a head's outer level begins the body, so no trailing closure attaches there",
                    "pass the closure in parentheses: `f(\{ … \})`")
        false
    }

    // Skips what is left of a construct that failed, from the token it started
    // at: forward to the line break or `;` that ends it at its own bracket
    // depth, or to the `}` or end of input that ends what holds it. A closer
    // ends only a bracket of its own kind, so an unclosed `(` never swallows
    // the block's `}`, and a `)` or `]` that closes nothing is stray.
    func recover(&var self, from: Int) {
        var open = Vector<TokenKind>()
        var depth = 0
        var k = from
        while k < self.pos {
            depth = track_bracket(&var open, depth, self.tokens[k].kind)
            k = k + 1
        }
        while self.kind() != TokenKind.Eof {
            let kind = self.kind()
            let boundary = kind == TokenKind.Newline || kind == TokenKind.Semicolon
            if depth == 0 && boundary {
                return
            }
            if kind == TokenKind.RBrace && (depth == 0 || open[depth - 1] != TokenKind.LBrace) {
                return
            }
            depth = track_bracket(&var open, depth, kind)
            self.advance()
        }
    }

    // ---- the depth funnel -----------------------------------------------------

    // The one depth funnel. Each construct GRAMMAR.md section 11 charges takes
    // its level here, at its opener, and gives it back with `leave_level` when
    // it ends; the 257th level is refused at the opener that would take it.
    // A failed construct gives nothing back: the recovery loop that catches it
    // restores the depth it saved, as a failed speculation's restore does.
    // Every recursion passes through here, which compiler/tools/depth_funnel.py
    // checks against this list; so a speculation nested in another is charged
    // at least the generic list that holds it.
    // ENTRY POINTS:
    //     parse_paren
    //     parse_module
    //     parse_cast
    //     parse_prefix_operator
    //     parse_bracket
    //     parse_postfix
    //     parse_try
    //     parse_interp
    //     parse_ref_type
    //     parse_slice_type
    //     parse_array_type
    //     parse_func_type
    //     parse_paren_type
    //     parse_generic_params
    //     parse_generic_args
    //     parse_const_negate
    //     parse_const_group
    //     parse_try_block
    //     parse_if
    //     parse_guard
    //     parse_while
    //     parse_for
    //     parse_match
    //     parse_tuple_pattern
    //     parse_variant_pattern
    //     parse_brace
    //     parse_closure_literal
    //     head_restricted
    //     parse_payload_decl
    //     parse_move
    //     parse_borrow_place
    //     parse_borrow_block
    //     parse_test_group
    func enter_level(&var self, opener: Int) -> Bool {
        if self.depth >= PARSE_MAX_DEPTH {
            self.depth_refusals = self.depth_refusals + 1
            self.depth_opener = opener
            return self.refuse_depth(opener)
        }
        self.depth = self.depth + 1
        true
    }

    // Reported directly: the depth budget decides no reading, so no other
    // rule's refusal replaces it.
    func refuse_depth(&var self, opener: Int) -> Bool {
        self.report(Rule.Rule_DepthLimit, opener, "nesting exceeds the parser depth limit (256)",
                    "split the expression or the declaration into smaller ones")
        false
    }

    func leave_level(&var self) {
        self.depth = self.depth - 1
    }

    // ---- doc comments ---------------------------------------------------------

    func find_doc_runs(&var self) {
        var i = 0
        var k = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if not d.kind.equals("doc") {
                i = i + 1
                continue
            }
            var last = i
            while last + 1 < self.docs.len() {
                let next = self.docs[last + 1]
                let current = self.docs[last]
                if not next.kind.equals("doc") || next.line != current.line + 1 {
                    break
                }
                last = last + 1
            }
            let end_line = self.docs[last].line
            while k < self.token_count && (self.tokens[k].line <= end_line
                                         || self.tokens[k].kind == TokenKind.Newline) {
                k = k + 1
            }
            let target = if k < self.token_count { k } else { self.token_count - 1 }
            try! self.runs.push(DocRun(first: i, last: last, target: target, attached: false))
            i = last + 1
        }
    }

    // A doc line's text: what follows its three-character marker and one
    // space, if there is one.
    func doc_line_span_start(&self, d: &DocComment) -> Int {
        let at = self.builder.tree.source.offset_of(d.line, d.col) + 3
        if at < self.builder.tree.source.len() && self.builder.tree.source.byte(at) == PARSE_SPACE {
            at + 1
        } else {
            at
        }
    }

    // The Doc node of docs[first..last], pushed as a child of the construct
    // under way. Returns where it starts.
    func doc_node(&var self, first: Int, last: Int) -> Int {
        let mark = self.builder.mark()
        let d0 = self.docs[first]
        let start = self.builder.tree.source.offset_of(d0.line, d0.col)
        var end = start
        var i = first
        while i <= last {
            let d = self.docs[i]
            let text_start = self.doc_line_span_start(&d)
            end = text_start + d.text.len()
            let _ = self.builder.leaf(NodeShape.DocLine, text_start, end)
            i = i + 1
        }
        let _ = self.builder.close(mark, NodeShape.Doc, None, start, end)
        start
    }

    // Attaches the doc run that documents the declaration starting at token
    // `first`, if there is one, and returns where the declaration's span
    // starts: at its doc comment, or at its first token.
    func attach_docs(&var self, first: Int) -> Int {
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if run.target == first {
                // A restore does not return the runs to an earlier state, so
                // none may be attached inside a speculation (SPECULATION LEDGER).
                assert(self.speculating == 0, "parse: a doc run attached inside a speculation")
                self.runs[r] = DocRun(first: run.first, last: run.last, target: run.target,
                                      attached: true)
                return self.doc_node(run.first, run.last)
            }
            r = r + 1
        }
        self.tokens[first].start
    }

    // The file's `//!` lines, as the File node's first child.
    func module_docs(&var self) {
        var first = -1
        var last = -1
        var i = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if d.kind.equals("module") {
                if first < 0 {
                    first = i
                }
                last = i
            }
            i = i + 1
        }
        if first < 0 {
            return
        }
        let mark = self.builder.mark()
        let d0 = self.docs[first]
        let start = self.builder.tree.source.offset_of(d0.line, d0.col)
        var end = start
        i = first
        while i <= last {
            let d = self.docs[i]
            if d.kind.equals("module") {
                let text_start = self.doc_line_span_start(&d)
                end = text_start + d.text.len()
                let _ = self.builder.leaf(NodeShape.DocLine, text_start, end)
            }
            i = i + 1
        }
        let _ = self.builder.close(mark, NodeShape.Doc, None, start, end)
    }

    // A `//!` line after the file's first token (syntax.lex.module-doc).
    func check_module_docs(&var self) {
        var k = 0
        while k < self.token_count && self.tokens[k].kind == TokenKind.Newline {
            k = k + 1
        }
        if k >= self.token_count || self.tokens[k].kind == TokenKind.Eof {
            return
        }
        let first_line = self.tokens[k].line
        var i = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if d.kind.equals("module") && d.line > first_line {
                let at = self.builder.tree.source.offset_of(d.line, d.col)
                self.record(Diagnostic(rule: Rule.Lex_ModuleDoc, start: at, end: at + 3,
                                       message: "a `//!` comment stands only before the file's first token",
                                       hint: "make it a `//` comment, or move it to the top"))
                return
            }
            i = i + 1
        }
    }

    // A `///` run that documents nothing (syntax.lex.doc-attach).
    func check_doc_runs(&var self) {
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if not run.attached {
                self.report_doc_run(&run)
            }
            r = r + 1
        }
    }

    func report_doc_run(&var self, run: &DocRun) {
        let d = self.docs[run.first]
        let at = self.builder.tree.source.offset_of(d.line, d.col)
        let earlier = self.documenting_run(run.target, run.first)
        if earlier >= 0 {
            let e = self.docs[earlier]
            var message = StringBuilder()
            try! message.append("this declaration already has a doc comment, at ")
            try! message.append(e.line)
            try! message.append(":")
            try! message.append(e.col)
            try! message.append("; a declaration takes one")
            self.record(Diagnostic(rule: Rule.Lex_DocAttach, start: at, end: at + 3,
                                   message: message.build(),
                                   hint: "join the two runs, or make one a `//` comment"))
            return
        }
        self.record(Diagnostic(rule: Rule.Lex_DocAttach, start: at, end: at + 3,
                               message: "this doc comment documents no declaration",
                               hint: "make it a `//` comment, or move it before a declaration"))
    }

    // The first doc line of another run attached to the declaration at token
    // `target` than the one starting at doc line `own`, or -1 when none is. A
    // declaration takes one run, so a later run reaching it is refused as a
    // second one (syntax.lex.doc-attach). A run refused before a test head is
    // marked attached too, which `own` keeps from answering for itself.
    func documenting_run(&self, target: Int, own: Int) -> Int {
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if run.attached && run.target == target && run.first != own {
                return run.first
            }
            r = r + 1
        }
        return -1
    }

    // A test case or group is never documented (GRAMMAR.md section 2.6), which
    // its head decides, so a run before one is refused there, ahead of
    // anything the rest of the file holds (syntax.lex.doc-attach).
    func refuse_documented_test(&var self) {
        let breaks = self.breaks_ahead(2)
        let group = self.kind_at(2 + breaks) == TokenKind.LBrace
        let case_head = self.kind_at(2) == TokenKind.StringLit || self.kind_at(2) == TokenKind.LParen
        if not (group || case_head) {
            return
        }
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if run.target == self.pos && not run.attached {
                self.runs[r] = DocRun(first: run.first, last: run.last, target: run.target,
                                      attached: true)
                self.report_doc_run(&run)
                return
            }
            r = r + 1
        }
    }

    // ---- files ----------------------------------------------------------------

    // `source-file ::= NEWLINE* top-level-list? EOF`
    public func parse_file(&var self) {
        self.check_module_docs()
        self.check_brackets()
        self.see(Alt.File_Source)
        let mark = self.builder.mark()
        self.module_docs()
        self.skip_newlines()
        self.parse_items(false)
        let end = self.builder.tree.source.len()
        let _ = self.builder.close(mark, NodeShape.Built, Alt.File_Source, 0, end)
        self.finish()
    }

    // `refusal-unit ::= NEWLINE* ( refusal-unit-item ( stmt-sep refusal-unit-item )* NEWLINE* )? EOF`,
    // the body of a refusal case parsed on its own in a test build.
    public func parse_refusal_unit(&var self) {
        self.check_module_docs()
        self.check_brackets()
        self.see(Alt.Test_RefusalUnit)
        let mark = self.builder.mark()
        self.skip_newlines()
        self.parse_unit_items()
        let end = self.builder.tree.source.len()
        let _ = self.builder.close(mark, NodeShape.Built, Alt.Test_RefusalUnit, 0, end)
        self.finish()
    }

    func finish(&var self) {
        if self.diagnostics.len() == 0 {
            self.check_doc_runs()
        }
        // Stage 0 workaround (SL:hazards S4): canonical: trim_to(&var self.taken, self.taken_count)
        let used = self.taken_count
        trim_to(&var self.taken, used)
        self.builder.finish()
    }

    // `top-level-list ::= top-level-item ( NEWLINE+ top-level-item )* NEWLINE*`,
    // inside an inline module when `inline`, which a `}` closes.
    func parse_items(&var self, inline: Bool) {
        var any = false
        while true {
            let kind = self.kind()
            if kind == TokenKind.Eof || (inline && kind == TokenKind.RBrace) {
                break
            }
            if not any {
                self.see(Alt.File_List)
                any = true
            }
            let from = self.pos
            let point = self.resume_point()
            self.begin_statement()
            if not self.parse_item() {
                self.resume(&point)
                self.recover(from)
            }
            let after = self.kind()
            if after == TokenKind.Newline {
                self.skip_newlines()
            } else if after == TokenKind.Eof || (inline && after == TokenKind.RBrace) {
                break
            } else {
                let from_here = self.pos
                if after == TokenKind.Semicolon {
                    let _ = self.error("declarations are not joined by `;`; put each on its own line")
                } else {
                    let _ = self.error("two declarations on one line need a line break between them")
                }
                self.recover(from_here)
                if self.kind() == TokenKind.Semicolon || (not inline && self.kind() == TokenKind.RBrace) {
                    self.advance()
                }
                self.skip_newlines()
            }
        }
    }

    // Whether the current token begins a top-level item rather than a
    // statement, which is how a refusal unit tells its two kinds of item apart.
    func starts_item(&self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.At {
            let attrs = self.after_attributes(0)
            let after = self.kind_at(attrs)
            return after != TokenKind.Let && after != TokenKind.Var
        }
        if is_declaration_keyword(kind) {
            return true
        }
        if kind == TokenKind.Ident && self.kind_at(1) == TokenKind.Ident {
            let module = self.word_at(0, "import") || self.word_at(0, "module")
            return module || self.word_at(0, "export")
        }
        false
    }

    // `top-level-item`: an import, a module, or a declaration.
    func parse_item(&var self) -> Bool {
        if self.kind() == TokenKind.At && self.word_at(1, "test") {
            self.refuse_documented_test()
            self.see(Alt.File_Item_Test)
            return self.parse_test_item()
        }
        // Nothing else starts with `import` or `module` at an item's head, so
        // without a name after it what is missing is that name.
        if self.kind_at(1) != TokenKind.Ident && self.word_at(0, "import") {
            self.advance()
            return self.error("expected the path of the module to import")
        }
        if self.kind_at(1) != TokenKind.Ident && self.word_at(0, "module") {
            self.advance()
            return self.error("expected the module's name")
        }
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Ident {
            if self.word_at(0, "import") {
                self.see(Alt.File_Item_Import)
                return self.parse_import(false)
            }
            if self.word_at(0, "module") {
                self.see(Alt.File_Item_Module)
                return self.parse_module(false)
            }
            if self.word_at(0, "export") {
                let at = self.pos
                return self.refuse(Rule.Decl_RefusedExport, at,
                                   "an `export` declaration is not Saw's re-export",
                                   "write `public import m.\{name\}`, `public import m.\{name as alias\}` or `public import m.*`")
            }
        }
        if self.kind() == TokenKind.Public {
            if self.word_at(1, "import") {
                self.see(Alt.File_Item_Import)
                return self.parse_import(true)
            }
            if self.word_at(1, "module") && self.kind_at(2) == TokenKind.Ident {
                self.see(Alt.File_Item_Module)
                return self.parse_module(true)
            }
            let scoped = self.kind_at(1) == TokenKind.LParen && self.kind_at(2) == TokenKind.Ident
            if scoped && self.kind_at(3) == TokenKind.RParen && self.word_at(4, "import") {
                let at = self.pos
                return self.refuse(Rule.Decl_RefusedScopedImport, at,
                                   "an import takes no scoped visibility",
                                   "`public import` is the only re-export form: write `public import m`")
            }
        }
        if self.word_at(0, "static_assert") && self.kind_at(1) == TokenKind.LParen {
            self.see(Alt.File_Item_StaticAssert)
            return self.parse_static_assert()
        }
        self.parse_declaration(true)
    }

    // ---- tests -------------------------------------------------------------------

    // `test-item ::= test-case | test-group | test-only-decl`: after `@test`, a
    // string or `(` makes a case, `{` a group, and anything else makes the
    // declaration after it test-only (syntax.rule.test-form).
    func parse_test_item(&var self) -> Bool {
        let next = self.kind_at(2)
        if next == TokenKind.StringLit || next == TokenKind.LParen {
            self.see(Alt.Test_Item_Case)
            return self.parse_test_case()
        }
        let breaks = self.breaks_ahead(2)
        if self.kind_at(2 + breaks) == TokenKind.LBrace {
            self.see(Alt.Test_Item_Group)
            return self.parse_test_group()
        }
        self.see(Alt.Test_Item_Declaration)
        self.parse_test_only()
    }

    // `test-case`: `@test`, a clause in parentheses when it `panics:`, `warns:`
    // or `refuses:`, the case's name, and its body: a block, or for
    // `refuses:` a refusal body, matched by its braces only
    // (syntax.rule.refusal-body). The clause's words print, being the leaves
    // of productions that build no node.
    func parse_test_case(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.advance()
        var alt = Alt.Test_Case_Run
        if self.kind() == TokenKind.LParen {
            let open = self.pos
            self.advance()
            if let clause = self.parse_test_clause() {
                alt = clause
            } else {
                return false
            }
            if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `)` after the test's clause")
            }
            self.advance()
        }
        if self.kind() != TokenKind.StringLit {
            return self.error("expected the test case's name, a string")
        }
        self.take_leaf()
        self.skip_newlines()
        self.see(alt)
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the test case's body")
        }
        if alt == Alt.Test_Case_Refuses {
            if not self.parse_refusal_body() {
                return false
            }
        } else if not self.parse_block() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // The clause of a test case, from its first word: `panics:`, `warns:` or
    // `refuses:`, each with what follows it. Returns the case's alternative,
    // or None once it has reported an error.
    func parse_test_clause(&var self) -> Alt? {
        let keyed = self.kind_at(1) == TokenKind.Colon
        let named = keyed && self.kind_at(2) == TokenKind.StringLit
        if self.word_at(0, "panics") && named {
            self.take_leaf()
            self.advance()
            self.take_leaf()
            let text = self.parse_test_text()
            self.parse_test_at()
            if text {
                self.see(Alt.Test_Panics_Text)
                self.see(Alt.Test_PanicsText)
            } else {
                self.see(Alt.Test_Panics_Rule)
            }
            return Alt.Test_Case_Panics
        }
        if self.word_at(0, "warns") && keyed && (self.kind_at(2) == TokenKind.StringLit
                                                  || self.word_at(2, "none")) {
            let alt = if self.kind_at(2) == TokenKind.StringLit { Alt.Test_Warns_Key } else { Alt.Test_Warns_None }
            self.see(alt)
            self.take_leaf()
            self.advance()
            self.take_leaf()
            return Alt.Test_Case_Warns
        }
        if self.word_at(0, "refuses") && named {
            self.see(Alt.Test_Refuses)
            self.take_leaf()
            self.advance()
            self.take_leaf()
            let _ = self.parse_test_text()
            self.parse_test_at()
            return Alt.Test_Case_Refuses
        }
        let _ = self.error("expected `panics:`, `warns:` or `refuses:` and its string")
        None
    }

    // `test-text ::= "," 'text' ":" STRING`, if one stands here; whether it did.
    func parse_test_text(&var self) -> Bool {
        let keyed = self.word_at(1, "text") && self.kind_at(2) == TokenKind.Colon
        if self.kind() != TokenKind.Comma || not keyed || self.kind_at(3) != TokenKind.StringLit {
            return false
        }
        self.see(Alt.Test_Text)
        self.advance()
        self.take_leaf()
        self.advance()
        self.take_leaf()
        true
    }

    // `test-at ::= "," 'at' ":" INT`, if one stands here.
    func parse_test_at(&var self) {
        let keyed = self.word_at(1, "at") && self.kind_at(2) == TokenKind.Colon
        if self.kind() != TokenKind.Comma || not keyed || self.kind_at(3) != TokenKind.IntLit {
            return
        }
        self.see(Alt.Test_At)
        self.advance()
        self.take_leaf()
        self.advance()
        self.take_leaf()
    }

    // `refusal-body ::= "{" refusal-token* "}"`: every token between its braces
    // a leaf, line breaks and nested braces included, and two `<` or two `>`
    // written together the one leaf a shift is (syntax.lex.shift-adjacent).
    func parse_refusal_body(&var self) -> Bool {
        self.see(Alt.Test_RefusalBody)
        let start = self.here()
        let mark = self.builder.mark()
        let open = self.pos
        self.advance()
        var depth = 0
        while depth > 0 || self.kind() != TokenKind.RBrace {
            let kind = self.kind()
            if kind == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            if kind == TokenKind.LBrace {
                self.see(Alt.Test_RefusalToken_Nested)
                depth = depth + 1
            } else if kind == TokenKind.RBrace {
                depth = depth - 1
            } else {
                self.see(Alt.Test_RefusalToken_Other)
            }
            let t = self.current()
            let paired = kind == TokenKind.Lt || kind == TokenKind.Gt
            if paired && self.kind_at(1) == kind && self.tokens[self.pos + 1].start == t.end {
                self.advance()
                let end = self.current().end
                let _ = self.builder.leaf(NodeShape.Token, t.start, end)
                self.advance()
            } else {
                self.take_leaf()
            }
        }
        self.advance()
        self.close(mark, Alt.Test_RefusalBody, start)
        true
    }

    // `test-group ::= "@" 'test' NEWLINE* "{" NEWLINE* top-level-list? "}"`,
    // which holds declarations and cases, never statements, and charges one
    // level held to its `}`.
    func parse_test_group(&var self) -> Bool {
        self.see(Alt.Test_Group)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.advance()
        self.skip_newlines()
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.advance()
        self.skip_newlines()
        self.parse_items(true)
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.advance()
        self.leave_level()
        self.close(mark, Alt.Test_Group, start)
        true
    }

    // `test-only-decl ::= "@" 'test' NEWLINE* (declaration-item | import-decl)`.
    // A `///` run before the `@test` documents the declaration, as one after
    // it does (GRAMMAR.md section 2.6), so the node starts where that run does.
    func parse_test_only(&var self) -> Bool {
        let at = self.pos
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.advance()
        self.skip_newlines()
        let first = self.pos
        // A restore does not return the runs to an earlier state (SPECULATION LEDGER).
        assert(self.speculating == 0, "parse: a doc run retargeted inside a speculation")
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if run.target == at {
                self.runs[r] = DocRun(first: run.first, last: run.last, target: first,
                                      attached: run.attached)
            }
            r = r + 1
        }
        var alt = Alt.Test_Declaration_Item
        var ok = true
        if self.kind() == TokenKind.Ident && self.word_at(0, "import") && self.kind_at(1) == TokenKind.Ident {
            alt = Alt.Test_Declaration_Import
            ok = self.parse_import(false)
        } else if self.kind() == TokenKind.Public && self.word_at(1, "import") {
            alt = Alt.Test_Declaration_Import
            ok = self.parse_import(true)
        } else {
            ok = self.parse_declaration(false)
        }
        if not ok {
            return false
        }
        self.see(alt)
        let inner = self.builder.node_at(mark).start
        let from = if inner < start { inner } else { start }
        self.close(mark, alt, from)
        true
    }

    // `declaration-item`, with its doc comment, attributes and visibility
    // inside it, or a head GRAMMAR.md section 10 refuses. The head is read
    // ahead first, past its attributes and visibility, since which of them it
    // may carry, and whether a doc comment documents it, depend on what it
    // declares. `item` when it stands as a top-level item, not under `@test`.
    func parse_declaration(&var self, item: Bool) -> Bool {
        let first = self.pos
        let attrs = self.after_attributes(0)
        let k = self.after_visibility(attrs)
        let attributed = attrs > 0
        let visible = k > attrs
        let prefix = self.effect_prefix_at(attrs)
        if prefix >= 0 {
            return self.refuse_effect_prefix(prefix)
        }
        let head = first + k
        let kind = self.kind_at(k)
        if self.word_at(k, "const") && self.kind_at(k + 1) == TokenKind.Ident {
            return self.refuse(Rule.Decl_RefusedConst, head,
                               "a module constant is a `static`",
                               "write `static NAME: T = value` for `const`")
        }
        if self.word_at(0, "private") {
            return self.refuse(Rule.Decl_RefusedVisibilityPrefix, first,
                               "a declaration with no modifier is already module-private",
                               "delete `private`")
        }
        if kind == TokenKind.Extension && visible {
            return self.refuse(Rule.Decl_RefusedVisibilityPrefix, first + attrs,
                               "an extension has no name to be visible",
                               "put the visibility on each member instead")
        }
        let after = self.kind_at(k + 1)
        if kind == TokenKind.Unsafe_ && (after == TokenKind.Enum || after == TokenKind.Trait
                                          || after == TokenKind.Extension) {
            return self.refuse(Rule.Decl_RefusedUnsafePrefix, head,
                               "an enum, a trait or an extension is not unsafe as a whole",
                               "mark `unsafe` in the effect slot of each function that needs it")
        }
        let static_var = kind == TokenKind.Static && after == TokenKind.Var
        let unsafe_static = kind == TokenKind.Unsafe_ && after == TokenKind.Static
        if static_var || (unsafe_static && self.kind_at(k + 2) != TokenKind.Var) {
            return self.refuse(Rule.Decl_RefusedStatic, head,
                               "a mutable static is `unsafe static var`, and `unsafe` marks a mutable one",
                               "write `unsafe static var X: T = …`, or `static X: T = …`")
        }
        if kind == TokenKind.Extension && after == TokenKind.LBracket {
            return self.refuse(Rule.Decl_RefusedArrayExtension, head,
                               "a fixed array takes no extension",
                               "write a free function instead")
        }
        let alt = self.declaration_alt(k)
        if alt == Alt.File_Item_Declaration {
            return self.error("expected a declaration")
        }
        let mark = self.builder.mark()
        let start = if alt == Alt.Decl_Item_Extern { self.here() } else { self.attach_docs(first) }
        if item {
            self.see(Alt.File_Item_Declaration)
        }
        self.see(alt)
        if attributed && not self.parse_attributes(alt) {
            return false
        }
        if visible {
            if alt == Alt.Decl_Item_Extern {
                return self.error("an extern block takes no visibility")
            }
            if not self.parse_visibility() {
                return false
            }
        }
        if not self.parse_declared(alt) {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // The `declaration-item` alternative whose declaration begins `ahead`
    // tokens on, past its attributes and visibility, or `File_Item_Declaration`
    // when none does. At a top-level item `static` and a name declare a
    // static (syntax.rule.static-head).
    func declaration_alt(&self, ahead: Int) -> Alt {
        let kind = self.kind_at(ahead)
        let after = self.kind_at(ahead + 1)
        if kind == TokenKind.Func {
            return Alt.Decl_Item_Func
        }
        if kind == TokenKind.Static && after == TokenKind.Ident {
            return Alt.Decl_Item_Static
        }
        if kind == TokenKind.Unsafe_ && after == TokenKind.Static {
            return Alt.Decl_Item_Static
        }
        if kind == TokenKind.Struct || ((kind == TokenKind.Unsafe_ || kind == TokenKind.Borrows)
                                        && after == TokenKind.Struct) {
            return Alt.Decl_Item_Struct
        }
        if kind == TokenKind.Enum {
            return Alt.Decl_Item_Enum
        }
        if kind == TokenKind.Trait {
            return Alt.Decl_Item_Trait
        }
        if kind == TokenKind.Extension {
            return Alt.Decl_Item_Extension
        }
        if kind == TokenKind.Extern {
            return Alt.Decl_Item_Extern
        }
        if self.word_at(ahead, "type") && after == TokenKind.Ident {
            return Alt.Decl_Item_TypeAlias
        }
        Alt.File_Item_Declaration
    }

    // The declaration a `declaration-item` alternative names, its attributes
    // and visibility already parsed.
    func parse_declared(&var self, alt: Alt) -> Bool {
        match alt {
            case Decl_Item_Func -> self.parse_func(),
            case Decl_Item_Static -> self.parse_static(),
            case Decl_Item_Struct -> self.parse_struct(),
            case Decl_Item_Enum -> self.parse_enum(),
            case Decl_Item_Trait -> self.parse_trait(),
            case Decl_Item_Extension -> self.parse_extension(),
            case Decl_Item_Extern -> self.parse_extern_block(),
            case _ -> self.parse_type_alias()
        }
    }

    // ---- declaration heads --------------------------------------------------

    // How many tokens on the attribute list that begins `ahead` tokens on
    // ends, counted as `ahead` is: each attribute an `@`, its name, a
    // parenthesized argument, and the line breaks after it.
    func after_attributes(&self, ahead: Int) -> Int {
        var k = ahead
        while self.kind_at(k) == TokenKind.At {
            k = k + 1
            if self.kind_at(k) == TokenKind.Ident {
                k = k + 1
            }
            if self.kind_at(k) == TokenKind.LParen {
                var depth = 0
                while self.kind_at(k) != TokenKind.Eof {
                    let kind = self.kind_at(k)
                    k = k + 1
                    if kind == TokenKind.LParen {
                        depth = depth + 1
                    } else if kind == TokenKind.RParen {
                        depth = depth - 1
                        if depth == 0 {
                            break
                        }
                    }
                }
            }
            k = k + self.breaks_ahead(k)
        }
        k
    }

    // How many tokens on the visibility that begins `ahead` tokens on ends,
    // or `ahead` when none stands there.
    func after_visibility(&self, ahead: Int) -> Int {
        if self.kind_at(ahead) != TokenKind.Public {
            return ahead
        }
        let scoped = self.word_at(ahead + 2, "package") || self.word_at(ahead + 2, "parent")
        let closed = self.kind_at(ahead + 3) == TokenKind.RParen
        if self.kind_at(ahead + 1) == TokenKind.LParen && scoped && closed {
            return ahead + 4
        }
        ahead + 1
    }

    // Whether the token `ahead` on is a word a declaration head holds only to
    // refuse it, before `func` or `init` (syntax.decl.refused-effect-prefix).
    func is_prefix_effect(&self, ahead: Int) -> Bool {
        let kind = self.kind_at(ahead)
        if kind == TokenKind.Unsafe_ || kind == TokenKind.Borrows {
            return true
        }
        let word = self.word_at(ahead, "sync") || self.word_at(ahead, "constexpr")
        word || self.word_at(ahead, "consumes") || self.word_at(ahead, "const")
    }

    // The token of the first effect word of a head, from `ahead` tokens on,
    // that writes its effects before `func` or `init`, or -1: visibilities
    // and `static`, an effect word, then any of the three, up to `func` or
    // `init`. A contextual word counts only before one of those tokens
    // (syntax.rule.contextual-words), which the run up to `func` or `init`
    // guarantees.
    func effect_prefix_at(&self, ahead: Int) -> Int {
        var k = ahead
        var found = -1
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Public {
                k = self.after_visibility(k)
            } else if kind == TokenKind.Static {
                k = k + 1
            } else if self.is_prefix_effect(k) {
                if found < 0 {
                    found = k
                }
                k = k + 1
            } else {
                break
            }
        }
        let end = self.kind_at(k)
        if found >= 0 && (end == TokenKind.Func || end == TokenKind.Init) {
            return self.pos + found
        }
        return -1
    }

    func refuse_effect_prefix(&var self, at: Int) -> Bool {
        self.refuse(Rule.Decl_RefusedEffectPrefix, at,
                    "a function's effects are written after its parameters",
                    "move the word into the effect slot: `func f(…) unsafe -> T`, or `constexpr` for `const`")
    }

    // ---- attributes -----------------------------------------------------------

    // `attribute-list ::= attribute+` on the declaration `host` names: each
    // attribute on a declaration it may stand on, and once
    // (syntax.rule.attribute-position).
    func parse_attributes(&var self, host: Alt) -> Bool {
        self.see(Alt.Attr_List)
        var seen = 0
        while self.kind() == TokenKind.At {
            let at = self.pos
            if not self.parse_attribute() {
                return false
            }
            let slot = self.builder.mark() - 1
            var bit = 1
            if let alt = self.builder.node_at(slot).alt {
                bit = attribute_bit(alt)
            }
            let allowed = attribute_hosts(host)
            if allowed == 0 {
                return self.report_plain(at, "this declaration takes no attribute")
            }
            if (allowed / bit) % 2 == 0 || (seen / bit) % 2 == 1 {
                return self.refuse(Rule.Rule_AttributePosition, at,
                                   "this attribute does not stand here, or stands here twice",
                                   "`@export` and `@section` go on a function or a static, `@align` on a static or a local, `@synthesize` on an extension")
            }
            seen = seen + bit
        }
        true
    }

    // A plain parse error at token `at`, rather than the current token.
    func report_plain(&var self, at: Int, message: String) -> Bool {
        self.report(None, at, message, "")
        false
    }

    // `attribute ::= "@" 'export' | "@" 'export' "(" STRING ")" | "@" 'section' "(" STRING ")"
    //     | "@" 'synthesize' | "@" 'align' "(" expr ")" | synthesize-shared-attr`,
    // each followed by any line breaks.
    func parse_attribute(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Attr_Attribute_Export
        if self.synthesize_shared_ahead() {
            alt = Alt.Attr_Attribute_SynthesizeShared
            self.see(alt)
            self.take_synthesize_shared()
            self.close(mark, alt, start)
            self.skip_newlines()
            return true
        }
        self.advance()
        let argument = self.kind_at(1) == TokenKind.LParen
        if self.word_at(0, "export") {
            alt = if argument { Alt.Attr_Attribute_ExportSymbol } else { Alt.Attr_Attribute_Export }
        } else if self.word_at(0, "section") && argument {
            alt = Alt.Attr_Attribute_Section
        } else if self.word_at(0, "synthesize") && not argument {
            alt = Alt.Attr_Attribute_Synthesize
        } else if self.word_at(0, "align") && argument {
            alt = Alt.Attr_Attribute_Align
        } else {
            return self.error("expected `export`, `section`, `synthesize` or `align` after `@`")
        }
        self.advance()
        if argument {
            let open = self.pos
            self.advance()
            if alt == Alt.Attr_Attribute_Align {
                if not self.parse_expr() {
                    return false
                }
            } else if self.kind() == TokenKind.StringLit {
                self.take_leaf()
            } else {
                return self.list_error(open, "expected the attribute's string")
            }
            if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `)` after the attribute's argument")
            }
            self.advance()
        }
        self.see(alt)
        self.close(mark, alt, start)
        self.skip_newlines()
        true
    }

    // Whether `@synthesize(shared)` stands here.
    func synthesize_shared_ahead(&self) -> Bool {
        let named = self.kind() == TokenKind.At && self.word_at(1, "synthesize")
        let opened = named && self.kind_at(2) == TokenKind.LParen
        opened && self.word_at(3, "shared") && self.kind_at(4) == TokenKind.RParen
    }

    // `synthesize-shared-attr ::= "@" 'synthesize' "(" 'shared' ")" NEWLINE*`,
    // whose two words are leaves of the node around it; the line breaks after
    // it are its caller's.
    func take_synthesize_shared(&var self) {
        self.see(Alt.Attr_SynthesizeShared)
        self.advance()
        self.take_leaf()
        self.advance()
        self.take_leaf()
        self.advance()
    }

    // ---- statics, structs and enums ---------------------------------------------

    // `static-decl ::= "static" IDENT ":" type static-init?
    //     | "unsafe" "static" "var" IDENT ":" type static-init?`
    func parse_static(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Decl_Static_Immutable
        if self.kind() == TokenKind.Unsafe_ {
            alt = Alt.Decl_Static_UnsafeVar
            self.advance()
            self.advance()
        }
        self.advance()
        self.see(alt)
        if self.kind() != TokenKind.Ident {
            return self.error("expected the static's name")
        }
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the static's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        if self.kind() == TokenKind.Assign {
            self.see(Alt.Decl_StaticInit)
            self.take_leaf()
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, alt, start)
        true
    }

    // The `{` that opens a declaration's body, on its head's line or after
    // line breaks, which it consumes with the line breaks after it; returns
    // the `{` or -1 once it has reported its absence.
    func open_body(&var self, message: String) -> Int {
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            let _ = self.error(message)
            return -1
        }
        let open = self.pos
        self.advance()
        self.skip_newlines()
        open
    }

    // `struct-decl ::= struct-modifier? "struct" IDENT generic-params? NEWLINE* "{" NEWLINE* field-list? "}"`
    func parse_struct(&var self) -> Bool {
        self.see(Alt.Decl_Struct)
        let start = self.here()
        let mark = self.builder.mark()
        if self.kind() == TokenKind.Unsafe_ {
            self.see(Alt.Decl_StructModifier_Unsafe)
            self.take_leaf()
        } else if self.kind() == TokenKind.Borrows {
            self.see(Alt.Decl_StructModifier_Borrows)
            self.take_leaf()
        }
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the struct's name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        let open = self.open_body("expected `\{` to open the struct's fields")
        if open < 0 {
            return false
        }
        if self.kind() != TokenKind.RBrace {
            self.see(Alt.Decl_Fields)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.Fields), open, false, &var count) {
            return false
        }
        self.advance()
        self.close(mark, Alt.Decl_Struct, start)
        true
    }

    // `field ::= field-visibility? IDENT ":" type`, with its doc comment;
    // `private` is the field's visibility only before a name
    // (syntax.rule.contextual-words).
    func parse_field(&var self) -> Bool {
        let first = self.pos
        let mark = self.builder.mark()
        let start = self.attach_docs(first)
        if self.kind() == TokenKind.Public {
            self.see(Alt.Decl_FieldVisibility_Public)
            if not self.parse_visibility() {
                return false
            }
        } else if self.word_at(0, "private") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.Decl_FieldVisibility_Private)
            self.take_leaf()
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected a field's name")
        }
        self.see(Alt.Decl_Field)
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the field's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_Field, start)
        true
    }

    // `enum-decl ::= "enum" IDENT generic-params? raw-backing? NEWLINE* "{" NEWLINE* case-list? "}"`
    func parse_enum(&var self) -> Bool {
        self.see(Alt.Decl_Enum)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the enum's name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Decl_RawBacking)
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        let open = self.open_body("expected `\{` to open the enum's cases")
        if open < 0 {
            return false
        }
        if self.kind() != TokenKind.RBrace {
            self.see(Alt.Decl_Cases)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.Cases), open, false, &var count) {
            return false
        }
        self.advance()
        self.close(mark, Alt.Decl_Enum, start)
        true
    }

    // `enum-case ::= "case" IDENT payload-decl? raw-value?`, with its doc
    // comment; `raw-value ::= "=" expr`, whose `=` prints.
    func parse_enum_case(&var self) -> Bool {
        if self.kind() != TokenKind.Case {
            return self.error("expected `case` and the case's name")
        }
        let first = self.pos
        let mark = self.builder.mark()
        let start = self.attach_docs(first)
        self.see(Alt.Decl_Case)
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the case's name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.LParen {
            if not self.parse_payload_decl() {
                return false
            }
        }
        if self.kind() == TokenKind.Assign {
            self.see(Alt.Decl_RawValue)
            self.take_leaf()
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, Alt.Decl_Case, start)
        true
    }

    // `payload-decl ::= "(" ( payload-field ( "," payload-field )* ","? )? ")"`,
    // whose parentheses print, so that `case A()` differs from `case A`. It
    // charges a level for its `(`, as a variant pattern's payload does, which
    // GRAMMAR.md section 11 does not list: the case list and the payload list
    // share the one comma funnel, so the call graph holds a cycle through it
    // that only a charge breaks (SL-424).
    func parse_payload_decl(&var self) -> Bool {
        self.see(Alt.Decl_Payload)
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.take_leaf()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.PayloadFields), open, false, &var count) {
            return false
        }
        self.take_leaf()
        self.leave_level()
        true
    }

    // `payload-field ::= IDENT ":" type`
    func parse_payload_field(&var self, open: Int) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.list_error(open, "expected a payload field's name")
        }
        self.see(Alt.Decl_PayloadField)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the payload field's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_PayloadField, start)
        true
    }

    // ---- traits and extensions ---------------------------------------------------

    // `trait-decl ::= "trait" IDENT generic-params? trait-parents? NEWLINE* "{" NEWLINE* trait-member-list? "}"`,
    // with `trait-parents ::= ":" path ( "," path )*`.
    func parse_trait(&var self) -> Bool {
        self.see(Alt.Decl_Trait)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the trait's name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Decl_TraitParents)
            let colon = self.pos
            self.advance()
            var count = no_elements()
            if not self.parse_comma_list(list_shape(CommaList.TraitParents), colon, false, &var count) {
                return false
            }
        }
        let open = self.open_body("expected `\{` to open the trait's members")
        if open < 0 {
            return false
        }
        if not self.parse_members(MemberBody.Trait, open) {
            return false
        }
        self.close(mark, Alt.Decl_Trait, start)
        true
    }

    // `extension-decl ::= "extension" path generic-params? conformance-list? NEWLINE* "{" NEWLINE* extension-member-list? "}"`,
    // with `conformance-list ::= ":" path ( "," path )*`.
    func parse_extension(&var self) -> Bool {
        self.see(Alt.Decl_Extension)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_path() {
            return false
        }
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Decl_Conformances)
            let colon = self.pos
            self.advance()
            var count = no_elements()
            if not self.parse_comma_list(list_shape(CommaList.Conformances), colon, false, &var count) {
                return false
            }
        }
        let open = self.open_body("expected `\{` to open the extension's members")
        if open < 0 {
            return false
        }
        if not self.parse_members(MemberBody.Extension, open) {
            return false
        }
        self.close(mark, Alt.Decl_Extension, start)
        true
    }

    // A trait's, an extension's or an extern block's members after its `{`
    // and the line breaks after that, up to and with its `}`: one per line,
    // never joined by `;` (syntax.rule.declaration-separator). A member that
    // fails is skipped to the end of its line, as a top-level item is.
    func parse_members(&var self, body: MemberBody, open: Int) -> Bool {
        var any = false
        while self.kind() != TokenKind.RBrace {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            if not any {
                self.see(member_list_alt(body))
                any = true
            }
            let from = self.pos
            let point = self.resume_point()
            self.begin_statement()
            if not self.parse_member(body) {
                self.resume(&point)
                self.recover(from)
            }
            let after = self.kind()
            if after == TokenKind.Newline {
                self.skip_newlines()
            } else if after != TokenKind.RBrace && after != TokenKind.Eof {
                let from_here = self.pos
                if after == TokenKind.Semicolon {
                    let _ = self.error("members are not joined by `;`; put each on its own line")
                } else {
                    let _ = self.error("two members on one line need a line break between them")
                }
                self.recover(from_here)
                if self.kind() == TokenKind.Semicolon {
                    self.advance()
                }
                self.skip_newlines()
            }
        }
        self.advance()
        true
    }

    func parse_member(&var self, body: MemberBody) -> Bool {
        match body {
            case Trait -> self.parse_trait_member(),
            case Extension -> self.parse_extension_member(),
            case Extern -> self.parse_extern_func()
        }
    }

    // `trait-member ::= assoc-type-decl | requirement`, or a head section 10
    // refuses.
    func parse_trait_member(&var self) -> Bool {
        let attrs = self.after_attributes(0)
        let prefix = self.effect_prefix_at(attrs)
        if prefix >= 0 {
            return self.refuse_effect_prefix(prefix)
        }
        let next = self.kind_at(1)
        if self.word_at(0, "private") && (next == TokenKind.Static || next == TokenKind.Func) {
            return self.refuse_member_private()
        }
        if self.word_at(0, "type") && next == TokenKind.Ident {
            self.see(Alt.Decl_TraitMember_AssocType)
            self.see(Alt.Decl_AssocType)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            self.take_leaf()
            self.close(mark, Alt.Decl_AssocType, start)
            return true
        }
        if self.kind() == TokenKind.Func || (self.kind() == TokenKind.Static && next == TokenKind.Func) {
            self.see(Alt.Decl_TraitMember_Requirement)
            return self.parse_requirement()
        }
        self.error("expected a requirement or an associated type")
    }

    func refuse_member_private(&var self) -> Bool {
        let at = self.pos
        self.refuse(Rule.Decl_RefusedMemberPrivate, at,
                    "a member with no modifier is already module-private",
                    "delete `private`; it narrows only a field")
    }

    // `requirement ::= "static"? "func" IDENT generic-params? "(" param-list? ")" effect-slot return-clause? default-body?`,
    // with its doc comment; `default-body ::= NEWLINE* block`.
    func parse_requirement(&var self) -> Bool {
        self.see(Alt.Decl_Requirement)
        let head = self.pos
        let mark = self.builder.mark()
        let start = self.attach_docs(head)
        let is_static = self.kind() == TokenKind.Static
        if is_static {
            self.take_leaf()
        }
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the requirement's name")
        }
        self.take_leaf()
        if not self.parse_signature(not is_static, head, EffectHost.Requirement) {
            return false
        }
        if self.body_ahead() {
            self.see(Alt.Decl_DefaultBody)
            self.skip_newlines()
            if not self.parse_block() {
                return false
            }
        }
        self.close(mark, Alt.Decl_Requirement, start)
        true
    }

    // `extension-member ::= type-assign-decl | visibility? method-decl
    //     | synthesize-shared-attr visibility? method-decl | visibility? init-decl`,
    // or a head section 10 refuses, with the member's doc comment.
    func parse_extension_member(&var self) -> Bool {
        let attrs = self.after_attributes(0)
        let prefix = self.effect_prefix_at(attrs)
        if prefix >= 0 {
            return self.refuse_effect_prefix(prefix)
        }
        let next = self.kind_at(1)
        if self.word_at(0, "private") && (next == TokenKind.Static || next == TokenKind.Func) {
            return self.refuse_member_private()
        }
        if self.kind() == TokenKind.Static && (next == TokenKind.Init || next == TokenKind.Public) {
            let at = self.pos
            return self.refuse(Rule.Decl_RefusedMemberStatic, at,
                               "an initializer takes no receiver by construction, and `static` follows the visibility",
                               "write `init(…)`, or `public static func`")
        }
        let first = self.pos
        let mark = self.builder.mark()
        if self.word_at(0, "type") && next == TokenKind.Ident {
            self.see(Alt.Decl_ExtensionMember_TypeAssign)
            let start = self.here()
            if not self.parse_type_assign() {
                return false
            }
            self.close(mark, Alt.Decl_ExtensionMember_TypeAssign, start)
            return true
        }
        let synthesized = self.kind() == TokenKind.At
        if synthesized && not self.synthesize_shared_ahead() {
            return self.error("a member takes no attribute but `@synthesize(shared)`")
        }
        let named = self.after_visibility(attrs)
        let head = self.kind_at(named)
        var alt = Alt.Decl_ExtensionMember_Method
        if head == TokenKind.Init && not synthesized {
            alt = Alt.Decl_ExtensionMember_Init
        } else if head != TokenKind.Func && head != TokenKind.Static {
            return self.error("expected a method, an `init` or a type assignment")
        }
        if synthesized {
            alt = Alt.Decl_ExtensionMember_SynthesizedMethod
        }
        let start = self.attach_docs(first)
        self.see(alt)
        if synthesized {
            self.take_synthesize_shared()
            self.skip_newlines()
            if self.kind() == TokenKind.At {
                return self.error("a member takes no attribute but `@synthesize(shared)`, once")
            }
        }
        if self.kind() == TokenKind.Public {
            if not self.parse_visibility() {
                return false
            }
        }
        let parsed = if alt == Alt.Decl_ExtensionMember_Init { self.parse_init() } else { self.parse_method() }
        if not parsed {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `type-assign-decl ::= 'type' IDENT "=" type`
    func parse_type_assign(&var self) -> Bool {
        self.see(Alt.Decl_TypeAssign)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.take_leaf()
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the type assigned")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_TypeAssign, start)
        true
    }

    // `method-decl ::= "static"? "func" method-name generic-params? "(" param-list? ")" effect-slot return-clause? NEWLINE* block`,
    // with `method-name ::= IDENT | "[" "]" | "[" "]" "="`, whose brackets
    // print (syntax.rule.subscript-declaration).
    func parse_method(&var self) -> Bool {
        self.see(Alt.Decl_Method)
        let start = self.here()
        let mark = self.builder.mark()
        let head = self.pos
        let is_static = self.kind() == TokenKind.Static
        if is_static {
            self.take_leaf()
            if self.kind() != TokenKind.Func {
                return self.error("expected `func` after `static`")
            }
        }
        self.advance()
        if self.kind() == TokenKind.Ident {
            self.see(Alt.Decl_MethodName_Ident)
            self.take_leaf()
        } else if self.kind() == TokenKind.LBracket && self.kind_at(1) == TokenKind.RBracket {
            let setitem = self.kind_at(2) == TokenKind.Assign
            self.take_leaf()
            self.take_leaf()
            if setitem {
                self.see(Alt.Decl_MethodName_Setitem)
                self.see(Alt.Decl_SetitemName)
                self.take_leaf()
            } else {
                self.see(Alt.Decl_MethodName_Subscript)
            }
        } else {
            return self.error("expected the method's name, `[]` or `[]=`")
        }
        if not self.parse_signature(not is_static, head, EffectHost.Method) {
            return false
        }
        if not self.parse_body_block("expected `\{` to open the method's body") {
            return false
        }
        self.close(mark, Alt.Decl_Method, start)
        true
    }

    // `init-decl ::= "init" "(" param-list? ")" effect-slot return-clause? NEWLINE* block`
    func parse_init(&var self) -> Bool {
        self.see(Alt.Decl_Init)
        let start = self.here()
        let mark = self.builder.mark()
        let head = self.pos
        self.advance()
        if self.kind() != TokenKind.LParen {
            return self.error("expected `(` to open the parameters")
        }
        if not self.parse_signature(false, head, EffectHost.Initializer) {
            return false
        }
        if not self.parse_body_block("expected `\{` to open the initializer's body") {
            return false
        }
        self.close(mark, Alt.Decl_Init, start)
        true
    }

    // A body's `{`, on its head's line or after line breaks, and its block.
    func parse_body_block(&var self, message: String) -> Bool {
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error(message)
        }
        self.parse_block()
    }

    // What follows a function's name: `generic-params? "(" param-list? ")" effect-slot return-clause?`
    // (the generic list absent from an `init`), with the receiver rule: a
    // declaration that `takes` one has it first, and any other has none
    // (syntax.rule.receiver-and-static). `head` is the token the declaration
    // starts at, where a missing receiver is refused.
    func parse_signature(&var self, takes: Bool, head: Int, host: EffectHost) -> Bool {
        if self.kind() == TokenKind.Lt && host != EffectHost.Initializer {
            if not self.parse_generic_params() {
                return false
            }
        }
        if self.kind() != TokenKind.LParen {
            return self.error("expected `(` to open the parameters")
        }
        let first = self.builder.mark()
        if not self.parse_params() {
            return false
        }
        let receiver = self.misplaced_receiver(first, takes)
        if receiver >= 0 {
            return self.refuse(Rule.Rule_ReceiverAndStatic, receiver,
                               "a receiver is a method's first parameter, and only a method that is not `static` takes one",
                               "declare `&self` or `&var self` first, or declare the method `static`")
        }
        if takes && not self.first_is_receiver(first) {
            return self.refuse(Rule.Rule_ReceiverAndStatic, head,
                               "a method that is not `static` takes a receiver",
                               "declare `&self` or `&var self` first, or declare the method `static`")
        }
        let exclusive = self.first_is_exclusive(first)
        if not self.parse_effects(host, exclusive) {
            return false
        }
        if self.kind() == TokenKind.Arrow {
            self.see(Alt.Decl_Return)
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        true
    }

    // Whether the parameter at scratch slot `slot` is a receiver.
    func is_receiver_slot(&self, slot: Int) -> Bool {
        if let alt = self.builder.node_at(slot).alt {
            return alt == Alt.Decl_Param_Receiver
        }
        false
    }

    // The token of the first receiver among the parameters from scratch slot
    // `first` on that stands where none may, or -1.
    func misplaced_receiver(&self, first: Int, takes: Bool) -> Int {
        var slot = first
        while slot < self.builder.mark() {
            if self.is_receiver_slot(slot) && (not takes || slot > first) {
                let at = self.builder.node_at(slot).start
                return self.token_starting_at(at)
            }
            slot = slot + 1
        }
        return -1
    }

    func first_is_receiver(&self, first: Int) -> Bool {
        first < self.builder.mark() && self.is_receiver_slot(first)
    }

    // Whether the first parameter is `&var self`.
    func first_is_exclusive(&self, first: Int) -> Bool {
        if not self.first_is_receiver(first) {
            return false
        }
        let start = self.builder.node_at(first).start
        let at = self.token_starting_at(start)
        self.tokens[at + 1].kind == TokenKind.Var
    }

    // ---- externs -------------------------------------------------------------------

    // `extern-block ::= "extern" STRING NEWLINE* "{" NEWLINE* extern-func-list? "}"`,
    // whose ABI string is `"C"` (syntax.rule.extern-abi).
    func parse_extern_block(&var self) -> Bool {
        self.see(Alt.Decl_ExternBlock)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.StringLit {
            return self.error("expected the ABI string, `\"C\"`")
        }
        let abi = self.current()
        if not self.abi_is_c(&abi) {
            let at = self.pos
            return self.refuse(Rule.Rule_ExternAbi, at, "the ABI string is `\"C\"`", "write `extern \"C\"`")
        }
        self.take_leaf()
        let open = self.open_body("expected `\{` to open the extern block")
        if open < 0 {
            return false
        }
        if not self.parse_members(MemberBody.Extern, open) {
            return false
        }
        self.close(mark, Alt.Decl_ExternBlock, start)
        true
    }

    // Whether the string token `t` holds `C`, as the letter or as the one
    // escape that decodes to it, `\u{43}` with any leading zeros.
    func abi_is_c(&self, t: &ParseToken) -> Bool {
        if self.builder.tree.source.span_is(t.start, t.end, "\"C\"") {
            return true
        }
        let open = t.start + 4
        let close = t.end - 2
        if close <= open || not self.builder.tree.source.span_is(t.start, open, "\"\\u\{") {
            return false
        }
        if not self.builder.tree.source.span_is(close, t.end, "\}\"") {
            return false
        }
        var value = 0
        var k = open
        while k < close {
            value = value * 16 + escape_digit_value(self.builder.tree.source.byte(k))
            k = k + 1
        }
        value == PARSE_LETTER_C
    }

    // `extern-func ::= 'blocking'? "func" IDENT "(" extern-param-list? ")" return-clause?`
    func parse_extern_func(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Decl_ExternFunc_Prompt
        if self.word_at(0, "blocking") && self.kind_at(1) == TokenKind.Func {
            alt = Alt.Decl_ExternFunc_Blocking
            self.advance()
        }
        if self.kind() != TokenKind.Func {
            return self.error("expected an extern function")
        }
        self.see(alt)
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the function's name")
        }
        self.take_leaf()
        if self.kind() != TokenKind.LParen {
            return self.error("expected `(` to open the parameters")
        }
        let open = self.pos
        self.advance()
        let fixed = self.kind() != TokenKind.RParen
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.ExternParams), open, false, &var count) {
            return false
        }
        if fixed {
            let variadic = self.tokens[self.pos - 1].kind == TokenKind.Ellipsis
            self.see(if variadic { Alt.Decl_ExternParams_Variadic } else { Alt.Decl_ExternParams_Fixed })
        }
        self.advance()
        if self.kind() == TokenKind.Arrow {
            self.see(Alt.Decl_Return)
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        self.close(mark, alt, start)
        true
    }

    // `extern-param ::= IDENT ":" type`, or the `...` that ends a variadic
    // list, after one parameter or more and right before its `)`.
    func parse_extern_param(&var self, open: Int) -> Bool {
        if self.kind() == TokenKind.Ellipsis {
            if self.pos == open + 1 || self.kind_at(1) != TokenKind.RParen {
                return self.error("`...` ends a list of one parameter or more")
            }
            self.take_leaf()
            return true
        }
        if self.kind() != TokenKind.Ident {
            return self.list_error(open, "expected a parameter name")
        }
        self.see(Alt.Decl_ExternParam)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the parameter's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_ExternParam, start)
        true
    }

    // `type-alias-decl ::= 'type' IDENT "=" type`
    func parse_type_alias(&var self) -> Bool {
        self.see(Alt.Decl_TypeAlias)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.take_leaf()
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the type the alias names")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_TypeAlias, start)
        true
    }

    // `visibility ::= "public" | "public" "(" 'package' ")" | "public" "(" 'parent' ")"`
    func parse_visibility(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var alt = Alt.Decl_Visibility_Public
        if self.kind() == TokenKind.LParen {
            if self.word_at(1, "package") && self.kind_at(2) == TokenKind.RParen {
                alt = Alt.Decl_Visibility_Package
            } else if self.word_at(1, "parent") && self.kind_at(2) == TokenKind.RParen {
                alt = Alt.Decl_Visibility_Parent
            } else {
                return self.error("a visibility names `package` or `parent`")
            }
            self.advance()
            self.advance()
            self.advance()
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // ---- imports and modules ----------------------------------------------------

    // `path ::= IDENT ( "." IDENT )*`
    func parse_path(&var self) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.error("expected a name")
        }
        self.see(Alt.Type_Path)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        while self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.Ident {
            self.advance()
            self.take_leaf()
        }
        self.close(mark, Alt.Type_Path, start)
        true
    }

    // `import-decl ::= 'import' import-target | "public" 'import' import-target`
    func parse_import(&var self, reexport: Bool) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if reexport {
            self.advance()
        }
        self.advance()
        let alt = if reexport { Alt.Decl_Import_Reexport } else { Alt.Decl_Import_Private }
        self.see(alt)
        if not self.parse_path() {
            return false
        }
        if self.kind() == TokenKind.As {
            self.see(Alt.Decl_ImportTarget_ModuleAlias)
            self.take_leaf()
            if self.kind() != TokenKind.Ident {
                return self.error("expected the module's alias")
            }
            self.take_leaf()
        } else if self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.Star {
            self.see(Alt.Decl_ImportTarget_Glob)
            self.take_leaf()
            self.take_leaf()
        } else if self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.LBrace {
            self.see(Alt.Decl_ImportTarget_Selective)
            self.take_leaf()
            if not self.parse_import_symbols() {
                return false
            }
        } else if self.kind() == TokenKind.Dot {
            self.advance()
            return self.error("expected a name, `*` or `\{` after the `.`")
        } else {
            self.see(Alt.Decl_ImportTarget_Module)
        }
        self.close(mark, alt, start)
        true
    }

    // `"{" NEWLINE* import-symbol-list? "}"`, the braces as leaves, then the
    // check that each local name is bound once (syntax.rule.import-names).
    func parse_import_symbols(&var self) -> Bool {
        let first = self.builder.mark()
        let open = self.pos
        self.take_leaf()
        self.skip_newlines()
        if self.kind() != TokenKind.RBrace {
            self.see(Alt.Decl_ImportSymbols)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.ImportSymbols), open, false, &var count) {
            return false
        }
        self.take_leaf()
        self.check_import_names(first, count.elements)
    }

    // An `import-symbol` of the list opened at `open`.
    func parse_import_symbol_element(&var self, open: Int) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.list_error(open, "expected a name to import")
        }
        self.parse_import_symbol()
    }

    // `import-symbol ::= IDENT NEWLINE* | IDENT "as" IDENT NEWLINE*`
    func parse_import_symbol(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        var alt = Alt.Decl_ImportSymbol_Name
        if self.kind() == TokenKind.As {
            alt = Alt.Decl_ImportSymbol_Alias
            self.advance()
            if self.kind() != TokenKind.Ident {
                return self.error("expected the name's alias")
            }
            self.take_leaf()
        }
        self.see(alt)
        self.close(mark, alt, start)
        self.skip_newlines()
        true
    }

    // The symbols are the `count` nodes after the `{` leaf at scratch slot
    // `first`; the name each binds is its last leaf.
    func check_import_names(&var self, first: Int, count: Int) -> Bool {
        var i = 0
        while i < count {
            let a = self.symbol_binding(first + 1 + i)
            var j = 0
            while j < i {
                let b = self.symbol_binding(first + 1 + j)
                if self.builder.tree.source.spans_equal(a.start, a.end, b.start, b.end) {
                    let symbol = self.builder.node_at(first + 1 + i)
                    self.record(Diagnostic(rule: Rule.Rule_ImportNames, start: symbol.start,
                                           end: symbol.end,
                                           message: "this import binds a name the list already binds",
                                           hint: "import each name once, and give a second one its own alias"))
                    return false
                }
                j = j + 1
            }
            i = i + 1
        }
        true
    }

    // The leaf naming what the import symbol at scratch slot `slot` binds.
    func symbol_binding(&self, slot: Int) -> ParseToken {
        let symbol = self.builder.node_at(slot)
        let leaf = self.builder.last_child(&symbol)
        ParseToken(kind: TokenKind.Ident, start: leaf.start, end: leaf.end, line: 0, seg_start: 0,
                   seg_count: 0)
    }

    // `module-decl ::= "public"? 'module' IDENT` or the inline form, whose
    // braces follow on its line or the next (syntax.rule.module-inline).
    func parse_module(&var self, visible: Bool) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if visible {
            self.take_leaf()
        }
        self.advance()
        self.take_leaf()
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) != TokenKind.LBrace {
            self.see(Alt.Decl_Module_File)
            self.close(mark, Alt.Decl_Module_File, start)
            return true
        }
        self.see(Alt.Decl_Module_Inline)
        self.skip_newlines()
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.advance()
        self.skip_newlines()
        self.parse_items(true)
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.advance()
        self.leave_level()
        self.close(mark, Alt.Decl_Module_Inline, start)
        true
    }

    // The bracket at `open` is never closed (syntax.lex.unclosed-bracket),
    // reported at the opener, once: `check_brackets` may have reported it
    // before the parse began.
    func refuse_unclosed(&var self, open: Int) -> Bool {
        let at = self.tokens[open].start
        var k = 0
        while k < self.diagnostics.len() {
            let d = self.diagnostics[k]
            if let rule = d.rule {
                if d.start == at && rule == Rule.Lex_UnclosedBracket {
                    return false
                }
            }
            k = k + 1
        }
        self.report(Rule.Lex_UnclosedBracket, open, "this bracket is never closed", "")
        false
    }

    // The file's first unclosed bracket, reported at its opener before any
    // other refusal (syntax.lex.unclosed-bracket): the parse would otherwise
    // meet a later token first, where the text stops making sense. A closer
    // that closes an opener deeper in the stack leaves the ones above it
    // unclosed, and one that closes nothing is stray, which the parse reports.
    func check_brackets(&var self) {
        var open = Vector<Int>()
        var depth = 0
        var first = -1
        var k = 0
        while k < self.limit {
            let kind = self.tokens[k].kind
            if opens_bracket(kind) {
                put_at(&var open, depth, k)
                depth = depth + 1
            } else if closes_bracket(kind) {
                var j = depth - 1
                while j >= 0 && not closes_opener(kind, self.tokens[open[j]].kind) {
                    j = j - 1
                }
                if j >= 0 {
                    if j + 1 < depth && (first < 0 || open[j + 1] < first) {
                        first = open[j + 1]
                    }
                    depth = j
                }
            }
            k = k + 1
        }
        if depth > 0 && (first < 0 || open[0] < first) {
            first = open[0]
        }
        if first >= 0 {
            let _ = self.refuse_unclosed(first)
        }
    }

    // ---- functions -------------------------------------------------------------

    // `func-decl ::= "func" IDENT generic-params? "(" param-list? ")" effect-slot return-clause? NEWLINE* block`
    func parse_func(&var self) -> Bool {
        self.see(Alt.Decl_Func)
        let start = self.here()
        let mark = self.builder.mark()
        let head = self.pos
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the function's name")
        }
        self.take_leaf()
        if not self.parse_signature(false, head, EffectHost.Function) {
            return false
        }
        if not self.parse_body_block("expected `\{` to open the function's body") {
            return false
        }
        self.close(mark, Alt.Decl_Func, start)
        true
    }

    // `"(" param-list? ")"`, with `param-list ::= param ( "," param )* ","?`
    func parse_params(&var self) -> Bool {
        let open = self.pos
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Decl_Params)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.Params), open, false, &var count) {
            return false
        }
        self.advance()
        true
    }

    // `param ::= IDENT ":" type | IDENT ":" type "=" expr | receiver`, where
    // `receiver ::= "&" "self" | "&" "var" "self"`, or a receiver section 10
    // refuses: `var self`, `self`, or a reference written on the name.
    func parse_param(&var self) -> Bool {
        let kind = self.kind()
        let next = self.kind_at(1)
        if kind == TokenKind.Ampersand {
            let exclusive = next == TokenKind.Var
            let target = if exclusive { self.kind_at(2) } else { next }
            if target == TokenKind.SelfKw {
                let alt = if exclusive { Alt.Decl_Receiver_Exclusive } else { Alt.Decl_Receiver_Shared }
                self.see(Alt.Decl_Param_Receiver)
                self.see(alt)
                let start = self.here()
                let mark = self.builder.mark()
                let inner = self.builder.mark()
                self.advance()
                if exclusive {
                    self.advance()
                }
                self.advance()
                self.close(inner, alt, start)
                self.close(mark, Alt.Decl_Param_Receiver, start)
                return true
            }
            if target == TokenKind.Ident {
                return self.refuse_receiver("a reference parameter carries `&` on its type",
                                            "write `x: &T` or `x: &var T`")
            }
        }
        if kind == TokenKind.SelfKw || (kind == TokenKind.Var && next == TokenKind.SelfKw) {
            return self.refuse_receiver("a receiver is a reference", "write `&self` or `&var self`")
        }
        if kind != TokenKind.Ident {
            return self.error("expected a parameter name")
        }
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the parameter's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        var alt = Alt.Decl_Param_Plain
        if self.kind() == TokenKind.Assign {
            alt = Alt.Decl_Param_Default
            self.advance()
            if not self.parse_expr() {
                return false
            }
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    func refuse_receiver(&var self, message: String, hint: String) -> Bool {
        let at = self.pos
        self.refuse(Rule.Decl_RefusedReceiver, at, message, hint)
    }

    // `effect-slot ::= 'consumes'? "unsafe"? constexpr-effect? 'sync'? borrows-effect? refused-escaping?`,
    // each word a leaf of the declaration. `consumes` stands only on a method
    // whose first parameter is `&var self` (`exclusive`), and `borrows` on
    // anything but an `init` (syntax.rule.effect-slot); a requirement is
    // never `consumes` (syntax.rule.requirement-borrows).
    func parse_effects(&var self, host: EffectHost, exclusive: Bool) -> Bool {
        self.see(Alt.Decl_Effects)
        var consumes = -1
        var lend_word = -1
        if self.word_at(0, "consumes") {
            consumes = self.pos
            self.take_leaf()
        }
        if self.kind() == TokenKind.Unsafe_ {
            self.take_leaf()
        }
        if self.word_at(0, "constexpr") {
            self.see(Alt.Decl_Constexpr)
            self.take_leaf()
        }
        if self.word_at(0, "sync") {
            self.take_leaf()
        }
        if self.kind() == TokenKind.Borrows {
            lend_word = self.pos
            let paired = self.kind_at(1) == TokenKind.LParen && self.word_at(2, "sync")
            if paired && self.kind_at(3) == TokenKind.RParen {
                self.see(Alt.Decl_BorrowsEffect_Sync)
                self.see(Alt.Decl_BorrowsSync)
                self.take_leaf()
                self.advance()
                self.take_leaf()
                self.advance()
            } else {
                self.see(Alt.Decl_BorrowsEffect_Plain)
                self.take_leaf()
            }
        }
        if self.word_at(0, "escaping") {
            let at = self.pos
            return self.refuse(Rule.Decl_RefusedEscaping, at,
                               "`escaping` describes a closure's environment, and a named function has none",
                               "write `escaping` on the function type instead")
        }
        if consumes >= 0 && host == EffectHost.Requirement {
            return self.refuse(Rule.Rule_RequirementBorrows, consumes,
                               "a trait requirement is never `consumes`",
                               "declare the consuming method in an extension")
        }
        if consumes >= 0 && not (host == EffectHost.Method && exclusive) {
            return self.refuse(Rule.Rule_EffectSlot, consumes,
                               "`consumes` stands only on a method whose receiver is `&var self`",
                               "declare the function as a method whose receiver is `&var self`")
        }
        if lend_word >= 0 && host == EffectHost.Initializer {
            return self.refuse(Rule.Rule_EffectSlot, lend_word, "an `init` is never `borrows`",
                               "lend the storage from a method instead")
        }
        true
    }

    // ---- statements --------------------------------------------------------------

    // `block ::= "{" block-body "}"`
    func parse_block(&var self) -> Bool {
        self.see(Alt.Stmt_Block)
        self.see(Alt.Stmt_Body)
        let start = self.here()
        let mark = self.builder.mark()
        let open = self.pos
        let head = self.head
        let lists = self.lists
        let noted = self.note_head()
        self.head = HeadState.Off
        self.lists = 0
        self.advance()
        self.skip_newlines()
        self.parse_statement_list(false)
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.lists = lists
        self.advance()
        self.head = head
        self.restore_head(&noted)
        self.close(mark, Alt.Stmt_Block, start)
        true
    }

    // What the statement around a brace body has noted about its heads, which
    // the body's own statements clear and the statement needs back after it.
    func note_head(&var self) -> HeadNote {
        let noted = HeadNote(brace: self.head_brace, start: self.head_start,
                             follow: self.head_follow)
        self.head_brace = -1
        noted
    }

    func restore_head(&var self, noted: &HeadNote) {
        self.head_brace = noted.brace
        self.head_start = noted.start
        self.head_follow = noted.follow
    }

    // `statement ( stmt-sep statement )* NEWLINE*`, up to a block's `}`;
    // after its first statement when `any`, which a brace whose first
    // element decided it is a closure has parsed already.
    func parse_statement_list(&var self, any: Bool) {
        var list = ListState(any: any, need: false)
        while self.next_item(false, &var list) {
            let from = self.pos
            let point = self.resume_point()
            self.begin_statement()
            if not self.parse_statement(StatementPlace.Block) {
                self.resume(&point)
                self.recover(from)
            }
        }
    }

    // What an item or statement that fails leaves behind for the next one to
    // start clean from: the scratch it built and the state its constructs
    // set on the way in and never got to set back.
    func resume_point(&self) -> ResumePoint {
        ResumePoint(mark: self.builder.mark(), depth: self.depth, lists: self.lists,
                    head: self.head, head_at: self.head_at, head_until: self.head_until,
                    spine: self.spine_count, literal_arm: self.literal_arm,
                    shadow_brace: self.shadow_brace)
    }

    func resume(&var self, point: &ResumePoint) {
        self.builder.discard(point.mark)
        self.depth = point.depth
        self.lists = point.lists
        self.head = point.head
        self.head_at = point.head_at
        self.head_until = point.head_until
        self.spine_count = point.spine
        self.literal_arm = point.literal_arm
        self.shadow_brace = point.shadow_brace
        self.primed = false
    }

    // Clears what one statement notes for its own refusals, as the next
    // statement begins.
    func begin_statement(&var self) {
        self.rejected_list = -1
        self.head_brace = -1
    }

    // A refusal unit's items, statements and top-level items alike, separated
    // as statements are, up to the end of input. A separate loop from a
    // block's, so that no block can reach a declaration.
    func parse_unit_items(&var self) {
        var list = ListState(any: false, need: false)
        while self.next_item(true, &var list) {
            let from = self.pos
            let point = self.resume_point()
            self.begin_statement()
            var ok = true
            if self.starts_item() {
                self.see(Alt.Test_RefusalUnitItem_Declaration)
                ok = self.parse_item()
            } else {
                self.see(Alt.Test_RefusalUnitItem_Statement)
                ok = self.parse_statement(StatementPlace.Block)
            }
            if not ok {
                self.resume(&point)
                self.recover(from)
            }
        }
    }

    // Takes the separators before a list's next item and returns whether one
    // starts here; false at the list's end, a block's `}` or, for a refusal
    // unit, the end of input. A `;` joins two statements on one line and never
    // ends one (syntax.rule.statement-separator), and two statements on one
    // line need one (syntax.rule.juxtaposition).
    func next_item(&var self, unit: Bool, list: &var ListState) -> Bool {
        while true {
            let kind = self.kind()
            if kind == TokenKind.Eof || (not unit && kind == TokenKind.RBrace) {
                if list.need {
                    let _ = self.error("a `;` joins two statements on one line; it does not end one")
                }
                return false
            }
            if list.need && kind == TokenKind.Newline {
                let _ = self.error("a `;` joins two statements on one line; it does not end one")
                list.need = false
            }
            if kind == TokenKind.Newline {
                self.skip_newlines()
                let closes = self.kind() == TokenKind.Eof || (not unit && self.kind() == TokenKind.RBrace)
                if list.any && not closes {
                    self.see(Alt.Stmt_Sep_Newline)
                }
                continue
            }
            if kind == TokenKind.Semicolon {
                let line_start = self.pos > 0 && self.tokens[self.pos - 1].kind == TokenKind.Newline
                if not list.any || list.need || line_start {
                    let _ = self.error("a `;` joins two statements on one line; it does not end one")
                }
                self.see(Alt.Stmt_Sep_Semicolon)
                self.advance()
                list.need = true
                continue
            }
            if list.any && not list.need && self.tokens[self.pos - 1].kind != TokenKind.Newline {
                let from_here = self.pos
                let _ = self.error("two statements on one line need a `;` between them")
                self.recover(from_here)
                continue
            }
            list.need = false
            list.any = true
            return true
        }
        false
    }

    // `statement ::= expr-stmt | non-expr-statement`, or, for an unbraced
    // match-arm body (`Arm`), `arm-body`'s expression or statement, which
    // means what the same statement in braces means (syntax.rule.arm-body).
    // At a brace's first element (`BraceFirst`) an expression is left bare,
    // since only the token after it says whether it is a statement.
    func parse_statement(&var self, place: StatementPlace) -> Bool {
        let arm = place == StatementPlace.Arm
        let kind = self.kind()
        if kind == TokenKind.At {
            self.see_other(Alt.Stmt_NonExpr_AttributedLocal, arm)
            return self.parse_attributed_local()
        }
        if kind == TokenKind.Let || kind == TokenKind.Var {
            if self.kind_at(1) == TokenKind.LParen {
                self.see_other(Alt.Stmt_NonExpr_Destructure, arm)
                return self.parse_destructure()
            }
            self.see_other(Alt.Stmt_NonExpr_Let, arm)
            return self.parse_let()
        }
        if kind == TokenKind.Return {
            self.see_other(Alt.Stmt_NonExpr_Return, arm)
            return self.parse_return(arm)
        }
        if kind == TokenKind.Break {
            self.see_other(Alt.Stmt_NonExpr_Break, arm)
            return self.parse_break(arm)
        }
        if kind == TokenKind.Continue {
            self.see_other(Alt.Stmt_NonExpr_Continue, arm)
            return self.token_node(Alt.Stmt_Continue, false)
        }
        if kind == TokenKind.Guard {
            self.see_other(Alt.Stmt_NonExpr_Guard, arm)
            return self.parse_guard()
        }
        if kind == TokenKind.Lend {
            return self.parse_lend(arm)
        }
        if self.word_at(0, "static_assert") && self.kind_at(1) == TokenKind.LParen {
            self.see_other(Alt.Stmt_NonExpr_StaticAssert, arm)
            let word = self.pos
            if not self.parse_static_assert() {
                return false
            }
            if not ends_statement(self.kind(), arm) {
                // The word is read by its `(` alone, so the assertion is
                // never a call to go on from.
                return self.refuse(Rule.Rule_ContextualWords, word,
                                   "`static_assert` followed by `(` is an assertion, not a call",
                                   "end the statement after the assertion's `)`")
            }
            return true
        }
        if self.word_at(0, "const") && self.kind_at(1) == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Stmt_RefusedLocalConst, at,
                               "a local constant is a `let`", "write `let` for `const`")
        }
        if self.word_at(0, "type") && self.kind_at(1) == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Stmt_RefusedLocalTypeAlias, at,
                               "a type alias is declared at module level",
                               "declare the alias at module level, or as an associated type")
        }
        if (kind == TokenKind.While || kind == TokenKind.For) && place != StatementPlace.BraceFirst {
            return self.parse_loop_statement(place)
        }
        if kind == TokenKind.While || kind == TokenKind.For {
            // A brace's first element may be a map key or a set element that
            // a loop begins, which only the token after the element tells; a
            // closure refuses the loop's continuation then (`loop_continuation`).
            return self.parse_expr()
        }
        let start = self.here()
        let mark = self.builder.mark()
        let from = self.taken_count
        let base = self.spine_count
        let first = self.pos
        if kind == TokenKind.Star {
            if not self.parse_prefix_operator(Alt.Expr_Prefix_Deref, Alt.Expr_Deref, 1, true) {
                return false
            }
        } else if kind == TokenKind.Borrow && self.borrow_binding_end(0) < 0 {
            if not self.parse_borrow_place(true) {
                return false
            }
        } else if self.starts_postfix() {
            if not self.parse_postfix(true) {
                return false
            }
        } else {
            self.see_expression(place)
            if not self.parse_expr() {
                return false
            }
            return self.close_expression(mark, start, place)
        }
        if is_assignment(self.kind()) {
            return self.parse_assignment(mark, start, from, base, first, arm)
        }
        // Not a target: the chain is the first operand of an expression.
        self.see_expression(place)
        let lead = self.spine_alts[base]
        if kind == TokenKind.Star {
            self.release_spine(base)
        } else if lead == Alt.Borrow_Place_Shared || lead == Alt.Borrow_Place_Var {
            self.see(Alt.Expr_Prefix_Borrow)
            self.release_spine(base)
            self.close(mark, lead, start)
        } else {
            self.see(Alt.Expr_Prefix_Postfix)
            self.release_spine(base)
        }
        self.primed = true
        if not self.parse_expr() {
            return false
        }
        self.close_expression(mark, start, place)
    }

    // Records a non-expression statement's alternative, reached through
    // `statement` in a block and through `arm-body` in an arm.
    func see_other(&var self, alt: Alt, arm: Bool) {
        let form = if arm { Alt.Expr_ArmBody_Statement } else { Alt.Stmt_Statement_Other }
        self.see(form)
        self.see(alt)
    }

    // Records an expression statement's alternatives; in an arm body the
    // expression stands alone, with no statement node around it, and at a
    // brace's first element nothing is known yet.
    func see_expression(&var self, place: StatementPlace) {
        if place == StatementPlace.Arm {
            self.see(Alt.Expr_ArmBody_Expr)
        } else if place == StatementPlace.Block {
            self.see(Alt.Stmt_Statement_Expr)
            self.see(Alt.Stmt_Expr)
        }
    }

    func close_expression(&var self, mark: Int, start: Int, place: StatementPlace) -> Bool {
        if place == StatementPlace.Block {
            self.close(mark, Alt.Stmt_Expr, start)
        }
        true
    }

    // Whether the current token begins a postfix expression: a primary, which
    // no prefix operator and no open range starts, and which `borrow` starts
    // only as a `borrow` block (syntax.rule.borrow-form).
    func starts_postfix(&self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Try {
            return self.try_block_ahead()
        }
        if kind == TokenKind.Ident {
            let next = self.kind_at(1)
            return not (self.word_at(0, "lends") && (next == TokenKind.SelfKw || next == TokenKind.Ident))
        }
        if kind == TokenKind.Dot {
            return self.kind_at(1) == TokenKind.Ident
        }
        if kind == TokenKind.Borrow {
            return self.borrow_binding_end(0) > 0
        }
        match kind {
            case IntLit -> true,
            case FloatLit -> true,
            case StringLit -> true,
            case InterpString -> true,
            case True_ -> true,
            case False_ -> true,
            case NoneKw -> true,
            case SelfKw -> true,
            case DollarParam -> true,
            case HashDirective -> true,
            case LParen -> true,
            case LBracket -> true,
            case LBrace -> true,
            case If -> true,
            case Match -> true,
            case While -> true,
            case For -> true,
            case _ -> false
        }
    }

    // Whether the `try` here is followed, on its line or the next, by `{`:
    // a try block (syntax.rule.try-block).
    func try_block_ahead(&self) -> Bool {
        var ahead = 1
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.LBrace
    }

    // Records `alt`, or, on a statement's leading chain, keeps it until the
    // statement knows whether the chain is an assignment target.
    func see_spine(&var self, alt: Alt, spine: Bool) {
        if not spine {
            self.see(alt)
            return
        }
        // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.spine_alts, self.spine_count, alt)
        let at = self.spine_count
        put_at(&var self.spine_alts, at, alt)
        self.spine_count = at + 1
    }

    // Records the kept alternatives from `base` on, as an expression took them.
    func release_spine(&var self, base: Int) {
        var k = base
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        self.spine_count = base
    }

    // Takes back `alt` if it was first recorded after `since`: a name or
    // `self` that, as a whole target, derives through another production.
    func unsee_since(&var self, alt: Alt, since: Int) {
        var k = since
        while k < self.taken_count {
            if self.taken[k] == alt {
                self.seen[(alt as UInt16) as Int] = false
                while k + 1 < self.taken_count {
                    // Stage 0 workaround (SL:hazards S4): canonical: self.taken[k] = self.taken[k + 1]
                    let next = self.taken[k + 1]
                    self.taken[k] = next
                    k = k + 1
                }
                self.taken_count = self.taken_count - 1
                return
            }
            k = k + 1
        }
    }

    // The statement's leading chain, begun at `mark`, stands before an
    // assignment operator: it must have a place shape, which decides the
    // statement's production (syntax.rule.assignment-target). The chain's
    // kept alternatives from `base` on name its hops; the target records
    // them as the production it derives through, and the last as its
    // place, call or chain hop.
    func parse_assignment(&var self, mark: Int, start: Int, from: Int, base: Int,
                          head: Int, arm: Bool) -> Bool {
        let compound = self.kind() != TokenKind.Assign
        let lead_alt = self.spine_alts[base]
        if lead_alt == Alt.Borrow_Place_Shared || lead_alt == Alt.Borrow_Place_Var {
            return self.borrow_assignment(mark, start, base, compound, arm)
        }
        let deref = self.spine_count > base && lead_alt == Alt.Expr_Prefix_Deref
        if deref {
            self.spine_count = base
            let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Deref,
                                           Alt.Stmt_CompoundTarget_Deref, arm)
            return self.finish_assignment(mark, start, compound, node)
        }
        let first = base + 1
        let hops = self.spine_count - first
        if hops == 0 {
            self.spine_count = base
            let lead = self.tokens[head].kind
            if lead == TokenKind.SelfKw {
                if compound {
                    return self.refuse(Rule.Stmt_RefusedCompoundSelf, head,
                                       "`self` is not a compound-assignment target",
                                       "replace the receiver whole: `self = …`")
                }
                self.unsee_since(Alt.Expr_Primary_Self, from)
                let node = self.see_assignment(false, Alt.Stmt_AssignTarget_Self,
                                               Alt.Stmt_AssignTarget_Self, arm)
                return self.finish_assignment(mark, start, false, node)
            }
            let target = self.builder.node_at(mark)
            if lead == TokenKind.Ident && target.count == 1 {
                self.unsee_since(Alt.Expr_Primary_Name, from)
                self.unsee_since(Alt.Expr_Name, from)
                self.see(Alt.Expr_NameRef)
                let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Name,
                                               Alt.Stmt_CompoundTarget_Name, arm)
                return self.finish_assignment(mark, start, compound, node)
            }
            return self.error("an assignment's target is a name, `self`, a field, an element or a pointee")
        }
        // An optional-chain run still open at the chain's end makes the
        // statement an optional assignment (syntax.rule.optional-chain-run).
        let optional = self.open_optional_hop(first)
        if optional >= 0 {
            self.see_chain_target(base, optional)
            let form = if compound { Alt.Stmt_OptionalAssign_Compound } else { Alt.Stmt_OptionalAssign_Plain }
            self.see_other(Alt.Stmt_NonExpr_OptionalAssign, arm)
            self.see(form)
            return self.finish_assignment(mark, start, compound, form)
        }
        let last = self.spine_alts[self.spine_count - 1]
        if last == Alt.Expr_Hop_Trailing {
            return self.error("an assignment's target is a name, `self`, a field, an element or a pointee")
        }
        var k = first
        while k < self.spine_count - 1 {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        self.spine_count = base
        if last == Alt.Expr_Hop_Call {
            self.see(Alt.Stmt_CallTarget)
            let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Call,
                                           Alt.Stmt_CompoundTarget_Call, arm)
            return self.finish_assignment(mark, start, compound, node)
        }
        self.see(Alt.Stmt_ProjectionTarget)
        self.see(place_hop(last))
        let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Projection,
                                       Alt.Stmt_CompoundTarget_Projection, arm)
        self.finish_assignment(mark, start, compound, node)
    }

    // An assignment whose target is a place form, left open at `mark` with
    // its form kept at spine slot `base` and its operand's alternatives after
    // it. An exclusive one whose operand ends in an open optional run writes
    // through the chain (syntax.stmt.optional-assign, syntax.rule.optional-chain-run);
    // any other is a plain or compound assignment to the place.
    func borrow_assignment(&var self, mark: Int, start: Int, base: Int, compound: Bool,
                           arm: Bool) -> Bool {
        let form = self.spine_alts[base]
        let optional = self.open_optional_hop(base + 2)
        if form == Alt.Borrow_Place_Var && optional >= 0 {
            self.see(Alt.Borrow_OptionalTarget)
            self.see_chain_target(base + 1, optional)
            self.spine_count = base
            self.close(mark, Alt.Borrow_OptionalTarget, start)
            let node = if compound { Alt.Stmt_OptionalAssign_BorrowCompound } else { Alt.Stmt_OptionalAssign_BorrowPlain }
            self.see_other(Alt.Stmt_NonExpr_OptionalAssign, arm)
            self.see(node)
            return self.finish_assignment(mark, start, compound, node)
        }
        self.release_spine(base)
        self.close(mark, form, start)
        let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Borrow,
                                       Alt.Stmt_CompoundTarget_Borrow, arm)
        self.finish_assignment(mark, start, compound, node)
    }

    // Records an assignment's production, plain or compound, and its target's form.
    // Returns the alternative whose node the statement builds.
    func see_assignment(&var self, compound: Bool, plain_target: Alt, compound_target: Alt,
                        arm: Bool) -> Alt {
        if compound {
            self.see_other(Alt.Stmt_NonExpr_CompoundAssign, arm)
            self.see(Alt.Stmt_CompoundAssign)
            self.see(compound_target)
            return Alt.Stmt_CompoundAssign
        }
        self.see_other(Alt.Stmt_NonExpr_Assign, arm)
        self.see(Alt.Stmt_Assign)
        self.see(plain_target)
        Alt.Stmt_Assign
    }

    // The operator and right side of an assignment whose target is parsed,
    // closed into its node. The right side starts on the line of the operator.
    // A compound operator prints; `=` is implied by the node's Kind.
    func finish_assignment(&var self, mark: Int, start: Int, compound: Bool, node: Alt) -> Bool {
        if compound {
            // Stage 0 workaround (SL:hazards S4): canonical: self.see(compound_op(self.kind()))
            let op = compound_op(self.kind())
            self.see(op)
            self.take_leaf()
        } else {
            self.advance()
        }
        if not self.parse_expr() {
            return false
        }
        self.close(mark, node, start)
        true
    }

    // `break-stmt ::= "break" expr?`: an operand when the next token can
    // begin one; in an arm body `,` and `case` end the statement too
    // (syntax.rule.arm-statement-end).
    func parse_break(&var self, arm: Bool) -> Bool {
        self.see(Alt.Stmt_Break)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not ends_statement(self.kind(), arm) {
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, Alt.Stmt_Break, start)
        true
    }

    // `static-assert ::= 'static_assert' "(" expr "," STRING ")"`. Recognized
    // by the word and its `(`, so without its message it is refused as that
    // reading (syntax.rule.contextual-words).
    func parse_static_assert(&var self) -> Bool {
        self.see(Alt.Decl_StaticAssert)
        let start = self.here()
        let mark = self.builder.mark()
        let word = self.pos
        self.advance()
        let open = self.pos
        self.advance()
        if not self.parse_expr() {
            return false
        }
        if self.kind() != TokenKind.Comma || self.kind_at(1) != TokenKind.StringLit {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            return self.refuse(Rule.Rule_ContextualWords, word,
                               "`static_assert` takes a condition and a message",
                               "write `static_assert(condition, \"message\")`")
        }
        self.advance()
        self.take_leaf()
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the assertion's message")
        }
        self.advance()
        self.close(mark, Alt.Decl_StaticAssert, start)
        true
    }

    // A `while` or `for` loop that starts a statement: a statement, never an
    // operand, so a token after it that would continue an expression is
    // refused (syntax.rule.block-tail). A `{` on its line is refused as the
    // trailing closure it would be after an `if`, which no loop takes either
    // (syntax.rule.trailing-closure).
    func parse_loop_statement(&var self, place: StatementPlace) -> Bool {
        self.see_expression(place)
        self.see_operand_tiers()
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_primary() {
            return false
        }
        if self.kind() == TokenKind.LBrace {
            let at = self.pos
            return self.refuse(Rule.Rule_TrailingClosure, at,
                               "only a name or a member takes a trailing closure, and only one",
                               "pass the closure in parentheses: `f(…)(\{ … \})`")
        }
        if continues_operand(self.kind()) {
            let at = self.pos
            return self.refuse(Rule.Rule_BlockTail, at,
                               "a loop that starts a statement is a statement, not an operand",
                               "parenthesize the loop to use its value")
        }
        self.close_expression(mark, start, place)
    }

    // The alternatives an operand reached through `expr` down to a primary
    // takes, when it has no operator of any tier.
    func see_operand_tiers(&var self) {
        self.see(Alt.Expr_Expr)
        self.see(Alt.Expr_Coalesce)
        self.see(Alt.Expr_Or)
        self.see(Alt.Expr_And)
        self.see(Alt.Expr_Bitor)
        self.see(Alt.Expr_Bitxor)
        self.see(Alt.Expr_Bitand)
        self.see(Alt.Expr_Compare_Pair)
        self.see(Alt.Expr_Range_Closed)
        self.see(Alt.Expr_Shift)
        self.see(Alt.Expr_Additive)
        self.see(Alt.Expr_Multiplicative)
        self.see(Alt.Expr_Cast)
        self.see(Alt.Expr_Prefix_Postfix)
        self.see(Alt.Expr_Postfix)
    }

    // `let-stmt ::= ("let" | "var") binding-name type-annotation? "=" expr`,
    // where `var _` is the refused discard (syntax.rule.discard-binding) and a
    // binding with no initializer is refused (syntax.stmt.refused-uninitialized).
    func parse_let(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        let keyword = self.pos
        let mutable = self.kind() == TokenKind.Var
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        if mutable && self.word_at(0, "_") {
            return self.refuse(Rule.Stmt_RefusedVarDiscard, keyword,
                               "`_` binds nothing, so there is nothing to mutate",
                               "write `let _ = e`")
        }
        let alt = if mutable { Alt.Stmt_Let_Mutable } else { Alt.Stmt_Let_Immutable }
        self.see(alt)
        self.see(Alt.Stmt_BindingName)
        let name_start = self.here()
        let name_mark = self.builder.mark()
        self.take_leaf()
        self.close(name_mark, Alt.Stmt_BindingName, name_start)
        var annotated = false
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Stmt_TypeAnnotation)
            annotated = true
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        if self.kind() != TokenKind.Assign {
            if annotated && ends_statement(self.kind(), false) {
                return self.refuse(Rule.Stmt_RefusedUninitialized, keyword,
                                   "every binding is initialized where it is declared",
                                   "write `= value` after the type")
            }
            return self.error("expected `=` and the binding's value")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `attributed-local ::= attribute-list let-stmt`: a `let` or `var` that
    // binds one name, whose one attribute is `@align`
    // (syntax.rule.attribute-position).
    func parse_attributed_local(&var self) -> Bool {
        self.see(Alt.Stmt_AttributedLocal)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_attributes(Alt.Stmt_AttributedLocal) {
            return false
        }
        let kind = self.kind()
        if (kind != TokenKind.Let && kind != TokenKind.Var) || self.kind_at(1) == TokenKind.LParen {
            return self.error("an attribute stands on a `let` or `var` that binds one name")
        }
        if not self.parse_let() {
            return false
        }
        self.close(mark, Alt.Stmt_AttributedLocal, start)
        true
    }

    // `destructure-stmt ::= ("let" | "var") tuple-pattern "=" expr`, which
    // takes no type annotation.
    func parse_destructure(&var self) -> Bool {
        let alt = if self.kind() == TokenKind.Var { Alt.Stmt_Destructure_Mutable } else { Alt.Stmt_Destructure_Immutable }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_tuple_pattern() {
            return false
        }
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the value to destructure")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `lend-stmt ::= "lend" expr`. A `lend` with nothing after it on its
    // statement hands out no place (syntax.stmt.refused-bare-lend).
    func parse_lend(&var self, arm: Bool) -> Bool {
        if ends_statement(self.kind_at(1), arm) {
            let at = self.pos
            return self.refuse(Rule.Stmt_RefusedBareLend, at, "`lend` hands out a place, so it needs one",
                               "write `lend place`")
        }
        self.see_other(Alt.Stmt_NonExpr_Lend, arm)
        self.see(Alt.Stmt_Lend)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, Alt.Stmt_Lend, start)
        true
    }

    // `return-stmt ::= "return" expr?`: an operand when the next token can
    // begin one.
    func parse_return(&var self, arm: Bool) -> Bool {
        self.see(Alt.Stmt_Return)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not ends_statement(self.kind(), arm) {
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, Alt.Stmt_Return, start)
        true
    }

    // ---- control flow --------------------------------------------------------------

    // `head-expr ::= expr`, parsed where a `{` at its outer level begins the
    // construct's body (syntax.rule.head-restriction); `follow` is the token
    // the construct takes after the head.
    func parse_head_expr(&var self, follow: TokenKind) -> Bool {
        self.see(Alt.Expr_Head)
        let saved = self.enter_head(follow)
        if not self.parse_expr() {
            return false
        }
        self.leave_head(&saved)
        true
    }

    // Enters a head that begins here, which its construct follows with
    // `follow`, and returns what `leave_head` gives back.
    func enter_head(&var self, follow: TokenKind) -> HeadFrame {
        let saved = HeadFrame(state: self.head, at: self.head_at, until: self.head_until)
        self.head = HeadState.On
        self.head_at = self.pos
        self.head_until = follow
        saved
    }

    func leave_head(&var self, saved: &HeadFrame) {
        self.head = saved.state
        self.head_at = saved.at
        self.head_until = saved.until
    }

    // Whether a `{` here, after an operand, begins a construct's body rather
    // than a trailing closure: at a head's outer level, and, in a head read
    // with the restriction lifted, at every `{` but the one it was noted at.
    func brace_ends_head(&self) -> Bool {
        self.head == HeadState.On || (self.head == HeadState.Lifted && self.pos != self.lifted_brace)
    }

    // Notes that the head being parsed stops at the `{` here, where a
    // trailing closure could have attached.
    func note_head_stop(&var self) {
        self.head_brace = self.pos
        self.head_start = self.head_at
        self.head_follow = self.head_until
    }

    // A construct's body, `NEWLINE* block`: its `{` may start the line after
    // its head (syntax.rule.continuation-keywords).
    func parse_body(&var self) -> Bool {
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the body")
        }
        self.parse_block()
    }

    // Whether `else`, on this line or a later one, goes on the construct
    // just closed; the line breaks before it are then the construct's.
    func else_ahead(&self) -> Bool {
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.Else
    }

    // `if-expr ::= "if" if-head NEWLINE* block else-if-arm* else-arm?`, one
    // node with its arms in order (syntax.rule.flat-else-if), charging one
    // level for the whole chain.
    func parse_if(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_If)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_if_head() {
            return false
        }
        if not self.parse_body() {
            return false
        }
        while self.else_ahead() {
            self.skip_newlines()
            if self.if_after_else() {
                self.see(Alt.Expr_ElseIf)
                let arm_start = self.here()
                let arm_mark = self.builder.mark()
                self.advance()
                self.skip_newlines()
                self.advance()
                if not self.parse_if_head() {
                    return false
                }
                if not self.parse_body() {
                    return false
                }
                self.close(arm_mark, Alt.Expr_ElseIf, arm_start)
            } else {
                self.see(Alt.Expr_Else)
                self.take_leaf()
                if not self.parse_body() {
                    return false
                }
                break
            }
        }
        self.close(mark, Alt.Expr_If, start)
        self.leave_level()
        true
    }

    // Whether the `else` here is followed, past line breaks, by `if`.
    func if_after_else(&self) -> Bool {
        var ahead = 1
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.If
    }

    // `if-head ::= head-expr | optional-binding | borrow-unwrap`. A binding
    // after `borrow` is the unwrap, never a `borrow` block read as the
    // condition (syntax.rule.borrow-form).
    func parse_if_head(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Let || kind == TokenKind.Var {
            self.see(Alt.Expr_IfHead_Binding)
            return self.parse_optional_binding()
        }
        if self.borrow_binding_end(0) > 0 {
            self.see(Alt.Expr_IfHead_Borrow)
            return self.parse_borrow_unwrap()
        }
        self.see(Alt.Expr_IfHead_Condition)
        self.parse_head_expr(TokenKind.LBrace)
    }

    // How many tokens on the `=` of the borrow binding that begins `ahead`
    // tokens on stands: `borrow`, `let` or `var`, a binding target, which is
    // a name or a parenthesized pattern, and `=`; or -1 when no binding
    // stands there, and `borrow` begins the place form
    // (syntax.rule.borrow-form).
    func borrow_binding_end(&self, ahead: Int) -> Int {
        let mode = self.kind_at(ahead + 1)
        if self.kind_at(ahead) != TokenKind.Borrow || (mode != TokenKind.Let && mode != TokenKind.Var) {
            return -1
        }
        var k = ahead + 2
        if self.kind_at(k) == TokenKind.Ident {
            k = k + 1
        } else if self.kind_at(k) == TokenKind.LParen {
            var depth = 0
            while true {
                let kind = self.kind_at(k)
                if kind == TokenKind.Eof {
                    return -1
                }
                k = k + 1
                if kind == TokenKind.LParen {
                    depth = depth + 1
                } else if kind == TokenKind.RParen {
                    depth = depth - 1
                    if depth == 0 {
                        break
                    }
                }
            }
        } else {
            return -1
        }
        if self.kind_at(k) == TokenKind.Assign { k } else { -1 }
    }

    // A borrow binding at an `if`, `else if` or `while` head, which only a
    // name may take (syntax.rule.borrow-form).
    func parse_borrow_unwrap(&var self) -> Bool {
        if self.kind_at(2) != TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Rule_BorrowForm, at,
                               "a borrow binding at an `if` or `while` head unwraps an optional place into one name",
                               "bind a name, then destructure it in the body")
        }
        let alt = if self.kind_at(1) == TokenKind.Var { Alt.Borrow_Unwrap_Var } else { Alt.Borrow_Unwrap_Let }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.advance()
        let _ = self.binding_name()
        self.advance()
        if not self.parse_head_expr(TokenKind.LBrace) {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `optional-binding ::= ("let" | "var") binding-target "=" binding-subject`
    func parse_optional_binding(&var self) -> Bool {
        let alt = if self.kind() == TokenKind.Var { Alt.Expr_OptionalBinding_Var } else { Alt.Expr_OptionalBinding_Let }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_binding_target() {
            return false
        }
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the optional to bind")
        }
        self.advance()
        if not self.parse_binding_subject(TokenKind.LBrace) {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `binding-target ::= binding-name | tuple-pattern`
    func parse_binding_target(&var self) -> Bool {
        if self.kind() == TokenKind.LParen {
            self.see(Alt.Stmt_BindingTarget_Tuple)
            return self.parse_tuple_pattern()
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        self.see(Alt.Stmt_BindingTarget_Name)
        self.binding_name()
    }

    // `binding-name ::= IDENT`
    func binding_name(&var self) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        self.see(Alt.Stmt_BindingName)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.close(mark, Alt.Stmt_BindingName, start)
        true
    }

    // `binding-subject ::= head-expr | optional-chain-target "=" expr`: a
    // chain whose optional run is open at its end, then `=`, writes through
    // the chain and tests whether it did; anything else is the value tested.
    func parse_binding_subject(&var self, follow: TokenKind) -> Bool {
        let place = self.kind() == TokenKind.Borrow && self.kind_at(1) == TokenKind.Var
        if place && self.borrow_binding_end(0) < 0 {
            return self.parse_borrow_subject(follow)
        }
        if not self.starts_postfix() {
            self.see(Alt.Stmt_BindingSubject_Value)
            return self.parse_head_expr(follow)
        }
        let head = self.enter_head(follow)
        let base = self.spine_count
        if not self.parse_postfix(true) {
            return false
        }
        let optional = self.open_optional_hop(base + 1)
        if self.kind() == TokenKind.Assign && optional >= 0 {
            self.see(Alt.Stmt_BindingSubject_ChainAssign)
            self.see_chain_target(base, optional)
            self.take_leaf()
            if not self.parse_expr() {
                return false
            }
            self.leave_head(&head)
            return true
        }
        self.see(Alt.Stmt_BindingSubject_Value)
        self.see(Alt.Expr_Head)
        self.see(Alt.Expr_Prefix_Postfix)
        self.release_spine(base)
        self.primed = true
        if not self.parse_expr() {
            return false
        }
        self.leave_head(&head)
        true
    }

    // A binding subject that begins with `borrow var`: an exclusive place
    // form whose operand's optional run is open at its end, then `=`, writes
    // through the chain and tests whether it did
    // (syntax.stmt.binding-subject.borrow-chain-assign); otherwise the place
    // is the first operand of the value tested.
    func parse_borrow_subject(&var self, follow: TokenKind) -> Bool {
        let head = self.enter_head(follow)
        let base = self.spine_count
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_borrow_place(true) {
            return false
        }
        let optional = self.open_optional_hop(base + 2)
        if self.kind() == TokenKind.Assign && optional >= 0 {
            self.see(Alt.Stmt_BindingSubject_BorrowChainAssign)
            self.see(Alt.Borrow_OptionalTarget)
            self.see_chain_target(base + 1, optional)
            self.spine_count = base
            self.close(mark, Alt.Borrow_OptionalTarget, start)
            self.take_leaf()
            if not self.parse_expr() {
                return false
            }
            self.leave_head(&head)
            return true
        }
        self.see(Alt.Stmt_BindingSubject_Value)
        self.see(Alt.Expr_Head)
        self.see(Alt.Expr_Prefix_Borrow)
        self.release_spine(base)
        self.close(mark, Alt.Borrow_Place_Var, start)
        self.primed = true
        if not self.parse_expr() {
            return false
        }
        self.leave_head(&head)
        true
    }

    // The kept hop of a chain, from `first` on, that is its optional-chain
    // target's optional hop: the first `?.` after the last hop that closes a
    // run, or -1 when no run is open at the chain's end
    // (syntax.rule.optional-chain-run).
    func open_optional_hop(&self, first: Int) -> Int {
        var optional = -1
        var k = first
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            if alt == Alt.Expr_Hop_Subscript || alt == Alt.Expr_Hop_Force || alt == Alt.Expr_Hop_TupleIndex {
                optional = -1
            } else if alt == Alt.Expr_Hop_Optional && optional < 0 {
                optional = k
            }
            k = k + 1
        }
        optional
    }

    // Records the kept chain from `base` as an optional-chain target whose
    // optional hop is the one at `optional`: hops before it as postfix hops,
    // hops after it as chain hops.
    func see_chain_target(&var self, base: Int, optional: Int) {
        var k = base + 1
        while k < optional {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        k = optional + 1
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            self.see(chain_hop(alt))
            k = k + 1
        }
        self.spine_count = base
        self.see(Alt.Stmt_OptionalChainTarget)
    }

    // `guard-stmt`: `guard let` or `guard var` and a binding, or a boolean
    // `guard` condition, then `else` and a block, one level held to the end
    // of the block.
    func parse_guard(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if self.borrow_binding_end(1) > 0 {
            return self.refuse_guard_borrow()
        }
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Stmt_Guard_Condition
        if self.kind_at(1) == TokenKind.Let || self.kind_at(1) == TokenKind.Var {
            alt = if self.kind_at(1) == TokenKind.Var { Alt.Stmt_Guard_Var } else { Alt.Stmt_Guard_Let }
            self.see(alt)
            self.advance()
            self.advance()
            if not self.parse_binding_target() {
                return false
            }
            if self.kind() != TokenKind.Assign {
                return self.error("expected `=` and the optional to bind")
            }
            self.advance()
            if not self.parse_binding_subject(TokenKind.Else) {
                return false
            }
        } else {
            self.see(alt)
            self.see(Alt.Stmt_GuardCondition)
            self.take_leaf()
            if not self.parse_head_expr(TokenKind.Else) {
                return false
            }
        }
        self.skip_newlines()
        if self.kind() != TokenKind.Else {
            return self.error("expected `else` and a block that leaves the scope")
        }
        if alt == Alt.Stmt_Guard_Condition {
            self.take_leaf()
        } else {
            self.advance()
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // A borrow binding at a `guard` head, which a guard never takes: a name
    // bound from a head that `else` follows is the refused form
    // (syntax.stmt.refused-guard-borrow), and anything else is refused as the
    // binding it reads as, never as a `borrow` block condition
    // (syntax.rule.borrow-form), unless the head restriction refuses it.
    func refuse_guard_borrow(&var self) -> Bool {
        let word = self.pos + 1
        if self.kind_at(3) == TokenKind.Ident {
            var k = 0
            while k < 5 {
                self.advance()
                k = k + 1
            }
            if not self.parse_head_expr(TokenKind.Else) {
                return false
            }
            if self.else_ahead() {
                return self.refuse(Rule.Stmt_RefusedGuardBorrow, word,
                                   "a `guard` takes no borrow binding: its braces run on the absent path",
                                   "write `if borrow let e = … \{ … \} else \{ … \}`")
            }
        }
        if self.head_restricted() {
            return self.refuse_head_restriction()
        }
        self.refuse(Rule.Rule_BorrowForm, word,
                    "a borrow binding at a `guard` head is refused, never read as a `borrow` block",
                    "parenthesize a `borrow` block condition: `guard (borrow let e = … \{ … \}) else \{ … \}`")
    }

    // `while-expr` and `while-let-expr`: a conditional loop, one with no
    // condition, or one that binds while its subject is present, which takes
    // no `else` (syntax.expr.refused-while-let-else). One level held to the
    // end of the body.
    func parse_while(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        let next = self.kind_at(1)
        var alt = Alt.Expr_While_Conditional
        if next == TokenKind.LBrace {
            alt = Alt.Expr_While_Infinite
            self.see(alt)
            self.advance()
            return self.parse_infinite_while(mark, start)
        } else if self.borrow_binding_end(1) > 0 {
            // A binding after `borrow` is the unwrap, never a `borrow` block
            // read as the condition (syntax.rule.borrow-form).
            alt = Alt.Expr_While_Borrow
            self.see(alt)
            self.advance()
            if not self.parse_borrow_unwrap() {
                return false
            }
        } else if next == TokenKind.Let || next == TokenKind.Var {
            alt = if next == TokenKind.Var { Alt.Expr_WhileLet_Var } else { Alt.Expr_WhileLet_Let }
            self.see(alt)
            self.advance()
            self.advance()
            if not self.parse_binding_target() {
                return false
            }
            if self.kind() != TokenKind.Assign {
                return self.error("expected `=` and the optional to bind")
            }
            self.advance()
            if not self.parse_head_expr(TokenKind.LBrace) {
                return false
            }
        } else {
            self.see(alt)
            self.advance()
            if not self.parse_head_expr(TokenKind.LBrace) {
                return false
            }
        }
        if not self.parse_body() {
            return false
        }
        let binds = alt == Alt.Expr_WhileLet_Let || alt == Alt.Expr_WhileLet_Var
        if binds && self.else_ahead() {
            self.skip_newlines()
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedWhileLetElse, at,
                               "a `while let` loop takes no `else`: it ends when the binding fails",
                               "write `if let … else` for a single test")
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // The body of `while {`, which a `{` right after `while` always begins
    // (syntax.rule.infinite-loop). Where a condition read from that `{` would
    // reach a body, the text is the refused form instead: a body with an
    // error is syntax.expr.refused-brace-condition, and a sound body the
    // rule's refusal at the token after it on its line.
    func parse_infinite_while(&var self, mark: Int, start: Int) -> Bool {
        let brace = self.pos
        let reported = self.diagnostics.len()
        let errors = reported + self.dropped
        let bodied = self.parse_body()
        let clean = self.diagnostics.len() + self.dropped == errors
        if not clean && self.brace_condition_ahead(brace) {
            if self.speculating == 0 {
                trim_to(&var self.diagnostics, reported)
            }
            return self.refuse(Rule.Expr_RefusedBraceCondition, brace,
                               "a `\{` right after `while` begins an infinite loop's body, never a condition",
                               "parenthesize a condition that starts with a brace: `while (\{ check() \}()) \{ step() \}`")
        }
        if not bodied {
            return false
        }
        let kind = self.kind()
        let continues = kind == TokenKind.LBrace || continues_operand(kind)
        if clean && continues && self.brace_condition_ahead(brace) {
            let at = self.pos
            return self.refuse(Rule.Rule_InfiniteLoop, at,
                               "a `\{` right after `while` begins an infinite loop's body, so the loop ends before this",
                               "parenthesize a condition that starts with a brace: `while (\{ check() \}()) \{ step() \}`")
        }
        self.close(mark, Alt.Expr_While_Infinite, start)
        self.leave_level()
        true
    }

    // Whether a condition read from the `{` at `brace`, with no error, goes
    // on to a body's `{`: the refused form's reading. Undone whatever it
    // finds.
    func brace_condition_ahead(&var self, brace: Int) -> Bool {
        let saved = self.checkpoint()
        let clean = self.dropped
        self.pos = brace
        self.primed = false
        var goes = self.parse_head_expr(TokenKind.LBrace)
        if goes {
            self.skip_newlines()
        }
        goes = goes && self.kind() == TokenKind.LBrace && self.dropped == clean
        self.restore(&saved)
        goes
    }

    // `for-expr ::= "for" binding-name "in" head-expr NEWLINE* block`, one
    // level held to the end of the body. A `for` head binds one name, so a
    // tuple pattern there is refused once it has parsed
    // (syntax.expr.refused-for-tuple).
    func parse_for(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.LParen {
            let at = self.pos
            if not self.parse_tuple_pattern() {
                return false
            }
            return self.refuse(Rule.Expr_RefusedForTuple, at,
                               "a `for` head binds one name",
                               "bind the element and destructure it in the body: `for p in v \{ let (a, b) = p \}`")
        }
        if self.kind() == TokenKind.Borrow {
            return self.parse_for_borrow(mark, start)
        }
        self.see(Alt.Expr_For_Plain)
        if not self.binding_name() {
            return false
        }
        if self.kind() != TokenKind.In {
            return self.error("expected `in` and what to iterate")
        }
        self.advance()
        if not self.parse_head_expr(TokenKind.LBrace) {
            return false
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, Alt.Expr_For_Plain, start)
        self.leave_level()
        true
    }

    // `for-borrow ::= "for" "borrow" ("let" | "var") binding-name "in" head-expr
    // NEWLINE* block`, after its `borrow`: a For node around the ForBorrow
    // node, both from the `for` at `start`, and the one level `parse_for` took.
    func parse_for_borrow(&var self, mark: Int, start: Int) -> Bool {
        let mode = self.kind_at(1)
        if mode != TokenKind.Let && mode != TokenKind.Var {
            self.advance()
            return self.error("expected `let` or `var` after `for borrow`")
        }
        let alt = if mode == TokenKind.Var { Alt.Borrow_For_Var } else { Alt.Borrow_For_Let }
        self.see(Alt.Expr_For_Borrow)
        self.see(alt)
        self.advance()
        self.advance()
        if not self.binding_name() {
            return false
        }
        if self.kind() != TokenKind.In {
            return self.error("expected `in` and what to iterate")
        }
        self.advance()
        if not self.parse_head_expr(TokenKind.LBrace) {
            return false
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, alt, start)
        self.close(mark, Alt.Expr_For_Borrow, start)
        self.leave_level()
        true
    }

    // `match-expr ::= "match" head-expr NEWLINE* "{" NEWLINE* match-arm-list? "}"`,
    // one level held to its `}`. Arms are separated by a comma, a line break
    // or nothing.
    func parse_match(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_Match)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_head_expr(TokenKind.LBrace) {
            return false
        }
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the match arms")
        }
        let brace = self.pos
        let head = self.head
        self.head = HeadState.Off
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.RBrace {
            self.see(Alt.Expr_MatchArms)
        }
        while self.kind() != TokenKind.RBrace {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(brace)
            }
            if self.kind() != TokenKind.Case {
                return self.error("expected `case` to begin an arm")
            }
            if not self.parse_match_arm() {
                return false
            }
            if not self.arm_separator() {
                return false
            }
        }
        self.advance()
        self.head = head
        self.close(mark, Alt.Expr_Match, start)
        self.leave_level()
        true
    }

    // `arm-sep ::= NEWLINE* "," NEWLINE* | NEWLINE+ | ε`, after an arm; the
    // last arm's separator, if any, stands before the `}`.
    func arm_separator(&var self) -> Bool {
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) == TokenKind.Comma {
            self.see(Alt.Expr_ArmSep_Comma)
            self.skip_newlines()
            self.advance()
            self.skip_newlines()
            return true
        }
        if ahead > 0 {
            self.see(Alt.Expr_ArmSep_Newline)
            self.skip_newlines()
            return true
        }
        if self.kind() == TokenKind.Case {
            self.see(Alt.Expr_ArmSep_None)
            return true
        }
        if self.kind() == TokenKind.RBrace || self.kind() == TokenKind.Eof {
            return true
        }
        self.error("expected `,`, a line break or `case` after the arm")
    }

    // `match-arm ::= "case" pattern arm-guard? "->" arm-body`, with
    // `arm-guard ::= "if" head-expr`, whose `if` prints.
    func parse_match_arm(&var self) -> Bool {
        self.see(Alt.Expr_MatchArm)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_pattern() {
            return false
        }
        if self.kind() == TokenKind.If {
            self.see(Alt.Expr_ArmGuard)
            self.take_leaf()
            if not self.parse_head_expr(TokenKind.Arrow) {
                return false
            }
        }
        if self.kind() != TokenKind.Arrow {
            return self.error("expected `->` and the arm's body")
        }
        self.advance()
        if not self.parse_arm_body() {
            return false
        }
        self.close(mark, Alt.Expr_MatchArm, start)
        true
    }

    // `arm-body ::= block | expr | non-expr-statement`: a body that starts
    // with `{` is a block, and the statement parser decides the rest
    // (syntax.rule.arm-body). A block that reads as a map or set literal
    // names that rule when it fails.
    func parse_arm_body(&var self) -> Bool {
        if self.kind() != TokenKind.LBrace {
            return self.parse_statement(StatementPlace.Arm)
        }
        self.see(Alt.Expr_ArmBody_Block)
        let saved = self.literal_arm
        if self.brace_reads_as_literal() {
            self.literal_arm = self.pos
        }
        if not self.parse_block() {
            return false
        }
        self.literal_arm = saved
        true
    }

    // Whether the brace here would read as a map or set literal where no
    // block is required (syntax.rule.brace): `{:}`, or a first element, one
    // that no statement-only keyword or closure head begins, followed by a
    // `:` on its line or a `,`. Only a refusal's name rests on it, so it
    // scans the element's tokens rather than parsing them, and a generic
    // list's comma inside the element reads as the set's.
    func brace_reads_as_literal(&self) -> Bool {
        if self.empty_map_ahead() {
            return true
        }
        if self.closure_head_ahead() {
            return false
        }
        var k = 1
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        if self.starts_statement_only(k) {
            return false
        }
        var nested = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof {
                return false
            }
            if opens_bracket(kind) {
                nested = nested + 1
            } else if closes_bracket(kind) {
                if nested == 0 {
                    return false
                }
                nested = nested - 1
            } else if nested == 0 {
                if kind == TokenKind.Colon || kind == TokenKind.Comma {
                    return true
                }
                if kind == TokenKind.Semicolon {
                    return false
                }
                if kind == TokenKind.Newline {
                    while self.kind_at(k) == TokenKind.Newline {
                        k = k + 1
                    }
                    return self.kind_at(k) == TokenKind.Comma
                }
            }
            k = k + 1
        }
        false
    }

    // `pattern`. A name followed by `(` is a variant pattern, `_` the
    // wildcard, and any other lone name a name pattern, whether it binds or
    // names a payload-free variant being resolution's to decide
    // (syntax.rule.name-pattern). A name followed by `.`, and a leading `.`,
    // are the refused qualified and dotted variant patterns.
    func parse_pattern(&var self) -> Bool {
        let kind = self.kind()
        let next = self.kind_at(1)
        if kind == TokenKind.Ident {
            if next == TokenKind.Dot {
                let at = self.pos
                return self.refuse(Rule.Pat_RefusedQualifiedVariant, at,
                                   "a variant pattern names the case alone",
                                   "write the case bare, as in `case Red`; the scrutinee's type supplies the enum")
            }
            if next == TokenKind.LParen {
                self.see(Alt.Pat_Pattern_Variant)
                return self.parse_variant_pattern()
            }
            if self.word_at(0, "_") {
                self.see(Alt.Pat_Pattern_Wildcard)
                return self.token_node(Alt.Pat_Wildcard, false)
            }
            self.see(Alt.Pat_Pattern_Name)
            return self.token_node(Alt.Pat_Name, true)
        }
        if kind == TokenKind.Dot && next == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Pat_RefusedDotVariant, at,
                               "a variant pattern names the case bare",
                               "drop the `.`, as in `case North`")
        }
        if kind == TokenKind.NoneKw {
            self.see(Alt.Pat_Pattern_None)
            return self.token_node(Alt.Pat_None, false)
        }
        if kind == TokenKind.LParen {
            self.see(Alt.Pat_Pattern_Tuple)
            return self.parse_tuple_pattern()
        }
        if kind == TokenKind.IntLit || (kind == TokenKind.Minus && next == TokenKind.IntLit) {
            let after = if kind == TokenKind.Minus { self.kind_at(2) } else { next }
            if after == TokenKind.DotDot || after == TokenKind.DotDotEq {
                self.see(Alt.Pat_Pattern_Range)
                return self.parse_range_pattern()
            }
            self.see(Alt.Pat_Pattern_Literal)
            if kind == TokenKind.IntLit {
                return self.token_node(Alt.Pat_Literal_Int, true)
            }
            self.see(Alt.Pat_Literal_NegativeInt)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            self.take_leaf()
            self.close(mark, Alt.Pat_Literal_NegativeInt, start)
            return true
        }
        if kind == TokenKind.StringLit {
            self.see(Alt.Pat_Pattern_Literal)
            return self.token_node(Alt.Pat_Literal_String, true)
        }
        if kind == TokenKind.True_ || kind == TokenKind.False_ {
            self.see(Alt.Pat_Pattern_Literal)
            let alt = if kind == TokenKind.True_ { Alt.Pat_Literal_True } else { Alt.Pat_Literal_False }
            return self.token_node(alt, false)
        }
        self.error("expected a pattern")
    }

    // `range-pattern ::= pattern-int (".." | "..=") pattern-int`, whose ends
    // are integers only; a `-` before either prints, since `pattern-int`
    // builds no node to imply it.
    func parse_range_pattern(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if not self.pattern_int() {
            return false
        }
        let alt = if self.kind() == TokenKind.DotDotEq { Alt.Pat_Range_Inclusive } else { Alt.Pat_Range_Exclusive }
        self.see(alt)
        self.advance()
        if not self.pattern_int() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `pattern-int ::= INT | "-" INT`, as leaves of the range around it.
    func pattern_int(&var self) -> Bool {
        if self.kind() == TokenKind.Minus && self.kind_at(1) == TokenKind.IntLit {
            self.see(Alt.Pat_Int_Negative)
            self.take_leaf()
            self.take_leaf()
            return true
        }
        if self.kind() != TokenKind.IntLit {
            return self.error("a range pattern's ends are integer literals")
        }
        self.see(Alt.Pat_Int_Positive)
        self.take_leaf()
        true
    }

    // `tuple-pattern ::= "(" ( pattern "," ( pattern ( "," pattern )* ","? )? )? ")"`,
    // one level held for its `(`. A name and `:` first make it the refused
    // named tuple pattern (syntax.pat.refused-named-tuple), and one element
    // with no comma the refused parenthesized pattern (syntax.pat.refused-paren).
    func parse_tuple_pattern(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_tuple_pattern_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_tuple_pattern_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            return self.refuse(Rule.Pat_RefusedNamedTuple, open,
                               "patterns destructure tuples by position only",
                               "drop the labels, as in `(a, b)`")
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.TuplePattern), open, false, &var count) {
            return false
        }
        self.advance()
        self.see(Alt.Pat_Tuple_Positional)
        self.close(mark, Alt.Pat_Tuple_Positional, start)
        true
    }

    // `variant-pattern ::= IDENT "(" ( payload-pattern ( "," payload-pattern )* ","? )? ")"`,
    // one level held for the payload's `(`.
    func parse_variant_pattern(&var self) -> Bool {
        let open = self.pos + 1
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_variant_pattern_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_variant_pattern_body(&var self, open: Int) -> Bool {
        self.see(Alt.Pat_Variant)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.PayloadPatterns), open, false, &var count) {
            return false
        }
        self.advance()
        self.close(mark, Alt.Pat_Variant, start)
        true
    }

    // `payload-pattern ::= pattern | borrow-binding-pattern`, with
    // `borrow-binding-pattern ::= "borrow" ("let" | "var") IDENT`, which only a
    // payload takes (GRAMMAR.md section 9).
    func payload_pattern(&var self) -> Bool {
        if self.kind() != TokenKind.Borrow {
            self.see(Alt.Pat_Payload_Pattern)
            return self.parse_pattern()
        }
        let mode = self.kind_at(1)
        if (mode != TokenKind.Let && mode != TokenKind.Var) || self.kind_at(2) != TokenKind.Ident {
            return self.error("a borrow binding in a payload is `borrow let` or `borrow var` and a name")
        }
        let alt = if mode == TokenKind.Var { Alt.Pat_BorrowBinding_Var } else { Alt.Pat_BorrowBinding_Let }
        self.see(Alt.Pat_Payload_Borrow)
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.advance()
        self.take_leaf()
        self.close(mark, alt, start)
        true
    }

    // ---- types -------------------------------------------------------------------

    // `type ::= ref-type | func-type | type-atom type-suffix*`. A reference and
    // a function type are not atoms, so a `?` after `&` or `->` belongs to the
    // type after it (syntax.rule.prefix-type-suffix). In a type `<` opens a
    // generic list, but where the type ends a cast target (`cast`) the list
    // after its last named type is speculative (syntax.rule.generic-or-less).
    func parse_type(&var self, cast: Bool) -> Bool {
        if self.kind() == TokenKind.Ampersand && not self.slice_ahead() {
            self.see(Alt.Type_Type_Ref)
            return self.parse_ref_type(cast)
        }
        if self.kind() == TokenKind.LParen && self.func_type_ahead() {
            self.see(Alt.Type_Type_Func)
            return self.parse_func_type(cast)
        }
        self.see(Alt.Type_Type_Suffixed)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_type_atom(cast) {
            return false
        }
        while self.kind() == TokenKind.Question || self.kind() == TokenKind.DoubleQuestion {
            // At the end of a cast target a `?` is the type's only when what
            // follows it may follow the cast; otherwise it is the cast's, and
            // a `??` there is refused (syntax.rule.cast-target-question).
            if cast && not follows_cast_list(self.kind_at(1)) {
                break
            }
            let double = self.kind() == TokenKind.DoubleQuestion
            let alt = if double { Alt.Type_Suffix_DoubleOptional } else { Alt.Type_Suffix_Optional }
            self.see(alt)
            self.advance()
            self.close(mark, alt, start)
            if double {
                self.close(mark, alt, start)
            }
        }
        true
    }

    // `type-atom`: a named type, a slice, an array, a tuple or a grouped
    // type, or `any` and a path.
    func parse_type_atom(&var self, cast: Bool) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Ident && self.word_at(0, "any") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.Type_Atom_Any)
            self.see(Alt.Type_Any)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            if not self.parse_path() {
                return false
            }
            self.close(mark, Alt.Type_Any, start)
            return true
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Type_Atom_Named)
            return self.parse_named_type(cast)
        }
        if kind == TokenKind.Ampersand {
            self.see(Alt.Type_Atom_Slice)
            return self.parse_slice_type()
        }
        if kind == TokenKind.LBracket {
            self.see(Alt.Type_Atom_Array)
            return self.parse_array_type()
        }
        if kind == TokenKind.LParen {
            return self.parse_paren_type()
        }
        self.error("expected a type")
    }

    // `named-type ::= path generic-args?`
    func parse_named_type(&var self, cast: Bool) -> Bool {
        self.see(Alt.Type_Named)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_path() {
            return false
        }
        if self.kind() == TokenKind.Lt {
            if cast {
                if self.speculate_list(true) == ListOutcome.Refused {
                    return false
                }
            } else if not self.parse_generic_args() {
                return false
            }
        }
        self.close(mark, Alt.Type_Named, start)
        true
    }

    // Whether the `&` here opens a slice, `&[T]` or `&var [T]`, which is an
    // atom, rather than a reference: to an array, `&[T; N]`, when a `;`
    // stands at its bracket's own level.
    func slice_ahead(&self) -> Bool {
        var k = 1
        if self.kind_at(k) == TokenKind.Var {
            k = 2
        }
        if self.kind_at(k) != TokenKind.LBracket {
            return false
        }
        var open = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof || kind == TokenKind.LBrace || kind == TokenKind.RBrace {
                return true
            }
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                open = open + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                open = open - 1
                if open == 0 {
                    return true
                }
            } else if kind == TokenKind.Semicolon && open == 1 {
                return false
            }
            k = k + 1
        }
        true
    }

    // `ref-type ::= "&" type | "&" "var" type`, charging one level held to
    // the end of the type it refers to.
    func parse_ref_type(&var self, cast: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let alt = if self.kind_at(1) == TokenKind.Var { Alt.Type_Ref_Exclusive } else { Alt.Type_Ref_Shared }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if alt == Alt.Type_Ref_Exclusive {
            self.advance()
        }
        if not self.parse_type(cast) {
            return false
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `slice-type ::= "&" "[" type "]" | "&" "var" "[" type "]"`, one level.
    func parse_slice_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let alt = if self.kind_at(1) == TokenKind.Var { Alt.Type_Slice_Exclusive } else { Alt.Type_Slice_Shared }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if alt == Alt.Type_Slice_Exclusive {
            self.advance()
        }
        let bracket = self.pos
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        if self.kind() != TokenKind.RBracket {
            return self.list_error(bracket, "expected `]` after the slice's element type")
        }
        self.advance()
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `array-type ::= "[" type ";" expr "]"`, one level for the `[`. A length
    // is closed by `]`, so it takes the full expression grammar.
    func parse_array_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Type_Array)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        if self.kind() != TokenKind.Semicolon {
            return self.list_error(open, "expected `;` and the array's length")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        if self.kind() != TokenKind.RBracket {
            return self.list_error(open, "expected `]` after the array's length")
        }
        self.advance()
        self.close(mark, Alt.Type_Array, start)
        self.leave_level()
        true
    }

    // Whether the `(` here opens a function type: its `)` is followed by an
    // effect word or `->` (syntax.rule.paren-type). `consumes` counts, so that
    // a function type that writes it is refused as one.
    func func_type_ahead(&self) -> Bool {
        var k = self.pos
        var open = 0
        while k < self.limit {
            let kind = self.tokens[k].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                open = open + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                open = open - 1
                if open == 0 {
                    break
                }
            } else if kind == TokenKind.Eof || kind == TokenKind.LBrace || kind == TokenKind.RBrace {
                return false
            }
            k = k + 1
        }
        let after = k + 1 - self.pos
        let next = self.kind_at(after)
        if next == TokenKind.Arrow || next == TokenKind.Unsafe_ || next == TokenKind.Borrows {
            return true
        }
        self.word_at(after, "sync") || self.word_at(after, "escaping") || self.word_at(after, "consumes")
    }

    // `func-type ::= "(" func-type-params? ")" func-type-effects "->" type`,
    // one level for the parameter list, held to the end of the return type.
    // The effects print, in their one order (syntax.rule.effect-slot).
    func parse_func_type(&var self, cast: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Type_Func)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Type_FuncParams)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.FuncTypeParams), open, false, &var count) {
            return false
        }
        self.advance()
        self.see(Alt.Type_FuncEffects)
        if self.kind() == TokenKind.Unsafe_ {
            self.take_leaf()
        }
        if self.word_at(0, "sync") {
            self.take_leaf()
        }
        if self.word_at(0, "escaping") {
            self.take_leaf()
        }
        if self.kind() == TokenKind.Borrows {
            self.take_leaf()
            if self.kind() == TokenKind.LParen && self.word_at(1, "sync") && self.kind_at(2) == TokenKind.RParen {
                self.see(Alt.Type_FuncBorrows_Sync)
                self.advance()
                self.take_leaf()
                self.advance()
            } else {
                self.see(Alt.Type_FuncBorrows_Plain)
            }
        }
        if self.word_at(0, "consumes") {
            let at = self.pos
            return self.refuse(Rule.Type_RefusedFuncConsumes, at,
                               "`consumes` ends a method's receiver, and a function type has none",
                               "call the method")
        }
        if self.kind() != TokenKind.Arrow {
            return self.error("expected `->` and the function type's return type")
        }
        self.advance()
        if not self.parse_type(cast) {
            return false
        }
        self.close(mark, Alt.Type_Func, start)
        self.leave_level()
        true
    }

    // A `(` that opens no function type: `()`, a tuple type, a one-element
    // tuple `(T,)`, or grouping parentheses, which build no node
    // (syntax.rule.paren-type). A tuple labels every element or none
    // (syntax.rule.label-or-tuple); a mix is refused once it has parsed.
    // Each charges one level for its `(`.
    func parse_paren_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_paren_type_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_paren_type_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.RParen {
            self.advance()
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Unit)
            self.close(mark, Alt.Type_Tuple_Unit, start)
            return true
        }
        let named = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
        let first = self.builder.mark()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.TupleType), open, false, &var count) {
            return false
        }
        let elements = count.elements
        let trailing = count.trailing
        let mixed = self.first_mixed_element(first, elements, Alt.Type_TupleField)
        self.advance()
        if mixed >= 0 {
            return self.refuse(Rule.Type_RefusedPartialNamedTuple, mixed,
                               "a named tuple type labels every element or none",
                               "label every element, or none")
        }
        if named {
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Named)
            self.close(mark, Alt.Type_Tuple_Named, start)
        } else if elements == 1 && trailing {
            self.see(Alt.Type_Atom_SingleTuple)
            self.see(Alt.Type_SingleTuple)
            self.close(mark, Alt.Type_SingleTuple, start)
        } else if elements == 1 {
            self.see(Alt.Type_Atom_Paren)
            self.see(Alt.Type_Paren)
        } else {
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Positional)
            self.close(mark, Alt.Type_Tuple_Positional, start)
        }
        true
    }

    // An element of a parenthesized type list: a name and `:` label it
    // (syntax.rule.label-or-tuple).
    func parse_tuple_type_element(&var self) -> Bool {
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            return self.parse_tuple_type_field()
        }
        self.parse_type(false)
    }

    // `tuple-type-field ::= IDENT ":" type`
    func parse_tuple_type_field(&var self) -> Bool {
        self.see(Alt.Type_TupleField)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Type_TupleField, start)
        true
    }

    // ---- generic lists ------------------------------------------------------------

    // `generic-params ::= "<" generic-param ( "," generic-param )* ">"`, one
    // level for the list. A trailing comma is refused
    // (syntax.generic.refused-param-comma).
    func parse_generic_params(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_generic_params_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_generic_params_body(&var self) -> Bool {
        self.see(Alt.Generic_Params_List)
        self.lists = self.lists + 1
        let open = self.pos
        self.advance()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.GenericParams), open, false, &var count) {
            return false
        }
        self.close_list()
        true
    }

    // `generic-param ::= IDENT bound-list? ( "=" type )? | 'const' IDENT ":" type ( "=" const-expr )?`,
    // with `bound-list ::= ":" path ( "+" path )*`.
    func parse_generic_param(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if self.word_at(0, "const") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.Generic_Param_Const)
            self.advance()
            self.take_leaf()
            if self.kind() != TokenKind.Colon {
                return self.error("expected `:` and the constant parameter's type")
            }
            self.advance()
            if not self.parse_type(false) {
                return false
            }
            if self.kind() == TokenKind.Assign {
                self.take_leaf()
                if not self.parse_const_expr() {
                    return false
                }
            }
            self.close(mark, Alt.Generic_Param_Const, start)
            return true
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected a generic parameter's name")
        }
        self.see(Alt.Generic_Param_Type)
        self.take_leaf()
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Generic_Bounds)
            self.advance()
            if not self.parse_path() {
                return false
            }
            while self.kind() == TokenKind.Plus {
                self.take_leaf()
                if not self.parse_path() {
                    return false
                }
            }
        }
        if self.kind() == TokenKind.Assign {
            self.take_leaf()
            if not self.parse_type(false) {
                return false
            }
        }
        self.close(mark, Alt.Generic_Param_Type, start)
        true
    }

    // `generic-args ::= "<" generic-arg ( "," generic-arg )* ">"`, one level
    // for the list, held to its `>`. A trailing comma is refused
    // (syntax.generic.refused-arg-comma); inside a speculation it is noted,
    // and refused only if the list is kept.
    func parse_generic_args(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_generic_args_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_generic_args_body(&var self) -> Bool {
        self.see(Alt.Generic_Args_List)
        self.lists = self.lists + 1
        let open = self.pos
        self.advance()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.GenericArgs), open, false, &var count) {
            return false
        }
        self.close_list()
        true
    }

    // Whether the current token closes the innermost generic list: a `>`, or
    // the first `>` of a `>=`, or of a `>>=` whose second `>` closes the list
    // around it (syntax.rule.generic-close-split).
    func closes_list(&self) -> Bool {
        let kind = self.kind()
        kind == TokenKind.Gt || kind == TokenKind.Gte || (kind == TokenKind.ShrAssign && self.lists >= 2)
    }

    // Consumes the `>` that closes the innermost list. A `>=` or `>>=` is split
    // after that `>`, and what remains of it is the current token.
    func close_list(&var self) {
        self.lists = self.lists - 1
        let t = self.current()
        if t.kind == TokenKind.Gt {
            self.advance()
            return
        }
        let rest = if t.kind == TokenKind.ShrAssign { TokenKind.Gte } else { TokenKind.Assign }
        let edit = TokenEdit(index: self.pos, token: t)
        // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.edits, self.edit_count, edit)
        let at = self.edit_count
        put_at(&var self.edits, at, edit)
        self.edit_count = at + 1
        self.tokens[self.pos] = ParseToken(kind: rest, start: t.start + 1, end: t.end, line: t.line,
                                           seg_start: 0, seg_count: 0)
        self.prev_end = t.start + 1
    }

    // `generic-arg ::= type | const-expr`. An argument that starts with an
    // integer, `-`, `sizeof` or `alignof` is a value, and so is one a type
    // cannot spell; the rest are types (syntax.rule.generic-arg-value).
    func parse_generic_arg(&var self) -> Bool {
        if self.value_ahead() {
            self.see(Alt.Generic_Arg_Value)
            return self.parse_const_expr()
        }
        self.see(Alt.Generic_Arg_Type)
        self.parse_type(false)
    }

    // Whether the generic argument here is a value. A path followed by an
    // arithmetic operator is one, as is a parenthesized argument holding an
    // integer, an operator or a layout query outside any `[]` or `<>` of its
    // own, or followed by an operator.
    func value_ahead(&self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.IntLit || kind == TokenKind.Minus {
            return true
        }
        if self.layout_ahead(0) {
            return true
        }
        var k = 0
        if kind == TokenKind.Ident {
            k = 1
            while self.kind_at(k) == TokenKind.Dot && self.kind_at(k + 1) == TokenKind.Ident {
                k = k + 2
            }
            return is_const_operator(self.kind_at(k))
        }
        if kind != TokenKind.LParen {
            return false
        }
        var parens = 0
        var nested = 0
        while true {
            let at = self.kind_at(k)
            if at == TokenKind.Eof || at == TokenKind.LBrace || at == TokenKind.RBrace {
                return false
            }
            if at == TokenKind.LParen {
                parens = parens + 1
            } else if at == TokenKind.RParen {
                parens = parens - 1
                if parens == 0 {
                    return is_const_operator(self.kind_at(k + 1))
                }
            } else if at == TokenKind.LBracket || at == TokenKind.Lt {
                nested = nested + 1
            } else if at == TokenKind.RBracket || at == TokenKind.Gt {
                nested = nested - 1
            } else if nested == 0 && (at == TokenKind.IntLit || is_const_operator(at) || self.layout_ahead(k)) {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether `sizeof` or `alignof` and a `<` stand `ahead` tokens on.
    func layout_ahead(&self, ahead: Int) -> Bool {
        let word = self.word_at(ahead, "sizeof") || self.word_at(ahead, "alignof")
        word && self.kind_at(ahead + 1) == TokenKind.Lt
    }

    // `const-expr ::= const-term ( const-add-op const-term )*`, one flat node.
    func parse_const_expr(&var self) -> Bool {
        self.see(Alt.Const_Expr)
        let mark = self.builder.mark()
        if not self.parse_const_term() {
            return false
        }
        var ops = 0
        while self.kind() == TokenKind.Plus || self.kind() == TokenKind.Minus {
            let op = if self.kind() == TokenKind.Plus { Alt.Const_AddOp_Plus } else { Alt.Const_AddOp_Minus }
            self.see(op)
            self.take_leaf()
            if not self.parse_const_term() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Const_Expr)
        }
        true
    }

    // `const-term ::= const-unary ( const-mul-op const-unary )*`
    func parse_const_term(&var self) -> Bool {
        self.see(Alt.Const_Term)
        let mark = self.builder.mark()
        if not self.parse_const_unary() {
            return false
        }
        var ops = 0
        while let op = self.const_mul_op() {
            self.see(op)
            self.take_leaf()
            if not self.parse_const_unary() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Const_Term)
        }
        true
    }

    func const_mul_op(&self) -> Alt? {
        match self.kind() {
            case Star -> Alt.Const_MulOp_Times,
            case Slash -> Alt.Const_MulOp_Divide,
            case Percent -> Alt.Const_MulOp_Remainder,
            case _ -> None
        }
    }

    // `const-unary ::= const-negate | const-atom`
    func parse_const_unary(&var self) -> Bool {
        if self.kind() == TokenKind.Minus {
            self.see(Alt.Const_Unary_Negate)
            return self.parse_const_negate()
        }
        self.see(Alt.Const_Unary_Atom)
        self.parse_const_atom()
    }

    // `const-negate ::= "-" const-unary`, one level held to its operand's end.
    func parse_const_negate(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Const_Negate)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_const_unary() {
            return false
        }
        self.close(mark, Alt.Const_Negate, start)
        self.leave_level()
        true
    }

    // `const-atom ::= int-literal | path | "(" const-expr ")" | layout-query`.
    // The parentheses group, and charge one level.
    func parse_const_atom(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.IntLit {
            self.see(Alt.Const_Atom_Int)
            return self.token_node(Alt.Expr_Int, true)
        }
        if self.layout_ahead(0) {
            self.see(Alt.Const_Atom_Layout)
            return self.parse_layout_query()
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Const_Atom_Name)
            return self.parse_path()
        }
        if kind == TokenKind.LParen {
            return self.parse_const_group()
        }
        self.error("expected a constant: an integer, a name or a parenthesized constant")
    }

    func parse_const_group(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Const_Atom_Group)
        self.advance()
        if not self.parse_const_expr() {
            return false
        }
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the constant")
        }
        self.advance()
        self.leave_level()
        true
    }

    // `layout-query ::= 'sizeof' generic-args "(" ")" | 'alignof' generic-args "(" ")"`,
    // whose list is committed: `sizeof` and `alignof` begin no type.
    func parse_layout_query(&var self) -> Bool {
        let alt = if self.word_at(0, "sizeof") { Alt.Const_LayoutQuery_Size } else { Alt.Const_LayoutQuery_Align }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_generic_args() {
            return false
        }
        if self.kind() != TokenKind.LParen || self.kind_at(1) != TokenKind.RParen {
            return self.error("expected `()` after the layout query's type")
        }
        self.advance()
        self.advance()
        self.close(mark, alt, start)
        true
    }

    // A generic list at the `<` after a name, a member or a cast target,
    // kept only where the token after its `>` may follow it: `(`, `.` or `{`
    // after a name or member, and after a cast target what the productions
    // allow there (syntax.rule.generic-or-less). A list not kept is undone,
    // and its `<` compares.
    func speculate_list(&var self, cast: Bool) -> ListOutcome {
        let open = self.pos
        if open < self.failed_lists.len() && self.failed_lists[open] {
            return ListOutcome.Compares
        }
        if not self.closer_ahead() {
            return ListOutcome.Compares
        }
        let saved = self.checkpoint()
        self.trailing_comma = -1
        let refusals = self.depth_refusals
        if not self.parse_generic_args() {
            let by_depth = self.depth_refusals > refusals
            self.restore(&saved)
            if by_depth {
                // The depth budget decides no reading: a list the limit cut
                // short is refused, never re-read as comparisons.
                let at = self.depth_opener
                let _ = self.refuse_depth(at)
                return ListOutcome.Refused
            }
            while self.failed_lists.len() <= open {
                try! self.failed_lists.push(false)
            }
            self.failed_lists[open] = true
            return ListOutcome.Compares
        }
        let after = self.kind()
        var kept = after == TokenKind.LParen || after == TokenKind.Dot || after == TokenKind.LBrace
        if cast {
            kept = follows_cast_list(after)
        }
        if not kept {
            self.restore(&saved)
            if not cast && continues_postfix(after) {
                self.rejected_list = open
            }
            return ListOutcome.Compares
        }
        let comma = self.trailing_comma
        self.commit(&saved)
        self.trailing_comma = saved.trailing_comma
        if comma >= 0 {
            let _ = self.refuse(Rule.Generic_RefusedArgComma, comma,
                                "a generic argument list takes no trailing comma", "drop the comma")
            return ListOutcome.Refused
        }
        if not cast && after == TokenKind.LBrace && self.brace_ends_head() {
            // A list is kept before a `{` only where a trailing closure may
            // attach, and in a head the `{` begins the body.
            let at = self.pos
            let _ = self.refuse(Rule.Rule_HeadRestriction, at,
                                "a `\{` after a head's outer level begins the body, so no trailing closure attaches there",
                                "call with parentheses: `f<T>(\{ … \})`")
            return ListOutcome.Refused
        }
        ListOutcome.Kept
    }

    // Whether a generic list opened at the `<` here could close: whether a
    // `>`, `>=` or `>>=` stands at its bracket depth before that depth ends.
    // The scan passes line breaks, which a list spans, and nested `( )` and
    // `[ ]` groups whole, since a list's closer sits at the list's own depth.
    // It stops at a token no list holds at that depth, which the grammar tables
    // compute from the productions (`stops_list_scan`), and the answer covers
    // every `<` at that depth up to where it stopped (SL-424 c29). It takes no
    // level: a scan is a look, and only the list it permits charges depth.
    func closer_ahead(&var self) -> Bool {
        let open = self.pos
        if open < self.closer_scans.len() && self.closer_scans[open] != CloserScan.Unscanned {
            return self.closer_scans[open] == CloserScan.Found
        }
        var k = open + 1
        var nested = 0
        var found = false
        while k < self.limit {
            let kind = self.tokens[k].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                nested = nested + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                if nested == 0 {
                    break
                }
                nested = nested - 1
            } else if nested == 0 {
                if kind == TokenKind.Gt || kind == TokenKind.Gte || kind == TokenKind.ShrAssign {
                    found = true
                    break
                }
                if stops_list_scan(kind) {
                    break
                }
            }
            k = k + 1
        }
        let answer = if found { CloserScan.Found } else { CloserScan.Missing }
        while self.closer_scans.len() < k {
            try! self.closer_scans.push(CloserScan.Unscanned)
        }
        nested = 0
        var at = open
        while at < k {
            let kind = self.tokens[at].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                nested = nested + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                nested = nested - 1
            } else if nested == 0 && kind == TokenKind.Lt {
                self.closer_scans[at] = answer
            }
            at = at + 1
        }
        found
    }

    // ---- expressions -----------------------------------------------------------------

    // `expr ::= coalesce-expr`
    func parse_expr(&var self) -> Bool {
        self.see(Alt.Expr_Expr)
        self.parse_coalesce()
    }

    // `coalesce-expr ::= or-expr ( "??" NEWLINE* or-expr )*`
    func parse_coalesce(&var self) -> Bool {
        self.see(Alt.Expr_Coalesce)
        let mark = self.operand_mark()
        if not self.parse_or() {
            return false
        }
        if self.kind() != TokenKind.DoubleQuestion {
            return true
        }
        while self.kind() == TokenKind.DoubleQuestion {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_or() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Coalesce)
        true
    }

    // `or-expr ::= and-expr ( "||" NEWLINE* and-expr )*`
    func parse_or(&var self) -> Bool {
        self.see(Alt.Expr_Or)
        let mark = self.operand_mark()
        if not self.parse_and() {
            return false
        }
        if self.kind() != TokenKind.Or {
            return true
        }
        while self.kind() == TokenKind.Or {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_and() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Or)
        true
    }

    // `and-expr ::= bitor-expr ( "&&" NEWLINE* bitor-expr )*`
    func parse_and(&var self) -> Bool {
        self.see(Alt.Expr_And)
        let mark = self.operand_mark()
        if not self.parse_bitor() {
            return false
        }
        if self.kind() != TokenKind.And {
            return true
        }
        while self.kind() == TokenKind.And {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitor() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_And)
        true
    }

    // `bitor-expr ::= bitxor-expr ( "|" NEWLINE* bitxor-expr )*`
    func parse_bitor(&var self) -> Bool {
        self.see(Alt.Expr_Bitor)
        let mark = self.operand_mark()
        if not self.parse_bitxor() {
            return false
        }
        if self.kind() != TokenKind.Pipe {
            return true
        }
        while self.kind() == TokenKind.Pipe {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitxor() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitor)
        true
    }

    // `bitxor-expr ::= bitand-expr ( "^" NEWLINE* bitand-expr )*`
    func parse_bitxor(&var self) -> Bool {
        self.see(Alt.Expr_Bitxor)
        let mark = self.operand_mark()
        if not self.parse_bitand() {
            return false
        }
        if self.kind() != TokenKind.Caret {
            return true
        }
        while self.kind() == TokenKind.Caret {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitand() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitxor)
        true
    }

    // `bitand-expr ::= compare-expr ( "&" NEWLINE* compare-expr )*`
    func parse_bitand(&var self) -> Bool {
        self.see(Alt.Expr_Bitand)
        let mark = self.operand_mark()
        if not self.parse_compare() {
            return false
        }
        if self.kind() != TokenKind.Ampersand {
            return true
        }
        while self.kind() == TokenKind.Ampersand {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_compare() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitand)
        true
    }

    // `compare-expr ::= range-expr ( compare-op NEWLINE* range-expr )?`. A
    // comparison takes two operands, so a chain of them is refused, at its
    // second operator, once the chain has parsed (syntax.rule.compare-chain).
    func parse_compare(&var self) -> Bool {
        self.see(Alt.Expr_Compare_Pair)
        let mark = self.operand_mark()
        if not self.parse_range() {
            return false
        }
        guard let op = self.compare_op() else { return true }
        self.see(op)
        self.take_leaf()
        self.skip_newlines()
        if not self.parse_range() {
            return false
        }
        let second = self.pos
        var chained = false
        while let more = self.compare_op() {
            self.see(more)
            chained = true
            self.advance()
            self.skip_newlines()
            if not self.parse_range() {
                return false
            }
        }
        // A chain that parses whole is the removed production, even where it
        // re-reads a generic list whose own reading went on: enabling it
        // alone makes the text parse (compiler/tests/parse/README.md,
        // Refusals, step 2).
        if chained {
            return self.refuse(Rule.Expr_RefusedCompareChain, second,
                               "a comparison takes two operands, so comparisons do not chain",
                               "join two comparisons with `&&`: `a < b && b < c`")
        }
        self.close_chain(mark, Alt.Expr_Compare_Pair)
        true
    }

    // The comparison operator at the current token, if there is one.
    func compare_op(&self) -> Alt? {
        match self.kind() {
            case Eq -> Alt.Expr_CompareOp_Equal,
            case Neq -> Alt.Expr_CompareOp_NotEqual,
            case Lt -> Alt.Expr_CompareOp_Less,
            case Gt -> Alt.Expr_CompareOp_Greater,
            case Lte -> Alt.Expr_CompareOp_LessEqual,
            case Gte -> Alt.Expr_CompareOp_GreaterEqual,
            case _ -> None
        }
    }

    // `range-expr`: a closed range `a..b` or `a..=b`, an open end `a..`, an
    // open start `..b`, `..=b` or `..`, or a lone shift operand. A range's
    // upper bound is omitted only where a closer, a separator or a line break
    // follows its `..` (syntax.rule.range-open-end), and a line break after
    // `..=` leaves it without the bound it needs.
    func parse_range(&var self) -> Bool {
        let start = self.operand_start()
        let mark = self.operand_mark()
        let lead = self.kind()
        if not self.primed && (lead == TokenKind.DotDot || lead == TokenKind.DotDotEq) {
            self.see(Alt.Expr_Range_Upto)
            self.take_leaf()
            if self.kind() == TokenKind.LBrace && self.brace_ends_head() {
                return self.refuse_open_end()
            }
            if lead == TokenKind.DotDot && self.range_ends() {
                self.see(Alt.Expr_RangeUpto_Full)
            } else {
                let alt = if lead == TokenKind.DotDot { Alt.Expr_RangeUpto_Exclusive } else { Alt.Expr_RangeUpto_Inclusive }
                self.see(alt)
                if not self.parse_shift() {
                    return false
                }
            }
            self.close(mark, Alt.Expr_Range_Upto, start)
            return true
        }
        if not self.parse_shift() {
            return false
        }
        let op = self.kind()
        if op == TokenKind.Ellipsis {
            let at = self.pos
            self.advance()
            if not self.parse_shift() {
                return false
            }
            return self.refuse(Rule.Expr_RefusedEllipsisRange, at,
                               "a range is written `..` or `..=`; `...` ends a variadic parameter list",
                               "write `a..=b` for a range that includes `b`")
        }
        if op != TokenKind.DotDot && op != TokenKind.DotDotEq {
            self.see(Alt.Expr_Range_Closed)
            return true
        }
        self.take_leaf()
        if self.kind() == TokenKind.LBrace && self.brace_ends_head() {
            return self.refuse_open_end()
        }
        if op == TokenKind.DotDot && self.range_ends() {
            self.see(Alt.Expr_Range_From)
            self.see(Alt.Expr_RangeFrom)
            self.close(mark, Alt.Expr_Range_From, start)
            return true
        }
        self.see(Alt.Expr_Range_Closed)
        let alt = if op == TokenKind.DotDot { Alt.Expr_RangeOp_Exclusive } else { Alt.Expr_RangeOp_Inclusive }
        self.see(alt)
        if not self.parse_shift() {
            return false
        }
        self.close(mark, Alt.Expr_Range_Closed, start)
        true
    }

    // A range operator before a head's body `{`: the `{` is the body, and a
    // range's upper bound is omitted only before a closer, a separator or a
    // line break (syntax.rule.range-open-end).
    func refuse_open_end(&var self) -> Bool {
        let at = self.pos
        self.refuse(Rule.Rule_RangeOpenEnd, at,
                    "a range's upper bound is omitted only before a closing token or a line break",
                    "parenthesize the open range: `for i in (a..) \{`")
    }

    // Whether the current token ends a range whose upper bound is omitted.
    func range_ends(&self) -> Bool {
        match self.kind() {
            case RBracket -> true,
            case RParen -> true,
            case Comma -> true,
            case Semicolon -> true,
            case Newline -> true,
            case RBrace -> true,
            case Eof -> true,
            case _ -> false
        }
    }

    // `shift-expr ::= additive-expr ( shift-op NEWLINE* additive-expr )*`
    func parse_shift(&var self) -> Bool {
        self.see(Alt.Expr_Shift)
        let mark = self.operand_mark()
        if not self.parse_additive() {
            return false
        }
        var ops = 0
        while let op = self.shift_op() {
            self.see(op)
            self.take_shift()
            self.skip_newlines()
            if not self.parse_additive() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Shift)
        }
        true
    }

    // The shift at the current token, if there is one: two `<` or two `>`
    // tokens with nothing between them (syntax.lex.shift-adjacent).
    func shift_op(&self) -> Alt? {
        let kind = self.kind()
        if kind != TokenKind.Lt && kind != TokenKind.Gt {
            return None
        }
        if self.kind_at(1) != kind || self.tokens[self.pos].end != self.tokens[self.pos + 1].start {
            return None
        }
        if kind == TokenKind.Lt { Alt.Expr_ShiftOp_Left } else { Alt.Expr_ShiftOp_Right }
    }

    // A shift's two tokens, as the one leaf `<<` or `>>`.
    func take_shift(&var self) {
        let first = self.current()
        self.advance()
        let second = self.current()
        let _ = self.builder.leaf(NodeShape.Token, first.start, second.end)
        self.advance()
    }

    // `additive-expr ::= multiplicative-expr ( add-op NEWLINE* multiplicative-expr )*`
    func parse_additive(&var self) -> Bool {
        self.see(Alt.Expr_Additive)
        let mark = self.operand_mark()
        if not self.parse_multiplicative() {
            return false
        }
        var ops = 0
        while let op = self.additive_op() {
            self.see(op)
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_multiplicative() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Additive)
        }
        true
    }

    func additive_op(&self) -> Alt? {
        match self.kind() {
            case Plus -> Alt.Expr_AddOp_Plus,
            case Minus -> Alt.Expr_AddOp_Minus,
            case WrapAdd -> Alt.Expr_AddOp_WrappingPlus,
            case WrapSub -> Alt.Expr_AddOp_WrappingMinus,
            case _ -> None
        }
    }

    // `multiplicative-expr ::= cast-expr ( mul-op NEWLINE* cast-expr )*`. A
    // `*` between operands multiplies, and one before an operand is a
    // dereference (syntax.rule.deref-or-multiply).
    func parse_multiplicative(&var self) -> Bool {
        self.see(Alt.Expr_Multiplicative)
        let mark = self.operand_mark()
        if not self.parse_cast() {
            return false
        }
        var ops = 0
        while let op = self.multiplicative_op() {
            self.see(op)
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_cast() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Multiplicative)
        }
        true
    }

    func multiplicative_op(&self) -> Alt? {
        match self.kind() {
            case Star -> Alt.Expr_MulOp_Times,
            case Slash -> Alt.Expr_MulOp_Divide,
            case Percent -> Alt.Expr_MulOp_Remainder,
            case WrapMul -> Alt.Expr_MulOp_WrappingTimes,
            case _ -> None
        }
    }

    // `cast-expr ::= prefix-expr cast-suffix*`, one Cast node per `as`, each
    // charging a level held to the end of the cast chain.
    func parse_cast(&var self) -> Bool {
        self.see(Alt.Expr_Cast)
        let start = self.operand_start()
        let mark = self.operand_mark()
        if not self.parse_prefix() {
            return false
        }
        var casts = 0
        while self.kind() == TokenKind.As {
            let at = self.pos
            if not self.enter_level(at) {
                return false
            }
            casts = casts + 1
            self.see(Alt.Expr_CastSuffix_Cast)
            self.take_leaf()
            if not self.parse_cast_target() {
                return false
            }
            self.close(mark, Alt.Expr_Cast, start)
        }
        while casts > 0 {
            self.leave_level()
            casts = casts - 1
        }
        true
    }

    // `cast-target ::= type-atom | type-atom "?" | ref-type | func-type`: a
    // type with at most one `?` of its own, so a `?` or `??` after it is
    // refused at that token, whatever the spacing
    // (syntax.rule.cast-target-question). The `<` after its last named type
    // is speculative (syntax.rule.generic-or-less).
    func parse_cast_target(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Type_CastTarget_Plain
        if self.kind() == TokenKind.Ampersand && not self.slice_ahead() {
            alt = Alt.Type_CastTarget_Ref
            if not self.parse_ref_type(true) {
                return false
            }
        } else if self.kind() == TokenKind.LParen && self.func_type_ahead() {
            alt = Alt.Type_CastTarget_Func
            if not self.parse_func_type(true) {
                return false
            }
        } else {
            if not self.parse_type_atom(true) {
                return false
            }
            if self.kind() == TokenKind.Question {
                alt = Alt.Type_CastTarget_Optional
                self.advance()
                self.close(mark, Alt.Type_Suffix_Optional, start)
            }
        }
        let after = self.kind()
        if after == TokenKind.Question || after == TokenKind.DoubleQuestion {
            let at = self.pos
            return self.refuse(Rule.Rule_CastTargetQuestion, at,
                               "a cast target takes at most one `?`",
                               "coalesce first, then convert: `(n ?? 9) as Int`")
        }
        self.see(alt)
        true
    }

    // `prefix-expr`: a prefix operator and its operand, or a postfix
    // expression. Each operator binds tighter than `as`
    // (syntax.rule.prefix-or-cast). A primed operand is already parsed.
    func parse_prefix(&var self) -> Bool {
        if self.primed {
            self.primed = false
            return true
        }
        let kind = self.kind()
        if kind == TokenKind.Minus {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Negate, 1, false)
        }
        if kind == TokenKind.Not_ {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Not, 1, false)
        }
        if kind == TokenKind.Tilde {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Complement, 1, false)
        }
        if kind == TokenKind.Star {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Deref, Alt.Expr_Deref, 1, false)
        }
        if kind == TokenKind.Ampersand {
            if self.kind_at(1) == TokenKind.Var {
                return self.parse_prefix_operator(Alt.Expr_Prefix_Ref, Alt.Expr_Ref_Exclusive, 2, false)
            }
            return self.parse_prefix_operator(Alt.Expr_Prefix_Ref, Alt.Expr_Ref_Shared, 1, false)
        }
        let next = self.kind_at(1)
        if self.word_at(0, "lends") && (next == TokenKind.SelfKw || next == TokenKind.Ident) {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Lends, Alt.Expr_Lends, 1, false)
        }
        if kind == TokenKind.Unsafe_ {
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedUnsafe, at,
                               "unsafety belongs to a declaration, not to an expression",
                               "mark the enclosing function `unsafe`, after its parameters")
        }
        if kind == TokenKind.Try && not self.try_block_ahead() {
            return self.parse_try()
        }
        if kind == TokenKind.Move_ {
            return self.parse_move()
        }
        if kind == TokenKind.Borrow && self.borrow_binding_end(0) < 0 {
            self.see(Alt.Expr_Prefix_Borrow)
            return self.parse_borrow_place(false)
        }
        self.see(Alt.Expr_Prefix_Postfix)
        self.parse_postfix(false)
    }

    // `borrow-place ::= "borrow" postfix-expr | "borrow" "var" postfix-expr`,
    // whose operand is a postfix expression, so it binds tighter than `as`
    // and every binary operator (syntax.rule.borrow-extent), charging one
    // level held to the operand's end. `let` after `borrow` with no binding
    // binds no name (syntax.expr.refused-borrow-let-unbound), and no line
    // break stands after `borrow` or `borrow var` (syntax.rule.borrow-form).
    // On a statement's leading operand (`spine`) the form and the operand's
    // alternatives are kept, and the node left open, until the statement
    // knows whether it is an assignment target and of which production.
    func parse_borrow_place(&var self, spine: Bool) -> Bool {
        let open = self.pos
        if self.kind_at(1) == TokenKind.Let {
            return self.refuse(Rule.Expr_RefusedBorrowLetUnbound, open,
                               "`let` after `borrow` introduces a name, and none is bound",
                               "write `borrow place` for a shared borrow, or `borrow let x = place \{ … \}` to bind it")
        }
        let exclusive = self.kind_at(1) == TokenKind.Var
        let width = if exclusive { 2 } else { 1 }
        if self.kind_at(width) == TokenKind.Newline {
            return self.refuse(Rule.Rule_BorrowForm, open,
                               "no line break stands between `borrow` and the place it borrows",
                               "write the place on the line of its `borrow`")
        }
        if not self.enter_level(open) {
            return false
        }
        let alt = if exclusive { Alt.Borrow_Place_Var } else { Alt.Borrow_Place_Shared }
        self.see_spine(alt, spine)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if exclusive {
            self.advance()
        }
        if not self.parse_postfix(spine) {
            return false
        }
        if not spine {
            self.close(mark, alt, start)
        }
        self.leave_level()
        true
    }

    // `borrow-block ::= "borrow" borrow-binding ( "," borrow-binding )* NEWLINE* block`,
    // a primary, charging one level held to its body's end.
    func parse_borrow_block(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_Primary_BorrowBlock)
        self.see(Alt.Borrow_Block)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.BorrowBindings), open, false, &var count) {
            return false
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, Alt.Borrow_Block, start)
        self.leave_level()
        true
    }

    // `borrow-binding ::= ("let" | "var") binding-target "=" head-expr`, whose
    // head ends at the `,` of the next binding or at the body's `{`.
    func parse_borrow_binding(&var self) -> Bool {
        let kind = self.kind()
        if kind != TokenKind.Let && kind != TokenKind.Var {
            return self.error("expected `let` or `var` and the next binding")
        }
        let alt = if kind == TokenKind.Var { Alt.Borrow_Binding_Var } else { Alt.Borrow_Binding_Let }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_binding_target() {
            return false
        }
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the place to borrow")
        }
        self.advance()
        if not self.parse_head_expr(TokenKind.Comma) {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `move-expr ::= "move" move-base move-hop* "!"?`: a place path, which
    // stops at the first token that is no field, tuple-index or subscript hop,
    // so `move x.f()` calls nothing (syntax.rule.move-place). `move` charges a
    // level, a `*` after it one more, and each hop one, all held to the
    // path's end; the `!` prints, since it is optional.
    func parse_move(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_Prefix_Move)
        self.see(Alt.Expr_Move_Place)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var levels = 1
        let base_start = self.here()
        let base = self.builder.mark()
        var deref = false
        if self.kind() == TokenKind.Star {
            let star = self.pos
            if not self.enter_level(star) {
                return false
            }
            levels = levels + 1
            deref = true
            self.see(Alt.Expr_MoveBase_Deref)
            self.advance()
        }
        let kind = self.kind()
        var alt = Alt.Expr_MoveBase_Name
        if kind == TokenKind.SelfKw {
            alt = if deref { Alt.Expr_MoveDeref_Self } else { Alt.Expr_MoveBase_Self }
            self.see(alt)
            let _ = self.token_node(Alt.Expr_Self, false)
        } else if kind == TokenKind.Ident {
            alt = if deref { Alt.Expr_MoveDeref_Name } else { Alt.Expr_MoveBase_Name }
            self.see(alt)
            let _ = self.token_node(Alt.Expr_NameRef, true)
        } else {
            return self.error("`move` takes a place: a name or `self`, then its fields and elements")
        }
        if deref {
            self.close(base, alt, base_start)
        }
        while true {
            let hop = self.kind()
            let after = self.kind_at(1)
            let member = hop == TokenKind.Dot && (after == TokenKind.Ident || after == TokenKind.IntLit)
            if not member && hop != TokenKind.LBracket {
                break
            }
            let at = self.pos
            if not self.enter_level(at) {
                return false
            }
            levels = levels + 1
            if hop == TokenKind.LBracket {
                if not self.parse_subscript(base, base_start, false, Alt.Expr_MoveHop_Subscript) {
                    return false
                }
                continue
            }
            let index = after == TokenKind.IntLit
            let form = if index { Alt.Expr_MoveHop_TupleIndex } else { Alt.Expr_MoveHop_Member }
            let node = if index { Alt.Expr_TupleIndex } else { Alt.Expr_Member }
            self.see(form)
            self.see(node)
            self.advance()
            self.take_leaf()
            if not index && self.opens_generic_list() {
                if self.speculate_list(false) == ListOutcome.Refused {
                    return false
                }
            }
            self.close(base, node, base_start)
        }
        if self.kind() == TokenKind.Exclaim {
            self.take_leaf()
        }
        self.close(mark, Alt.Expr_Move_Place, start)
        while levels > 0 {
            self.leave_level()
            levels = levels - 1
        }
        true
    }

    // A prefix operator spelled by `width` tokens, which its node's Kind
    // implies, so it prints nothing. It charges one level, held to its
    // operand's end. On a statement's leading operand (`spine`) its form is
    // kept until the statement knows whether the operand is a target.
    func parse_prefix_operator(&var self, form: Alt, node: Alt, width: Int, spine: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see_spine(form, spine)
        self.see(node)
        let start = self.here()
        let mark = self.builder.mark()
        var k = 0
        while k < width {
            self.advance()
            k = k + 1
        }
        if not self.parse_prefix() {
            return false
        }
        self.close(mark, node, start)
        self.leave_level()
        true
    }

    // `try-expr`: `try`, `try?` or `try!` applied to the prefix expression
    // after it, and only that (syntax.rule.try-extent), charging one level.
    // A plain `try` may take an inline `catch` after its operand.
    func parse_try(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_try_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    // What follows a `try` at `open`. Only a plain `try` routes its error,
    // and a routed one takes no `catch`: a routing clause after `try!` or
    // `try?`, or before a `catch`, is refused once the operand has parsed.
    func parse_try_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var alt = Alt.Expr_Try_Propagate
        if self.kind() == TokenKind.Exclaim {
            alt = Alt.Expr_Try_Force
            self.advance()
        } else if self.kind() == TokenKind.Question {
            alt = Alt.Expr_Try_Optional
            self.advance()
        }
        let route = self.pos
        let routed = self.kind() == TokenKind.LParen && self.kind_at(1) == TokenKind.As
        if routed {
            if not self.parse_try_route() {
                return false
            }
        }
        self.skip_newlines()
        if not self.parse_prefix() {
            return false
        }
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        let caught = self.kind_at(ahead) == TokenKind.Catch
        if routed && (caught || alt != Alt.Expr_Try_Propagate) {
            return self.refuse(Rule.Expr_RefusedTryRoute, route,
                               "only a plain `try` routes its error, and a routed `try` takes no `catch`",
                               "write `try(as E.Case) f()` alone")
        }
        if caught && alt == Alt.Expr_Try_Propagate {
            alt = Alt.Expr_Try_Catch
            if not self.parse_catch_clause() {
                return false
            }
        }
        if routed {
            alt = Alt.Expr_Try_Route
        }
        self.see(Alt.Expr_Prefix_Try)
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `catch-clause ::= NEWLINE* "catch" NEWLINE* block`, which may start the
    // line after its operand (syntax.rule.continuation-keywords).
    func parse_catch_clause(&var self) -> Bool {
        self.see(Alt.Expr_Catch)
        self.skip_newlines()
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the `catch` block")
        }
        if not self.parse_block() {
            return false
        }
        self.close(mark, Alt.Expr_Catch, start)
        true
    }

    // `try-block ::= "try" NEWLINE* block NEWLINE* "catch" NEWLINE* block`,
    // one level held to the end of its `catch` block. A `try` before a brace
    // is a block, never a `try` applied to a closure, so one without its
    // `catch` is refused (syntax.rule.try-block).
    func parse_try_block(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_TryBlock)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.skip_newlines()
        let brace = self.pos
        if not self.parse_block() {
            return false
        }
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) != TokenKind.Catch {
            return self.refuse(Rule.Rule_TryBlock, brace,
                               "a `try` block takes a `catch` block",
                               "add `catch \{ … \}`, or parenthesize a closure: `try (\{ … \})()`")
        }
        self.skip_newlines()
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the `catch` block")
        }
        if not self.parse_block() {
            return false
        }
        self.close(mark, Alt.Expr_TryBlock, start)
        self.leave_level()
        true
    }

    // `try-route ::= "(" "as" path ")"`, whose path names an enum and one of
    // its cases (syntax.rule.try-route-case). The `as` prints.
    func parse_try_route(&var self) -> Bool {
        let open = self.pos
        self.advance()
        self.take_leaf()
        let path = self.pos
        if not self.parse_path() {
            return false
        }
        if self.pos - path < 3 {
            return self.refuse(Rule.Rule_TryRouteCase, path,
                               "a routing clause names an enum and a case",
                               "write the case with its enum: `try(as ConfigError.Alloc)`")
        }
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the routing clause")
        }
        self.advance()
        self.see(Alt.Expr_TryRoute)
        true
    }

    // `postfix-expr ::= primary-expr postfix-hop*`: one node per hop, the
    // primary innermost, each hop charging a level held until the chain ends
    // (syntax.rule.postfix-per-hop). A `?.` hop opens an optional-chain run,
    // which member, `?.` and call hops continue, and which a `!`, a subscript,
    // a tuple index or the chain's end closes into one OptionalChain node
    // around the chain so far (syntax.rule.optional-chain-run). On a
    // statement's leading chain (`spine`) the chain's alternative and each
    // hop's are kept until the statement knows whether the chain is a target.
    // A `{` right after the chain is a trailing closure, which only a name,
    // an implicit member or a member takes, once; at a head's outer level it
    // begins the body instead (syntax.rule.trailing-closure).
    func parse_postfix(&var self, spine: Bool) -> Bool {
        self.see_spine(Alt.Expr_Postfix, spine)
        let start = self.here()
        let mark = self.builder.mark()
        let lead = self.kind()
        if not self.parse_primary() {
            return false
        }
        // Whether a trailing closure may attach after the chain so far.
        var callee = lead == TokenKind.Ident || lead == TokenKind.Dot
        var hops = 0
        var run = false
        while true {
            let kind = self.kind()
            let after = self.kind_at(1)
            if kind == TokenKind.LBrace {
                if self.brace_ends_head() {
                    if callee && self.head == HeadState.On {
                        self.note_head_stop()
                    }
                    break
                }
                let at = self.pos
                if not callee {
                    return self.refuse(Rule.Rule_TrailingClosure, at,
                                       "only a name or a member takes a trailing closure, and only one",
                                       "pass the closure in parentheses: `f(…)(\{ … \})`")
                }
                self.note_shadow_closure()
                if not self.enter_level(at) {
                    return false
                }
                hops = hops + 1
                if not self.parse_trailing_hop(mark, start, spine) {
                    return false
                }
                callee = false
                continue
            }
            let continues = (kind == TokenKind.QuestionDot || kind == TokenKind.LParen
                             || (kind == TokenKind.Dot && after == TokenKind.Ident))
            let closes = (kind == TokenKind.Exclaim || kind == TokenKind.LBracket
                          || (kind == TokenKind.Dot && after == TokenKind.IntLit))
            if not continues && not closes {
                break
            }
            if run && closes {
                self.close_run(mark, start)
                run = false
            }
            let at = self.pos
            if not self.enter_level(at) {
                return false
            }
            hops = hops + 1
            if not self.parse_hop(mark, start, spine, callee) {
                return false
            }
            if kind == TokenKind.QuestionDot {
                run = true
            }
            callee = kind == TokenKind.QuestionDot || (kind == TokenKind.Dot && after == TokenKind.Ident)
        }
        if run {
            self.close_run(mark, start)
        }
        while hops > 0 {
            self.leave_level()
            hops = hops - 1
        }
        true
    }

    // Closes the chain begun at `mark` into the OptionalChain node of a run.
    func close_run(&var self, mark: Int, start: Int) {
        // Stage 0 workaround (SL:hazards S4): canonical: let _ = self.builder.close(mark, NodeShape.OptionalChain, None, start, self.prev_end)
        let end = self.prev_end
        let _ = self.builder.close(mark, NodeShape.OptionalChain, None, start, end)
    }

    // One `postfix-hop`, applied to the chain begun at `mark`; `callee` when a
    // trailing closure may follow a call's `)` here.
    func parse_hop(&var self, mark: Int, start: Int, spine: Bool, callee: Bool) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.LParen {
            return self.parse_call(mark, start, spine, callee)
        }
        if kind == TokenKind.LBracket {
            return self.parse_subscript(mark, start, spine, Alt.Expr_Hop_Subscript)
        }
        if kind == TokenKind.Exclaim {
            self.see_spine(Alt.Expr_Hop_Force, spine)
            self.see(Alt.Expr_Force)
            self.advance()
            self.close(mark, Alt.Expr_Force, start)
            return true
        }
        var hop = Alt.Expr_Hop_Member
        var node = Alt.Expr_Member
        if kind == TokenKind.QuestionDot {
            hop = Alt.Expr_Hop_Optional
            node = Alt.Expr_OptionalMember
        } else if self.kind_at(1) == TokenKind.IntLit {
            // Digits after a member `.` are a tuple index, which never takes
            // the next `.` as a decimal point (syntax.rule.tuple-index-dot).
            hop = Alt.Expr_Hop_TupleIndex
            node = Alt.Expr_TupleIndex
        }
        self.advance()
        if self.kind() != TokenKind.Ident && node != Alt.Expr_TupleIndex {
            return self.error("expected a member name after `?.`")
        }
        self.see_spine(hop, spine)
        self.see(node)
        self.take_leaf()
        if node != Alt.Expr_TupleIndex && self.opens_generic_list() {
            if self.speculate_list(false) == ListOutcome.Refused {
                return false
            }
        }
        self.close(mark, node, start)
        true
    }

    // Whether a `<` here may open a generic list after a name or member: a
    // `<` that is not the first half of a shift (syntax.lex.shift-adjacent).
    func opens_generic_list(&self) -> Bool {
        if self.kind() != TokenKind.Lt {
            return false
        }
        if let _ = self.shift_op() {
            return false
        }
        true
    }

    // `name-expr ::= IDENT generic-args?`
    func parse_name(&var self) -> Bool {
        self.see(Alt.Expr_Name)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.opens_generic_list() {
            if self.speculate_list(false) == ListOutcome.Refused {
                return false
            }
        }
        self.close(mark, Alt.Expr_Name, start)
        true
    }

    // `call-hop ::= "(" arg-list? ")" closure-literal?`, one Call node whatever
    // the callee is (syntax.rule.one-call-node), with
    // `arg-list ::= argument ( "," argument )* ","?`. A closure right after
    // the `)` is the call's trailing closure when the callee takes one
    // (`attach`), and the parser is not at a head's outer level.
    func parse_call(&var self, mark: Int, start: Int, spine: Bool, attach: Bool) -> Bool {
        self.see_spine(Alt.Expr_Hop_Call, spine)
        let open = self.pos
        let head = self.head
        self.head = HeadState.Off
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Expr_Args)
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.CallArgs), open, false, &var count) {
            return false
        }
        self.advance()
        self.head = head
        var alt = Alt.Expr_Call_Paren
        if attach && self.kind() == TokenKind.LBrace {
            if self.brace_ends_head() {
                if self.head == HeadState.On {
                    self.note_head_stop()
                }
            } else {
                alt = Alt.Expr_Call_ParenTrailing
                self.note_shadow_closure()
                if not self.parse_closure_literal() {
                    return false
                }
            }
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `trailing-hop ::= closure-literal`, a Call node of its own.
    func parse_trailing_hop(&var self, mark: Int, start: Int, spine: Bool) -> Bool {
        self.see_spine(Alt.Expr_Hop_Trailing, spine)
        self.see(Alt.Expr_TrailingCall)
        if not self.parse_closure_literal() {
            return false
        }
        self.close(mark, Alt.Expr_TrailingCall, start)
        true
    }

    // A trailing closure attaching at the `{` here, which a brace literal the
    // first element turns out to be in refuses, should that literal stand at a
    // head's outer level (HeadState.Shadow).
    func note_shadow_closure(&var self) {
        if self.head == HeadState.Shadow && self.shadow_brace < 0 {
            self.shadow_brace = self.pos
        }
    }

    // `argument ::= expr | IDENT ":" expr`: a name and `:` at an argument's
    // start is its label (syntax.rule.label-or-tuple).
    func parse_argument(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Expr_Argument_Positional
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            alt = Alt.Expr_Argument_Labelled
            self.take_leaf()
            self.advance()
        }
        self.see(alt)
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `subscript-hop ::= "[" expr "]" | multi-subscript`, the hop `hop`
    // derives it through. One unlabelled argument is a single subscript; a
    // label or a comma after the first makes the multi-argument form, whose
    // later arguments follow the call-argument rules, so `m[r, c]`,
    // `m[(r, c)]` and `m[k, default: 0]` are three forms
    // (syntax.rule.subscript-arguments). Its first element is a bare
    // expression, or a label and one, and the funnel parses the rest.
    func parse_subscript(&var self, mark: Int, start: Int, spine: Bool, hop: Alt) -> Bool {
        self.see_spine(hop, spine)
        let open = self.pos
        let head = self.head
        self.head = HeadState.Off
        self.advance()
        let labelled = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
        if labelled {
            self.take_leaf()
            self.advance()
        }
        if not self.parse_expr() {
            return false
        }
        var alt = Alt.Expr_Subscript_Single
        if labelled || self.kind() == TokenKind.Comma {
            alt = Alt.Expr_Subscript_Multi
            let form = if labelled { Alt.Expr_MultiSubscript_LabelledFirst } else { Alt.Expr_MultiSubscript_PositionalFirst }
            self.see(form)
            var count = no_elements()
            if not self.parse_comma_list(list_shape(CommaList.SubscriptArgs), open, true, &var count) {
                return false
            }
            if count.elements > 1 {
                self.see(Alt.Expr_Args)
            } else if labelled && count.trailing {
                return self.error("a comma after a labelled subscript's first argument takes another argument")
            }
        } else if self.kind() != TokenKind.RBracket {
            return self.list_error(open, "expected `]`")
        }
        self.advance()
        self.head = head
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `primary-expr`: a literal, a name, a parenthesized expression, or a
    // construct that ends in a block: `if`, `match`, a loop, a try block or a
    // `borrow` block, which every caller has told from the place form.
    func parse_primary(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.If {
            self.see(Alt.Expr_Primary_If)
            return self.parse_if()
        }
        if kind == TokenKind.Match {
            self.see(Alt.Expr_Primary_Match)
            return self.parse_match()
        }
        if kind == TokenKind.While {
            let binds = self.kind_at(1) == TokenKind.Let || self.kind_at(1) == TokenKind.Var
            let form = if binds { Alt.Expr_Primary_WhileLet } else { Alt.Expr_Primary_While }
            self.see(form)
            return self.parse_while()
        }
        if kind == TokenKind.For {
            self.see(Alt.Expr_Primary_For)
            return self.parse_for()
        }
        if kind == TokenKind.Try {
            self.see(Alt.Expr_Primary_TryBlock)
            return self.parse_try_block()
        }
        if kind == TokenKind.Borrow {
            return self.parse_borrow_block()
        }
        if kind == TokenKind.IntLit {
            let digits = self.pos
            let _ = self.literal(Alt.Expr_Literal_Int, Alt.Expr_Int, true)
            return self.check_trailing_point(digits)
        }
        if kind == TokenKind.FloatLit {
            return self.literal(Alt.Expr_Literal_Float, Alt.Expr_Float, true)
        }
        if kind == TokenKind.StringLit {
            return self.literal(Alt.Expr_Literal_String, Alt.Expr_String, true)
        }
        if kind == TokenKind.True_ {
            return self.literal(Alt.Expr_Literal_Bool, Alt.Expr_Bool_True, false)
        }
        if kind == TokenKind.False_ {
            return self.literal(Alt.Expr_Literal_Bool, Alt.Expr_Bool_False, false)
        }
        if kind == TokenKind.NoneKw {
            return self.literal(Alt.Expr_Literal_None, Alt.Expr_None, false)
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Expr_Primary_Name)
            return self.parse_name()
        }
        if kind == TokenKind.SelfKw {
            self.see(Alt.Expr_Primary_Self)
            return self.token_node(Alt.Expr_Self, false)
        }
        if kind == TokenKind.DollarParam {
            self.see(Alt.Expr_Primary_ShorthandParam)
            return self.token_node(Alt.Expr_ShorthandParam, true)
        }
        if kind == TokenKind.HashDirective {
            return self.parse_directive()
        }
        if kind == TokenKind.InterpString {
            return self.parse_interp()
        }
        if kind == TokenKind.Dot && self.kind_at(1) == TokenKind.Ident {
            // `.` and a name at the start of an operand name an enum case
            // (syntax.rule.implicit-member).
            self.see(Alt.Expr_Primary_ImplicitMember)
            self.see(Alt.Expr_ImplicitMember)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            self.take_leaf()
            self.close(mark, Alt.Expr_ImplicitMember, start)
            return true
        }
        if kind == TokenKind.LParen {
            return self.parse_paren()
        }
        if kind == TokenKind.LBracket {
            return self.parse_bracket()
        }
        if kind == TokenKind.LBrace {
            return self.parse_brace()
        }
        self.error("expected an expression")
    }

    // After the integer literal at `digits`, a `.` written against it that no
    // name, digit or second `.` follows is a float with no digit after its
    // point, `7.` (syntax.lex.float-point). The lexer reads `7.to_string()`
    // and `1..=9` by that lookahead too, so it leaves the `.` to the parser,
    // which alone sees the token after it. A tuple index never reaches here.
    func check_trailing_point(&var self, digits: Int) -> Bool {
        if self.kind() != TokenKind.Dot || self.tokens[digits].end != self.here() {
            return true
        }
        let next = self.kind_at(1)
        if next == TokenKind.Ident || next == TokenKind.IntLit || next == TokenKind.Dot {
            return true
        }
        let t = self.tokens[digits]
        var hint = StringBuilder()
        var k = t.start
        while k < t.end {
            let b = self.builder.tree.source.byte(k)
            if not (is_decimal_byte(b) || b == PARSE_UNDERSCORE) {
                // A based or suffixed integer spells no float, `.` or not.
                return true
            }
            k = k + 1
        }
        try! hint.append("write `")
        try! hint.append(self.builder.tree.source.slice(t.start, t.end))
        try! hint.append(".0`")
        self.refuse(Rule.Lex_FloatPoint, digits, "a float needs a digit after its point",
                    hint.build())
    }

    // A node of one token with `node`'s Kind, which records it; `shown` when
    // the token prints, which a keyword the Kind implies does not.
    func token_node(&var self, node: Alt, shown: Bool) -> Bool {
        self.see(node)
        let start = self.here()
        let mark = self.builder.mark()
        if shown {
            self.take_leaf()
        } else {
            self.advance()
        }
        self.close(mark, node, start)
        true
    }

    // `interp-string ::= INTERP_STRING`: an Interp node holding, in order, the
    // literal runs as written, in quotes, and the segments. The string
    // charges one level, and its segments' nesting continues from it.
    func parse_interp(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_interp_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_interp_body(&var self) -> Bool {
        let t = self.current()
        let mark = self.builder.mark()
        var run = t.start + 1
        var k = 0
        while k < t.seg_count {
            let piece = self.pieces[t.seg_start + k]
            if piece.open > run {
                let _ = self.builder.leaf(NodeShape.Segment, run, piece.open)
            }
            if not self.parse_segment(piece) {
                return false
            }
            run = piece.open + piece.len + 2
            k = k + 1
        }
        if run < t.end - 1 {
            let _ = self.builder.leaf(NodeShape.Segment, run, t.end - 1)
        }
        self.advance()
        self.see(Alt.Expr_Primary_Interpolation)
        self.see(Alt.Expr_Interpolation)
        self.close(mark, Alt.Expr_Interpolation, t.start)
        true
    }

    // One expression segment, lexed and parsed on its own from
    // `interp-segment ::= expr EOF | EOF` (syntax.rule.interpolation-segment):
    // its tokens are appended after every token so far, with their file
    // positions, and parsed as a run of their own. A blank segment is a
    // format placeholder, and any other must be exactly one expression
    // (syntax.rule.interpolation-whole).
    func parse_segment(&var self, piece: InterpPiece) -> Bool {
        let start = piece.open + 1
        let text = self.builder.tree.source.slice(start, start + piece.len)
        var toks = Vector<ParseToken>()
        var found = Vector<InterpPiece>()
        let lexed = lex(text)
        match lexed {
            case Ok(result) -> {
                let segment_source = source_file("", text)
                parser_tokens(&segment_source, &result, start, &var toks, &var found)
            },
            case Err(e) -> {
                let segment_source = source_file("", text)
                let at = start + segment_source.offset_of(e.line, e.col)
                self.lex_error(at, e.message, e.rule, e.hint)
                return false
            }
        }
        // The segment's tokens and pieces go at the live ends of the parser's
        // own, so each nested string's piece indices move by where they land.
        let base = self.piece_count
        var k = 0
        while k < found.len() {
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.pieces, self.piece_count, found[k])
            let nested = found[k]
            let at = self.piece_count
            put_at(&var self.pieces, at, nested)
            self.piece_count = at + 1
            k = k + 1
        }
        let first = self.token_count
        k = 0
        while k < toks.len() {
            let t = toks[k]
            let moved = ParseToken(kind: t.kind, start: t.start, end: t.end, line: t.line,
                                   seg_start: t.seg_start + base, seg_count: t.seg_count)
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.tokens, self.token_count, moved)
            let at = self.token_count
            put_at(&var self.tokens, at, moved)
            if at < self.failed_lists.len() {
                self.failed_lists[at] = false
            }
            if at < self.closer_scans.len() {
                self.closer_scans[at] = CloserScan.Unscanned
            }
            self.token_count = at + 1
            k = k + 1
        }
        let saved_pos = self.pos
        let saved_limit = self.limit
        let saved_end = self.prev_end
        let saved_lists = self.lists
        let saved_head = self.head
        // A head noted inside the segment names the segment's own tokens,
        // which no refusal after it reads.
        let noted = self.note_head()
        self.pos = first
        self.limit = self.token_count - 1
        self.lists = 0
        self.head = HeadState.Off
        var ok = true
        if self.kind() == TokenKind.Eof {
            self.see(Alt.Expr_InterpSegment_Placeholder)
            let _ = self.builder.leaf(NodeShape.Placeholder, piece.open, start + piece.len + 1)
        } else {
            self.see(Alt.Expr_InterpSegment_Expr)
            ok = self.parse_expr()
            if ok && self.kind() != TokenKind.Eof {
                ok = self.error("an interpolation segment holds exactly one expression")
            }
        }
        self.pos = saved_pos
        self.limit = saved_limit
        self.prev_end = saved_end
        self.lists = saved_lists
        self.head = saved_head
        self.restore_head(&noted)
        ok
    }

    // `source-location ::= "#file" | "#line" | "#function"`, and `#lend_var`,
    // which the lexer passes on only to be refused.
    func parse_directive(&var self) -> Bool {
        let t = self.current()
        let name_start = t.start + 1
        var alt = Alt.Expr_SourceLocation_File
        if self.builder.tree.source.span_is(name_start, t.end, "line") {
            alt = Alt.Expr_SourceLocation_Line
        } else if self.builder.tree.source.span_is(name_start, t.end, "function") {
            alt = Alt.Expr_SourceLocation_Function
        } else if not self.builder.tree.source.span_is(name_start, t.end, "file") {
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedLendVar, at,
                               "a `borrows` body never tests its lend mode",
                               "write the shared and the exclusive accessor apart, or use `@synthesize(shared)`")
        }
        self.see(Alt.Expr_Primary_SourceLocation)
        self.token_node(alt, false)
    }

    // A literal's node; `shown` when its token prints, which a keyword the
    // node's Kind implies does not.
    func literal(&var self, form: Alt, node: Alt, shown: Bool) -> Bool {
        self.see(Alt.Expr_Primary_Literal)
        self.see(form)
        self.token_node(node, shown)
    }

    // `paren-expr ::= "(" expr ")"`, which builds no node, since grouping
    // parentheses print nothing, or a `tuple-expr`. Either charges one level
    // for its `(`. A name and `:` first make the tuple named, and then every
    // element is labelled, or else none is (syntax.rule.label-or-tuple); a
    // mix is refused once the tuple has parsed.
    func parse_paren(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let head = self.head
        self.head = HeadState.Off
        if not self.parse_paren_body(open) {
            return false
        }
        self.head = head
        self.leave_level()
        true
    }

    func parse_paren_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.RParen {
            self.advance()
            self.see(Alt.Expr_Primary_Tuple)
            self.see(Alt.Expr_Tuple_Unit)
            self.close(mark, Alt.Expr_Tuple_Unit, start)
            return true
        }
        let named = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
        let first = self.builder.mark()
        if not named {
            if not self.parse_expr() {
                return false
            }
            if self.kind() == TokenKind.RParen {
                self.advance()
                self.see(Alt.Expr_Primary_Paren)
                self.see(Alt.Expr_Paren)
                return true
            }
        }
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.TupleExpr), open, not named, &var count) {
            return false
        }
        let mixed = self.first_mixed_element(first, count.elements, Alt.Expr_TupleField)
        self.advance()
        if mixed >= 0 {
            return self.refuse(Rule.Expr_RefusedPartialNamedTuple, mixed,
                               "a named tuple labels every element or none",
                               "label every element, or none")
        }
        let alt = if named { Alt.Expr_Tuple_Named } else { Alt.Expr_Tuple_Positional }
        self.see(Alt.Expr_Primary_Tuple)
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // An element of a tuple expression: a name and `:` label it
    // (syntax.rule.label-or-tuple).
    func parse_tuple_element(&var self) -> Bool {
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            return self.parse_tuple_field()
        }
        self.parse_expr()
    }

    // `tuple-field ::= IDENT ":" expr`
    func parse_tuple_field(&var self) -> Bool {
        self.see(Alt.Expr_TupleField)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, Alt.Expr_TupleField, start)
        true
    }

    // A bracketed list that goes on neither with a separator nor with its
    // closer: unclosed at the end of input, reported at its opener, and
    // otherwise a plain error here.
    func list_error(&var self, open: Int, message: String) -> Bool {
        if self.kind() == TokenKind.Eof {
            return self.refuse_unclosed(open)
        }
        self.error(message)
    }

    // ---- comma lists -----------------------------------------------------------------

    // The one comma-list funnel: `element ( "," element )* ","?` up to the
    // closer `shape` names, which it tests for and leaves to the caller, who
    // consumed the opener at `open` too. With `first_done` the caller has
    // parsed the first element already, to tell the list from a construct
    // that shares its opener. A trailing comma follows `shape.trailing`; a
    // refused one inside a speculation is noted and refused only if the list
    // is kept (`speculate_list`), so the speculation does not fail on it.
    // Writes what the list holds to `count`, and returns false once it has
    // reported an error. compiler/tools/comma_funnel.py
    // fails on a loop that takes a `,` anywhere else, but those the COMMA
    // LEDGER below exempts.
    // ENTRY POINTS:
    //     parse_import_symbols
    //     parse_params
    //     parse_tuple_pattern_body
    //     parse_variant_pattern_body
    //     parse_func_type
    //     parse_paren_type_body
    //     parse_generic_params_body
    //     parse_generic_args_body
    //     parse_call
    //     parse_subscript
    //     parse_paren_body
    //     parse_bracket
    //     parse_map_rest
    //     parse_set_rest
    //     parse_closure_head
    //     parse_capture_list
    //     parse_struct
    //     parse_enum
    //     parse_payload_decl
    //     parse_extern_func
    //     parse_trait
    //     parse_extension
    //     parse_borrow_block
    // COMMA LEDGER:
    //     parse_match: an arm separator is a comma, a line break or nothing (syntax.expr.arm-sep), and separates arms, which no bracket closes
    func parse_comma_list(&var self, shape: ListShape, open: Int, first_done: Bool,
                          count: &var ListCount) -> Bool {
        var elements = 0
        var trailing = false
        if first_done {
            elements = 1
        } else if not (shape.empty && self.at_closer(shape.closer)) {
            if not self.parse_list_item(shape, open) {
                return false
            }
            elements = 1
        }
        while elements > 0 {
            if shape.breaks == LineBreaks.AroundEntries && self.separator_after_breaks(shape.closer) {
                self.skip_newlines()
            }
            if self.at_closer(shape.closer) {
                break
            }
            if shape.breaks == LineBreaks.Separate {
                let taken = self.take_list_sep()
                if taken == 0 {
                    return self.list_stop(shape.closer, open, list_gap_message(shape))
                }
                if self.at_closer(shape.closer) {
                    trailing = taken == 2
                    break
                }
            } else {
                if self.kind() != TokenKind.Comma {
                    return self.list_stop(shape.closer, open, list_gap_message(shape))
                }
                let comma = self.pos
                self.advance()
                if shape.breaks != LineBreaks.Settled {
                    self.skip_newlines()
                }
                if self.at_closer(shape.closer) {
                    trailing = true
                    if not self.trailing_comma_allowed(shape, comma) {
                        return false
                    }
                    break
                }
            }
            if not self.parse_list_item(shape, open) {
                return false
            }
            elements = elements + 1
        }
        if shape.trailing == TrailingComma.RequiredForOne && elements == 1 && not trailing {
            return self.refuse_list(shape, open)
        }
        count = ListCount(elements: elements, trailing: trailing)
        true
    }

    // The refusal of a list's trailing comma, or of its missing one, at `at`:
    // by the list's rule, or a plain error where it has none.
    func refuse_list(&var self, shape: ListShape, at: Int) -> Bool {
        if let rule = shape.refusal {
            return self.refuse(rule, at, list_refusal_message(shape.list),
                               list_refusal_hint(shape.list))
        }
        self.report(None, at, list_refusal_message(shape.list), "")
        false
    }

    // One element of the list, at the end of input the list's unclosed
    // bracket instead.
    func parse_list_item(&var self, shape: ListShape, open: Int) -> Bool {
        if self.kind() == TokenKind.Eof && is_bracket_closer(shape.closer) {
            return self.refuse_unclosed(open)
        }
        self.parse_list_element(shape.list, open)
    }

    // Whether the comma at `comma`, which the list's closer follows, may
    // stand there; reports it when not.
    func trailing_comma_allowed(&var self, shape: ListShape, comma: Int) -> Bool {
        if shape.trailing == TrailingComma.Allowed || shape.trailing == TrailingComma.RequiredForOne {
            return true
        }
        if shape.trailing == TrailingComma.Plain {
            return self.error(list_refusal_message(shape.list))
        }
        if self.speculating > 0 {
            if self.trailing_comma < 0 {
                self.trailing_comma = comma
            }
            return true
        }
        self.refuse_list(shape, comma)
    }

    // Whether the current token is the list's closer.
    func at_closer(&self, closer: ListCloser) -> Bool {
        match closer {
            case RParen -> self.kind() == TokenKind.RParen,
            case RBracket -> self.kind() == TokenKind.RBracket,
            case RBrace -> self.kind() == TokenKind.RBrace,
            case GenericClose -> self.closes_list(),
            case In -> self.kind() == TokenKind.In,
            case Body -> self.body_ahead()
        }
    }

    // Whether a `{` follows, on this line or after line breaks.
    func body_ahead(&self) -> Bool {
        let breaks = self.breaks_ahead(0)
        self.kind_at(breaks) == TokenKind.LBrace
    }

    // How many line breaks stand from `ahead` tokens on.
    func breaks_ahead(&self, ahead: Int) -> Int {
        var k = ahead
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        k - ahead
    }

    // The separator between two fields or cases, recorded as the list-sep
    // alternative it is: 2 for one that holds a comma, 1 for line breaks
    // alone, 0 when there is none (syntax.decl.list-sep).
    func take_list_sep(&var self) -> Int {
        var taken = 0
        if self.kind() == TokenKind.Newline {
            self.skip_newlines()
            taken = 1
        }
        if self.kind() == TokenKind.Comma {
            let alt = if taken == 1 { Alt.Decl_ListSep_NewlineComma } else { Alt.Decl_ListSep_Comma }
            self.see(alt)
            self.advance()
            self.skip_newlines()
            return 2
        }
        if taken == 1 {
            self.see(Alt.Decl_ListSep_Newline)
        }
        taken
    }

    // Whether line breaks here lead to a `,` or to the list's closer, which
    // they may stand before in a brace-delimited list.
    func separator_after_breaks(&self, closer: ListCloser) -> Bool {
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        let kind = self.kind_at(ahead)
        kind == TokenKind.Comma || (closer == ListCloser.RBrace && kind == TokenKind.RBrace)
    }

    // A list that goes on neither with a comma nor with its closer: an
    // unclosed bracket at the end of input, else a plain error here.
    func list_stop(&var self, closer: ListCloser, open: Int, message: String) -> Bool {
        if is_bracket_closer(closer) {
            return self.list_error(open, message)
        }
        self.error(message)
    }

    // The parser of one element of `list`.
    func parse_list_element(&var self, list: CommaList, open: Int) -> Bool {
        match list {
            case ImportSymbols -> self.parse_import_symbol_element(open),
            case Params -> self.parse_param(),
            case FuncTypeParams -> self.parse_type(false),
            case TupleType -> self.parse_tuple_type_element(),
            case GenericParams -> self.parse_generic_param(),
            case GenericArgs -> self.parse_generic_arg(),
            case CallArgs -> self.parse_argument(),
            case SubscriptArgs -> self.parse_argument(),
            case TupleExpr -> self.parse_tuple_element(),
            case ArrayElements -> self.parse_expr(),
            case MapEntries -> self.parse_map_entry(open),
            case SetElements -> self.parse_expr(),
            case TuplePattern -> self.parse_pattern(),
            case PayloadPatterns -> self.payload_pattern(),
            case ClosureParams -> self.parse_closure_param(),
            case Captures -> self.parse_capture(),
            case Fields -> self.parse_field(),
            case Cases -> self.parse_enum_case(),
            case PayloadFields -> self.parse_payload_field(open),
            case ExternParams -> self.parse_extern_param(open),
            case TraitParents -> self.parse_path(),
            case Conformances -> self.parse_path(),
            case BorrowBindings -> self.parse_borrow_binding()
        }
    }

    // The node of each of the `count` elements from scratch slot `first` is
    // a labelled field (`field`) or not; the token the first element that
    // differs from the first one starts at, or -1 when none does
    // (syntax.rule.label-or-tuple).
    func first_mixed_element(&self, first: Int, count: Int, field: Alt) -> Int {
        var named = false
        var k = 0
        while k < count {
            let node = self.builder.node_at(first + k)
            var labelled = false
            if let alt = node.alt {
                labelled = alt == field
            }
            if k == 0 {
                named = labelled
            } else if labelled != named {
                return self.token_starting_at(node.start)
            }
            k = k + 1
        }
        return -1
    }

    // The token before the current one that starts at byte `at`.
    func token_starting_at(&self, at: Int) -> Int {
        var k = self.pos
        while k > 0 && self.tokens[k].start > at {
            k = k - 1
        }
        k
    }

    // `array-literal ::= "[" ( expr ( "," expr )* ","? )? "]"` or
    // `repeat-literal ::= "[" expr ";" expr "]"`, charging one level for the `[`.
    func parse_bracket(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        let head = self.head
        self.head = HeadState.Off
        self.advance()
        var alt = Alt.Expr_Array
        if self.kind() != TokenKind.RBracket {
            if not self.parse_expr() {
                return false
            }
            if self.kind() == TokenKind.Semicolon {
                alt = Alt.Expr_Repeat
                self.advance()
                if not self.parse_expr() {
                    return false
                }
                if self.kind() != TokenKind.RBracket {
                    return self.list_error(open, "expected `]` after the repeat count")
                }
            } else {
                var count = no_elements()
                if not self.parse_comma_list(list_shape(CommaList.ArrayElements), open, true, &var count) {
                    return false
                }
            }
        }
        self.advance()
        self.head = head
        let form = if alt == Alt.Expr_Repeat { Alt.Expr_Primary_Repeat } else { Alt.Expr_Primary_Array }
        self.see(form)
        self.see(alt)
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // ---- braces and closures ----------------------------------------------------------

    // A `{` in expression position: a map literal, a set literal or a closure,
    // one level for the `{` whichever it is (syntax.rule.brace). A bounded look
    // decides `{:}` and a closure head; after that the first element decides,
    // parsed once as a closure's first statement would be and read by the
    // token after it: `:` on its line makes a map, `,` after any line breaks a
    // set, anything else a closure. A statement-only keyword first is a closure.
    func parse_brace(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_brace_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_brace_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        let outer = self.head
        let lists = self.lists
        self.lists = 0
        if self.empty_map_ahead() {
            self.see(Alt.Expr_Primary_Map)
            self.see(Alt.Expr_Map_Empty)
            self.advance()
            self.skip_newlines()
            self.advance()
            self.skip_newlines()
            self.lists = lists
            self.advance()
            self.close(mark, Alt.Expr_Map_Empty, start)
            return true
        }
        let noted = self.note_head()
        if self.closure_head_ahead() {
            self.see(Alt.Expr_Primary_Closure)
            self.advance()
            return self.parse_closure_rest(open, start, mark, true, lists, outer, &noted)
        }
        self.advance()
        self.skip_newlines()
        if self.kind() == TokenKind.RBrace || self.starts_statement_only(0) {
            self.see(Alt.Expr_Primary_Closure)
            return self.parse_closure_rest(open, start, mark, false, lists, outer, &noted)
        }
        let saved_shadow = self.shadow_brace
        if outer != HeadState.Off {
            self.head = HeadState.Shadow
            self.shadow_brace = -1
        }
        let first = self.pos
        let first_start = self.here()
        let element = self.builder.mark()
        let point = self.resume_point()
        var ok = true
        var bare = true
        if self.word_at(0, "static_assert") && self.kind_at(1) == TokenKind.LParen {
            // Only an element reaches here (starts_statement_only), and an
            // element names a call.
            ok = self.parse_expr()
        } else {
            ok = self.parse_statement(StatementPlace.BraceFirst)
            bare = ok && not self.is_statement_node(element)
        }
        var form = BraceForm.Closure
        if ok && bare {
            form = self.brace_form_after_element()
        }
        if form == BraceForm.Closure {
            if not ok {
                self.resume(&point)
                self.recover(first)
            }
            self.shadow_brace = saved_shadow
            if ok && bare {
                let continued = self.loop_continuation(element, first)
                if continued >= 0 {
                    return self.refuse(Rule.Rule_BlockTail, continued,
                                       "a loop that starts a statement is a statement, not an operand",
                                       "parenthesize the loop to use its value")
                }
                self.see(Alt.Stmt_Statement_Expr)
                self.see(Alt.Stmt_Expr)
                self.close(element, Alt.Stmt_Expr, first_start)
            }
            self.see(Alt.Expr_Primary_Closure)
            return self.parse_closure_body(open, start, mark, true, lists, outer, &noted)
        }
        // A literal's elements stand where the brace does, so they are in any
        // head the brace is in (syntax.rule.head-reset names no literal).
        if outer == HeadState.On && self.shadow_brace >= 0 {
            let at = self.shadow_brace
            self.shadow_brace = saved_shadow
            return self.refuse(Rule.Rule_HeadRestriction, at,
                               "a map or set literal in a head is at the head's outer level, so no trailing closure attaches there",
                               "pass the closure in parentheses: `f(\{ … \})`")
        }
        if outer != HeadState.Shadow || saved_shadow >= 0 {
            self.shadow_brace = saved_shadow
        }
        self.head = outer
        if self.head_brace < 0 {
            self.restore_head(&noted)
        }
        var alt = Alt.Expr_Set
        if form == BraceForm.Map {
            alt = Alt.Expr_Map_Entries
            self.see(Alt.Expr_Primary_Map)
            if not self.parse_map_rest(open, element, first_start) {
                return false
            }
        } else {
            self.see(Alt.Expr_Primary_Set)
            if not self.parse_set_rest(open) {
                return false
            }
        }
        self.lists = lists
        self.advance()
        self.close(mark, alt, start)
        true
    }

    // Whether the brace here is `{:}`, line breaks allowed around the `:`.
    func empty_map_ahead(&self) -> Bool {
        var k = 1
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        if self.kind_at(k) != TokenKind.Colon {
            return false
        }
        k = k + 1
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        self.kind_at(k) == TokenKind.RBrace
    }

    // Whether a closure head follows the brace here: past line breaks, a run
    // of tokens a head holds at the brace's own depth, then `in`. The scan
    // passes nested `( )` and `[ ]` groups whole and stops at the first token
    // no head holds (`holds_closure_head`, generated from the grammar). Only
    // `for` puts an `in` in a statement, so a body never reaches one this way.
    func closure_head_ahead(&self) -> Bool {
        var k = 1
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        let first = k
        var nested = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof {
                return false
            }
            if nested > 0 {
                if opens_bracket(kind) {
                    nested = nested + 1
                } else if closes_bracket(kind) {
                    nested = nested - 1
                }
            } else if kind == TokenKind.In {
                return k > first
            } else if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                nested = 1
            } else if not holds_closure_head(kind) {
                return false
            }
            k = k + 1
        }
        false
    }

    // Whether the token `ahead` tokens on begins a statement no expression
    // begins, which makes the brace around it a closure: a token of
    // `begins_statement_only`, generated from the grammar, or `static_assert`
    // and its `(`, which begin the assertion unless the token after its `)`
    // makes it a map key or a set element, where it is an ordinary call.
    func starts_statement_only(&self, ahead: Int) -> Bool {
        if self.word_at(ahead, "static_assert") && self.kind_at(ahead + 1) == TokenKind.LParen {
            return not self.assertion_is_element(ahead)
        }
        begins_statement_only(self.kind_at(ahead))
    }

    // Whether the `static_assert (…)` `ahead` tokens on is followed by what
    // makes it a map key or a set element: `:` on its line, or `,` after any
    // line breaks.
    func assertion_is_element(&self, ahead: Int) -> Bool {
        var k = ahead + 1
        var nested = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof {
                return false
            }
            if opens_bracket(kind) {
                nested = nested + 1
            } else if closes_bracket(kind) {
                nested = nested - 1
                if nested == 0 {
                    break
                }
            }
            k = k + 1
        }
        k = k + 1
        if self.kind_at(k) == TokenKind.Colon {
            return true
        }
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        self.kind_at(k) == TokenKind.Comma
    }

    // A closure's first statement, at scratch slot `slot` and begun at token
    // `first`, that a loop begins: the token after the loop when it would
    // continue the loop as an operand, which a loop starting a statement never
    // is (syntax.rule.block-tail), or -1. The loop is the element's leftmost
    // operand, so first children lead to it.
    func loop_continuation(&self, slot: Int, first: Int) -> Int {
        let lead = self.tokens[first].kind
        if lead != TokenKind.While && lead != TokenKind.For {
            return -1
        }
        var node = self.builder.node_at(slot)
        var found = false
        while not found {
            if let alt = node.alt {
                found = is_loop_alt(alt)
            }
            if not found {
                if node.count == 0 {
                    return -1
                }
                let child = self.builder.tree.child(&node, 0)
                node = self.builder.tree.node(child)
            }
        }
        var k = first
        while k < self.limit && self.tokens[k].start < node.end {
            k = k + 1
        }
        if continues_operand(self.tokens[k].kind) {
            return k
        }
        return -1
    }

    // Whether the node at scratch slot `slot` is a statement that no
    // expression is: an assignment, the one kind a brace's first element can
    // be that starts like an expression.
    func is_statement_node(&self, slot: Int) -> Bool {
        let node = self.builder.node_at(slot)
        if let alt = node.alt {
            return (alt == Alt.Stmt_Assign || alt == Alt.Stmt_CompoundAssign
                    || alt == Alt.Stmt_OptionalAssign_Plain || alt == Alt.Stmt_OptionalAssign_Compound)
        }
        false
    }

    // What the token after a brace's first element makes the brace. A map
    // entry's `:` stands on its key's line; a set may break before its `,`.
    func brace_form_after_element(&self) -> BraceForm {
        if self.kind() == TokenKind.Colon {
            return BraceForm.Map
        }
        var k = 0
        while self.kind_at(k) == TokenKind.Newline {
            k = k + 1
        }
        if self.kind_at(k) == TokenKind.Comma {
            return BraceForm.Set
        }
        BraceForm.Closure
    }

    // `map-literal`'s entries after its first key, which is on the scratch
    // stack at `key` and stands before the current `:`, up to its `}`.
    func parse_map_rest(&var self, open: Int, key: Int, key_start: Int) -> Bool {
        self.see(Alt.Expr_Map_Entries)
        if not self.parse_map_value(key, key_start) {
            return false
        }
        var count = no_elements()
        self.parse_comma_list(list_shape(CommaList.MapEntries), open, true, &var count)
    }

    // A `map-entry` of the map opened at `open`, whose `:` stands on its
    // key's line.
    func parse_map_entry(&var self, open: Int) -> Bool {
        let entry = self.builder.mark()
        let entry_start = self.here()
        if not self.parse_expr() {
            return false
        }
        if self.kind() != TokenKind.Colon {
            return self.list_error(open, "expected `:` and the entry's value")
        }
        self.parse_map_value(entry, entry_start)
    }

    // The `:` and value of the entry whose key is on the scratch stack at
    // `entry`, closed into its MapEntry node.
    func parse_map_value(&var self, entry: Int, entry_start: Int) -> Bool {
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.see(Alt.Expr_MapEntry)
        self.close(entry, Alt.Expr_MapEntry, entry_start)
        true
    }

    // `set-literal`'s elements after its first, which is on the scratch stack
    // and stands before the `,` that line breaks may precede, up to its `}`.
    func parse_set_rest(&var self, open: Int) -> Bool {
        self.see(Alt.Expr_Set)
        var count = no_elements()
        self.parse_comma_list(list_shape(CommaList.SetElements), open, true, &var count)
    }

    // `closure-literal` as a call's trailing closure, where no map or set can
    // stand, one level for its `{`.
    func parse_closure_literal(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        let outer = self.head
        let lists = self.lists
        self.lists = 0
        let noted = self.note_head()
        let headed = self.closure_head_ahead()
        self.advance()
        if not self.parse_closure_rest(open, start, mark, headed, lists, outer, &noted) {
            return false
        }
        self.leave_level()
        true
    }

    // A closure after its `{`: its head when the scan found one (`headed`),
    // then its statements. `lists`, `outer` and `noted` are what the brace
    // found, which the closure gives back at its `}`.
    func parse_closure_rest(&var self, open: Int, start: Int, mark: Int, headed: Bool, lists: Int,
                            outer: HeadState, noted: &HeadNote) -> Bool {
        if headed {
            self.skip_newlines()
            self.head = HeadState.Off
            if not self.parse_closure_head() {
                return false
            }
        }
        self.parse_closure_body(open, start, mark, false, lists, outer, &noted)
    }

    // `block-body "}"` of a closure, after its first statement when `any`,
    // closed into the Closure node. A closure body resets any head around it
    // (syntax.rule.head-reset), and its line breaks are significant inside a
    // generic list.
    func parse_closure_body(&var self, open: Int, start: Int, mark: Int, any: Bool, lists: Int,
                            outer: HeadState, noted: &HeadNote) -> Bool {
        self.see(Alt.Expr_Closure)
        self.see(Alt.Stmt_Body)
        self.head = HeadState.Off
        self.parse_statement_list(any)
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.lists = lists
        self.advance()
        self.head = outer
        self.restore_head(&noted)
        self.close(mark, Alt.Expr_Closure, start)
        true
    }

    // `closure-head`: a capture list, parameters, or both, then `in`, which
    // prints, since `closure-head` builds no node to imply it. Line breaks may
    // stand after the capture list, and after each parameter's `,`.
    func parse_closure_head(&var self) -> Bool {
        if self.kind() == TokenKind.LBracket {
            if not self.parse_capture_list() {
                return false
            }
            self.skip_newlines()
            if self.kind() == TokenKind.In {
                self.see(Alt.Expr_ClosureHead_Captures)
                self.take_leaf()
                return true
            }
            self.see(Alt.Expr_ClosureHead_CapturesParams)
        } else {
            self.see(Alt.Expr_ClosureHead_Params)
        }
        self.see(Alt.Expr_ClosureParams)
        let first = self.pos
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.ClosureParams), first, false, &var count) {
            return false
        }
        self.take_leaf()
        true
    }

    // `capture-list ::= "[" capture ( "," capture )* ","? "]"`
    func parse_capture_list(&var self) -> Bool {
        self.see(Alt.Expr_CaptureList)
        let open = self.pos
        self.advance()
        var count = no_elements()
        if not self.parse_comma_list(list_shape(CommaList.Captures), open, false, &var count) {
            return false
        }
        self.advance()
        true
    }

    // `capture`: a name, `move`, `copy`, `&` or `&var` and a name, or `&` or
    // `&var` and `self`. A plain or moved `self` is the refused capture
    // (syntax.expr.refused-capture-self).
    func parse_capture(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        let kind = self.kind()
        let next = self.kind_at(1)
        var alt = Alt.Expr_Capture_Value
        if kind == TokenKind.SelfKw || (kind == TokenKind.Move_ && next == TokenKind.SelfKw) {
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedCaptureSelf, at,
                               "`self` is captured only by borrowing it",
                               "write `[&self]` or `[&var self]`")
        }
        if kind == TokenKind.Ident && next == TokenKind.Ident && self.word_at(0, "copy") {
            alt = Alt.Expr_Capture_Copy
            self.advance()
        } else if kind == TokenKind.Move_ {
            alt = Alt.Expr_Capture_Move
            self.advance()
        } else if kind == TokenKind.Ampersand {
            let exclusive = next == TokenKind.Var
            let width = if exclusive { 2 } else { 1 }
            if self.kind_at(width) == TokenKind.SelfKw {
                alt = if exclusive { Alt.Expr_Capture_SelfExclusive } else { Alt.Expr_Capture_Self }
                var k = 0
                while k <= width {
                    self.advance()
                    k = k + 1
                }
                self.see(alt)
                self.close(mark, alt, start)
                return true
            }
            alt = if exclusive { Alt.Expr_Capture_BorrowExclusive } else { Alt.Expr_Capture_Borrow }
            var k = 0
            while k < width {
                self.advance()
                k = k + 1
            }
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected a name to capture")
        }
        self.take_leaf()
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `closure-param`: a name, or `&` or `&var` and a name, with an optional
    // type annotation.
    func parse_closure_param(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Expr_ClosureParam_Value
        if self.kind() == TokenKind.Ampersand {
            if self.kind_at(1) == TokenKind.Var {
                alt = Alt.Expr_ClosureParam_RefExclusive
                self.advance()
            } else {
                alt = Alt.Expr_ClosureParam_Ref
            }
            self.advance()
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected a parameter name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Stmt_TypeAnnotation)
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }
}
