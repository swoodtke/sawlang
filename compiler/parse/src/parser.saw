// The parser: bounded recursive descent over GRAMMAR.md (SL:architecture §3.2).
//
// Each construct is one method, named for its production, which builds the
// construct's node from the scratch stack of `TreeBuilder` and records every
// alternative its derivation takes, so a parse reports the same coverage the
// reference recognizer's record does. A binary tier is a loop into one flat
// node. Recursion only ever passes through `enter_level`, the one depth funnel;
// compiler/tools/depth_funnel.py proves that of every call cycle.
//
// A method returns false once it has reported an error. Nothing above it
// reports again: the error unwinds to the statement or declaration loop,
// which skips to the next boundary at the same bracket depth and goes on, so
// one run reports every independent error.

import sawlex.src.lib.{DocComment, TokenKind, lex}
import sawparse.src.source.{source_file}
import sawparse.src.diag.{Diagnostic}
import sawparse.src.grammar.{ALT_COUNT, Alt, Rule, follows_cast_list, stops_list_scan}
import sawparse.src.tokens.{InterpPiece, ParseToken, closes_bracket, opens_bracket, parser_tokens}
import sawparse.src.tree.{BuilderCheckpoint, NodeShape, TreeBuilder, put_at, trim_to}

public static PARSE_MAX_DEPTH: Int = 256
static PARSE_SPACE: Int = 32

// A run of `///` lines and the token it documents: the first token after its
// last line that is not a line break.
struct DocRun {
    first: Int
    last: Int
    target: Int
    attached: Bool
}

// Where a statement list stands between items: whether it holds one yet, and
// whether a `;` is waiting for the statement it joins.
struct ListState {
    any: Bool
    need: Bool
}

// A token a generic list's close split, and the token it was before, so that
// a restore can put it back (syntax.rule.generic-close-split).
struct TokenEdit {
    index: Int
    token: ParseToken
}

// What a speculative generic list came to: kept, re-read as comparisons, or
// kept and refused, which is reported (syntax.rule.generic-or-less).
enum ListOutcome {
    case Kept,
    case Compares,
    case Refused
}

// What a scan ahead of a `<` found: a token that could close a generic list
// opened there, or proof that none can (syntax.rule.generic-or-less).
enum CloserScan {
    case Unscanned,
    case Found,
    case Missing
}

// Where a statement list stood before an item that may fail: what the
// recovery loop returns it to.
struct ResumePoint {
    mark: Int
    depth: Int
    lists: Int
    head: Bool
    spine: Int
    literal_arm: Int
}

// Where the parser stood when a speculation began: what `restore` returns it
// to. SPECULATION LEDGER below lists each field of `Parser` and why a restore
// leaves it right.
public struct Checkpoint {
    public tree: BuilderCheckpoint
    public tokens: Int
    public pieces: Int
    public pos: Int
    public limit: Int
    public prev_end: Int
    public depth: Int
    public taken: Int
    public edits: Int
    public lists: Int
    public speculating: Int
    public trailing_comma: Int
    public rejected_list: Int
    public head: Bool
    public primed: Bool
    public spine: Int
    public literal_arm: Int
}

public struct Parser {
    builder: TreeBuilder
    // The file's tokens, and after them each interpolation segment's, as it
    // is parsed, each run ending in its own Eof. The first `token_count` are
    // live; a restore lowers the count, and the slots above are reused.
    private tokens: Vector<ParseToken>
    private token_count: Int
    private pieces: Vector<InterpPiece>
    private piece_count: Int
    private docs: Vector<DocComment>
    private runs: Vector<DocRun>
    private pos: Int
    // The Eof that ends the run being parsed: the file's, or a segment's.
    private limit: Int
    // The end of the last token consumed, where a node closing now ends.
    private prev_end: Int
    private depth: Int
    diagnostics: Vector<Diagnostic>
    // Which alternatives the derivation took, and the same set in the order
    // first taken; the first `taken_count` of `taken` are live.
    private seen: Vector<Bool>
    taken: Vector<Alt>
    private taken_count: Int
    // The tokens split so far, the first `edit_count` live.
    private edits: Vector<TokenEdit>
    private edit_count: Int
    // How many generic lists are open, inside which line breaks are
    // insignificant (syntax.rule.generic-or-less).
    private lists: Int
    // How many speculations are open; none reports a diagnostic.
    private speculating: Int
    // The first trailing comma a speculative list met, or -1: refused only if
    // the list is kept.
    private trailing_comma: Int
    // The `<` of the last list the statement re-read as comparisons although
    // it parsed and its reading could go on, or -1; a plain error in that
    // statement is then that rule's refusal (syntax.rule.generic-or-less).
    private rejected_list: Int
    // For each token, whether a generic list speculated at it failed to parse,
    // which it then does wherever it is retried: a retry answers at once, so
    // nested speculations do not double their cost per level.
    private failed_lists: Vector<Bool>
    // For each `<`, what the scan for a closer ahead of it found. One scan
    // answers every `<` at its bracket depth up to where it stopped, so a
    // flat run of comparisons costs one scan, not one per `<`.
    private closer_scans: Vector<CloserScan>
    // Whether the parser stands at the outer level of a head, where a `{`
    // begins the construct's body (syntax.rule.head-restriction). A bracket, an
    // interpolation segment and a nested block clear it for their contents
    // (syntax.rule.head-reset).
    private head: Bool
    // Whether the operand of the expression about to be parsed is already
    // on the scratch stack: a statement that parsed a postfix chain as a
    // possible assignment target, and found no assignment after it.
    private primed: Bool
    // The alternatives a statement's leading postfix chain took that a target
    // derives otherwise: the chain's own, and one per hop. The first
    // `spine_count` are live, a stack each statement pushes and pops.
    private spine_alts: Vector<Alt>
    private spine_count: Int
    // The `{` of an arm body that reads as a map or set literal, or -1: a
    // plain error inside its block is that rule's refusal (syntax.rule.arm-body).
    private literal_arm: Int
    // How many depth refusals the parse has met, speculations included, and
    // the opener of the last.
    private depth_refusals: Int
    private depth_opener: Int
}

extension Parser: NoCopy {}

public func new_parser(builder: TreeBuilder, tokens: Vector<ParseToken>,
                       pieces: Vector<InterpPiece>, docs: &Vector<DocComment>) -> Parser {
    var seen = Vector<Bool>()
    var k = 0
    while k < ALT_COUNT {
        try! seen.push(false)
        k = k + 1
    }
    var own_docs = Vector<DocComment>()
    k = 0
    while k < docs.len() {
        let d = docs[k]
        try! own_docs.push(d)
        k = k + 1
    }
    let token_count = tokens.len()
    let piece_count = pieces.len()
    var parser = Parser(builder: move builder, tokens: move tokens, token_count: token_count,
                        pieces: move pieces, piece_count: piece_count, docs: move own_docs,
                        runs: Vector<DocRun>(), pos: 0, limit: token_count - 1, prev_end: 0,
                        depth: 0, diagnostics: Vector<Diagnostic>(), seen: move seen,
                        taken: Vector<Alt>(), taken_count: 0, edits: Vector<TokenEdit>(),
                        edit_count: 0, lists: 0, speculating: 0, trailing_comma: -1,
                        rejected_list: -1, failed_lists: Vector<Bool>(),
                        closer_scans: Vector<CloserScan>(), head: false, primed: false,
                        spine_alts: Vector<Alt>(), spine_count: 0, literal_arm: -1,
                        depth_refusals: 0,
                        depth_opener: -1)
    parser.find_doc_runs()
    move parser
}

// Whether a token of this kind ends a statement, and so leaves a `return`
// or `break` without an operand (GRAMMAR.md section 6.3); in an unbraced arm
// body (`arm`), `,` and `case` end one too (syntax.rule.arm-statement-end).
func ends_statement(kind: TokenKind, arm: Bool) -> Bool {
    match kind {
        case Newline -> true,
        case Semicolon -> true,
        case RBrace -> true,
        case Eof -> true,
        case Comma -> arm,
        case Case -> arm,
        case _ -> false
    }
}

// Whether a token of this kind would continue an expression whose operand
// ends before it: a postfix hop, a cast, or any binary, range or assignment
// operator (syntax.rule.block-tail).
func continues_operand(kind: TokenKind) -> Bool {
    if is_assignment(kind) || is_const_operator(kind) {
        return true
    }
    match kind {
        case Dot -> true,
        case QuestionDot -> true,
        case LParen -> true,
        case LBracket -> true,
        case Exclaim -> true,
        case As -> true,
        case WrapAdd -> true,
        case WrapSub -> true,
        case WrapMul -> true,
        case Lt -> true,
        case Gt -> true,
        case Lte -> true,
        case Gte -> true,
        case Eq -> true,
        case Neq -> true,
        case Ampersand -> true,
        case Pipe -> true,
        case Caret -> true,
        case And -> true,
        case Or -> true,
        case DoubleQuestion -> true,
        case DotDot -> true,
        case DotDotEq -> true,
        case Ellipsis -> true,
        case _ -> false
    }
}

// The alternative of a place hop, `place-hop`, for the postfix hop `hop`
// that ends an assignment's projection target.
func place_hop(hop: Alt) -> Alt {
    match hop {
        case Expr_Hop_TupleIndex -> Alt.Stmt_PlaceHop_TupleIndex,
        case Expr_Hop_Subscript -> Alt.Stmt_PlaceHop_Subscript,
        case Expr_Hop_Force -> Alt.Stmt_PlaceHop_Force,
        case _ -> Alt.Stmt_PlaceHop_Member
    }
}

// The alternative of a `chain-hop` after an optional-chain target's
// optional hop, for the postfix hop `hop` in its place.
func chain_hop(hop: Alt) -> Alt {
    match hop {
        case Expr_Hop_Optional -> Alt.Stmt_ChainHop_Optional,
        case Expr_Hop_Call -> Alt.Stmt_ChainHop_Call,
        case _ -> Alt.Stmt_ChainHop_Member
    }
}

// The `compound-op` alternative of a compound assignment operator.
func compound_op(kind: TokenKind) -> Alt {
    match kind {
        case MinusAssign -> Alt.Stmt_CompoundOp_Subtract,
        case StarAssign -> Alt.Stmt_CompoundOp_Multiply,
        case SlashAssign -> Alt.Stmt_CompoundOp_Divide,
        case PercentAssign -> Alt.Stmt_CompoundOp_Remainder,
        case AmpAssign -> Alt.Stmt_CompoundOp_And,
        case PipeAssign -> Alt.Stmt_CompoundOp_Or,
        case CaretAssign -> Alt.Stmt_CompoundOp_Xor,
        case ShlAssign -> Alt.Stmt_CompoundOp_ShiftLeft,
        case ShrAssign -> Alt.Stmt_CompoundOp_ShiftRight,
        case _ -> Alt.Stmt_CompoundOp_Add
    }
}

// The bracket depth after a token of this kind, where `open` holds the
// openers still open, innermost at `depth - 1`. A closer pops only an opener
// of its own kind.
func track_bracket(open: &var Vector<TokenKind>, depth: Int, kind: TokenKind) -> Int {
    if opens_bracket(kind) {
        if depth < open.len() {
            open[depth] = kind
        } else {
            try! open.push(kind)
        }
        return depth + 1
    }
    if depth > 0 && closes_bracket(kind) && closes_opener(kind, open[depth - 1]) {
        return depth - 1
    }
    depth
}

func closes_opener(closer: TokenKind, opener: TokenKind) -> Bool {
    match closer {
        case RParen -> opener == TokenKind.LParen,
        case RBracket -> opener == TokenKind.LBracket,
        case RBrace -> opener == TokenKind.LBrace,
        case _ -> false
    }
}

// Whether a token of this kind begins a declaration at a top-level item's head.
func is_declaration_keyword(kind: TokenKind) -> Bool {
    match kind {
        case Func -> true,
        case Public -> true,
        case At -> true,
        case Struct -> true,
        case Enum -> true,
        case Trait -> true,
        case Extension -> true,
        case Extern -> true,
        case Static -> true,
        case Unsafe_ -> true,
        case _ -> false
    }
}

// Whether a token of this kind is an operator of the constant grammar
// (GRAMMAR.md section 5.2).
func is_const_operator(kind: TokenKind) -> Bool {
    match kind {
        case Plus -> true,
        case Minus -> true,
        case Star -> true,
        case Slash -> true,
        case Percent -> true,
        case _ -> false
    }
}

// Whether a token of this kind can go on after a postfix expression, so that
// a generic list re-read before it had a reading that went on
// (syntax.rule.generic-or-less).
func continues_postfix(kind: TokenKind) -> Bool {
    (follows_cast_list(kind) || kind == TokenKind.LBracket || kind == TokenKind.Exclaim
     || kind == TokenKind.QuestionDot)
}

// Whether a token of this kind makes the statement before it an assignment.
func is_assignment(kind: TokenKind) -> Bool {
    match kind {
        case Assign -> true,
        case PlusAssign -> true,
        case MinusAssign -> true,
        case StarAssign -> true,
        case SlashAssign -> true,
        case PercentAssign -> true,
        case AmpAssign -> true,
        case PipeAssign -> true,
        case CaretAssign -> true,
        case ShlAssign -> true,
        case ShrAssign -> true,
        case _ -> false
    }
}

extension Parser {
    // ---- tokens -------------------------------------------------------------

    func current(&self) -> ParseToken { self.tokens[self.pos] }

    func kind(&self) -> TokenKind { self.tokens[self.pos].kind }

    // The kind `ahead` tokens on, or Eof past the end of the run.
    func kind_at(&self, ahead: Int) -> TokenKind {
        let at = self.pos + ahead
        if at <= self.limit { self.tokens[at].kind } else { TokenKind.Eof }
    }

    // Whether the token `ahead` tokens on is an identifier spelled `word`: a
    // contextual word, recognized only where the grammar asks for it.
    func word_at(&self, ahead: Int, word: String) -> Bool {
        let at = self.pos + ahead
        if at > self.limit || self.tokens[at].kind != TokenKind.Ident {
            return false
        }
        let t = self.tokens[at]
        self.builder.tree.source.span_is(t.start, t.end, word)
    }

    // Consumes the current token. Inside a generic list the line breaks after
    // it are insignificant, so they are passed over too, without moving where
    // a node closing now ends.
    func advance(&var self) {
        let t = self.current()
        self.prev_end = t.end
        if self.pos < self.limit {
            self.pos = self.pos + 1
        }
        if self.lists > 0 {
            while self.pos < self.limit && self.tokens[self.pos].kind == TokenKind.Newline {
                self.pos = self.pos + 1
            }
        }
    }

    // The byte where the current token starts, where a construct starting
    // here begins its span.
    func here(&self) -> Int { self.tokens[self.pos].start }

    func skip_newlines(&var self) {
        while self.kind() == TokenKind.Newline {
            self.advance()
        }
    }

    // The current token as a leaf of the construct under way.
    func take_leaf(&var self) {
        let t = self.current()
        let _ = self.builder.leaf(NodeShape.Token, t.start, t.end)
        self.advance()
    }

    // ---- the tree -----------------------------------------------------------

    func see(&var self, alt: Alt) {
        let index = (alt as UInt16) as Int
        if not self.seen[index] {
            self.seen[index] = true
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.taken, self.taken_count, alt)
            let at = self.taken_count
            put_at(&var self.taken, at, alt)
            self.taken_count = at + 1
        }
    }

    // ---- speculation ----------------------------------------------------------

    // Opens a speculation: parsing goes on from here, reporting nothing, until
    // `restore` undoes all of it or `commit` keeps it.
    // SPECULATION LEDGER:
    //     builder: restored
    //     tokens: restored
    //     token_count: restored
    //     pieces: restored by piece_count
    //     piece_count: restored
    //     docs: unchanged, because nothing writes it after the parser is built
    //     runs: unchanged, because only a declaration attaches a doc run, and attach_docs refuses to run inside a speculation
    //     pos: restored
    //     limit: restored
    //     prev_end: restored
    //     depth: restored
    //     diagnostics: unchanged, because record drops a diagnostic while a speculation is open
    //     seen: restored
    //     taken: restored
    //     taken_count: restored
    //     edits: restored
    //     edit_count: restored
    //     lists: restored
    //     speculating: restored
    //     trailing_comma: restored
    //     rejected_list: restored
    //     failed_lists: kept, because a list that failed to parse fails in every context, a depth refusal being refused rather than recorded, and parse_segment clears a slot it reuses
    //     closer_scans: kept, because a scan reads only the tokens after its `<`, which no speculation has split yet, and parse_segment clears a slot it reuses
    //     head: restored
    //     primed: restored
    //     spine_alts: restored by spine_count
    //     spine_count: restored
    //     literal_arm: restored
    //     depth_refusals: kept, because it only counts up, so a speculation sees the refusals of those nested in it
    //     depth_opener: kept, because it names the opener a depth refusal a restore undid is reported at
    public func checkpoint(&var self) -> Checkpoint {
        let tree = self.builder.checkpoint()
        let saved = Checkpoint(tree: tree, tokens: self.token_count, pieces: self.piece_count,
                               pos: self.pos, limit: self.limit, prev_end: self.prev_end,
                               depth: self.depth, taken: self.taken_count,
                               edits: self.edit_count, lists: self.lists,
                               speculating: self.speculating,
                               trailing_comma: self.trailing_comma,
                               rejected_list: self.rejected_list, head: self.head,
                               primed: self.primed, spine: self.spine_count,
                               literal_arm: self.literal_arm)
        self.speculating = self.speculating + 1
        saved
    }

    // Undoes everything since `saved`: the nodes built, the tokens appended
    // and split, the alternatives seen and the levels taken.
    public func restore(&var self, saved: &Checkpoint) {
        self.builder.restore(&saved.tree)
        var k = self.edit_count
        while k > saved.edits {
            k = k - 1
            let edit = self.edits[k]
            self.tokens[edit.index] = edit.token
        }
        self.edit_count = saved.edits
        k = self.taken_count
        while k > saved.taken {
            k = k - 1
            let index = (self.taken[k] as UInt16) as Int
            self.seen[index] = false
        }
        self.taken_count = saved.taken
        self.token_count = saved.tokens
        self.piece_count = saved.pieces
        self.pos = saved.pos
        self.limit = saved.limit
        self.prev_end = saved.prev_end
        self.depth = saved.depth
        self.lists = saved.lists
        self.speculating = saved.speculating
        self.trailing_comma = saved.trailing_comma
        self.rejected_list = saved.rejected_list
        self.head = saved.head
        self.primed = saved.primed
        self.spine_count = saved.spine
        self.literal_arm = saved.literal_arm
    }

    // Keeps what the speculation since `saved` parsed.
    public func commit(&var self, saved: &Checkpoint) {
        self.builder.commit(&saved.tree)
        self.speculating = saved.speculating
    }

    // Closes the construct begun at `mark` into a node of `alt`'s Kind that
    // spans from `start` to the last token consumed.
    func close(&var self, mark: Int, alt: Alt, start: Int) {
        // Stage 0 workaround (SL:hazards S4): canonical: let _ = self.builder.close(mark, NodeShape.Built, alt, start, self.prev_end)
        let end = self.prev_end
        let _ = self.builder.close(mark, NodeShape.Built, alt, start, end)
    }

    // Closes a binary tier's flat node, which spans from its first operand. A
    // chain production builds its node only over a second operand, so a
    // caller closes one only once it has taken an operator.
    func close_chain(&var self, mark: Int, alt: Alt) {
        let first = self.builder.at(mark)
        let start = self.builder.node(first).start
        self.close(mark, alt, start)
    }

    // The scratch height the operand parsed next starts at, one slot lower
    // when a statement's leading chain is already there (`primed`).
    func operand_mark(&self) -> Int {
        if self.primed { self.builder.mark() - 1 } else { self.builder.mark() }
    }

    // Where the operand parsed next starts.
    func operand_start(&self) -> Int {
        if self.primed {
            let slot = self.builder.mark() - 1
            return self.builder.node_at(slot).start
        }
        self.here()
    }

    // ---- diagnostics --------------------------------------------------------

    // The one place a diagnostic is kept. Inside a speculation nothing is: a
    // speculation that fails is undone and its errors with it.
    func record(&var self, d: Diagnostic) {
        if self.speculating == 0 {
            try! self.diagnostics.push(d)
        }
    }

    func report(&var self, rule: Rule?, at: Int, message: String, hint: String) {
        let t = self.tokens[at]
        self.record(Diagnostic(rule: rule, start: t.start, end: t.end, message: message,
                               hint: hint))
    }

    // A plain parse error at the current token. Always false, so a method
    // reports and fails in one step. In a statement that re-read a generic
    // list its reading could have gone on with, the error is that rule's
    // refusal, at the list's `<` (syntax.rule.generic-or-less).
    func error(&var self, message: String) -> Bool {
        let list = self.rejected_list
        if list >= 0 && self.speculating == 0 {
            return self.refuse_rejected_list(list)
        }
        let brace = self.literal_arm
        if brace >= 0 && self.speculating == 0 {
            self.literal_arm = -1
            return self.refuse(Rule.Rule_ArmBody, brace,
                               "an arm body that starts with `\{` is a block",
                               "parenthesize a map or set literal: `case _ -> (\{a: 1\})`")
        }
        // Stage 0 workaround (SL:hazards S4): canonical: self.report(None, self.pos, message, "")
        let at = self.pos
        self.report(None, at, message, "")
        false
    }

    // The refusal of the generic list at `at`, which parsed and was re-read as
    // comparisons, when that reading fails and its own would have gone on.
    func refuse_rejected_list(&var self, at: Int) -> Bool {
        self.rejected_list = -1
        self.refuse(Rule.Rule_GenericOrLess, at, "these generic arguments are read as comparisons",
                    "a generic list is kept before `(`, `.` or `\{`; parenthesize a comparison")
    }

    // The lexer's refusal, at byte `at`: the whole parse, since the lexer
    // stops at its first error.
    public func lex_error(&var self, at: Int, message: String) {
        self.record(Diagnostic(rule: None, start: at, end: at, message: message, hint: ""))
    }

    // A refusal named by `rule`, at the token `at`.
    func refuse(&var self, rule: Rule, at: Int, message: String, hint: String) -> Bool {
        self.report(rule, at, message, hint)
        false
    }

    // Skips what is left of a construct that failed, from the token it started
    // at: forward to the line break or `;` that ends it at its own bracket
    // depth, or to the `}` or end of input that ends what holds it. A closer
    // ends only a bracket of its own kind, so an unclosed `(` never swallows
    // the block's `}`, and a `)` or `]` that closes nothing is stray.
    func recover(&var self, from: Int) {
        var open = Vector<TokenKind>()
        var depth = 0
        var k = from
        while k < self.pos {
            depth = track_bracket(&var open, depth, self.tokens[k].kind)
            k = k + 1
        }
        while self.kind() != TokenKind.Eof {
            let kind = self.kind()
            let boundary = kind == TokenKind.Newline || kind == TokenKind.Semicolon
            if depth == 0 && boundary {
                return
            }
            if kind == TokenKind.RBrace && (depth == 0 || open[depth - 1] != TokenKind.LBrace) {
                return
            }
            depth = track_bracket(&var open, depth, kind)
            self.advance()
        }
    }

    // ---- the depth funnel -----------------------------------------------------

    // The one depth funnel. Each construct GRAMMAR.md section 11 charges takes
    // its level here, at its opener, and gives it back with `leave_level` when
    // it ends; the 257th level is refused at the opener that would take it.
    // A failed construct gives nothing back: the recovery loop that catches it
    // restores the depth it saved, as a failed speculation's restore does.
    // Every recursion passes through here, which compiler/tools/depth_funnel.py
    // checks against this list; so a speculation nested in another is charged
    // at least the generic list that holds it.
    // ENTRY POINTS:
    //     parse_paren
    //     parse_module
    //     parse_cast
    //     parse_prefix_operator
    //     parse_bracket
    //     parse_postfix
    //     parse_try
    //     parse_interp
    //     parse_ref_type
    //     parse_slice_type
    //     parse_array_type
    //     parse_func_type
    //     parse_paren_type
    //     parse_generic_params
    //     parse_generic_args
    //     parse_const_negate
    //     parse_const_group
    //     parse_try_block
    //     parse_if
    //     parse_guard
    //     parse_while
    //     parse_for
    //     parse_match
    //     parse_tuple_pattern
    //     parse_variant_pattern
    func enter_level(&var self, opener: Int) -> Bool {
        if self.depth >= PARSE_MAX_DEPTH {
            self.depth_refusals = self.depth_refusals + 1
            self.depth_opener = opener
            return self.refuse_depth(opener)
        }
        self.depth = self.depth + 1
        true
    }

    func refuse_depth(&var self, opener: Int) -> Bool {
        self.refuse(Rule.Rule_DepthLimit, opener, "nesting exceeds the parser depth limit (256)",
                    "split the expression or the declaration into smaller ones")
    }

    func leave_level(&var self) {
        self.depth = self.depth - 1
    }

    // ---- doc comments ---------------------------------------------------------

    func find_doc_runs(&var self) {
        var i = 0
        var k = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if not d.kind.equals("doc") {
                i = i + 1
                continue
            }
            var last = i
            while last + 1 < self.docs.len() {
                let next = self.docs[last + 1]
                let current = self.docs[last]
                if not next.kind.equals("doc") || next.line != current.line + 1 {
                    break
                }
                last = last + 1
            }
            let end_line = self.docs[last].line
            while k < self.token_count && (self.tokens[k].line <= end_line
                                         || self.tokens[k].kind == TokenKind.Newline) {
                k = k + 1
            }
            let target = if k < self.token_count { k } else { self.token_count - 1 }
            try! self.runs.push(DocRun(first: i, last: last, target: target, attached: false))
            i = last + 1
        }
    }

    // A doc line's text: what follows its three-character marker and one
    // space, if there is one.
    func doc_line_span_start(&self, d: &DocComment) -> Int {
        let at = self.builder.tree.source.offset_of(d.line, d.col) + 3
        if at < self.builder.tree.source.len() && self.builder.tree.source.byte(at) == PARSE_SPACE {
            at + 1
        } else {
            at
        }
    }

    // The Doc node of docs[first..last], pushed as a child of the construct
    // under way. Returns where it starts.
    func doc_node(&var self, first: Int, last: Int) -> Int {
        let mark = self.builder.mark()
        let d0 = self.docs[first]
        let start = self.builder.tree.source.offset_of(d0.line, d0.col)
        var end = start
        var i = first
        while i <= last {
            let d = self.docs[i]
            let text_start = self.doc_line_span_start(&d)
            end = text_start + d.text.len()
            let _ = self.builder.leaf(NodeShape.DocLine, text_start, end)
            i = i + 1
        }
        let _ = self.builder.close(mark, NodeShape.Doc, None, start, end)
        start
    }

    // Attaches the doc run that documents the declaration starting at token
    // `first`, if there is one, and returns where the declaration's span
    // starts: at its doc comment, or at its first token.
    func attach_docs(&var self, first: Int) -> Int {
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if run.target == first {
                // A restore does not return the runs to an earlier state, so
                // none may be attached inside a speculation (SPECULATION LEDGER).
                assert(self.speculating == 0, "parse: a doc run attached inside a speculation")
                self.runs[r] = DocRun(first: run.first, last: run.last, target: run.target,
                                      attached: true)
                return self.doc_node(run.first, run.last)
            }
            r = r + 1
        }
        self.tokens[first].start
    }

    // The file's `//!` lines, as the File node's first child.
    func module_docs(&var self) {
        var first = -1
        var last = -1
        var i = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if d.kind.equals("module") {
                if first < 0 {
                    first = i
                }
                last = i
            }
            i = i + 1
        }
        if first < 0 {
            return
        }
        let mark = self.builder.mark()
        let d0 = self.docs[first]
        let start = self.builder.tree.source.offset_of(d0.line, d0.col)
        var end = start
        i = first
        while i <= last {
            let d = self.docs[i]
            if d.kind.equals("module") {
                let text_start = self.doc_line_span_start(&d)
                end = text_start + d.text.len()
                let _ = self.builder.leaf(NodeShape.DocLine, text_start, end)
            }
            i = i + 1
        }
        let _ = self.builder.close(mark, NodeShape.Doc, None, start, end)
    }

    // A `//!` line after the file's first token (syntax.lex.module-doc).
    func check_module_docs(&var self) {
        var k = 0
        while k < self.token_count && self.tokens[k].kind == TokenKind.Newline {
            k = k + 1
        }
        if k >= self.token_count || self.tokens[k].kind == TokenKind.Eof {
            return
        }
        let first_line = self.tokens[k].line
        var i = 0
        while i < self.docs.len() {
            let d = self.docs[i]
            if d.kind.equals("module") && d.line > first_line {
                let at = self.builder.tree.source.offset_of(d.line, d.col)
                self.record(Diagnostic(rule: Rule.Lex_ModuleDoc, start: at, end: at + 3,
                                       message: "a `//!` comment stands only before the file's first token",
                                       hint: "make it a `//` comment, or move it to the top"))
                return
            }
            i = i + 1
        }
    }

    // A `///` run that documents nothing (syntax.lex.doc-attach).
    func check_doc_runs(&var self) {
        var r = 0
        while r < self.runs.len() {
            let run = self.runs[r]
            if not run.attached {
                let d = self.docs[run.first]
                let at = self.builder.tree.source.offset_of(d.line, d.col)
                self.record(Diagnostic(rule: Rule.Lex_DocAttach, start: at, end: at + 3,
                                       message: "this doc comment documents no declaration",
                                       hint: "make it a `//` comment, or move it before a declaration"))
            }
            r = r + 1
        }
    }

    // ---- files ----------------------------------------------------------------

    // `source-file ::= NEWLINE* top-level-list? EOF`
    public func parse_file(&var self) {
        self.check_module_docs()
        self.see(Alt.File_Source)
        let mark = self.builder.mark()
        self.module_docs()
        self.skip_newlines()
        self.parse_items(false)
        let end = self.builder.tree.source.len()
        let _ = self.builder.close(mark, NodeShape.Built, Alt.File_Source, 0, end)
        self.finish()
    }

    // `refusal-unit ::= NEWLINE* ( refusal-unit-item ( stmt-sep refusal-unit-item )* NEWLINE* )? EOF`,
    // the body of a refusal case parsed on its own in a test build.
    public func parse_refusal_unit(&var self) {
        self.check_module_docs()
        self.see(Alt.Test_RefusalUnit)
        let mark = self.builder.mark()
        self.skip_newlines()
        self.parse_unit_items()
        let end = self.builder.tree.source.len()
        let _ = self.builder.close(mark, NodeShape.Built, Alt.Test_RefusalUnit, 0, end)
        self.finish()
    }

    func finish(&var self) {
        if self.diagnostics.len() == 0 {
            self.check_doc_runs()
        }
        // Stage 0 workaround (SL:hazards S4): canonical: trim_to(&var self.taken, self.taken_count)
        let used = self.taken_count
        trim_to(&var self.taken, used)
        self.builder.finish()
    }

    // `top-level-list ::= top-level-item ( NEWLINE+ top-level-item )* NEWLINE*`,
    // inside an inline module when `inline`, which a `}` closes.
    func parse_items(&var self, inline: Bool) {
        var any = false
        while true {
            let kind = self.kind()
            if kind == TokenKind.Eof || (inline && kind == TokenKind.RBrace) {
                break
            }
            if not any {
                self.see(Alt.File_List)
                any = true
            }
            let from = self.pos
            let point = self.resume_point()
            self.rejected_list = -1
            if not self.parse_item() {
                self.resume(&point)
                self.recover(from)
            }
            let after = self.kind()
            if after == TokenKind.Newline {
                self.skip_newlines()
            } else if after == TokenKind.Eof || (inline && after == TokenKind.RBrace) {
                break
            } else {
                let from_here = self.pos
                if after == TokenKind.Semicolon {
                    let _ = self.error("declarations are not joined by `;`; put each on its own line")
                } else {
                    let _ = self.error("two declarations on one line need a line break between them")
                }
                self.recover(from_here)
                if self.kind() == TokenKind.Semicolon || (not inline && self.kind() == TokenKind.RBrace) {
                    self.advance()
                }
                self.skip_newlines()
            }
        }
    }

    // Whether the current token begins a top-level item rather than a
    // statement, which is how a refusal unit tells its two kinds of item apart.
    func starts_item(&self) -> Bool {
        let kind = self.kind()
        if is_declaration_keyword(kind) {
            return true
        }
        if kind == TokenKind.Ident && self.kind_at(1) == TokenKind.Ident {
            let module = self.word_at(0, "import") || self.word_at(0, "module")
            return module || self.word_at(0, "export")
        }
        false
    }

    // `top-level-item`: an import, a module, or a declaration.
    func parse_item(&var self) -> Bool {
        // Nothing else starts with `import` or `module` at an item's head, so
        // without a name after it what is missing is that name.
        if self.kind_at(1) != TokenKind.Ident && self.word_at(0, "import") {
            self.advance()
            return self.error("expected the path of the module to import")
        }
        if self.kind_at(1) != TokenKind.Ident && self.word_at(0, "module") {
            self.advance()
            return self.error("expected the module's name")
        }
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Ident {
            if self.word_at(0, "import") {
                self.see(Alt.File_Item_Import)
                return self.parse_import(false)
            }
            if self.word_at(0, "module") {
                self.see(Alt.File_Item_Module)
                return self.parse_module(false)
            }
            if self.word_at(0, "export") {
                let at = self.pos
                return self.refuse(Rule.Decl_RefusedExport, at,
                                   "an `export` declaration is not Saw's re-export",
                                   "write `public import m.\{name\}`, `public import m.\{name as alias\}` or `public import m.*`")
            }
        }
        if self.kind() == TokenKind.Public {
            if self.word_at(1, "import") {
                self.see(Alt.File_Item_Import)
                return self.parse_import(true)
            }
            if self.word_at(1, "module") && self.kind_at(2) == TokenKind.Ident {
                self.see(Alt.File_Item_Module)
                return self.parse_module(true)
            }
            let scoped = self.kind_at(1) == TokenKind.LParen && self.kind_at(2) == TokenKind.Ident
            if scoped && self.kind_at(3) == TokenKind.RParen && self.word_at(4, "import") {
                let at = self.pos
                return self.refuse(Rule.Decl_RefusedScopedImport, at,
                                   "an import takes no scoped visibility",
                                   "`public import` is the only re-export form: write `public import m`")
            }
        }
        if self.word_at(0, "static_assert") && self.kind_at(1) == TokenKind.LParen {
            self.see(Alt.File_Item_StaticAssert)
            return self.parse_static_assert()
        }
        self.parse_declaration()
    }

    // `declaration-item`, with its doc comment and visibility inside it.
    func parse_declaration(&var self) -> Bool {
        let first = self.pos
        let mark = self.builder.mark()
        let start = self.attach_docs(first)
        if self.kind() == TokenKind.At {
            return self.error("an attribute is not parsed yet")
        }
        if self.kind() == TokenKind.Public {
            if not self.parse_visibility() {
                return false
            }
        }
        if self.kind() == TokenKind.Func {
            self.see(Alt.File_Item_Declaration)
            self.see(Alt.Decl_Item_Func)
            if not self.parse_func() {
                return false
            }
            self.close(mark, Alt.Decl_Item_Func, start)
            return true
        }
        if self.word_at(0, "type") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.File_Item_Declaration)
            self.see(Alt.Decl_Item_TypeAlias)
            if not self.parse_type_alias() {
                return false
            }
            self.close(mark, Alt.Decl_Item_TypeAlias, start)
            return true
        }
        if self.kind() == TokenKind.Enum && self.kind_at(1) == TokenKind.Ident {
            return self.parse_enum_head()
        }
        self.error("expected a declaration")
    }

    // `type-alias-decl ::= 'type' IDENT "=" type`
    func parse_type_alias(&var self) -> Bool {
        self.see(Alt.Decl_TypeAlias)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.take_leaf()
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the type the alias names")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Decl_TypeAlias, start)
        true
    }

    // An enum's head, as far as its generic parameters, so that a refusal
    // there is reported by name; the rest of an enum is not parsed yet.
    func parse_enum_head(&var self) -> Bool {
        self.advance()
        self.take_leaf()
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        self.error("an enum is not parsed yet")
    }

    // `visibility ::= "public" | "public" "(" 'package' ")" | "public" "(" 'parent' ")"`
    func parse_visibility(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var alt = Alt.Decl_Visibility_Public
        if self.kind() == TokenKind.LParen {
            if self.word_at(1, "package") && self.kind_at(2) == TokenKind.RParen {
                alt = Alt.Decl_Visibility_Package
            } else if self.word_at(1, "parent") && self.kind_at(2) == TokenKind.RParen {
                alt = Alt.Decl_Visibility_Parent
            } else {
                return self.error("a visibility names `package` or `parent`")
            }
            self.advance()
            self.advance()
            self.advance()
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // ---- imports and modules ----------------------------------------------------

    // `path ::= IDENT ( "." IDENT )*`
    func parse_path(&var self) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.error("expected a name")
        }
        self.see(Alt.Type_Path)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        while self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.Ident {
            self.advance()
            self.take_leaf()
        }
        self.close(mark, Alt.Type_Path, start)
        true
    }

    // `import-decl ::= 'import' import-target | "public" 'import' import-target`
    func parse_import(&var self, reexport: Bool) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if reexport {
            self.advance()
        }
        self.advance()
        let alt = if reexport { Alt.Decl_Import_Reexport } else { Alt.Decl_Import_Private }
        self.see(alt)
        if not self.parse_path() {
            return false
        }
        if self.kind() == TokenKind.As {
            self.see(Alt.Decl_ImportTarget_ModuleAlias)
            self.take_leaf()
            if self.kind() != TokenKind.Ident {
                return self.error("expected the module's alias")
            }
            self.take_leaf()
        } else if self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.Star {
            self.see(Alt.Decl_ImportTarget_Glob)
            self.take_leaf()
            self.take_leaf()
        } else if self.kind() == TokenKind.Dot && self.kind_at(1) == TokenKind.LBrace {
            self.see(Alt.Decl_ImportTarget_Selective)
            self.take_leaf()
            if not self.parse_import_symbols() {
                return false
            }
        } else if self.kind() == TokenKind.Dot {
            self.advance()
            return self.error("expected a name, `*` or `\{` after the `.`")
        } else {
            self.see(Alt.Decl_ImportTarget_Module)
        }
        self.close(mark, alt, start)
        true
    }

    // `"{" NEWLINE* import-symbol-list? "}"`, the braces as leaves, then the
    // check that each local name is bound once (syntax.rule.import-names).
    func parse_import_symbols(&var self) -> Bool {
        let first = self.builder.mark()
        let open = self.pos
        self.take_leaf()
        self.skip_newlines()
        var count = 0
        while self.kind() != TokenKind.RBrace {
            if self.kind() != TokenKind.Ident {
                if self.kind() == TokenKind.Eof {
                    return self.refuse_unclosed(open)
                }
                return self.error("expected a name to import")
            }
            if count == 0 {
                self.see(Alt.Decl_ImportSymbols)
            }
            if not self.parse_import_symbol() {
                return false
            }
            count = count + 1
            if self.kind() == TokenKind.Comma {
                self.advance()
                self.skip_newlines()
            } else if self.kind() != TokenKind.RBrace {
                return self.error("expected `,` or `\}` in the import list")
            }
        }
        self.take_leaf()
        self.check_import_names(first, count)
    }

    // `import-symbol ::= IDENT NEWLINE* | IDENT "as" IDENT NEWLINE*`
    func parse_import_symbol(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        var alt = Alt.Decl_ImportSymbol_Name
        if self.kind() == TokenKind.As {
            alt = Alt.Decl_ImportSymbol_Alias
            self.advance()
            if self.kind() != TokenKind.Ident {
                return self.error("expected the name's alias")
            }
            self.take_leaf()
        }
        self.see(alt)
        self.close(mark, alt, start)
        self.skip_newlines()
        true
    }

    // The symbols are the `count` nodes after the `{` leaf at scratch slot
    // `first`; the name each binds is its last leaf.
    func check_import_names(&var self, first: Int, count: Int) -> Bool {
        var i = 0
        while i < count {
            let a = self.symbol_binding(first + 1 + i)
            var j = 0
            while j < i {
                let b = self.symbol_binding(first + 1 + j)
                if self.builder.tree.source.spans_equal(a.start, a.end, b.start, b.end) {
                    let symbol = self.builder.node_at(first + 1 + i)
                    self.record(Diagnostic(rule: Rule.Rule_ImportNames, start: symbol.start,
                                           end: symbol.end,
                                           message: "this import binds a name the list already binds",
                                           hint: "import each name once, and give a second one its own alias"))
                    return false
                }
                j = j + 1
            }
            i = i + 1
        }
        true
    }

    // The leaf naming what the import symbol at scratch slot `slot` binds.
    func symbol_binding(&self, slot: Int) -> ParseToken {
        let symbol = self.builder.node_at(slot)
        let leaf = self.builder.last_child(&symbol)
        ParseToken(kind: TokenKind.Ident, start: leaf.start, end: leaf.end, line: 0, seg_start: 0,
                   seg_count: 0)
    }

    // `module-decl ::= "public"? 'module' IDENT` or the inline form, whose
    // braces follow on its line or the next (syntax.rule.module-inline).
    func parse_module(&var self, visible: Bool) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if visible {
            self.take_leaf()
        }
        self.advance()
        self.take_leaf()
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) != TokenKind.LBrace {
            self.see(Alt.Decl_Module_File)
            self.close(mark, Alt.Decl_Module_File, start)
            return true
        }
        self.see(Alt.Decl_Module_Inline)
        self.skip_newlines()
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.advance()
        self.skip_newlines()
        self.parse_items(true)
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.advance()
        self.leave_level()
        self.close(mark, Alt.Decl_Module_Inline, start)
        true
    }

    // The bracket at `open` is never closed (syntax.lex.unclosed-bracket),
    // reported at the opener.
    func refuse_unclosed(&var self, open: Int) -> Bool {
        self.report(Rule.Lex_UnclosedBracket, open, "this bracket is never closed", "")
        false
    }

    // ---- functions -------------------------------------------------------------

    // `func-decl ::= "func" IDENT generic-params? "(" param-list? ")" effect-slot return-clause? NEWLINE* block`
    func parse_func(&var self) -> Bool {
        self.see(Alt.Decl_Func)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the function's name")
        }
        self.take_leaf()
        if self.kind() == TokenKind.Lt {
            if not self.parse_generic_params() {
                return false
            }
        }
        if self.kind() != TokenKind.LParen {
            return self.error("expected `(` to open the parameters")
        }
        if not self.parse_params() {
            return false
        }
        if not self.parse_effects() {
            return false
        }
        if self.kind() == TokenKind.Arrow {
            self.see(Alt.Decl_Return)
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the function's body")
        }
        if not self.parse_block() {
            return false
        }
        self.close(mark, Alt.Decl_Func, start)
        true
    }

    // `"(" param-list? ")"`, with `param-list ::= param ( "," param )* ","?`
    func parse_params(&var self) -> Bool {
        let open = self.pos
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Decl_Params)
        }
        while self.kind() != TokenKind.RParen {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            if not self.parse_param() {
                return false
            }
            if self.kind() == TokenKind.Comma {
                self.advance()
            } else if self.kind() != TokenKind.RParen {
                return self.error("expected `,` or `)` after a parameter")
            }
        }
        self.advance()
        true
    }

    // `param ::= IDENT ":" type | IDENT ":" type "=" expr`
    func parse_param(&var self) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.error("expected a parameter name")
        }
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.kind() != TokenKind.Colon {
            return self.error("expected `:` and the parameter's type")
        }
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        var alt = Alt.Decl_Param_Plain
        if self.kind() == TokenKind.Assign {
            alt = Alt.Decl_Param_Default
            self.advance()
            if not self.parse_expr() {
                return false
            }
        }
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `effect-slot ::= 'consumes'? "unsafe"? constexpr-effect? 'sync'? borrows-effect? refused-escaping?`,
    // each word a leaf of the function. A free function takes no `consumes`,
    // which needs a `&var self` receiver (syntax.rule.effect-slot).
    func parse_effects(&var self) -> Bool {
        self.see(Alt.Decl_Effects)
        var consumes = -1
        if self.word_at(0, "consumes") {
            consumes = self.pos
            self.take_leaf()
        }
        if self.kind() == TokenKind.Unsafe_ {
            self.take_leaf()
        }
        if self.word_at(0, "sync") {
            self.take_leaf()
        }
        if consumes >= 0 {
            return self.refuse(Rule.Rule_EffectSlot, consumes,
                               "`consumes` ends a method's receiver, and a function has none",
                               "declare the function as a method whose receiver is `&var self`")
        }
        true
    }

    // ---- statements --------------------------------------------------------------

    // `block ::= "{" block-body "}"`
    func parse_block(&var self) -> Bool {
        self.see(Alt.Stmt_Block)
        self.see(Alt.Stmt_Body)
        let start = self.here()
        let mark = self.builder.mark()
        let open = self.pos
        let head = self.head
        self.head = false
        self.advance()
        self.skip_newlines()
        self.parse_statement_list()
        if self.kind() != TokenKind.RBrace {
            return self.refuse_unclosed(open)
        }
        self.advance()
        self.head = head
        self.close(mark, Alt.Stmt_Block, start)
        true
    }

    // `statement ( stmt-sep statement )* NEWLINE*`, up to a block's `}`.
    func parse_statement_list(&var self) {
        var list = ListState(any: false, need: false)
        while self.next_item(false, &var list) {
            let from = self.pos
            let point = self.resume_point()
            self.rejected_list = -1
            if not self.parse_statement(false) {
                self.resume(&point)
                self.recover(from)
            }
        }
    }

    // What an item or statement that fails leaves behind for the next one to
    // start clean from: the scratch it built and the state its constructs
    // set on the way in and never got to set back.
    func resume_point(&self) -> ResumePoint {
        ResumePoint(mark: self.builder.mark(), depth: self.depth, lists: self.lists,
                    head: self.head, spine: self.spine_count, literal_arm: self.literal_arm)
    }

    func resume(&var self, point: &ResumePoint) {
        self.builder.discard(point.mark)
        self.depth = point.depth
        self.lists = point.lists
        self.head = point.head
        self.spine_count = point.spine
        self.literal_arm = point.literal_arm
        self.primed = false
    }

    // A refusal unit's items, statements and top-level items alike, separated
    // as statements are, up to the end of input. A separate loop from a
    // block's, so that no block can reach a declaration.
    func parse_unit_items(&var self) {
        var list = ListState(any: false, need: false)
        while self.next_item(true, &var list) {
            let from = self.pos
            let point = self.resume_point()
            self.rejected_list = -1
            var ok = true
            if self.starts_item() {
                self.see(Alt.Test_RefusalUnitItem_Declaration)
                ok = self.parse_item()
            } else {
                self.see(Alt.Test_RefusalUnitItem_Statement)
                ok = self.parse_statement(false)
            }
            if not ok {
                self.resume(&point)
                self.recover(from)
            }
        }
    }

    // Takes the separators before a list's next item and returns whether one
    // starts here; false at the list's end, a block's `}` or, for a refusal
    // unit, the end of input. A `;` joins two statements on one line and never
    // ends one (syntax.rule.statement-separator), and two statements on one
    // line need one (syntax.rule.juxtaposition).
    func next_item(&var self, unit: Bool, list: &var ListState) -> Bool {
        while true {
            let kind = self.kind()
            if kind == TokenKind.Eof || (not unit && kind == TokenKind.RBrace) {
                if list.need {
                    let _ = self.error("a `;` joins two statements on one line; it does not end one")
                }
                return false
            }
            if list.need && kind == TokenKind.Newline {
                let _ = self.error("a `;` joins two statements on one line; it does not end one")
                list.need = false
            }
            if kind == TokenKind.Newline {
                self.skip_newlines()
                let closes = self.kind() == TokenKind.Eof || (not unit && self.kind() == TokenKind.RBrace)
                if list.any && not closes {
                    self.see(Alt.Stmt_Sep_Newline)
                }
                continue
            }
            if kind == TokenKind.Semicolon {
                let line_start = self.pos > 0 && self.tokens[self.pos - 1].kind == TokenKind.Newline
                if not list.any || list.need || line_start {
                    let _ = self.error("a `;` joins two statements on one line; it does not end one")
                }
                self.see(Alt.Stmt_Sep_Semicolon)
                self.advance()
                list.need = true
                continue
            }
            if list.any && not list.need && self.tokens[self.pos - 1].kind != TokenKind.Newline {
                let from_here = self.pos
                let _ = self.error("two statements on one line need a `;` between them")
                self.recover(from_here)
                continue
            }
            list.need = false
            list.any = true
            return true
        }
        false
    }

    // `statement ::= expr-stmt | non-expr-statement`, or, for an unbraced
    // match-arm body (`arm`), `arm-body`'s expression or statement, which
    // means what the same statement in braces means (syntax.rule.arm-body).
    func parse_statement(&var self, arm: Bool) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Let || kind == TokenKind.Var {
            if self.kind_at(1) == TokenKind.LParen {
                self.see_other(Alt.Stmt_NonExpr_Destructure, arm)
                return self.parse_destructure()
            }
            self.see_other(Alt.Stmt_NonExpr_Let, arm)
            return self.parse_let()
        }
        if kind == TokenKind.Return {
            self.see_other(Alt.Stmt_NonExpr_Return, arm)
            return self.parse_return(arm)
        }
        if kind == TokenKind.Break {
            self.see_other(Alt.Stmt_NonExpr_Break, arm)
            return self.parse_break(arm)
        }
        if kind == TokenKind.Continue {
            self.see_other(Alt.Stmt_NonExpr_Continue, arm)
            return self.token_node(Alt.Stmt_Continue, false)
        }
        if kind == TokenKind.Guard {
            self.see_other(Alt.Stmt_NonExpr_Guard, arm)
            return self.parse_guard()
        }
        if self.word_at(0, "static_assert") && self.kind_at(1) == TokenKind.LParen {
            self.see_other(Alt.Stmt_NonExpr_StaticAssert, arm)
            let word = self.pos
            if not self.parse_static_assert() {
                return false
            }
            if not ends_statement(self.kind(), arm) {
                // The word is read by its `(` alone, so the assertion is
                // never a call to go on from.
                return self.refuse(Rule.Rule_ContextualWords, word,
                                   "`static_assert` followed by `(` is an assertion, not a call",
                                   "end the statement after the assertion's `)`")
            }
            return true
        }
        if self.word_at(0, "const") && self.kind_at(1) == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Stmt_RefusedLocalConst, at,
                               "a local constant is a `let`", "write `let` for `const`")
        }
        if self.word_at(0, "type") && self.kind_at(1) == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Stmt_RefusedLocalTypeAlias, at,
                               "a type alias is declared at module level",
                               "declare the alias at module level, or as an associated type")
        }
        if kind == TokenKind.While || kind == TokenKind.For {
            return self.parse_loop_statement(arm)
        }
        let start = self.here()
        let mark = self.builder.mark()
        let from = self.taken_count
        let base = self.spine_count
        let first = self.pos
        if kind == TokenKind.Star {
            if not self.parse_prefix_operator(Alt.Expr_Prefix_Deref, Alt.Expr_Deref, 1, true) {
                return false
            }
        } else if self.starts_postfix() {
            if not self.parse_postfix(true) {
                return false
            }
        } else {
            self.see_expression(arm)
            if not self.parse_expr() {
                return false
            }
            return self.close_expression(mark, start, arm)
        }
        if is_assignment(self.kind()) {
            return self.parse_assignment(mark, start, from, base, first, arm)
        }
        // Not a target: the chain is the first operand of an expression.
        self.see_expression(arm)
        if kind == TokenKind.Star {
            self.release_spine(base)
        } else {
            self.see(Alt.Expr_Prefix_Postfix)
            self.release_spine(base)
        }
        self.primed = true
        if not self.parse_expr() {
            return false
        }
        self.close_expression(mark, start, arm)
    }

    // Records a non-expression statement's alternative, reached through
    // `statement` in a block and through `arm-body` in an arm.
    func see_other(&var self, alt: Alt, arm: Bool) {
        let form = if arm { Alt.Expr_ArmBody_Statement } else { Alt.Stmt_Statement_Other }
        self.see(form)
        self.see(alt)
    }

    // Records an expression statement's alternatives; in an arm body the
    // expression stands alone, with no statement node around it.
    func see_expression(&var self, arm: Bool) {
        if arm {
            self.see(Alt.Expr_ArmBody_Expr)
        } else {
            self.see(Alt.Stmt_Statement_Expr)
            self.see(Alt.Stmt_Expr)
        }
    }

    func close_expression(&var self, mark: Int, start: Int, arm: Bool) -> Bool {
        if not arm {
            self.close(mark, Alt.Stmt_Expr, start)
        }
        true
    }

    // Whether the current token begins a postfix expression: a primary, which
    // no prefix operator and no open range starts.
    func starts_postfix(&self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Try {
            return self.try_block_ahead()
        }
        if kind == TokenKind.Ident {
            let next = self.kind_at(1)
            return not (self.word_at(0, "lends") && (next == TokenKind.SelfKw || next == TokenKind.Ident))
        }
        if kind == TokenKind.Dot {
            return self.kind_at(1) == TokenKind.Ident
        }
        match kind {
            case IntLit -> true,
            case FloatLit -> true,
            case StringLit -> true,
            case InterpString -> true,
            case True_ -> true,
            case False_ -> true,
            case NoneKw -> true,
            case SelfKw -> true,
            case DollarParam -> true,
            case HashDirective -> true,
            case LParen -> true,
            case LBracket -> true,
            case If -> true,
            case Match -> true,
            case While -> true,
            case For -> true,
            case _ -> false
        }
    }

    // Whether the `try` here is followed, on its line or the next, by `{`:
    // a try block (syntax.rule.try-block).
    func try_block_ahead(&self) -> Bool {
        var ahead = 1
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.LBrace
    }

    // Records `alt`, or, on a statement's leading chain, keeps it until the
    // statement knows whether the chain is an assignment target.
    func see_spine(&var self, alt: Alt, spine: Bool) {
        if not spine {
            self.see(alt)
            return
        }
        // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.spine_alts, self.spine_count, alt)
        let at = self.spine_count
        put_at(&var self.spine_alts, at, alt)
        self.spine_count = at + 1
    }

    // Records the kept alternatives from `base` on, as an expression took them.
    func release_spine(&var self, base: Int) {
        var k = base
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        self.spine_count = base
    }

    // Takes back `alt` if it was first recorded after `since`: a name or
    // `self` that, as a whole target, derives through another production.
    func unsee_since(&var self, alt: Alt, since: Int) {
        var k = since
        while k < self.taken_count {
            if self.taken[k] == alt {
                self.seen[(alt as UInt16) as Int] = false
                while k + 1 < self.taken_count {
                    // Stage 0 workaround (SL:hazards S4): canonical: self.taken[k] = self.taken[k + 1]
                    let next = self.taken[k + 1]
                    self.taken[k] = next
                    k = k + 1
                }
                self.taken_count = self.taken_count - 1
                return
            }
            k = k + 1
        }
    }

    // The statement's leading chain, begun at `mark`, stands before an
    // assignment operator: it must have a place shape, which decides the
    // statement's production (syntax.rule.assignment-target). The chain's
    // kept alternatives from `base` on name its hops; the target records
    // them as the production it derives through, and the last as its
    // place, call or chain hop.
    func parse_assignment(&var self, mark: Int, start: Int, from: Int, base: Int,
                          head: Int, arm: Bool) -> Bool {
        let compound = self.kind() != TokenKind.Assign
        let deref = self.spine_count > base && self.spine_alts[base] == Alt.Expr_Prefix_Deref
        if deref {
            self.spine_count = base
            let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Deref,
                                           Alt.Stmt_CompoundTarget_Deref, arm)
            return self.finish_assignment(mark, start, compound, node)
        }
        let first = base + 1
        let hops = self.spine_count - first
        if hops == 0 {
            self.spine_count = base
            let lead = self.tokens[head].kind
            if lead == TokenKind.SelfKw {
                if compound {
                    return self.refuse(Rule.Stmt_RefusedCompoundSelf, head,
                                       "`self` is not a compound-assignment target",
                                       "replace the receiver whole: `self = …`")
                }
                self.unsee_since(Alt.Expr_Primary_Self, from)
                let node = self.see_assignment(false, Alt.Stmt_AssignTarget_Self,
                                               Alt.Stmt_AssignTarget_Self, arm)
                return self.finish_assignment(mark, start, false, node)
            }
            let target = self.builder.node_at(mark)
            if lead == TokenKind.Ident && target.count == 1 {
                self.unsee_since(Alt.Expr_Primary_Name, from)
                self.unsee_since(Alt.Expr_Name, from)
                self.see(Alt.Expr_NameRef)
                let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Name,
                                               Alt.Stmt_CompoundTarget_Name, arm)
                return self.finish_assignment(mark, start, compound, node)
            }
            return self.error("an assignment's target is a name, `self`, a field, an element or a pointee")
        }
        // An optional-chain run still open at the chain's end makes the
        // statement an optional assignment (syntax.rule.optional-chain-run).
        let optional = self.open_optional_hop(first)
        if optional >= 0 {
            self.see_chain_target(base, optional)
            let form = if compound { Alt.Stmt_OptionalAssign_Compound } else { Alt.Stmt_OptionalAssign_Plain }
            self.see_other(Alt.Stmt_NonExpr_OptionalAssign, arm)
            self.see(form)
            return self.finish_assignment(mark, start, compound, form)
        }
        let last = self.spine_alts[self.spine_count - 1]
        var k = first
        while k < self.spine_count - 1 {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        self.spine_count = base
        if last == Alt.Expr_Hop_Call {
            self.see(Alt.Stmt_CallTarget)
            let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Call,
                                           Alt.Stmt_CompoundTarget_Call, arm)
            return self.finish_assignment(mark, start, compound, node)
        }
        self.see(Alt.Stmt_ProjectionTarget)
        self.see(place_hop(last))
        let node = self.see_assignment(compound, Alt.Stmt_AssignTarget_Projection,
                                       Alt.Stmt_CompoundTarget_Projection, arm)
        self.finish_assignment(mark, start, compound, node)
    }

    // Records an assignment's production, plain or compound, and its target's form.
    // Returns the alternative whose node the statement builds.
    func see_assignment(&var self, compound: Bool, plain_target: Alt, compound_target: Alt,
                        arm: Bool) -> Alt {
        if compound {
            self.see_other(Alt.Stmt_NonExpr_CompoundAssign, arm)
            self.see(Alt.Stmt_CompoundAssign)
            self.see(compound_target)
            return Alt.Stmt_CompoundAssign
        }
        self.see_other(Alt.Stmt_NonExpr_Assign, arm)
        self.see(Alt.Stmt_Assign)
        self.see(plain_target)
        Alt.Stmt_Assign
    }

    // The operator and right side of an assignment whose target is parsed,
    // closed into its node. The right side starts on the line of the operator.
    // A compound operator prints; `=` is implied by the node's Kind.
    func finish_assignment(&var self, mark: Int, start: Int, compound: Bool, node: Alt) -> Bool {
        if compound {
            // Stage 0 workaround (SL:hazards S4): canonical: self.see(compound_op(self.kind()))
            let op = compound_op(self.kind())
            self.see(op)
            self.take_leaf()
        } else {
            self.advance()
        }
        if not self.parse_expr() {
            return false
        }
        self.close(mark, node, start)
        true
    }

    // `break-stmt ::= "break" expr?`: an operand when the next token can
    // begin one; in an arm body `,` and `case` end the statement too
    // (syntax.rule.arm-statement-end).
    func parse_break(&var self, arm: Bool) -> Bool {
        self.see(Alt.Stmt_Break)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not ends_statement(self.kind(), arm) {
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, Alt.Stmt_Break, start)
        true
    }

    // `static-assert ::= 'static_assert' "(" expr "," STRING ")"`. Recognized
    // by the word and its `(`, so without its message it is refused as that
    // reading (syntax.rule.contextual-words).
    func parse_static_assert(&var self) -> Bool {
        self.see(Alt.Decl_StaticAssert)
        let start = self.here()
        let mark = self.builder.mark()
        let word = self.pos
        self.advance()
        let open = self.pos
        self.advance()
        if not self.parse_expr() {
            return false
        }
        if self.kind() != TokenKind.Comma || self.kind_at(1) != TokenKind.StringLit {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            return self.refuse(Rule.Rule_ContextualWords, word,
                               "`static_assert` takes a condition and a message",
                               "write `static_assert(condition, \"message\")`")
        }
        self.advance()
        self.take_leaf()
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the assertion's message")
        }
        self.advance()
        self.close(mark, Alt.Decl_StaticAssert, start)
        true
    }

    // A `while` or `for` loop that starts a statement: a statement, never an
    // operand, so a token after it that would continue an expression is
    // refused (syntax.rule.block-tail).
    func parse_loop_statement(&var self, arm: Bool) -> Bool {
        self.see_expression(arm)
        self.see_operand_tiers()
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_primary() {
            return false
        }
        if continues_operand(self.kind()) {
            let at = self.pos
            return self.refuse(Rule.Rule_BlockTail, at,
                               "a loop that starts a statement is a statement, not an operand",
                               "parenthesize the loop to use its value")
        }
        self.close_expression(mark, start, arm)
    }

    // The alternatives an operand reached through `expr` down to a primary
    // takes, when it has no operator of any tier.
    func see_operand_tiers(&var self) {
        self.see(Alt.Expr_Expr)
        self.see(Alt.Expr_Coalesce)
        self.see(Alt.Expr_Or)
        self.see(Alt.Expr_And)
        self.see(Alt.Expr_Bitor)
        self.see(Alt.Expr_Bitxor)
        self.see(Alt.Expr_Bitand)
        self.see(Alt.Expr_Compare_Pair)
        self.see(Alt.Expr_Range_Closed)
        self.see(Alt.Expr_Shift)
        self.see(Alt.Expr_Additive)
        self.see(Alt.Expr_Multiplicative)
        self.see(Alt.Expr_Cast)
        self.see(Alt.Expr_Prefix_Postfix)
        self.see(Alt.Expr_Postfix)
    }

    // `let-stmt ::= ("let" | "var") binding-name type-annotation? "=" expr`,
    // where `var _` is the refused discard (syntax.rule.discard-binding) and a
    // binding with no initializer is refused (syntax.stmt.refused-uninitialized).
    func parse_let(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        let keyword = self.pos
        let mutable = self.kind() == TokenKind.Var
        self.advance()
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        if mutable && self.word_at(0, "_") {
            return self.refuse(Rule.Stmt_RefusedVarDiscard, keyword,
                               "`_` binds nothing, so there is nothing to mutate",
                               "write `let _ = e`")
        }
        let alt = if mutable { Alt.Stmt_Let_Mutable } else { Alt.Stmt_Let_Immutable }
        self.see(alt)
        self.see(Alt.Stmt_BindingName)
        let name_start = self.here()
        let name_mark = self.builder.mark()
        self.take_leaf()
        self.close(name_mark, Alt.Stmt_BindingName, name_start)
        var annotated = false
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Stmt_TypeAnnotation)
            annotated = true
            self.advance()
            if not self.parse_type(false) {
                return false
            }
        }
        if self.kind() != TokenKind.Assign {
            if annotated && ends_statement(self.kind(), false) {
                return self.refuse(Rule.Stmt_RefusedUninitialized, keyword,
                                   "every binding is initialized where it is declared",
                                   "write `= value` after the type")
            }
            return self.error("expected `=` and the binding's value")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `destructure-stmt ::= ("let" | "var") tuple-pattern "=" expr`, which
    // takes no type annotation.
    func parse_destructure(&var self) -> Bool {
        let alt = if self.kind() == TokenKind.Var { Alt.Stmt_Destructure_Mutable } else { Alt.Stmt_Destructure_Immutable }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_tuple_pattern() {
            return false
        }
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the value to destructure")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `return-stmt ::= "return" expr?`: an operand when the next token can
    // begin one.
    func parse_return(&var self, arm: Bool) -> Bool {
        self.see(Alt.Stmt_Return)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not ends_statement(self.kind(), arm) {
            if not self.parse_expr() {
                return false
            }
        }
        self.close(mark, Alt.Stmt_Return, start)
        true
    }

    // ---- control flow --------------------------------------------------------------

    // `head-expr ::= expr`, parsed where a `{` at its outer level begins the
    // construct's body (syntax.rule.head-restriction).
    func parse_head_expr(&var self) -> Bool {
        self.see(Alt.Expr_Head)
        let head = self.head
        self.head = true
        if not self.parse_expr() {
            return false
        }
        self.head = head
        true
    }

    // A construct's body, `NEWLINE* block`: its `{` may start the line after
    // its head (syntax.rule.continuation-keywords).
    func parse_body(&var self) -> Bool {
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the body")
        }
        self.parse_block()
    }

    // Whether `else`, on this line or a later one, goes on the construct
    // just closed; the line breaks before it are then the construct's.
    func else_ahead(&self) -> Bool {
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.Else
    }

    // `if-expr ::= "if" if-head NEWLINE* block else-if-arm* else-arm?`, one
    // node with its arms in order (syntax.rule.flat-else-if), charging one
    // level for the whole chain.
    func parse_if(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_If)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_if_head() {
            return false
        }
        if not self.parse_body() {
            return false
        }
        while self.else_ahead() {
            self.skip_newlines()
            if self.if_after_else() {
                self.see(Alt.Expr_ElseIf)
                let arm_start = self.here()
                let arm_mark = self.builder.mark()
                self.advance()
                self.skip_newlines()
                self.advance()
                if not self.parse_if_head() {
                    return false
                }
                if not self.parse_body() {
                    return false
                }
                self.close(arm_mark, Alt.Expr_ElseIf, arm_start)
            } else {
                self.see(Alt.Expr_Else)
                self.take_leaf()
                if not self.parse_body() {
                    return false
                }
                break
            }
        }
        self.close(mark, Alt.Expr_If, start)
        self.leave_level()
        true
    }

    // Whether the `else` here is followed, past line breaks, by `if`.
    func if_after_else(&self) -> Bool {
        var ahead = 1
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        self.kind_at(ahead) == TokenKind.If
    }

    // `if-head ::= head-expr | optional-binding | borrow-unwrap`
    func parse_if_head(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Let || kind == TokenKind.Var {
            self.see(Alt.Expr_IfHead_Binding)
            return self.parse_optional_binding()
        }
        if kind == TokenKind.Borrow {
            return self.error("a borrow in an `if` head is not parsed yet")
        }
        self.see(Alt.Expr_IfHead_Condition)
        self.parse_head_expr()
    }

    // `optional-binding ::= ("let" | "var") binding-target "=" binding-subject`
    func parse_optional_binding(&var self) -> Bool {
        let alt = if self.kind() == TokenKind.Var { Alt.Expr_OptionalBinding_Var } else { Alt.Expr_OptionalBinding_Let }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_binding_target() {
            return false
        }
        if self.kind() != TokenKind.Assign {
            return self.error("expected `=` and the optional to bind")
        }
        self.advance()
        if not self.parse_binding_subject() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `binding-target ::= binding-name | tuple-pattern`
    func parse_binding_target(&var self) -> Bool {
        if self.kind() == TokenKind.LParen {
            self.see(Alt.Stmt_BindingTarget_Tuple)
            return self.parse_tuple_pattern()
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        self.see(Alt.Stmt_BindingTarget_Name)
        self.binding_name()
    }

    // `binding-name ::= IDENT`
    func binding_name(&var self) -> Bool {
        if self.kind() != TokenKind.Ident {
            return self.error("expected the binding's name")
        }
        self.see(Alt.Stmt_BindingName)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.close(mark, Alt.Stmt_BindingName, start)
        true
    }

    // `binding-subject ::= head-expr | optional-chain-target "=" expr`: a
    // chain whose optional run is open at its end, then `=`, writes through
    // the chain and tests whether it did; anything else is the value tested.
    func parse_binding_subject(&var self) -> Bool {
        if not self.starts_postfix() {
            self.see(Alt.Stmt_BindingSubject_Value)
            return self.parse_head_expr()
        }
        let head = self.head
        self.head = true
        let base = self.spine_count
        if not self.parse_postfix(true) {
            return false
        }
        let optional = self.open_optional_hop(base + 1)
        if self.kind() == TokenKind.Assign && optional >= 0 {
            self.see(Alt.Stmt_BindingSubject_ChainAssign)
            self.see_chain_target(base, optional)
            self.take_leaf()
            if not self.parse_expr() {
                return false
            }
            self.head = head
            return true
        }
        self.see(Alt.Stmt_BindingSubject_Value)
        self.see(Alt.Expr_Head)
        self.see(Alt.Expr_Prefix_Postfix)
        self.release_spine(base)
        self.primed = true
        if not self.parse_expr() {
            return false
        }
        self.head = head
        true
    }

    // The kept hop of a chain, from `first` on, that is its optional-chain
    // target's optional hop: the first `?.` after the last hop that closes a
    // run, or -1 when no run is open at the chain's end
    // (syntax.rule.optional-chain-run).
    func open_optional_hop(&self, first: Int) -> Int {
        var optional = -1
        var k = first
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            if alt == Alt.Expr_Hop_Subscript || alt == Alt.Expr_Hop_Force || alt == Alt.Expr_Hop_TupleIndex {
                optional = -1
            } else if alt == Alt.Expr_Hop_Optional && optional < 0 {
                optional = k
            }
            k = k + 1
        }
        optional
    }

    // Records the kept chain from `base` as an optional-chain target whose
    // optional hop is the one at `optional`: hops before it as postfix hops,
    // hops after it as chain hops.
    func see_chain_target(&var self, base: Int, optional: Int) {
        var k = base + 1
        while k < optional {
            let alt = self.spine_alts[k]
            self.see(alt)
            k = k + 1
        }
        k = optional + 1
        while k < self.spine_count {
            let alt = self.spine_alts[k]
            self.see(chain_hop(alt))
            k = k + 1
        }
        self.spine_count = base
        self.see(Alt.Stmt_OptionalChainTarget)
    }

    // `guard-stmt`: `guard let` or `guard var` and a binding, or a boolean
    // `guard` condition, then `else` and a block, one level held to the end
    // of the block.
    func parse_guard(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Stmt_Guard_Condition
        if self.kind_at(1) == TokenKind.Let || self.kind_at(1) == TokenKind.Var {
            alt = if self.kind_at(1) == TokenKind.Var { Alt.Stmt_Guard_Var } else { Alt.Stmt_Guard_Let }
            self.see(alt)
            self.advance()
            self.advance()
            if not self.parse_binding_target() {
                return false
            }
            if self.kind() != TokenKind.Assign {
                return self.error("expected `=` and the optional to bind")
            }
            self.advance()
            if not self.parse_binding_subject() {
                return false
            }
        } else {
            self.see(alt)
            self.see(Alt.Stmt_GuardCondition)
            self.take_leaf()
            if not self.parse_head_expr() {
                return false
            }
        }
        self.skip_newlines()
        if self.kind() != TokenKind.Else {
            return self.error("expected `else` and a block that leaves the scope")
        }
        if alt == Alt.Stmt_Guard_Condition {
            self.take_leaf()
        } else {
            self.advance()
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `while-expr` and `while-let-expr`: a conditional loop, one with no
    // condition, or one that binds while its subject is present, which takes
    // no `else` (syntax.expr.refused-while-let-else). One level held to the
    // end of the body.
    func parse_while(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        let next = self.kind_at(1)
        var alt = Alt.Expr_While_Conditional
        if next == TokenKind.LBrace {
            alt = Alt.Expr_While_Infinite
            self.see(alt)
            self.advance()
        } else if next == TokenKind.Let || next == TokenKind.Var {
            alt = if next == TokenKind.Var { Alt.Expr_WhileLet_Var } else { Alt.Expr_WhileLet_Let }
            self.see(alt)
            self.advance()
            self.advance()
            if not self.parse_binding_target() {
                return false
            }
            if self.kind() != TokenKind.Assign {
                return self.error("expected `=` and the optional to bind")
            }
            self.advance()
            if not self.parse_head_expr() {
                return false
            }
        } else {
            self.see(alt)
            self.advance()
            if not self.parse_head_expr() {
                return false
            }
        }
        if not self.parse_body() {
            return false
        }
        let binds = alt == Alt.Expr_WhileLet_Let || alt == Alt.Expr_WhileLet_Var
        if binds && self.else_ahead() {
            self.skip_newlines()
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedWhileLetElse, at,
                               "a `while let` loop takes no `else`: it ends when the binding fails",
                               "write `if let … else` for a single test")
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `for-expr ::= "for" binding-name "in" head-expr NEWLINE* block`, one
    // level held to the end of the body. A `for` head binds one name, so a
    // tuple pattern there is refused once it has parsed
    // (syntax.expr.refused-for-tuple).
    func parse_for(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.LParen {
            let at = self.pos
            if not self.parse_tuple_pattern() {
                return false
            }
            return self.refuse(Rule.Expr_RefusedForTuple, at,
                               "a `for` head binds one name",
                               "bind the element and destructure it in the body: `for p in v \{ let (a, b) = p \}`")
        }
        if self.kind() == TokenKind.Borrow {
            return self.error("a borrowing `for` is not parsed yet")
        }
        self.see(Alt.Expr_For_Plain)
        if not self.binding_name() {
            return false
        }
        if self.kind() != TokenKind.In {
            return self.error("expected `in` and what to iterate")
        }
        self.advance()
        if not self.parse_head_expr() {
            return false
        }
        if not self.parse_body() {
            return false
        }
        self.close(mark, Alt.Expr_For_Plain, start)
        self.leave_level()
        true
    }

    // `match-expr ::= "match" head-expr NEWLINE* "{" NEWLINE* match-arm-list? "}"`,
    // one level held to its `}`. Arms are separated by a comma, a line break
    // or nothing.
    func parse_match(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_Match)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_head_expr() {
            return false
        }
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the match arms")
        }
        let brace = self.pos
        let head = self.head
        self.head = false
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.RBrace {
            self.see(Alt.Expr_MatchArms)
        }
        while self.kind() != TokenKind.RBrace {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(brace)
            }
            if self.kind() != TokenKind.Case {
                return self.error("expected `case` to begin an arm")
            }
            if not self.parse_match_arm() {
                return false
            }
            if not self.arm_separator() {
                return false
            }
        }
        self.advance()
        self.head = head
        self.close(mark, Alt.Expr_Match, start)
        self.leave_level()
        true
    }

    // `arm-sep ::= NEWLINE* "," NEWLINE* | NEWLINE+ | ε`, after an arm; the
    // last arm's separator, if any, stands before the `}`.
    func arm_separator(&var self) -> Bool {
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) == TokenKind.Comma {
            self.see(Alt.Expr_ArmSep_Comma)
            self.skip_newlines()
            self.advance()
            self.skip_newlines()
            return true
        }
        if ahead > 0 {
            self.see(Alt.Expr_ArmSep_Newline)
            self.skip_newlines()
            return true
        }
        if self.kind() == TokenKind.Case {
            self.see(Alt.Expr_ArmSep_None)
            return true
        }
        if self.kind() == TokenKind.RBrace || self.kind() == TokenKind.Eof {
            return true
        }
        self.error("expected `,`, a line break or `case` after the arm")
    }

    // `match-arm ::= "case" pattern arm-guard? "->" arm-body`, with
    // `arm-guard ::= "if" head-expr`, whose `if` prints.
    func parse_match_arm(&var self) -> Bool {
        self.see(Alt.Expr_MatchArm)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_pattern() {
            return false
        }
        if self.kind() == TokenKind.If {
            self.see(Alt.Expr_ArmGuard)
            self.take_leaf()
            if not self.parse_head_expr() {
                return false
            }
        }
        if self.kind() != TokenKind.Arrow {
            return self.error("expected `->` and the arm's body")
        }
        self.advance()
        if not self.parse_arm_body() {
            return false
        }
        self.close(mark, Alt.Expr_MatchArm, start)
        true
    }

    // `arm-body ::= block | expr | non-expr-statement`: a body that starts
    // with `{` is a block, and the statement parser decides the rest
    // (syntax.rule.arm-body). A block that reads as a map or set literal
    // names that rule when it fails.
    func parse_arm_body(&var self) -> Bool {
        if self.kind() != TokenKind.LBrace {
            return self.parse_statement(true)
        }
        self.see(Alt.Expr_ArmBody_Block)
        let saved = self.literal_arm
        if self.brace_reads_as_literal() {
            self.literal_arm = self.pos
        }
        if not self.parse_block() {
            return false
        }
        self.literal_arm = saved
        true
    }

    // Whether the brace here would read as a map or set literal where no
    // block is required: `{:}`, or a `:` or `,` at its own level
    // (syntax.rule.brace).
    func brace_reads_as_literal(&self) -> Bool {
        var k = 1
        var nested = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof {
                return false
            }
            if opens_bracket(kind) {
                nested = nested + 1
            } else if closes_bracket(kind) {
                if nested == 0 {
                    return false
                }
                nested = nested - 1
            } else if nested == 0 && (kind == TokenKind.Colon || kind == TokenKind.Comma) {
                return true
            }
            k = k + 1
        }
        false
    }

    // `pattern`. A name followed by `(` is a variant pattern, `_` the
    // wildcard, and any other lone name a name pattern, whether it binds or
    // names a payload-free variant being resolution's to decide
    // (syntax.rule.name-pattern). A name followed by `.`, and a leading `.`,
    // are the refused qualified and dotted variant patterns.
    func parse_pattern(&var self) -> Bool {
        let kind = self.kind()
        let next = self.kind_at(1)
        if kind == TokenKind.Ident {
            if next == TokenKind.Dot {
                let at = self.pos
                return self.refuse(Rule.Pat_RefusedQualifiedVariant, at,
                                   "a variant pattern names the case alone",
                                   "write the case bare, as in `case Red`; the scrutinee's type supplies the enum")
            }
            if next == TokenKind.LParen {
                self.see(Alt.Pat_Pattern_Variant)
                return self.parse_variant_pattern()
            }
            if self.word_at(0, "_") {
                self.see(Alt.Pat_Pattern_Wildcard)
                return self.token_node(Alt.Pat_Wildcard, false)
            }
            self.see(Alt.Pat_Pattern_Name)
            return self.token_node(Alt.Pat_Name, true)
        }
        if kind == TokenKind.Dot && next == TokenKind.Ident {
            let at = self.pos
            return self.refuse(Rule.Pat_RefusedDotVariant, at,
                               "a variant pattern names the case bare",
                               "drop the `.`, as in `case North`")
        }
        if kind == TokenKind.NoneKw {
            self.see(Alt.Pat_Pattern_None)
            return self.token_node(Alt.Pat_None, false)
        }
        if kind == TokenKind.LParen {
            self.see(Alt.Pat_Pattern_Tuple)
            return self.parse_tuple_pattern()
        }
        if kind == TokenKind.IntLit || (kind == TokenKind.Minus && next == TokenKind.IntLit) {
            let after = if kind == TokenKind.Minus { self.kind_at(2) } else { next }
            if after == TokenKind.DotDot || after == TokenKind.DotDotEq {
                self.see(Alt.Pat_Pattern_Range)
                return self.parse_range_pattern()
            }
            self.see(Alt.Pat_Pattern_Literal)
            if kind == TokenKind.IntLit {
                return self.token_node(Alt.Pat_Literal_Int, true)
            }
            self.see(Alt.Pat_Literal_NegativeInt)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            self.take_leaf()
            self.close(mark, Alt.Pat_Literal_NegativeInt, start)
            return true
        }
        if kind == TokenKind.StringLit {
            self.see(Alt.Pat_Pattern_Literal)
            return self.token_node(Alt.Pat_Literal_String, true)
        }
        if kind == TokenKind.True_ || kind == TokenKind.False_ {
            self.see(Alt.Pat_Pattern_Literal)
            let alt = if kind == TokenKind.True_ { Alt.Pat_Literal_True } else { Alt.Pat_Literal_False }
            return self.token_node(alt, false)
        }
        self.error("expected a pattern")
    }

    // `range-pattern ::= pattern-int (".." | "..=") pattern-int`, whose ends
    // are integers only; a `-` before either prints, since `pattern-int`
    // builds no node to imply it.
    func parse_range_pattern(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if not self.pattern_int() {
            return false
        }
        let alt = if self.kind() == TokenKind.DotDotEq { Alt.Pat_Range_Inclusive } else { Alt.Pat_Range_Exclusive }
        self.see(alt)
        self.advance()
        if not self.pattern_int() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `pattern-int ::= INT | "-" INT`, as leaves of the range around it.
    func pattern_int(&var self) -> Bool {
        if self.kind() == TokenKind.Minus && self.kind_at(1) == TokenKind.IntLit {
            self.see(Alt.Pat_Int_Negative)
            self.take_leaf()
            self.take_leaf()
            return true
        }
        if self.kind() != TokenKind.IntLit {
            return self.error("a range pattern's ends are integer literals")
        }
        self.see(Alt.Pat_Int_Positive)
        self.take_leaf()
        true
    }

    // `tuple-pattern ::= "(" ( pattern ( "," pattern )* )? ")"`, one level
    // held for its `(`. A name and `:` first make it the refused named tuple
    // pattern (syntax.pat.refused-named-tuple).
    func parse_tuple_pattern(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_tuple_pattern_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_tuple_pattern_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            return self.refuse(Rule.Pat_RefusedNamedTuple, open,
                               "patterns destructure tuples by position only",
                               "drop the labels, as in `(a, b)`")
        }
        if self.kind() != TokenKind.RParen {
            if not self.parse_pattern() {
                return false
            }
            // The one place a lone element is decided: `(p)` is a tuple
            // pattern of one element, never a parenthesized pattern, and so
            // no `,` may follow a last element, `(p,)` included, as GRAMMAR.md
            // section 8 is written. Pinned by the one-element cases of
            // golden/patterns.saw and negative/patterns.saw (SL:open-questions W2).
            while self.kind() == TokenKind.Comma {
                self.advance()
                if not self.parse_pattern() {
                    return false
                }
            }
            if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `,` or `)` in the tuple pattern")
            }
        }
        self.advance()
        self.see(Alt.Pat_Tuple_Positional)
        self.close(mark, Alt.Pat_Tuple_Positional, start)
        true
    }

    // `variant-pattern ::= IDENT "(" ( payload-pattern ( "," payload-pattern )* )? ")"`,
    // one level held for the payload's `(`.
    func parse_variant_pattern(&var self) -> Bool {
        let open = self.pos + 1
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_variant_pattern_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_variant_pattern_body(&var self, open: Int) -> Bool {
        self.see(Alt.Pat_Variant)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        if self.kind() != TokenKind.RParen {
            if not self.payload_pattern() {
                return false
            }
            while self.kind() == TokenKind.Comma {
                self.advance()
                if not self.payload_pattern() {
                    return false
                }
            }
            if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `,` or `)` in the payload pattern")
            }
        }
        self.advance()
        self.close(mark, Alt.Pat_Variant, start)
        true
    }

    // `payload-pattern ::= pattern | borrow-binding-pattern`; a borrow
    // binding is not parsed yet.
    func payload_pattern(&var self) -> Bool {
        if self.kind() == TokenKind.Borrow {
            return self.error("a borrow binding in a payload is not parsed yet")
        }
        self.see(Alt.Pat_Payload_Pattern)
        self.parse_pattern()
    }

    // ---- types -------------------------------------------------------------------

    // `type ::= ref-type | func-type | type-atom type-suffix*`. A reference and
    // a function type are not atoms, so a `?` after `&` or `->` belongs to the
    // type after it (syntax.rule.prefix-type-suffix). In a type `<` opens a
    // generic list, but where the type ends a cast target (`cast`) the list
    // after its last named type is speculative (syntax.rule.generic-or-less).
    func parse_type(&var self, cast: Bool) -> Bool {
        if self.kind() == TokenKind.Ampersand && not self.slice_ahead() {
            self.see(Alt.Type_Type_Ref)
            return self.parse_ref_type(cast)
        }
        if self.kind() == TokenKind.LParen && self.func_type_ahead() {
            self.see(Alt.Type_Type_Func)
            return self.parse_func_type(cast)
        }
        self.see(Alt.Type_Type_Suffixed)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_type_atom(cast) {
            return false
        }
        while self.kind() == TokenKind.Question || self.kind() == TokenKind.DoubleQuestion {
            // At the end of a cast target a `?` is the type's only when what
            // follows it may follow the cast; otherwise it is the cast's, and
            // a `??` there is refused (syntax.rule.cast-target-question).
            if cast && not follows_cast_list(self.kind_at(1)) {
                break
            }
            let double = self.kind() == TokenKind.DoubleQuestion
            let alt = if double { Alt.Type_Suffix_DoubleOptional } else { Alt.Type_Suffix_Optional }
            self.see(alt)
            self.advance()
            self.close(mark, alt, start)
            if double {
                self.close(mark, alt, start)
            }
        }
        true
    }

    // `type-atom`: a named type, a slice, an array, a tuple or a grouped
    // type, or `any` and a path.
    func parse_type_atom(&var self, cast: Bool) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.Ident && self.word_at(0, "any") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.Type_Atom_Any)
            self.see(Alt.Type_Any)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            if not self.parse_path() {
                return false
            }
            self.close(mark, Alt.Type_Any, start)
            return true
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Type_Atom_Named)
            return self.parse_named_type(cast)
        }
        if kind == TokenKind.Ampersand {
            self.see(Alt.Type_Atom_Slice)
            return self.parse_slice_type()
        }
        if kind == TokenKind.LBracket {
            self.see(Alt.Type_Atom_Array)
            return self.parse_array_type()
        }
        if kind == TokenKind.LParen {
            return self.parse_paren_type()
        }
        self.error("expected a type")
    }

    // `named-type ::= path generic-args?`
    func parse_named_type(&var self, cast: Bool) -> Bool {
        self.see(Alt.Type_Named)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_path() {
            return false
        }
        if self.kind() == TokenKind.Lt {
            if cast {
                if self.speculate_list(true) == ListOutcome.Refused {
                    return false
                }
            } else if not self.parse_generic_args() {
                return false
            }
        }
        self.close(mark, Alt.Type_Named, start)
        true
    }

    // Whether the `&` here opens a slice, `&[T]` or `&var [T]`, which is an
    // atom, rather than a reference: to an array, `&[T; N]`, when a `;`
    // stands at its bracket's own level.
    func slice_ahead(&self) -> Bool {
        var k = 1
        if self.kind_at(k) == TokenKind.Var {
            k = 2
        }
        if self.kind_at(k) != TokenKind.LBracket {
            return false
        }
        var open = 0
        while true {
            let kind = self.kind_at(k)
            if kind == TokenKind.Eof || kind == TokenKind.LBrace || kind == TokenKind.RBrace {
                return true
            }
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                open = open + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                open = open - 1
                if open == 0 {
                    return true
                }
            } else if kind == TokenKind.Semicolon && open == 1 {
                return false
            }
            k = k + 1
        }
        true
    }

    // `ref-type ::= "&" type | "&" "var" type`, charging one level held to
    // the end of the type it refers to.
    func parse_ref_type(&var self, cast: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let alt = if self.kind_at(1) == TokenKind.Var { Alt.Type_Ref_Exclusive } else { Alt.Type_Ref_Shared }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if alt == Alt.Type_Ref_Exclusive {
            self.advance()
        }
        if not self.parse_type(cast) {
            return false
        }
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `slice-type ::= "&" "[" type "]" | "&" "var" "[" type "]"`, one level.
    func parse_slice_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let alt = if self.kind_at(1) == TokenKind.Var { Alt.Type_Slice_Exclusive } else { Alt.Type_Slice_Shared }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if alt == Alt.Type_Slice_Exclusive {
            self.advance()
        }
        let bracket = self.pos
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        if self.kind() != TokenKind.RBracket {
            return self.list_error(bracket, "expected `]` after the slice's element type")
        }
        self.advance()
        self.close(mark, alt, start)
        self.leave_level()
        true
    }

    // `array-type ::= "[" type ";" expr "]"`, one level for the `[`. A length
    // is closed by `]`, so it takes the full expression grammar.
    func parse_array_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Type_Array)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        if self.kind() != TokenKind.Semicolon {
            return self.list_error(open, "expected `;` and the array's length")
        }
        self.advance()
        if not self.parse_expr() {
            return false
        }
        if self.kind() != TokenKind.RBracket {
            return self.list_error(open, "expected `]` after the array's length")
        }
        self.advance()
        self.close(mark, Alt.Type_Array, start)
        self.leave_level()
        true
    }

    // Whether the `(` here opens a function type: its `)` is followed by an
    // effect word or `->` (syntax.rule.paren-type). `consumes` counts, so that
    // a function type that writes it is refused as one.
    func func_type_ahead(&self) -> Bool {
        var k = self.pos
        var open = 0
        while k < self.limit {
            let kind = self.tokens[k].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                open = open + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                open = open - 1
                if open == 0 {
                    break
                }
            } else if kind == TokenKind.Eof || kind == TokenKind.LBrace || kind == TokenKind.RBrace {
                return false
            }
            k = k + 1
        }
        let after = k + 1 - self.pos
        let next = self.kind_at(after)
        if next == TokenKind.Arrow || next == TokenKind.Unsafe_ || next == TokenKind.Borrows {
            return true
        }
        self.word_at(after, "sync") || self.word_at(after, "escaping") || self.word_at(after, "consumes")
    }

    // `func-type ::= "(" func-type-params? ")" func-type-effects "->" type`,
    // one level for the parameter list, held to the end of the return type.
    // The effects print, in their one order (syntax.rule.effect-slot).
    func parse_func_type(&var self, cast: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Type_Func)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Type_FuncParams)
        }
        while self.kind() != TokenKind.RParen {
            if not self.parse_type(false) {
                return false
            }
            if self.kind() == TokenKind.Comma {
                self.advance()
            } else if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `,` or `)` after a parameter type")
            }
        }
        self.advance()
        self.see(Alt.Type_FuncEffects)
        if self.kind() == TokenKind.Unsafe_ {
            self.take_leaf()
        }
        if self.word_at(0, "sync") {
            self.take_leaf()
        }
        if self.word_at(0, "escaping") {
            self.take_leaf()
        }
        if self.kind() == TokenKind.Borrows {
            self.take_leaf()
            if self.kind() == TokenKind.LParen && self.word_at(1, "sync") && self.kind_at(2) == TokenKind.RParen {
                self.see(Alt.Type_FuncBorrows_Sync)
                self.advance()
                self.take_leaf()
                self.advance()
            } else {
                self.see(Alt.Type_FuncBorrows_Plain)
            }
        }
        if self.word_at(0, "consumes") {
            let at = self.pos
            return self.refuse(Rule.Type_RefusedFuncConsumes, at,
                               "`consumes` ends a method's receiver, and a function type has none",
                               "call the method")
        }
        if self.kind() != TokenKind.Arrow {
            return self.error("expected `->` and the function type's return type")
        }
        self.advance()
        if not self.parse_type(cast) {
            return false
        }
        self.close(mark, Alt.Type_Func, start)
        self.leave_level()
        true
    }

    // A `(` that opens no function type: `()`, a tuple type, a one-element
    // tuple `(T,)`, or grouping parentheses, which build no node
    // (syntax.rule.paren-type). A tuple labels every element or none
    // (syntax.rule.label-or-tuple); a mix is refused once it has parsed.
    // Each charges one level for its `(`.
    func parse_paren_type(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_paren_type_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    func parse_paren_type_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.RParen {
            self.advance()
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Unit)
            self.close(mark, Alt.Type_Tuple_Unit, start)
            return true
        }
        let named = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
        var elements = 0
        var mixed = -1
        var trailing = false
        while true {
            if elements > 0 {
                if self.kind() == TokenKind.Comma {
                    self.advance()
                    if self.kind() == TokenKind.RParen {
                        trailing = true
                        break
                    }
                } else if self.kind() == TokenKind.RParen {
                    break
                } else {
                    return self.list_error(open, "expected `,` or `)` in the tuple type")
                }
            }
            let labelled = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
            if labelled != named && mixed < 0 {
                mixed = self.pos
            }
            if labelled {
                if not self.parse_tuple_type_field() {
                    return false
                }
            } else if not self.parse_type(false) {
                return false
            }
            elements = elements + 1
        }
        self.advance()
        if mixed >= 0 {
            return self.refuse(Rule.Type_RefusedPartialNamedTuple, mixed,
                               "a named tuple type labels every element or none",
                               "label every element, or none")
        }
        if named {
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Named)
            self.close(mark, Alt.Type_Tuple_Named, start)
        } else if elements == 1 && trailing {
            self.see(Alt.Type_Atom_SingleTuple)
            self.see(Alt.Type_SingleTuple)
            self.close(mark, Alt.Type_SingleTuple, start)
        } else if elements == 1 {
            self.see(Alt.Type_Atom_Paren)
            self.see(Alt.Type_Paren)
        } else {
            self.see(Alt.Type_Atom_Tuple)
            self.see(Alt.Type_Tuple_Positional)
            self.close(mark, Alt.Type_Tuple_Positional, start)
        }
        true
    }

    // `tuple-type-field ::= IDENT ":" type`
    func parse_tuple_type_field(&var self) -> Bool {
        self.see(Alt.Type_TupleField)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        if not self.parse_type(false) {
            return false
        }
        self.close(mark, Alt.Type_TupleField, start)
        true
    }

    // ---- generic lists ------------------------------------------------------------

    // `generic-params ::= "<" generic-param ( "," generic-param )* ">"`, one
    // level for the list. A trailing comma is refused
    // (syntax.generic.refused-param-comma).
    func parse_generic_params(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_generic_params_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_generic_params_body(&var self) -> Bool {
        self.see(Alt.Generic_Params_List)
        self.lists = self.lists + 1
        self.advance()
        while true {
            if not self.parse_generic_param() {
                return false
            }
            if self.kind() == TokenKind.Comma {
                let comma = self.pos
                self.advance()
                if self.closes_list() {
                    return self.refuse(Rule.Generic_RefusedParamComma, comma,
                                       "a generic parameter list takes no trailing comma",
                                       "drop the comma")
                }
            } else if self.closes_list() {
                break
            } else {
                return self.error("expected `,` or `>` in the generic parameters")
            }
        }
        self.close_list()
        true
    }

    // `generic-param ::= IDENT bound-list? ( "=" type )? | 'const' IDENT ":" type ( "=" const-expr )?`,
    // with `bound-list ::= ":" path ( "+" path )*`.
    func parse_generic_param(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        if self.word_at(0, "const") && self.kind_at(1) == TokenKind.Ident {
            self.see(Alt.Generic_Param_Const)
            self.advance()
            self.take_leaf()
            if self.kind() != TokenKind.Colon {
                return self.error("expected `:` and the constant parameter's type")
            }
            self.advance()
            if not self.parse_type(false) {
                return false
            }
            if self.kind() == TokenKind.Assign {
                self.take_leaf()
                if not self.parse_const_expr() {
                    return false
                }
            }
            self.close(mark, Alt.Generic_Param_Const, start)
            return true
        }
        if self.kind() != TokenKind.Ident {
            return self.error("expected a generic parameter's name")
        }
        self.see(Alt.Generic_Param_Type)
        self.take_leaf()
        if self.kind() == TokenKind.Colon {
            self.see(Alt.Generic_Bounds)
            self.advance()
            if not self.parse_path() {
                return false
            }
            while self.kind() == TokenKind.Plus {
                self.take_leaf()
                if not self.parse_path() {
                    return false
                }
            }
        }
        if self.kind() == TokenKind.Assign {
            self.take_leaf()
            if not self.parse_type(false) {
                return false
            }
        }
        self.close(mark, Alt.Generic_Param_Type, start)
        true
    }

    // `generic-args ::= "<" generic-arg ( "," generic-arg )* ">"`, one level
    // for the list, held to its `>`. A trailing comma is refused
    // (syntax.generic.refused-arg-comma); inside a speculation it is noted,
    // and refused only if the list is kept.
    func parse_generic_args(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_generic_args_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_generic_args_body(&var self) -> Bool {
        self.see(Alt.Generic_Args_List)
        self.lists = self.lists + 1
        self.advance()
        while true {
            if not self.parse_generic_arg() {
                return false
            }
            if self.kind() == TokenKind.Comma {
                let comma = self.pos
                self.advance()
                if self.closes_list() {
                    if self.speculating == 0 {
                        return self.refuse(Rule.Generic_RefusedArgComma, comma,
                                           "a generic argument list takes no trailing comma",
                                           "drop the comma")
                    }
                    if self.trailing_comma < 0 {
                        self.trailing_comma = comma
                    }
                    break
                }
            } else if self.closes_list() {
                break
            } else {
                return self.error("expected `,` or `>` in the generic arguments")
            }
        }
        self.close_list()
        true
    }

    // Whether the current token closes the innermost generic list: a `>`, or
    // the first `>` of a `>=`, or of a `>>=` whose second `>` closes the list
    // around it (syntax.rule.generic-close-split).
    func closes_list(&self) -> Bool {
        let kind = self.kind()
        kind == TokenKind.Gt || kind == TokenKind.Gte || (kind == TokenKind.ShrAssign && self.lists >= 2)
    }

    // Consumes the `>` that closes the innermost list. A `>=` or `>>=` is split
    // after that `>`, and what remains of it is the current token.
    func close_list(&var self) {
        self.lists = self.lists - 1
        let t = self.current()
        if t.kind == TokenKind.Gt {
            self.advance()
            return
        }
        let rest = if t.kind == TokenKind.ShrAssign { TokenKind.Gte } else { TokenKind.Assign }
        let edit = TokenEdit(index: self.pos, token: t)
        // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.edits, self.edit_count, edit)
        let at = self.edit_count
        put_at(&var self.edits, at, edit)
        self.edit_count = at + 1
        self.tokens[self.pos] = ParseToken(kind: rest, start: t.start + 1, end: t.end, line: t.line,
                                           seg_start: 0, seg_count: 0)
        self.prev_end = t.start + 1
    }

    // `generic-arg ::= type | const-expr`. An argument that starts with an
    // integer, `-`, `sizeof` or `alignof` is a value, and so is one a type
    // cannot spell; the rest are types (syntax.rule.generic-arg-value).
    func parse_generic_arg(&var self) -> Bool {
        if self.value_ahead() {
            self.see(Alt.Generic_Arg_Value)
            return self.parse_const_expr()
        }
        self.see(Alt.Generic_Arg_Type)
        self.parse_type(false)
    }

    // Whether the generic argument here is a value. A path followed by an
    // arithmetic operator is one, as is a parenthesized argument holding an
    // integer, an operator or a layout query outside any `[]` or `<>` of its
    // own, or followed by an operator.
    func value_ahead(&self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.IntLit || kind == TokenKind.Minus {
            return true
        }
        if self.layout_ahead(0) {
            return true
        }
        var k = 0
        if kind == TokenKind.Ident {
            k = 1
            while self.kind_at(k) == TokenKind.Dot && self.kind_at(k + 1) == TokenKind.Ident {
                k = k + 2
            }
            return is_const_operator(self.kind_at(k))
        }
        if kind != TokenKind.LParen {
            return false
        }
        var parens = 0
        var nested = 0
        while true {
            let at = self.kind_at(k)
            if at == TokenKind.Eof || at == TokenKind.LBrace || at == TokenKind.RBrace {
                return false
            }
            if at == TokenKind.LParen {
                parens = parens + 1
            } else if at == TokenKind.RParen {
                parens = parens - 1
                if parens == 0 {
                    return is_const_operator(self.kind_at(k + 1))
                }
            } else if at == TokenKind.LBracket || at == TokenKind.Lt {
                nested = nested + 1
            } else if at == TokenKind.RBracket || at == TokenKind.Gt {
                nested = nested - 1
            } else if nested == 0 && (at == TokenKind.IntLit || is_const_operator(at) || self.layout_ahead(k)) {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether `sizeof` or `alignof` and a `<` stand `ahead` tokens on.
    func layout_ahead(&self, ahead: Int) -> Bool {
        let word = self.word_at(ahead, "sizeof") || self.word_at(ahead, "alignof")
        word && self.kind_at(ahead + 1) == TokenKind.Lt
    }

    // `const-expr ::= const-term ( const-add-op const-term )*`, one flat node.
    func parse_const_expr(&var self) -> Bool {
        self.see(Alt.Const_Expr)
        let mark = self.builder.mark()
        if not self.parse_const_term() {
            return false
        }
        var ops = 0
        while self.kind() == TokenKind.Plus || self.kind() == TokenKind.Minus {
            let op = if self.kind() == TokenKind.Plus { Alt.Const_AddOp_Plus } else { Alt.Const_AddOp_Minus }
            self.see(op)
            self.take_leaf()
            if not self.parse_const_term() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Const_Expr)
        }
        true
    }

    // `const-term ::= const-unary ( const-mul-op const-unary )*`
    func parse_const_term(&var self) -> Bool {
        self.see(Alt.Const_Term)
        let mark = self.builder.mark()
        if not self.parse_const_unary() {
            return false
        }
        var ops = 0
        while let op = self.const_mul_op() {
            self.see(op)
            self.take_leaf()
            if not self.parse_const_unary() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Const_Term)
        }
        true
    }

    func const_mul_op(&self) -> Alt? {
        match self.kind() {
            case Star -> Alt.Const_MulOp_Times,
            case Slash -> Alt.Const_MulOp_Divide,
            case Percent -> Alt.Const_MulOp_Remainder,
            case _ -> None
        }
    }

    // `const-unary ::= const-negate | const-atom`
    func parse_const_unary(&var self) -> Bool {
        if self.kind() == TokenKind.Minus {
            self.see(Alt.Const_Unary_Negate)
            return self.parse_const_negate()
        }
        self.see(Alt.Const_Unary_Atom)
        self.parse_const_atom()
    }

    // `const-negate ::= "-" const-unary`, one level held to its operand's end.
    func parse_const_negate(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Const_Negate)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_const_unary() {
            return false
        }
        self.close(mark, Alt.Const_Negate, start)
        self.leave_level()
        true
    }

    // `const-atom ::= int-literal | path | "(" const-expr ")" | layout-query`.
    // The parentheses group, and charge one level.
    func parse_const_atom(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.IntLit {
            self.see(Alt.Const_Atom_Int)
            return self.token_node(Alt.Expr_Int, true)
        }
        if self.layout_ahead(0) {
            self.see(Alt.Const_Atom_Layout)
            return self.parse_layout_query()
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Const_Atom_Name)
            return self.parse_path()
        }
        if kind == TokenKind.LParen {
            return self.parse_const_group()
        }
        self.error("expected a constant: an integer, a name or a parenthesized constant")
    }

    func parse_const_group(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Const_Atom_Group)
        self.advance()
        if not self.parse_const_expr() {
            return false
        }
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the constant")
        }
        self.advance()
        self.leave_level()
        true
    }

    // `layout-query ::= 'sizeof' generic-args "(" ")" | 'alignof' generic-args "(" ")"`,
    // whose list is committed: `sizeof` and `alignof` begin no type.
    func parse_layout_query(&var self) -> Bool {
        let alt = if self.word_at(0, "sizeof") { Alt.Const_LayoutQuery_Size } else { Alt.Const_LayoutQuery_Align }
        self.see(alt)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if not self.parse_generic_args() {
            return false
        }
        if self.kind() != TokenKind.LParen || self.kind_at(1) != TokenKind.RParen {
            return self.error("expected `()` after the layout query's type")
        }
        self.advance()
        self.advance()
        self.close(mark, alt, start)
        true
    }

    // A generic list at the `<` after a name, a member or a cast target,
    // kept only where the token after its `>` may follow it: `(`, `.` or `{`
    // after a name or member, and after a cast target what the productions
    // allow there (syntax.rule.generic-or-less). A list not kept is undone,
    // and its `<` compares.
    func speculate_list(&var self, cast: Bool) -> ListOutcome {
        let open = self.pos
        if open < self.failed_lists.len() && self.failed_lists[open] {
            return ListOutcome.Compares
        }
        if not self.closer_ahead() {
            return ListOutcome.Compares
        }
        let saved = self.checkpoint()
        self.trailing_comma = -1
        let refusals = self.depth_refusals
        if not self.parse_generic_args() {
            let by_depth = self.depth_refusals > refusals
            self.restore(&saved)
            if by_depth {
                // The depth budget decides no reading: a list the limit cut
                // short is refused, never re-read as comparisons.
                let at = self.depth_opener
                let _ = self.refuse_depth(at)
                return ListOutcome.Refused
            }
            while self.failed_lists.len() <= open {
                try! self.failed_lists.push(false)
            }
            self.failed_lists[open] = true
            return ListOutcome.Compares
        }
        let after = self.kind()
        var kept = after == TokenKind.LParen || after == TokenKind.Dot || after == TokenKind.LBrace
        if cast {
            kept = follows_cast_list(after)
        }
        if not kept {
            self.restore(&saved)
            if not cast && continues_postfix(after) {
                self.rejected_list = open
            }
            return ListOutcome.Compares
        }
        let comma = self.trailing_comma
        self.commit(&saved)
        self.trailing_comma = saved.trailing_comma
        if comma >= 0 {
            let _ = self.refuse(Rule.Generic_RefusedArgComma, comma,
                                "a generic argument list takes no trailing comma", "drop the comma")
            return ListOutcome.Refused
        }
        if not cast && after == TokenKind.LBrace && self.head {
            // A list is kept before a `{` only where a trailing closure may
            // attach, and in a head the `{` begins the body.
            let at = self.pos
            let _ = self.refuse(Rule.Rule_HeadRestriction, at,
                                "a `\{` after a head's outer level begins the body, so no trailing closure attaches there",
                                "call with parentheses: `f<T>(\{ … \})`")
            return ListOutcome.Refused
        }
        ListOutcome.Kept
    }

    // Whether a generic list opened at the `<` here could close: whether a
    // `>`, `>=` or `>>=` stands at its bracket depth before that depth ends.
    // The scan passes line breaks, which a list spans, and nested `( )` and
    // `[ ]` groups whole, since a list's closer sits at the list's own depth.
    // It stops at a token no list holds at that depth, which the grammar tables
    // compute from the productions (`stops_list_scan`), and the answer covers
    // every `<` at that depth up to where it stopped (SL-424 c29). It takes no
    // level: a scan is a look, and only the list it permits charges depth.
    func closer_ahead(&var self) -> Bool {
        let open = self.pos
        if open < self.closer_scans.len() && self.closer_scans[open] != CloserScan.Unscanned {
            return self.closer_scans[open] == CloserScan.Found
        }
        var k = open + 1
        var nested = 0
        var found = false
        while k < self.limit {
            let kind = self.tokens[k].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                nested = nested + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                if nested == 0 {
                    break
                }
                nested = nested - 1
            } else if nested == 0 {
                if kind == TokenKind.Gt || kind == TokenKind.Gte || kind == TokenKind.ShrAssign {
                    found = true
                    break
                }
                if stops_list_scan(kind) {
                    break
                }
            }
            k = k + 1
        }
        let answer = if found { CloserScan.Found } else { CloserScan.Missing }
        while self.closer_scans.len() < k {
            try! self.closer_scans.push(CloserScan.Unscanned)
        }
        nested = 0
        var at = open
        while at < k {
            let kind = self.tokens[at].kind
            if kind == TokenKind.LParen || kind == TokenKind.LBracket {
                nested = nested + 1
            } else if kind == TokenKind.RParen || kind == TokenKind.RBracket {
                nested = nested - 1
            } else if nested == 0 && kind == TokenKind.Lt {
                self.closer_scans[at] = answer
            }
            at = at + 1
        }
        found
    }

    // ---- expressions -----------------------------------------------------------------

    // `expr ::= coalesce-expr`
    func parse_expr(&var self) -> Bool {
        self.see(Alt.Expr_Expr)
        self.parse_coalesce()
    }

    // `coalesce-expr ::= or-expr ( "??" NEWLINE* or-expr )*`
    func parse_coalesce(&var self) -> Bool {
        self.see(Alt.Expr_Coalesce)
        let mark = self.operand_mark()
        if not self.parse_or() {
            return false
        }
        if self.kind() != TokenKind.DoubleQuestion {
            return true
        }
        while self.kind() == TokenKind.DoubleQuestion {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_or() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Coalesce)
        true
    }

    // `or-expr ::= and-expr ( "||" NEWLINE* and-expr )*`
    func parse_or(&var self) -> Bool {
        self.see(Alt.Expr_Or)
        let mark = self.operand_mark()
        if not self.parse_and() {
            return false
        }
        if self.kind() != TokenKind.Or {
            return true
        }
        while self.kind() == TokenKind.Or {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_and() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Or)
        true
    }

    // `and-expr ::= bitor-expr ( "&&" NEWLINE* bitor-expr )*`
    func parse_and(&var self) -> Bool {
        self.see(Alt.Expr_And)
        let mark = self.operand_mark()
        if not self.parse_bitor() {
            return false
        }
        if self.kind() != TokenKind.And {
            return true
        }
        while self.kind() == TokenKind.And {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitor() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_And)
        true
    }

    // `bitor-expr ::= bitxor-expr ( "|" NEWLINE* bitxor-expr )*`
    func parse_bitor(&var self) -> Bool {
        self.see(Alt.Expr_Bitor)
        let mark = self.operand_mark()
        if not self.parse_bitxor() {
            return false
        }
        if self.kind() != TokenKind.Pipe {
            return true
        }
        while self.kind() == TokenKind.Pipe {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitxor() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitor)
        true
    }

    // `bitxor-expr ::= bitand-expr ( "^" NEWLINE* bitand-expr )*`
    func parse_bitxor(&var self) -> Bool {
        self.see(Alt.Expr_Bitxor)
        let mark = self.operand_mark()
        if not self.parse_bitand() {
            return false
        }
        if self.kind() != TokenKind.Caret {
            return true
        }
        while self.kind() == TokenKind.Caret {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_bitand() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitxor)
        true
    }

    // `bitand-expr ::= compare-expr ( "&" NEWLINE* compare-expr )*`
    func parse_bitand(&var self) -> Bool {
        self.see(Alt.Expr_Bitand)
        let mark = self.operand_mark()
        if not self.parse_compare() {
            return false
        }
        if self.kind() != TokenKind.Ampersand {
            return true
        }
        while self.kind() == TokenKind.Ampersand {
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_compare() {
                return false
            }
        }
        self.close_chain(mark, Alt.Expr_Bitand)
        true
    }

    // `compare-expr ::= range-expr ( compare-op NEWLINE* range-expr )?`. A
    // comparison takes two operands, so a chain of them is refused, at its
    // second operator, once the chain has parsed (syntax.rule.compare-chain).
    func parse_compare(&var self) -> Bool {
        self.see(Alt.Expr_Compare_Pair)
        let mark = self.operand_mark()
        if not self.parse_range() {
            return false
        }
        guard let op = self.compare_op() else { return true }
        self.see(op)
        self.take_leaf()
        self.skip_newlines()
        if not self.parse_range() {
            return false
        }
        let second = self.pos
        var chained = false
        while let more = self.compare_op() {
            self.see(more)
            chained = true
            self.advance()
            self.skip_newlines()
            if not self.parse_range() {
                return false
            }
        }
        // A chain that parses whole is the removed production, even where it
        // re-reads a generic list whose own reading went on: enabling it
        // alone makes the text parse (compiler/tests/parse/README.md,
        // Refusals, step 2).
        if chained {
            return self.refuse(Rule.Expr_RefusedCompareChain, second,
                               "a comparison takes two operands, so comparisons do not chain",
                               "join two comparisons with `&&`: `a < b && b < c`")
        }
        self.close_chain(mark, Alt.Expr_Compare_Pair)
        true
    }

    // The comparison operator at the current token, if there is one.
    func compare_op(&self) -> Alt? {
        match self.kind() {
            case Eq -> Alt.Expr_CompareOp_Equal,
            case Neq -> Alt.Expr_CompareOp_NotEqual,
            case Lt -> Alt.Expr_CompareOp_Less,
            case Gt -> Alt.Expr_CompareOp_Greater,
            case Lte -> Alt.Expr_CompareOp_LessEqual,
            case Gte -> Alt.Expr_CompareOp_GreaterEqual,
            case _ -> None
        }
    }

    // `range-expr`: a closed range `a..b` or `a..=b`, an open end `a..`, an
    // open start `..b`, `..=b` or `..`, or a lone shift operand. A range's
    // upper bound is omitted only where a closer, a separator or a line break
    // follows its `..` (syntax.rule.range-open-end), and a line break after
    // `..=` leaves it without the bound it needs.
    func parse_range(&var self) -> Bool {
        let start = self.operand_start()
        let mark = self.operand_mark()
        let lead = self.kind()
        if not self.primed && (lead == TokenKind.DotDot || lead == TokenKind.DotDotEq) {
            self.see(Alt.Expr_Range_Upto)
            self.take_leaf()
            if self.head && self.kind() == TokenKind.LBrace {
                return self.refuse_open_end()
            }
            if lead == TokenKind.DotDot && self.range_ends() {
                self.see(Alt.Expr_RangeUpto_Full)
            } else {
                let alt = if lead == TokenKind.DotDot { Alt.Expr_RangeUpto_Exclusive } else { Alt.Expr_RangeUpto_Inclusive }
                self.see(alt)
                if not self.parse_shift() {
                    return false
                }
            }
            self.close(mark, Alt.Expr_Range_Upto, start)
            return true
        }
        if not self.parse_shift() {
            return false
        }
        let op = self.kind()
        if op == TokenKind.Ellipsis {
            let at = self.pos
            self.advance()
            if not self.parse_shift() {
                return false
            }
            return self.refuse(Rule.Expr_RefusedEllipsisRange, at,
                               "a range is written `..` or `..=`; `...` ends a variadic parameter list",
                               "write `a..=b` for a range that includes `b`")
        }
        if op != TokenKind.DotDot && op != TokenKind.DotDotEq {
            self.see(Alt.Expr_Range_Closed)
            return true
        }
        self.take_leaf()
        if self.head && self.kind() == TokenKind.LBrace {
            return self.refuse_open_end()
        }
        if op == TokenKind.DotDot && self.range_ends() {
            self.see(Alt.Expr_Range_From)
            self.see(Alt.Expr_RangeFrom)
            self.close(mark, Alt.Expr_Range_From, start)
            return true
        }
        self.see(Alt.Expr_Range_Closed)
        let alt = if op == TokenKind.DotDot { Alt.Expr_RangeOp_Exclusive } else { Alt.Expr_RangeOp_Inclusive }
        self.see(alt)
        if not self.parse_shift() {
            return false
        }
        self.close(mark, Alt.Expr_Range_Closed, start)
        true
    }

    // A range operator before a head's body `{`: the `{` is the body, and a
    // range's upper bound is omitted only before a closer, a separator or a
    // line break (syntax.rule.range-open-end).
    func refuse_open_end(&var self) -> Bool {
        let at = self.pos
        self.refuse(Rule.Rule_RangeOpenEnd, at,
                    "a range's upper bound is omitted only before a closing token or a line break",
                    "parenthesize the open range: `for i in (a..) \{`")
    }

    // Whether the current token ends a range whose upper bound is omitted.
    func range_ends(&self) -> Bool {
        match self.kind() {
            case RBracket -> true,
            case RParen -> true,
            case Comma -> true,
            case Semicolon -> true,
            case Newline -> true,
            case RBrace -> true,
            case Eof -> true,
            case _ -> false
        }
    }

    // `shift-expr ::= additive-expr ( shift-op NEWLINE* additive-expr )*`
    func parse_shift(&var self) -> Bool {
        self.see(Alt.Expr_Shift)
        let mark = self.operand_mark()
        if not self.parse_additive() {
            return false
        }
        var ops = 0
        while let op = self.shift_op() {
            self.see(op)
            self.take_shift()
            self.skip_newlines()
            if not self.parse_additive() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Shift)
        }
        true
    }

    // The shift at the current token, if there is one: two `<` or two `>`
    // tokens with nothing between them (syntax.lex.shift-adjacent).
    func shift_op(&self) -> Alt? {
        let kind = self.kind()
        if kind != TokenKind.Lt && kind != TokenKind.Gt {
            return None
        }
        if self.kind_at(1) != kind || self.tokens[self.pos].end != self.tokens[self.pos + 1].start {
            return None
        }
        if kind == TokenKind.Lt { Alt.Expr_ShiftOp_Left } else { Alt.Expr_ShiftOp_Right }
    }

    // A shift's two tokens, as the one leaf `<<` or `>>`.
    func take_shift(&var self) {
        let first = self.current()
        self.advance()
        let second = self.current()
        let _ = self.builder.leaf(NodeShape.Token, first.start, second.end)
        self.advance()
    }

    // `additive-expr ::= multiplicative-expr ( add-op NEWLINE* multiplicative-expr )*`
    func parse_additive(&var self) -> Bool {
        self.see(Alt.Expr_Additive)
        let mark = self.operand_mark()
        if not self.parse_multiplicative() {
            return false
        }
        var ops = 0
        while let op = self.additive_op() {
            self.see(op)
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_multiplicative() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Additive)
        }
        true
    }

    func additive_op(&self) -> Alt? {
        match self.kind() {
            case Plus -> Alt.Expr_AddOp_Plus,
            case Minus -> Alt.Expr_AddOp_Minus,
            case WrapAdd -> Alt.Expr_AddOp_WrappingPlus,
            case WrapSub -> Alt.Expr_AddOp_WrappingMinus,
            case _ -> None
        }
    }

    // `multiplicative-expr ::= cast-expr ( mul-op NEWLINE* cast-expr )*`. A
    // `*` between operands multiplies, and one before an operand is a
    // dereference (syntax.rule.deref-or-multiply).
    func parse_multiplicative(&var self) -> Bool {
        self.see(Alt.Expr_Multiplicative)
        let mark = self.operand_mark()
        if not self.parse_cast() {
            return false
        }
        var ops = 0
        while let op = self.multiplicative_op() {
            self.see(op)
            self.take_leaf()
            self.skip_newlines()
            if not self.parse_cast() {
                return false
            }
            ops = ops + 1
        }
        if ops > 0 {
            self.close_chain(mark, Alt.Expr_Multiplicative)
        }
        true
    }

    func multiplicative_op(&self) -> Alt? {
        match self.kind() {
            case Star -> Alt.Expr_MulOp_Times,
            case Slash -> Alt.Expr_MulOp_Divide,
            case Percent -> Alt.Expr_MulOp_Remainder,
            case WrapMul -> Alt.Expr_MulOp_WrappingTimes,
            case _ -> None
        }
    }

    // `cast-expr ::= prefix-expr cast-suffix*`, one Cast node per `as`, each
    // charging a level held to the end of the cast chain.
    func parse_cast(&var self) -> Bool {
        self.see(Alt.Expr_Cast)
        let start = self.operand_start()
        let mark = self.operand_mark()
        if not self.parse_prefix() {
            return false
        }
        var casts = 0
        while self.kind() == TokenKind.As {
            let at = self.pos
            if not self.enter_level(at) {
                return false
            }
            casts = casts + 1
            self.see(Alt.Expr_CastSuffix_Cast)
            self.take_leaf()
            if not self.parse_cast_target() {
                return false
            }
            self.close(mark, Alt.Expr_Cast, start)
        }
        while casts > 0 {
            self.leave_level()
            casts = casts - 1
        }
        true
    }

    // `cast-target ::= type-atom | type-atom "?" | ref-type | func-type`: a
    // type with at most one `?` of its own, so a `?` or `??` after it is
    // refused at that token, whatever the spacing
    // (syntax.rule.cast-target-question). The `<` after its last named type
    // is speculative (syntax.rule.generic-or-less).
    func parse_cast_target(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Type_CastTarget_Plain
        if self.kind() == TokenKind.Ampersand && not self.slice_ahead() {
            alt = Alt.Type_CastTarget_Ref
            if not self.parse_ref_type(true) {
                return false
            }
        } else if self.kind() == TokenKind.LParen && self.func_type_ahead() {
            alt = Alt.Type_CastTarget_Func
            if not self.parse_func_type(true) {
                return false
            }
        } else {
            if not self.parse_type_atom(true) {
                return false
            }
            if self.kind() == TokenKind.Question {
                alt = Alt.Type_CastTarget_Optional
                self.advance()
                self.close(mark, Alt.Type_Suffix_Optional, start)
            }
        }
        let after = self.kind()
        if after == TokenKind.Question || after == TokenKind.DoubleQuestion {
            let at = self.pos
            return self.refuse(Rule.Rule_CastTargetQuestion, at,
                               "a cast target takes at most one `?`",
                               "coalesce first, then convert: `(n ?? 9) as Int`")
        }
        self.see(alt)
        true
    }

    // `prefix-expr`: a prefix operator and its operand, or a postfix
    // expression. Each operator binds tighter than `as`
    // (syntax.rule.prefix-or-cast). A primed operand is already parsed.
    func parse_prefix(&var self) -> Bool {
        if self.primed {
            self.primed = false
            return true
        }
        let kind = self.kind()
        if kind == TokenKind.Minus {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Negate, 1, false)
        }
        if kind == TokenKind.Not_ {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Not, 1, false)
        }
        if kind == TokenKind.Tilde {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Unary, Alt.Expr_Unary_Complement, 1, false)
        }
        if kind == TokenKind.Star {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Deref, Alt.Expr_Deref, 1, false)
        }
        if kind == TokenKind.Ampersand {
            if self.kind_at(1) == TokenKind.Var {
                return self.parse_prefix_operator(Alt.Expr_Prefix_Ref, Alt.Expr_Ref_Exclusive, 2, false)
            }
            return self.parse_prefix_operator(Alt.Expr_Prefix_Ref, Alt.Expr_Ref_Shared, 1, false)
        }
        let next = self.kind_at(1)
        if self.word_at(0, "lends") && (next == TokenKind.SelfKw || next == TokenKind.Ident) {
            return self.parse_prefix_operator(Alt.Expr_Prefix_Lends, Alt.Expr_Lends, 1, false)
        }
        if kind == TokenKind.Unsafe_ {
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedUnsafe, at,
                               "unsafety belongs to a declaration, not to an expression",
                               "mark the enclosing function `unsafe`, after its parameters")
        }
        if kind == TokenKind.Try && not self.try_block_ahead() {
            return self.parse_try()
        }
        if kind == TokenKind.Move_ || kind == TokenKind.Borrow {
            return self.error("this prefix form is not parsed yet")
        }
        self.see(Alt.Expr_Prefix_Postfix)
        self.parse_postfix(false)
    }

    // A prefix operator spelled by `width` tokens, which its node's Kind
    // implies, so it prints nothing. It charges one level, held to its
    // operand's end. On a statement's leading operand (`spine`) its form is
    // kept until the statement knows whether the operand is a target.
    func parse_prefix_operator(&var self, form: Alt, node: Alt, width: Int, spine: Bool) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see_spine(form, spine)
        self.see(node)
        let start = self.here()
        let mark = self.builder.mark()
        var k = 0
        while k < width {
            self.advance()
            k = k + 1
        }
        if not self.parse_prefix() {
            return false
        }
        self.close(mark, node, start)
        self.leave_level()
        true
    }

    // `try-expr`: `try`, `try?` or `try!` applied to the prefix expression
    // after it, and only that (syntax.rule.try-extent), charging one level.
    // A plain `try` may take an inline `catch` after its operand.
    func parse_try(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_try_body(open) {
            return false
        }
        self.leave_level()
        true
    }

    // What follows a `try` at `open`. Only a plain `try` routes its error,
    // and a routed one takes no `catch`: a routing clause after `try!` or
    // `try?`, or before a `catch`, is refused once the operand has parsed.
    func parse_try_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        var alt = Alt.Expr_Try_Propagate
        if self.kind() == TokenKind.Exclaim {
            alt = Alt.Expr_Try_Force
            self.advance()
        } else if self.kind() == TokenKind.Question {
            alt = Alt.Expr_Try_Optional
            self.advance()
        }
        let route = self.pos
        let routed = self.kind() == TokenKind.LParen && self.kind_at(1) == TokenKind.As
        if routed {
            if not self.parse_try_route() {
                return false
            }
        }
        self.skip_newlines()
        if not self.parse_prefix() {
            return false
        }
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        let caught = self.kind_at(ahead) == TokenKind.Catch
        if routed && (caught || alt != Alt.Expr_Try_Propagate) {
            return self.refuse(Rule.Expr_RefusedTryRoute, route,
                               "only a plain `try` routes its error, and a routed `try` takes no `catch`",
                               "write `try(as E.Case) f()` alone")
        }
        if caught && alt == Alt.Expr_Try_Propagate {
            alt = Alt.Expr_Try_Catch
            if not self.parse_catch_clause() {
                return false
            }
        }
        if routed {
            alt = Alt.Expr_Try_Route
        }
        self.see(Alt.Expr_Prefix_Try)
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `catch-clause ::= NEWLINE* "catch" NEWLINE* block`, which may start the
    // line after its operand (syntax.rule.continuation-keywords).
    func parse_catch_clause(&var self) -> Bool {
        self.see(Alt.Expr_Catch)
        self.skip_newlines()
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the `catch` block")
        }
        if not self.parse_block() {
            return false
        }
        self.close(mark, Alt.Expr_Catch, start)
        true
    }

    // `try-block ::= "try" NEWLINE* block NEWLINE* "catch" NEWLINE* block`,
    // one level held to the end of its `catch` block. A `try` before a brace
    // is a block, never a `try` applied to a closure, so one without its
    // `catch` is refused (syntax.rule.try-block).
    func parse_try_block(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        self.see(Alt.Expr_TryBlock)
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        self.skip_newlines()
        let brace = self.pos
        if not self.parse_block() {
            return false
        }
        var ahead = 0
        while self.kind_at(ahead) == TokenKind.Newline {
            ahead = ahead + 1
        }
        if self.kind_at(ahead) != TokenKind.Catch {
            return self.refuse(Rule.Rule_TryBlock, brace,
                               "a `try` block takes a `catch` block",
                               "add `catch \{ … \}`, or parenthesize a closure: `try (\{ … \})()`")
        }
        self.skip_newlines()
        self.advance()
        self.skip_newlines()
        if self.kind() != TokenKind.LBrace {
            return self.error("expected `\{` to open the `catch` block")
        }
        if not self.parse_block() {
            return false
        }
        self.close(mark, Alt.Expr_TryBlock, start)
        self.leave_level()
        true
    }

    // `try-route ::= "(" "as" path ")"`, whose path names an enum and one of
    // its cases (syntax.rule.try-route-case). The `as` prints.
    func parse_try_route(&var self) -> Bool {
        let open = self.pos
        self.advance()
        self.take_leaf()
        let path = self.pos
        if not self.parse_path() {
            return false
        }
        if self.pos - path < 3 {
            return self.refuse(Rule.Rule_TryRouteCase, path,
                               "a routing clause names an enum and a case",
                               "write the case with its enum: `try(as ConfigError.Alloc)`")
        }
        if self.kind() != TokenKind.RParen {
            return self.list_error(open, "expected `)` after the routing clause")
        }
        self.advance()
        self.see(Alt.Expr_TryRoute)
        true
    }

    // `postfix-expr ::= primary-expr postfix-hop*`: one node per hop, the
    // primary innermost, each hop charging a level held until the chain ends
    // (syntax.rule.postfix-per-hop). A `?.` hop opens an optional-chain run,
    // which member, `?.` and call hops continue, and which a `!`, a subscript,
    // a tuple index or the chain's end closes into one OptionalChain node
    // around the chain so far (syntax.rule.optional-chain-run). On a
    // statement's leading chain (`spine`) the chain's alternative and each
    // hop's are kept until the statement knows whether the chain is a target.
    func parse_postfix(&var self, spine: Bool) -> Bool {
        self.see_spine(Alt.Expr_Postfix, spine)
        let start = self.here()
        let mark = self.builder.mark()
        if not self.parse_primary() {
            return false
        }
        var hops = 0
        var run = false
        while true {
            let kind = self.kind()
            let after = self.kind_at(1)
            let continues = (kind == TokenKind.QuestionDot || kind == TokenKind.LParen
                             || (kind == TokenKind.Dot && after == TokenKind.Ident))
            let closes = (kind == TokenKind.Exclaim || kind == TokenKind.LBracket
                          || (kind == TokenKind.Dot && after == TokenKind.IntLit))
            if not continues && not closes {
                break
            }
            if run && closes {
                self.close_run(mark, start)
                run = false
            }
            let at = self.pos
            if not self.enter_level(at) {
                return false
            }
            hops = hops + 1
            if not self.parse_hop(mark, start, spine) {
                return false
            }
            if kind == TokenKind.QuestionDot {
                run = true
            }
        }
        if run {
            self.close_run(mark, start)
        }
        while hops > 0 {
            self.leave_level()
            hops = hops - 1
        }
        true
    }

    // Closes the chain begun at `mark` into the OptionalChain node of a run.
    func close_run(&var self, mark: Int, start: Int) {
        // Stage 0 workaround (SL:hazards S4): canonical: let _ = self.builder.close(mark, NodeShape.OptionalChain, None, start, self.prev_end)
        let end = self.prev_end
        let _ = self.builder.close(mark, NodeShape.OptionalChain, None, start, end)
    }

    // One `postfix-hop`, applied to the chain begun at `mark`.
    func parse_hop(&var self, mark: Int, start: Int, spine: Bool) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.LParen {
            return self.parse_call(mark, start, spine)
        }
        if kind == TokenKind.LBracket {
            return self.parse_subscript(mark, start, spine)
        }
        if kind == TokenKind.Exclaim {
            self.see_spine(Alt.Expr_Hop_Force, spine)
            self.see(Alt.Expr_Force)
            self.advance()
            self.close(mark, Alt.Expr_Force, start)
            return true
        }
        var hop = Alt.Expr_Hop_Member
        var node = Alt.Expr_Member
        if kind == TokenKind.QuestionDot {
            hop = Alt.Expr_Hop_Optional
            node = Alt.Expr_OptionalMember
        } else if self.kind_at(1) == TokenKind.IntLit {
            // Digits after a member `.` are a tuple index, which never takes
            // the next `.` as a decimal point (syntax.rule.tuple-index-dot).
            hop = Alt.Expr_Hop_TupleIndex
            node = Alt.Expr_TupleIndex
        }
        self.advance()
        if self.kind() != TokenKind.Ident && node != Alt.Expr_TupleIndex {
            return self.error("expected a member name after `?.`")
        }
        self.see_spine(hop, spine)
        self.see(node)
        self.take_leaf()
        if node != Alt.Expr_TupleIndex && self.opens_generic_list() {
            if self.speculate_list(false) == ListOutcome.Refused {
                return false
            }
        }
        self.close(mark, node, start)
        true
    }

    // Whether a `<` here may open a generic list after a name or member: a
    // `<` that is not the first half of a shift (syntax.lex.shift-adjacent).
    func opens_generic_list(&self) -> Bool {
        if self.kind() != TokenKind.Lt {
            return false
        }
        if let _ = self.shift_op() {
            return false
        }
        true
    }

    // `name-expr ::= IDENT generic-args?`
    func parse_name(&var self) -> Bool {
        self.see(Alt.Expr_Name)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        if self.opens_generic_list() {
            if self.speculate_list(false) == ListOutcome.Refused {
                return false
            }
        }
        self.close(mark, Alt.Expr_Name, start)
        true
    }

    // `call-hop ::= "(" arg-list? ")"`, one Call node whatever the callee is
    // (syntax.rule.one-call-node), with `arg-list ::= argument ( "," argument )* ","?`.
    func parse_call(&var self, mark: Int, start: Int, spine: Bool) -> Bool {
        self.see_spine(Alt.Expr_Hop_Call, spine)
        self.see(Alt.Expr_Call_Paren)
        let open = self.pos
        let head = self.head
        self.head = false
        self.advance()
        if self.kind() != TokenKind.RParen {
            self.see(Alt.Expr_Args)
        }
        while self.kind() != TokenKind.RParen {
            if self.kind() == TokenKind.Eof {
                return self.refuse_unclosed(open)
            }
            if not self.parse_argument() {
                return false
            }
            if self.kind() == TokenKind.Comma {
                self.advance()
            } else if self.kind() != TokenKind.RParen {
                return self.list_error(open, "expected `,` or `)` after an argument")
            }
        }
        self.advance()
        self.head = head
        self.close(mark, Alt.Expr_Call_Paren, start)
        true
    }

    // `argument ::= expr | IDENT ":" expr`: a name and `:` at an argument's
    // start is its label (syntax.rule.label-or-tuple).
    func parse_argument(&var self) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        var alt = Alt.Expr_Argument_Positional
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            alt = Alt.Expr_Argument_Labelled
            self.take_leaf()
            self.advance()
        }
        self.see(alt)
        if not self.parse_expr() {
            return false
        }
        self.close(mark, alt, start)
        true
    }

    // `subscript-hop ::= "[" expr "]"`. A subscript with a label or a second
    // argument is the multi-argument form, which is not parsed yet.
    func parse_subscript(&var self, mark: Int, start: Int, spine: Bool) -> Bool {
        self.see_spine(Alt.Expr_Hop_Subscript, spine)
        self.see(Alt.Expr_Subscript_Single)
        let open = self.pos
        let head = self.head
        self.head = false
        self.advance()
        if self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon {
            return self.error("a labelled subscript is not parsed yet")
        }
        if not self.parse_expr() {
            return false
        }
        if self.kind() == TokenKind.Comma {
            return self.error("a subscript of more than one argument is not parsed yet")
        }
        if self.kind() != TokenKind.RBracket {
            return self.list_error(open, "expected `]`")
        }
        self.advance()
        self.head = head
        self.close(mark, Alt.Expr_Subscript_Single, start)
        true
    }

    // `primary-expr`: a literal, a name, a parenthesized expression, or a
    // construct that ends in a block: `if`, `match`, a loop or a try block.
    func parse_primary(&var self) -> Bool {
        let kind = self.kind()
        if kind == TokenKind.If {
            self.see(Alt.Expr_Primary_If)
            return self.parse_if()
        }
        if kind == TokenKind.Match {
            self.see(Alt.Expr_Primary_Match)
            return self.parse_match()
        }
        if kind == TokenKind.While {
            let binds = self.kind_at(1) == TokenKind.Let || self.kind_at(1) == TokenKind.Var
            let form = if binds { Alt.Expr_Primary_WhileLet } else { Alt.Expr_Primary_While }
            self.see(form)
            return self.parse_while()
        }
        if kind == TokenKind.For {
            self.see(Alt.Expr_Primary_For)
            return self.parse_for()
        }
        if kind == TokenKind.Try {
            self.see(Alt.Expr_Primary_TryBlock)
            return self.parse_try_block()
        }
        if kind == TokenKind.IntLit {
            return self.literal(Alt.Expr_Literal_Int, Alt.Expr_Int, true)
        }
        if kind == TokenKind.FloatLit {
            return self.literal(Alt.Expr_Literal_Float, Alt.Expr_Float, true)
        }
        if kind == TokenKind.StringLit {
            return self.literal(Alt.Expr_Literal_String, Alt.Expr_String, true)
        }
        if kind == TokenKind.True_ {
            return self.literal(Alt.Expr_Literal_Bool, Alt.Expr_Bool_True, false)
        }
        if kind == TokenKind.False_ {
            return self.literal(Alt.Expr_Literal_Bool, Alt.Expr_Bool_False, false)
        }
        if kind == TokenKind.NoneKw {
            return self.literal(Alt.Expr_Literal_None, Alt.Expr_None, false)
        }
        if kind == TokenKind.Ident {
            self.see(Alt.Expr_Primary_Name)
            return self.parse_name()
        }
        if kind == TokenKind.SelfKw {
            self.see(Alt.Expr_Primary_Self)
            return self.token_node(Alt.Expr_Self, false)
        }
        if kind == TokenKind.DollarParam {
            self.see(Alt.Expr_Primary_ShorthandParam)
            return self.token_node(Alt.Expr_ShorthandParam, true)
        }
        if kind == TokenKind.HashDirective {
            return self.parse_directive()
        }
        if kind == TokenKind.InterpString {
            return self.parse_interp()
        }
        if kind == TokenKind.Dot && self.kind_at(1) == TokenKind.Ident {
            // `.` and a name at the start of an operand name an enum case
            // (syntax.rule.implicit-member).
            self.see(Alt.Expr_Primary_ImplicitMember)
            self.see(Alt.Expr_ImplicitMember)
            let start = self.here()
            let mark = self.builder.mark()
            self.advance()
            self.take_leaf()
            self.close(mark, Alt.Expr_ImplicitMember, start)
            return true
        }
        if kind == TokenKind.LParen {
            return self.parse_paren()
        }
        if kind == TokenKind.LBracket {
            return self.parse_bracket()
        }
        self.error("expected an expression")
    }

    // A node of one token with `node`'s Kind, which records it; `shown` when
    // the token prints, which a keyword the Kind implies does not.
    func token_node(&var self, node: Alt, shown: Bool) -> Bool {
        self.see(node)
        let start = self.here()
        let mark = self.builder.mark()
        if shown {
            self.take_leaf()
        } else {
            self.advance()
        }
        self.close(mark, node, start)
        true
    }

    // `interp-string ::= INTERP_STRING`: an Interp node holding, in order, the
    // literal runs as written, in quotes, and the segments. The string
    // charges one level, and its segments' nesting continues from it.
    func parse_interp(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        if not self.parse_interp_body() {
            return false
        }
        self.leave_level()
        true
    }

    func parse_interp_body(&var self) -> Bool {
        let t = self.current()
        let mark = self.builder.mark()
        var run = t.start + 1
        var k = 0
        while k < t.seg_count {
            let piece = self.pieces[t.seg_start + k]
            if piece.open > run {
                let _ = self.builder.leaf(NodeShape.Segment, run, piece.open)
            }
            if not self.parse_segment(piece) {
                return false
            }
            run = piece.open + piece.len + 2
            k = k + 1
        }
        if run < t.end - 1 {
            let _ = self.builder.leaf(NodeShape.Segment, run, t.end - 1)
        }
        self.advance()
        self.see(Alt.Expr_Primary_Interpolation)
        self.see(Alt.Expr_Interpolation)
        self.close(mark, Alt.Expr_Interpolation, t.start)
        true
    }

    // One expression segment, lexed and parsed on its own from
    // `interp-segment ::= expr EOF | EOF` (syntax.rule.interpolation-segment):
    // its tokens are appended after every token so far, with their file
    // positions, and parsed as a run of their own. A blank segment is a
    // format placeholder, and any other must be exactly one expression
    // (syntax.rule.interpolation-whole).
    func parse_segment(&var self, piece: InterpPiece) -> Bool {
        let start = piece.open + 1
        let text = self.builder.tree.source.slice(start, start + piece.len)
        var toks = Vector<ParseToken>()
        var found = Vector<InterpPiece>()
        let lexed = lex(text)
        match lexed {
            case Ok(result) -> {
                let segment_source = source_file("", text)
                parser_tokens(&segment_source, &result, start, &var toks, &var found)
            },
            case Err(e) -> {
                let segment_source = source_file("", text)
                let at = start + segment_source.offset_of(e.line, e.col)
                self.lex_error(at, e.message)
                return false
            }
        }
        // The segment's tokens and pieces go at the live ends of the parser's
        // own, so each nested string's piece indices move by where they land.
        let base = self.piece_count
        var k = 0
        while k < found.len() {
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.pieces, self.piece_count, found[k])
            let nested = found[k]
            let at = self.piece_count
            put_at(&var self.pieces, at, nested)
            self.piece_count = at + 1
            k = k + 1
        }
        let first = self.token_count
        k = 0
        while k < toks.len() {
            let t = toks[k]
            let moved = ParseToken(kind: t.kind, start: t.start, end: t.end, line: t.line,
                                   seg_start: t.seg_start + base, seg_count: t.seg_count)
            // Stage 0 workaround (SL:hazards S4): canonical: put_at(&var self.tokens, self.token_count, moved)
            let at = self.token_count
            put_at(&var self.tokens, at, moved)
            if at < self.failed_lists.len() {
                self.failed_lists[at] = false
            }
            if at < self.closer_scans.len() {
                self.closer_scans[at] = CloserScan.Unscanned
            }
            self.token_count = at + 1
            k = k + 1
        }
        let saved_pos = self.pos
        let saved_limit = self.limit
        let saved_end = self.prev_end
        let saved_lists = self.lists
        let saved_head = self.head
        self.pos = first
        self.limit = self.token_count - 1
        self.lists = 0
        self.head = false
        var ok = true
        if self.kind() == TokenKind.Eof {
            self.see(Alt.Expr_InterpSegment_Placeholder)
            let _ = self.builder.leaf(NodeShape.Placeholder, piece.open, start + piece.len + 1)
        } else {
            self.see(Alt.Expr_InterpSegment_Expr)
            ok = self.parse_expr()
            if ok && self.kind() != TokenKind.Eof {
                ok = self.error("an interpolation segment holds exactly one expression")
            }
        }
        self.pos = saved_pos
        self.limit = saved_limit
        self.prev_end = saved_end
        self.lists = saved_lists
        self.head = saved_head
        ok
    }

    // `source-location ::= "#file" | "#line" | "#function"`, and `#lend_var`,
    // which the lexer passes on only to be refused.
    func parse_directive(&var self) -> Bool {
        let t = self.current()
        let name_start = t.start + 1
        var alt = Alt.Expr_SourceLocation_File
        if self.builder.tree.source.span_is(name_start, t.end, "line") {
            alt = Alt.Expr_SourceLocation_Line
        } else if self.builder.tree.source.span_is(name_start, t.end, "function") {
            alt = Alt.Expr_SourceLocation_Function
        } else if not self.builder.tree.source.span_is(name_start, t.end, "file") {
            let at = self.pos
            return self.refuse(Rule.Expr_RefusedLendVar, at,
                               "a `borrows` body never tests its lend mode",
                               "write the shared and the exclusive accessor apart, or use `@synthesize(shared)`")
        }
        self.see(Alt.Expr_Primary_SourceLocation)
        self.token_node(alt, false)
    }

    // A literal's node; `shown` when its token prints, which a keyword the
    // node's Kind implies does not.
    func literal(&var self, form: Alt, node: Alt, shown: Bool) -> Bool {
        self.see(Alt.Expr_Primary_Literal)
        self.see(form)
        self.token_node(node, shown)
    }

    // `paren-expr ::= "(" expr ")"`, which builds no node, since grouping
    // parentheses print nothing, or a `tuple-expr`. Either charges one level
    // for its `(`. A name and `:` first make the tuple named, and then every
    // element is labelled, or else none is (syntax.rule.label-or-tuple); a
    // mix is refused once the tuple has parsed.
    func parse_paren(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let head = self.head
        self.head = false
        if not self.parse_paren_body(open) {
            return false
        }
        self.head = head
        self.leave_level()
        true
    }

    func parse_paren_body(&var self, open: Int) -> Bool {
        let start = self.here()
        let mark = self.builder.mark()
        self.advance()
        if self.kind() == TokenKind.RParen {
            self.advance()
            self.see(Alt.Expr_Primary_Tuple)
            self.see(Alt.Expr_Tuple_Unit)
            self.close(mark, Alt.Expr_Tuple_Unit, start)
            return true
        }
        let named = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
        var elements = 0
        if not named {
            if not self.parse_expr() {
                return false
            }
            if self.kind() == TokenKind.RParen {
                self.advance()
                self.see(Alt.Expr_Primary_Paren)
                self.see(Alt.Expr_Paren)
                return true
            }
            elements = 1
        }
        var mixed = -1
        while true {
            if elements > 0 {
                if self.kind() == TokenKind.Comma {
                    self.advance()
                } else if self.kind() != TokenKind.RParen {
                    return self.list_error(open, "expected `,` or `)`")
                }
                if self.kind() == TokenKind.RParen {
                    break
                }
            }
            let labelled = self.kind() == TokenKind.Ident && self.kind_at(1) == TokenKind.Colon
            if labelled != named && mixed < 0 {
                mixed = self.pos
            }
            if labelled {
                if not self.parse_tuple_field() {
                    return false
                }
            } else if not self.parse_expr() {
                return false
            }
            elements = elements + 1
        }
        self.advance()
        if mixed >= 0 {
            return self.refuse(Rule.Expr_RefusedPartialNamedTuple, mixed,
                               "a named tuple labels every element or none",
                               "label every element, or none")
        }
        let alt = if named { Alt.Expr_Tuple_Named } else { Alt.Expr_Tuple_Positional }
        self.see(Alt.Expr_Primary_Tuple)
        self.see(alt)
        self.close(mark, alt, start)
        true
    }

    // `tuple-field ::= IDENT ":" expr`
    func parse_tuple_field(&var self) -> Bool {
        self.see(Alt.Expr_TupleField)
        let start = self.here()
        let mark = self.builder.mark()
        self.take_leaf()
        self.advance()
        if not self.parse_expr() {
            return false
        }
        self.close(mark, Alt.Expr_TupleField, start)
        true
    }

    // A bracketed list that goes on neither with a separator nor with its
    // closer: unclosed at the end of input, reported at its opener, and
    // otherwise a plain error here.
    func list_error(&var self, open: Int, message: String) -> Bool {
        if self.kind() == TokenKind.Eof {
            return self.refuse_unclosed(open)
        }
        self.error(message)
    }

    // `array-literal ::= "[" ( expr ( "," expr )* ","? )? "]"` or
    // `repeat-literal ::= "[" expr ";" expr "]"`, charging one level for the `[`.
    func parse_bracket(&var self) -> Bool {
        let open = self.pos
        if not self.enter_level(open) {
            return false
        }
        let start = self.here()
        let mark = self.builder.mark()
        let head = self.head
        self.head = false
        self.advance()
        var alt = Alt.Expr_Array
        if self.kind() != TokenKind.RBracket {
            if not self.parse_expr() {
                return false
            }
            if self.kind() == TokenKind.Semicolon {
                alt = Alt.Expr_Repeat
                self.advance()
                if not self.parse_expr() {
                    return false
                }
            } else {
                while self.kind() == TokenKind.Comma {
                    self.advance()
                    if self.kind() == TokenKind.RBracket {
                        break
                    }
                    if not self.parse_expr() {
                        return false
                    }
                }
            }
            if self.kind() != TokenKind.RBracket {
                return self.list_error(open, "expected `,` or `]`")
            }
        }
        self.advance()
        self.head = head
        let form = if alt == Alt.Expr_Repeat { Alt.Expr_Primary_Repeat } else { Alt.Expr_Primary_Array }
        self.see(form)
        self.see(alt)
        self.close(mark, alt, start)
        self.leave_level()
        true
    }
}
