// shadowed: constant.overflow at 7:20
// flags: --target riscv32-unknown-none-elf
// An `Int` constant past 2^31 - 1 overflows at riscv32's 32-bit word, where
// the same initializer folds clean on a 64-bit target; typecheck's
// constant-position funnel refuses it first, at the operation.

static EDGE: Int = 2147483647 + 1
