// flags: --target riscv32-unknown-none-elf
// Constants folded at riscv32's 32-bit word: `Int` and `UInt` are the word's
// width, so `Int.max` is 2^31 - 1, `1 << 31` is the sign bit, `Int.min`, and
// `UInt.max` is 2^32 - 1; every fixed width keeps its own, `Int64` included.

static INT_MAX: Int = Int.max
static INT_MIN: Int = Int.min
static SIGN_BIT: Int = 1 << 31
static UINT_MAX: UInt = UInt.max
static ALL_ONES: UInt = ~(0 as UInt)
static HALF_MASK: Int = ~0 & 0xFFFF
static PAGE: Int = 1 << 12
static WIDE: Int64 = 1 << 40
static WIDE_MAX: Int64 = Int64.max
static NARROW: Int32 = Int32.max

static_assert(SIGN_BIT == Int.min, "the sign bit of a 32-bit word is Int.min")
static_assert(INT_MAX == 2147483647, "Int.max is the 32-bit word's")
