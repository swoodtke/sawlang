// A type alias's construction over a constant is a constant (user ruling,
// Oct 10): the identity at the alias's underlying type, in a static, a
// `static_assert` and a raw case's value, through an alias of an alias, an
// alias over `Int8` holding a negative value or its minimum, an alias over
// `Bool`, and over an argument that is a static or an `as`. An alias over
// `Float` is no constant, as a float literal is not, and a call stays none.
// Typecheck's fold reaches every value the evaluator does.

type Small = Int8
type Octet = Byte
type Flag = Bool
type Ratio = Float
type Count = Int

func seven() -> Int { 7 }

static BASE: Int = 7
static LETTER: Byte = Byte(65)
static NEXT: Byte = Byte(65) + 1
static WIDE: Int = Byte(65) as Int
static NESTED: Octet = Octet(1)
static INNER: Byte = Byte(Octet(9))
static NEGATIVE: Small = Small(-3)
static LOWEST: Small = Small(Small.min)
static SET: Flag = Flag(true)
static NAMED: Count = Count(BASE)
static CAST: Byte = Byte(BASE as UInt8)
static FOLDED: Byte = Byte(200 + 55)
static RATIO: Ratio = Ratio(1.5)
static CALLED: Int = seven()

static_assert(Byte(65) == 65, "an alias's construction in a condition")
static_assert(Small(-3) < 0, "a signed alias")

enum Tag: UInt8 { case One = Byte(1), case Two = 2 }

func main() {
    print(LETTER)
}
