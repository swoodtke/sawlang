// Types whose size is at or just under the 64-bit `Int`'s largest value, each
// asserted at its exact size: the layout funnel accepts a size that fits
// (`compiler/target/tests/size_funnel.saw` runs this file on an LP64 triple).
// Nothing here is built or run; a value of one of these types cannot exist.

struct Halves {
    a: [UInt8; 4611686018427387904]
    b: [UInt8; 4611686018427387903]
}

struct PadEdge {
    b: [UInt64; 1152921504606846975]
}

struct PadTail {
    b: [UInt64; 1152921504606846974]
    c: UInt8
}

enum Wide {
    case A(v: [UInt8; 9223372036854775800])
    case B
}

struct Buf<const N: Int> {
    d: [UInt8; N]
}

static_assert(sizeof<[UInt8; 9223372036854775807]>() == 9223372036854775807, "an array of Int.max bytes")
static_assert(sizeof<[[UInt8; 1]; 9223372036854775807]>() == 9223372036854775807, "a nested array of Int.max bytes")
static_assert(sizeof<[Void; 9223372036854775807]>() == 0, "a zero-size element at Int.max elements")
static_assert(sizeof<Halves>() == 9223372036854775807, "a struct of Int.max bytes")
static_assert(sizeof<PadEdge>() == 9223372036854775800, "a struct one word under Int.max")
static_assert(sizeof<PadTail>() == 9223372036854775800, "a tail byte rounded up to the alignment, under Int.max")
static_assert(sizeof<Wide>() == 9223372036854775804, "an enum: tag and payload rounded to the tag's alignment")
static_assert(sizeof<[UInt8; 9223372036854775806]?>() == 9223372036854775807, "an Optional of Int.max bytes")
static_assert(sizeof<([UInt8; 4611686018427387904], [UInt8; 4611686018427387903])>() == 9223372036854775807, "a tuple of Int.max bytes")
static_assert(sizeof<Buf<9223372036854775807>>() == 9223372036854775807, "a generic instance of Int.max bytes")

func main() {
    print(1)
}
