// Body rules inside a trait's default method bodies.
func probe_run(f: (Int) -> Int) -> Int { f(1) }

enum ProbeSlot { case Empty, case Full(item: String) }

trait ProbeShape {
    func area(&self) -> Int

    func doubled(&self) -> Int {
        let k = 2
        probe_run({ x: Int in x * k })   // refuses: closure-capture
    }

    func steal(&self, s: &var ProbeSlot) -> String {
        match s {
            case Empty -> "",
            case Full(item) -> move item   // refuses: borrowed-match-payload
        }
    }
}
