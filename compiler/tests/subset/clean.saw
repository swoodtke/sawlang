// Code the checker must accept: the full language, including shapes the
// compiler's source once left out because Stage 0 built it.
import std.file.{File}
import std.box.{Box}
import sawlex.{lex, LexResult}

type Offset = Int

public struct CleanNode {
    kind: Int
    private next: Int
}

enum CleanShape { case Leaf(value: Int), case Pair(left: Int, right: Int) }

extension CleanNode {
    func with_kind(&self, kind: Int) -> CleanNode {
        CleanNode(kind: kind, next: self.next)
    }
}

func clean_scaled(n: Int) -> Int {
    let factor = 3
    let scale = { x: Int in x * factor + n }
    scale(2)
}

func clean_ratio() -> Bool {
    let ratio = 1.5
    ratio > 1.0
}

func clean_boxed(n: Int) -> Int {
    let held = Box(n)
    match held {
        case Ok(b) -> 1,
        case Err(_) -> 0
    }
}

func clean_absent(v: Int?) -> Bool {
    v == None
}

func clean_offset(at: Offset) -> Offset {
    at + 1
}
