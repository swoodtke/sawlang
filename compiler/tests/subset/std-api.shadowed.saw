// Std calls off the allowlist, after the build declares methods of those names.
struct ProbeArena { n: Int }

extension ProbeArena {
    func insert(&var self, k: String, n: Int) -> Result<Int?, Int> { return 0 }
    func pop(&var self) -> Int? { None }
    func keys(&self) -> Result<Int, Int> { return 0 }
    func sort(&var self) {}
    func tidy(&var self) {}
}

func probe_calls(m: &var Map<String, Int>, v: &var Vector<Int>) -> Int {
    let old = try! m.insert("k", 1)   // refuses: std-api
    let last = v.pop()   // refuses: std-api
    let keys = try! m.keys()   // refuses: std-api
    v.sort()   // refuses: std-api
    3
}

func arena_calls(a: &var ProbeArena) -> Int {
    let old = try! a.insert("k", 1)
    let last = a.pop()
    a.sort()
    a.tidy()
    3
}

func untraced_calls(pair: (ProbeArena, Int)) {
    var copy = pair
    copy.0.sort()   // refuses: index-receiver-call, std-api
    copy.0.tidy()   // refuses: index-receiver-call
}
