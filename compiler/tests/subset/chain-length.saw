// Operator, postfix and `else if` chains longer than 100 terms, each beside
// one of exactly 100.
struct Link { a: Int }

func operator_fixture(n: Int) -> Int {
    let long = n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n   // refuses: chain-length
    let fine = n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n + n
    fine
}

func postfix_fixture(link: Link) -> Int {
    let long = link.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a   // refuses: chain-length
    let fine = link.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a.a
    fine
}

func arms_fixture(n: Int) -> Int {
    if n == 0 { 0 } else if n == 1 { 1 } else if n == 2 { 2 } else if n == 3 { 3 } else if n == 4 { 4 } else if n == 5 { 5 } else if n == 6 { 6 } else if n == 7 { 7 } else if n == 8 { 8 } else if n == 9 { 9 } else if n == 10 { 10 } else if n == 11 { 11 } else if n == 12 { 12 } else if n == 13 { 13 } else if n == 14 { 14 } else if n == 15 { 15 } else if n == 16 { 16 } else if n == 17 { 17 } else if n == 18 { 18 } else if n == 19 { 19 } else if n == 20 { 20 } else if n == 21 { 21 } else if n == 22 { 22 } else if n == 23 { 23 } else if n == 24 { 24 } else if n == 25 { 25 } else if n == 26 { 26 } else if n == 27 { 27 } else if n == 28 { 28 } else if n == 29 { 29 } else if n == 30 { 30 } else if n == 31 { 31 } else if n == 32 { 32 } else if n == 33 { 33 } else if n == 34 { 34 } else if n == 35 { 35 } else if n == 36 { 36 } else if n == 37 { 37 } else if n == 38 { 38 } else if n == 39 { 39 } else if n == 40 { 40 } else if n == 41 { 41 } else if n == 42 { 42 } else if n == 43 { 43 } else if n == 44 { 44 } else if n == 45 { 45 } else if n == 46 { 46 } else if n == 47 { 47 } else if n == 48 { 48 } else if n == 49 { 49 } else if n == 50 { 50 } else if n == 51 { 51 } else if n == 52 { 52 } else if n == 53 { 53 } else if n == 54 { 54 } else if n == 55 { 55 } else if n == 56 { 56 } else if n == 57 { 57 } else if n == 58 { 58 } else if n == 59 { 59 } else if n == 60 { 60 } else if n == 61 { 61 } else if n == 62 { 62 } else if n == 63 { 63 } else if n == 64 { 64 } else if n == 65 { 65 } else if n == 66 { 66 } else if n == 67 { 67 } else if n == 68 { 68 } else if n == 69 { 69 } else if n == 70 { 70 } else if n == 71 { 71 } else if n == 72 { 72 } else if n == 73 { 73 } else if n == 74 { 74 } else if n == 75 { 75 } else if n == 76 { 76 } else if n == 77 { 77 } else if n == 78 { 78 } else if n == 79 { 79 } else if n == 80 { 80 } else if n == 81 { 81 } else if n == 82 { 82 } else if n == 83 { 83 } else if n == 84 { 84 } else if n == 85 { 85 } else if n == 86 { 86 } else if n == 87 { 87 } else if n == 88 { 88 } else if n == 89 { 89 } else if n == 90 { 90 } else if n == 91 { 91 } else if n == 92 { 92 } else if n == 93 { 93 } else if n == 94 { 94 } else if n == 95 { 95 } else if n == 96 { 96 } else if n == 97 { 97 } else if n == 98 { 98 } else if n == 99 { 99 } else if n == 100 { 100 } else { 101 }   // refuses: chain-length
}

