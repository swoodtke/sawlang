// A prefix operator beside an `as` cast, spelled so both parsers read it
// alike: the prefix expression parenthesized as the cast's operand, the cast
// (or a chain of casts) parenthesized as the prefix's operand, a cast inside a
// call under the prefix, and `not`, whose cast to `Bool` means the same either
// way.
func same_fixture(n: Int) -> Int { n }

func grouped_fixture(x: Int32, m: UInt8, t: Bool) -> Int {
    let a = (-x) as Int
    let b = -(x as Int)
    let c = (~m) as UInt16
    let d = ~(m as UInt16)
    let e = -(x as Int16 as Int)
    let f = -same_fixture(x as Int)
    let g = not t as Bool
    print("neg {(-x) as Int} {-(x as Int)} {~(m as UInt16)}")
    if g {
        return a + b + e + f + (c as Int) + (d as Int)
    }
    a
}
