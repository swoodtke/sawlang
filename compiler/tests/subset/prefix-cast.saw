// A `-` whose operand is an unparenthesized `as` cast: Stage 0 casts first,
// GRAMMAR.md negates first. Parenthesizing the operand alone, `-(x)`, leaves the
// cast outside it.
func widen_fixture(x: Int32) -> Int {
    let a = -x as Int   // refuses: prefix-cast
    let b = -(x) as Int   // refuses: prefix-cast
    let c = -(x as Int16) as Int   // refuses: prefix-cast
    let d = -1 as Int32   // refuses: prefix-cast
    let e = -(-x) as Int   // refuses: prefix-cast
    print("neg {-x as Int}")   // refuses: prefix-cast
    a + b + c + (d as Int) + e
}

func negate_fixture(x: Int32) -> Int {
    return -x as Int   // refuses: prefix-cast
}
