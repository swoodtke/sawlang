// A `&var self` method through `get`, spelled with `!` and with `?.`.
struct Entry { n: Int }

extension Entry {
    func bump(&var self) { self.n = self.n + 1 }
}

func main() {
    var v: Vector<Entry> = [Entry(n: 1)]
    v.get(0)!.bump()   // refuses: std-api
    print(v[0].n)
    v.get(0)?.bump()   // refuses: std-api
    print(v[0].n)
    v[0].bump()   // refuses: index-receiver-call
    print(v[0].n)
}
