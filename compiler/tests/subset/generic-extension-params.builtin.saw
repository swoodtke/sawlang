// An extension head naming `Result` without its parameters. The typechecker
// declares it itself, so no std source does: a bare `Result` crashes Stage 0 as
// a build generic's does (SL:hazards L18; probe g3). The message says to write
// the parameters, which Stage 0 accepts for `Result`.
extension Result {   // refuses: generic-extension-params
    func res_mark(&self) -> Int { 1 }
}

extension Result<T, E> {
    func res_tag(&self) -> Int { 3 }
}
