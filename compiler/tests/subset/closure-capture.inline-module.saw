// Body rules inside an inline `module m { ... }`, which is itself refused.
module probe_inner {   // refuses: inline-module
    public func apply_it(f: (Int) -> Int) -> Int { f(1) }

    public func capture_in_module(n: Int) -> Int {
        let k = 2
        apply_it({ x: Int in x + k })   // refuses: closure-capture
    }

    public func alias_free(v: &var Vector<Int>) {
        v[0] = v[0] * 2   // refuses: root-reuse
    }
}

func main() {
    print(probe_inner.capture_in_module(1))
}
