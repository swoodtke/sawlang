// Array literals that adopt a written `Vector` type: a struct field, a
// non-generic argument inside a tuple, a function's tail, and a closure's value
// passed to a parameter whose function type is written.
struct Bag { items: Vector<Int> }

extension Bag: NoCopy {}

func sum_of(v: Vector<Int>) -> Int { v.len() }

func make_items() -> Vector<Int> { [4, 5, 6] }

func apply_vec(f: (Int) -> Vector<Int>) -> Int {
    let v = f(3)
    v.len()
}

func main() {
    let bag = Bag(items: [7, 8])
    let pair = (sum_of([9]), 1)
    let made = apply_vec({ x: Int in [x, x] })
    print(bag.items.len() + pair.0 + make_items().len() + made)
}
