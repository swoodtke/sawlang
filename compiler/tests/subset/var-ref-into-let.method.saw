// An implicit `&var` through a mutating method on a `let` root's field (SL:hazards S5).
struct Counter { n: Int }

extension Counter {
    func bump(&var self) { self.n = self.n + 1 }
}

struct Holder { c: Counter }

func main() {
    let h = Holder(c: Counter(n: 1))
    h.c.bump()   // refuses: var-ref-into-let
    print(h.c.n)
}
