// An unsuffixed integer literal above Int.max, outside a `UInt64` binding.
func big_fixture() -> Int {
    let a = 18446744073709551615   // refuses: int-literal-range
    let b = 18446744073709551615u64
    let c = 0xFFFF_FFFF_FFFF_FFFF   // refuses: int-literal-range
    let d = 9223372036854775807
    let e: Int = 9223372036854775808   // refuses: int-literal-range
    let g = -9223372036854775809   // refuses: int-literal-range
    print("big {18446744073709551615}")   // refuses: int-literal-range
    // An element of a `UInt64`-typed array literal adopts the element type.
    let t: [UInt64; 2] = [0xFFFF_FFFF_FFFF_FFFF, 1]   // refuses: fixed-array
    let u = [0xFFFF_FFFF_FFFF_FFFF, 1]   // refuses: int-literal-range fixed-array
    3
}
