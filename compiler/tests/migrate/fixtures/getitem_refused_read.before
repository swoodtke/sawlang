// EXPECT: success
// EXPECT-OUTPUT: 1

struct Grid { cells: [Int; 2], visits: Int }

extension Grid {
    func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Grid.[]: index out of range") }
        lend self.cells[i]
        self.visits = self.visits + 1
    }
}

func main() {
    var g = Grid(cells: [1, 2], visits: 0)
    print(g[0])
}
