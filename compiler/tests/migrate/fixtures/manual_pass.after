struct Cell { n: Int }
struct Res { n: Int }
extension Res: NoCopy {}
enum Slot { case Empty, case Full(res: Res) }
extension Slot: NoCopy {}

func main() {
    var m = Map<String, Cell>()
    let _ = m.insert("k", Cell(n: 1))
    let key = "k"
    borrow var m.find(&key)?.n = 5
    var v = Vector<Slot>()
    try! v.push(Slot.Full(res: Res(n: 3)))
    let n = borrow let lent = v[0] { match lent {
        case Empty -> 0
        case Full(borrow let r) -> r.n
    } }
    var w: Vector<Cell> = [Cell(n: 1)]
    borrow var w[0].n = 2
    print(n)
}
