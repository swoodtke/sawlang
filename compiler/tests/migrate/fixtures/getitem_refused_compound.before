// EXPECT: success
// EXPECT-OUTPUT: done

struct Bag { cells: [Int; 2] }

extension Bag {
    func [](&var self, i: Int) borrows -> &var Int {
        if i < 0 || i >= 2 { panic("Bag.[]: index out of range") }
        lend self.cells[i]
    }
}

func main() {
    var b = Bag(cells: [1, 2])
    b[0] += 1
    print("done")
}
