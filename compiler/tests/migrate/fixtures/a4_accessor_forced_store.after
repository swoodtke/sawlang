struct Cell { n: Int }
struct Bag { a: Cell, b: Cell, count: Int }
extension Bag: NoCopy {}
extension Bag {
    public func at(&var self, i: Int) borrows -> &var Cell {
        if i == 0 { lend self.a } else { lend self.b }
    }
    public func slot(&var self, i: Int) borrows -> &var Cell? {
        if i > 1 { return None }
        if i == 0 { lend self.a } else { lend self.b }
    }
    public func total(&var self) borrows -> &var Int {
        lend self.count
    }
}

func make() -> Bag { Bag(a: Cell(n: 1), b: Cell(n: 2), count: 0) }

func main() {
    var b = make()
    borrow var b.slot(0)! = Cell(n: 3)
    print(b.a.n)
}
