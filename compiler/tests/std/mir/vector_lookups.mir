    }

    bb5: {
        _6 = T?::None;
        _0 = move _6;
        return;
    }

    bb6: {
        goto -> bb1;
    }

    bb7: {
        _7 = copy ((*_1).buffer as Some).0;
        _9 = copy _2;
        _10 = T?::Some(copy _7[_9]);
        _0 = move _10;
        return;
    }

    bb8: {
        _8 = T?::None;
        _0 = move _8;
        return;
    }
}

fn prologue std.vector.Vector.find(index: Int) -> (&var T)? {
    let _0: (&var T)?;  // return
