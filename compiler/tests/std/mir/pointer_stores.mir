fn Optional.take_payload() -> T? {
    let _0: T?;  // return
    let _1: &var T?;  // self
    let _2: UnsafePointer<T?>;  // at
    let _3: &var T?;
    let _4: UnsafePointer<T?>;
    let _5: T?;  // held
    let _6: Int;
    let _7: Int;
    let _8: T?;

