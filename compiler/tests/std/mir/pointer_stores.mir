// The std's stores through a raw pointer as sawc lowers them against std/
// (SL-512). A whole pointer slot tracks no occupancy, so each store is a
// placement that drops nothing first: `Box.make` and `Vector.push` write a
// fresh slot, and `Vector.set` and `Optional.take_payload` write one their
// own `move` has just emptied.
// function: fn std.box.Box.make(value: T)
// function: fn std.vector.Vector.push(value: T)
// function: fn std.vector.Vector.set(index: Int, value: T)
// function: fn Optional.take_payload()
fn std.box.Box.make(value: T) -> Result<std.box.Box<T, A>, std.alloc.AllocError> {
    let _0: Result<std.box.Box<T, A>, std.alloc.AllocError>;  // return
    let _1: T;  // param value
    let _2: Int;  // size
    let _3: Int;
    let _4: Int;  // align
    let _5: Int;
    let _6: A;
    let _7: Int;
    let _8: Int;
    let _9: &A;
    let _10: UnsafePointer<Int8>?;
    let _11: UnsafePointer<Int8>;  // raw
    let _12: UnsafePointer<T>;  // ptr
    let _13: UnsafePointer<T>;
    let _14: Int;
    let _15: std.box.Box<T, A>;
    let _16: Result<std.box.Box<T, A>, std.alloc.AllocError>;
    let _17: std.alloc.AllocError;
    let _18: Result<std.box.Box<T, A>, std.alloc.AllocError>;

    bb0: {
        _3 = call builtin sizeof (inst T) [] -> [return: bb1];
    }

    bb1: {
        _2 = move _3;
        _5 = call builtin alignof (inst T) [] -> [return: bb2];
    }

    bb2: {
        _4 = move _5;
        _6 = call builtin init (owner A) [] -> [return: bb4];
    }

    bb3: {
        _17 = std.alloc.AllocError { size: copy _2, align: copy _4 };
        _18 = Result<std.box.Box<T, A>, std.alloc.AllocError>::Err(move _17);
        _0 = move _18;
        drop(_1);
        return;
    }

    bb4: {
        _7 = copy _2;
        _8 = copy _4;
        _9 = ref(shared, _6);
        _10 = call std.alloc.Allocator.alloc(size: Int, align: Int) (owner A) [move _9, move _7, move _8] -> [return: bb5] suspends when A.Allocator.alloc;
    }

    bb5: {
        switch discriminant(_10) -> [Some: bb6, None: bb7];
    }

    bb6: {
        _11 = copy (_10 as Some).0;
        _13 = cast(copy _11 as UnsafePointer<T>);
        _12 = move _13;
        _14 = const 0: Int;
        _12[_14] = move _1;
        _15 = std.box.Box<T, A> { ptr: copy _12 };
        _16 = Result<std.box.Box<T, A>, std.alloc.AllocError>::Ok(move _15);
        _0 = move _16;
        drop(_6);
        drop(_1);
        return;
    }

    bb7: {
        drop(_6);
        goto -> bb3;
    }
}

