// The new std's in-place drop as sawc lowers it against std/ (SL-662): the
// intrinsic it is written over is a drop of the pointee's place, `(*_2)`, so
// the value's glue runs at the address it lives at. A move out into a
// temporary first would destroy a `NoMove` value away from its home.
// function: fn std.mem.drop_in_place(at: UnsafePointer<T>)
fn std.mem.drop_in_place(at: UnsafePointer<T>) -> Void {
    let _0: Void;  // return
    let _1: UnsafePointer<T>;  // param at
    let _2: UnsafePointer<T>;

    bb0: {
        _2 = copy _1;
        drop((*_2));
        return;
    }
}
