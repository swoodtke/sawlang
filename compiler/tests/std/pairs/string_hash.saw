// A String feeds a Hasher one byte at a time, each as an unsigned `Int`, with
// no length prefix. Each digest is compared with a hasher fed those bytes by
// hand, so a feed that differs in the new std fails here whatever `finish`
// computes.

func digest(text: String) -> Int {
    var h = Hasher()
    text.hash(&var h)
    h.finish()
}

// The digest of a hasher fed exactly `words`, in order.
func fed(words: Vector<Int>) -> Int {
    var h = Hasher()
    for w in words.iter() {
        h.write_int(w)
    }
    h.finish()
}

func main() -> Int {
    assert(digest("") == fed([]), "the empty string feeds nothing")
    assert(digest("a") == fed([97]), "a one-byte feed")
    assert(digest("hello") == fed([104, 101, 108, 108, 111]), "an ASCII feed")
    assert(digest("a\0b") == fed([97, 0, 98]), "an interior NUL is fed")
    assert(digest("h\u{e9}llo") == fed([104, 195, 169, 108, 108, 111]), "UTF-8 bytes feed unsigned")
    assert(digest("zero") == fed([122, 101, 114, 111]), "a literal pattern's text")
    0
}
