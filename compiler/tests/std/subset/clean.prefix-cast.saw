// A prefix operator over an unparenthesized `as` cast, which the compiler
// profile refuses: only sawc2 reads `std/`, and it reads `~m as UInt16` as
// GRAMMAR.md's `(~m) as UInt16`, so the std profile accepts every spelling.

public func widened_complement(m: UInt8) -> UInt16 {
    ~m as UInt16
}

public func widened_negation(x: Int32) -> Int {
    let a = -x as Int
    let b = -(x as Int)
    a + b
}
