// A `Thread.spawn` brace's capture list, read and accepted: the brace
// captures nothing implicitly and takes no parameters, so the list is
// its parameter list, and a captured name is the brace's own binding.

func add_one(n: Int) -> Int {
    n + 1
}

public func spawn_and_join(n: Int) -> Int {
    let spawned = Thread.spawn({ [n] in add_one(n) })
    match spawned {
        case Ok(worker) -> {
            var held = move worker
            held.join()
        },
        case Err(_) -> 0
    }
}
