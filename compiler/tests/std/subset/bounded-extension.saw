// A std extension may bound an allocator parameter, and an element on a
// policy trait a conditional conformance needs; nothing else.

public struct Pair<T> {
    first: T
}

extension Pair<T: Equatable> { // refuses: bounded-extension
    public func same(&self, other: &Pair<T>) -> Bool {
        self.first == other.first
    }
}

extension Pair<T: Send>: UnsafeSend {}
