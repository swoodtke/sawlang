// An ordinary closure keeps the subset's ban on capture lists and on
// captures, however the `Thread.spawn` brace's list is admitted.

func run(body: () -> Int) -> Int {
    body()
}

public func listed(n: Int) -> Int {
    run({ [n] in 1 }) // refuses: closure-capture
}

public func implicit(n: Int) -> Int {
    run({ n + 1 }) // refuses: closure-capture
}
