// Specialized extensions, whose head arguments name types.

public struct Pair<T> {
    first: T
    second: T
}

extension Vector<String> {
    public func total_bytes(&self) -> Int {
        var total = 0
        var i = 0
        while i < self.len() {
            total = total + self[i].len()
            i = i + 1
        }
        total
    }
}

extension Pair<Int> {
    public func sum(&self) -> Int {
        self.first + self.second
    }
}
