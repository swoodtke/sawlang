// A methods-only extension that declares a hook-named member keeps the
// policy-only bound: a compiler-inserted call (interpolation, here) reaches
// `format` by name, not through a written call whose bound typecheck checked.

public struct Pair<T> {
    first: T
}

extension Pair<T: Printable> { // refuses: bounded-extension
    public func format(&self) -> Int {
        1
    }
}
