// The std profile's cooperative-task feature, accepted: a std module declares
// the task vocabulary over a park point, and another names it.

import std.task.{yield_now}

public func cancelled() -> Bool {
    false
}

public func sleep(duration: Duration) {
    yield_now()
}

public func pause_twice() {
    yield_now()
    sleep(Duration.ms(1))
    if cancelled() {
        return
    }
    yield_now()
}
