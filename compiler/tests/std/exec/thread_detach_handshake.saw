// The detach handshake in both orders, on threads `Thread.spawn` starts, with
// an owning result that says when it is destroyed (runtime/ABI.md,
// `__saw_rt_thread_detach`):
//   * detach then exit: the body returns only once its handle has detached,
//     so the thread's exit (`Thread.__saw_exit`) reads the detacher's 0,
//     destroys the result nobody will read and frees the block;
//   * exit then detach: the body returns at once and the handle detaches well
//     after, so the seam reports that the caller owns the block, and `detach`
//     destroys the result and frees it;
//   * a join takes the result and frees the block itself.
// Each result is destroyed exactly once whichever side ends the handshake, so
// the output holds in either order; the waits make the second order the one a
// run takes.
import std.task.{Thread}

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static NAP_NANOS: UInt64 = 1_000_000
// Far longer than a body's return takes to reach its exit.
static SETTLE_NANOS: UInt64 = 50_000_000

static DETACHED: Atomic<Int> = Atomic(0)
static RETURNED: Atomic<Int> = Atomic(0)
static DESTROYED: Atomic<Int> = Atomic(0)

// A result that says when it is destroyed.
struct Loud {
    id: Int
}

extension Loud: NoCopy {
    func deinit(&var self) {
        print("result {} destroyed", self.id)
        let _ = DESTROYED.fetch_add(1)
    }
}

func wait_destroyed(count: Int) {
    while DESTROYED.load() < count {
        __saw_rt_sleep_ns(NAP_NANOS)
    }
}

func detach_then_exit() {
    var t = try! Thread.spawn {
        while DETACHED.load() == 0 {
            __saw_rt_sleep_ns(NAP_NANOS)
        }
        Loud(id: 1)
    }
    t.detach()
    DETACHED.store(1)
    wait_destroyed(1)
    print("detach then exit: the result was destroyed once")
}

func exit_then_detach() {
    var t = try! Thread.spawn {
        RETURNED.store(1)
        Loud(id: 2)
    }
    while RETURNED.load() == 0 {
        __saw_rt_sleep_ns(NAP_NANOS)
    }
    __saw_rt_sleep_ns(SETTLE_NANOS)
    t.detach()
    wait_destroyed(2)
    print("exit then detach: the result was destroyed once")
}

func join_takes_it() {
    var t = try! Thread.spawn { Loud(id: 3) }
    let got = t.join()
    print("joined result {}", got.id)
}

func main() {
    print("the detach handshake, both orders")
    detach_then_exit()
    exit_then_detach()
    join_takes_it()
    print("results destroyed: {}", DESTROYED.load())
}
