// `Thread<T>.join` takes the result a `Thread.spawn` body returned: the
// trampoline stores it in the control block, the thread's exit leaves the
// block to the handle, and the join moves the result out and frees the block.
// A result that owns its bytes arrives whole. At `T = Void` the result slot
// is zero-sized and `join()` is a statement. A capture crosses as the body's
// parameter: the environment is moved to the heap at the spawn and the body
// takes each capture out of it.
import std.task.{Thread}

func main() {
    let base = 40
    var number = try! Thread.spawn { [base] in base + 2 }
    print("joined {}", number.join())
    let owned = "a result that owns its bytes"
    var text = try! Thread.spawn { [owned] in owned }
    let got = text.join()
    print("joined `{}`", got)
    var nothing = try! Thread.spawn { print("void body ran") }
    nothing.join()
    print("joined the Void thread")
}
