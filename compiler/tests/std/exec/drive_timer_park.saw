// expect-panic: `__saw_drive(...)` at the site: the driven frame recorded park word 1000000, which names no park
// A drive point resumes a ready yield at once, and hands a timer park to the
// executor's sweep, which idles until the deadline the frame's context
// records; each counts as one `Pending` (SL-645, SL:coroutines A11). A frame
// that records a park word no park has is refused, naming the word and the
// site, rather than waited on.

import std.taskgroup.{FrameDescriptor, Poll, TaskContext}
import std.taskgroup.{__saw_exec_drive, __saw_exec_drive_steps, __saw_exec_timer_deadline}

extern "C" {
    func __saw_rt_clock_monotonic_nanos() -> Int64
}

struct Sleeper {
    state: Int
    deadline: UInt64
}

// Yields, sleeps, then is done; then, started again, records a park word
// that names no park.
func sleeper_resume(frame: UnsafePointer<UInt8>, cx: UnsafePointer<TaskContext>) unsafe -> Poll {
    let f = frame as UnsafePointer<Sleeper>
    let state = f[0].state
    f[0].state = state + 1
    if state == 0 {
        print("sleeper yields")
        cx[0].park[0] = 0
        return Poll.Pending
    }
    if state == 1 {
        print("sleeper sleeps")
        f[0].deadline = __saw_exec_timer_deadline(2000000)
        cx[0].deadline = f[0].deadline
        cx[0].park[0] = 1
        return Poll.Pending
    }
    if state == 2 {
        let now = __saw_rt_clock_monotonic_nanos() as UInt64
        print("sleeper wakes at its deadline: {}", now >= f[0].deadline)
        return Poll.Ready
    }
    print("sleeper parks")
    cx[0].park[0] = 1000000
    Poll.Pending
}

func drop_nothing(at: UnsafePointer<UInt8>) unsafe {
}

func run() unsafe {
    let sleeper = FrameDescriptor(resume: { f, c in sleeper_resume(f, c) },
                                  size: sizeof<Sleeper>(), align: alignof<Sleeper>(),
                                  result_offset: 0, result_size: 0, result_align: 1,
                                  drop_result: { p in drop_nothing(p) }, backtrace: -1)
    let d = (&sleeper) as UnsafePointer<FrameDescriptor>
    var storage = Sleeper(state: 0, deadline: 0)
    let frame = (&storage) as UnsafePointer<UInt8>
    print("{} steps", __saw_exec_drive_steps(d, frame, "`__saw_drive_steps(...)` at the site"))
    __saw_exec_drive(d, frame, "`__saw_drive(...)` at the site")
    print("drove")
}

func main() {
    run()
}
