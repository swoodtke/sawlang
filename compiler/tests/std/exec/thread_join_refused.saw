// expect-panic: Thread.join: joining the thread failed (errno 11)
// A join the operating system refuses panics with the cause (SL-768): a
// thread handed its own handle joins itself, which `pthread_join` refuses
// with `EDEADLK`, and `Thread.join`, which has no error channel, panics
// naming it rather than reading a result slot nothing wrote. The handle
// reaches its own thread over a channel. macOS only: `EDEADLK` is 11 there.
import std.channel.{Channel}
import std.task.{Thread}

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static NAP_NANOS: UInt64 = 10_000_000
// Ten seconds of naps: far longer than the thread takes to reach its join.
static MOST_NAPS: Int = 1000

func main() {
    let handles = try! Channel<Thread<Int>>()
    var t = try! Thread.spawn { [handles] in
        var own = handles.recv()
        print("joining my own handle")
        own.join()
    }
    try! handles.send(move t)
    var naps = 0
    while naps < MOST_NAPS {
        __saw_rt_sleep_ns(NAP_NANOS)
        naps = naps + 1
    }
    print("unreachable: the thread never joined")
}
