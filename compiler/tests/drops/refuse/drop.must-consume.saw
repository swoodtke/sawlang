// refuses: drop.must-consume at 12:19
// A `Task.spawn` handle bound and never given a fate reaches its scope's
// implicit drop: it must reach `join()`, `detach()` or `cancel()` on every
// path. The refusal stands at the spawn site, which minted the obligation.

func work(n: Int) -> Int {
    n * 2
}

func main() {
    let n = 4
    let pending = Task.spawn(work(n))
    print(n)
}
