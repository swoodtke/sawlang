module conditional

fn conditional.take(r: conditional.Res) -> Int {
    let _0: Int;  // return
    let _1: conditional.Res;  // param r

    bb0: {
        _0 = copy _1.id;
        drop(_1);
        return;
    }

    glue conditional.Res: structural
}

fn conditional.maybe(keep: Bool) -> Int {
    let _0: Int;  // return
    let _1: Bool;  // param keep
    let _2: conditional.Res;  // r
    let _3: conditional.Res;
    let _4: Int;  // n
    let _5: Int;
    let _6: Int;
    let _7: Bool;  // flag _2

    bb0: {
        _7 = const false: Bool;
        _3 = conditional.Res { id: const 1: Int };
        _2 = move _3;
        _7 = const true: Bool;
        _4 = const 0: Int;
        switch copy _1 -> [true: bb2, false: bb3];
    }

    bb1: {
        _6 = Add(copy _4, const 1: Int);
        _0 = move _6;
        switch copy _7 -> [true: bb5, false: bb6];
    }

    bb2: {
        _7 = const false: Bool;
        _5 = call conditional.take(r: conditional.Res) [move _2] -> [return: bb4];
    }

    bb3: {
        goto -> bb1;
    }

    bb4: {
        _4 = move _5;
        goto -> bb1;
    }

    bb5: {
        drop(_2);
        _7 = const false: Bool;
        goto -> bb6;
    }

    bb6: {
        return;
    }

    glue conditional.Res: structural
}

fn conditional.both(left: Bool) -> Int {
    let _0: Int;  // return
    let _1: Bool;  // param left
    let _2: conditional.Res;  // r
    let _3: conditional.Res;
    let _4: Int;
    let _5: Int;
    let _6: Int;

    bb0: {
        _3 = conditional.Res { id: const 2: Int };
        _2 = move _3;
        switch copy _1 -> [true: bb2, false: bb3];
    }

    bb1: {
        _5 = call conditional.take(r: conditional.Res) [move _2] -> [return: bb5];
    }

    bb2: {
        _4 = call conditional.take(r: conditional.Res) [move _2] -> [return: bb4];
    }

    bb3: {
        goto -> bb1;
    }

    bb4: {
        _0 = move _4;
        return;
    }

    bb5: {
        _6 = Add(move _5, const 1: Int);
        _0 = move _6;
        return;
    }
}

fn conditional.main() -> Void {
    let _0: Void;  // return
    let _1: Int;
    let _2: Int;
    let _3: Int;
    let _4: Int;
    let _5: Int;

    bb0: {
        _1 = call conditional.maybe(keep: Bool) [const true: Bool] -> [return: bb1];
    }

    bb1: {
        _2 = call conditional.maybe(keep: Bool) [const false: Bool] -> [return: bb2];
    }

    bb2: {
        _3 = Add(move _1, move _2);
        _4 = call conditional.both(left: Bool) [const true: Bool] -> [return: bb3];
    }

    bb3: {
        _5 = Add(move _3, move _4);
        call builtin print [move _5] -> [return: bb4];
    }

    bb4: {
        return;
    }
}
