// Drops and windows: a scope's exits run newest first, so a value declared
// inside a window's body is dropped before the window closes. A `for` over a
// borrowing struct keeps the iterator in its window and drops it at the
// loop's exit, before the window closes (golden `borrowing_struct`).

func iterate(v: Vector<String>) -> Int {
    var total = 0
    for s in v.iter() {
        let copied = s
        total = total + copied.len()
    }
    total
}

func inside(v: Vector<String>) -> Int {
    var total = 0
    borrow let first = v[0] {
        let label = first
        total = label.len()
    }
    total
}

func main() {
    var v = Vector<String>()
    try! v.push("a")
    var w = Vector<String>()
    try! w.push("bc")
    print(iterate(move v) + inside(move w))
}
