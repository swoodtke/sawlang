// A borrowing struct that owns something is destroyed before the window whose
// loan it carries closes, so a `deinit` may still read through its reference
// (SL:architecture §3.6): `main` drops the walker, then closes the window of
// `walk`, whose producer's body built it with `lends self`.

struct Shelf { items: Vector<Int> }
extension Shelf: NoCopy {}

borrows struct Walker {
    shelf: &Shelf,
    at: Int,
    tag: String
}

extension Walker: NoCopy {}

extension Walker: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.at >= self.shelf.items.len() {
            return None
        }
        let v = self.shelf.items[self.at]
        self.at = self.at + 1
        v
    }
}

extension Shelf {
    func walk(&self) borrows -> Walker {
        Walker(shelf: lends self, at: 0, tag: "walker")
    }
}

func main() {
    var s = Shelf(items: Vector<Int>())
    try! s.items.push(3)
    var sum = 0
    for x in s.walk() {
        sum = sum + x
    }
    print(sum)
}
