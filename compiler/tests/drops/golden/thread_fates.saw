// flags: --std-root std
// `Thread.spawn`'s accepted shapes: the obligation sits on the `Result`'s
// `Ok` payload, so `try!` and an `Ok(h)` arm carry it to the handle, the
// `Err` path owes nothing, the chained `(try! ...).join()` writes its fate
// where it is made, and a move into storage whose owner declares a `deinit`
// discharges it. None is refused. The `deinit` joins, so it is `blocking`,
// and `main` is declared `blocking` too: it joins and drops the pool, which
// only thread context may do.

import std.task.{Thread}

func work() -> Int {
    7
}

struct Pool {
    workers: Vector<Thread<Int>>
}

extension Pool: NoCopy {
    func deinit(&var self) blocking {
        while self.workers.len() > 0 {
            if let held = self.workers.pop() {
                var h = move held
                let _ = h.join()
            }
        }
    }
}

func bound() -> Int {
    var t = try! Thread.spawn { work() }
    t.join()
}

func matched() {
    let spawned = Thread.spawn { work() }
    match spawned {
        case Ok(h) -> {
            var t = move h
            t.detach()
        },
        case Err(_) -> print("refused")
    }
}

func chained() -> Int {
    (try! Thread.spawn { work() }).join()
}

func stored(pool: &var Pool) {
    var t = try! Thread.spawn { work() }
    try! pool.workers.push(move t)
}

func main() blocking {
    print(bound())
    matched()
    print(chained())
    var pool = Pool(workers: Vector<Thread<Int>>())
    stored(&var pool)
}
