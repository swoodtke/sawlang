}

fn generics.Holder.take(v: T) -> Int {
    let _0: Int;  // return
    let _1: &generics.Holder<T>;  // self
    let _2: T;  // param v

    bb0: {
        _0 = const 1: Int;
        drop(_2);
        return;
    }

    glue T: per instantiation
}

fn generics.Holder.hand(t: &T) -> Int {
    let _0: Int;  // return
    let _1: &generics.Holder<T>;  // self
    let _2: &T;  // param t
    let _3: T;
    let _4: &generics.Holder<T>;
    let _5: Int;

    bb0: {
        _3 = copy (*_2);
        _4 = ref(shared, (*_1));
        _5 = call generics.Holder.take(v: T) (owner generics.Holder<T>) [move _4, move _3] -> [return: bb1];
    }

    bb1: {
        _0 = move _5;
        return;
    }
}

fn generics.main() -> Void {
    let _0: Void;  // return
    let _1: std.vector.Vector<Int, std.alloc.GlobalAllocator>;  // v
    let _2: std.vector.Vector<Int, std.alloc.GlobalAllocator>;
    let _3: () -> Int;  // f
    let _4: () -> Int;
    let _5: () -> Int;  // g
    let _6: () -> Int;
    let _7: std.vector.Vector<Int, std.alloc.GlobalAllocator>;  // w
    let _8: std.vector.Vector<Int, std.alloc.GlobalAllocator>;
    let _9: generics.Holder<String>;  // h
    let _10: generics.Holder<String>;
    let _11: String;  // d
    let _12: Int;
    let _13: Int;
    let _14: Int;
    let _15: Int;
    let _16: Int;
    let _17: Int;
    let _18: Int;
    let _19: &String;
    let _20: &generics.Holder<String>;
    let _21: Int;
    let _22: Int;

    bb0: {
        _2 = vector [const 1: Int, const 2: Int]: std.vector.Vector<Int, std.alloc.GlobalAllocator>;
        _1 = move _2;
        _4 = call generics.later(x: T) (inst std.vector.Vector<Int, std.alloc.GlobalAllocator>) [move _1] -> [return: bb1];
    }

    bb1: {
        _3 = move _4;
        _6 = call generics.later_copy(x: T) (inst String) [const "abc": String] -> [return: bb2];
    }

    bb2: {
        _5 = move _6;
        _8 = vector [const 3: Int]: std.vector.Vector<Int, std.alloc.GlobalAllocator>;
        _7 = move _8;
        _10 = generics.Holder<String> { n: const 1: Int };
        _9 = move _10;
        _11 = const "d": String;
        _12 = call value copy _3 [] -> [return: bb3];
    }

    bb3: {
        _13 = call value copy _3 [] -> [return: bb4];
    }

    bb4: {
        _14 = Add(move _12, move _13);
        _15 = call value copy _5 [] -> [return: bb5];
    }

    bb5: {
        _16 = Add(move _14, move _15);
        _17 = call generics.copied(x: T) (inst std.vector.Vector<Int, std.alloc.GlobalAllocator>) [move _7] -> [return: bb6];
    }

    bb6: {
        _18 = Add(move _16, move _17);
        _19 = ref(shared, _11);
        _20 = ref(shared, _9);
        _21 = call generics.Holder.hand(t: &T) (owner generics.Holder<String>) [move _20, move _19] -> [return: bb7];
    }

    bb7: {
        _22 = Add(move _18, move _21);
        call builtin print [move _22] -> [return: bb8];
    }

    bb8: {
        drop(_11);
        drop(_5);
        drop(_3);
        return;
    }

    glue () -> Int: closure environment
    glue String: builtin
}
