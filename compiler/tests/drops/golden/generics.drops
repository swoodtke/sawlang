module generics

fn generics.measure(x: &T) -> Int {
    let _0: Int;  // return
    let _1: &T;  // param x

    bb0: {
        _0 = const 1: Int;
        return;
    }
}

fn generics.run(body: () -> Int) -> Int {
    let _0: Int;  // return
    let _1: () -> Int;  // param body
    let _2: Int;

    bb0: {
        _2 = call value copy _1 [] -> [return: bb1];
    }

    bb1: {
        _0 = move _2;
        drop(_1);
        return;
    }

    glue () -> Int: closure environment
}

fn generics.later(x: T) -> () -> Int {
    let _0: () -> Int;  // return
    let _1: T;  // param x
    let _2: () -> Int;

    bb0: {
        _2 = closure#0 of generics.later(x: T) [move _1];
        _0 = move _2;
        return;
    }
}

fn closure#0 of generics.later(x: T) -> Int {
    let _0: Int;  // return
    let _1: &(T,);  // env
    let _2: &T;  // ref x
    let _3: &T;
    let _4: Int;

    bb0: {
        _2 = ref(shared, (*_1).0);
        _3 = ref(shared, (*_2));
        _4 = call generics.measure(x: &T) (inst T) [move _3] -> [return: bb1];
    }

    bb1: {
        _0 = move _4;
        return;
    }
}

fn generics.later_copy(x: T) -> () -> Int {
    let _0: () -> Int;  // return
    let _1: T;  // param x
    let _2: () -> Int;

    bb0: {
        _2 = closure#0 of generics.later_copy(x: T) [move _1];
