    glue T: per instantiation
}

fn generics.copied(x: T) -> Int {
    let _0: Int;  // return
    let _1: T;  // param x
    let _2: &T;
    let _3: T;
    let _4: () -> Int;
    let _5: Int;

    bb0: {
        _2 = ref(shared, _1);
        _3 = call ExplicitCopy.copy() (owner T) [move _2] -> [return: bb1];
    }

    bb1: {
        _4 = closure#0 of generics.copied(x: T) [move _3];
        _5 = call generics.run(body: () -> Int) [move _4] -> [return: bb2];
    }

    bb2: {
        _0 = move _5;
        drop(_1);
        return;
    }

    glue T: per instantiation
}

fn closure#0 of generics.copied(x: T) -> Int {
    let _0: Int;  // return
    let _1: &(T,);  // env
    let _2: &T;  // ref x
    let _3: &T;
    let _4: Int;

    bb0: {
        _2 = ref(shared, (*_1).0);
        _3 = ref(shared, (*_2));
        _4 = call generics.measure(x: &T) (inst T) [move _3] -> [return: bb1];
