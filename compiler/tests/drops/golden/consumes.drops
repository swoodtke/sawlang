module consumes

fn consumes.Triple.middle(hot: Bool) -> consumes.Res {
    let _0: consumes.Res;  // return
    let _1: consumes.Triple;  // self
    let _2: Bool;  // param hot

    bb0: {
        switch copy _2 -> [true: bb2, false: bb3];
    }

    bb1: {
        _0 = move _1.b;
        drop(_1.c);
        drop(_1.a);
        return;
    }

    bb2: {
        _0 = move _1.b;
        drop(_1.c);
        drop(_1.a);
        return;
    }

    bb3: {
        goto -> bb1;
    }

    glue consumes.Res: structural
}

