log	"  --> examples/set_literal_not_hashable_error.saw:12:12"
log	"     |"
log	" 12 |     print(s.len())"
log	"     |            ^"
log	"   hint: `len` is only available when `T` satisfies `Hashable`"
log	""
log	"2 error(s) generated"
