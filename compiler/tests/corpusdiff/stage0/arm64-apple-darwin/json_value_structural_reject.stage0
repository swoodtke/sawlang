stdout	"unterminated_string: decode error at byte 0: the input ended in the middle of an item"
stdout	"unterminated_array: decode error at byte 4: the input ended in the middle of an item"
stdout	"depth_ok_at_limit: leaf=0"
stdout	"depth_exceeds_limit: decode error at byte 3: nesting is deeper than the decoder allows"
stdout	"duplicate_key_last_wins: a=2"
stdout	""
meets_expect	yes
