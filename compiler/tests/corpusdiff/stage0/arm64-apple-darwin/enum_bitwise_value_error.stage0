program	enum_bitwise_value_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	operator `|` requires integer operands, got `Perm` and `Perm`
meets_expect	yes
log	"error: operator `|` requires integer operands, got `Perm` and `Perm`"
log	"  --> examples/enum_bitwise_value_error.saw:37:18"
log	"     |"
log	" 37 |     let held = a | b"
log	"     |                  ^"
log	"   hint: an enum is a closed set of tags, not a bit set: write `(a as UInt8) | (b as UInt8)`. The result is the backing integer, because a combined value need not be a declared case"
log	""
log	"error: operator `<<` requires integer operands, got `Perm` and `Int`"
log	"  --> examples/enum_bitwise_value_error.saw:38:19"
log	"     |"
log	" 38 |     let moved = a << 1"
log	"     |                   ^"
log	"   hint: an enum is a closed set of tags, not a bit set: write `(e as UInt8) << n`. The result is the backing integer, because a combined value need not be a declared case"
log	""
log	"error: operator `~` requires an integer operand, got `Perm`"
log	"  --> examples/enum_bitwise_value_error.saw:39:19"
log	"     |"
log	" 39 |     let flipped = ~b"
log	"     |                   ^"
log	"   hint: an enum is a closed set of tags, not a bit set: write `~(e as UInt8)`. The result is the backing integer, because a combined value need not be a declared case"
log	""
log	"error: operator `|` requires integer operands, got `Color` and `Color`"
log	"  --> examples/enum_bitwise_value_error.saw:40:27"
log	"     |"
log	" 40 |     let mixed = Color.Red | Color.Blue"
log	"     |                           ^"
log	"   hint: `Color` has no raw backing, so its cases are not numbers — give it one (`enum Color: UInt8`, design 145) and project each operand with `as`"
log	""
log	"error: undefined variable `held`"
log	"  --> examples/enum_bitwise_value_error.saw:42:26"
log	"     |"
log	" 42 |     print(\"{} {} {} {}\", held, moved, flipped, mixed)"
log	"     |                          ^"
log	""
log	"error: undefined variable `moved`"
log	"  --> examples/enum_bitwise_value_error.saw:42:32"
log	"     |"
log	" 42 |     print(\"{} {} {} {}\", held, moved, flipped, mixed)"
log	"     |                                ^"
log	""
log	"error: undefined variable `flipped`"
log	"  --> examples/enum_bitwise_value_error.saw:42:39"
log	"     |"
log	" 42 |     print(\"{} {} {} {}\", held, moved, flipped, mixed)"
log	"     |                                       ^"
log	""
log	"error: undefined variable `mixed`"
log	"  --> examples/enum_bitwise_value_error.saw:42:48"
log	"     |"
log	" 42 |     print(\"{} {} {} {}\", held, moved, flipped, mixed)"
log	"     |                                                ^"
log	""
log	"8 error(s) generated"
