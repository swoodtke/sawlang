program	vector_literal_non_collection_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot assign `[Int; 3]` to variable of type `Int`
meets_expect	yes
log	"error: cannot assign `[Int; 3]` to variable of type `Int`"
log	"  --> examples/vector_literal_non_collection_error.saw:8:5"
log	"    |"
log	" 8 |     let x: Int = [1, 2, 3]"
log	"    |     ^"
log	""
log	"1 error(s) generated"
