program	errors/fixed_width_arith_literal_out_of_range.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	integer literal 999 does not fit in `Int8` (range -128..=127)
meets_expect	yes
log	"error: integer literal 999 does not fit in `Int8` (range -128..=127)"
log	"  --> examples/errors/fixed_width_arith_literal_out_of_range.saw:9:16"
log	"    |"
log	" 9 |     print((b + 999) as Int)"
log	"    |                ^"
log	""
log	"1 error(s) generated"
