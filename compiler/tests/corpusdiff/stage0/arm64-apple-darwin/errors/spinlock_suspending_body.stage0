program	errors/spinlock_suspending_body.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot suspend in a `sync` closure context: closure calls yield_now (closure suspends at line 17)
meets_expect	yes
log	"error: cannot suspend in a `sync` closure context: closure calls yield_now (closure suspends at line 17)"
log	"  --> examples/errors/spinlock_suspending_body.saw:16:16"
log	"     |"
log	" 16 |     COUNT.lock({ n in"
log	"     |                ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
