program	errors/unsafe_reference_param_triggers.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	function `peek` is not declared `unsafe`, but its signature receives a value of unsafe type (`UnsafePointer<Int8>`)
meets_expect	yes
log	"error: function `peek` is not declared `unsafe`, but its signature receives a value of unsafe type (`UnsafePointer<Int8>`)"
log	"  --> examples/errors/unsafe_reference_param_triggers.saw:8:1"
log	"    |"
log	" 8 | func peek(p: &UnsafePointer<Int8>) -> Int {"
log	"    | ^"
log	"   hint: write `func peek(...) unsafe` — the unsafety belongs in the signature where every caller can see it; if the operation is sound for every input, keep the wrapper unsafe and expose a safe one that checks its arguments"
log	""
log	"1 error(s) generated"
