program	errors/shadow_inner_let.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	`x` shadows the binding declared at shadow_inner_let.saw:12:5
meets_expect	yes
log	"error: `x` shadows the binding declared at shadow_inner_let.saw:12:5"
log	"  --> examples/errors/shadow_inner_let.saw:14:9"
log	"     |"
log	" 14 |         let x = compute()   // shadows outer x, never mentions it -> error"
log	"     |         ^"
log	"   hint: rename it, or derive it from the original (e.g. `let x = parse(move x)`) to make the redefinition explicit"
log	""
log	"1 error(s) generated"
