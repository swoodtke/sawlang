program	errors/sync_context_calls_a_closure_taking_helper.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` declaration: `sync func doubled` calls `apply` → a call through a non-`sync` function value (`apply` suspends at line 22)
meets_expect	yes
log	"error: cannot suspend in `sync func` declaration: `sync func doubled` calls `apply` → a call through a non-`sync` function value (`apply` suspends at line 22)"
log	"  --> examples/errors/sync_context_calls_a_closure_taking_helper.saw:24:1"
log	"     |"
log	" 24 | func doubled() sync -> Int { apply(1, { n: Int in n * 2 }) }"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
