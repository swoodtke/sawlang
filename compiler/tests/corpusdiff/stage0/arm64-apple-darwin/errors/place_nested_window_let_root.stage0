program	errors/place_nested_window_let_root.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot open an exclusive place window on immutable variable `frozen`
meets_expect	yes
log	"error: cannot open an exclusive place window on immutable variable `frozen`"
log	"  --> examples/errors/place_nested_window_let_root.saw:34:11"
log	"     |"
log	" 34 |     frozen[0][1].count += 10"
log	"     |           ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
