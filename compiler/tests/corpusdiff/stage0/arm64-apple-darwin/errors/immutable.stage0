program	errors/immutable.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot assign to immutable variable `x`
meets_expect	yes
log	"error: cannot assign to immutable variable `x`"
log	"  --> examples/errors/immutable.saw:7:5"
log	"    |"
log	" 7 |     x = 20"
log	"    |     ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
