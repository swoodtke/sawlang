program	errors/any_sync_suspend.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` declaration: `sync func compute` calls a call through `any Shape` dispatch (`compute` suspends at line 17)
meets_expect	yes
log	"error: cannot suspend in `sync func` declaration: `sync func compute` calls a call through `any Shape` dispatch (`compute` suspends at line 17)"
log	"  --> examples/errors/any_sync_suspend.saw:16:1"
log	"     |"
log	" 16 | func compute(s: &any Shape) sync -> Int {"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
