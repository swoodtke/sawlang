program	errors/sync_direct_suspend.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` declaration: `sync func handler` calls `suspends` → __saw_test_suspend (`suspends` suspends at line 8)
meets_expect	yes
log	"error: cannot suspend in `sync func` declaration: `sync func handler` calls `suspends` → __saw_test_suspend (`suspends` suspends at line 8)"
log	"  --> examples/errors/sync_direct_suspend.saw:11:1"
log	"     |"
log	" 11 | func handler() sync {"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
