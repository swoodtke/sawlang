program	errors/unsaferef_write_through_let_root.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot open an exclusive place window on immutable variable `r`
meets_expect	yes
log	"error: cannot open an exclusive place window on immutable variable `r`"
log	"  --> examples/errors/unsaferef_write_through_let_root.saw:27:6"
log	"     |"
log	" 27 |     r.deref().a = 7"
log	"     |      ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
