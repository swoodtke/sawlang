program	errors/sync_extension_method_suspend.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` method: method `Sensor.poll` calls __saw_test_suspend (`Sensor.poll` suspends at line 14)
meets_expect	yes
log	"error: cannot suspend in `sync func` method: method `Sensor.poll` calls __saw_test_suspend (`Sensor.poll` suspends at line 14)"
log	"  --> examples/errors/sync_extension_method_suspend.saw:13:5"
log	"     |"
log	" 13 |     func poll(&self) sync -> Int {"
log	"     |     ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
