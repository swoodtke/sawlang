program	errors/unsaferef_write_through_let_closure_capture.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot open an exclusive place window on immutable variable `h`
meets_expect	yes
log	"error: cannot open an exclusive place window on immutable variable `h`"
log	"  --> examples/errors/unsaferef_write_through_let_closure_capture.saw:26:28"
log	"     |"
log	" 26 |     run_int({ [move h] in h.deref().bump(); h.deref().n })"
log	"     |                            ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
