program	errors/place_write_immutable_root.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot open an exclusive place window on immutable variable `m`
meets_expect	yes
log	"error: cannot open an exclusive place window on immutable variable `m`"
log	"  --> examples/errors/place_write_immutable_root.saw:11:6"
log	"     |"
log	" 11 |     m[\"k\"]! = 5"
log	"     |      ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
