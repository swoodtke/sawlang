program	errors/sync_module_call.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` declaration: `sync func handler` calls `blockingRead` → __saw_test_suspend (`blockingRead` suspends at line 10)
meets_expect	yes
log	"error: cannot suspend in `sync func` declaration: `sync func handler` calls `blockingRead` → __saw_test_suspend (`blockingRead` suspends at line 10)"
log	"  --> examples/errors/sync_module_call.saw:15:1"
log	"     |"
log	" 15 | func handler() sync -> Int {"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
