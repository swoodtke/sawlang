program	errors/unsafe_mem_wo_read.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot `read()` a `WriteOnly` register
meets_expect	yes
log	"error: cannot `read()` a `WriteOnly` register"
log	"  --> examples/errors/unsafe_mem_wo_read.saw:8:31"
log	"    |"
log	" 8 | func main() { print(DEV.intclr.read()) }"
log	"    |                               ^"
log	""
log	"error: function `main` is not declared `unsafe`, but its body names a value of unsafe type (`UnsafeMemory<Regs, Device>`)"
log	"  --> examples/errors/unsafe_mem_wo_read.saw:8:21"
log	"    |"
log	" 8 | func main() { print(DEV.intclr.read()) }"
log	"    |                     ^"
log	"   hint: write `func main(...) unsafe` — the unsafety belongs in the signature where every caller can see it; if the operation is sound for every input, keep the wrapper unsafe and expose a safe one that checks its arguments"
log	""
log	"2 error(s) generated"
