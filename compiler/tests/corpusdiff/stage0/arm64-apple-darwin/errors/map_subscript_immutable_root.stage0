program	errors/map_subscript_immutable_root.saw
triple	arm64-apple-darwin
twin	differs
expect	error
build	refused	cannot open an exclusive place window on immutable variable `m`
meets_expect	yes
log	"error: cannot open an exclusive place window on immutable variable `m`"
log	"  --> examples/errors/map_subscript_immutable_root.saw:15:6"
log	"     |"
log	" 15 |     m[\"a\"]!.n += 1"
log	"     |      ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
