program	const_static_length_shadow.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	array length is not a compile-time constant: `REGION_SIZE` is not allowed here
meets_expect	yes
log	"error: array length is not a compile-time constant: `REGION_SIZE` is not allowed here"
log	"  --> examples/const_static_length_shadow.saw:15:22"
log	"     |"
log	" 15 |     var buf: [UInt8; REGION_SIZE] = [0; 4]"
log	"     |                      ^"
log	"   hint: a length is fixed at compile time — use an integer literal, a const generic parameter, a module `static` of type `Int` or `UInt` whose own initializer folds, the integer limits, a raw-backed enum case, `sizeof`/`alignof` of a primitive or pointer type, or arithmetic and bitwise operators over any of those"
log	""
log	"1 error(s) generated"
