program	array_explicit_copy_requires_move.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot copy value of type `[R; 2]` which implements ExplicitCopy
meets_expect	yes
log	"error: cannot copy value of type `[R; 2]` which implements ExplicitCopy"
log	"  --> examples/array_explicit_copy_requires_move.saw:15:5"
log	"     |"
log	" 15 |     let b = a          // ExplicitCopy array: needs `move` or `.copy()`"
log	"     |     ^"
log	"   hint: use .copy() for an explicit deep copy, or `move` to transfer ownership"
log	""
log	"1 error(s) generated"
