program	fixed_width_enum_payload_out_of_range_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	integer literal 999 does not fit in `Int8` (range -128..=127)
meets_expect	yes
log	"error: integer literal 999 does not fit in `Int8` (range -128..=127)"
log	"  --> examples/fixed_width_enum_payload_out_of_range_error.saw:8:20"
log	"    |"
log	" 8 |     let e = E.V(x: 999)"
log	"    |                    ^"
log	""
log	"1 error(s) generated"
