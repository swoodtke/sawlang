program	let_struct_field_assign_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot assign to field of immutable variable `p`
meets_expect	yes
log	"error: cannot assign to field of immutable variable `p`"
log	"  --> examples/let_struct_field_assign_error.saw:12:6"
log	"     |"
log	" 12 |     p.x = 5"
log	"     |      ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
