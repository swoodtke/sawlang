program	coro_while_head_move_reevaluates_per_iteration.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"fallthrough sync"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"fallthrough driven"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"continue sync"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"continue driven"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"while-let sync"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"while-let driven"
stdout	"drop 0"
stdout	"drop 1"
stdout	"drop 2"
stdout	"-> 2"
stdout	"never-enters sync"
stdout	"drop 9"
stdout	"-> 0"
stdout	"never-enters driven"
stdout	"drop 9"
stdout	"-> 0"
stdout	""
meets_expect	yes
