program	task_backtrace_panic.saw
triple	arm64-apple-darwin
twin	same
expect	panic
build	ok
exit	-6
stderr	"panic at task_backtrace_panic.saw:32: deliberate"
stderr	"saw tasks: 2 live (as-of panic, unsynchronized)"
stderr	"  task group 1 slot 0 gen 1 sleeping"
stderr	"    at task_backtrace_panic.saw:21 in panicking_leaf"
stderr	"    at task_backtrace_panic.saw:26 in panicking_worker"
stderr	"  task group 1 slot 1 gen 1 running"
stderr	"    at task_backtrace_panic.saw:31 in exploder"
stderr	""
meets_expect	yes
