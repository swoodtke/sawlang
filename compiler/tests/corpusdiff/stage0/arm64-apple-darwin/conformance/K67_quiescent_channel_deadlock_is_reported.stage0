program	conformance/K67_quiescent_channel_deadlock_is_reported.saw
triple	arm64-apple-darwin
twin	same
expect	panic
build	ok
exit	-6
stdout	"waiting"
stdout	""
stderr	"panic at taskgroup.saw:2452: deadlock: every task is waiting to receive from a channel, and nothing in this program can send. A channel has no sender count — every handle is the same handle — so a producer that is finished must say so with close(), and a receive on a closed, drained channel returns Err(Closed) instead of waiting"
stderr	"saw tasks: 1 live (as-of panic, unsynchronized)"
stderr	"  task group 1 slot 0 gen 1 channel-parked"
stderr	"    at K67_quiescent_channel_deadlock_is_reported.saw:30 in consume"
stderr	""
meets_expect	yes
