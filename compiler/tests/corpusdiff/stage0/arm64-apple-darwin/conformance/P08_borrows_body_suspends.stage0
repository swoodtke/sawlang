program	conformance/P08_borrows_body_suspends.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` method: method `C.slot` calls yield_now (`C.slot` suspends at line 14)
meets_expect	yes
log	"error: cannot suspend in `sync func` method: method `C.slot` calls yield_now (`C.slot` suspends at line 14)"
log	"  --> examples/conformance/P08_borrows_body_suspends.saw:13:5"
log	"     |"
log	" 13 |     func slot(&self) borrows -> &Int {"
log	"     |     ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
