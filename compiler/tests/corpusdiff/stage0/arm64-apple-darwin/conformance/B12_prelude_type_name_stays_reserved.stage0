log	"     |"
log	" 18 |     print(\"{Vector(x: 1).x}\")"
log	"     |             ^"
log	""
log	"error: no matching initializer for `Vector` with parameters: x"
log	"  --> examples/conformance/B12_prelude_type_name_stays_reserved.saw:18:13"
log	"     |"
log	" 18 |     print(\"{Vector(x: 1).x}\")"
log	"     |             ^"
log	"   hint: field init expects: buffer, capacity, length; available init methods: [[], ['capacity']]"
log	""
log	"error: struct `Vector` has no field `x`"
log	"  --> examples/conformance/B12_prelude_type_name_stays_reserved.saw:18:25"
log	"     |"
log	" 18 |     print(\"{Vector(x: 1).x}\")"
log	"     |                         ^"
