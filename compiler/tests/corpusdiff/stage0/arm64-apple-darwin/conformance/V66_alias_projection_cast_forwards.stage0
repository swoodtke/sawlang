log	"     |"
log	" 34 | func full_projection() -> Int {"
log	"     | ^"
log	""
log	"error: cannot copy value of type `Inner` which implements NoCopy"
log	"  --> examples/conformance/V66_alias_projection_cast_forwards.saw:42:5"
log	"     |"
log	" 42 |     let b = a as Inner          // error: NoCopy — same rule, one chain link up"
log	"     |     ^"
log	"   hint: use `move` to transfer ownership instead"
log	""
log	"error: function `partial_projection` should return `Int` but body has no value"
