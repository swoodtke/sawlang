program	conformance/K86_background_task_handle_panics_in_deinit.saw
triple	arm64-apple-darwin
twin	same
expect	panic
build	ok
exit	-6
stdout	"a group handle drops in silence"
stdout	"about to drop the keeper"
stdout	"the keeper forgot to join"
stdout	"panic at taskgroup.saw:1909: Task was dropped without being joined, detached or cancelled — `join()` waits for it and takes its result, `detach()` hands it to the process, `cancel()` asks it to stop"
stdout	"saw tasks: 2 live (as-of panic, unsynchronized)"
stdout	"  task group 1 slot 0 gen 1 ready"
stdout	"    at K86_background_task_handle_panics_in_deinit.saw:0 in work"
stdout	"  task group 2 slot 0 gen 1 ready"
stdout	"    at K86_background_task_handle_panics_in_deinit.saw:0 in work"
stdout	""
meets_expect	yes
