program	conformance/M19_assign_parameter.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot assign to immutable variable `n`
meets_expect	yes
log	"error: cannot assign to immutable variable `n`"
log	"  --> examples/conformance/M19_assign_parameter.saw:9:5"
log	"    |"
log	" 9 |     n = 5"
log	"    |     ^"
log	"   hint: consider using `var` instead of `let` to make it mutable"
log	""
log	"1 error(s) generated"
