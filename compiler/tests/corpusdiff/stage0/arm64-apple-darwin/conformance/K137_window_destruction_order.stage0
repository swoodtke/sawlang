program	conformance/K137_window_destruction_order.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"-- sync"
stdout	"iterator deinit, owner still has 3"
stdout	"after sync loop"
stdout	"walk 6"
stdout	"owner deinit"
stdout	"-- driven"
stdout	"iterator deinit, owner still has 3"
stdout	"after driven loop"
stdout	"walk 6"
stdout	"owner deinit"
stdout	"-- break on the first element"
stdout	"iterator deinit, owner still has 3"
stdout	"after break loop"
stdout	"walk 1"
stdout	"-- driven break"
stdout	"iterator deinit, owner still has 3"
stdout	"after driven break"
stdout	"walk 3"
stdout	"-- driven return"
stdout	"iterator deinit, owner still has 3"
stdout	"after driven return 3"
stdout	"-- driven continue to the outer loop"
stdout	"iterator deinit, owner still has 3"
stdout	"after inner 1"
stdout	"iterator deinit, owner still has 3"
stdout	"after inner 2"
stdout	"after outer"
stdout	"walk 12"
stdout	"-- driven try propagated"
stdout	"iterator deinit, owner still has 3"
stdout	"caught stop"
stdout	"-- owned driven"
stdout	"drop counter"
stdout	"after owned loop"
stdout	"walk 7"
stdout	"-- owned driven break"
stdout	"drop counter"
stdout	"after owned break"
stdout	"walk 3"
stdout	"owner deinit"
stdout	""
meets_expect	yes
