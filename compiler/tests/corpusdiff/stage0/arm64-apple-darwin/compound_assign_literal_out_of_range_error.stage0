program	compound_assign_literal_out_of_range_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	integer literal 300 does not fit in `Int8` (range -128..=127)
meets_expect	yes
log	"error: integer literal 300 does not fit in `Int8` (range -128..=127)"
log	"  --> examples/compound_assign_literal_out_of_range_error.saw:9:10"
log	"    |"
log	" 9 |     s += 300"
log	"    |          ^"
log	""
log	"1 error(s) generated"
