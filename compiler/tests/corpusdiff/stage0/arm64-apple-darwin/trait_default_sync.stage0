program	trait_default_sync.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` method: method `C.stepped` calls __saw_test_suspend (`C.stepped` suspends at line 10)
meets_expect	yes
log	"error: cannot suspend in `sync func` method: method `C.stepped` calls __saw_test_suspend (`C.stepped` suspends at line 10)"
log	"  --> examples/trait_default_sync.saw:16:1"
log	"     |"
log	" 16 | extension C: Counter {"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
