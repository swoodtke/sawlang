stdout	"-- dropping map"
stdout	"deinit 3"
stdout	"-- map gone"
stdout	"r1 alpha"
stdout	"r2 alpha"
stdout	"after drop r1 alpha"
stdout	"after drop r2 alpha"
stdout	"held beta"
stdout	"-- done"
stdout	""
meets_expect	yes
