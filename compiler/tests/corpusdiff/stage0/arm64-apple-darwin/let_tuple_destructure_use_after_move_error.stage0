program	let_tuple_destructure_use_after_move_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	use of moved variable `pair`
meets_expect	yes
log	"error: use of moved variable `pair`"
log	"  --> examples/let_tuple_destructure_use_after_move_error.saw:14:18"
log	"     |"
log	" 14 |     let (c, d) = move pair   // use after move -> error"
log	"     |                  ^"
log	"   hint: value was already moved at line 13 and can no longer be used"
log	""
log	"1 error(s) generated"
