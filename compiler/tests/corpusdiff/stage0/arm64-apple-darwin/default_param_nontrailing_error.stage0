program	default_param_nontrailing_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	function `f`: parameter `y` has no default value but follows a parameter that does — defaulted parameters must be trailing
meets_expect	yes
log	"error: function `f`: parameter `y` has no default value but follows a parameter that does — defaulted parameters must be trailing"
