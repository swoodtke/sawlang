program	default_param_suspend_sync_error.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	cannot suspend in `sync func` declaration: `sync func caller` calls `useDefault` → `slow` → __saw_test_suspend (`slow` suspends at line 8)
meets_expect	yes
log	"error: cannot suspend in `sync func` declaration: `sync func caller` calls `useDefault` → `slow` → __saw_test_suspend (`slow` suspends at line 8)"
log	"  --> examples/default_param_suspend_sync_error.saw:14:1"
log	"     |"
log	" 14 | func caller() sync {"
log	"     | ^"
log	"   hint: a `sync` context must be transitively suspension-free: remove the suspending call or hoist it out of the sync region"
log	""
log	"1 error(s) generated"
