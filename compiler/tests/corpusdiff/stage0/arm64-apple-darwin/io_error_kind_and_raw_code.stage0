program	io_error_kind_and_raw_code.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"rendered: io error: open failed (not found)"
stdout	"kind: not found"
stdout	"kind is NotFound: true"
stdout	"os refusal carries a raw code: true"
stdout	"a std-raised failure carries none: true"
stdout	"an unmapped tag is Unknown: true"
stdout	"Unknown renders as: other error"
stdout	"channel alloc: the channel could not allocate a queue node: allocation of 64 bytes (align 8) failed"
stdout	"channel closed: channel is closed"
stdout	""
meets_expect	yes
