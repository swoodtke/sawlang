program	df137d_literal_width_riscv32.saw
triple	arm64-apple-darwin
twin	same
expect	error
build	refused	integer literal 2147483648 does not fit in `Int` (range -2147483648..=2147483647)
meets_expect	yes
log	"error: integer literal 2147483648 does not fit in `Int` (range -2147483648..=2147483647)"
log	"  --> examples/df137d_literal_width_riscv32.saw:20:24"
log	"     |"
log	" 20 | static RAM_BASE: Int = 0x80000000       // wrapped negative before this check"
log	"     |                        ^"
log	""
log	"error: integer literal 256 does not fit in `UInt8` (range 0..=255)"
log	"  --> examples/df137d_literal_width_riscv32.saw:21:23"
log	"     |"
log	" 21 | static SMALL: UInt8 = 256               // statics skipped the check entirely"
log	"     |                       ^"
log	""
log	"error: integer literal 2147483648 does not fit in `Int` (range -2147483648..=2147483647)"
log	"  --> examples/df137d_literal_width_riscv32.saw:25:26"
log	"     |"
log	" 25 |     let big_local: Int = 0x80000000"
log	"     |                          ^"
log	""
log	"error: integer literal 4294967296 does not fit in `UInt` (range 0..=4294967295)"
log	"  --> examples/df137d_literal_width_riscv32.saw:26:22"
log	"     |"
log	" 26 |     let wide: UInt = 0x100000000"
log	"     |                      ^"
log	""
log	"4 error(s) generated"
