// case: syntax.rule.compare-chain/less-than-chain
func f() {
    let ok = a < b < c
}

// case: syntax.rule.compare-chain/equality-chain
func f() {
    let ok = a == b == c
}

// case: syntax.rule.compare-chain/chain-across-a-line
func f() {
    let ok = a <=
        b != c
}

// case: syntax.rule.try-extent/catch-after-a-cast
// `try` takes a prefix expression, so no cast is ever followed by `catch`.
func f() {
    let v = try g() as Int catch {
        0
    }
}

