func f() {
    let y = n as Int? ?
}

// case: syntax.rule.cast-target-question/double-optional-token-after-a-cast
func f() {
    let y = n as Int??
}

// case: syntax.rule.cast-target-question/coalesce-after-an-optional-cast
func f() {
    let y = n as Int? ?? 9
}

// case: syntax.rule.cast-target-question/coalesce-touching-a-cast-target
func f() {
    let y = n as Int?? 9
}

// case: syntax.rule.cast-target-question/coalesce-after-a-cast
func f() {
    let y = n as Int ?? 9
}

// case: syntax.rule.cast-target-question/coalesce-after-a-generic-cast-target
func f() {
    let y = x as Box<Int> ?? z
}
