// case: syntax.rule.trailing-closure/on-a-call-result
func f() {
    foo()(1) { 2 }
}

// case: syntax.rule.trailing-closure/on-a-called-closure
func f() {
    let x = { 1 }() { 2 }
}

// case: syntax.rule.trailing-closure/second-trailing-closure
func f() {
    let x = f { 1 } { 2 }
}

// case: syntax.rule.trailing-closure/on-a-subscript
func f() {
    v[0] { 1 }
}

// case: syntax.rule.head-restriction/trailing-closure-in-a-guard-condition
func f() {
    guard v.any { $0 } else {
        return
    }
}

// case: syntax.rule.head-restriction/trailing-closure-on-a-match-scrutinee
func f() {
    match f { a } {
        case _ -> x
    }
}

// case: syntax.rule.head-restriction/trailing-closure-in-an-arm-guard
func f() {
    match x {
        case _ if v.any { $0 } -> x
    }
}

// case: syntax.rule.head-restriction/trailing-closure-in-an-if-condition
// Also refused as a trailing closure on the `if`; head-restriction is reported.
func f() {
    if v.any { $0 } { }
}

// case: syntax.rule.head-restriction/trailing-closure-in-an-else-if-condition
func f() {
    if a {
    } else if v.any { $0 } { }
}

// case: syntax.rule.head-restriction/trailing-closure-in-a-while-condition
func f() {
    while f { a } {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-on-an-if-let-subject
func f() {
    if let x = f { a } {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-on-a-while-let-subject
func f() {
    while let x = f { a } {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-on-a-guard-let-subject
func f() {
    guard let x = f { a } else {
        return
    }
}

// case: syntax.rule.head-restriction/trailing-closure-on-a-for-iterable
func f() {
    for i in f { a } {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-after-a-match-in-an-if-condition
func f() {
    if match m { case _ -> v }.any { $0 } {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-in-a-borrow-block-head
// Also refused as a place borrow and as a trailing closure on the block.
func f() {
    borrow let x = f { a } {
    }
}

// case: syntax.rule.head-restriction/generic-list-in-a-borrow-unwrap-head
// With a trailing closure in its place, `if borrow let x = f { a } {` parses:
// the condition is the borrow block `borrow let x = f { a }`.
func f() {
    if borrow let x = f<T> {
    }
}

// case: syntax.rule.head-restriction/trailing-closure-in-a-borrow-for-head
func f() {
    for borrow let x in f { a } {
    }
}

// case: syntax.rule.head-restriction/generic-list-kept-by-the-body-brace
func f() {
    if a<b> {
    }
}

// case: syntax.rule.head-restriction/generic-list-kept-by-a-while-body-brace
// The list parses and is kept before `{`, where a trailing closure would
// attach, but in a head the `{` begins the body.
func f() {
    while a < b > { }
}

// case: syntax.rule.head-reset/only-inside-the-nested-block
// The block resets the head only inside its braces; the hop after it is
// back in the head.
func f() {
    guard match m { case _ -> v }.any { $0 } else {
        return
    }
}
