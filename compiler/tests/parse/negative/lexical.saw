// case: syntax.lex.ascii-identifier/non-ascii-letter-starting-a-name
func f() {
    let π = 3
}

// case: syntax.lex.module-doc/after-the-first-token
func f() {
}
//! Too late.

// case: syntax.lex.doc-attach/doc-before-an-import
/// An import is not documented.
import m

// case: syntax.lex.doc-attach/doc-before-a-local
func f() {
    /// A local.
    let b = 1
}

// case: syntax.lex.doc-attach/doc-at-the-end-of-input
func f() {
}
/// Nothing follows.

// case: syntax.lex.doc-attach/doc-before-an-extern-function
extern "C" {
    /// A C function.
    func g()
}

// case: syntax.lex.doc-attach/doc-between-an-attribute-and-its-declaration
@export
/// Exported.
public func f() {
}

// case: syntax.lex.doc-attach/second-run-around-test
/// one
@test
/// two
func f() {}

// case: syntax.lex.doc-attach/second-run-after-a-blank-line
/// one

/// two
func f() {}

// case: syntax.lex.doc-attach/second-run-after-a-plain-comment
/// one
// plain
/// two
func f() {}

// case: syntax.lex.doc-attach/second-run-before-a-field
struct S {
    /// one

    /// two
    x: Int
}

// case: syntax.lex.shift-adjacent/spaced-shift
func f() {
    let s = a < < 2
}

// case: syntax.lex.float-point/trailing-point
func f() {
    let x = 1.
}

// case: syntax.lex.float-point/leading-point
func f() {
    let x = .5
}

// case: syntax.lex.int-range/literal-past-its-suffix
func f() {
    let a = 256u8
}

// case: syntax.lex.escape/unknown-escape
func f() {
    let s = "\q"
}

// case: syntax.lex.directive/unknown-directive
func f() {
    let a = #column
}

// case: syntax.lex.directive/lend-var-is-refused
extension P {
    func m(&self) borrows -> &Int {
        if #lend_var {
        }
    }
}

// case: syntax.lex.unterminated-string/no-closing-quote
func f() {
    let a = "no closing quote
}

// case: syntax.lex.unclosed-bracket/unclosed-parenthesis
// an unclosed bracket, refused at its opener
func f() {
    let x = (1 + 2
}

// case: syntax.lex.unclosed-bracket/unclosed-brace
// an unclosed bracket, refused at its opener
func a() {
    let x = 1

func b() {
}

// case: syntax.lex.int-range/literal-past-64-bits
func f() {
    let a = 18446744073709551616
}

// case: syntax.lex.escape/surrogate-scalar
func f() {
    let s = "\u{D800}"
}

// case: syntax.lex.escape/scalar-past-the-maximum
func f() {
    let s = "\u{110000}"
}

// case: syntax.lex.escape/unicode-escape-with-no-digits
func f() {
    let s = "\u{}"
}

// case: syntax.lex.unterminated-string/closing-quote-swallowed-by-an-interpolation
// The segment's odd quote swallows the literal's closing quote.
func f() {
    let s = "a {"b} c"
}

// case: syntax.lex.unclosed-bracket/unclosed-square-bracket
// an unclosed bracket, refused at its opener
func f() {
    let x = [1, 2
}

// case: syntax.lex.unterminated-string/quote-in-an-interpolation-comment
// SL:hazards C3: the segment's quote is in a comment, so the literal's own
// opening quote is reported.
func main() { let s = "a {1 // comment: "
}

// case: syntax.lex.float-point/leading-point-in-an-argument
func f() {
    g(1, .25)
}

// case: SL-408-c1/doubled-separator
func f() {
    let a = 1__000
}

// case: SL-408-c1/doubled-separator-in-a-binary-literal
func f() {
    let a = 0b1__0
}

// case: SL-408-c1/doubled-separator-in-a-float
func f() {
    let a = 1.0__5
}

// case: SL-408-c1/separator-after-a-base-prefix
func f() {
    let a = 0x_FF
}

// case: SL-408-c1/trailing-separator
func f() {
    let a = 1_
}

// case: SL-408-c1/trailing-separator-after-hex-digits
func f() {
    let a = 0xFF_
}

// case: SL-408-c1/trailing-separator-after-a-group
func f() {
    let a = 1_000_
}

// case: SL-408-c1/trailing-separator-in-a-float
func f() {
    let a = 1.0_
}

// case: SL-408-c1/separator-before-the-point
func f() {
    let a = 1_.5
}

// case: SL-408-c1/two-underscores-before-a-width-suffix
func f() {
    let a = 2__u8
}

// case: syntax.expr.int/uppercase-hex-prefix
func f() {
    let a = 0XFF
}

// case: syntax.expr.int/uppercase-binary-prefix
func f() {
    let a = 0B1
}

// case: syntax.expr.int/uppercase-octal-prefix
func f() {
    let a = 0O7
}

// case: syntax.expr.int/decimal-digit-in-a-binary-literal
func f() {
    let a = 0b102
}

// case: syntax.expr.int/decimal-digit-in-an-octal-literal
func f() {
    let a = 0o78
}

// case: syntax.expr.int/word-spelled-like-a-width-suffix
func f() {
    let a = 2u9
}

// case: syntax.expr.int/separator-before-a-word-spelled-like-a-width-suffix
func f() {
    let a = 2_u9
}

// case: syntax.expr.float/width-suffix-on-a-float
func f() {
    let a = 1.5u8
}

// case: syntax.expr.shorthand-param/suffix-like-word-after-a-shorthand-parameter
// A shorthand parameter's digits are no number, so the lexer leaves the word
// to the parser.
func f() {
    let g = { $0u8 }
}
