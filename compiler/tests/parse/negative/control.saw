// case: syntax.rule.arm-body/map-in-an-arm-body
func f() {
    match x {
        case 1 -> { a: 1 }
        case _ -> 2
    }
}

// case: syntax.rule.arm-body/set-in-an-arm-body
func f() {
    match x {
        case 1 -> { a, b }
        case _ -> 2
    }
}

// case: syntax.rule.arm-body/body-on-the-next-line
func f() {
    match x {
        case 1 ->
            a
    }
}

// case: syntax.expr.match-arm/arm-written-with-an-arrow-and-no-case
func f() {
    match x {
        1 => 2
    }
}

// case: syntax.expr.match-arm/assignment-where-an-arm-begins
func f() {
    match x {
        1 = 2
    }
}

// case: syntax.expr.match-arm/juxtaposed-names-where-an-arm-begins
func f() {
    match x {
        a b
    }
}

// case: syntax.expr.match-arm/open-range-where-an-arm-begins
func f() {
    match x {
        a.. == c
    }
}

// case: syntax.expr.match-arm/borrow-binding-where-an-arm-begins
func f() {
    match x {
        borrow var e =
    }
}

// case: syntax.expr.match-arm/semicolon-where-an-arm-begins
func f() {
    match x {
        ;
    }
}

// case: syntax.expr.match-arm/expression-and-semicolon-where-an-arm-begins
func f() {
    match x {
        a;
    }
}

// case: syntax.expr.match-arm/call-after-a-move-where-an-arm-begins
func f() {
    match x {
        move x.f()
    }
}

// case: syntax.expr.match-arm/float-with-no-digit-after-its-point-where-an-arm-begins
func f() {
    match x {
        7.
    }
}

// case: syntax.expr.match-arm/shift-with-a-space-where-an-arm-begins
func f() {
    match x {
        a < < b
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-literal-scrutinee
func f() {
    match 1 {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-parenthesized-scrutinee
func f() {
    match (x) {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-call-scrutinee
func f() {
    match g() {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-member-scrutinee
func f() {
    match a.b {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-generic-scrutinee
func f() {
    match Foo<T> {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-after-a-comparison-scrutinee
func f() {
    match a < b {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-in-a-match-value
func f() {
    let v = match x {
        1 => 2
    }
}

// case: syntax.expr.match-arm/arrow-arm-in-a-match-in-a-trailing-closure
func f() {
    g {
        match x {
            1 => 2
        }
    }
}

// case: syntax.rule.try-block/try-before-a-brace-without-catch
func f() {
    let c = try { 1 }
}

// case: syntax.rule.try-block/optional-try-block
func f() {
    try? {
        g()
    } catch {
    }
}

// case: syntax.rule.infinite-loop/called-closure-condition
func f() {
    while { c }() { }
}

// case: syntax.rule.infinite-loop/closure-condition
func f() {
    while { a } { }
}

// case: syntax.rule.infinite-loop/member-on-a-closure-condition
func f() {
    while { a }.x { }
}

// case: syntax.rule.infinite-loop/subscript-on-a-closure-condition
func f() {
    while { a }[0] { }
}

// case: syntax.rule.infinite-loop/operator-after-a-closure-condition
func f() {
    while { a } + b { }
}

// case: syntax.rule.infinite-loop/loop-as-an-operand
func f() {
    let n = while { a } + b { }
}

// case: syntax.expr.refused-brace-condition/map-condition
func f() {
    while {1: 2}.is_empty() { }
}

// case: syntax.expr.refused-brace-condition/set-condition-before-a-line-break
func f() {
    while {1, 2}
    { }
}

// case: syntax.rule.try-route-case/one-segment
func f() {
    let n = try(as E) f()
}

// case: syntax.expr.refused-try-route/route-on-force-try
func f() {
    let n = try!(as E.Case) f()
}

// case: syntax.expr.refused-try-route/route-beside-catch
func f() {
    let n = try(as E.Case) f() catch {
    }
}

// case: syntax.expr.refused-while-let-else/else-after-a-while-let
func f() {
    while let x = g() {
    } else {
    }
}

// case: syntax.expr.refused-for-tuple/tuple-pattern-in-a-for-head
