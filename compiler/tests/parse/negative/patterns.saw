// case: syntax.pat.refused-paren/at-a-case
func f() {
    match t {
        case (a) -> 1
    }
}

// case: syntax.pat.refused-paren/in-a-let
func f() {
    let (a) = t
}

// case: syntax.pat.refused-paren/in-an-if-let
func f() {
    if let (a) = t {
    }
}

// case: syntax.pat.refused-paren/in-a-guard-let
func f() {
    guard let (a) = t else {
        return
    }
}

// case: syntax.pat.refused-paren/in-a-while-let
func f() {
    while let (a) = t {
    }
}

// case: syntax.pat.refused-paren/nested-in-a-tuple
func f() {
    match t {
        case (b, (a)) -> 1
    }
}

// case: syntax.pat.refused-paren/nested-in-a-payload
func f() {
    match t {
        case Some((a)) -> 1
    }
}

// case: syntax.pat.refused-paren/doubled
func f() {
    match t {
        case ((a,)) -> 1
    }
}

// case: syntax.pat.tuple.positional/two-trailing-commas
func f() {
    match t {
        case (a,,) -> 1
    }
}

// case: syntax.pat.variant/a-comma-with-no-payload
func f() {
    match t {
        case A(,) -> 1
    }
}

// case: syntax.pat.range/open-end
func f() {
    match n {
        case 1.. -> 1
    }
}

// case: syntax.pat.range/open-start
func f() {
    match n {
        case ..5 -> 1
    }
}

// case: syntax.pat.int/name-as-an-end
func f() {
    match n {
        case 1..k -> 1
    }
}

// case: syntax.pat.int/expression-as-an-end
func f() {
    match n {
        case 1..(2) -> 1
    }
}

// case: syntax.pat.literal/negated-name
func f() {
    match n {
        case -x -> 1
    }
}

// case: syntax.pat.literal/float
func f() {
    match n {
        case 1.5 -> 1
    }
}

// case: syntax.pat.literal/interpolated-string
func f() {
    match s {
        case "a{b}" -> 1
    }
}

// case: syntax.stmt.destructure/type-annotation
func f() {
    let (a, b): (Int, Int) = t
}

// case: syntax.pat.refused-qualified-variant/qualified-name
func f() {
    match e {
        case E.a -> 1
    }
}

// case: syntax.pat.refused-qualified-variant/qualified-payload
func f() {
    match e {
        case m.E.a(x, _) -> 1
    }
}

// case: syntax.pat.refused-dot-variant/dotted-name
func f() {
    match e {
        case .a -> 1
    }
}

// case: syntax.pat.refused-dot-variant/dotted-payload-nested
func f() {
    match e {
        case (1, .a(x)) -> 1
    }
}

// case: syntax.pat.refused-named-tuple/labelled-elements
func f() {
    match t {
        case (x: 1, y: 2) -> 1
    }
}

// case: syntax.pat.refused-named-tuple/in-a-destructuring-let
func f() {
    let (x: a, y: b) = t
}
