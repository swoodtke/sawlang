// case: syntax.expr.map/bare:arm
func f() {
    match x {
        case _ -> {a: b}
    }
}

// case: syntax.expr.set/bare:arm
func f() {
    match x {
        case _ -> {a, b}
    }
}

// case: syntax.expr.closure/bare:arm
// parses as another construct
func f() {
    match x {
        case _ -> { a }
    }
}

// case: syntax.expr.unary/bare:recv
// parses as another construct
func f() {
    let v = -a.b
}

