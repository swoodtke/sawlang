            (Block
              (StaticAssert (Name a) "m")
              (ExprStmt (Name x)))))))))

// case: syntax.decl.static-assert/cell:arm
(File
  (Declaration.func
    (Func f
      (Block
        (ExprStmt
          (Match
            (Name x)
            (MatchArm
              (WildcardPat)
              (StaticAssert (Name a) "m"))))))))
