// case: census-N11/deep-recursion-is-a-runtime-matter
(File
  (Declaration.func
    (Func down
      (Param.plain n
        (NamedType (Path Int)))
      (NamedType (Path Int))
      (Block
        (ExprStmt
          (If
            (Binary.pair (Name n) == (IntLit 0))
            (Block
              (Return (IntLit 0)))))
        (ExprStmt
          (Binary
            (Call.paren
              (Name down)
              (Arg.labelled n
                (Binary (Name n) - (IntLit 1))))
            +
            (IntLit 1)))))))

