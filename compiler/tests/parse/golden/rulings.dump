                  (Closure
                    (ExprStmt (ShorthandParam $0))))))
            (Block)))
        (ExprStmt
          (If
            (Call
              (Member (Name v) any)
              (Closure
                (ExprStmt
                  (Binary.pair (ShorthandParam $0) > (IntLit 1)))))
            (Block)))
        (ExprStmt
          (If
            (Binary.pair
              (Interp
                (Call
                  (Member (Name v) map)
                  (Closure
                    (ExprStmt (ShorthandParam $0)))))
              ==
              (Name s))
            (Block)))))))

