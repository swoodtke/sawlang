// case: syntax.lex.doc-attach/every-documentable-declaration
(File
  (Doc "The module." "Its second line.")
  (Declaration.func
    (Doc "A function.")
    (Visibility.public)
    (Func f (Block)))
  (Declaration.static
    (Doc "A static.")
    (Static.immutable S
      (NamedType (Path Int))
      =
      (IntLit 0)))
  (Declaration.struct
    (Doc "A struct.")
    (Struct P
      (Field
        (Doc "A field.")
        x
        (NamedType (Path Int)))))
  (Declaration.enum
    (Doc "An enum.")
    (Enum E
      (Case (Doc "A case.") A)))
  (Declaration.trait
    (Doc "A trait.")
    (Trait T
      (Requirement
        (Doc "A requirement.")
        m
        (Param.receiver (Receiver.shared)))))
  (Declaration.extension
    (Doc "An extension.")
    (Extension
      (Path P)
      (ExtensionMember.method
        (Doc "A method.")
        (Method m
          (Param.receiver (Receiver.shared))
          (Block)))
      (ExtensionMember.init
        (Doc "An initializer.")
        (Init (Block)))))
  (Declaration.type-alias
    (Doc "An alias.")
    (TypeAlias Alias
      (NamedType (Path Int)))))

