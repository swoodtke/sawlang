// case: syntax.rule.static-head/top-level-static-names-a-static
(File
  (Declaration.static
    (Static.immutable sync
      (NamedType (Path Int))
      =
      (IntLit 0)))
  (Declaration.static
    (Static.immutable limit
      (NamedType (Path Int))
      =
      (IntLit 4))))

// case: syntax.rule.static-head/static-method-in-an-extension-and-a-trait
(File
  (Declaration.extension
    (Extension
      (Path S)
      (ExtensionMember.method
        (Method static make
          (NamedType (Path S))
          (Block
            (ExprStmt
              (Call.paren (Name S))))))))
  (Declaration.trait
    (Trait T
      (Requirement static make
        (NamedType (Path Self))))))

