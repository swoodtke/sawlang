      (GenericParam.const N
        (NamedType (Path Int)))
      (Param.plain a
        (AnyType (Path Shape)))
      (Block))))

// case: syntax.rule.contextual-words/words-are-identifiers-elsewhere
(File
  (Declaration.func
    (Func f
      (Block
        (Let.immutable (BindingName private) (IntLit 1))
        (Let.immutable (BindingName type) (IntLit 2))
        (Let.immutable (BindingName const) (IntLit 3))
        (Let.immutable (BindingName any) (IntLit 4))
        (Let.immutable (BindingName sync) (IntLit 5))
        (Let.immutable
          (BindingName consumes)
          (Binary (Name private) + (Name type) + (Name const) + (Name any) + (Name sync)))))))

// case: syntax.rule.contextual-words/lends-before-self-or-a-name
(File
  (Declaration.struct
    (Struct Cursor
      (Field buf
        (RefType.shared
          (NamedType
            (Path Vector)
            (NamedType (Path Int)))))))
  (Declaration.extension
    (Extension
      (Path Cursor)
      (ExtensionMember.method
        (Method view
          (Param.receiver (Receiver.shared))
          (NamedType (Path Cursor))
          (Block
            (ExprStmt
              (Call.paren
                (Name Cursor)
                (Arg.labelled buf
                  (Lends (SelfExpr))))))))
      (ExtensionMember.method
        (Method other
          (Param.receiver (Receiver.shared))
          (Param.plain b
            (RefType.shared
              (NamedType
                (Path Vector)
                (NamedType (Path Int)))))
          (NamedType (Path Cursor))
          (Block
            (ExprStmt
              (Call.paren
                (Name Cursor)
                (Arg.labelled buf
                  (Lends (Name b)))))))))))

