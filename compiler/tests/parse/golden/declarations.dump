    (Func f
      (Block
        (Assign (Name static_assert) (Name x))
        (CompoundAssign (Name static_assert) += (IntLit 1))
        (Assign
          (Member (Name static_assert) b)
          (Name x))
        (OptionalAssign.plain
          (OptionalChain
            (OptionalMember (Name static_assert) b))
          (Name x))))))

