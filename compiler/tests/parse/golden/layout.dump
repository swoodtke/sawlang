// case: syntax.rule.range-open-end/before-a-closing-token
(File
  (Declaration.func
    (Func f
      (Block
        (Let.immutable
          (BindingName a)
          (Subscript.single
            (Name buf)
            (Range.from (IntLit 4) ..)))
        (Let.immutable
          (BindingName b)
          (Subscript.single (Name buf) (Range.upto ..)))
        (Let.immutable
          (BindingName c)
          (Range.from (Name a) ..))
        (ExprStmt
          (Call.paren
            (Name g)
            (Arg.positional
              (Range.from (Name a) ..))
            (Arg.positional (Name b))))
        (Let.immutable
          (BindingName m)
          (Closure
            (ExprStmt
              (Range.from (Name a) ..))))))))

