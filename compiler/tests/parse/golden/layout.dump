      (Field x
        (NamedType (Path Int)))))
  (Declaration.struct
    (Struct Q
      (Field y
        (NamedType (Path Int))))))

// case: syntax.rule.declaration-separator/members-one-per-line
(File
  (Declaration.trait
    (Trait T
      (Requirement a
        (Param.receiver (Receiver.shared)))
      (Requirement b
        (Param.receiver (Receiver.shared)))))
  (Declaration.extension
    (Extension
      (Path S)
      (ExtensionMember.method
        (Method a
          (Param.receiver (Receiver.shared))
          (Block)))
      (ExtensionMember.method
        (Method b
          (Param.receiver (Receiver.shared))
          (Block)))))
  (Declaration.extern
    (ExternBlock "C" (ExternFunc.prompt a) (ExternFunc.prompt b))))

// case: syntax.rule.operator-continuation/line-ending-in-an-operator
(File
  (Declaration.func
    (Func f
      (Block
        (Let.immutable
          (BindingName x)
          (Binary
            (Name a)
            +
            (Binary (Name b) * (Name c))))
        (Let.immutable
          (BindingName y)
          (Binary
            (Binary (Name p) && (Name q))
            ||
            (Name r)))
        (Let.immutable
          (BindingName z)
          (Coalesce (Name o) ?? (Name d)))
        (Let.immutable
          (BindingName w)
          (Binary.pair (Name a) == (Name b)))
        (Let.immutable
          (BindingName s)
          (Binary (Name a) << (Name b)))))))

