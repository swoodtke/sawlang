// case: syntax.rule.subscript-declaration/setitem
extension Grid {
    func []=(&var self, i: Int, value: Int) {
    }
}

// case: syntax.rule.attribute-position/export-and-section-on-functions-and-statics
@export
func a() {
}
@export("sym_b")
func b() {
}
@section(".data")
static S: Int = 0

// case: syntax.rule.attribute-position/align-on-a-static-and-a-local
@align(64)
static Buffer: [UInt8; 64] = [0; 64]
func f() {
    @align(16) let x = 1
    @align(16)
    var y = 2
}

