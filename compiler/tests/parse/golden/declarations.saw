// case: syntax.rule.extern-abi/c-block
extern "C" {
    func puts(s: UnsafePointer<UInt8>) -> Int32
    blocking func read(fd: Int32, buf: UnsafePointer<UInt8>, n: Int) -> Int
    func printf(fmt: UnsafePointer<UInt8>, ...) -> Int32
}

// case: syntax.rule.requirement-borrows/borrows-requirements
trait Store {
    func get(&self, k: Int) borrows -> &Int
    func peek(&self, k: Int) borrows(sync) -> &Int
}

// case: syntax.rule.import-names/each-local-name-once
import m.{a, b as c}
import n.{a as b, b as a}

