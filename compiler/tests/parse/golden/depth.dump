// case: syntax.rule.depth-limit/a-speculated-list-within-the-limit-compares
(File
  (Declaration.func
    (Func f
      (Block
        (Let.immutable
          (BindingName x)
          (Call.paren
            (Name g)
            (Arg.positional
              (Binary.pair (Name a) < (Name b)))
            (Arg.positional
              (Binary.pair (Name c) > (Name d)))))))))

// case: syntax.rule.depth-limit/a-failing-speculated-list-within-the-limit-compares
(File
  (Declaration.func
    (Func f
      (Block
        (Let.immutable
          (BindingName x)
          (Call.paren
            (Name g)
            (Arg.positional
              (Binary.pair (Name a) < (StringLit "s")))
            (Arg.positional
              (Binary.pair (Name c) > (Name d)))))))))
