// case: syntax.decl.import-symbols/trailing-comma-and-line-breaks
(File
  (Import.private (Path m) . { (ImportSymbol.name a) (ImportSymbol.alias b c) })
  (Import.private (Path n) . { }))

// case: syntax.decl.params/trailing-comma-and-empty
(File
  (Declaration.func
    (Func f
      (Param.plain a
        (NamedType (Path Int)))
      (Param.default b
        (NamedType (Path Int))
        (IntLit 1))
      (Block)))
  (Declaration.func
    (Func g (Block))))

