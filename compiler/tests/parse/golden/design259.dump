                (Match
                  (Name n)
                  (MatchArm
                    (LiteralPat.int 0)
                    (Return (IntLit 1)))
                  (MatchArm (LiteralPat.int 1) (Break))
                  (MatchArm (LiteralPat.int 2) (Continue))
                  (MatchArm
                    (WildcardPat)
                    (Call.paren (Name g))))))))
        (ExprStmt (IntLit 0))))))

