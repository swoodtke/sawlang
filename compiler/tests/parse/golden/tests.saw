// case: syntax.rule.test-form/string-makes-a-case
@test "adds two numbers" {
    assert(1 + 1 == 2)
}

// case: syntax.rule.test-form/brace-makes-a-group
@test {
    import helpers
    func helper() -> Int {
        1
    }
    @test "uses the helper" {
        assert(helper() == 1)
    }
}

