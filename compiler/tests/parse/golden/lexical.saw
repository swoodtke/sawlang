// case: syntax.lex.doc-attach/every-documentable-declaration
//! The module.
//! Its second line.

/// A function.
public func f() {
}

/// A static.
static S: Int = 0

/// A struct.
struct P {
    /// A field.
    x: Int
}

/// An enum.
enum E {
    /// A case.
    case A
}

/// A trait.
trait T {
    /// A requirement.
    func m(&self)
}

/// An extension.
extension P {
    /// A method.
    func m(&self) {
    }
    /// An initializer.
    init() {
    }
}

/// An alias.
type Alias = Int

