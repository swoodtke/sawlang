// The constant casts that fit, each free of a run-time check: a raw-backed
// case to its own backing, to a wider type, and below its backing where its
// value fits; a literal at the target's edge, a sum, a limit and a static.
// A `let` local and a computed case that fit pass their run-time check
// (SL-757).
enum Wide: UInt16 {
    case Small = 7,
    case Big = 300
}

static SMALL: Int = 7

func pick(n: Int) -> Wide {
    if n > 0 { Wide.Big } else { Wide.Small }
}

func main() {
    let own = Wide.Big as UInt16
    let wider = Wide.Big as Int
    let as32 = Wide.Big as UInt32
    let fits = Wide.Small as UInt8
    print("{} {} {} {}", own, wider, as32, fits)
    let edge = 255 as UInt8
    let sum = (200 + 55) as UInt8
    let low = Int8.min as Int16
    let named = SMALL as UInt8
    print("{} {} {} {}", edge, sum, low, named)
    let local = 200
    let from_local = local as UInt8
    let computed = pick(0) as UInt8
    print("{} {}", from_local, computed)
}
