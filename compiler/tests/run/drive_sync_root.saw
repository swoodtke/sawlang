// A drive site's root is its task root, framed whether or not it suspends,
// as Stage 0 frames a driven root (SL:coroutines A4b): a root that never
// suspends is driven to `Ready` at its first resume, so `__saw_drive_steps`
// counts no `Pending`, and its result is moved out or dropped as any root's.

struct Tracker {
    id: Int
}

extension Tracker: NoCopy {
    func deinit(&var self) {
        print(self.id)
    }
}

func plain(n: Int) -> Int {
    n + 1
}

func made(n: Int) -> Tracker {
    Tracker(id: n)
}

func main() {
    print(__saw_drive(plain(4)))
    print(__saw_drive_steps(plain(4)))
    print(__saw_drive_steps(made(9)))
    let t = __saw_drive(made(3))
    print(t.id + 100)
}
