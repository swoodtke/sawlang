// Aggregates as `Map` keys and `Set` elements (SL-598): the table hashes and
// compares each through its synthesized or automatic hooks. Each walked
// table's entries print sorted, one line per stored key with the value it
// last took, because the table's iteration order is unspecified. A trivial
// struct and a payload-free enum meet `Hashable` automatically; a struct
// holding a String, a payload-carrying enum and a nested aggregate through a
// written `@synthesize`; a tuple and an Optional through their parts. A
// String part reaches a key through a struct and an enum payload; Stage 0
// takes no tuple holding one as a key.

struct Point { x: Int, y: Int }

enum Color { case Red, case Green, case Blue }

// The `Copy` assertions are Stage 0's: it takes no key holding a String unless
// the type declares a retaining copy. sawc2 needs none.
struct Named { name: String, n: Int }
@synthesize
extension Named: Copy {}
@synthesize
extension Named: Equatable {}
@synthesize
extension Named: Hashable {}

enum Shape {
    case Circle(r: Int),
    case Label(text: String),
    case Empty
}
@synthesize
extension Shape: Copy {}
@synthesize
extension Shape: Equatable {}
@synthesize
extension Shape: Hashable {}

struct Nest { at: Point, shape: Shape, tag: Color? }
@synthesize
extension Nest: Copy {}
@synthesize
extension Nest: Equatable {}
@synthesize
extension Nest: Hashable {}

func print_sorted(lines: &var Vector<String>) {
    lines.sort()
    for line in lines.iter() {
        print(line)
    }
}

func main() {
    var points: Map<Point, Int> = {:}
    var k = 0
    while k < 6 {
        try! points.insert(Point(x: k, y: 10 - k), k * k)
        k = k + 1
    }
    print("points {} {} {}", points.len(), points.contains_key(Point(x: 2, y: 8)), points.contains_key(Point(x: 2, y: 9)))
    var point_lines = Vector<String>()
    points.each({ [&var point_lines] p, v in try! point_lines.push("  ({p.x}, {p.y}) -> {v}") })
    print_sorted(&var point_lines)

    var colors = Set<Color>()
    let _ = try! colors.insert(Color.Blue)
    let _ = try! colors.insert(Color.Red)
    let _ = try! colors.insert(Color.Blue)
    print("colors {} {} {}", colors.len(), colors.contains(Color.Red), colors.contains(Color.Green))

    var names: Map<Named, String> = {:}
    try! names.insert(Named(name: "ada", n: 1), "one")
    try! names.insert(Named(name: "bob", n: 2), "two")
    try! names.insert(Named(name: "ada", n: 3), "three")
    try! names.insert(Named(name: "ada", n: 1), "uno")
    print("names {}", names.len())
    var name_lines = Vector<String>()
    names.each({ [&var name_lines] key, v in try! name_lines.push("  {key.name} {key.n} -> {v}") })
    print_sorted(&var name_lines)

    var shapes = Set<Shape>()
    let _ = try! shapes.insert(Shape.Circle(r: 1))
    let _ = try! shapes.insert(Shape.Label(text: "a"))
    let _ = try! shapes.insert(Shape.Empty)
    let _ = try! shapes.insert(Shape.Circle(r: 1))
    let _ = try! shapes.insert(Shape.Circle(r: 2))
    print("shapes {} {} {}", shapes.len(), shapes.contains(Shape.Label(text: "a")), shapes.contains(Shape.Label(text: "b")))

    var pairs: Map<(Int, Color), Int> = {:}
    try! pairs.insert((1, Color.Red), 1)
    try! pairs.insert((1, Color.Blue), 2)
    try! pairs.insert((2, Color.Red), 3)
    try! pairs.insert((1, Color.Red), 4)
    print("pairs {}", pairs.len())
    var pair_lines = Vector<String>()
    pairs.each({ [&var pair_lines] key, v in
        let red = key.1 == Color.Red
        try! pair_lines.push("  {key.0} {red} -> {v}")
    })
    print_sorted(&var pair_lines)

    var maybes: Map<Color?, Int> = {:}
    let none: Color? = None
    try! maybes.insert(none, 0)
    try! maybes.insert(Color.Green, 1)
    try! maybes.insert(Color.Red, 2)
    print("maybes {} {}", maybes.len(), maybes.contains_key(none))

    var nests = Set<Nest>()
    let _ = try! nests.insert(Nest(at: Point(x: 1, y: 2), shape: Shape.Empty, tag: None))
    let _ = try! nests.insert(Nest(at: Point(x: 1, y: 2), shape: Shape.Empty, tag: Color.Red))
    let _ = try! nests.insert(Nest(at: Point(x: 1, y: 2), shape: Shape.Label(text: "n"), tag: None))
    let _ = try! nests.insert(Nest(at: Point(x: 1, y: 2), shape: Shape.Empty, tag: None))
    print("nests {}", nests.len())
    var nest_lines = Vector<String>()
    nests.each({ [&var nest_lines] e in
        let tagged = e.tag.is_some()
        try! nest_lines.push("  {e.at.x} {tagged}")
    })
    print_sorted(&var nest_lines)
}
