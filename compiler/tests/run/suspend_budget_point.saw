// A loop in a function that suspends keeps its op-budget point live, so the
// point is a suspension of the function's frame: here a suspending `main`,
// whose loop charges the frame's counter three times, too few to force a
// yield, before the ready park under `yield_now` (SL:coroutines A9).
import std.task.{yield_now}

func main() {
    var i = 0
    while i < 3 {
        i = i + 1
    }
    if i == 3 {
        print("{}", i)
        yield_now()
    }
}
