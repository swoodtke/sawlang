// due: a function that suspends needs a coroutine frame, and none is lowered yet
// refuses: coro.not-yet at 16:22
// A loop in a function that suspends keeps its op-budget point live, so the
// point needs the frame the function is refused for; the refusal is at the
// call its suspension was found through.
extern "C" {
    blocking func usleep(us: UInt32) -> Int32
}

func main() {
    var i = 0
    while i < 3 {
        i = i + 1
    }
    if i == 3 {
        print("{}", (usleep(1) as Int) + i)
    }
}
