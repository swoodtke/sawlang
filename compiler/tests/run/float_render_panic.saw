// A panic's format arguments render a Float through the same formatter as
// every other position: the two zeros, NaN, an infinity, the minimum
// subnormal, `0.1 + 0.2` and both sides of the `1e16` switch (SL-722).

func main() {
    let zero = 0.0
    let tiny = Float.from(bits: 1)
    print("before")
    panic("floats {} {} {} {} {} {} {} {}", 0.0, -0.0, zero / zero, -1.0 / zero, tiny, 0.1 + 0.2,
          9999999999999998.0, 10000000000000000.0)
}
