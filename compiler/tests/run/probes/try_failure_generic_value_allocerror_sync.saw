// probe: panics
// about: `try!` on a call generic over its value type that fails with `AllocError`, in a sync body, panics with the error rendered after `try! failed: ` through its error type's helper (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed: allocation of 64 bytes (align 8) failed
// ll defines: saw try failure std.alloc.AllocError

func failing<T>(value: T, fail: Bool) -> Result<T, AllocError> {
    if fail {
        return AllocError(size: 64, align: 8)
    }
    return value
}

func run() {
    print("start")
    let v = try! failing(5, true)
    print("unreached")
}

func main() {
    run()
}
