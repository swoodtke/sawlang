// probe: stated
// about: the deadlock walk a sync `main` makes in its idle wait reads a cooperative group a pool task made, registered in a worker's executor record, only under that record's latch, while the worker runs the group down and tears it down, conformance row K192 (SL-808)
// stage 0: runs it alike, but on its own std's executor, so a recorded run says nothing about these walks (SL-808)
// speeds: -O0 -O2
// prints: total 19900
import std.channel.{Channel}

func send_one(a: Channel<Int>, v: Int) -> Int {
    try! a.send(v)
    0
}

func recv_one(b: Channel<Int>) -> Int {
    try! b.receive()
}

func inner_group(a: Channel<Int>, b: Channel<Int>) -> Int {
    var g = TaskGroup()
    let h = g.spawn(recv_one(a))
    let v = h.join()
    try! b.send(v)
    v
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    var group = TaskGroup()
    var total = 0
    var i = 0
    while i < 200 {
        let a = try! Channel<Int>()
        let b = try! Channel<Int>()
        let _ = pool.spawn(inner_group(a, b))
        let s = group.spawn(send_one(a, i))
        let r = group.spawn(recv_one(b))
        total = total + r.join()
        let _ = s.join()
        i = i + 1
    }
    print("total {}", total)
}
