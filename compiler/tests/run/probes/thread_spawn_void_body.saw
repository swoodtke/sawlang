// probe: stated
// about: a `Void` `Thread.spawn` body yields a `Thread<Void>`, whose zero-sized result slot nothing stores, and whose `join()` is a statement (SL-765)
// stage 0: refuses `try! Thread.spawn` at parse, and its `Void` body yields its retired `VoidThread` (SL-765 Q1 (b), c10); with its infallible spawn the program prints this line under it (the corpus program `spawn_void_body`)
// speeds: -O0 -O2
// prints: 15

static COUNTER: Atomic<Int> = Atomic(0)

func bump(times: Int) {
    var i = 0
    while i < times {
        COUNTER.fetch_add(1)
        i = i + 1
    }
}

func joined_in_a_callee() {
    var t = try! Thread.spawn { bump(5) }
    t.join()
}

func main() {
    var t0 = try! Thread.spawn { bump(4) }
    var t1 = try! Thread.spawn { bump(6) }
    t0.join()
    t1.join()
    joined_in_a_callee()
    print(COUNTER.load())
}
