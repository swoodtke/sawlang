    hits
}
func main() {
    let f = fixture()
    print("arith len getfield {}", arith_len_getfield(&f, 6, true))
    print("arith len gettuple {}", arith_len_gettuple(&f, 6, true))
    print("arith len getforce {}", arith_len_getforce(&f, 6, true))
    print("arith len getindex {}", arith_len_getindex(&f, 6, true))
    print("arith len getfield2 {}", arith_len_getfield2(&f, 6, true))
    print("coalesce default getfield {}", coalesce_default_getfield(&f, 6, true))
    print("coalesce default gettuple {}", coalesce_default_gettuple(&f, 6, true))
    print("coalesce default getforce {}", coalesce_default_getforce(&f, 6, true))
    print("coalesce default getindex {}", coalesce_default_getindex(&f, 6, true))
    print("coalesce default getfield2 {}", coalesce_default_getfield2(&f, 6, true))
    print("match getfield {}", match_getfield(&f, 6, true))
    print("match gettuple {}", match_gettuple(&f, 6, true))
    print("match getforce {}", match_getforce(&f, 6, true))
    print("match getindex {}", match_getindex(&f, 6, true))
    print("match getfield2 {}", match_getfield2(&f, 6, true))
    print("receiver getfield {}", receiver_getfield(&f, 6, true))
    print("receiver gettuple {}", receiver_gettuple(&f, 6, true))
    print("receiver getforce {}", receiver_getforce(&f, 6, true))
    print("receiver getindex {}", receiver_getindex(&f, 6, true))
    print("receiver getfield2 {}", receiver_getfield2(&f, 6, true))
    print("segment getfield {}", segment_getfield(&f, 6, true))
    print("segment gettuple {}", segment_gettuple(&f, 6, true))
    print("segment getforce {}", segment_getforce(&f, 6, true))
    print("segment getindex {}", segment_getindex(&f, 6, true))
    print("segment getfield2 {}", segment_getfield2(&f, 6, true))
    print("value arg getfield {}", value_arg_getfield(&f, 6, true))
    print("value arg gettuple {}", value_arg_gettuple(&f, 6, true))
    print("value arg getforce {}", value_arg_getforce(&f, 6, true))
    print("value arg getindex {}", value_arg_getindex(&f, 6, true))
    print("value arg getfield2 {}", value_arg_getfield2(&f, 6, true))
    print("let bound getfield {}", let_bound_getfield(&f, 6, true))
    print("let bound gettuple {}", let_bound_gettuple(&f, 6, true))
    print("let bound getforce {}", let_bound_getforce(&f, 6, true))
    print("let bound getindex {}", let_bound_getindex(&f, 6, true))
    print("let bound getfield2 {}", let_bound_getfield2(&f, 6, true))
    print("coalesce left getfield {}", coalesce_left_getfield(&f, 6, true))
    print("coalesce left gettuple {}", coalesce_left_gettuple(&f, 6, true))
    print("arith int getfield {}", arith_int_getfield(&f, 6, true))
}
