func match_getfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let m = match f.toks[i % 2].text {
            case "alpha1" -> 1,
            case _ -> 0
        }
        hits = hits + m
        i = i + 1
    }
    hits
}

