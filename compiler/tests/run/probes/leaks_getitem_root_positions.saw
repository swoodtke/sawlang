func coalesce_default_getfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = nothing(i) ?? f.toks[i % 2].text
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

