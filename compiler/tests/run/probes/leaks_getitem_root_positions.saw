// probe: stated
// about: a getitem's element copy that a part is read through is dropped, wherever the part is read (SL-825)
// stage 0: leaks the element copy (SL:hazards S23)
// speeds: -O0 -O2
// leaks: none
// prints: arith len getfield 39
// prints: arith len gettuple 39
// prints: arith len getforce 39
// prints: arith len getindex 39
// prints: arith len getfield2 42
// prints: coalesce default getfield 33
// prints: coalesce default gettuple 33
// prints: coalesce default getforce 33
// prints: coalesce default getindex 33
// prints: coalesce default getfield2 36
// prints: match getfield 3
// prints: match gettuple 3
// prints: match getforce 3
// prints: match getindex 3
// prints: match getfield2 3
// prints: receiver getfield 33
// prints: receiver gettuple 33
// prints: receiver getforce 33
// prints: receiver getindex 33
// prints: receiver getfield2 36
// prints: segment getfield 45
// prints: segment gettuple 45
// prints: segment getforce 45
// prints: segment getindex 45
// prints: segment getfield2 48
// prints: value arg getfield 33
// prints: value arg gettuple 33
// prints: value arg getforce 33
// prints: value arg getindex 33
// prints: value arg getfield2 36
// prints: let bound getfield 33
// prints: let bound gettuple 33
// prints: let bound getforce 33
// prints: let bound getindex 33
// prints: let bound getfield2 36
// prints: coalesce left getfield 21
// prints: coalesce left gettuple 21
// prints: arith int getfield 15
// Each cell reads a part through a getitem six times over two elements, as
// an operand, a `??` operand, a scrutinee, a receiver, a segment, an
// argument and a binding; the lane runs every build under `leaks --atExit`
// and requires no leak.

struct Tok {
    text: String,
    alias: String?,
    kind: Int
}

struct Outer {
    inner: Tok,
    tag: String
}

struct Fixture {
    toks: Vector<Tok>,
    outers: Vector<Outer>,
    pairs: Vector<(String, Int)>,
    opairs: Vector<(String?, Int)>,
    somes: Vector<String?>,
    arrs: Vector<[String; 2]>,
    names: Vector<String>
}

extension Fixture: NoCopy {}

enum Bad {
    case Nope
}

func make(n: Int) -> String {
    "alpha{n}"
}

func nothing(n: Int) -> String? {
    if n < 0 {
        return "neg{n}"
    }
    None
}

func fallible(n: Int) -> Result<String, Bad> {
    if n < 0 {
        return Bad.Nope
    }
    return "alpha{n}"
}

func mk_tok(n: Int) -> Tok {
    Tok(text: "alpha{n}", alias: "al{n}", kind: n)
}

func mk_outer(n: Int) -> Outer {
    Outer(inner: mk_tok(n), tag: "t{n}")
}

func consume(s: String) -> Int {
    s.len()
}

func fixture() -> Fixture {
    var toks = Vector<Tok>()
    try! toks.push(Tok(text: "alpha{1}", alias: "al{1}", kind: 1))
    try! toks.push(Tok(text: "beta{2}", alias: None, kind: 2))
    var outers = Vector<Outer>()
    try! outers.push(mk_outer(1))
    try! outers.push(mk_outer(2))
    var pairs = Vector<(String, Int)>()
    try! pairs.push(("alpha{1}", 1))
    try! pairs.push(("beta{2}", 2))
    var opairs = Vector<(String?, Int)>()
    try! opairs.push(("oa{1}", 1))
    try! opairs.push((None, 2))
    var somes = Vector<String?>()
    try! somes.push("alpha{1}")
    try! somes.push("beta{2}")
    var arrs = Vector<[String; 2]>()
    try! arrs.push(["alpha{1}", "x{1}"])
    try! arrs.push(["beta{2}", "y{2}"])
    var names = Vector<String>()
    try! names.push("alpha{1}")
    try! names.push("beta{2}")
    Fixture(toks: move toks, outers: move outers, pairs: move pairs, opairs: move opairs, somes: move somes,
            arrs: move arrs, names: move names)
}

func arith_len_getfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = f.toks[i % 2].text.len() + 1
        hits = hits + got
        i = i + 1
    }
    hits
}

func arith_len_gettuple(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = f.pairs[i % 2].0.len() + 1
        hits = hits + got
        i = i + 1
    }
    hits
}

