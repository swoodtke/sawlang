// probe: stated
// about: a `close` from a `Thread.spawn` body wakes a thread blocked in `Channel.recv`, which returns `Err(Closed)` rather than waiting on or panicking (SL-777)
// stage 0: refuses `try! Thread.spawn` at parse, and its `Thread.spawn` hands back no `Result` (SL-765 Q1 (b)); its `recv` panics on the closed, drained channel where sawc2's returns `Err`
// speeds: -O0 -O2
// prints: waiting
// prints: woken: channel is closed
// `main` blocks in `recv` before the thread closes, since the thread sleeps
// first; the close must reach the blocked wait, or the program hangs.
import std.channel.{Channel}

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static NAP_NANOS: UInt64 = 50_000_000

func main() {
    let ch = try! Channel<Int>()
    var closer = try! Thread.spawn { [ch] in
        __saw_rt_sleep_ns(NAP_NANOS)
        let _ = ch.close()
    }
    closer.detach()
    print("waiting")
    match ch.recv() {
        case Ok(v) -> print("woken: a value {}", v),
        case Err(e) -> print("woken: {e}")
    }
}
