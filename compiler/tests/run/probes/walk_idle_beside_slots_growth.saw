// probe: stated
// about: the deadlock walk a sync `main` makes in its idle wait reads a cooperative group a pool task grows, registered in a worker's executor record, only under that record's latch, while the task spawns into it past its capacity, so its `slots` buffer is reallocated, and then tears it down, conformance row K192 (SL-808)
// stage 0: runs it alike, but on its own std's executor, so a recorded run says nothing about these walks (SL-808)
// speeds: -O0 -O2
// prints: total 32700
import std.channel.{Channel}

func quick(n: Int) -> Int {
    n + 1
}

func send_one(a: Channel<Int>, v: Int) -> Int {
    try! a.send(v)
    0
}

func recv_one(b: Channel<Int>) -> Int {
    try! b.receive()
}

// Spawns 64 tasks into a fresh group, past several of its capacities, and
// drops it, which runs them and tears the group down on this worker.
func grow_a_group() -> Int {
    var g = TaskGroup()
    var k = 0
    while k < 64 {
        let _ = g.spawn(quick(k))
        k = k + 1
    }
    k
}

func grower(a: Channel<Int>, b: Channel<Int>) -> Int {
    let v = try! a.receive()
    let grown = grow_a_group()
    try! b.send(v + grown)
    0
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    var group = TaskGroup()
    var total = 0
    var i = 0
    while i < 200 {
        let a = try! Channel<Int>()
        let b = try! Channel<Int>()
        let _ = pool.spawn(grower(a, b))
        let s = group.spawn(send_one(a, i))
        let r = group.spawn(recv_one(b))
        total = total + r.join()
        let _ = s.join()
        i = i + 1
    }
    print("total {}", total)
}
