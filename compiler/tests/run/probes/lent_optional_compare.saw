// probe: stated
// about: `==` and `!=` between a conditional lend's optional place and an Optional copy the place out, for a Copy-tier payload (SL-899)
// stage 0: refuses a `borrows` call written without `borrow`
// speeds: -O0 -O2
// leaks: none
// prints: int vec present true false false true
// prints: int vec absent false true false false
// prints: int user present true false false true
// prints: int user absent false true false false
// prints: int shared present true false false true
// prints: int shared absent false true false false
// prints: int user closes 4 0
// prints: named vec present true false false true
// prints: named vec absent false true false false
// prints: named user present true false false true
// prints: named user absent false true false false
// prints: named shared present true false false true
// prints: named shared absent false true false false
// prints: named user closes 4 0
// prints: shape vec present true false false true
// prints: shape vec absent false true false false
// prints: shape user present true false false true
// prints: shape user absent false true false false
// prints: shape shared present true false false true
// prints: shape shared absent false true false false
// prints: shape user closes 4 0

func tag(x: &Int) -> Int { x }
struct Named { name: String }
@synthesize
extension Named: Equatable {}
func tag(x: &Named) -> Int { x.name.len() }
enum Shape { case Circle(r: Int), case Label(s: String) }
@synthesize
extension Shape: Equatable {}
func tag(x: &Shape) -> Int {
    match x {
        case Circle(r) -> r,
        case Label(s) -> s.len()
    }
}

// The user accessor counts its epilogues, which run only when it lent.
struct UserInt { e: Int, ok: Bool, closes: Int }
extension UserInt: NoCopy {}
extension UserInt {
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedInt { e: Int, ok: Bool }
extension SharedInt: NoCopy {}
extension SharedInt {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserNamed { e: Named, ok: Bool, closes: Int }
extension UserNamed: NoCopy {}
extension UserNamed {
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedNamed { e: Named, ok: Bool }
extension SharedNamed: NoCopy {}
extension SharedNamed {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserShape { e: Shape, ok: Bool, closes: Int }
extension UserShape: NoCopy {}
extension UserShape {
    func slot(&var self) borrows -> &var Shape? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedShape { e: Shape, ok: Bool }
extension SharedShape: NoCopy {}
extension SharedShape {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Shape? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}

func lent_optional_compare_int() {
    var v = Vector<Int>()
    try! v.push(7)
    var u = UserInt(e: 7, ok: true, closes: 0)
    var ua = UserInt(e: 7, ok: false, closes: 0)
    let s = SharedInt(e: 7, ok: true)
    let sa = SharedInt(e: 7, ok: false)
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int vec present {v.find(0) == want} {v.find(0) != want} {v.find(0) == other} {want == v.find(0)}")
    }
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int vec absent {v.find(9) == want} {v.find(9) != want} {v.find(9) == other} {want == v.find(9)}")
    }
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int user present {u.slot() == want} {u.slot() != want} {u.slot() == other} {want == u.slot()}")
    }
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int user absent {ua.slot() == want} {ua.slot() != want} {ua.slot() == other} {want == ua.slot()}")
    }
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int shared present {s.slot() == want} {s.slot() != want} {s.slot() == other} {want == s.slot()}")
    }
    if true {
        let want: Int? = 7
        let other: Int? = 8
        print("int shared absent {sa.slot() == want} {sa.slot() != want} {sa.slot() == other} {want == sa.slot()}")
    }
    print("int user closes {u.closes} {ua.closes}")
}

func lent_optional_compare_named() {
    var v = Vector<Named>()
    try! v.push(Named(name: "ann"))
    var u = UserNamed(e: Named(name: "ann"), ok: true, closes: 0)
    var ua = UserNamed(e: Named(name: "ann"), ok: false, closes: 0)
    let s = SharedNamed(e: Named(name: "ann"), ok: true)
    let sa = SharedNamed(e: Named(name: "ann"), ok: false)
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named vec present {v.find(0) == want} {v.find(0) != want} {v.find(0) == other} {want == v.find(0)}")
    }
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named vec absent {v.find(9) == want} {v.find(9) != want} {v.find(9) == other} {want == v.find(9)}")
    }
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named user present {u.slot() == want} {u.slot() != want} {u.slot() == other} {want == u.slot()}")
    }
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named user absent {ua.slot() == want} {ua.slot() != want} {ua.slot() == other} {want == ua.slot()}")
    }
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named shared present {s.slot() == want} {s.slot() != want} {s.slot() == other} {want == s.slot()}")
    }
    if true {
        let want: Named? = Named(name: "ann")
        let other: Named? = Named(name: "bobby")
        print("named shared absent {sa.slot() == want} {sa.slot() != want} {sa.slot() == other} {want == sa.slot()}")
    }
    print("named user closes {u.closes} {ua.closes}")
}

func lent_optional_compare_shape() {
    var v = Vector<Shape>()
    try! v.push(Shape.Label(s: "abc"))
    var u = UserShape(e: Shape.Label(s: "abc"), ok: true, closes: 0)
    var ua = UserShape(e: Shape.Label(s: "abc"), ok: false, closes: 0)
    let s = SharedShape(e: Shape.Label(s: "abc"), ok: true)
    let sa = SharedShape(e: Shape.Label(s: "abc"), ok: false)
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape vec present {v.find(0) == want} {v.find(0) != want} {v.find(0) == other} {want == v.find(0)}")
    }
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape vec absent {v.find(9) == want} {v.find(9) != want} {v.find(9) == other} {want == v.find(9)}")
    }
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape user present {u.slot() == want} {u.slot() != want} {u.slot() == other} {want == u.slot()}")
    }
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape user absent {ua.slot() == want} {ua.slot() != want} {ua.slot() == other} {want == ua.slot()}")
    }
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape shared present {s.slot() == want} {s.slot() != want} {s.slot() == other} {want == s.slot()}")
    }
    if true {
        let want: Shape? = Shape.Label(s: "abc")
        let other: Shape? = Shape.Circle(r: 9)
        print("shape shared absent {sa.slot() == want} {sa.slot() != want} {sa.slot() == other} {want == sa.slot()}")
    }
    print("shape user closes {u.closes} {ua.closes}")
}

func main() {
    lent_optional_compare_int()
    lent_optional_compare_named()
    lent_optional_compare_shape()
}
