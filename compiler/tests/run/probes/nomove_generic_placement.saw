// probe: stated
// about: a generic body's fresh placement of a by-value parameter stays legal at a `NoMove` instantiation (SL-662)
// stage 0: does not check a generic body's unspelled move per instantiation, and cannot name `std.mem.drop_in_place`
// speeds: -O0 -O2
// The per-instantiation `NoMove` check keeps the fresh journey's one
// exception: a by-value parameter placed into fresh storage before anything
// referenced it, spelled `ptr[0] = move value` or, at its last use,
// `ptr[0] = value`. A body that references the parameter first is refused at
// `Pinned` (mono's `transfer.no-move.placement-after-borrow`) and runs at
// `Int`, here.
// prints: placed 7, destroyed where it lives: true
// prints: placed 8, destroyed where it lives: true
// prints: an Int placed after a reference: 5

import std.mem.{drop_in_place}

unsafe static var EXPECTED: Int = 0

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {
    func deinit(&var self) unsafe {
        let here = (&self) as UnsafePointer<Pinned> as Int
        print("placed {}, destroyed where it lives: {}", self.id, here == EXPECTED)
    }
}

extension Pinned: NoMove {}

func fresh_slot<T>() unsafe -> UnsafePointer<T> {
    GlobalAllocator().alloc(sizeof<T>(), alignof<T>())! as UnsafePointer<T>
}

func place_spelled<T>(value: T) unsafe -> UnsafePointer<T> {
    let ptr = fresh_slot<T>()
    ptr[0] = move value
    ptr
}

func place_unspelled<T>(value: T) unsafe -> UnsafePointer<T> {
    let ptr = fresh_slot<T>()
    ptr[0] = value
    ptr
}

func observe<T>(v: &T) -> Int {
    1
}

func place_seen<T>(value: T) unsafe -> UnsafePointer<T> {
    let ptr = fresh_slot<T>()
    let seen = observe(&value)
    ptr[0] = move value
    ptr
}

func destroy<T>(at: UnsafePointer<T>) unsafe {
    EXPECTED = at as Int
    drop_in_place(at)
    GlobalAllocator().dealloc(at as UnsafePointer<Int8>, sizeof<T>(), alignof<T>())
}

func main() unsafe {
    destroy(place_spelled(Pinned(id: 7)))
    destroy(place_unspelled(Pinned(id: 8)))
    let n = place_seen(5)
    print("an Int placed after a reference: {}", n[0])
    destroy(n)
}
