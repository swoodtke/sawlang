// probe: stated
// about: an `@section` function that suspends and nothing calls is still defined, as its resume function in the section, and kept (SL-934)
// stage 0: not run; the probe holds sawc to the spec's placement of a function whose body suspends
// speeds: -O0 -O2
// prints: 7
// The name is Mach-O's form, which an ELF target takes verbatim (section_function.saw).

func nap() -> Int {
    sleep(Duration.ms(1))
    5
}

@section("__TEXT,__sawfn,regular,pure_instructions")
func placed() -> Int {
    nap() + 2
}

func main() {
    print("7")
}
