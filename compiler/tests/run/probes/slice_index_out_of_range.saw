// probe: panics
// about: `s[i]` through a slice panics outside `0..<s.len()`, naming the index and the length (SL-988)
// stage 0: not run; v0.18.0's spec calls slices planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// prints: 3
// panics: slice: index out of range: 5 (len 3)
func at(s: &[Int], i: Int) -> Int { s[i] }

func main() {
    var v = Vector<Int>()
    try! v.push(1)
    try! v.push(2)
    try! v.push(3)
    print("{}", at(&v, 2))
    print("{}", at(&v, 5))
}
