// probe: stated
// about: a subscript accessor forwarding its lend to a later named accessor (SL-1173)
// stage 0: has no `lend`-forwarding accessors to compare against; the expectation is the spec's
// speeds: -O0 -O2
// prints: 7
// `[]` forwards `second(i)`, declared after it.

struct Inner {
    n: Int
}
struct Outer {
    inner: Inner
}
extension Outer {
    func [](&self, i: Int) borrows -> &Inner { lend self.second(i) }
    func second(&self, i: Int) borrows -> &Inner { lend self.inner }
}
func main() {
    let o = Outer(inner: Inner(n: 7))
    print(o[0].n)
}
