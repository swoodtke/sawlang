// probe: stated
// about: two `Thread.spawn` bodies spawn background tasks with `Task.spawn` concurrently, each holding its tasks until the other has spawned too, beside a `main` that drives a `TaskGroup()` of its own; each thread has its own background group, so every resume runs on the thread that spawned it, conformance row K189 (SL-806)
// stage 0: keeps one process-wide list of cooperative groups, so the two threads resume each other's frames and the program crashes (SL-797)
// speeds: -O0 -O2
// prints: 12000 resumes checked, foreign resumes: 0
import std.task.*

extern "C" {
    func pthread_self() -> Int
    func __saw_rt_sleep_ns(ns: UInt64)
}

static YIELDS: Int = 2000
static NAP_NANOS: UInt64 = 1_000_000
static FOREIGN: Atomic<Int> = Atomic(0)
// How many threads have spawned their background tasks; neither joins until
// both have, so the two background groups are live at once.
static SPAWNED: Atomic<Int> = Atomic(0)

func spin(owner: Int) -> Int {
    var i = 0
    while i < YIELDS {
        yield_now()
        if pthread_self() != owner {
            let _ = FOREIGN.fetch_add(1)
        }
        i = i + 1
    }
    i
}

func background_pair() -> Int {
    let me = pthread_self()
    let a = Task.spawn(spin(me))
    let b = Task.spawn(spin(me))
    let _ = SPAWNED.fetch_add(1)
    while SPAWNED.load() < 2 {
        __saw_rt_sleep_ns(NAP_NANOS)
    }
    a.join() + b.join()
}

func drive() -> Int {
    let me = pthread_self()
    var g = TaskGroup()
    let a = g.spawn(spin(me))
    let b = g.spawn(spin(me))
    a.join() + b.join()
}

func main() {
    var t1 = try! Thread.spawn { background_pair() }
    var t2 = try! Thread.spawn { background_pair() }
    let mine = drive()
    let r = t1.join() + t2.join() + mine
    print("{} resumes checked, foreign resumes: {}", r, FOREIGN.load())
}
