// probe: panics
// about: the pool control of K200: hosted by a pool task, a join of the host's own cooperative tasks runs in place, so a task whose join waits on a sibling's later send deadlocks and is reported, where the same body hosted by a cooperative task parks and completes, conformance row K200 (SL-1161)
// stage 0: runs it on its own std's executor, which this rule is not part of (SL-1161)
// speeds: -O0 -O2
// panics: deadlock: every task is waiting to receive from a channel, or to join a `TaskGroup(threads:)` task that is, and nothing in this program can send. A join or a pool's teardown made in thread context, or by a pool's task, runs that thread's other tasks until it returns
// `a` joins `a1` and then sends; `b` joins `b1`, which receives what `a`
// sends. Inside the host's in-place join, `a`'s join nests `b`'s above it, and
// `b1` waits for a send `a` makes only once `b`'s join returns. The cooperative
// twin is `join_hosted_by_a_cooperative_task_parks.saw`.
import std.channel.{Channel}
import std.task.*

func a1() -> Int {
    yield_now()
    5
}

func b1(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func a(ch: Channel<Int>) -> Int {
    var ga = TaskGroup()
    let h = ga.spawn(a1())
    let x = h.join()
    try! ch.send(x)
    x
}

func b(ch: Channel<Int>) -> Int {
    var gb = TaskGroup()
    let h = gb.spawn(b1(ch.copy()))
    h.join() * 2
}

func host() -> Int {
    let ch = try! Channel<Int>()
    var g = TaskGroup()
    let ha = g.spawn(a(ch.copy()))
    let hb = g.spawn(b(ch.copy()))
    ha.join() + hb.join()
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    let h = pool.spawn(host())
    print("host {}", h.join())
}
