// probe: panics
// about: `f as UInt` panics on `-1.0`, the first value an unsigned target cannot hold, naming the value, so no out-of-range `fptosi`/`fptoui` runs (SL-927)
// stage 0: not run; the Float conversion rule is SL-927's, which v0.18.0 predates
// speeds: -O0 -O2
// prints: before
// panics: cast to UInt out of range: -1.0
// The program renders no other Float, so the panic's rendering is rooted by
// the cast alone.

func held(v: Float) -> Float {
    v
}

func main() {
    let f = held(v: -1.0)
    print("before")
    let n = f as UInt
    print("unreachable {}", n)
}
