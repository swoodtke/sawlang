// probe: stated
// about: `if borrow let p = s.c_string()` lends a string with no NUL and takes the absent path for one holding a NUL (SL-686)
// stage 0: its std has no `c_string`, and it cannot parse a `borrow`
// speeds: -O0 -O2
// prints: 5
// prints: -1
// `c_string` lends the bytes of a string with no NUL, and nothing for one
// with a NUL, whose `else` runs with the string free.

extern "C" {
    func strlen(s: UnsafePointer<Int8>) -> UInt
}

func measured(s: String) unsafe -> Int {
    if borrow let p = s.c_string() {
        return strlen(p) as Int
    } else {
        return -1
    }
}

func main() {
    print(measured("hello"))
    print(measured("a\0b"))
}
