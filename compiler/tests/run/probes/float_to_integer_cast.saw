// probe: stated
// about: `f as T` truncates toward zero at every integer width, holding each width's truncated extremes, -0.0 and a negative fraction into an unsigned target (SL-927)
// stage 0: not run; the Float conversion rule is SL-927's, which v0.18.0 predates
// speeds: -O0 -O2
// prints: Int8 3.7 3
// prints: Int8 -3.7 -3
// prints: Int8 127.5 127
// prints: Int8 -128.5 -128
// prints: Int8 -128.0 -128
// prints: UInt8 255.9 255
// prints: UInt8 -0.9 0
// prints: Int16 32767.5 32767
// prints: Int16 -32768.9 -32768
// prints: UInt16 65535.5 65535
// prints: Int32 2147483647.5 2147483647
// prints: Int32 -2147483648.5 -2147483648
// prints: UInt32 4294967295.5 4294967295
// prints: Int64 below 2^63 9223372036854774784
// prints: Int64 -2^63 -9223372036854775808
// prints: Int below 2^63 9223372036854774784
// prints: UInt64 below 2^64 18446744073709549568
// prints: UInt64 2^63 9223372036854775808
// prints: UInt below 2^64 18446744073709549568
// prints: Int -0.0 0
// prints: Int 0.9 0
// prints: UInt -0.9 0
// prints: UInt64 -0.9 0
// prints: Byte 200.7 200
// prints: Int8 constant 2.9 2
// prints: Int constant -2.9 -2
// The range is the truncated value's: a value is in range when it lies in
// the open interval (min - 1, max + 1), so `max + 0.5` is `max` and `-0.9`
// is 0 even unsigned. The largest doubles below 2^63 and 2^64 are the
// 64-bit widths' last values in range.

func held(v: Float) -> Float {
    v
}

func main() {
    print("Int8 3.7 {}", held(v: 3.7) as Int8)
    print("Int8 -3.7 {}", held(v: -3.7) as Int8)
    print("Int8 127.5 {}", held(v: 127.5) as Int8)
    print("Int8 -128.5 {}", held(v: -128.5) as Int8)
    print("Int8 -128.0 {}", held(v: -128.0) as Int8)
    print("UInt8 255.9 {}", held(v: 255.9) as UInt8)
    print("UInt8 -0.9 {}", held(v: -0.9) as UInt8)
    print("Int16 32767.5 {}", held(v: 32767.5) as Int16)
    print("Int16 -32768.9 {}", held(v: -32768.9) as Int16)
    print("UInt16 65535.5 {}", held(v: 65535.5) as UInt16)
    print("Int32 2147483647.5 {}", held(v: 2147483647.5) as Int32)
    print("Int32 -2147483648.5 {}", held(v: -2147483648.5) as Int32)
    print("UInt32 4294967295.5 {}", held(v: 4294967295.5) as UInt32)
    print("Int64 below 2^63 {}", held(v: 9223372036854774784.0) as Int64)
    print("Int64 -2^63 {}", held(v: -9223372036854775808.0) as Int64)
    print("Int below 2^63 {}", held(v: 9223372036854774784.0) as Int)
    print("UInt64 below 2^64 {}", held(v: 18446744073709549568.0) as UInt64)
    print("UInt64 2^63 {}", held(v: 9223372036854775808.0) as UInt64)
    print("UInt below 2^64 {}", held(v: 18446744073709549568.0) as UInt)
    print("Int -0.0 {}", held(v: -0.0) as Int)
    print("Int 0.9 {}", held(v: 0.9) as Int)
    print("UInt -0.9 {}", held(v: -0.9) as UInt)
    print("UInt64 -0.9 {}", held(v: -0.9) as UInt64)
    print("Byte 200.7 {}", held(v: 200.7) as Byte)
    print("Int8 constant 2.9 {}", 2.9 as Int8)
    print("Int constant -2.9 {}", -2.9 as Int)
}
