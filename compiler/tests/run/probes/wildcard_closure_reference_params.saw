// probe: stated
// about: two `&_` closure parameters bind nothing (SL-978)
// stage 0: not run; the probe holds sawc to the spec's `_` binds-nothing rule, row by row
// speeds: -O0 -O2
// prints: 15

func applyr(f: (&Int, &Int) -> Int) -> Int {
    let a = 5
    let b = 6
    f(&a, &b)
}

func main() {
    print(applyr({ &_, &_ in 15 }))
