// probe: stated
// about: the deadlock walk a pool worker makes while its only task waits on a channel reads another `TaskGroup(threads: 2)`, registered in `main`'s executor record, only under that record's latch, while a task on `main` tears that pool down, round after round, conformance row K192 (SL-808)
// stage 0: runs it alike, but on its own std's executor, so a recorded run says nothing about these walks (SL-808)
// speeds: -O0 -O2
// prints: total 210
import std.channel.{Channel}

func quick(n: Int) -> Int {
    n + 1
}

func recv_one(c: Channel<Int>) -> Int {
    try! c.receive()
}

// Starts, uses and tears down a fresh pool each round, inside a task, so the
// teardown drives `main`'s thread meanwhile.
func churn(rounds: Int) -> Int {
    var sum = 0
    var k = 0
    while k < rounds {
        sum = sum + one_round(k)
        k = k + 1
    }
    sum
}

// One round's pool, made, used and torn down inside the call, so the task's
// frame never holds a group across its loop's suspension point.
func one_round(k: Int) -> Int {
    var inner = try! TaskGroup(threads: 2)
    let h = inner.spawn(quick(k))
    h.join()
}

func main() {
    var waiting = try! TaskGroup(threads: 2)
    var group = TaskGroup()
    let c = try! Channel<Int>()
    let p = waiting.spawn(recv_one(c.copy()))
    let t = group.spawn(churn(20))
    let churned = t.join()
    try! c.send(churned)
    print("total {}", p.join())
}
