// probe: stated
// about: the scheduler's walk stands on `main`'s group and the sleep order gives the turn to a background task; that task's join runs a nested sweep that resumes `main`, which drops the group, and the outer walk never reads it again (SL-1109)
// stage 0: runs it on its own std's executor, which gives no turn by the sleep order (SL-977)
// speeds: -O0 -O2
// prints: joined 1 and 1
// `helper` sleeps first, so its deadline is the earliest. `one_round` spawns
// `hog` and `napper` and sleeps 3 ms; `napper` sleeps 1 ms. On the next pass
// `hog` holds the thread 5 ms, so every deadline has passed when the walk
// reaches `napper`, and the earliest expired sleeper is `helper`, in another
// group. `helper` joins a task of its own inside that one turn; the join's
// sweep runs `napper` to its end, then resumes `main`, which joins `napper`
// and drops the group the outer walk stands on.

import std.task.*
import std.time.{Instant}

static TICK_MS: UInt64 = 1

func hold(millis: UInt64) sync {
    let start = Instant.now()
    while start.elapsed().as_millis() < millis {}
}

func hog() -> Int {
    yield_now()
    hold(5)
    0
}

func napper() -> Int {
    sleep(Duration.ms(TICK_MS))
    1
}

func quick() -> Int {
    sleep(Duration.ms(6))
    1
}

func helper() -> Int {
    sleep(Duration.ms(TICK_MS))
    let h = Task.spawn(quick())
    h.join()
}

func one_round() -> Int {
    var group = TaskGroup()
    let _ = group.spawn(hog())
    let t = group.spawn(napper())
    sleep(Duration.ms(3))
    t.join()
}

func settle(n: Int) {
    var i = 0
    while i < n {
        sleep(Duration.ms(TICK_MS))
        i = i + 1
    }
}

func main() {
    let y = Task.spawn(helper())
    yield_now()
    let n = one_round()
    settle(10)
    let m = y.join()
    print("joined {n} and {m}")
}
