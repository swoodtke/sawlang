// probe: panics
// about: a failed `assert` panics on standard error while the program's prints stay on standard output (SL-768)
// stage 0: its record follows whichever stream Stage 0 writes, so it cannot pin the stream
// speeds: -O0 -O2
// prints: before
// panics: assertion failed: n is 9
func check(n: Int) {
    assert(n < 3, "n is {}", n)
}

func main() {
    print("before")
    check(9)
}
