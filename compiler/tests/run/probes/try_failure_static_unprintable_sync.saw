// probe: panics
// about: `try!` on a static method call that fails with a struct with no `Printable` conformance, which keeps the bare reason, in a sync body, panics `try! failed` and calls no rendering helper (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed
// ll omits: saw try failure try_failure_static_unprintable_sync.Plain

struct Plain {
    n: Int
}

struct Maker {
    n: Int
}

extension Maker {
    static func build(fail: Bool) -> Result<Int, Plain> {
        if fail {
            return Plain(n: 3)
        }
        return 1
    }
}

func run() {
    print("start")
    let v = try! Maker.build(true)
    print("unreached")
}

func main() {
    run()
}
