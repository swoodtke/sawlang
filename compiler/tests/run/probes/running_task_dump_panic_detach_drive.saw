// probe: panics
// about: a task inside the drive of a `Thread.join` in thread context (`waits_drive`) that detached a task it spawned and then panics dumps only its live frames, its own at the line of the drive that returned, never that drive's released slot (SL-863)
// stage 0: runs it on its own std's executor, whose task dump this does not pin (SL-863)
// speeds: -O0 -O2
// prints: saw tasks: 2 live (unsynchronized snapshot)
// prints:   task group 1 slot 0 gen 1 ready
// prints:     at running_task_dump_panic_detach_drive.saw:0 in long_work
// prints:   task group 2 slot 0 gen 1 running
// prints:     at running_task_dump_panic_detach_drive.saw:52 in p
// panics: after the fate
import std.task.*

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static RELEASED: Atomic<Int> = Atomic(0)

static LONG_ROUNDS: Int = 50

// Runs about 100 ms unless cancelled.
func long_work(i: Int) -> Int {
    var n = 0
    while n < LONG_ROUNDS && not cancelled() {
        sleep(Duration.ms(2))
        n = n + 1
    }
    i
}

func fate_detach(i: Int) -> Int {
    yield_now()
    let h = Task.spawn(long_work(i))
    h.detach()
    i
}

func hold() -> Int {
    hold_until_released()
    7
}

// A blocking wait for a thread, in thread context: the join drives the
// group, so `p` runs inside that drive while the thread holds, and `main`
// never suspends.
func wait_for_thread() blocking -> Int {
    var t = try! Thread.spawn { hold() }
    t.join()
}

func p(i: Int) -> Int {
    let v = fate_detach(i)
    dump_tasks()
    if v >= 0 {
        panic("after the fate {}", v)
    }
    v
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(p(1))
    print("T {}", wait_for_thread())
    print("P {}", h.join())
}

// The thread holds until RELEASED is set, never for a span of time, so `p`
// runs to its end inside the join's drive however slowly the machine runs.
// This `p` never sets it: its panic ends the process first. The 1ms tick paces
// the poll; the 10s deadline bounds only genuine breakage (TESTING.md,
// "Waiting in a multi-threaded test").
static HOLD_TICK_NANOS: UInt64 = 1_000_000
static HOLD_DEADLINE_TICKS: Int = 10000

func hold_until_released() {
    var ticks = 0
    while RELEASED.load() == 0 {
        if ticks >= HOLD_DEADLINE_TICKS {
            panic("the thread: nothing released it")
        }
        __saw_rt_sleep_ns(HOLD_TICK_NANOS)
        ticks = ticks + 1
    }
}
