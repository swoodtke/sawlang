// probe: panics
// about: a `Box<TaskGroup>` moved into a function that drops it while a handle minted through its borrow window is outstanding panics at the group's teardown (SL-564)
// stage 0: cannot parse a `borrow` block
// speeds: -O0 -O2
// prints: window closed
// prints: consumed
// panics: TaskGroup: destroyed while 1 task handle still refers to it
import std.task.{yield_now}

func work(n: Int) -> Int {
    yield_now()
    n * 2
}

func consume(b: Box<TaskGroup>) {
    print("consumed")
}

func main() {
    var g = try! Box<TaskGroup>.make(TaskGroup())
    var kept: Task<Int>? = None
    borrow var p = g.value() {
        kept = p.spawn(work(7))
    }
    print("window closed")
    consume(move g)
    print("after consume")
    print("joined {}", kept.take()!.join())
}
