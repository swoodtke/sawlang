struct SharedShape { e: Shape, ok: Bool }
extension SharedShape: NoCopy {}
extension SharedShape {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Shape? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}

func lent_optional_copy_int() {
    var v = Vector<Int>()
    try! v.push(7)
    var u = UserInt(e: 7, ok: true, closes: 0)
    var ua = UserInt(e: 7, ok: false, closes: 0)
    let s = SharedInt(e: 7, ok: true)
    let sa = SharedInt(e: 7, ok: false)
    if let c = v.find(0).copy() { print("int vec present {tag(&c)}") } else { print("int vec present none") }
    if true {
        let d = v.find(0).copy()
        print("int vec present let {d.is_some()}")
    }
    if let c = v.find(9).copy() { print("int vec absent {tag(&c)}") } else { print("int vec absent none") }
    if true {
        let d = v.find(9).copy()
        print("int vec absent let {d.is_some()}")
    }
    if let c = u.slot().copy() { print("int user present {tag(&c)}") } else { print("int user present none") }
    if true {
        let d = u.slot().copy()
        print("int user present let {d.is_some()}")
    }
    if let c = ua.slot().copy() { print("int user absent {tag(&c)}") } else { print("int user absent none") }
    if true {
        let d = ua.slot().copy()
        print("int user absent let {d.is_some()}")
    }
    if let c = s.slot().copy() { print("int shared present {tag(&c)}") } else { print("int shared present none") }
    if true {
        let d = s.slot().copy()
        print("int shared present let {d.is_some()}")
    }
    if let c = sa.slot().copy() { print("int shared absent {tag(&c)}") } else { print("int shared absent none") }
    if true {
        let d = sa.slot().copy()
        print("int shared absent let {d.is_some()}")
    }
    print("int user closes {u.closes} {ua.closes}")
}

