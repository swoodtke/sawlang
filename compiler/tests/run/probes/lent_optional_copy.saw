// probe: stated
// about: `.copy()` of a conditional lend's optional place is the optional copy at the payload's tier, ExplicitCopy included, the window closing at the read (SL-899)
// stage 0: refuses a `borrows` call written without `borrow`
// speeds: -O0 -O2
// leaks: none
// prints: int vec present 7
// prints: int vec present let true
// prints: int vec absent none
// prints: int vec absent let false
// prints: int user present 7
// prints: int user present let true
// prints: int user absent none
// prints: int user absent let false
// prints: int shared present 7
// prints: int shared present let true
// prints: int shared absent none
// prints: int shared absent let false
// prints: int user closes 2 0
// prints: named vec present 3
// prints: named vec present let true
// prints: named vec absent none
// prints: named vec absent let false
// prints: named user present 3
// prints: named user present let true
// prints: named user absent none
// prints: named user absent let false
// prints: named shared present 3
// prints: named shared present let true
// prints: named shared absent none
// prints: named shared absent let false
// prints: named user closes 2 0
// prints: bag vec present 2
// prints: bag vec present let true
// prints: bag vec absent none
// prints: bag vec absent let false
// prints: bag user present 2
// prints: bag user present let true
// prints: bag user absent none
// prints: bag user absent let false
// prints: bag shared present 2
// prints: bag shared present let true
// prints: bag shared absent none
// prints: bag shared absent let false
// prints: bag user closes 2 0
// prints: shape vec present 3
// prints: shape vec present let true
// prints: shape vec absent none
// prints: shape vec absent let false
// prints: shape user present 3
// prints: shape user present let true
// prints: shape user absent none
// prints: shape user absent let false
// prints: shape shared present 3
// prints: shape shared present let true
// prints: shape shared absent none
// prints: shape shared absent let false
// prints: shape user closes 2 0

func tag(x: &Int) -> Int { x }
struct Named { name: String }
@synthesize
extension Named: Equatable {}
func tag(x: &Named) -> Int { x.name.len() }
struct Bag { items: Vector<Int> }
@synthesize
extension Bag: ExplicitCopy {}
@synthesize
extension Bag: Equatable {}
func tag(x: &Bag) -> Int { x.items.len() }
enum Shape { case Circle(r: Int), case Label(s: String) }
@synthesize
extension Shape: Equatable {}
func tag(x: &Shape) -> Int {
    match x {
        case Circle(r) -> r,
        case Label(s) -> s.len()
    }
}

// The user accessor counts its epilogues, which run only when it lent.
struct UserInt { e: Int, ok: Bool, closes: Int }
extension UserInt: NoCopy {}
extension UserInt {
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedInt { e: Int, ok: Bool }
extension SharedInt: NoCopy {}
extension SharedInt {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserNamed { e: Named, ok: Bool, closes: Int }
extension UserNamed: NoCopy {}
extension UserNamed {
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedNamed { e: Named, ok: Bool }
extension SharedNamed: NoCopy {}
extension SharedNamed {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
