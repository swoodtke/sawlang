// probe: panics
// about: `try!` on a method call that fails with a user enum conforming to `Printable`, in a sync body, panics with the error rendered after `try! failed: ` through its error type's helper (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed: bad code
// ll defines: saw try failure try_failure_method_enum_sync.Code

enum Code {
    case Bad,
    case Worse
}

extension Code: Printable {
    func format(&self, into: &var StringBuilder) {
        match self {
            case Bad -> try! into.append("bad code"),
            case Worse -> try! into.append("worse code")
        }
    }
}

struct Maker {
    n: Int
}

extension Maker {
    func make(&self, fail: Bool) -> Result<Int, Code> {
        if fail {
            return Code.Bad
        }
        return self.n
    }
}

func run() {
    print("start")
    let v = try! Maker(n: 1).make(true)
    print("unreached")
}

func main() {
    run()
}
