// probe: stated
// about: Directory.set_current moves the working directory, which a relative path then resolves against, and surfaces the Err of a directory that is missing (SL-720)
// stage 0: its Directory.current returns `Path?`, so it cannot build this source
// speeds: -O0 -O2
// prints: true
// prints: false
// prints: set_cwd missing: surfaced
// prints: true
import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}

func main() {
    try! Directory.set_current(Path(s: "/"))
    print(File.exists(Path(s: "etc")))
    print(File.exists(Path(s: "no_such_entry_in_the_root")))

    match Directory.set_current(Path(s: "/no_such_directory_for_set_cwd")) {
        case Ok(_) -> print("set_cwd UNEXPECTED ok"),
        case Err(_) -> print("set_cwd missing: surfaced")
    }
    // The failed call leaves the directory where it was.
    print(File.exists(Path(s: "etc")))
}
