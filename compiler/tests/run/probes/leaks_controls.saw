func receiver_call(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = make(i % 2).len()
        hits = hits + got
        i = i + 1
    }
    hits
}

func receiver_literal(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = "alpha1".len()
        hits = hits + got
        i = i + 1
    }
    hits
}

func receiver_getitem(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = f.names[i % 2].len()
        hits = hits + got
        i = i + 1
    }
    hits
}

func receiver_callfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let got = mk_tok(i % 2).text.len()
        hits = hits + got
        i = i + 1
    }
    hits
}

func segment_call(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = "[{make(i % 2)}]"
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func segment_literal(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = "[{"alpha1"}]"
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func segment_getitem(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = "[{f.names[i % 2]}]"
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func segment_callfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = "[{mk_tok(i % 2).text}]"
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func let_bound_call(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = make(i % 2)
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func let_bound_literal(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = "alpha1"
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func let_bound_getitem(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = f.names[i % 2]
        hits = hits + s.len()
        i = i + 1
    }
    hits
}

func let_bound_callfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let s = mk_tok(i % 2).text
        hits = hits + s.len()
        i = i + 1
    }
    hits
}
func main() {
    let f = fixture()
    print("eq left call {}", eq_left_call(&f, 6, true))
    print("eq left literal {}", eq_left_literal(&f, 6, true))
    print("eq left getitem {}", eq_left_getitem(&f, 6, true))
    print("eq left callfield {}", eq_left_callfield(&f, 6, true))
    print("ne call {}", ne_call(&f, 6, true))
    print("ne literal {}", ne_literal(&f, 6, true))
    print("ne getitem {}", ne_getitem(&f, 6, true))
    print("ne callfield {}", ne_callfield(&f, 6, true))
    print("if cond call {}", if_cond_call(&f, 6, true))
    print("if cond literal {}", if_cond_literal(&f, 6, true))
    print("if cond getitem {}", if_cond_getitem(&f, 6, true))
    print("if cond callfield {}", if_cond_callfield(&f, 6, true))
    print("receiver call {}", receiver_call(&f, 6, true))
    print("receiver literal {}", receiver_literal(&f, 6, true))
    print("receiver getitem {}", receiver_getitem(&f, 6, true))
    print("receiver callfield {}", receiver_callfield(&f, 6, true))
    print("segment call {}", segment_call(&f, 6, true))
    print("segment literal {}", segment_literal(&f, 6, true))
    print("segment getitem {}", segment_getitem(&f, 6, true))
    print("segment callfield {}", segment_callfield(&f, 6, true))
    print("let bound call {}", let_bound_call(&f, 6, true))
    print("let bound literal {}", let_bound_literal(&f, 6, true))
    print("let bound getitem {}", let_bound_getitem(&f, 6, true))
    print("let bound callfield {}", let_bound_callfield(&f, 6, true))
}
