// probe: custom
// about: `sawc build --freestanding` writes an ELF object whose roots are its exports and its `main`, the entry `__saw_main` external beside the export (SL-1143)
// Built with `--freestanding --target aarch64-unknown-none-elf` at -O0 and
// -O2: no C `main` and no argument accessors, the export and `__saw_main`
// each defined in a section of its own, the panic seam its overflow check
// reaches undefined, and this file's `main` an internal function the entry
// calls. Its `.ll` names the aarch64 default `-neon,-fp-armv8`, which
// `--target-features` replaces, and a Mach-O triple is refused.

func triple(x: Int) -> Int {
    x * 3
}

func main() -> Int {
    triple(2)
}

@export("probe_freestanding_entry")
func entry(n: Int) -> Int {
    triple(n) + 1
}
