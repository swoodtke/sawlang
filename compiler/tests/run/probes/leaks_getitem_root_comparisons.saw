// probe: stated
// about: a getitem's element copy that a field, tuple element, payload or index is read through is dropped, at every comparison position (SL-825)
// stage 0: leaks the element copy (SL:hazards S23)
// speeds: -O0 -O2
// leaks: none
// prints: eq left getfield 3
// prints: eq left gettuple 3
// prints: eq left getforce 3
// prints: eq left getindex 3
// prints: eq left getfield2 3
// prints: eq right getfield 3
// prints: eq right gettuple 3
// prints: eq right getforce 3
// prints: eq right getindex 3
// prints: eq right getfield2 3
// prints: ne getfield 3
// prints: ne gettuple 3
// prints: ne getforce 3
// prints: ne getindex 3
// prints: ne getfield2 3
// prints: lt getfield 3
// prints: lt gettuple 3
// prints: lt getforce 3
// prints: lt getindex 3
// prints: lt getfield2 6
// prints: and rhs getfield 3
// prints: and rhs gettuple 3
// prints: and rhs getforce 3
// prints: and rhs getindex 3
// prints: and rhs getfield2 3
// prints: or first getfield 3
// prints: or first gettuple 3
// prints: or first getforce 3
// prints: or first getindex 3
// prints: or first getfield2 3
// prints: if cond getfield 3
// prints: if cond gettuple 3
// prints: if cond getforce 3
// prints: if cond getindex 3
// prints: if cond getfield2 3
// prints: while cond getfield 6
// prints: while cond gettuple 6
// prints: while cond getforce 6
// prints: while cond getindex 6
// prints: while cond getfield2 6
// Each cell reads a part through a getitem six times over two elements; the
// lane runs every build under `leaks --atExit` and requires no leak.

struct Tok {
    text: String,
    alias: String?,
    kind: Int
}

struct Outer {
    inner: Tok,
    tag: String
}

struct Fixture {
    toks: Vector<Tok>,
    outers: Vector<Outer>,
    pairs: Vector<(String, Int)>,
    opairs: Vector<(String?, Int)>,
    somes: Vector<String?>,
    arrs: Vector<[String; 2]>,
    names: Vector<String>
}

extension Fixture: NoCopy {}

enum Bad {
    case Nope
}

func make(n: Int) -> String {
    "alpha{n}"
}

func nothing(n: Int) -> String? {
    if n < 0 {
        return "neg{n}"
    }
    None
}

func fallible(n: Int) -> Result<String, Bad> {
    if n < 0 {
        return Bad.Nope
    }
    return "alpha{n}"
}

func mk_tok(n: Int) -> Tok {
    Tok(text: "alpha{n}", alias: "al{n}", kind: n)
}

func mk_outer(n: Int) -> Outer {
    Outer(inner: mk_tok(n), tag: "t{n}")
}

func consume(s: String) -> Int {
    s.len()
}

func fixture() -> Fixture {
    var toks = Vector<Tok>()
    try! toks.push(Tok(text: "alpha{1}", alias: "al{1}", kind: 1))
    try! toks.push(Tok(text: "beta{2}", alias: None, kind: 2))
    var outers = Vector<Outer>()
    try! outers.push(mk_outer(1))
    try! outers.push(mk_outer(2))
    var pairs = Vector<(String, Int)>()
    try! pairs.push(("alpha{1}", 1))
    try! pairs.push(("beta{2}", 2))
    var opairs = Vector<(String?, Int)>()
    try! opairs.push(("oa{1}", 1))
    try! opairs.push((None, 2))
    var somes = Vector<String?>()
    try! somes.push("alpha{1}")
    try! somes.push("beta{2}")
    var arrs = Vector<[String; 2]>()
    try! arrs.push(["alpha{1}", "x{1}"])
    try! arrs.push(["beta{2}", "y{2}"])
    var names = Vector<String>()
    try! names.push("alpha{1}")
    try! names.push("beta{2}")
    Fixture(toks: move toks, outers: move outers, pairs: move pairs, opairs: move opairs, somes: move somes,
            arrs: move arrs, names: move names)
}

func eq_left_getfield(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = f.toks[i % 2].text == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_left_gettuple(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = f.pairs[i % 2].0 == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_left_getforce(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = f.somes[i % 2]! == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

