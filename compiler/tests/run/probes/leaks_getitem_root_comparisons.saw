func main() {
    let f = fixture()
    print("eq left getfield {}", eq_left_getfield(&f, 6, true))
    print("eq left gettuple {}", eq_left_gettuple(&f, 6, true))
    print("eq left getforce {}", eq_left_getforce(&f, 6, true))
    print("eq left getindex {}", eq_left_getindex(&f, 6, true))
    print("eq left getfield2 {}", eq_left_getfield2(&f, 6, true))
    print("eq right getfield {}", eq_right_getfield(&f, 6, true))
    print("eq right gettuple {}", eq_right_gettuple(&f, 6, true))
    print("eq right getforce {}", eq_right_getforce(&f, 6, true))
    print("eq right getindex {}", eq_right_getindex(&f, 6, true))
    print("eq right getfield2 {}", eq_right_getfield2(&f, 6, true))
    print("ne getfield {}", ne_getfield(&f, 6, true))
    print("ne gettuple {}", ne_gettuple(&f, 6, true))
    print("ne getforce {}", ne_getforce(&f, 6, true))
    print("ne getindex {}", ne_getindex(&f, 6, true))
    print("ne getfield2 {}", ne_getfield2(&f, 6, true))
    print("lt getfield {}", lt_getfield(&f, 6, true))
    print("lt gettuple {}", lt_gettuple(&f, 6, true))
    print("lt getforce {}", lt_getforce(&f, 6, true))
    print("lt getindex {}", lt_getindex(&f, 6, true))
    print("lt getfield2 {}", lt_getfield2(&f, 6, true))
    print("and rhs getfield {}", and_rhs_getfield(&f, 6, true))
    print("and rhs gettuple {}", and_rhs_gettuple(&f, 6, true))
    print("and rhs getforce {}", and_rhs_getforce(&f, 6, true))
    print("and rhs getindex {}", and_rhs_getindex(&f, 6, true))
    print("and rhs getfield2 {}", and_rhs_getfield2(&f, 6, true))
    print("or first getfield {}", or_first_getfield(&f, 6, true))
    print("or first gettuple {}", or_first_gettuple(&f, 6, true))
    print("or first getforce {}", or_first_getforce(&f, 6, true))
    print("or first getindex {}", or_first_getindex(&f, 6, true))
    print("or first getfield2 {}", or_first_getfield2(&f, 6, true))
    print("if cond getfield {}", if_cond_getfield(&f, 6, true))
    print("if cond gettuple {}", if_cond_gettuple(&f, 6, true))
    print("if cond getforce {}", if_cond_getforce(&f, 6, true))
    print("if cond getindex {}", if_cond_getindex(&f, 6, true))
    print("if cond getfield2 {}", if_cond_getfield2(&f, 6, true))
    print("while cond getfield {}", while_cond_getfield(&f, 6, true))
    print("while cond gettuple {}", while_cond_gettuple(&f, 6, true))
    print("while cond getforce {}", while_cond_getforce(&f, 6, true))
    print("while cond getindex {}", while_cond_getindex(&f, 6, true))
    print("while cond getfield2 {}", while_cond_getfield2(&f, 6, true))
}
