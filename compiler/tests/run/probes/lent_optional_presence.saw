func lent_optional_presence_int() {
    var v = Vector<Int>()
    try! v.push(7)
    var u = UserInt(e: 7, ok: true, closes: 0)
    var ua = UserInt(e: 7, ok: false, closes: 0)
    let s = SharedInt(e: 7, ok: true)
    let sa = SharedInt(e: 7, ok: false)
    print("int vec present {v.find(0).is_some()} {v.find(0).is_none()}")
    print("int vec present {v.find(0) == None} {v.find(0) != None} {None == v.find(0)}")
    print("int vec absent {v.find(9).is_some()} {v.find(9).is_none()}")
    print("int vec absent {v.find(9) == None} {v.find(9) != None} {None == v.find(9)}")
    print("int user present {u.slot().is_some()} {u.slot().is_none()}")
    print("int user present {u.slot() == None} {u.slot() != None} {None == u.slot()}")
    print("int user absent {ua.slot().is_some()} {ua.slot().is_none()}")
    print("int user absent {ua.slot() == None} {ua.slot() != None} {None == ua.slot()}")
    print("int shared present {s.slot().is_some()} {s.slot().is_none()}")
    print("int shared present {s.slot() == None} {s.slot() != None} {None == s.slot()}")
    print("int shared absent {sa.slot().is_some()} {sa.slot().is_none()}")
    print("int shared absent {sa.slot() == None} {sa.slot() != None} {None == sa.slot()}")
    print("int user closes {u.closes} {ua.closes}")
}

func lent_optional_presence_named() {
    var v = Vector<Named>()
    try! v.push(Named(name: "ann"))
    var u = UserNamed(e: Named(name: "ann"), ok: true, closes: 0)
    var ua = UserNamed(e: Named(name: "ann"), ok: false, closes: 0)
    let s = SharedNamed(e: Named(name: "ann"), ok: true)
    let sa = SharedNamed(e: Named(name: "ann"), ok: false)
    print("named vec present {v.find(0).is_some()} {v.find(0).is_none()}")
    print("named vec present {v.find(0) == None} {v.find(0) != None} {None == v.find(0)}")
    print("named vec absent {v.find(9).is_some()} {v.find(9).is_none()}")
    print("named vec absent {v.find(9) == None} {v.find(9) != None} {None == v.find(9)}")
    print("named user present {u.slot().is_some()} {u.slot().is_none()}")
    print("named user present {u.slot() == None} {u.slot() != None} {None == u.slot()}")
    print("named user absent {ua.slot().is_some()} {ua.slot().is_none()}")
    print("named user absent {ua.slot() == None} {ua.slot() != None} {None == ua.slot()}")
    print("named shared present {s.slot().is_some()} {s.slot().is_none()}")
    print("named shared present {s.slot() == None} {s.slot() != None} {None == s.slot()}")
    print("named shared absent {sa.slot().is_some()} {sa.slot().is_none()}")
    print("named shared absent {sa.slot() == None} {sa.slot() != None} {None == sa.slot()}")
    print("named user closes {u.closes} {ua.closes}")
}

func lent_optional_presence_bag() {
    var v = Vector<Bag>()
    try! v.push(Bag(items: [1, 2]))
    var u = UserBag(e: Bag(items: [1, 2]), ok: true, closes: 0)
    var ua = UserBag(e: Bag(items: [1, 2]), ok: false, closes: 0)
    let s = SharedBag(e: Bag(items: [1, 2]), ok: true)
    let sa = SharedBag(e: Bag(items: [1, 2]), ok: false)
    print("bag vec present {v.find(0).is_some()} {v.find(0).is_none()}")
    print("bag vec present {v.find(0) == None} {v.find(0) != None} {None == v.find(0)}")
