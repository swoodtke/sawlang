// probe: stated
// about: `is_some()`, `is_none()`, `== None` and `!= None` of a conditional lend's optional place read its tag alone, at every copy tier, NoCopy included (SL-899)
// stage 0: refuses a `borrows` call written without `borrow`
// speeds: -O0 -O2
// leaks: none
// prints: int vec present true false
// prints: int vec present false true false
// prints: int vec absent false true
// prints: int vec absent true false true
// prints: int user present true false
// prints: int user present false true false
// prints: int user absent false true
// prints: int user absent true false true
// prints: int shared present true false
// prints: int shared present false true false
// prints: int shared absent false true
// prints: int shared absent true false true
// prints: int user closes 5 0
// prints: named vec present true false
// prints: named vec present false true false
// prints: named vec absent false true
// prints: named vec absent true false true
// prints: named user present true false
// prints: named user present false true false
// prints: named user absent false true
// prints: named user absent true false true
// prints: named shared present true false
// prints: named shared present false true false
// prints: named shared absent false true
// prints: named shared absent true false true
// prints: named user closes 5 0
// prints: bag vec present true false
// prints: bag vec present false true false
// prints: bag vec absent false true
// prints: bag vec absent true false true
// prints: bag user present true false
// prints: bag user present false true false
// prints: bag user absent false true
// prints: bag user absent true false true
// prints: bag shared present true false
// prints: bag shared present false true false
// prints: bag shared absent false true
// prints: bag shared absent true false true
// prints: bag user closes 5 0
// prints: shape vec present true false
// prints: shape vec present false true false
// prints: shape vec absent false true
// prints: shape vec absent true false true
// prints: shape user present true false
// prints: shape user present false true false
// prints: shape user absent false true
// prints: shape user absent true false true
// prints: shape shared present true false
// prints: shape shared present false true false
// prints: shape shared absent false true
// prints: shape shared absent true false true
// prints: shape user closes 5 0
// prints: res vec present true false
// prints: res vec present false true false
// prints: res vec absent false true
// prints: res vec absent true false true
// prints: res user present true false
// prints: res user present false true false
// prints: res user absent false true
// prints: res user absent true false true
// prints: res shared present true false
// prints: res shared present false true false
// prints: res shared absent false true
// prints: res shared absent true false true
// prints: res user closes 5 0

func tag(x: &Int) -> Int { x }
struct Named { name: String }
@synthesize
extension Named: Equatable {}
func tag(x: &Named) -> Int { x.name.len() }
struct Bag { items: Vector<Int> }
@synthesize
extension Bag: ExplicitCopy {}
@synthesize
extension Bag: Equatable {}
func tag(x: &Bag) -> Int { x.items.len() }
enum Shape { case Circle(r: Int), case Label(s: String) }
@synthesize
extension Shape: Equatable {}
func tag(x: &Shape) -> Int {
    match x {
        case Circle(r) -> r,
        case Label(s) -> s.len()
    }
}
struct Res { id: Int }
extension Res: NoCopy {}
@synthesize
extension Res: Equatable {}
func tag(x: &Res) -> Int { x.id }

// The user accessor counts its epilogues, which run only when it lent.
struct UserInt { e: Int, ok: Bool, closes: Int }
extension UserInt: NoCopy {}
extension UserInt {
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedInt { e: Int, ok: Bool }
extension SharedInt: NoCopy {}
extension SharedInt {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserNamed { e: Named, ok: Bool, closes: Int }
extension UserNamed: NoCopy {}
extension UserNamed {
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedNamed { e: Named, ok: Bool }
extension SharedNamed: NoCopy {}
extension SharedNamed {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
