// probe: custom
// about: a `--freestanding` object whose runtime declares both background entries, under a program with no spawn site, defines them with nothing to do (SL-1150)
// Built with `--freestanding --target aarch64-unknown-none-elf -c` whole and with
// `--codegen-units=module`: both entries are external definitions, and the
// declaration alone reaches no reactor seam.

extern "C" {
    func __saw_background_drive() -> Int64
    func __saw_background_close()
}

@export("probe_background_quiet_start")
func start() -> Int64 {
    let next = __saw_background_drive()
    __saw_background_close()
    next
}
