// probe: stated
// about: a `for` head reading through a two-site accessor whose second site alone holds a local across a suspension reads it back only on that site's path (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: epi 0
// prints: j 0
// prints: j 1
// prints: epi 1 2
// prints: drop t2
// prints: k 0
// prints: k 1
// prints: k 2
// prints: a 2 b 3
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

func sink(t: Tag) {
    print("sink t{}", t.id)
}

struct Two {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two: NoCopy {}

extension Two {
    func pick(&var self, first: Bool, i: Int) borrows -> &var Int {
        if first {
            lend self.a[i]
            print("epi 0")
        } else {
            let t = Tag(id: 2)
            yield_now()
            lend self.b[i]
            print("epi 1 {}", t.id)
        }
    }
}

func main() {
    var s = Two(a: [2], b: [3])
    for j in 0..borrow s.pick(true, 0) {
        print("j {}", j)
    }
    for j in 0..borrow s.pick(false, 0) {
        yield_now()
        print("k {}", j)
    }
    print("a {} b {}", s.a[0], s.b[0])
}
