// probe: stated
// about: a shift count that is constant only per instantiation of a const generic is no certain fault: behind its guard `top_bit<0>` never shifts, so typecheck accepts it and the count stays a run-time check (SL-543), and `N` reads as each instance's value (SL-548)
// stage 0: prints the same line, but this program has no Stage 0 record on either host (it was due until SL-548), so the line is stated
// speeds: -O0 -O2
// prints: 1 8
func top_bit<const N: Int>(x: Int) -> Int {
    if N > 0 { x << (N - 1) } else { x }
}

func main() {
    print("{} {}", top_bit<0>(1), top_bit<4>(1))
}
