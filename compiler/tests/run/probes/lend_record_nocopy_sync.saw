// probe: stated
// about: an accessor with two or three `lend` sites, each holding a NoCopy struct owning a `Vector` across its own `lend` or none, for every set of holding sites, with nothing suspending, writes into the state record and reads back on each site's path only the locals that site holds, each dropped once, conformance row K220 (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: cell n2_h0
// prints: epi 0 0
// prints: epi 1
// prints: a 1 b 2 c 0
// prints: cell n2_h1
// prints: epi 0
// prints: epi 1 1
// prints: a 1 b 2 c 0
// prints: cell n2_h01
// prints: epi 0 0
// prints: epi 1 1
// prints: a 1 b 2 c 0
// prints: cell n3_h0
// prints: epi 0 0
// prints: epi 1
// prints: epi 2
// prints: a 1 b 2 c 3
// prints: cell n3_h1
// prints: epi 0
// prints: epi 1 1
// prints: epi 2
// prints: a 1 b 2 c 3
// prints: cell n3_h2
// prints: epi 0
// prints: epi 1
// prints: epi 2 2
// prints: a 1 b 2 c 3
// prints: cell n3_h01
// prints: epi 0 0
// prints: epi 1 1
// prints: epi 2
// prints: a 1 b 2 c 3
// prints: cell n3_h02
// prints: epi 0 0
// prints: epi 1
// prints: epi 2 2
// prints: a 1 b 2 c 3
// prints: cell n3_h12
// prints: epi 0
// prints: epi 1 1
// prints: epi 2 2
// prints: a 1 b 2 c 3
// prints: cell n3_h012
// prints: epi 0 0
// prints: epi 1 1
// prints: epi 2 2
// prints: a 1 b 2 c 3
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

struct Bag {
    v: Vector<Int>
}

extension Bag: NoCopy {}

struct Sites_n2_h0 {
    a: Vector<Int>
    b: Vector<Int>
    c: Vector<Int>
}

extension Sites_n2_h0: NoCopy {}

extension Sites_n2_h0 {
    func pick(&var self, which: Int, i: Int) borrows -> &var Int {
        if which == 0 {
            let t0 = Bag(v: [0, i])
            lend self.a[i]
            print("epi 0 {}", t0.v[0])
        } else {
            lend self.b[i]
            print("epi 1")
        }
    }
}

func cell_n2_h0() {
    print("cell n2_h0")
    var s = Sites_n2_h0(a: [0], b: [0], c: [0])
    s.pick(0, 0) += 1
    s.pick(1, 0) += 2
    print("a {} b {} c {}", s.a[0], s.b[0], s.c[0])
}

