// probe: stated
// about: typed `_` closure parameters bind nothing, and their annotations still type the closure (SL-978)
// stage 0: not run; the probe holds sawc to the spec's `_` binds-nothing rule, row by row
// speeds: -O0 -O2
// prints: 13

func apply2(f: (Int, Int) -> Int) -> Int { f(5, 6) }

func main() {
    print(apply2({ _: Int, _: Int in 13 }))
}
