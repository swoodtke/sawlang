// probe: stated
// about: a cancelled `Command.output()` leaves its child running, and the next spawn reaps it once it exits, so no zombie is left for nobody (SL-799)
// stage 0: cannot run it, since its `std.process` has no `Command.output()` that returns a `Result` and ends in `SystemError.Interrupted`
// speeds: -O0 -O2
// prints: interrupted 20 of 20
// prints: zombies left for nobody: 0
//
// Each round's child closes its standard output at once, so the drain ends
// and `output()` waits on the child's exit, and the child then waits on a
// gate pipe, its standard input, that stays open until every round is over.
// So each cancel lands while its child runs, which the child says by writing
// its pid and a newline to its standard error, the write end of a second pipe.
// A child inherits only its standard descriptors, so the program puts that
// write end at its own standard error while it launches a child, and puts its
// own back once the line has come. Closing the gate ends every child, and the
// second pipe then reads end of file once every child holding it has begun to
// exit. A child's descriptors close before it can be waited on, so the end of
// file does not mean the children are zombies yet. Each spawn sweeps the orphan
// list, so the program spawns again until no recorded pid exists: `kill(pid, 0)`
// answers 0 for a running child and a zombie alike, and -1 once it is reaped.
// `waitpid(-1, WNOHANG)` then counts what no one reaped.

import std.process.{Command, CommandOutput}
import std.time.{Instant}

struct PollFd { fd: Int32, events: Int16, revents: Int16 }

extern "C" {
    func waitpid(pid: Int32, status: UnsafePointer<Int32>, options: Int32) -> Int32
    func pipe(ends: UnsafePointer<Int32>) -> Int32
    func dup(fd: Int32) -> Int32
    func dup2(from: Int32, to: Int32) -> Int32
    func close(fd: Int32) -> Int32
    func read(fd: Int32, bytes: UnsafePointer<UInt8>, count: Int) -> Int
    // `nfds_t` is 32 bits on macOS and 64 on Linux; a word carries either.
    func poll(fds: UnsafePointer<PollFd>, count: UInt, timeout_ms: Int32) -> Int32
    func kill(pid: Int32, signal: Int32) -> Int32
}

static ROUNDS: Int = 20
static POLLIN: Int16 = 1
static STANDARD_INPUT: Int32 = 0
static STANDARD_ERROR: Int32 = 2
static NEWLINE: UInt8 = 10
static ZERO: Int = 48
// Each wait below looks, sleeps a millisecond and looks again, and gives up
// 10 s after it began by the clock, whatever one round costs: a sweeping round
// also runs a child, and the run lane ends a program at 20 s.
static TICK_MS: UInt64 = 1
static DEADLINE_MS: UInt64 = 10_000
static GATE_WRITE: Atomic<Int> = Atomic(-1)
static ALIVE_READ: Atomic<Int> = Atomic(-1)
static ALIVE_WRITE: Atomic<Int> = Atomic(-1)
static SAVED_ERROR: Atomic<Int> = Atomic(-1)
// The digits of the pid line a read cut short, kept until its newline arrives.
static PARTIAL: Atomic<Int> = Atomic(0)

func pipe_ends() unsafe -> (Int32, Int32) {
    var ends: [Int32; 2] = [0; 2]
    if pipe((&ends) as UnsafePointer<Int32>) != 0 {
        panic("pipe(2) failed")
    }
    (ends[0], ends[1])
}

func open_pipes() unsafe {
    let (gate_read, gate_write) = pipe_ends()
    let (alive_read, alive_write) = pipe_ends()
    if dup2(gate_read, STANDARD_INPUT) < 0 {
        panic("dup2(2) of the gate failed")
    }
    let _ = close(gate_read)
    GATE_WRITE.store(gate_write as Int)
    ALIVE_READ.store(alive_read as Int)
    ALIVE_WRITE.store(alive_write as Int)
    SAVED_ERROR.store(dup(STANDARD_ERROR) as Int)
}

func divert_error() unsafe {
    let _ = dup2(ALIVE_WRITE.load() as Int32, STANDARD_ERROR)
}

func restore_error() unsafe {
    let _ = dup2(SAVED_ERROR.load() as Int32, STANDARD_ERROR)
}

// What one look at the second pipe found: bytes, end of file, or nothing yet.
enum Look { case Bytes, case Ended, case Empty }

// Reads what the children wrote, and appends each completed pid line to `pids`.
func look(pids: &var Vector<Int32>) unsafe -> Look {
    var watched = PollFd(fd: ALIVE_READ.load() as Int32, events: POLLIN, revents: 0)
    if poll((&watched) as UnsafePointer<PollFd>, 1, 0) == 0 {
        return Look.Empty
    }
    var got: [UInt8; 64] = [0; 64]
    let n = read(ALIVE_READ.load() as Int32, (&got) as UnsafePointer<UInt8>, 64)
    if n <= 0 {
        return Look.Ended
    }
    var i = 0
    while i < n {
        let byte = got[i]
        if byte == NEWLINE {
            try! pids.push(PARTIAL.load() as Int32)
            PARTIAL.store(0)
        } else {
            PARTIAL.store(PARTIAL.load() * 10 + (byte as Int) - ZERO)
        }
        i = i + 1
    }
    Look.Bytes
}

// Waits, a tick at a time, until `count` children have said they run.
func await_started(count: Int, pids: &var Vector<Int32>) {
    let start = Instant.now()
    while pids.len() < count {
        if start.elapsed().as_millis() >= DEADLINE_MS {
            restore_error()
            panic("child {} never said it runs within 10 s", count)
        }
        match look(&var pids) {
            case Ended -> {
                restore_error()
                panic("the children's pipe ended while child {} was launching", count)
            },
            case _ -> {}
        }
        sleep(Duration.ms(TICK_MS))
    }
}

// Waits, a tick at a time, for the second pipe's end of file.
func await_exits(pids: &var Vector<Int32>) {
    let start = Instant.now()
    var ended = false
    while not ended {
        if start.elapsed().as_millis() >= DEADLINE_MS {
            panic("the children never all exited within 10 s")
        }
        match look(&var pids) {
            case Ended -> { ended = true },
            case _ -> {
                sleep(Duration.ms(TICK_MS))
            }
        }
    }
}

func interrupted_output() -> Int {
    var c = Command(program: "/bin/sh")
    try! c.arg("-c")
    try! c.arg("exec 1>&-; printf '%s\n' $$ >&2; read gate")
    match c.output() {
        case Ok(_) -> 0,
        case Err(_) -> 1
    }
}

// How many of `pids` still exist, running or not yet reaped.
func existing(pids: &Vector<Int32>) unsafe -> Int {
    var count = 0
    var i = 0
    while i < pids.len() {
        if kill(pids[i], 0) == 0 {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Spawns a child that exits at once, which sweeps the orphan list, until every
// recorded pid has been reaped.
func sweep_until_reaped(pids: &Vector<Int32>) unsafe {
    let start = Instant.now()
    while true {
        var sweeper = Command(program: "/bin/sh")
        try! sweeper.arg("-c")
        try! sweeper.arg("exit 0")
        let _ = try! sweeper.wait()
        let remaining = existing(&pids)
        if remaining == 0 {
            return
        }
        if start.elapsed().as_millis() >= DEADLINE_MS {
            panic("{} children were never reaped within 10 s", remaining)
        }
        sleep(Duration.ms(TICK_MS))
    }
}

func leftovers() unsafe -> Int {
    var count = 0
    var status: Int32 = 0
    while waitpid(-1, (&status) as UnsafePointer<Int32>, 1) > 0 {
        count = count + 1
    }
    count
}

func main() {
    open_pipes()
    var pids = Vector<Int32>()
    var cancelled = 0
    var round = 0
    while round < ROUNDS {
        var group = TaskGroup()
        divert_error()
        let t = group.spawn(interrupted_output())
        await_started(round + 1, &var pids)
        restore_error()
        t.cancel()
        cancelled = cancelled + t.join()
        round = round + 1
    }
    let _ = close(ALIVE_WRITE.load() as Int32)
    let _ = close(GATE_WRITE.load() as Int32)
    await_exits(&var pids)
    sweep_until_reaped(&pids)
    print("interrupted {cancelled} of 20")
    print("zombies left for nobody: {leftovers()}")
}
