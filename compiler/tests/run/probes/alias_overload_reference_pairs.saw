// probe: stated
// about: a `&Alias` argument picks the by-reference overload of a by-value and by-reference pair at the type the alias names, as the plain reference does, at a String and at an Int (SL-1012)
// stage 0: reads an alias as its target, so it is no oracle for the alias's own ranking
// speeds: -O0 -O2
// leaks: none
// prints: 2
// prints: 2
// prints: 2
// prints: 2

type Name = String
type UserId = Int

func f(x: String) -> Int { 1 }
func f(x: &String) -> Int { 2 }

func g(x: Int) -> Int { 1 }
func g(x: &Int) -> Int { 2 }

func main() {
    let s: String = "ab"
    print(f(&s))
    let n = Name("ab")
    print(f(&n))
    let i: Int = 3
    print(g(&i))
    let u = UserId(3)
    print(g(&u))
}
