// probe: stated
// about: a channel send wakes `main`, parked receiving, inside a nested sweep, and `main` drops the group the outer walk stands on, which the walk never reads again (SL-1109)
// stage 0: runs it on its own std's executor, which gives no turn by the sleep order (SL-977)
// speeds: -O0 -O2
// prints: total 30 of 30
// `hog` holds the thread past every deadline, so the walk stands on `napper`'s
// group at `napper`'s expired sleep, and the sleep order gives the turn to
// `waker`, the earliest sleeper, a background task. `waker` sends on the
// channel `main` is receiving on, then joins a task of its own; that join's
// sweep runs `napper`, then `main`, woken by the channel, which joins `napper`
// and drops the group under the outer walk.

import std.task.*
import std.time.{Instant}
import std.channel.{Channel}

static TICK_MS: UInt64 = 1
static WAKER_MS: UInt64 = 1
static NAPPER_MS: UInt64 = 2
static QUICK_MS: UInt64 = 3
static HOLD_MS: UInt64 = 4
static ROUNDS: Int = 10
static SETTLE_TICKS: Int = 6
static JOINED_PER_ROUND: Int = 3
static EXPECTED: Int = ROUNDS * JOINED_PER_ROUND

func hold(millis: UInt64) sync {
    let start = Instant.now()
    while start.elapsed().as_millis() < millis {}
}

func hog() -> Int {
    yield_now()
    hold(HOLD_MS)
    0
}

func napper() -> Int {
    sleep(Duration.ms(NAPPER_MS))
    1
}

func quick() -> Int {
    sleep(Duration.ms(QUICK_MS))
    1
}

func waker(ch: Channel<Int>) -> Int {
    sleep(Duration.ms(WAKER_MS))
    try! ch.send(1)
    let h = Task.spawn(quick())
    h.join()
}

func one_round(ch: &Channel<Int>) -> Int {
    var group = TaskGroup()
    let _ = group.spawn(hog())
    let t = group.spawn(napper())
    let got = try! ch.receive()
    got + t.join()
}

func settle(n: Int) {
    var i = 0
    while i < n {
        sleep(Duration.ms(TICK_MS))
        i = i + 1
    }
}

func main() {
    let ch = try! Channel<Int>()
    var total = 0
    var round = 0
    while round < ROUNDS {
        let w = Task.spawn(waker(ch.copy()))
        yield_now()
        total = total + one_round(&ch)
        settle(SETTLE_TICKS)
        total = total + w.join()
        round = round + 1
    }
    print("total {total} of {EXPECTED}")
}
