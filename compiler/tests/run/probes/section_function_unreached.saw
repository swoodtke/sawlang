// probe: stated
// about: an `@section` function nothing calls is still defined, as an internal function, and `@llvm.used` keeps it (SL-934)
// stage 0: builds it and prints the same line; a probe because the Linux Stage 0 records are v0.18.0's and cannot be recorded again from the VM
// speeds: -O0 -O2
// prints: 7
// ll defines: saw section_function_unreached.placed()
// ll defines: llvm.used
// The name is Mach-O's form, which an ELF target takes verbatim (section_function.saw).

@section("__TEXT,__sawfn,regular,pure_instructions")
func placed() -> Int {
    7
}

func main() {
    print("7")
}
