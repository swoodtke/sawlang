// probe: stated
// about: four thousand short `Thread.spawn` bodies, two at once, each drive a one-task `TaskGroup()` and then wait at a gate until the other has too, so both threads hold an executor record at once in every round, and the executor makes two thread records in all, each reused once its thread ends, conformance row K189 (SL-793)
// stage 0: has no per-thread executor record to count (SL-793)
// speeds: -O0 -O2
// prints: 4000 tasks, 2 executor records
import std.task.*
import std.taskgroup.{__saw_exec_record_count}

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static ROUNDS: Int = 2000
static NAP_NANOS: UInt64 = 20_000
static DEADLINE_NAPS: Int = 500000
// Threads that have reached the gate, over all rounds: a round's two threads
// take counts 2k and 2k+1 and each leaves once the count reaches 2k+2. A
// record is claimed at a thread's first drive and held until the thread ends,
// so at the gate both are held and a second record is forced; the count of
// two is then exact, not a race between short-lived threads.
static AT_GATE: Atomic<Int> = Atomic(0)

func one() -> Int {
    yield_now()
    1
}

func drive() -> Int {
    var g = TaskGroup()
    let h = g.spawn(one())
    let n = h.join()
    let before = AT_GATE.fetch_add(1)
    let want = before - before % 2 + 2
    var naps = 0
    while AT_GATE.load() < want {
        if naps > DEADLINE_NAPS {
            panic("gate: thread {} never saw its round's other thread arrive (count {}, want {})", before, AT_GATE.load(), want)
        }
        __saw_rt_sleep_ns(NAP_NANOS)
        naps = naps + 1
    }
    n
}

func main() blocking {
    var total = 0
    var i = 0
    while i < ROUNDS {
        var a = try! Thread.spawn { drive() }
        var b = try! Thread.spawn { drive() }
        total = total + a.join() + b.join()
        i = i + 1
    }
    print("{} tasks, {} executor records", total, __saw_exec_record_count())
}
