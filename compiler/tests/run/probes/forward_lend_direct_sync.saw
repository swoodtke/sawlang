// probe: stated
// about: a forwarding accessor whose inner accessor keeps an owning local across its `lend`, by a direct `lend self.inner.at(i)`, with a sync caller (SL-861)
// stage 0: cannot parse a `borrow` prefix
// speeds: -O0 -O2
// leaks: none
// Each owning local (String, NoCopy, NoCopy with a deinit) at forwarding depth 1
// and 2, with no epilogue, the inner's alone, or every accessor's: the inner
// epilogue runs at the outer window's close and the local drops once a call.
// prints: string-none 1 = 11
// prints: string-none 2 = 11
// prints: string-inner leaf epi held
// prints: string-inner 1 = 11
// prints: string-inner leaf epi held
// prints: string-inner 2 = 11
// prints: string-both leaf epi held
// prints: string-both mid epi
// prints: string-both 1 = 11
// prints: string-both leaf epi held
// prints: string-both mid epi
// prints: string-both top epi
// prints: string-both 2 = 11
// prints: plain-none 1 = 11
// prints: plain-none 2 = 11
// prints: plain-inner leaf epi 7
// prints: plain-inner 1 = 11
// prints: plain-inner leaf epi 7
// prints: plain-inner 2 = 11
// prints: plain-both leaf epi 7
// prints: plain-both mid epi
// prints: plain-both 1 = 11
// prints: plain-both leaf epi 7
// prints: plain-both mid epi
// prints: plain-both top epi
// prints: plain-both 2 = 11
// prints: drop traced 7
// prints: traced-none 1 = 11
// prints: drop traced 7
// prints: traced-none 2 = 11
// prints: traced-inner leaf epi 7
// prints: drop traced 7
// prints: traced-inner 1 = 11
// prints: traced-inner leaf epi 7
// prints: drop traced 7
// prints: traced-inner 2 = 11
// prints: traced-both leaf epi 7
// prints: drop traced 7
// prints: traced-both mid epi
// prints: traced-both 1 = 11
// prints: traced-both leaf epi 7
// prints: drop traced 7
// prints: traced-both mid epi
// prints: traced-both top epi
// prints: traced-both 2 = 11
// prints: done 0

struct Traced { id: Int }
extension Traced: NoCopy {
    func deinit(&var self) { print("drop traced {}", self.id) }
}

struct Plain { id: Int }
extension Plain: NoCopy {}

struct LeafStringNone { cells: Vector<Int> }
extension LeafStringNone: NoCopy {}

extension LeafStringNone {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = "held".to_string()
        lend self.cells[i]
    }
}

struct MidStringNone { inner: LeafStringNone }
extension MidStringNone: NoCopy {}

extension MidStringNone {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
    }
}

struct TopStringNone { inner: MidStringNone }
extension TopStringNone: NoCopy {}

extension TopStringNone {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
    }
}

struct LeafStringInner { cells: Vector<Int> }
extension LeafStringInner: NoCopy {}

extension LeafStringInner {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = "held".to_string()
        lend self.cells[i]
        print("string-inner leaf epi {}", note)
    }
}

struct MidStringInner { inner: LeafStringInner }
extension MidStringInner: NoCopy {}

extension MidStringInner {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
    }
}

struct TopStringInner { inner: MidStringInner }
extension TopStringInner: NoCopy {}

extension TopStringInner {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
    }
}

