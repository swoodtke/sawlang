extension LeafTracedInner: NoCopy {}

extension LeafTracedInner {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = Traced(id: 7)
        lend self.cells[i]
        print("traced-inner leaf epi {}", note.id)
    }
}

