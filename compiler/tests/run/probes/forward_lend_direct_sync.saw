struct LeafTracedBoth { cells: Vector<Int> }
extension LeafTracedBoth: NoCopy {}

extension LeafTracedBoth {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = Traced(id: 7)
        lend self.cells[i]
        print("traced-both leaf epi {}", note.id)
    }
}

struct MidTracedBoth { inner: LeafTracedBoth }
extension MidTracedBoth: NoCopy {}

extension MidTracedBoth {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
        print("traced-both mid epi")
    }
}

struct TopTracedBoth { inner: MidTracedBoth }
extension TopTracedBoth: NoCopy {}

extension TopTracedBoth {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.inner.at(i)
        print("traced-both top epi")
    }
}

func run() -> Int {
    var string_none1 = MidStringNone(inner: LeafStringNone(cells: [10]))
    borrow var string_none1.at(0) += 1
    print("string-none 1 = {}", string_none1.inner.cells[0])
    var string_none2 = TopStringNone(inner: MidStringNone(inner: LeafStringNone(cells: [10])))
    borrow var string_none2.at(0) += 1
    print("string-none 2 = {}", string_none2.inner.inner.cells[0])
    var string_inner1 = MidStringInner(inner: LeafStringInner(cells: [10]))
    borrow var string_inner1.at(0) += 1
    print("string-inner 1 = {}", string_inner1.inner.cells[0])
    var string_inner2 = TopStringInner(inner: MidStringInner(inner: LeafStringInner(cells: [10])))
    borrow var string_inner2.at(0) += 1
    print("string-inner 2 = {}", string_inner2.inner.inner.cells[0])
    var string_both1 = MidStringBoth(inner: LeafStringBoth(cells: [10]))
    borrow var string_both1.at(0) += 1
    print("string-both 1 = {}", string_both1.inner.cells[0])
    var string_both2 = TopStringBoth(inner: MidStringBoth(inner: LeafStringBoth(cells: [10])))
    borrow var string_both2.at(0) += 1
    print("string-both 2 = {}", string_both2.inner.inner.cells[0])
    var plain_none1 = MidPlainNone(inner: LeafPlainNone(cells: [10]))
    borrow var plain_none1.at(0) += 1
    print("plain-none 1 = {}", plain_none1.inner.cells[0])
    var plain_none2 = TopPlainNone(inner: MidPlainNone(inner: LeafPlainNone(cells: [10])))
    borrow var plain_none2.at(0) += 1
    print("plain-none 2 = {}", plain_none2.inner.inner.cells[0])
    var plain_inner1 = MidPlainInner(inner: LeafPlainInner(cells: [10]))
    borrow var plain_inner1.at(0) += 1
    print("plain-inner 1 = {}", plain_inner1.inner.cells[0])
    var plain_inner2 = TopPlainInner(inner: MidPlainInner(inner: LeafPlainInner(cells: [10])))
    borrow var plain_inner2.at(0) += 1
    print("plain-inner 2 = {}", plain_inner2.inner.inner.cells[0])
    var plain_both1 = MidPlainBoth(inner: LeafPlainBoth(cells: [10]))
    borrow var plain_both1.at(0) += 1
    print("plain-both 1 = {}", plain_both1.inner.cells[0])
    var plain_both2 = TopPlainBoth(inner: MidPlainBoth(inner: LeafPlainBoth(cells: [10])))
    borrow var plain_both2.at(0) += 1
    print("plain-both 2 = {}", plain_both2.inner.inner.cells[0])
    var traced_none1 = MidTracedNone(inner: LeafTracedNone(cells: [10]))
    borrow var traced_none1.at(0) += 1
    print("traced-none 1 = {}", traced_none1.inner.cells[0])
    var traced_none2 = TopTracedNone(inner: MidTracedNone(inner: LeafTracedNone(cells: [10])))
    borrow var traced_none2.at(0) += 1
    print("traced-none 2 = {}", traced_none2.inner.inner.cells[0])
    var traced_inner1 = MidTracedInner(inner: LeafTracedInner(cells: [10]))
    borrow var traced_inner1.at(0) += 1
    print("traced-inner 1 = {}", traced_inner1.inner.cells[0])
    var traced_inner2 = TopTracedInner(inner: MidTracedInner(inner: LeafTracedInner(cells: [10])))
    borrow var traced_inner2.at(0) += 1
    print("traced-inner 2 = {}", traced_inner2.inner.inner.cells[0])
    var traced_both1 = MidTracedBoth(inner: LeafTracedBoth(cells: [10]))
    borrow var traced_both1.at(0) += 1
    print("traced-both 1 = {}", traced_both1.inner.cells[0])
    var traced_both2 = TopTracedBoth(inner: MidTracedBoth(inner: LeafTracedBoth(cells: [10])))
    borrow var traced_both2.at(0) += 1
    print("traced-both 2 = {}", traced_both2.inner.inner.cells[0])
    0
}

func main() {
    print("done {}", run())
}
