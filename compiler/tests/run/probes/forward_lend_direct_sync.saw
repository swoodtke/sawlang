extension LeafPlainNone: NoCopy {}

extension LeafPlainNone {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = Plain(id: 7)
        lend self.cells[i]
    }
}

struct MidPlainNone { inner: LeafPlainNone }
extension MidPlainNone: NoCopy {}

extension MidPlainNone {
    func at(&var self, i: Int) borrows -> &var Int {
