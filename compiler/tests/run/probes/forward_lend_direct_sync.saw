extension LeafPlainInner: NoCopy {}

extension LeafPlainInner {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = Plain(id: 7)
        lend self.cells[i]
        print("plain-inner leaf epi {}", note.id)
    }
}

