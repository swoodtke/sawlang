struct LeafTracedNone { cells: Vector<Int> }
extension LeafTracedNone: NoCopy {}

extension LeafTracedNone {
    func at(&var self, i: Int) borrows -> &var Int {
        let note = Traced(id: 7)
        lend self.cells[i]
    }
}

