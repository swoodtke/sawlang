// probe: stated
// about: a pool task's lock window that drops a group whose task waits for `Thread.spawn` bodies that never take the lock completes, conformance row K206 (SL-1161)
// stage 0: runs it on its own std's executor, which this rule is not part of
// speeds: -O0 -O2
// prints: total 100
import std.channel.{Channel}
import std.mutex.{Mutex}
import std.task.*

static M: Mutex<Int>
static OPEN: Atomic<Int> = Atomic(0)

func gather(ch: Channel<Int>, n: Int) -> Int {
    var k = 0
    var sum = 0
    while k < n {
        sum = sum + try! ch.receive()
        k = k + 1
    }
    sum
}

func drain_inside(ch: Channel<Int>) sync {
    let g = TaskGroup()
    let h = g.spawn(gather(ch, 4))
}

func holder(ch: Channel<Int>) -> Int {
    sleep(Duration.ms(2))
    borrow var m = M.lock() {
        OPEN.store(1)
        drain_inside(ch.copy())
        m = m + 100
    }
    0
}

func send_after_lock(ch: Channel<Int>) {
    while OPEN.load() == 0 { }
    try! ch.send(1)
}

func main() {
    let ch = try! Channel<Int>()
    var pool = try! TaskGroup(threads: 2)
    let h = pool.spawn(holder(ch.copy()))
    let c1 = ch.copy()
    let c2 = ch.copy()
    let c3 = ch.copy()
    let c4 = ch.copy()
    var t1 = try! Thread.spawn { [c1] in send_after_lock(c1) }
    var t2 = try! Thread.spawn { [c2] in send_after_lock(c2) }
    var t3 = try! Thread.spawn { [c3] in send_after_lock(c3) }
    var t4 = try! Thread.spawn { [c4] in send_after_lock(c4) }
    let _ = h.join()
    t1.join()
    t2.join()
    t3.join()
    t4.join()
    print("total {}", M.get())
}
