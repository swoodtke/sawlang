// probe: panics
// about: a reactor the system refuses is reported with its cause, never handed back half built (SL-768)
// stage 0: panics with the same message, then writes its task dump, which sawc2's executor does not have
// speeds: -O0 -O2
// prints: descriptors exhausted: true
// panics: reactor: creating the reactor failed (errno 24)
// A reactor that cannot be made is reported, never handed back half built
// (SL-768): the program uses up its descriptors, then waits on two sleeping
// tasks, which needs the executor's reactor. Its creation is refused with
// EMFILE, and the executor panics naming the cause where it once got an
// instance with no kqueue or epoll set behind it and spun through the waits.
//
// The descriptor limit is lowered first so the exhaustion is quick at any
// starting limit. Its resource number is per host (`RLIMIT_NOFILE` is 8 on
// macOS and 7 on Linux), so both are capped: the other number is a limit
// this program never meets (`RLIMIT_NPROC` on macOS, `RLIMIT_MEMLOCK` on
// Linux).

extern "C" {
    func pipe(fds: UnsafePointer<Int32>) -> Int32
    func dup(fd: Int32) -> Int32
    func getrlimit(resource: Int32, limit: UnsafePointer<Limit>) -> Int32
    func setrlimit(resource: Int32, limit: UnsafePointer<Limit>) -> Int32
}

struct Limit {
    soft: UInt64
    hard: UInt64
}

struct Ends {
    read: Int32
    write: Int32
}

static DESCRIPTOR_CAP: UInt64 = 64
static NOFILE_MACOS: Int32 = 8
static NOFILE_LINUX: Int32 = 7
static NAP_MS: UInt64 = 10

// Lowers resource `resource`'s soft limit to `DESCRIPTOR_CAP`.
func cap(resource: Int32) unsafe {
    var limit = Limit(soft: 0, hard: 0)
    if getrlimit(resource, (&limit) as UnsafePointer<Limit>) == (0 as Int32) {
        if limit.soft > DESCRIPTOR_CAP {
            limit.soft = DESCRIPTOR_CAP
            let _ = setrlimit(resource, (&limit) as UnsafePointer<Limit>)
        }
    }
}

// Opens pipes until the system refuses one, then duplicates standard input
// into the odd descriptor a pipe could not take; whether any were opened.
func exhaust() unsafe -> Bool {
    var ends = Ends(read: 0 as Int32, write: 0 as Int32)
    var made = 0
    while pipe((&ends) as UnsafePointer<Int32>) == (0 as Int32) {
        made = made + 1
    }
    while dup(0 as Int32) >= (0 as Int32) {
        made = made + 1
    }
    made > 0
}

func nap(id: Int) -> Int {
    sleep(Duration.ms(NAP_MS))
    id
}

func main() {
    cap(NOFILE_MACOS)
    cap(NOFILE_LINUX)
    print("descriptors exhausted: {}", exhaust())
    var group = TaskGroup()
    let a = group.spawn(nap(1))
    let b = group.spawn(nap(2))
    print("unreachable: {} {}", a.join(), b.join())
}
