// probe: stated
// about: a `Channel.recv` whose wait gate the allocator refuses returns `Err(Alloc(...))` instead of panicking, leaves the channel working, and tries the gate again on the next `recv` (SL-777)
// stage 0: its `recv` returns the message itself and panics on a refused gate, so there is no `Result` to match (SL-777)
// speeds: -O0 -O2
// prints: refused: the channel could not allocate memory: allocation of 128 bytes (align 16) failed
// prints: the queue is untouched: true
// prints: after the refusal: 7
// prints: the retry made its gate: channel is closed
// The channel is empty and open, so `recv` must wait, and the wait's first
// step is allocating its gate. The runtime's deny mode refuses that one
// allocation, and nothing else allocates between the arming and the
// disarming. Denial is a mode, so it is turned off before anything renders
// (an interpolation allocates). The retry runs with the allocator healthy: it
// makes the gate, and a close from a second thread wakes it.
import std.channel.{Channel}

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
    func __saw_rt_sleep_ns(ns: UInt64)
}

static NAP_NANOS: UInt64 = 50_000_000

func main() {
    let ch = try! Channel<Int>()
    __saw_rt_alloc_deny_after(0)
    let refused = ch.recv()
    __saw_rt_alloc_deny_after(-1)
    match refused {
        case Ok(_) -> print("unexpected: a value"),
        case Err(e) -> print("refused: {e}")
    }
    print("the queue is untouched: {(try! ch.try_receive()).is_none()}")

    try! ch.send(7)
    print("after the refusal: {try! ch.recv()}")

    var closer = try! Thread.spawn { [ch] in
        __saw_rt_sleep_ns(NAP_NANOS)
        let _ = ch.close()
    }
    closer.detach()
    match ch.recv() {
        case Ok(_) -> print("unexpected: a value"),
        case Err(e) -> print("the retry made its gate: {e}")
    }
}
