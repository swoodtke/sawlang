// probe: panics
// about: a task inside the drive of a `Thread.join` in thread context (`waits_drive`) that joined a task it spawned and then panics dumps only its live frames, its own at the line of the drive that returned, never that drive's released slot (SL-863)
// stage 0: runs it on its own std's executor, whose task dump this does not pin (SL-863)
// speeds: -O0 -O2
// prints: saw tasks: 1 live (unsynchronized snapshot)
// prints:   task group 2 slot 0 gen 1 running
// prints:     at running_task_dump_panic_join_drive.saw:42 in p
// panics: after the fate
import std.task.*

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static HOLD_NANOS: UInt64 = 300_000_000

func work(i: Int) -> Int {
    yield_now()
    i * 10
}

func fate_join(i: Int) -> Int {
    yield_now()
    let h = Task.spawn(work(i))
    h.join()
}

func hold() -> Int {
    __saw_rt_sleep_ns(HOLD_NANOS)
    7
}

// A blocking wait for a thread, in thread context: the join drives the
// group, so `p` runs inside that drive while the thread sleeps, and `main`
// never suspends.
func wait_for_thread() blocking -> Int {
    var t = try! Thread.spawn { hold() }
    t.join()
}

func p(i: Int) -> Int {
    let v = fate_join(i)
    dump_tasks()
    if v >= 0 {
        panic("after the fate {}", v)
    }
    v
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(p(1))
    print("T {}", wait_for_thread())
    print("P {}", h.join())
}
