// probe: stated
// about: a `Data`'s range subscripts lend views of its bytes in every range form; a read view works on a `let` root, a `&Data` parameter and shared bytes, and a writable view separates shared bytes first, so a copy taken before it keeps its bytes (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// prints: 9
// prints: 0 0 3
// prints: 1 2
// prints: 30 30
// prints: 2 30
// prints: 60
// prints: 3 5 3
// prints: 0 30 0 4 0
// prints: 0 0
// prints: 0
// leaks: none
import std.data.{Data}

func total(s: &[UInt8]) -> Int {
    var sum = 0
    var i = 0
    while i < s.len() {
        sum += s[i] as Int
        i += 1
    }
    sum
}

func zero(s: &var [UInt8]) {
    var i = 0
    while i < s.len() {
        s[i] = 0
        i += 1
    }
}

func make(n: Int) -> Data {
    var d = Data()
    var i = 0
    while i < n {
        try! d.push(UInt8.from(truncating: i + 1))
        i += 1
    }
    d
}

func head_total(d: &Data) -> Int {
    borrow let h = d[0..2] { total(&h) }
}

func main() {
    var d = make(6)
    print(total(&d[1..4]))
    let before = d
    zero(&var d[0..2])
    print("{} {} {}", d[0], d[1], d[2])
    print("{} {}", before[0], before[1])
    d[2..4][0] = 30
    print("{} {}", d[2], d[2..][0])
    borrow let s = d[1..3] { print("{} {}", s.len(), s[1]) }
    borrow var t = d[4..6] { t[1] = 60 }
    print(d[5])
    let frozen = make(3)
    borrow let f = frozen[0..2] { print("{} {} {}", total(&f), total(&frozen[1..3]), head_total(&frozen)) }
    print("{} {} {} {} {}", total(&d[..=1]), total(&d[1..=2]), total(&d[..2]), total(&d[3..=3]), total(&d[..0]))
    zero(&var d[4..])
    print("{} {}", d[4], d[5])
    let empty = Data()
    print(total(&empty[..]))
}
