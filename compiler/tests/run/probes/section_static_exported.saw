// probe: stated
// about: an `@export` static with an `@section` nothing reads is still defined, in its section, and `@llvm.used` keeps it so the section carries its retain flag (SL-1083)
// stage 0: builds it and prints the same line; a probe because the Linux Stage 0 records are v0.18.0's and cannot be recorded again from the VM
// speeds: -O0 -O2
// prints: 7
// ll defines: exported_placed_static
// ll defines: llvm.used
// The name is Mach-O's two-part form, which an ELF target takes verbatim.

@export("exported_placed_static")
@section("__DATA,__sawtag")
static TAGGED: Int = 7

func main() {
    print("7")
}
