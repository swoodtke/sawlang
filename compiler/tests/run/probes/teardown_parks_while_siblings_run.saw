// probe: stated
// about: a `TaskGroup` local whose scope ends in a task with a member still live parks there until the member finishes, the task `joining` at the group's line while a sibling runs and dumps, rather than running the sibling inside its own turn, conformance row K228 (SL-1161)
// stage 0: tears the group down with a nested sweep inside the task's turn, so the dump reads the task `running`
// speeds: -O0 -O2
// prints: scope ends
// prints: watcher dumps
// prints: saw tasks: 3 live (unsynchronized snapshot)
// prints:   task group 1 slot 0 gen 1 sleeping
// prints:     at teardown_parks_while_siblings_run.saw:36 in wait_for
// prints:     at teardown_parks_while_siblings_run.saw:42 in held
// prints:   task group 2 slot 0 gen 1 running
// prints:     at teardown_parks_while_siblings_run.saw:48 in watcher
// prints:   task group 2 slot 1 gen 1 joining
// prints:     at teardown_parks_while_siblings_run.saw:56 in scope
// prints: held done
// prints: scope returns 0
// prints: watcher returns 0
// The watcher dumps once the scope has reached its end, and the held task
// waits until the dump is made, so no timer decides the order.
import std.task.{dump_tasks}

// The gates the test owns. The 1ms tick paces each poll and decides nothing;
// the 10s deadline bounds only genuine breakage (TESTING.md, "Waiting in a
// multi-threaded test").
static ENDING: Atomic<Int> = Atomic(0)
static SEEN: Atomic<Int> = Atomic(0)
static POLL_TICK_MS: UInt64 = 1
static POLL_DEADLINE_TICKS: Int = 10000

func wait_for(gate: &Atomic<Int>, who: String) {
    var ticks = 0
    while gate.load() == 0 {
        if ticks >= POLL_DEADLINE_TICKS {
            panic("{}: the gate never opened", who)
        }
        sleep(Duration.ms(POLL_TICK_MS))
        ticks = ticks + 1
    }
}

func held() -> Int {
    wait_for(&SEEN, "held")
    print("held done")
    1
}

func watcher() -> Int {
    wait_for(&ENDING, "watcher")
    print("watcher dumps")
    dump_tasks()
    SEEN.store(1)
    0
}

func scope() -> Int {
    var g = TaskGroup()
    let _ = g.spawn(held())
    ENDING.store(1)
    print("scope ends")
    0
}

func main() {
    var outer = TaskGroup()
    let w = outer.spawn(watcher())
    let s = outer.spawn(scope())
    print("scope returns {}", s.join())
    print("watcher returns {}", w.join())
}
