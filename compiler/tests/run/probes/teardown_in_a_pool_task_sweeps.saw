// probe: stated
// about: a pool task whose `TaskGroup()` local's scope ends with a member still live does not park, since its worker runs no group of its own between resumes: the teardown runs the member in place, a dump from the member reads the pool task `running` where a parked one reads `joining`, and the task completes, conformance row K228 (SL-1161)
// stage 0: runs the teardown as a nested sweep, as here, which is the ruling for a pool's worker
// speeds: -O0 -O2
// prints: pool task reaches its group's end
// prints: member dumps
// prints: saw tasks: 2 live (unsynchronized snapshot)
// prints:   task group 1 slot 0 gen 1 running
// prints:     at teardown_in_a_pool_task_sweeps.saw:16 in member
// prints:   task group 2 slot 0 gen 1 running
// prints:     at teardown_in_a_pool_task_sweeps.saw:25 in pool_task
// prints: pool returns 2
import std.task.{dump_tasks, yield_now}

func member() -> Int {
    yield_now()
    print("member dumps")
    dump_tasks()
    1
}

func pool_task() -> Int {
    var g = TaskGroup()
    let _ = g.spawn(member())
    yield_now()
    print("pool task reaches its group's end")
    2
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    let h = pool.spawn(pool_task())
    print("pool returns {}", h.join())
}
