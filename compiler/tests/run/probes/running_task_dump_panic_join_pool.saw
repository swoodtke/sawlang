// probe: panics
// about: a task on a `TaskGroup(threads: 2)` worker that joined a task it spawned and then panics dumps only its live frames, its own at the line of the drive that returned, never that drive's released slot (SL-863)
// stage 0: runs it on its own std's executor, whose task dump this does not pin (SL-863)
// speeds: -O0 -O2
// prints: saw tasks: 1 live (unsynchronized snapshot)
// prints:   task group 2 slot 0 gen 1 running
// prints:     at running_task_dump_panic_join_pool.saw:23 in p
// panics: after the fate
import std.task.*

func work(i: Int) -> Int {
    yield_now()
    i * 10
}

func fate_join(i: Int) -> Int {
    yield_now()
    let h = Task.spawn(work(i))
    h.join()
}

func p(i: Int) -> Int {
    let v = fate_join(i)
    dump_tasks()
    if v >= 0 {
        panic("after the fate {}", v)
    }
    v
}

func main() {
    var group = try! TaskGroup(threads: 2)
    print("P {}", group.spawn(p(1)).join())
}
