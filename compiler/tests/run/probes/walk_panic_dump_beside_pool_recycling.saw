// probe: panics
// about: the panic path's task dump reads a pool only under the pool's lock, while its workers complete unclaimed tasks and free their cells and frames, conformance row K192 (SL-808)
// stage 0: runs it alike, but on its own std's executor, so a recorded run says nothing about these walks (SL-808)
// speeds: -O0 -O2
// panics: the dump walks a pool whose workers free cells
func quick(n: Int) -> Int {
    n + 1
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    var k = 0
    while k < 256 {
        let _ = pool.spawn(quick(k))
        k = k + 1
    }
    panic("the dump walks a pool whose workers free cells")
}
