import std.file
import std.path.{Path}
import std.systemerror.{SystemError}

func main() -> Result<Void, SystemError> {
    var config = try file.File.open(Path(s: "saw.toml"))
    let text = try config.read()
    print("read {text.len()} bytes")
    return
}
