// probe: stated
// about: a `lend` that forwards to an accessor another module declares (SL-1173)
// stage 0: has no `lend`-forwarding accessors to compare against; the expectation is the spec's
// speeds: -O0 -O2
// prints: 7
// The forwarder is in this module and the accessor it forwards to in the imported one.

import lend_forward_other_module_accessor_module.*
extension Outer {
    func outer_view(&self) borrows -> &Inner { lend self.inner_view() }
}
func main() {
    let o = Outer(inner: Inner(n: 7))
    print(o.outer_view().n)
}
