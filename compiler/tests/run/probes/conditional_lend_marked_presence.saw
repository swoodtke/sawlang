// probe: stated
// about: every `borrow`-marked use of a conditional lend runs its epilogue on the present path only, in a sync body and across a suspension in a driven one (SL-864)
// stage 0: cannot parse a `borrow` place or unwrap
// speeds: -O0 -O2
// leaks: none
// prints: match 2 0 closes 1
// prints: match var 3 0 closes 1
// prints: presence 1 0 closes 1
// prints: if borrow 4 0 closes 1
// prints: nested 25 0 closes 2
// prints: force 1 closes 1
// prints: coalesce 1 7 closes 1
// prints: if let 1 -1 closes 1
// prints: copy 1 -1 closes 1
// prints: assign 8 1 closes 1
// prints: block 2 0 closes 1
// prints: guard 1 -1 closes 1
// prints: driven match 2 0 closes 1
// prints: driven match var 3 0 closes 1
// prints: driven presence 1 0 closes 1
// prints: driven if borrow 4 0 closes 1
// prints: driven nested 25 0 closes 2
// prints: driven coalesce 1 7 closes 1
// prints: driven if let 1 -1 closes 1
// prints: driven block 2 0 closes 1
// Each accessor counts its closes in its epilogue, which runs only when it
// lent: a call at index 1 lends, one at 9 is absent and must close nothing.
import std.task.*

struct Cell { n: Int }

struct Row {
    cells: [Cell; 4],
    closes: Int
}

extension Row {
    func find(&var self, i: Int) borrows -> &var Cell? {
        if i < 0 || i >= 4 {
            return None
        }
        lend self.cells[i]
        self.closes = self.closes + 1
    }
}

func fresh() -> Row {
    Row(cells: [Cell(n: 0), Cell(n: 1), Cell(n: 2), Cell(n: 3)], closes: 0)
}

func matched(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            c.n += 1
            c.n
        },
        case None -> 0
    }
}

func matched_var(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            c.n += 2
            c.n
        },
        case None -> 0
    }
}

func present(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(_) -> 1,
        case None -> 0
    }
}

func unwrapped(r: &var Row, i: Int) -> Int {
    if var c = r.find(i) {
        c.n += 3
        c.n
    } else {
        0
    }
}

func nested(r: &var Row, other: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            match other.find(i + 1) {
                case Some(d) -> c.n * 10 + d.n * 5 + 5,
                case None -> -1
            }
        },
        case None -> 0
    }
}

func forced(r: &var Row, i: Int) -> Int {
    r.find(i)!.n
}

func coalesced(r: &var Row, i: Int) -> Int {
    let c = r.find(i) ?? Cell(n: 7)
    c.n
}

func let_bound(r: &var Row, i: Int) -> Int {
    if let c = borrow r.find(i) {
        c.n
    } else {
        -1
    }
}

func copied(r: &var Row, i: Int) -> Int {
    let c = r.find(i)
    if let x = c {
        x.n
    } else {
        -1
    }
}

func assigned(r: &var Row, i: Int) -> Int {
    r.find(i)?.n = 8
    r.cells[1].n
}

func blocked(r: &var Row, i: Int) -> Int {
    borrow var e = r.find(i) {
        if var c = e {
            c.n += 1
            c.n
        } else {
            0
        }
    }
}

func guarded(r: &var Row, i: Int) -> Int {
    guard let c = borrow r.find(i) else {
        return -1
    }
    c.n
}

func driven_matched(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            yield_now()
            c.n += 1
            c.n
        },
        case None -> {
            yield_now()
            0
        }
    }
}

func driven_matched_var(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            yield_now()
            c.n += 2
            c.n
        },
        case None -> {
            yield_now()
            0
        }
    }
}

func driven_present(r: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(_) -> {
            yield_now()
            1
        },
        case None -> {
            yield_now()
            0
        }
    }
}

func driven_unwrapped(r: &var Row, i: Int) -> Int {
    if var c = r.find(i) {
        yield_now()
        c.n += 3
        c.n
    } else {
        yield_now()
        0
    }
}

func driven_nested(r: &var Row, other: &var Row, i: Int) -> Int {
    match r.find(i) {
        case Some(var c) -> {
            yield_now()
            match other.find(i + 1) {
                case Some(d) -> {
                    yield_now()
                    c.n * 10 + d.n * 5 + 5
                },
                case None -> -1
            }
        },
        case None -> {
            yield_now()
            0
        }
    }
}

func driven_coalesced(r: &var Row, i: Int) -> Int {
    yield_now()
    let c = r.find(i) ?? Cell(n: 7)
    yield_now()
    c.n
}

func driven_let_bound(r: &var Row, i: Int) -> Int {
    if let c = borrow r.find(i) {
        yield_now()
        c.n
    } else {
        yield_now()
        -1
    }
}

func driven_blocked(r: &var Row, i: Int) -> Int {
    borrow var e = r.find(i) {
        yield_now()
        if var c = e {
            yield_now()
            c.n += 1
            c.n
        } else {
            yield_now()
            0
        }
    }
}

func report(label: String, a: Int, b: Int, closes: Int) {
    print("{} {} {} closes {}", label, a, b, closes)
}

func sync_rows() {
    var r = fresh()
    var a = matched(&var r, 1)
    var b = matched(&var r, 9)
    report("match", a, b, r.closes)
    r = fresh()
    a = matched_var(&var r, 1)
    b = matched_var(&var r, 9)
    report("match var", a, b, r.closes)
    r = fresh()
    a = present(&var r, 1)
    b = present(&var r, 9)
    report("presence", a, b, r.closes)
    r = fresh()
    a = unwrapped(&var r, 1)
    b = unwrapped(&var r, 9)
    report("if borrow", a, b, r.closes)
    r = fresh()
    var o = fresh()
    a = nested(&var r, &var o, 1)
    b = nested(&var r, &var o, 9)
    report("nested", a, b, r.closes + o.closes)
    r = fresh()
    a = forced(&var r, 1)
    print("force {} closes {}", a, r.closes)
    r = fresh()
    a = coalesced(&var r, 1)
    b = coalesced(&var r, 9)
    report("coalesce", a, b, r.closes)
    r = fresh()
    a = let_bound(&var r, 1)
    b = let_bound(&var r, 9)
    report("if let", a, b, r.closes)
    r = fresh()
    a = copied(&var r, 1)
    b = copied(&var r, 9)
    report("copy", a, b, r.closes)
    r = fresh()
    a = assigned(&var r, 1)
    b = assigned(&var r, 9) - 7
    report("assign", a, b, r.closes)
    r = fresh()
    a = blocked(&var r, 1)
    b = blocked(&var r, 9)
    report("block", a, b, r.closes)
    r = fresh()
    a = guarded(&var r, 1)
    b = guarded(&var r, 9)
    report("guard", a, b, r.closes)
}

func driven_rows() {
    var r = fresh()
    var a = driven_matched(&var r, 1)
    var b = driven_matched(&var r, 9)
    report("driven match", a, b, r.closes)
    r = fresh()
    a = driven_matched_var(&var r, 1)
    b = driven_matched_var(&var r, 9)
    report("driven match var", a, b, r.closes)
    r = fresh()
    a = driven_present(&var r, 1)
    b = driven_present(&var r, 9)
    report("driven presence", a, b, r.closes)
    r = fresh()
    a = driven_unwrapped(&var r, 1)
    b = driven_unwrapped(&var r, 9)
    report("driven if borrow", a, b, r.closes)
    r = fresh()
    var o = fresh()
    a = driven_nested(&var r, &var o, 1)
    b = driven_nested(&var r, &var o, 9)
    report("driven nested", a, b, r.closes + o.closes)
    r = fresh()
    a = driven_coalesced(&var r, 1)
    b = driven_coalesced(&var r, 9)
    report("driven coalesce", a, b, r.closes)
    r = fresh()
    a = driven_let_bound(&var r, 1)
    b = driven_let_bound(&var r, 9)
    report("driven if let", a, b, r.closes)
    r = fresh()
    a = driven_blocked(&var r, 1)
    b = driven_blocked(&var r, 9)
    report("driven block", a, b, r.closes)
}

func main() {
    sync_rows()
    var group = TaskGroup()
    let h = group.spawn(driven_rows())
    h.join()
}
