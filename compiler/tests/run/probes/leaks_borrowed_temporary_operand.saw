// probe: stated
// about: an owned temporary a builtin comparison borrows is dropped by its statement, at every comparison position (SL-825)
// stage 0: leaks the temporary (SL:hazards S23)
// speeds: -O0 -O2
// leaks: none
// prints: eq left interp 3
// prints: eq left coalesced 3
// prints: eq left propagated 3
// prints: eq right interp 3
// prints: eq right coalesced 3
// prints: eq right propagated 3
// prints: ne interp 3
// prints: ne coalesced 3
// prints: ne propagated 3
// prints: lt interp 6
// prints: lt coalesced 6
// prints: lt propagated 6
// prints: and rhs interp 3
// prints: and rhs coalesced 3
// prints: and rhs propagated 3
// prints: or first interp 3
// prints: or first coalesced 3
// prints: or first propagated 3
// prints: if cond interp 3
// prints: if cond coalesced 3
// prints: if cond propagated 3
// prints: while cond interp 6
// prints: while cond coalesced 6
// prints: while cond propagated 6
// Each cell evaluates its comparison six times; the lane runs every build
// under `leaks --atExit` and requires no leak. The operand is a value the
// lowering makes as an operand rather than a place: an interpolation, a
// `??` and a propagated `try`.

struct Tok {
    text: String,
    alias: String?,
    kind: Int
}

struct Outer {
    inner: Tok,
    tag: String
}

struct Fixture {
    toks: Vector<Tok>,
    outers: Vector<Outer>,
    pairs: Vector<(String, Int)>,
    opairs: Vector<(String?, Int)>,
    somes: Vector<String?>,
    arrs: Vector<[String; 2]>,
    names: Vector<String>
}

extension Fixture: NoCopy {}

enum Bad {
    case Nope
}

func make(n: Int) -> String {
    "alpha{n}"
}

func nothing(n: Int) -> String? {
    if n < 0 {
        return "neg{n}"
    }
    None
}

func fallible(n: Int) -> Result<String, Bad> {
    if n < 0 {
        return Bad.Nope
    }
    return "alpha{n}"
}

func mk_tok(n: Int) -> Tok {
    Tok(text: "alpha{n}", alias: "al{n}", kind: n)
}

func mk_outer(n: Int) -> Outer {
    Outer(inner: mk_tok(n), tag: "t{n}")
}

func consume(s: String) -> Int {
    s.len()
}

func fixture() -> Fixture {
    var toks = Vector<Tok>()
    try! toks.push(Tok(text: "alpha{1}", alias: "al{1}", kind: 1))
    try! toks.push(Tok(text: "beta{2}", alias: None, kind: 2))
    var outers = Vector<Outer>()
    try! outers.push(mk_outer(1))
    try! outers.push(mk_outer(2))
    var pairs = Vector<(String, Int)>()
    try! pairs.push(("alpha{1}", 1))
    try! pairs.push(("beta{2}", 2))
    var opairs = Vector<(String?, Int)>()
    try! opairs.push(("oa{1}", 1))
    try! opairs.push((None, 2))
    var somes = Vector<String?>()
    try! somes.push("alpha{1}")
    try! somes.push("beta{2}")
    var arrs = Vector<[String; 2]>()
    try! arrs.push(["alpha{1}", "x{1}"])
    try! arrs.push(["beta{2}", "y{2}"])
    var names = Vector<String>()
    try! names.push("alpha{1}")
    try! names.push("beta{2}")
    Fixture(toks: move toks, outers: move outers, pairs: move pairs, opairs: move opairs, somes: move somes,
            arrs: move arrs, names: move names)
}

func eq_left_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha{i % 2}" == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_left_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = (nothing(i) ?? make(i % 2)) == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_left_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = (try fallible(i % 2)) == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func eq_right_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha1" == "alpha{i % 2}"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_right_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha1" == (nothing(i) ?? make(i % 2))
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func eq_right_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha1" == (try fallible(i % 2))
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func ne_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha{i % 2}" != "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

