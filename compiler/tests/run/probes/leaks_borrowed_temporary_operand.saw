    var hits = 0
    var i = 0
    while i < n {
        if (try fallible(i % 2)) == "alpha1" {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func while_cond_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        while "alpha{i % 2}" == "never" {
            hits = hits + 100
        }
        hits = hits + 1
        i = i + 1
    }
    hits
}

func while_cond_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        while (nothing(i) ?? make(i % 2)) == "never" {
            hits = hits + 100
        }
        hits = hits + 1
        i = i + 1
    }
    hits
}

func while_cond_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        while (try fallible(i % 2)) == "never" {
            hits = hits + 100
        }
        hits = hits + 1
        i = i + 1
    }
    return hits
}
func main() {
    let f = fixture()
    print("eq left interp {}", eq_left_interp(&f, 6, true))
    print("eq left coalesced {}", eq_left_coalesced(&f, 6, true))
    print("eq left propagated {}", (try! eq_left_propagated(&f, 6, true)))
    print("eq right interp {}", eq_right_interp(&f, 6, true))
    print("eq right coalesced {}", eq_right_coalesced(&f, 6, true))
    print("eq right propagated {}", (try! eq_right_propagated(&f, 6, true)))
    print("ne interp {}", ne_interp(&f, 6, true))
    print("ne coalesced {}", ne_coalesced(&f, 6, true))
    print("ne propagated {}", (try! ne_propagated(&f, 6, true)))
    print("lt interp {}", lt_interp(&f, 6, true))
    print("lt coalesced {}", lt_coalesced(&f, 6, true))
    print("lt propagated {}", (try! lt_propagated(&f, 6, true)))
    print("and rhs interp {}", and_rhs_interp(&f, 6, true))
    print("and rhs coalesced {}", and_rhs_coalesced(&f, 6, true))
    print("and rhs propagated {}", (try! and_rhs_propagated(&f, 6, true)))
    print("or first interp {}", or_first_interp(&f, 6, true))
    print("or first coalesced {}", or_first_coalesced(&f, 6, true))
    print("or first propagated {}", (try! or_first_propagated(&f, 6, true)))
    print("if cond interp {}", if_cond_interp(&f, 6, true))
    print("if cond coalesced {}", if_cond_coalesced(&f, 6, true))
    print("if cond propagated {}", (try! if_cond_propagated(&f, 6, true)))
    print("while cond interp {}", while_cond_interp(&f, 6, true))
    print("while cond coalesced {}", while_cond_coalesced(&f, 6, true))
    print("while cond propagated {}", (try! while_cond_propagated(&f, 6, true)))
}
