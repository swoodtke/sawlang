    var hits = 0
    var i = 0
    while i < n {
        let b = (nothing(i) ?? make(i % 2)) < "beta"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func lt_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = (try fallible(i % 2)) < "beta"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func and_rhs_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = flag && "alpha{i % 2}" == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func and_rhs_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = flag && (nothing(i) ?? make(i % 2)) == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func and_rhs_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = flag && (try fallible(i % 2)) == "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func or_first_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha{i % 2}" == "alpha1" || not flag
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func or_first_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = (nothing(i) ?? make(i % 2)) == "alpha1" || not flag
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func or_first_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = (try fallible(i % 2)) == "alpha1" || not flag
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func if_cond_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        if "alpha{i % 2}" == "alpha1" {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func if_cond_coalesced(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        if (nothing(i) ?? make(i % 2)) == "alpha1" {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

