    var hits = 0
    var i = 0
    while i < n {
        let b = (nothing(i) ?? make(i % 2)) != "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

func ne_propagated(f: &Fixture, n: Int, flag: Bool) -> Result<Int, Bad> {
    var hits = 0
    var i = 0
    while i < n {
        let b = (try fallible(i % 2)) != "alpha1"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    return hits
}

func lt_interp(f: &Fixture, n: Int, flag: Bool) -> Int {
    var hits = 0
    var i = 0
    while i < n {
        let b = "alpha{i % 2}" < "beta"
        if b {
            hits = hits + 1
        }
        i = i + 1
    }
    hits
}

