// probe: panics
// about: `try!` on a call generic over its value type that fails with a user enum conforming to `Printable`, in a suspending body, panics with the error rendered after `try! failed: ` through its error type's helper (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed: bad code
// ll defines: saw try failure try_failure_generic_value_enum_suspending.Code

import std.task.{yield_now}

enum Code {
    case Bad,
    case Worse
}

extension Code: Printable {
    func format(&self, into: &var StringBuilder) {
        match self {
            case Bad -> try! into.append("bad code"),
            case Worse -> try! into.append("worse code")
        }
    }
}

func failing<T>(value: T, fail: Bool) -> Result<T, Code> {
    yield_now()
    if fail {
        return Code.Bad
    }
    return value
}

func run() {
    yield_now()
    print("start")
    let v = try! failing(5, true)
    print("unreached")
}

func main() {
    run()
}
