// probe: stated
// about: a view's field and index projections reach the member at its natural-ABI offset with no load, on both intents, markers unwrapped, through a driver's `&self` (SL-914)
// stage 0: v0.18.0 projects through views of enum types and never gates a marker on `Normal`; this probe holds sawc to SL-914's surface
// speeds: -O0 -O2
// Each view is built over a static backing store, read back word by word
// through a second view, so the offsets are observed: a field, a nested
// struct's field, an array field's element, an index then a field, a run-time
// index, `ReadOnly` and `WriteOnly` fields reached by projection, and the
// MMIO driver idiom, `self.regs.status.read()`, on `Device` and `Normal`.
// prints: field 7
// prints: nested 5 6
// prints: element 9
// prints: index then field 11 12
// prints: dynamic 30 31 32
// prints: markers 42 3
// prints: driver 64 42
// prints: device 100 100

struct Inner {
    a: UInt32
    b: UInt32
}

struct Pair {
    lo: UInt32
    hi: UInt32
}

struct Block {
    head: UInt32
    inner: Inner
    tail: [UInt32; 2]
    pairs: [Pair; 2]
}

struct UartRegs {
    data: UInt32
    status: ReadOnly<UInt32>
    ctrl: UInt32
    clear: WriteOnly<UInt32>
}

struct Uart {
    regs: UnsafeMemory<UartRegs, Device>
}

extension Uart {
    func ready(&self) unsafe -> UInt32 {
        self.regs.status.read()
    }

    func send(&self, byte: UInt32) unsafe {
        self.regs.data.write(byte)
    }
}

static BACKING: [UInt32; 16]

func main() unsafe {
    let base = ((&BACKING) as UnsafePointer<UInt32>) as Int
    let words = UnsafeMemory<[UInt32; 16], Normal>(base)
    let block = UnsafeMemory<Block, Normal>(base)

    block.head.write(7)
    print("field {}", words[0].read())

    block.inner.a.write(5)
    block.inner.b.write(6)
    print("nested {} {}", words[1].read(), words[2].read())

    block.tail[1].write(9)
    print("element {}", words[4].read())

    block.pairs[1].lo.write(11)
    block.pairs[1].hi.write(12)
    print("index then field {} {}", words[7].read(), words[8].read())

    var k = 0
    while k < 3 {
        words[10 + k].write((30 + k) as UInt32)
        k = k + 1
    }
    let at = 11
    print("dynamic {} {} {}", words[10].read(), words[at].read(), words[at + 1].read())

    let device = UnsafeMemory<UartRegs, Device>(base)
    words[1].write(42)
    device.clear.write(3)
    print("markers {} {}", device.status.read(), words[3].read())

    let uart = Uart(regs: UnsafeMemory<UartRegs, Device>(base))
    uart.send(64)
    print("driver {} {}", words[0].read(), uart.ready())

    let normal = UnsafeMemory<UartRegs, Normal>(base)
    normal.ctrl.write(100)
    print("device {} {}", device.ctrl.read(), words[2].read())
}
