// probe: panics
// about: a `join()` of a `group.spawn` task further up its thread's stack, made by a suspending `main` inside the drive two above the subject's own, beside a sleeping sibling it cancels first, panics at the join, before any other task runs, conformance row K200 (SL-809)
// stage 0: runs it on its own std's executor, which this check is not part of (SL-809)
// speeds: -O0 -O2
// prints: J joins the subject
// panics: Task.join: the task cannot finish while this join waits for it
// The joiner waits until the leaf reports that it is waiting, so the subject's
// drive resumes it; the leaf holds until the joiner releases it just before the
// join, so no timer decides which of the two moves first.
import std.task.*

// The gates the test owns. The 1ms tick paces each poll and decides nothing;
// the 10s deadline bounds only genuine breakage (TESTING.md, "Waiting in a
// multi-threaded test").
static ARRIVED: Atomic<Int> = Atomic(0)
static RELEASED: Atomic<Int> = Atomic(0)
static POLL_TICK_MS: UInt64 = 1
static POLL_DEADLINE_TICKS: Int = 10000

func leaf() -> Int {
    ARRIVED.store(1)
    var ticks = 0
    while RELEASED.load() == 0 {
        if ticks >= POLL_DEADLINE_TICKS {
            panic("leaf: the joiner never released it")
        }
        sleep(Duration.ms(POLL_TICK_MS))
        ticks = ticks + 1
    }
    print("leaf done")
    1
}

func mid0() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(leaf())
    h.join() + 1
}

func mid1() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid0())
    h.join() + 1
}

func mid2() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid1())
    h.join() + 1
}

func sleeper() -> Int {
    sleep(Duration.secs(3600))
    0
}

func main() {
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(mid2())
    var ticks = 0
    while ARRIVED.load() == 0 {
        if ticks >= POLL_DEADLINE_TICKS {
            panic("main: the leaf never reached its wait")
        }
        sleep(Duration.ms(POLL_TICK_MS))
        ticks = ticks + 1
    }
    s.cancel()
    print("J joins the subject")
    RELEASED.store(1)
    let v = h.join()
    let _ = s.join()
    print("J returns {}", v)
}
