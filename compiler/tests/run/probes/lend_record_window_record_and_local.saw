// probe: stated
// about: an accessor whose site 0 forwards a suspending inner accessor (its window's record carried) and whose site 1 holds its own local carries each only on its own site's path (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: slow_at epi 50
// prints: drop t50
// prints: epi 0
// prints: epi 1 2
// prints: drop t2
// prints: a 1 b 2
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

func sink(t: Tag) {
    print("sink t{}", t.id)
}

struct Two {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two: NoCopy {}

struct Cells {
    v: Vector<Int>
}

extension Cells: NoCopy {}

extension Cells {
    func slow_at(&var self, i: Int) borrows -> &var Int {
        let t = Tag(id: 50)
        yield_now()
        lend self.v[i]
        print("slow_at epi {}", t.id)
    }
}

struct Mixed {
    p: Cells
    b: Vector<Int>
}

extension Mixed: NoCopy {}

extension Mixed {
    func pick(&var self, first: Bool, i: Int) borrows -> &var Int {
        if first {
            lend self.p.slow_at(i)
            print("epi 0")
        } else {
            let u = Tag(id: 2)
            yield_now()
            lend self.b[i]
            print("epi 1 {}", u.id)
        }
    }
}

func main() {
    var s = Mixed(p: Cells(v: [0]), b: [0])
    s.pick(true, 0) += 1
    s.pick(false, 0) += 2
    print("a {} b {}", s.p.v[0], s.b[0])
}
