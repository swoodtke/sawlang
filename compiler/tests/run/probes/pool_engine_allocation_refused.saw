// probe: stated
// about: a `TaskGroup(threads:)` whose lock the allocator refuses returns `Err(AllocError)` naming the lock, and a pool made after the refusal runs (SL-933)
// stage 0: its pool is fork-join over a lock allocated at the constructor, and the refusal is the same lock's (SL-933)
// speeds: -O0 -O2
// prints: lock refused: allocation of 128 bytes (align 16) failed
// prints: joined 42
// The pool's code is a link-time constant, so the constructor's only
// allocation is its lock and condition variable block (std.taskgroup): 128
// bytes at alignment 16 on a 64-bit host. With every allocation refused that
// block is the one refused, and nothing is left half-made. A `TaskGroup` is
// `NoMove`, so the result is matched where the constructor builds it, and
// denial is turned off before anything renders.

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
}

func doubled(n: Int) -> Int {
    n * 2
}

func main() {
    __saw_rt_alloc_deny_after(0)
    match TaskGroup(threads: 2) {
        case Ok(_) -> {
            __saw_rt_alloc_deny_after(-1)
            print("unexpected: a pool")
        },
        case Err(e) -> {
            __saw_rt_alloc_deny_after(-1)
            print("lock refused: {e}")
        }
    }
    var pool = try! TaskGroup(threads: 2)
    let h = pool.spawn(doubled(21))
    print("joined {}", h.join())
}
