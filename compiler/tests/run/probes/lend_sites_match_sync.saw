func fresh() -> S {
    S(f0: 0, f1: 10, f2: 20, v0: [100], v1: [110], v2: [120], h0: Holder(cells: [200]),
      h1: Holder(cells: [210]), h2: Holder(cells: [220]))
}


func run_p_ff() {
    var s = fresh()
    let _ = use_p_ff(&var s, 0)
    let _ = use_p_ff(&var s, 1)
    print("p_ff {} {} {} {} {} {} {} {} {}", s.f0, s.f1, s.f2, s.v0[0], s.v1[0], s.v2[0],
          s.h0.cells[0], s.h1.cells[0], s.h2.cells[0])
}

