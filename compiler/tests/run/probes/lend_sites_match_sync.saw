func use_p_ff(s: &var S, sel: Int) -> Int {
    borrow var s.p_ff(sel, 0) += 1
    0
}

func use_c_ff(s: &var S, sel: Int) -> Int {
    if borrow var x = s.c_ff(sel, 0) {
        x += 1
    } else {
        print("none")
    }
    0
}

func use_p_fv(s: &var S, sel: Int) -> Int {
    borrow var s.p_fv(sel, 0) += 1
