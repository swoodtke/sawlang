// prints: c_hhh 0 10 20 100 110 120 201 211 221
// Each accessor is named for its sites' places in order (`f` a field,
// `v` a `Vector.[]` place, `h` a forwarded `Holder.at`), `c_` when it is a
// conditional lend, whose `sel` 9 is the absent path. Each site but a field
// opens its own inner window, which the epilogue closes on that site's path
// only; the last line of each accessor's run is its state after every site
// was written once.

struct Holder {
    cells: Vector<Int>
}

extension Holder: NoCopy {}

extension Holder {
    func at(&var self, i: Int) borrows -> &var Int {
        lend self.cells[i]
        print("inner epi")
    }
}

struct S {
    f0: Int
    f1: Int
    f2: Int
    v0: Vector<Int>
    v1: Vector<Int>
    v2: Vector<Int>
    h0: Holder
    h1: Holder
    h2: Holder
}

extension S: NoCopy {}

extension S {
    func p_ff(&var self, sel: Int, i: Int) borrows -> &var Int {
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.f1
                print("epi 1")
            },
        }
        print("tail")
    }

    func c_ff(&var self, sel: Int, i: Int) borrows -> &var Int? {
        if sel == 9 {
            print("absent")
            return None
        }
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.f1
                print("epi 1")
            },
        }
        print("tail")
    }

    func p_fv(&var self, sel: Int, i: Int) borrows -> &var Int {
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.v1[i]
                print("epi 1")
            },
        }
        print("tail")
    }

    func c_fv(&var self, sel: Int, i: Int) borrows -> &var Int? {
        if sel == 9 {
            print("absent")
            return None
        }
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.v1[i]
                print("epi 1")
            },
        }
        print("tail")
    }

    func p_fh(&var self, sel: Int, i: Int) borrows -> &var Int {
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.h1.at(i)
                print("epi 1")
            },
        }
        print("tail")
    }

    func c_fh(&var self, sel: Int, i: Int) borrows -> &var Int? {
        if sel == 9 {
            print("absent")
            return None
        }
        match sel {
            case 0 -> {
                lend self.f0
                print("epi 0")
            },
            case _ -> {
                lend self.h1.at(i)
                print("epi 1")
            },
        }
        print("tail")
    }

    func p_vf(&var self, sel: Int, i: Int) borrows -> &var Int {
        match sel {
            case 0 -> {
                lend self.v0[i]
                print("epi 0")
            },
            case _ -> {
                lend self.f1
                print("epi 1")
            },
        }
        print("tail")
    }

    func c_vf(&var self, sel: Int, i: Int) borrows -> &var Int? {
        if sel == 9 {
