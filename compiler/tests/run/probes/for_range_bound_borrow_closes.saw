// probe: stated
// about: a `for` range's bound read through a `borrows` call is written `borrow`, and its window closes at the head, so the body takes the root exclusively each iteration (SL-849)
// stage 0: cannot parse a `borrow` place
// speeds: -O0 -O2
// prints: 2
// prints: 3
// prints: 8
import std.json.{JsonValue}

struct Store { projects: JsonValue, count: Int }

extension Store: NoCopy {}

struct Entry { n: Int }

struct Shelf { items: [Entry; 2], visits: Int }

extension Shelf {
    @synthesize(shared)
    func slot(&var self, i: Int) borrows -> &var Entry {
        lend self.items[i]
    }
}

func touch(st: &var Store) { st.count += 1 }

func visit(s: &var Shelf) { s.visits += s.items[0].n }

func main() {
    var items = Vector<JsonValue>()
    try! items.push(JsonValue.Number(1))
    try! items.push(JsonValue.Number(2))
    var st = Store(projects: JsonValue.Array(move items), count: 0)
    for i in 0..borrow st.projects.as_array()!.len() {
        touch(&var st)
    }
    print(st.count)
    var s = Shelf(items: [Entry(n: 1), Entry(n: 3)], visits: 0)
    for i in 0..borrow s.slot(1).n {
        visit(&var s)
    }
    print(s.visits)
    while borrow s.slot(0).n < 3 {
        borrow var s.slot(0).n += 1
        visit(&var s)
    }
    print(s.visits)
}
