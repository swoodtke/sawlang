// probe: stated
// about: a const parameter read as a value is its instance's value at every expression position: a tail, an operand, a comparison, a loop bound, an index, a shift count, a format argument, an interpolation, a match scrutinee, beside a repeat count, and inferred from a `[T; N]` argument (SL-548)
// stage 0: prints the same lines, but a program new since v0.18.0 has no Linux record, so the lines are stated
// speeds: -O0 -O2
// prints: 3 5
// prints: 77 -21
// prints: 1 0 -1
// prints: true false
// prints: 406 0
// prints: 20 50
// prints: 4 25
// prints: 1 8
// prints: 1 1024
// prints: N = 12
// prints: again 12
// prints: zero positive
// prints: 310
// prints: 4 1
func width<const N: Int>() -> Int {
    N
}

func scaled<const N: Int>(x: Int) -> Int {
    let a = N * 2 + 1
    let b = x - N
    a + b * 10
}

func sign<const N: Int>() -> Int {
    if N > 0 { 1 } else if N == 0 { 0 } else { -1 }
}

func big<const N: Int>(x: Int) -> Bool {
    x >= N
}

func sum_below<const N: Int>() -> Int {
    var s = 0
    for i in 0..N {
        s += i
    }
    var j = 0
    while j < N {
        s += 100
        j += 1
    }
    s
}

func pick<const N: Int>() -> Int {
    let a = [10, 20, 30, 40, 50]
    a[N]
}

func last<const N: Int>() -> Int {
    var b: [Int; N] = [0; N]
    var i = 0
    while i < N {
        b[i] = i * i
        i += 1
    }
    b[N - 1]
}

// The spec's guarded shift: `top_bit<0>` never runs its shift by -1.
func top_bit<const N: Int>(x: Int) -> Int {
    if N > 0 { x << (N - 1) } else { x }
}

func pow2<const N: Int>() -> Int {
    1 << N
}

func show<const N: Int>() {
    print("N = {}", N)
    print("again {N}")
}

func name<const N: Int>() -> String {
    match N {
        case 0 -> "zero",
        case n if n < 0 -> "negative",
        case _ -> "positive"
    }
}

func filled<const N: Int>(v: Int) -> Int {
    let a: [Int; N] = [v; N]
    a.len() * 100 + a[0] + N
}

func inferred<const N: Int>(xs: [Int; N]) -> Int {
    N
}

func main() {
    print("{} {}", width<3>(), width<5>())
    print("{} {}", scaled<3>(10), scaled<4>(1))
    print("{} {} {}", sign<7>(), sign<0>(), sign<0 - 2>())
    print("{} {}", big<5>(5), big<5>(4))
    print("{} {}", sum_below<4>(), sum_below<0>())
    print("{} {}", pick<1>(), pick<4>())
    print("{} {}", last<3>(), last<6>())
    print("{} {}", top_bit<0>(1), top_bit<4>(1))
    print("{} {}", pow2<0>(), pow2<10>())
    show<12>()
    print("{} {}", name<0>(), name<5>())
    print("{}", filled<3>(7))
    print("{} {}", inferred([1, 2, 3, 4]), inferred([9]))
}
