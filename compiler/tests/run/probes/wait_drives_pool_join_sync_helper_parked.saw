// probe: stated
// about: a `join()` of a `TaskGroup(threads: 2)` task made by a `sync` helper under a suspending `main` while a cooperative task on its thread, parked on a timer, sends what it waits for, runs that task and completes, conformance row K205 (SL-821)
// stage 0: runs it on its own std's executor, which this rule is not part of (SL-821)
// speeds: -O0 -O2
// prints: done 5
import std.task.*
import std.channel.{Channel}

// Parks on a timer before it sends.
func late_sender(ch: Channel<Int>, value: Int) -> Int {
    sleep(Duration.ms(20))
    try! ch.send(value)
    0
}

// Cedes once, so a join of it runs the thread's other ready tasks first.
func yielder() -> Int {
    yield_now()
    0
}

func pool_receive(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func helper() sync -> Int {
    let ch = try! Channel<Int>()
    var group = TaskGroup()
    let s = group.spawn(late_sender(ch, 5))
    // The kick's join runs the sender to its timer park.
    var kick = TaskGroup()
    let k = kick.spawn(yielder())
    let _ = k.join()
    var pool = try! TaskGroup(threads: 2)
    let p = pool.spawn(pool_receive(ch))
    let v = p.join()
    let _ = s.join()
    v
}

func main() {
    yield_now()
    print("done {}", helper())
}
