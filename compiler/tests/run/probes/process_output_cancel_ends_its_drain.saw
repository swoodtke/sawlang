// probe: stated
// about: a task cancelled while `Command.output()` or `output_bytes()` drains its child's standard output gets `Interrupted` at once, in a cooperative group and a pool alike, and the child keeps running until a later spawn reaps it (SL-896)
// stage 0: cannot run it, since its `std.process` has no `Command.output()` that returns a `Result` and ends in `SystemError.Interrupted`
// speeds: -O0 -O2
// leaks: none
// prints: output, silent child: interrupted early true, cancelled true
// prints: output, child wrote first: interrupted early true, cancelled true
// prints: output_bytes, silent child: interrupted early true, cancelled true
// prints: output in a pool: interrupted early true, cancelled true
// prints: children still running after the cancels: true
// prints: zombies left for nobody: 0
// prints: children still running after the sweep: false
// prints: deinits=4
//
// Every child keeps its standard output open until a gate pipe, its standard
// input, closes, which happens only once every cell is over. So a drain that
// returns before that was cut short by its cancel, and one that is not cut
// short never returns before the gate closes. Each cancel lands once its
// child runs, which the child says by writing one byte to its standard error,
// the write end of a second pipe. A child inherits only its standard
// descriptors, so the program puts that write end at its own standard error
// while it launches a child, and puts its own back once the byte has come.
// Closing the gate ends every child, and the second pipe then reads end of
// file once every child holding it has closed its standard error, which a
// child does on its way out, before `waitpid` can reap it. So the end of file
// is not an exit. Each spawn sweeps the orphan list, so the program spawns
// again until `waitid` with `WNOWAIT`, which reaps nothing, says the process
// has no child left: std reaped every one. `waitpid(-1, WNOHANG)` then counts
// what no one reaped.

import std.process.{Command, CommandOutput, CommandByteOutput}
import std.systemerror.{SystemError, SystemErrorKind}
import std.task.*

struct PollFd { fd: Int32, events: Int16, revents: Int16 }

extern "C" {
    func waitpid(pid: Int32, status: UnsafePointer<Int32>, options: Int32) -> Int32
    func waitid(kind: Int32, id: Int32, info: UnsafePointer<UInt8>, options: Int32) -> Int32
    func pipe(ends: UnsafePointer<Int32>) -> Int32
    func dup(fd: Int32) -> Int32
    func dup2(from: Int32, to: Int32) -> Int32
    func close(fd: Int32) -> Int32
    func read(fd: Int32, bytes: UnsafePointer<UInt8>, count: Int) -> Int
    // `nfds_t` is 32 bits on macOS and 64 on Linux; a word carries either.
    func poll(fds: UnsafePointer<PollFd>, count: UInt, timeout_ms: Int32) -> Int32
}

static WNOHANG: Int32 = 1
static WEXITED: Int32 = 4
static P_ALL: Int32 = 0
// The `siginfo_t` buffer `waitid` fills, larger than the struct on macOS and Linux.
static SIGINFO_BYTES: Int = 256
// `WNOWAIT` by host, which `uname -s` names (sys/wait.h on each).
static WNOWAIT_DARWIN: Int32 = 0x20
static WNOWAIT_LINUX: Int32 = 0x01000000
static WNOWAIT: Atomic<Int> = Atomic(0)
static POLLIN: Int16 = 1
static STANDARD_INPUT: Int32 = 0
static STANDARD_ERROR: Int32 = 2
// The waits below tick every millisecond for at most 10 s.
static TICK_MS: UInt64 = 1
static DEADLINE_TICKS: Int = 10_000
static DEINITS: Atomic<Int> = Atomic(0)
static GATE_WRITE: Atomic<Int> = Atomic(-1)
static GATE_CLOSED: Atomic<Int> = Atomic(0)
static ALIVE_READ: Atomic<Int> = Atomic(-1)
static ALIVE_WRITE: Atomic<Int> = Atomic(-1)
static SAVED_ERROR: Atomic<Int> = Atomic(-1)
// The bytes the children have written on the second pipe.
static STARTED: Atomic<Int> = Atomic(0)

struct Held { id: Int }
extension Held: NoCopy { func deinit(&var self) { let _ = DEINITS.fetch_add(1) } }

func pipe_ends() unsafe -> (Int32, Int32) {
    var ends: [Int32; 2] = [0; 2]
    if pipe((&ends) as UnsafePointer<Int32>) != 0 {
        panic("pipe(2) failed")
    }
    (ends[0], ends[1])
}

func open_pipes() unsafe {
    let (gate_read, gate_write) = pipe_ends()
    let (alive_read, alive_write) = pipe_ends()
    if dup2(gate_read, STANDARD_INPUT) < 0 {
        panic("dup2(2) of the gate failed")
    }
    let _ = close(gate_read)
    GATE_WRITE.store(gate_write as Int)
    ALIVE_READ.store(alive_read as Int)
    ALIVE_WRITE.store(alive_write as Int)
    SAVED_ERROR.store(dup(STANDARD_ERROR) as Int)
}

func divert_error() unsafe {
    let _ = dup2(ALIVE_WRITE.load() as Int32, STANDARD_ERROR)
}

func restore_error() unsafe {
    let _ = dup2(SAVED_ERROR.load() as Int32, STANDARD_ERROR)
}

// What one look at the second pipe found: bytes, end of file, or nothing yet.
enum Look { case Bytes, case Ended, case Empty }

func look() unsafe -> Look {
    var watched = PollFd(fd: ALIVE_READ.load() as Int32, events: POLLIN, revents: 0)
    if poll((&watched) as UnsafePointer<PollFd>, 1, 0) == 0 {
        return Look.Empty
    }
    var got: [UInt8; 64] = [0; 64]
    let n = read(ALIVE_READ.load() as Int32, (&got) as UnsafePointer<UInt8>, 64)
    if n <= 0 {
        return Look.Ended
    }
    let _ = STARTED.fetch_add(n)
    Look.Bytes
}

// Waits, a tick at a time, until `count` children have said they run.
func await_started(count: Int) {
    var ticks = 0
    while STARTED.load() < count {
        if ticks == DEADLINE_TICKS {
            restore_error()
            panic("child {} never said it runs within 10 s", count)
        }
        match look() {
            case Ended -> {
                restore_error()
                panic("the children's pipe ended while child {} was launching", count)
            },
            case _ -> {}
        }
        sleep(Duration.ms(TICK_MS))
        ticks = ticks + 1
    }
}

// Waits, a tick at a time, for the second pipe's end of file.
func await_exits() {
    var ticks = 0
    var ended = false
    while not ended {
        if ticks == DEADLINE_TICKS {
            panic("the children never all exited within 10 s")
        }
        match look() {
            case Ended -> { ended = true },
            case _ -> {
                sleep(Duration.ms(TICK_MS))
                ticks = ticks + 1
            }
        }
    }
}

func child(script: String) -> Command {
    var c = Command(program: "/bin/sh")
    try! c.arg("-c")
    try! c.arg(script)
    move c
}

func interrupted(e: &SystemError) -> Bool {
    match e.kind() {
        case Interrupted -> true,
        case _ -> false
    }
}

// Runs one cell and reports it; `bytes` picks `output_bytes()`.
func cell(name: String, script: String, bytes: Bool) -> Int {
    let _held = Held(id: 1)
    let c = child(script)
    let stopped = if bytes {
        match c.output_bytes() {
            case Ok(_) -> false,
            case Err(e) -> interrupted(&e)
        }
    } else {
        match c.output() {
            case Ok(_) -> false,
            case Err(e) -> interrupted(&e)
        }
    }
    let early = stopped && GATE_CLOSED.load() == 0
    print("{}: interrupted early {}, cancelled {}", name, early, cancelled())
    0
}

func cancelled_cell(name: String, script: String, bytes: Bool) {
    let launched = STARTED.load() + 1
    var g = TaskGroup()
    divert_error()
    let t = g.spawn(cell(name, script, bytes))
    await_started(launched)
    restore_error()
    t.cancel()
    let _ = t.join()
}

func pool_cell() {
    let launched = STARTED.load() + 1
    var pool = try! TaskGroup(threads: 2)
    divert_error()
    let t = pool.spawn(cell("output in a pool", "printf x >&2; read gate", false))
    await_started(launched)
    restore_error()
    t.cancel()
    let _ = t.join()
}

func running_children() unsafe -> Bool {
    var status: Int32 = 0
    waitpid(-1, (&status) as UnsafePointer<Int32>, WNOHANG) == 0
}

func leftovers() unsafe -> Int {
    var count = 0
    var status: Int32 = 0
    while waitpid(-1, (&status) as UnsafePointer<Int32>, WNOHANG) > 0 {
        count = count + 1
    }
    count
}

// Picks `WNOWAIT` for the host `uname -s` names. Its child is reaped by the call.
func choose_wait_flag() {
    var uname = Command(program: "uname")
    try! uname.arg("-s")
    let name = match uname.output() {
        case Ok(out) -> out.stdout.trim(),
        case Err(_) -> panic("uname -s did not run")
    }
    if name == "Darwin" {
        WNOWAIT.store(WNOWAIT_DARWIN as Int)
    } else if name == "Linux" {
        WNOWAIT.store(WNOWAIT_LINUX as Int)
    } else {
        panic("no WNOWAIT value for the host {}", name)
    }
}

// Whether the process has a child, running or not yet reaped; nothing is reaped.
func has_children() unsafe -> Bool {
    var info: [UInt8; 256] = [0; 256]
    waitid(P_ALL, 0, (&info) as UnsafePointer<UInt8>, WEXITED | WNOHANG | (WNOWAIT.load() as Int32)) == 0
}

// Spawns a child that exits at once, which sweeps the orphan list, until the
// process has no child left, a tick between turns.
func sweep_until_childless() unsafe {
    var ticks = 0
    while true {
        var sweeper = Command(program: "/bin/sh")
        try! sweeper.arg("-c")
        try! sweeper.arg("exit 0")
        let _ = try! sweeper.wait()
        if not has_children() {
            return
        }
        if ticks == DEADLINE_TICKS {
            return
        }
        sleep(Duration.ms(TICK_MS))
        ticks = ticks + 1
    }
}

func main() {
    choose_wait_flag()
    open_pipes()
    cancelled_cell("output, silent child", "printf x >&2; read gate", false)
    cancelled_cell("output, child wrote first", "echo hi; printf x >&2; read gate", false)
    cancelled_cell("output_bytes, silent child", "printf x >&2; read gate", true)
    pool_cell()
    print("children still running after the cancels: {}", running_children())
    let _ = close(ALIVE_WRITE.load() as Int32)
    GATE_CLOSED.store(1)
    let _ = close(GATE_WRITE.load() as Int32)
    await_exits()
    sweep_until_childless()
    print("zombies left for nobody: {}", leftovers())
    print("children still running after the sweep: {}", running_children())
    print("deinits={}", DEINITS.load())
}
