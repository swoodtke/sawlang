// probe: stated
// about: a `@synthesize`d Serialize and Deserialize on a struct: every stored field in declaration order as one array, a private field included, over Int, Bool, String, String?, Vector<Int>, a nested derived struct and a narrow Int8 read through its range check (SL-833)
// stage 0: has no std.serialize module
// speeds: -O0 -O2
// leaks: none
// prints: a8 i443 b1 tapi n a2 i1 i2 a2 th i80 i-3 u7
// prints: 443 true api none 2 h 80 -3 7
// prints: a8 i1 b0 tx tt a0 a2 t i-1 i127 u65535
// prints: 1 false x t 0  -1 127 65535
// prints: refused: decode error at byte 10: the value does not fit the destination type
// prints: refused: decode error at byte 1: the array or map holds a different number of items than expected
import std.serialize.{Decoder, Encoder}
import std.json.{DecodeError, DecodeFault, EncodeError, EncodeFault}

// One token per item: a kind letter and its text. `Tape` is both sides of the
// seam, so a probe writes a value into it and reads the value back.
static KIND_INT: Byte = 0x69
static KIND_UINT: Byte = 0x75
static KIND_BOOL: Byte = 0x62
static KIND_NULL: Byte = 0x6E
static KIND_TEXT: Byte = 0x74
static KIND_ARRAY: Byte = 0x61
static KIND_MAP: Byte = 0x6D

struct Tape {
    items: Vector<String>
    at: Int
}

extension Tape: NoCopy {}

extension Tape {
    func put(&var self, token: String) sync -> Result<Void, EncodeError> {
        match self.items.push(token) {
            case Ok(_) -> { return },
            case Err(_) -> { return EncodeError(fault: EncodeFault.Alloc) }
        }
    }

    func peek(&self) sync -> Result<String, DecodeError> {
        guard let tok = self.items.get(self.at) else {
            return DecodeError(offset: self.at, fault: DecodeFault.Truncated)
        }
        return tok
    }

    // The next token's text after its kind letter, or TypeMismatch at the
    // token's own position.
    func take(&var self, kind: Byte) sync -> Result<String, DecodeError> {
        let tok = try self.peek()
        if tok.byte_at(0) != kind {
            return DecodeError(offset: self.at, fault: DecodeFault.TypeMismatch)
        }
        self.at = self.at + 1
        return tok.substring(1, tok.len())
    }

    func render(&self) -> String {
        var out = StringBuilder()
        var i = 0
        while i < self.items.len() {
            if i > 0 {
                try! out.append(" ")
            }
            try! out.append(self.items[i])
            i = i + 1
        }
        return out.build()
    }
}

extension Tape: Encoder {
    func write_uint(&var self, v: UInt64) sync -> Result<Void, EncodeError> {
        var b = StringBuilder()
        try! b.append(KIND_UINT)
        try! b.append(v.to_string())
        return self.put(b.build())
    }
    func write_int(&var self, v: Int64) sync -> Result<Void, EncodeError> {
        var b = StringBuilder()
        try! b.append(KIND_INT)
        try! b.append(v.to_string())
        return self.put(b.build())
    }
    func write_bool(&var self, v: Bool) sync -> Result<Void, EncodeError> {
        if v {
            return self.put("b1")
        }
        return self.put("b0")
    }
    func write_null(&var self) sync -> Result<Void, EncodeError> {
        self.put("n")
    }
    func write_text(&var self, v: String) sync -> Result<Void, EncodeError> {
        var b = StringBuilder()
        try! b.append(KIND_TEXT)
        try! b.append(v)
        return self.put(b.build())
    }
    func begin_bytes(&var self, count: Int) sync -> Result<Void, EncodeError> {
        return EncodeError(fault: EncodeFault.Unsupported)
    }
    func write_byte(&var self, b: UInt8) sync -> Result<Void, EncodeError> {
        return EncodeError(fault: EncodeFault.Unsupported)
    }
    func begin_array(&var self, count: Int) sync -> Result<Void, EncodeError> {
        var b = StringBuilder()
        try! b.append(KIND_ARRAY)
        try! b.append(count)
        return self.put(b.build())
    }
    func begin_map(&var self, count: Int) sync -> Result<Void, EncodeError> {
        var b = StringBuilder()
        try! b.append(KIND_MAP)
        try! b.append(count)
        return self.put(b.build())
    }
}

extension Tape: Decoder {
    func read_uint(&var self) sync -> Result<UInt64, DecodeError> {
        let at = self.at
        let text = try self.take(KIND_UINT)
        guard let v = text.to_uint() else {
            return DecodeError(offset: at, fault: DecodeFault.Malformed)
        }
        return v as UInt64
    }
    func read_int(&var self) sync -> Result<Int64, DecodeError> {
        let at = self.at
        let text = try self.take(KIND_INT)
        guard let v = text.to_int() else {
            return DecodeError(offset: at, fault: DecodeFault.Malformed)
        }
        return v as Int64
    }
    func read_bool(&var self) sync -> Result<Bool, DecodeError> {
        let text = try self.take(KIND_BOOL)
        return text == "1"
    }
    func read_null(&var self) sync -> Result<Void, DecodeError> {
        let _ = try self.take(KIND_NULL)
        return
    }
    func read_text(&var self) sync -> Result<String, DecodeError> {
        self.take(KIND_TEXT)
    }
    func begin_bytes(&var self) sync -> Result<Int, DecodeError> {
        return DecodeError(offset: self.at, fault: DecodeFault.Unsupported)
    }
    func read_byte(&var self) sync -> Result<Byte, DecodeError> {
        return DecodeError(offset: self.at, fault: DecodeFault.Unsupported)
    }
    func begin_array(&var self) sync -> Result<Int, DecodeError> {
        let at = self.at
        let text = try self.take(KIND_ARRAY)
        guard let v = text.to_int() else {
            return DecodeError(offset: at, fault: DecodeFault.Malformed)
        }
        return v
    }
    func begin_map(&var self) sync -> Result<Int, DecodeError> {
        let at = self.at
        let text = try self.take(KIND_MAP)
        guard let v = text.to_int() else {
            return DecodeError(offset: at, fault: DecodeFault.Malformed)
        }
        return v
    }
    func at_null(&var self) sync -> Result<Bool, DecodeError> {
        let tok = try self.peek()
        return tok.byte_at(0) == KIND_NULL
    }
    func offset(&self) sync -> Int {
        self.at
    }
    func skip(&var self) sync -> Result<Void, DecodeError> {
        let _ = try self.peek()
        self.at = self.at + 1
        return
    }
}

// A tape holding the space-separated tokens of `text`, ready to read.
func tape_from(text: String) -> Tape {
    Tape(items: try! text.split(" "), at: 0)
}

struct Inner {
    host: String
    port: Int
}

@synthesize
extension Inner: Serialize {}
@synthesize
extension Inner: Deserialize {}

public struct Endpoint {
    port: Int
    secure: Bool
    name: String
    tag: String?
    nums: Vector<Int>
    inner: Inner
    small: Int8
    private hidden: UInt16
}

@synthesize
extension Endpoint: Serialize {}
@synthesize
extension Endpoint: Deserialize {}
extension Endpoint: NoCopy {}

// Writes `v` into a fresh tape and returns the tape's text.
func written(v: &Endpoint) -> String {
    var t = Tape(items: Vector<String>(), at: 0)
    try! v.serialize(to: &var t)
    t.render()
}

func show(r: Result<Endpoint, DecodeError>) {
    match r {
        case Ok(e) -> print("{} {} {} {} {} {} {} {} {}", e.port, e.secure, e.name, e.tag ?? "none", e.nums.len(),
                           e.inner.host, e.inner.port, e.small as Int, e.hidden as Int),
        case Err(e) -> print("refused: {}", e)
    }
}

func main() {
    var nums = Vector<Int>()
    try! nums.push(1)
    try! nums.push(2)
    let ep = Endpoint(port: 443, secure: true, name: "api", tag: None, nums: move nums,
                      inner: Inner(host: "h", port: 80), small: -3, hidden: 7)
    let text = written(&ep)
    print("{}", text)
    var back = tape_from(text)
    show(Endpoint.deserialize(from: &var back))

    let tagged = Endpoint(port: 1, secure: false, name: "x", tag: "t", nums: Vector<Int>(),
                          inner: Inner(host: "", port: -1), small: 127, hidden: 65535)
    let text2 = written(&tagged)
    print("{}", text2)
    var back2 = tape_from(text2)
    show(Endpoint.deserialize(from: &var back2))

    // Int8 reads back through its range check.
    var wide = tape_from("a8 i1 b1 tx n a0 a2 th i2 i128 u1")
    show(Endpoint.deserialize(from: &var wide))
    // A field count the struct does not have.
    var short = tape_from("a7 i1 b1 tx n a0 a2 th i2 i1")
    show(Endpoint.deserialize(from: &var short))
}
