// probe: panics
// about: `try!` on a call generic over its error type that fails with `AllocError`, in a sync body, panics with the error rendered after `try! failed: ` through its error type's helper (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed: allocation of 64 bytes (align 8) failed
// ll defines: saw try failure std.alloc.AllocError

func failing<F>(error: F) -> Result<Int, F> {
    return Result<Int, F>.Err(error: error)
}

func run() {
    print("start")
    let v = try! failing(AllocError(size: 64, align: 8))
    print("unreached")
}

func main() {
    run()
}
