// probe: stated
// about: a `Data` window cut by `slice` is O(1) and keeps its block alive: it outlives the `Data` it was cut from, survives that binding's replacement and a write to it, and the block is freed once, by the last owner (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// prints: 3 2 4
// prints: 3 2 4
// prints: 100 3 2
// prints: 2 3
// leaks: none
import std.data.{Data}

func make(n: Int) -> Data {
    var d = Data()
    var i = 0
    while i < n {
        try! d.push(UInt8.from(truncating: i + 1))
        i += 1
    }
    d
}

func middle() -> Data {
    let whole = make(6)
    whole.slice(1, 4)!
}

func main() {
    let w = middle()
    print("{} {} {}", w.len(), w[0], w[2])
    var d = make(5)
    let x = d.slice(1, 4)!
    d = make(1)
    print("{} {} {}", x.len(), x[0], x[2])
    var e = make(4)
    let y = e.slice(1, 3)!
    e[0] = 100
    print("{} {} {}", e[0], e[2], y[0])
    print("{} {}", y[0], y[1])
}
