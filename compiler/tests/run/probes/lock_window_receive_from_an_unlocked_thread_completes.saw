// probe: stated
// about: a blocking `main`'s lock window that receives, through a `blocking` helper that drives the executor, from a `Thread.spawn` body that never takes the lock completes, conformance row K206 (SL-1161)
// stage 0: runs it on its own std's executor, which this rule is not part of
// speeds: -O0 -O2
// prints: got 5
import std.channel.{Channel}
import std.mutex.{Mutex}

static M: Mutex<Int>
static OPEN: Atomic<Int> = Atomic(0)
static LOCKS: Bool = false

func take(ch: &Channel<Int>) blocking -> Int {
    try! ch.receive()
}

func nap() -> Int {
    sleep(Duration.ms(5))
    0
}

func send_after_lock(ch: Channel<Int>) {
    while OPEN.load() == 0 { }
    if LOCKS {
        borrow var m = M.lock() { m = m + 1 }
    }
    try! ch.send(5)
}

func main() blocking {
    let ch = try! Channel<Int>()
    let c = ch.copy()
    var t = try! Thread.spawn { [c] in send_after_lock(c) }
    let group = TaskGroup()
    let n = group.spawn(nap())
    let v = borrow var m = M.lock() {
        OPEN.store(1)
        m = m + take(&ch)
        m
    }
    t.join()
    print("got {}", v)
}
