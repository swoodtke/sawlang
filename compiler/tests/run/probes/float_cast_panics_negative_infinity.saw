// probe: panics
// about: `f as Int32` panics on negative infinity, naming the value, so no out-of-range `fptosi`/`fptoui` runs (SL-927)
// stage 0: not run; the Float conversion rule is SL-927's, which v0.18.0 predates
// speeds: -O0 -O2
// prints: before
// panics: cast to Int32 out of range: -inf
// The program renders no other Float, so the panic's rendering is rooted by
// the cast alone.

func held(v: Float) -> Float {
    v
}

func main() {
    let f = held(v: -Float.from(bits: 0x7FF0_0000_0000_0000))
    print("before")
    let n = f as Int32
    print("unreachable {}", n)
}
