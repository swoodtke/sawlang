// probe: stated
// about: `pow` finishes for any exponent when the base is 0, 1 or -1, since it squares rather than multiplying `exp` times (SL-736)
// stage 0: its std's `pow` multiplies `exp` times, so `Int.max` iterations never finish
// speeds: -O0 -O2
// prints: 1
// prints: -1
// prints: 1
// prints: 0
func main() {
    print("{}", (1).pow(Int.max))
    print("{}", (-1).pow(Int.max))
    print("{}", (-1).pow(Int.max - 1))
    print("{}", (0).pow(Int.max))
}
