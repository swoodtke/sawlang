// probe: stated
// about: control: one `lend` site whose local is moved away before the suspension ahead of its `lend` is neither written nor read back (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: sink t1
// prints: drop t1
// prints: epi
// prints: a 1 b 0
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

func sink(t: Tag) {
    print("sink t{}", t.id)
}

struct Two {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two: NoCopy {}

extension Two {
    func pick(&var self, i: Int) borrows -> &var Int {
        let t = Tag(id: 1)
        sink(move t)
        yield_now()
        lend self.a[i]
        print("epi")
    }
}

func main() {
    var s = Two(a: [0], b: [0])
    borrow var x = s.pick(0) {
        yield_now()
        x += 1
    }
    print("a {} b {}", s.a[0], s.b[0])
}
