// probe: panics
// about: a handle minted through a user lending accessor's window and kept past its holder's scope panics at the group's teardown, where the holder dies (SL-564)
// stage 0: cannot parse a `borrow` block
// speeds: -O0 -O2
// prints: holder workers
// panics: TaskGroup: destroyed while 1 task handle still refers to it
import std.task.{yield_now}

func work(n: Int) -> Int {
    yield_now()
    n * 2
}

func pick() -> Bool {
    true
}

struct Holder {
    label: String,
    group: TaskGroup
}

extension Holder: NoCopy {}
extension Holder: NoMove {}

extension Holder {
    func tasks(&var self) borrows -> &var TaskGroup {
        lend self.group
    }
}

func main() {
    var kept: Task<Int>? = None
    if pick() {
        var holder = Holder(label: "workers", group: TaskGroup())
        borrow var t = holder.tasks() {
            kept = t.spawn(work(3))
        }
        print("holder {}", holder.label)
    }
    print("holder gone")
    print("joined {}", kept.take()!.join())
}
