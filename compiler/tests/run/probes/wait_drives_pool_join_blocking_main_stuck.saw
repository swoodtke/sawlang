// probe: panics
// about: a `join()` of a `TaskGroup(threads: 2)` task made by a `blocking` `main` while its thread's one cooperative task receives from a channel nothing sends to, as does what it waits for, is reported by the deadlock walk, conformance row K205 (SL-821)
// stage 0: runs it on its own std's executor, which this rule is not part of (SL-821)
// speeds: -O0 -O2
// panics: deadlock: every task is waiting to receive from a channel, or to join a `TaskGroup(threads:)` task that is, and nothing in this program can send. A join or a pool's teardown made inside a task, or on a thread that has tasks of its own, runs that thread's other tasks until it returns
import std.channel.{Channel}

func stuck_receive(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func pool_receive(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func main() blocking {
    let ch = try! Channel<Int>()
    let other = try! Channel<Int>()
    var group = TaskGroup()
    let s = group.spawn(stuck_receive(other))
    var pool = try! TaskGroup(threads: 2)
    let p = pool.spawn(pool_receive(ch))
    let v = p.join()
    print("done {}", v)
}
