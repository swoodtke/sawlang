// probe: stated
// about: a suspending `main() -> Result<Int, Missing>` that returns `Ok`, its error a struct owning a `String`, exits with the `Ok` payload, 0 for `Ok(())` (SL-874)
// stage 0: runs it alike; the cell is stated beside the error cells, whose stream Stage 0 differs on
// speeds: -O0 -O2
// prints: start
// exits: 5
// leaks: none

import std.task.{yield_now}

struct Missing {
    shelf: String
}

extension Missing: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("no such shelf: ")
        try! into.append(self.shelf)
    }
}

extension Missing: Error {}

func main() -> Result<Int, Missing> {
    yield_now()
    print("start")
    return 5
}
