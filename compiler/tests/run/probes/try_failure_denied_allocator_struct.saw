// probe: panics
// about: `try!` on a `Result<Int, Failure>` made before the allocator is denied panics with the error rendered, so the rendering allocates nothing (SL-882)
// stage 0: not run; the probe holds sawc to the spec's `try!` message cell by cell
// speeds: -O0 -O2
// prints: start
// panics: try! failed: no such widget
// ll defines: saw try failure try_failure_denied_allocator_struct.Failure

extern "C" {
    func __saw_rt_alloc_deny_after(allow: Int)
}

struct Failure {
    why: String
}

extension Failure: Error {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.why)
    }
}

func make(fail: Bool) -> Result<Int, Failure> {
    if fail {
        return Failure(why: "no such widget")
    }
    return 1
}

func run() {
    print("start")
    let made = make(true)
    __saw_rt_alloc_deny_after(0)
    let v = try! move made
    print("unreached")
}

func main() {
    run()
}
