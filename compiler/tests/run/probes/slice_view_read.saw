// probe: stated
// about: an element of a slice a `borrows` accessor lends is read where it sits, inside the view's window, at every value position: a `let`, an argument, arithmetic, a format argument, a condition, a `return`, a nested view, a Copy-tier `String` element, an ExplicitCopy element's `.copy()`, through the shared twin, for a user accessor and std's `Vector` and `Data` (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// prints: 2
// prints: 3
// prints: 21
// prints: 2 3
// prints: second is 2
// prints: 3
// prints: 2
// prints: 3
// prints: c c
// prints: 30 30
// prints: 4
// prints: 9 8
// prints: 1 3
// prints: 2 2
// prints: 3 2 5
// leaks: none
import std.data.{Data}

struct Ring { store: [Int; 3] }

extension Ring {
    func base(&self) unsafe -> UnsafePointer<Int> {
        (&self.store) as UnsafePointer<Int>
    }

    @synthesize(shared)
    func [](&var self, range: Range) unsafe borrows -> &var [Int] {
        lend self.base()[range.current..range.end]
    }
}

func twice(n: Int) -> Int { n * 2 }

func last_of(v: &Vector<Int>) -> Int {
    return v[1..][v.len() - 2]
}

func shared_second(v: &Vector<Int>) -> Int { v[1..][0] }

func main() {
    let v: Vector<Int> = [1, 2, 3, 4]
    let x = v[1..][0]
    print(x)
    print(twice(v[..2][1]) - 1)
    print(v[1..=2][0] * 10 + 1)
    print("{} {}", v[1..][0], v[2..][0])
    if v[1..][0] == 2 { print("second is {}", v[1..][0]) }
    print(last_of(&v) - 1)
    print(v[1..][0..2][0])
    print(v[1..][1..][0])
    let names: Vector<String> = ["a", "b", "c"]
    let n = names[1..][1]
    print("{} {}", n, names[2..][0])
    var d = Data()
    try! d.push(10)
    try! d.push(20)
    try! d.push(30)
    print("{} {}", d[2..][0], d[1..][1])
    print(shared_second(&v) * 2)
    var r = Ring(store: [9, 8, 7])
    print("{} {}", r[0..2][0], r[1..3][0])
    let frozen = Ring(store: [1, 2, 3])
    print("{} {}", frozen[0..1][0], frozen[2..3][0])
    let y = frozen[1..3][0]
    print("{} {}", y, r[0..3][2] - 5)
    let rows: Vector<Vector<Int>> = [[1, 2], [3, 4], [5]]
    var row = rows[1..][0].copy()
    try! row.push(9)
    print("{} {} {}", row.len(), rows[1..][0].len(), rows[1..][1][0])
}
