// probe: panics
// about: a reversed `Vector` range view panics, naming `Vector`, the range and the length (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// panics: Vector.[]: range out of range: 2..1 (len 3)
func bound(n: Int) -> Int { n }

func main() {
    let v: Vector<Int> = [1, 2, 3]
    borrow let s = v[bound(2)..1] { print(s.len()) }
}
