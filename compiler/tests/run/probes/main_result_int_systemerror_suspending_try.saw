// probe: stated
// about: a suspending `main() -> Result<Int, SystemError>` that propagates an `Err` with `try`, its error `SystemError`, writes `error: ` and the rendered error on standard error and exits 1 (SL-874)
// stage 0: writes the error on standard output, where sawc writes standard error
// speeds: -O0 -O2
// prints: start
// prints: middle 7
// exits: 1
// stderr: error: open "/nonexistent/sl874" failed (not found)
// leaks: none

import std.task.{yield_now}
import std.file
import std.path.{Path}
import std.systemerror.{SystemError}

func opening_error() -> SystemError {
    match file.File.open(Path(s: "/nonexistent/sl874")) {
        case Ok(_) -> panic("opened"),
        case Err(e) -> e
    }
}

func step(fail: Bool) -> Result<Int, SystemError> {
    if fail {
        return opening_error()
    }
    return 7
}

func main() -> Result<Int, SystemError> {
    yield_now()
    print("start")
    let a = try step(false)
    print("middle {}", a)
    let b = try step(true)
    print("unreached {}", b)
    return 0
}
