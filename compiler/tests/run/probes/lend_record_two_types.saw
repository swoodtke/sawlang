// probe: stated
// about: each of two `lend` sites holds a local of its own type, a `String` and a NoCopy struct with a `deinit`, across a suspending `lend` (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: epi 0 s0
// prints: tail
// prints: epi 1 1
// prints: drop t1
// prints: tail
// prints: a 1 b 2
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

func sink(t: Tag) {
    print("sink t{}", t.id)
}

struct Two {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two: NoCopy {}

extension Two {
    func pick(&var self, first: Bool, i: Int) borrows -> &var Int {
        if first {
            let s = "s{i}"
            yield_now()
            lend self.a[i]
            print("epi 0 {}", s)
        } else {
            let t = Tag(id: 1)
            yield_now()
            lend self.b[i]
            print("epi 1 {}", t.id)
        }
        print("tail")
    }
}

func main() {
    var s = Two(a: [0], b: [0])
    borrow var s.pick(true, 0) += 1
    borrow var s.pick(false, 0) += 2
    print("a {} b {}", s.a[0], s.b[0])
}
