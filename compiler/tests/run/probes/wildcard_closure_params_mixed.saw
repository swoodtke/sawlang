// probe: stated
// about: `_` closure parameters beside named ones leave each name bound to its own argument (SL-978)
// stage 0: not run; the probe holds sawc to the spec's `_` binds-nothing rule, row by row
// speeds: -O0 -O2
// prints: 5
// prints: 6
// prints: 6
// prints: 12

func apply2(f: (Int, Int) -> Int) -> Int { f(5, 6) }
func apply3(f: (Int, Int, Int) -> Int) -> Int { f(5, 6, 7) }

func main() {
    print(apply2({ a, _ in a }))
    print(apply2({ _, b in b }))
    print(apply3({ _, b, _ in b }))
    print(apply3({ a: Int, _: Int, c: Int in a + c }))
}
