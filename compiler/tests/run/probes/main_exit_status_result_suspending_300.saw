// probe: panics
// about: a suspending `main() -> Result<Int, Refusal>` returning `Ok(300)`, outside 0...255, panics at `main`'s declaration instead of exiting with a narrowed status (SL-892)
// stage 0: not run; the probe states a rule Stage 0 predates
// speeds: -O0 -O2
// prints: start
// panics: main returned exit status 300, which is outside 0...255

import std.task.{yield_now}

struct Refusal {
    reason: String
}

extension Refusal: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.reason)
    }
}

extension Refusal: Error {}

func main() -> Result<Int, Refusal> {
    yield_now()
    print("start")
    return 300
}
