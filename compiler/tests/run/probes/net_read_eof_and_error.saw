// probe: stated
// about: a read's bytes and its clean end of stream stay two answers (SL-570)
// stage 0: its frozen std.net answers `TcpStream.pair()` with a bare pair, so it refuses the `try!` (SL-768)
// speeds: -O0 -O2
// prints: pair, data waiting: bytes
// prints: pair, peer closed: end of stream
// A read's answers stay apart (SL:coroutines A12b): bytes are a non-empty
// `Ok` and the peer's clean close is an empty `Ok`. No case races the peer's
// close: the data is written before the read, and the close happens before
// the second read. The failure answer, a reset, needs the peer to close a
// socket that holds unread bytes, which only a descriptor wait can order, so
// std's `exec/park_net_read_after_reset` pins it.
import std.data.{Data}
import std.net.{IoError, TcpStream}

func describe(answer: Result<Data, IoError>) -> String {
    match answer {
        case Ok(bytes) -> {
            if bytes.len() == 0 { "end of stream" } else { "bytes" }
        },
        case Err(e) -> "{e}"
    }
}

func main() {
    let (near, far) = try! TcpStream.pair()
    try! far.write("x")
    print("pair, data waiting: {}", describe(near.read()))
    let _ = move far
    print("pair, peer closed: {}", describe(near.read()))
}
