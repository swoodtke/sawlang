// probe: stated
// about: a `match` whose arm binds all of an owned scrutinee, a String, hands it to the binding and leaks nothing (SL-852)
// stage 0: releases a call's result its arm binds whole and consumes a second time, and dies
// speeds: -O0 -O2
// leaks: none
// prints: call bare consumed t1
// prints: call bare borrowed t2
// prints: call bare unused none
// prints: call literal consumed t4
// prints: call literal borrowed t5
// prints: call literal unused none
// prints: call guard consumed t7
// prints: call guard borrowed t8
// prints: call guard unused none
// prints: move local bare consumed t10
// prints: move local bare borrowed t11
// prints: move local bare unused none
// prints: move local literal consumed t13
// prints: move local literal borrowed t14
// prints: move local literal unused none
// prints: move local guard consumed t16
// prints: move local guard borrowed t17
// prints: move local guard unused none
// prints: coalesce bare consumed t19
// prints: coalesce bare borrowed t20
// prints: coalesce bare unused none
// prints: coalesce literal consumed t22
// prints: coalesce literal borrowed t23
// prints: coalesce literal unused none
// prints: coalesce guard consumed t25
// prints: coalesce guard borrowed t26
// prints: coalesce guard unused none
// prints: force bare consumed t28
// prints: force bare borrowed t29
// prints: force bare unused none
// prints: force literal consumed t31
// prints: force literal borrowed t32
// prints: force literal unused none
// prints: force guard consumed t34
// prints: force guard borrowed t35
// prints: force guard unused none
// prints: try bare consumed t37
// prints: try bare borrowed t38
// prints: try bare unused none
// prints: try literal consumed t40
// prints: try literal borrowed t41
// prints: try literal unused none
// prints: try guard consumed t43
// prints: try guard borrowed t44
// prints: try guard unused none
// Each function matches an owned scrutinee, a temporary the match holds,
// with an arm that binds all of it, after a literal or under a guard too,
// and consumes, borrows or ignores the binding. The binding takes the
// temporary whole, so the value is released once, by the binding or by
// the call it moved into, and never by the match.

enum Refused {
    case Never
}

func make(n: Int) -> String {
    "t{n}"
}

func maybe(n: Int) -> String? {
    make(n)
}

func fallible(n: Int) -> Result<String, Refused> {
    make(n)
}

func take(x: String) -> String {
    "{x}"
}

func look(x: &String) -> String {
    "{x}"
}

func call_bare_consumed(n: Int) -> String {
    match make(n) {
        case x -> take(move x)
    }
}

func call_bare_borrowed(n: Int) -> String {
    match make(n) {
        case x -> look(&x)
    }
}

func call_bare_unused(n: Int) -> String {
    match make(n) {
        case x -> "none"
    }
}

func call_literal_consumed(n: Int) -> String {
    match make(n) {
        case "zz" -> "zz",
        case x -> take(move x)
    }
}

func call_literal_borrowed(n: Int) -> String {
    match make(n) {
        case "zz" -> "zz",
        case x -> look(&x)
    }
}

func call_literal_unused(n: Int) -> String {
    match make(n) {
        case "zz" -> "zz",
        case x -> "none"
    }
}

func call_guard_consumed(n: Int) -> String {
    match make(n) {
        case x if n > 0 -> take(move x),
        case _ -> "other"
    }
}

func call_guard_borrowed(n: Int) -> String {
    match make(n) {
        case x if n > 0 -> look(&x),
        case _ -> "other"
    }
}

func call_guard_unused(n: Int) -> String {
    match make(n) {
        case x if n > 0 -> "none",
        case _ -> "other"
    }
}

func move_local_bare_consumed(n: Int) -> String {
    let s = make(n)
    match move s {
        case x -> take(move x)
    }
}

func move_local_bare_borrowed(n: Int) -> String {
    let s = make(n)
    match move s {
        case x -> look(&x)
    }
}

func move_local_bare_unused(n: Int) -> String {
    let s = make(n)
    match move s {
        case x -> "none"
    }
}

func move_local_literal_consumed(n: Int) -> String {
    let s = make(n)
    match move s {
        case "zz" -> "zz",
        case x -> take(move x)
    }
}

func move_local_literal_borrowed(n: Int) -> String {
    let s = make(n)
    match move s {
        case "zz" -> "zz",
        case x -> look(&x)
    }
}

func move_local_literal_unused(n: Int) -> String {
    let s = make(n)
    match move s {
        case "zz" -> "zz",
        case x -> "none"
    }
}

func move_local_guard_consumed(n: Int) -> String {
    let s = make(n)
    match move s {
        case x if n > 0 -> take(move x),
        case _ -> "other"
    }
}

func move_local_guard_borrowed(n: Int) -> String {
    let s = make(n)
    match move s {
        case x if n > 0 -> look(&x),
        case _ -> "other"
    }
}

func move_local_guard_unused(n: Int) -> String {
    let s = make(n)
    match move s {
        case x if n > 0 -> "none",
        case _ -> "other"
    }
}

func coalesce_bare_consumed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case x -> take(move x)
    }
}

func coalesce_bare_borrowed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case x -> look(&x)
    }
}

func coalesce_bare_unused(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case x -> "none"
    }
}

func coalesce_literal_consumed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case "zz" -> "zz",
        case x -> take(move x)
    }
}

func coalesce_literal_borrowed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case "zz" -> "zz",
        case x -> look(&x)
    }
}

func coalesce_literal_unused(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case "zz" -> "zz",
        case x -> "none"
    }
}

func coalesce_guard_consumed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case x if n > 0 -> take(move x),
        case _ -> "other"
    }
}

func coalesce_guard_borrowed(n: Int) -> String {
    match maybe(n) ?? make(0) {
        case x if n > 0 -> look(&x),
        case _ -> "other"
    }
}

func coalesce_guard_unused(n: Int) -> String {
