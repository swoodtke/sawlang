    match maybe(n)! {
        case "zz" -> "zz",
        case x -> take(move x)
    }
}

func force_literal_borrowed(n: Int) -> String {
    match maybe(n)! {
        case "zz" -> "zz",
        case x -> look(&x)
    }
}

func force_literal_unused(n: Int) -> String {
    match maybe(n)! {
        case "zz" -> "zz",
        case x -> "none"
    }
}

func force_guard_consumed(n: Int) -> String {
    match maybe(n)! {
        case x if n > 0 -> take(move x),
        case _ -> "other"
    }
}

func force_guard_borrowed(n: Int) -> String {
    match maybe(n)! {
        case x if n > 0 -> look(&x),
        case _ -> "other"
    }
}

func force_guard_unused(n: Int) -> String {
    match maybe(n)! {
        case x if n > 0 -> "none",
        case _ -> "other"
    }
}

func try_bare_consumed(n: Int) -> String {
    match try! fallible(n) {
        case x -> take(move x)
    }
}

func try_bare_borrowed(n: Int) -> String {
    match try! fallible(n) {
        case x -> look(&x)
    }
}

func try_bare_unused(n: Int) -> String {
    match try! fallible(n) {
        case x -> "none"
    }
}

func try_literal_consumed(n: Int) -> String {
    match try! fallible(n) {
        case "zz" -> "zz",
        case x -> take(move x)
    }
}

func try_literal_borrowed(n: Int) -> String {
    match try! fallible(n) {
        case "zz" -> "zz",
        case x -> look(&x)
    }
}

func try_literal_unused(n: Int) -> String {
