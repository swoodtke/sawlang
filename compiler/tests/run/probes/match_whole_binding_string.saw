func main() {
    print("call bare consumed {}", call_bare_consumed(1))
    print("call bare borrowed {}", call_bare_borrowed(2))
    print("call bare unused {}", call_bare_unused(3))
    print("call literal consumed {}", call_literal_consumed(4))
    print("call literal borrowed {}", call_literal_borrowed(5))
    print("call literal unused {}", call_literal_unused(6))
    print("call guard consumed {}", call_guard_consumed(7))
    print("call guard borrowed {}", call_guard_borrowed(8))
    print("call guard unused {}", call_guard_unused(9))
    print("move local bare consumed {}", move_local_bare_consumed(10))
    print("move local bare borrowed {}", move_local_bare_borrowed(11))
    print("move local bare unused {}", move_local_bare_unused(12))
    print("move local literal consumed {}", move_local_literal_consumed(13))
    print("move local literal borrowed {}", move_local_literal_borrowed(14))
    print("move local literal unused {}", move_local_literal_unused(15))
    print("move local guard consumed {}", move_local_guard_consumed(16))
    print("move local guard borrowed {}", move_local_guard_borrowed(17))
    print("move local guard unused {}", move_local_guard_unused(18))
    print("coalesce bare consumed {}", coalesce_bare_consumed(19))
    print("coalesce bare borrowed {}", coalesce_bare_borrowed(20))
    print("coalesce bare unused {}", coalesce_bare_unused(21))
    print("coalesce literal consumed {}", coalesce_literal_consumed(22))
    print("coalesce literal borrowed {}", coalesce_literal_borrowed(23))
    print("coalesce literal unused {}", coalesce_literal_unused(24))
    print("coalesce guard consumed {}", coalesce_guard_consumed(25))
    print("coalesce guard borrowed {}", coalesce_guard_borrowed(26))
    print("coalesce guard unused {}", coalesce_guard_unused(27))
    print("force bare consumed {}", force_bare_consumed(28))
    print("force bare borrowed {}", force_bare_borrowed(29))
    print("force bare unused {}", force_bare_unused(30))
    print("force literal consumed {}", force_literal_consumed(31))
    print("force literal borrowed {}", force_literal_borrowed(32))
    print("force literal unused {}", force_literal_unused(33))
    print("force guard consumed {}", force_guard_consumed(34))
    print("force guard borrowed {}", force_guard_borrowed(35))
    print("force guard unused {}", force_guard_unused(36))
    print("try bare consumed {}", try_bare_consumed(37))
    print("try bare borrowed {}", try_bare_borrowed(38))
    print("try bare unused {}", try_bare_unused(39))
    print("try literal consumed {}", try_literal_consumed(40))
    print("try literal borrowed {}", try_literal_borrowed(41))
    print("try literal unused {}", try_literal_unused(42))
    print("try guard consumed {}", try_guard_consumed(43))
    print("try guard borrowed {}", try_guard_borrowed(44))
    print("try guard unused {}", try_guard_unused(45))
}
