// probe: stated
// about: a local `var`'s `@align` reaches its slot, which its type alone would put on an 8-byte boundary (SL-801)
// stage 0: builds it and prints the same lines; a probe because the Linux Stage 0 records are v0.18.0's and cannot be recorded again from the VM
// speeds: -O0 -O2
// prints: 2
// prints: 0
func main() unsafe {
    @align(64)
    var b = 1
    b = b + 1
    print("{}", b)
    print("{}", ((&b) as UnsafePointer<Int> as Int) % 64)
}
