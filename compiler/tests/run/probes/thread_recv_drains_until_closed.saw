// probe: stated
// about: a `Thread.spawn` consumer drains a channel with a `while` over `Channel.recv()` that ends at `Err(Closed)` once the producer has closed it, and a `recv` after that reports `Closed` at once (SL-777)
// stage 0: refuses `try! Thread.spawn` at parse, and its `recv` returns the message itself, so the `Result` the loop matches on is not there (SL-765 Q1 (b), SL-777)
// speeds: -O0 -O2
// prints: drained 100 values, sum 5050
// prints: recv after the drain: channel is closed
// The consumer thread takes values until `recv` says the channel is closed
// and drained; the main thread produces 1..100 and closes. The sum of 1..100
// is 5050 whatever the interleaving.
import std.channel.{Channel}

func main() {
    let ch = try! Channel<Int>()
    var consumer = try! Thread.spawn { [ch] in
        var count = 0
        var sum = 0
        var going = true
        while going {
            match ch.recv() {
                case Ok(v) -> {
                    count = count + 1
                    sum = sum + v
                },
                case Err(_) -> {
                    going = false
                }
            }
        }
        (count, sum)
    }
    var i = 1
    while i <= 100 {
        try! ch.send(i)
        i = i + 1
    }
    try! ch.close()
    let totals = consumer.join()
    print("drained {} values, sum {}", totals.0, totals.1)
    match ch.recv() {
        case Ok(_) -> print("recv after the drain: a value"),
        case Err(e) -> print("recv after the drain: {e}")
    }
}
