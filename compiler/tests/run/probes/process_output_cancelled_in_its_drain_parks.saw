// probe: stated
// about: a task cancelled while `Command.output()` drains a silent child stays parked in the offloaded read until the child writes, so a sibling keeps ticking (SL-807)
// stage 0: its cancelled offload goes straight to the take, whose join of the read's thread blocks the executor's thread until the child writes (SL-807)
// speeds: -O0 -O2
// prints: the cancelled drain waited for the child: true
// prints: the sibling ticked through the drain: true
// prints: cancelled after the drain: true
// The child sleeps 200 ms before it writes, so the drain's offloaded read of
// its standard output waits that long; the cancel lands about 20 ms in.
import std.task.*
import std.process.{Command, CommandOutput}

extern "C" {
    func __saw_rt_clock_monotonic_nanos() -> Int64
}

static AT_LEAST_MS: Int = 150
static AT_LEAST_TICKS: Int = 10
static TICKS: Atomic<Int> = Atomic(0)
static AT_CANCEL: Atomic<Int> = Atomic(-1)
static STOP: Atomic<Int> = Atomic(0)

func now_ms() -> Int {
    (__saw_rt_clock_monotonic_nanos() / 1_000_000) as Int
}

func ticker() -> Int {
    while STOP.load() == 0 {
        sleep(Duration.ms(5))
        let _ = TICKS.fetch_add(1)
    }
    0
}

func drain() -> Int {
    var c = Command(program: "/bin/sh")
    try! c.arg("-c")
    try! c.arg("sleep 0.2; echo late")
    let start = now_ms()
    let failed = match c.output() {
        case Ok(_) -> 0,
        case Err(_) -> 1
    }
    let ms = now_ms() - start
    let ticks = TICKS.load() - AT_CANCEL.load()
    print("the cancelled drain waited for the child: {}", ms >= AT_LEAST_MS)
    print("the sibling ticked through the drain: {}", ticks >= AT_LEAST_TICKS)
    print("cancelled after the drain: {}", cancelled())
    failed
}

func main() {
    var g = TaskGroup()
    let t = g.spawn(ticker())
    let c = g.spawn(drain())
    sleep(Duration.ms(20))
    AT_CANCEL.store(TICKS.load())
    c.cancel()
    // A timer park, so `main` is not joining while `drain` waits.
    sleep(Duration.ms(400))
    let _ = c.join()
    STOP.store(1)
    let _ = t.join()
}
