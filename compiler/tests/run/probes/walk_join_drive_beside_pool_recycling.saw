// probe: stated
// about: the deadlock walk a cooperative task's join of a pool task makes while it drives the thread reads a sibling pool slot only under the pool's lock, while a worker completes that sibling and frees its cell, conformance row K192 (SL-808)
// stage 0: runs it alike, but on its own std's executor, so a recorded run says nothing about these walks (SL-808)
// speeds: -O0 -O2
// prints: total 19900
import std.channel.{Channel}

func relay(a: Channel<Int>, b: Channel<Int>) -> Int {
    let v = try! a.receive()
    try! b.send(v)
    0
}

func send_one(a: Channel<Int>, v: Int) -> Int {
    try! a.send(v)
    0
}

func recv_one(b: Channel<Int>) -> Int {
    try! b.receive()
}

func joiner(pool: &TaskGroup, a: Channel<Int>, b: Channel<Int>, c: Channel<Int>) -> Int {
    let _ = pool.spawn(relay(a, b))
    let h = pool.spawn(recv_one(c))
    h.join()
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    var group = TaskGroup()
    var total = 0
    var i = 0
    while i < 200 {
        let a = try! Channel<Int>()
        let b = try! Channel<Int>()
        let c = try! Channel<Int>()
        let j = group.spawn(joiner(&pool, a, b, c))
        let s = group.spawn(send_one(a, i))
        let r = group.spawn(relay(b, c))
        total = total + j.join()
        let _ = s.join()
        let _ = r.join()
        i = i + 1
    }
    print("total {}", total)
}
