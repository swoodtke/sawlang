// probe: link-fails
// about: a normal build defines no symbol for an `@export` written after `@test` (SL-631)
// stage 0: cannot parse `@test`
// speeds: -O0
// A normal build emits no test-only declaration (SL:testing), so an `@export`
// written after `@test` defines no symbol, and production code calling it
// through `extern "C"` fails to link, with no refusal printed.
// undefined: c631_leak

extern "C" {
    func c631_leak() -> Int32
}

@test
@export("c631_leak") func leak() -> Int32 { 7 }

func main() {
    print("{}", c631_leak())
}
