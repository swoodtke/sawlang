// probe: stated
// about: a `Thread.join()` made by a suspending `main` inside a drive one or two above a subject's, whose thread receives what the subject's continuation sends, parks rather than nesting a drive, so it finishes, with no sibling, a ticking, a sleeping or a cancelled one, conformance row K200 (SL-809)
// stage 0: runs it on its own std's executor, which this check is not part of (SL-809)
// speeds: -O0 -O2
// prints: leaf done
// prints: d1 none 6
// prints: leaf done
// prints: d1 ticking 6
// prints: leaf done
// prints: d1 sleeping 6
// prints: leaf done
// prints: d1 cancelled 6
// prints: leaf done
// prints: d2 none 8
// prints: leaf done
// prints: d2 ticking 8
// prints: leaf done
// prints: d2 sleeping 8
// prints: leaf done
// prints: d2 cancelled 8
import std.task.*
import std.channel.{Channel}

func leaf() -> Int {
    sleep(Duration.ms(50))
    print("leaf done")
    1
}

func mid0() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(leaf())
    h.join() + 1
}

func mid1() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid0())
    h.join() + 1
}

func mid2() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid1())
    h.join() + 1
}

func ticker() -> Int {
    while not cancelled() {
        sleep(Duration.ms(1))
    }
    0
}

func sleeper() -> Int {
    sleep(Duration.secs(3600))
    0
}

func sends1(ch: Channel<Int>) -> Int {
    let v = mid1()
    try! ch.send(v)
    v
}

func sends2(ch: Channel<Int>) -> Int {
    let v = mid2()
    try! ch.send(v)
    v
}

func thread_receive(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func cell_d1_none() -> Int {
    let ch = try! Channel<Int>()
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    v
}

func cell_d1_ticking() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(ticker())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d1_sleeping() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d1_cancelled() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    sleep(Duration.ms(10))
    s.cancel()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    let _ = s.join()
    v
}

func cell_d2_none() -> Int {
    let ch = try! Channel<Int>()
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    v
}

func cell_d2_ticking() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(ticker())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d2_sleeping() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    sleep(Duration.ms(10))
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d2_cancelled() -> Int {
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    sleep(Duration.ms(10))
    s.cancel()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    let v = th.join() + h.join()
    let _ = s.join()
    v
}

func main() {
    print("d1 none {}", cell_d1_none())
    print("d1 ticking {}", cell_d1_ticking())
    print("d1 sleeping {}", cell_d1_sleeping())
    print("d1 cancelled {}", cell_d1_cancelled())
    print("d2 none {}", cell_d2_none())
    print("d2 ticking {}", cell_d2_ticking())
    print("d2 sleeping {}", cell_d2_sleeping())
    print("d2 cancelled {}", cell_d2_cancelled())
}
