// probe: stated
// about: a `Thread.join()` made by a suspending `main` inside a drive one or two above a subject's, whose thread receives what the subject's continuation sends, parks rather than nesting a drive, so it finishes, with no sibling, a ticking, a sleeping or a cancelled one, conformance row K200 (SL-809)
// stage 0: runs it on its own std's executor, which this check is not part of (SL-809)
// speeds: -O0 -O2
// prints: leaf done
// prints: d1 none 6
// prints: leaf done
// prints: d1 ticking 6
// prints: leaf done
// prints: d1 sleeping 6
// prints: leaf done
// prints: d1 cancelled 6
// prints: leaf done
// prints: d2 none 8
// prints: leaf done
// prints: d2 ticking 8
// prints: leaf done
// prints: d2 sleeping 8
// prints: leaf done
// prints: d2 cancelled 8
// Each cell waits until its leaf reports that it is waiting, so the subject's
// drive resumes the cell; the leaf holds until the cell releases it just before
// the join, so no timer decides which of the two moves first.
import std.task.*
import std.channel.{Channel}

// The gates the test owns, re-armed by each cell. The 1ms tick paces each poll
// and decides nothing; the 10s deadline bounds only genuine breakage
// (TESTING.md, "Waiting in a multi-threaded test").
static ARRIVED: Atomic<Int> = Atomic(0)
static RELEASED: Atomic<Int> = Atomic(0)
static POLL_TICK_MS: UInt64 = 1
static POLL_DEADLINE_TICKS: Int = 10000

func leaf() -> Int {
    ARRIVED.store(1)
    var ticks = 0
    while RELEASED.load() == 0 {
        if ticks >= POLL_DEADLINE_TICKS {
            panic("leaf: the cell never released it")
        }
        sleep(Duration.ms(POLL_TICK_MS))
        ticks = ticks + 1
    }
    print("leaf done")
    1
}

// The previous cell joined its subject, so its leaf has finished with both
// gates.
func arm_the_gates() {
    ARRIVED.store(0)
    RELEASED.store(0)
}

func await_the_leaf() {
    var ticks = 0
    while ARRIVED.load() == 0 {
        if ticks >= POLL_DEADLINE_TICKS {
            panic("cell: the leaf never reached its wait")
        }
        sleep(Duration.ms(POLL_TICK_MS))
        ticks = ticks + 1
    }
}

func mid0() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(leaf())
    h.join() + 1
}

func mid1() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid0())
    h.join() + 1
}

func mid2() -> Int {
    var inner = TaskGroup()
    let h = inner.spawn(mid1())
    h.join() + 1
}

func ticker() -> Int {
    while not cancelled() {
        sleep(Duration.ms(1))
    }
    0
}

func sleeper() -> Int {
    sleep(Duration.secs(3600))
    0
}

func sends1(ch: Channel<Int>) -> Int {
    let v = mid1()
    try! ch.send(v)
    v
}

func sends2(ch: Channel<Int>) -> Int {
    let v = mid2()
    try! ch.send(v)
    v
}

func thread_receive(ch: Channel<Int>) -> Int {
    try! ch.receive()
}

func cell_d1_none() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    v
}

func cell_d1_ticking() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(ticker())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d1_sleeping() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d1_cancelled() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends1(ch))
    await_the_leaf()
    s.cancel()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    let _ = s.join()
    v
}

func cell_d2_none() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    v
}

func cell_d2_ticking() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(ticker())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d2_sleeping() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    await_the_leaf()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    s.cancel()
    let _ = s.join()
    v
}

func cell_d2_cancelled() -> Int {
    arm_the_gates()
    let ch = try! Channel<Int>()
    var gs = TaskGroup()
    let s = gs.spawn(sleeper())
    var gj = TaskGroup()
    let h = gj.spawn(sends2(ch))
    await_the_leaf()
    s.cancel()
    var th = try! Thread.spawn { [ch] in thread_receive(ch) }
    RELEASED.store(1)
    let v = th.join() + h.join()
    let _ = s.join()
    v
}

func main() {
    print("d1 none {}", cell_d1_none())
    print("d1 ticking {}", cell_d1_ticking())
    print("d1 sleeping {}", cell_d1_sleeping())
    print("d1 cancelled {}", cell_d1_cancelled())
    print("d2 none {}", cell_d2_none())
    print("d2 ticking {}", cell_d2_ticking())
    print("d2 sleeping {}", cell_d2_sleeping())
    print("d2 cancelled {}", cell_d2_cancelled())
}
