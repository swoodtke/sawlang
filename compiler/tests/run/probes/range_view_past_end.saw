// probe: panics
// about: a range view past its base's end panics at the subscript's line, naming the range and the length (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6)
// speeds: -O0 -O2
// panics: slice: range out of range: 1..5 (len 3)
func bound(n: Int) -> Int { n }

func main() {
    let a: [Int; 3] = [1, 2, 3]
    borrow let s = a[1..bound(5)] { print(s.len()) }
}
