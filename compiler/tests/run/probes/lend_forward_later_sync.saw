// probe: stated
// about: a `borrows(sync)` accessor forwarding its lend to a later one (SL-1173)
// stage 0: has no `lend`-forwarding accessors to compare against; the expectation is the spec's
// speeds: -O0 -O2
// prints: 7
// Both accessors are `borrows(sync)`.

struct Inner {
    n: Int
}
struct Outer {
    inner: Inner
}
extension Outer {
    func outer_view(&self) borrows(sync) -> &Inner { lend self.inner_view() }
    func inner_view(&self) borrows(sync) -> &Inner { lend self.inner }
}
func main() {
    let o = Outer(inner: Inner(n: 7))
    print(o.outer_view().n)
}
