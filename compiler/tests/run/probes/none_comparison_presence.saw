import std.task.*

// No `Equatable` at all.
struct Plain {
    s: String
}

enum Opaque {
    case Some(n: Int),
    case Other
}

// A derived `Equatable` over a member that does not conform, at a field and
// at a case's payload: nothing here reaches it.
struct Holder {
    x: Opaque
}

@synthesize
extension Holder: Equatable {}

enum Boxed {
    case Full(x: Opaque),
    case Empty
}

@synthesize
extension Boxed: Equatable {}

struct Res {
    id: Int
}

extension Res: NoCopy {
    func deinit(&var self) {
        print("drop res {}", self.id)
    }
}

// A copy would print.
struct Dup {
    id: Int
}

extension Dup: ExplicitCopy {
    func copy(&self) -> Dup {
        print("copy dup {}", self.id)
        Dup(id: self.id)
    }

    func deinit(&var self) {
        print("drop dup {}", self.id)
    }
}

struct Field<T> {
    f: T?
}

extension Field<T>: NoCopy {}

func give<T>(v: T?) -> T? {
    v
}

func slow<T>(v: T?) -> T? {
    yield_now()
    v
}

func generic_row<T>(label: String, x: &T?, y: &T?) {
    print("{} {} {} {} {} | {} {} {} {}", label, x == None, x != None, None == x, None != x,
          y == None, y != None, None == y, None != y)
}

func row_local_int() {
    let x: Int? = 5
    let y: Int? = None
    print("local int {} {} {} {} | {} {} {} {}", x == None, x != None, None == x, None != x, y == None, y != None, None == y, None != y)
}

func row_local_plain() {
    let x: Plain? = Plain(s: "p")
    let y: Plain? = None
    print("local plain {} {} {} {} | {} {} {} {}", x == None, x != None, None == x, None != x, y == None, y != None, None == y, None != y)
    print("  after {}", x!.s)
}

