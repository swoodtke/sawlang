func positions_local() {
    let x: Res? = Res(id: 41)
    let y: Res? = None
    var i = false
    if x == None {
        i = false
    } else {
        i = true
    }
    var w = false
    while x != None {
        w = true
        break
    }
    guard x != None else {
        print("local positions: guard failed")
        return
    }
    let b = x == None
    print("local positions {} {} {} {}", i, w, b, true && x != None)
    print("  after {}", x!.id)
}

