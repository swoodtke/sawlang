// probe: stated
// about: comparing an Optional with the `None` literal (`x == None`, `x != None`, `None == x`, `None != x`) is a presence test: it needs no `Equatable` on the payload, reads the tag alone, and neither copies nor moves the payload, on every spelling of `x` (SL-945)
// stage 0: refuses a `borrows` call written without `borrow`
// speeds: -O0 -O2
// leaks: none
// prints: local int false true false true | true false true false
// prints: local plain false true false true | true false true false
// prints:   after p
// prints: local unmet false true false true | true false true false
// prints: local nocopy false true false true | true false true false
// prints:   after 4
// prints: drop res 4
// prints: local explicit false true false true | true false true false
// prints:   after 5
// prints: drop dup 5
// prints: field int false true false true | true false true false
// prints: field plain false true false true | true false true false
// prints:   after p
// prints: field unmet false true false true | true false true false
// prints: field nocopy false true false true | true false true false
// prints:   after 9
// prints: drop res 9
// prints: field explicit false true false true | true false true false
// prints:   after 10
// prints: drop dup 10
// prints: call int false true false true | true false true false
// prints: call plain false true false true | true false true false
// prints: call unmet false true false true | true false true false
// prints: call nocopy false true false true | true false true false
// prints: drop res 14
// prints: drop res 14
// prints: drop res 14
// prints: drop res 14
// prints: call explicit false true false true | true false true false
// prints: drop dup 15
// prints: drop dup 15
// prints: drop dup 15
// prints: drop dup 15
// prints: lend int false true false true | true false true false
// prints: lend plain false true false true | true false true false
// prints:   after p
// prints: lend unmet false true false true | true false true false
// prints: lend nocopy false true false true | true false true false
// prints:   after 19
// prints: drop res 19
// prints: lend explicit false true false true | true false true false
// prints:   after 20
// prints: drop dup 20
// prints: chain int false true false true | true false true false
// prints: chain plain false true false true | true false true false
// prints:   after p
// prints: chain unmet false true false true | true false true false
// prints: chain nocopy false true false true | true false true false
// prints:   after 24
// prints: drop res 24
// prints: chain explicit false true false true | true false true false
// prints:   after 25
// prints: drop dup 25
// prints: nested int false true false true | true false true false
// prints: nested plain false true false true | true false true false
// prints: nested unmet false true false true | true false true false
// prints: nested nocopy false true false true | true false true false
// prints: nested explicit false true false true | true false true false
// prints: generic int false true false true | true false true false
// prints: generic plain false true false true | true false true false
// prints:   after p
// prints: generic unmet false true false true | true false true false
// prints: generic nocopy false true false true | true false true false
// prints:   after 34
// prints: drop res 34
// prints: generic explicit false true false true | true false true false
// prints:   after 35
// prints: drop dup 35
// prints: suspend int false true false true | true false true false
// prints: suspend plain false true false true | true false true false
// prints: suspend unmet false true false true | true false true false
// prints: suspend nocopy false true false true | true false true false
// prints: drop res 39
// prints: drop res 39
// prints: drop res 39
// prints: drop res 39
// prints: suspend explicit false true false true | true false true false
// prints: drop dup 40
// prints: drop dup 40
