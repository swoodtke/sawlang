// probe: stated
// about: a `main() -> Result<Void, Box<any Error>>` returning an `Err` whose rendering is 5,000 bytes writes the whole error on standard error, its last bytes included, and exits 1 (SL-1120)
// stage 0: writes the error on standard output, where sawc writes standard error
// speeds: -O0 -O2
// prints: start
// exits: 1
// stderr: error: --- END --
// leaks: none

struct Failure {
    message: String
}

extension Failure: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.message)
    }
}

extension Failure: Error {}

// 4,990 digits, then a marker, so a cut shows where it fell.
func long_message() -> String {
    var b = StringBuilder()
    var i = 0
    while i < 499 {
        try! b.append("0123456789")
        i = i + 1
    }
    try! b.append("--- END --")
    return b.build()
}

func main() -> Result<Void, Box<any Error>> {
    print("start")
    return Failure(message: long_message())
}
