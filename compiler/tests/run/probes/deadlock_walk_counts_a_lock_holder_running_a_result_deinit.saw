// probe: stated
// about: a blocking `main` whose lock window waits in place while a finished task's unclaimed result runs a slow deinit, beside a `Thread.spawn` body blocked on the lock that then sends to a pool task, completes and is never reported, conformance row K206 (SL-1161)
// stage 0: runs it on its own std's executor, which this rule is not part of
// speeds: -O0 -O2
// prints: total 101 got 7
// A live program. A `blocking` `main` (thread context, no frame of its own)
// holds a Mutex window, and inside it a `sync` helper drops a cooperative
// group, so `main` waits in place: its record counts as waiting and no slot
// of its is active. The group's one task finishes with an unclaimed result
// whose deinit computes for a while; the executor drops it in `retire`, after
// the slot went inactive. Meanwhile a Thread.spawn body waits for the lock
// and then sends to a pool task parked on a receive, whose worker walks. Once
// the deinit ends, the teardown returns, the window closes, the locker sends
// and the pool task receives.
import std.channel.{Channel}
import std.mutex.{Mutex}
import std.thread.{Thread}
import std.task.*

static M: Mutex<Int>
static OPEN: Atomic<Int> = Atomic(0)
static READY: Atomic<Int> = Atomic(0)
static SPIN: Atomic<Int> = Atomic(0)
static PAUSE: Atomic<Int> = Atomic(0)
static GOT: Atomic<Int> = Atomic(0)

struct Slow {
    n: Int
}

extension Slow: NoCopy {
    func deinit(&var self) {
        while SPIN.fetch_add(1) < 40_000_000 { }
    }
}

func make_slow() -> Slow {
    yield_now()
    Slow(n: 1)
}

func drop_inside() sync -> Int {
    var g = TaskGroup()
    let h = g.spawn(make_slow())
    0
}

func take_one(ch: Channel<Int>) -> Int {
    READY.store(1)
    GOT.store(try! ch.receive())
    0
}

func locker(ch: Channel<Int>) {
    while OPEN.load() == 0 { }
    borrow var m = M.lock() { m = m + 1 }
    try! ch.send(7)
}

func main() blocking {
    let ch = try! Channel<Int>()
    var pool = try! TaskGroup(threads: 2)
    let h = pool.spawn(take_one(ch.copy()))
    let c = ch.copy()
    var t = try! Thread.spawn { [c] in locker(c) }
    while READY.load() == 0 { }
    while PAUSE.fetch_add(1) < 2_000_000 { }
    borrow var m = M.lock() {
        OPEN.store(1)
        m = m + 100 + drop_inside()
    }
    let _ = h.join()
    t.join()
    print("total {} got {}", M.get(), GOT.load())
}
