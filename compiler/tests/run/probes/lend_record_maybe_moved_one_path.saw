// probe: stated
// about: one local declared before two `lend` sites, maybe moved on site 0's path (a drop flag) and whole at site 1, is read after site 1's `lend` as a plain load, never as maybe moved (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: sink t1
// prints: drop t1
// prints: epi 0
// prints: tail
// prints: epi 0
// prints: tail
// prints: drop t1
// prints: epi 1 1
// prints: tail
// prints: drop t1
// prints: a 2 b 2
import std.task.*

struct Tag {
    id: Int
}

extension Tag: NoCopy {
    func deinit(&var self) {
        print("drop t{}", self.id)
    }
}

func sink(t: Tag) {
    print("sink t{}", t.id)
}

struct Two {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two: NoCopy {}

extension Two {
    func pick(&var self, first: Bool, c: Bool, i: Int) borrows -> &var Int {
        let t = Tag(id: 1)
        if first {
            if c {
                sink(move t)
            }
            yield_now()
            lend self.a[i]
            print("epi 0")
        } else {
            yield_now()
            lend self.b[i]
            print("epi 1 {}", t.id)
        }
        print("tail")
    }
}

func main() {
    var s = Two(a: [0], b: [0])
    borrow var s.pick(true, true, 0) += 1
    borrow var s.pick(true, false, 0) += 1
    borrow var s.pick(false, false, 0) += 2
    print("a {} b {}", s.a[0], s.b[0])
}
