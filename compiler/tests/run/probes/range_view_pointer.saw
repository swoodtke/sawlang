// probe: stated
// about: a raw pointer's range views, `p[a..b]`, `p[..b]`, `p[..=b]` and `p[a..=b]`, read and written in an unsafe function (SL-988)
// stage 0: not run; v0.18.0's spec calls range views planned, so the probe states the spec's answers (SL:borrowing §6, §7)
// speeds: -O0 -O2
// prints: 5
// prints: 3
// prints: 6
// prints: 7
// prints: 40
func total(s: &[Int]) -> Int {
    var sum = 0
    var i = 0
    while i < s.len() {
        sum += s[i]
        i += 1
    }
    sum
}

func run(p: UnsafePointer<Int>) unsafe {
    print(total(&p[1..3]))
    print(total(&p[..2]))
    print(total(&p[..=2]))
    print(total(&p[2..=3]))
    p[0..4][3] = 40
}

func main() unsafe {
    var a: [Int; 4] = [1, 2, 3, 4]
    run((&a) as UnsafePointer<Int>)
    print(a[3])
}
