// probe: stated
// about: an exclusive borrowing struct's window across a suspension: the frame holds the struct and its `&var` field, and a spawned task walks its own root (SL-871)
// stage 0: refuses a `&var` field of a borrowing struct (K145)
// speeds: -O0 -O2
// leaks: none
// prints: cells deinit at 3
// prints: walk = 36
// prints: after = 11 1
// prints: cells deinit at 2
// prints: grid deinit, visits 1
// prints: local = 18
// prints: cells deinit at 2
// prints: grid deinit, visits 1
// prints: task = 18
// prints: grid deinit, visits 1
// Spec-derived expectation (no oracle): the window spans each `yield_now`,
// so the struct lives in the frame, and every `next` writes 10 more into the
// cell it hands out through the `&var` field. The struct's `deinit` runs
// before the window closes. A root that is the frame's own local is read
// after its loop: 15 + 16, less `own.cells[0]` (15), plus twice its one
// visit, is 18, in `main` and in a spawned task.

import std.task.*

struct Grid {
    cells: Vector<Int>
    visits: Int
}

extension Grid: NoCopy {
    func deinit(&var self) { print("grid deinit, visits {}", self.visits) }
}

borrows struct Cells {
    grid: &var Grid,
    index: Int
}

extension Cells: NoCopy {
    func deinit(&var self) {
        self.grid.visits = self.grid.visits + 1
        print("cells deinit at {}", self.index)
    }
}

extension Cells: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.index >= self.grid.cells.len() {
            return None
        }
        let i = self.index
        self.index = i + 1
        self.grid.cells[i] = self.grid.cells[i] + 10
        self.grid.cells[i]
    }
}

extension Grid {
    func cells(&var self) borrows -> Cells {
        Cells(grid: lends self, index: 0)
    }
}

func walk(g: &var Grid) -> Int {
    var t = 0
    for c in g.cells() {
        yield_now()
        t = t + c
    }
    t
}

func local_root() -> Int {
    var own = Grid(cells: [5, 6], visits: 0)
    var t = 0
    for c in own.cells() {
        yield_now()
        t = t + c
    }
    t - own.cells[0] + own.visits * 2
}

func main() {
    var g = Grid(cells: [1, 2, 3], visits: 0)
    print("walk = {}", walk(&var g))
    print("after = {} {}", g.cells[0], g.visits)
    print("local = {}", local_root())
    let task = Task.spawn(local_root())
    print("task = {}", task.join())
}
