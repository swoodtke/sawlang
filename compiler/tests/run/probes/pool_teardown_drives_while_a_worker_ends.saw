// probe: stated
// about: a `TaskGroup(threads: 2)` worker leaves a detached background task joining a thread that waits on a pipe, and the pool is torn down inside a cooperative task while a sibling ticks; the worker's end waits on that join, and the teardown drives the thread's tasks until the worker has ended, so the sibling keeps ticking, conformance row K188 (SL-806)
// stage 0: keeps one process-wide background group, which the worker never closes (SL-797)
// speeds: -O0 -O2
// prints: the teardown waited for the worker: true
// prints: the sibling ticked through the teardown: true
// The joined thread waits in `poll` on a pipe that only the sibling writes
// to, once the owner has begun the teardown. So the thread ends only by that
// byte, and the teardown ends only after the thread, which proves the
// sibling ran during the teardown. A teardown that blocked the executor's
// thread would leave the thread's `poll` to its 10 s timeout.
import std.task.*

struct PollFd { fd: Int32, events: Int16, revents: Int16 }

extern "C" {
    func pipe(ends: UnsafePointer<Int32>) -> Int32
    func write(fd: Int32, bytes: UnsafePointer<UInt8>, count: Int) -> Int
    // `nfds_t` is 32 bits on macOS and 64 on Linux; a word carries either.
    blocking func poll(fds: UnsafePointer<PollFd>, count: UInt, timeout_ms: Int32) -> Int32
}

static POLLIN: Int16 = 1
static NAP_TIMEOUT_MS: Int32 = 10_000
static READ_END: Atomic<Int> = Atomic(-1)
static WRITE_END: Atomic<Int> = Atomic(-1)
static TEARDOWN: Atomic<Int> = Atomic(0)
static FED: Atomic<Int> = Atomic(0)
static NAPPED: Atomic<Int> = Atomic(0)
static STOP: Atomic<Int> = Atomic(0)

func make_pipe() unsafe {
    var ends: [Int32; 2] = [0; 2]
    if pipe((&ends) as UnsafePointer<Int32>) != 0 {
        panic("pipe(2) failed")
    }
    READ_END.store(ends[0] as Int)
    WRITE_END.store(ends[1] as Int)
}

func feed() unsafe {
    var byte: [UInt8; 1] = [1; 1]
    if write(WRITE_END.load() as Int32, (&byte) as UnsafePointer<UInt8>, 1) != 1 {
        panic("write(2) to the pipe failed")
    }
}

// Blocks the calling thread until the sibling's byte arrives.
func nap() unsafe -> Int {
    var watched = PollFd(fd: READ_END.load() as Int32, events: POLLIN, revents: 0)
    if poll((&watched) as UnsafePointer<PollFd>, 1, NAP_TIMEOUT_MS) == 0 {
        panic("the sibling's byte never reached the napping thread within 10 s")
    }
    NAPPED.store(1)
    7
}

func join_sleeper() -> Int {
    var sleeper = try! Thread.spawn { nap() }
    sleeper.join()
}

func leave_one() -> Int {
    let h = Task.spawn(join_sleeper())
    h.detach()
    1
}

func ticker() -> Int {
    while STOP.load() == 0 {
        sleep(Duration.ms(5))
        if TEARDOWN.load() == 1 && FED.load() == 0 {
            FED.store(1)
            feed()
        }
    }
    0
}

func pool_scope() -> Int {
    var pool = try! TaskGroup(threads: 2)
    let a = pool.spawn(leave_one())
    let r = a.join()
    // Nothing suspends between this store and the pool's teardown.
    TEARDOWN.store(1)
    r
}

func owner() -> Int {
    let r = pool_scope()
    print("the teardown waited for the worker: {}", NAPPED.load() == 1)
    print("the sibling ticked through the teardown: {}", FED.load() == 1)
    r
}

func main() {
    make_pipe()
    var g = TaskGroup()
    let t = g.spawn(ticker())
    let o = g.spawn(owner())
    let _ = o.join()
    STOP.store(1)
    let _ = t.join()
}
