// probe: stated
// about: a sync `main() -> Result<Int, Box<any Error>>` that returns an `Err`, its error a struct owning a `String` boxed as `Box<any Error>`, writes `error: ` and the rendered error on standard error and exits 1 (SL-874)
// stage 0: writes the error on standard output, where sawc writes standard error
// speeds: -O0 -O2
// prints: start
// exits: 1
// stderr: error: no such shelf: top
// leaks: none

struct Missing {
    shelf: String
}

extension Missing: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("no such shelf: ")
        try! into.append(self.shelf)
    }
}

extension Missing: Error {}

func main() -> Result<Int, Box<any Error>> {
    print("start")
    return Missing(shelf: "top")
}
