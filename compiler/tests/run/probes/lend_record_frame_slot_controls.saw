// probe: stated
// about: two-site accessors whose locals are or are not held across a suspension inside the accessor, lending a `Vector.[]` place or a field, from statement and block windows, the reviewer's three shapes and the variants between them and the faulting cells: each site reads back only its own local (SL-873)
// stage 0: cannot parse a `borrow` statement or block
// speeds: -O0 -O2
// leaks: none
// prints: case air1_statement
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case air2_block_yield
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case air3_both_top_yield
// prints: 11
// prints: 22
// prints: 11
// prints: 22
// prints: a 2 b 4
// prints: case v_both_branch_yields
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case v_holder0_yield_only
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case v_holder1_yield_only
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case v_top_and_branch1
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case v_h0_yield_site0
// prints: 11
// prints: e1
// prints: a 1 b 2
// prints: case v_h0_yield_site1
// prints: 11
// prints: e1
// prints: a 1 b 2
// prints: case f_both_branch_yields
// prints: 11
// prints: 22
// prints: a 1 b 2
// prints: case f_holder0_yield_only
// prints: 11
// prints: 22
// prints: a 1 b 2
import std.task.*

struct Two0 {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two0: NoCopy {}

extension Two0 {
    func pick(&var self, first: Bool) borrows -> &var Int {
        if first {
            let x = 11
            lend self.a[0]
            print("{}", x)
        } else {
            let y = 22
            lend self.b[0]
            print("{}", y)
        }
    }
}

func run_air1_statement() {
    print("case air1_statement")
    var s = Two0(a: [0], b: [0])
    yield_now()
    s.pick(true) += 1
    s.pick(false) += 2
    print("a {} b {}", s.a[0], s.b[0])
}

struct Two1 {
    a: Vector<Int>
    b: Vector<Int>
}

extension Two1: NoCopy {}

extension Two1 {
    func pick(&var self, first: Bool) borrows -> &var Int {
        if first {
