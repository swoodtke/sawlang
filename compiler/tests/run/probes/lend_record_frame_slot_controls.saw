func run_air3_both_top_yield() {
    print("case air3_both_top_yield")
    var s = Two2(a: [0], b: [0])
    yield_now()
    s.pick(true) += 1
    s.pick(false) += 2
    borrow var p = s.pick(true) {
        yield_now()
        p += 1
    }
    borrow var q = s.pick(false) {
        yield_now()
        q += 2
    }
    print("a {} b {}", s.a[0], s.b[0])
}

