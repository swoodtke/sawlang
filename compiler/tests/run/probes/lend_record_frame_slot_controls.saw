func run_air2_block_yield() {
    print("case air2_block_yield")
    var s = Two1(a: [0], b: [0])
    yield_now()
    borrow var p = s.pick(true) {
        yield_now()
        p += 1
    }
    borrow var q = s.pick(false) {
        yield_now()
        q += 2
    }
    print("a {} b {}", s.a[0], s.b[0])
}

