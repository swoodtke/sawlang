// probe: stated
// about: a generic `deinit` and a std `Vector<T, A>` over a type parameter whose requirement opens no window are drops inside a held window on a static root, and the window's value survives them (SL-1156)
// stage 0: cannot parse `borrows(ROOT)`
// speeds: -O0 -O2
// leaks: none
// prints: made 1
// prints: tag after scope drop 7
// prints: tag after vector drop 7
struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

trait Cleanup {
    func cleanup(&self)
}

struct Quiet {
    n: Int
}

extension Quiet: Cleanup {
    func cleanup(&self) {
        let _n = self.n
    }
}

struct W<T: Cleanup> {
    t: T
}

extension W<T: Cleanup>: NoCopy {
    func deinit(&var self) {
        self.t.cleanup()
    }
}

struct QuietHeap {
}

extension QuietHeap: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        GlobalAllocator().alloc(size, align)
    }

    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func sink(v: Vector<Int, QuietHeap>) -> Int {
    v.len()
}

func main() {
    var v = Vector<Int, QuietHeap>()
    try! v.push(1)
    borrow var b = boot_slot() {
        b.tag = 7
        if b.tag == 7 {
            let w = W(t: Quiet(n: 1))
            print("made {}", w.t.n)
        }
        print("tag after scope drop {}", b.tag)
        let n = sink(move v)
        print("tag after vector drop {}", b.tag + n - 1)
    }
}
