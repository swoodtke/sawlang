// probe: panics
// about: a task inside the drive of a `Thread.join` in thread context (`waits_drive`) that drove a call to its end and waits in a join of a task that panics dumps only its live frames, never the returned drive's released slot (SL-863)
// stage 0: runs it on its own std's executor, whose task dump this does not pin (SL-863)
// speeds: -O0 -O2
// prints: saw tasks: 2 live (unsynchronized snapshot)
// prints:   task group 1 slot 0 gen 1 running
// prints:     at running_task_dump_joined_panics_drive.saw:27 in panicker
// prints:   task group 2 slot 0 gen 1 running
// prints:     at running_task_dump_joined_panics_drive.saw:49 in p
// panics: the joined task panics
import std.task.*

extern "C" {
    func __saw_rt_sleep_ns(ns: UInt64)
}

static HOLD_NANOS: UInt64 = 300_000_000

// A suspending call the task drives as a sub-frame of its own.
func child(i: Int) -> Int {
    yield_now()
    i + 1
}

// Panics while the task that spawned it waits in its join.
func panicker(i: Int) -> Int {
    yield_now()
    dump_tasks()
    if i >= 0 {
        panic("the joined task panics {}", i)
    }
    i
}

func hold() -> Int {
    __saw_rt_sleep_ns(HOLD_NANOS)
    7
}

// A blocking wait for a thread, in thread context: the join drives the
// group, so `p` runs inside that drive while the thread sleeps, and `main`
// never suspends.
func wait_for_thread() blocking -> Int {
    var t = try! Thread.spawn { hold() }
    t.join()
}

func p(i: Int) -> Int {
    let v = child(i)
    let h = Task.spawn(panicker(v))
    h.join()
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(p(1))
    print("T {}", wait_for_thread())
    print("P {}", h.join())
}
