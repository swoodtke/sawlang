// probe: panics
// about: a `TaskGroup(threads: 2)` teardown made by a `sync` helper under a suspending `main` with no cooperative task on its thread, waiting for a pool task that receives from a channel nothing sends to, is reported by the deadlock walk, conformance row K205 (SL-821)
// stage 0: runs it on its own std's executor, which this rule is not part of (SL-821)
// speeds: -O0 -O2
// panics: deadlock: every task is waiting to receive from a channel, or to join a `TaskGroup(threads:)` task that is, and nothing in this program can send. A join or a pool's teardown made inside a task, or on a thread that has tasks of its own, runs that thread's other tasks until it returns
import std.task.*
import std.channel.{Channel}

func relay(ch: Channel<Int>, out: Channel<Int>) {
    let v = try! ch.receive()
    try! out.send(v)
}

// The pool is torn down at this function's end.
func run_pool(ch: Channel<Int>, out: Channel<Int>) {
    var pool = try! TaskGroup(threads: 2)
    let p = pool.spawn(relay(ch, out))
}

// What the pool's task relayed, read once the pool is torn down.
func tear_down_pool(ch: Channel<Int>) -> Int {
    let out = try! Channel<Int>()
    run_pool(ch, out)
    (try! out.try_receive())!
}

func helper() sync -> Int {
    let ch = try! Channel<Int>()
    let v = tear_down_pool(ch)
    v
}

func main() {
    yield_now()
    print("done {}", helper())
}
