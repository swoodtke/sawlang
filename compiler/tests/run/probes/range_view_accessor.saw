// probe: stated
// about: a user `borrows -> &var [T]` range accessor lending `p[a..b]` or a view of its own field, and its `@synthesize(shared)` twin lending `&[T]`, through named and unnamed lends, a write, a shared root and `.copy()` (SL-988)
// stage 0: not run; v0.18.0's spec calls slice lends planned, so the probe states the spec's answers (SL:borrowing §4, §6)
// speeds: -O0 -O2
// prints: 3 9
// prints: 24
// prints: 20 50 84
// prints: 21
// prints: 3 b e z
// leaks: none
struct Ring {
    store: [Int; 6]
}

extension Ring {
    func base(&self) unsafe -> UnsafePointer<Int> {
        (&self.store) as UnsafePointer<Int>
    }

    /// Lends the elements in `range` where they sit.
    @synthesize(shared)
    func [](&var self, range: Range) unsafe borrows -> &var [Int] {
        if range.current < 0 || range.end > 6 || range.current > range.end {
            panic("Ring.[]: range out of range: {}..{} (len 6)", range.current, range.end)
        }
        lend self.base()[range.current..range.end]
    }
}

struct Names {
    store: [String; 4]
}

extension Names {
    @synthesize(shared)
    func [](&var self, range: Range) borrows -> &var [String] {
        lend self.store[range.current..range.end]
    }
}

func total(s: &[Int]) -> Int {
    var sum = 0
    var i = 0
    while i < s.len() {
        sum += s[i]
        i += 1
    }
    sum
}

func main() {
    var r = Ring(store: [1, 2, 3, 4, 5, 6])
    borrow let s = r[1..4] { print("{} {}", s.len(), total(&s)) }
    borrow var w = r[0..2] { w[1] = 20 }
    print(total(&r[0..3]))
    r[4..6][0] = 50
    print("{} {} {}", r.store[1], r.store[4], total(&r[0..6]))
    let k = Ring(store: [7, 7, 7, 7, 7, 7])
    print(total(&k[2..5]))
    var n = Names(store: ["a", "b", "c", "d"])
    var c = n[1..3].copy()
    try! c.push("e")
    n[0..1][0] = "z"
    print("{} {} {} {}", c.len(), c[0], c[2], n.store[0])
}
