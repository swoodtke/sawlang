// probe: stated
// about: a `let`, `??` and a by-value argument read a conditional lend's optional place whole as its optional copy, for a Copy-tier payload (SL-899)
// stage 0: refuses a `borrows` call written without `borrow`
// speeds: -O0 -O2
// leaks: none
// prints: int vec present 7 7 7
// prints: int vec absent -1 8 -1
// prints: int user present 7 7 7
// prints: int user absent -1 8 -1
// prints: int shared present 7 7 7
// prints: int shared absent -1 8 -1
// prints: int user closes 3 0
// prints: named vec present 3 3 3
// prints: named vec absent -1 5 -1
// prints: named user present 3 3 3
// prints: named user absent -1 5 -1
// prints: named shared present 3 3 3
// prints: named shared absent -1 5 -1
// prints: named user closes 3 0
// prints: shape vec present 3 3 3
// prints: shape vec absent -1 9 -1
// prints: shape user present 3 3 3
// prints: shape user absent -1 9 -1
// prints: shape shared present 3 3 3
// prints: shape shared absent -1 9 -1
// prints: shape user closes 3 0

func tag(x: &Int) -> Int { x }
struct Named { name: String }
@synthesize
extension Named: Equatable {}
func tag(x: &Named) -> Int { x.name.len() }
enum Shape { case Circle(r: Int), case Label(s: String) }
@synthesize
extension Shape: Equatable {}
func tag(x: &Shape) -> Int {
    match x {
        case Circle(r) -> r,
        case Label(s) -> s.len()
    }
}

// The user accessor counts its epilogues, which run only when it lent.
struct UserInt { e: Int, ok: Bool, closes: Int }
extension UserInt: NoCopy {}
extension UserInt {
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedInt { e: Int, ok: Bool }
extension SharedInt: NoCopy {}
extension SharedInt {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Int? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserNamed { e: Named, ok: Bool, closes: Int }
extension UserNamed: NoCopy {}
extension UserNamed {
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedNamed { e: Named, ok: Bool }
extension SharedNamed: NoCopy {}
extension SharedNamed {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Named? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
// The user accessor counts its epilogues, which run only when it lent.
struct UserShape { e: Shape, ok: Bool, closes: Int }
extension UserShape: NoCopy {}
extension UserShape {
    func slot(&var self) borrows -> &var Shape? {
        if not self.ok {
            return None
        }
        lend self.e
        self.closes += 1
    }
}

struct SharedShape { e: Shape, ok: Bool }
extension SharedShape: NoCopy {}
extension SharedShape {
    @synthesize(shared)
    func slot(&var self) borrows -> &var Shape? {
        if not self.ok {
            return None
        }
        lend self.e
    }
}
func show(o: Int?) -> Int {
    if let x = o { tag(&x) } else { -1 }
}
func show(o: Named?) -> Int {
    if let x = o { tag(&x) } else { -1 }
}
func show(o: Shape?) -> Int {
    if let x = o { tag(&x) } else { -1 }
}

func lent_optional_value_reads_int() {
    var v = Vector<Int>()
    try! v.push(7)
    var u = UserInt(e: 7, ok: true, closes: 0)
    var ua = UserInt(e: 7, ok: false, closes: 0)
    let s = SharedInt(e: 7, ok: true)
    let sa = SharedInt(e: 7, ok: false)
    if true {
        let c = v.find(0)
        let d = v.find(0) ?? 8
        print("int vec present {show(c)} {tag(&d)} {show(v.find(0))}")
    }
    if true {
        let c = v.find(9)
        let d = v.find(9) ?? 8
        print("int vec absent {show(c)} {tag(&d)} {show(v.find(9))}")
    }
    if true {
        let c = u.slot()
        let d = u.slot() ?? 8
        print("int user present {show(c)} {tag(&d)} {show(u.slot())}")
    }
    if true {
        let c = ua.slot()
        let d = ua.slot() ?? 8
        print("int user absent {show(c)} {tag(&d)} {show(ua.slot())}")
    }
    if true {
        let c = s.slot()
        let d = s.slot() ?? 8
        print("int shared present {show(c)} {tag(&d)} {show(s.slot())}")
    }
    if true {
        let c = sa.slot()
        let d = sa.slot() ?? 8
        print("int shared absent {show(c)} {tag(&d)} {show(sa.slot())}")
    }
    print("int user closes {u.closes} {ua.closes}")
}

func lent_optional_value_reads_named() {
    var v = Vector<Named>()
    try! v.push(Named(name: "ann"))
    var u = UserNamed(e: Named(name: "ann"), ok: true, closes: 0)
    var ua = UserNamed(e: Named(name: "ann"), ok: false, closes: 0)
    let s = SharedNamed(e: Named(name: "ann"), ok: true)
    let sa = SharedNamed(e: Named(name: "ann"), ok: false)
    if true {
        let c = v.find(0)
        let d = v.find(0) ?? Named(name: "bobby")
        print("named vec present {show(c)} {tag(&d)} {show(v.find(0))}")
    }
    if true {
        let c = v.find(9)
        let d = v.find(9) ?? Named(name: "bobby")
        print("named vec absent {show(c)} {tag(&d)} {show(v.find(9))}")
    }
    if true {
        let c = u.slot()
        let d = u.slot() ?? Named(name: "bobby")
        print("named user present {show(c)} {tag(&d)} {show(u.slot())}")
    }
    if true {
        let c = ua.slot()
        let d = ua.slot() ?? Named(name: "bobby")
        print("named user absent {show(c)} {tag(&d)} {show(ua.slot())}")
    }
    if true {
        let c = s.slot()
        let d = s.slot() ?? Named(name: "bobby")
        print("named shared present {show(c)} {tag(&d)} {show(s.slot())}")
    }
    if true {
        let c = sa.slot()
        let d = sa.slot() ?? Named(name: "bobby")
        print("named shared absent {show(c)} {tag(&d)} {show(sa.slot())}")
    }
    print("named user closes {u.closes} {ua.closes}")
}

func lent_optional_value_reads_shape() {
    var v = Vector<Shape>()
    try! v.push(Shape.Label(s: "abc"))
    var u = UserShape(e: Shape.Label(s: "abc"), ok: true, closes: 0)
    var ua = UserShape(e: Shape.Label(s: "abc"), ok: false, closes: 0)
    let s = SharedShape(e: Shape.Label(s: "abc"), ok: true)
    let sa = SharedShape(e: Shape.Label(s: "abc"), ok: false)
    if true {
        let c = v.find(0)
        let d = v.find(0) ?? Shape.Circle(r: 9)
        print("shape vec present {show(c)} {tag(&d)} {show(v.find(0))}")
    }
    if true {
        let c = v.find(9)
        let d = v.find(9) ?? Shape.Circle(r: 9)
        print("shape vec absent {show(c)} {tag(&d)} {show(v.find(9))}")
    }
    if true {
        let c = u.slot()
        let d = u.slot() ?? Shape.Circle(r: 9)
        print("shape user present {show(c)} {tag(&d)} {show(u.slot())}")
    }
    if true {
        let c = ua.slot()
        let d = ua.slot() ?? Shape.Circle(r: 9)
        print("shape user absent {show(c)} {tag(&d)} {show(ua.slot())}")
    }
    if true {
        let c = s.slot()
        let d = s.slot() ?? Shape.Circle(r: 9)
        print("shape shared present {show(c)} {tag(&d)} {show(s.slot())}")
    }
    if true {
        let c = sa.slot()
        let d = sa.slot() ?? Shape.Circle(r: 9)
        print("shape shared absent {show(c)} {tag(&d)} {show(sa.slot())}")
    }
    print("shape user closes {u.closes} {ua.closes}")
}

func main() {
    lent_optional_value_reads_int()
    lent_optional_value_reads_named()
    lent_optional_value_reads_shape()
}
