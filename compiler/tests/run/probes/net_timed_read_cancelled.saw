// probe: stated
// about: a timed read cancelled while parked answers Interrupted, never a timeout, and leaves the stream usable (SL-770)
// stage 0: its frozen std.net answers `TcpStream.pair()` with a bare pair, so it refuses the `try!` on it (SL-768)
// speeds: -O0 -O2
// prints: reader parks
// prints: main cancels the parked read
// prints: reader: io error: read failed (interrupted) (kind interrupted, code 0)
// prints: the stream still reads: after
// The cancel and the deadline are told apart (design 272): the reader waits on
// a thirty-second deadline, far past the cancel, so a `TimedOut` here could
// only mean the cancel was lost. The cancelled read answers `Err` of kind
// `Interrupted`, takes no bytes, and leaves its stream readable.
import std.net.{TcpStream, Timed}
import std.task.{yield_now}

func reader(stream: TcpStream) -> TcpStream {
    print("reader parks")
    match stream.read(timeout: Duration.secs(30)) {
        case Ok(timed) -> match timed {
            case Value(chunk) -> print("reader: {} bytes", chunk.len()),
            case TimedOut -> print("reader: TIMED OUT")
        },
        case Err(e) -> print("reader: {} (kind {}, code {})", e, e.kind(), e.code())
    }
    move stream
}

func main() {
    let (near, far) = try! TcpStream.pair()
    var group = TaskGroup()
    let h = group.spawn(reader(move near))
    yield_now()
    print("main cancels the parked read")
    h.cancel()
    let back = h.join()
    try! far.write("after")
    let chunk = try! back.read()
    print("the stream still reads: {}", try! chunk.to_string())
}
