// probe: custom
// about: built with `--no-hidden-alloc`, a `main() -> Result<Void, Failure>` returning an `Err` whose rendering is 5,000 bytes writes `error: ` and the error rendered in 512 bytes of stack, ending in `…`, where the same program built without the flag writes it whole (SL-1120)

struct Failure {
    message: String
}

extension Failure: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.message)
    }
}

extension Failure: Error {}

// 4,990 digits, then a marker, so a cut shows where it fell.
func long_message() -> String {
    var b = StringBuilder()
    var i = 0
    while i < 499 {
        try! b.append("0123456789")
        i = i + 1
    }
    try! b.append("--- END --")
    return b.build()
}

func main() -> Result<Void, Failure> {
    print("start")
    return Failure(message: long_message())
}
