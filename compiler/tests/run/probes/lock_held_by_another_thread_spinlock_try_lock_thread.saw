// probe: stated
// about: a `Thread.spawn` body whose `SpinLock.try_lock` meets the lock `main` holds answers absent, and is never taken for a re-entry (SL-843)
// stage 0: cannot parse a `borrow` block, and its std's locks check no owner
// speeds: -O0 -O2
// prints: worker -1 done 1
// `main` holds the window open until the worker's `try_lock` has answered,
// so the answer is decided while another thread holds the lock.
import std.spinlock.{SpinLock}

static G: SpinLock<Int>
static HELD: Atomic<Int> = Atomic(0)
static STARTED: Atomic<Int> = Atomic(0)
static DONE: Atomic<Int> = Atomic(0)
static SPIN: Atomic<Int> = Atomic(0)

func worker() -> Int {
    while HELD.load() == 0 { }
    STARTED.store(1)
    let r = if borrow var g = G.try_lock() { g = g + 1; g } else { -1 }
    DONE.store(1)
    r
}

func main() blocking {
    var t = try! Thread.spawn { worker() }
    borrow var o = G.lock() {
        HELD.store(1)
        while DONE.load() == 0 { }
        while SPIN.fetch_add(1) < 1_000_000 { }
        o = 10
    }
    let r = t.join()
    print("worker {} done {}", r, DONE.load())
}
