// Generic functions and methods that call themselves: at their own
// parameters, inferred and written, mutually, with the parameters swapped, a
// generic method, a method and a static of a generic type, and from inside a
// closure (SL-509).
struct Chain<T> {
    v: T
}

func count<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + count(x, n - 1)
}

func written<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + written<T>(x, n - 1)
}

func ping<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + pong(x, n - 1)
}

func pong<U>(y: U, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    10 + ping(y, n - 1)
}

func flip<A, B>(a: A, b: B, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + flip(b, a, n - 1)
}

extension Chain<T: Copy> {
    func depth(&self, n: Int) -> Int {
        if n == 0 {
            return 0
        }
        1 + self.depth(n - 1)
    }

    func walk<U>(&self, u: U, n: Int) -> Int {
        if n == 0 {
            return 0
        }
        1 + self.walk(u, n - 1)
    }

    static func make(v: T, n: Int) -> Int {
        if n == 0 {
            return 0
        }
        1 + Chain<T>.make(v, n - 1)
    }
}

func run(body: (Int) -> Int, n: Int) -> Int {
    body(n)
}

func closed<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    run({ k in 1 + closed(x, k) }, n - 1)
}

func main() {
    print("{}", count(true, 3))
    print("{}", written(7, 2))
    print("{}", ping(1, 3))
    print("{}", flip(1, true, 3))
    let c = Chain<Int>(v: 5)
    print("{}", c.depth(4))
    print("{}", c.walk(true, 2))
    print("{}", Chain<Int>.make(1, 3))
    print("{}", closed(1, 3))
}
