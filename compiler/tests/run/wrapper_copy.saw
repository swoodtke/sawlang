// A spelled `.copy()` of a wrapper no declaration writes a `copy()` for: a
// fixed array, an Optional and a tuple, each holding an ExplicitCopy part,
// and wrappers nested inside one another. Each part is copied by its own
// `copy()` in order, so the hook's lines are the oracle; a wrapper of trivial
// or String parts copies too.

struct R {
    v: Int
}

extension R: ExplicitCopy {
    func copy(&self) -> R {
        print("copy {}", self.v)
        R(v: self.v + 100)
    }

    func deinit(&var self) {
        print("d-{}", self.v)
    }
}

func array_case() {
    print("-- array")
    let a = [R(v: 1), R(v: 2)]
    let b = a.copy()
    print("{} {} / {} {}", a[0].v, a[1].v, b[0].v, b[1].v)
}

func optional_case() {
    print("-- optional")
    let o: R? = R(v: 3)
    let p = o.copy()
    print("{} {}", o!.v, p!.v)
    let n: R? = None
    let q = n.copy()
    print("none {}", q.is_none())
}

func tuple_case() {
    print("-- tuple")
    let t = (R(v: 4), 7, "s")
    let u = t.copy()
    print("{} {} {} / {} {} {}", t.0.v, t.1, t.2, u.0.v, u.1, u.2)
    let n = ((R(v: 5), 1), R(v: 6))
    let m = n.copy()
    print("{} {} / {} {}", n.0.0.v, n.1.v, m.0.0.v, m.1.v)
}

func nested_case() {
    print("-- nested")
    let o: [R; 2]? = [R(v: 9), R(v: 10)]
    let p = o.copy()
    print("{}", p!.len())
    let t: (R?, Int) = (R(v: 11), 2)
    let u = t.copy()
    print("{} {}", u.0!.v, u.1)
    let w: (R, Int)? = (R(v: 12), 3)
    let x = w.copy()
    print("{}", x!.1)
}

func bitwise_case() {
    print("-- bits")
    let a = [1, 2, 3]
    let b = a.copy()
    print("{} {}", b[0], b[2])
    let o: Int? = 4
    print("{}", o.copy()!)
    let t = (1, true)
    let u = t.copy()
    print("{} {}", u.0, u.1)
    let s = ["x", "y"]
    let c = s.copy()
    print("{} {}", c[0], c[1])
}

func main() {
    array_case()
    optional_case()
    tuple_case()
    nested_case()
    bitwise_case()
}
