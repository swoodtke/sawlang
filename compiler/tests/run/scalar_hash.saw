// A scalar's synthesized `Hashable.hash`, reached through a bound, at every
// integer width and `Bool`: each feeds its bits into the hasher as one word, a
// narrow value zero-extended, so `-1i8` and `255u8` digest alike. Each digest
// is compared with a hasher fed that word by hand, so the feed is pinned
// whatever `finish` computes.

func digest<T: Hashable>(v: T) -> Int {
    var h = Hasher()
    v.hash(&var h)
    h.finish()
}

// The digest of a hasher fed the one word `w`.
func fed(w: Int) -> Int {
    var h = Hasher()
    h.write_int(w)
    h.finish()
}

func main() {
    print("Int {} {} {}", digest(0) == fed(0), digest(-1) == fed(-1), digest(Int.max) == fed(Int.max))
    print("Int8 {} {}", digest(-1i8) == fed(255), digest(Int8.min) == fed(128))
    print("Int16 {} {}", digest(-1i16) == fed(65_535), digest(300i16) == fed(300))
    print("Int32 {} {}", digest(-1i32) == fed(0xFFFF_FFFF), digest(Int32.max) == fed(0x7FFF_FFFF))
    print("Int64 {} {}", digest(-1i64) == fed(-1), digest(Int64.min) == fed(Int.min))
    print("UInt {} {}", digest(UInt.max) == fed(-1), digest(UInt.min) == fed(0))
    print("UInt8 {} {}", digest(255u8) == fed(255), digest(128u8) == fed(128))
    print("UInt16 {} {}", digest(UInt16.max) == fed(65_535), digest(1u16) == fed(1))
    print("UInt32 {} {}", digest(UInt32.max) == fed(0xFFFF_FFFF), digest(1u32) == fed(1))
    print("UInt64 {} {}", digest(UInt64.max) == fed(-1), digest(1u64) == fed(1))
    print("Bool {} {}", digest(true) == fed(1), digest(false) == fed(0))
    print("narrow alike {}", digest(-1i8) == digest(255u8))
}
