// A failed assert's format arguments and an interpolated message render a
// Float through the same formatter as every other position: the maximum
// finite value, `100.0`, `0.001`, both sides of the `1e-4` switch and `2^53`
// (SL-722).

func main() {
    let huge = Float.from(bits: 0x7FEF_FFFF_FFFF_FFFF)
    let held = 0.0001
    assert(huge > 0.0, "never {held}")
    print("held {held}")
    assert(held < 0.0, "floats {} {} {} {} {} {}", huge, 100.0, 0.001, held, 0.00001,
           9007199254740992.0)
}
