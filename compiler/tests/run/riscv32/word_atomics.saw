// A riscv32 word probe (compiler/tests/run/riscv32_ir.py): every atomic the
// backend lowers, on the 4-byte word. `Atomic<Int>`'s four sequentially
// consistent operations, a String's refcount (the relaxed load, the add, the
// releasing sub and the acquire fence) and a closure environment's count.

static COUNTER: Atomic<Int> = Atomic(0)

@export("probe_atomics")
func probe_atomics(n: Int) -> Int {
    COUNTER.store(n)
    let before = COUNTER.fetch_add(2)
    let swapped = COUNTER.compare_exchange(n + 2, n + 5)
    let text = "shared"
    let copied = text
    print("{} {}", copied, text)
    let base = n
    let add: (Int) sync -> Int = { m: Int in m + base }
    let again = add
    if swapped {
        return before + COUNTER.load() + again(1)
    }
    before + add(2)
}
