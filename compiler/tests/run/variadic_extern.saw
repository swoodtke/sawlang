// A call of a variadic C function: the fixed arguments at their declared
// types, each extra one by C's default promotions. `fcntl(fd, F_DUPFD, min)`
// duplicates a descriptor at the lowest number at or above `min`, read from
// the variadic part; F_DUPFD is 0 on macOS and Linux alike.

extern "C" {
    func fcntl(fd: Int32, command: Int32, ...) -> Int32
    func close(fd: Int32) -> Int32
}

static F_DUPFD: Int32 = 0

func duplicate_at_least(fd: Int32, wide: Int, narrow: Int8) -> Bool {
    let first = fcntl(fd, F_DUPFD, wide)
    let second = fcntl(fd, F_DUPFD, narrow)
    let ok = first >= 40 && second >= 30 && first != second
    let _ = close(first)
    let _ = close(second)
    ok
}

func main() {
    print(duplicate_at_least(1, 40, 30))
}
