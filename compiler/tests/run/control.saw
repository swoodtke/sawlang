// `if`, `else if`, `while` with `break` and `continue`, a `for` over a
// range, and value-producing branches.
func classify(n: Int) -> Int {
    if n < 0 {
        -1
    } else if n == 0 {
        0
    } else {
        1
    }
}

func main() {
    var i = 0
    var evens = 0
    while i < 20 {
        i = i + 1
        if i % 2 == 1 {
            continue
        }
        if i > 14 {
            break
        }
        evens = evens + i
    }
    print("evens {} stopped at {}", evens, i)
    var total = 0
    for k in 0..5 {
        total = total + k
    }
    for k in 1..=3 {
        total = total + k * 100
    }
    print("total {}", total)
    print("{} {} {}", classify(-7), classify(0), classify(42))
    let flag = i > 10 && total > 0 || false
    print("flag {}", flag)
}
