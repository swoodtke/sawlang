func main() {
    var mixed: UInt64 = 0
    var high = 0
    var zeros = 0
    var k = 0
    while k < 1302 {
        let v = TABLE[k]
        mixed = (mixed ^ v) &* 31
        if v >= 0x8000_0000_0000_0000 {
            high = high + 1
        }
        if v == 0 {
            zeros = zeros + 1
        }
        k = k + 1
    }
    print("{} {} {}", TABLE[1], TABLE[651], TABLE[1301])
    print("{} {} {}", mixed, high, zeros)
}
