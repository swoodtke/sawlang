// An erased `Result<T, Box<any Error>>`'s error, dispatched through its
// vtable: `Printable.format` and the default `to_string` reached through
// `Error`, which refines `Printable`, by a method call, an interpolation and
// a format argument, on the box and through a reference to it; a concrete
// error boxed at a return and at a `try`, and each box's payload torn down
// exactly once (SL-721).

struct ParseFault {
    at: Int
}

extension ParseFault: Error {
    func format(&self, into: &var StringBuilder) {
        try! into.append("parse fault at ")
        try! into.append(self.at)
    }
}

struct Closed {
    name: String
}

extension Closed: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("closed ")
        try! into.append(self.name)
    }
}

extension Closed: Error {}

extension Closed: NoCopy {
    func deinit(&var self) { print("released {self.name}") }
}

func parse(n: Int) -> Result<Int, ParseFault> {
    if n < 0 { return ParseFault(at: -n) }
    return n * 10
}

func open(n: Int) -> Result<Int, Box<any Error>> {
    if n == 0 { return Closed(name: "socket") }
    let v = try parse(n)
    return v + 1
}

func describe(e: &Box<any Error>) -> String {
    e.to_string()
}

func show(n: Int) {
    match open(n) {
        case Ok(v) -> print("ok {}", v),
        case Err(e) -> {
            print("{e}")
            print("{}", e)
            print(describe(&e))
            var b = StringBuilder()
            e.format(into: &var b)
            print(b.build())
        }
    }
}

func main() {
    show(4)
    show(-3)
    show(0)
}
