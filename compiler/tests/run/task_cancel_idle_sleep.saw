// tests/corpus/taskgroup_cancel_during_sleep's subject, with a suspending
// `main` and `Task.spawn` in place of its `TaskGroup`, and a handle's
// `cancel()` in place of a peer's write through `cancel_addr()`
// (SL:coroutines A11): both the sleeper and `main` are parked on timers, so
// the executor idles until the earlier deadline, `main`'s; `main` then
// cancels the sleeper, and the sleeper's `sleep` returns long before its own
// deadline. That deadline is ten minutes off, so a sleep the cancel does not
// cut short shows as a hang rather than as a late line.
func sleeper() -> Int {
    print("sleeper: going to sleep")
    sleep(Duration.secs(600))
    if cancelled() {
        print("sleeper: cancelled")
        return 1
    }
    print("sleeper: slept the whole span")
    0
}

func main() {
    let victim = Task.spawn(sleeper())
    sleep(Duration.ms(50))
    print("main: cancelling the sleeper")
    victim.cancel()
    print("main: joined {}", victim.join())
}
