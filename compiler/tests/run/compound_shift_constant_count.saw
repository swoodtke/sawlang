// A compound shift's count is no constant position, as a binary shift's
// beside a run-time value is not: a constant count out of range is the
// run-time "shift out of range" panic, not a compile error (SL-514).
func main() {
    var u: UInt8 = 1
    u <<= 3
    print("{}", u)
    u <<= (1 << 64)
    print("{}", u)
}
