// due: the backend aligns a local only as its type asks yet
// refuses: backend.not-yet at 6:5
// A local's `@align` is refused at the attribute rather than dropped: its
// slot would otherwise be aligned to its type's 8 bytes, not to 64.
func main() {
    @align(64)
    var b = 1
    b = b + 1
    print("{}", b)
}
