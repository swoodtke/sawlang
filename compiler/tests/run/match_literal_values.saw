// Literal patterns are tested by value, never by spelling: a guarded arm's
// false edge still reaches a later arm that writes the same value another way
// (hex, `- 1`, digit separators, a base prefix, a width suffix, a string
// escape, inside a tuple and a payload), and a different value, `-1` beside
// `1`, is never taken for it. Guarded repeats and overlapping ranges stay
// legal, and raw-backed cases, documented ones included, compare by their
// raw values in a constant and at run time alike (SL-609).

/// A documented raw-backed enum.
enum Perm: UInt8 {
    /// Reading.
    case Read = 1 << 0,
    /// Writing.
    case Write = 0x02
}

static SAME: Bool = Perm.Read == Perm.Write
static DIFFER: Bool = Perm.Read != Perm.Write
static SELF: Bool = Perm.Write == Perm.Write
static READ: UInt8 = Perm.Read
static_assert(Perm.Read != Perm.Write, "two flags")

func guarded(x: Int, c: Bool) -> Int {
    match x {
        case 1 if c -> 1,
        case 1 -> 2,
        case _ -> 3
    }
}

func ranges(x: Int) -> Int {
    match x {
        case 1..=9 -> 1,
        case 1..=9 -> 2,
        case 5 -> 3,
        case _ -> 4
    }
}

func signs(x: Int, c: Bool) -> Int {
    match x {
        case -1 if c -> 1,
        case 1 -> 2,
        case -1 -> 3,
        case _ -> 4
    }
}

func edges(x: Int8) -> Int {
    match x {
        case -128 -> 1,
        case 127 -> 2,
        case _ -> 3
    }
}

func hex(x: Int, c: Bool) -> Int {
    match x {
        case 0x10 if c -> 1,
        case 16 -> 2,
        case _ -> 3
    }
}

func negative(x: Int, c: Bool) -> Int {
    match x {
        case -1 if c -> 1,
        case - 1 -> 2,
        case _ -> 3
    }
}

func separated(x: Int, c: Bool) -> Int {
    match x {
        case 1_000 if c -> 1,
        case 1000 -> 2,
        case _ -> 3
    }
}

func binary(x: Int, c: Bool) -> Int {
    match x {
        case 0b101 if c -> 1,
        case 0o5 -> 2,
        case _ -> 3
    }
}

func suffixed(x: UInt8, c: Bool) -> Int {
    match x {
        case 10_u8 if c -> 1,
        case 10 -> 2,
        case _ -> 3
    }
}

func escaped(s: String, c: Bool) -> Int {
    match s {
        case "a" if c -> 1,
        case "\u{61}" -> 2,
        case _ -> 3
    }
}

func newline(s: String, c: Bool) -> Int {
    match s {
        case "\n" if c -> 1,
        case "\u{a}" -> 2,
        case _ -> 3
    }
}

func tuple(x: Int, y: Int, c: Bool) -> Int {
    match (x, y) {
        case (0x10, 1) if c -> 1,
        case (16, 1) -> 2,
        case _ -> 3
    }
}

func payload(o: Int?, c: Bool) -> Int {
    match o {
        case Some(0x10) if c -> 1,
        case Some(16) -> 2,
        case _ -> 3
    }
}

func ranged(x: Int, c: Bool) -> Int {
    match x {
        case 0x1..=0x5 if c -> 1,
        case 1..=5 -> 2,
        case _ -> 3
    }
}

func distinct(x: Int, c: Bool) -> Int {
    match x {
        case 0x11 if c -> 1,
        case 16 -> 2,
        case _ -> 3
    }
}

func flags(b: Bool, c: Bool) -> Int {
    match b {
        case true if c -> 1,
        case false -> 2,
        case true -> 3
    }
}

func sign(x: Int, c: Bool) -> Int {
    match x {
        case -1 if c -> 1,
        case 1 -> 2,
        case _ -> 3
    }
}

func main() {
    print("sign {} {}", sign(x: 1, c: false), sign(x: -1, c: true))
    print("hex {} {}", hex(x: 16, c: false), hex(x: 16, c: true))
    print("negative {} {}", negative(x: -1, c: false), negative(x: -1, c: true))
    print("separated {} {}", separated(x: 1000, c: false), separated(x: 1000, c: true))
    print("binary {} {}", binary(x: 5, c: false), binary(x: 5, c: true))
    print("suffixed {} {}", suffixed(x: 10, c: false), suffixed(x: 10, c: true))
    print("escaped {} {}", escaped(s: "a", c: false), escaped(s: "a", c: true))
    print("newline {} {}", newline(s: "\n", c: false), newline(s: "\n", c: true))
    print("tuple {} {}", tuple(x: 16, y: 1, c: false), tuple(x: 16, y: 1, c: true))
    print("payload {} {}", payload(o: 16, c: false), payload(o: 16, c: true))
    print("ranged {} {}", ranged(x: 3, c: false), ranged(x: 3, c: true))
    print("distinct {} {} {}", distinct(x: 16, c: false), distinct(x: 17, c: false), distinct(x: 17, c: true))
    print("flags {} {} {}", flags(b: true, c: false), flags(b: true, c: true), flags(b: false, c: true))
    print("{} {} {}", SAME, DIFFER, SELF)
    print("{}", READ)
    print("{} {}", guarded(x: 1, c: false), guarded(x: 1, c: true))
    print("{} {}", ranges(x: 5), ranges(x: 10))
    print("{} {} {}", signs(x: 1, c: true), signs(x: -1, c: false), signs(x: -1, c: true))
    print("{} {}", edges(x: -128), edges(x: 127))
}
