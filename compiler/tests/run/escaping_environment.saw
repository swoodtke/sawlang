// A returned closure's environment outlives the frame that built it:
// `clobber` reuses that stack before `f()` reads it, so a capture that lived
// in the frame would print whatever the stack then held. The capture lives
// in a heap environment, and it prints 42 (SL-608).
struct Res { n: Int }

func make(r: &Res) -> () -> Int {
    let n = r.n
    return { [n] in n }
}

func build() -> () -> Int {
    let x = Res(n: 42)
    make(&x)
}

func clobber(a: Int, b: Int, c: Int, d: Int) -> Int {
    let y = Res(n: a * b + c * d)
    let z = Res(n: y.n + 7)
    z.n + y.n
}

func main() {
    let f = build()
    let _ = clobber(1000, 1000, 1000, 1000)
    print("{}", f())
}
