// due: a blocking extern's offload is not lowered yet (SL:coroutines A14)
// refuses: coro.not-yet at 19:17
// A `main` that reaches a `blocking` extern through two helpers suspends, and
// so does each helper, so each is refused, `main` first, rather than
// compiled as a plain call that blocks the only thread.
extern "C" {
    blocking func usleep(us: UInt32) -> Int32
}

func nap() -> Int32 {
    usleep(10)
}

func caller() -> Int {
    (nap() as Int) + 41
}

func main() {
    print("{}", caller())
}
