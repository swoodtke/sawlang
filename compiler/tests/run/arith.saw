// Integer arithmetic at several widths: checked and wrapping operators,
// division and remainder of both signs, shifts, bitwise operators and
// comparisons.
func main() {
    let a = 17
    let b = -5
    print("{} {} {}", a + b, a - b, a * b)
    print("{} {} {} {}", a / b, a % b, b / 2, b % 2)
    let small: Int8 = 100
    let wrapped = small &+ 100
    print("wrapped {}", wrapped)
    let byte: UInt8 = 200
    print("byte {} {}", byte, byte &* 2)
    let big: UInt64 = 18446744073709551615
    print("big {}", big)
    print("shift {} {} {}", 1 << 10, -64 >> 2, (255u8 >> 3))
    print("bits {} {} {}", 0xF0 & 0x3C, 0xF0 | 0x0F, 0xFF ^ 0x0F)
    print("cmp {} {} {}", a < b, a >= 17, b != -5)
    let m: Int32 = -2147483648
    print("min {}", m)
    var acc = 0
    var i = 1
    while i <= 10 {
        acc = acc + i * i
        i = i + 1
    }
    print("sum of squares {}", acc)
}
