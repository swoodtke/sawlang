// `dump_tasks()` and `Task.spawn` read no current task, so from a task's
// `sync` helper the dump is the body's, and a background task spawned there
// runs as one the body spawns does: the controls of conformance row K201
// (SL-810). A join suspends, so the helper detaches its task.
import std.task.*

func square(n: Int) -> Int {
    yield_now()
    n * n
}

func dump_sync() sync {
    print("-- dump from the sync helper")
    dump_tasks()
}

func report() {
    print("sync helper's Task.spawn ran {}", square(5))
}

func spawn_sync() sync {
    let t = Task.spawn(report())
    t.detach()
}

func body() -> Int {
    yield_now()
    print("-- dump from the body")
    dump_tasks()
    dump_sync()
    let a = Task.spawn(square(4)).join()
    print("body's Task.spawn joined {}", a)
    spawn_sync()
    sleep(Duration.ms(20))
    0
}

func main() {
    let t = Task.spawn(body())
    print("joined {}", t.join())
}
