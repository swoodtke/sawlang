// tests/corpus/coro_iflet_over_suspending, with `__saw_drive` in place of its
// `TaskGroup` (SL-551 c2): an `if let` whose subject suspends binds an
// ordinary local, and the frame resumes into the branch. The step counts show
// the subject really suspended, once per `yield_now`.
import std.task.*

func maybe_get(n: Int) -> Int? {
    yield_now()
    if n > 0 {
        return n * 10
    }
    return None
}

func worker(n: Int) -> Int {
    if let v = maybe_get(n) {
        yield_now()
        return v + 1
    }
    return -1
}

func main() {
    print(__saw_drive(worker(5)))
    print(__saw_drive(worker(0)))
    print(__saw_drive_steps(worker(5)))
    print(__saw_drive_steps(worker(0)))
}
