// tests/corpus/taskgroup_compute_preemption, with `Task.spawn` in place of
// its `TaskGroup`, which waits on SL:coroutines A8b (SL-566): a task that only
// computes, with no suspending call of its own, still cedes to its sibling.
// `spinner`'s loop is a million iterations of arithmetic; its op-budget point
// forces a yield after 128 of them, so `chatty`, spawned second and waiting
// in the run queue, prints while the spinner is still counting.
func spinner() -> Int {
    print("spin start")
    var i = 0
    var acc = 0
    while i < 1000000 {
        acc = acc + i
        i = i + 1
    }
    print("spin end")
    acc
}

func chatty() -> Int {
    print("sibling ran")
    1
}

func main() {
    let hs = Task.spawn(spinner())
    let hc = Task.spawn(chatty())
    let acc = hs.join()
    let _ = hc.join()
    print(acc)
}
