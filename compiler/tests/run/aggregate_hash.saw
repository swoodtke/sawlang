// An aggregate's `Hashable.hash` with no written body (SL-598), its digest
// compared with a hasher fed by hand the exact words the hook must feed, in
// order, so the feed is pinned word for word whatever `finish` computes: a
// trivial struct's and a payload-free enum's automatic conformance (a narrow
// signed field
// zero-extended), a raw-backed enum (its case's stated value, zero-extended),
// a written `@synthesize` on a struct holding a String, a payload-carrying
// enum (the case's ordinal, then its payload), a struct holding a fixed array,
// a tuple and an Optional (1 or 0, then the payload when present), and a
// nested aggregate asking each part's own hook, a hand-written one included.
// The automatic conformances are reached by a call on the concrete type,
// since Stage 0 meets no `T: Hashable` bound with one.

struct Point { x: Int, y: Int8 }

enum Color { case Red, case Green, case Blue }

enum Level: Int8 { case Low = -1, case High = 7 }

struct Named { name: String, n: Int }
@synthesize
extension Named: Equatable {}
@synthesize
extension Named: Hashable {}

enum Shape {
    case Circle(r: Int),
    case Rect(w: Int, h: Int),
    case Label(text: String),
    case Empty
}
@synthesize
extension Shape: Equatable {}
@synthesize
extension Shape: Hashable {}

struct Row { cells: [UInt8; 3], tag: Bool }
@synthesize
extension Row: Equatable {}
@synthesize
extension Row: Hashable {}

// Feeds its id alone, so a memberwise answer would differ.
struct Keyed { id: Int, note: String }
extension Keyed: Equatable {
    func equals(&self, other: &Self) -> Bool { self.id == other.id }
}
extension Keyed: Hashable {
    func hash(&self, h: &var Hasher) { h.write_int(self.id) }
}

struct Nest {
    at: Point,
    color: Color,
    level: Level,
    shape: Shape,
    pair: (Int, String),
    maybe: Named?,
    keyed: Keyed
}
@synthesize
extension Nest: Equatable {}
@synthesize
extension Nest: Hashable {}

func digest<T: Hashable>(v: T) -> Int {
    var h = Hasher()
    v.hash(&var h)
    h.finish()
}

func point_digest(v: Point) -> Int {
    var h = Hasher()
    v.hash(&var h)
    h.finish()
}

func color_digest(v: Color) -> Int {
    var h = Hasher()
    v.hash(&var h)
    h.finish()
}

func level_digest(v: Level) -> Int {
    var h = Hasher()
    v.hash(&var h)
    h.finish()
}

// The digest of a hasher fed exactly `words`, in order. A String's bytes are
// written as their codes: "a" is 97, "b" 98, "h" 104, "i" 105, "q" 113,
// "r" 114, "x" 120, "z" 122.
func fed(words: Vector<Int>) -> Int {
    var h = Hasher()
    for w in words.iter() {
        h.write_int(w)
    }
    h.finish()
}

func main() {
    print("point {} {}", point_digest(Point(x: 3, y: -1i8)) == fed([3, 255]),
          point_digest(Point(x: 3, y: 2i8)) == fed([3, 2]))
    print("color {} {} {}", color_digest(Color.Red) == fed([0]), color_digest(Color.Green) == fed([1]),
          color_digest(Color.Blue) == fed([2]))
    print("level {} {}", level_digest(Level.Low) == fed([255]), level_digest(Level.High) == fed([7]))
    print("named {} {}", digest(Named(name: "ab", n: 7)) == fed([97, 98, 7]),
          digest(Named(name: "", n: 0)) == fed([0]))
    print("shape {} {} {} {}", digest(Shape.Circle(r: 9)) == fed([0, 9]),
          digest(Shape.Rect(w: 1, h: 2)) == fed([1, 1, 2]),
          digest(Shape.Label(text: "hi")) == fed([2, 104, 105]), digest(Shape.Empty) == fed([3]))
    print("row {} {}", digest(Row(cells: [1u8, 2u8, 255u8], tag: true)) == fed([1, 2, 255, 1]),
          digest(Row(cells: [0u8, 0u8, 0u8], tag: false)) == fed([0, 0, 0, 0]))
    print("tuple {} {}", digest((1, "x")) == fed([1, 120]), digest((-1, Shape.Empty)) == fed([-1, 3]))
    let some: Named? = Named(name: "z", n: 9)
    let none: Named? = None
    let deep: Int?? = 4
    print("optional {} {} {}", digest(some) == fed([1, 122, 9]), digest(none) == fed([0]),
          digest(deep) == fed([1, 1, 4]))
    let n = Nest(at: Point(x: 5, y: -128i8), color: Color.Blue, level: Level.Low, shape: Shape.Label(text: "q"),
                 pair: (6, "r"), maybe: None, keyed: Keyed(id: 11, note: "ignored"))
    let m = Nest(at: Point(x: 5, y: -128i8), color: Color.Blue, level: Level.Low, shape: Shape.Label(text: "q"),
                 pair: (6, "r"), maybe: None, keyed: Keyed(id: 11, note: "other"))
    print("nest {} {}", digest(n) == fed([5, 128, 2, 255, 2, 113, 6, 114, 0, 11]), digest(n) == digest(m))
}
