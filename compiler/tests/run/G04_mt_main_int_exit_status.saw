// tests/corpus/conformance/G04_mt_main_int_exit_status less its directives (SL-578):
// a `TaskGroup(threads: N)` pool program, held to Stage 0's run.
//
// Conformance row G04 — a suspending `main() -> Int` over a `threads: N` group
// returns its value as the process exit status
//
// The multi-threaded engine drains the same run queue from N OS workers. Main's
// own frame is still the ambient root, so the status must survive the crossing
// unchanged — this row is the one that says the answer does not depend on which
// engine ran the siblings.

import std.task.{yield_now}

func work(n: Int) -> Int {
    yield_now()
    n + 1
}

func main() -> Int {
    var g = try! TaskGroup(threads: 2)
    let h = g.spawn(work(0))
    yield_now()
    print("joined {h.join()}")
    7
}
