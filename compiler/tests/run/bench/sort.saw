// An insertion sort of 20,000 pseudo-random `Int`s, then a checksum: the inner
// loop is all `v[k]` reads and `v.set` writes, so it measures whether the
// checked accessors inline.
func sort_checksum(n: Int) -> Int {
    var v = Vector<Int>()
    var seed = 12345
    var i = 0
    while i < n {
        seed = (seed * 1103515245 + 12345) % 2147483648
        try! v.push(seed % 100000)
        i = i + 1
    }
    var j = 1
    while j < v.len() {
        let key = v[j]
        var k = j - 1
        while k >= 0 && v[k] > key {
            v.set(k + 1, v[k])
            k = k - 1
        }
        v.set(k + 1, key)
        j = j + 1
    }
    var sum = 0
    var w = 0
    while w < v.len() {
        sum = (sum * 31 + v[w]) % 1000000007
        w = w + 1
    }
    sum
}

func main() {
    print("sort {}", sort_checksum(20000))
}
