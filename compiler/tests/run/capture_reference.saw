// A non-escaping closure capturing a reference parameter under each capture
// word where it is legal: `[&var v]` and the implicit capture of a `&var`
// parameter write the caller's vector, `[&v]` reads it, and the implicit
// capture, `[v]` and `[copy r]` of a shared parameter read the live referent,
// beside a shared argument of the same call.
struct Res { n: Int }

func run(f: () -> Void) { f() }

func run_int(f: () -> Int) -> Int { f() }

func peek(a: &Vector<Int>, f: () -> Int) -> Int { a.len() + f() }

func grow(v: &var Vector<Int>) {
    run({ [&var v] in try! v.push(7) })
    run({ try! v.push(8) })
}

func count(v: &var Vector<Int>) -> Int {
    run_int({ [&v] in v.len() })
}

func shared(v: &Vector<Int>) -> Int {
    peek(&v, { v.len() }) + peek(&v, { [v] in v[1] })
}

func read_copied(r: &Res) -> Int {
    run_int({ [copy r] in r.n + 1 })
}

func main() {
    var v: Vector<Int> = [1]
    grow(&var v)
    print("{} {} {}", v.len(), v[1], v[2])
    print("{}", count(&var v))
    print("{}", shared(&v))
    var r = Res(n: 0)
    r.n = 41
    print("{}", read_copied(&r))
}
