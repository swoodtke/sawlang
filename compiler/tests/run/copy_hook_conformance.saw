// The `copy()` a `Copy` conformance writes is the retain hook every silent
// copy runs: at a binding, a tuple, an Optional, a generic body, a field and
// a payload, and a spelled `.copy()` calls it too. An `ExplicitCopy`
// conformance's `copy()` runs where it is spelled.
struct Money {
    cents: Int
}

extension Money: Copy {
    func copy(&self) -> Money {
        print("hook")
        Money(cents: self.cents + 100)
    }
}

struct Wallet {
    m: Money
    n: Int
}

@synthesize
extension Wallet: Copy {}

enum Slot {
    case Full(m: Money),
    case Empty
}

struct Ledger {
    cents: Int
}

extension Ledger: ExplicitCopy {
    func copy(&self) -> Ledger {
        print("explicit copy")
        Ledger(cents: self.cents + 1)
    }
}

func dup<T: Copy>(x: &T) -> T {
    let y = x
    y
}

func cents_of(s: Slot) -> Int {
    match s {
        case Full(m) -> m.cents,
        case Empty -> -1
    }
}

func main() {
    let a = Money(cents: 1)
    let b = a
    print("let {}", b.cents)
    let t = (a, 2)
    let u = t
    print("tuple {}", u.0.cents)
    let o: Money? = a
    let p = o
    print("optional {}", p!.cents)
    let g = dup(&a)
    print("generic {}", g.cents)
    let w = Wallet(m: a, n: 3)
    let w2 = w
    print("field {}", w2.m.cents)
    let s = Slot.Full(m: a)
    let s2 = s
    print("payload {}", cents_of(s2))
    let v = a.copy()
    print("spelled call {}", v.cents)
    let l = Ledger(cents: 1)
    let k = l.copy()
    print("explicit {}", k.cents)
}
