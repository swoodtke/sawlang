// A bare static of a `SpinLock` and of a `Once` is an unlocked lock and an
// unset slot: zero is each one's starting state, so neither needs an
// initializer.

import std.once.{Once}
import std.spinlock.{SpinLock}

static COUNT: SpinLock<Int>
static LIMIT: Once<Int>

func main() {
    print(COUNT.is_locked())
    print(LIMIT.is_set())
    LIMIT.set(4096)
    print(LIMIT.is_set())
}
