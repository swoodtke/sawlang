// tests/corpus/conformance/K54_mt_task_receives_what_main_sent less its directives (SL-578):
// a `TaskGroup(threads: N)` pool program, held to Stage 0's run.
//
// Conformance row K54 — control: an MT group's task receives what MAIN sent
//
// The direction that already worked, and must keep working. Main fills the
// channel before the drain starts, so the task's cooperative `receive()` finds
// its value on the first `try_receive` and never has to be woken by anybody.
// It is the row that says the live pool did not cost the fork-join case its
// determinism: the value is there before the worker is.
//

import std.channel.{Channel}

func consume(inbox: Channel<Int>) -> Int {
    try! inbox.receive()
}

func main() {
    let inbox = try! Channel<Int>()
    var workers = try! TaskGroup(threads: 2)
    try! inbox.send(5)
    let h = workers.spawn(consume(inbox.copy()))
    print("task got {}", h.join())
}
