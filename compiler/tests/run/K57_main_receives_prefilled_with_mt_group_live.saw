// tests/corpus/conformance/K57_main_receives_prefilled_with_mt_group_live less its directives (SL-578):
// a `TaskGroup(threads: N)` pool program, held to Stage 0's run.
//
// Conformance row K57 — control: main receives a value that is ALREADY in the
// channel while an MT group is live
//
// The isolating cell. Main's receive here depends on nothing the group does,
// so it separates "main cannot receive while an MT group exists" from "an MT
// group's tasks do not run" — the sweep needed it to rule the first out, and
// the suite keeps it because a live pool adds real concurrency to main's own
// path and this is the row that says main still reads its own channel.
//

import std.channel.{Channel}

func idle(n: Int) -> Int {
    n
}

func main() {
    let inbox = try! Channel<Int>()
    try! inbox.send(2)
    var workers = try! TaskGroup(threads: 2)
    let h = workers.spawn(idle(1))
    let got = try! inbox.receive()
    let _ = h.join()
    print("main got {}", got)
}
