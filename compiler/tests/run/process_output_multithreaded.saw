// Command.output is spawnable into a multi-threaded group: everything its
// frame carries across the drain's park crosses an OS thread, so the drain
// must hold no state the Send gate refuses. Each handle joins its own task's
// result, so the two lines are deterministic whatever order the workers ran in.

import std.process.{Command, CommandOutput}

func capture(word: String) -> String {
    var c = Command(program: "/bin/echo")
    try! c.arg(word)
    let result: CommandOutput? = try! c.output()
    if let out = result {
        return out.stdout.trim()
    }
    "<no output>"
}

func main() {
    var group = try! TaskGroup(threads: 2)
    let a = group.spawn(capture("alpha"))
    let b = group.spawn(capture("beta"))
    print("first: {}", a.join())
    print("second: {}", b.join())
}
