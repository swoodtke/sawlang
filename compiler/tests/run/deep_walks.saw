trait Worker {
    func step(&self) -> Int
}

struct Fast {
    n: Int
}

extension Fast: Worker {
    func step(&self) -> Int {
        self.n
    }
}

struct Wrap<T> {
    inner: T
}

extension Wrap<T: Worker>: Worker {
    func step(&self) -> Int {
        self.inner.step() + 1
    }
}

func deep_step(w: &Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Fast>>>>>>>>>>>>>>>>>>) sync -> Int {
    w.step()
}

