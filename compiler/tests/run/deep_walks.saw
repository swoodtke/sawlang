func equatable<T: Equatable>(x: &T) -> Int {
    1
}

struct Node {
    value: Int
    children: Vector<Node>
}

extension Node: NoCopy {}

func sendable<T: Send>(x: &T) -> Int {
    1
}

trait Ping {
    func ping(&self, n: Int) -> Int {
        if n <= 0 {
            return 0
        }
        self.pong(n - 1) + 1
    }

    func pong(&self, n: Int) -> Int {
        self.ping(n)
    }
}

struct Ball {
    n: Int
}

extension Ball: Ping {}

func bounce(b: &Ball) sync -> Int {
    b.ping(3)
}

