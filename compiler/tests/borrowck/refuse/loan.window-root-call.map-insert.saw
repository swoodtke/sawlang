// refuses: loan.window-root-call at 44:17
// `Map.insert` hashes its key, so the call inside the window reaches the
// root the key's `hash` opens (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

func main() {
    var m: Map<HKey, Int> = Map()
    borrow let c = count() {
        let _ = m.insert(HKey(n: 1), 2)
        print("{}", c)
    }
}
