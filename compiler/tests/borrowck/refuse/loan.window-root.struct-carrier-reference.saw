// refuses: loan.window-root at 34:14
// an exclusive borrow of a `for` loop's root, passed as `&var`, while the borrowing struct the head lends points into it (spec, Borrowing structs)

struct Tally { n: Int }
extension Tally: NoCopy {}

borrows struct Steps {
    tally: &Tally,
    at: Int
}

extension Tally {
    func steps(&self) borrows -> Steps {
        Steps(tally: lends self, at: 0)
    }
}

extension Steps: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.at >= self.tally.n {
            return None
        }
        self.at = self.at + 1
        self.at
    }
}

func bump(t: &var Tally) { t.n = t.n + 1 }

func main() {
    var t = Tally(n: 2)
    for x in t.steps() {
        bump(&var t)
    }
    print(t.n)
}
