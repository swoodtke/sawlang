// refuses: loan.window-root-call at 48:20
// an array literal compared where it is written has the same equality as a bound array, so it is
// refused inside a window on a static root its element opens (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let same = [HKey(n: 45)] == [HKey(n: 45)]
        print("tag {} {}", b.tag, same)
    }
}
