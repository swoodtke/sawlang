// refuses: loan.window-root-call at 54:20
// a generic `==` over `T: Equatable` instantiated at a tuple runs the tuple's element equality, so the
// call inside a window on a static root an element opens is refused (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

func eq<T: Equatable>(a: &T, b: &T) -> Bool {
    a == b
}

func main() {
    let x = (HKey(n: 41), 1)
    let y = (HKey(n: 41), 1)
    borrow var b = boot_slot() {
        b.tag = 7
        let same = eq(&x, &y)
        print("tag {} {}", b.tag, same)
    }
}
