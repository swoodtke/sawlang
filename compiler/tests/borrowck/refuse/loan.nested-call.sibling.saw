// refuses: loan.nested-call at 18:26
// a nested call's `&var` overlapping a sibling argument's reference
// (conformance X41)

struct Pair { a: Int, b: Int }

func reset(p: &var Pair) -> Int {
    p.a = 100
    7
}

func sink(x: &var Int, extra: Int) {
    x = x + extra
}

func main() {
    var p = Pair(a: 1, b: 2)
    sink(&var p.a, reset(&var p))
    print(p.a)
}
