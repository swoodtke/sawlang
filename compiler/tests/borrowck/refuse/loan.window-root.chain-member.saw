// refuses: loan.window-root at 17:15
// a subscript, a field of the element it lends, then a subscript: the outer
// hop is exclusive through the field between them (SL-490)

struct P { n: Int }

struct Row { cells: Vector<P> }

extension Row: NoCopy {}

func main() {
    var cells = Vector<P>()
    try! cells.push(P(n: 1))
    var g = Vector<Row>()
    try! g.push(Row(cells: move cells))
    borrow var c = g[0].cells[0] {
        c.n = g.len()
    }
    print(g.len())
}
