// refuses: loan.window-root-call at 48:28
// a `Set` literal is its container's `init()` and an `insert` per entry, which hash and compare the
// elements, so one inside a window on a static root the elements' methods open is refused (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let s: Set<HKey> = {HKey(n: 42), HKey(n: 43)}
        print("tag {} {}", b.tag, s.len())
    }
}
