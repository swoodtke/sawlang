// refuses: loan.nested-call at 19:39
// two nested calls borrowing one root: a call's references are checked over
// the whole call, whatever order the nested calls run in (conformance X45)

func bump(n: &var Int) -> Int {
    n = n + 5
    n
}

func scale(n: &var Int) -> Int {
    n = n * 2
    n
}

func combine(a: Int, b: Int) -> Int { a + b }

func main() {
    var n = 0
    print(combine(bump(&var n), scale(&var n)))
}
