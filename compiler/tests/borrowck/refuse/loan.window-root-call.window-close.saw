// refuses: loan.window-root-call at 22:5
// a shared root function whose epilogue, the code after its `lend`, calls a
// function that opens an exclusive window on an overlapping root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func watched() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
    install(1)
}

func main() {
    borrow let c = watched() {
        print("{}", c)
    }
}
