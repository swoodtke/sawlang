// refuses: loan.window-root-call at 57:20
// a `@synthesize`d equality compares each field, and a tuple field compares by its elements, so `==` on
// the struct inside a window on a static root an element opens is refused (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

struct Pair {
    k: (HKey, Int)
}

@synthesize
extension Pair: Equatable {}

func main() {
    let x = Pair(k: (HKey(n: 44), 1))
    let y = Pair(k: (HKey(n: 44), 1))
    borrow var b = boot_slot() {
        b.tag = 7
        let same = x == y
        print("tag {} {}", b.tag, same)
    }
}
