// refuses: loan.window-root at 47:17
// a forwarding accessor `(&var self) borrows -> &E` whose `match` arm lends
// its `var` payload onward reaches the inner accessor's exclusive form through
// an accessor with a `@synthesize(shared)` form, so a second lend of the inner
// root inside the arm conflicts with its window (SL-906)

struct E { n: Int, items: Vector<Int> }
extension E: NoCopy {}
enum Sl { case Full(e: E), case Empty }
extension Sl: NoCopy {}

func grow(v: &var Vector<Int>) {
    var k = 0
    while k < 256 {
        try! v.push(k)
        k += 1
    }
}

func fresh() -> E {
    var items = Vector<Int>()
    try! items.push(41)
    E(n: 1, items: move items)
}

struct C { slot: E, sl: Sl }
extension C: NoCopy {}
extension C {
    @synthesize(shared)
    func sat(&var self, i: Int) borrows -> &var Sl {
        lend self.sl
    }
    @synthesize(shared)
    func sfind(&var self, i: Int) borrows -> &var Sl? {
        if i != 0 {
            return None
        }
        lend self.sl
    }
}
struct O { inner: C }
extension O: NoCopy {}
extension O {
    func get(&var self) borrows -> &E {
        match self.inner.sat(0) {
            case Full(var e) -> {
                if let xs = self.inner.sfind(0) {
                    match xs {
                        case Full(x) -> {
                            borrow let r = x.items[0] {
                                grow(&var e.items)
                                print(r)
                            }
                        },
                        case Empty -> {}
                    }
                }
                lend e
            },
            case Empty -> { panic("empty") }
        }
    }
}

func main() {
    var o = O(inner: C(slot: fresh(), sl: Sl.Full(e: fresh())))
    borrow let g = o.get() {
        print(g.n)
    }
}
