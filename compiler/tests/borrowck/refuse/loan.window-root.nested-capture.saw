// refuses: loan.window-root at 11:17
// a nested closure re-capturing `[&var v]` out of its outer closure's
// environment, under a window the outer closure opens on `v[0]`; the
// diagnostic names the capture `v`, not the environment's slot (SL-607)

func run(f: () -> Void) { f() }

func nested(v: &var Vector<Int>) {
    run({ [&var v] in
        borrow var first = v[0] {
            run({ [&var v] in try! v.push(1) })
            first += 1
        }
    })
}

func main() {
}
