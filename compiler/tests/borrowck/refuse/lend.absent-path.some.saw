// refuses: lend.absent-path at 10:13
// a conditional accessor's `return Optional.Some(6)` before its `lend`: a
// present value is still no place; only `return None` is the absent path

struct Gauge { level: Int }

extension Gauge {
    func at(&var self, i: Int) borrows -> &var Int? {
        if i != 0 {
            return Optional.Some(6)
        }
        lend self.level
    }
}

func main() {
    var g = Gauge(level: 1)
    if var x = g.at(1) { print("present {}", x) } else { print("absent") }
    print(g.level)
}
