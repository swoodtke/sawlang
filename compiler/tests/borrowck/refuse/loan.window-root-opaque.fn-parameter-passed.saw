// refuses: loan.window-root-opaque at 29:9
// the own function parameter passed on inside the window (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func forward(body: () sync -> Void) {
    body()
}

func run(body: () sync -> Void) {
    borrow let c = count() {
        forward(body)
        print("{}", c)
    }
}

func main() {
    run({ install(1) })
}
