// refuses: loan.window-root at 23:34
// two exclusive windows on one root in one call (conformance X16, X20, X30)

struct Pair { a: Int, b: Int }

extension Pair {
    func at(&var self, i: Int) borrows -> &var Int {
        if i == 0 {
            lend self.a
        } else {
            lend self.b
        }
    }
}

func set_both(x: &var Int, y: &var Int) {
    x = 50
    y = 60
}

func main() {
    var p = Pair(a: 1, b: 2)
    set_both(borrow var p.at(0), borrow var p.at(1))
    print(p.a)
}
