// refuses: loan.exclusive-twice at 10:9
// A writable range view holds its array exclusively while it is in use, so
// a write to the array between two of its uses is two exclusive borrows of
// one place (SL:borrowing §6, SL-988).

func main() {
    var a: [Int; 4] = [1, 2, 3, 4]
    borrow var s = a[0..2] {
        s[0] = 5
        a[3] = 9
        s[1] = 6
    }
}
