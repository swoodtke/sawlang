// refuses: loan.window-root-call at 45:9
// a call through a bound, resolved at its concrete type, reaches the
// implementation's roots (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

trait Probe {
    func poke(&self)
}

struct Writer {
    n: Int
}

extension Writer: Probe {
    func poke(&self) {
        install(self.n)
    }
}

func poke_it<T: Probe>(t: &T) {
    t.poke()
}

func main() {
    let w = Writer(n: 4)
    borrow let c = count() {
        poke_it(&w)
        print("{}", c)
    }
}
