// refuses: loan.window-root-call at 26:9
// a shared window on a static root held across a call that opens an
// exclusive window on an overlapping root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func main() {
    borrow let c = count() {
        install(7)
        print("{}", c)
    }
}
