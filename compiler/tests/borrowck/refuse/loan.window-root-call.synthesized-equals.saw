// refuses: loan.window-root-call at 46:12
// a synthesized `==` runs its members' `equals`, so the call inside the
// window reaches the root a member's `equals` opens (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

struct Key {
    n: Int
}

extension Key: Equatable {
    func equals(&self, other: &Key) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

struct Pair {
    k: Key
}

@synthesize
extension Pair: Equatable {}

func main() {
    let a = Pair(k: Key(n: 1))
    let b = Pair(k: Key(n: 2))
    borrow let c = count() {
        if a == b {
            print("{}", c)
        }
    }
}
