// refuses: loan.window-root at 27:36
// a place reached through a forced conditional lend charges its root as any
// window does (conformance X41, the `!` head)

struct Pair { a: Int, b: Int }

extension Pair {
    func opt(&var self, i: Int) borrows -> &var Int? {
        if i > 1 {
            return None
        }
        if i == 0 {
            lend self.a
        } else {
            lend self.b
        }
    }
}

func set_both(x: &var Int, y: &var Int) {
    x = 50
    y = 60
}

func main() {
    var p = Pair(a: 1, b: 2)
    set_both(borrow var p.opt(0)!, borrow var p.opt(1)!)
    print(p.a)
}
