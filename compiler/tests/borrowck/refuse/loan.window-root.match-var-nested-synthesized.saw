// refuses: loan.window-root at 43:13
// a `var` payload nested in a pattern over a conditional lend through an
// accessor with a `@synthesize(shared)` form takes the exclusive form, so a
// second lend of the root inside the arm conflicts with its window, and
// growing the payload through the binding cannot free what that lend points
// into (SL-906)

struct E { n: Int, items: Vector<Int> }
extension E: NoCopy {}
enum Sl { case Full(e: E), case Empty }
extension Sl: NoCopy {}

func grow(v: &var Vector<Int>) {
    var k = 0
    while k < 256 {
        try! v.push(k)
        k += 1
    }
}

func fresh() -> E {
    var items = Vector<Int>()
    try! items.push(41)
    E(n: 1, items: move items)
}

struct C { slot: E, sl: Sl }
extension C: NoCopy {}
extension C {
    @synthesize(shared)
    func sfind(&var self, i: Int) borrows -> &var Sl? {
        if i != 0 {
            return None
        }
        lend self.sl
    }
}

func main() {
    var c = C(slot: fresh(), sl: Sl.Full(e: fresh()))
    match c.sfind(0) {
        case Some(Full(var e)) -> {
            if let xs = c.sfind(0) {
                match xs {
                    case Full(x) -> {
                        borrow let r = x.items[0] {
                            grow(&var e.items)
                            print(r)
                        }
                    },
                    case Empty -> {}
                }
            }
        },
        case _ -> {}
    }
}
