// refuses: loan.window-root at 37:14
// a `for` over a borrowing struct holds its producer's window, shared on the receiver's root, for the whole loop, so growing the walked vector inside the body conflicts with it while the walker that points into it is live (spec, Borrowing structs)

struct Shelf { items: Vector<Int> }
extension Shelf: NoCopy {}

borrows struct Walker {
    shelf: &Shelf,
    at: Int
}

extension Walker: NoCopy {}

extension Walker: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.at >= self.shelf.items.len() {
            return None
        }
        let v = self.shelf.items[self.at]
        self.at = self.at + 1
        v
    }
}

extension Shelf {
    func walk(&self) borrows -> Walker {
        Walker(shelf: lends self, at: 0)
    }
}

func main() {
    var s = Shelf(items: Vector<Int>())
    try! s.items.push(3)
    var sum = 0
    for x in s.walk() {
        try! s.items.push(x)
        sum = sum + x
    }
    print(sum)
}
