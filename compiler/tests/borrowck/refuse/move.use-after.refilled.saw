// refuses: move.use-after at 20:17
// a `consumes` body borrows the whole receiver after a field moved out and
// was assigned again: a write to a part of a partial path leaves it partial,
// so the receiver is not whole again (conformance V130)

struct Res { id: Int }
extension Res: NoCopy {}

struct Pair { a: Res, b: Res }
extension Pair: NoCopy {}

extension Pair {
    func total(&self) -> Int {
        self.a.id + self.b.id
    }

    func split(&var self) consumes -> Res {
        let a = move self.a
        self.a = Res(id: 5)
        let n = self.total()
        Res(id: a.id + n)
    }
}

func main() {
    let p = Pair(a: Res(id: 1), b: Res(id: 2))
    print((move p).split().id)
}
