// refuses: loan.window-root-call at 62:36
// a `Vector` literal pushes each entry, which allocates through the vector's allocator, so one over an
// allocator that opens a window on a static root is refused inside that window (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

struct Heap {
}

extension Heap: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        install(size)
        GlobalAllocator().alloc(size, align)
    }

    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let v: Vector<Int, Heap> = [1, 2]
        print("tag {} {}", b.tag, v.len())
    }
}
