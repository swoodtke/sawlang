// refuses: loan.window-root-opaque at 27:9
// a call of the function's own non-escaping function parameter inside a
// window on a root: its argument is unseen, and may open a window on it
// (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func run(body: () sync -> Void) {
    borrow let c = count() {
        body()
        print("{}", c)
    }
}

func main() {
    run({ install(1) })
}
