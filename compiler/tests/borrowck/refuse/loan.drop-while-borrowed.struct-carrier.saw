// refuses: loan.drop-while-borrowed at 32:9
// replacing a `for` loop's root drops the value the borrowing struct the head lends points into, while it is live (spec, Borrowing structs)

struct Tally { n: Int }
extension Tally: NoCopy {}

borrows struct Steps {
    tally: &Tally,
    at: Int
}

extension Tally {
    func steps(&self) borrows -> Steps {
        Steps(tally: lends self, at: 0)
    }
}

extension Steps: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.at >= self.tally.n {
            return None
        }
        self.at = self.at + 1
        self.at
    }
}

func main() {
    var t = Tally(n: 2)
    for x in t.steps() {
        t = Tally(n: x)
    }
    print(t.n)
}
