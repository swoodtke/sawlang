// refuses: loan.window-root-call at 30:9
// an exclusive window on a static root held across a call that, through two
// functions, opens an exclusive window on the whole static (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func reset() {
    install(99)
}

func main() {
    borrow var c = count_slot() {
        reset()
        c = c + 1
    }
}
