// refuses: loan.move-while-borrowed at 28:17
// the handle variable is assigned another task's handle, so the first task's
// handle is discarded and its borrow of `buf` lasts to the group's drop: the
// join of the rebound variable releases nothing, and the move is refused.
func fill(v: &var Vector<Int>, n: Int) -> Int {
    var i = 0
    while i < n {
        try! v.push(i)
        i = i + 1
    }
    v.len()
}

func quick() -> Int {
    7
}

func consume(v: Vector<Int>) -> Int {
    v.len()
}

func main() {
    var buf: Vector<Int> = []
    var group = TaskGroup()
    var h = group.spawn(fill(&var buf, 200))
    h = group.spawn(quick())
    print("quick {}", h.join())
    let taken = consume(move buf)
    print("taken {}", taken)
}
