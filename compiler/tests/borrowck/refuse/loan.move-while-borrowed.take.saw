// refuses: loan.move-while-borrowed at 13:24
// a non-escaping `[move r]` of a binding a live borrow holds

struct Res { id: Int }
extension Res: NoCopy {}

func run(body: () -> Int) -> Int { body() }
func sink(r: Res) -> Int { r.id }
func both(a: &Res, n: Int) -> Int { a.id + n }

func main() {
    let r = Res(id: 1)
    print(both(&r, run({ [move r] in sink(move r) })))
}
