// refuses: loan.window-root-call at 30:9
// a closure literal passed to a non-escaping parameter counts as called at
// the call, so its call of `install` inside the window is refused (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func install(n: Int) {
    boot_slot() = Boot(count: n, tag: n)
}

func run(body: () sync -> Void) {
    body()
}

func main() {
    borrow let c = count() {
        run({ install(1) })
        print("{}", c)
    }
}
