// refuses: loan.window-root-call at 49:14
// a `Set` of tuples hashes and compares each element by its parts, so an insert inside a window on a
// static root a part opens is refused (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

extension HKey: Comparable {
    func compare(&self, other: &Self) -> Ordering {
        install(self.n)
        self.n.compare(&other.n)
    }
}

func main() {
    var tuples = Set<(HKey, Int)>()
    borrow var b = boot_slot() {
        b.tag = 7
        try! tuples.insert((HKey(n: 50), 1))
        print("tag {} {}", b.tag, tuples.len())
    }
}
