// refuses: loan.window-root at 20:36
// a window beside a `&var` of a field of its root: a window charges its whole
// root, so field disjointness does not apply (conformance X20, X31)

struct Pair { a: Int, b: Int }

extension Pair {
    func first(&var self) borrows -> &var Int {
        lend self.a
    }
}

func set_both(x: &var Int, y: &var Int) {
    x = 50
    y = 60
}

func main() {
    var p = Pair(a: 1, b: 2)
    set_both(borrow var p.first(), &var p.b)
    print(p.a)
}
