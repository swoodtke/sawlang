// A borrow a `group.spawn` root takes of its spawner is a loan its handle
// carries (SL:coroutines A8c): a `&var` argument joined before the root is
// touched again; a `[&var]` capture likewise; two shared `&` arguments beside
// a read of the root; a join chained onto the spawn; a spawn joined inside a
// loop body; a discarded handle released by its group's drop at the end of
// an inner scope; and a reference parameter's referent spawned into the
// caller's group and joined before the return.
func fill(v: &var Vector<Int>, n: Int) -> Int {
    var i = 0
    while i < n {
        try! v.push(i)
        i = i + 1
    }
    v.len()
}

func bump(n: &var Int) -> Int {
    n = n + 1
    n
}

func look(n: &Int) -> Int {
    n + 1
}

func run(f: () -> Int) -> Int {
    f()
}

func through(v: &var Int, group: &TaskGroup) -> Int {
    let h = group.spawn(bump(&var v))
    h.join()
}

func main() {
    var buf: Vector<Int> = []
    var n = 1
    let base = 7
    var group = TaskGroup()
    let h = group.spawn(fill(&var buf, 3))
    print("{}", h.join())
    print("{}", buf.len())
    let c = group.spawn(run({ [&var n] in n = n + 1; n }))
    print("{}", c.join())
    n = n + 1
    let a = group.spawn(look(&base))
    let b = group.spawn(look(&base))
    print("{} {} {}", base, a.join(), b.join())
    let r = group.spawn(bump(&var n)).join()
    print("{}", r)
    var k = 0
    while k < 2 {
        let t = group.spawn(fill(&var buf, 1))
        print("{}", t.join())
        k = k + 1
    }
    if k > 0 {
        var inner = TaskGroup()
        let _ = inner.spawn(bump(&var n))
    }
    n = n + 1
    print("{}", through(&var n, &group))
}
