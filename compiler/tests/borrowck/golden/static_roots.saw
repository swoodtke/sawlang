// Root functions' prologues accepted: a `lend` rooted in the declared static,
// a field path under it, a forced optional payload, a conditional lend, a
// `static func`, a generic function and a body that suspends, each declaring
// the root it lends. No call stands in this file, since the call sites of a
// root function are not lowered yet (SL-1156).
import std.task.*

struct System { n: Int }

struct Pair { depth: Int, width: Int }

struct Boot {
    system: System?
    pair: Pair
    count: Int
}

unsafe static var BOOT: Boot

func whole() unsafe borrows(BOOT) -> &Boot {
    lend BOOT
}

func system() unsafe borrows(BOOT.system) -> &System {
    lend BOOT.system!
}

func depth() unsafe borrows(BOOT.pair) -> &Int {
    lend BOOT.pair.depth
}

func maybe() unsafe borrows(BOOT.system) -> &System? {
    if BOOT.system.is_none() {
        return None
    }
    lend BOOT.system!
}

func count_for<T>(tag: T) unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

func slow() unsafe borrows(BOOT.count) -> &Int {
    yield_now()
    lend BOOT.count
}

extension Boot {
    static func count() unsafe borrows(BOOT.count) -> &Int {
        lend BOOT.count
    }
}

func main() {
    print(1)
}
