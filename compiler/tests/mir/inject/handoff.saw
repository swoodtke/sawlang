// The program compiler/mir/tests/verify_moves.saw loads: `give` writes `&t`
// for a by-value `T`. Lowered, it would be a move out through a reference,
// `move (*_3)`, which the verifier reports; typecheck refuses the sigil first,
// since a call site mirrors its parameter's reference spelling (SL-484).

struct Holder<T> {
    n: Int
}

extension Holder<T> {
    func take(&self, v: T) -> Int {
        1
    }

    func give(&self, t: T) -> Int {
        self.take(&t)
    }
}
