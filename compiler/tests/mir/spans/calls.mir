module calls

fn calls.twice(n: Int) -> Int {
    let _0: Int;  // return
    let _1: Int;  // param n
    let _2: Int;

    bb0: {
        _2 = Mul(copy _1, const 2: Int);  @5:5
        _0 = move _2;  @5:5
        return;  @6:1
    }
}

fn calls.pick(n: Int) -> Int {
    let _0: Int;  // return
    let _1: Int;  // param n
    let _2: Bool;
    let _3: Int;
    let _4: Int;

    bb0: {
        _2 = Eq(copy _1, const 0: Int);  @9:5
        switch move _2 -> [true: bb2, false: bb3];  @9:5
    }

    bb1: {
        return;  @13:1
    }

    bb2: {
        goto -> bb4;  @9:5
    }

    bb3: {
        goto -> bb5;  @9:5
    }

    bb4: {
        _3 = call calls.twice(n: Int) [const 1: Int] -> [return: bb6];  @10:19
    }

    bb5: {
        _4 = call calls.twice(n: Int) [copy _1] -> [return: bb7];  @11:19
    }

    bb6: {
        _0 = move _3;  @10:19
        goto -> bb1;  @9:5
    }

    bb7: {
        _0 = move _4;  @11:19
        goto -> bb1;  @9:5
    }
}

fn calls.spin(n: Int) -> Int {
    let _0: Int;  // return
    let _1: Int;  // param n
    let _2: Int;  // k
    let _3: Bool;
    let _4: Int;
    let _5: Int;
    let _6: Int;

    bb0: {
        _2 = const 0: Int;  @16:13
        goto -> bb1;  @17:5
    }

    bb1: {
        _3 = Lt(copy _2, copy _1);  @17:11
        switch move _3 -> [true: bb3, false: bb2];  @17:5
    }

    bb2: {
        _0 = copy _2;  @20:5
        return;  @21:1
    }

    bb3: {
        _4 = copy _2;  @18:13
        _5 = call calls.twice(n: Int) [const 1: Int] -> [return: bb4];  @18:17
    }

    bb4: {
        _6 = Add(move _4, move _5);  @18:13
        _2 = move _6;  @18:9
        budget(yield-capable);  @17:5
        goto -> bb1;  @17:5
    }
}

fn calls.main() -> Void {
    let _0: Void;  // return
    let _1: Int;
    let _2: Bool;
    let _3: Int;

    bb0: {
        _1 = call calls.pick(n: Int) [const 2: Int] -> [return: bb2];  @24:8
    }

    bb1: {
        return;  @27:1
    }

    bb2: {
        _2 = Gt(copy _1, const 1: Int);  @24:8
        switch move _2 -> [true: bb3, false: bb4];  @24:5
    }

    bb3: {
        _3 = call calls.spin(n: Int) [const 3: Int] -> [return: bb5];  @25:15
    }

    bb4: {
        goto -> bb1;  @24:5
    }

    bb5: {
        call builtin print [copy _3] -> [return: bb6];  @25:9
    }

    bb6: {
        goto -> bb1;  @24:5
    }
}
