// Which `copy()` a copy the lowering inserts runs: the one a `Copy`
// conformance writes, at a binding, and for a spelled `[copy x]` of an
// ExplicitCopy type the one its conformance writes. A `copy` method of an
// extension that declares no policy is an ordinary method: a binding, a
// tuple and every capture copy the bits, trivial or owning, and only a
// spelled call runs it (`declared_copy`).

struct Plain {
    n: Int
}

extension Plain {
    func copy(&self) -> Plain {
        Plain(n: self.n + 100)
    }
}

struct Owned {
    s: String
}

extension Owned {
    func copy(&self) -> Owned {
        Owned(s: "other")
    }
}

struct Hooked {
    n: Int
}

extension Hooked: Copy {
    func copy(&self) -> Hooked {
        Hooked(n: self.n + 1)
    }
}

struct Dup {
    n: Int
}

extension Dup: ExplicitCopy {
    func copy(&self) -> Dup {
        Dup(n: self.n)
    }
}

func call(f: () -> Int) -> Int {
    f()
}

func plain(p: Plain) -> Int {
    let a = p
    let t = (p, 1)
    let c = call({ [p] in p.n }) + call({ [copy p] in p.n }) + call({ p.n })
    let spelled = p.copy()
    a.n + t.0.n + c + spelled.n
}

func owned(o: Owned) -> Int {
    let a = o
    a.s.len() + o.s.len()
}

func hooked(h: Hooked) -> Int {
    let a = h
    a.n + h.n
}

func dup(d: Dup) -> Int {
    call({ [copy d] in d.n })
}
