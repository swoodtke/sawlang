// A call that leaves out a defaulted argument is two calls at one node: the
// default's own body, then the function. Each is a suspension point as its
// own summary makes it. A suspending default makes its function suspending
// (LANGUAGE_SPEC, "Default parameter values"), so both of `fills()`'s calls
// suspend, and so does `explicit()`'s, which passes the argument. A literal
// default never suspends, whether its function does (`body_fills`) or not
// (`control`), and in a generic body only the function's call carries the
// condition. A spawn root's default is evaluated by the spawner, so its call
// is the spawner's suspension point.

import std.task.{yield_now}

func slow() -> Int {
    yield_now()
    4
}

func with_slow(n: Int = slow()) -> Int {
    n + 1
}

func with_literal(n: Int = 3) -> Int {
    yield_now()
    n + 1
}

func quiet(n: Int = 3) -> Int {
    n + 1
}

trait Worker {
    func step(&self) -> Int
}

func run<T: Worker>(t: &T, n: Int = 3) -> Int {
    t.step() + n
}

func fills() -> Int {
    with_slow()
}

func explicit() -> Int {
    with_slow(n: 2)
}

func body_fills() -> Int {
    with_literal()
}

func control() -> Int {
    quiet()
}

func generic<T: Worker>(t: &T) -> Int {
    run(&t)
}

func spawner() -> Int {
    let t = Task.spawn(with_slow())
    t.join()
}
