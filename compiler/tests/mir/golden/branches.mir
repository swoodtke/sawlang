module branches

fn branches.check(n: Int) -> Bool {
    let _0: Bool;  // return
    let _1: Int;  // param n
    let _2: Bool;

    bb0: {
        _2 = Gt(copy _1, const 2: Int);
        _0 = move _2;
        return;
    }
}

fn branches.parse(n: Int) -> Result<Int, branches.Fault> {
    let _0: Result<Int, branches.Fault>;  // return
    let _1: Int;  // param n
    let _2: Bool;
    let _3: branches.Fault;
    let _4: Result<Int, branches.Fault>;
    let _5: Result<Int, branches.Fault>;

    bb0: {
        _2 = Lt(copy _1, const 0: Int);
        switch move _2 -> [true: bb2, false: bb3];
    }

    bb1: {
        _5 = Result<Int, branches.Fault>::Ok(copy _1);
        _0 = move _5;
        return;
    }

    bb2: {
        _3 = branches.Fault::Broken;
        _4 = Result<Int, branches.Fault>::Err(move _3);
        _0 = move _4;
        return;
    }

    bb3: {
        goto -> bb1;
    }
}

fn branches.logic(a: Int, b: Int) -> Bool {
    let _0: Bool;  // return
    let _1: Int;  // param a
    let _2: Int;  // param b
    let _3: Bool;
    let _4: Bool;
    let _5: Bool;
    let _6: Bool;
    let _7: Bool;

    bb0: {
        _5 = call branches.check(n: Int) [copy _1] -> [return: bb3];
    }

    bb1: {
        _0 = move _3;
        return;
    }

    bb2: {
        switch move _4 -> [true: bb8, false: bb7];
    }

    bb3: {
        switch move _5 -> [true: bb4, false: bb5];
    }

    bb4: {
        _6 = call branches.check(n: Int) [copy _2] -> [return: bb6];
    }

    bb5: {
        _4 = const false: Bool;
        goto -> bb2;
    }

    bb6: {
        _4 = move _6;
        goto -> bb2;
    }

    bb7: {
        _7 = Eq(copy _1, copy _2);
        _3 = move _7;
        goto -> bb1;
