    bb5: {
        switch discriminant(_7) -> [Ok: bb6, Err: bb7];
    }

    bb6: {
        _8 = Int?::Some(copy (_7 as Ok).0);
        goto -> bb8;
    }

    bb7: {
        _8 = Int?::None;
        goto -> bb8;
    }

    bb8: {
        _6 = move _8;
        drop(_7);
        switch discriminant(_6) -> [Some: bb10, None: bb11];
    }

    bb9: {
        switch discriminant(_6) -> [Some: bb12, None: bb13];
    }

    bb10: {
        _9 = copy (_6 as Some).0;
        _10 = Result<Int, branches.Fault>::Ok(copy _9);
        _0 = move _10;
        return;
    }

    bb11: {
        goto -> bb9;
    }

    bb12: {
        _11 = copy (_6 as Some).0;
        _14 = Int?::Some(copy _11);
        _13 = move _14;
        goto -> bb14;
