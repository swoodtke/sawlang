    bb2: {
        _2 = copy (_3 as Ok).0;
        drop(_3);
        _5 = call branches.parse(n: Int) [copy _2] -> [return: bb4];
    }

    bb3: {
        _0 = Result<Int, branches.Fault>::Err(copy (_3 as Err).0);
        drop(_3);
