    }

    bb15: {
        _17 = Add(copy _2, copy _4);
        _18 = Result<Int, branches.Fault>::Ok(move _17);
        _0 = move _18;
        return;
    }

    bb16: {
        _15 = copy (_13 as Some).0;
        _16 = Int?::None;
        _13 = move _16;
        budget(yield-capable);
        goto -> bb14;
    }

    bb17: {
        goto -> bb15;
    }
}
