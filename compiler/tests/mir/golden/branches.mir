fn branches.tries(n: Int) -> Result<Int, branches.Fault> {
    let _0: Result<Int, branches.Fault>;  // return
    let _1: Int;  // param n
    let _2: Int;  // a
    let _3: Result<Int, branches.Fault>;
    let _4: Int;  // b
    let _5: Result<Int, branches.Fault>;
