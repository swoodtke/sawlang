    bb8: {
        _3 = const true: Bool;
        goto -> bb1;
    }
}

fn branches.coalesce(first: Int?, second: Int?, last: Int) -> Int {
    let _0: Int;  // return
    let _1: Int?;  // param first
    let _2: Int?;  // param second
    let _3: Int;  // param last
    let _4: Int;
    let _5: Int?;
    let _6: Int?;

    bb0: {
        _5 = copy _1;
        switch discriminant(_5) -> [Some: bb2, None: bb3];
    }

    bb1: {
        _0 = move _4;
        return;
    }

    bb2: {
        _4 = copy (_5 as Some).0;
        goto -> bb1;
    }

    bb3: {
        _6 = copy _2;
        switch discriminant(_6) -> [Some: bb4, None: bb5];
    }

    bb4: {
        _4 = copy (_6 as Some).0;
        goto -> bb1;
    }

    bb5: {
        _4 = copy _3;
        goto -> bb1;
