module catches

fn catches.risky(n: Int) -> Result<Int, catches.Fault> {
    let _0: Result<Int, catches.Fault>;  // return
    let _1: Int;  // param n
    let _2: Bool;
    let _3: catches.Fault;
    let _4: Result<Int, catches.Fault>;
    let _5: Result<Int, catches.Fault>;

