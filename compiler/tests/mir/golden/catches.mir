        _2 = Lt(copy _1, const 0: Int);
        switch move _2 -> [true: bb2, false: bb3];
    }

    bb1: {
        _5 = Result<Int, catches.Fault>::Ok(copy _1);
        _0 = move _5;
        return;
    }

    bb2: {
        _3 = catches.Fault { code: copy _1 };
        _4 = Result<Int, catches.Fault>::Err(move _3);
        _0 = move _4;
        return;
    }

    bb3: {
        goto -> bb1;
    }
}

