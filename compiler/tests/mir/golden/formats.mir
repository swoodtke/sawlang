module formats

fn formats.report(count: Int, name: String) -> Void {
    let _0: Void;  // return
    let _1: Int;  // param count
    let _2: String;  // param name
    let _3: &String;
    let _4: &String;
    let _5: String;
    let _6: Bool;

    bb0: {
        call builtin print [format "count = {}", copy _1] -> [return: bb1];
    }

    bb1: {
        _3 = ref(shared, _2);
        call builtin print [format "{} and {}", move _3, copy _1] -> [return: bb2];
    }

    bb2: {
        call builtin print [const "braces \{\} only": String] -> [return: bb3];
    }

    bb3: {
        _4 = ref(shared, _2);
        _5 = interpolate [const "hello ": String, move _4];
        call builtin print [move _5] -> [return: bb4];
    }

    bb4: {
        _6 = Ge(copy _1, const 0: Int);
        call builtin assert [move _6, format "a negative count: {}", copy _1] -> [return: bb5];
    }

    bb5: {
        drop(_2);
        return;
    }
}

fn formats.fail(code: Int) -> Never {
    let _0: Never;  // return
    let _1: Int;  // param code

    bb0: {
        call builtin panic [format "failed with {}", copy _1] -> !;
    }
}
