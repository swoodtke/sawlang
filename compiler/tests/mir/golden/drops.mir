    bb19: {
        _16 = Result<Int, drops.Fault>::Ok(const 0: Int);
        _0 = move _16;
        drop(_2);
        return;
    }

    bb20: {
        _17 = move _18;
        _19 = Result<Int, drops.Fault>::Ok(copy _4);
        _0 = move _19;
