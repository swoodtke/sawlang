fn drops.temporaries() -> Int {
    let _0: Int;  // return
    let _1: Int;  // length
    let _2: String;
    let _3: &String;
    let _4: Int;
    let _5: String;
    let _6: String;
    let _7: &String;

    bb0: {
        _2 = call drops.make() [] -> [return: bb1];
