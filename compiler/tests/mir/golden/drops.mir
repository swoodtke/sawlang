    bb1: {
        _3 = ref(shared, _2);
        _4 = call std.string.String.len() (owner String) [move _3] -> [return: bb2];
    }

    bb2: {
        _1 = move _4;
        drop(_2);
        _5 = call drops.make() [] -> [return: bb3];
    }

    bb3: {
        drop(_5);
        _6 = call drops.make() [] -> [return: bb4];
    }

    bb4: {
        _7 = ref(shared, _6);
        call builtin print [format "{}", move _7] -> [return: bb5];
