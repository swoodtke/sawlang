// A reference read out of a part, an Optional's payload or a tuple's element:
// an exclusive one moves, a reborrow out of a container dead after it, and a
// shared one is copied.

func wrap<R>(f: (&var Int) -> R, r: &var Int) -> R? {
    f(r)
}

func view<R>(f: (&Int) -> R, r: &Int) -> R? {
    f(r)
}

func pair<R>(f: (&var Int) -> R, r: &var Int) -> (R, Int) {
    (f(r), 1)
}

func exclusive(n: &var Int) -> Int {
    if let r = wrap({ m: &var Int in m }, n) {
        return r + 1
    }
    0
}

func shared(n: &Int) -> Int {
    if let r = view({ m: &Int in m }, n) {
        return r + 1
    }
    0
}

func element(n: &var Int) -> Int {
    let (r, k) = pair({ m: &var Int in m }, n)
    r + k
}

func main() {
    var a = 1
    print(exclusive(&var a) + shared(&a) + element(&var a))
}
