// References reached through `borrows` accessors: a conditional lend's
// present edge hands out the lent `&var` or `&` itself and its forced place is
// reborrowed, and an accessor's epilogue moves the exclusive receiver out of
// its state record's tuple element.

struct Grid {
    cells: [Int; 4],
    flag: Int?,
    reads: Int
}

extension Grid {
    func slot(&var self) borrows -> &var Int? {
        if self.flag.is_none() {
            return None
        }
        lend self.flag!
    }

    func peek(&self) borrows -> &Int? {
        if self.flag.is_none() {
            return None
        }
        lend self.flag!
    }

    func counted(&var self, i: Int) borrows -> &var Int {
        let tag = "read"
        lend self.cells[i]
        self.reads = self.reads + tag.len()
    }
}

func inc(n: &var Int) {
    n += 1
}

func exclusive(g: &var Grid) -> Int {
    if borrow var r = g.slot() {
        r += 1
    }
    inc(borrow var g.slot()!)
    g.reads
}

func shared(g: &Grid) -> Int {
    if let r = g.peek() {
        return r + 1
    }
    0
}

func element(g: &var Grid) -> Int {
    g.counted(0) += 1
    g.counted(1)
}

func main() {
    var g = Grid(cells: [1, 2, 3, 4], flag: 5, reads: 0)
    print(exclusive(&var g) + shared(&g) + element(&var g))
}
