module peel

fn peel.peel(v: std.vector.Vector<Int?, std.alloc.GlobalAllocator>, o: Int?, p: Int?) -> Int {
    let _0: Int;  // return
    let _1: std.vector.Vector<Int?, std.alloc.GlobalAllocator>;  // param v
