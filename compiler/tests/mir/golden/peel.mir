    let _11: Int?;
    let _12: Int;
    let _13: Int?;
    let _14: Int;
    let _15: Int?;
    let _16: Int;

    bb0: {
        _6 = ref(shared, _1);
        _7 = call std.vector.Vector.get(index: Int) (owner std.vector.Vector<Int?, std.alloc.GlobalAllocator>) [move _6, const 0: Int] -> [return: bb2];
    }

    bb1: {
        _4 = move _5;
