// refuses: slice.not-yet at 15:45
// A `consumes` body whose receiver's type writes its own `deinit` and that
// moves the receiver out whole: its release is not lowered yet.

struct Res { id: Int }
extension Res: NoCopy {
    func deinit(&var self) {
        print("released")
    }
}

func keep(r: Res) -> Int { r.id }

extension Res {
    func hand_on(&var self) consumes -> Int {
        keep(move self)
    }
}
