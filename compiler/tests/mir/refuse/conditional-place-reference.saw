// refuses: slice.not-yet at 23:38
// a `borrow` binding of a conditional lend passed by reference: a `&Int?`
// would point at a `T?` that no storage holds (SL-835)

struct Row {
    cells: [Int; 4]
}

extension Row {
    func find(&var self, i: Int) borrows -> &var Int? {
        if i < 0 || i >= 4 {
            return None
        }
        lend self.cells[i]
    }
}

func look(o: &Int?) -> Int {
    if let n = o { n } else { 0 }
}

func read(r: &var Row) -> Int {
    borrow let e = r.find(1) { look(&e) }
}
