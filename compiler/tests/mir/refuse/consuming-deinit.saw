// refuses: slice.not-yet at 20:14
// A consuming destructure of a type that writes its own `deinit`: the spec
// does not say whether dissolving one skips that body.

struct Res { id: Int }
extension Res: NoCopy {}

enum Guarded {
    case Held(r: Res),
    case Idle
}
extension Guarded: NoCopy {
    func deinit(&var self) {
        print("released")
    }
}

func take(g: Guarded) -> Int {
    match g {
        case Held(r) -> r.id,
        case Idle -> 0
    }
}
