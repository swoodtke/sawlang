// refuses: mono.not-yet at 10:12
// An escaping closure that captures a value: the backend builds its
// environment in `make`'s frame, which is gone once `make` returns, so the
// call in `main` would read a dead frame (SL-608). Typecheck through drop
// elaboration accept the program; mono refuses it until SL-525.
struct Res { n: Int }

func make(r: &Res) -> () -> Int {
    let n = r.n
    return { [n] in n }
}

func main() {
    let x = Res(n: 42)
    let f = make(&x)
    print("{}", f())
}
