// refuses: constant.divide-by-zero at 11:17
// message: divides by zero
// message: (in the instantiation `f<0>`)
// A faulting argument of a struct that has no array is refused as well.

struct Tag<const M: Int> {
    x: Int
}

func f<const N: Int>() -> Int {
    let t = Tag<8 / N>(x: 7)
    t.x
}

func main() {
    print(f<0>())
}
