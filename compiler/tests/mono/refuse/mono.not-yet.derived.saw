// refuses: mono.not-yet at 15:5
// A struct's derived `Equatable` asks each field's own `equals` through the
// requirement funnel. A `Float` field's is a cell the member glue table
// refuses, since the backend lowers no Float operation (SL-722), and the
// refusal lands where the derived `equals` was first reached.
struct Reading {
    id: Int,
    value: Float
}

@synthesize
extension Reading: Equatable {}

func same<T: Equatable>(a: &T, b: &T) -> Bool {
    a.equals(&b)
}

func main() {
    let r = Reading(id: 1, value: 0.5)
    print("{}", same(&r, &r))
}
