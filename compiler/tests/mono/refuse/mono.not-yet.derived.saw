// refuses: mono.not-yet at 15:5
// A struct's derived `Comparable` asks each field's own `compare` through the
// requirement funnel. A `Bool` field's is a cell the member glue table
// refuses, since the spec gives `Bool` no builtin `Comparable` (SL-715), and
// the refusal lands where the derived `compare` was first reached.
struct Reading {
    id: Int,
    on: Bool
}

@synthesize
extension Reading: Comparable {}

func order<T: Comparable>(a: &T, b: &T) -> Bool {
    a.compare(&b) == Ordering.Less
}

func main() {
    let r = Reading(id: 1, on: true)
    print("{}", order(&r, &r))
}
