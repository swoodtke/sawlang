// refuses: type.too-large at 10:15
// message: more than the 2147483647 bytes (2^31-1) a type may hold on any target
// A `static_assert` that measures a type whose size passes the 64-bit `Int`
// is refused as an overflow, not read as a layout this compiler lacks.

struct Huge {
    d: [UInt64; 2305843009213693952]
}

static_assert(sizeof<Huge>() > 0, "measured")

func main() {
    print(1)
}
