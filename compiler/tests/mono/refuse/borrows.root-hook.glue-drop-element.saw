// refuses: borrows.root-hook at 47:10
// A `Vector<W<R>>` drops each element through `__saw_deinit_in_place`, which reaches the instance's
// `deinit` (SL-1156).
// message: may open a window on

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

trait Cleanup {
    func cleanup(&self)
}

struct R {
    n: Int
}

extension R: Cleanup {
    func cleanup(&self) {
        install(self.n)
    }
}

struct W<T: Cleanup> {
    t: T
}

extension W<T: Cleanup>: NoCopy {
    func deinit(&var self) {
        self.t.cleanup()
    }
}

func main() {
    var v = Vector<W<R>>()
    try! v.push(W(t: R(n: 1)))
    print("{}", v.len())
}
