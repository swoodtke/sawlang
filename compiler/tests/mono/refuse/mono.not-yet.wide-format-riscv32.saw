// refuses: mono.not-yet at 9:16
// flags: --target riscv32-unknown-none-elf
// An integer wider than riscv32's 32-bit word has no `Int` for the builder's
// `append(value: Int)` to take, so its `Printable.format` glue is refused
// rather than written through a narrowing; an interpolation reaches it.

func main() {
    let wide: Int64 = 1 << 40
    let text = "{wide}"
    print("{}", text.len())
}
