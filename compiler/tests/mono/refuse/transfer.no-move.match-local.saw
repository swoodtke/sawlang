// refuses: transfer.no-move at 21:11
// A local the generic body built itself is relocated by a consuming `match`
// as a parameter is (SL-681).

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {}
extension Pinned: NoMove {}

enum Wrap<T> {
    case Full(v: T),
    case Blank
}

extension Wrap<T>: NoCopy {}

func look<T>() -> Int {
    let w = Wrap<T>.Blank
    match w {
        case Full(v) -> 1,
        case Blank -> 0
    }
}

func main() {
    let n = look<Pinned>()
}
