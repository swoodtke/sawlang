// refuses: mono.not-yet at 8:13
// A refusal met inside std is reported at the program's own call that
// reached it, the std position named in its message: `Set.copy()` copies
// each `String` element through `ExplicitCopy.copy()`, which the slice does
// not resolve on `String`.
func main() {
    var s = Set<String>()
    let t = s.copy()
    print("{} {}", s.len(), t.len())
}
