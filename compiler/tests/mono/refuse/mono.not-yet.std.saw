// refuses: mono.not-yet at 10:5
// A refusal met inside std is reported at the program's own call that
// reached it, the std position named in its message: `Vector.sort` orders
// its elements through `Comparable.compare`, which the scalar table refuses
// for `Bool` though typecheck grants the bound (SL-715).
func main() {
    var v: Vector<Bool> = Vector()
    try! v.push(true)
    try! v.push(false)
    v.sort()
    print("{}", v.len())
}
