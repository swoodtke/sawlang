// refuses: mono.not-yet at 13:5
// A struct's derived `Equatable` is synthesized glue the slice does not
// make: the scalar hook table covers the primitives alone.
struct Point {
    x: Int
    name: String
}

@synthesize
extension Point: Equatable {}

func same<T: Equatable>(a: T, b: T) -> Bool {
    a == b
}

func main() {
    print(same(Point(x: 1, name: "a"), Point(x: 1, name: "a")))
}
