// refuses: mono.not-yet at 7:5
// A tuple's `equals` asks each element's own hook through the requirement
// funnel, so an element's refusal lands where the tuple's glue was first
// reached: a raw pointer's `equals`, which the scalar table refuses though
// typecheck grants the bound (SL-715).
func same<T: Equatable>(a: T, b: T) unsafe -> Bool {
    a == b
}

func main() unsafe {
    let p = 4096 as UnsafePointer<Int>
    print(same((p, 1), (p, 1)))
}
