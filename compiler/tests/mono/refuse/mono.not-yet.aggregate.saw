// refuses: mono.not-yet at 6:5
// Typecheck grants a tuple `Comparable` through its parts, which the spec
// does not (SL-754), so the member glue table has no `compare` for one,
// whose `equals` and `hash` it builds from the parts.
func less<T: Comparable>(a: T, b: T) -> Bool {
    a < b
}

func main() {
    print(less((1, 2), (1, 3)))
}
