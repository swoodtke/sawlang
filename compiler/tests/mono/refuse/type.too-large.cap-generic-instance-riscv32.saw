// refuses: type.too-large at 9:6
// flags: --target riscv32-unknown-none-elf
// message: more than the 2147483647 bytes (2^31-1) a type may hold on any target
// A const generic whose instance passes the cap.
struct Buf<const N: Int> {
    data: [UInt64; N]
}

func main() {
    print(sizeof<Buf<1073741824>>())
}
