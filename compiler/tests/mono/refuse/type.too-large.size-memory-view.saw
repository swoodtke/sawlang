// refuses: type.too-large at 12:32
// message: more than the 2147483647 bytes (2^31-1) a type may hold on any target
// A view built over a constant address of a type whose size passes the 64-bit
// `Int` is refused as an overflow, where the misalignment check had no layout
// to read.

struct Huge {
    d: [UInt64; 2305843009213693952]
}

func reach() unsafe -> UInt64 {
    UnsafeMemory<Huge, Normal>(0x2000).read().d[0]
}

func main() {
    print(0)
}
