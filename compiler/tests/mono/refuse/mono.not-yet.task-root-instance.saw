// refuses: mono.not-yet at 9:5
// message: (in the instantiation `order<Bool>`)
// One instance that is two items, the generic called directly and spawned,
// each its own item: the refusal is reported once, naming the instance.
import std.task.*

func order<T: Comparable>(a: T, b: T) -> Bool {
    yield_now()
    a < b
}

func main() {
    print(order(false, true))
    var group = TaskGroup()
    let h = group.spawn(order(true, false))
    print(h.join())
}
