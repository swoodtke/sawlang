// refuses: mono.not-yet at 9:5
// message: (in the instantiation `order<Float>`)
// One instance that is two items, called directly and spawned: the refusal,
// a generic `<=` at `Float`, is reported once, naming it (SL-722 Q3).
import std.task.*

func order<T: Comparable>(a: T, b: T) -> Bool {
    yield_now()
    a <= b
}

func main() {
    print(order(1.5, 2.5))
    var group = TaskGroup()
    let h = group.spawn(order(2.5, 1.5))
    print(h.join())
}
