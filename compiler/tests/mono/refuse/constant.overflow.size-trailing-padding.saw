// refuses: constant.overflow at 11:6
// message: is larger than `Int` counts on this target
// A struct whose fields fit a 64-bit `Int` and whose size overflows only by
// its trailing padding: 8 + (2^63 - 11) = 2^63 - 3, rounded up to the
// alignment of 8 is 2^63.
struct Tail {
    w: UInt64
    b: [UInt8; 9_223_372_036_854_775_797]
}

func main() {
    print("{}", sizeof<Tail>())
}
