// refuses: type.mismatch at 13:17
// message: the constant argument `K + 1` is 256, which does not fit `UInt8`, the type of `N`
// message: (in the instantiation `tagged<255>`)
// A struct's argument computed over a parameter of another type does not fit
// at one instance, though the struct has no array and the argument is only
// carried.

struct Tag<const N: UInt8> {
    x: Int
}

func tagged<const K: Int>() -> Int {
    let t = Tag<K + 1>(x: 7)
    t.x
}

func main() {
    print(tagged<254>() + tagged<255>())
}
