// refuses: constant.overflow at 10:6
// flags: --target riscv32-unknown-none-elf
// message: is larger than `Int` counts on this target
// Padding before the second field tips an unpadded 2^31 - 3 bytes over.
struct Padded {
    a: UInt8
    b: [UInt32; 536870911]
}

func main() {
    print(sizeof<Padded>())
}
