// refuses: mono.not-yet at 6:17
// A capturing closure pushed into a vector the caller owns: `push` takes its
// element as a type argument, which holds the value past the call (SL-608).
func fill(v: &var Vector<() -> Int>, seed: Int) {
    let n = seed
    try! v.push({ [n] in n })
}

func main() {
    var v = Vector<() -> Int>()
    fill(&var v, 42)
    let f = v[0]
    print("{}", f())
}
