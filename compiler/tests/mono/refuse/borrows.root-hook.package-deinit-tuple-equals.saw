import gpk.*
import zroot.*

struct R {
    n: Int
}

extension R: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

struct C {
    n: Int
}

extension C: Equatable {
    func equals(&self, other: &Self) -> Bool {
        self.n == other.n
    }
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        if b.tag == 7 {
            let calm = Guarded(t: C(n: 1))
            let w = Guarded(t: R(n: 42))
            print("made {} {}", calm.t.n, w.t.n)
        }
        print("tag {}", b.tag)
    }
}
