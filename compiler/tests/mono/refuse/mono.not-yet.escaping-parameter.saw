// refuses: mono.not-yet at 11:10
// A capturing closure passed to a parameter that says `escaping`, which may
// keep it past the call (SL-608).
struct Holder {
    f: () -> Int
}

func keep(f: () escaping -> Int) -> Holder { Holder(f: f) }

func make(n: Int) -> Holder {
    keep({ [n] in n })
}

func main() {
    let h = make(42)
    print("{}", h.f())
}
