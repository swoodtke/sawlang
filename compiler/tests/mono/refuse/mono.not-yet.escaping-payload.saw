// refuses: mono.not-yet at 9:19
// A capturing closure as an enum case's payload (SL-608).
enum Job {
    case Run(work: () -> Int),
    case Idle
}

func make(n: Int) -> Job {
    Job.Run(work: { [n] in n })
}

func main() {
    match make(42) {
        case Run(work) -> print("{}", work()),
        case Idle -> print("idle")
    }
}
