// refuses: type.mismatch at 7:41
// message: constant expression 9223372036854775808 does not fit in `Int`
// A `UInt64` constant expression of 2^63 is a value, spelled as one when the
// `Int` it is adopted into refuses it, not read as a negative number.

func v<const N: UInt64>() -> UInt64 { N }
func g<const K: UInt64>() -> UInt64 { v<K + 1>() }

func main() {
    print(g<9223372036854775807u64>())
}
