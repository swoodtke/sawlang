// refuses: constant.divide-by-zero at 12:7
// message: divides by zero
// message: (in the instantiation `f<0>`)
// Two faulting arguments of one call are two refusals, one at each
// expression.

func g<const A: Int, const B: Int>() -> Int {
    1
}

func f<const N: Int>() -> Int {
    g<8 / N, 9 / N>()
}

func main() {
    print(f<0>())
}
