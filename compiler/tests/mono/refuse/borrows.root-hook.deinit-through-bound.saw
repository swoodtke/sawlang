// refuses: borrows.root-hook at 46:32
// A `deinit` that reaches a static root only through a type parameter's requirement is judged at the
// instantiation the program reaches, where the scope end drops a `W<R>` (SL-1156).
// message: may open a window on

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

trait Cleanup {
    func cleanup(&self)
}

struct R {
    n: Int
}

extension R: Cleanup {
    func cleanup(&self) {
        install(self.n)
    }
}

struct W<T: Cleanup> {
    t: T
}

extension W<T: Cleanup>: NoCopy {
    func deinit(&var self) {
        self.t.cleanup()
    }
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let w = W(t: R(n: 42))
        print("made {}", w.t.n)
    }
}
