// refuses: transfer.no-move at 20:19
// A generic value `match` consumes its owned scrutinee as a statement one
// does (SL-681).

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {}
extension Pinned: NoMove {}

enum Wrap<T> {
    case Full(v: T),
    case Blank
}

extension Wrap<T>: NoCopy {}

func look<T>(w: Wrap<T>) -> Int {
    let n = match w {
        case Full(v) -> 1,
        case Blank -> 0
    }
    n
}

func main() {
    let n = look(Wrap<Pinned>.Full(v: Pinned(id: 1)))
}
