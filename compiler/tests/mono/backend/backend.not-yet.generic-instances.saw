// refuses: backend.not-yet at 7:5
// message: (in the instantiation `line_of<Int>`)
// A backend refusal inside a generic emitted at two instances: the backend
// refuses each instance's function at the one node they share, through mono's
// refusal, and each refusal names its instance, so the two lines differ.
func line_of<T>(v: T) -> Int {
    #line
}

func main() {
    print(line_of(1))
    print(line_of("x"))
}
