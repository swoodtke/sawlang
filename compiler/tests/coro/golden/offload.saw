// The offload of a `blocking` extern call (SL:coroutines A14a). The call
// keeps its arguments and is the start, which writes each into the frame's
// offload storage after the job word. Then the job's completion check, whose
// true edge is the completion exit to the take and whose false edge parks on
// the job's completion word, its pipe armed; and the park, which returns to
// the completion check: a wake that finds the job running parks again, and
// no cancel ends the wait, since nothing reads the cancel word. The take writes the
// extern's result where the call wrote it. `pause` returns nothing and takes
// no argument; `fill` takes a pointer into the frame, a narrow integer and a
// Float.
extern "C" {
    blocking func pause()
    blocking func fill(buf: UnsafePointer<Int8>, n: Int32, scale: Float) -> Int32
}

func main() unsafe {
    pause()
    var buf: [Int8; 8] = [0; 8]
    let got = fill((&buf) as UnsafePointer<Int8>, 8, 0.5)
    print("{} {}", got, buf[0])
}
