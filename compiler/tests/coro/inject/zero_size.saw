// The program compiler/coro/tests/verify_zero_size.saw lowers, then edits:
// `outer` holds `n` and `label` across its drive of `make`, whose zero-size
// result lies at the end of `make`'s frame. `outer` returns nothing, so the
// child's slot interferes with every value that holds bytes and is laid
// last, and that result lies at the end of `outer`'s frame too. One edit
// moves `label`'s drop to a slot that starts inside the frame and runs past
// its end; the other copies `make`'s result slot a second time, which only
// the drive's move-out may reach.

struct Marker {}

func make() -> Marker {
    __saw_suspend()
    Marker()
}

func outer(n: Int) {
    let label = "kept across"
    let m = make()
    let _ = m
    print("{} {}", label, n + 1)
}

func main() {
    __saw_drive(outer(4))
}
