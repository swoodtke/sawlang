// refuses: constant.overflow at 8:6
// message: is larger than `Int` counts on this target
// Two locals of 2^62 bytes each, which fit a 64-bit `Int` one by one, both
// live across one suspension: the coroutine frame holds both, 2^63 bytes,
// which does not. Never built; `coro --layouts` only.
import std.task.*

func hold() {
    var a = [0u8; 4_611_686_018_427_387_904]
    var b = [0u8; 4_611_686_018_427_387_904]
    yield_now()
    a[0] = 1
    b[0] = 2
}

func main() {
    let t = Task.spawn(hold())
    t.join()
}
