// accepts: (size 1073741840 align 8,
// flags: --max-task-frame=9223372036854775807
// One local of 2^30 bytes, half the cap on a type's size, live across a
// suspension: the frame fits. Never built; `coro --layouts` only.
import std.task.*

func hold() {
    var a = [0u8; 1_073_741_824]
    yield_now()
    a[0] = 1
}

func main() {
    let t = Task.spawn(hold())
    t.join()
}
