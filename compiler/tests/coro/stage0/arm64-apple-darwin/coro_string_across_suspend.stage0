program	coro_string_across_suspend.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"done"
stdout	""
meets_expect	yes
frame	__Frame_greet$m$	greet	72	8	states=2	own=65	sub=0	bt=0	root=0	method=0	agrees=1
field	g	own	0	16	8
field	__state	own	16	8	8
field	__wake	own	24	8	8
field	__io_tok	own	32	8	8
field	__io_deadline	own	40	8	8
field	__cancel	own	48	1	1
field	__result	own	56	16	8
bt	240	strtab=96	version=1	word_bits=64
btframe	__Frame_greet$m$	greet	coro_string_across_suspend.saw	16	0 12
