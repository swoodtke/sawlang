program	spinlock_contention_mt.saw
triple	arm64-apple-darwin
twin	differs
expect	success
build	ok
exit	0
stdout	"spawned 1000"
stdout	"total 1000"
stdout	"turns 1000"
stdout	"locked? false"
stdout	""
meets_expect	yes
frame	__Frame_contribute$m$	contribute	64	8	states=7	own=64	sub=0	bt=0	root=1	method=0	agrees=1
field	n	own	0	8	8
field	__saw_loop_budget	own	8	8	8
field	i	own	16	8	8
field	__state	own	24	8	8
field	__wake	own	32	8	8
field	__io_tok	own	40	8	8
field	__io_deadline	own	48	8	8
field	__cellp	own	56	8	8
bt	306	strtab=102	version=1	word_bits=64
btframe	__Frame_contribute$m$	contribute	spinlock_contention_mt.saw	24	0 0 0 0 0 0 29
