stdout	"drop kept"
stdout	"caught"
stdout	"-- 10 try nested in an argument's call"
stdout	"drop kept"
stdout	"caught"
stdout	"-- 11 success path"
stdout	"sink kept"
stdout	"drop kept"
stdout	"ok 11"
stdout	""
