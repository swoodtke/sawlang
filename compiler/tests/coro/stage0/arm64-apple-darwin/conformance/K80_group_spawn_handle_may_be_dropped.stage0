program	conformance/K80_group_spawn_handle_may_be_dropped.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"served 15"
stdout	""
meets_expect	yes
frame	__Frame_serve$m$	serve	48	8	states=1	own=48	sub=0	bt=0	root=1	method=0	agrees=1
field	amount	own	0	8	8
field	__state	own	8	8	8
field	__wake	own	16	8	8
field	__io_tok	own	24	8	8
field	__io_deadline	own	32	8	8
field	__cellp	own	40	8	8
bt	239	strtab=107	version=1	word_bits=64
btframe	__Frame_serve$m$	serve	K80_group_spawn_handle_may_be_dropped.saw	8	0
