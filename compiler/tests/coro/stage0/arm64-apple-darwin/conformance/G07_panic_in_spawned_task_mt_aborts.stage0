field	__wake	own	8	8	8
field	__io_tok	own	16	8	8
field	__io_deadline	own	24	8	8
field	__cellp	own	32	8	8
bt	247	strtab=103	version=1	word_bits=64
btframe	__Frame_work$m$	work	G07_panic_in_spawned_task_mt_aborts.saw	0	0 13
