program	conformance/K86_background_task_handle_panics_in_deinit.saw
triple	arm64-apple-darwin
twin	same
expect	panic
build	ok
exit	-6
stdout	"a group handle drops in silence"
stdout	"about to drop the keeper"
stdout	"the keeper forgot to join"
stdout	""
stderr	"panic at taskgroup.saw:1982: Task was dropped without being joined, detached or cancelled — `join()` waits for it and takes its result, `detach()` hands it to the process, `cancel()` asks it to stop"
stderr	"saw tasks: 2 live (as-of panic, unsynchronized)"
stderr	"  task group 1 slot 0 gen 1 ready"
stderr	"    at K86_background_task_handle_panics_in_deinit.saw:0 in work"
stderr	"  task group 2 slot 0 gen 1 ready"
stderr	"    at K86_background_task_handle_panics_in_deinit.saw:0 in work"
stderr	""
meets_expect	yes
frame	__Frame_work$m$	work	48	8	states=2	own=48	sub=0	bt=0	root=1	method=0	agrees=1
field	n	own	0	8	8
field	__state	own	8	8	8
field	__wake	own	16	8	8
field	__io_tok	own	24	8	8
field	__io_deadline	own	32	8	8
field	__cellp	own	40	8	8
bt	255	strtab=111	version=1	word_bits=64
btframe	__Frame_work$m$	work	K86_background_task_handle_panics_in_deinit.saw	8	0 23
