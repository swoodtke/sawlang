program	taskgroup_unjoined_drop.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"0"
stdout	"200"
stdout	""
meets_expect	yes
frame	__Frame_makes$m$	makes	48	8	states=2	own=48	sub=0	bt=0	root=1	method=0	agrees=1
field	id	own	0	8	8
field	__state	own	8	8	8
field	__wake	own	16	8	8
field	__io_tok	own	24	8	8
field	__io_deadline	own	32	8	8
field	__cellp	own	40	8	8
bt	237	strtab=93	version=1	word_bits=64
btframe	__Frame_makes$m$	makes	taskgroup_unjoined_drop.saw	8	0 15
