program	taskgroup_compute_preemption.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"spin start"
stdout	"sibling ran"
stdout	"spin end"
stdout	"499999500000"
stdout	""
meets_expect	yes
frame	__Frame_chatty$m$	chatty	40	8	states=1	own=40	sub=0	bt=0	root=1	method=0	agrees=1
field	__state	own	0	8	8
field	__wake	own	8	8	8
field	__io_tok	own	16	8	8
field	__io_deadline	own	24	8	8
field	__cellp	own	32	8	8
frame	__Frame_spinner$m$	spinner	64	8	states=7	own=64	sub=0	bt=1	root=1	method=0	agrees=1
field	__saw_loop_budget	own	0	8	8
field	i	own	8	8	8
field	acc	own	16	8	8
field	__state	own	24	8	8
field	__wake	own	32	8	8
field	__io_tok	own	40	8	8
field	__io_deadline	own	48	8	8
field	__cellp	own	56	8	8
bt	367	strtab=127	version=1	word_bits=64
btframe	__Frame_chatty$m$	chatty	taskgroup_compute_preemption.saw	0	0
btframe	__Frame_spinner$m$	spinner	taskgroup_compute_preemption.saw	24	0 0 0 0 0 0 28
