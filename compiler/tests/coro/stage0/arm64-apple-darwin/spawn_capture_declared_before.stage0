program	spawn_capture_declared_before.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"task saw 8"
stdout	"n is now 8"
stdout	"doubled 24"
stdout	"base still 12"
stdout	""
meets_expect	yes
frame	__Frame_run$m$	run	72	8	states=2	own=72	sub=0	bt=0	root=1	method=0	agrees=1
field	f	own	0	32	8
field	__state	own	32	8	8
field	__wake	own	40	8	8
field	__io_tok	own	48	8	8
field	__io_deadline	own	56	8	8
field	__cellp	own	64	8	8
bt	239	strtab=95	version=1	word_bits=64
btframe	__Frame_run$m$	run	spawn_capture_declared_before.saw	32	0 23
