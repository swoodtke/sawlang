program	taskgroup_cancel_during_sleep.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"canceller: fired"
stdout	"sleeper: cancelled"
stdout	"woke promptly: true"
stdout	""
meets_expect	yes
frame	__Frame_canceller$m$	canceller	64	8	states=2	own=64	sub=0	bt=0	root=1	method=0	agrees=1
field	target	own	0	8	8
field	p	own	8	16	8
field	__state	own	24	8	8
field	__wake	own	32	8	8
field	__io_tok	own	40	8	8
field	__io_deadline	own	48	8	8
field	__cellp	own	56	8	8
frame	__Frame_sleeper$m$	sleeper	40	8	states=2	own=40	sub=0	bt=1	root=1	method=0	agrees=1
field	__state	own	0	8	8
field	__wake	own	8	8	8
field	__io_tok	own	16	8	8
field	__io_deadline	own	24	8	8
field	__cellp	own	32	8	8
bt	326	strtab=134	version=1	word_bits=64
btframe	__Frame_canceller$m$	canceller	taskgroup_cancel_during_sleep.saw	24	0 42
btframe	__Frame_sleeper$m$	sleeper	taskgroup_cancel_during_sleep.saw	0	0 32
