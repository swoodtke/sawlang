field	acc	own	24	8	8
field	__state	own	32	8	8
field	__wake	own	40	8	8
field	__io_tok	own	48	8	8
field	__io_deadline	own	56	8	8
field	__cellp	own	64	8	8
bt	311	strtab=107	version=1	word_bits=64
btframe	__Frame_spin_sum$m$	spin_sum	taskgroup_compute_preemption_mt.saw	32	0 0 0 0 0 0 16
