program	offload_seam_first_tick.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"sibling first tick: prompt"
stdout	"300"
stdout	""
meets_expect	yes
frame	__Frame_blocker$m$	blocker	48	8	states=5	own=48	sub=0	bt=0	root=1	method=0	agrees=1
field	__blkjob0	own	0	8	8
field	__state	own	8	8	8
field	__wake	own	16	8	8
field	__io_tok	own	24	8	8
field	__io_deadline	own	32	8	8
field	__cellp	own	40	8	8
frame	__Frame_ticker$m$	ticker	56	8	states=1	own=56	sub=0	bt=1	root=1	method=0	agrees=1
field	t0	own	0	16	8
field	__state	own	16	8	8
field	__wake	own	24	8	8
field	__io_tok	own	32	8	8
field	__io_deadline	own	40	8	8
field	__cellp	own	48	8	8
bt	338	strtab=122	version=1	word_bits=64
btframe	__Frame_blocker$m$	blocker	offload_seam_first_tick.saw	8	0 20 0 0 0
btframe	__Frame_ticker$m$	ticker	offload_seam_first_tick.saw	16	0
