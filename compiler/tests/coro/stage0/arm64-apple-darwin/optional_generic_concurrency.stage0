program	optional_generic_concurrency.saw
triple	arm64-apple-darwin
twin	differs
expect	success
build	ok
exit	0
stdout	"t1 present -1"
stdout	"t2 present 7"
stdout	"t3 EMPTY"
stdout	"across suspend 106"
stdout	"with_unique 5"
stdout	"mutex 5"
stdout	"mutex after -7"
stdout	"-- done"
stdout	""
meets_expect	yes
frame	__Frame_across_suspend$m$	across_suspend	232	8	states=2	own=232	sub=0	bt=0	root=1	method=0	agrees=1
field	v	own	0	40	8
field	a	own	40	24	8
field	n	own	64	24	8
field	held	own	88	32	8
field	held_none	own	120	32	8
field	absent	own	152	32	8
field	acc	own	184	8	8
field	__state	own	192	8	8
field	__wake	own	200	8	8
field	__io_tok	own	208	8	8
field	__io_deadline	own	216	8	8
field	__cellp	own	224	8	8
bt	260	strtab=116	version=1	word_bits=64
btframe	__Frame_across_suspend$m$	across_suspend	optional_generic_concurrency.saw	192	0 39
