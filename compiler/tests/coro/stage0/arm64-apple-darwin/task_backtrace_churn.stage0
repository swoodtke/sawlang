program	task_backtrace_churn.saw
triple	arm64-apple-darwin
twin	same
expect	success
build	ok
exit	0
stdout	"three short tasks done"
stdout	"saw tasks: 2 live (unsynchronized snapshot)"
stdout	"  task group 1 slot 0 gen 4 sleeping"
stdout	"    at task_backtrace_churn.saw:36 in churn_sleeper"
stdout	"  task group 1 slot 1 gen 1 running"
stdout	"    at task_backtrace_churn.saw:41 in churn_watcher"
stdout	"watcher 0"
stdout	"sleeper 7"
stdout	""
meets_expect	yes
frame	__Frame_churn_short$m$	churn_short	40	8	states=2	own=40	sub=0	bt=0	root=1	method=0	agrees=1
field	__state	own	0	8	8
field	__wake	own	8	8	8
field	__io_tok	own	16	8	8
field	__io_deadline	own	24	8	8
field	__cellp	own	32	8	8
frame	__Frame_churn_sleeper$m$	churn_sleeper	48	8	states=2	own=48	sub=0	bt=1	root=1	method=0	agrees=1
field	n	own	0	8	8
field	__state	own	8	8	8
field	__wake	own	16	8	8
field	__io_tok	own	24	8	8
field	__io_deadline	own	32	8	8
field	__cellp	own	40	8	8
frame	__Frame_churn_watcher$m$	churn_watcher	40	8	states=2	own=40	sub=0	bt=2	root=1	method=0	agrees=1
field	__state	own	0	8	8
field	__wake	own	8	8	8
field	__io_tok	own	16	8	8
field	__io_deadline	own	24	8	8
field	__cellp	own	32	8	8
bt	420	strtab=180	version=1	word_bits=64
btframe	__Frame_churn_short$m$	churn_short	task_backtrace_churn.saw	0	0 31
btframe	__Frame_churn_sleeper$m$	churn_sleeper	task_backtrace_churn.saw	8	0 36
btframe	__Frame_churn_watcher$m$	churn_watcher	task_backtrace_churn.saw	0	0 41
