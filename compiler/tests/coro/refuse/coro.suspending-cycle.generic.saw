// refuses: coro.suspending-cycle at 30:1
// message: `descend -> descend`
// A cycle is decided per instantiation: `descend` recurses at both types, but
// only its instantiation at `Slow` suspends, so only that one is refused; at
// `Fast` it is ordinary recursion.
extern "C" {
    blocking func usleep(us: UInt32) -> Int32
}

trait Worker {
    func step(&self) -> Int
}

struct Fast {
    n: Int
}

struct Slow {
    n: Int
}

extension Fast: Worker {
    func step(&self) -> Int { self.n }
}

extension Slow: Worker {
    func step(&self) -> Int { (usleep(1) as Int) + self.n }
}

func descend<T: Worker>(w: &T, n: Int) -> Int {
    if n <= 0 {
        return w.step()
    }
    descend(&w, n - 1) + 1
}

func main() {
    let fast = Fast(n: 1)
    let slow = Slow(n: 3)
    print("{} {}", descend(&fast, 2), descend(&slow, 2))
}
