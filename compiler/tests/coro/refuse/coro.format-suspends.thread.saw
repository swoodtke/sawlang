// refuses: coro.format-suspends at 26:10
// message: `Printable.format` must not suspend
// message: .Wrapper<
// message: .Yielder>`'s does: `Wrapper.format` → `Yielder.name` → `yield_now` (parks the task)
// The rule's per-instance half, at an interpolation in a `Thread.spawn` body,
// which renders through the ordinary item (SL-781).

import std.task.*

trait Namer {
    func name(&self) -> String
}

struct Yielder { n: Int }

extension Yielder: Namer {
    func name(&self) -> String {
        yield_now()
        "yielder"
    }
}

struct Wrapper<T: Namer> { inner: T }

extension Wrapper<T: Namer>: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.inner.name())
    }
}

func main() {
    var t = try! Thread.spawn { "{Wrapper(inner: Yielder(n: 4))}".len() }
    print("rendered {}", t.join())
}
