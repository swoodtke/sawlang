// refuses: coro.window-drives at 31:9
// message: this drop of `o: std.taskgroup.TaskGroup?` reaches the executor's sweep
// message: `exec_run` → `sweep`, inside the `borrows(sync)` window of `boot_slot` opened at
// an `Optional` group set to `None` inside the window, declared before it: the assignment drops the old value (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func bump() -> Int {
    yield_now()
    var o: TaskGroup? = Optional<TaskGroup>.Some(TaskGroup())
    let _ = o?.spawn(member())
    borrow var b = boot_slot() {
        b = 1
        o = None
        print("inside the window, after the teardown: {}", b)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
}
