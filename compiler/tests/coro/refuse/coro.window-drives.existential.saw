// refuses: coro.window-drives at 49:17
// message: this drop of `e: std.box.Box<any coro.window-drives.existential.Named, std.alloc.GlobalAllocator>` reaches the executor's sweep
// message: `exec_run` → `sweep`, inside the `borrows(sync)` window of `boot_slot` opened at
// a `Box<any Named>` holding a group-holding value, dropped inside the window: the drop runs through the vtable
// of each conformer, which the glue's body does not name (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

struct Holder {
    group: TaskGroup
    n: Int
}

extension Holder: NoCopy {}
extension Holder: NoMove {}

trait Named {
    func id(&self) -> Int
}

extension Holder: Named {
    func id(&self) -> Int {
        self.n
    }
}

func bump() -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        if true {
            let e = Box<any Named>.make(Holder(group: TaskGroup(), n: 1))
        }
        print("inside the window, after the teardown: {}", b)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
}
