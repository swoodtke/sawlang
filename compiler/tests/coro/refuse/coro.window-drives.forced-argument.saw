// refuses: coro.window-drives at 58:17
// message: this call reaches the executor's sweep
// message: `Oops.format` → `tear_down`
// `twice(try! r)`: a forced `Result` in a call's argument renders its error, whose `format` tears a group
// down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Oops {
    n: Int
}

extension Oops: Printable {
    func format(&self, into: &var StringBuilder) {
        tear_down()
        try! into.append("oops")
    }
}

func flag(fail: Bool) -> Result<Int, Oops> {
    if fail {
        return Result<Int, Oops>.Err(Oops(n: 1))
    }
    Result<Int, Oops>.Ok(1)
}

func twice(n: Int) -> Int {
    n * 2
}

func bump() -> Int {
    yield_now()
    let r = flag(fail: true)
    borrow var b = boot_slot() {
        b = 1
        let n = twice(try! r)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
