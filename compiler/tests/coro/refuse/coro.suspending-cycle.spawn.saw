// refuses: coro.suspending-cycle at 11:1
// message: suspending recursion is not allowed
// message: `recurse -> recurse`
// From errors/coro_spawn_suspending_recursion. The test's root is
// `Task.spawn(recurse(3))`, which arrives with spawn lowering (SL:coroutines
// A7a); `main` calls `recurse` until then.
extern "C" {
    blocking func usleep(us: UInt32) -> Int32
}

func recurse(n: Int) -> Int {
    usleep(1)
    if n <= 0 {
        return 0
    }
    return recurse(n - 1)
}

func main() {
    print("{}", recurse(3))
}
