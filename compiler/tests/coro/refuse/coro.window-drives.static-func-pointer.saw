// refuses: coro.window-drives at 43:17
// message: this call through a function value of type `(Int) sync -> Int` may run any function value of that type in the program, and one of them reaches the executor's sweep
// a `FuncPointer` static whose initializer names a function that tears a group down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func tear_down(x: Int) sync -> Int {
    var g = TaskGroup()
    let _ = g.spawn(member())
    x
}

static HOOK: FuncPointer<(Int) sync -> Int> = tear_down

func bump() -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        let n = HOOK(1)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
    print("after bump: {}", after())
}
