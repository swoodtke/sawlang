// refuses: coro.window-drives at 69:17
// message: this call through a function value of type `(Int8, Int16) sync -> Int8` may run any function value of that type in the program, and one of them reaches the executor's sweep
// the same, with a closure of that type elsewhere that tears a group down (K228)

import std.task.{yield_now}

extern "C" {
    func dlopen(path: UnsafePointer<UInt8>, mode: Int32) -> UnsafePointer<UInt8>
    func dlsym(handle: UnsafePointer<UInt8>, symbol: UnsafePointer<UInt8>) -> FuncPointer<(Int8, Int16) sync -> Int8>
}

static RTLD_LAZY: Int32 = 1

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

@export("sl1161_probe_tear")
func probe_tear(a: Int8, b: Int16) sync -> Int8 {
    tear_down()
    a
}

func unused() -> Int8 {
    let f: (Int8, Int16) sync -> Int8 = { a, b in tear_down(); a }
    1
}

func find(name: String) unsafe -> FuncPointer<(Int8, Int16) sync -> Int8> {
    var text: [UInt8; 64] = [0; 64]
    var i = 0
    while i < name.len() {
        text[i] = name.byte_at(i)
        i = i + 1
    }
    dlsym(dlopen(0 as UnsafePointer<UInt8>, RTLD_LAZY), (&text) as UnsafePointer<UInt8>)
}

func bump() -> Int {
    yield_now()
    let fp = find("sl1161_probe_tear")
    borrow var b = boot_slot() {
        b = 1
        let n = fp(1 as Int8, 2 as Int16)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
    print("after bump: {}", after())
    print("{}", unused())
}
