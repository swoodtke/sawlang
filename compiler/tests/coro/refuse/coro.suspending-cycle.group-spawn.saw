// refuses: coro.suspending-cycle at 9:1
// message: suspending recursion is not allowed
// message: `recurse -> recurse`
// From errors/coro_group_spawn_suspending_recursion: a task root spawned into
// a group whose function is a cycle of its own. The root is a separate item
// that calls the ordinary one, which the cycle refusal names.
import std.task.{yield_now}

func recurse(n: Int) -> Int {
    yield_now()
    if n <= 0 {
        return 0
    }
    return recurse(n - 1)
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(recurse(3))
    print("{}", h.join())
}
