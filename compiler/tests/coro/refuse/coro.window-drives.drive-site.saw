// refuses: coro.window-drives at 33:17
// message: this drive site reaches the executor's sweep
// message: inside the `borrows(sync)` window of `boot_slot` opened at
// a drive site in a function that does not suspend, inside the window: the driver runs the executor (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func side() -> Int {
    yield_now()
    5
}

func bump() -> Int {
    borrow var b = boot_slot() {
        b = 1
        let r = __saw_drive(side())
        print("inside the window: {} {}", b, r)
    }
    0
}

func main() {
    print("bump returns {}", bump())
}
