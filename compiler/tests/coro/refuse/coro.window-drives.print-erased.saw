// refuses: coro.window-drives at 46:9
// message: this call reaches the executor's sweep
// message: `Shown.format` → `tear_down`
// `print` of a `Box<any Printable>` whose payload's `format` tears a group down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Shown {
    n: Int
}

extension Shown: Printable {
    func format(&self, into: &var StringBuilder) {
        tear_down()
        try! into.append("shown")
    }
}

func bump() -> Int {
    yield_now()
    let p = Box<any Printable>.make(Shown(n: 1))
    borrow var b = boot_slot() {
        b = 1
        print("inside the window: {} {}", b, p)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
