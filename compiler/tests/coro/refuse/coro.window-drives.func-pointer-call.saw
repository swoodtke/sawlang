// refuses: coro.window-drives at 41:17
// message: this call through a function value of type `() sync -> Int` may run any function value of that type
// message: `exec_run` → `sweep`, inside the `borrows(sync)` window of `boot_slot` opened at
// a `FuncPointer` to a `sync` function that tears a group down, called inside the window: a call through a
// `FuncPointer` reaches every function and closure body taken as a pointer of its type (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync -> Int {
    var g = TaskGroup()
    let _ = g.spawn(member())
    1
}

struct Job {
    run: FuncPointer<() sync -> Int>
}

func bump() -> Int {
    yield_now()
    let job = Job(run: tear_down)
    borrow var b = boot_slot() {
        b = 1
        let r = job.run()
        print("inside the window: {} {}", b, r)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
}
