// refuses: coro.window-drives at 62:9
// message: this drop of `o: std.box.Box<any coro.window-drives.erased-box-dealloc.Speaks, coro.window-drives.erased-box-dealloc.DeallocTears>?` reaches the executor's sweep
// message: `DeallocTears.dealloc` → `tear_down`
// an erased box dropped inside the window, whose allocator's `dealloc` tears a group down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct DeallocTears {}

extension DeallocTears: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        GlobalAllocator().alloc(size, align)
    }

    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        tear_down()
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

trait Speaks {
    func say(&self) -> Int
}

struct Dog {
    n: Int
}

extension Dog: Speaks {
    func say(&self) -> Int {
        self.n
    }
}

func bump() -> Int {
    yield_now()
    var o: Box<any Speaks, DeallocTears>? = Box<any Speaks, DeallocTears>.make(Dog(n: 3))
    borrow var b = boot_slot() {
        b = 1
        o = None
        print("inside the window: {}", b)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
