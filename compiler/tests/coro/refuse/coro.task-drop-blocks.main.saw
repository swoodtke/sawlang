// refuses: coro.task-drop-blocks at 25:1
// message: `main` suspends, so it runs the executor, and it blocks its thread here: `main` → drops `pool: coro.task-drop-blocks.main.Pool` (blocking deinit)
// message: Declare `func main() blocking` to run it in thread context
// A `main` that joins a thread suspends there, since a join from an
// executor parks, so it is a task root, and the `Pool` it drops at its end
// is refused; the message offers `func main() blocking` (conformance row
// K182; the lead's ruling on SL-782 1b-ii's OPEN row 5).

import std.task.{Thread}

struct Pool {
    size: Int
}

extension Pool: NoCopy {
    func deinit(&var self) blocking {
        print("retired a pool of {}", self.size)
    }
}

func work() -> Int {
    7
}

func main() {
    let pool = Pool(size: 2)
    var t = try! Thread.spawn { work() }
    print(t.join() + pool.size)
}
