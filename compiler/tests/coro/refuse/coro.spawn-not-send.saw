// refuses: coro.spawn-not-send at 11:1
// message: cannot spawn `bump` into a multi-threaded `TaskGroup(threads: ...)`: parameter `n` of type `&var Int` is not `Send`
// message: A reference into the spawner never crosses to another thread
// A reference parameter of a root spawned into a `threads:` group, from
// `tests/corpus/conformance/K19_spawn_ref_param_mt_send`. `Int` is `Sync`,
// so `&var Int` is `Send`: the root's reference is refused outright, at the
// root's declaration, because it points into the spawner.

import std.task.*

func bump(n: &var Int) -> Int {
    yield_now()
    n = n + 1
    n
}

func main() {
    var n = 7
    var group = try! TaskGroup(threads: 2)
    let h = group.spawn(bump(&var n))
    print("task saw {h.join()}")
}
