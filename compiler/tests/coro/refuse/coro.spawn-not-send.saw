// refuses: coro.spawn-not-send at 9:1
// message: cannot spawn `waiter`: parameter `pool` of type `&std.taskgroup.TaskGroup` is not `Send`
// A reference parameter of a root spawned into a single-threaded group: a
// spawned frame is `Send` whatever its group, and `&T` is `Send` only when
// `T` is `Sync`, which a `TaskGroup` is not, since a cooperative group
// belongs to the thread that drives it.
import std.task.*

func waiter(pool: &TaskGroup) -> Int {
    let h = pool.spawn(one())
    yield_now()
    h.join()
}

func one() -> Int {
    1
}

func main() {
    var pool = try! TaskGroup(threads: 2)
    var group = TaskGroup()
    let b = group.spawn(waiter(&pool))
    print(b.join())
}
