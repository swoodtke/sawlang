import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

func bump() -> Int {
    yield_now()
    var hooks = Vector<(Int8) sync -> Int8>()
    let _ = hooks.push({ x in x })
    borrow var b = boot_slot() {
        b = 1
        let first = hooks.get(0) ?? { x in x }
        let n = first(1 as Int8)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
