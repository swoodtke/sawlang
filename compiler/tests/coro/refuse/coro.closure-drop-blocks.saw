// refuses: coro.closure-drop-blocks at 27:31
// message: a closure body may not block, and this one drops a value whose drop blocks: `main` → drops `p: coro.closure-drop-blocks.Pool` (blocking deinit)
// A closure built in a `main` declared `blocking`, thread context, and
// called through its function value by a task, whose body drops a value
// whose `deinit` is `blocking`: no task root sees a call through a value, so
// the closure itself is refused (conformance row K182; the Air's SL-782 c37
// `d5_value_call_main`).

import std.task.*

struct Pool {
    n: Int
}

extension Pool: NoCopy {
    func deinit(&var self) blocking {
        print("retired a pool of {}", self.n)
    }
}

func run(body: () -> Void) {
    body()
}

func main() blocking {
    var group = TaskGroup()
    let job = group.spawn(run({ let p = Pool(n: 1); let _ = p.n }))
    job.join()
}
