// refuses: coro.window-drives at 35:17
// message: this call reaches the executor's sweep
// message: the closure in `bump` (a call through a function value of type `() sync -> Int` may run it)
// a closure made before the window, passed to `apply` inside it, which calls it through its function value
// (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func apply(body: () sync -> Int) -> Int {
    body()
}

func bump() -> Int {
    yield_now()
    let f: () sync -> Int = { var g = TaskGroup(); let _ = g.spawn(member()); 1 }
    borrow var b = boot_slot() {
        b = 1
        let n = apply(f)
        print("inside the window: {} {}", b, n)
    }
    0
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
    print("after bump: {}", after())
}
