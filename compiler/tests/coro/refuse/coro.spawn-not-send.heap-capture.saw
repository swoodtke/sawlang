// refuses: coro.spawn-not-send at 17:29
// message: cannot spawn `run`: parameter `f` of type `() -> Int` holds this closure, and the closure is not `sendable`, since it captures `c` of type `coro.spawn-not-send.heap-capture.Counter`, which is not `Sync`: every copy of a closure shares what it captured, so each capture must be `Send` and `Sync`, so the task frame cannot cross to a worker thread.
// An escaping closure's heap environment is shared by every copy of it, so
// an owned capture that is `Send` but not `Sync` keeps it from crossing to a
// worker, named by the refusal (SL-525).
struct Counter { cell: UnsafeMutableInterior<Int> }

func counter() unsafe -> Counter { Counter(cell: UnsafeMutableInterior(0)) }

func run(f: () escaping -> Int) -> Int {
