// refuses: coro.window-drives at 71:9
// message: this call reaches the executor's sweep
// message: whose accessor holds a static root's exclusive window open across its `lend`
// an accessor that carries such an accessor's window open: fenced at any depth (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
        print("member saw {}", c)
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Door {
    n: Int
}

extension Door {
    func held(&var self) sync borrows(sync) -> &var Int {
        borrow var c = boot_slot() {
            c = 1
            lend self.n
            c = 2
        }
    }
}

struct Hall {
    door: Door
    m: Int
}

extension Hall {
    func held(&var self) sync borrows(sync) -> &var Int {
        borrow var d = self.door.held() {
            d = 7
            lend self.m
        }
    }
}

func form_a() -> Int {
    yield_now()
    var h = Hall(door: Door(n: 0), m: 0)
    borrow var n = h.held() {
        n = 5
        tear_down()
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("{}", outer.spawn(form_a()).join())
    print("after a: {}", after())
}
