// refuses: coro.window-drives at 51:27
// message: this collection literal reaches the executor's sweep
// message: `Key.hash` → `tear_down`
// a `Set` literal whose element's `hash` tears a group down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Key {
    n: Int
}

extension Key: Equatable {
    func equals(&self, other: &Key) -> Bool {
        self.n == other.n
    }
}

extension Key: Hashable {
    func hash(&self, h: &var Hasher) {
        tear_down()
        self.n.hash(&var h)
    }
}

func bump() -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        let s: Set<Key> = {Key(n: 1), Key(n: 2)}
        print("inside the window: {} {}", b, s.len())
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
