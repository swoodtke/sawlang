// refuses: coro.not-yet at 17:11
// message: `main` suspends (main -> count), so it needs a coroutine frame, which is not lowered yet
// A caller that drives a child whose frame is refused for its op-budget
// point: the chain of children that are not lowered ends at that child,
// since a budget point is no call to follow (SL-646).

func count(limit: Int) -> Int {
    var n = 0
    while n < 10 {
        n = n + 1
        __saw_suspend()
    }
    n
}

func main() {
    print(count(2))
}
