// refuses: coro.task-drop-blocks at 25:15
// message: the task runs `work` → `measure` → drops `pool: coro.task-drop-blocks.parameter.Pool` (blocking deinit)
// A by-value parameter, which the callee owns and drops at its end, a call
// below the task root (conformance row K182).

struct Pool {
    size: Int
}

extension Pool: NoCopy {
    func deinit(&var self) blocking {
        print("retired a pool of {}", self.size)
    }
}

func measure(pool: Pool) -> Int {
    pool.size
}

func work(size: Int) -> Int {
    measure(Pool(size: size))
}

func main() {
    let job = Task.spawn(work(4))
    print(job.join())
}
