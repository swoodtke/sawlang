// refuses: coro.window-drives at 45:17
// message: this call through a function value of type `(Int16, Int8) sync -> Int16` may run any function value of that type in the program, and one of them reaches the executor's sweep
// message: that `FuncPointer.from_raw` made, which may run anything
// a pointer `FuncPointer.from_raw` made, of a type no other value has, called inside the window: its code is
// unseen, so it reaches the sweep, harmless or not (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

func harmless(a: Int16, b: Int8) sync -> Int16 {
    a
}

func forge(at: Int) unsafe -> FuncPointer<(Int16, Int8) sync -> Int16> {
    FuncPointer<(Int16, Int8) sync -> Int16>.from_raw(at as UnsafePointer<UInt8>)
}

func bump() -> Int {
    yield_now()
    let named: FuncPointer<(Int16, Int8) sync -> Int16> = harmless
    let f = forge(Int.from(truncating: named.address()))
    borrow var b = boot_slot() {
        b = 1
        let n = f(1, 2)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
