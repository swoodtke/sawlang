// refuses: coro.window-drives at 50:17
// message: this call reaches the executor's sweep
// message: `Cheap.copy` → `tear_down`
// a tuple of a type whose `copy` tears a group down, copied into a call's argument (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Cheap {
    n: Int
}

extension Cheap: Copy {
    func copy(&self) -> Cheap {
        tear_down()
        Cheap(n: self.n)
    }
}

func consume(t: (Cheap, Int)) -> Int {
    t.1
}

func bump() -> Int {
    yield_now()
    let t = (Cheap(n: 1), 2)
    borrow var b = boot_slot() {
        b = 1
        let n = consume(t)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
