// refuses: coro.window-drives at 33:9
// message: this call reaches the executor's sweep
// message: `exec_run` → `sweep`, inside the `borrows(sync)` window of `boot_slot` opened at
// a callee that replaces a group through a `&var` reference, called inside the window (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func replace_group(g: &var TaskGroup) sync {
    g = TaskGroup()
}

func bump(g: &var TaskGroup) -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        replace_group(&var g)
        print("inside the window, after the teardown: {}", b)
    }
    0
}

func main() {
    var g = TaskGroup()
    let _ = g.spawn(member())
    print("bump returns {}", bump(&var g))
}
