// refuses: coro.window-drives at 27:17
// message: this call reaches the executor's sweep
// message: `abs` (an `extern` with no body in the program, which may run anything) → `sweep`
// an `extern "C"` function with no body in the program, called inside the window: the check cannot see what
// it runs, so it reaches the sweep (K228)

import std.task.{yield_now}

extern "C" {
    func abs(value: Int32) -> Int32
}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func bump() -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        let n = abs(-3)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
}
