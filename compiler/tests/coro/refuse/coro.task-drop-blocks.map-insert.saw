// refuses: coro.task-drop-blocks at 28:15
// message: the task runs `replace` → `Map.insert` →
// message: → `coro.task-drop-blocks.map-insert.Pool` (blocking deinit)
// `Map.insert` hands back the value its key displaced, and the task drops it
// (conformance row K182; the Air's SL-782 c24).

import std.task.*

struct Pool {
    size: Int
}

extension Pool: NoCopy {
    func deinit(&var self) blocking {
        print("retired a pool of {}", self.size)
    }
}

func replace(pools: &var Map<Int, Pool>, size: Int) -> Bool {
    let displaced = try! pools.insert(1, Pool(size: size))
    displaced.is_some()
}

func main() {
    var pools = Map<Int, Pool>()
    let _ = try! pools.insert(1, Pool(size: 1))
    var group = TaskGroup()
    let job = group.spawn(replace(&var pools, 2))
    print(job.join())
}
