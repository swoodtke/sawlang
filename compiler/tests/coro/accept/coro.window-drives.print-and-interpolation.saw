// accepts: coro.window-drives
// the `Printable` printed and interpolated after the window (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func reset() {
    borrow var b = boot_slot() {
        b = 1
    }
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

struct Shown {
    n: Int
}

extension Shown: Printable {
    func format(&self, into: &var StringBuilder) {
        tear_down()
        try! into.append("shown")
    }
}

func bump() -> Int {
    yield_now()
    let s = Shown(n: 1)
    borrow var b = boot_slot() {
        b = 1
        print("inside the window: {}", b)
    }
    print("print: {}", s)
    print("right after the action (format arg): {}", after())
    reset()
    print(s)
    print("right after the action (single print): {}", after())
    reset()
    let text = "x={s}"
    print("right after the action (string interpolation): {} {}", after(), text)
    reset()
    print("print interpolation {s}")
    print("right after the action (print interpolation): {}", after())
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
