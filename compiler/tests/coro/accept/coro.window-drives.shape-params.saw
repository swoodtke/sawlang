// accepts: coro.window-drives
// a harmless closure whose parameter type differs from the one that tears a group down (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func unrelated() -> Int {
    let loud: (Int) sync -> Int = { x in var g = TaskGroup(); let _ = g.spawn(member()); x }
    loud(1)
}

func bump() -> Int {
    yield_now()
    let quiet: (Int8) sync -> Int = { x in 1 }
    borrow var b = boot_slot() {
        b = 1
        let n = quiet(1)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("unrelated {}", unrelated())
    print("bump returns {}", outer.spawn(bump()).join())
}
