// accepts: coro.window-drives
// a raw pointer made from `&slot.tag`, an `Int`, stepped into the sibling `FuncPointer` field: a raw pointer
// is assumed to stay within the place it was made from; stepping it outside that place, into a sibling field
// or another object, is the obligation of the `unsafe` code that steps it (spec, A group's teardown in a task
// parks). Accepted, by that rule (K228)

import std.task.{yield_now}
import std.mem.{copy_bytes}

extern "C" {
    func dlopen(path: UnsafePointer<UInt8>, mode: Int32) -> UnsafePointer<UInt8>
    func dlsym(handle: UnsafePointer<UInt8>, symbol: UnsafePointer<UInt8>) -> UnsafePointer<UInt8>
}

static RTLD_LAZY: Int32 = 1

struct Pair {
    n: Int
    f: FuncPointer<(Int8, Int16) sync -> Int8>
}

func harmless(a: Int8, b: Int16) sync -> Int8 {
    a
}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

@export("sl1161_probe_tear_v7b")
func probe_tear(a: Int8, b: Int16) sync -> Int8 {
    tear_down()
    a
}

func fill(n: &var Int) unsafe {
    var text: [UInt8; 64] = [0; 64]
    let name = "sl1161_probe_tear_v7b"
    var i = 0
    while i < name.len() {
        text[i] = name.byte_at(i)
        i = i + 1
    }
    var addr = dlsym(dlopen(0 as UnsafePointer<UInt8>, RTLD_LAZY), (&text) as UnsafePointer<UInt8>)
    let next = ((n as UnsafePointer<Int8>) as Int + 8) as UnsafePointer<Int8>
    copy_bytes((&addr) as UnsafePointer<Int8>, next, 8)
}

func bump() -> Int {
    yield_now()
    var pair = Pair(n: 0, f: harmless)
    fill(&var pair.n)
    borrow var b = boot_slot() {
        b = 1
        let n = pair.f(1 as Int8, 2 as Int16)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
    print("after bump: {}", after())
}
