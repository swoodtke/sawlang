// accepts: coro.window-drives
// an `extern` naming the program's own harmless `@export`, called inside the window: the export is followed
// (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func tear_down() sync {
    var g = TaskGroup()
    let _ = g.spawn(member())
}

extern "C" {
    func sl1161_window_harmless(x: Int) -> Int
}

@export("sl1161_window_harmless")
func harmless(x: Int) sync -> Int {
    x + 1
}

func bump() -> Int {
    yield_now()
    borrow var b = boot_slot() {
        b = 1
        let n = sl1161_window_harmless(1)
        print("inside the window: {} {}", b, n)
    }
    0
}

func main() {
    var outer = TaskGroup()
    print("bump returns {}", outer.spawn(bump()).join())
}
