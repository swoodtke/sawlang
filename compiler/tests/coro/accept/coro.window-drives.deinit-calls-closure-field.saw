// accepts: coro.window-drives
// the value dropped after the window (K228)

import std.task.{yield_now}

struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT.count) -> &var Int {
    lend BOOT.count
}

func member() -> Int {
    borrow var c = boot_slot() {
        c += 100
    }
    1
}

func after() -> Int {
    let v = borrow var b = boot_slot() {
        b
    }
    v
}

struct Hook {
    run: () sync -> Int
}

extension Hook: NoCopy {
    func deinit(&var self) {
        let _ = self.run()
    }
}

func bump() -> Int {
    yield_now()
    var hook = Hook(run: { var g = TaskGroup(); let _ = g.spawn(member()); 1 })
    borrow var b = boot_slot() {
        b = 1
        print("inside the window: {}", b)
    }
    if true {
        let moved = move hook
    }
    print("right after the action: {}", after())
    0
}

func main() {
    var outer = TaskGroup()
    let t = outer.spawn(bump())
    print("bump returns {}", t.join())
}
