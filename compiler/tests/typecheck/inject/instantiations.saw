// Generic calls whose instantiations name type parameters: `count` calls
// itself at its own `T`, `ping` calls `pong` at `ping`'s `T`, and `walk`
// calls itself at its own `U` and its type's `T`.
// `compiler/typecheck/tests/verify_instantiations.saw` checks them clean,
// then edits a call to name a parameter its body cannot see.

struct Chain<T> {
    v: T
}

func count<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + count(x, n - 1)
}

func ping<T>(x: T, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + pong(x, n - 1)
}

func pong<U>(y: U, n: Int) -> Int {
    if n == 0 {
        return 0
    }
    1 + ping(y, n - 1)
}

extension Chain<T: Copy> {
    func walk<U>(&self, u: U, n: Int) -> Int {
        if n == 0 {
            return 0
        }
        1 + self.walk(u, n - 1)
    }
}

func main() {
    let c = Chain<Int>(v: 5)
    print("{}", count(true, 3) + ping(1, 3) + c.walk(true, 2))
}
