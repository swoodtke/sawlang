// warns: 7
// the statement form's prefix at each unnamed-lend position draws
// `borrows.redundant-prefix`, and its fix-it drops it (SL:borrowing §12.1)
// message: write `v[0].n`
// message: write `m.find(&"a")?.hits`
// message: write `q[0].push(5)`

struct Cell { n: Int }
struct Hit { hits: Int }

func main() {
    var v = Vector<Cell>()
    try! v.push(Cell(n: 1))
    borrow var v[0].n = 10
    borrow var v[0].n += 1
    print(borrow v[0].n)
    print("{borrow v[0].n}")
    var m = Map<String, Hit>()
    m["a"] = Hit(hits: 1)
    borrow var m.find(&"a")?.hits = 7
    var q = Vector<Vector<Int>>()
    try! q.push(Vector<Int>())
    try! borrow var q[0].push(5)
    let n = borrow q[0].len()
    print(n)
}
