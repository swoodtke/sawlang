// refuses: effect.sync at 20:9
// an assignment from a place in a `sync` function, its old value dropped after the copy
// message: a copy of `effect.sync.copy-assign.Heavy` happens here, and `Heavy.copy()` suspends

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(a: &Heavy) sync -> Int {
    var b = Heavy(n: 5)
    b = a
    b.n
}

func main() {
    let a = Heavy(n: 1)
    print(f(&a))
}
