// refuses: mutability.immutable at 13:9
// compound-assigning a `[move n]` capture, in a closure passed straight to a
// non-escaping parameter: a by-value capture is a `let` in the closure's body
// (SL-472)

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var n = 0
    run({ [move n] in
        n += 5
        n
    })
}
