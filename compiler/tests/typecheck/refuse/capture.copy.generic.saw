// refuses: capture.copy at 19:12
// a `[copy x]` capture of an unbounded type parameter is a spelled copy no
// bound grants, refused at the definition (SL-481, D30)
struct Res {
    name: String
}

extension Res: NoCopy {}

func run(f: () -> Int) -> Int {
    f()
}

func measure<T>(x: &T) -> Int {
    1
}

func copied<T>(x: T) -> Int {
    run({ [copy x] in measure(&x) })
}

func main() {
    let _ = copied(Res(name: "a"))
}
