// errors: 1
// a closure handed to an `escaping` parameter outlives the call, so it reaches no static root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func keep(body: () escaping -> Int) -> Int {
    body()
}

func main() {
    print("{}", keep({ install(4)
                       return 4 }))
}
