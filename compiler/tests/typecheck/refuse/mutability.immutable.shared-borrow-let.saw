// refuses: mutability.immutable at 30:5
// a bare `borrow` statement writing through a read-only lend on a `let`
// root (SL-487)
struct Cell {
    n: Int
}

extension Cell {
    func bump(&var self) {
        self.n += 1
    }
}

struct Grid {
    cells: [Cell; 2]
}

extension Grid {
    func ro(&self, i: Int) borrows -> &Cell {
        lend self.cells[i]
    }

    func rw(&var self, i: Int) borrows -> &var Cell {
        lend self.cells[i]
    }
}

func main() {
    let g = Grid(cells: [Cell(n: 1), Cell(n: 2)])
    borrow g.ro(1).n += 50
}
