// refuses: mutability.immutable at 13:24
// a `&self` method opening a `borrow var` block on an element of a `Vector`
// field, an exclusive accessor (SL:borrowing §9)

struct Board {
    cells: Vector<Int>
}

extension Board: NoCopy {}

extension Board {
    func stamp(&self) {
        borrow var e = self.cells[0] {
            e = 1
        }
    }
}
