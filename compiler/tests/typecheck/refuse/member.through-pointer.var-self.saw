// refuses: member.through-pointer at 15:7
// flags: --std-root std
// a `&var self` payload method called on its `var` box; the hint names `borrow var b.value().bump()`

struct Counter {
    n: Int
}

extension Counter {
    func bump(&var self) { self.n = self.n + 1 }
}

func main() {
    var b = try! Box<Counter>.make(Counter(n: 0))
    b.bump()
}
