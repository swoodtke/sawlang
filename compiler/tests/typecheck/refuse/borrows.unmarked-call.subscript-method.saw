struct Entry { n: Int }

extension Entry {
    func twice(&self) -> Int { self.n * 2 }
    func bump(&var self) { self.n += 1 }
}

struct Store { items: [Entry; 2] }

extension Store {
    @synthesize(shared)
    func slot(&var self, i: Int) borrows -> &var Entry {
        lend self.items[i]
    }

    @synthesize(shared)
    func find(&var self, i: Int) borrows -> &var Entry? {
        if i < 0 || i >= 2 {
            return None
        }
        lend self.items[i]
    }
}

struct Grid { cells: [Entry; 2] }

extension Grid {
    func [](&var self, i: Int) borrows -> &var Entry {
        lend self.cells[i]
    }
}

func main() {
    var st = Store(items: [Entry(n: 1), Entry(n: 2)])
    var g = Grid(cells: [Entry(n: 1), Entry(n: 2)])
    g[0].bump()
}
