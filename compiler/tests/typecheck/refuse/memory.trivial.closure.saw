// refuses: memory.trivial at 6:15
// an `UnsafeMemory` view of a function value: a view copies the bytes it reads
// and writes, so its `T` is trivially copyable

func reach(address: Int) unsafe {
    let view: UnsafeMemory<() -> Int, Normal> = UnsafeMemory(address)
    let _ = view
}

func main() {
    print(0)
}
