// refuses: mutability.immutable at 13:9
// an array's builtin `swap` on a `[move a]` capture, in a closure passed
// straight to a non-escaping parameter: a by-value capture is a `let` in the
// closure's body (SL-472)

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var a: [Int; 3] = [1, 2, 3]
    run({ [move a] in
        a.swap(0, 1)
        a[0]
    })
}
