struct Clock {
    n: Int
}

extension Clock {
    func read(&self) -> Int {
        self.n
    }
}

@test
extension Clock {
    func read(&self, x: Int) -> Int {
        x
    }
}

func main() {
    let c = Clock(n: 1)
    print("{}", c.read(x: 5))
}
