// refuses: copy.second-policy at 15:18
// `NoCopy` and then `ExplicitCopy`: a move-only type cannot also be one a
// spelled `.copy()` duplicates

struct Noisy {
    id: Int
}

extension Noisy: NoCopy {
    func deinit(&var self) {
        print("deinit {}", self.id)
    }
}

extension Noisy: ExplicitCopy {
    func copy(&self) -> Noisy {
        Noisy(id: self.id)
    }
}

func main() {
    let n = Noisy(id: 7)
    print("made {}", n.id)
}
