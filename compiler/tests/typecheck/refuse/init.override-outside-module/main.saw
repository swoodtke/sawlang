// refuses: init.override-outside-module at 7:5
// an importer's `init` matching a struct's fields exactly: only the struct's own module may override its construction (SL-648)

import ports.{Port}

extension Port {
    init(value: Int) -> Port {
        Port(value: value + 1)
    }
}

func main() {
    print(Port(value: 1).value)
}
