// refuses: mutability.immutable at 26:24
// a `@synthesize(shared)` accessor whose prologue writes its receiver's
// storage through a nested `borrow var` of another accessor: under the derived
// twin's `&self` that borrow is a write through a shared receiver (conformance
// row X60)

struct Counters {
    hits: [Int; 2]
}

extension Counters {
    @synthesize(shared)
    func [](&var self, i: Int) borrows -> &var Int {
        lend self.hits[i]
    }
}

struct Log {
    counters: Counters
    slots: [Int; 4]
}

extension Log {
    @synthesize(shared)
    func at(&var self, i: Int) borrows -> &var Int {
        borrow var c = self.counters[0] {
            c = c + 1
        }
        lend self.slots[i]
    }
}
