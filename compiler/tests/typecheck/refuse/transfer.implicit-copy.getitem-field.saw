// refuses: transfer.implicit-copy at 36:13
// a field read off a plain subscript of a NoCopy element: a getitem of
// the whole element, then the field (SL:borrowing §5.2)
struct Res {
    id: Int,
    inner: Tag
}

struct Tag {
    n: Int
}

extension Res: NoCopy {}

extension Res: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(value: self.id)
    }
}

extension Res: Equatable {
    func equals(&self, other: &Self) -> Bool {
        self.id == other.id
    }
}

extension Res {
    func look(&self) -> Int {
        self.id
    }
}

func main() {
    var v: Vector<Res> = Vector<Res>()
    try! v.push(Res(id: 1, inner: Tag(n: 2)))
    let _ = v[0].id
}
