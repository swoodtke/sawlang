// refuses: conformance.policy-placement at 13:19
// a test-only `NoMove` on a production type, which made production `Holder`'s
// declaration a `nomove.undeclared`: the misplaced conformance counts for
// nothing, so `Holder` is refused nothing (SL-659)

struct Pinned {
    n: Int
}

extension Pinned: NoCopy {}

@test
extension Pinned: NoMove {}

struct Holder {
    p: Pinned
}

extension Holder: NoCopy {}

func main() {
    let h = Holder(p: Pinned(n: 4))
    print("{}", h.p.n)
}
