// refuses: mutability.immutable at 23:9
// calling a `&var self` method on an implicit by-value capture, in a closure
// passed straight to a non-escaping parameter: a by-value capture is a `let`
// in the closure's body (SL-472)

struct P {
    x: Int
}

extension P {
    func bump(&var self) {
        self.x = self.x + 1
    }
}

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var p = P(x: 1)
    run({
        p.bump()
        p.x
    })
}
