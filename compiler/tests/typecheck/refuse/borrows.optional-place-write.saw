// refuses: borrows.optional-place-write at 8:5
// a conditional lend's optional place assigned whole: no Optional is stored
// there, only the element when one is present, so the fix writes it through
// its binding (SL:borrowing §2.4; SL-899)
// message: `v.find(0)` lends a place only when one is present, so no Optional is stored there to write. Write the element through its binding: `if var x = v.find(0) { x = … }`

func clear(v: &var Vector<Int>) {
    v.find(0) = None
}

func main() {
}
