// refuses: transfer.implicit-copy at 17:15
// a repeat literal of a moved NoCopy value: the `move` hands over one value,
// and the literal still copies it (SL-612)

struct Handle {
    n: Int
}

extension Handle: NoCopy {}

func make() -> Handle {
    Handle(n: 1)
}

func main() {
    let h = make()
    let hs = [move h; 2]
    print(hs[0].n)
}
