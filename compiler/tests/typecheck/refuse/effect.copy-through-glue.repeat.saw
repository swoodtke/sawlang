// refuses: effect.copy-through-glue at 19:15
// a repeat literal copies its element after the first through glue
// message: a copy of `effect.copy-through-glue.repeat.Heavy` happens here, and it runs generated glue

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(a: &Heavy) -> Int {
    let arr = [a; 3]
    arr[2].n
}

func main() {
    let a = Heavy(n: 1)
    print(f(&a))
}
