// refuses: mutability.immutable at 30:15
// a `match` arm's `var` payload over a `borrow let` binding of std
// `Vector.find`, whose shared form `@synthesize(shared)` derives writes
// through a binding that lends its place shared (SL-906)

struct E { n: Int, items: Vector<Int> }
extension E: NoCopy {}
enum Sl { case Full(e: E), case Empty }
extension Sl: NoCopy {}

func grow(v: &var Vector<Int>) {
    var k = 0
    while k < 256 {
        try! v.push(k)
        k += 1
    }
}

func fresh() -> E {
    var items = Vector<Int>()
    try! items.push(41)
    E(n: 1, items: move items)
}


func main() {
    var c = Vector<E>()
    try! c.push(fresh())
    borrow let o = c.find(0) {
        match o {
            case Some(var e) -> { e.n = 5 },
            case None -> {}
        }
    }
}
