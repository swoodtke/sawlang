// refuses: atomics.target at 10:15
// flags: --std-root std --target riscv32-unknown-none-elf --target-features +m,-a,+c
// The target-atomics rule: a riscv32 list without the `A` extension lowers a
// compare-and-swap to an `__atomic_*` libcall, and naming a `SpinLock` is
// refused once, at the first written type that names it, saying to add `+a`
// (golden/atomics_target_answered.saw is the same program with it).

import std.spinlock.*

static COUNT: SpinLock<Int>

func bump() -> Int {
    borrow var n = COUNT.lock() {
        n = n + 1
        n
    }
}

func main() {
    print("{}", bump())
}
