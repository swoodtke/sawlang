// refuses: mutability.immutable at 40:9
// a write through a borrowing struct's `&var` field from a `&self` method: `&self` is read-only all the way down (SL-871)

struct Grid {
    cells: Vector<Int>
    n: Int
}

extension Grid: NoCopy {}

borrows struct Cells {
    grid: &var Grid,
    index: Int
}

extension Grid {
    func cells(&var self) borrows -> Cells {
        Cells(grid: lends self, index: 0)
    }

    func size(&self) -> Int { self.cells.len() }

    func bump(&var self) { self.n = self.n + 1 }
}

extension Cells: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.index >= self.grid.cells.len() {
            return None
        }
        let i = self.index
        self.index = i + 1
        self.grid.cells[i]
    }
}

extension Cells {
    func poke(&self) {
        self.grid.n = 5
    }
}
