// refuses: capture.escaping-consume at 25:27
// A closure passed to a parameter that says `escaping` consumes its `[move r]`
// capture by moving it into a field of a constructed value: the environment is
// shared by every copy of the closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

struct Holder {
    r: Res
}

extension Holder: NoCopy {}

func keep(f: () escaping -> Int) -> Int {
    f()
}

func probe() -> Int {
    let r = Res(id: 1)
    keep({ [move r] in
        let h = Holder(r: move r)
        h.r.id
    })
}
