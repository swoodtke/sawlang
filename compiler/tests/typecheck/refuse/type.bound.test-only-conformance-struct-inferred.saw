// refuses: type.bound at 22:13
// a generic struct's inferred argument in ordinary code met only by a
// test-only conformance

struct Money {
    cents: Int
    tag: String
}

@test
extension Money: Equatable {
    func equals(&self, other: &Money) -> Bool {
        self.cents == other.cents
    }
}

struct Holder<T: Equatable> {
    t: T
}

func main() {
    let h = Holder(t: Money(cents: 1, tag: "a"))
    print("{}", h.t.cents)
}
