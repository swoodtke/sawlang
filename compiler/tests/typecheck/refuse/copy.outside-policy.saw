// refuses: copy.outside-policy at 11:10
// a `copy()` in a plain extension of a type that is Copy by its members: a
// silent copy would copy the bits and a spelled one run the method, two
// answers for one value, so the method is refused (conformance row V151)

struct Money {
    cents: Int
}

extension Money {
    func copy(&self) -> Money {
        print("user copy")
        Money(cents: self.cents + 100)
    }
}

func main() {
    let a = Money(cents: 1)
    let b = a
    let c = a.copy()
    print("{} {}", b.cents, c.cents)
}
