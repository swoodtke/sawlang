// refuses: copy.test-only-policy at 9:18
// a test-only `Copy` conformance with a retain hook on a production type

struct Money {
    cents: Int
}

@test
extension Money: Copy {
    func copy(&self) -> Money {
        Money(cents: self.cents + 100)
    }
}

func main() {
    let a = Money(cents: 1)
    let b = a
    print("{}", b.cents)
}
