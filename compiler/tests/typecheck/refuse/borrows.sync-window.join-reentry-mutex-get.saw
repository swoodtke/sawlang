// refuses: borrows.sync-window at 18:9
// A lock's window around a `join()` of a cooperative task: the join suspends, and a
// `borrows(sync)` accessor's borrow cannot be held across a suspension, so the
// window is refused at compile time (conformance row K206).
import std.mutex.{Mutex}

static G: Mutex<Int>

func take() -> Int {
    G.get()
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(take())
    let r = borrow var o = G.lock() {
        o = 10
        h.join()
    }
    print("joined {}", r)
}
