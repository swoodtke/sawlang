// message: a fallible `init` does not meet an infallible requirement
enum LoadError { case Missing }

trait Make {
    init(seed: Int) -> Self
}

struct Page { number: Int }

extension Page: Make {
    init(seed: Int) -> Result<Page, LoadError> {
        if seed < 0 { return LoadError.Missing }
        return Page(number: seed)
    }
}

func main() {
    let _ = Page(seed: 1)
}
