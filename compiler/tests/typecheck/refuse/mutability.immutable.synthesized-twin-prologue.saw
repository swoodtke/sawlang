// refuses: mutability.immutable at 14:9
// a `@synthesize(shared)` accessor whose prologue writes `self`: the twin it
// derives checks the same body under `&self`, where the write is refused
// (conformance row X60)

struct H {
    n: Int
    reads: Int
}

extension H {
    @synthesize(shared)
    func at(&var self) borrows -> &var Int {
        self.reads = self.reads + 1
        lend self.n
    }
}
