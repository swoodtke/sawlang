// refuses: mutability.immutable at 9:17
// the builtin `take()` on an implicit by-value capture, in a closure bound to
// a `let`, which escapes: a by-value capture is a `let` in the closure's body
// (SL-472)

func probe() -> Int {
    var o: Int? = 3
    let f = {
        let t = o.take()
        t ?? 0
    }
    f()
}
