// refuses: static.not-constant at 10:22
// a local named as an array length: it wins over a static of its name and is
// the run-time value it looks like, refused as such and never as a static
// message: `REGION` is not a constant, and an array length is a constant expression: it names a binding whose value is known only at run time

static REGION: Int = 64

func main() {
    let REGION = REGION + 1
    var buf: [UInt8; REGION] = [0; 4]
    print(buf.len())
}
