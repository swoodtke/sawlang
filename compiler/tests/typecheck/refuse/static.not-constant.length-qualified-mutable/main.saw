// refuses: static.not-constant at 9:20
// a mutable static of another module, named through its module as an array
// length (SL-920)
// message: `sizes.LIVE` is not a constant, and an array length is a constant expression: it names an `unsafe static var`, whose value belongs to the running program

import sizes

struct Frame {
    bytes: [UInt8; sizes.LIVE]
}

func main() {
    let f = Frame(bytes: [0; 4])
    print(f.bytes.len())
}
