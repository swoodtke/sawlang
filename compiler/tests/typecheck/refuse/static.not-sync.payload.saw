// refuses: static.not-sync at 17:8
// a static holding an enum whose payload is an interior cell, and which declares no `UnsafeSync`; the enum sits in an Optional, whose zero is `None`, so the static's zero is valid

enum Slot {
    case Held(cell: UnsafeMutableInterior<Int>),
    case Empty
}

extension Slot: NoCopy {}

struct Bay {
    slot: Slot?
}

extension Bay: NoCopy {}

static BAY: Bay

func main() {
    print(0)
}
