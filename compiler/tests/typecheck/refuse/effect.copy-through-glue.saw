import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

struct Pair {
    h: Heavy
    k: Int
}

@synthesize
extension Pair: Copy {}

func f(p: &Pair) -> Int {
    let q = p
    q.h.n
}

func main() {
    let p = Pair(h: Heavy(n: 1), k: 2)
    print(f(&p))
}
