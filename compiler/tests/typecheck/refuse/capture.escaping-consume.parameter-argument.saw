// refuses: capture.escaping-consume at 23:14
// A closure passed to a parameter that says `escaping` consumes its `[move r]`
// capture by moving it into an argument: the environment is shared by every
// copy of the closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

func sink(r: Res) -> Int {
    r.id
}

func keep(f: () escaping -> Int) -> Int {
    f()
}

func probe() -> Int {
    let r = Res(id: 1)
    keep({ [move r] in
        sink(move r)
    })
}
