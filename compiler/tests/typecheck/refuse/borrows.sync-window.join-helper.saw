// refuses: borrows.sync-window at 34:17
// a user function that joins drives the executor too, so calling it inside
// the window is refused (SL-1156)

import std.task.*

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func writer() -> Int {
    install(42)
    0
}

func settle() -> Int {
    Task.spawn(writer()).join()
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let r = settle()
        print("{} {}", b.tag, r)
    }
}
