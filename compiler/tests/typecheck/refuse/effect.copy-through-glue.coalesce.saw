// refuses: effect.copy-through-glue at 19:13
// `o ?? a` copies the Optional `o` whole before it takes the payload
// message: a copy of `effect.copy-through-glue.coalesce.Heavy?` happens here

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(o: &Heavy?, a: Heavy) -> Int {
    let b = o ?? a
    b.n
}

func main() {
    let o: Heavy? = None
    print(f(&o, Heavy(n: 1)))
}
