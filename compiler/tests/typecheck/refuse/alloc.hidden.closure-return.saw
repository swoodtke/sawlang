// refuses: alloc.hidden at 7:5
// flags: --std-root std --no-hidden-alloc
// message: an escaping closure heap-allocates its captured environment
// A capturing closure returned from the function that builds it.

func adder(base: Int) -> (Int) sync -> Int {
    { n: Int in n + base }
}

func main() {
    let add = adder(base: 10)
    print("{}", add(5))
}
