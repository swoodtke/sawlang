// refuses: erasure.not-object-safe at 21:12
// a trait with a static requirement, erased in a field's `Box`

trait Make {
    static func make() -> Int
    func id(&self) -> Int
}

struct P { n: Int }

extension P: Make {
    static func make() -> Int {
        0
    }
    func id(&self) -> Int {
        self.n
    }
}

struct Holder {
    b: Box<any Make>
}

extension Holder: NoCopy {}

func main() {
    print(0)
}
