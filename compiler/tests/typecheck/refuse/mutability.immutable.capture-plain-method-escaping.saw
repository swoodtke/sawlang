// refuses: mutability.immutable at 19:9
// calling a `&var self` method on an implicit by-value capture, in a closure
// bound to a `let`, which escapes: a by-value capture is a `let` in the
// closure's body (SL-472)

struct P {
    x: Int
}

extension P {
    func bump(&var self) {
        self.x = self.x + 1
    }
}

func probe() -> Int {
    var p = P(x: 1)
    let f = {
        p.bump()
        p.x
    }
    f()
}
