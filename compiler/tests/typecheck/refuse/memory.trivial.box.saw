// an `UnsafeMemory` view of a `Box`, which owns its allocation: a view copies
// the bytes it reads and writes, so its `T` is trivially copyable

import std.box.{Box}

func reach(address: Int) unsafe {
    let view: UnsafeMemory<Box<Int>, Normal> = UnsafeMemory(address)
    let _ = view
}

func main() {
    print(0)
