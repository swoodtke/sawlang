// refuses: borrows.unmarked-call at 30:12
// a `return` operand, written without `borrow` (SL-849)
// message: write `borrow st.slot(0).n`

struct Entry { n: Int }

extension Entry {
    func twice(&self) -> Int { self.n * 2 }
    func bump(&var self) { self.n += 1 }
}

struct Store { items: [Entry; 2] }

extension Store {
    @synthesize(shared)
    func slot(&var self, i: Int) borrows -> &var Entry {
        lend self.items[i]
    }

    @synthesize(shared)
    func find(&var self, i: Int) borrows -> &var Entry? {
        if i < 0 || i >= 2 {
            return None
        }
        lend self.items[i]
    }
}

func first(st: &var Store) -> Int {
    return st.slot(0).n
}

func main() {
    var st = Store(items: [Entry(n: 1), Entry(n: 2)])
    print(first(&var st))
}
