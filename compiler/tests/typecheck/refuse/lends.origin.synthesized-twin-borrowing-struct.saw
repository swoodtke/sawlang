// `&var`: the derived twin fills that field from `&self`, as a written `&self`
// twin is refused for (conformance row X60)

struct C {
    n: Int
}

borrows struct Cursor {
    c: &var C
    i: Int
}

extension Cursor: Iterator {
    type Item = Int
