// a chain of two accessors, refused once, at the inner call, written without
// `borrow` (SL-849)
// message: write `borrow o.store().slot(0).n`

struct Entry { n: Int }

extension Entry {
    func twice(&self) -> Int { self.n * 2 }
    func bump(&var self) { self.n += 1 }
}

struct Store { items: [Entry; 2] }

extension Store {
    @synthesize(shared)
    func slot(&var self, i: Int) borrows -> &var Entry {
        lend self.items[i]
    }

    @synthesize(shared)
    func find(&var self, i: Int) borrows -> &var Entry? {
        if i < 0 || i >= 2 {
            return None
        }
        lend self.items[i]
    }
}

struct Outer { st: Store }

extension Outer {
    func store(&var self) borrows -> &var Store {
        lend self.st
    }
}

func main() {
    var st = Store(items: [Entry(n: 1), Entry(n: 2)])
    var o = Outer(st: move st)
    print(o.store().slot(0).n)
}
