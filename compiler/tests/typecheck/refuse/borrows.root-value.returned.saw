// refuses: borrows.root-value at 21:5
// errors: 1
// a returned closure leaves its function, so it reaches no static root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func make() -> () sync -> Void {
    { install(2) }
}

func main() {
    make()()
}
