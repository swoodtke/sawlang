// refuses: borrowing.sigil-place at 20:10
// a named accessor behind a sigil, `&var bag.at(0)`: `borrow var bag.at(0)`
// (SL:borrowing §2.2, §9; SL-491)

struct P { n: Int }

struct Bag { items: [P; 2] }

extension Bag {
    func at(&var self, i: Int) borrows -> &var P {
        lend self.items[i]
    }
}

func bump(p: &var P) {
    p.n = p.n + 1
}

func first(bag: &var Bag) {
    bump(&var bag.at(0))
}

func main() {
}
