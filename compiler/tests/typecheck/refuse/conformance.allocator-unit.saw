// refuses: conformance.allocator-unit at 11:20
// an `Allocator` conformer with a field and an `init` of its own, refused at the conformance: an allocator is zero-sized, so `A()` has nothing to build (SL-966)
// message: `Counted` has the field `start` and writes `Counted.init() ->
// message: an allocator is zero-sized and static-backed (design 19)
struct Counted { start: Int }

extension Counted {
    init() -> Counted { Counted(start: 0) }
}

extension Counted: Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        GlobalAllocator().alloc(size, align)
    }
    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        GlobalAllocator().dealloc(ptr, size, align)
    }
}

func main() {
    var v = Vector<Int, Counted>()
    try! v.push(1)
    print("{}", v.len())
}
