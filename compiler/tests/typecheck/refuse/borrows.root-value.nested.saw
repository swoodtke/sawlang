// errors: 1
// a closure that may escape reaches a root through a non-escaping closure it runs (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func run(body: () sync -> Void) sync {
    body()
}

func main() {
    let f = { run({ install(1) }) }
    f()
}
