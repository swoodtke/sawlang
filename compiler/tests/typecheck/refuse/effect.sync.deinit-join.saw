// refuses: effect.sync at 16:67
// flags: --std-root std
// a `deinit` not declared `blocking` that joins a thread: `Thread.join` is a
// pair whose default parks, and a `deinit` runs where nothing may suspend,
// so the message points at `blocking` on the `deinit` (conformance row K186)

import std.task.{Thread}

struct Pool {
    workers: Vector<Thread<Void>>
}

extension Pool: NoCopy {
    func deinit(&var self) {
        while self.workers.len() > 0 {
            if let held = self.workers.pop() { var h = move held; h.join() }
        }
    }
}

func main() {
    let pool = Pool(workers: Vector<Thread<Void>>())
    print(pool.workers.len())
}
