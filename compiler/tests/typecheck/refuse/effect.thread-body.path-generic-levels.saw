// refuses: effect.thread-body at 30:33
// flags: --std-root std
// message: closure calls `twice` → `run_two` → `run_one` → `Slow.step` → `yield_now` (parks the task):
// a `Thread.spawn` body reaching a generic that forwards its `T` to another
// generic: the path follows both levels at the type argument to the park
// (SL-982)

import std.task.{yield_now}

trait Step {
    func step(&self) -> Int
}

struct Slow { n: Int }

extension Slow: Step {
    func step(&self) -> Int {
        yield_now()
        self.n
    }
}

func run_one<T: Step>(t: &T) -> Int { t.step() }

func run_two<U: Step>(u: &U) -> Int { run_one(&u) + 1 }

func twice() -> Int { run_two(&Slow(n: 1)) }

func main() {
    var t = try! Thread.spawn { twice() }
    print(t.join())
}
