// refuses: borrows.root-erased at 38:21
// errors: 1
// a type erased to `any Trait` whose method opens a window on a static root is refused where it is erased; a dispatch through `any` is not followed to its implementation (SL-1156)
// message: its implementation of `Probe.look`, `Writer.look`, may open a window

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

trait Probe {
    func look(&self) -> Int
}

struct Writer {
    n: Int
}

extension Writer: Probe {
    func look(&self) -> Int {
        boot_slot() = Boot(count: self.n, tag: self.n)
        self.n
    }
}

func use(p: &any Probe) -> Int {
    p.look()
}

func main() {
    let w = Writer(n: 1)
    print("{}", use(&w))
}
