// refuses: type.bound at 21:14
// a `for` loop over a type whose `next` is declared in a bounded extension
// its argument does not meet (SL-463)

struct Token { id: Int }
extension Token: NoCopy {}

struct Walk<T> { v: T, n: Int }
extension Walk<T: Equatable> {
    func next(&var self) -> Int? {
        if self.n == 0 {
            return None
        }
        self.n = self.n - 1
        self.n
    }
}

func main() {
    var w = Walk(v: Token(id: 1), n: 2)
    for i in w {
        print(i)
    }
}
