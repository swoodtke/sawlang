// refuses: mutability.immutable at 34:14
// a `for` head through a `&var self` accessor lending a borrowing struct,
// with no shared twin, on a `let` root (SL-470)

struct Grid {
    cells: [Int; 4]
    walks: Int
}

borrows struct Walk {
    grid: &Grid,
    index: Int
}

extension Walk {
    func next(&var self) -> Int? {
        if self.index >= 4 {
            return None
        }
        self.index = self.index + 1
        self.grid.cells[self.index - 1]
    }
}

extension Grid {
    func walk(&var self) borrows -> Walk {
        self.walks += 1
        lend Walk(grid: &self, index: 0)
    }
}

func main() {
    let g = Grid(cells: [1, 2, 3, 4], walks: 0)
    for c in g.walk() {
        print(c)
    }
}
