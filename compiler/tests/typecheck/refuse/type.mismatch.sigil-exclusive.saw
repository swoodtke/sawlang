// refuses: type.mismatch at 33:18
// `&var x` passed to a `&T` parameter of a free function: call sites
// mirror the parameter's reference spelling (SL-484)
struct Box2 {
    n: Int
}

extension Box2 {
    init(r: &Int) -> Box2 {
        Box2(n: r)
    }

    func look(&self, r: &Int) -> Int {
        r + self.n
    }

    static func peek(r: &Int) -> Int {
        r
    }
}

func look(r: &Int) -> Int {
    r
}

func pair(a: Int, r: &Int) -> Int {
    a + r
}


func main() {
    var n = 1
    let _ = look(&var n)
}
