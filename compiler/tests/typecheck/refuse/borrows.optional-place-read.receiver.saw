// refuses: borrows.optional-place-read at 18:5
// a conditional lend's optional place as the shared receiver of a method on
// its Optional reads it whole, a copy an ExplicitCopy payload does not make
// silently; `is_some()` and `is_none()` read the tag alone and are accepted
// (SL:borrowing §2.2, §2.4; SL-899)
// message: which does not copy silently: call it on `v.find(0).copy()`, or name the place: `if let x = v.find(0) { … }`

struct Bag { items: Vector<Int> }
@synthesize
extension Bag: ExplicitCopy {}

extension Optional<Bag> {
    func held(&self) -> Bool { self.is_some() }
}

func check(v: &Vector<Bag>) -> Bool {
    let present = v.find(0).is_some()
    v.find(0).held() && present
}

func main() {
}
