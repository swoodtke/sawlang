// refuses: effect.suspending-value at 32:13
// a function that joins a task, taken as a value and called inside the window
// of an exclusive static root (SL-1156)

import std.task.*

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func writer() -> Int {
    install(42)
    0
}

func settle() -> Int {
    Task.spawn(writer()).join()
}

func main() {
    let f = settle
    borrow var b = boot_slot() {
        b.tag = 7
        let r = f()
        print("{} {}", b.tag, r)
    }
}
