// refuses: capture.escaping-consume at 19:9
// A closure stored in a struct's field consumes its `[move r]` capture by
// handing it on as the body's tail: the environment is shared by every copy of
// the closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

struct Keeper {
    f: () -> Res
}

func probe() -> Keeper {
    let r = Res(id: 1)
    Keeper(f: { [move r] in
        move r
    })
}
