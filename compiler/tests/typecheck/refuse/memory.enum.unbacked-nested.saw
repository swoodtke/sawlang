enum Phase {
    case Idle,
    case Busy
}

struct Slot {
    phase: Phase
}

struct Table {
    slots: [Slot; 4]
}

func reach(address: Int) unsafe {
    let _ = UnsafeMemory<Table, Normal>(address)
}

