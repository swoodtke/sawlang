// refuses: conformance.policy-placement at 12:20
// a test-only `UnsafeSync` on a production type, which test code's `T: Sync`
// bound would meet

struct Counter {
    cell: UnsafeMutableInterior<Int>
}

extension Counter: NoCopy {}

@test
extension Counter: UnsafeSync {}

func share<T: Sync>(x: &T) {}

@test
func relay(c: &Counter) {
    share(&c)
}

func main() {
    print("ok")
}
