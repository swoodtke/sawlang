// refuses: capture.escaping-consume at 25:27
// A closure stored in a struct's field consumes its `[move r]` capture by
// moving it into a field of a constructed value: the environment is shared by
// every copy of the closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

struct Holder {
    r: Res
}

extension Holder: NoCopy {}

struct Keeper {
    f: () -> Int
}

func probe() -> Keeper {
    let r = Res(id: 1)
    Keeper(f: { [move r] in
        let h = Holder(r: move r)
        h.r.id
    })
}
