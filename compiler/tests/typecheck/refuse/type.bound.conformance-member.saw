// refuses: type.bound at 16:15
// a member of the bounded conformance `extension Cell<T: Equatable>:
// Equatable`, called on a `Cell<Token>` (SL-463)

struct Token { id: Int }
extension Token: NoCopy {}

struct Cell<T> { v: T }
extension Cell<T: Equatable>: Equatable {
    func equals(&self, other: &Cell<T>) -> Bool { self.v == other.v }
}

func main() {
    let a = Cell(v: Token(id: 3))
    let b = Cell(v: Token(id: 4))
    let s = a.equals(&b)
}
