// refuses: transfer.implicit-copy at 25:23
// a part of a `borrow PLACE`, here a field, as a NoCopy raw-backed enum's
// cast operand is read by value as the whole `borrow PLACE` is, refused until
// SL-642 makes such a place at a Borrow position read through its window

enum Tag: UInt8 {
    case A = 1,
    case B = 2
}

extension Tag: NoCopy {
    func deinit(&var self) {
    }
}

struct Holder {
    tag: Tag
}

extension Holder: NoCopy {}

func main() {
    var hs = Vector<Holder>()
    try! hs.push(Holder(tag: Tag.B))
    print("field {}", (borrow hs[0]).tag as UInt8)
}
