// refuses: mutability.immutable at 30:5
// a `borrow var` statement compound-assigning a field through a read-only
// lend (SL-487)
struct Cell {
    n: Int
}

extension Cell {
    func bump(&var self) {
        self.n += 1
    }
}

struct Grid {
    cells: [Cell; 2]
}

extension Grid {
    func ro(&self, i: Int) borrows -> &Cell {
        lend self.cells[i]
    }

    func rw(&var self, i: Int) borrows -> &var Cell {
        lend self.cells[i]
    }
}

func main() {
    var g = Grid(cells: [Cell(n: 1), Cell(n: 2)])
    borrow var g.ro(0).n += 1
}
