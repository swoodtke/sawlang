// refuses: borrows.root-value at 23:17
// errors: 1
// a closure pushed into a collection is called wherever the collection goes, so it reaches no static root (SL-1156)
// message: may outlive the statement that makes it

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func main() {
    var v = Vector<() sync -> Void>()
    try! v.push({ install(3) })
    print("{}", v.len())
}
