// refuses: borrows.sync-window at 31:17
// a group task's `join` inside the window runs the group's sweep there
// (SL-1156)

import std.task.*

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func writer() -> Int {
    install(42)
    0
}

func main() {
    var group = TaskGroup()
    borrow var b = boot_slot() {
        b.tag = 7
        let r = group.spawn(writer()).join()
        print("{} {}", b.tag, r)
    }
}
