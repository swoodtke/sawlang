// refuses: transfer.implicit-copy at 26:23
// `case Some(x)` over a lent optional place copies the payload, as a plain
// `if let` does; `case Some(borrow let x)` binds it in place (SL:borrowing
// §2.4; SL-492)

struct Res { n: Int }

extension Res: NoCopy {}

struct Bag { held: [Res; 2] }

extension Bag: NoCopy {}

extension Bag {
    func find(&var self, i: Int) borrows -> &var Res? {
        if i < 0 || i > 1 {
            return None
        }
        lend self.held[i]
    }
}

func look(b: &var Bag) -> Int {
    borrow var e = b.find(0) {
        match e {
            case Some(x) -> x.n,
            case None -> 0
        }
    }
}

func main() {
}
