// refuses: mutability.immutable at 13:9
// writing a `Vector` element (heap storage) of a `[move v]` capture, in a
// closure passed straight to a non-escaping parameter: a by-value capture is a
// `let` in the closure's body (SL-472)

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var v: Vector<Int> = [1]
    run({ [move v] in
        v[0] = 9
        v[0]
    })
}
