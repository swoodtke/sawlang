// refuses: effect.copy-through-glue at 19:13
// a fixed array of `Heavy`, copied whole
// message: a copy of `[effect.copy-through-glue.array.Heavy; 2]` happens here

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(arr: &[Heavy; 2]) -> Int {
    let b = arr
    b[1].n
}

func main() {
    let arr = [Heavy(n: 1), Heavy(n: 2)]
    print(f(&arr))
}
