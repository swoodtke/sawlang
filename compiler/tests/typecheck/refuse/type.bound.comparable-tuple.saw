// refuses: type.bound at 11:17
// a `T: Comparable` bound at a tuple, which meets `Equatable` and `Hashable`
// through its elements and `Comparable` never (spec, Ordering).
func less<T: Comparable>(a: &T, b: &T) -> Bool {
    a < b
}

func main() {
    let a = (1, 2)
    let b = (1, 3)
    print("{}", less(&a, &b))
}
