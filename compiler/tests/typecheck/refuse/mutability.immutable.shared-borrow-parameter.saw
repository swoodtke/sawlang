// refuses: mutability.immutable at 28:5
// a bare `borrow` statement writing through a `&Grid` parameter (SL-487)
struct Cell {
    n: Int
}

extension Cell {
    func bump(&var self) {
        self.n += 1
    }
}

struct Grid {
    cells: [Cell; 2]
}

extension Grid {
    func ro(&self, i: Int) borrows -> &Cell {
        lend self.cells[i]
    }

    func rw(&var self, i: Int) borrows -> &var Cell {
        lend self.cells[i]
    }
}

func set(g: &Grid) {
    borrow g.ro(0).n = 7
}
