// refuses: erasure.not-object-safe at 19:18
// a trait with an associated type, erased in a parameter's `Box`

trait Walk {
    type Item
    func step(&var self) -> Int
}

struct P { n: Int }

extension P: Walk {
    type Item = Int
    func step(&var self) -> Int {
        self.n = self.n + 1
        self.n
    }
}

func take(b: Box<any Walk>) -> Int {
    1
}

func main() {
    print(0)
}
