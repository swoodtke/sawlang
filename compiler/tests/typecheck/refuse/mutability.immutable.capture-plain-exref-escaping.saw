// refuses: mutability.immutable at 12:19
// `&var` of an implicit by-value capture, in a closure bound to a `let`, which
// escapes: a by-value capture is a `let` in the closure's body (SL-472)

func bump(r: &var Int) {
    r = r + 1
}

func probe() -> Int {
    var n = 0
    let f = {
        bump(&var n)
        n
    }
    f()
}
