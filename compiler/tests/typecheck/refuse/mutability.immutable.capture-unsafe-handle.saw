// refuses: mutability.immutable at 32:24
// an exclusive `borrows` accessor through a `[move h]` capture of a handle:
// a capture is judged exactly as a `let` of its type, so `h.deref()` opens no
// exclusive window, as on a `let h` (SL-472)

struct Counter {
    n: Int
}

extension Counter {
    func bump(&var self) {
        self.n = self.n + 10
    }
}

struct Handle {
    c: Counter
}

extension Handle {
    func deref(&var self) borrows -> &var Counter {
        lend self.c
    }
}

func run_int(body: () sync -> Int) -> Int {
    body()
}

func through_capture(h: Handle) -> Int {
    run_int({ [move h] in
        borrow var c = h.deref() { c.bump() }
        1
    })
}
