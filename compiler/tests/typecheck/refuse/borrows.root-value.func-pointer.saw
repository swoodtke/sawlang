// refuses: borrows.root-value at 26:49
// errors: 2
// a `FuncPointer` from a function name or from a literal with no captures is a value that goes anywhere, so its code reaches no static root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func reset() sync {
    install(0)
}

func main() {
    let named: FuncPointer<() sync -> Void> = reset
    let literal: FuncPointer<() sync -> Void> = { install(5) }
    named()
    literal()
}
