// refuses: capture.escaping-consume at 19:16
// A closure passed to a parameter that says `escaping` consumes its `[move r]`
// capture by returning it: the environment is shared by every copy of the
// closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

func keep(f: () escaping -> Res) -> Res {
    f()
}

func probe() -> Res {
    let r = Res(id: 1)
    keep({ [move r] in
        return move r
    })
}
