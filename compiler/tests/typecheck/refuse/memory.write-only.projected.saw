// refuses: memory.write-only at 11:5
// `read()` of a `WriteOnly` register reached by a field projection

struct Port {
    data: UInt32
    status: ReadOnly<UInt32>
    clear: WriteOnly<UInt32>
}

func reach(address: Int) unsafe -> UInt32 {
    UnsafeMemory<Port, Device>(address).clear.read()
}

func main() {
    print(0)
}
