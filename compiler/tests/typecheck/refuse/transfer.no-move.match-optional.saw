// refuses: transfer.no-move at 14:11
// An optional of a `NoMove` payload is `NoMove`, so a `match` consuming an
// owned one relocates it (SL-681).

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {}
extension Pinned: NoMove {}

func main() {
    let o: Pinned? = Pinned(id: 1)
    match o {
        case Some(p) -> print("{}", p.id),
        case None -> print("none")
    }
}
