// refuses: slice.not-yet at 6:18
// arithmetic over a const parameter in a repeat count, which folds only per instantiation (U4 owns it)
// message: arithmetic over a const parameter

func grow<const N: Int>() -> Int {
    let xs = [0; N + 1]
    xs.len()
}

func main() {
    print("{}", grow<4>())
}
