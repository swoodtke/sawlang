// refuses: conformance.policy-placement at 11:18
// a test-only `NoCopy` conformance on a production type, whose `deinit` would
// run in a production build: test code is a file of its own, and a type's
// policies are declared in its defining file (SL-659)

struct Noisy {
    id: Int
}

@test
extension Noisy: NoCopy {
    func deinit(&var self) {
        print("test-only deinit {}", self.id)
    }
}

func main() {
    let n = Noisy(id: 7)
    print("made {}", n.id)
}
