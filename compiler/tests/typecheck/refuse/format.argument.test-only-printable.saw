// refuses: format.argument at 18:17
// ordinary code formatting a type only a test-only conformance makes `Printable`

struct Money {
    cents: Int
    tag: String
}

@test
extension Money: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append("money")
    }
}

func main() {
    let a = Money(cents: 1, tag: "a")
    print("{}", a)
}
