// refuses: copy.requirement at 23:13
// a closure naming an unbounded type parameter's local captures it by
// value, the inferred Copy requirement, refused at a NoCopy call (D30)
struct Res {
    name: String
}

extension Res: NoCopy {}

func run(f: () -> Int) -> Int {
    f()
}

func measure<T>(x: &T) -> Int {
    1
}

func plain<T>(x: T) -> Int {
    run({ measure(&x) })
}

func main() {
    let _ = plain(Res(name: "a"))
}
