// refuses: mutability.immutable at 9:9
// writing an inline array element of an implicit by-value capture, in a
// closure bound to a `let`, which escapes: a by-value capture is a `let` in
// the closure's body (SL-472)

func probe() -> Int {
    var a: [Int; 3] = [1, 2, 3]
    let f = {
        a[0] = 9
        a[0]
    }
    f()
}
