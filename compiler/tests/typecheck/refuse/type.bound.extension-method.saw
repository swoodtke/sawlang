// refuses: type.bound at 16:15
// a method of `extension Cell<T: Equatable>` on a `Cell<Token>`: the member
// exists only where its extension's bound holds (SL-463)

struct Token { id: Int }
extension Token: NoCopy {}

struct Cell<T> { v: T }
extension Cell<T: Equatable> {
    func same(&self, other: &Cell<T>) -> Bool { self.v == other.v }
}

func main() {
    let a = Cell(v: Token(id: 3))
    let b = Cell(v: Token(id: 4))
    let s = a.same(&b)
}
