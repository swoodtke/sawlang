// refuses: borrows.root-hook at 45:10
// errors: 1
// a `deinit` that compares tuples calls the elements' equality, so it reaches a static root through it and is
// refused as a hook that opens a window is (SL-1156)
// message: is a `deinit`, which runs where a value is dropped

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct HKey {
    n: Int
}

extension HKey: Equatable {
    func equals(&self, other: &Self) -> Bool {
        install(self.n)
        self.n == other.n
    }
}

extension HKey: Hashable {
    func hash(&self, h: &var Hasher) {
        install(self.n)
        h.write_int(self.n)
    }
}

struct Guard {
    n: Int
}

extension Guard: NoCopy {
    func deinit(&var self) {
        if (HKey(n: self.n), 1) == (HKey(n: self.n), 1) {
            self.n = 0
        }
    }
}

func main() {
    let g = Guard(n: 1)
    print("{}", g.n)
}
