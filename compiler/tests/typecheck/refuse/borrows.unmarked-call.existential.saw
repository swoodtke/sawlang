// refuses: borrows.unmarked-call at 40:5
// a call through `any`, written without `borrow` (SL-849)
// message: write `borrow t.get().n`

struct Entry { n: Int }

extension Entry {
    func twice(&self) -> Int { self.n * 2 }
    func bump(&var self) { self.n += 1 }
}

struct Store { items: [Entry; 2] }

extension Store {
    @synthesize(shared)
    func slot(&var self, i: Int) borrows -> &var Entry {
        lend self.items[i]
    }

    @synthesize(shared)
    func find(&var self, i: Int) borrows -> &var Entry? {
        if i < 0 || i >= 2 {
            return None
        }
        lend self.items[i]
    }
}

trait Lens {
    func get(&var self) borrows -> &var Entry
}

extension Store: Lens {
    func get(&var self) borrows -> &var Entry {
        lend self.items[0]
    }
}

func via(t: &var any Lens) -> Int {
    t.get().n
}

func main() {
    var st = Store(items: [Entry(n: 1), Entry(n: 2)])
    print(via(&var st))
}
