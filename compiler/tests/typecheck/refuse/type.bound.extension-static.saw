// refuses: type.bound at 16:25
// a static of `extension Cell<T: Equatable>` named on `Cell<Token>`, which
// Stage 0 accepts (SL:hazards S26)

struct Token { id: Int }
extension Token: NoCopy {}

struct Cell<T> { v: T }
extension Cell<T: Equatable> {
    static func twin(a: &Cell<T>, b: &Cell<T>) -> Bool { a.v == b.v }
}

func main() {
    let a = Cell(v: Token(id: 3))
    let b = Cell(v: Token(id: 4))
    let s = Cell<Token>.twin(&a, &b)
}
