// refuses: capture.escaping-consume at 21:27
// A closure bound to a `let`, which escapes consumes its `[move r]` capture by
// moving it into a field of a constructed value: the environment is shared by
// every copy of the closure and outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

struct Holder {
    r: Res
}

extension Holder: NoCopy {}

func probe() -> Int {
    let r = Res(id: 1)
    let f: () -> Int = { [move r] in
        let h = Holder(r: move r)
        h.r.id
    }
    f()
}
