// refuses: transfer.no-move at 22:11
// An arm that binds nothing still consumes the scrutinee: the match holds
// it in storage of its own until the arm completes (SL-681).

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {}
extension Pinned: NoMove {}

enum Holder {
    case Has(p: Pinned),
    case Empty
}

extension Holder: NoCopy {}
extension Holder: NoMove {}

func main() {
    let h = Holder.Has(p: Pinned(id: 1))
    match h {
        case Has(_) -> print("has"),
        case Empty -> print("empty")
    }
}
