// refuses: effect.copy-through-glue at 19:13
// an Optional of `Heavy`, copied whole
// message: a copy of `effect.copy-through-glue.optional.Heavy?` happens here

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(o: &Heavy?) -> Int {
    let p = o
    p!.n
}

func main() {
    let o: Heavy? = Heavy(n: 1)
    print(f(&o))
}
