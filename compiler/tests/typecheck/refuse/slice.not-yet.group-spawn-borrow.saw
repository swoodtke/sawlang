// refuses: slice.not-yet at 16:30
// a `&var` argument of a `group.spawn` root borrows its spawner for the
// task's life, which needs the group's extent (SL:coroutines A8c); a borrow
// capture in a closure the root carries is the same borrow

import std.task.{yield_now}

func fill(v: &var Vector<Int>, n: Int) -> Int {
    yield_now()
    v.len() + n
}

func main() {
    var buf: Vector<Int> = []
    var group = TaskGroup()
    let h = group.spawn(fill(&var buf, 3))
    print("{}", h.join())
}
