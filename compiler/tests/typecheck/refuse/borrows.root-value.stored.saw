// refuses: borrows.root-value at 25:26
// errors: 1
// a closure stored in a field is called wherever the holder goes, so it reaches no static root (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct Handler {
    run: () sync -> Void
}

func main() {
    let h = Handler(run: { install(3) })
    h.run()
}
