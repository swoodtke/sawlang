// refuses: type.bound at 23:17
// ordinary code's inferred bound met only by a test-only conformance

struct Money {
    cents: Int
    tag: String
}

@test
extension Money: Equatable {
    func equals(&self, other: &Money) -> Bool {
        self.cents == other.cents
    }
}

func same<T: Equatable>(a: &T, b: &T) -> Bool {
    a == b
}

func main() {
    let a = Money(cents: 1, tag: "a")
    let b = Money(cents: 1, tag: "a")
    print("{}", same(&a, &b))
}
