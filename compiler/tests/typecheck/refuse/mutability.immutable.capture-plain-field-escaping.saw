// refuses: mutability.immutable at 13:9
// writing a field of an implicit by-value capture, in a closure bound to a
// `let`, which escapes: a by-value capture is a `let` in the closure's body
// (SL-472)

struct P {
    x: Int
}

func probe() -> Int {
    var p = P(x: 1)
    let f = {
        p.x = 2
        p.x
    }
    f()
}
