// refuses: transfer.no-move at 22:19
// A value `match` consumes its owned `NoMove` scrutinee as a statement one
// does (SL-681).

struct Pinned {
    id: Int
}

extension Pinned: NoCopy {}
extension Pinned: NoMove {}

enum Holder {
    case Has(p: Pinned),
    case Empty
}

extension Holder: NoCopy {}
extension Holder: NoMove {}

func main() {
    let h = Holder.Has(p: Pinned(id: 1))
    let n = match h {
        case Has(p) -> p.id,
        case Empty -> 0
    }
}
