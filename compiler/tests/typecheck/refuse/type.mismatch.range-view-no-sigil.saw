// refuses: type.mismatch at 10:17
// message: `a[1..3]` is a slice, which is forwarded as a reference is: forward it with its sigil, `&a[1..3]`
// A view passes by reference with the parameter's sigil (SL:borrowing §12.1,
// SL-988).

func total(s: &[Int]) -> Int { s.len() }

func main() {
    let a: [Int; 4] = [1, 2, 3, 4]
    print(total(a[1..3]))
}
