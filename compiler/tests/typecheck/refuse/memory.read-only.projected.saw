// refuses: memory.read-only at 11:5
// `write(v)` of a `ReadOnly` register reached by a field projection

struct Port {
    data: UInt32
    status: ReadOnly<UInt32>
    clear: WriteOnly<UInt32>
}

func reach(address: Int) unsafe {
    UnsafeMemory<Port, Device>(address).status.write(1)
}

func main() {
    print(0)
}
