// refuses: capture.escaping-consume at 21:10
// A returned closure consumes its `[move r]` capture by calling a `consumes`
// method on it: the environment is shared by every copy of the closure and
// outlives each call (SL-469)

struct Res {
    id: Int
}

extension Res: NoCopy {}

extension Res {
    func close(&var self) consumes -> Int {
        self.id
    }
}

func probe() -> () -> Int {
    let r = Res(id: 1)
    return { [move r] in
        (move r).close()
    }
}
