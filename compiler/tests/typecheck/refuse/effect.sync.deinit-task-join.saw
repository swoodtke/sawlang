// refuses: effect.sync at 17:17
// a `deinit` not declared `blocking` that joins a task: a `deinit` runs where
// nothing may suspend, so the message points at `blocking` on the `deinit`
// (conformance rows K226 and K222)

func work() -> Int {
    4
}

struct Noisy {
    n: Int
}

extension Noisy: NoCopy {
    func deinit(&var self) {
        let t = Task.spawn(work())
        let _ = t.join()
    }
}

func main() {
    let n = Noisy(n: 1)
    print(n.n)
}
