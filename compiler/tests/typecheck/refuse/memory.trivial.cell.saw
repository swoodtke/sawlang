// an `UnsafeMemory` view of an interior cell, which declares NoCopy: a view
// copies the bytes it reads and writes, so its `T` is trivially copyable

func reach(address: Int) unsafe {
    let view: UnsafeMemory<UnsafeMutableInterior<Int>, Normal> = UnsafeMemory(address)
    let _ = view
}

