// refuses: effect.sync at 9:37
// flags: --std-root std
// message: it calls `apply_to`, which is not sync-callable (`apply_to` → a call through a non-`sync` function value)
// a `sync` body calling a generic that calls through a function value not
// declared `sync`: the path ends at the call through the value (SL-982)

func apply_to<T>(x: &T, f: (&T) -> Int) -> Int { f(&x) }

func measured(n: Int) sync -> Int { apply_to(&n, { v in v + 1 }) }
