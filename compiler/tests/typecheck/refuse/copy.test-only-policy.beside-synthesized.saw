// refuses: copy.test-only-policy at 14:10
// a test-only `copy()` beside a production `Copy` conformance that derives
// its own: the test-only body is refused, and meets nothing

struct Money {
    cents: Int
}

@synthesize
extension Money: Copy {}

@test
extension Money {
    func copy(&self) -> Money {
        print("test-only copy")
        Money(cents: self.cents + 100)
    }
}

func main() {
    let a = Money(cents: 1)
    let b = a
    print("{}", b.cents)
}
