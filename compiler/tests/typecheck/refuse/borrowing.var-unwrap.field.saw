// refuses: borrowing.var-unwrap at 17:12
// `if var` over an optional field of a lent place: the payload is still
// storage the accessor lends (SL:borrowing §2.4; SL-492)

struct P { n: Int, next: Int? }

struct Bag { items: [P; 2] }

extension Bag {
    func at(&var self, i: Int) borrows -> &var P {
        lend self.items[i]
    }
}

func bump(b: &var Bag) {
    borrow var p = b.at(0) {
        if var x = p.next {
            x = 7
        }
    }
}

func main() {
}
