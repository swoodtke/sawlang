// refuses: effect.closure-suspends at 14:15
// a closure that calls a function that joins a task, called where it is
// written: the join parks, and a closure body may not suspend (conformance row
// K226)
func writer() -> Int {
    4
}

func settle() -> Int {
    Task.spawn(writer()).join()
}

func main() {
    let f = { settle() }
    print(f())
}
