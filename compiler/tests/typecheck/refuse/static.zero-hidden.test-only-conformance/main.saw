// refuses: static.zero-hidden at 7:8
// flags: --std-root std
// a production zero-initialized static of a struct only a test-only `ZeroInit` vouches for: production code is checked as if no test-only declaration existed, so the private field is hidden (SL:testing; SL-660)

import ports.{Port}

static PORT: Port

func main() {
    print(PORT.number())
}
