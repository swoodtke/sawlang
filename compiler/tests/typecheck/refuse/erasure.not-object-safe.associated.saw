// refuses: erasure.not-object-safe at 19:15
// a trait with an associated type, erased by a coercion to `&any`

trait Walk {
    type Item
    func step(&var self) -> Int
}

struct P { n: Int }

extension P: Walk {
    type Item = Int
    func step(&var self) -> Int {
        self.n = self.n + 1
        self.n
    }
}

func take(s: &any Walk) -> Int {
    1
}

func main() {
    let p = P(n: 1)
    print(take(&p))
}
