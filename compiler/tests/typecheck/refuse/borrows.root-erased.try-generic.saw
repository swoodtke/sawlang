// refuses: borrows.root-erased at 48:13
// errors: 1
// `try` in a generic body erases the error type parameter, so the instantiation whose error reaches a root is refused where the generic is called (SL-1156)
// message: its body makes it `any` at

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct Bad {
    n: Int
}

extension Bad: Printable {
    func format(&self, into: &var StringBuilder) {
        try! into.append(self.n)
    }

    func to_string(&self) -> String {
        install(self.n)
        "bad"
    }
}

extension Bad: Error {}

func fail() -> Result<Int, Bad> {
    Bad(n: 42)
}

func relay<E: Error>(r: Result<Int, E>) -> Result<Int, Box<any Error>> {
    let x = try move r
    x
}

func main() {
    let r = relay(fail())
    match r {
        case Ok(v) -> print(v),
        case Err(e) -> print(e.to_string())
    }
}
