// refuses: effect.format-suspends at 9:10
// a suspending `format` reached only by an explicit `format(into:)` call is
// refused all the same: `format` is `sync` (SL-781)

import std.task.*

struct Slow { n: Int }
extension Slow: Printable {
    func format(&self, into: &var StringBuilder) {
        yield_now()
        try! into.append(value: self.n)
    }
}

func render() -> Int {
    let s = Slow(n: 4)
    var b = StringBuilder()
    s.format(into: &var b)
    b.build().len()
}

func main() {
    var group = TaskGroup()
    let h = group.spawn(render())
    print("rendered {}", h.join())
}
