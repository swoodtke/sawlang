// refuses: borrowing.containment at 26:14
// a borrowing struct built outside the `borrows` function that lends it, as a `for` head: it would point into a root no window charges (spec, Borrowing structs)

struct Bag {
    n: Int
}

borrows struct Walk {
    bag: &Bag,
    at: Int
}

extension Walk: Iterator {
    type Item = Int
    func next(&var self) -> Int? {
        if self.at >= self.bag.n {
            return None
        }
        self.at = self.at + 1
        self.at
    }
}

func total(b: &Bag) -> Int {
    var sum = 0
    for x in Walk(bag: &b, at: 0) {
        sum = sum + x
    }
    sum
}
