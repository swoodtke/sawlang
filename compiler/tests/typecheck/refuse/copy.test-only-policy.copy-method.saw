// refuses: copy.test-only-policy at 11:10
// a test-only `copy()` on a production type, in a plain test-only extension:
// test code cannot change how a production type copies

struct Money {
    cents: Int
}

@test
extension Money {
    func copy(&self) -> Money {
        print("test-only copy")
        Money(cents: self.cents + 100)
    }
}

func main() {
    let a = Money(cents: 1)
    let b = a
    print("{}", b.cents)
}
