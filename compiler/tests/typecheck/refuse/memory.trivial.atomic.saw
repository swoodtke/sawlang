// an `UnsafeMemory` view of an `Atomic`, which declares NoCopy: a view copies
// the bytes it reads and writes, so its `T` is trivially copyable

func reach(address: Int) unsafe {
    let view: UnsafeMemory<Atomic<Int>, Normal> = UnsafeMemory(address)
    let _ = view
}

