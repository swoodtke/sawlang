// refuses: mutability.immutable at 8:17
// the builtin `take()` on a `[move o]` capture, in a closure bound to a `let`,
// which escapes: a by-value capture is a `let` in the closure's body (SL-472)

func probe() -> Int {
    var o: Int? = 3
    let f = { [move o] in
        let t = o.take()
        t ?? 0
    }
    f()
}
