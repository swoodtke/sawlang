// refuses: erasure.not-object-safe at 16:31
// erasure in a Result's error box, `Result<Int, Box<any Same>>`

trait Same {
    func same(&self, other: &Self) -> Bool
}

struct P { n: Int }

extension P: Same {
    func same(&self, other: &Self) -> Bool {
        self.n == other.n
    }
}

func run() -> Result<Int, Box<any Same>> {
    1
}

func main() {
    print(0)
}
