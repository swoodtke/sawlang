// refuses: transfer.move-from-borrow at 16:38
// the same through a `borrow var` binding: writing the place does not make
// it owned (SL-478)

struct Res { n: Int }
extension Res: NoCopy {}

enum Slot { case Empty, case Occupied(key: Res) }
extension Slot: NoCopy {}

func sink(r: Res) -> Int { r.n }

func take_key(slots: &var Vector<Slot>, i: Int) -> Int {
    borrow var lent = slots[i] {
        match lent {
            case Occupied(k) -> sink(move k),
            case Empty -> 0
        }
    }
}

func main() {
}
