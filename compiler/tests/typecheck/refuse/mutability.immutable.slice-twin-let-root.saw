// refuses: mutability.immutable at 24:5
// message: this assignment writes `r[0..2][0]`, and `r` is a `let` binding
// A write through a slice accessor takes its exclusive half, which writes
// the receiver: a `let` root has none, and the `@synthesize(shared)` twin
// lends only `&[Int]` (SL:borrowing §4, SL-988).

struct Ring {
    store: [Int; 6]
}

extension Ring {
    func base(&self) unsafe -> UnsafePointer<Int> {
        (&self.store) as UnsafePointer<Int>
    }

    @synthesize(shared)
    func [](&var self, range: Range) unsafe borrows -> &var [Int] {
        lend self.base()[range.current..range.end]
    }
}

func main() {
    let r = Ring(store: [1, 2, 3, 4, 5, 6])
    r[0..2][0] = 9
}
