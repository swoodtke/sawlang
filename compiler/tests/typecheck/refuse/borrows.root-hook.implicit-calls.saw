// refuses: borrows.root-hook at 26:10
// errors: 2
// the calls the compiler inserts into a `deinit` or a `format` (a scope drop, a moved parameter's drop, a Vector element's drop, a payload reassignment, an interpolation and a `print` format) name no source call, so each hook is refused at its declaration (SL-1156)
// message: is a `deinit`, which runs where a value is dropped

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

struct Tok {
    n: Int
}

extension Tok: NoCopy {
    func deinit(&var self) {
        install(self.n)
    }
}

func via_scope_drop() -> Int {
    let t = Tok(n: 3)
    t.n
}

func sink(t: Tok) -> Int {
    t.n
}

func via_moved_drop() -> Int {
    let t = Tok(n: 4)
    sink(move t)
}

func via_vector_drop() -> Int {
    var v: Vector<Tok> = Vector()
    let _ = v.push(Tok(n: 5))
    v.len()
}

func via_reassign() -> Int {
    var o: Tok? = Tok(n: 6)
    o = None
    0
}

struct Shown {
    n: Int
}

extension Shown: Printable {
    func format(&self, into: &var StringBuilder) {
        install(self.n)
        try! into.append(self.n)
    }
}

func via_interpolation(s: &Shown) -> String {
    "{s}"
}

func via_print_format(s: &Shown) {
    print("x = {}", s)
}

func main() {
    print(via_scope_drop() + via_moved_drop() + via_vector_drop() + via_reassign())
    print(via_interpolation(&Shown(n: 1)))
    via_print_format(&Shown(n: 2))
}
