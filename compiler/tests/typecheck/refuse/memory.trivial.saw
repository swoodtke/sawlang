// an `UnsafeMemory` view of a `String`, which owns its bytes: a view copies
// the bytes it reads and writes, so its `T` is trivially copyable

func reach(address: Int) unsafe {
    let view: UnsafeMemory<String, Normal> = UnsafeMemory(address)
    let _ = view
}

