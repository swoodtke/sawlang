// refuses: effect.closure-suspends at 38:24
// a closure that joins a task, passed to a parameter and called there inside
// the window of an exclusive static root (SL-1156)

import std.task.*

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func writer() -> Int {
    install(42)
    0
}

func settle() -> Int {
    Task.spawn(writer()).join()
}

func call(f: () -> Int) -> Int {
    f()
}

func main() {
    borrow var b = boot_slot() {
        b.tag = 7
        let r = call({ settle() })
        print("{} {}", b.tag, r)
    }
}
