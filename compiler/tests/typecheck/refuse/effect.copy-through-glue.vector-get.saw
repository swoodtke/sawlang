// refuses: effect.copy-through-glue at 19:13
// `Vector.get` reads its element by value in a generic body
// message: this calls `Vector.get` with `T` as `effect.copy-through-glue.vector-get.Heavy`

import std.task.*

struct Heavy {
    n: Int
}

extension Heavy: Copy {
    func copy(&self) -> Heavy {
        yield_now()
        Heavy(n: self.n + 1)
    }
}

func f(v: &Vector<Heavy>) -> Int {
    let b = v.get(0) ?? Heavy(n: 0)
    b.n
}

func main() {
    let v: Vector<Heavy> = [Heavy(n: 1)]
    print(f(&v))
}
