// refuses: borrows.root-value at 25:25
// errors: 1
// a function name kept as a value reaches no static root, as a closure does (SL-1156)

struct Boot {
    count: Int
    tag: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n)
}

func reset() {
    install(0)
}

func main() {
    let f: () -> Void = reset
    f()
}
