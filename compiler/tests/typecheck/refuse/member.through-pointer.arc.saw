// refuses: member.through-pointer at 16:13
// flags: --std-root std
// a `&self` payload method called on its `Arc`; the payload is reached as `borrow a.value().sum()`

struct Point {
    x: Int,
    y: Int
}

extension Point {
    func sum(&self) -> Int { self.x + self.y }
}

func main() {
    let a = try! Arc<Point>(value: Point(x: 1, y: 2))
    print(a.sum())
}
