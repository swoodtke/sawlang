// refuses: spawn.freestanding at 12:5
// flags: --std-root std --freestanding
// `Task.spawn` under the freestanding profile with a runtime that does not
// declare the background entries: nothing would drive or close the group

func work(n: Int) -> Int {
    n * 2
}

@export("entry")
func entry(n: Int) blocking -> Int {
    Task.spawn(work(n)).join()
}
