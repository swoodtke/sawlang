// refuses: mutability.immutable at 9:14
// calling `push`, a `&var self` method, on a `[copy v]` capture, in a closure
// bound to a `let`, which escapes: a by-value capture is a `let` in the
// closure's body (SL-472)

func probe() -> Int {
    var v: Vector<Int> = [1]
    let f = { [copy v] in
        try! v.push(2)
        v.len()
    }
    f()
}
