// refuses: mutability.immutable at 17:19
// `&var` of a `[copy n]` capture, in a closure passed straight to a non-
// escaping parameter: a by-value capture is a `let` in the closure's body
// (SL-472)

func bump(r: &var Int) {
    r = r + 1
}

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var n = 0
    run({ [copy n] in
        bump(&var n)
        n
    })
}
