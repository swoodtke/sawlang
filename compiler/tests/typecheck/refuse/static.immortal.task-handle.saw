// refuses: static.immortal at 8:19
// a group handle's type writes its own `deinit`, so no static can hold one,
// and a handle can never be stored into one (K164's static cell).
func work(n: Int) -> Int {
    n
}

unsafe static var KEPT: Task<Int>? = None

func stash() unsafe {
    var g = TaskGroup()
    KEPT = g.spawn(work(6))
}

func main() {
    stash()
}
