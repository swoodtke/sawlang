// refuses: erasure.not-object-safe at 16:19
// a trait whose requirement names `Self` in a parameter, erased by a coercion to `&var any`

trait Same {
    func same(&self, other: &Self) -> Bool
}

struct P { n: Int }

extension P: Same {
    func same(&self, other: &Self) -> Bool {
        self.n == other.n
    }
}

func take(s: &var any Same) -> Int {
    1
}

func main() {
    var p = P(n: 1)
    print(take(&var p))
}
