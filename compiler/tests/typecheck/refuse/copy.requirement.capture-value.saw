// refuses: copy.requirement at 23:13
// a `[x]` capture of an unbounded type parameter copies at creation, the
// inferred Copy requirement, refused at a NoCopy call (SL-481, D30)
struct Res {
    name: String
}

extension Res: NoCopy {}

func run(f: () -> Int) -> Int {
    f()
}

func measure<T>(x: &T) -> Int {
    1
}

func listed<T>(x: T) -> Int {
    run({ [x] in measure(&x) })
}

func main() {
    let _ = listed(Res(name: "a"))
}
