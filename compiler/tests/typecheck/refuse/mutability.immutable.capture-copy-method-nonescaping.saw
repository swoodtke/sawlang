// refuses: mutability.immutable at 13:14
// calling `push`, a `&var self` method, on a `[copy v]` capture, in a closure
// passed straight to a non-escaping parameter: a by-value capture is a `let`
// in the closure's body (SL-472)

func run(f: () -> Int) -> Int {
    f()
}

func probe() -> Int {
    var v: Vector<Int> = [1]
    run({ [copy v] in
        try! v.push(2)
        v.len()
    })
}
