// refuses: borrows.optional-place-write at 10:9
// a `borrow var` binding of a conditional lend names its optional place,
// which is no more an Optional in storage than the lend call is: assigning
// it whole is refused, naming the payload's binding (SL:borrowing §2.4,
// §12.7 P3; SL-899)
// message: `e` lends a place only when one is present, so no Optional is stored there to write. Write the element through its binding: `if var x = e { x = … }`

func clear(v: &var Vector<Int>) {
    borrow var e = v.find(0) {
        e = None
    }
}

func main() {
}
