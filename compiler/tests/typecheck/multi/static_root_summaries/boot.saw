// The root's module: `BOOT` is private, so no importer can name it, and the
// functions the importer calls open a window on it (SL-1156).

public struct Boot {
    count: Int
}

unsafe static var BOOT: Boot

func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

public func count() unsafe borrows(BOOT.count) -> &Int {
    lend BOOT.count
}

public func install(n: Int) sync {
    boot_slot() = Boot(count: n)
}

public func run(body: () sync -> Int) sync -> Int {
    body()
}
