// `Task.spawn` typed under Stage 0's root: `Task<Int>` for an `Int` root,
// `Task<Void>` for a `Void` one. The root is the task's call, so a spawner
// that never suspends itself stays sync-callable, and a reference a call
// nested in the root's arguments makes ends at the spawn.
import std.task.*

func work(n: Int) -> Int {
    yield_now()
    n
}

func ping() {
    yield_now()
}

func peek(v: &Vector<Int>) -> Int {
    v.len()
}

func start() sync {
    let t = Task.spawn(work(1))
    t.detach()
    let v = Task.spawn(ping())
    v.detach()
}

func main() {
    start()
    let buffer: Vector<Int> = []
    let t = Task.spawn(work(peek(&buffer)))
    print("{}", t.join())
}
