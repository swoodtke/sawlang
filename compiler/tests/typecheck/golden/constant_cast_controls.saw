// What the constant-cast rule accepts or leaves to run time (spec, Integer
// Conversions, "Constants"; SL-757): a raw-backed case to its own backing,
// to a wider type, and below its backing where its value fits; a literal, a
// sum and a limit that fit; a static that fits; and the operands the fold
// does not read, so each keeps its run-time check: a `let` local, an enum
// value computed at run time, and a const parameter, constant only per
// instantiation.

enum Wide: UInt16 {
    case Small = 7,
    case Big = 300
}

static SMALL: Int = 7

func pick(n: Int) -> Wide {
    if n > 0 { Wide.Big } else { Wide.Small }
}

func narrow<const N: Int>() -> UInt8 {
    N as UInt8
}

func main() {
    let own = Wide.Big as UInt16
    let wider = Wide.Big as Int
    let fits = Wide.Small as UInt8
    let edge = 255 as UInt8
    let sum = (200 + 55) as UInt8
    let low = Int8.min as Int16
    let named = SMALL as UInt8
    let big = 1000
    let late = big as UInt8
    let computed = pick(1) as UInt8
    print("{own} {wider} {fits} {edge} {sum} {low} {named} {late} {computed} {narrow<7>()}")
}
