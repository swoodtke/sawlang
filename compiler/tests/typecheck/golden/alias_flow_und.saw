// The alias position matrix at its "und" column (SL-1012 U3a): an `Int` value into an alias slot,
// at each position `sawc` checks a transfer, recorded at the distinct-alias
// verdict (LANGUAGE_SPEC.md, Type Definitions): the reverse flow needs the
// alias's construction, so every position is an ERROR.

type UserId = Int
type OrderId = Int
type Small = UInt8

static N: Int = 3
static SO: OrderId = OrderId(1)
static SU: UserId = UserId(1)

func cell_let(n: Int) {
    let x: UserId = n
    print(x as Int)
}

func cell_var(n: Int) {
    var x: UserId = n
    x = x
    print(x as Int)
}

static CELL: UserId = N
func cell_static() { print(CELL as Int) }

func cell_assign(n: Int, seed: UserId) {
    var x = seed
    x = n
    print(x as Int)
}

func take_arg(x: UserId) { print(x as Int) }
func cell_arg(n: Int) {
    take_arg(n)
}

struct Holder { x: UserId }
func cell_field(n: Int) {
    let s = Holder(x: n)
    print(s.x as Int)
}

func cell_return(n: Int) -> UserId {
    return n
}

func cell_tail(n: Int) -> UserId {
    n
}

func cell_branch(n: Int, c: Bool) {
    let x: UserId = if c { n } else { n }
    print(x as Int)
}

func cell_arm(n: Int, k: Int) {
    let x: UserId = match k { case 0 -> n, case _ -> n }
    print(x as Int)
}

func cell_payload(n: Int) {
    let x: UserId? = n
    print(x! as Int)
}

func cell_element(n: Int) {
    let x: [UserId; 1] = [n]
    print(x[0] as Int)
}

func cell_vector(n: Int) {
    let x: Vector<UserId> = [n]
    print(x.len())
}

func cell_tuple(n: Int) {
    let x: (UserId, Int) = (n, 1)
    print(x.0 as Int)
}

func cell_closure(n: Int) {
    let f: () -> UserId = { n }
    print(f() as Int)
}

func cell_coalesce(n: Int, opt: UserId?) {
    let x: UserId = opt ?? n
    print(x as Int)
}

func cell_compound(n: Int, seed: UserId) {
    var x = seed
    x += n
    print(x as Int)
}

func main() {}
