// the float literals that are representable: the largest finite value, the
// value just below the halfway point above it, the least subnormal, and zeros

func main() {
    let largest: Float = .0
    let below: Float = .0
    let least: Float = 0.
    let zero: Float = 0.0
    let negzero: Float = -0.0
    let zeros: Float = 0.000
    let negleast: Float = -0.
    print(largest)
    print(below)
    print(least)
    print(zero)
    print(negzero)
    print(zeros)
    print(negleast)
}
