// Constant folding: a literal inside a constant expression is judged by the
// folded value (design 87), a static and a raw-backed case are leaves, and a
// combination of flags is its backing integer (spec, Flag enums), as is a
// lone case in an integer slot. A signed suffix's minimum is written under a
// unary minus (SL:open-questions D6).

enum Perm: UInt8 {
    case Read = 0x01,
    case Write = 0x02,
    case Exec = 0x04
}

static SHIFT: Int = 3
static RW: UInt8 = Perm.Read | Perm.Write
static EXEC: UInt32 = Perm.Exec

static_assert((Perm.Read | Perm.Write) == 3, "read and write")

func main() {
    let top: UInt8 = 256 - 1
    let page: UInt16 = 1 << SHIFT
    let low = -128_i8
    let high = 127_i8
    let flags = Perm.Read | Perm.Exec
    print(top + RW)
    print(page)
    print(low + high)
    print(flags)
    print(EXEC)
}
