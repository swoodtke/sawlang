// The finite-size check, one declaration per cycle of the by-value
// containment graph (spec, Recursive types): `Grow` holds itself at an ever
// larger argument; `Fixed` holds one fixed instance of itself, which holds
// itself in turn; `A` and `B` hold each other, and `C`, which only `A` reaches,
// is on a second cycle through `B` and is refused too; `Chain` holds itself
// through a generic's inline field. `Outer` holds the infinite `Grow` but is on
// no cycle, and neither is `Finite`, 66 instances of `Wrap` deep (SL-627).

struct Grow<T> {
    x: Grow<(T,)>?
}

struct Fixed<T> {
    u: Fixed<Int>?
}

struct A {
    b: B
    c: C
}

struct B {
    a: A?
}

struct C {
    b: B
}

struct Wrap<T> {
    held: T
}

struct Chain {
    next: Wrap<Chain>
}

struct Outer {
    g: Grow<Int>
}

type F1 = Wrap<Int>
type F2 = Wrap<F1>
type F3 = Wrap<F2>
type F4 = Wrap<F3>
type F5 = Wrap<F4>
type F6 = Wrap<F5>
