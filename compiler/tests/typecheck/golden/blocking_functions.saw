// flags: --std-root std
// `blocking` functions and pairs (spec, Blocking functions): a lone one, its
// callers inferring the block, a pair whose calls name the default, a
// published one that declares it, and one that does not, whose refusal's
// fix-it writes the declaration (conformance rows K174, K177, K179).

import std.task.{yield_now}

func settle(ms: Int) blocking -> Int {
    ms
}

func settled_plus_one(ms: Int) -> Int {
    settle(ms) + 1
}

public func load_settled(ms: Int) blocking -> Int {
    settle(ms)
}

public func load_config(path: String) -> Int {
    settle(path.len())
}

struct Mailbox { id: Int }

extension Mailbox {
    /// Takes the next letter: a task cedes until it is there, and a thread
    /// blocks.
    public func take(&self) -> Int {
        yield_now()
        self.id
    }
    public func take(&self) blocking -> Int {
        settle(self.id)
    }
}

func collect(box: Mailbox) -> Int {
    box.take() + 1
}

func main() {
    print(settled_plus_one(1))
    print(load_settled(2))
}
