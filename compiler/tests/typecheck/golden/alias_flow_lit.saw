// The alias position matrix at its "lit" column (SL-1012 U3a): a bare literal into an alias of `Int`,
// at each position `sawc` checks a transfer, recorded at the distinct-alias
// verdict (LANGUAGE_SPEC.md, Type Definitions): an annotated `let` or `var`
// and a module `static` adopt the literal, every other position is an ERROR.

type UserId = Int
type OrderId = Int
type Small = UInt8

static N: Int = 3
static SO: OrderId = OrderId(1)
static SU: UserId = UserId(1)

func cell_let(n: Int) {
    let x: UserId = 7
    print(x as Int)
}

func cell_var(n: Int) {
    var x: UserId = 7
    x = x
    print(x as Int)
}

static CELL: UserId = 7
func cell_static() { print(CELL as Int) }

func cell_assign(n: Int, seed: UserId) {
    var x = seed
    x = 7
    print(x as Int)
}

func take_arg(x: UserId) { print(x as Int) }
func cell_arg(n: Int) {
    take_arg(7)
}

struct Holder { x: UserId }
func cell_field(n: Int) {
    let s = Holder(x: 7)
    print(s.x as Int)
}

func take_default(x: UserId = 7) { print(x as Int) }
func cell_default() { take_default() }

func cell_return(n: Int) -> UserId {
    return 7
}

func cell_tail(n: Int) -> UserId {
    7
}

func cell_branch(n: Int, c: Bool) {
    let x: UserId = if c { 7 } else { 7 }
    print(x as Int)
}

func cell_arm(n: Int, k: Int) {
    let x: UserId = match k { case 0 -> 7, case _ -> 7 }
    print(x as Int)
}

func cell_payload(n: Int) {
    let x: UserId? = 7
    print(x! as Int)
}

func cell_element(n: Int) {
    let x: [UserId; 1] = [7]
    print(x[0] as Int)
}

func cell_vector(n: Int) {
    let x: Vector<UserId> = [7]
    print(x.len())
}

func cell_tuple(n: Int) {
    let x: (UserId, Int) = (7, 1)
    print(x.0 as Int)
}

func cell_closure(n: Int) {
    let f: () -> UserId = { 7 }
    print(f() as Int)
}

func cell_coalesce(n: Int, opt: UserId?) {
    let x: UserId = opt ?? 7
    print(x as Int)
}

func cell_compound(n: Int, seed: UserId) {
    var x = seed
    x += 7
    print(x as Int)
}

func main() {}
