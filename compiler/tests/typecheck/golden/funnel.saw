// The expected-type funnel's entry points, one position each, every slot a
// `UInt8` so each literal shows the adoption (design 87): an annotated
// binding, a static, each assignment-target kind, a parameter, a field, an
// init argument, a default value, `return`, a body's tail, the branches that
// merge into one, an enum payload, a compound assignment's right side, each
// collection literal's element, key and value, a closure's tail, a mixed
// operator's other operand, and `??`'s fallback.

static LIMIT: UInt8 = 200

struct Pixel {
    level: UInt8
}

extension Pixel {
    init(half: UInt8) {
        Pixel(level: half)
    }
}

enum Reading {
    case Level(value: UInt8),
    case Missing
}

func take(b: UInt8) -> UInt8 {
    b
}

func padded(b: UInt8 = 7) -> UInt8 {
    b
}

func early(c: Bool) -> UInt8 {
    if c {
        return 1
    }
    2
}

func branches(c: Bool) -> UInt8 {
    let v: UInt8 = if c { 3 } else { 4 }
    match c {
        case true -> 5,
        case false -> v
    }
}

func positions(p: &var Pixel, slot: UInt8?) {
    let a: UInt8 = 10
    var b = a
    b = 11
    p.level = 12
    var pair: (UInt8, UInt8) = (13, 14)
    pair.0 = 15
    var buffer: [UInt8; 2] = [16, 17]
    buffer[0] = 18
    let _ = take(19)
    let _ = Pixel(level: 20)
    let _ = Pixel(half: 21)
    let _ = Reading.Level(value: 22)
    b += 23
    let list: Vector<UInt8> = [24, 25]
    let table: Map<UInt8, UInt8> = {26: 27}
    let chosen: Set<UInt8> = {28, 29}
    let f: (UInt8) -> UInt8 = { x: UInt8 in 29 }
    let sum = b + 30
    let fallback = slot ?? 31
}
