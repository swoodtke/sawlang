// flags: --std-root std
// Under the std that declares `String`'s Copy, the policy a struct owes is
// still owed for its other members: a NoCopy field beside a `String` one is
// named, not the `String`, and a field of a declared Copy type, std's `Data`
// or a user's, is the containment error.

import std.data.{Data}

struct Handle {
    fd: Int
}

extension Handle: NoCopy {}

struct Mixed {
    name: String,
    handle: Handle
}

struct Packet {
    body: Data
}

struct Tag {
    id: Int
}

extension Tag: Copy {
    func copy(&self) -> Tag {
        Tag(id: self.id)
    }
}

struct Badge {
    label: String,
    tag: Tag
}
