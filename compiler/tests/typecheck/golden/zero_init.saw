// flags: --std-root std
// The bare statics the zero-init funnel accepts in one module (SL-660): every
// part a scalar, `Bool`, `Float`, a raw pointer, a payload-free enum (zero is
// its first case), a raw-backed enum with a case of value 0, a tuple, an
// array, an `Atomic<Int>`, an Optional (zero is `None`), a struct
// of those whose private fields this module sees, a struct declaring
// `ZeroInit`, and a generic struct whose argument is one of those.

enum Mode {
    case Idle,
    case Busy
}

enum Wire: UInt8 {
    case On = 1,
    case Off = 0
}

struct Ledger {
    private credits: Int
    private debits: Int
}

struct Gauge {
    private level: Int
}

extension Gauge: ZeroInit {}

struct Holder<T> {
    value: T
}

struct Mixed {
    flag: Bool
    ratio: Float
    base: UnsafePointer<Int>
    mode: Mode
    wire: Wire
    pair: (Int, Int)
    table: [Int; 4]
    note: Shape?
    ledger: Ledger
    gauge: Gauge
}

static COUNT: Int
static SCRATCH: [UInt8; 64]
static HITS: Atomic<Int>
static MODE: Mode
static WIRE: Wire
static LEDGER: Ledger
static GAUGE: Gauge
static HELD: Holder<Gauge>
static HELD_LEDGER: Holder<Ledger>
unsafe static var MIXED: Mixed

func main() unsafe {
    print(COUNT)
    print(MIXED.pair.0)
}

enum Shape {
    case Dot(x: Int)
}
