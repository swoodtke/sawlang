// A `Thread.spawn` body calling a std method the suspension table answers
// for: `Command.output` both parks cooperatively and offloads a `blocking`
// extern, so the body is refused, naming the source it strikes on
// (conformance row K112). The form itself checks: the std declares `Thread`
// and `SystemError`.

import std.process.{Command}

func main() {
    var c = Command(program: "/bin/echo")
    try! c.arg("hi")
    var d = try! Thread.spawn { [move c] in
        let _ = c.output()
        3
    }
    print(d.join())
}
