// A `Thread.spawn` body calling a std method that parks cooperatively:
// `Command.output` drains its child's pipe and waits for its exit on the
// reactor, so the body is refused, naming the chain down to the first park
// it reaches inside std. The form itself checks: the std declares `Thread`
// and `SystemError`.

import std.process.{Command}

func main() {
    var c = Command(program: "/bin/echo")
    try! c.arg("hi")
    var d = try! Thread.spawn { [move c] in
        let _ = c.output()
        3
    }
    print(d.join())
}
