// `group.spawn` typed under Stage 0's root: the group is borrowed shared for
// the spawn, through a local, a field or a `&TaskGroup` parameter, and the
// form hands back `Task<Int>` for an `Int` root and `Task<Void>` for a
// `Void` one. The root is the task's call, so a spawner that never suspends itself
// stays sync-callable.
import std.task.*

func work(n: Int) -> Int {
    yield_now()
    n
}

func ping() {
    yield_now()
}

struct Holder {
    group: TaskGroup
}

extension Holder: NoCopy {}
extension Holder: NoMove {}

func into(group: &TaskGroup) sync -> Int {
    let t = group.spawn(work(2))
    t.join()
}

func main() {
    var group = TaskGroup()
    let t = group.spawn(work(1))
    let v = group.spawn(ping())
    var holder = Holder(group: TaskGroup())
    let f = holder.group.spawn(work(3))
    print("{} {} {}", t.join(), f.join(), into(&group))
    v.join()
}
