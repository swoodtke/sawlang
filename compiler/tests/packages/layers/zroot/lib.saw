//! A static root in a package that sorts after `gpk`: the generic code is summarized before
//! this layer's keys exist (SL-1156).

public struct Label {
    s: String
}

extension Label: NoCopy {
    func deinit(&var self) {
    }
}

public struct Boot {
    count: Int
    tag: Int
    name: Label?
}

extension Boot: NoCopy {}

unsafe static var BOOT: Boot

public func boot_slot() unsafe sync borrows(sync, BOOT) -> &var Boot {
    lend BOOT
}

public func install(n: Int) sync {
    boot_slot() = Boot(count: n, tag: n, name: None)
}

public func seed() {
    var text = StringBuilder()
    try! text.append("a label long enough to live on the heap")
    boot_slot() = Boot(count: 1, tag: 0, name: Label(s: text.build()))
}
