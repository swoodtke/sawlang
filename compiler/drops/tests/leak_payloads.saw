// The limit of the drops verifier's leak check (SL-471): at a `return` it
// follows a partly moved value's fields and tuple elements, never its enum
// payloads, so it cannot see an owning payload left behind. The fixture
// `compiler/tests/drops/inject/payloads.saw` is elaborated, found clean, then
// edited: the drop of the payload `first_name` leaves is unlinked, and the
// verifier still reports nothing. A change that closes the gap fails this
// program; it then becomes a rejection pin, and compiler/tests/drops/README.md
// drops the limit. Paths are the repository root's, where the runner runs.
import sawborrowck.src.check.{borrowck_rules}
import sawborrowck.src.program.{borrowck_program}
import sawdrops.src.elaborate.{drops_rules}
import sawdrops.src.program.{DropsProgram, drops_program}
import sawdrops.src.verify.{drops_verify_module}
import sawmir.src.api.{mir_lower_file}
import sawmir.src.model.{MirProjKind, MirStmtKind}

// The index of module `name`, or -1.
func module_index(p: &DropsProgram, name: String) -> Int {
    var m = 0
    while m < p.bc.mir.tc.res.module_count() {
        if p.bc.mir.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether statement `s` drops an enum payload.
func drops_payload(p: &DropsProgram, s: Int) -> Bool {
    let stmt = p.bc.mir.stmts[s]
    if stmt.kind != MirStmtKind.Drop || stmt.place < 0 {
        return false
    }
    let place = p.bc.mir.places[stmt.place]
    if place.count == 0 {
        return false
    }
    p.bc.mir.projs[place.first + place.count - 1].kind == MirProjKind.Payload
}

// Unlinks the first statement of module `m`'s functions that drops an enum
// payload; whether one was found.
func unlink_payload_drop(p: &var DropsProgram, m: Int) -> Bool {
    var f = 0
    while f < p.bc.mir.funcs.len() {
        let info = p.bc.mir.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let at = info.block_first + b
            b = b + 1
            var block = p.bc.mir.blocks[at]
            var prev = -1
            var s = block.first
            while s >= 0 {
                let next = p.bc.mir.stmts[s].next
                if drops_payload(&p, s) {
                    if prev < 0 {
                        block.first = next
                    } else {
                        var before = p.bc.mir.stmts[prev]
                        before.next = next
                        p.bc.mir.stmts[prev] = before
                    }
                    if block.last == s {
                        block.last = prev
                    }
                    p.bc.mir.blocks[at] = block
                    return true
                }
                prev = s
                s = next
            }
        }
    }
    false
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    let lowered = mir_lower_file("compiler/tests/drops/inject/payloads.saw", "sawc", &names, &dirs)
    var bc = borrowck_program(move lowered)
    var m = 0
    while m < bc.mir.tc.res.module_count() {
        let info = bc.mir.tc.res.module(m)
        if info.available && not info.interface_only {
            bc.check_module(m)
        }
        m = m + 1
    }
    assert(bc.diags.len() == 0 && bc.mir.diags.len() == 0, "the fixture is refused")
    var p = drops_program(move bc)
    let entry = module_index(&p, "payloads")
    assert(entry >= 0, "the fixture did not load: run from the repository root")
    p.elaborate_module(entry)
    assert(p.problems.len() == 0, "elaborating the fixture meets a problem")
    let before = drops_verify_module(&var p, entry)
    assert(before.len() == 0, "the fixture's elaborated MIR is not clean before the edit")

    assert(unlink_payload_drop(&var p, entry), "the fixture drops no enum payload")
    let after = drops_verify_module(&var p, entry)
    assert(after.len() == 0, "the leak check now sees a payload left behind: make this a rejection pin")
}
