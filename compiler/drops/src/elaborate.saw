// Drop elaboration (SL:architecture §3.7): every `drop(p)` of borrow-checked
// MIR becomes a concrete operation on a concrete path, by the label the
// borrow check gave it from the shared initialisation analysis:
//   - static: an unconditional drop;
//   - elided: nothing;
//   - flagged: a drop under a drop flag, a `Bool` local that mirrors whether
//     the path is whole. It is set from the entry's conditions in bb0, then
//     after each statement (before each terminator) whose accesses change
//     that, and the drop sits in a block of its own that a switch on the
//     flag enters.
// Flags exist only for the paths a flagged drop names, and for an
// accessor's record locals that carry one across its split, whose flag the
// prologue writes into the record and the epilogue reads back. A path a take
// capture takes uses the take flag MIR made for it, which the closure body
// clears when it takes the value. A drop never
// moves: placement is the MIR's, which drops in reverse declaration order at
// scope exits and in reverse creation order at a statement's end, and
// decomposes a value whose parts left into drops of the parts. A panic does
// not unwind, so no cleanup path is generated.

import sawborrowck.program.{BORROWCK_LABEL_ELIDED, BORROWCK_LABEL_FLAGGED, BORROWCK_LABEL_STATIC,
                                BorrowckProgram}
import sawdrops.program.{DROPS_KEEP, DROPS_PLAIN, DROPS_SET, DropsProgram, drops_flag_effect}
import sawmir.build.{mir_func_local}
import sawmir.dump.{mir_module_functions}
import sawmir.initialisation.{MIR_INIT_PARTIAL, MIR_INIT_WHOLE, MirAccess, MirAccessKind, MirInit,
                                  mir_init_apply_all}
import sawmir.model.{MirBlock, MirCall, MirCallKind, MirConstKind, MirDiag, MirFuncKind, MirLocal, MirLocalKind,
                         MirOperandKind, MirProjKind, MirRvalueKind, MirStmt, MirStmtKind, MirSwitchKind, MirTermKind,
                         mir_owes_fate}
import sawmir.program.{MirProgram}
import sawmir.split.{MirHalf}
import sawresolve.dump.{res_sort_strings}
import sawresolve.program.{ResProgram}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.model.{TC_EFFECT_CONSUMES, TcReceiver}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.summaries.{TcAcc}
import sawtypecheck.typeops.{TcClient}

// Every rule drop elaboration refuses by.
public func drops_rules() -> Vector<String> {
    var out = Vector<String>()
    try! out.push("drop.must-consume")
    move out
}

// How a handle that owes a fate leaves the locals the check follows it
// through, other than by a written fate or into storage a declared `deinit`
// owns.
enum DropsEscape {
    // An implicit drop: a scope's end, a statement's end, an overwrite.
    case Dropped,
    // A move into the return place.
    case Returned,
    // A move into a field, an element or a referent, of storage whose owner
    // declares no `deinit`.
    case Stored,
    // A move into a call's argument.
    case Argument,
    // A take capture of a non-escaping closure.
    case Captured
}

extension DropsProgram {
    // Every function module `m`'s bodies lowered to, elaborated.
    public func elaborate_module(&var self, m: Int) {
        let order = mir_module_functions(&self.bc.mir, m)
        var k = 0
        while k < order.len() {
            self.elaborate_func(order[k])
            k = k + 1
        }
    }

    func elaborate_func(&var self, f: Int) {
        let facts = self.bc.mir.init_analysis(f)
        self.check_fates(f, &facts)
        self.collect_flags(f, &facts)
        let relocated = self.flag_count[f] > 0
        if relocated {
            self.relocate(f)
        }
        let info = self.bc.mir.funcs[f]
        self.bc.mir.cur = f
        self.bc.mir.local_base = info.local_first
        self.bc.mir.block_base = info.block_first
        var b = 0
        while b < info.block_count {
            self.rebuild_block(f, b, &facts)
            b = b + 1
        }
        if relocated {
            var done = self.bc.mir.funcs[f]
            done.block_count = self.bc.mir.blocks.len() - done.block_first
            self.bc.mir.funcs[f] = done
        }
        self.bc.mir.current = -1
        self.elaborated[f] = true
    }

    // Function `f`'s flags: one per path a flagged drop names, and one per
    // record local a prologue transfers, each numbered after its locals. A
    // path a take capture takes has its take flag instead, adopted first, so
    // the closure body and the guarded drop read one flag.
    func collect_flags(&var self, f: Int, facts: &MirInit) {
        let info = self.bc.mir.funcs[f]
        // Stage 0 workaround (SL:hazards S4): canonical: self.flag_first[f] = self.flag_local.len()
        let first = self.flag_local.len()
        self.flag_first[f] = first
        var paths = Vector<Int>()
        self.adopt_take_flags(f, &facts, &var paths)
        var b = 0
        while b < info.block_count {
            if facts.reached[b] {
                var state = facts.entry_state(b)
                let block = self.bc.mir.blocks[info.block_first + b]
                var s = block.first
                while s >= 0 {
                    let stmt = self.bc.mir.stmts[s]
                    let accesses = self.bc.mir.init_stmt_accesses(f, s, &facts)
                    var k = 0
                    while k < accesses.len() {
                        let a = accesses[k]
                        k = k + 1
                        if a.path < 0 || a.cut {
                            continue
                        }
                        let flagged_drop = a.kind == MirAccessKind.Drop && self.bc.labels[s] == BORROWCK_LABEL_FLAGGED
                        if flagged_drop && (state[a.path] & MIR_INIT_PARTIAL) != 0 {
                            try! self.partial_drops.push(s)
                            self.problem(f, s, "is a flagged drop of a place a part of which may have moved out, which no flag can decide")
                        } else if flagged_drop || a.kind == MirAccessKind.Transfer {
                            let fresh = info.local_count + self.created_flags(f, paths.len())
                            self.add_flag(f, &facts, &var paths, a.path, a.place, fresh)
                        }
                    }
                    mir_init_apply_all(&facts, &var state, &accesses)
                    s = stmt.next
                }
            }
            b = b + 1
        }
        self.flag_count[f] = paths.len()
    }

    // Path `q`'s flag, held in local `local` and named by place `p`, unless
    // it has one. A `consumes` body's receiver is released field by field on
    // every path or on none (borrowck's `consumes.some-paths`), so a flag
    // there is a broken invariant.
    func add_flag(&var self, f: Int, facts: &MirInit, paths: &var Vector<Int>, q: Int, p: Int, local: Int) {
        var k = 0
        while k < paths.len() {
            if paths[k] == q {
                return
            }
            k = k + 1
        }
        if self.consumed_receiver(f) && facts.path_local[q] == 1 {
            self.problem(f, -1, "needs a drop flag for its consumed receiver or a field of it, which the every-path-or-none rule makes static")
        }
        try! self.flag_local.push(local)
        try! self.flag_place.push(p)
        try! paths.push(q)
    }

    // Each take flag of `f` adopted as the drop flag of the path its take
    // takes, before any other flag is made. Two takes of one path naming two
    // flags would split what the closure bodies clear from what the drop
    // reads, so that is a broken invariant.
    func adopt_take_flags(&var self, f: Int, facts: &MirInit, paths: &var Vector<Int>) {
        let info = self.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.bc.mir.blocks[info.block_first + b]
            var s = block.first
            while s >= 0 {
                let stmt = self.bc.mir.stmts[s]
                s = stmt.next
                if facts.reached[b] && stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                    let rv = self.bc.mir.rvalues[stmt.rvalue]
                    if rv.kind == MirRvalueKind.Take && rv.place >= 0 && rv.flag >= 0 {
                        let q = self.bc.mir.init_path_of(rv.place, &facts)
                        let flag = self.bc.mir.places[rv.flag].local
                        let held = self.flag_for_path_in(f, &facts, &paths, q)
                        if held >= 0 && held != flag {
                            self.problem(f, -1, "takes one local under two take flags")
                        }
                        self.add_flag(f, &facts, &var paths, q, rv.place, flag)
                    }
                }
            }
            b = b + 1
        }
    }

    // The local holding the flag collected so far for path `q` of `f`, or -1.
    func flag_for_path_in(&self, f: Int, facts: &MirInit, paths: &Vector<Int>, q: Int) -> Int {
        var k = 0
        while k < paths.len() {
            if paths[k] == q {
                return self.flag_local[self.flag_first[f] + k]
            }
            k = k + 1
        }
        return -1
    }

    // How many of `f`'s first `count` flags elaboration made, numbered after
    // its locals, rather than adopted.
    func created_flags(&self, f: Int, count: Int) -> Int {
        let locals = self.bc.mir.funcs[f].local_count
        var n = 0
        var k = 0
        while k < count {
            if self.flag_local[self.flag_first[f] + k] >= locals {
                n = n + 1
            }
            k = k + 1
        }
        n
    }

    // Whether `f` is a `consumes` body, whose local `_1` is its receiver.
    public func consumed_receiver(&self, f: Int) -> Bool {
        let info = self.bc.mir.funcs[f]
        if info.kind != MirFuncKind.Body || info.decl < 0 || info.param_count < 1 {
            return false
        }
        if (self.bc.mir.tc.sigs[info.decl].effects & TC_EFFECT_CONSUMES) == 0 {
            return false
        }
        mir_func_local(&self.bc.mir, f, 1).kind == MirLocalKind.Receiver
    }

    // Moves function `f`'s locals and blocks to the end of their arenas,
    // the locals followed by the flags elaboration made, so the blocks a
    // guard needs can join its run. Local and block numbers are unchanged.
    func relocate(&var self, f: Int) {
        var info = self.bc.mir.funcs[f]
        let count = self.flag_count[f]
        let created = self.created_flags(f, count)
        let local_first = self.bc.mir.locals.len()
        var k = 0
        while k < info.local_count {
            let l = self.bc.mir.locals[info.local_first + k]
            try! self.bc.mir.locals.push(l)
            k = k + 1
        }
        let flag = self.bc.mir.tc.bool_type()
        k = 0
        while k < created {
            try! self.bc.mir.locals.push(MirLocal(ty: flag, kind: MirLocalKind.Temp, name: -1, node: -1, owned: false,
                                                  reference: false))
            k = k + 1
        }
        let block_first = self.bc.mir.blocks.len()
        k = 0
        while k < info.block_count {
            let block = self.bc.mir.blocks[info.block_first + k]
            try! self.bc.mir.blocks.push(block)
            k = k + 1
        }
        info.local_count = info.local_count + created
        info.local_first = local_first
        info.block_first = block_first
        self.bc.mir.funcs[f] = info
    }

    // Block `b` of `f` rebuilt: its statements elaborated, a flag's update
    // after the statement that changes its path, a guarded drop splitting
    // the block, then its terminator, after the updates its accesses owe. A
    // block no path reaches keeps everything but its drops.
    func rebuild_block(&var self, f: Int, b: Int, facts: &MirInit) {
        let at = self.bc.mir.block_base + b
        let old = self.bc.mir.blocks[at]
        let reached = facts.reached[b]
        var term = Vector<MirAccess>()
        if reached {
            term = self.bc.mir.init_term_accesses(f, b, &facts)
        }
        var order = Vector<Int>()
        var s = old.first
        while s >= 0 {
            try! order.push(s)
            s = self.bc.mir.stmts[s].next
        }
        var fresh = old
        fresh.first = -1
        fresh.last = -1
        self.bc.mir.blocks[at] = fresh
        self.bc.mir.enter(b)
        if b == 0 {
            self.init_flags(f, &facts)
        }
        var k = 0
        while k < order.len() {
            let one = order[k]
            k = k + 1
            if reached {
                self.rebuild_stmt(f, one, &facts)
            } else {
                self.copy_unreached(one)
            }
        }
        let saved = self.bc.mir.source_as(old.term_node, old.term_closing)
        self.emit_updates(f, &facts, &term, -1)
        self.install_terminator(&old)
        self.bc.mir.source_restore(saved)
    }

    // Each flag of `f` set from the entry's conditions: a parameter's path is
    // whole there, every other path not.
    func init_flags(&var self, f: Int, facts: &MirInit) {
        let root = self.bc.mir.funcs[f].root
        let saved = self.bc.mir.source_at(root)
        var j = 0
        while j < self.flag_count[f] {
            let at = self.flag_first[f] + j
            let p = self.flag_place[at]
            let q = self.bc.mir.init_path_of(p, &facts)
            let whole = q >= 0 && facts.entry[q] == MIR_INIT_WHOLE
            let flag = self.flag_local[at]
            self.assign_flag(flag, whole)
            j = j + 1
        }
        self.bc.mir.source_restore(saved)
    }

    func copy_unreached(&var self, s: Int) {
        let stmt = self.bc.mir.stmts[s]
        if stmt.kind == MirStmtKind.Drop {
            return
        }
        let saved = self.bc.mir.source_as(stmt.node, stmt.closing)
        self.copy_stmt(&stmt)
        self.bc.mir.source_restore(saved)
    }

    func copy_stmt(&var self, stmt: &MirStmt) {
        if stmt.kind == MirStmtKind.Assign {
            self.bc.mir.assign(stmt.place, stmt.rvalue)
        } else if stmt.kind == MirStmtKind.Budget {
            self.bc.mir.emit_budget(stmt.yields)
        }
    }

    func rebuild_stmt(&var self, f: Int, s: Int, facts: &MirInit) {
        let stmt = self.bc.mir.stmts[s]
        let saved = self.bc.mir.source_as(stmt.node, stmt.closing)
        let accesses = self.bc.mir.init_stmt_accesses(f, s, &facts)
        if stmt.kind == MirStmtKind.Drop {
            let label = self.bc.labels[s]
            if label == BORROWCK_LABEL_STATIC {
                self.emit_drop(f, s, stmt.place, DROPS_PLAIN)
                self.emit_updates(f, &facts, &accesses, -1)
            } else if label == BORROWCK_LABEL_FLAGGED {
                self.emit_guarded_drop(f, s, &facts, &accesses)
            } else if label != BORROWCK_LABEL_ELIDED {
                self.problem(f, s, "is a drop a path reaches that carries no label")
            }
        } else {
            let into = self.bc.mir.record_transfer_field(f, s)
            if into >= 0 {
                self.write_record_flag(f, &facts, &accesses, into)
            }
            self.copy_stmt(&stmt)
            let from = self.bc.mir.record_resume_field(f, s)
            var resumed = -1
            if from >= 0 {
                resumed = self.read_record_flag(f, &facts, &accesses, from)
            }
            self.emit_updates(f, &facts, &accesses, resumed)
        }
        self.bc.mir.source_restore(saved)
    }

    // A flagged drop: `switch copy F -> [true: bbD, false: bbC]`, then in bbD
    // the drop and the flag cleared, `goto -> bbC`; the block goes on in bbC.
    func emit_guarded_drop(&var self, f: Int, s: Int, facts: &MirInit, accesses: &Vector<MirAccess>) {
        let p = self.bc.mir.stmts[s].place
        let q = self.dropped_path(&accesses)
        let j = self.flag_for_path(f, &facts, q)
        if j < 0 {
            if not self.partial_drop(s) {
                self.problem(f, s, "is a flagged drop whose path has no flag")
            }
            return
        }
        let flag = self.flag_local[j]
        let dropping = self.bc.mir.new_block()
        let after = self.bc.mir.new_block()
        let fp = self.bc.mir.place_local(flag)
        let read = self.bc.mir.op_copy(fp)
        self.bc.mir.switch_bool(read, dropping, after)
        self.bc.mir.enter(dropping)
        self.emit_drop(f, s, p, flag)
        self.emit_updates(f, &facts, &accesses, -1)
        self.bc.mir.goto(after)
        self.bc.mir.enter(after)
    }

    func partial_drop(&self, s: Int) -> Bool {
        var k = 0
        while k < self.partial_drops.len() {
            if self.partial_drops[k] == s {
                return true
            }
            k = k + 1
        }
        false
    }

    // The path a drop's accesses drop, or -1 for one through a reference.
    func dropped_path(&self, accesses: &Vector<MirAccess>) -> Int {
        var k = 0
        while k < accesses.len() {
            let a = accesses[k]
            if a.kind == MirAccessKind.Drop && not a.cut {
                return a.path
            }
            k = k + 1
        }
        return -1
    }

    // An output drop of place `p`, guarded by `by`.
    func emit_drop(&var self, f: Int, s: Int, p: Int, by: Int) {
        let at = self.bc.mir.stmts.len()
        self.bc.mir.emit_drop(p)
        self.set_guard(at, by)
    }

    // The flag updates `accesses` owe, each flag of `f` set or cleared once
    // by their net effect, in flag order; flag `skip` is a resume's, which
    // the record gives.
    func emit_updates(&var self, f: Int, facts: &MirInit, accesses: &Vector<MirAccess>, skip: Int) {
        var j = 0
        while j < self.flag_count[f] {
            let at = self.flag_first[f] + j
            j = j + 1
            if at == skip {
                continue
            }
            let p = self.flag_place[at]
            let q = self.bc.mir.init_path_of(p, &facts)
            var net = DROPS_KEEP
            var k = 0
            while k < accesses.len() {
                let a = accesses[k]
                let effect = drops_flag_effect(&facts, q, &a)
                if effect != DROPS_KEEP {
                    net = effect
                }
                k = k + 1
            }
            if net != DROPS_KEEP {
                let flag = self.flag_local[at]
                self.assign_flag(flag, net == DROPS_SET)
            }
        }
    }

    // `F = const true` or `false`.
    func assign_flag(&var self, flag: Int, value: Bool) {
        let t = self.bc.mir.tc.bool_type()
        let text = if value { "true" } else { "false" }
        let c = self.bc.mir.op_const(MirConstKind.Bool, text, t)
        let rv = self.bc.mir.rv_use(c)
        let fp = self.bc.mir.place_local(flag)
        self.bc.mir.assign(fp, rv)
    }

    // The prologue's record field `field`, `(*_1).field`, of type `Bool`.
    func record_flag_place(&var self, field: Int) -> Int {
        let record = self.bc.mir.local_type(1)
        let rt = self.bc.mir.tc.referent(record)
        let base = self.bc.mir.place_local(1)
        let whole = self.bc.mir.project(base, MirProjKind.Deref, -1, -1, rt)
        let t = self.bc.mir.tc.bool_type()
        self.bc.mir.project(whole, MirProjKind.Tuple, -1, field, t)
    }

    // Before a prologue's transfer of a flagged local into its record, the
    // local's flag into the record's field `field`.
    func write_record_flag(&var self, f: Int, facts: &MirInit, accesses: &Vector<MirAccess>, field: Int) {
        var q = -1
        var k = 0
        while k < accesses.len() {
            let a = accesses[k]
            if a.kind == MirAccessKind.Transfer && not a.cut {
                q = a.path
            }
            k = k + 1
        }
        let j = self.flag_for_path(f, &facts, q)
        if j < 0 {
            self.problem(f, -1, "transfers a record local that has no flag")
            return
        }
        let flag = self.flag_local[j]
        let slot = self.record_flag_place(field)
        let fp = self.bc.mir.place_local(flag)
        let read = self.bc.mir.op_copy(fp)
        let rv = self.bc.mir.rv_use(read)
        self.bc.mir.assign(slot, rv)
    }

    // After an epilogue's resume of a record local, its flag from the
    // record's field `field`; returns the flag, or -1 when the epilogue needs
    // none for the local.
    func read_record_flag(&var self, f: Int, facts: &MirInit, accesses: &Vector<MirAccess>, field: Int) -> Int {
        var q = -1
        var k = 0
        while k < accesses.len() {
            let a = accesses[k]
            if a.kind == MirAccessKind.Resume && not a.cut {
                q = a.path
            }
            k = k + 1
        }
        let j = self.flag_for_path(f, &facts, q)
        if j < 0 {
            return -1
        }
        let flag = self.flag_local[j]
        let slot = self.record_flag_place(field)
        let read = self.bc.mir.op_copy(slot)
        let rv = self.bc.mir.rv_use(read)
        let fp = self.bc.mir.place_local(flag)
        self.bc.mir.assign(fp, rv)
        j
    }

    // The original terminator of a rebuilt block, on the block the rebuild
    // ended in.
    func install_terminator(&var self, old: &MirBlock) {
        let cur = self.bc.mir.current
        if cur < 0 {
            return
        }
        let at = self.bc.mir.block_base + cur
        var info = self.bc.mir.blocks[at]
        info.term = old.term
        info.target = old.target
        info.switch_kind = old.switch_kind
        info.operand = old.operand
        info.place = old.place
        info.arm_first = old.arm_first
        info.arm_count = old.arm_count
        info.otherwise = old.otherwise
        info.call = old.call
        info.term_node = old.term_node
        info.term_closing = old.term_closing
        self.bc.mir.blocks[at] = info
        self.bc.mir.current = -1
    }

    // THE MUST-CONSUME CHECK (spec: No implicit fates): the handle a spawn
    // site mints when `mir_owes_fate` holds must reach `join()`, `detach()`
    // or `cancel()` on every path. It follows the handle's value, not a name:
    // forward over `f`'s blocks to a fixpoint, each local holds the site whose
    // handle it may hold on some path with no fate written, or -1. A fate
    // call on the local clears it, a whole move into another local carries
    // it, and a move into storage whose owner declares a `deinit` discharges
    // it, that `deinit` being the fate the handle's run-time panic backstops.
    // Every other way out is refused once, at the site (`DropsEscape`).
    // `Thread.spawn`'s site mints on the `Result` it hands back, whose `Ok`
    // payload is the handle: a move of that payload carries the obligation
    // (`try!`, an `Ok(h)` arm), a fate written through it clears it, and the
    // `Err` path owes nothing, so its payload's move and a switch's `Err`
    // edge clear it too. Dropping the `Result`, `let _ =` included, is an
    // escape like any other.
    func check_fates(&var self, f: Int, facts: &MirInit) {
        let info = self.bc.mir.funcs[f]
        if not self.mints_fates(f) {
            return
        }
        let n = info.local_count
        let refs = self.ref_places(f)
        var entry = Vector<Int>()
        var seen = Vector<Bool>()
        var queued = Vector<Bool>()
        var b = 0
        while b < info.block_count {
            try! seen.push(false)
            try! queued.push(false)
            var l = 0
            while l < n {
                try! entry.push(-1)
                l = l + 1
            }
            b = b + 1
        }
        var reported = Vector<Int>()
        var state = Vector<Int>()
        var l = 0
        while l < n {
            try! state.push(-1)
            l = l + 1
        }
        var work = Vector<Int>()
        seen[0] = true
        queued[0] = true
        try! work.push(0)
        var next = 0
        while next < work.len() {
            let at = work[next]
            next = next + 1
            queued[at] = false
            self.load_fates(&entry, at, n, &var state)
            self.fate_block(f, at, &var state, &refs, false, &var reported)
            let block = self.bc.mir.blocks[info.block_first + at]
            let succ = self.bc.mir.successors_of(&block)
            var k = 0
            while k < succ.len() {
                let s = succ[k]
                k = k + 1
                var changed = not seen[s]
                seen[s] = true
                let cleared = self.err_edge_local(&block, s)
                var j = 0
                while j < n {
                    if j != cleared && state[j] >= 0 && entry[s * n + j] < 0 {
                        entry[s * n + j] = state[j]
                        changed = true
                    }
                    j = j + 1
                }
                if changed && not queued[s] {
                    queued[s] = true
                    try! work.push(s)
                }
            }
        }
        b = 0
        while b < info.block_count {
            if seen[b] && facts.reached[b] {
                self.load_fates(&entry, b, n, &var state)
                self.fate_block(f, b, &var state, &refs, true, &var reported)
            }
            b = b + 1
        }
    }

    // Whether some call of `f` mints a handle that owes a fate.
    func mints_fates(&self, f: Int) -> Bool {
        let info = self.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.bc.mir.blocks[info.block_first + b]
            b = b + 1
            if block.term == MirTermKind.Call {
                let c = self.bc.mir.calls[block.call]
                if mir_owes_fate(&c) {
                    return true
                }
            }
        }
        false
    }

    // By local of `f`: the place a `ref` assigned to it whole borrows, or -1,
    // which is how a method's receiver operand names the local it borrows.
    func ref_places(&self, f: Int) -> Vector<Int> {
        let info = self.bc.mir.funcs[f]
        var out = Vector<Int>()
        var l = 0
        while l < info.local_count {
            try! out.push(-1)
            l = l + 1
        }
        var b = 0
        while b < info.block_count {
            let block = self.bc.mir.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = self.bc.mir.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = self.bc.mir.rvalues[stmt.rvalue]
                let dest = self.bc.mir.bare_local(stmt.place)
                if rv.kind == MirRvalueKind.Ref && dest >= 0 && rv.place >= 0 {
                    out[dest] = rv.place
                }
            }
        }
        move out
    }

    func load_fates(&self, entry: &Vector<Int>, b: Int, n: Int, state: &var Vector<Int>) {
        var j = 0
        while j < n {
            state[j] = entry[b * n + j]
            j = j + 1
        }
    }

    // Block `b`'s statements and terminator applied to `state`; with
    // `report`, each escape refused.
    func fate_block(&var self, f: Int, b: Int, state: &var Vector<Int>, refs: &Vector<Int>, report: Bool,
                    reported: &var Vector<Int>) {
        let info = self.bc.mir.funcs[f]
        let block = self.bc.mir.blocks[info.block_first + b]
        var s = block.first
        while s >= 0 {
            let stmt = self.bc.mir.stmts[s]
            if stmt.kind == MirStmtKind.Drop {
                let l = self.bc.mir.bare_local(stmt.place)
                if l >= 0 && state[l] >= 0 && self.bc.labels[s] != BORROWCK_LABEL_ELIDED && report {
                    self.refuse_fate(f, state[l], l, DropsEscape.Dropped, -1, &var reported)
                }
                if l >= 0 {
                    state[l] = -1
                }
            } else if stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                self.fate_assign(f, &stmt, &var state, report, &var reported)
            }
            s = stmt.next
        }
        if block.term == MirTermKind.Call {
            self.fate_call(f, block.call, &var state, &refs, report, &var reported)
        }
    }

    // An assignment. A value moved in, whole or as a part of what the
    // rvalue builds (a struct, a case, a tuple, a closure's environment),
    // goes with the destination: a local carries it, the return place and
    // storage whose owner declares no `deinit` are escapes, and other storage
    // discharges it. A local a take capture names escapes into the closure.
    // Whatever the destination held before is gone, since an owning
    // overwrite drops it first.
    func fate_assign(&var self, f: Int, stmt: &MirStmt, state: &var Vector<Int>, report: Bool,
                     reported: &var Vector<Int>) {
        let rv = self.bc.mir.rvalues[stmt.rvalue]
        let dest = self.bc.mir.bare_local(stmt.place)
        if rv.kind == MirRvalueKind.Take && rv.place >= 0 {
            let m = self.bc.mir.bare_local(rv.place)
            if m >= 0 && state[m] >= 0 {
                if report {
                    self.refuse_fate(f, state[m], m, DropsEscape.Captured, -1, &var reported)
                }
                state[m] = -1
            }
        }
        var site = -1
        var from = -1
        var k = 0
        while k < rv.count {
            let m = self.fate_source(rv.first + k, &var state)
            k = k + 1
            if m >= 0 && state[m] >= 0 {
                if site < 0 {
                    site = state[m]
                    from = m
                }
                state[m] = -1
            }
        }
        if dest >= 0 {
            state[dest] = -1
        }
        if site < 0 {
            return
        }
        if dest > 0 {
            state[dest] = site
        } else if dest == 0 {
            if report {
                self.refuse_fate(f, site, from, DropsEscape.Returned, -1, &var reported)
            }
        } else if not self.owner_declares_deinit(f, stmt.place) && report {
            self.refuse_fate(f, site, from, DropsEscape.Stored, -1, &var reported)
        }
    }

    // A call: a fate method on a local writes its fate; an argument moved
    // in discharges into storage a declared `deinit` owns, or escapes; the
    // destination holds what a site mints, or nothing that owes.
    func fate_call(&var self, f: Int, at: Int, state: &var Vector<Int>, refs: &Vector<Int>, report: Bool,
                   reported: &var Vector<Int>) {
        let c = self.bc.mir.calls[at]
        let receiver = self.receiver_place(&c, &refs)
        let fate = self.is_fate_method(&c)
        if receiver >= 0 && fate {
            let l = self.owing_local(receiver)
            if l >= 0 {
                state[l] = -1
            }
        }
        var k = 0
        while k < c.arg_count {
            let m = self.fate_source(c.arg_first + k, &var state)
            let first = k == 0
            k = k + 1
            if m < 0 || state[m] < 0 {
                continue
            }
            let site = state[m]
            state[m] = -1
            // A consuming fate method takes the handle itself as its receiver.
            if first && fate {
                continue
            }
            let stored = receiver >= 0 && self.owner_declares_deinit(f, receiver)
            if not stored && report {
                self.refuse_fate(f, site, m, DropsEscape.Argument, at, &var reported)
            }
        }
        if c.dest < 0 {
            return
        }
        let d = self.bc.mir.bare_local(c.dest)
        if not mir_owes_fate(&c) {
            if d >= 0 {
                state[d] = -1
            }
            return
        }
        if d > 0 {
            state[d] = at
        } else if report {
            let why = if d == 0 { DropsEscape.Returned } else { DropsEscape.Stored }
            self.refuse_fate(f, at, -1, why, -1, &var reported)
        }
    }

    // The local whose owed fate the operand at operand-list index `at`
    // carries off: one it moves out of whole, or one whose `Ok` payload it
    // moves (`Thread.spawn`'s handle). A move of an `Err` payload proves the
    // local holds no handle, so its obligation is cleared there; -1.
    func fate_source(&self, at: Int, state: &var Vector<Int>) -> Int {
        let o = self.bc.mir.lists[at]
        if o < 0 {
            return -1
        }
        let info = self.bc.mir.operands[o]
        if info.kind != MirOperandKind.Move || info.place < 0 {
            return -1
        }
        let l = self.owing_local(info.place)
        if l >= 0 {
            return l
        }
        let p = self.bc.mir.places[info.place]
        let case_name = self.payload_case(info.place)
        if p.local >= 0 && p.count == 1 && case_name.equals("Err") {
            state[p.local] = -1
        }
        return -1
    }

    // The local place `p` names whole, or whose `Ok` payload it is, which is
    // where `Thread.spawn`'s handle lives until it is bound; -1 otherwise.
    func owing_local(&self, p: Int) -> Int {
        let info = self.bc.mir.places[p]
        if info.count == 0 {
            return info.local
        }
        let case_name = self.payload_case(p)
        if info.local >= 0 && info.count == 1 && case_name.equals("Ok") {
            return info.local
        }
        return -1
    }

    // The case whose payload place `p`'s first step reads, `Ok` or `Err`, or
    // "" when that step reads no payload.
    func payload_case(&self, p: Int) -> String {
        let info = self.bc.mir.places[p]
        if info.count == 0 {
            return ""
        }
        let step = self.bc.mir.projs[info.first]
        if step.kind != MirProjKind.Payload && step.kind != MirProjKind.Force {
            return ""
        }
        self.result_case_name(step.decl)
    }

    // `Ok` or `Err` when case declaration `d` is `Result`'s, else "".
    func result_case_name(&self, d: Int) -> String {
        if d < 0 || self.bc.mir.tc.res.decls[d].parent != self.bc.mir.tc.known.result {
            return ""
        }
        // Stage 0 workaround (SL:hazards S4): canonical: self.bc.mir.tc.name_text(self.bc.mir.tc.res.decls[d].name)
        let name = self.bc.mir.tc.res.decls[d].name
        self.bc.mir.tc.name_text(name)
    }

    // The local of a `switch discriminant` terminator `block` whose `Err` arm
    // targets `s` and no other arm does: on that edge the `Result` holds no
    // handle, so its owed fate is not carried; -1.
    func err_edge_local(&self, block: &MirBlock, s: Int) -> Int {
        if block.term != MirTermKind.Switch || block.switch_kind != MirSwitchKind.Discriminant || block.place < 0 {
            return -1
        }
        let l = self.bc.mir.bare_local(block.place)
        if l < 0 {
            return -1
        }
        var err = false
        var other = block.otherwise == s
        var k = 0
        while k < block.arm_count {
            let arm = self.bc.mir.arms[block.arm_first + k]
            k = k + 1
            if arm.target != s {
                continue
            }
            let case_name = self.result_case_name(arm.value)
            if case_name.equals("Err") {
                err = true
            } else {
                other = true
            }
        }
        if err && not other { l } else { -1 }
    }

    // The local the operand at operand-list index `at` moves out of whole,
    // or -1.
    func moved_local(&self, at: Int) -> Int {
        let o = self.bc.mir.lists[at]
        if o < 0 {
            return -1
        }
        let info = self.bc.mir.operands[o]
        if info.kind != MirOperandKind.Move || info.place < 0 {
            return -1
        }
        self.bc.mir.bare_local(info.place)
    }

    // The place call `c` borrows its receiver from: a method of a declaration
    // whose first argument moves out of a local a `ref` made; or -1.
    func receiver_place(&self, c: &MirCall, refs: &Vector<Int>) -> Int {
        if c.kind != MirCallKind.Function || c.target < 0 || c.arg_count < 1 {
            return -1
        }
        if self.bc.mir.tc.sigs[c.target].receiver == TcReceiver.Absent {
            return -1
        }
        let r = self.moved_local(c.arg_first)
        if r < 0 {
            return -1
        }
        refs[r]
    }

    // Whether call `c` is `join`, `detach` or `cancel` of a handle a
    // cooperative spawn form mints, `join` or `detach` of a `Thread`, or a
    // `consumes` method of either. A consuming method ends the handle and its
    // body stands in for the handle's `deinit`, and only the defining module
    // can declare one (`consumes.foreign-type`), so only `std.task` adds a
    // fate this way.
    func is_fate_method(&self, c: &MirCall) -> Bool {
        if c.owner < 0 {
            return false
        }
        // Stage 0 workaround (SL:hazards S4): canonical: let d = self.bc.mir.tc.nominal_decl(self.bc.mir.tc.strip_refs(c.owner))
        let owner = self.bc.mir.tc.strip_refs(c.owner)
        let d = self.bc.mir.tc.nominal_decl(owner)
        let thread = d >= 0 && d == self.bc.mir.tc.known.thread
        if d < 0 || (d != self.bc.mir.tc.known.task && not thread) {
            return false
        }
        if (self.bc.mir.tc.sigs[c.target].effects & TC_EFFECT_CONSUMES) != 0 {
            return true
        }
        // Stage 0 workaround (SL:hazards S4): canonical: let name = self.bc.mir.tc.name_text(self.bc.mir.tc.res.decls[c.target].name)
        let interned = self.bc.mir.tc.res.decls[c.target].name
        let name = self.bc.mir.tc.name_text(interned)
        if thread {
            return name.equals("join") || name.equals("detach")
        }
        name.equals("join") || name.equals("detach") || name.equals("cancel")
    }

    // Whether the value place `p` is rooted in has a type that declares a
    // hand-written `deinit`, reached through any reference to it.
    func owner_declares_deinit(&var self, f: Int, p: Int) -> Bool {
        let l = self.bc.mir.places[p].local
        if l < 0 {
            return false
        }
        let t = mir_func_local(&self.bc.mir, f, l).ty
        // Stage 0 workaround (SL:hazards S4): canonical: let d = self.bc.mir.tc.nominal_decl(self.bc.mir.tc.strip_refs(t))
        let owner = self.bc.mir.tc.strip_refs(t)
        let d = self.bc.mir.tc.nominal_decl(owner)
        d >= 0 && self.bc.mir.deinit_member(d) >= 0
    }

    // Refuses the handle site `site` minted, once per site, for leaving by
    // `why` from local `l` (-1 for the site's own destination); `call` names
    // the call an argument escapes into.
    func refuse_fate(&var self, f: Int, site: Int, l: Int, why: DropsEscape, call: Int, reported: &var Vector<Int>) {
        var k = 0
        while k < reported.len() {
            if reported[k] == site {
                return
            }
            k = k + 1
        }
        try! reported.push(site)
        let c = self.bc.mir.calls[site]
        var node = c.node
        if node < 0 {
            node = self.bc.mir.funcs[f].root
        }
        // A `Thread.spawn` site's destination is the `Result` that carries
        // the handle; once bound, the obligation sits on the handle.
        let thread = c.kind == MirCallKind.Builtin
        var handle_type = self.bc.mir.places[c.dest].ty
        var name = -1
        if l >= 0 {
            let local = mir_func_local(&self.bc.mir, f, l)
            handle_type = local.ty
            if local.kind == MirLocalKind.User {
                name = local.name
            }
        }
        if name < 0 {
            name = self.binding_of(f, c.dest)
        }
        let handle = self.bc.mir.tc.type_text(handle_type)
        var msg = StringBuilder()
        if name < 0 && thread {
            try! msg.append("`Thread.spawn` hands back a `")
            try! msg.append(handle)
            try! msg.append("` whose `Ok` handle must be consumed, and this one is discarded. Bind the handle, as `try! Thread.spawn \{ ... \}` does, and consume it on every path: ")
        } else if name < 0 {
            try! msg.append("`Task.spawn` hands back a `")
            try! msg.append(handle)
            try! msg.append("` that must be consumed, and this one is discarded. Bind it and consume it on every path: ")
        } else {
            let binding = self.bc.mir.tc.name_text(name)
            try! msg.append("`")
            try! msg.append(binding)
            try! msg.append("` holds the `")
            try! msg.append(handle)
            try! msg.append("` spawned here, which is never consumed: `")
            try! msg.append(binding)
            try! msg.append("` ")
            match why {
                case Dropped -> {
                    if thread {
                        try! msg.append("is dropped with no `join()` or `detach()` of it on some path")
                    } else {
                        try! msg.append("is dropped with no `join()`, `detach()` or `cancel()` of it on some path")
                    }
                },
                case Returned -> try! msg.append("leaves the function by a `return` without consuming it"),
                case Stored -> try! msg.append("moves into storage whose owner declares no `deinit`, which writes no fate"),
                case Argument -> {
                    try! msg.append("moves into an argument of `")
                    try! msg.append(self.call_label(call))
                    try! msg.append("`, which writes no fate")
                },
                case Captured -> try! msg.append("is taken by a closure's capture, which writes no fate")
            }
            try! msg.append(". ")
        }
        if thread {
            try! msg.append("`join()` waits for it and takes its result, `(try! Thread.spawn \{ ... \}).join()` being the wait-here spelling, and `detach()` gives the thread to the process. To manage a dynamic set of workers, spawn them into a `TaskGroup`: a group is a declared consumer, so its handles may be dropped freely")
        } else {
            try! msg.append("`join()` waits for it and takes its result, `detach()` hands it to the process (its result is dropped at completion), and `cancel()` asks it to stop. To manage a dynamic set of tasks, spawn them into a `TaskGroup`: a group is a declared consumer, so its handles may be dropped freely")
        }
        if name >= 0 {
            try! msg.append(". Moving it into storage writes its fate only when the storing type declares a `deinit` of its own")
        }
        let m = self.bc.mir.tc.node_module(node)
        let span = self.bc.mir.tc.res.nodes[node]
        try! self.diags.push(MirDiag(module: m, start: span.start, end: span.end, id: "drop.must-consume",
                                     message: msg.build()))
    }

    // The name of the binding of `f` a site's destination `dest` is moved
    // into whole, as `let t = Task.spawn(...)` binds it, or -1.
    func binding_of(&self, f: Int, dest: Int) -> Int {
        let d = self.bc.mir.bare_local(dest)
        if d < 0 {
            return -1
        }
        let info = self.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.bc.mir.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = self.bc.mir.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = self.bc.mir.rvalues[stmt.rvalue]
                let to = self.bc.mir.bare_local(stmt.place)
                if rv.kind != MirRvalueKind.Use || rv.count != 1 || to < 0 {
                    continue
                }
                if self.moved_local(rv.first) != d {
                    continue
                }
                let local = mir_func_local(&self.bc.mir, f, to)
                if local.kind == MirLocalKind.User {
                    return local.name
                }
            }
        }
        return -1
    }

    // How a refusal names the target of call `c`.
    func call_label(&self, c: Int) -> String {
        if c < 0 {
            return "a call"
        }
        let info = self.bc.mir.calls[c]
        if info.target < 0 {
            return "a function value"
        }
        self.bc.mir.tc.res.decl_path(info.target)
    }

    // A broken invariant in function `f`, at statement `s` or the function.
    public func problem(&var self, f: Int, s: Int, text: String) {
        let info = self.bc.mir.funcs[f]
        var line = StringBuilder()
        try! line.append(self.bc.mir.tc.res.node_position(info.module, info.root))
        try! line.append(" ")
        try! line.append(self.bc.mir.func_name(f))
        if s >= 0 {
            let stmt = self.bc.mir.stmts[s]
            try! line.append(": the statement at ")
            try! line.append(self.bc.mir.span_text(stmt.node, stmt.closing))
        }
        try! line.append(" ")
        try! line.append(text)
        try! self.problems.push(line.build())
        try! self.problem_modules.push(info.module)
    }
}
