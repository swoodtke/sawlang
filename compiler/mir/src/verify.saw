// The MIR verifier (SL:architecture §3.0, "every boundary has a verifier"),
// run on every function lowered. It reads the MIR alone, apart from the
// lowering, and checks:
//   - every block ends in one terminator, and every edge names a block;
//   - every place, operand and rvalue is typed and in range, and every
//     operand is a move, a copy or a constant;
//   - a frame slot `(*_K).[off: T]` is the second step of its place, right
//     after the dereference of the local holding the frame pointer, at an
//     offset of at least 0, so a frame value is only ever addressed in place;
//   - no conversion is left implicit: an assignment's rvalue has its place's
//     type, and a call's argument the type its target takes at the call's
//     own instantiation, synthesized calls and externs included (a builtin
//     declares no signature, and a C variadic tail no type);
//   - every call names its target and a complete instantiation, and is a
//     suspension point exactly as typecheck's summaries make it, a
//     conditional one with its conditions;
//   - no owned local is live at a `return` or when it is assigned again,
//     so every scope exit drops it; no window is open at a `return` or when
//     it opens again, so every path out of its body closes it; no path is
//     dropped whole once a move has taken a part out of it; no path drops a
//     place twice, or uses a local after its drop, with no assignment
//     between. The move-path facts are the initialisation analysis's
//     (initialisation.saw);
//   - an accessor's epilogue carries exactly its prologue's carried windows,
//     in order;
//   - a window's presence local is the Optional its conditional open writes,
//     an open with no absent edge;
//   - every cycle the entry reaches passes an op-budget point;
//   - every statement and terminator the entry reaches carries a source node;
//   - no operand moves an owning value out through a reference, but for an
//     epilogue's record load and a closure body's take of a take capture,
//     each in its one shape;
//   - no operand copies an owning value whose type does not copy silently,
//     which would give a NoCopy or ExplicitCopy value a second owner;
//   - every proven payload `(P as CASE)` is used only where every path has
//     switched `P` to CASE with nothing writing `P` since, which is what lets
//     a construct drop its leftovers when its body completes.

import sawmir.build.{mir_func_local}
import sawmir.dump.{mir_dump_module, mir_module_functions}
import sawmir.initialisation.{MIR_INIT_DROPPED, MIR_INIT_MOVED, MIR_INIT_PARTIAL, MIR_INIT_WHOLE, MirAccess, MirAccessKind,
                        MirInit}
import sawmir.model.{MirAccessor, MirArm, MirBlock, MirCall, MirCallKind, MirFunc, MirFuncKind, MirLocal, MirLocalKind,
                         MirOperand, MirOperandKind, MirPlace, MirProj, MirProjKind, MirRvalue, MirRvalueKind,
                         MirDriveForm, MirSpawnForm, MirStmt, MirStmtKind, MirSuspend, MirSwitchKind,
                         MirTermKind, mir_spawn_leading}
import sawmir.program.{MirProgram}
import sawmir.split.{MirHalf}
import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResDeclKind}
import sawresolve.program.{ResProgram}
// For the extension writing `casts_backing`.
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.bodydump.{tc_dump_bodies}
import sawtypecheck.conform.{TcSubst}
import sawtypecheck.model.{TC_EFFECT_BORROWS, TC_EFFECT_CONSUMES, TcLend, TcReceiver}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.summaries.{TcAcc}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// Every problem the verifier finds in the functions module `m`'s bodies
// lowered to, one line each.
public func mir_verify_module(p: &var MirProgram, m: Int) -> Vector<String> {
    var out = Vector<String>()
    let order = mir_module_functions(&p, m)
    var k = 0
    while k < order.len() {
        p.verify_func(order[k], &var out)
        k = k + 1
    }
    move out
}

extension MirProgram {
    func verify_func(&var self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        self.cur = f
        self.local_base = info.local_first
        self.block_base = info.block_first
        var b = 0
        while b < info.block_count {
            self.verify_block(f, b, &var out)
            b = b + 1
        }
        self.verify_flow(f, &var out)
        self.verify_budget_cycles(f, &var out)
        self.verify_halves(f, &var out)
        self.verify_nodes(f, &var out)
        self.verify_moves(f, &var out)
        self.verify_payloads(f, &var out)
        self.verify_default_result(f, &var out)
    }

    // A default value's function returns its parameter's declared type, so
    // each call's instantiation of it is the slot the caller passes; a
    // generic default typed at anything else stores one width into another
    // (pinned by compiler/mir/tests/verify_default_result.saw).
    func verify_default_result(&var self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if info.kind != MirFuncKind.Default || info.decl < 0 || info.local_count == 0 {
            return
        }
        let s = self.tc.sigs[info.decl]
        if info.param < 0 || info.param >= s.param_count {
            self.problem(f, &var out, "a default's function names no parameter")
            return
        }
        let want = self.tc.params[s.param_first + info.param].ty
        let have = self.locals[info.local_first].ty
        if have != want {
            var text = StringBuilder()
            try! text.append("a default's function returns `")
            try! text.append(self.tc.type_text(have))
            try! text.append("` for a parameter of type `")
            try! text.append(self.tc.type_text(want))
            try! text.append("`")
            self.problem(f, &var out, text.build())
        }
    }

    // No operand moves an owning value out through a reference, and none
    // copies one that does not copy silently. Storage reached through a
    // `Deref` of a reference belongs to someone else, who drops it again, so
    // such a move is a double free once code exists (SL-475). A value that
    // owns nothing, a reference part among them, may move. Two shapes are
    // admitted: an epilogue's load from its accessor's state record, which
    // the accessor owns across its split, and a closure body's take of a
    // take capture (`take_shape`).
    func verify_moves(&var self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.blocks[info.block_first + b]
            var s = block.first
            while s >= 0 {
                let stmt = self.stmts[s]
                let at = s
                s = stmt.next
                if stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                    let rv = self.rvalues[stmt.rvalue]
                    var k = 0
                    while k < rv.count {
                        let o = self.lists[rv.first + k]
                        self.check_move(f, b, at, o, &var out)
                        if not self.reads_tag(&rv, o) {
                            self.check_copy(f, b, o, &var out)
                        }
                        k = k + 1
                    }
                }
            }
            if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Bool {
                self.check_move(f, b, -1, block.operand, &var out)
                self.check_copy(f, b, block.operand, &var out)
            } else if block.term == MirTermKind.Call && block.call >= 0 {
                let c = self.calls[block.call]
                if c.callee >= 0 {
                    self.check_move(f, b, -1, c.callee, &var out)
                    self.check_copy(f, b, c.callee, &var out)
                }
                var k = 0
                while k < c.arg_count {
                    let o = self.lists[c.arg_first + k]
                    self.check_move(f, b, -1, o, &var out)
                    self.check_copy(f, b, o, &var out)
                    k = k + 1
                }
            }
            b = b + 1
        }
    }

    // Operand `o` of statement `s` of block `b`, or of its terminator when
    // `s` is -1.
    func check_move(&var self, f: Int, b: Int, s: Int, o: Int, out: &var Vector<String>) {
        if o < 0 || o >= self.operands.len() {
            return
        }
        let operand = self.operands[o]
        if operand.kind != MirOperandKind.Move || not self.through_reference_deref(operand.place) {
            return
        }
        if not self.owns(operand.ty) || self.epilogue_record_load(f, operand.place) || self.take_shape(f, b, s) {
            return
        }
        var text = StringBuilder()
        try! text.append("bb")
        try! text.append(b)
        try! text.append(" moves a `")
        try! text.append(self.tc.type_text(operand.ty))
        try! text.append("` out through a reference, `")
        self.append_place(&var text, operand.place)
        try! text.append("`: the referent's owner drops it again")
        self.problem(f, &var out, text.build())
    }

    // Operand `o` of block `b` copied: a bitwise copy of a value that does
    // not copy silently gives it a second owner, so it is dropped twice or
    // its copy's storage leaks. Typecheck refuses every such copy the source
    // spells, and a `copy()` hook runs as a call, so one here is the
    // lowering's (pinned by compiler/mir/tests/verify_copies.saw).
    func check_copy(&var self, f: Int, b: Int, o: Int, out: &var Vector<String>) {
        if o < 0 || o >= self.operands.len() {
            return
        }
        let operand = self.operands[o]
        if operand.kind != MirOperandKind.Copy || not self.owns(operand.ty) || self.tc.copies_silently(operand.ty) {
            return
        }
        var text = StringBuilder()
        try! text.append("bb")
        try! text.append(b)
        try! text.append(" copies a `")
        try! text.append(self.tc.type_text(operand.ty))
        try! text.append("`, which does not copy silently, `")
        self.append_place(&var text, operand.place)
        try! text.append("`: the copy is a second owner of the value")
        self.problem(f, &var out, text.build())
    }

    // Whether operand `o` of rvalue `rv` is a raw-backed enum a cast to an
    // integer reads: the enum is its tag, so the cast reads the tag and the
    // value stays with its one owner (spec, Raw-backed enums).
    func reads_tag(&self, rv: &MirRvalue, o: Int) -> Bool {
        let t = self.operands[o].ty
        rv.kind == MirRvalueKind.Cast && self.tc.casts_backing(t, rv.ty)
    }

    // Whether place `p` of `f` is an epilogue's load of record local K, the
    // whole entry `(*_1).K`.
    func epilogue_record_load(&self, f: Int, p: Int) -> Bool {
        let info = self.funcs[f]
        if info.kind != MirFuncKind.Epilogue {
            return false
        }
        let k = self.env_entry(p, 2)
        k >= 0 && k < info.record_count
    }

    // K when place `p` is `(*_1).K` followed by `extra - 2` more steps, else
    // -1.
    func env_entry(&self, p: Int, extra: Int) -> Int {
        let place = self.places[p]
        if place.local != 1 || place.count != extra {
            return -1
        }
        let entry = self.projs[place.first + 1]
        if self.projs[place.first].kind != MirProjKind.Deref || entry.kind != MirProjKind.Tuple {
            return -1
        }
        entry.index
    }

    // Whether statement `s` of block `b` of `f` is a closure body's take of a
    // take capture K, the one shape `load_take_capture` emits:
    //   - `s` is `_L = move (*(*_1).K.0)`, K a take capture of the closure;
    //   - the statement after it is `(*(*_1).K.1) = const false`;
    //   - `b` starts with `s` and is entered only by the true arm of
    //     `switch copy (*(*_1).K.1)`, whose false arm is a block holding
    //     nothing but a builtin `panic` that never returns.
    func take_shape(&var self, f: Int, b: Int, s: Int) -> Bool {
        let info = self.funcs[f]
        if s < 0 || info.kind != MirFuncKind.Closure {
            return false
        }
        let block = self.blocks[info.block_first + b]
        let stmt = self.stmts[s]
        if block.first != s || stmt.place < 0 || self.places[stmt.place].count != 0 {
            return false
        }
        let rv = self.rvalues[stmt.rvalue]
        if rv.kind != MirRvalueKind.Use || rv.count != 1 {
            return false
        }
        let value = self.operands[self.lists[rv.first]].place
        let k = self.take_slot(value, 0)
        if k < 0 || not self.closure_take(f, k) || stmt.next < 0 {
            return false
        }
        let clear = self.stmts[stmt.next]
        if clear.kind != MirStmtKind.Assign || self.take_slot(clear.place, 1) != k || not self.constant_false(clear.rvalue) {
            return false
        }
        let head = self.only_predecessor(f, b)
        if head < 0 {
            return false
        }
        let test = self.blocks[info.block_first + head]
        if test.term != MirTermKind.Switch || test.switch_kind != MirSwitchKind.Bool || test.arm_count != 2 {
            return false
        }
        let tested = self.operands[test.operand]
        if tested.kind != MirOperandKind.Copy || self.take_slot(tested.place, 1) != k {
            return false
        }
        let yes = self.arms[test.arm_first]
        let no = self.arms[test.arm_first + 1]
        yes.value == 1 && yes.target == b && no.value == 0 && self.panics_only(f, no.target)
    }

    // K when place `p` is `(*(*_1).K.slot)`, else -1.
    func take_slot(&self, p: Int, slot: Int) -> Int {
        if p < 0 {
            return -1
        }
        let k = self.env_entry(p, 4)
        if k < 0 {
            return -1
        }
        let place = self.places[p]
        let part = self.projs[place.first + 2]
        let deref = self.projs[place.first + 3]
        if part.kind != MirProjKind.Tuple || part.index != slot || deref.kind != MirProjKind.Deref {
            return -1
        }
        k
    }

    // Whether capture K of closure function `f` is a take.
    func closure_take(&var self, f: Int, k: Int) -> Bool {
        let e = self.funcs[f].root
        let at = self.tc.closure_index.first(e, 0)
        if at < 0 {
            return false
        }
        let index = self.tc.closure_index.value(at)
        self.take_capture(index, k)
    }

    // Whether rvalue `r` is `const false`.
    func constant_false(&self, r: Int) -> Bool {
        if r < 0 {
            return false
        }
        let rv = self.rvalues[r]
        if rv.kind != MirRvalueKind.Use || rv.count != 1 {
            return false
        }
        let o = self.operands[self.lists[rv.first]]
        o.kind == MirOperandKind.Const && self.tc.name_text(o.text).equals("false")
    }

    // The one block with an edge to block `b` of `f`, or -1 for none or
    // several.
    func only_predecessor(&self, f: Int, b: Int) -> Int {
        let info = self.funcs[f]
        var found = -1
        var p = 0
        while p < info.block_count {
            let block = self.blocks[info.block_first + p]
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            var j = 0
            while j < succ.len() {
                if succ[j] == b {
                    if found >= 0 && found != p {
                        return -1
                    }
                    found = p
                }
                j = j + 1
            }
            p = p + 1
        }
        found
    }

    // Whether block `b` of `f` holds nothing but a builtin `panic` call that
    // never returns.
    func panics_only(&self, f: Int, b: Int) -> Bool {
        let info = self.funcs[f]
        if b < 0 || b >= info.block_count {
            return false
        }
        let block = self.blocks[info.block_first + b]
        if block.first >= 0 || block.term != MirTermKind.Call {
            return false
        }
        let c = self.calls[block.call]
        c.kind == MirCallKind.Builtin && c.next < 0 && self.tc.name_text(c.spelling).equals("panic")
    }

    // Every statement and terminator the entry reaches carries a source node
    // (`source_at` in build.saw).
    func verify_nodes(&self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if info.block_count == 0 {
            return
        }
        var reached = Vector<Bool>()
        var k = 0
        while k < info.block_count {
            try! reached.push(k == 0)
            k = k + 1
        }
        var work = Vector<Int>()
        try! work.push(0)
        var at = 0
        while at < work.len() {
            let b = work[at]
            at = at + 1
            let block = self.blocks[info.block_first + b]
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                if target >= 0 && target < info.block_count && not reached[target] {
                    reached[target] = true
                    try! work.push(target)
                }
                j = j + 1
            }
            var s = block.first
            while s >= 0 {
                let stmt = self.stmts[s]
                if stmt.node < 0 {
                    var text = StringBuilder()
                    try! text.append("a statement of bb")
                    try! text.append(b)
                    try! text.append(" carries no source node")
                    self.problem(f, &var out, text.build())
                }
                s = stmt.next
            }
            if block.term_node < 0 {
                var text = StringBuilder()
                try! text.append("the terminator of bb")
                try! text.append(b)
                try! text.append(" carries no source node")
                self.problem(f, &var out, text.build())
            }
        }
    }

    // An accessor's halves (SL:architecture §3.5): a `borrows` accessor that
    // lends a place is never lowered whole; each half belongs to its
    // accessor's entry; the epilogue's record holds exactly the locals live
    // where it resumes, none read before the record gives it and none it
    // never reads; and each prologue return writes every field of the record
    // but the drop flags, or none on a conditional lend's absent path.
    func verify_halves(&var self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if info.kind == MirFuncKind.Body && info.decl >= 0 && self.lends_place_decl(info.decl) {
            self.problem(f, &var out, "a `borrows` accessor is lowered whole, not as two halves around its `lend`")
            return
        }
        if info.kind != MirFuncKind.Prologue && info.kind != MirFuncKind.Epilogue {
            return
        }
        let a = self.accessor_of[info.decl]
        if a < 0 {
            self.problem(f, &var out, "an accessor's half belongs to no accessor")
            return
        }
        let acc = self.accessors[a]
        let half = if info.kind == MirFuncKind.Prologue { acc.prologue } else { acc.epilogue }
        if half != f {
            self.problem(f, &var out, "an accessor's half is not the one its accessor names")
            return
        }
        if info.kind == MirFuncKind.Epilogue {
            self.verify_epilogue_record(f, acc.record, &var out)
            self.verify_carried(f, acc.prologue, &var out)
        } else {
            self.verify_prologue_record(f, acc.record, &var out)
        }
    }

    // Whether declaration `d` is a `borrows` accessor that lends a place.
    func lends_place_decl(&self, d: Int) -> Bool {
        let s = self.tc.sigs[d]
        let place = s.lending == TcLend.Place || s.lending == TcLend.ConditionalPlace
        (s.effects & TC_EFFECT_BORROWS) != 0 && place
    }

    func verify_epilogue_record(&var self, f: Int, record: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        let n = info.local_count
        let live = self.recomputed_liveness(f)
        var k = 0
        while k < n {
            let is_record_param = record >= 0 && k == 1
            if live[k] && not is_record_param {
                var text = StringBuilder()
                try! text.append("local _")
                try! text.append(k)
                try! text.append(" is read in the epilogue before the record gives it: the record misses a local live across `lend`")
                self.problem(f, &var out, text.build())
            }
            k = k + 1
        }
        let entry = self.blocks[info.block_first]
        var succ = Vector<Int>()
        var opened = -1
        self.successors(f, &entry, &var succ, &var opened)
        k = 0
        while k < info.record_count {
            let l = self.aux[info.record_first + k]
            var read = false
            var j = 0
            while j < succ.len() {
                if live[succ[j] * n + l] {
                    read = true
                }
                j = j + 1
            }
            if not read {
                var text = StringBuilder()
                try! text.append("record local _")
                try! text.append(l)
                try! text.append(" is never read after the `lend`: the record holds a local not live across it")
                self.problem(f, &var out, text.build())
            }
            k = k + 1
        }
    }

    // Which locals of `f` are live at each block's entry, `block *
    // local_count + local`, computed apart from the split's own liveness
    // (split.saw), so a fault there is a disagreement here rather than a
    // shared blind spot. Per local: each block that reads it before writing
    // it whole is live, and liveness spreads back along every edge into a
    // block that does not write it whole first. A read is any place an
    // operand, a statement, an rvalue or a terminator names, a write into a
    // part, and an index; a whole write is an assignment to the bare local,
    // after its rvalue's reads, or a call's destination, after its operands.
    public func recomputed_liveness(&self, f: Int) -> Vector<Bool> {
        let info = self.funcs[f]
        let n = info.local_count
        let count = info.block_count
        // Per block and local: read before any whole write, or written whole
        // before any read.
        var reads = Vector<Bool>()
        var kills = Vector<Bool>()
        var k = 0
        while k < count * n {
            try! reads.push(false)
            try! kills.push(false)
            k = k + 1
        }
        // The block that last touched each local, so each block notes only
        // a local's first access.
        var touched = Vector<Int>()
        k = 0
        while k < n {
            try! touched.push(-1)
            k = k + 1
        }
        // Block `b`'s predecessors are `preds[pred_first[b] .. pred_first[b
        // + 1]]`.
        var pred_first = Vector<Int>()
        k = 0
        while k <= count {
            try! pred_first.push(0)
            k = k + 1
        }
        var b = 0
        while b < count {
            let block = self.blocks[info.block_first + b]
            var s = block.first
            while s >= 0 {
                let stmt = self.stmts[s]
                s = stmt.next
                if stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                    let rv = self.rvalues[stmt.rvalue]
                    self.live_read_place(rv.place, b, n, &var touched, &var reads)
                    self.live_read_place(rv.flag, b, n, &var touched, &var reads)
                    var j = 0
                    while j < rv.count {
                        let o = self.lists[rv.first + j]
                        self.live_read_operand(o, b, n, &var touched, &var reads)
                        j = j + 1
                    }
                    self.live_write_place(stmt.place, b, n, &var touched, &var reads, &var kills)
                } else if stmt.kind == MirStmtKind.Drop {
                    self.live_read_place(stmt.place, b, n, &var touched, &var reads)
                }
            }
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                pred_first[target + 1] += 1
                j = j + 1
            }
            if block.term == MirTermKind.Switch {
                self.live_read_operand(block.operand, b, n, &var touched, &var reads)
                self.live_read_place(block.place, b, n, &var touched, &var reads)
            } else if block.term == MirTermKind.Call {
                let c = self.calls[block.call]
                j = 0
                while j < c.arg_count {
                    let o = self.lists[c.arg_first + j]
                    self.live_read_operand(o, b, n, &var touched, &var reads)
                    j = j + 1
                }
                self.live_read_operand(c.callee, b, n, &var touched, &var reads)
                self.live_write_place(c.dest, b, n, &var touched, &var reads, &var kills)
            }
            b = b + 1
        }
        k = 0
        while k < count {
            let below = pred_first[k]
            pred_first[k + 1] += below
            k = k + 1
        }
        var preds = Vector<Int>()
        var fill = Vector<Int>()
        k = 0
        while k < pred_first[count] {
            try! preds.push(-1)
            k = k + 1
        }
        k = 0
        while k < count {
            try! fill.push(pred_first[k])
            k = k + 1
        }
        b = 0
        while b < count {
            let block = self.blocks[info.block_first + b]
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                preds[fill[target]] = b
                fill[target] += 1
                j = j + 1
            }
            b = b + 1
        }
        var live = Vector<Bool>()
        k = 0
        while k < count * n {
            try! live.push(false)
            k = k + 1
        }
        var l = 0
        while l < n {
            var work = Vector<Int>()
            b = 0
            while b < count {
                if reads[b * n + l] {
                    live[b * n + l] = true
                    try! work.push(b)
                }
                b = b + 1
            }
            var next = 0
            while next < work.len() {
                let at = work[next]
                next = next + 1
                var j = pred_first[at]
                while j < pred_first[at + 1] {
                    let p = preds[j]
                    j = j + 1
                    if not live[p * n + l] && not kills[p * n + l] {
                        live[p * n + l] = true
                        try! work.push(p)
                    }
                }
            }
            l = l + 1
        }
        move live
    }

    func live_read_operand(&self, o: Int, b: Int, n: Int, touched: &var Vector<Int>, reads: &var Vector<Bool>) {
        if o >= 0 && self.operands[o].kind != MirOperandKind.Const {
            let p = self.operands[o].place
            self.live_read_place(p, b, n, &var touched, &var reads)
        }
    }

    // Place `p` read in block `b`: its local, and every index local.
    func live_read_place(&self, p: Int, b: Int, n: Int, touched: &var Vector<Int>, reads: &var Vector<Bool>) {
        if p < 0 {
            return
        }
        let info = self.places[p]
        if info.local >= 0 {
            self.live_note(info.local, b, n, &var touched, &var reads)
        }
        self.live_read_indices(p, b, n, &var touched, &var reads)
    }

    func live_read_indices(&self, p: Int, b: Int, n: Int, touched: &var Vector<Int>, reads: &var Vector<Bool>) {
        let info = self.places[p]
        var k = 0
        while k < info.count {
            let step = self.projs[info.first + k]
            if step.kind == MirProjKind.Index && step.index >= 0 {
                self.live_note(step.index, b, n, &var touched, &var reads)
            }
            k = k + 1
        }
    }

    // Place `p` written in block `b`: the bare local is written whole; a
    // place with steps reads its local and its indices.
    func live_write_place(&self, p: Int, b: Int, n: Int, touched: &var Vector<Int>, reads: &var Vector<Bool>,
                          kills: &var Vector<Bool>) {
        if p < 0 {
            return
        }
        let info = self.places[p]
        if info.local >= 0 && info.count == 0 {
            if touched[info.local] != b {
                touched[info.local] = b
                kills[b * n + info.local] = true
            }
            return
        }
        self.live_read_place(p, b, n, &var touched, &var reads)
    }

    // A read of local `l` in block `b`, noted when it is the block's first
    // access of `l`.
    func live_note(&self, l: Int, b: Int, n: Int, touched: &var Vector<Int>, reads: &var Vector<Bool>) {
        if touched[l] != b {
            touched[l] = b
            reads[b * n + l] = true
        }
    }

    // Epilogue `f` carries exactly prologue `pro`'s carried windows, in
    // order: as many, each in range of its own half's windows, the k-th of
    // each the same window of the accessor's body. The window dataflow here
    // and borrowck's carried loans read the two lists in step (SL-495), so a
    // mismatch would drop a loan silently rather than fail.
    func verify_carried(&self, f: Int, pro: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if pro < 0 {
            return
        }
        let pinfo = self.funcs[pro]
        if pinfo.carried_count != info.carried_count {
            var text = StringBuilder()
            try! text.append("the epilogue carries ")
            try! text.append(info.carried_count)
            try! text.append(" windows and its prologue leaves ")
            try! text.append(pinfo.carried_count)
            try! text.append(" open at the `lend`")
            self.problem(f, &var out, text.build())
            return
        }
        var k = 0
        while k < info.carried_count {
            let w = self.aux[info.carried_first + k]
            let pw = self.aux[pinfo.carried_first + k]
            k = k + 1
            if w < 0 || w >= info.window_count || pw < 0 || pw >= pinfo.window_count {
                self.problem(f, &var out, "a carried window is out of range of its half's windows")
                continue
            }
            let mine = self.windows[info.window_first + w]
            let theirs = self.windows[pinfo.window_first + pw]
            if mine.node != theirs.node {
                self.problem(f, &var out, "the epilogue's carried windows are not its prologue's, in order")
            }
        }
    }

    func verify_prologue_record(&self, f: Int, record: Int, out: &var Vector<String>) {
        if record < 0 {
            return
        }
        let info = self.funcs[f]
        let fields = self.tc.types.ty(record).count
        var b = 0
        while b < info.block_count {
            let block = self.blocks[info.block_first + b]
            b = b + 1
            if block.term != MirTermKind.Return {
                continue
            }
            var written = Vector<Bool>()
            var k = 0
            while k < fields {
                try! written.push(false)
                k = k + 1
            }
            var s = block.first
            while s >= 0 {
                let stmt = self.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign {
                    continue
                }
                let place = self.places[stmt.place]
                if place.local == 1 && place.count == 2 {
                    let step = self.projs[place.first + 1]
                    if step.kind == MirProjKind.Tuple && step.index < fields {
                        written[step.index] = true
                    }
                }
            }
            // A record local's flag field is drop elaboration's to write.
            k = 0
            var flagged = 0
            while k < info.record_count {
                let slot = self.aux[info.record_flags_first + k]
                if slot >= 0 && slot < fields {
                    written[slot] = false
                    flagged = flagged + 1
                }
                k = k + 1
            }
            var count = 0
            k = 0
            while k < fields {
                if written[k] {
                    count = count + 1
                }
                k = k + 1
            }
            if count != 0 && count != fields - flagged {
                self.problem(f, &var out, "a prologue's `lend` writes some of the record's fields and not others")
            }
        }
    }

    // Whether MIR function `f` holds a call that may suspend.
    func function_suspends(&self, f: Int) -> Bool {
        let info = self.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.blocks[info.block_first + b]
            if block.term == MirTermKind.Call && self.calls[block.call].suspend != MirSuspend.Never {
                return true
            }
            b = b + 1
        }
        false
    }

    // Whether flow slot `k` of prologue `f` (a local, then a window) is what
    // its `lend` hands the epilogue: a record local, or a window left open.
    func carried_at_lend(&self, f: Int, k: Int) -> Bool {
        let info = self.funcs[f]
        if info.kind != MirFuncKind.Prologue {
            return false
        }
        var j = 0
        if k < info.local_count {
            while j < info.record_count {
                if self.aux[info.record_first + j] == k {
                    return true
                }
                j = j + 1
            }
            return false
        }
        while j < info.carried_count {
            if self.aux[info.carried_first + j] == k - info.local_count {
                return true
            }
            j = j + 1
        }
        false
    }

    // A window call names its accessor's half and passes its record, or,
    // for an accessor this program lowers no body of, neither.
    func verify_window_call(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        let info = self.funcs[f]
        if c.window < 0 || c.window >= info.window_count {
            return
        }
        let w = self.windows[info.window_first + c.window]
        if w.presence >= 0 && c.kind == MirCallKind.WindowOpen {
            let named = c.dest >= 0 && self.places[c.dest].local == w.presence && self.places[c.dest].count == 0
            if not w.conditional || c.absent >= 0 || not named {
                self.problem(f, &var out, "a window's presence local is not the Optional its conditional open, with no absent edge, writes")
            }
        }
        let a = self.accessor_of[c.target]
        if a < 0 {
            if c.half >= 0 || w.record >= 0 {
                self.problem(f, &var out, "a window call names a half or a record for an accessor this program lowers no body of")
            }
            return
        }
        let acc = self.accessors[a]
        let half = if c.kind == MirCallKind.WindowOpen { acc.prologue } else { acc.epilogue }
        if c.half != half {
            self.problem(f, &var out, "a window call does not name its accessor's half")
        }
        if (acc.record >= 0) != (w.record >= 0) {
            self.problem(f, &var out, "a window holds a record its accessor does not lay out, or none for one it does")
            return
        }
        if w.record < 0 {
            return
        }
        if c.arg_count == 0 {
            self.problem(f, &var out, "a window call does not pass its record")
            return
        }
        let o = self.lists[c.arg_first]
        let have = self.operands[o].ty
        let rt = mir_func_local(&self, f, w.record).ty
        let want = self.tc.mk_ref(true, rt)
        let raw = self.call_type(acc.record, &c)
        if have != want || rt != raw {
            self.problem(f, &var out, "a window call's record is not its accessor's, instantiated")
        }
    }

    func problem(&self, f: Int, out: &var Vector<String>, text: String) {
        var line = StringBuilder()
        try! line.append(self.func_label(f))
        try! line.append(": ")
        try! line.append(text)
        try! out.push(line.build())
    }

    func func_label(&self, f: Int) -> String {
        let info = self.funcs[f]
        var line = StringBuilder()
        try! line.append(self.tc.res.node_position(info.module, info.root))
        try! line.append(" ")
        try! line.append(self.func_name(f))
        line.build()
    }

    func verify_block(&var self, f: Int, b: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        let block = self.blocks[info.block_first + b]
        var s = block.first
        while s >= 0 {
            let stmt = self.stmts[s]
            if stmt.kind == MirStmtKind.Assign {
                self.verify_place(f, stmt.place, &var out)
                self.verify_rvalue(f, stmt.rvalue, &var out)
                if stmt.place >= 0 && stmt.rvalue >= 0 {
                    let pt = self.places[stmt.place].ty
                    let rt = self.rvalues[stmt.rvalue].ty
                    if pt != rt {
                        var text = StringBuilder()
                        try! text.append("bb")
                        try! text.append(b)
                        try! text.append(" assigns a `")
                        try! text.append(self.tc.type_text(rt))
                        try! text.append("` to a place of type `")
                        try! text.append(self.tc.type_text(pt))
                        try! text.append("`, a conversion left implicit")
                        self.problem(f, &var out, text.build())
                    }
                }
            } else if stmt.kind == MirStmtKind.Drop {
                self.verify_place(f, stmt.place, &var out)
            }
            s = stmt.next
        }
        match block.term {
            case Open -> self.problem(f, &var out, "a block has no terminator"),
            case Goto -> self.verify_edge(f, block.target, &var out),
            case Switch -> {
                var k = 0
                while k < block.arm_count {
                    let arm = self.arms[block.arm_first + k]
                    self.verify_edge(f, arm.target, &var out)
                    k = k + 1
                }
                if block.otherwise >= 0 {
                    self.verify_edge(f, block.otherwise, &var out)
                }
                if block.switch_kind == MirSwitchKind.Bool {
                    self.verify_operand(f, block.operand, &var out)
                    var read = -1
                    if block.operand >= 0 {
                        read = self.operands[block.operand].ty
                    }
                    if read >= 0 && not self.tc.is_bool(read) {
                        self.problem(f, &var out, "a switch on a `Bool` reads no `Bool`")
                    }
                } else {
                    self.verify_place(f, block.place, &var out)
                }
            },
            case Call -> self.verify_call(f, block.call, &var out),
            case Return -> {},
            case Unreachable -> {}
        }
    }

    func verify_edge(&self, f: Int, target: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if target < 0 || target >= info.block_count {
            self.problem(f, &var out, "an edge names no block")
        }
    }

    func verify_place(&self, f: Int, p: Int, out: &var Vector<String>) {
        if p < 0 || p >= self.places.len() {
            self.problem(f, &var out, "a place is out of range")
            return
        }
        let info = self.funcs[f]
        let place = self.places[p]
        if place.local >= info.local_count || (place.local < 0 && place.static_decl < 0) {
            self.problem(f, &var out, "a place names no local")
        }
        if place.ty < 0 {
            self.problem(f, &var out, "a place has no type")
        }
        var k = 0
        while k < place.count {
            let step = self.projs[place.first + k]
            if step.ty < 0 {
                self.problem(f, &var out, "a projection has no type")
            }
            if step.kind == MirProjKind.Index && (step.index < 0 || step.index >= info.local_count) {
                self.problem(f, &var out, "an index projection names no local")
            }
            if step.kind == MirProjKind.FrameSlot {
                let through_frame = k == 1 && place.local >= 0 && self.projs[place.first].kind == MirProjKind.Deref
                if not through_frame {
                    self.problem(f, &var out, "a frame slot is not the second step of a place through a frame pointer local")
                }
                if step.index < 0 {
                    self.problem(f, &var out, "a frame slot has a negative offset")
                }
            }
            k = k + 1
        }
    }

    func verify_operand(&self, f: Int, o: Int, out: &var Vector<String>) {
        if o < 0 || o >= self.operands.len() {
            self.problem(f, &var out, "an operand is out of range")
            return
        }
        let info = self.operands[o]
        if info.ty < 0 {
            self.problem(f, &var out, "an operand has no type")
        }
        if info.kind == MirOperandKind.Const {
            if info.text < 0 {
                self.problem(f, &var out, "a constant has no spelling")
            }
        } else {
            self.verify_place(f, info.place, &var out)
        }
    }

    func verify_rvalue(&self, f: Int, r: Int, out: &var Vector<String>) {
        if r < 0 || r >= self.rvalues.len() {
            self.problem(f, &var out, "an rvalue is out of range")
            return
        }
        let info = self.rvalues[r]
        if info.ty < 0 {
            self.problem(f, &var out, "an rvalue has no type")
        }
        if info.kind == MirRvalueKind.Ref {
            self.verify_place(f, info.place, &var out)
        }
        if info.kind == MirRvalueKind.Take {
            self.verify_take(f, &info, &var out)
        }
        var k = 0
        while k < info.count {
            let o = self.lists[info.first + k]
            self.verify_operand(f, o, &var out)
            k = k + 1
        }
        if info.kind == MirRvalueKind.Use && info.count == 1 {
            let o = self.lists[info.first]
            if self.operands[o].ty != info.ty {
                self.problem(f, &var out, "a use changes its operand's type")
            }
        }
    }

    // A take capture's entry: a whole local and a take flag, typed
    // `(&var T, &var Bool)`.
    func verify_take(&self, f: Int, info: &MirRvalue, out: &var Vector<String>) {
        self.verify_place(f, info.place, &var out)
        self.verify_place(f, info.flag, &var out)
        if info.place < 0 || info.flag < 0 || info.place >= self.places.len() || info.flag >= self.places.len() {
            return
        }
        let taken = self.places[info.place]
        let flag = self.places[info.flag]
        if taken.count != 0 || taken.local < 0 {
            self.problem(f, &var out, "a take names no whole local")
        }
        if flag.count != 0 || flag.local < 0 || mir_func_local(&self, f, flag.local).kind != MirLocalKind.Flag {
            self.problem(f, &var out, "a take's flag is no take flag")
        }
        if not self.tc.is_bool(flag.ty) {
            self.problem(f, &var out, "a take's flag is no `Bool`")
        }
        var typed = self.tc.kind_of(info.ty) == TcKind.Tuple && self.tc.types.ty(info.ty).count == 2
        if typed {
            let value_slot = self.tc.types.arg(info.ty, 0)
            let flag_slot = self.tc.types.arg(info.ty, 1)
            typed = self.tc.is_exclusive_ref(value_slot) && self.tc.referent(value_slot) == taken.ty
            typed = typed && self.tc.is_exclusive_ref(flag_slot) && self.tc.referent(flag_slot) == flag.ty
        }
        if not typed {
            self.problem(f, &var out, "a take is not typed as references to its local and its flag")
        }
    }

    // A call's target, instantiation, arguments and suspension point.
    func verify_call(&var self, f: Int, at: Int, out: &var Vector<String>) {
        if at < 0 || at >= self.calls.len() {
            self.problem(f, &var out, "a call terminator names no call")
            return
        }
        let c = self.calls[at]
        if c.next >= 0 {
            self.verify_edge(f, c.next, &var out)
        }
        if c.absent >= 0 {
            self.verify_edge(f, c.absent, &var out)
        }
        if c.dest >= 0 {
            self.verify_place(f, c.dest, &var out)
        }
        var k = 0
        while k < c.arg_count {
            let o = self.lists[c.arg_first + k]
            self.verify_operand(f, o, &var out)
            k = k + 1
        }
        let info = self.funcs[f]
        match c.kind {
            case Builtin -> {
                if c.spelling < 0 {
                    self.problem(f, &var out, "a builtin call names no builtin")
                }
            },
            case Value -> {
                if c.callee < 0 {
                    self.problem(f, &var out, "a function value's call names no value")
                } else {
                    self.verify_operand(f, c.callee, &var out)
                }
            },
            case Lend -> {},
            case _ -> {
                if c.target < 0 {
                    self.problem(f, &var out, "a call names no target")
                    return
                }
                let s = self.tc.sigs[c.target]
                if c.inst_count != s.generic_count {
                    self.problem(f, &var out, "a call's instantiation is incomplete")
                }
                if c.window >= 0 && c.window >= info.window_count {
                    self.problem(f, &var out, "a window call names no window")
                }
                if (c.kind == MirCallKind.WindowOpen || c.kind == MirCallKind.WindowClose) && c.window < 0 {
                    self.problem(f, &var out, "a window call names no window")
                }
                if c.kind == MirCallKind.WindowOpen || c.kind == MirCallKind.WindowClose {
                    self.verify_window_call(f, &c, &var out)
                }
            }
        }
        self.verify_arguments(f, &c, &var out)
        self.verify_suspension(f, &c, &var out)
        self.verify_spawn(f, &c, &var out)
        self.verify_drive(f, &c, &var out)
    }

    // A drive site names its form, returns, and leaves what its form gives:
    // the root's result for `__saw_drive`, an `Int` for `__saw_drive_steps`.
    // Only a drive site carries a form.
    func verify_drive(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        if c.kind != MirCallKind.Drive {
            if c.drive != MirDriveForm.Absent {
                self.problem(f, &var out, "a call that is no drive site carries a drive form")
            }
            return
        }
        if c.drive == MirDriveForm.Absent {
            self.problem(f, &var out, "a drive site carries no form")
        }
        if c.target < 0 {
            return
        }
        let s = self.tc.sigs[c.target]
        let body = if s.result < 0 { -1 } else { self.call_type(s.result, &c) }
        if c.next < 0 {
            if body < 0 || not self.tc.is_never(body) || c.drive == MirDriveForm.Steps {
                self.problem(f, &var out, "a drive site does not return")
            }
            return
        }
        var want = body
        if c.drive == MirDriveForm.Steps {
            want = self.tc.int_type()
        }
        if c.dest < 0 {
            if want >= 0 && not self.tc.is_void(want) {
                self.problem(f, &var out, "a drive site leaves nothing of a root that gives a value")
            }
            return
        }
        let have = self.places[c.dest].ty
        if want < 0 || have != want {
            var text = StringBuilder()
            try! text.append("a drive site leaves a `")
            try! text.append(self.tc.type_text(have))
            try! text.append("` where its form gives `")
            try! text.append(if want < 0 { "Void" } else { self.tc.type_text(want) })
            try! text.append("`")
            self.problem(f, &var out, text.build())
        }
    }

    // A spawn site names its form and a free function as its root, returns,
    // and leaves the handle its form gives for the root's result: `Task<T>`,
    // `Task<Void>` for a `Void` root. A group site passes a shared reference
    // to a `TaskGroup` first. Only a spawn site carries a form, but for the
    // `Thread` form, which only the `Thread.spawn` builtin carries.
    func verify_spawn(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        let thread_form = c.spawn == MirSpawnForm.Thread
        let thread_builtin = c.kind == MirCallKind.Builtin && c.spelling >= 0 && self.tc.name_text(c.spelling).equals("Thread.spawn")
        if thread_form != thread_builtin {
            self.problem(f, &var out, "a `Thread.spawn` call and the `Thread` spawn form do not go together")
            return
        }
        if c.kind != MirCallKind.Spawn {
            if c.spawn != MirSpawnForm.Absent && not thread_form {
                self.problem(f, &var out, "a call that is no spawn site carries a spawn form")
            }
            return
        }
        if c.spawn == MirSpawnForm.Absent {
            self.problem(f, &var out, "a spawn site carries no form")
        }
        if c.spawn == MirSpawnForm.Group {
            var grouped = false
            if c.arg_count > 0 {
                let have = self.operands[self.lists[c.arg_first]].ty
                let group = self.tc.strip_refs(have)
                let d = self.tc.nominal_decl(group)
                grouped = d >= 0 && d == self.tc.known.task_group && have == self.tc.mk_ref(false, group)
            }
            if not grouped {
                self.problem(f, &var out, "a group spawn site does not pass a shared reference to its `TaskGroup` first")
            }
        }
        if c.target < 0 {
            return
        }
        let s = self.tc.sigs[c.target]
        if s.receiver != TcReceiver.Absent {
            self.problem(f, &var out, "a spawn site's root is a method")
        }
        if c.next < 0 || c.dest < 0 {
            self.problem(f, &var out, "a spawn site does not return its handle")
            return
        }
        let body = if s.result < 0 { -1 } else { self.call_type(s.result, &c) }
        let have = self.places[c.dest].ty
        let d = self.tc.nominal_decl(have)
        var typed = d >= 0 && d == self.tc.known.task && self.tc.types.ty(have).count == 1
        if typed {
            let arg = self.tc.types.arg(have, 0)
            if body < 0 || self.tc.is_void(body) {
                typed = self.tc.is_void(arg)
            } else {
                typed = arg == body
            }
        }
        if not typed {
            var text = StringBuilder()
            try! text.append("a spawn site's handle is a `")
            try! text.append(self.tc.type_text(have))
            try! text.append("` for a root of type `")
            try! text.append(if body < 0 { "Void" } else { self.tc.type_text(body) })
            try! text.append("`")
            self.problem(f, &var out, text.build())
        }
    }

    // Type `t`, over call `c`'s target's own type parameters and its owner's,
    // at the instantiation and owner the call carries.
    func call_type(&var self, t: Int, c: &MirCall) -> Int {
        var args = Vector<Int>()
        var k = 0
        while k < c.inst_count {
            try! args.push(self.types[c.inst_first + k])
            k = k + 1
        }
        let own = TcSubst(owner: c.target, args: move args)
        let first = self.tc.subst(t, &own)
        if c.owner < 0 {
            return first
        }
        self.tc.impl_subst(first, c.target, c.owner)
    }

    // Each argument has the type its target takes, at the call's own
    // instantiation, so synthesized calls are checked as written ones are: a
    // declaration's (a function, a window's prologue) its receiver, by
    // reference in the mode the call takes it or by value for `consumes`,
    // then each parameter, a C variadic tail past them unchecked since no
    // declaration types it; a function value's its type's parameters; a
    // `lend` the reference its accessor lends; a default's result its
    // parameter's type. A builtin declares no signature, so its operands
    // are checked only as operands.
    func verify_arguments(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        match c.kind {
            case Function -> self.verify_declared_arguments(f, &c, false, &var out),
            case Spawn -> self.verify_declared_arguments(f, &c, false, &var out),
            case Drive -> self.verify_declared_arguments(f, &c, false, &var out),
            case WindowOpen -> {
                let info = self.funcs[f]
                let exclusive = c.window >= 0 && self.windows[info.window_first + c.window].exclusive
                self.verify_declared_arguments(f, &c, exclusive, &var out)
            },
            case Value -> self.verify_value_arguments(f, &c, &var out),
            case Default -> {
                let s = self.tc.sigs[c.target]
                if c.param < 0 || c.param >= s.param_count || c.dest < 0 {
                    self.problem(f, &var out, "a default's call names no parameter or no destination")
                    return
                }
                let param = self.tc.params[s.param_first + c.param]
                let want = self.call_type(param.ty, &c)
                let have = self.places[c.dest].ty
                self.compare_argument(f, &c, want, have, &var out)
            },
            case Lend -> self.verify_lend_argument(f, &c, &var out),
            case _ -> {}
        }
    }

    // A declaration's call: `window_exclusive` the mode a window's prologue
    // takes its receiver in, which its use site picks (SL:borrowing §1).
    func verify_declared_arguments(&var self, f: Int, c: &MirCall, window_exclusive: Bool,
                                   out: &var Vector<String>) {
        let s = self.tc.sigs[c.target]
        let decl = self.tc.res.decls[c.target]
        var at = 0
        // A window's open passes its record first, which `verify_window_call`
        // checks.
        let info = self.funcs[f]
        if c.kind == MirCallKind.WindowOpen && c.window >= 0 && c.window < info.window_count {
            if self.windows[info.window_first + c.window].record >= 0 {
                at = 1
            }
        }
        // A group spawn site passes its group first, which `verify_spawn`
        // checks.
        at = at + mir_spawn_leading(&c)
        if s.receiver != TcReceiver.Absent {
            if c.arg_count <= at {
                self.problem(f, &var out, "a method's call passes no receiver")
                return
            }
            let o = self.lists[c.arg_first + at]
            let have = self.operands[o].ty
            let consumes = (s.effects & TC_EFFECT_CONSUMES) != 0
            if c.owner < 0 {
                self.problem(f, &var out, "a method's call names no owner type for its receiver")
            } else if consumes {
                let recv = self.tc.strip_refs(c.owner)
                self.compare_argument(f, &c, recv, have, &var out)
            } else {
                var exclusive = s.receiver == TcReceiver.Exclusive
                if c.kind == MirCallKind.WindowOpen {
                    exclusive = window_exclusive
                }
                let recv = self.tc.strip_refs(c.owner)
                let want = self.tc.mk_ref(exclusive, recv)
                self.compare_argument(f, &c, want, have, &var out)
            }
            at = at + 1
        }
        if c.arg_count < at + s.param_count {
            self.problem(f, &var out, "a call passes fewer arguments than its target has parameters")
            return
        }
        if c.arg_count > at + s.param_count && decl.kind != ResDeclKind.Extern {
            self.problem(f, &var out, "a call passes more arguments than its target has parameters")
        }
        var k = 0
        while k < s.param_count {
            let param = self.tc.params[s.param_first + k]
            let want = self.call_type(param.ty, &c)
            let o = self.lists[c.arg_first + at + k]
            let have = self.operands[o].ty
            self.compare_argument(f, &c, want, have, &var out)
            k = k + 1
        }
    }

    // A function value's call: each argument its type's parameter.
    func verify_value_arguments(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        if c.callee < 0 {
            return
        }
        var ft = self.operands[c.callee].ty
        if self.tc.kind_of(ft) == TcKind.Ref {
            ft = self.tc.referent(ft)
        }
        if self.tc.kind_of(ft) != TcKind.Func {
            self.problem(f, &var out, "a function value's call calls a value of no function type")
            return
        }
        let info = self.tc.types.ty(ft)
        if c.arg_count != info.count {
            self.problem(f, &var out, "a function value's call passes another number of arguments than its type takes")
            return
        }
        var k = 0
        while k < info.count {
            let want = self.tc.types.arg(ft, k)
            let o = self.lists[c.arg_first + k]
            let have = self.operands[o].ty
            self.compare_argument(f, &c, want, have, &var out)
            k = k + 1
        }
    }

    // A `lend`: a reference to the place its accessor declares it lends.
    func verify_lend_argument(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        let d = self.funcs[f].decl
        if d < 0 || c.arg_count != 1 {
            self.problem(f, &var out, "a `lend` outside an accessor, or lending no one reference")
            return
        }
        let s = self.tc.sigs[d]
        var lent = s.result
        if self.tc.kind_of(lent) == TcKind.Ref {
            lent = self.tc.referent(lent)
        }
        if s.lending == TcLend.ConditionalPlace {
            lent = self.tc.arg_of(lent, 0)
        }
        let o = self.lists[c.arg_first]
        let have = self.operands[o].ty
        if self.tc.kind_of(have) != TcKind.Ref || self.tc.referent(have) != lent {
            var text = StringBuilder()
            try! text.append("a `lend` passes a `")
            try! text.append(self.tc.type_text(have))
            try! text.append("` where its accessor lends `")
            try! text.append(self.tc.type_text(lent))
            try! text.append("`")
            self.problem(f, &var out, text.build())
        }
    }

    func compare_argument(&var self, f: Int, c: &MirCall, want: Int, have: Int, out: &var Vector<String>) {
        if want == have || self.tc.has_error(want) {
            return
        }
        var text = StringBuilder()
        try! text.append("an argument of `")
        if c.target >= 0 {
            try! text.append(self.tc.res.decl_path(c.target))
        } else {
            try! text.append("a function value")
        }
        try! text.append("` is a `")
        try! text.append(self.tc.type_text(have))
        try! text.append("` where its parameter takes `")
        try! text.append(self.tc.type_text(want))
        try! text.append("`, a conversion left implicit")
        self.problem(f, &var out, text.build())
    }

    // A call is a suspension point exactly when typecheck's summaries,
    // evaluated at its source node, say it may suspend, and a conditional
    // one carries the conditions they leave.
    func verify_suspension(&var self, f: Int, c: &MirCall, out: &var Vector<String>) {
        if c.node < 0 || self.tc.call_at[c.node] < 0 {
            if c.suspend != MirSuspend.Never {
                self.problem(f, &var out, "a call no summary answers is marked a suspension point")
            }
            return
        }
        let owner = self.funcs[f].owner
        var acc = TcAcc(owner: owner, unit: -1)
        let node = c.node
        self.call_effect(node, &c, &var acc)
        var want = MirSuspend.Never
        let threaded = self.thread_context(f)
        if self.thread_plain_call(threaded, &acc) {
            want = MirSuspend.Never
        } else if acc.suspends {
            want = MirSuspend.Always
        } else if acc.suspend_atoms.len() > 0 {
            want = MirSuspend.When
        }
        // A window call runs one half, a suspension point only when that half
        // may suspend (SL:architecture §3.5).
        let window = c.kind == MirCallKind.WindowOpen || c.kind == MirCallKind.WindowClose
        if window && c.half >= 0 && not self.function_suspends(c.half) {
            want = MirSuspend.Never
        }
        if c.kind == MirCallKind.WindowClose && self.closes_nothing(c.target) {
            want = MirSuspend.Never
        }
        if want != c.suspend {
            self.problem(f, &var out, "a call's suspension point disagrees with its callee's summary")
            return
        }
        if want == MirSuspend.When && c.cond_count == 0 {
            self.problem(f, &var out, "a conditional suspension point carries no condition")
        }
    }

    // The flow checks: the move-path invariants, each a question the
    // initialisation analysis (initialisation.saw) answers, and which windows
    // are open.
    // A `consumes` body that moves a field on some paths only, or replaces
    // `self` after a field may have left, is a user's error borrowck reports,
    // so its move paths are not checked here.
    func verify_flow(&var self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        let facts = self.init_analysis(f)
        let partial = self.init_consumes_partial(f, &facts)
        let replaced = self.init_consumes_replacements(f, &facts)
        let moves = partial.len() == 0 && replaced.len() == 0
        let open = self.window_entries(f)
        var b = 0
        while b < info.block_count {
            if facts.reached[b] {
                var state = facts.entry_state(b)
                var windows = Vector<Bool>()
                var k = 0
                while k < info.window_count {
                    try! windows.push(open[b * info.window_count + k])
                    k = k + 1
                }
                let block = self.blocks[info.block_first + b]
                var s = block.first
                while s >= 0 {
                    let accesses = self.init_stmt_accesses(f, s, &facts)
                    self.check_accesses(f, b, &facts, &var state, &accesses, moves, &var out)
                    s = self.stmts[s].next
                }
                let accesses = self.init_term_accesses(f, b, &facts)
                self.check_accesses(f, b, &facts, &var state, &accesses, moves, &var out)
                if block.term == MirTermKind.Return {
                    self.check_return(f, b, &facts, &state, &windows, moves, &var out)
                }
                if block.term == MirTermKind.Call {
                    let c = self.calls[block.call]
                    if c.kind == MirCallKind.WindowOpen && c.window >= 0 && windows[c.window] {
                        self.problem(f, &var out, "a window opens again while it may still be open")
                    }
                }
            }
            b = b + 1
        }
    }

    // A `return`: no owned local may still be live, assigned or moved whole
    // and not dropped, and no window open, except what a prologue's `lend`
    // hands its epilogue.
    func check_return(&self, f: Int, b: Int, facts: &MirInit, state: &Vector<Int>, windows: &Vector<Bool>,
                      moves: Bool, out: &var Vector<String>) {
        let info = self.funcs[f]
        var k = 0
        while k < info.local_count && moves {
            let l = mir_func_local(&self, f, k)
            let live = (state[k] & (MIR_INIT_WHOLE | MIR_INIT_MOVED)) != 0
            if l.owned && live && not self.carried_at_lend(f, k) {
                var text = StringBuilder()
                try! text.append("owned local _")
                try! text.append(k)
                try! text.append(" may still be live at a `return` in bb")
                try! text.append(b)
                try! text.append(": a scope exit does not drop it")
                self.problem(f, &var out, text.build())
            }
            k = k + 1
        }
        k = 0
        while k < info.window_count {
            if windows[k] && not self.carried_at_lend(f, info.local_count + k) {
                var text = StringBuilder()
                try! text.append("window w")
                try! text.append(k)
                try! text.append(" may still be open at a `return` in bb")
                try! text.append(b)
                try! text.append(": a path out of its body does not close it")
                self.problem(f, &var out, text.build())
            }
            k = k + 1
        }
    }

    // Each of `accesses` checked against `state`, then applied to it: a use,
    // a part's write included, of a local some path dropped with nothing
    // assigned since; a drop of a path some path dropped already, or whose
    // part some path moved out; an assignment to a whole owned local that
    // may still be live, so the scope exit before it does not drop it.
    func check_accesses(&self, f: Int, b: Int, facts: &MirInit, state: &var Vector<Int>,
                        accesses: &Vector<MirAccess>, moves: Bool, out: &var Vector<String>) {
        var k = 0
        while k < accesses.len() {
            let a = accesses[k]
            k = k + 1
            if moves && a.path >= 0 {
                self.check_access(f, b, &facts, &state, &a, &var out)
            }
            facts.apply(&var state, &a)
        }
    }

    func check_access(&self, f: Int, b: Int, facts: &MirInit, state: &Vector<Int>, a: &MirAccess,
                      out: &var Vector<String>) {
        let local = facts.path_local[a.path]
        let whole = a.path == local
        if a.kind == MirAccessKind.Drop && not a.cut {
            let own = state[a.path]
            if (own & MIR_INIT_PARTIAL) != 0 {
                var text = StringBuilder()
                try! text.append(self.path_noun(&facts, a.path))
                try! text.append(" is dropped whole after a part of it moved out: a destructure does not dissolve it")
                self.problem(f, &var out, text.build())
            }
            if (own & MIR_INIT_DROPPED) != 0 {
                var text = StringBuilder()
                try! text.append(self.path_noun(&facts, a.path))
                try! text.append(" may be dropped twice in bb")
                try! text.append(b)
                try! text.append(": a path drops it before, and nothing assigns it between")
                self.problem(f, &var out, text.build())
            }
            return
        }
        if a.kind == MirAccessKind.Write && whole && not a.cut {
            let l = mir_func_local(&self, f, local)
            let live = (state[local] & (MIR_INIT_WHOLE | MIR_INIT_MOVED)) != 0
            if a.stmt >= 0 && l.owned && live {
                var text = StringBuilder()
                try! text.append("owned local _")
                try! text.append(local)
                try! text.append(" is assigned while it may still be live: a scope exit before it does not drop it")
                self.problem(f, &var out, text.build())
            }
            return
        }
        if (state[local] & MIR_INIT_DROPPED) != 0 {
            var text = StringBuilder()
            try! text.append("local _")
            try! text.append(local)
            try! text.append(" may be used in bb")
            try! text.append(b)
            try! text.append(" after a path dropped it, and nothing assigns it between")
            self.problem(f, &var out, text.build())
        }
    }

    // `local _K` for a local's own path, `place P` for a path inside one.
    func path_noun(&self, facts: &MirInit, q: Int) -> String {
        var text = StringBuilder()
        if facts.path_parent[q] < 0 {
            try! text.append("local ")
        } else {
            try! text.append("place ")
        }
        try! text.append(self.init_path_text(&facts, q))
        text.build()
    }

    // Each window's openness at each block's entry, `block * window_count +
    // window`: a may-dataflow over the edges `window_open_after` describes.
    // An epilogue resumes with the windows its prologue left open.
    func window_entries(&self, f: Int) -> Vector<Bool> {
        let info = self.funcs[f]
        let width = info.window_count
        var entry = Vector<Bool>()
        var reached = Vector<Bool>()
        var k = 0
        while k < info.block_count * width {
            try! entry.push(false)
            k = k + 1
        }
        k = 0
        while k < info.block_count {
            try! reached.push(k == 0)
            k = k + 1
        }
        if info.kind == MirFuncKind.Epilogue && width > 0 {
            k = 0
            while k < info.carried_count {
                // An index out of range is verify_carried's report.
                let w = self.aux[info.carried_first + k]
                if w >= 0 && w < width {
                    entry[w] = true
                }
                k = k + 1
            }
        }
        // A worklist swept in reverse postorder, to the fixpoint: a block is
        // walked again only when its entry grew.
        let order = self.verify_order(f)
        var pending = Vector<Bool>()
        k = 0
        while k < info.block_count {
            try! pending.push(k == 0)
            k = k + 1
        }
        var left = if info.block_count > 0 { 1 } else { 0 }
        while left > 0 {
            var i = 0
            while i < order.len() {
                let b = order[i]
                i = i + 1
                if not pending[b] {
                    continue
                }
                pending[b] = false
                left = left - 1
                var state = Vector<Bool>()
                k = 0
                while k < width {
                    try! state.push(entry[b * width + k])
                    k = k + 1
                }
                let block = self.blocks[info.block_first + b]
                var succ = Vector<Int>()
                var opened = -1
                self.successors(f, &block, &var succ, &var opened)
                let switched = self.switched_local(f, b)
                var j = 0
                while j < succ.len() {
                    let target = succ[j]
                    var next = Vector<Bool>()
                    k = 0
                    while k < width {
                        try! next.push(self.window_open_after(f, b, target, k, state[k], switched))
                        k = k + 1
                    }
                    var grew = false
                    if not reached[target] {
                        reached[target] = true
                        grew = true
                    }
                    k = 0
                    while k < width {
                        if next[k] && not entry[target * width + k] {
                            entry[target * width + k] = true
                            grew = true
                        }
                        k = k + 1
                    }
                    if grew && not pending[target] {
                        pending[target] = true
                        left = left + 1
                    }
                    j = j + 1
                }
            }
        }
        move entry
    }

    // Function `f`'s blocks in reverse postorder from the entry, then those
    // the entry does not reach, in index order: the order the verifier's
    // forward dataflows sweep, so a join is met after its arms (the lowering
    // numbers a join below them).
    func verify_order(&self, f: Int) -> Vector<Int> {
        let info = self.funcs[f]
        let count = info.block_count
        var post = Vector<Int>()
        var seen = Vector<Bool>()
        var stack = Vector<Int>()
        var cursor = Vector<Int>()
        var k = 0
        while k < count {
            try! seen.push(false)
            try! stack.push(0)
            try! cursor.push(0)
            k = k + 1
        }
        var depth = 0
        if count > 0 {
            seen[0] = true
            depth = 1
        }
        while depth > 0 {
            let b = stack[depth - 1]
            let block = self.blocks[info.block_first + b]
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            let i = cursor[depth - 1]
            if i < succ.len() {
                cursor[depth - 1] = i + 1
                let s = succ[i]
                if not seen[s] {
                    seen[s] = true
                    stack[depth] = s
                    cursor[depth] = 0
                    depth = depth + 1
                }
            } else {
                try! post.push(b)
                depth = depth - 1
            }
        }
        var out = Vector<Int>()
        k = post.len() - 1
        while k >= 0 {
            try! out.push(post[k])
            k = k - 1
        }
        k = 0
        while k < count {
            if not seen[k] {
                try! out.push(k)
            }
            k = k + 1
        }
        move out
    }

    func successors(&self, f: Int, block: &MirBlock, succ: &var Vector<Int>, opened: &var Int) {
        if block.term == MirTermKind.Goto {
            try! succ.push(block.target)
        } else if block.term == MirTermKind.Switch {
            var k = 0
            while k < block.arm_count {
                try! succ.push(self.arms[block.arm_first + k].target)
                k = k + 1
            }
            if block.otherwise >= 0 {
                try! succ.push(block.otherwise)
            }
        } else if block.term == MirTermKind.Call {
            let c = self.calls[block.call]
            if c.next >= 0 {
                try! succ.push(c.next)
            }
            if c.absent >= 0 {
                try! succ.push(c.absent)
            }
            if c.kind == MirCallKind.WindowOpen {
                opened = c.window
            }
        }
    }

    // Every cycle the entry reaches passes an op-budget point: with each block
    // holding one taken out, the blocks the entry reaches form no cycle. A
    // loop's point opens its body, so a `continue` and the backedge both
    // reach it through the head.
    func verify_budget_cycles(&self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        if info.block_count == 0 {
            return
        }
        var reached = Vector<Bool>()
        var charged = Vector<Bool>()
        var state = Vector<Int>()
        var stack = Vector<Int>()
        var cursor = Vector<Int>()
        var k = 0
        while k < info.block_count {
            let block = self.blocks[info.block_first + k]
            try! reached.push(false)
            try! charged.push(self.holds_budget(&block))
            try! state.push(0)
            try! stack.push(0)
            try! cursor.push(0)
            k = k + 1
        }
        var work = Vector<Int>()
        try! work.push(0)
        reached[0] = true
        var at = 0
        while at < work.len() {
            let b = work[at]
            at = at + 1
            let block = self.blocks[info.block_first + b]
            var succ = Vector<Int>()
            var opened = -1
            self.successors(f, &block, &var succ, &var opened)
            var j = 0
            while j < succ.len() {
                let t = succ[j]
                j = j + 1
                if not reached[t] {
                    reached[t] = true
                    try! work.push(t)
                }
            }
        }
        var root = 0
        while root < info.block_count {
            let r = root
            root = root + 1
            if not reached[r] || charged[r] || state[r] != 0 {
                continue
            }
            var depth = 1
            stack[0] = r
            cursor[0] = 0
            state[r] = 1
            while depth > 0 {
                let top = depth - 1
                let b = stack[top]
                let block = self.blocks[info.block_first + b]
                var succ = Vector<Int>()
                var opened = -1
                self.successors(f, &block, &var succ, &var opened)
                let i = cursor[top]
                if i >= succ.len() {
                    state[b] = 2
                    depth = top
                    continue
                }
                cursor[top] = i + 1
                let target = succ[i]
                if charged[target] {
                    continue
                }
                if state[target] == 1 {
                    var text = StringBuilder()
                    try! text.append("the cycle through bb")
                    try! text.append(b)
                    try! text.append(" -> bb")
                    try! text.append(target)
                    try! text.append(" passes no op-budget point")
                    self.problem(f, &var out, text.build())
                } else if state[target] == 0 {
                    state[target] = 1
                    stack[depth] = target
                    cursor[depth] = 0
                    depth = depth + 1
                }
            }
        }
    }

    // Whether `block` holds an op-budget point.
    func holds_budget(&self, block: &MirBlock) -> Bool {
        var s = block.first
        while s >= 0 {
            let stmt = self.stmts[s]
            if stmt.kind == MirStmtKind.Budget {
                return true
            }
            s = stmt.next
        }
        false
    }
}

// Proven payloads. A `(P as CASE)` projection reads CASE's payload with no
// check of its own, so it is sound only where the case is proven; a checked
// `(P as CASE!)` panics on any other case and needs no proof.
extension MirProgram {
    // Every proven payload function `f` uses, read, written, borrowed or
    // dropped, stands where every path from the entry has switched on `P`'s
    // discriminant to CASE, with nothing writing `P` or a place it lies in
    // since. A `match`, `if let` or `while let` holds what its pattern left
    // over as such places until its body completes (spec, Match consumes an
    // owned enum), so this is the check that a construct's leftovers drop only
    // on the paths of the case that left them, and never once the scrutinee's
    // storage holds a new value. A must-dataflow over the (switched place,
    // case) facts the function's switches prove; the entry knows none, an
    // epilogue's entry included.
    func verify_payloads(&self, f: Int, out: &var Vector<String>) {
        let info = self.funcs[f]
        let n = info.block_count
        var fact_place = Vector<Int>()
        var fact_case = Vector<Int>()
        var b = 0
        while b < n {
            let block = self.blocks[info.block_first + b]
            if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Discriminant {
                var k = 0
                while k < block.arm_count {
                    let c = self.arms[block.arm_first + k].value
                    if self.fact_index(&fact_place, &fact_case, block.place, c) < 0 {
                        try! fact_place.push(block.place)
                        try! fact_case.push(c)
                    }
                    k = k + 1
                }
            }
            b = b + 1
        }
        let width = fact_place.len()
        var entry = Vector<Bool>()
        var reached = Vector<Bool>()
        b = 0
        while b < n {
            try! reached.push(b == 0)
            var k = 0
            while k < width {
                try! entry.push(b != 0)
                k = k + 1
            }
            b = b + 1
        }
        var quiet = Vector<String>()
        // A worklist swept in reverse postorder, to the fixpoint: a block is
        // walked again only when its entry shrank.
        let order = self.verify_order(f)
        var pending = Vector<Bool>()
        b = 0
        while b < n {
            try! pending.push(b == 0)
            b = b + 1
        }
        var left = if n > 0 { 1 } else { 0 }
        while left > 0 {
            var i = 0
            while i < order.len() {
                b = order[i]
                i = i + 1
                if not pending[b] {
                    continue
                }
                pending[b] = false
                left = left - 1
                var state = Vector<Bool>()
                var k = 0
                while k < width {
                    try! state.push(entry[b * width + k])
                    k = k + 1
                }
                self.payload_block(f, b, &fact_place, &fact_case, &var state, false, &var quiet)
                let block = self.blocks[info.block_first + b]
                var succ = Vector<Int>()
                var opened = -1
                self.successors(f, &block, &var succ, &var opened)
                var j = 0
                while j < succ.len() {
                    let target = succ[j]
                    var next = Vector<Bool>()
                    k = 0
                    while k < width {
                        try! next.push(state[k])
                        k = k + 1
                    }
                    if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Discriminant && j < block.arm_count {
                        let c = self.arms[block.arm_first + j].value
                        let at = self.fact_index(&fact_place, &fact_case, block.place, c)
                        next[at] = true
                    }
                    var shrank = false
                    if not reached[target] {
                        reached[target] = true
                        shrank = true
                        k = 0
                        while k < width {
                            entry[target * width + k] = next[k]
                            k = k + 1
                        }
                    } else {
                        k = 0
                        while k < width {
                            if entry[target * width + k] && not next[k] {
                                entry[target * width + k] = false
                                shrank = true
                            }
                            k = k + 1
                        }
                    }
                    if shrank && not pending[target] {
                        pending[target] = true
                        left = left + 1
                    }
                    j = j + 1
                }
            }
        }
        b = 0
        while b < n {
            if reached[b] {
                var state = Vector<Bool>()
                var k = 0
                while k < width {
                    try! state.push(entry[b * width + k])
                    k = k + 1
                }
                self.payload_block(f, b, &fact_place, &fact_case, &var state, true, &var out)
            }
            b = b + 1
        }
    }

    // Block `b`'s statements and terminator over `state`: each place used
    // checked against it when `report`, then each write applied, a call's
    // destination last, since it is written on the return edge.
    func payload_block(&self, f: Int, b: Int, fact_place: &Vector<Int>, fact_case: &Vector<Int>,
                       state: &var Vector<Bool>, report: Bool, out: &var Vector<String>) {
        let info = self.funcs[f]
        let block = self.blocks[info.block_first + b]
        var s = block.first
        while s >= 0 {
            let stmt = self.stmts[s]
            s = stmt.next
            if stmt.kind == MirStmtKind.Budget {
                continue
            }
            var used = Vector<Int>()
            try! used.push(stmt.place)
            if stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                let rv = self.rvalues[stmt.rvalue]
                try! used.push(rv.place)
                try! used.push(rv.flag)
                var k = 0
                while k < rv.count {
                    // Stage 0 workaround (SL:hazards S4): canonical: self.push_operand_place(&var used, self.lists[rv.first + k])
                    let o = self.lists[rv.first + k]
                    self.push_operand_place(&var used, o)
                    k = k + 1
                }
            }
            if report {
                self.check_payloads(f, b, &fact_place, &fact_case, &state, &used, &var out)
            }
            self.kill_facts(&fact_place, &var state, stmt.place)
            if stmt.kind == MirStmtKind.Assign && stmt.rvalue >= 0 {
                let rv = self.rvalues[stmt.rvalue]
                if rv.kind == MirRvalueKind.Ref && rv.exclusive {
                    self.kill_facts(&fact_place, &var state, rv.place)
                }
            }
        }
        var used = Vector<Int>()
        if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Discriminant {
            try! used.push(block.place)
        } else if block.term == MirTermKind.Switch {
            self.push_operand_place(&var used, block.operand)
        } else if block.term == MirTermKind.Call && block.call >= 0 {
            let c = self.calls[block.call]
            self.push_operand_place(&var used, c.callee)
            var k = 0
            while k < c.arg_count {
                // Stage 0 workaround (SL:hazards S4): canonical: self.push_operand_place(&var used, self.lists[c.arg_first + k])
                let o = self.lists[c.arg_first + k]
                self.push_operand_place(&var used, o)
                k = k + 1
            }
            try! used.push(c.dest)
        }
        if report {
            self.check_payloads(f, b, &fact_place, &fact_case, &state, &used, &var out)
        }
        if block.term == MirTermKind.Call && block.call >= 0 {
            // Stage 0 workaround (SL:hazards S4): canonical: self.kill_facts(&fact_place, &var state, self.calls[block.call].dest)
            let dest = self.calls[block.call].dest
            self.kill_facts(&fact_place, &var state, dest)
        }
    }

    func push_operand_place(&self, used: &var Vector<Int>, o: Int) {
        if o >= 0 && self.operands[o].kind != MirOperandKind.Const {
            try! used.push(self.operands[o].place)
        }
    }

    // Each proven payload step of the places in `used` against `state`.
    func check_payloads(&self, f: Int, b: Int, fact_place: &Vector<Int>, fact_case: &Vector<Int>,
                        state: &Vector<Bool>, used: &Vector<Int>, out: &var Vector<String>) {
        var u = 0
        while u < used.len() {
            let p = used[u]
            u = u + 1
            if p < 0 {
                continue
            }
            let info = self.places[p]
            var k = 0
            while k < info.count {
                let step = self.projs[info.first + k]
                if step.kind == MirProjKind.Payload {
                    var proven = false
                    var i = 0
                    while i < fact_place.len() && not proven {
                        if fact_case[i] == step.decl && state[i] && self.prefix_is(p, k, fact_place[i]) {
                            proven = true
                        }
                        i = i + 1
                    }
                    if not proven {
                        var text = StringBuilder()
                        try! text.append("bb")
                        try! text.append(b)
                        try! text.append(" uses ")
                        self.append_place(&var text, p)
                        try! text.append(" where some path has not switched its scrutinee to `")
                        try! text.append(self.decl_name(step.decl))
                        try! text.append("`, or has written the scrutinee since")
                        self.problem(f, &var out, text.build())
                    }
                }
                k = k + 1
            }
        }
    }

    // Clears every fact whose switched place written place `w` is, or holds.
    func kill_facts(&self, fact_place: &Vector<Int>, state: &var Vector<Bool>, w: Int) {
        if w < 0 {
            return
        }
        let count = self.places[w].count
        var i = 0
        while i < fact_place.len() {
            if self.places[fact_place[i]].count >= count && self.prefix_is(fact_place[i], count, w) {
                state[i] = false
            }
            i = i + 1
        }
    }

    // The fact (place `p`, case `c`)'s index, places compared by structure.
    func fact_index(&self, fact_place: &Vector<Int>, fact_case: &Vector<Int>, p: Int, c: Int) -> Int {
        let count = self.places[p].count
        var i = 0
        while i < fact_place.len() {
            if fact_case[i] == c && self.places[fact_place[i]].count == count && self.prefix_is(p, count, fact_place[i]) {
                return i
            }
            i = i + 1
        }
        return -1
    }

    // Whether place `p` cut to its first `count` projections is place `q`:
    // the same root and the same steps, a proven payload and a checked one
    // counting as one.
    func prefix_is(&self, p: Int, count: Int, q: Int) -> Bool {
        let a = self.places[p]
        let c = self.places[q]
        if c.count != count || a.count < count || a.local != c.local || a.static_decl != c.static_decl {
            return false
        }
        var k = 0
        while k < count {
            let x = self.projs[a.first + k]
            let y = self.projs[c.first + k]
            let x_payload = x.kind == MirProjKind.Payload || x.kind == MirProjKind.Force
            let y_payload = y.kind == MirProjKind.Payload || y.kind == MirProjKind.Force
            let same_kind = x.kind == y.kind || (x_payload && y_payload)
            if not same_kind || x.decl != y.decl || x.index != y.index {
                return false
            }
            k = k + 1
        }
        true
    }
}
