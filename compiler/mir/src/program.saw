// The program under MIR lowering: typecheck's program, unchanged, and the
// MIR's arenas, with the state the builder keeps while one function is
// lowered. One value holds it all, so each phase is a set of methods on it.

import sawmir.model.{MirAccessor, MirArm, MirBlock, MirCall, MirDiag, MirFunc, MirLocal, MirOperand,
                         MirPlace, MirProj, MirRvalue, MirStmt, MirWindow}
import sawresolve.layer.{FrontLayer}
import sawresolve.names.{ResIndex}
import sawresolve.program.{ResProgram, res_twin_message}
import sawtypecheck.program.{TcProgram}

// One entry of the builder's scope stack: an owned local a scope exit drops,
// or a window it closes. A consumed receiver whose body moves fields out is
// released field by field (`release_fields`). A
// construct's implicit binding of what its pattern left over holds the run
// `leftover_parts[parts_first..]` of places in local `index`, dropped in
// that order; `parts_count` is -1 for every other entry (`hold_leftovers`).
// A hand-off entry holds an operand's temporary only until the instruction
// that takes it is emitted (`hold_operand`).
public struct MirScopeEntry {
    window: Bool
    index: Int
    fieldwise: Bool
    parts_first: Int
    parts_count: Int
    handoff: Bool
}

// A loop being lowered: where `continue` goes, where `break` goes, the scope
// depth outside its body, and whether its body's budget point may yield.
public struct MirLoop {
    head: Int
    exit: Int
    depth: Int
    yields: Bool
    // The loop's node, which its budget points carry.
    node: Int
}

// A `try` block being lowered: the block its catch block starts at, the
// scope depth outside its body, the local its `error` binding is, and
// whether a propagating `try` reaches it.
public struct MirCatch {
    block: Int
    depth: Int
    error: Int
    reached: Bool
}

// An optional chain being lowered: the block its absent hops reach, the
// scope depth outside it, the first scope entry made inside it, and whether
// a hop reaches the block.
public struct MirChain {
    exit: Int
    depth: Int
    mark: Int
    reached: Bool
}

public struct MirProgram {
    tc: TcProgram
    funcs: Vector<MirFunc>
    locals: Vector<MirLocal>
    blocks: Vector<MirBlock>
    stmts: Vector<MirStmt>
    places: Vector<MirPlace>
    projs: Vector<MirProj>
    operands: Vector<MirOperand>
    rvalues: Vector<MirRvalue>
    // Operand runs: an rvalue's operands, a call's arguments.
    lists: Vector<Int>
    arms: Vector<MirArm>
    calls: Vector<MirCall>
    // Type runs: a call's instantiation.
    types: Vector<Int>
    // Condition runs: a conditional suspension point's conditions.
    conds: Vector<String>
    windows: Vector<MirWindow>
    diags: Vector<MirDiag>
    // What the lowering found typecheck left unrecorded, and in which module:
    // each an INVARIANT line, never a guess.
    problems: Vector<String>
    problem_modules: Vector<Int>
    // (body root, 0) -> the function lowering it; (closure node, 0) -> its
    // body's function.
    func_of: ResIndex
    // The function being lowered, its first local and block, and the block
    // code is emitted into, -1 once control cannot reach it.
    cur: Int
    local_base: Int
    block_base: Int
    current: Int
    scope: Vector<MirScopeEntry>  // front: rewritten in place
    scope_marks: Vector<Int>  // front: rewritten in place
    loops: Vector<MirLoop>  // front: rewritten in place
    // The `try` blocks open around the position, innermost last.
    catches: Vector<MirCatch>  // front: rewritten in place
    // The optional chains open around the position, innermost last.
    chains: Vector<MirChain>  // front: rewritten in place
    // The absent blocks the hops of the open chains made over an owned
    // temporary, innermost chain last: the block, the temporary's local, and
    // the chain's index in `chains`. A field read that takes the temporary
    // apart drops it in each block (`take_from_temporary`).
    absent_blocks: Vector<Int>  // front: process-local
    absent_roots: Vector<Int>  // front: process-local
    absent_chains: Vector<Int>  // front: process-local
    // By leaf: the local a binding lowers to, or -1; the leaves set, so they
    // are cleared when the function is done.
    leaf_local: Vector<Int>
    touched: Vector<Int>  // front: rewritten in place
    // A closure body's captures: by the binding's leaf, its index in the
    // environment, or -1.
    leaf_capture: Vector<Int>
    // The closures met while a function is lowered, lowered after it.
    pending: Vector<Int>  // front: rewritten in place
    pending_parents: Vector<Int>  // front: rewritten in place
    // How many closures each declaration's bodies hold so far.
    closure_counts: ResIndex
    // (spelling of a `Function` constant, 0) -> the declaration it names
    // (`function_constant`); a `FuncPointer`'s address is that function's.
    function_targets: ResIndex
    // Windows a statement-form `borrow` opened, closed when its statement
    // ends or its value is copied out.
    statement_windows: Vector<Int>
    // Whether the function being lowered is refused.
    refused: Bool
    // The owned parts a destructure's bindings have moved out so far, which
    // `dissolve` reads once they are bound.
    moved_parts: Vector<Int>  // front: rewritten in place
    // The places the scope's leftover entries hold, in runs.
    leftover_parts: Vector<Int>  // front: rewritten in place
    // A `consumes` body's receiver release: every field of `self`, in
    // declaration order, with their types. A field moved on some paths to a
    // return only is borrowck's to refuse (`init_consumes_partial`).
    release_fields: Vector<Int>  // front: rewritten in place
    release_types: Vector<Int>  // front: rewritten in place
    // Runs a function's record locals and carried windows name, and an
    // accessor's per-site resume blocks and open windows.
    aux: Vector<Int>
    // The accessors lowered as halves, or whole for one that lends a
    // borrowing struct, and by declaration the one each declaration's
    // halves are, or -1.
    accessors: Vector<MirAccessor>
    accessor_of: Vector<Int>
    // The order of the body root being lowered, which its functions take.
    order_now: Int
    // The source node the next statement or terminator carries, and whether
    // at its end (`source_at` in build.saw).
    at: Int
    at_closing: Bool
    // The unnamed lend's chain top whose `borrow` form lowering is under way,
    // which its own plan reads as the expression it is (`implicit_top` in
    // lower.saw); -1 outside one.
    lend_top_open: Int
    // The expression a statement-form `borrow` reads, whose windows close at
    // the first value a call returns along its chain, and the scope entry
    // they are registered from; -1 outside one, or once they have closed
    // (`prepare_borrow` in lower.saw).
    borrow_spine: Int
    borrow_mark: Int
}

extension MirProgram: NoCopy {}

extension MirProgram {
    // The declaration a `Function` constant spelled `text` names, or -1.
    public func function_target(&self, text: Int) -> Int {
        if text < 0 {
            return -1
        }
        let at = self.function_targets.first(text, 0)
        if at < 0 {
            return -1
        }
        self.function_targets.value(at)
    }

    // Whether the windows of accessor `decl` close by running nothing: it
    // lends a borrowing struct, so its whole body runs at the open and it
    // has no epilogue (split.saw, `register_producer`).
    public func closes_nothing(&self, decl: Int) -> Bool {
        if decl < 0 {
            return false
        }
        let a = self.accessor_of[decl]
        a >= 0 && self.accessors[a].epilogue < 0
    }
}

// THE MIR-FAMILY REPORT FUNNEL: the message refusal `d`, made at node `node`,
// is reported with, or None. A refusal made inside a generic function's
// instance names it, `instance` being mono's reader spelling of it (empty
// outside any, as before mono), since every instance reports at the one
// source node they share; and is reported once per instance, though several
// items may be one instance (its task root, its thread copy, an accessor's
// halves). A refusal in a derived twin's body that its accessor's own body
// already made at the same span is that refusal, reported once; one only the
// twin makes says so (`res_twin_message`).
//
// ENTRY POINTS:
//     MirProgram.not_yet
//     BorrowckProgram.report
//     BorrowckProgram.report_conflict
//     BorrowckProgram.report_loan
//     DropsProgram.refuse_fate
//     EvalProgram.report_bare
//     MonoProgram.refuse
//     CoroProgram.refuse_within
public func mir_diag_message(res: &ResProgram, diags: &Vector<MirDiag>, node: Int, d: &MirDiag,
                             instance: String = "") -> String? {
    var text = d.message
    if instance.len() > 0 {
        var named = StringBuilder()
        try! named.append(text)
        try! named.append(" (in the instantiation `")
        try! named.append(instance)
        try! named.append("`)")
        text = named.build()
    }
    if node >= 0 && res.twin_at(node) >= 0 {
        if mir_diag_made(&diags, &d, None) {
            return None
        }
        text = res_twin_message(text)
    }
    if instance.len() > 0 && mir_diag_made(&diags, &d, text) {
        return None
    }
    text
}

// Whether `diags` holds a refusal by `d`'s rule at `d`'s span, with
// `message` when one is given.
func mir_diag_made(diags: &Vector<MirDiag>, d: &MirDiag, message: String?) -> Bool {
    var k = 0
    while k < diags.len() {
        let seen = diags[k]
        if seen.module == d.module && seen.start == d.start && seen.end == d.end && seen.id.equals(d.id) {
            if let text = message {
                if seen.message.equals(text) {
                    return true
                }
            } else {
                return true
            }
        }
        k = k + 1
    }
    false
}

// The program under MIR lowering over `tc`, its tables sized to what `tc`
// holds; each layer grows them to what the stages before it add
// (`begin_layer`).
public func mir_program(tc: TcProgram) -> MirProgram {
    var p = mir_empty_program(move tc)
    p.grow_tables()
    move p
}

func mir_empty_program(tc: TcProgram) -> MirProgram {
    MirProgram(tc: move tc, funcs: Vector<MirFunc>(), locals: Vector<MirLocal>(),
               blocks: Vector<MirBlock>(), stmts: Vector<MirStmt>(), places: Vector<MirPlace>(),
               projs: Vector<MirProj>(), operands: Vector<MirOperand>(), rvalues: Vector<MirRvalue>(),
               lists: Vector<Int>(), arms: Vector<MirArm>(), calls: Vector<MirCall>(),
               types: Vector<Int>(), conds: Vector<String>(), windows: Vector<MirWindow>(),
               diags: Vector<MirDiag>(), problems: Vector<String>(), problem_modules: Vector<Int>(),
               func_of: ResIndex(), cur: -1, local_base: 0,
               block_base: 0, current: -1, scope: Vector<MirScopeEntry>(),
               scope_marks: Vector<Int>(), loops: Vector<MirLoop>(), catches: Vector<MirCatch>(),
               chains: Vector<MirChain>(), absent_blocks: Vector<Int>(), absent_roots: Vector<Int>(),
               absent_chains: Vector<Int>(), leaf_local: Vector<Int>(),
               touched: Vector<Int>(), leaf_capture: Vector<Int>(), pending: Vector<Int>(),
               pending_parents: Vector<Int>(), closure_counts: ResIndex(), function_targets: ResIndex(),
               statement_windows: Vector<Int>(), refused: false, moved_parts: Vector<Int>(),
               leftover_parts: Vector<Int>(), release_fields: Vector<Int>(), release_types: Vector<Int>(),
               aux: Vector<Int>(), accessors: Vector<MirAccessor>(), accessor_of: Vector<Int>(),
               order_now: 0, at: -1, at_closing: false, lend_top_open: -1, borrow_spine: -1, borrow_mark: 0)
}

extension MirProgram {
    // Stamps MIR's watermarks on `layer`, whose lowering begins once the
    // stages before it have checked the layer, and grows the per-node and
    // per-declaration tables to what they hold.
    public func begin_layer(&var self, layer: &var FrontLayer) {
        layer.func_first = self.funcs.len()
        layer.stmt_first = self.stmts.len()
        layer.place_first = self.places.len()
        self.grow_tables()
    }

    func grow_tables(&var self) {
        var k = self.leaf_local.len()
        while k < self.tc.res.nodes.len() {
            try! self.leaf_local.push(-1)
            try! self.leaf_capture.push(-1)
            k = k + 1
        }
        k = self.accessor_of.len()
        while k < self.tc.res.decls.len() {
            try! self.accessor_of.push(-1)
            k = k + 1
        }
    }
}

// The front-end image writes these types (sawmono.frontimage). They are
// derived, so a field added later is in the image by construction.
@synthesize
extension MirProgram: Serialize {}
@synthesize
extension MirProgram: Deserialize {}

@synthesize
extension MirScopeEntry: Serialize {}
@synthesize
extension MirScopeEntry: Deserialize {}

@synthesize
extension MirLoop: Serialize {}
@synthesize
extension MirLoop: Deserialize {}

@synthesize
extension MirCatch: Serialize {}
@synthesize
extension MirCatch: Deserialize {}

@synthesize
extension MirChain: Serialize {}
@synthesize
extension MirChain: Deserialize {}
