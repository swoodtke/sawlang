// The MIR's records (SL:architecture §3.5): a function is locals plus basic
// blocks; a place is a local, or a static, with a projection path; a statement
// assigns an rvalue to a place; a block ends in one terminator. Every record
// is plain data in the program's arenas. A function's locals and blocks are
// numbered from 0 within the function; places, operands, rvalues, statements
// and calls are arena indices. Types are typecheck's interned ids.

// What a local is: the return place `_0`, a parameter (the receiver first), a
// closure's environment, a binding the source names, a temporary, an
// accessor's state record (a half's parameter, or a window's storage), or the
// take flag of a local a non-escaping closure's `[move v]` takes, which drop
// elaboration adopts as that local's drop flag.
public enum MirLocalKind {
    case Return,
    case Param,
    case Receiver,
    case Env,
    case User,
    case Temp,
    case Record,
    case Flag
}

public struct MirLocal {
    public ty: Int
    public kind: MirLocalKind
    // The binding's name, interned in resolve's names, or -1.
    public name: Int
    // The leaf that declares it, or -1.
    public node: Int
    // Whether scope exits drop it: an owned local whose value no hand-off
    // consumes by construction (SL:architecture §3.5, "Scopes end in drops").
    public owned: Bool
    // A borrow binding, or a match binding that aliases its part: the local
    // holds a reference, and its name reads through it.
    public reference: Bool
}

public enum MirProjKind {
    // A struct's field: `decl` the field.
    case Field,
    // A tuple's element: `index`.
    case Tuple,
    // An array's, a slice's or a pointer's element: `index` the local holding
    // the index.
    case Index,
    // A reference's or a raw pointer's referent.
    case Deref,
    // A payload field of case `decl`, which a switch has proven: `index`.
    case Payload,
    // A payload field of case `decl` that panics when the value holds
    // another case: `o!` and `try!` (`index` 0).
    case Force
}

public struct MirProj {
    public kind: MirProjKind
    public decl: Int
    public index: Int
    // The type of the place this step produces.
    public ty: Int
}

// A root and a run of the program's projections. `local` is -1 for a place
// rooted in module static `static_decl`.
public struct MirPlace {
    public local: Int
    public static_decl: Int
    public first: Int
    public count: Int
    public ty: Int
}

public enum MirOperandKind {
    case Copy,
    case Move,
    case Const
}

// What a constant operand is: its spelling is the source's.
public enum MirConstKind {
    case Int,
    case Float,
    case String,
    case Bool,
    case Unit,
    // A format placeholder `{}` in an interpolated format string.
    case Placeholder,
    // The format string of `print`, `panic` or `assert`, its pieces and `{}`
    // slots as the literal spells them; its arguments are the call's next
    // operands, rendered without allocating (design 137).
    case Format,
    // A function named as a value: its spelling is its target's identity.
    case Function,
    // A const generic parameter, `N`, folded per instantiation.
    case Generic,
    // A builtin integer bound, `Int.max`, or a source location, `#line`.
    case Builtin
}

public struct MirOperand {
    public kind: MirOperandKind
    // The place a copy or a move reads, or -1.
    public place: Int
    public ty: Int
    public const_kind: MirConstKind
    // A constant's spelling, interned in the program's texts, or -1.
    public text: Int
}

public enum MirRvalueKind {
    // An operand as it is.
    case Use,
    // `ref(shared | exclusive, place)`.
    case Ref,
    // A builtin binary operator over two operands, by its spelling.
    case Binary,
    // A builtin unary operator.
    case Unary,
    // `x as T`.
    case Cast,
    // The adjustments that build a new value (compiler/tests/typecheck
    // README, "The dump"): an integer widened, a constant or case adopting an
    // integer slot, an erasure into an existential, `&v` as a slice.
    case Widen,
    case Adopt,
    case Erase,
    case Slice,
    // A conversion no declaration writes: an integer's `from`, `from(
    // truncating:)`, a raw-backed enum's `from(raw:)`, an alias's
    // construction; `op` its spelling.
    case Conversion,
    // A construction: see MirAggregate.
    case Aggregate,
    // An interpolated string's parts, in order.
    case Interpolate,
    // A take capture's environment entry, `take(place, flag)`: an exclusive
    // reference to the local the closure body takes, and one to its take
    // flag, `(&var T, &var Bool)`. The local counts as moved for every later
    // use and as maybe moved for its drop, since the body takes it only if it
    // runs.
    case Take
}

public enum MirAggregate {
    case Plain,
    // A struct's memberwise construction: `decl` the struct, operands in
    // field order.
    case Struct,
    // An enum case: `decl` the case, operands in payload order.
    case Case,
    case Tuple,
    // A fixed array.
    case Array,
    // `[v; N]`: the value, then the count.
    case Repeat,
    // A collection literal: its elements, or a map's keys and values in turn.
    case Vector,
    case Map,
    case Set,
    // A closure: `decl` the MIR function of its body, operands its captures.
    case Closure
}

public struct MirRvalue {
    public kind: MirRvalueKind
    public ty: Int
    // The operator's or conversion's spelling, interned in the texts; -1.
    public op: Int
    // A `Ref`'s mode.
    public exclusive: Bool
    // A `Ref`'s place, or -1.
    public place: Int
    // The operands: a run of the program's operand lists.
    public first: Int
    public count: Int
    public aggregate: MirAggregate
    public decl: Int
    // A `Take`'s flag place, or -1.
    public flag: Int
}

public enum MirStmtKind {
    // `place = rvalue`.
    case Assign,
    // `drop(place)`: drop it if it is still initialised.
    case Drop,
    // An op-budget point (design 127), on a loop backedge.
    case Budget
}

public struct MirStmt {
    public kind: MirStmtKind
    public place: Int
    public rvalue: Int
    // A budget point's class: yield-capable, or charge-only inside a
    // `borrows(sync)` window.
    public yields: Bool
    // The next statement of the same block, or -1.
    public next: Int
    // The source node it lowers, and whether it stands at that node's end,
    // a block's closing (compiler/tests/mir/README.md, "Source nodes").
    public node: Int
    public closing: Bool
}

public enum MirTermKind {
    // Not terminated yet; the verifier refuses one left so.
    case Open,
    case Goto,
    case Switch,
    case Call,
    case Return,
    case Unreachable
}

// What a switch reads: a `Bool` operand, or a place's discriminant.
public enum MirSwitchKind {
    case Bool,
    case Discriminant
}

// One arm of a switch: a `Bool`'s value (1 or 0) or a case declaration, and
// its target.
public struct MirArm {
    public value: Int
    public target: Int
}

public struct MirBlock {
    public first: Int
    public last: Int
    public term: MirTermKind
    // A goto's target.
    public target: Int
    public switch_kind: MirSwitchKind
    public operand: Int
    public place: Int
    public arm_first: Int
    public arm_count: Int
    // A switch's arm for every value no arm names, or -1.
    public otherwise: Int
    public call: Int
    // The terminator's source node, and whether it stands at that node's end.
    public term_node: Int
    public term_closing: Bool
}

// What a call terminator calls.
public enum MirCallKind {
    // A declaration: a function, method, requirement or init.
    case Function,
    // A parameter's default value: `target` the function, `param` its index.
    case Default,
    // A builtin with no declaration to name, by its spelling: `print`,
    // `panic`, `assert`, `sizeof`, `alignof`, `take`, `is_some`, `is_none`,
    // `copy`, `len`, `swap`, `init`.
    case Builtin,
    // A function value: `callee` the operand.
    case Value,
    // A `borrows` accessor's window: its prologue, which yields the lent
    // reference on the present edge; its epilogue; and, inside an accessor's
    // own body, the lend that pauses it (SL:architecture §3.5).
    case WindowOpen,
    case WindowClose,
    case Lend
}

// A call's suspension point, from typecheck's summaries: none, always, or
// when a condition over the enclosing function's type parameters holds.
public enum MirSuspend {
    case Never,
    case Always,
    case When
}

public struct MirCall {
    public kind: MirCallKind
    public target: Int
    public param: Int
    // The type a member is instantiated at, or -1; a function value's type.
    public owner: Int
    // The target's own type arguments: a run of the program's types list.
    public inst_first: Int
    public inst_count: Int
    // A builtin's spelling, interned in the texts; -1.
    public spelling: Int
    public callee: Int
    public arg_first: Int
    public arg_count: Int
    // Where the result goes, or -1.
    public dest: Int
    // The return edge (the present edge of a window), or -1 when the call
    // never returns.
    public next: Int
    // A conditional window's absent edge, or -1.
    public absent: Int
    // The window a window call opens or closes, or -1.
    public window: Int
    public suspend: MirSuspend
    // A conditional point's conditions, canonical and sorted: a run of the
    // program's condition texts.
    public cond_first: Int
    public cond_count: Int
    // The source node the call lowers.
    public node: Int
    // A window call's half: the accessor's prologue for an open, its
    // epilogue for a close, a MIR function; -1 when this program lowers no
    // body for the accessor.
    public half: Int
}

// A window a body opens: the accessor, whether it lends exclusively, and
// whether its borrow may not span a suspension (`borrows(sync)`).
public struct MirWindow {
    public accessor: Int
    public exclusive: Bool
    public sync: Bool
    public conditional: Bool
    // The call node the window lowers, whose summary answers whether each
    // half suspends.
    public node: Int
    // The local holding the accessor's state record for the window's
    // duration, or -1: none when the record is empty or the accessor's body
    // is not lowered here.
    public record: Int
    // Whether this program lowers the accessor's body, so its halves exist.
    public lowered: Bool
}

// A `borrows` accessor lowered as two halves around its `lend`
// (SL:architecture §3.5): the prologue, run at `window_open`, which produces
// the lent reference and writes the state record; the epilogue, run at
// `window_close`, which reads it. The record is a tuple of the locals live
// across the `lend`, over the accessor's own type parameters, a `Bool` drop
// flag for each one only maybe initialised there, and a resume index when the
// body lends at more than one place.
public struct MirAccessor {
    public decl: Int
    public prologue: Int
    public epilogue: Int
    // The record's type, or -1 when nothing lives across the `lend`.
    public record: Int
    public lend_sites: Int
    // Whether each half holds a call that may suspend.
    public prologue_suspends: Bool
    public epilogue_suspends: Bool
}

// Which body a MIR function lowers.
public enum MirFuncKind {
    // A function's, method's, `init`'s or default-bodied requirement's block.
    case Body,
    // A parameter's default value: `param` its index.
    case Default,
    // A static's initializer.
    case Static,
    // A raw-backed case's value.
    case RawValue,
    // An `@align` argument.
    case Align,
    // A `static_assert`'s condition.
    case Assert,
    // A test case's block.
    case Test,
    // A closure's body: `parent` the function it is written in.
    case Closure,
    // A `borrows` accessor's halves: the code up to its `lend`, and the code
    // after it.
    case Prologue,
    case Epilogue
}

public struct MirFunc {
    public module: Int
    public kind: MirFuncKind
    // The declaration the body belongs to, or -1 for an item.
    public decl: Int
    public root: Int
    public param: Int
    public parent: Int
    // A closure's ordinal among its declaration's closures.
    public ordinal: Int
    public local_first: Int
    public local_count: Int
    public block_first: Int
    public block_count: Int
    // How many locals after `_0` are parameters (the receiver and a
    // closure's environment included).
    public param_count: Int
    public window_first: Int
    public window_count: Int
    // The type parameters conditions and instantiations are over: the
    // declaration whose generic list is in scope.
    public owner: Int
    // Whether lowering refused a construct in it, or found a fact missing;
    // a refused function is neither dumped nor verified.
    public refused: Bool
    // Where its body root stands in typecheck's order, which the dump
    // follows; a closure and an accessor's halves share their function's.
    public order: Int
    // An accessor half's record locals and the windows open across its
    // `lend`, in its own numbering: runs of the program's `aux` list.
    public record_first: Int
    public record_count: Int
    // Parallel to the record locals: the record field holding each one's
    // drop flag, or -1 for a local definitely whole at every `lend`. Drop
    // elaboration writes those fields (SL:architecture §3.7).
    public record_flags_first: Int
    public carried_first: Int
    public carried_count: Int
}

public struct MirDiag {
    public module: Int
    public start: Int
    public end: Int
    public id: String
    public message: String
}
