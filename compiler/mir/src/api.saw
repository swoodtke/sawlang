// The MIR stage's entry points: a program checked, then lowered, and the
// record `sawc mir` prints for it.

import sawlex.stagetime.{StageTime, stagetime_begin, stagetime_end}
import sawmir.derive.{mir_lower_derived_bodies}
import sawmir.dump.{mir_dump_module}
import sawmir.lower.{mir_lower_program}
import sawmir.model.{MirDiag}
import sawmir.program.{MirProgram, mir_program}
import sawmir.verify.{mir_verify_module}
import sawresolve.api.{append_res_diag}
import sawresolve.layer.{FrontInputs, FrontLayer, FrontLayerKind, front_layer, front_layers}
import sawresolve.verify.{res_verify_module}
import sawasserts.layout.{asserts_inputs, asserts_run_layer}
import sawtypecheck.api.{append_tc_diag, tc_empty_program}
import sawtypecheck.bodyverify.{tc_verify_bodies}
import sawtypecheck.program.{TcTarget}
import sawtypecheck.verify.{tc_verify_module}

// How `sawc mir` treats one entry file.
public struct MirOptions {
    // The directory holding `std/` and `builtin.saw`.
    std_root: String
    // Print each lowered module's dump.
    dump: Bool
    // Print the notes about interface modules as well as the refusals.
    notes: Bool
    // Follow each dumped statement and terminator with its source position.
    spans: Bool
    // The target the program is checked for (`target_front_end`).
    target: TcTarget
}

// The program whose entry file is `path`, type checked for `target` and
// lowered to MIR, the lowering counted in `lowerings`. A caller lowers a file
// once and hands that program to every later stage, the evaluator included,
// so each driver path's count, which `--lowerings` prints, is 1 (SL-523).
public func mir_lower_file(path: String, std_root: String, names: &Vector<String>,
                           dirs: &Vector<String>, lowerings: &var Int, target: TcTarget, runtime: Bool = false,
                           freestanding: Bool = false, provider: Bool = false,
                           no_hidden_alloc: Bool = false) -> MirProgram {
    var p = mir_empty_front(std_root, target, runtime: runtime, freestanding: freestanding, provider: provider,
                            no_hidden_alloc: no_hidden_alloc)
    let inputs = asserts_inputs(path, &names, &dirs, target, freestanding)
    var layers = front_layers()
    var k = 0
    while k < layers.len() {
        var layer = layers[k]
        mir_run_layer(&var p, &var layer, &inputs)
        k = k + 1
    }
    lowerings = lowerings + 1
    move p
}

// The program under MIR lowering before any layer is loaded, compiled for
// `target` under the profile the flags name.
public func mir_empty_front(std_root: String, target: TcTarget, runtime: Bool = false, freestanding: Bool = false,
                            provider: Bool = false, no_hidden_alloc: Bool = false) -> MirProgram {
    mir_program(tc_empty_program(std_root, target, runtime: runtime, freestanding: freestanding, provider: provider,
                                 no_hidden_alloc: no_hidden_alloc))
}

// `layer` checked through the layout-assert funnel, then lowered: its
// accessors, its bodies and its derived bodies, after every earlier layer's.
public func mir_run_layer(p: &var MirProgram, layer: &var FrontLayer, inputs: &FrontInputs) {
    asserts_run_layer(&var p.tc, &var layer, &inputs)
    stagetime_begin(StageTime.Mir)
    p.begin_layer(&var layer)
    mir_lower_program(&var p, &layer)
    mir_lower_derived_bodies(&var p, &layer)
    stagetime_end(StageTime.Mir)
}

// The record of one lowered program, after its `FILE` line: resolve's,
// typecheck's and the lowering's refusals, each an `ERROR` line, `NOTE` lines
// when asked for, an `INVARIANT` line per problem any verifier finds or the
// lowering met, and each lowered module's dump when asked for. Returns 0
// when nothing was refused and 1 otherwise. The lowering is counted in
// `lowerings`.
public func mir_record(out: &var StringBuilder, path: String, options: &MirOptions, names: &Vector<String>,
                       dirs: &Vector<String>, lowerings: &var Int) -> Int {
    var p = mir_empty_front(options.std_root, options.target)
    let inputs = asserts_inputs(path, &names, &dirs, options.target, false)
    var layer = front_layer(FrontLayerKind.Std)
    mir_run_layer(&var p, &var layer, &inputs)
    mir_record_from(out: &var out, p: &var p, checked: "", verified_std: false, path: path, options: &options,
                    names: &names, dirs: &dirs, lowerings: &var lowerings)
}

// `mir_record` for program `p`, which std's layer has already run over:
// std's cut, computed here or by mono, or read from an image. The program's
// layer runs from there. With `verified_std`, std's layer verified its
// modules as it ran, leaving `checked`, and only the program's are verified
// here; else every module is.
public func mir_record_from(out: &var StringBuilder, p: &var MirProgram, checked: String, verified_std: Bool,
                            path: String, options: &MirOptions, names: &Vector<String>, dirs: &Vector<String>,
                            lowerings: &var Int) -> Int {
    let inputs = asserts_inputs(path, &names, &dirs, options.target, false)
    var layer = front_layer(FrontLayerKind.Program)
    mir_run_layer(&var p, &var layer, &inputs)
    lowerings = lowerings + 1
    let first = if verified_std { layer.module_first } else { 0 }
    mir_append_refusals(out: &var out, p: &p, notes: options.notes)
    try! out.append(checked)
    mir_append_module_checks(out: &var out, p: &var p, first: first)
    if options.dump {
        mir_append_dumps(out: &var out, p: &p, spans: options.spans)
    }
    mir_status(&p)
}

// Each module checked in full's dump, in load order.
public func mir_append_dumps(out: &var StringBuilder, p: &MirProgram, spans: Bool) {
    var m = 0
    while m < p.tc.res.module_count() {
        let info = p.tc.res.module(m)
        if info.available && not info.interface_only {
            mir_dump_module(&p, &var out, m, spans)
            try! out.append("\n")
        }
        m = m + 1
    }
}

// A lowered program's refusals, `NOTE` lines when asked for, and every
// verifier's `INVARIANT` lines, as `mir_record` describes; returns 0 when
// nothing was refused and 1 otherwise.
public func mir_append_checks(out: &var StringBuilder, p: &var MirProgram, notes: Bool) -> Int {
    mir_append_refusals(out: &var out, p: &p, notes: notes)
    mir_append_module_checks(out: &var out, p: &var p, first: 0)
    mir_status(&p)
}

// 0 when nothing in lowered program `p` is refused, 1 otherwise.
public func mir_status(p: &MirProgram) -> Int {
    if p.tc.error_count() > 0 || p.diags.len() > 0 {
        return 1
    }
    0
}

// Resolve's, typecheck's and the lowering's refusals, each an `ERROR` line,
// with `NOTE` lines when asked for.
public func mir_append_refusals(out: &var StringBuilder, p: &MirProgram, notes: Bool) {
    var k = 0
    while k < p.tc.res.diags.len() {
        let d = p.tc.res.diags[k]
        if not d.note || notes {
            append_res_diag(out: &var out, p: &p.tc.res, d: &d)
        }
        k = k + 1
    }
    k = 0
    while k < p.tc.diags.len() {
        let d = p.tc.diags[k]
        if not d.note || notes {
            append_tc_diag(out: &var out, p: &p.tc, d: &d)
        }
        k = k + 1
    }
    k = 0
    while k < p.diags.len() {
        let d = p.diags[k]
        mir_append_diag(out: &var out, p: &p, d: &d)
        k = k + 1
    }
}

// The `INVARIANT` lines every verifier finds in each module from `first` on,
// in module order: the verifiers run per module, so a layer's modules are
// verified in its step, before a later stage rewrites their MIR.
public func mir_append_module_checks(out: &var StringBuilder, p: &var MirProgram, first: Int) {
    var m = first
    while m < p.tc.res.module_count() {
        stagetime_begin(StageTime.VerifyResolve)
        let found = res_verify_module(&p.tc.res, m)
        stagetime_end(StageTime.VerifyResolve)
        mir_append_invariants(out: &var out, p: &p, m: m, problems: &found)
        stagetime_begin(StageTime.VerifyTypecheck)
        let own = tc_verify_module(&p.tc, m)
        stagetime_end(StageTime.VerifyTypecheck)
        mir_append_invariants(out: &var out, p: &p, m: m, problems: &own)
        stagetime_begin(StageTime.VerifyTypecheck)
        let bodies = tc_verify_bodies(&p.tc, m)
        stagetime_end(StageTime.VerifyTypecheck)
        mir_append_invariants(out: &var out, p: &p, m: m, problems: &bodies)
        var met = Vector<String>()
        var j = 0
        while j < p.tc.summary_problems.len() {
            if p.tc.summary_problem_modules[j] == m {
                try! met.push(p.tc.summary_problems.get(j) ?? "")
            }
            j = j + 1
        }
        j = 0
        while j < p.tc.phase_problems.len() {
            if p.tc.phase_problem_modules[j] == m {
                try! met.push(p.tc.phase_problems.get(j) ?? "")
            }
            j = j + 1
        }
        j = 0
        while j < p.problems.len() {
            if p.problem_modules[j] == m {
                try! met.push(p.problems.get(j) ?? "")
            }
            j = j + 1
        }
        mir_append_invariants(out: &var out, p: &p, m: m, problems: &met)
        stagetime_begin(StageTime.VerifyMir)
        let lowered = mir_verify_module(&var p, m)
        stagetime_end(StageTime.VerifyMir)
        mir_append_invariants(out: &var out, p: &p, m: m, problems: &lowered)
        m = m + 1
    }
}

public func mir_append_invariants(out: &var StringBuilder, p: &MirProgram, m: Int, problems: &Vector<String>) {
    var j = 0
    while j < problems.len() {
        try! out.append("INVARIANT\t")
        try! out.append(p.tc.res.module_name(m))
        try! out.append("\t")
        try! out.append(problems.get(j) ?? "")
        try! out.append("\n")
        j = j + 1
    }
}

// `ERROR<TAB>id<TAB>file:line:col<TAB>message`.
public func mir_append_diag(out: &var StringBuilder, p: &MirProgram, d: &MirDiag) {
    try! out.append("ERROR\t")
    try! out.append(d.id)
    try! out.append("\t")
    try! out.append(p.tc.res.module_file(d.module))
    try! out.append(":")
    try! out.append(p.tc.res.position_text(d.module, d.start))
    try! out.append("\t")
    try! out.append(d.message)
    try! out.append("\n")
}
