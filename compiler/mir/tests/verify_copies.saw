// The MIR verifier refuses a copy of an owning value whose type does not copy
// silently (SL-642). The verifier reads no text, so the fixture
// `compiler/tests/mir/inject/copies.saw` is lowered, found clean with its
// `String` copy and its raw-backed enum's tag cast, then edited: its one move
// of a NoCopy value becomes a copy, and the verifier must report exactly
// that. Paths are the repository root's, where the runner runs.
import sawmir.api.{mir_lower_file}
import sawmir.build.{mir_func_local}
import sawmir.model.{MirOperandKind, MirStmtKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}
import sawtypecheck.typeops.{TcClient}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` report a copy of a value that does not copy silently.
func copies_reported(found: &Vector<String>) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, "does not copy silently") {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// The first statement operand of module `m`'s functions that is a `move` or
// a `copy`, by `kind`, of an owning value, which copies silently or not by
// `silent`, or -1.
func owning_operand(p: &var MirProgram, m: Int, kind: MirOperandKind, silent: Bool) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        p.local_base = info.local_first
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                var k = 0
                while k < rv.count {
                    let o = p.lists[rv.first + k]
                    k = k + 1
                    let operand = p.operands[o]
                    if operand.kind == kind && p.owns(operand.ty) && p.tc.copies_silently(operand.ty) == silent {
                        return o
                    }
                }
            }
        }
    }
    return -1
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/copies.saw", "sawc", &names, &dirs, &var lowerings)
    let m = module_index(&p, "copies")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")
    assert(owning_operand(&var p, m, MirOperandKind.Copy, true) >= 0, "the fixture holds no silent copy of an owning value")

    let o = owning_operand(&var p, m, MirOperandKind.Move, false)
    assert(o >= 0, "the fixture holds no move of a NoCopy value")
    var edited = p.operands[o]
    edited.kind = MirOperandKind.Copy
    p.operands[o] = edited
    let after = mir_verify_module(&var p, m)
    assert(copies_reported(&after) == 1, "the verifier does not refuse the edited copy")
    assert(after.len() == 1, "the edit is reported as more than the copy")
}
