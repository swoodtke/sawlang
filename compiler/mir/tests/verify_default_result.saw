// The MIR verifier refuses a default value's function whose return is not
// its parameter's declared type, which stores one width into another at each
// call (SL-830). The verifier reads no text, so the fixture
// `compiler/tests/mir/inject/default_result.saw` is lowered and found clean,
// then its generic default's return local is retyped to `Int`, the type a
// literal has as written, and the verifier must report exactly that. Paths
// are the repository root's, where the runner runs.
import sawmir.api.{mir_lower_file}
import sawmir.model.{MirFuncKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// The first local of module `m`'s default function whose return is a type
// parameter, or -1.
func generic_default_return(p: &MirProgram, m: Int) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module == m && info.kind == MirFuncKind.Default && info.local_count > 0 {
            let ret = p.locals[info.local_first].ty
            if p.tc.ty(ret).kind == TcKind.Param {
                return info.local_first
            }
        }
    }
    return -1
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/default_result.saw", "sawc", &names, &dirs, &var lowerings)
    let m = module_index(&p, "default_result")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")

    let l = generic_default_return(&p, m)
    assert(l >= 0, "the fixture's generic default does not return its type parameter")
    var edited = p.locals[l]
    edited.ty = p.tc.int_type()
    p.locals[l] = edited
    let after = mir_verify_module(&var p, m)
    var reported = 0
    var k = 0
    while k < after.len() {
        let line = after.get(k) ?? ""
        if holds(&line, "a default's function returns `Int` for a parameter of type `T`") {
            reported = reported + 1
        }
        k = k + 1
    }
    assert(reported == 1, "the verifier admits a default returning another type than its parameter's")
}
