// The MIR verifier refuses an alias retype between types of another
// representation. The verifier reads no text, so the fixture
// `compiler/tests/mir/inject/alias_retype.saw` is lowered, found clean with its
// `&Name` passed as the `&String` it projects to, then edited: that retype
// reads the reference as its referent's value, and the verifier must report
// exactly that. No lowering emits the shape. Paths are the repository root's,
// where the runner runs.
import sawmir.api.{mir_lower_file}
import sawtarget.layout.{target_front_end}
import sawmir.model.{MirRvalueKind, MirStmtKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}
import sawtypecheck.typeops.{TcClient}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` report an alias retype between representations.
func retypes_reported(found: &Vector<String>) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, "an alias retype reads") {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// Retypes the first `alias` conversion of module `m` that reads a reference
// as the value it refers to, and returns its rvalue, or -1.
func inject_retype(p: &var MirProgram, m: Int) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                var rv = p.rvalues[stmt.rvalue]
                if rv.kind != MirRvalueKind.Conversion || rv.count != 1 || rv.op < 0 ||
                    not p.tc.name_text(rv.op).equals("alias") {
                    continue
                }
                let from = p.operands[p.lists[rv.first]].ty
                let value = p.tc.referent(from)
                if value >= 0 && not p.tc.same_representation(from, value) {
                    rv.ty = value
                    p.rvalues[stmt.rvalue] = rv
                    return stmt.rvalue
                }
            }
        }
    }
    return -1
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/alias_retype.saw", "std", &names, &dirs, &var lowerings,
                           target: target_front_end("arm64-apple-darwin", ""))
    let m = module_index(&p, "alias_retype")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")
    assert(inject_retype(&var p, m) >= 0, "the fixture holds no alias projection of a reference")
    let after = mir_verify_module(&var p, m)
    assert(retypes_reported(&after) == 1, "the verifier does not refuse the edited retype")
    // The retyped value then lands in a place of the projection's type, which
    // the verifier reports as the one consequence.
    assert(after.len() == 2, "the edit is reported as more than the retype and its consequence")
}
