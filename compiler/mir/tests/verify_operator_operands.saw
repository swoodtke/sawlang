// The MIR verifier refuses an owning value moved into a builtin binary
// operator, which borrows its operands and drops neither (SL-825). The
// verifier reads no text, so the fixture
// `compiler/tests/mir/inject/operator_operands.saw` is lowered, found clean
// with its interpolation passed to `!=` by shared reference, then edited: the
// operator's operand that moves that reference moves the interpolation's
// temporary itself, and the verifier must report exactly that. Paths are the
// repository root's, where the runner runs.
import sawmir.api.{mir_lower_file}
// For the extension writing `owns`.
import sawmir.build.{mir_func_local}
import sawmir.model.{MirOperandKind, MirRvalueKind, MirStmtKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` report an owning value moved into a builtin operator.
func operator_moves_reported(found: &Vector<String>) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, "into a builtin operator") {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// The whole local a `ref(shared, _K)` of an owning value in module `m`'s
// functions refers to, as (the ref's destination place, `_K`'s place), or
// (-1, -1).
func owning_ref(p: &var MirProgram, m: Int) -> (Int, Int) {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                if rv.kind != MirRvalueKind.Ref || rv.place < 0 {
                    continue
                }
                let referent = p.places[rv.place]
                if referent.count == 0 && referent.local >= 0 && p.owns(referent.ty) {
                    return (stmt.place, rv.place)
                }
            }
        }
    }
    return (-1, -1)
}

// The operand of a builtin binary operator in module `m`'s functions that
// moves the local place `dest` names, or -1.
func operator_operand(p: &var MirProgram, m: Int, dest: Int) -> Int {
    let want = p.places[dest].local
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                if rv.kind != MirRvalueKind.Binary {
                    continue
                }
                var k = 0
                while k < rv.count {
                    let o = p.lists[rv.first + k]
                    k = k + 1
                    let operand = p.operands[o]
                    if operand.kind != MirOperandKind.Move {
                        continue
                    }
                    let read = p.places[operand.place]
                    if read.count == 0 && read.local == want {
                        return o
                    }
                }
            }
        }
    }
    return -1
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/operator_operands.saw", "sawc", &names, &dirs,
                           &var lowerings)
    let m = module_index(&p, "operator_operands")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")

    let (dest, referent) = owning_ref(&var p, m)
    assert(dest >= 0, "the fixture borrows no owning temporary by reference")
    let o = operator_operand(&var p, m, dest)
    assert(o >= 0, "no builtin operator takes the reference to the temporary")
    var edited = p.operands[o]
    edited.place = referent
    edited.ty = p.places[referent].ty
    p.operands[o] = edited
    let after = mir_verify_module(&var p, m)
    assert(operator_moves_reported(&after) == 1, "the verifier does not refuse the edited operand")
    assert(after.len() == 1, "the edit is reported as more than the operator's operand")
}
