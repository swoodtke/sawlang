// A frame slot is the second step of its place, right after the dereference
// of the local holding the frame pointer, at an offset of at least 0
// (compiler/tests/mir/README.md, "The verifier"). No lowering makes one
// before coroutine lowering, so the fixture `compiler/tests/mir/inject/
// frame_slots.saw` is lowered, found clean, then edited: its write through
// `(*_1)` becomes a write to `(*_1).[8: Int]`, which the dump spells so and
// the verifier admits; then to a slot on `_1` itself, and to one at a
// negative offset, each of which must be reported. Paths are the repository
// root's, where the runner runs.
import sawmir.api.{mir_lower_file}
import sawmir.build.{mir_func_local}
import sawmir.dump.{mir_dump_module}
import sawmir.model.{MirProjKind, MirStmtKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` hold `word`.
func reported(found: &Vector<String>, word: String) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, word) {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// The statement of module `m`'s functions that assigns `(*_1)`, or -1, with
// `local_base` left at its function's.
func write_through_param(p: &var MirProgram, m: Int) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        p.local_base = info.local_first
        var b = 0
        while b < info.block_count {
            let first = p.blocks[info.block_first + b].first
            b = b + 1
            var s = first
            while s >= 0 {
                let stmt = p.stmts[s]
                let here = s
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.place < 0 {
                    continue
                }
                let place = p.places[stmt.place]
                if place.local == 1 && place.count == 1 && p.projs[place.first].kind == MirProjKind.Deref {
                    return here
                }
            }
        }
    }
    return -1
}

// The fixture lowered, checked clean, its write through `(*_1)` found, and
// that write's place replaced with `place` as `edit` makes it from the
// original: 0 a slot at offset 8 after the dereference, 1 a slot on `_1`
// itself, 2 a slot at offset -8 after the dereference.
func edited(names: &Vector<String>, dirs: &Vector<String>, edit: Int) -> MirProgram {
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/frame_slots.saw", "sawc", &names, &dirs, &var lowerings)
    let m = module_index(&p, "frame_slots")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let clean = mir_verify_module(&var p, m)
    assert(clean.len() == 0, "the fixture's MIR is not clean before the edit")
    let s = write_through_param(&var p, m)
    assert(s >= 0, "the fixture has no write through `(*_1)`")
    var stmt = p.stmts[s]
    let t = p.places[stmt.place].ty
    var slot = -1
    if edit == 1 {
        let root = p.place_local(1)
        slot = p.project(root, MirProjKind.FrameSlot, -1, 8, t)
    } else if edit == 2 {
        slot = p.project(stmt.place, MirProjKind.FrameSlot, -1, -8, t)
    } else {
        slot = p.project(stmt.place, MirProjKind.FrameSlot, -1, 8, t)
    }
    stmt.place = slot
    p.stmts[s] = stmt
    move p
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()

    // A slot right after the dereference: spelled `(*_1).[8: Int]`, and clean.
    var p = edited(&names, &dirs, 0)
    let m = module_index(&p, "frame_slots")
    var out = StringBuilder()
    mir_dump_module(&p, &var out, m, false)
    let text = out.build()
    assert(holds(&text, "(*_1).[8: Int] = "), "the dump does not spell a frame slot `(*_1).[8: Int]`")
    let admitted = mir_verify_module(&var p, m)
    assert(admitted.len() == 0, "the verifier refuses a frame slot right after the frame pointer's dereference")

    // A slot on the local itself, with no dereference before it.
    var q = edited(&names, &dirs, 1)
    let qm = module_index(&q, "frame_slots")
    let bare = mir_verify_module(&var q, qm)
    assert(reported(&bare, "frame slot is not the second step") == 1, "the verifier admits a frame slot on a local")

    // A slot at a negative offset.
    var r = edited(&names, &dirs, 2)
    let rm = module_index(&r, "frame_slots")
    let negative = mir_verify_module(&var r, rm)
    assert(reported(&negative, "negative offset") == 1, "the verifier admits a frame slot at a negative offset")
}
