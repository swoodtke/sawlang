// The MIR verifier refuses an exclusive reference taken through a shared one
// (SL-906). The verifier reads no text, so the fixture
// `compiler/tests/mir/inject/exclusive_refs.saw` is lowered, found clean with
// its exclusive borrow through a `&var` parameter and into a raw pointer's
// pointee reached through `&self`, then edited four times. Its shared borrow
// of a cell-carrying receiver's cell becomes exclusive, and so does the
// receiver a `&self` window takes through a `&Holder`, and the verifier must
// admit both; then the receiver a `&var self` window takes is retargeted
// through that `&Holder`, and a shared borrow of a payload through a `&Slot`
// parameter becomes exclusive, and the verifier must report exactly those
// two. Paths are the repository root's, where the runner runs.
import sawmir.api.{mir_lower_file}
import sawmir.model.{MirRvalueKind, MirStmtKind}
import sawmir.program.{MirProgram}
import sawmir.verify.{mir_verify_module}
// For the extension writing `type_text`.
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` report an exclusive reference through a shared one.
func reported(found: &Vector<String>) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, "exclusive reference through a shared one") {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// Makes exclusive the first shared `Ref` in module `m`'s functions whose
// place's type's spelling holds `spelled`. Returns whether one was found.
func make_exclusive(p: &var MirProgram, m: Int, spelled: String) -> Bool {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                var rv = p.rvalues[stmt.rvalue]
                if rv.kind != MirRvalueKind.Ref || rv.exclusive {
                    continue
                }
                let text = p.tc.type_text(p.places[rv.place].ty)
                if holds(&text, spelled) {
                    rv.exclusive = true
                    p.rvalues[stmt.rvalue] = rv
                    return true
                }
            }
        }
    }
    false
}

// The rvalue of the first `Ref` in module `m`'s functions, of the mode
// `exclusive`, whose place projects through a reference to a value whose
// type's spelling holds `spelled`, or -1.
func projected_ref(p: &var MirProgram, m: Int, spelled: String, exclusive: Bool) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                if rv.kind != MirRvalueKind.Ref || rv.exclusive != exclusive || p.places[rv.place].count == 0 {
                    continue
                }
                let text = p.tc.type_text(p.places[rv.place].ty)
                if holds(&text, spelled) {
                    return stmt.rvalue
                }
            }
        }
    }
    -1
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var lowerings = 0
    var p = mir_lower_file("compiler/tests/mir/inject/exclusive_refs.saw", "std", &names, &dirs, &var lowerings)
    let m = module_index(&p, "exclusive_refs")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")
    assert(make_exclusive(&var p, m, "UnsafeMutableInterior<Int>"), "the fixture borrows no cell through `&self`")
    let admitted = mir_verify_module(&var p, m)
    assert(admitted.len() == 0, "the verifier refuses an exclusive borrow of a cell-carrying referent's interior")

    let read = projected_ref(&var p, m, "Holder", false)
    let write = projected_ref(&var p, m, "Holder", true)
    assert(read >= 0 && write >= 0, "the fixture opens no `&self` and `&var self` windows through references")
    var reader = p.rvalues[read]
    reader.exclusive = true
    p.rvalues[read] = reader
    let receiver = mir_verify_module(&var p, m)
    assert(receiver.len() == 0, "the verifier refuses an exclusive receiver of a `&self` window")
    var writer = p.rvalues[write]
    writer.place = reader.place
    p.rvalues[write] = writer
    let through = mir_verify_module(&var p, m)
    assert(reported(&through) == 1, "the verifier does not refuse a `&var self` window's receiver reached through `&`")
    assert(through.len() == 1, "the retargeted receiver is reported as more than the one reference")

    assert(make_exclusive(&var p, m, "Cell"), "the fixture borrows no payload through a shared reference")
    let after = mir_verify_module(&var p, m)
    assert(reported(&after) == 2, "the verifier does not refuse the exclusive reference through a shared one")
    assert(after.len() == 2, "the edit is reported as more than the one reference")
}
