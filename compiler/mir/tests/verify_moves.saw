// The MIR verifier refuses a move of an owning value out through a reference
// (SL-475). The verifier reads no text, so the fixture
// `compiler/tests/mir/inject/moves.saw` is lowered, found clean, then edited:
// its one copy of an owning value through a reference becomes a move, and the
// verifier must report exactly that. `inject/handoff.saw` is lowered as it
// stands: a generic hand-off of an unbounded `T` must stay a reported move.
// `inject/takes.saw` holds a closure body's take, the one owning move through
// a reference the verifier admits; it is found clean, then each of two edits,
// unlinking the flag's clear and swapping the switch's arms, must make the
// verifier report the move. Paths are the repository root's, where the runner
// runs.
import sawmir.src.api.{mir_lower_file}
import sawmir.src.build.{mir_func_local}
import sawmir.src.model.{MirOperandKind, MirStmtKind}
import sawmir.src.program.{MirProgram}
import sawmir.src.verify.{mir_verify_module}

// The index of module `name`, or -1.
func module_index(p: &MirProgram, name: String) -> Int {
    var m = 0
    while m < p.tc.res.module_count() {
        if p.tc.res.module_name(m).equals(name) {
            return m
        }
        m = m + 1
    }
    return -1
}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// How many of `found` report a move through a reference.
func moves_reported(found: &Vector<String>) -> Int {
    var count = 0
    var k = 0
    while k < found.len() {
        let line = found.get(k) ?? ""
        if holds(&line, "out through a reference") {
            count = count + 1
        }
        k = k + 1
    }
    count
}

// The first operand of module `m`'s functions that copies an owning value
// out through a reference, or -1.
func owning_copy_through_reference(p: &var MirProgram, m: Int) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        f = f + 1
        if info.module != m {
            continue
        }
        p.local_base = info.local_first
        var b = 0
        while b < info.block_count {
            let block = p.blocks[info.block_first + b]
            b = b + 1
            var s = block.first
            while s >= 0 {
                let stmt = p.stmts[s]
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                var k = 0
                while k < rv.count {
                    let o = p.lists[rv.first + k]
                    k = k + 1
                    let operand = p.operands[o]
                    if operand.kind == MirOperandKind.Copy && p.owns(operand.ty) && p.through_reference_deref(operand.place) {
                        return o
                    }
                }
            }
        }
    }
    return -1
}

// The statement of module `m`'s functions that moves an owning value out
// through a reference, a closure body's take, or -1; with `function`, the
// function holding it instead.
func owning_move_through_reference(p: &var MirProgram, m: Int, function: Bool) -> Int {
    var f = 0
    while f < p.funcs.len() {
        let info = p.funcs[f]
        let here_function = f
        f = f + 1
        if info.module != m {
            continue
        }
        p.local_base = info.local_first
        var b = 0
        while b < info.block_count {
            let first = p.blocks[info.block_first + b].first
            b = b + 1
            var s = first
            while s >= 0 {
                let stmt = p.stmts[s]
                let here = s
                s = stmt.next
                if stmt.kind != MirStmtKind.Assign || stmt.rvalue < 0 {
                    continue
                }
                let rv = p.rvalues[stmt.rvalue]
                if rv.count != 1 {
                    continue
                }
                let operand = p.operands[p.lists[rv.first]]
                if operand.kind == MirOperandKind.Move && p.owns(operand.ty) && p.through_reference_deref(operand.place) {
                    if function {
                        return here_function
                    }
                    return here
                }
            }
        }
    }
    return -1
}

// The take fixture lowered, checked clean, and its take found.
func lowered_takes(names: &Vector<String>, dirs: &Vector<String>) -> MirProgram {
    var p = mir_lower_file("compiler/tests/mir/inject/takes.saw", "sawc", &names, &dirs)
    let m = module_index(&p, "takes")
    assert(m >= 0, "the take fixture did not load")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the take fixture is refused")
    let clean = mir_verify_module(&var p, m)
    assert(clean.len() == 0, "the take fixture's MIR is not clean before the edit")
    assert(owning_move_through_reference(&var p, m, false) >= 0, "the take fixture holds no take")
    move p
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var p = mir_lower_file("compiler/tests/mir/inject/moves.saw", "sawc", &names, &dirs)
    let m = module_index(&p, "moves")
    assert(m >= 0, "the fixture did not load: run from the repository root")
    assert(p.diags.len() == 0 && p.tc.error_count() == 0, "the fixture is refused")
    let before = mir_verify_module(&var p, m)
    assert(before.len() == 0, "the fixture's MIR is not clean before the edit")

    let o = owning_copy_through_reference(&var p, m)
    assert(o >= 0, "the fixture holds no copy of an owning value through a reference")
    var edited = p.operands[o]
    edited.kind = MirOperandKind.Move
    p.operands[o] = edited
    let after = mir_verify_module(&var p, m)
    assert(moves_reported(&after) == 1, "the verifier does not refuse the edited move")
    assert(after.len() == 1, "the edit is reported as more than the move")

    // A hand-off of an unbounded `T` through a reference stays visible as a
    // move, never a bitwise copy.
    var q = mir_lower_file("compiler/tests/mir/inject/handoff.saw", "sawc", &names, &dirs)
    let h = module_index(&q, "handoff")
    assert(h >= 0, "the hand-off fixture did not load")
    assert(q.diags.len() == 0 && q.tc.error_count() == 0, "the hand-off fixture is refused")
    let found = mir_verify_module(&var q, h)
    assert(moves_reported(&found) == 1 && found.len() == 1, "the generic hand-off is not reported as a move")

    // A take whose flag is never cleared would let a second run take again.
    var t = lowered_takes(&names, &dirs)
    let tm = module_index(&t, "takes")
    let s = owning_move_through_reference(&var t, tm, false)
    var take = t.stmts[s]
    let clear = t.stmts[take.next]
    take.next = clear.next
    t.stmts[s] = take
    let unclear = mir_verify_module(&var t, tm)
    assert(moves_reported(&unclear) == 1, "the verifier admits a take that leaves its flag set")

    // A take on the switch's false arm would run when the flag says gone. The
    // body's one capture is its take, so its entry block ends in the switch.
    var u = lowered_takes(&names, &dirs)
    let um = module_index(&u, "takes")
    let body = owning_move_through_reference(&var u, um, true)
    let head = u.blocks[u.funcs[body].block_first]
    assert(head.arm_count == 2, "the take fixture's body does not start with the take's switch")
    let first = head.arm_first
    var yes = u.arms[first]
    var no = u.arms[first + 1]
    yes.value = 0
    no.value = 1
    u.arms[first] = yes
    u.arms[first + 1] = no
    let swapped = mir_verify_module(&var u, um)
    assert(moves_reported(&swapped) == 1, "the verifier admits a take entered on its flag's false edge")
}
