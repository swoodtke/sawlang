// The borrow check's program: the MIR program, unchanged, the refusals the
// check makes, and the drop labels it exports for drop elaboration
// (SL:architecture §3.7).

import sawmir.model.{MirDiag}
import sawmir.program.{MirProgram}
import sawresolve.layer.{FrontLayer}

// A drop's label in the side table: none for a statement that is no drop,
// or a drop no path reaches.
public static BORROWCK_LABEL_NONE: Int = -1
public static BORROWCK_LABEL_STATIC: Int = 0
public static BORROWCK_LABEL_ELIDED: Int = 1
public static BORROWCK_LABEL_FLAGGED: Int = 2

public struct BorrowckProgram {
    mir: MirProgram
    diags: Vector<MirDiag>
    // By statement, in the MIR's statement arena: each reached drop's label.
    labels: Vector<Int>
    // By source node, its parent node, or -1; built when a rule first needs
    // it (`node_parents` in conflicts.saw).
    parents: Vector<Int>
}

extension BorrowckProgram: NoCopy {}

public func borrowck_program(mir: MirProgram) -> BorrowckProgram {
    var p = BorrowckProgram(mir: move mir, diags: Vector<MirDiag>(), labels: Vector<Int>(), parents: Vector<Int>())
    p.grow_labels()
    move p
}

extension BorrowckProgram {
    // Grows the label table to every statement a layer's lowering added,
    // before the layer's modules are checked.
    public func begin_layer(&var self, layer: &FrontLayer) {
        self.grow_labels()
    }

    func grow_labels(&var self) {
        var k = self.labels.len()
        while k < self.mir.stmts.len() {
            try! self.labels.push(BORROWCK_LABEL_NONE)
            k = k + 1
        }
    }
}
