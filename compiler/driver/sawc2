#!/bin/sh
# sawc2, the script that connects the pieces (SL:architecture §4): the
# compiler binary writes one textual LLVM module and spawns nothing; this
# script hands it to clang with the runtime objects its link manifest names.
#
#   compiler/driver/sawc2 build [-O0|-O1|-O2|-Os|-Oz] [--std-root DIR]
#                               [--target TRIPLE] FILE [-o OUT]
#   compiler/driver/sawc2 COMMAND ARGS...   any other command, run as is
#
# The binary is .build/sawc2 (compiler/tools/build.py builds it); $SAWC2_BIN
# overrides it. clang is $CLANG, else `clang` on PATH. The runtime objects
# are Stage 0's prebuilt ones (compiler/tools/runtime_objects.py), found with
# $SAW_PYTHON, else the repository's .venv, else python3. `-o` defaults to
# the source's name under .build/.
#
# A build links for the host only: the runtime objects are the host's, so a
# `--target` naming another target is refused here rather than linked into a
# host binary. The module names the triple clang compiles IR for on this
# host, so clang links it as written and never overrides it.

set -eu

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
bin=${SAWC2_BIN:-$repo/.build/sawc2}

if [ "${1:-}" != "build" ]; then
    exec "$bin" "$@"
fi
shift

out=""
pass=""
source=""
target=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o)
            out=$2
            shift 2
            ;;
        --target)
            target=$2
            shift 2
            ;;
        --std-root|--module-path)
            pass="$pass $1 $2"
            shift 2
            ;;
        -*)
            pass="$pass $1"
            shift
            ;;
        *)
            source=$1
            pass="$pass $1"
            shift
            ;;
    esac
done
if [ -z "$source" ]; then
    echo "usage: sawc2 build [-O0|-O1|-O2|-Os|-Oz] [--std-root DIR] [--target TRIPLE] FILE [-o OUT]" >&2
    exit 2
fi
if [ -z "$out" ]; then
    name=$(basename "$source" .saw)
    out="$repo/.build/$name"
fi

clang=${CLANG:-clang}
module_triple=$("$clang" -### -x ir -c /dev/null -o /dev/null 2>&1 | sed -n 's/.*"-triple" "\([^"]*\)".*/\1/p' | head -n 1)
case "$module_triple" in
    arm64-apple-*|aarch64-apple-*)
        host=arm64-apple-darwin
        ;;
    x86_64-*-linux-gnu)
        host=x86_64-unknown-linux-gnu
        ;;
    *)
        echo "sawc2 build: this host's clang compiles for \`$module_triple\`, which is not a target sawc2 builds for" >&2
        exit 1
        ;;
esac
if [ -n "$target" ] && [ "$target" != "$host" ]; then
    echo "sawc2 build: --target $target is not this host ($host): a build links against the host's runtime, so only the host is a build target; \`sawc2 mono --layouts --target $target\` describes another target's layouts" >&2
    exit 1
fi

ll="$out.ll"
# shellcheck disable=SC2086
if ! "$bin" build --target "$host" --module-triple "$module_triple" $pass > "$ll"; then
    cat "$ll"
    rm -f "$ll"
    exit 1
fi

manifest() {
    sed -n "s/^; $1 //p" "$ll" | head -n 1
}
speed=$(manifest speed)
runtime=$(manifest runtime)

python=${SAW_PYTHON:-}
if [ -z "$python" ]; then
    if [ -x "$repo/.venv/bin/python" ]; then
        python="$repo/.venv/bin/python"
    else
        python=python3
    fi
fi

objects=""
if [ "$runtime" = "hosted" ]; then
    objects=$("$python" "$repo/compiler/tools/runtime_objects.py")
fi

# shellcheck disable=SC2086
exec "$clang" $speed -x ir "$ll" -x none $objects -o "$out"
