static DRIVER_EXIT_LEX_ERROR: Int = 1
static DRIVER_EXIT_USAGE: Int = 2
static DRIVER_NEWLINE: Int = 10
static DRIVER_AT: Int = 64
static DRIVER_EQUALS: Int = 61
static DRIVER_SLASH: Int = 47
func driver_usage() -> Int {
    print("usage: sawc lex [--docs] <file.saw>")
    print("       sawc lex --kinds")
    print("       sawc lex @LIST")
    print("       sawc parse (--dump | --check) [--alternatives] [[--unit] FILE | @LIST]...")
    print("       sawc parse --redump [FILE | @LIST]...")
    print("       sawc resolve (--dump | --check) [--notes] [--lowerings] [--std-root DIR]")
    print("                    [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc typecheck (--dump | --check) [--notes] [--interfaces] [--summaries] [--runtime]")
    print("                      [--freestanding] [--no-hidden-alloc] [--lowerings] [-W borrow-prefix] [--std-root DIR]")
    print("                      [--target TRIPLE] [--target-features FEATURES] [--module-path NAME=DIR]...")
    print("                      [FILE | @LIST]...")
    print("       sawc fix [--check] [--std-root DIR] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc mir (--dump | --check) [--notes] [--spans] [--lowerings] [--std-root DIR] [--target TRIPLE]")
    print("                [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc eval (--dump | --check) [--notes] [--lowerings] [--std-root DIR] [--target TRIPLE]")
    print("                 [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc borrowck (--dump | --check) [--notes] [--lowerings] [--std-root DIR] [--target TRIPLE]")
    print("                     [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc drops (--dump | --check) [--notes] [--lowerings] [--std-root DIR] [--target TRIPLE]")
    print("                  [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc mono (--dump | --layouts | --check) [--notes] [--lowerings] [--std-root DIR]")
    print("                 [--target TRIPLE] [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc coro (--dump | --layouts | --lowered | --bt-table | --check) [--notes] [--std-root DIR]")
    print("                 [--target TRIPLE] [--target-features FEATURES] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc build [-O0 | -O1 | -O2 | -Os | -Oz] [-g | -g0] [-c] [--std-root DIR] [--target TRIPLE]")
    print("                  [--target-features FEATURES] [--sanitize address] [--freestanding] [--runtime] [--no-hidden-alloc]")
    print("                  [-W borrow-prefix] [--time-stages] [--codegen-units=1|module] [--lto=thin|full|none]")
    print("                  [--no-object-cache] [--no-front-cache] [--module-path NAME=DIR]...")
    print("                  (FILE [-o OUT] | --emit-ll FILE)")
    print("       (resolve through coro, and fix, each also take --no-front-cache)")
    print("       sawc runtime [--std-root DIR] [--rt-root DIR] [--target TRIPLE] [--clang PATH]")
    print("                    (--out DIR | --emit-ll FILE)")
    print("       sawc [BUILD-FLAG]... FILE.saw [-o OUT]   the same as `sawc build`")
    print("       sawc --version")
    DRIVER_EXIT_USAGE
}

// The optimisation level `flag` asks for, as the flag clang takes, or "" for
// none: the one place a speed flag is read (design 265's `speed_level`).
func driver_speed_level(flag: String) -> String {
    if flag.equals("-O0") || flag.equals("-O1") || flag.equals("-O2") || flag.equals("-Os") || flag.equals("-Oz") {
        return flag
    }
    ""
}

// `sawc build FILE`: the program compiled to `OUT.ll` and linked by clang
// into `OUT` against the runtime objects the manifest beside this binary
// names; with `--emit-ll`, its `.ll` on standard output and nothing linked.
// With `-c`, clang compiles `OUT.ll` to the object `OUT`, `.o` appended when
// `OUT` lacks it, and links nothing: the object keeps the executable's
// linkage, and a program with no `main` owes none (`llvm_emit_program`).
// `--target-features` names the subtarget features every function is
// compiled for, each one checked against the target's clang first
// (`driver_check_feature_names`).
// `--sanitize address` builds it under AddressSanitizer, its frames poisoned
// outside their values' lifetimes; it is the one value the flag takes. A
// refusal prints its record and exits 1, and a failing clang's exit status
// is the build's (compiler/tests/run/README.md). `--freestanding` builds an
// object under the freestanding profile: the exports are its roots, a Mach-O
// triple is refused (`driver_refuse_mach_o`), and the target's default
// features apply when none are named (`target_effective_features`).
// `--runtime` (and v0.18.0's spelling, `--runtime-provider`) builds a runtime
// provider: it may export the frozen seams, each checked against
// runtime/ABI.md, and a hosted one links with none of sawc's runtime objects,
// so it must define every seam it reaches (`ll_check_provider_seams`);
// `--runtime-build` is refused, naming `sawc runtime`. `--no-hidden-alloc`
// has typecheck refuse the allocations no source construct names
// (`refuse_hidden_allocation`). The program carries DWARF line tables unless
// `-g0` turns them off; `-g` spells the default (spec, Debug info).
// `--codegen-units=module` compiles one module per Saw module in parallel and
// links them (`driver_split_build`), optimised across them as `--lto` says
// (`driver_codegen_choice`), reusing the object of every unit whose key the
// object cache holds unless `--no-object-cache` says otherwise
// (`driver_object_key`); `--codegen-units=1`, the default, compiles the
// whole program as one module. Its
// arguments start at `args[first]`: 2 after `build`, and 1 for the implicit
// form `sawc [FLAG]... FILE.saw`, the command line a Stage 0 consumer already
// writes.
func driver_build(args: &Vector<String>, first: Int) -> Int {
    var std_root = ""
    var triple = ""
    var speed = "-O0"
    var names = Vector<String>()
    var dirs = Vector<String>()
    var path = ""
    var out = ""
    var emit = false
    var sanitize = false
    var freestanding = false
    var provider = false
    var hidden = false
    var debug = true
    var warn = false
    var object = false
    var features = ""
    var units = ""
    var lto = ""
    var timed = false
    var no_cache = false
    var no_front = false
    var i = first
    while i < args.len() {
        let arg = args.get(i) ?? ""
        let level = driver_speed_level(arg)
        let valued = (arg.equals("--std-root") || arg.equals("--module-path") || arg.equals("--target")
                      || arg.equals("--sanitize") || arg.equals("--target-features"))
        if level.len() > 0 {
            speed = level
        } else if arg.starts_with("--codegen-units=") {
            units = arg.substring(16, arg.len())
        } else if arg.starts_with("--lto=") {
            lto = arg.substring(6, arg.len())
        } else if arg.equals("-c") {
            object = true
        } else if arg.equals("-g") {
            debug = true
        } else if arg.equals("-g0") {
            debug = false
        } else if arg.equals("-W") {
            if not driver_warning_category(args.get(i + 1) ?? "") {
                return DRIVER_EXIT_USAGE
            }
            warn = true
            i = i + 1
        } else if arg.equals("--emit-ll") {
            emit = true
        } else if arg.equals("--no-object-cache") {
            no_cache = true
        } else if arg.equals("--no-front-cache") {
            no_front = true
        } else if arg.equals("--time-stages") {
            stagetime_enable()
            timed = true
        } else if arg.equals("--freestanding") {
            freestanding = true
        } else if arg.equals("--runtime") || arg.equals("--runtime-provider") {
            provider = true
        } else if arg.equals("--no-hidden-alloc") {
            hidden = true
        } else if arg.equals("--runtime-build") {
            print("sawc build: takes no --runtime-build, v0.18.0's build of its own runtime: `sawc runtime` builds runtime/, each seam checked against runtime/ABI.md, and `--runtime` builds a program that is its own runtime")
            return DRIVER_EXIT_USAGE
        } else if valued || arg.equals("-o") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if arg.equals("--sanitize") {
                if not value.equals("address") {
                    print("sawc build: --sanitize takes `address`, the one sanitizer sawc builds with, not `{}`", value)
                    return DRIVER_EXIT_USAGE
                }
                sanitize = true
            } else if arg.equals("--target-features") {
                if not driver_features_ok(value) {
                    return DRIVER_EXIT_USAGE
                }
                features = value
            } else if arg.equals("-o") {
                out = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("-") || path.len() > 0 {
            return driver_usage()
        } else {
            path = arg
        }
        i = i + 1
    }
    if path.len() == 0 || (emit && out.len() > 0) {
        return driver_usage()
    }
    let codegen = driver_codegen_choice(units, lto, speed)
    if codegen.0.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    let split = codegen.0.equals("module")
    lto = codegen.1
    let cache_entries = driver_cache_choice()
    if cache_entries < 0 {
        return DRIVER_EXIT_USAGE
    }
    let front_on = driver_front_choice("sawc build", no_front)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    if triple.len() > 0 && not target_known(triple) {
        print("sawc: unknown target {triple}")
        return DRIVER_EXIT_USAGE
    }
    if target_bare_metal(triple) && not (object || emit || freestanding) {
        print("sawc build: {} is a bare-metal target, with no C library or runtime for sawc to link a program against: `-c` writes an object to link yourself, and `--freestanding` checks a program against the profile a kernel builds under", triple)
        return DRIVER_EXIT_USAGE
    }
    std_root = driver_std_root("sawc build", std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    // A freestanding build writes an object and links nothing.
    if freestanding {
        object = true
    }
    var objects = Vector<String>()
    var clang = StringBuilder()
    var objcopy = StringBuilder()
    if emit && triple.len() == 0 {
        triple = driver_read_runtime("sawc build", &var objects, &var clang, &var objcopy)
        if triple.len() == 0 {
            print("sawc build: --emit-ll without --target writes the host's module, which the manifest names")
            return DRIVER_EXIT_USAGE
        }
    }
    var host = ""
    if not emit {
        host = driver_read_runtime("sawc build", &var objects, &var clang, &var objcopy)
        if host.len() == 0 {
            return DRIVER_EXIT_USAGE
        }
        if triple.len() == 0 {
            triple = host
        }
    }
    if freestanding && target_mach_o(triple) {
        return driver_refuse_mach_o(path, triple)
    }
    let written_features = features
    features = target_effective_features(triple, features, freestanding)
    var front = driver_front(std_root, target_front_end(triple, features), false, freestanding, provider,
                             front_on == 1, timed)
    let plan = driver_plan(&front, path, &names, &dirs)
    if emit {
        let emitting = BuildOptions(std_root: std_root, target: triple, speed: speed,
                                    module_triple: target_clang_triple(triple), runtime: false,
                                    freestanding: freestanding, provider: provider, no_hidden_alloc: hidden,
                                    sanitize_address: sanitize, debug_info: debug, features: features, object: object)
        return driver_emit(path, &var front, &plan, &emitting, warn)
    }
    // Another target links against its own runtime, which a manifest of its
    // own names once build.py's clang check has passed for it; the host's
    // objects never reach that link (compiler/tests/run/README.md). A
    // bare-metal target's record names its clang and no object, since only
    // an object build reaches here for it. A freestanding object and a
    // provider for another hosted target need no runtime, so the host's clang
    // compiles them when that target has no manifest of its own.
    let cross = not triple.equals(host)
    var foreign = Vector<String>()
    var foreign_clang = StringBuilder()
    var foreign_objcopy = StringBuilder()
    if cross {
        let configured = driver_read_target_runtime(triple, &var foreign, &var foreign_clang, &var foreign_objcopy)
        if not configured.equals(triple) && target_bare_metal(triple) {
            print("sawc build: --target {} has no clang configured to compile for it: compiler/tools/build.py records one on every build, the one SAWC_CLANG names or else the first that compiles IR for that target of each clang-NN on PATH (the newest first), clang, and Homebrew's LLVM clang ($HOMEBREW_PREFIX/opt/llvm/bin/clang, /opt/homebrew when unset), and found none (`compiler/tools/build.py --runtime {}` says why)", triple, triple)
            return 1
        }
        if not configured.equals(triple) && (freestanding || provider) {
            try! foreign_clang.append(clang.build())
            try! foreign_objcopy.append(objcopy.build())
        } else if not configured.equals(triple) {
            print("sawc build: --target {} is not this host ({}), and no runtime for it is configured: `compiler/tools/build.py --runtime {}` builds one where a clang passes the opaque-pointer check for that target and its C headers compile shim.c; `sawc mono --layouts --target {}` describes its layouts", triple, host, triple, triple)
            return 1
        }
    }
    if out.len() == 0 {
        out = driver_default_output(path)
    }
    if object && not out.ends_with(".o") {
        var named = StringBuilder()
        try! named.append(out)
        try! named.append(".o")
        out = named.build()
    }
    let clang_triple = target_clang_triple(triple)
    let options = BuildOptions(std_root: std_root, target: triple, speed: speed, module_triple: clang_triple,
                               runtime: false, freestanding: freestanding, provider: provider,
                               no_hidden_alloc: hidden, sanitize_address: sanitize, debug_info: debug,
                               features: features, object: object)
    var record = StringBuilder()
    var ir = StringBuilder()
    let compiler = if cross { foreign_clang.build() } else { clang.build() }
    if written_features.len() > 0 {
        let named = driver_check_feature_names(compiler, clang_triple, triple, features, out)
        if named != 0 {
            return named
        }
    }
    let whole = driver_front_chain(&var front, &plan, true, hidden)
    if warn {
        driver_print_warnings(path, &whole.drops.bc.mir.tc)
    }
    var exports = Vector<String>()
    var unit_plan = LlUnitPlan()
    let built = llvm_build_exporting(out: &var record, ir: &var ir, exports: &var exports, plan: &var unit_plan,
                                     split: split, front: move whole, options: &options)
    if split {
        if built != 0 {
            driver_print_refusal(path, &var record)
            return built
        }
        // An ASan unit's object names the path clang reads it at, which no
        // key holds, so a sanitized build is never cached.
        let objects_kind = driver_object_kind()
        let cache = if no_cache || sanitize || cache_entries == 0 { "" } else { driver_cache_directory(&objects_kind) }
        let job = DriverSplit(clang: compiler, triple: clang_triple, speed: speed, sanitize: sanitize,
                              freestanding: freestanding, debug: debug, object: object, lto: lto, out: out,
                              jobs: driver_jobs(out), timed: timed,
                              bare_metal: freestanding || target_bare_metal(triple),
                              objcopy: if cross { foreign_objcopy.build() } else { objcopy.build() },
                              cache: cache, cache_entries: cache_entries)
        if object && not target_mach_o(triple) && job.objcopy.len() == 0 {
            print("sawc build: a split -c object for {} needs llvm-objcopy to make its codegen units' hidden symbols local, and the target's record names none: compiler/tools/build.py records the one `clang -print-prog-name=llvm-objcopy` names, else llvm-objcopy or llvm-objcopy-NN on PATH, else Homebrew LLVM's; install LLVM's binary tools (Homebrew's `llvm`, Debian's `llvm-NN`) and run it again, or build with --codegen-units=1", triple)
            return 1
        }
        let text = ir.build()
        if provider {
            let none = Vector<String>()
            return driver_split_build(&job, &unit_plan, &text, &none)
        }
        if cross {
            return driver_split_build(&job, &unit_plan, &text, &foreign)
        }
        return driver_split_build(&job, &unit_plan, &text, &objects)
    }
    if built != 0 {
        driver_print_refusal(path, &var record)
        return built
    }
    var ll = StringBuilder()
    try! ll.append(out)
    try! ll.append(".ll")
    let ll_path = ll.build()
    stagetime_begin(StageTime.WriteLl)
    let written = driver_write_file(ll_path, ir.build())
    stagetime_end(StageTime.WriteLl)
    if not written {
        return 1
    }
    if object {
        let arguments = driver_object_arguments(clang_triple, speed, sanitize, freestanding, "none", ll_path, out)
        stagetime_begin(StageTime.Clang)
        let compiled = driver_clang("sawc build", compiler, &arguments)
        stagetime_end(StageTime.Clang)
        return compiled
    }
    let link = DriverLink(clang: compiler, ll: ll_path, out: out, speed: speed, sanitize: sanitize,
                          triple: clang_triple, debug: debug)
    // A provider is its own runtime: none of sawc's objects join its link.
    if provider {
        let none = Vector<String>()
        return driver_link(&link, &none)
    }
    if cross {
        return driver_link(&link, &foreign)
    }
    driver_link(&link, &objects)
}

// `sawc build --emit-ll FILE`: the program's `.ll` on standard output, or
// the record of what refused it and its status.
func driver_emit(path: String, front: &var DriverFront, plan: &ResLayerPlan, options: &BuildOptions,
                 warn: Bool) -> Int {
    var record = StringBuilder()
    var ir = StringBuilder()
    let whole = driver_front_chain(&var front, &plan, true, options.no_hidden_alloc)
    if warn {
        driver_print_warnings(path, &whole.drops.bc.mir.tc)
    }
    var exports = Vector<String>()
    var units = LlUnitPlan()
    let status = llvm_build_exporting(out: &var record, ir: &var ir, exports: &var exports, plan: &var units,
                                      split: false, front: move whole, options: &options)
    if status != 0 {
        driver_print_refusal(path, &var record)
        return status
    }
    print(ir.build())
    0
}

// Refuses a freestanding build for the Mach-O triple `triple`, printing the
// record a refusal prints and returning 1: the profile places each function
// in a section of its own for a kernel's linker to collect, which Mach-O's
// section names cannot spell. The ELF triples it names are the bare-metal
// ones sawc describes (`target_bare_metal`).
func driver_refuse_mach_o(path: String, triple: String) -> Int {
    var record = StringBuilder()
    try! record.append("FILE\t")
    try! record.append(path)
    try! record.append("\nERROR\tdriver.freestanding-mach-o\t")
    try! record.append(path)
    try! record.append(":1:1\t`--freestanding` cannot target the Mach-O triple `")
    try! record.append(triple)
    try! record.append("`: the freestanding profile writes an ELF object, each function in a section of its own, and Mach-O names a section by segment; build for a bare-metal ELF triple instead:")
    let known = target_triples()
    var k = 0
    while k < known.len() {
        let one = known.get(k) ?? ""
        if target_bare_metal(one) {
            try! record.append(" `--target ")
            try! record.append(one)
            try! record.append("`")
        }
        k = k + 1
    }
    try! record.append("\n")
    print(record.build())
    1
}

// Whether `category`, the operand of `-W`, names a warning category sawc
// has; one it lacks is a usage error, the usage printed first as for any
// other. `borrow-prefix` is the one so far (SL-879 adds the rest).
func driver_warning_category(category: String) -> Bool {
    if category.equals("borrow-prefix") {
        return true
    }
    let _ = driver_usage()
    print("sawc: -W takes a warning category, and `borrow-prefix` is the one sawc has, not `{}`", category)
    false
}

// The warnings `-W borrow-prefix` asks a build of `path` for, from `p`, the
// program the build checked, headed by the file, printed when there are any.
// They never change the exit status.
func driver_print_warnings(path: String, p: &TcProgram) {
    var found = StringBuilder()
    append_tc_warnings(out: &var found, p: &p)
    let text = found.build()
    if text.len() == 0 {
        return
    }
    var record = StringBuilder()
    try! record.append("FILE\t")
    try! record.append(path)
    try! record.append("\n")
    try! record.append(text)
    print(record.build())
}

// Prints the record `sawc mono --check` would, headed by its file.
func driver_print_refusal(path: String, found: &var StringBuilder) {
    try! found.append("\n")
    var record = StringBuilder()
    try! record.append("FILE\t")
    try! record.append(path)
    try! record.append("\n")
    try! record.append(found.build())
    print(record.build())
}

// `.build/NAME` for the entry file `path`, NAME its file name without `.saw`.
func driver_default_output(path: String) -> String {
    driver_path(".build", driver_stem(path), "")
}

// The host target the runtime manifest beside this binary names, with the
// clang it names appended to `clang` and its objects added to `objects`; ""
// once the reason it cannot be read is printed, headed by `command`. This is
// how sawc knows its host. The manifest is `sawc-runtime.txt` in the
// directory of the executable this process runs from, its real path, since
// `argv[0]` names a bare command found through `PATH` or a symbolic link: a
// `target TRIPLE` line, a `clang PATH` line naming the clang that passed the
// opaque-pointer check, then an `object PATH` line per runtime object, and an
// `objcopy PATH` line naming its llvm-objcopy when build.py found one,
// appended to `objcopy` (compiler/tools/build.py writes it).
func driver_read_runtime(command: String, objects: &var Vector<String>, clang: &var StringBuilder,
                         objcopy: &var StringBuilder) -> String {
    let at = driver_beside_binary(command, "sawc-runtime.txt")
    if at.len() == 0 {
        return ""
    }
    guard let text = driver_read_source(at) else {
        print("{}: no runtime manifest beside the binary; compiler/tools/build.py writes it", command)
        return ""
    }
    driver_parse_manifest(command, at, text, &var objects, &var clang, &var objcopy)
}

// The target the runtime manifest of another target `triple` names, read as
// `driver_read_runtime` reads the host's: `sawc-runtime-TRIPLE.txt` beside
// this binary, which `compiler/tools/build.py --runtime TRIPLE` writes only
// once its clang passes the opaque-pointer check for that target, and every
// stage build writes for a bare-metal target, naming no object, since it has
// no runtime. "" when there is none, which is no error: that target is
// simply not configured.
func driver_read_target_runtime(triple: String, objects: &var Vector<String>, clang: &var StringBuilder,
                                objcopy: &var StringBuilder) -> String {
    var name = StringBuilder()
    try! name.append("sawc-runtime-")
    try! name.append(triple)
    try! name.append(".txt")
    let at = driver_beside_binary("sawc build", name.build())
    if at.len() == 0 {
        return ""
    }
    let opened = File.open(Path(s: at))
    match opened {
        case Ok(_) -> {},
        case Err(_) -> {
            return ""
        }
    }
    guard let text = driver_read_source(at) else {
        return ""
    }
    driver_parse_manifest("sawc build", at, text, &var objects, &var clang, &var objcopy)
}

// The path of the file `name` in the directory of the executable this process
// runs from, its real path; "" once the reason it cannot be found is printed.
func driver_beside_binary(command: String, name: String) -> String {
    let found = Env.executable_path()
    let binary = match found {
        case Ok(path) -> path,
        case Err(e) -> {
            print("{}: cannot find this executable's path: {}", command, e)
            return ""
        }
    }
    driver_path(driver_parent(binary), name, "")
}

// The std root a command compiles against: `given`, the `--std-root` it was
// handed, as written; with none, the `std/` of the sawlang tree this binary
// was built in, so the default never depends on the working directory. Either
// must hold a std (`prelude.saw` for the new std, `builtin.saw` for Stage 0's
// frozen one), since a root holding neither would compile against no std at
// all. "" once the refusal is printed, headed by `command`.
// ENTRY POINTS:
//     driver_build
//     driver_resolve
//     driver_mono
//     driver_coro
//     driver_runtime
func driver_std_root(command: String, given: String) -> String {
    if given.len() > 0 {
        let new_std = driver_file_exists(driver_path(given, "prelude.saw", ""))
        let frozen_std = driver_file_exists(driver_path(given, "builtin.saw", ""))
        if new_std || frozen_std {
            return given
        }
        print("{}: --std-root {} holds no std: neither prelude.saw (the new std) nor builtin.saw (Stage 0's frozen std) is there", command, given)
        return ""
    }
    let root = driver_sawlang_root(command)
    if root.len() == 0 {
        return ""
    }
    let found = driver_path(root, "std", "")
    if not driver_file_exists(driver_path(found, "prelude.saw", "")) {
        print("{}: no std at {}: the sawlang tree this binary was built in holds no std/prelude.saw; pass --std-root DIR", command, found)
        return ""
    }
    found
}

// The runtime root `sawc runtime` reads its sources from: `given`, the
// `--rt-root` it was handed, as written; with none, the `runtime/` of the
// sawlang tree this binary was built in. "" once the reason is printed.
func driver_rt_root(command: String, given: String) -> String {
    if given.len() > 0 {
        return given
    }
    let root = driver_sawlang_root(command)
    if root.len() == 0 {
        return ""
    }
    driver_path(root, "runtime", "")
}

// The sawlang tree this binary was built in: the parent of the directory
// holding the executable's real path, since build.py links each stage into
// the `.build/` of the tree it builds. "" once the reason it cannot be found
// is printed, headed by `command`.
// ENTRY POINTS:
//     driver_std_root
//     driver_rt_root
func driver_sawlang_root(command: String) -> String {
    let found = Env.executable_path()
    let binary = match found {
        case Ok(path) -> path,
        case Err(e) -> {
            print("{}: cannot find this executable's path: {}", command, e)
            return ""
        }
    }
    driver_parent(driver_parent(binary))
}

// `path` without its last `/` and what follows it: "." when it has none, and
// "/" for a name directly under the root.
func driver_parent(path: String) -> String {
    var slash = 0 - 1
    var i = 0
    while i < path.len() {
        if (path.byte_at(i) as Int) == DRIVER_SLASH {
            slash = i
        }
        i = i + 1
    }
    if slash < 0 {
        return "."
    }
    if slash == 0 {
        return "/"
    }
    path.substring(0, slash)
}

// Whether the file at `path` opens for reading.
func driver_file_exists(path: String) -> Bool {
    let opened = File.open(Path(s: path))
    match opened {
        case Ok(_) -> true,
        case Err(_) -> false
    }
}

// The target a runtime manifest's `text`, read from `at`, names, its clang
// appended to `clang`, its llvm-objcopy, which a record names when build.py
// found one, appended to `objcopy`, and its objects added to
// `objects`; "" once what is wrong with it is printed.
func driver_parse_manifest(command: String, at: String, text: String, objects: &var Vector<String>,
                           clang: &var StringBuilder, objcopy: &var StringBuilder) -> String {
    var host = ""
    var named = false
    var start = 0
    var k = 0
    while k <= text.len() {
        if k == text.len() || (text.byte_at(k) as Int) == DRIVER_NEWLINE {
            if k > start {
                let line = text.substring(start, k)
                if line.starts_with("target ") {
                    host = text.substring(start + 7, k)
                } else if line.starts_with("clang ") {
                    try! clang.append(text.substring(start + 6, k))
                    named = true
                } else if line.starts_with("object ") {
                    try! objects.push(text.substring(start + 7, k))
                } else if line.starts_with("objcopy ") {
                    try! objcopy.append(text.substring(start + 8, k))
                } else {
                    print("{}: {}: unknown line `{}`", command, at, line)
                    return ""
                }
            }
            start = k + 1
        }
        k = k + 1
    }
    if host.len() == 0 || not target_known(host) {
        print("{}: {} names no target sawc knows", command, at)
        return ""
    }
    if not named {
        print("{}: {} names no clang; compiler/tools/build.py writes the one it chose", command, at)
        return ""
    }
    host
}

// Writes `text` to the file at `path`, or prints why it could not and
// returns false.
func driver_write_file(path: String, text: String) -> Bool {
    let created = File.create(Path(s: path))
    var file = match created {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("sawc: cannot create {path}: {e}")
            return false
        }
    }
    let converted = text.to_data()
    let data = match converted {
        case Ok(bytes) -> bytes,
        case Err(e) -> {
            print("sawc: cannot write {path}: {e}")
            return false
        }
    }
    let written = file.write(data)
    match written {
        case Ok(count) -> {
            if count != text.len() {
                print("sawc: {}: wrote {} of {} bytes", path, count, text.len())
                return false
            }
        },
        case Err(e) -> {
            print("sawc: cannot write {path}: {e}")
            return false
        }
    }
    // Stage 0 workaround (SL:hazards S28): canonical: var out = BufferedFile(move file); try out.write(text) — its deinit flushes and closes the file
    let closed = file.close()
    match closed {
        case Ok(_) -> true,
        case Err(e) -> {
            print("sawc: cannot close {path}: {e}")
            false
        }
    }
}

// What `driver_link` links: with `clang`, the module `ll` into the
// executable `out` at the speed flag `speed`, for the clang triple `triple`;
// `sanitize` asks clang to instrument the module's `sanitize_address`
// functions and link AddressSanitizer's runtime, and `debug` says the module
// carries line tables.
struct DriverLink {
    clang: String
    ll: String
    out: String
    speed: String
    sanitize: Bool
    triple: String
    debug: Bool
}

// Links `link`'s module with `objects` and the target's libraries, and
// returns the build's exit status, or 1 once the reason it could not is
// printed. One clang run does it, `CLANG -target TRIPLE SPEED
// [-fsanitize=address] -x ir LL -x none OBJECTS... LIBRARIES... -o OUT`, and
// an ELF executable keeps the module's DWARF itself. A Mach-O executable
// keeps only a debug map naming the object its DWARF is in, so a module with
// line tables links there through `driver_link_mach_o`. compiler/tools/
// build.py's `link_module` links as this does, and must agree with it.
func driver_link(link: &DriverLink, objects: &Vector<String>) -> Int {
    if link.debug && driver_mach_o(link.triple) {
        return driver_link_mach_o(&link, &objects)
    }
    var arguments = driver_link_head(&link)
    try! arguments.push("-x")
    try! arguments.push("ir")
    try! arguments.push(link.ll)
    try! arguments.push("-x")
    try! arguments.push("none")
    driver_link_tail(&var arguments, &link, &objects)
    stagetime_begin(StageTime.ClangLink)
    let status = driver_clang("sawc build", link.clang, &arguments)
    stagetime_end(StageTime.ClangLink)
    status
}

// The Mach-O link of a module with line tables, which is reproducible, since
// the fixpoint needs Stage 3 to be Stage 2 byte for byte. The module is
// compiled to `OUT.o` beside the output; the link takes `-reproducible`, and
// cuts the output's directory from the object path the debug map records, so
// the binary names neither a temporary object nor where it was built; then
// dsymutil writes `OUT.dSYM`, which a debugger and the crash reporter read,
// and the object is removed. A step that fails fails the build, since a
// binary whose line tables were lost is not what was asked for.
func driver_link_mach_o(link: &DriverLink, objects: &Vector<String>) -> Int {
    let dir = driver_output_directory(link.out)
    if dir.len() == 0 {
        return 1
    }
    let base = driver_base_name(link.out)
    let object = driver_path(dir, base, ".o")
    let compile = driver_object_arguments(link.triple, link.speed, link.sanitize, false, "none", link.ll, object)
    stagetime_begin(StageTime.Clang)
    let compiled = driver_clang("sawc build", link.clang, &compile)
    stagetime_end(StageTime.Clang)
    if compiled != 0 {
        return compiled
    }
    let problem = driver_linker_problem(link.clang, link.out)
    if problem.len() > 0 {
        print("sawc build: {}", problem)
        return 1
    }
    var arguments = driver_link_head(&link)
    try! arguments.push(object)
    try! arguments.push("-Wl,-reproducible")
    var prefix = StringBuilder()
    try! prefix.append("-Wl,-oso_prefix,")
    try! prefix.append(dir)
    try! prefix.append("/")
    try! arguments.push(prefix.build())
    driver_link_tail(&var arguments, &link, &objects)
    stagetime_begin(StageTime.Link)
    let linked = driver_clang("sawc build", link.clang, &arguments)
    stagetime_end(StageTime.Link)
    if linked != 0 {
        return linked
    }
    let dsymutil = driver_clang_tool(link.clang, "dsymutil", link.out)
    if dsymutil.len() == 0 {
        return 1
    }
    var bundle = StringBuilder()
    try! bundle.append(link.out)
    try! bundle.append(".dSYM")
    var symbols = Vector<String>()
    try! symbols.push("--oso-prepend-path")
    try! symbols.push(dir)
    try! symbols.push(link.out)
    try! symbols.push("-o")
    try! symbols.push(bundle.build())
    stagetime_begin(StageTime.Dsymutil)
    let written = driver_tool("sawc build", "dsymutil", dsymutil, &symbols)
    stagetime_end(StageTime.Dsymutil)
    if written != 0 {
        print("sawc build: dsymutil wrote no {}.dSYM, the line tables a debugger and the crash reporter read; -g0 builds without them", link.out)
        return 1
    }
    match File.remove(Path(s: object)) {
        case Ok(_) -> 0,
        case Err(e) -> {
            print("sawc build: cannot remove {}, the object the .dSYM was written from: {}", object, e)
            1
        }
    }
}

// The codegen units a build asks for and the link-time optimisation of a split
// one, as (`1` or `module`, `thin`, `full` or `none`); ("", "") once a usage
// error is printed. `--codegen-units=` and `--lto=` win; without them,
// `SAWC_CODEGEN_UNITS` and `SAWC_LTO`, which let a lane build every program
// one way. A split build's link optimises across its units with ThinLTO
// unless it is `-O0`; a whole-module build is already one unit, so `--lto`
// takes a split one.
func driver_codegen_choice(flag_units: String, flag_lto: String, speed: String) -> (String, String) {
    var units = flag_units
    if units.len() == 0 {
        units = driver_environment("SAWC_CODEGEN_UNITS")
    }
    if units.len() == 0 {
        units = "1"
    }
    if not (units.equals("1") || units.equals("module")) {
        print("sawc build: --codegen-units takes `1`, the whole program as one module, or `module`, one per Saw module, not `{}`", units)
        return ("", "")
    }
    var lto = flag_lto
    if lto.len() > 0 && units.equals("1") {
        print("sawc build: --lto takes a split build (--codegen-units=module): a whole-module build already optimises the whole program as one module")
        return ("", "")
    }
    if lto.len() == 0 {
        lto = driver_environment("SAWC_LTO")
    }
    if lto.len() == 0 {
        lto = if speed.equals("-O0") { "none" } else { "thin" }
    }
    if not (lto.equals("thin") || lto.equals("full") || lto.equals("none")) {
        print("sawc build: --lto takes `thin`, `full` or `none`, not `{}`", lto)
        return ("", "")
    }
    (units, lto)
}

// The value of environment variable `name`, or "" when it is unset or holds
// no text.
func driver_environment(name: String) -> String {
    match Env.get(name) {
        case Ok(value) -> value ?? "",
        case Err(_) -> ""
    }
}


// The clang flag of link-time optimisation `lto`, `thin` or `full`.
func driver_lto_flag(lto: String) -> String {
    var flag = StringBuilder()
    try! flag.append("-flto=")
    try! flag.append(lto)
    flag.build()
}

// A freestanding object's code generation flags (`driver_object_arguments`),
// which a link that optimises its units passes again for the code it writes.
func driver_freestanding_arguments(arguments: &var Vector<String>, freestanding: Bool) {
    if freestanding {
        try! arguments.push("-ffunction-sections")
        try! arguments.push("-fdata-sections")
        try! arguments.push("-fno-pic")
    }
}

// The most clang runs a split build keeps going at once: three quarters of
// the machine's processors, at least one, the ceiling every test lane keeps
// to; `SAW_GATE_JOBS`, when it names a positive count, lowers it, which a
// lane running builds side by side sets. The processors are what `getconf
// _NPROCESSORS_ONLN` reports; when it cannot be asked the build says so and
// runs one at a time.
func driver_jobs(out: String) -> Int {
    var arguments = Vector<String>()
    try! arguments.push("_NPROCESSORS_ONLN")
    var cpus = 0
    if let said = driver_captured(out, "getconf", "getconf", &arguments) {
        cpus = driver_first_line(said).to_int() ?? 0
    }
    if cpus <= 0 {
        print("sawc build: getconf reports no processor count, so the codegen units compile one at a time")
        return 1
    }
    var ceiling = cpus * 3 / 4
    if ceiling < 1 {
        ceiling = 1
    }
    let asked = driver_environment("SAW_GATE_JOBS").to_int() ?? 0
    if asked > 0 && asked < ceiling {
        return asked
    }
    ceiling
}

// What a split build compiles and links: with `clang`, each unit for the
// clang triple `triple` at `speed`, instrumented under `sanitize`, as a
// `freestanding` object's when it is one, with line tables under `debug`;
// then an object (`object`) or the executable `out`, optimised across the
// units as `lto` says, `jobs` clang runs at once; under `timed`, a time line
// per unit. `bare_metal` is a freestanding object's or a bare-metal target's,
// which links with `ld.lld`. `objcopy` is the target's llvm-objcopy, or "".
// `cache` is the object cache's directory, "" when the build uses none, and
// `cache_entries` the most entries it keeps (`driver_cache_choice`).
struct DriverSplit {
    clang: String
    triple: String
    speed: String
    sanitize: Bool
    freestanding: Bool
    debug: Bool
    object: Bool
    lto: String
    out: String
    jobs: Int
    timed: Bool
    bare_metal: Bool
    objcopy: String
    cache: String
    cache_entries: Int
}

// One run of a tool, which `driver_run_jobs` takes in turn.
struct DriverJob {
    tool: String
    program: String
    arguments: Vector<String>
}

extension DriverJob: NoCopy {}

// A finished job: its index, its exit status and how long it ran.
struct DriverDone {
    job: Int
    status: Int
    nanos: Int
}

extern "C" {
    func __saw_rt_write_error(ptr: UnsafePointer<Int8>, len: Int)
}

// `sawc build --codegen-units=module`: the program's `.ll`, `text`, written to
// `OUT.ll` as a whole-module build writes it, and cut by `plan` into one
// module per Saw module (`ll_split`), each written to `OUT.units/uN.ll` and
// compiled by clang, `split.jobs` at a time, then
// linked with `objects` into the executable `OUT`, or for `-c` into the one
// object `OUT` by a relocatable link (`driver_split_link`). A unit whose key
// the object cache holds takes its object from there and is not compiled, and
// each one compiled is stored (`driver_cache_fetch`, `driver_cache_store`).
// The unit objects are removed once linked. A clang that fails fails the
// build with its exit status; with `--time-stages` each unit's compile time,
// or `cached` and its fetch time, is a line of its own, in unit order, and
// the cache's own work one more.
func driver_split_build(split: &DriverSplit, plan: &LlUnitPlan, text: &String, objects: &Vector<String>) -> Int {
    var whole = StringBuilder()
    try! whole.append(split.out)
    try! whole.append(".ll")
    stagetime_begin(StageTime.WriteLl)
    let written = driver_write_file(whole.build(), text)
    stagetime_end(StageTime.WriteLl)
    if not written {
        return 1
    }
    let started = time.Instant.now()
    var problems = Vector<String>()
    let units = ll_split(&text, &plan, &var problems)
    if split.timed {
        driver_time_line("split", started.elapsed().as_nanos() as Int)
    }
    if problems.len() > 0 {
        var k = 0
        while k < problems.len() {
            print("sawc build: INVARIANT: {}", problems.get(k) ?? "")
            k = k + 1
        }
        return 1
    }
    var named = StringBuilder()
    try! named.append(split.out)
    try! named.append(".units")
    let dir = named.build()
    if not Directory.exists(Path(s: dir)) {
        match Directory.create(Path(s: dir)) {
            case Ok(_) -> {},
            case Err(e) -> {
                print("sawc build: cannot create {}, where the codegen units are written: {}", dir, e)
                return 1
            }
        }
    }
    stagetime_begin(StageTime.WriteLl)
    var compiled = Vector<String>()
    var lls = Vector<String>()
    var k = 0
    while k < units.len() {
        var stem = StringBuilder()
        try! stem.append("u")
        try! stem.append(k)
        let ll = driver_path(dir, stem.build(), ".ll")
        if not driver_write_file(ll, units[k].text) {
            stagetime_end(StageTime.WriteLl)
            return 1
        }
        try! lls.push(ll)
        try! compiled.push(driver_path(dir, stem.build(), ".o"))
        k = k + 1
    }
    stagetime_end(StageTime.WriteLl)
    // Each unit's key, and the time its object took to fetch from the cache,
    // or -1 for a unit clang compiles.
    let looking = time.Instant.now()
    let cache = driver_cache_open(&split)
    var keys = Vector<String>()
    var fetched = Vector<Int>()
    var jobs = Vector<DriverJob>()
    var compiling = Vector<Int>()
    k = 0
    while k < units.len() {
        let fetching = time.Instant.now()
        var key = ""
        var hit = false
        if cache.dir.len() > 0 {
            key = driver_object_key(&cache, &units[k].text)
            hit = driver_cache_fetch(&cache, key, compiled[k])
        }
        try! keys.push(key)
        if hit {
            try! fetched.push(fetching.elapsed().as_nanos() as Int)
        } else {
            try! fetched.push(0 - 1)
            let arguments = driver_object_arguments(split.triple, split.speed, split.sanitize, split.freestanding,
                                                    split.lto, lls[k], compiled[k])
            try! jobs.push(DriverJob(tool: "clang", program: split.clang, arguments: move arguments))
            try! compiling.push(k)
        }
        k = k + 1
    }
    var cache_nanos = looking.elapsed().as_nanos() as Int
    stagetime_begin(StageTime.Clang)
    let done = driver_run_jobs(&jobs, split.jobs)
    stagetime_end(StageTime.Clang)
    var status = 0
    var compile_nanos = Vector<Int>()
    k = 0
    while k < units.len() {
        try! compile_nanos.push(0)
        k = k + 1
    }
    k = 0
    while k < done.len() {
        compile_nanos[compiling[done[k].job]] = done[k].nanos
        if done[k].status != 0 && status == 0 {
            status = done[k].status
        }
        k = k + 1
    }
    if split.timed {
        k = 0
        while k < units.len() {
            var line = StringBuilder()
            try! line.append("clang unit ")
            try! line.append(units[k].name)
            if fetched[k] >= 0 {
                try! line.append(" cached")
                driver_time_line(line.build(), fetched[k])
            } else {
                driver_time_line(line.build(), compile_nanos[k])
            }
            k = k + 1
        }
    }
    if status != 0 {
        return status
    }
    if cache.dir.len() > 0 {
        let storing = time.Instant.now()
        k = 0
        while k < compiling.len() {
            let u = compiling[k]
            driver_cache_store(&cache, keys[u], compiled[u])
            k = k + 1
        }
        driver_cache_rotate(&cache)
        cache_nanos = cache_nanos + (storing.elapsed().as_nanos() as Int)
    }
    if split.timed && cache.dir.len() > 0 {
        driver_time_line("object cache", cache_nanos)
    }
    let linked = driver_split_link(&split, dir, &compiled, &objects, &plan.exports, cache.thinlto)
    if linked != 0 {
        return linked
    }
    k = 0
    while k < compiled.len() {
        let one = compiled.get(k) ?? ""
        match File.remove(Path(s: one)) {
            case Ok(_) -> {},
            case Err(e) -> {
                print("sawc build: cannot remove {}, a codegen unit's object: {}", one, e)
                return 1
            }
        }
        k = k + 1
    }
    0
}

// Links the unit objects `compiled` of the split build `split`, whose units
// sit in `dir`. An object build is one relocatable link of them, `-r`, which a
// bare-metal ELF target does with `ld.lld`; an executable is linked with `objects` and the
// target's libraries as `driver_link` links one module, and on Mach-O with
// line tables as `driver_link_mach_o` does, the LTO objects kept in
// `DIR/lto` for dsymutil and removed after it. Under `lto` the link
// optimises across the units (`-flto=`), with as many jobs as the compiles,
// and keeps the C symbols `exports` global; a ThinLTO link keeps its
// per-module results in `thinlto` when it names a directory
// (`driver_thinlto_cache_arguments`).
func driver_split_link(split: &DriverSplit, dir: String, compiled: &Vector<String>, objects: &Vector<String>,
                       exports: &Vector<String>, thinlto: String) -> Int {
    let link = DriverLink(clang: split.clang, ll: "", out: split.out, speed: split.speed, sanitize: split.sanitize,
                          triple: split.triple, debug: split.debug)
    let mach_o = driver_mach_o(split.triple)
    var arguments = driver_link_head(&link)
    if split.object {
        try! arguments.push("-r")
        try! arguments.push("-nostdlib")
    }
    if not split.lto.equals("none") {
        try! arguments.push(driver_lto_flag(split.lto))
        var jobs = StringBuilder()
        try! jobs.append("-flto-jobs=")
        try! jobs.append(split.jobs)
        try! arguments.push(jobs.build())
        driver_freestanding_arguments(&var arguments, split.freestanding)
        if split.lto.equals("thin") && thinlto.len() > 0 {
            driver_thinlto_cache_arguments(&var arguments, thinlto, mach_o)
        }
        // LTO would make an executable's global symbols local, `@export`s
        // among them, where a whole-module link keeps each global (so `dlsym`
        // finds one). Naming exactly the exports keeps them and leaves every
        // other symbol the link's to internalize.
        if not split.object {
            var x = 0
            while x < exports.len() {
                try! arguments.push(driver_export_argument(exports.get(x) ?? "", mach_o))
                x = x + 1
            }
        }
    }
    // A bare-metal target has no system linker, and a hosted ELF one's may
    // have no LTO plugin.
    if not mach_o && (split.bare_metal || not split.lto.equals("none")) {
        try! arguments.push("-fuse-ld=lld")
    }
    var k = 0
    while k < compiled.len() {
        try! arguments.push(compiled.get(k) ?? "")
        k = k + 1
    }
    if split.object {
        try! arguments.push("-o")
        try! arguments.push(split.out)
        stagetime_begin(StageTime.Link)
        var status = driver_clang("sawc build", split.clang, &arguments)
        // ELF's relocatable link keeps a hidden symbol global, where Mach-O's
        // makes it local; every unit's own definitions are hidden, so they
        // are made local as a whole-module object's internal ones are.
        if status == 0 && not mach_o {
            var localize = Vector<String>()
            try! localize.push("--localize-hidden")
            try! localize.push(split.out)
            status = driver_tool("sawc build", "llvm-objcopy", split.objcopy, &localize)
        }
        stagetime_end(StageTime.Link)
        return status
    }
    let lines = split.debug && mach_o
    var real_dir = ""
    var kept = ""
    if lines {
        real_dir = driver_output_directory(split.out)
        if real_dir.len() == 0 {
            return 1
        }
        let problem = driver_linker_problem(split.clang, split.out)
        if problem.len() > 0 {
            print("sawc build: {}", problem)
            return 1
        }
        try! arguments.push("-Wl,-reproducible")
        var prefix = StringBuilder()
        try! prefix.append("-Wl,-oso_prefix,")
        try! prefix.append(real_dir)
        try! prefix.append("/")
        try! arguments.push(prefix.build())
        if not split.lto.equals("none") {
            var units_dir = StringBuilder()
            try! units_dir.append(driver_base_name(split.out))
            try! units_dir.append(".units")
            kept = driver_path(driver_path(real_dir, units_dir.build(), ""), "lto", "")
            var path = StringBuilder()
            try! path.append("-Wl,-object_path_lto,")
            try! path.append(kept)
            try! arguments.push(path.build())
        }
    }
    driver_link_tail(&var arguments, &link, &objects)
    stagetime_begin(StageTime.Link)
    let linked = driver_clang("sawc build", split.clang, &arguments)
    stagetime_end(StageTime.Link)
    if linked != 0 || not lines {
        return linked
    }
    let dsymutil = driver_clang_tool(split.clang, "dsymutil", split.out)
    if dsymutil.len() == 0 {
        return 1
    }
    var bundle = StringBuilder()
    try! bundle.append(split.out)
    try! bundle.append(".dSYM")
    var symbols = Vector<String>()
    try! symbols.push("--oso-prepend-path")
    try! symbols.push(real_dir)
    try! symbols.push(split.out)
    try! symbols.push("-o")
    try! symbols.push(bundle.build())
    stagetime_begin(StageTime.Dsymutil)
    let written = driver_tool("sawc build", "dsymutil", dsymutil, &symbols)
    stagetime_end(StageTime.Dsymutil)
    if written != 0 {
        print("sawc build: dsymutil wrote no {}.dSYM, the line tables a debugger and the crash reporter read; -g0 builds without them", split.out)
        return 1
    }
    if kept.len() > 0 {
        return driver_remove_lto_objects(kept, split.lto)
    }
    0
}

// The linker flag that keeps C symbol `symbol` global through an LTO link:
// Mach-O names it with its leading underscore, ELF as written.
func driver_export_argument(symbol: String, mach_o: Bool) -> String {
    var flag = StringBuilder()
    if mach_o {
        try! flag.append("-Wl,-exported_symbol,_")
    } else {
        try! flag.append("-Wl,--export-dynamic-symbol=")
    }
    try! flag.append(symbol)
    flag.build()
}

// Removes the LTO objects a link kept at `kept` for dsymutil: under ThinLTO a
// directory of them, under full LTO one object.
func driver_remove_lto_objects(kept: String, lto: String) -> Int {
    if lto.equals("full") {
        return match File.remove(Path(s: kept)) {
            case Ok(_) -> 0,
            case Err(e) -> {
                print("sawc build: cannot remove {}, the LTO object the .dSYM was written from: {}", kept, e)
                1
            }
        }
    }
    let listed = Directory.list(Path(s: kept))
    let entries = match listed {
        case Ok(found) -> move found,
        case Err(e) -> {
            print("sawc build: cannot list {}, the LTO objects the .dSYM was written from: {}", kept, e)
            return 1
        }
    }
    var k = 0
    while k < entries.len() {
        let one = entries[k].as_string()
        k = k + 1
        match File.remove(Path(s: one)) {
            case Ok(_) -> {},
            case Err(e) -> {
                print("sawc build: cannot remove {}, an LTO object the .dSYM was written from: {}", one, e)
                return 1
            }
        }
    }
    match Directory.remove(Path(s: kept)) {
        case Ok(_) -> 0,
        case Err(e) -> {
            print("sawc build: cannot remove {}: {}", kept, e)
            1
        }
    }
}

// The object cache's default bound, in entries: a generation holds half of
// it, about six whole split builds of sawc (one entry per unit, 158 for
// sawc), so what a working tree builds stays cached across a rotation.
static DRIVER_CACHE_ENTRIES: Int = 2048
// The number an entry's header and every key's description carry; a change
// to either's layout takes the next one.
static DRIVER_CACHE_FORMAT: Int = 2
// The front cache's bound, in entries, std's images and the layers' parts
// alike: a generation holds half of it, and a build of sawc stores fifteen.
static DRIVER_FRONT_ENTRIES: Int = 256
// The most threads a command stores its computed layers on.
static DRIVER_STORE_THREADS: Int = 4
// The number a front entry's header and every front key's description carry.
static DRIVER_FRONT_FORMAT: Int = 1
// The furthest into an entry its header's line break may be:
// `sawc-object N KEY LENGTH DIGEST`, with a 64-digit key and digest.
static DRIVER_CACHE_HEADER_MAX: Int = 192
// The bytes of /dev/urandom an entry's temporary name carries.
static DRIVER_CACHE_TOKEN_BYTES: Int = 8
// How often a store tries again in the newest generation when rotations by
// other builds remove the one it writes into (`driver_cache_store`).
static DRIVER_CACHE_STORE_ATTEMPTS: Int = 3

// The most entries the object cache keeps: `SAWC_CACHE_ENTRIES`, else
// DRIVER_CACHE_ENTRIES; 0 when `SAWC_OBJECT_CACHE=off` turns the cache off
// for every build, as a lane may; -1 once a usage error is printed.
func driver_cache_choice() -> Int {
    let mode = driver_environment("SAWC_OBJECT_CACHE")
    if not (mode.len() == 0 || mode.equals("on") || mode.equals("off")) {
        print("sawc build: SAWC_OBJECT_CACHE takes `on` or `off`, not `{}`", mode)
        return 0 - 1
    }
    var entries = DRIVER_CACHE_ENTRIES
    let named = driver_environment("SAWC_CACHE_ENTRIES")
    if named.len() > 0 {
        entries = named.to_int() ?? 0
        if entries < 2 {
            print("sawc build: SAWC_CACHE_ENTRIES takes the most entries the object cache keeps, a count of at least 2, not `{}`", named)
            return 0 - 1
        }
    }
    if mode.equals("off") {
        return 0
    }
    entries
}

// Whether a command uses the std front cache: on unless `off`, its
// `--no-front-cache`, or `SAWC_FRONT_CACHE=off` says otherwise; 1 for on, 0
// for off, and -1 once a usage error is printed, headed by `command`.
func driver_front_choice(command: String, off: Bool) -> Int {
    let mode = driver_environment("SAWC_FRONT_CACHE")
    if not (mode.len() == 0 || mode.equals("on") || mode.equals("off")) {
        print("{}: SAWC_FRONT_CACHE takes `on` or `off`, not `{}`", command, mode)
        return 0 - 1
    }
    if off || mode.equals("off") {
        return 0
    }
    1
}

// The cache's directory: `SAWC_CACHE_DIR`, else `$XDG_CACHE_HOME/sawc`, else
// `$HOME/.cache/sawc`; "" once a warning says there is none, for a cache of
// `kind`.
func driver_cache_directory(kind: &DriverCacheKind) unsafe -> String {
    let named = driver_environment("SAWC_CACHE_DIR")
    if named.len() > 0 {
        return named
    }
    let xdg = driver_environment("XDG_CACHE_HOME")
    if xdg.len() > 0 {
        return driver_path(xdg, "sawc", "")
    }
    let home = driver_environment("HOME")
    if home.len() > 0 {
        return driver_path(driver_path(home, ".cache", ""), "sawc", "")
    }
    let what = kind.what
    let without = kind.without
    driver_cache_warning("no {what}: none of SAWC_CACHE_DIR, XDG_CACHE_HOME and HOME is set, so {without}")
    ""
}

// What a cache's entries are: the directory under the cache's root holding
// their generations, their file suffix, their first line's magic word and
// format, and whether that line records the body's SHA-256; and, for its
// warnings, the cache's name, what a build does instead of a fetch it cannot
// make, and what it does with no cache at all.
struct DriverCacheKind {
    under: String
    suffix: String
    magic: String
    format: Int
    digested: Bool
    what: String
    redo: String
    without: String
}

// The object cache's entries: one codegen unit's object each, its bytes'
// SHA-256 in its first line.
func driver_object_kind() -> DriverCacheKind {
    DriverCacheKind(under: "objects", suffix: ".o", magic: "sawc-object", format: DRIVER_CACHE_FORMAT,
                    digested: true, what: "object cache", redo: "compiling the unit",
                    without: "every unit is compiled")
}

// The front cache's entries: an image of std's cut, or one layer's part, each
// of which carries its own length and digest (`front_image_decode`,
// `front_part_decode`), so the entry's first line records no SHA-256 of its
// own.
func driver_front_kind() -> DriverCacheKind {
    DriverCacheKind(under: "front", suffix: ".img", magic: "sawc-front-entry", format: DRIVER_FRONT_FORMAT,
                    digested: false, what: "front cache", redo: "computing std's front end",
                    without: "std's front end is computed")
}

// A cache one build uses, of `kind`: `dir`, the generations of its entries,
// "" when the build uses none; for the object cache, `thinlto`, the ThinLTO
// link's own, and `clang` and `fingerprint`, which every object key covers;
// `entries`, the bound; and `token`, which names this build's temporary
// entries.
struct DriverCache {
    kind: DriverCacheKind
    dir: String
    thinlto: String
    clang: String
    fingerprint: String
    entries: Int
    token: String
}

// The object cache of the split build `split`, its directories made; one the
// build uses none of when `split` names none, or once a warning says why it
// cannot be used.
func driver_cache_open(split: &DriverSplit) unsafe -> DriverCache {
    let off = DriverCache(kind: driver_object_kind(), dir: "", thinlto: "", clang: "", fingerprint: "", entries: 0,
                          token: "")
    if split.cache.len() == 0 {
        return off
    }
    let objects = driver_path(split.cache, "objects", "")
    let thinlto = driver_path(split.cache, "thinlto", "")
    var problem = driver_make_directories(objects)
    if problem.len() == 0 {
        problem = driver_make_directories(thinlto)
    }
    if problem.len() > 0 {
        driver_cache_warning("no object cache: {problem}, so every unit is compiled")
        return off
    }
    guard let fingerprint = driver_cache_fingerprint(&split) else {
        driver_cache_warning("no object cache: `clang -###` does not describe the compile, so every unit is compiled")
        return off
    }
    DriverCache(kind: driver_object_kind(), dir: objects, thinlto: thinlto, clang: split.clang,
                fingerprint: fingerprint, entries: split.cache_entries, token: driver_cache_token())
}

// Makes the directory `path` and each missing one above it; the reason one
// cannot be made, or "". One another build makes meanwhile is no failure.
func driver_make_directories(path: String) unsafe -> String {
    var k = 1
    while k <= path.len() {
        if k == path.len() || (path.byte_at(k) as Int) == DRIVER_SLASH {
            let prefix = path.substring(0, k)
            if not Directory.exists(Path(s: prefix)) {
                match Directory.create(Path(s: prefix)) {
                    case Ok(_) -> {},
                    case Err(e) -> {
                        if not Directory.exists(Path(s: prefix)) {
                            return "cannot create {prefix}: {e}"
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    ""
}

// What clang makes of a unit compile of `split`'s, as `clang -###` prints it
// without running anything, for `/dev/null` in and out: its version and
// toolchain directory, the cc1 binary it runs and that binary's whole command
// line, which carries what the environment and clang's configuration files
// change (the deployment target, the SDK, `CCC_OVERRIDE_OPTIONS`); None once
// clang cannot be asked.
func driver_cache_fingerprint(split: &DriverSplit) unsafe -> String? {
    var arguments = Vector<String>()
    try! arguments.push("-###")
    let compile = driver_object_arguments(split.triple, split.speed, split.sanitize, split.freestanding, split.lto,
                                          "/dev/null", "/dev/null")
    var k = 0
    while k < compile.len() {
        try! arguments.push(compile.get(k) ?? "")
        k = k + 1
    }
    driver_captured(split.out, "clang", split.clang, &arguments)
}

// A name no other build's temporary entry takes: random bytes in hex, or,
// where /dev/urandom cannot be read, the time.
func driver_cache_token() unsafe -> String {
    var out = StringBuilder()
    match File.open(Path(s: "/dev/urandom")) {
        case Ok(handle) -> {
            var file = move handle
            match file.read(size: DRIVER_CACHE_TOKEN_BYTES) {
                case Ok(bytes) -> {
                    var k = 0
                    while k < bytes.len() {
                        try! out.append((bytes.get(k) ?? Byte(0)) as Int)
                        try! out.append("-")
                        k = k + 1
                    }
                },
                case Err(_) -> {}
            }
            let _ = file.close()
        },
        case Err(_) -> {}
    }
    try! out.append(time.unix_timestamp() as Int)
    out.build()
}

// THE OBJECT CACHE KEY: the hex SHA-256 of a versioned description of what a
// codegen unit's object is a function of, `text` the unit's module: the
// format, clang's path and `cache.fingerprint` (its version and toolchain,
// every flag, and what the environment changes), then the text. The unit's
// path is not in it: each unit names itself as its `source_filename`
// (compiler/llvm/src/split.saw), and a sanitized unit, whose object names
// its path whatever the text says, is never cached (`driver_build`). A clang
// replaced in place by another build of the same version is not seen
// (compiler/README.md).
// ENTRY POINTS:
//     driver_split_build
func driver_object_key(cache: &DriverCache, text: &String) unsafe -> String {
    var description = StringBuilder()
    try! description.append("sawc-object-cache ")
    try! description.append(DRIVER_CACHE_FORMAT)
    try! description.append("\nclang ")
    try! description.append(cache.clang)
    try! description.append("\n")
    try! description.append(cache.fingerprint)
    try! description.append("\nunit ")
    try! description.append(text.len())
    try! description.append("\n")
    let head = description.build()
    var hash = Sha256()
    hash.update(&head)
    hash.update(&text)
    hash.finish()
}

// The numbers of the cache's generations, the directories `DIR/gN`, in
// ascending order; anything else there is left alone.
func driver_cache_generations(cache: &DriverCache) unsafe -> Vector<Int> {
    var out = Vector<Int>()
    match Directory.list(Path(s: cache.dir)) {
        case Ok(entries) -> {
            var k = 0
            while k < entries.len() {
                let name = entries[k].file_name() ?? ""
                if name.starts_with("g") {
                    let n = name.substring(1, name.len()).to_int() ?? 0
                    if n > 0 {
                        try! out.push(n)
                    }
                }
                k = k + 1
            }
        },
        case Err(e) -> {
            let what = cache.kind.what
            let dir = cache.dir
            driver_cache_warning("cannot list the {what}'s generations in {dir}: {e}")
        }
    }
    out.sort()
    move out
}

// The directory of generation `n` in `dir`.
func driver_cache_generation(dir: String, n: Int) -> String {
    var name = StringBuilder()
    try! name.append("g")
    try! name.append(n)
    driver_path(dir, name.build(), "")
}

// Where generation `n` holds `key`'s entry.
func driver_cache_entry(cache: &DriverCache, n: Int, key: String) -> String {
    driver_path(driver_cache_generation(cache.dir, n), key, cache.kind.suffix)
}

// An entry's first line, which a read checks: the magic and format, the key,
// the length of the body that follows it, and, for a kind that records one,
// the body's SHA-256 `digest`.
func driver_cache_header(cache: &DriverCache, key: String, length: Int, digest: String) -> String {
    var line = StringBuilder()
    try! line.append(driver_cache_header_head(&cache, key, length))
    if cache.kind.digested {
        try! line.append(" ")
        try! line.append(digest)
    }
    line.build()
}

// An entry's first line up to its digest.
func driver_cache_header_head(cache: &DriverCache, key: String, length: Int) -> String {
    var line = StringBuilder()
    try! line.append(cache.kind.magic)
    try! line.append(" ")
    try! line.append(cache.kind.format)
    try! line.append(" ")
    try! line.append(key)
    try! line.append(" ")
    try! line.append(length)
    line.build()
}

// The hex SHA-256 of an entry's body, which its header records for a kind
// that records one.
func driver_object_digest(bytes: &Data) unsafe -> String {
    var hash = Sha256()
    hash.update(&bytes)
    hash.finish()
}

// The newest generation's number, `g1` made when there is none; 0 once a
// warning says it cannot be.
func driver_cache_newest(cache: &DriverCache) unsafe -> Int {
    let generations = driver_cache_generations(&cache)
    if generations.len() > 0 {
        return generations[generations.len() - 1]
    }
    let problem = driver_make_directories(driver_cache_generation(cache.dir, 1))
    if problem.len() > 0 {
        let what = cache.kind.what
        driver_cache_warning("the {what} stores nothing: {problem}")
        return 0
    }
    1
}

// An entry read from a cache: where it was found, and its body.
struct DriverCached {
    path: String
    body: Data
}

extension DriverCached: NoCopy {}

// Whether the cache holds `key`'s object, which is then written to `object`
// (`driver_cache_read`). A fetched object is the one clang wrote, byte for
// byte.
func driver_cache_fetch(cache: &DriverCache, key: String, object: String) unsafe -> Bool {
    guard let found = driver_cache_read(&cache, key) else {
        return false
    }
    match driver_write_bytes(object, found.body) {
        case Ok(_) -> true,
        case Err(e) -> {
            driver_cache_warning("cannot write {object} from the object cache: {e}; compiling the unit")
            false
        }
    }
}

// THE CACHE READ: `key`'s entry's body, found in the newest generation, or in
// an older one and moved into the newest, so an entry in use outlives the
// next rotation. An entry that cannot be read, whose header is not its own,
// or whose body's bytes are not the ones its header's SHA-256 names, is a
// warning and a miss: the build does the work instead, and stores the entry
// again.
// ENTRY POINTS:
//     driver_cache_fetch
//     driver_front_cut
//     driver_front_chain
//     driver_verify_chain
func driver_cache_read(cache: &DriverCache, key: String) unsafe -> DriverCached? {
    let what = cache.kind.what
    let redo = cache.kind.redo
    let generations = driver_cache_generations(&cache)
    if generations.len() == 0 {
        return None
    }
    let newest = generations[generations.len() - 1]
    let current = driver_cache_entry(&cache, newest, key)
    var found = ""
    var k = generations.len() - 1
    while k >= 0 && found.len() == 0 {
        let at = driver_cache_entry(&cache, generations[k], key)
        if File.exists(Path(s: at)) {
            if generations[k] == newest {
                found = at
            } else {
                // A rename another build makes first leaves this one nothing
                // to move, and the entry where that build put it.
                match File.rename(Path(s: at), Path(s: current)) {
                    case Ok(_) -> {
                        found = current
                    },
                    case Err(_) -> {
                        if File.exists(Path(s: current)) {
                            found = current
                        }
                    }
                }
            }
        }
        k = k - 1
    }
    if found.len() == 0 {
        return None
    }
    let entry = match driver_read_bytes(found) {
        case Ok(bytes) -> bytes,
        case Err(e) -> {
            driver_cache_warning("cannot read the {what} entry {found}: {e}; {redo}")
            return None
        }
    }
    var line = 0 - 1
    var i = 0
    while i < entry.len() && i < DRIVER_CACHE_HEADER_MAX && line < 0 {
        if ((entry.get(i) ?? Byte(0)) as Int) == DRIVER_NEWLINE {
            line = i
        }
        i = i + 1
    }
    var header = ""
    if line > 0 {
        if let head = entry.slice(0, line) {
            header = match head.to_string() {
                case Ok(text) -> text,
                case Err(_) -> ""
            }
        }
    }
    let head = driver_cache_header_head(&cache, key, entry.len() - line - 1)
    var prefix = StringBuilder()
    try! prefix.append(head)
    if cache.kind.digested {
        try! prefix.append(" ")
    }
    let begins = prefix.build()
    let whole = cache.kind.digested && header.starts_with(begins)
    if line < 0 || not (whole || header.equals(begins)) {
        driver_cache_warning("the {what} entry {found} is damaged: its first line does not begin `{head}`; {redo}")
        return None
    }
    guard let body = entry.slice(line + 1, entry.len()) else {
        return None
    }
    if cache.kind.digested {
        let digest = driver_object_digest(&body)
        if not header.equals(driver_cache_header(&cache, key, body.len(), digest)) {
            driver_cache_warning("the {what} entry {found} is damaged: its object's SHA-256 is {digest}, not the one its first line records; {redo}")
            return None
        }
    }
    DriverCached(path: found, body: body)
}

// Stores the object clang wrote at `object` as `key`'s entry
// (`driver_cache_write`).
func driver_cache_store(cache: &DriverCache, key: String, object: String) unsafe {
    let body = match driver_read_bytes(object) {
        case Ok(bytes) -> bytes,
        case Err(e) -> {
            driver_cache_warning("the object cache does not store {object}: {e}")
            return
        }
    }
    driver_cache_write(&cache, key, body, object)
}

// THE CACHE WRITE: `body` stored as `key`'s entry in the newest generation,
// `stored` naming it in a warning: written under its writer's own temporary
// name, `cache.token`, which no other command and no other store thread of
// this one holds (`driver_spawn_stores`), then renamed into place, so a build
// reading the cache meanwhile finds
// the whole entry or none, and two builds storing one key both succeed. When
// a rotation removes the generation, or the temporary entry, meanwhile, the
// store starts again in the newest generation; one that fails every attempt
// is a warning, and the build goes on.
// ENTRY POINTS:
//     driver_cache_store
//     driver_front_cut
//     driver_store_parts
func driver_cache_write(cache: &DriverCache, key: String, body: Data, stored: String) unsafe {
    let what = cache.kind.what
    let digest = if cache.kind.digested { driver_object_digest(&body) } else { "" }
    let header = driver_cache_header(&cache, key, body.len(), digest)
    var line = StringBuilder()
    try! line.append(header)
    try! line.append("\n")
    var entry = match line.build().to_data() {
        case Ok(bytes) -> bytes,
        case Err(e) -> {
            driver_cache_warning("the {what} does not store {stored}: {e}")
            return
        }
    }
    match entry.append(body) {
        case Ok(_) -> {},
        case Err(e) -> {
            driver_cache_warning("the {what} does not store {stored}: {e}")
            return
        }
    }
    var why = ""
    var attempt = 0
    while attempt < DRIVER_CACHE_STORE_ATTEMPTS {
        let generation = driver_cache_newest(&cache)
        if generation == 0 {
            return
        }
        let final = driver_cache_entry(&cache, generation, key)
        var named = StringBuilder()
        try! named.append(final)
        try! named.append(".")
        try! named.append(cache.token)
        try! named.append(".tmp")
        let temporary = named.build()
        match driver_write_bytes(temporary, entry) {
            case Ok(_) -> {
                match File.rename(Path(s: temporary), Path(s: final)) {
                    case Ok(_) -> {
                        return
                    },
                    case Err(e) -> {
                        why = "{e}"
                    }
                }
            },
            case Err(e) -> {
                why = "{e}"
            }
        }
        attempt = attempt + 1
    }
    driver_cache_warning("the {what} does not store {stored}: {why}")
}

// Bounds the cache: when the newest generation holds more than half of
// `cache.entries`, a new generation starts and every one older than the one
// before it is removed, so the cache holds about `entries` entries and every
// entry used since the last rotation survives the next. Two builds rotating
// at once both succeed: the second finds the new generation made, and each
// removal tolerates the other's (`driver_cache_remove_generation`).
func driver_cache_rotate(cache: &DriverCache) unsafe {
    let generations = driver_cache_generations(&cache)
    if generations.len() == 0 {
        return
    }
    let newest = generations[generations.len() - 1]
    let held = match Directory.list(Path(s: driver_cache_generation(cache.dir, newest))) {
        case Ok(entries) -> entries.len(),
        case Err(_) -> 0
    }
    if held <= cache.entries / 2 {
        return
    }
    let next = driver_cache_generation(cache.dir, newest + 1)
    match Directory.create(Path(s: next)) {
        case Ok(_) -> {},
        case Err(e) -> {
            if not Directory.exists(Path(s: next)) {
                driver_cache_warning("the {cache.kind.what} cannot start a generation: cannot create {next}: {e}")
                return
            }
        }
    }
    var k = 0
    while k < generations.len() {
        if generations[k] < newest {
            driver_cache_remove_generation(&cache, generations[k])
        }
        k = k + 1
    }
}

// Removes generation `n` and its entries. An entry or the directory already
// gone is another build's removal, and an entry that appears meanwhile, which
// a build still storing into this generation writes, keeps the directory for
// the next rotation: that build's rename then fails and it stores the entry
// in the newest generation (`driver_cache_store`).
func driver_cache_remove_generation(cache: &DriverCache, n: Int) unsafe {
    let what = cache.kind.what
    let dir = driver_cache_generation(cache.dir, n)
    let listed = Directory.list(Path(s: dir))
    let entries = match listed {
        case Ok(found) -> move found,
        case Err(_) -> {
            return
        }
    }
    var k = 0
    while k < entries.len() {
        match File.remove(entries[k]) {
            case Ok(_) -> {},
            case Err(e) -> {
                match e.kind() {
                    case NotFound -> {},
                    case _ -> {
                        driver_cache_warning("cannot remove the {what} entry {entries[k].as_string()}: {e}")
                    }
                }
            }
        }
        k = k + 1
    }
    match Directory.remove(Path(s: dir)) {
        case Ok(_) -> {},
        case Err(e) -> {
            let left = match Directory.list(Path(s: dir)) {
                case Ok(found) -> found.len(),
                case Err(_) -> 0
            }
            if Directory.exists(Path(s: dir)) && left == 0 {
                driver_cache_warning("cannot remove the {what} generation {dir}: {e}")
            }
        }
    }
}

// The bytes of the file at `path`.
func driver_read_bytes(path: String) unsafe -> Result<Data, SystemError> {
    var file = try File.open(Path(s: path))
    let bytes = try file.read()
    try file.close()
    return bytes
}

// Writes `bytes` to the file at `path`, replacing what it holds.
func driver_write_bytes(path: String, bytes: Data) unsafe -> Result<Void, SystemError> {
    var file = try File.create(Path(s: path))
    let _ = try file.write(bytes)
    try file.close()
    return
}

// `sawc build: warning: TEXT` on standard error: what the object cache or
// the std front cache could not do, which changes how a build gets an object
// or std's cut and never which one it gets, so the build goes on.
func driver_cache_warning(text: String) unsafe {
    var line = StringBuilder()
    try! line.append("sawc build: warning: ")
    try! line.append(text)
    try! line.append("\n")
    let message = line.build()
    if let bytes = message.c_string() {
        __saw_rt_write_error(bytes, message.len())
    }
}

// Where one command's cuts of std come from: std's layer for one std root,
// target and profile, read from the std front cache when it holds the cut's
// key, else computed, and stored there when the cache is `on`. Once the
// command has one, `image` holds it, so each later program the command
// compiles decodes that instead of computing std's layer again. `timed`
// prints the cache's time line (`--time-stages`).
// The threads storing the layers this command computed (`stores`) are joined
// when it ends, as the value drops; `verify` is the lanes' check that every
// stored layer rebuilds to the state computed (`SAWC_FRONT_VERIFY=1`).
struct DriverFront {
    std_root: String
    target: TcTarget
    runtime: Bool
    freestanding: Bool
    provider: Bool
    on: Bool
    timed: Bool
    opened: Bool
    cache: DriverCache
    key: String
    image: Data
    verify: Bool
    stores: Vector<Thread<Int>>
    // How many store threads the command has started, each one's suffix to
    // the command's token: two threads may write one key, when a later input
    // misses a layer an earlier input's thread is still storing.
    writers: Int
}

extension DriverFront: NoCopy {
    // Waits for the store threads, which hold copies and write the front
    // cache's layers while the rest of the command runs: a command ends with
    // every layer it computed stored or warned about. The join blocks; it
    // never spins.
    func deinit(&var self) blocking {
        let started = time.Instant.now()
        let waited = self.stores.len() > 0
        while self.stores.len() > 0 {
            var handle = self.stores.pop()!
            let _ = handle.join()
        }
        if waited && self.timed {
            driver_time_line("front layers join", started.elapsed().as_nanos() as Int)
        }
    }
}

// The source of std's cuts for a command compiling against `std_root` for
// `target` under the profile the three flags name, using the std front cache
// when `on`.
func driver_front(std_root: String, target: TcTarget, runtime: Bool, freestanding: Bool, provider: Bool, on: Bool,
                  timed: Bool) unsafe -> DriverFront {
    let none = DriverCache(kind: driver_front_kind(), dir: "", thinlto: "", clang: "", fingerprint: "",
                           entries: DRIVER_FRONT_ENTRIES, token: "")
    DriverFront(std_root: std_root, target: target, runtime: runtime, freestanding: freestanding, provider: provider,
                on: on, timed: timed, opened: false, cache: none, key: "", image: Data(),
                verify: driver_environment("SAWC_FRONT_VERIFY").equals("1"), stores: Vector<Thread<Int>>(),
                writers: 0)
}

// THE FRONT CUT: std's cut for `front`'s std root, target and profile. It is
// decoded from the image the command already holds; else, with the cache on,
// read from the entry under its key (`driver_front_key`); else computed by
// mono's one maker of it (`mono_front_std`), then, with the cache on, stored.
// An entry that cannot be read or decoded is a warning, and the cut is
// computed and stored again; the cache never fails a command. A loaded cut
// skips std's verifiers, which ran when its image was made, and their lines
// are in it. Under `--time-stages` a load is `front cache load`, and a
// computed cut `std front end`, then, with the cache on, `front cache store`.
// ENTRY POINTS:
//     driver_build
//     driver_emit
//     driver_runtime
//     driver_print_warnings
//     driver_resolve
//     driver_fix_file
//     driver_mono
//     driver_coro
func driver_front_cut(front: &var DriverFront) unsafe -> FrontCut {
    if front.image.len() > 0 {
        match front_image_decode(front.image.copy()) {
            case Ok(cut) -> { return move cut },
            case Err(_) -> {
                front.image = Data()
            }
        }
    }
    let started = time.Instant.now()
    if front.on && not front.opened {
        driver_front_open(&var front)
    }
    if front.on {
        if let found = driver_cache_read(&front.cache, front.key) {
            match front_image_decode(found.body.copy()) {
                case Ok(cut) -> {
                    front.image = found.body.copy()
                    if front.timed {
                        driver_time_line("front cache load", started.elapsed().as_nanos() as Int)
                    }
                    return move cut
                },
                case Err(e) -> {
                    let at = found.path
                    driver_cache_warning("the front cache entry {at} is damaged: {e}; computing std's front end")
                }
            }
        }
    }
    let none = Vector<String>()
    let inputs = asserts_inputs("", &none, &none, front.target, front.freestanding)
    let computing = time.Instant.now()
    let cut = mono_front_std(front.std_root, front.target, &inputs, runtime: front.runtime,
                             freestanding: front.freestanding, provider: front.provider)
    let computed = computing.elapsed().as_nanos() as Int
    if front.timed {
        driver_time_line("std front end", computed)
    }
    if front.on {
        match front_image_encode(&cut) {
            case Ok(image) -> {
                driver_cache_write(&front.cache, front.key, image.copy(), "std's front-end image")
                driver_cache_rotate(&front.cache)
                front.image = image
            },
            case Err(e) -> {
                driver_cache_warning("the front cache does not store std's front-end image: {e}")
            }
        }
        if front.timed {
            driver_time_line("front cache store", (started.elapsed().as_nanos() as Int) - computed)
        }
    }
    move cut
}

// Opens `front`'s cache: its directory made and its key computed, or, once a
// warning says why neither can be, the cache turned off for the command.
func driver_front_open(front: &var DriverFront) unsafe {
    front.opened = true
    let root = driver_cache_directory(&front.cache.kind)
    if root.len() == 0 {
        front.on = false
        return
    }
    let dir = driver_path(root, front.cache.kind.under, "")
    let problem = driver_make_directories(dir)
    if problem.len() > 0 {
        driver_cache_warning("no front cache: {problem}, so std's front end is computed")
        front.on = false
        return
    }
    guard let key = driver_front_key(&front) else {
        front.on = false
        return
    }
    front.cache.dir = dir
    front.cache.token = driver_cache_token()
    front.key = key
}

// The layers the front end of entry file `path` runs after std's, under the
// mappings `names` to `dirs` (`res_layer_plan`).
func driver_plan(front: &DriverFront, path: String, names: &Vector<String>, dirs: &Vector<String>) -> ResLayerPlan {
    res_layer_plan(front.std_root, path, &names, &dirs)
}

// The mappings the entry's layer of `plan` adds, as `--module-path` names
// and directories: the record of a command that stops before drops runs that
// layer itself, with these.
func driver_entry_names(plan: &ResLayerPlan) -> Vector<String> {
    plan.layers[plan.layers.len() - 1].step.inputs.names.copy()
}

func driver_entry_dirs(plan: &ResLayerPlan) -> Vector<String> {
    plan.layers[plan.layers.len() - 1].step.inputs.dirs.copy()
}

// THE FRONT CHAIN: the front end of `plan`'s program for `front`'s std root,
// target and profile, through drop elaboration, every layer before the
// entry's and, with `through_entry`, the entry's too. Std's cut comes from
// `driver_front_cut`; then each layer's part is read from the front cache
// under its chain key (`driver_layer_key`) and applied, as long as the cache
// holds it, and the layers after that are computed. Each computed layer is
// stored when its state is the plan's: none left the program blocked, it
// loaded the modules the scan expected, and no appending table was cut back.
// At the end of drops each part is copied (`front_part_make`), and threads
// encode and write them while the rest of the command runs (`stores`, joined
// when `front` drops). A fallback plan computes its one program layer and
// stores nothing past std. Under `--time-stages` each layer is
// `front layer NAME loaded` or `front layer NAME computed`, the copy before
// the threads start is `front layers store`, and waiting for them at the
// end `front layers join`.
// ENTRY POINTS:
//     driver_build
//     driver_emit
//     driver_runtime
//     driver_resolve
//     driver_fix_file
//     driver_mono
//     driver_coro
func driver_front_chain(front: &var DriverFront, plan: &ResLayerPlan, through_entry: Bool,
                        no_hidden_alloc: Bool) unsafe -> FrontCut {
    var cut = driver_front_cut(&var front)
    let count = if through_entry { plan.layers.len() } else { plan.layers.len() - 1 }
    let caching = front.on && front.key.len() > 0 && not plan.fallback
    var key = front.key
    var loaded = 0
    // A layer's entry that cannot be used is a warning that says so.
    var layer_cache = front.cache
    layer_cache.kind.redo = "computing the layer again"
    while caching && loaded < count {
        let started = time.Instant.now()
        let next = driver_layer_key(key, &plan.layers[loaded], no_hidden_alloc)
        guard let found = driver_cache_read(&layer_cache, next) else {
            break
        }
        match front_part_decode(found.body) {
            case Ok(part) -> {
                front_part_apply(&var cut, &part)
                key = next
                loaded = loaded + 1
                if front.timed {
                    var line = StringBuilder()
                    try! line.append("front layer ")
                    try! line.append(plan.layers[loaded - 1].step.name)
                    try! line.append(" loaded")
                    driver_time_line(line.build(), started.elapsed().as_nanos() as Int)
                }
            },
            case Err(e) -> {
                let at = found.path
                driver_cache_warning("the front cache entry {at} is damaged: {e}; computing the layer again")
                break
            }
        }
    }
    if loaded == count {
        return move cut
    }
    var lengths = Vector<Vector<Int>>()
    var snaps = Vector<FrontSnap>()
    try! lengths.push(front_part_lengths(&cut))
    try! snaps.push(front_part_snapshot(&cut))
    var images = Vector<Data>()
    if front.verify && caching {
        try! images.push(driver_verify_image(&cut))
    }
    var storable = caching
    var j = loaded
    while j < count {
        let started = time.Instant.now()
        let first_module = cut.drops.bc.mir.tc.res.module_count()
        mono_front_layer(&var cut, &plan.layers[j].step, no_hidden_alloc)
        if front.timed {
            var line = StringBuilder()
            try! line.append("front layer ")
            try! line.append(plan.layers[j].step.name)
            try! line.append(" computed")
            driver_time_line(line.build(), started.elapsed().as_nanos() as Int)
        }
        try! lengths.push(front_part_lengths(&cut))
        try! snaps.push(front_part_snapshot(&cut))
        if front.verify && caching {
            try! images.push(driver_verify_image(&cut))
        }
        if cut.blocked || not driver_loaded_planned(&cut, first_module, &plan.layers[j]) {
            storable = false
        }
        j = j + 1
    }
    if not storable {
        return move cut
    }
    // A part cuts an appending table's run out of the state at the end, so
    // a table cut back after any layer's end stores nothing; under the
    // verify switch it is the missing marker it is.
    var w = 0
    while w < lengths.len() {
        let shrunk = front_part_shrunk(&cut, &lengths[w])
        if shrunk.len() > 0 {
            if front.verify {
                panic("sawc: front cache verify: the table {} is cut back below a layer's watermark, and its field carries no `front: rewritten in place` marker", shrunk)
            }
            return move cut
        }
        w = w + 1
    }
    let started = time.Instant.now()
    var keys = Vector<String>()
    var parts = Vector<FrontPart>()
    var named = Vector<String>()
    j = loaded
    while j < count {
        key = driver_layer_key(key, &plan.layers[j], no_hidden_alloc)
        let at = j - loaded
        try! keys.push(key)
        try! parts.push(front_part_make(&cut, &lengths[at], &lengths[at + 1], &snaps[at], &snaps[at + 1]))
        try! named.push(plan.layers[j].step.name)
        j = j + 1
    }
    if front.verify {
        let _ = driver_store_parts(front.cache, move keys, move parts, move named)
        driver_verify_chain(&var front, &plan, loaded, count, &images, no_hidden_alloc)
        return move cut
    }
    driver_spawn_stores(&var front, move keys, move parts, move named)
    if front.timed {
        driver_time_line("front layers store", started.elapsed().as_nanos() as Int)
    }
    move cut
}

// Whether the modules `cut` loaded from module `first` on are the ones the
// scan expected `layer` to load: a layer is stored only when its key covers
// what it read.
func driver_loaded_planned(cut: &FrontCut, first: Int, layer: &ResPlannedLayer) -> Bool {
    if cut.drops.bc.mir.tc.res.module_count() - first != layer.modules.len() {
        return false
    }
    var m = first
    while m < cut.drops.bc.mir.tc.res.module_count() {
        let info = cut.drops.bc.mir.tc.res.module(m)
        let real = cut.drops.bc.mir.tc.res.name_text(info.real)
        var k = 0
        var found = false
        while k < layer.modules.len() && not found {
            found = layer.modules[k].real.equals(real)
            k = k + 1
        }
        if not found {
            return false
        }
        m = m + 1
    }
    true
}

// The parts `parts`, each stored as `keys`' entry, split over at most
// DRIVER_STORE_THREADS threads, which `front` holds until it drops.
func driver_spawn_stores(front: &var DriverFront, keys: Vector<String>, parts: Vector<FrontPart>,
                         named: Vector<String>) unsafe {
    var threads = if parts.len() < DRIVER_STORE_THREADS { parts.len() } else { DRIVER_STORE_THREADS }
    var groups_keys = Vector<Vector<String>>()
    var groups_parts = Vector<Vector<FrontPart>>()
    var groups_named = Vector<Vector<String>>()
    var g = 0
    while g < threads {
        try! groups_keys.push(Vector<String>())
        try! groups_parts.push(Vector<FrontPart>())
        try! groups_named.push(Vector<String>())
        g = g + 1
    }
    var all_keys = move keys
    var all_parts = move parts
    var all_named = move named
    var k = 0
    while all_parts.len() > 0 {
        let part = all_parts.pop()!
        let key = all_keys.pop()!
        let name = all_named.pop()!
        let to = k % threads
        borrow var mine = groups_parts[to] {
            try! mine.push(move part)
        }
        borrow var mine_keys = groups_keys[to] {
            try! mine_keys.push(key)
        }
        borrow var mine_named = groups_named[to] {
            try! mine_named.push(name)
        }
        k = k + 1
    }
    while groups_parts.len() > 0 {
        let mine = groups_parts.pop()!
        let mine_keys = groups_keys.pop()!
        let mine_named = groups_named.pop()!
        var cache = front.cache
        var token = StringBuilder()
        try! token.append(front.cache.token)
        try! token.append("-w")
        try! token.append(front.writers)
        cache.token = token.build()
        front.writers = front.writers + 1
        let spawned = Thread.spawn { [move cache, move mine_keys, move mine, move mine_named] in
            driver_store_parts(move cache, move mine_keys, move mine, move mine_named)
        }
        match spawned {
            case Ok(handle) -> { try! front.stores.push(move handle) },
            case Err(e) -> { driver_cache_warning("the front cache stores no layer: no thread to write them: {e}") }
        }
    }
}

// Each of `parts` encoded and stored as `keys`' entry, then the cache
// bounded; returns how many were stored. Runs on a store thread, or inline
// under the verify switch.
func driver_store_parts(cache: DriverCache, keys: Vector<String>, parts: Vector<FrontPart>,
                        named: Vector<String>) unsafe -> Int {
    var stored = 0
    var k = 0
    while k < parts.len() {
        let name = named[k]
        match front_part_encode(&parts[k]) {
            case Ok(image) -> {
                var what = StringBuilder()
                try! what.append("the layer ")
                try! what.append(name)
                driver_cache_write(&cache, keys[k], image, what.build())
                stored = stored + 1
            },
            case Err(e) -> {
                driver_cache_warning("the front cache does not store the layer {name}: {e}")
            }
        }
        k = k + 1
    }
    driver_cache_rotate(&cache)
    stored
}

// The state `cut` as the image codec writes it, for the verify switch.
func driver_verify_image(cut: &FrontCut) -> Data {
    match front_image_encode(&cut) {
        case Ok(image) -> image,
        case Err(e) -> panic("sawc: front cache verify: the state cannot be encoded: {}", e)
    }
}

// THE FRONT CACHE VERIFY: under `SAWC_FRONT_VERIFY=1`, a lanes' switch never
// set in a user's build, every layer `driver_front_chain` just stored is read
// back from the front cache, applied to the state before it, and the result
// encoded and compared with the state computed, `images[0]` being the state
// before layer `loaded` and `images[k]` the state after layer `loaded + k - 1`.
// A difference is a part that does not rebuild its layer, which a table
// rewritten in place without its marker makes (compiler/tools/front_parts.py),
// and fails the command.
func driver_verify_chain(front: &var DriverFront, plan: &ResLayerPlan, loaded: Int, count: Int,
                         images: &Vector<Data>, no_hidden_alloc: Bool) unsafe {
    var rebuilt = match front_image_decode(images[0].copy()) {
        case Ok(c) -> move c,
        case Err(e) -> panic("sawc: front cache verify: the state before the first stored layer does not decode: {}", e)
    }
    var key = front.key
    var j = 0
    while j < loaded {
        key = driver_layer_key(key, &plan.layers[j], no_hidden_alloc)
        j = j + 1
    }
    while j < count {
        key = driver_layer_key(key, &plan.layers[j], no_hidden_alloc)
        let name = plan.layers[j].step.name
        guard let found = driver_cache_read(&front.cache, key) else {
            panic("sawc: front cache verify: the layer {} was not stored", name)
        }
        let part = match front_part_decode(found.body) {
            case Ok(p) -> move p,
            case Err(e) -> panic("sawc: front cache verify: the layer {} does not decode: {}", name, e)
        }
        front_part_apply(&var rebuilt, &part)
        let have = driver_verify_image(&rebuilt)
        let want = images[j - loaded + 1].copy()
        if have.len() != want.len() || not driver_same_bytes(&have, &want) {
            var at = 0
            while at < have.len() && at < want.len() && (have.get(at) ?? Byte(0)) == (want.get(at) ?? Byte(0)) {
                at = at + 1
            }
            panic("sawc: front cache verify: the layer {} rebuilt from its part differs from its computed state, first at byte {} ({} bytes against {})",
                  name, at, have.len(), want.len())
        }
        j = j + 1
    }
}

func driver_same_bytes(a: &Data, b: &Data) -> Bool {
    var i = 0
    while i < a.len() {
        if (a.get(i) ?? Byte(0)) != (b.get(i) ?? Byte(0)) {
            return false
        }
        i = i + 1
    }
    true
}

// THE LAYER KEY CHAIN: the hex SHA-256 of a versioned description of what one
// layer's part is a function of, `parent` the key of the state before it
// (std's key for the first layer after std's, `driver_front_key`), so a key
// covers every layer before its own:
//
//   in the key                              why
//   the parent's key                        the binary, std, the target and the
//                                           profile, then each layer before
//   the part and image formats              another layout is never looked up
//   the layer's kind and name               the entry's layer checks `main`
//   `--no-hidden-alloc`                     every layer after std's reads it
//   each mapping the layer adds: its name,  `add_package` interns them; the
//   its directory as spelled, its real      spelling reaches diagnostics and
//   path                                    `#file`, the real path identity
//   each module, in the scan's order: its   identity, diagnostics and `#file`,
//   name, its file as spelled, its real     positions; the order fixes arena
//   path, its package, its length and bytes positions in a package layer
//
//   not in it                               why
//   later layers, other layers' mappings    no phase reads a later table; an
//                                           overlap falls back to one layer
//   files probed and not found, Saw.toml    they decide which files the scan
//                                           reaches, and those are in it; a
//                                           refusal's text is never stored
//   codegen, cache and output flags, `-W`   read after drops, or only printed
//   the environment, the working directory  no stage reads the first; the
//                                           spellings and real paths cover the
//                                           second
// ENTRY POINTS:
//     driver_front_chain
//     driver_verify_chain
func driver_layer_key(parent: String, layer: &ResPlannedLayer, no_hidden_alloc: Bool) unsafe -> String {
    var hash = Sha256()
    var head = StringBuilder()
    try! head.append("sawc-front-layer ")
    try! head.append(DRIVER_FRONT_FORMAT)
    try! head.append("\npart ")
    try! head.append(FRONT_PART_FORMAT)
    try! head.append(" image ")
    try! head.append(FRONT_IMAGE_FORMAT)
    try! head.append("\nparent ")
    try! head.append(parent)
    try! head.append("\nlayer ")
    try! head.append(if layer.step.kind == FrontLayerKind.Package { "package " } else { "program " })
    driver_key_text(&var head, layer.step.name)
    try! head.append(if no_hidden_alloc { "\nno-hidden-alloc" } else { "\nhidden-alloc" })
    var k = 0
    while k < layer.step.inputs.names.len() {
        try! head.append("\nmap ")
        driver_key_text(&var head, layer.step.inputs.names[k])
        let dir = layer.step.inputs.dirs[k]
        driver_key_text(&var head, dir)
        driver_key_text(&var head, res_mapping(layer.step.inputs.names[k], dir).real)
        k = k + 1
    }
    try! head.append("\nentry ")
    driver_key_text(&var head, layer.step.inputs.path)
    try! head.append("\n")
    let text = head.build()
    hash.update(&text)
    k = 0
    while k < layer.modules.len() {
        var line = StringBuilder()
        try! line.append("module ")
        driver_key_text(&var line, layer.modules[k].name)
        driver_key_text(&var line, layer.modules[k].file)
        driver_key_text(&var line, layer.modules[k].real)
        driver_key_text(&var line, layer.modules[k].package)
        try! line.append(layer.modules[k].text.len())
        try! line.append("\n")
        let named = line.build()
        hash.update(&named)
        hash.update(&layer.modules[k].text)
        k = k + 1
    }
    hash.finish()
}

// `text` with its length ahead of it, then a space: a field of a key's
// description that no other field's text can run into.
func driver_key_text(out: &var StringBuilder, text: String) {
    try! out.append(text.len())
    try! out.append(" ")
    try! out.append(text)
    try! out.append(" ")
}

// THE FRONT CACHE KEY: the hex SHA-256 of a versioned description of what
// std's cut is a function of, or None once a warning says what could not be
// read. `mono_front_std` reads only these, so two builds whose keys agree
// make one cut:
//
//   in the key                              why
//   the entry format, the image format      another layout is never looked up
//   the running binary's SHA-256            the suspension and runtime-ABI
//                                           tables are compiled in; Stage 1
//                                           and Stage 2 never share an image
//   the std root as spelled, its real path  diagnostics and `#file` quote the
//                                           spelling; the real path is each
//                                           module's identity
//   every `.saw` file std's layer can read: its path, length and bytes
//                                           (`driver_front_std_files`)
//   the target record: triple, word bits,   the only target facts std's layer
//   atomics, FP unit                        reads; the builtins modules follow
//   `runtime`, `freestanding`, `provider`   the profile record (`tc_profile`)
//
//   not in it                               why
//   `--no-hidden-alloc`                     std is exempt; the program's
//                                           layer sets it
//   `--module-path`, the entry file         loaded in the program's layer
//   `-O`, `-g`, `-c`, `--sanitize`, the     read after drops
//   codegen-unit, LTO and cache flags, `-o`
//   `-W`, `--notes`, the dump modes         what is printed, not std's state
//   the environment                         no front-end stage reads one
//   the working directory                   covered by the root's spelling and
//                                           real path
// ENTRY POINTS:
//     driver_front_open
func driver_front_key(front: &DriverFront) unsafe -> String? {
    let binary = match Env.executable_path() {
        case Ok(path) -> path,
        case Err(e) -> {
            driver_cache_warning("no front cache: cannot find this executable's path: {e}, so std's front end is computed")
            return None
        }
    }
    let compiler = match driver_read_bytes(binary) {
        case Ok(bytes) -> driver_object_digest(&bytes),
        case Err(e) -> {
            driver_cache_warning("no front cache: cannot read {binary}: {e}, so std's front end is computed")
            return None
        }
    }
    let real = match Path(s: front.std_root).canonical() {
        case Ok(p) -> p.as_string(),
        case Err(e) -> {
            let root = front.std_root
            driver_cache_warning("no front cache: cannot find the real path of {root}: {e}, so std's front end is computed")
            return None
        }
    }
    guard let files = driver_front_std_files(front.std_root) else {
        let root = front.std_root
        driver_cache_warning("no front cache: cannot list the std root {root}, so std's front end is computed")
        return None
    }
    var hash = Sha256()
    var head = StringBuilder()
    try! head.append("sawc-front-cache ")
    try! head.append(DRIVER_FRONT_FORMAT)
    try! head.append("\nimage ")
    try! head.append(FRONT_IMAGE_FORMAT)
    try! head.append("\ncompiler ")
    try! head.append(compiler)
    try! head.append("\nstd-root ")
    try! head.append(front.std_root.len())
    try! head.append(" ")
    try! head.append(front.std_root)
    try! head.append("\nstd-real ")
    try! head.append(real.len())
    try! head.append(" ")
    try! head.append(real)
    try! head.append("\ntarget ")
    try! head.append(front.target.triple)
    try! head.append(" ")
    try! head.append(front.target.word_bits)
    try! head.append(if front.target.atomics { " atomics" } else { " no-atomics" })
    try! head.append(if front.target.float_unit { " float-unit" } else { " no-float-unit" })
    try! head.append("\nprofile")
    try! head.append(if front.runtime { " runtime" } else { " no-runtime" })
    try! head.append(if front.freestanding { " freestanding" } else { " hosted" })
    try! head.append(if front.provider { " provider" } else { " no-provider" })
    try! head.append("\n")
    let text = head.build()
    hash.update(&text)
    var k = 0
    while k < files.len() {
        let rel = files[k]
        k = k + 1
        let bytes = match driver_read_bytes(driver_path(front.std_root, rel, "")) {
            case Ok(b) -> b,
            case Err(e) -> {
                driver_cache_warning("no front cache: cannot read {rel} in the std root: {e}, so std's front end is computed")
                return None
            }
        }
        var line = StringBuilder()
        try! line.append("file ")
        try! line.append(rel.len())
        try! line.append(" ")
        try! line.append(rel)
        try! line.append(" ")
        try! line.append(bytes.len())
        try! line.append("\n")
        let named = line.build()
        hash.update(&named)
        hash.update(&bytes)
    }
    hash.finish()
}

// Every `.saw` file std's layer can read under the std root `root`, as paths
// relative to it in byte order: the whole root for the new std, and Stage 0's
// frozen std's `builtin.saw` and `std/` (`detect_std_layout`); None when a
// directory cannot be listed.
func driver_front_std_files(root: String) unsafe -> Vector<String>? {
    var out = Vector<String>()
    if driver_file_exists(driver_path(root, "prelude.saw", "")) {
        if not driver_front_walk(root, "", &var out) {
            return None
        }
    } else {
        try! out.push("builtin.saw")
        if not driver_front_walk(root, "std", &var out) {
            return None
        }
    }
    out.sort()
    move out
}

// Adds each `.saw` file under `root`'s `rel` (the root itself when empty),
// in every directory below it, to `out`; false when a directory cannot be
// listed. An entry that is neither a `.saw` file nor a directory is no
// source of std's.
func driver_front_walk(root: String, rel: String, out: &var Vector<String>) unsafe -> Bool {
    let dir = if rel.len() == 0 { root } else { driver_path(root, rel, "") }
    let entries = match Directory.list(Path(s: dir)) {
        case Ok(found) -> move found,
        case Err(_) -> {
            return false
        }
    }
    var k = 0
    while k < entries.len() {
        let name = entries[k].file_name() ?? ""
        k = k + 1
        let child = if rel.len() == 0 { name } else { driver_path(rel, name, "") }
        if name.ends_with(".saw") {
            try! out.push(child)
            continue
        }
        let directory = match Directory.list(Path(s: driver_path(root, child, ""))) {
            case Ok(_) -> true,
            case Err(_) -> false
        }
        if directory && not driver_front_walk(root, child, &var out) {
            return false
        }
    }
    true
}

// THE THINLTO CACHE FLAGS: a ThinLTO link keeps each module's optimised
// result in `dir`, keyed by the linker on the module and what it imports,
// and prunes it by the linker's own policy: an entry unused for a week goes,
// the check runs at most hourly, and the directory takes at most a tenth of
// the disk's free space, and on ELF at most 1 GiB (ld64 has no byte cap).
// `mach_o` picks ld64's spelling over lld's.
func driver_thinlto_cache_arguments(arguments: &var Vector<String>, dir: String, mach_o: Bool) {
    var path = StringBuilder()
    if mach_o {
        try! path.append("-Wl,-cache_path_lto,")
        try! path.append(dir)
        try! arguments.push(path.build())
        try! arguments.push("-Wl,-prune_interval_lto,3600")
        try! arguments.push("-Wl,-prune_after_lto,604800")
        try! arguments.push("-Wl,-max_relative_cache_size_lto,10")
    } else {
        try! path.append("-Wl,--thinlto-cache-dir=")
        try! path.append(dir)
        try! arguments.push(path.build())
        try! arguments.push("-Wl,--thinlto-cache-policy=prune_interval=1h:prune_after=168h:cache_size=10%:cache_size_bytes=1g")
    }
}

// Runs every job of `jobs`, at most `workers` children at once: it starts
// them in order up to the bound, then waits for the oldest and starts the
// next, so nothing but child processes runs in parallel and sawc stays
// single-threaded. Returns each job's outcome in job order, its time from its
// start to its reaping, and a status of 1 for a job that could not run, once
// the reason is printed.
func driver_run_jobs(jobs: &Vector<DriverJob>, workers: Int) -> Vector<DriverDone> {
    let count = jobs.len()
    var children = Vector<Child>()
    var started = Vector<time.Instant>()
    var launched = Vector<Int>()
    var out = Vector<DriverDone>()
    var k = 0
    while k < count {
        try! out.push(DriverDone(job: k, status: 0, nanos: 0))
        k = k + 1
    }
    var next = 0
    var oldest = 0
    while next < count || oldest < children.len() {
        while next < count && children.len() - oldest < workers {
            var command = Command(program: jobs[next].program)
            var i = 0
            while i < jobs[next].arguments.len() {
                try! command.arg(jobs[next].arguments.get(i) ?? "")
                i = i + 1
            }
            match command.spawn() {
                case Ok(child) -> {
                    try! children.push(move child)
                    try! started.push(time.Instant.now())
                    try! launched.push(next)
                },
                case Err(e) -> {
                    print("sawc build: cannot run {}: {}", jobs[next].tool, e)
                    out[next].status = 1
                }
            }
            next = next + 1
        }
        if oldest < children.len() {
            let job = launched[oldest]
            let waited = children[oldest].wait()
            out[job].nanos = started[oldest].elapsed().as_nanos() as Int
            match waited {
                case Ok(code) -> {
                    if code != 0 {
                        print("sawc build: {} exited {}", jobs[job].tool, code)
                    }
                    out[job].status = code as Int
                },
                case Err(e) -> {
                    print("sawc build: cannot run {}: {}", jobs[job].tool, e)
                    out[job].status = 1
                }
            }
            oldest = oldest + 1
        }
    }
    move out
}

// `time: NAME MS ms` on standard error, the milliseconds rounded to one
// decimal, as `--time-stages` reports its steps.
func driver_time_line(name: String, nanos: Int) unsafe {
    let tenths = (nanos + 50_000) / 100_000
    var text = StringBuilder()
    try! text.append("time: ")
    try! text.append(name)
    try! text.append(" ")
    try! text.append(tenths / 10)
    try! text.append(".")
    try! text.append(tenths % 10)
    try! text.append(" ms\n")
    let line = text.build()
    if let bytes = line.c_string() {
        __saw_rt_write_error(bytes, line.len())
    }
}

// THE OBJECT COMPILE: the arguments clang compiles the module at `ll` to the
// object `out` with, `-c -target TRIPLE SPEED [-fsanitize=address]
// [FREESTANDING] [-flto=LTO] -x ir LL -o OUT`, for the clang triple `triple`.
// The module's attribute group already names its subtarget features and size
// level, which clang reads from the IR. A `freestanding` object puts each
// function and each global in a section of its own, so a kernel's
// `--gc-sections` link drops what nothing reaches, and is not
// position-independent, since a kernel is linked at the address its script
// names: `-ffunction-sections -fdata-sections -fno-pic`. An `lto` of `thin`
// or `full` writes a codegen unit's bitcode for the link to optimise.
// ENTRY POINTS:
//     driver_build
//     driver_cache_fingerprint
//     driver_link_mach_o
//     driver_runtime
//     driver_split_build
func driver_object_arguments(triple: String, speed: String, sanitize: Bool, freestanding: Bool, lto: String,
                             ll: String, out: String) -> Vector<String> {
    var arguments = Vector<String>()
    try! arguments.push("-c")
    try! arguments.push("-target")
    try! arguments.push(triple)
    try! arguments.push(speed)
    if sanitize {
        try! arguments.push("-fsanitize=address")
    }
    driver_freestanding_arguments(&var arguments, freestanding)
    if not lto.equals("none") {
        try! arguments.push(driver_lto_flag(lto))
    }
    try! arguments.push("-x")
    try! arguments.push("ir")
    try! arguments.push(ll)
    try! arguments.push("-o")
    try! arguments.push(out)
    move arguments
}

// Whether `features`, the operand of `--target-features`, is a feature list
// the module's attribute group can carry as written: letters, digits and
// `+-,._` alone, which also keeps a quote from ending the attribute's
// string, and one that leaves `forced-atomics` off. One that is not is a usage
// error, printed first.
func driver_features_ok(features: String) -> Bool {
    var k = 0
    while k < features.len() {
        let b = features.byte_at(k) as Int
        let letter = (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
        let digit = b >= 48 && b <= 57
        let mark = b == 43 || b == 45 || b == 44 || b == 46 || b == 95
        if not (letter || digit || mark) {
            print("sawc build: --target-features takes a comma-separated list such as `+m,+a,+c`, of letters, digits and `+-,._`, not `{}`", features)
            return false
        }
        k = k + 1
    }
    // `forced-atomics` has LLVM call `__sync_*` routines, which no
    // environment is told to supply (SL-948).
    if target_feature_state(features, "forced-atomics") == TargetFeatureState.On {
        print("sawc build: --target-features turns on `forced-atomics`, which has LLVM call `__sync_*` routines for the word's atomics, and no environment is told to supply those: without `+a`, sawc's output calls the five `__atomic_*_4` routines the environment supplies (LANGUAGE_SPEC.md, Profiles), so leave `forced-atomics` off")
        return false
    }
    true
}

// THE FEATURE-NAME CHECK: whether the clang at `clang` recognizes each name
// in `features` for `clang_triple`, which it compiles the build's IR for.
// LLVM drops a name it does not know with a warning and builds without it,
// so a misspelled `+strict-align` would cost an alignment guarantee with the
// build still passing: a probe module carrying the list is compiled first,
// and every name its output reports is a usage error (SL-995). Returns 0
// when every name is known, `DRIVER_EXIT_USAGE` once the refusal is
// printed, and 1 when the probe cannot run.
// ENTRY POINTS:
//     driver_build
func driver_check_feature_names(clang: String, clang_triple: String, triple: String, features: String,
                                out: String) -> Int {
    var probe_path = StringBuilder()
    try! probe_path.append(out)
    try! probe_path.append(".features.ll")
    let probe = probe_path.build()
    var text = StringBuilder()
    try! text.append("define void @sawc_feature_probe() #0 \{\n  ret void\n\}\n\nattributes #0 = \{ \"target-features\"=\"")
    try! text.append(features)
    try! text.append("\" \}\n")
    if not driver_write_file(probe, text.build()) {
        return 1
    }
    var arguments = Vector<String>()
    try! arguments.push("-target")
    try! arguments.push(clang_triple)
    try! arguments.push("-Wno-override-module")
    try! arguments.push("-c")
    try! arguments.push("-x")
    try! arguments.push("ir")
    try! arguments.push(probe)
    try! arguments.push("-o")
    try! arguments.push("/dev/null")
    let captured = driver_captured(out, "clang", clang, &arguments)
    let _ = File.remove(Path(s: probe))
    guard let said = captured else {
        return 1
    }
    let marker = "' is not a recognized feature for this target"
    var unknown = Vector<String>()
    let lines = try! said.split("\n")
    var k = 0
    while k < lines.len() {
        let line = lines[k]
        k = k + 1
        if not line.contains(marker) || not line.starts_with("'") {
            continue
        }
        var end = 1
        while end + marker.len() <= line.len() && not line.substring(end, end + marker.len()).equals(marker) {
            end = end + 1
        }
        let name = line.substring(1, end)
        var seen = false
        var j = 0
        while j < unknown.len() {
            if unknown[j].equals(name) {
                seen = true
            }
            j = j + 1
        }
        if not seen {
            try! unknown.push(name)
        }
    }
    if unknown.len() == 0 {
        return 0
    }
    var names = StringBuilder()
    var n = 0
    while n < unknown.len() {
        if n > 0 {
            try! names.append(", ")
        }
        try! names.append("`")
        try! names.append(unknown[n])
        try! names.append("`")
        n = n + 1
    }
    print("sawc build: --target-features names {}, which {}'s clang ({}) does not recognize as a feature of that target; LLVM would build without it, so check its spelling", names.build(), triple, clang)
    DRIVER_EXIT_USAGE
}

// The arguments every clang run of a link starts with: the target, the speed
// and the sanitizer.
func driver_link_head(link: &DriverLink) -> Vector<String> {
    var arguments = Vector<String>()
    try! arguments.push("-target")
    try! arguments.push(link.triple)
    try! arguments.push(link.speed)
    if link.sanitize {
        try! arguments.push("-fsanitize=address")
    }
    move arguments
}

// The arguments a link ends with: the runtime's objects, the target's
// libraries and the output.
func driver_link_tail(arguments: &var Vector<String>, link: &DriverLink, objects: &Vector<String>) {
    var i = 0
    while i < objects.len() {
        try! arguments.push(objects.get(i) ?? "")
        i = i + 1
    }
    let libraries = driver_link_libraries(link.triple)
    i = 0
    while i < libraries.len() {
        try! arguments.push(libraries.get(i) ?? "")
        i = i + 1
    }
    try! arguments.push("-o")
    try! arguments.push(link.out)
}

// Whether the clang triple `triple` names a Mach-O target.
func driver_mach_o(triple: String) -> Bool {
    triple.contains("-apple-")
}

// The real path of the directory output `out` is written into, or "" once
// the reason it has none is printed. The debug map is cut by this spelling,
// which is the one the linker records the object's path in.
func driver_output_directory(out: String) -> String {
    var dir = "."
    if let parent = Path(s: out).parent() {
        let spelled = parent.as_string()
        if spelled.len() > 0 {
            dir = spelled
        }
    }
    match Path(s: dir).canonical() {
        case Ok(real) -> real.as_string(),
        case Err(e) -> {
            print("sawc build: cannot find the directory {} is written into: {}", out, e)
            ""
        }
    }
}

// The file name of `path` without its directory.
func driver_base_name(path: String) -> String {
    var start = 0
    var i = 0
    while i < path.len() {
        if (path.byte_at(i) as Int) == DRIVER_SLASH {
            start = i + 1
        }
        i = i + 1
    }
    path.substring(start, path.len())
}

// The program clang runs for the tool `name`, as `-print-prog-name` reports
// it, or "" once the reason it could not be asked is printed. `out` is the
// build's output, beside which the answer is captured.
func driver_clang_tool(clang: String, name: String, out: String) -> String {
    var asked = StringBuilder()
    try! asked.append("-print-prog-name=")
    try! asked.append(name)
    var arguments = Vector<String>()
    try! arguments.push(asked.build())
    if let said = driver_captured(out, "clang", clang, &arguments) {
        let found = driver_first_line(said)
        if found.len() > 0 {
            return found
        }
    }
    print("sawc build: clang {} named no {} for -print-prog-name", clang, name)
    ""
}

// Why the linker clang runs cannot link a module with line tables
// reproducibly, or "": `-reproducible` is Xcode 15's linker's, whose
// `ld -v` names project `ld`, where the linker before it names `ld64`.
func driver_linker_problem(clang: String, out: String) -> String {
    let ld = driver_clang_tool(clang, "ld", out)
    if ld.len() == 0 {
        return "no linker to ask for `-reproducible`"
    }
    var arguments = Vector<String>()
    try! arguments.push("-v")
    guard let said = driver_captured(out, "the linker", ld, &arguments) else {
        return "the linker's version is unknown"
    }
    if said.contains("PROJECT:ld-") {
        return ""
    }
    var problem = StringBuilder()
    try! problem.append("the linker ")
    try! problem.append(ld)
    try! problem.append(" (")
    try! problem.append(driver_first_line(said))
    try! problem.append(") is older than Xcode 15's, which has the `-reproducible` a build with line tables links with; update the Command Line Tools, or build with -g0")
    problem.build()
}

// What `program`, the tool `tool`, writes to standard output and standard
// error when run with `arguments`, or None once the reason is printed. The
// driver runs nothing that suspends, so the text is captured through the file
// `OUT.tool` beside the build's output `out`, which `sh` redirects into and
// which is removed after; every path reaches `sh` as an argument, never as
// script text, so nothing is quoted.
func driver_captured(out: String, tool: String, program: String, arguments: &Vector<String>) -> String? {
    var file = StringBuilder()
    try! file.append(out)
    try! file.append(".tool")
    let path = file.build()
    var shell = Vector<String>()
    try! shell.push("-c")
    try! shell.push("out=\"$1\"; shift; exec \"$@\" >\"$out\" 2>&1")
    try! shell.push("sh")
    try! shell.push(path)
    try! shell.push(program)
    var i = 0
    while i < arguments.len() {
        try! shell.push(arguments.get(i) ?? "")
        i = i + 1
    }
    let code = driver_tool("sawc build", tool, "/bin/sh", &shell)
    guard let said = driver_read_source(path) else {
        return None
    }
    match File.remove(Path(s: path)) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("sawc build: cannot remove {}: {}", path, e)
            return None
        }
    }
    if code != 0 {
        return None
    }
    said
}

// The first line of `text`, without its line break.
func driver_first_line(text: String) -> String {
    var stop = 0
    while stop < text.len() && (text.byte_at(stop) as Int) != DRIVER_NEWLINE {
        stop = stop + 1
    }
    text.substring(0, stop)
}

// The libraries a program linked for the clang triple `triple` names after
// its objects, decided by the target and never the host. glibc keeps the
// math functions in libm, apart from libc, so a Linux link names it; macOS
// carries them in libSystem, which every link takes. The Linux triples are
// named one by one, so a new Linux target must be added here, and to
// build.py's `link_libraries`, which must agree since the seed links as
// `sawc build` does.
// ENTRY POINTS:
//     driver_link
func driver_link_libraries(triple: String) -> Vector<String> {
    var out = Vector<String>()
    if triple.equals("aarch64-unknown-linux-gnu") || triple.equals("x86_64-unknown-linux-gnu") {
        try! out.push("-lm")
    }
    move out
}

// Runs the clang at `program` with `arguments` and returns its exit status,
// or 1 once the reason it could not run is printed, headed by `command`.
func driver_clang(command: String, program: String, arguments: &Vector<String>) -> Int {
    driver_tool(command, "clang", program, &arguments)
}

// Runs `program`, the tool `tool`, with `arguments` and returns its exit
// status, or 1 once the reason it could not run is printed, headed by
// `command`.
func driver_tool(command: String, tool: String, program: String, arguments: &Vector<String>) -> Int {
    var child = Command(program: program)
    var i = 0
    while i < arguments.len() {
        try! child.arg(arguments.get(i) ?? "")
        i = i + 1
    }
    // Stage 0 workaround (SL:hazards S28): canonical: let code = try child.status() — a child handle whose deinit waits for it
    let waited = child.wait()
    match waited {
        case Ok(code) -> {
            if code != 0 {
                print("{}: {} exited {}", command, tool, code)
            }
            code as Int
        },
        case Err(e) -> {
            print("{command}: cannot run {tool}: {e}")
            1
        }
    }
}

// `sawc runtime --out DIR`: each runtime source of the target, as the ABI
// table lists them under the runtime root, compiled to `DIR/NAME.ll` and by
// clang to `DIR/NAME.o`, and the C shim to `DIR/shim.o`, all at the module's
// target; then every runtime seam of the table must be defined by exactly one
// of them, and nothing else by any. On success the runtime manifest naming
// the target, the clang and the objects is printed. The target and the clang
// are `--target` and `--clang`, else the host and the clang the manifest
// beside this binary names. DIR must exist, and nothing is cached here, since
// caching would need directory operations std lacks (SL:open-questions D41).
// With `--emit-ll FILE`, that one source's `.ll` goes to standard output.
func driver_runtime(args: &Vector<String>) -> Int {
    var std_root = ""
    var rt_root = ""
    var out_dir = ""
    var emit = ""
    var host = ""
    var program = ""
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        let value = args.get(i + 1) ?? ""
        if value.len() == 0 {
            return driver_usage()
        }
        if arg.equals("--std-root") {
            std_root = value
        } else if arg.equals("--rt-root") {
            rt_root = value
        } else if arg.equals("--out") {
            out_dir = value
        } else if arg.equals("--emit-ll") {
            emit = value
        } else if arg.equals("--target") {
            host = value
        } else if arg.equals("--clang") {
            program = value
        } else {
            return driver_usage()
        }
        i = i + 2
    }
    if (out_dir.len() == 0) == (emit.len() == 0) {
        return driver_usage()
    }
    std_root = driver_std_root("sawc runtime", std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    rt_root = driver_rt_root("sawc runtime", rt_root)
    if rt_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    if host.len() == 0 || (program.len() == 0 && out_dir.len() > 0) {
        var unused = Vector<String>()
        var named = StringBuilder()
        var no_objcopy = StringBuilder()
        let found = driver_read_runtime("sawc runtime", &var unused, &var named, &var no_objcopy)
        if found.len() == 0 {
            print("sawc runtime: without a manifest, --target and --clang name what it builds for and with")
            return DRIVER_EXIT_USAGE
        }
        if host.len() == 0 {
            host = found
        }
        if program.len() == 0 {
            program = named.build()
        }
    }
    if not target_known(host) {
        print("sawc: unknown target {host}")
        return DRIVER_EXIT_USAGE
    }
    let speed = driver_runtime_speed()
    // A runtime carries no line tables: its objects sit in the build cache,
    // whose absolute path every program's debug map would then name.
    let options = BuildOptions(std_root: std_root, target: host, speed: speed,
                               module_triple: target_clang_triple(host), runtime: true, freestanding: false,
                               provider: false, no_hidden_alloc: false,
                               sanitize_address: false, debug_info: false, features: "", object: false)
    let names = Vector<String>()
    let dirs = Vector<String>()
    let front_on = driver_front_choice("sawc runtime", false)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    var front = driver_front(std_root, target_front_end(host, ""), true, false, false, front_on == 1, false)
    if emit.len() > 0 {
        var record = StringBuilder()
        var ir = StringBuilder()
        let plan = driver_plan(&front, emit, &names, &dirs)
        var exports = Vector<String>()
        var units = LlUnitPlan()
        let status = llvm_build_exporting(out: &var record, ir: &var ir, exports: &var exports, plan: &var units,
                                          split: false, front: driver_front_chain(&var front, &plan, true, false),
                                          options: &options)
        if status != 0 {
            driver_print_refusal(emit, &var record)
            return status
        }
        print(ir.build())
        return 0
    }
    let sources = tc_runtime_sources(host)
    if sources.len() == 0 {
        print("sawc runtime: the runtime table lists no sources for {}; compiler/tools/runtime_table.py's HOSTS gives a host its runtime", host)
        return 1
    }
    var objects = Vector<String>()
    var seams = Vector<String>()
    var definers = Vector<String>()
    var status = 0
    var k = 0
    while k < sources.len() {
        let source = driver_path(rt_root, sources.get(k) ?? "", "")
        let stem = driver_stem(source)
        let ll = driver_path(out_dir, stem, ".ll")
        let object = driver_path(out_dir, stem, ".o")
        k = k + 1
        var record = StringBuilder()
        var ir = StringBuilder()
        var exports = Vector<String>()
        let plan = driver_plan(&front, source, &names, &dirs)
        var units = LlUnitPlan()
        let built = llvm_build_exporting(out: &var record, ir: &var ir, exports: &var exports, plan: &var units,
                                         split: false, front: driver_front_chain(&var front, &plan, true, false),
                                         options: &options)
        if built != 0 {
            driver_print_refusal(source, &var record)
            status = 1
            continue
        }
        if not driver_write_file(ll, ir.build()) {
            print("sawc runtime: --out {} must be a directory that exists; sawc creates none", out_dir)
            return 1
        }
        let arguments = driver_object_arguments(options.module_triple, speed, false, false, "none", ll, object)
        let compiled = driver_clang("sawc runtime", program, &arguments)
        if compiled != 0 {
            return compiled
        }
        var j = 0
        while j < exports.len() {
            try! seams.push(exports.get(j) ?? "")
            try! definers.push(object)
            j = j + 1
        }
        try! objects.push(object)
    }
    if status != 0 {
        return status
    }
    let shim = driver_path(out_dir, "shim", ".o")
    var arguments = Vector<String>()
    try! arguments.push("-c")
    try! arguments.push(driver_path(rt_root, "shim.c", ""))
    try! arguments.push("-O2")
    try! arguments.push("-fno-strict-aliasing")
    try! arguments.push("-target")
    try! arguments.push(options.module_triple)
    try! arguments.push("-o")
    try! arguments.push(shim)
    let compiled = driver_clang("sawc runtime", program, &arguments)
    if compiled != 0 {
        return compiled
    }
    let shim_seams = tc_runtime_shim_seams(host)
    k = 0
    while k < shim_seams.len() {
        try! seams.push(shim_seams.get(k) ?? "")
        try! definers.push(shim)
        k = k + 1
    }
    try! objects.push(shim)
    if not driver_runtime_seams_hold(&seams, &definers) || not driver_distinct(&objects) {
        return 1
    }
    print("target {}", host)
    print("clang {}", program)
    k = 0
    while k < objects.len() {
        print("object {}", objects.get(k) ?? "")
        k = k + 1
    }
    0
}

// The optimisation level a runtime object is built at.
func driver_runtime_speed() -> String {
    "-O2"
}

// Whether `seams`, each defined by the object at the same index of
// `definers`, are the ABI table's runtime seams, each exactly once; every way
// they are not is printed first.
func driver_runtime_seams_hold(seams: &Vector<String>, definers: &Vector<String>) -> Bool {
    var names = Vector<String>()
    var params = Vector<String>()
    var results = Vector<String>()
    var owners = Vector<String>()
    tc_runtime_abi_rows(&var names, &var params, &var results, &var owners)
    var holds = true
    var k = 0
    while k < names.len() {
        let name = names.get(k) ?? ""
        let owner = owners.get(k) ?? ""
        k = k + 1
        if not owner.equals("runtime") {
            continue
        }
        var first = ""
        var j = 0
        while j < seams.len() {
            let seam = seams.get(j) ?? ""
            if seam.equals(name) {
                let by = definers.get(j) ?? ""
                if first.len() > 0 {
                    print("sawc runtime: `{}` is defined by both {} and {}", name, first, by)
                    holds = false
                }
                first = by
            }
            j = j + 1
        }
        if first.len() == 0 {
            print("sawc runtime: no runtime object defines `{}`, which runtime/ABI.md lists", name)
            holds = false
        }
    }
    k = 0
    while k < seams.len() {
        let seam = seams.get(k) ?? ""
        var listed = false
        var j = 0
        while j < names.len() {
            let name = names.get(j) ?? ""
            let owner = owners.get(j) ?? ""
            if name.equals(seam) && owner.equals("runtime") {
                listed = true
            }
            j = j + 1
        }
        if not listed {
            print("sawc runtime: {} defines `{}`, which is not a runtime seam of runtime/ABI.md", definers.get(k) ?? "", seam)
            holds = false
        }
        k = k + 1
    }
    holds
}

// Whether no two of `paths` are the same, which two sources of one stem would
// make; the first repeat is printed.
func driver_distinct(paths: &Vector<String>) -> Bool {
    var k = 0
    while k < paths.len() {
        let one = paths.get(k) ?? ""
        var j = 0
        while j < k {
            let other = paths.get(j) ?? ""
            if other.equals(one) {
                print("sawc runtime: two runtime sources write {}", one)
                return false
            }
            j = j + 1
        }
        k = k + 1
    }
    true
}

// `DIR/NAME` followed by `suffix`.
func driver_path(dir: String, name: String, suffix: String) -> String {
    var out = StringBuilder()
    try! out.append(dir)
    try! out.append("/")
    try! out.append(name)
    try! out.append(suffix)
    out.build()
}

// The file name of `path` without its directory and its `.saw`.
func driver_stem(path: String) -> String {
    var start = 0
    var i = 0
    while i < path.len() {
        if (path.byte_at(i) as Int) == DRIVER_SLASH {
            start = i + 1
        }
        i = i + 1
    }
    var stop = path.len()
    if stop - start > 4 && path.substring(stop - 4, stop).equals(".saw") {
        stop = stop - 4
    }
    path.substring(start, stop)
}

// `sawc mono`: one record per entry file, in order, each file the entry of
// its own program; `--dump` prints the items, `--layouts` the layout table of
// the types they reach.
// The triple a checking subcommand checks for when `--target` names none: an
// LP64 host's, which every hosted triple sawc describes is.
func driver_check_triple() -> String {
    "arm64-apple-darwin"
}

// The target record of a checking subcommand, for `triple` with the
// subtarget features `features`; or none, once the reason is printed, for a
// triple sawc does not describe or a malformed feature list.
func driver_check_target(triple: String, features: String) -> TcTarget? {
    if not target_known(triple) {
        print("sawc: unknown target {triple}")
        return None
    }
    if features.len() > 0 && not driver_features_ok(features) {
        return None
    }
    target_front_end(triple, features)
}

func driver_mono(args: &Vector<String>) -> Int {
    var dump = false
    var layouts = false
    var check = false
    var notes = false
    var counted = false
    var no_front = false
    var std_root = ""
    var triple = driver_check_triple()
    var features = ""
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--layouts") {
            layouts = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if arg.equals("--lowerings") {
            counted = true
        } else if arg.equals("--no-front-cache") {
            no_front = true
        } else if (arg.equals("--std-root") || arg.equals("--module-path") || arg.equals("--target")
                   || arg.equals("--target-features")) {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if arg.equals("--target-features") {
                features = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    let modes = (if dump { 1 } else { 0 }) + (if layouts { 1 } else { 0 }) + (if check { 1 } else { 0 })
    if modes != 1 {
        return driver_usage()
    }
    guard let checked_for = driver_check_target(triple, features) else {
        return DRIVER_EXIT_USAGE
    }
    std_root = driver_std_root("sawc mono", std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    let front_on = driver_front_choice("sawc mono", no_front)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    var front = driver_front(std_root, checked_for, false, false, false, front_on == 1, false)
    let options = MonoOptions(std_root: std_root, target: checked_for, dump: dump, layouts: layouts, notes: notes)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            var lowerings = 0
            let plan = driver_plan(&front, input.path, &names, &dirs)
            let entry_names = driver_entry_names(&plan)
            let entry_dirs = driver_entry_dirs(&plan)
            let result = mono_record(out: &var out, front: driver_front_chain(&var front, &plan, false, false),
                                     path: input.path, options: &options, names: &entry_names, dirs: &entry_dirs,
                                     lowerings: &var lowerings)
            if counted {
                driver_append_lowerings(&var out, lowerings)
            }
            let printed = driver_print_record(&var out, result)
            if printed > status {
                status = printed
            }
        }
        k = k + 1
    }
    status
}

// `sawc coro`: one record per entry file, in order, each file the entry of
// its own program; `--dump` prints each item's frame decision, `--layouts`
// each frame's layout, `--lowered` each lowered frame's resume function, and
// `--bt-table` the program's backtrace table, decoded.
func driver_coro(args: &Vector<String>) -> Int {
    var dump = false
    var layouts = false
    var lowered = false
    var bt_table = false
    var check = false
    var notes = false
    var no_front = false
    var std_root = ""
    var triple = driver_check_triple()
    var features = ""
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--no-front-cache") {
            no_front = true
        } else if arg.equals("--layouts") {
            layouts = true
        } else if arg.equals("--lowered") {
            lowered = true
        } else if arg.equals("--bt-table") {
            bt_table = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if (arg.equals("--std-root") || arg.equals("--module-path") || arg.equals("--target")
                   || arg.equals("--target-features")) {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if arg.equals("--target-features") {
                features = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    let modes = ((if dump { 1 } else { 0 }) + (if layouts { 1 } else { 0 }) + (if lowered { 1 } else { 0 })
                 + (if bt_table { 1 } else { 0 }) + (if check { 1 } else { 0 }))
    if modes != 1 {
        return driver_usage()
    }
    guard let checked_for = driver_check_target(triple, features) else {
        return DRIVER_EXIT_USAGE
    }
    std_root = driver_std_root("sawc coro", std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    let front_on = driver_front_choice("sawc coro", no_front)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    var front = driver_front(std_root, checked_for, false, false, false, front_on == 1, false)
    let options = CoroOptions(std_root: std_root, target: checked_for, dump: dump, layouts: layouts, lowered: lowered,
                              notes: notes)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            var result = 0
            let plan = driver_plan(&front, input.path, &names, &dirs)
            let entry_names = driver_entry_names(&plan)
            let entry_dirs = driver_entry_dirs(&plan)
            let cut = driver_front_chain(&var front, &plan, false, false)
            if bt_table {
                result = coro_bt_record(out: &var out, front: move cut, path: input.path, options: &options,
                                        names: &entry_names, dirs: &entry_dirs)
            } else {
                result = coro_record(out: &var out, front: move cut, path: input.path, options: &options,
                                     names: &entry_names, dirs: &entry_dirs)
            }
            let printed = driver_print_record(&var out, result)
            if printed > status {
                status = printed
            }
        }
        k = k + 1
    }
    status
}

func main() -> Int {
    let args = try! Env.args()
    let command = args.get(1) ?? ""
    if command.equals("lex") {
        return driver_lex(&args)
    }
    if command.equals("parse") {
        return driver_parse(&args)
    }
    if command.equals("resolve") {
        return driver_resolve(&args, DRIVER_STAGE_RESOLVE)
    }
    if command.equals("typecheck") {
        return driver_resolve(&args, DRIVER_STAGE_TYPECHECK)
    }
    if command.equals("fix") {
        return driver_fix(&args)
    }
    if command.equals("mir") {
        return driver_resolve(&args, DRIVER_STAGE_MIR)
    }
    if command.equals("eval") {
        return driver_resolve(&args, DRIVER_STAGE_EVAL)
    }
    if command.equals("borrowck") {
        return driver_resolve(&args, DRIVER_STAGE_BORROWCK)
    }
    if command.equals("drops") {
        return driver_resolve(&args, DRIVER_STAGE_DROPS)
    }
    if command.equals("mono") {
        return driver_mono(&args)
    }
    if command.equals("coro") {
        return driver_coro(&args)
    }
    if command.equals("build") {
        return driver_timed_build(&args, 2)
    }
    if command.equals("runtime") {
        return driver_runtime(&args)
    }
    if command.equals("--version") {
        print("sawc {}", driver_version())
        return 0
    }
    if command.equals("--help") {
        driver_usage()
        return 0
    }
    if command.starts_with("-") || command.ends_with(".saw") {
        return driver_timed_build(&args, 1)
    }
    driver_usage()
}

// `driver_build`, then the stage times `--time-stages` asked for, on standard
// error whatever the build's status; a build without the flag prints nothing
// more.
func driver_timed_build(args: &Vector<String>, first: Int) -> Int {
    let status = driver_build(&args, first)
    stagetime_report()
    status
}

// The release this compiler is, which `sawc --version` prints as `sawc
// VERSION`: a toolchain consumer checks it against its pin before trusting a
// `sawc` found on `PATH`. compiler/tests/run.py fails unless it equals
// `.sawtracker/version`, so a release bump edits both.
func driver_version() -> String {
    "0.20.0"
}

// The program stages `driver_resolve` runs to.
static DRIVER_STAGE_RESOLVE: Int = 0
static DRIVER_STAGE_TYPECHECK: Int = 1
static DRIVER_STAGE_MIR: Int = 2
static DRIVER_STAGE_EVAL: Int = 3
static DRIVER_STAGE_BORROWCK: Int = 4
static DRIVER_STAGE_DROPS: Int = 5

// `sawc resolve`, `typecheck`, `mir`, `eval`, `borrowck` and `drops`, which take the same
// flags, `--interfaces` and `--summaries` typecheck's alone and `--spans` the
// MIR's: one record per
// entry file, in order, each file the entry of its own program.
func driver_resolve(args: &Vector<String>, stage: Int) -> Int {
    let typecheck = stage == DRIVER_STAGE_TYPECHECK
    var dump = false
    var check = false
    var notes = false
    var spans = false
    var interfaces = false
    var summaries = false
    var provider = false
    var freestanding = false
    var hidden = false
    var counted = false
    var warn = false
    var no_front = false
    var std_root = ""
    var triple = driver_check_triple()
    var features = ""
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--no-front-cache") {
            no_front = true
        } else if arg.equals("-W") && typecheck {
            if not driver_warning_category(args.get(i + 1) ?? "") {
                return DRIVER_EXIT_USAGE
            }
            warn = true
            i = i + 1
        } else if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if arg.equals("--lowerings") {
            counted = true
        } else if arg.equals("--interfaces") && typecheck {
            interfaces = true
        } else if arg.equals("--summaries") && typecheck {
            summaries = true
        } else if (arg.equals("--runtime") || arg.equals("--runtime-provider")) && typecheck {
            provider = true
        } else if arg.equals("--freestanding") && typecheck {
            freestanding = true
        } else if arg.equals("--no-hidden-alloc") && typecheck {
            hidden = true
        } else if arg.equals("--spans") && stage == DRIVER_STAGE_MIR {
            spans = true
        } else if (arg.equals("--std-root") || arg.equals("--module-path")
                   || ((arg.equals("--target") || arg.equals("--target-features")) && stage != DRIVER_STAGE_RESOLVE)) {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if arg.equals("--target-features") {
                features = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    if dump == check {
        return driver_usage()
    }
    var command = StringBuilder()
    try! command.append("sawc ")
    try! command.append(args.get(1) ?? "")
    guard let checked_for = driver_check_target(triple, features) else {
        return DRIVER_EXIT_USAGE
    }
    let named = command.build()
    std_root = driver_std_root(named, std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    let front_on = driver_front_choice(named, no_front)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    // Every stage starts from std's cut, brought through drops whatever stage
    // the command stops at, so a cut read from the cache and one computed
    // give every record the same program.
    var front = driver_front(std_root, checked_for, false, freestanding, provider, front_on == 1, false)
    let options = ResolveOptions(std_root: std_root, dump: dump, notes: notes)
    let checking = TypecheckOptions(std_root: std_root, dump: dump, notes: notes,
                                    interfaces: interfaces, summaries: summaries, warn_borrow_prefix: warn)
    let lowering = MirOptions(std_root: std_root, dump: dump, notes: notes, spans: spans, target: checked_for)
    let evaluating = EvalOptions(std_root: std_root, dump: dump, notes: notes, target: checked_for)
    let borrowing = BorrowckOptions(std_root: std_root, dump: dump, notes: notes, target: checked_for)
    let elaborating = DropsOptions(std_root: std_root, dump: dump, notes: notes, target: checked_for)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            var result = 0
            var lowerings = 0
            // Every layer before the entry's comes through drops, read from the
            // front cache or computed and stored, whatever stage the command
            // stops at, so its sections print alike whatever the cache held;
            // the record runs the entry's layer to its own stage.
            let plan = driver_plan(&front, input.path, &names, &dirs)
            let entry_names = driver_entry_names(&plan)
            let entry_dirs = driver_entry_dirs(&plan)
            var cut = driver_front_chain(&var front, &plan, false, hidden)
            // The earlier layers' lines, as each recorded them when it ran.
            let checked_std = cut.checked
            if stage == DRIVER_STAGE_DROPS {
                let start = DropsStart(checked: checked_std, verified: cut.verified, elaborated: cut.elaborated,
                                       blocked: cut.blocked)
                let prior = cut.layers.copy()
                result = drops_record_from(out: &var out, p: &var cut.drops, prior: &prior, start: start,
                                           path: input.path, options: &elaborating, names: &entry_names,
                                           dirs: &entry_dirs, lowerings: &var lowerings)
            } else if stage == DRIVER_STAGE_BORROWCK {
                let start = BorrowckStart(checked: checked_std, verified: cut.verified, verified_std: true)
                result = borrowck_record_from(out: &var out, p: &var cut.drops.bc, start: start, path: input.path,
                                              options: &borrowing, names: &entry_names, dirs: &entry_dirs,
                                              lowerings: &var lowerings)
            } else if stage == DRIVER_STAGE_EVAL {
                let start = EvalStart(checked: checked_std, verified_std: true)
                let (taken, values) = (move cut).take_program()
                var lowered = move taken
                var evaluated = move values
                result = eval_record_from(out: &var out, lowered: &var lowered.bc.mir, p: &var evaluated,
                                          start: start, path: input.path, options: &evaluating, names: &entry_names,
                                          dirs: &entry_dirs, lowerings: &var lowerings)
            } else if stage == DRIVER_STAGE_MIR {
                result = mir_record_from(out: &var out, p: &var cut.drops.bc.mir, checked: checked_std,
                                         verified_std: true, path: input.path, options: &lowering,
                                         names: &entry_names, dirs: &entry_dirs, lowerings: &var lowerings)
            } else if typecheck {
                let first = cut.drops.bc.mir.tc.res.module_count()
                asserts_program_layer(&var cut.drops.bc.mir.tc, input.path, &entry_names, &entry_dirs, hidden)
                result = typecheck_record_from(out: &var out, p: &cut.drops.bc.mir.tc, options: &checking,
                                               first: first)
            } else {
                let start = ResolveStart(checked: checked_std, verified_std: true)
                result = resolve_record_from(out: &var out, p: &var cut.drops.bc.mir.tc.res, start: start,
                                             path: input.path, options: &options, names: &entry_names,
                                             dirs: &entry_dirs)
            }
            if counted {
                driver_append_lowerings(&var out, lowerings)
            }
            let printed = driver_print_record(&var out, result)
            if printed > status {
                status = printed
            }
        }
        k = k + 1
    }
    status
}

// `sawc fix`: in each FILE, every old `borrow` prefix SL:borrowing §12 makes
// redundant is dropped where it stands, or replaced with the sigil of the
// reference argument it passes. Each FILE is typechecked as an entry, and the
// fix-its are the `borrows.redundant-prefix` warnings' (`-W borrow-prefix`),
// so the tool needs no warning shown. A record per file lists `FIX` per site
// rewritten and `KEEP` per prefix left, with why; `--check` rewrites nothing.
// A file the parser or resolve refuses is listed `SKIP`, since its tree and
// its names' types are what decide.
func driver_fix(args: &Vector<String>) -> Int {
    var check = false
    var no_front = false
    var std_root = ""
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--check") {
            check = true
        } else if arg.equals("--no-front-cache") {
            no_front = true
        } else if arg.equals("--std-root") || arg.equals("--module-path") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    if inputs.len() == 0 {
        return driver_usage()
    }
    std_root = driver_std_root("sawc fix", std_root)
    if std_root.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    let front_on = driver_front_choice("sawc fix", no_front)
    if front_on < 0 {
        return DRIVER_EXIT_USAGE
    }
    var front = driver_front(std_root, target_front_end(driver_check_triple(), ""), false, false, false,
                             front_on == 1, false)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            if not driver_fix_file(input.path, &var front, check, &names, &dirs) {
                status = 1
            }
        }
        k = k + 1
    }
    status
}

// One file of `sawc fix`, its program's layer typechecked from std's cut for
// `front`; false when it could not be written.
func driver_fix_file(path: String, front: &var DriverFront, check: Bool, names: &Vector<String>,
                     dirs: &Vector<String>) -> Bool {
    let plan = driver_plan(&front, path, &names, &dirs)
    let entry_names = driver_entry_names(&plan)
    let entry_dirs = driver_entry_dirs(&plan)
    var cut = driver_front_chain(&var front, &plan, false, false)
    asserts_program_layer(&var cut.drops.bc.mir.tc, path, &entry_names, &entry_dirs, false)
    driver_fix_checked(path, &cut.drops.bc.mir.tc, check)
}

// `sawc fix`'s record of `path` from its checked program `p`, and the file
// rewritten unless `check`; false when it could not be written.
func driver_fix_checked(path: String, p: &TcProgram, check: Bool) -> Bool {
    var record = StringBuilder()
    try! record.append("FILE\t")
    try! record.append(path)
    try! record.append("\n")
    var m = -1
    var k = 0
    while k < p.res.module_count() {
        if m < 0 && p.res.module_file(k).equals(path) && not tc_module_is_std(&p, k) {
            m = k
        }
        k = k + 1
    }
    // A file that does not resolve is left whole: the types its unresolved
    // names would give decide whether a prefix is redundant.
    k = 0
    while k < p.res.diags.len() {
        let d = p.res.diags[k]
        k = k + 1
        if not d.note && (m < 0 || d.module == m) {
            try! record.append("SKIP\t")
            try! record.append(path)
            try! record.append("\tit does not resolve (")
            try! record.append(d.id)
            try! record.append("), and the types it would give decide each prefix\n")
            print(record.build())
            return true
        }
    }
    if m < 0 {
        try! record.append("SKIP\t")
        try! record.append(path)
        try! record.append("\tno module of the program is this file\n")
        print(record.build())
        return true
    }
    // The fix-its, latest first, so each edit leaves the offsets of those
    // before it standing; one that overlaps an edit already taken is left.
    var order = Vector<Int>()
    k = 0
    while k < p.warnings.len() {
        let w = p.warnings[k]
        if w.module == m && not w.kept && w.fix_start >= 0 {
            var at = order.len()
            try! order.push(k)
            while at > 0 && p.warnings[order[at - 1]].fix_start < w.fix_start {
                order[at] = order[at - 1]
                at = at - 1
            }
            order[at] = k
        }
        k = k + 1
    }
    let text = p.res.module_text(m)
    var out = text.substring(0, text.len())
    var limit = text.len() + 1
    var fixed = 0
    k = 0
    while k < order.len() {
        let w = p.warnings[order[k]]
        k = k + 1
        if w.fix_end > limit {
            continue
        }
        var next = StringBuilder()
        try! next.append(out.substring(0, w.fix_start))
        try! next.append(w.fix_text)
        try! next.append(out.substring(w.fix_end, out.len()))
        out = next.build()
        limit = w.fix_start
        fixed = fixed + 1
        try! record.append("FIX\t")
        try! record.append(path)
        try! record.append(":")
        try! record.append(p.res.position_text(m, w.start))
        try! record.append("\t")
        try! record.append(w.form)
        try! record.append("\n")
    }
    var kept = 0
    k = 0
    while k < p.warnings.len() {
        let w = p.warnings[k]
        k = k + 1
        if w.module != m || not w.kept {
            continue
        }
        kept = kept + 1
        try! record.append("KEEP\t")
        try! record.append(path)
        try! record.append(":")
        try! record.append(p.res.position_text(m, w.start))
        try! record.append("\t")
        try! record.append(w.form)
        try! record.append("\t")
        try! record.append(w.message)
        try! record.append("\n")
    }
    try! record.append("FIXED\t")
    try! record.append(fixed)
    try! record.append("\tKEPT\t")
    try! record.append(kept)
    try! record.append("\n")
    print(record.build())
    if check || fixed == 0 {
        return true
    }
    driver_write_file(path, out)
}

// The `LOWERINGS<TAB>N` line `--lowerings` ends a record with: how many times
// its program's source was lowered to MIR, which is 1 on every path that
// lowers and 0 on the two that stop before MIR (SL-523).
func driver_append_lowerings(out: &var StringBuilder, lowerings: Int) {
    try! out.append("LOWERINGS\t")
    try! out.append(lowerings)
    try! out.append("\n")
}

// Adds a `NAME=DIR` package mapping; false when the text has no `=`.
func driver_add_mapping(names: &var Vector<String>, dirs: &var Vector<String>, text: String) -> Bool {
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == DRIVER_EQUALS {
            try! names.push(text.substring(0, i))
            try! dirs.push(text.substring(i + 1, n))
            return true
        }
        i = i + 1
    }
    false
}

// One input of `sawc parse`: a path, and whether it is parsed from
// `refusal-unit` rather than `source-file`.
struct DriverInput {
    path: String
    unit: Bool
}

// Adds the inputs a `@LIST` file names, one path per line. A line may start
// with `--unit ` to parse that file from `refusal-unit`.
func driver_add_list(inputs: &var Vector<DriverInput>, list: String) -> Bool {
    if let text = driver_read_source(list) {
        var start = 0
        var i = 0
        while i <= text.len() {
            if i == text.len() || (text.byte_at(i) as Int) == DRIVER_NEWLINE {
                if i > start {
                    let line = text.substring(start, i)
                    if line.starts_with("--unit ") {
                        let path = text.substring(start + 7, i)
                        try! inputs.push(DriverInput(path: path, unit: true))
                    } else {
                        try! inputs.push(DriverInput(path: line, unit: false))
                    }
                }
                start = i + 1
            }
            i = i + 1
        }
        true
    } else {
        false
    }
}

// `sawc parse`: one record per input, in order, so that one process covers a
// whole corpus.
func driver_parse(args: &Vector<String>) -> Int {
    var dump = false
    var check = false
    var reread = false
    var alternatives = false
    var unit_next = false
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--redump") {
            reread = true
        } else if arg.equals("--alternatives") {
            alternatives = true
        } else if arg.equals("--unit") {
            unit_next = true
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: unit_next))
            unit_next = false
        }
        i = i + 1
    }
    let modes = (if dump { 1 } else { 0 }) + (if check { 1 } else { 0 }) + (if reread { 1 } else { 0 })
    if modes != 1 || unit_next {
        return driver_usage()
    }
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            let result = driver_parse_one(&input, dump, reread, alternatives)
            if result > status {
                status = result
            }
        }
        k = k + 1
    }
    status
}

func driver_parse_one(input: &DriverInput, dump: Bool, reread: Bool, alternatives: Bool) -> Int {
    var out = StringBuilder()
    try! out.append("FILE\t")
    try! out.append(input.path)
    try! out.append("\n")
    let source = driver_read_source(input.path)
    if let text = source {
        if reread {
            try! out.append(redump(text))
            print(out.build())
            return 0
        }
        let options = ParseOptions(unit: input.unit, dump: dump, alternatives: alternatives)
        let status = parse_record(out: &var out, path: input.path, text: text, options: &options)
        return driver_print_record(&var out, status)
    }
    print(out.build())
    DRIVER_EXIT_USAGE
}

// THE RECORD STATUS FUNNEL: prints a finished record and returns its exit
// status, as `drops_record_status` decides it from the record and its
// stage's status, so a record holding an `INVARIANT` line never exits 0.
//
// ENTRY POINTS (driver_print_record):
//     driver_parse_one
//     driver_resolve
//     driver_mono
//     driver_coro
func driver_print_record(out: &var StringBuilder, status: Int) -> Int {
    let text = out.build()
    print(text)
    drops_record_status(text, status)
}

// `sawc lex`: the arguments after the subcommand name one file or one `@LIST`,
// or ask for the kind list.
func driver_lex(args: &Vector<String>) -> Int {
    var docs_mode = false
    var kinds_mode = false
    var path = ""
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--docs") {
            docs_mode = true
        } else if arg.equals("--kinds") {
            kinds_mode = true
        } else if arg.starts_with("--") || not path.equals("") {
            return driver_usage()
        } else {
            path = arg
        }
        i = i + 1
    }
    if kinds_mode {
        if docs_mode || not path.equals("") {
            return driver_usage()
        }
        return driver_print_kinds()
    }
    if path.equals("") {
        return driver_usage()
    }
    if path.len() > 1 && (path.byte_at(0) as Int) == DRIVER_AT {
        if docs_mode {
            return driver_usage()
        }
        // Stage 0 workaround (SL:hazards S4): canonical: return driver_lex_list(path.substring(1, path.len()))
        let size = path.len()
        let list = path.substring(1, size)
        return driver_lex_list(list)
    }
    driver_lex_part(path, docs_mode)
}

// One file's token dump, or its doc dump, and the status `sawc lex` exits with.
func driver_lex_part(path: String, docs_mode: Bool) -> Int {
    if let text = driver_read_source(path) {
        driver_dump(text, docs_mode)
    } else {
        DRIVER_EXIT_USAGE
    }
}

// `sawc lex @LIST`: for each listed file, `FILE\tPATH`, what `sawc lex PATH`
// prints, `DOCS\tSTATUS` with that command's exit status, what `sawc lex
// --docs PATH` prints, and `END\tSTATUS`. Each part is byte for byte the
// single-file command's output, so one process can stand for many. No token or
// doc record starts with `FILE`, `DOCS` or `END`. Exits with the largest status.
func driver_lex_list(list: String) -> Int {
    var inputs = Vector<DriverInput>()
    if not driver_add_list(&var inputs, list) {
        return DRIVER_EXIT_USAGE
    }
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            print("FILE\t{}", input.path)
            let tokens = driver_lex_part(input.path, false)
            print("DOCS\t{}", tokens)
            let docs = driver_lex_part(input.path, true)
            print("END\t{}", docs)
            if tokens > status {
                status = tokens
            }
            if docs > status {
                status = docs
            }
        }
        k = k + 1
    }
    status
}

// The file's text, or None once the reason it could not be read is printed.
func driver_read_source(path: String) -> String? {
    let opened = File.open(Path(s: path))
    var file = match opened {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("sawc: cannot open {path}: {e}")
            return None
        }
    }
    let read = file.read()
    let data = match read {
        case Ok(bytes) -> move bytes,
        case Err(e) -> {
            print("sawc: cannot read {path}: {e}")
            return None
        }
    }
    let decoded = data.to_string()
    match decoded {
        case Ok(text) -> text,
        case Err(e) -> {
            print("sawc: {path} is not valid UTF-8 (byte {e.offset})")
            None
        }
    }
}

func driver_dump(source: String, docs_mode: Bool) -> Int {
    let lexed = lex(source)
    match lexed {
        case Ok(result) -> {
            if docs_mode {
                driver_print_docs(&result)
            } else {
                driver_print_tokens(&result)
            }
            0
        },
        case Err(e) -> {
            print(format_error(&e))
            DRIVER_EXIT_LEX_ERROR
        }
    }
}

func driver_print_tokens(result: &LexResult) {
    var i = 0
    while i < result.tokens.len() {
        if let t = result.tokens.get(i) {
            print(format_token(&t, &result.segments))
        }
        i = i + 1
    }
}

func driver_print_docs(result: &LexResult) {
    var i = 0
    while i < result.docs.len() {
        if let d = result.docs.get(i) {
            print(format_doc(&d))
        }
        i = i + 1
    }
}

func driver_print_kinds() -> Int {
    let kinds = token_kinds()
    var i = 0
    while i < kinds.len() {
        if let k = kinds.get(i) {
            print(kind_name(k))
        }
        i = i + 1
    }
    0
}
