// sawc2, the driver of the self-hosted Saw compiler. Each stage is reached
// through a subcommand.
//
//   sawc2 lex [--docs] <file.saw>   the token dump, or the doc-comment trivia
//   sawc2 lex --kinds               every token kind's dump name, one per line
//   sawc2 parse --dump FILE...      each file's canonical AST dump
//   sawc2 parse --check FILE...     each file's diagnostics only
//   sawc2 parse --redump FILE...    each dump file read back and rendered again
//   sawc2 resolve --dump FILE...    each entry file's program resolved, and its dump
//   sawc2 resolve --check FILE...   each entry file's program resolved, refusals only
//   sawc2 typecheck --dump FILE...  each entry file's signatures checked, and its dump
//   sawc2 typecheck --check FILE... each entry file's signatures checked, refusals only
//   sawc2 mir --dump FILE...        each entry file's program lowered to MIR, and its dump
//   sawc2 mir --check FILE...       each entry file's program lowered, refusals and invariants only
//   sawc2 eval --dump FILE...       each entry file's constants evaluated, and their values
//   sawc2 eval --check FILE...      each entry file's constants evaluated, refusals and invariants only
//   sawc2 borrowck --dump FILE...   each entry file's program borrow checked, and its dump
//   sawc2 borrowck --check FILE...  each entry file's program borrow checked, refusals and invariants only
//   sawc2 drops --dump FILE...      each entry file's program with its drops elaborated, and its dump
//   sawc2 drops --check FILE...     each entry file's program elaborated, refusals and invariants only
//   sawc2 mono --dump FILE...       each entry file's program monomorphized, and its items
//   sawc2 mono --layouts FILE...    each entry file's program monomorphized, and its types' layouts
//   sawc2 mono --check FILE...      each entry file's program monomorphized, refusals and invariants only
//   sawc2 coro --dump FILE...       each entry file's program through coroutine lowering, and each item's frame
//   sawc2 coro --check FILE...      each entry file's program through coroutine lowering, refusals and invariants only
//   sawc2 build FILE [-o OUT]       the entry file's program compiled and linked by clang
//   sawc2 build --emit-ll FILE      the entry file's program as one `.ll` on standard output
//   sawc2 runtime --out DIR         the host's runtime objects built into DIR
//   sawc2 runtime --emit-ll FILE    one runtime source as one `.ll` on standard output
//
// The lexer's records are its canonical dump (compiler/lex/README.md), the
// parser's are described in compiler/parse/README.md, the resolver's in
// compiler/tests/resolve/README.md, and the type checker's in
// compiler/tests/typecheck/README.md, the MIR's in compiler/tests/mir/README.md,
// the evaluator's in compiler/tests/eval/README.md, the borrow check's in
// compiler/tests/borrowck/README.md, drop elaboration's in
// compiler/tests/drops/README.md, and coroutine lowering's in
// compiler/tests/coro/README.md.
// A lex error prints one ERROR record and
// exits 1, and so does a file a later stage refuses; a usage or I/O failure
// prints a message and exits 2.

import sawasserts.layout.{asserts_typecheck_program}
import sawborrowck.api.{BorrowckOptions, borrowck_record}
import sawcoro.api.{CoroOptions, coro_record}
import sawdrops.api.{DropsOptions, drops_record}
import saweval.api.{EvalOptions, eval_record}
import sawlex.{LexResult, format_doc, format_error, format_token, kind_name, lex, token_kinds}
import sawllvm.api.{BuildOptions, llvm_build, llvm_build_exporting}
import sawmir.api.{MirOptions, mir_record}
import sawmono.api.{MonoOptions, mono_record}
import sawparse.api.{ParseOptions, parse_record}
import sawparse.reader.{redump}
import sawresolve.api.{ResolveOptions, resolve_record}
import sawtarget.layout.{target_clang_triple, target_known}
import sawtypecheck.api.{TypecheckOptions, typecheck_record}
import sawtypecheck.runtimeabi.{tc_runtime_abi_rows, tc_runtime_shim_seams, tc_runtime_sources}
import std.data.{Data}
import std.env.{Env}
import std.file.{File}
import std.path.{Path}
import std.process.{Command}

static DRIVER_EXIT_LEX_ERROR: Int = 1
static DRIVER_EXIT_USAGE: Int = 2
static DRIVER_NEWLINE: Int = 10
static DRIVER_AT: Int = 64
static DRIVER_EQUALS: Int = 61
static DRIVER_SLASH: Int = 47
func driver_usage() -> Int {
    print("usage: sawc2 lex [--docs] <file.saw>")
    print("       sawc2 lex --kinds")
    print("       sawc2 parse (--dump | --check) [--alternatives] [[--unit] FILE | @LIST]...")
    print("       sawc2 parse --redump [FILE | @LIST]...")
    print("       sawc2 resolve (--dump | --check) [--notes] [--std-root DIR]")
    print("                     [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 typecheck (--dump | --check) [--notes] [--interfaces] [--summaries] [--runtime]")
    print("                       [--std-root DIR] [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 mir (--dump | --check) [--notes] [--spans] [--std-root DIR]")
    print("                 [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 eval (--dump | --check) [--notes] [--std-root DIR]")
    print("                  [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 borrowck (--dump | --check) [--notes] [--std-root DIR]")
    print("                      [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 drops (--dump | --check) [--notes] [--std-root DIR]")
    print("                   [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 mono (--dump | --layouts | --check) [--notes] [--std-root DIR] [--target TRIPLE]")
    print("                  [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 coro (--dump | --check) [--notes] [--std-root DIR]")
    print("                  [--module-path NAME=DIR]... [FILE | @LIST]...")
    print("       sawc2 build [-O0 | -O1 | -O2 | -Os | -Oz] [--std-root DIR] [--target TRIPLE]")
    print("                   [--module-path NAME=DIR]... (FILE [-o OUT] | --emit-ll FILE)")
    print("       sawc2 runtime [--std-root DIR] [--rt-root DIR] (--out DIR | --emit-ll FILE)")
    DRIVER_EXIT_USAGE
}

// The optimisation level `flag` asks for, as the flag clang takes, or "" for
// none: the one place a speed flag is read (design 265's `speed_level`).
func driver_speed_level(flag: String) -> String {
    if flag.equals("-O0") || flag.equals("-O1") || flag.equals("-O2") || flag.equals("-Os") || flag.equals("-Oz") {
        return flag
    }
    ""
}

// `sawc2 build FILE`: the program compiled to `OUT.ll` and linked by clang
// into `OUT` against the runtime objects the manifest beside this binary
// names; with `--emit-ll`, its `.ll` on standard output and nothing linked.
// A refusal prints its record and exits 1, and a failing clang's exit status
// is the build's (compiler/tests/run/README.md).
func driver_build(args: &Vector<String>) -> Int {
    var std_root = "sawc"
    var triple = ""
    var speed = "-O0"
    var names = Vector<String>()
    var dirs = Vector<String>()
    var path = ""
    var out = ""
    var emit = false
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        let level = driver_speed_level(arg)
        let valued = arg.equals("--std-root") || arg.equals("--module-path") || arg.equals("--target")
        if level.len() > 0 {
            speed = level
        } else if arg.equals("--emit-ll") {
            emit = true
        } else if valued || arg.equals("-o") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if arg.equals("-o") {
                out = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("-") || path.len() > 0 {
            return driver_usage()
        } else {
            path = arg
        }
        i = i + 1
    }
    if path.len() == 0 || (emit && out.len() > 0) {
        return driver_usage()
    }
    if triple.len() > 0 && not target_known(triple) {
        // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: unknown target {triple}")
        print("sawc2: unknown target {}", triple)
        return DRIVER_EXIT_USAGE
    }
    if emit {
        if triple.len() == 0 {
            triple = "arm64-apple-darwin"
        }
        return driver_emit(path, std_root, triple, speed, &names, &dirs)
    }
    var objects = Vector<String>()
    let host = driver_read_runtime(&var objects)
    if host.len() == 0 {
        return DRIVER_EXIT_USAGE
    }
    if triple.len() == 0 {
        triple = host
    } else if not triple.equals(host) {
        print("sawc2 build: --target {} is not this host ({}): a build links against the host's runtime, so only the host is a build target; `sawc2 mono --layouts --target {}` describes another target's layouts", triple, host, triple)
        return 1
    }
    if out.len() == 0 {
        out = driver_default_output(path)
    }
    let clang_triple = target_clang_triple(triple)
    let options = BuildOptions(std_root: std_root, target: triple, speed: speed, module_triple: clang_triple,
                               runtime: false)
    var record = StringBuilder()
    var ir = StringBuilder()
    let status = llvm_build(out: &var record, ir: &var ir, path: path, options: &options, names: &names, dirs: &dirs)
    if status != 0 {
        driver_print_refusal(path, &var record)
        return status
    }
    var ll = StringBuilder()
    try! ll.append(out)
    try! ll.append(".ll")
    let ll_path = ll.build()
    if not driver_write_file(ll_path, ir.build()) {
        return 1
    }
    driver_link(ll_path, out, speed, clang_triple, &objects)
}

// `sawc2 build --emit-ll FILE`: the program's `.ll` on standard output, or
// the record of what refused it and its status.
func driver_emit(path: String, std_root: String, triple: String, speed: String, names: &Vector<String>,
                 dirs: &Vector<String>) -> Int {
    let options = BuildOptions(std_root: std_root, target: triple, speed: speed,
                               module_triple: target_clang_triple(triple), runtime: false)
    var record = StringBuilder()
    var ir = StringBuilder()
    let status = llvm_build(out: &var record, ir: &var ir, path: path, options: &options, names: &names, dirs: &dirs)
    if status != 0 {
        driver_print_refusal(path, &var record)
        return status
    }
    print(ir.build())
    0
}

// Prints the record `sawc2 mono --check` would, headed by its file.
func driver_print_refusal(path: String, found: &var StringBuilder) {
    try! found.append("\n")
    var record = StringBuilder()
    try! record.append("FILE\t")
    try! record.append(path)
    try! record.append("\n")
    try! record.append(found.build())
    print(record.build())
}

// `.build/NAME` for the entry file `path`, NAME its file name without `.saw`.
func driver_default_output(path: String) -> String {
    driver_path(".build", driver_stem(path), "")
}

// The host target the runtime manifest beside this binary names, its objects
// added to `objects`; "" once the reason it cannot be read is printed. The
// manifest is `sawc2-runtime.txt` in the directory of the executable this
// process runs from, its real path, since `argv[0]` names a bare command
// found through `PATH` or a symbolic link: a `target TRIPLE` line, then an
// `object PATH` line per runtime object (compiler/tools/build.py writes it).
func driver_read_runtime(objects: &var Vector<String>) -> String {
    let found = Env.executable_path()
    let binary = match found {
        case Ok(path) -> path,
        case Err(e) -> {
            print("sawc2 build: cannot find this executable's path: {}", e)
            return ""
        }
    }
    var slash = 0 - 1
    var i = 0
    while i < binary.len() {
        if (binary.byte_at(i) as Int) == DRIVER_SLASH {
            slash = i
        }
        i = i + 1
    }
    var manifest = StringBuilder()
    if slash < 0 {
        try! manifest.append(".")
    } else {
        try! manifest.append(binary.substring(0, slash))
    }
    try! manifest.append("/sawc2-runtime.txt")
    let at = manifest.build()
    guard let text = driver_read_source(at) else {
        print("sawc2 build: no runtime manifest beside the binary; compiler/tools/build.py writes it")
        return ""
    }
    var host = ""
    var start = 0
    var k = 0
    while k <= text.len() {
        if k == text.len() || (text.byte_at(k) as Int) == DRIVER_NEWLINE {
            if k > start {
                let line = text.substring(start, k)
                if line.starts_with("target ") {
                    host = text.substring(start + 7, k)
                } else if line.starts_with("object ") {
                    try! objects.push(text.substring(start + 7, k))
                } else {
                    print("sawc2 build: {}: unknown line `{}`", at, line)
                    return ""
                }
            }
            start = k + 1
        }
        k = k + 1
    }
    if host.len() == 0 || not target_known(host) {
        print("sawc2 build: {} names no target sawc2 knows", at)
        return ""
    }
    host
}

// Writes `text` to the file at `path`, or prints why it could not and
// returns false.
func driver_write_file(path: String, text: String) -> Bool {
    let created = File.create(Path(s: path))
    var file = match created {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot create {path}: {e}")
            print("sawc2: cannot create {}: {}", path, e)
            return false
        }
    }
    let converted = text.to_data()
    let data = match converted {
        case Ok(bytes) -> bytes,
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot write {path}: {e}")
            print("sawc2: cannot write {}: {}", path, e)
            return false
        }
    }
    let written = file.write(data)
    match written {
        case Ok(count) -> {
            if count != text.len() {
                print("sawc2: {}: wrote {} of {} bytes", path, count, text.len())
                return false
            }
        },
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot write {path}: {e}")
            print("sawc2: cannot write {}: {}", path, e)
            return false
        }
    }
    // Stage 0 workaround (SL:hazards S28): canonical: var out = BufferedFile(move file); try out.write(text) — its deinit flushes and closes the file
    let closed = file.close()
    match closed {
        case Ok(_) -> true,
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot close {path}: {e}")
            print("sawc2: cannot close {}: {}", path, e)
            false
        }
    }
}

// Runs `clang -target TRIPLE SPEED -x ir LL -x none OBJECTS... -o OUT` and
// returns its exit status, or 1 once the reason it could not run is printed.
func driver_link(ll: String, out: String, speed: String, triple: String, objects: &Vector<String>) -> Int {
    var arguments = Vector<String>()
    try! arguments.push("-target")
    try! arguments.push(triple)
    try! arguments.push(speed)
    try! arguments.push("-x")
    try! arguments.push("ir")
    try! arguments.push(ll)
    try! arguments.push("-x")
    try! arguments.push("none")
    var i = 0
    while i < objects.len() {
        try! arguments.push(objects.get(i) ?? "")
        i = i + 1
    }
    try! arguments.push("-o")
    try! arguments.push(out)
    driver_clang("sawc2 build", &arguments)
}

// Runs clang with `arguments` and returns its exit status, or 1 once the
// reason it could not run is printed, headed by `command`.
func driver_clang(command: String, arguments: &Vector<String>) -> Int {
    var clang = Command(program: "clang")
    var i = 0
    while i < arguments.len() {
        try! clang.arg(arguments.get(i) ?? "")
        i = i + 1
    }
    // Stage 0 workaround (SL:hazards S28): canonical: let code = try clang.status() — a child handle whose deinit waits for it
    let waited = clang.wait()
    match waited {
        case Ok(code) -> {
            if code != 0 {
                print("{}: clang exited {}", command, code)
            }
            code as Int
        },
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("{command}: cannot run clang: {e}")
            print("{}: cannot run clang: {}", command, e)
            1
        }
    }
}

// `sawc2 runtime --out DIR`: each runtime source of the host, as the ABI
// table lists them under the runtime root, compiled to `DIR/NAME.ll` and by
// clang to `DIR/NAME.o`, and the C shim to `DIR/shim.o`, all at the module's
// target; then every runtime seam of the table must be defined by exactly one
// of them, and nothing else by any. On success the runtime manifest naming
// the objects is printed. DIR must exist, and nothing is cached here, since
// caching would need directory operations std lacks (SL:open-questions D41).
// With `--emit-ll FILE`, that one source's `.ll` goes to standard output.
func driver_runtime(args: &Vector<String>) -> Int {
    // The runtime sources are written against the new std's `Atomic` and cell,
    // so they build against `std/` alone, unlike every other subcommand.
    var std_root = "std"
    var rt_root = "sawc/rt"
    var out_dir = ""
    var emit = ""
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        let value = args.get(i + 1) ?? ""
        if value.len() == 0 {
            return driver_usage()
        }
        if arg.equals("--std-root") {
            std_root = value
        } else if arg.equals("--rt-root") {
            rt_root = value
        } else if arg.equals("--out") {
            out_dir = value
        } else if arg.equals("--emit-ll") {
            emit = value
        } else {
            return driver_usage()
        }
        i = i + 2
    }
    if (out_dir.len() == 0) == (emit.len() == 0) {
        return driver_usage()
    }
    let host = driver_runtime_host()
    let speed = driver_runtime_speed()
    let options = BuildOptions(std_root: std_root, target: host, speed: speed,
                               module_triple: target_clang_triple(host), runtime: true)
    let names = Vector<String>()
    let dirs = Vector<String>()
    if emit.len() > 0 {
        var record = StringBuilder()
        var ir = StringBuilder()
        let status = llvm_build(out: &var record, ir: &var ir, path: emit, options: &options, names: &names,
                                dirs: &dirs)
        if status != 0 {
            driver_print_refusal(emit, &var record)
            return status
        }
        print(ir.build())
        return 0
    }
    let sources = tc_runtime_sources(host)
    var objects = Vector<String>()
    var seams = Vector<String>()
    var definers = Vector<String>()
    var status = 0
    var k = 0
    while k < sources.len() {
        let source = driver_path(rt_root, sources.get(k) ?? "", "")
        let stem = driver_stem(source)
        let ll = driver_path(out_dir, stem, ".ll")
        let object = driver_path(out_dir, stem, ".o")
        k = k + 1
        var record = StringBuilder()
        var ir = StringBuilder()
        var exports = Vector<String>()
        let built = llvm_build_exporting(out: &var record, ir: &var ir, exports: &var exports, path: source,
                                         options: &options, names: &names, dirs: &dirs)
        if built != 0 {
            driver_print_refusal(source, &var record)
            status = 1
            continue
        }
        if not driver_write_file(ll, ir.build()) {
            print("sawc2 runtime: --out {} must be a directory that exists; sawc2 creates none", out_dir)
            return 1
        }
        var arguments = Vector<String>()
        try! arguments.push("-c")
        try! arguments.push("-target")
        try! arguments.push(options.module_triple)
        try! arguments.push(speed)
        try! arguments.push("-x")
        try! arguments.push("ir")
        try! arguments.push(ll)
        try! arguments.push("-o")
        try! arguments.push(object)
        let compiled = driver_clang("sawc2 runtime", &arguments)
        if compiled != 0 {
            return compiled
        }
        var j = 0
        while j < exports.len() {
            try! seams.push(exports.get(j) ?? "")
            try! definers.push(object)
            j = j + 1
        }
        try! objects.push(object)
    }
    if status != 0 {
        return status
    }
    let shim = driver_path(out_dir, "shim", ".o")
    var arguments = Vector<String>()
    try! arguments.push("-c")
    try! arguments.push(driver_path(rt_root, "shim.c", ""))
    try! arguments.push("-O2")
    try! arguments.push("-fno-strict-aliasing")
    try! arguments.push("-target")
    try! arguments.push(options.module_triple)
    try! arguments.push("-o")
    try! arguments.push(shim)
    let compiled = driver_clang("sawc2 runtime", &arguments)
    if compiled != 0 {
        return compiled
    }
    let shim_seams = tc_runtime_shim_seams(host)
    k = 0
    while k < shim_seams.len() {
        try! seams.push(shim_seams.get(k) ?? "")
        try! definers.push(shim)
        k = k + 1
    }
    try! objects.push(shim)
    if not driver_runtime_seams_hold(&seams, &definers) || not driver_distinct(&objects) {
        return 1
    }
    print("target {}", host)
    k = 0
    while k < objects.len() {
        // Stage 0 workaround (SL:hazards S23): canonical: print("object {}", objects.get(k) ?? "")
        let object = objects.get(k) ?? ""
        print("object {}", object)
        k = k + 1
    }
    0
}

// The host `sawc2 runtime` builds for, whose runtime directory and C shim the
// ABI table names.
func driver_runtime_host() -> String {
    "arm64-apple-darwin"
}

// The optimisation level a runtime object is built at.
func driver_runtime_speed() -> String {
    "-O2"
}

// Whether `seams`, each defined by the object at the same index of
// `definers`, are the ABI table's runtime seams, each exactly once; every way
// they are not is printed first.
func driver_runtime_seams_hold(seams: &Vector<String>, definers: &Vector<String>) -> Bool {
    var names = Vector<String>()
    var params = Vector<String>()
    var results = Vector<String>()
    var owners = Vector<String>()
    tc_runtime_abi_rows(&var names, &var params, &var results, &var owners)
    var holds = true
    var k = 0
    while k < names.len() {
        let name = names.get(k) ?? ""
        let owner = owners.get(k) ?? ""
        k = k + 1
        if not owner.equals("runtime") {
            continue
        }
        var first = ""
        var j = 0
        while j < seams.len() {
            let seam = seams.get(j) ?? ""
            if seam.equals(name) {
                let by = definers.get(j) ?? ""
                if first.len() > 0 {
                    print("sawc2 runtime: `{}` is defined by both {} and {}", name, first, by)
                    holds = false
                }
                first = by
            }
            j = j + 1
        }
        if first.len() == 0 {
            print("sawc2 runtime: no runtime object defines `{}`, which sawc/rt/ABI.md lists", name)
            holds = false
        }
    }
    k = 0
    while k < seams.len() {
        let seam = seams.get(k) ?? ""
        var listed = false
        var j = 0
        while j < names.len() {
            let name = names.get(j) ?? ""
            let owner = owners.get(j) ?? ""
            if name.equals(seam) && owner.equals("runtime") {
                listed = true
            }
            j = j + 1
        }
        if not listed {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2 runtime: {} defines `{}`, which is not a runtime seam of sawc/rt/ABI.md", definers.get(k) ?? "", seam)
            let by = definers.get(k) ?? ""
            print("sawc2 runtime: {} defines `{}`, which is not a runtime seam of sawc/rt/ABI.md", by, seam)
            holds = false
        }
        k = k + 1
    }
    holds
}

// Whether no two of `paths` are the same, which two sources of one stem would
// make; the first repeat is printed.
func driver_distinct(paths: &Vector<String>) -> Bool {
    var k = 0
    while k < paths.len() {
        let one = paths.get(k) ?? ""
        var j = 0
        while j < k {
            let other = paths.get(j) ?? ""
            if other.equals(one) {
                print("sawc2 runtime: two runtime sources write {}", one)
                return false
            }
            j = j + 1
        }
        k = k + 1
    }
    true
}

// `DIR/NAME` followed by `suffix`.
func driver_path(dir: String, name: String, suffix: String) -> String {
    var out = StringBuilder()
    try! out.append(dir)
    try! out.append("/")
    try! out.append(name)
    try! out.append(suffix)
    out.build()
}

// The file name of `path` without its directory and its `.saw`.
func driver_stem(path: String) -> String {
    var start = 0
    var i = 0
    while i < path.len() {
        if (path.byte_at(i) as Int) == DRIVER_SLASH {
            start = i + 1
        }
        i = i + 1
    }
    var stop = path.len()
    if stop - start > 4 && path.substring(stop - 4, stop).equals(".saw") {
        stop = stop - 4
    }
    path.substring(start, stop)
}

// `sawc2 mono`: one record per entry file, in order, each file the entry of
// its own program; `--dump` prints the items, `--layouts` the layout table of
// the types they reach.
func driver_mono(args: &Vector<String>) -> Int {
    var dump = false
    var layouts = false
    var check = false
    var notes = false
    var std_root = "sawc"
    var triple = "arm64-apple-darwin"
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--layouts") {
            layouts = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if arg.equals("--std-root") || arg.equals("--module-path") || arg.equals("--target") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if arg.equals("--target") {
                triple = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    let modes = (if dump { 1 } else { 0 }) + (if layouts { 1 } else { 0 }) + (if check { 1 } else { 0 })
    if modes != 1 {
        return driver_usage()
    }
    if not target_known(triple) {
        // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: unknown target {triple}")
        print("sawc2: unknown target {}", triple)
        return DRIVER_EXIT_USAGE
    }
    let options = MonoOptions(std_root: std_root, target: triple, dump: dump, layouts: layouts, notes: notes)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            let result = mono_record(out: &var out, path: input.path, options: &options, names: &names, dirs: &dirs)
            print(out.build())
            if result > status {
                status = result
            }
        }
        k = k + 1
    }
    status
}

// `sawc2 coro`: one record per entry file, in order, each file the entry of
// its own program; `--dump` prints each item's frame decision.
func driver_coro(args: &Vector<String>) -> Int {
    var dump = false
    var check = false
    var notes = false
    var std_root = "sawc"
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if arg.equals("--std-root") || arg.equals("--module-path") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    if dump == check {
        return driver_usage()
    }
    let options = CoroOptions(std_root: std_root, dump: dump, notes: notes)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            let result = coro_record(out: &var out, path: input.path, options: &options, names: &names, dirs: &dirs)
            print(out.build())
            if result > status {
                status = result
            }
        }
        k = k + 1
    }
    status
}

func main() -> Int {
    let args = try! Env.args()
    let command = args.get(1) ?? ""
    if command.equals("lex") {
        return driver_lex(&args)
    }
    if command.equals("parse") {
        return driver_parse(&args)
    }
    if command.equals("resolve") {
        return driver_resolve(&args, DRIVER_STAGE_RESOLVE)
    }
    if command.equals("typecheck") {
        return driver_resolve(&args, DRIVER_STAGE_TYPECHECK)
    }
    if command.equals("mir") {
        return driver_resolve(&args, DRIVER_STAGE_MIR)
    }
    if command.equals("eval") {
        return driver_resolve(&args, DRIVER_STAGE_EVAL)
    }
    if command.equals("borrowck") {
        return driver_resolve(&args, DRIVER_STAGE_BORROWCK)
    }
    if command.equals("drops") {
        return driver_resolve(&args, DRIVER_STAGE_DROPS)
    }
    if command.equals("mono") {
        return driver_mono(&args)
    }
    if command.equals("coro") {
        return driver_coro(&args)
    }
    if command.equals("build") {
        return driver_build(&args)
    }
    if command.equals("runtime") {
        return driver_runtime(&args)
    }
    driver_usage()
}

// The program stages `driver_resolve` runs to.
static DRIVER_STAGE_RESOLVE: Int = 0
static DRIVER_STAGE_TYPECHECK: Int = 1
static DRIVER_STAGE_MIR: Int = 2
static DRIVER_STAGE_EVAL: Int = 3
static DRIVER_STAGE_BORROWCK: Int = 4
static DRIVER_STAGE_DROPS: Int = 5

// `sawc2 resolve`, `typecheck`, `mir`, `eval`, `borrowck` and `drops`, which take the same
// flags, `--interfaces` and `--summaries` typecheck's alone and `--spans` the
// MIR's: one record per
// entry file, in order, each file the entry of its own program.
func driver_resolve(args: &Vector<String>, stage: Int) -> Int {
    let typecheck = stage == DRIVER_STAGE_TYPECHECK
    var dump = false
    var check = false
    var notes = false
    var spans = false
    var interfaces = false
    var summaries = false
    var runtime = false
    var std_root = "sawc"
    var names = Vector<String>()
    var dirs = Vector<String>()
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--notes") {
            notes = true
        } else if arg.equals("--interfaces") && typecheck {
            interfaces = true
        } else if arg.equals("--summaries") && typecheck {
            summaries = true
        } else if arg.equals("--runtime") && typecheck {
            runtime = true
        } else if arg.equals("--spans") && stage == DRIVER_STAGE_MIR {
            spans = true
        } else if arg.equals("--std-root") || arg.equals("--module-path") {
            let value = args.get(i + 1) ?? ""
            if value.len() == 0 {
                return driver_usage()
            }
            if arg.equals("--std-root") {
                std_root = value
            } else if not driver_add_mapping(&var names, &var dirs, value) {
                return driver_usage()
            }
            i = i + 1
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: false))
        }
        i = i + 1
    }
    if dump == check {
        return driver_usage()
    }
    let options = ResolveOptions(std_root: std_root, dump: dump, notes: notes)
    let checking = TypecheckOptions(std_root: std_root, dump: dump, notes: notes,
                                    interfaces: interfaces, summaries: summaries)
    let lowering = MirOptions(std_root: std_root, dump: dump, notes: notes, spans: spans)
    let evaluating = EvalOptions(std_root: std_root, dump: dump, notes: notes)
    let borrowing = BorrowckOptions(std_root: std_root, dump: dump, notes: notes)
    let elaborating = DropsOptions(std_root: std_root, dump: dump, notes: notes)
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            var out = StringBuilder()
            try! out.append("FILE\t")
            try! out.append(input.path)
            try! out.append("\n")
            var result = 0
            if stage == DRIVER_STAGE_DROPS {
                result = drops_record(out: &var out, path: input.path, options: &elaborating, names: &names,
                                      dirs: &dirs)
            } else if stage == DRIVER_STAGE_BORROWCK {
                result = borrowck_record(out: &var out, path: input.path, options: &borrowing, names: &names,
                                         dirs: &dirs)
            } else if stage == DRIVER_STAGE_EVAL {
                result = eval_record(out: &var out, path: input.path, options: &evaluating, names: &names,
                                     dirs: &dirs)
            } else if stage == DRIVER_STAGE_MIR {
                result = mir_record(out: &var out, path: input.path, options: &lowering, names: &names,
                                    dirs: &dirs)
            } else if typecheck {
                let checked = asserts_typecheck_program(input.path, checking.std_root, &names, &dirs,
                                                        runtime: runtime)
                result = typecheck_record(out: &var out, p: &checked, options: &checking)
            } else {
                result = resolve_record(out: &var out, path: input.path, options: &options,
                                        names: &names, dirs: &dirs)
            }
            print(out.build())
            if result > status {
                status = result
            }
        }
        k = k + 1
    }
    status
}

// Adds a `NAME=DIR` package mapping; false when the text has no `=`.
func driver_add_mapping(names: &var Vector<String>, dirs: &var Vector<String>, text: String) -> Bool {
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == DRIVER_EQUALS {
            try! names.push(text.substring(0, i))
            try! dirs.push(text.substring(i + 1, n))
            return true
        }
        i = i + 1
    }
    false
}

// One input of `sawc2 parse`: a path, and whether it is parsed from
// `refusal-unit` rather than `source-file`.
struct DriverInput {
    path: String
    unit: Bool
}

// Adds the inputs a `@LIST` file names, one path per line. A line may start
// with `--unit ` to parse that file from `refusal-unit`.
func driver_add_list(inputs: &var Vector<DriverInput>, list: String) -> Bool {
    if let text = driver_read_source(list) {
        var start = 0
        var i = 0
        while i <= text.len() {
            if i == text.len() || (text.byte_at(i) as Int) == DRIVER_NEWLINE {
                if i > start {
                    let line = text.substring(start, i)
                    if line.starts_with("--unit ") {
                        let path = text.substring(start + 7, i)
                        try! inputs.push(DriverInput(path: path, unit: true))
                    } else {
                        try! inputs.push(DriverInput(path: line, unit: false))
                    }
                }
                start = i + 1
            }
            i = i + 1
        }
        true
    } else {
        false
    }
}

// `sawc2 parse`: one record per input, in order, so that one process covers a
// whole corpus.
func driver_parse(args: &Vector<String>) -> Int {
    var dump = false
    var check = false
    var reread = false
    var alternatives = false
    var unit_next = false
    var inputs = Vector<DriverInput>()
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--dump") {
            dump = true
        } else if arg.equals("--check") {
            check = true
        } else if arg.equals("--redump") {
            reread = true
        } else if arg.equals("--alternatives") {
            alternatives = true
        } else if arg.equals("--unit") {
            unit_next = true
        } else if arg.starts_with("--") {
            return driver_usage()
        } else if arg.len() > 1 && (arg.byte_at(0) as Int) == DRIVER_AT {
            // Stage 0 workaround (SL:hazards S4): canonical: let list = arg.substring(1, arg.len())
            let size = arg.len()
            let list = arg.substring(1, size)
            if not driver_add_list(&var inputs, list) {
                return DRIVER_EXIT_USAGE
            }
        } else {
            try! inputs.push(DriverInput(path: arg, unit: unit_next))
            unit_next = false
        }
        i = i + 1
    }
    let modes = (if dump { 1 } else { 0 }) + (if check { 1 } else { 0 }) + (if reread { 1 } else { 0 })
    if modes != 1 || unit_next {
        return driver_usage()
    }
    var status = 0
    var k = 0
    while k < inputs.len() {
        if let input = inputs.get(k) {
            let result = driver_parse_one(&input, dump, reread, alternatives)
            if result > status {
                status = result
            }
        }
        k = k + 1
    }
    status
}

func driver_parse_one(input: &DriverInput, dump: Bool, reread: Bool, alternatives: Bool) -> Int {
    var out = StringBuilder()
    try! out.append("FILE\t")
    try! out.append(input.path)
    try! out.append("\n")
    let source = driver_read_source(input.path)
    if let text = source {
        if reread {
            try! out.append(redump(text))
            print(out.build())
            return 0
        }
        let options = ParseOptions(unit: input.unit, dump: dump, alternatives: alternatives)
        let status = parse_record(out: &var out, path: input.path, text: text, options: &options)
        print(out.build())
        return status
    }
    print(out.build())
    DRIVER_EXIT_USAGE
}

// `sawc2 lex`: the arguments after the subcommand name one file, or ask for
// the kind list.
func driver_lex(args: &Vector<String>) -> Int {
    var docs_mode = false
    var kinds_mode = false
    var path = ""
    var i = 2
    while i < args.len() {
        let arg = args.get(i) ?? ""
        if arg.equals("--docs") {
            docs_mode = true
        } else if arg.equals("--kinds") {
            kinds_mode = true
        } else if arg.starts_with("--") || not path.equals("") {
            return driver_usage()
        } else {
            path = arg
        }
        i = i + 1
    }
    if kinds_mode {
        if docs_mode || not path.equals("") {
            return driver_usage()
        }
        return driver_print_kinds()
    }
    if path.equals("") {
        return driver_usage()
    }
    if let text = driver_read_source(path) {
        driver_dump(text, docs_mode)
    } else {
        DRIVER_EXIT_USAGE
    }
}

// The file's text, or None once the reason it could not be read is printed.
func driver_read_source(path: String) -> String? {
    let opened = File.open(Path(s: path))
    var file = match opened {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot open {path}: {e}")
            print("sawc2: cannot open {}: {}", path, e)
            return None
        }
    }
    let read = file.read()
    let data = match read {
        case Ok(bytes) -> move bytes,
        case Err(e) -> {
            // Stage 0 workaround (SL:hazards S23): canonical: print("sawc2: cannot read {path}: {e}")
            print("sawc2: cannot read {}: {}", path, e)
            return None
        }
    }
    let decoded = data.to_string()
    match decoded {
        case Ok(text) -> text,
        case Err(e) -> {
            print("sawc2: {path} is not valid UTF-8 (byte {e.offset})")
            None
        }
    }
}

func driver_dump(source: String, docs_mode: Bool) -> Int {
    let lexed = lex(source)
    match lexed {
        case Ok(result) -> {
            if docs_mode {
                driver_print_docs(&result)
            } else {
                driver_print_tokens(&result)
            }
            0
        },
        case Err(e) -> {
            print(format_error(&e))
            DRIVER_EXIT_LEX_ERROR
        }
    }
}

func driver_print_tokens(result: &LexResult) {
    var i = 0
    while i < result.tokens.len() {
        if let t = result.tokens.get(i) {
            print(format_token(&t, &result.segments))
        }
        i = i + 1
    }
}

func driver_print_docs(result: &LexResult) {
    var i = 0
    while i < result.docs.len() {
        if let d = result.docs.get(i) {
            print(format_doc(&d))
        }
        i = i + 1
    }
}

func driver_print_kinds() -> Int {
    let kinds = token_kinds()
    var i = 0
    while i < kinds.len() {
        if let k = kinds.get(i) {
            print(kind_name(k))
        }
        i = i + 1
    }
    0
}
