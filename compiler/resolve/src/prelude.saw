    p.prelude_name("VoidTask", "std.taskgroup")
}

extension ResProgram {
    func builtin_type(&var self, name: String) {
        let _ = self.builtin_decl(name, ResDeclKind.Primitive, -1, false)
    }

    func builtin_function(&var self, name: String) {
        let _ = self.builtin_decl(name, ResDeclKind.BuiltinFunc, -1, false)
    }

    func builtin_decl(&var self, text: String, kind: ResDeclKind, parent: Int, flag: Bool) -> Int {
        let name = self.intern(text)
        let m = self.current
        let d = self.add_decl(kind, name, -1, -1, -1, ResVis.Public, parent, false, flag)
        if parent < 0 {
            self.top.add(m, name, d)
        } else {
            self.members.add(parent, name, d)
            if kind == ResDeclKind.Case {
                self.cases.add(0, name, d)
            }
        }
        d
    }

    // Enters `text` from module `module` in the prelude. A name its module does
    // not declare is a note on the builtin module, which a check of the tables
    // reports. Under the new std, a builtin name its prelude module declares
    // comes from there; a builtin name it does not declare yet is left out, and
    // so is every name of a module it does not have yet.
    func prelude_name(&var self, text: String, module: String) {
        let name = self.intern(text)
        if self.std_new && module.equals("builtin") {
            let home = self.intern("std.prelude")
            let at = self.by_name.first(0, home)
            if at >= 0 {
                let m = self.by_name.value(at)
                let entry = self.top.first(m, name)
                if entry >= 0 {
                    let d = self.top.value(entry)
                    self.prelude.add(0, name, d)
                    return
                }
            }
        }
        let key = self.intern(module)
        let at = self.by_name.first(0, key)
        if at < 0 {
            if not self.std_new {
                self.prelude_missing(text, module)
            }
            return
        }
        let m = self.by_name.value(at)
        let entry = self.top.first(m, name)
        if entry < 0 {
            if not self.std_new || not module.equals("builtin") {
                self.prelude_missing(text, module)
            }
            return
        }
        let d = self.top.value(entry)
        self.prelude.add(0, name, d)
    }

    func prelude_missing(&var self, text: String, module: String) {
        var msg = StringBuilder()
        try! msg.append("the prelude lists `")
        try! msg.append(text)
        try! msg.append("` from `")
        try! msg.append(module)
        try! msg.append("`, which does not declare it")
        let b = self.builtin
        self.refuse_at(b, 0, "resolve.prelude-table", msg.build(), true)
    }
}
