// The one lookup of a bare name, and the scopes it reads (design 150's order,
// with design 255's tier). Every position that resolves a bare name passes
// through `lookup`; every position that binds one passes through `bind_local`,
// which applies the shadowing rule (designs 100 and 107).
//
// ENTRY POINTS (lookup):
//     walk_name
//     walk_path
//     walk_capture
//     bind_pattern_as
// ENTRY POINTS (bind_local):
//     bind_value
//     walk_capture
//     walk_catch_block

import sawparse.src.grammar.{Alt}
import sawresolve.src.imports.{res_decl_binding, res_same_binding, res_vis_text}
import sawresolve.src.model.{ResBindKind, ResBinding, ResDecl, ResDeclKind, ResImport,
                             ResImportForm, ResLocal, ResModuleKind, ResName, ResPending,
                             ResSymbol, res_unbound}
import sawresolve.src.program.{ResProgram}

// Adds `b` to `out` unless a binding denoting the same thing is there.
func res_add_distinct(out: &var Vector<ResBinding>, b: ResBinding) {
    var k = 0
    while k < out.len() {
        let known = out[k]
        if res_same_binding(&known, &b) {
            return
        }
        k = k + 1
    }
    try! out.push(b)
}

// Whether `v` holds `x`.
func res_holds(v: &Vector<Int>, x: Int) -> Bool {
    var k = 0
    while k < v.len() {
        if v[k] == x {
            return true
        }
        k = k + 1
    }
    false
}

// `names`, each in backquotes, joined by commas and `last` before the last:
// "`A`", "`A` or `B`", "`A`, `B` or `C`".
func res_join_names(names: &Vector<String>, last: String) -> String {
    var out = StringBuilder()
    var k = 0
    while k < names.len() {
        if k > 0 && k == names.len() - 1 {
            try! out.append(last)
        } else if k > 0 {
            try! out.append(", ")
        }
        try! out.append("`")
        try! out.append(names.get(k) ?? "")
        try! out.append("`")
        k = k + 1
    }
    out.build()
}

// Where a name is looked up: a value position sees locals, a type position
// sees only type-level bindings (type parameters, `Self`, associated types).
public enum ResSpace {
    case Value,
    case Type
}

// How a new binding may relate to one it shadows.
public enum ResShadow {
    // A `let`, `var`, loop or optional binding: legal when its initializer
    // mentions the shadowed binding.
    case Derivable,
    // A pattern, parameter or closure parameter: a shadow is always refused.
    case Flat,
    // A capture, which is the enclosing binding itself.
    case Capture
}

extension ResProgram {
    public func push_scope(&var self) {
        let height = self.local_top
        if self.scope_top < self.scope_marks.len() {
            self.scope_marks[self.scope_top] = height
        } else {
            try! self.scope_marks.push(height)
        }
        self.scope_top = self.scope_top + 1
    }

    public func pop_scope(&var self) {
        self.scope_top = self.scope_top - 1
        self.local_top = self.scope_marks[self.scope_top]
    }

    // Drops every local and scope: a declaration starts with none.
    public func reset_scopes(&var self) {
        self.local_top = 0
        self.scope_top = 0
    }

    func push_local(&var self, local: ResLocal) {
        if self.local_top < self.locals.len() {
            self.locals[self.local_top] = local
        } else {
            try! self.locals.push(local)
        }
        self.local_top = self.local_top + 1
    }

    // Declares a type-level binding: a type parameter, an associated type.
    public func bind_type_level(&var self, name: Int, binding: ResBinding) {
        let depth = self.scope_top
        self.push_local(ResLocal(name: name, binding: binding, depth: depth, type_level: true))
    }

    // The innermost local of `name` in `space`, or -1.
    public func find_local(&self, name: Int, space: ResSpace) -> Int {
        var k = self.local_top - 1
        while k >= 0 {
            let local = self.locals[k]
            if local.name == name {
                if local.type_level || space == ResSpace.Value {
                    return k
                }
            }
            k = k - 1
        }
        return -1
    }

    // THE LOOKUP: what bare `name`, written at `leaf`, denotes. Locals, then
    // the module's declarations, then imported bare names, then the prelude,
    // then the gated std tier (refused with a precise hint, except in a
    // module of Stage 0's std, which sees it bare), then qualifiers.
    // A name nothing binds is refused. Never returns Unbound.
    public func lookup(&var self, name: Int, leaf: Int, space: ResSpace) -> ResBinding {
        if name == self.name_self_type {
            if self.self_type.kind == ResBindKind.Unbound {
                self.refuse(leaf, "name.self-outside-type",
                            "`Self` names the enclosing type, and there is none here")
                return self.error_binding()
            }
            return self.self_type
        }
        let local = self.find_local(name, space)
        if local >= 0 {
            let found = self.locals[local]
            return found.binding
        }
        let m = self.current
        let own = self.top.first(m, name)
        if own >= 0 {
            let d = self.top.value(own)
            let decl = self.decls[d]
            if decl.test_only && not self.in_test {
                self.refuse_test_only(leaf, name)
                return self.error_binding()
            }
            let found = res_decl_binding(d, &decl)
            if found.kind != ResBindKind.Overload {
                return found
            }
            // A function merges with the functions imported bare under its
            // name into one overload set (design 249).
            var candidates = Vector<ResBinding>()
            try! candidates.push(found)
            let _ = self.imported_candidates(name, leaf, &var candidates)
            return self.merge_overloads(name, &candidates)
        }
        var imported = Vector<ResBinding>()
        let hidden = self.imported_candidates(name, leaf, &var imported)
        if imported.len() > 0 {
            return self.pick_imported(name, leaf, &imported)
        }
        if hidden {
            self.refuse_test_only(leaf, name)
            return self.error_binding()
        }
        let prelude = self.prelude.first(0, name)
        if prelude >= 0 {
            return self.prelude_binding(name)
        }
        let gated = self.prelude.first(1, name)
        if gated >= 0 {
            let d = self.prelude.value(gated)
            let info = self.modules[m]
            if info.kind == ResModuleKind.Std && not self.std_new {
                // `sawc/std` is written for the frozen compiler's one std
                // namespace, where each std module sees every other bare; the
                // new std writes its imports as any module does.
                let decl = self.decls[d]
                return res_decl_binding(d, &decl)
            }
            self.refuse_gated(leaf, name, d)
            return self.error_binding()
        }
        let qualifier = self.qualifiers.first(m, name)
        if qualifier >= 0 {
            let imp = self.imports[self.qualifiers.value(qualifier)]
            return ResBinding(kind: ResBindKind.Module, module: imp.target, decl: -1, name: -1,
                              node: -1)
        }
        let text = self.name_text(name)
        var msg = StringBuilder()
        // The atomic intrinsics are the new std's alone: no prelude names
        // them, and only a std module sees the builtin module's spelling.
        let info = self.modules[m]
        if info.kind == ResModuleKind.Std && self.std_new && text.starts_with("__saw_atomic_") {
            let b = self.builtin
            let intrinsic = self.top.first(b, name)
            if intrinsic >= 0 {
                let d = self.top.value(intrinsic)
                let decl = self.decls[d]
                return res_decl_binding(d, &decl)
            }
        }
        if text.starts_with("__saw_") {
            // The frozen compiler's test intrinsics (`__saw_drive` and its
            // kin) drive coroutines, which the slice leaves out.
            try! msg.append("the compiler intrinsic `")
            try! msg.append(text)
            try! msg.append("` is not in the bootstrap slice yet")
            self.refuse(leaf, "slice.not-yet", msg.build())
            return self.error_binding()
        }
        let hidden_in = self.glob_hiding(name)
        if hidden_in >= 0 {
            let d = self.decls[hidden_in]
            try! msg.append("`")
            try! msg.append(text)
            try! msg.append("` is ")
            try! msg.append(res_vis_text(d.vis))
            try! msg.append(" in `")
            try! msg.append(self.module_name(d.module))
            try! msg.append("`")
            self.refuse(leaf, "visibility.private", msg.build())
            return self.error_binding()
        }
        if self.defer_bare_name(name, leaf) {
            return self.error_binding()
        }
        try! msg.append("cannot find `")
        try! msg.append(text)
        try! msg.append("` in scope")
        self.refuse(leaf, "name.undefined", msg.build())
        self.error_binding()
    }

    // A top-level declaration named `name` in a module the current module
    // glob-imports, which its visibility keeps out of the current module, or
    // -1. A name a lookup misses for that reason is refused as private rather
    // than undefined.
    func glob_hiding(&self, name: Int) -> Int {
        let m = self.current
        var g = self.qualifiers.first(m, -2)
        while g >= 0 {
            let imp = self.imports[self.qualifiers.value(g)]
            var at = self.top.first(imp.target, name)
            while at >= 0 {
                let d = self.top.value(at)
                let decl = self.decls[d]
                if not self.visible_to(decl.vis, decl.module, m) {
                    return d
                }
                at = self.top.following(at)
            }
            g = self.qualifiers.following(g)
        }
        return -1
    }

    // Whether a path headed by `b` names an associated type by its second
    // segment: `T.Item` under a type parameter, `Self.Item` in a trait.
    public func heads_projection(&self, b: ResBinding) -> Bool {
        if b.kind == ResBindKind.TypeParam {
            return true
        }
        b.kind == ResBindKind.SelfType && b.decl >= 0 && self.decls[b.decl].kind == ResDeclKind.Trait
    }

    // Defers the associated type `path`'s second segment names under `head`
    // to `settle_pending`, since a bound's parents may sit in a module not
    // walked yet. Every segment after the head is recorded refused until then.
    public func defer_projection(&var self, path: Int, head: ResBinding) {
        let n = self.child_count(path)
        let leaf = self.child(path, 1)
        let name = self.leaf_name(leaf)
        var k = 1
        while k < n {
            let segment = self.child(path, k)
            let refused = self.error_binding()
            self.record(segment, refused)
            k = k + 1
        }
        var chain = -1
        if n > 2 {
            chain = self.child(path, 2)
        }
        var trait_decl = -1
        var param = res_unbound()
        if head.kind == ResBindKind.SelfType {
            trait_decl = head.decl
        } else {
            param = head
        }
        let m = self.current
        try! self.pending.push(ResPending(module: m, leaf: leaf, name: name, param: param,
                                          trait_decl: trait_decl, chain: chain, first: 0, count: 0))
    }

    // Defers the refusal of bare `name` at `leaf`, which nothing binds, when a
    // type parameter in scope has a bound: `settle_pending` refuses it with
    // the `T.Item` spellings the bounds reach as its fix-it. Returns whether
    // it was deferred.
    func defer_bare_name(&var self, name: Int, leaf: Int) -> Bool {
        let first = self.pending_params.len()
        var k = 0
        while k < self.local_top {
            let local = self.locals[k]
            if local.type_level && local.binding.kind == ResBindKind.TypeParam {
                var traits = Vector<Int>()
                self.bound_traits(local.binding.node, &var traits)
                if traits.len() > 0 {
                    try! self.pending_params.push(local.binding.node)
                }
            }
            k = k + 1
        }
        let count = self.pending_params.len() - first
        if count == 0 {
            return false
        }
        let m = self.current
        try! self.pending.push(ResPending(module: m, leaf: leaf, name: name, param: res_unbound(),
                                          trait_decl: -1, chain: -1, first: first, count: count))
        true
    }

    // Decides every deferred name, once every trait's parents are recorded.
    // A projection is bound or refused; a bare name is refused with its fix-it.
    public func settle_pending(&var self) {
        let saved = self.current
        var k = 0
        while k < self.pending.len() {
            let p = self.pending[k]
            self.current = p.module
            if p.count > 0 {
                self.settle_bare(&p)
            } else {
                self.settle_projection(&p)
            }
            k = k + 1
        }
        self.current = saved
    }

    // `T.Item`: the one associated type named `Item` that `T`'s bounds
    // declare or inherit. Two bounds reaching one declaration name it once;
    // two declarations are ambiguous. `Self.Item` searches the trait itself.
    func settle_projection(&var self, p: &ResPending) {
        var traits = Vector<Int>()
        if p.trait_decl >= 0 {
            try! traits.push(p.trait_decl)
        } else {
            self.bound_traits(p.param.node, &var traits)
        }
        var seen = Vector<Int>()
        var found = Vector<Int>()
        var k = 0
        while k < traits.len() {
            self.collect_assoc_types(traits[k], p.name, &var seen, &var found)
            k = k + 1
        }
        let head = if p.trait_decl >= 0 { "Self" } else { self.name_text(p.param.name) }
        let text = self.name_text(p.name)
        var msg = StringBuilder()
        if found.len() == 1 {
            let d = found[0]
            if p.trait_decl >= 0 {
                let owner = self.decls[d].module
                self.rebind(p.leaf, ResBinding(kind: ResBindKind.Decl, module: owner, decl: d,
                                               name: -1, node: -1))
            } else {
                self.rebind(p.leaf, ResBinding(kind: ResBindKind.Projection,
                                               module: p.param.module, decl: d,
                                               name: p.param.name, node: p.param.node))
            }
            if p.chain >= 0 {
                let m = self.current
                try! msg.append("`")
                try! msg.append(self.text_of(m, p.chain))
                try! msg.append("` is named through the associated type `")
                try! msg.append(head)
                try! msg.append(".")
                try! msg.append(text)
                try! msg.append("`, which is not in the bootstrap slice yet")
                self.refuse(p.chain, "slice.not-yet", msg.build())
            }
            return
        }
        var names = Vector<String>()
        if found.len() == 0 {
            k = 0
            while k < traits.len() {
                let trait_name = self.decls[traits[k]].name
                try! names.push(self.name_text(trait_name))
                k = k + 1
            }
            try! msg.append("`")
            try! msg.append(head)
            try! msg.append("` has no associated type `")
            try! msg.append(text)
            if names.len() == 0 {
                try! msg.append("`: it has no bounds")
            } else if p.trait_decl >= 0 {
                try! msg.append("`: ")
                try! msg.append(res_join_names(&names, ", "))
                try! msg.append(" and the traits it refines declare none")
            } else if names.len() == 1 {
                try! msg.append("`: its bound ")
                try! msg.append(res_join_names(&names, ", "))
                try! msg.append(" and the traits it refines declare none")
            } else {
                try! msg.append("`: its bounds ")
                try! msg.append(res_join_names(&names, ", "))
                try! msg.append(" and the traits they refine declare none")
            }
            self.refuse(p.leaf, "name.undefined", msg.build())
            return
        }
        k = 0
        while k < found.len() {
            let d = self.decls[found[k]]
            var qualified = StringBuilder()
            let trait_name = self.decls[d.parent].name
            try! qualified.append(self.name_text(trait_name))
            try! qualified.append(".")
            try! qualified.append(self.name_text(d.name))
            try! names.push(qualified.build())
            k = k + 1
        }
        try! msg.append("ambiguous `")
        try! msg.append(head)
        try! msg.append(".")
        try! msg.append(text)
        try! msg.append("`: the bounds of `")
        try! msg.append(head)
        try! msg.append("` reach the associated types ")
        try! msg.append(res_join_names(&names, " and "))
        self.refuse(p.leaf, "name.ambiguous", msg.build())
    }

    // A bare name nothing binds, refused with each `T.Item` the in-scope type
    // parameters' bounds reach, all of them when there are several.
    func settle_bare(&var self, p: &ResPending) {
        let text = self.name_text(p.name)
        let m = self.current
        var spellings = Vector<String>()
        var k = 0
        while k < p.count {
            let param = self.pending_params[p.first + k]
            var traits = Vector<Int>()
            self.bound_traits(param, &var traits)
            var seen = Vector<Int>()
            var found = Vector<Int>()
            var j = 0
            while j < traits.len() {
                self.collect_assoc_types(traits[j], p.name, &var seen, &var found)
                j = j + 1
            }
            if found.len() > 0 {
                var spelling = StringBuilder()
                try! spelling.append(self.text_of(m, param))
                try! spelling.append(".")
                try! spelling.append(text)
                try! spellings.push(spelling.build())
            }
            k = k + 1
        }
        var msg = StringBuilder()
        try! msg.append("cannot find `")
        try! msg.append(text)
        try! msg.append("` in scope")
        if spellings.len() > 0 {
            try! msg.append("; an associated type of a bound is named through its type parameter, as ")
            try! msg.append(res_join_names(&spellings, " or "))
        }
        self.refuse(p.leaf, "name.undefined", msg.build())
    }

    // Replaces the binding recorded for `leaf`.
    func rebind(&var self, leaf: Int, b: ResBinding) {
        let at = self.record_of[leaf]
        var r = self.records[at]
        r.binding = b
        self.records[at] = r
    }

    // The traits the type parameter declared at `leaf` is bounded by, in the
    // order its bounds are written.
    public func bound_traits(&self, leaf: Int, out: &var Vector<Int>) {
        let at = self.param_nodes.first(0, leaf)
        if at < 0 {
            return
        }
        let g = self.param_nodes.value(at)
        self.path_traits(g, &var out)
    }

    // The traits node `owner`'s path children name: a generic parameter's
    // bounds, or a trait's parents.
    func path_traits(&self, owner: Int, out: &var Vector<Int>) {
        let n = self.child_count(owner)
        var j = 0
        while j < n {
            let c = self.child(owner, j)
            if self.is_alt(c, Alt.Type_Path) {
                let segments = self.child_count(c)
                let last = self.child(c, segments - 1)
                let r = self.record_of[last]
                if r >= 0 {
                    let b = self.records[r].binding
                    if b.kind == ResBindKind.Decl && self.decls[b.decl].kind == ResDeclKind.Trait {
                        try! out.push(b.decl)
                    }
                }
            }
            j = j + 1
        }
    }

    // Adds to `out` each associated type named `name` that trait `t` declares
    // or inherits through its parents, each declaration once; `seen` holds
    // the traits already searched.
    func collect_assoc_types(&self, t: Int, name: Int, seen: &var Vector<Int>,
                             out: &var Vector<Int>) {
        if res_holds(&seen, t) {
            return
        }
        try! seen.push(t)
        var at = self.members.first(t, name)
        while at >= 0 {
            let d = self.members.value(at)
            if self.decls[d].kind == ResDeclKind.AssocType && not res_holds(&out, d) {
                try! out.push(d)
            }
            at = self.members.following(at)
        }
        var parents = Vector<Int>()
        let node = self.decls[t].node
        self.path_traits(node, &var parents)
        var k = 0
        while k < parents.len() {
            self.collect_assoc_types(parents[k], name, &var seen, &var out)
            k = k + 1
        }
    }

    public func error_binding(&self) -> ResBinding {
        ResBinding(kind: ResBindKind.Error, module: -1, decl: -1, name: -1, node: -1)
    }

    // Adds to `out` each distinct binding the current module's selective and
    // glob imports give `name`. Returns whether a test-only import, which
    // ordinary code may not use, would have given it one.
    func imported_candidates(&var self, name: Int, leaf: Int, out: &var Vector<ResBinding>) -> Bool {
        let m = self.current
        var hidden = false
        var at = self.bare.first(m, name)
        while at >= 0 {
            let sym = self.symbols[self.bare.value(at)]
            let imp = self.imports[sym.import_at]
            if imp.test_only && not self.in_test {
                hidden = true
            } else if sym.binding.kind != ResBindKind.Error {
                res_add_distinct(&var out, sym.binding)
            }
            at = self.bare.following(at)
        }
        var g = self.qualifiers.first(m, -2)
        while g >= 0 {
            let imp = self.imports[self.qualifiers.value(g)]
            if imp.test_only && not self.in_test {
                hidden = true
            } else {
                let b = self.surface_lookup(imp.target, name, leaf, false)
                if b.kind != ResBindKind.Error && b.kind != ResBindKind.Unbound {
                    res_add_distinct(&var out, b)
                }
            }
            g = self.qualifiers.following(g)
        }
        hidden
    }

    // The binding the imports give `name`: one binding as it is, overload sets
    // of several modules merged, and any other pair refused as ambiguous at
    // the use (design 255).
    func pick_imported(&var self, name: Int, leaf: Int, candidates: &Vector<ResBinding>) -> ResBinding {
        if candidates.len() == 1 {
            return candidates[0]
        }
        var k = 0
        while k < candidates.len() {
            if candidates[k].kind != ResBindKind.Overload {
                let text = self.name_text(name)
                var msg = StringBuilder()
                try! msg.append("ambiguous `")
                try! msg.append(text)
                try! msg.append("`: two imports bind it to different declarations; qualify the use, or import it from a single module")
                self.refuse(leaf, "name.ambiguous", msg.build())
                return self.error_binding()
            }
            k = k + 1
        }
        self.merge_overloads(name, &candidates)
    }

    // One overload set over the modules of `candidates`, the first the
    // module's own when it declares the name. Only Overload candidates count:
    // a module's own function shadows an imported type of its name.
    func merge_overloads(&var self, name: Int, candidates: &Vector<ResBinding>) -> ResBinding {
        let first = candidates[0]
        var count = 0
        var k = 0
        while k < candidates.len() {
            if candidates[k].kind == ResBindKind.Overload {
                count = count + 1
            }
            k = k + 1
        }
        if count <= 1 {
            return first
        }
        let at = self.merges.len()
        try! self.merges.push(count)
        k = 0
        while k < candidates.len() {
            let c = candidates[k]
            if c.kind == ResBindKind.Overload {
                try! self.merges.push(c.module)
            }
            k = k + 1
        }
        ResBinding(kind: ResBindKind.Overloads, module: -1, decl: at, name: name, node: -1)
    }

    func refuse_test_only(&var self, leaf: Int, name: Int) {
        let text = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` exists only in test builds")
        self.refuse(leaf, "test.only-reference", msg.build())
    }

    // A std name the prelude leaves out: say which import supplies it.
    func refuse_gated(&var self, leaf: Int, name: Int, d: Int) {
        let text = self.name_text(name)
        let decl = self.decls[d]
        let module = self.module_name(decl.module)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` is not in the prelude and must be imported: `import ")
        try! msg.append(module)
        try! msg.append(".\{")
        try! msg.append(text)
        try! msg.append("\}` selects it")
        self.refuse(leaf, "name.not-in-prelude", msg.build())
    }

    // Declares a value binding named `name` at `leaf` in the innermost scope,
    // with binding `binding`. A binding that shadows a local, or a module
    // static, is refused unless it is Derivable and a name record since
    // `mentions_from` refers to the binding it shadows.
    public func bind_local(&var self, name: Int, leaf: Int, binding: ResBinding, shadow: ResShadow,
                           mentions_from: Int) {
        let depth = self.scope_top
        if shadow != ResShadow.Capture {
            self.check_shadow(name, leaf, shadow, mentions_from, depth)
        }
        self.push_local(ResLocal(name: name, binding: binding, depth: depth, type_level: false))
    }

    func check_shadow(&var self, name: Int, leaf: Int, shadow: ResShadow, mentions_from: Int,
                      depth: Int) {
        var shadowed = ResBinding(kind: ResBindKind.Unbound, module: -1, decl: -1, name: -1,
                                  node: -1)
        var same_scope = false
        let local = self.find_local(name, ResSpace.Value)
        if local >= 0 {
            let found = self.locals[local]
            if not found.type_level {
                shadowed = found.binding
                same_scope = found.depth == depth
            }
        }
        if shadowed.kind == ResBindKind.Unbound {
            let m = self.current
            var at = self.top.first(m, name)
            while at >= 0 {
                let d = self.top.value(at)
                let decl = self.decls[d]
                if decl.kind == ResDeclKind.Static {
                    shadowed = res_decl_binding(d, &decl)
                }
                at = self.top.following(at)
            }
        }
        if shadowed.kind == ResBindKind.Unbound {
            return
        }
        if shadow == ResShadow.Derivable && self.mentioned_since(mentions_from, &shadowed) {
            return
        }
        let text = self.name_text(name)
        var msg = StringBuilder()
        if same_scope {
            try! msg.append("`")
            try! msg.append(text)
            try! msg.append("` is already defined in this scope; a redefinition must derive from it, as `let ")
            try! msg.append(text)
            try! msg.append(" = f(")
            try! msg.append(text)
            try! msg.append(")` does")
        } else if shadow == ResShadow.Flat {
            try! msg.append("`")
            try! msg.append(text)
            try! msg.append("` shadows an enclosing binding, which a pattern, a parameter or a closure parameter may not do; pick another name")
        } else {
            try! msg.append("`")
            try! msg.append(text)
            try! msg.append("` shadows an enclosing binding without deriving from it; pick another name, or mention `")
            try! msg.append(text)
            try! msg.append("` in the initializer")
        }
        self.refuse(leaf, "name.shadowing", msg.build())
    }

    // Whether a name record from `from` on refers to `binding`.
    func mentioned_since(&self, from: Int, binding: &ResBinding) -> Bool {
        var k = from
        while k < self.records.len() {
            let r = self.records[k]
            if res_same_binding(&r.binding, &binding) {
                return true
            }
            k = k + 1
        }
        false
    }
}
