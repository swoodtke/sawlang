// The resolve stage's entry points: a program resolved from its entry file,
// and the record `sawc resolve` prints for it.

import sawresolve.dump.{res_sort_strings}
import sawresolve.imports.{res_same_binding}
import sawresolve.lang.{ResLang}
import sawresolve.layer.{FrontInputs, FrontLayer, FrontLayerKind, front_inputs, front_layers}
import sawresolve.loader.{res_read_file}
import sawresolve.model.{ResDiag, ResModule, ResModuleKind}
import sawresolve.prelude.{res_declare_prelude}
import sawresolve.program.{ResProgram, res_program}
import sawresolve.rules.{res_conformance_decl}
import sawresolve.verify.{res_verify_module}
import sawresolve.walk.{res_resolve_bodies}

// How `sawc resolve` treats one entry file.
public struct ResolveOptions {
    // The std root: Stage 0's, holding `std/` and `builtin.saw`, or the new
    // std's, holding its modules and `prelude.saw`.
    std_root: String
    // Print each resolved module's dump.
    dump: Bool
    // Print the notes about interface modules as well as the refusals.
    notes: Bool
}

// Resolves the program whose entry file is `path`, with each of `names`
// mapped to the package directory beside it in `dirs`, and with the std
// builtins modules `builtins` names (`target_builtins_modules`) loaded after
// std's own: std's layer, then the program's (`front_layers`).
public func resolve_program(path: String, std_root: String, names: &Vector<String>,
                            dirs: &Vector<String>, builtins: Vector<String> = Vector<String>()) -> ResProgram {
    var p = res_program(std_root)
    let inputs = front_inputs(path, &names, &dirs, move builtins)
    var layers = front_layers()
    var k = 0
    while k < layers.len() {
        var layer = layers[k]
        res_run_layer(&var p, &var layer, &inputs)
        k = k + 1
    }
    move p
}

// Resolve's step of `layer`: its modules loaded, and each collected as it
// loads; then imports, bodies and the rules that need every module, each over
// the layer's part of its table. Std's layer reads nothing of the program, so
// the `--module-path` packages are mapped in the program's.
public func res_run_layer(p: &var ResProgram, layer: &var FrontLayer, inputs: &FrontInputs) {
    p.begin_layer(&var layer)
    match layer.kind {
        case Std -> {
            p.detect_std_layout()
            p.load_builtin()
            p.load_std_modules()
            p.load_builtins_modules(&inputs.builtins)
            p.bind_lang_items()
            res_declare_prelude(&var p)
            p.index_gated_std()
        },
        case Program -> {
            var k = 0
            while k < inputs.names.len() {
                p.add_package(inputs.names.get(k) ?? "", inputs.dirs.get(k) ?? "")
                k = k + 1
            }
            let _ = p.load_entry(inputs.path)
        }
    }
    p.process_imports(&layer)
    p.check_none_cases(&layer)
    res_resolve_bodies(&var p, &layer)
    p.check_conformances(&layer)
}

extension ResProgram {
    // Stamps resolve's watermarks on `layer`, whose step begins.
    public func begin_layer(&self, layer: &var FrontLayer) {
        layer.module_first = self.modules.len()
        layer.decl_first = self.decls.len()
        layer.node_first = self.nodes.len()
        layer.import_first = self.imports.len()
        layer.symbol_first = self.symbols.len()
        layer.conformance_first = self.conformances.len()
        layer.pending_first = self.pending.len()
        layer.call_first = self.calls.len()
        layer.name_first = self.names.count()
    }
}

// The record of one resolved program, after its `FILE` line: an `ERROR` line
// per refusal, in the order they were made, `NOTE` lines when asked for, an
// `INVARIANT` line per problem the verifier finds, and each resolved module's
// dump when asked for. Returns 0 when nothing was refused and 1 otherwise.
public func resolve_record(out: &var StringBuilder, path: String, options: &ResolveOptions,
                           names: &Vector<String>, dirs: &Vector<String>) -> Int {
    let p = resolve_program(path, options.std_root, &names, &dirs)
    var k = 0
    while k < p.diags.len() {
        let d = p.diags[k]
        if not d.note || options.notes {
            append_res_diag(out: &var out, p: &p, d: &d)
        }
        k = k + 1
    }
    var m = 0
    while m < p.module_count() {
        let problems = res_verify_module(&p, m)
        var j = 0
        while j < problems.len() {
            try! out.append("INVARIANT\t")
            try! out.append(p.module_name(m))
            try! out.append("\t")
            try! out.append(problems.get(j) ?? "")
            try! out.append("\n")
            j = j + 1
        }
        m = m + 1
    }
    if options.dump {
        m = 0
        while m < p.module_count() {
            let info = p.module(m)
            if info.available && not info.interface_only {
                p.dump_module(&var out, m)
                try! out.append("\n")
            }
            m = m + 1
        }
    }
    if p.error_count() > 0 {
        return 1
    }
    0
}

// `ERROR<TAB>id<TAB>file:line:col<TAB>message`, or `NOTE` for a note.
public func append_res_diag(out: &var StringBuilder, p: &ResProgram, d: &ResDiag) {
    if d.note {
        try! out.append("NOTE\t")
    } else {
        try! out.append("ERROR\t")
    }
    try! out.append(d.id)
    try! out.append("\t")
    try! out.append(p.module_file(d.module))
    try! out.append(":")
    try! out.append(p.position_text(d.module, d.start))
    try! out.append("\t")
    try! out.append(d.message)
    try! out.append("\n")
}
