// The records name resolution produces (SL:architecture §3.3). Every record is
// plain data keyed by ids: a module by its index in the program, a node by its
// id in the program's copy of the parsed arenas, a declaration by its index in
// the program's declaration table. A binding into another module names it by
// module and declaration, and the dump prints that as the module's identity and
// the declaration's path, never as an index.

// Where a module's source comes from, which decides how much of it is resolved.
public enum ResModuleKind: UInt8 {
    // A file named on the command line, or a module found beside one.
    case Entry = 0,
    // A module of a package mapped with `--module-path`.
    case Package = 1,
    // A module of `std`, read for its interface only.
    case Std = 2,
    // The synthetic `builtin` module, with `builtin.saw`, also an interface.
    case Builtin = 3
}

public struct ResModule {
    // The module's name, interned: `main`, `sawparse.api`, `std.vector`.
    name: Int
    // The file it was read from, interned as the spelling that reached it
    // first; -1 for none.
    file: Int
    // The file's real path, interned: the module's identity (loader.saw's
    // `module_for_file`).
    real: Int
    kind: ResModuleKind
    // The first segment of the identity, interned: std's is `std`, and a module
    // no mapped package holds belongs to its importer's, the empty package
    // when that is a file outside every mapped package.
    package: Int
    // The directory of the file, interned, where a sibling import looks.
    dir: Int
    // Whether the file was read and parsed; a module that was not has no
    // declarations and every lookup into it is refused.
    available: Bool
    // Only an interface: declarations and imports, no bodies.
    interface_only: Bool
    // The module's nodes are `node_base .. node_base + node_count` of the
    // program's arena, and `root` is its File node; -1 when unavailable.
    node_base: Int
    node_count: Int
    root: Int
    // The byte offset of each line start, in the program's `line_starts`.
    line_base: Int
    line_count: Int
    // The module's declarations are `decl_first .. decl_first + decl_count`.
    decl_first: Int
    decl_count: Int
}

public enum ResVis: UInt8 {
    case Private = 0,
    case Public = 1,
    case Package = 2,
    case Parent = 3
}

public enum ResDeclKind: UInt8 {
    case Struct = 0,
    case Enum = 1,
    case Case = 2,
    case Trait = 3,
    case Alias = 4,
    case Static = 5,
    case Func = 6,
    case Extern = 7,
    case Extension = 8,
    case Method = 9,
    case Init = 10,
    case TypeAssign = 11,
    case AssocType = 12,
    case Requirement = 13,
    case Field = 14,
    // A type nothing declares: the primitives, `String`, `Void`, `Never`, the
    // pointer types (SL:open-questions D12).
    case Primitive = 15,
    // A function nothing declares: `print`, `panic`, `assert`, `sizeof`, `alignof`.
    case BuiltinFunc = 16,
    // A trait's `init(...)` with no body, which a conformance meets with an
    // `init` or a struct's memberwise construction (spec, Init requirements).
    case InitRequirement = 17
}

public struct ResDecl {
    module: Int
    kind: ResDeclKind
    // The declared name, interned; -1 for an extension.
    name: Int
    // The declaration's own node (Func, Struct, Case, ...); -1 when synthetic.
    node: Int
    // The node that holds its modifiers: a Declaration or ExtensionMember
    // node, else the declaration's own node. Under `@test` it is still the
    // Declaration, never the TestOnly item; read attributes through
    // `decl_attribute`.
    outer: Int
    // The leaf of its name, where it is reported; -1 when synthetic.
    leaf: Int
    vis: ResVis
    // The enclosing declaration: an enum for a case, a struct for a field, a
    // trait or an extension for a member; -1 at the top level.
    parent: Int
    // Declared under `@test`, so ordinary code may not name it.
    test_only: Bool
    // A static method, or a case with a payload.
    flag: Bool
}

public enum ResBindKind: UInt8 {
    case Unbound = 0,
    // A local, a parameter, a pattern or loop binding, a capture, a receiver.
    case Local = 1,
    // A declaration: a type, a static, an extern, a trait, an alias.
    case Decl = 2,
    // A function name: the module's whole overload set for that name.
    case Overload = 3,
    // A bare function name several modules supply, the module's own
    // declarations and its bare imports merged into one overload set (design
    // 249): `decl` indexes the program's `merges` table.
    case Overloads = 4,
    // One enum case.
    case Case = 5,
    // A variant pattern's or implicit member's case, chosen among `name`'s
    // candidates by typecheck from the scrutinee's or expected type.
    case Cases = 6,
    case TypeParam = 7,
    // A module, reached through a qualifier or an import path.
    case Module = 8,
    // `Self`: the enclosing type, or a trait's own.
    case SelfType = 9,
    // `T.Item`: the associated type `decl` that type parameter `T`'s bounds
    // declare or inherit; `node`, `name` and `module` are `T`'s, as in its
    // TypeParam binding.
    case Projection = 10,
    // A member selected on a value, or a static member on a type: found in the
    // type's member tables by typecheck, which needs the type.
    case Member = 11,
    // Refused; a diagnostic says why.
    case Error = 12
}

public struct ResBinding {
    kind: ResBindKind
    // The module of a Module or Overload binding.
    module: Int
    // The declaration of a Decl or Case binding, or the type of a SelfType or
    // Member one; -1 otherwise.
    decl: Int
    // The name of an Overload or Cases binding.
    name: Int
    // The leaf that declares a Local or TypeParam binding, or the node that
    // introduces an implicit one (a catch block's `error`).
    node: Int
}

extension ResBinding {
    public static func unbound() -> ResBinding {
        ResBinding(kind: ResBindKind.Unbound, module: -1, decl: -1, name: -1, node: -1)
    }

    public static func error() -> ResBinding {
        ResBinding(kind: ResBindKind.Error, module: -1, decl: -1, name: -1, node: -1)
    }
}

// What a pending name asks of the traits' parents.
public enum ResPendingKind: UInt8 {
    // `T.Item`, or `Self.Item` in a trait.
    case Projection = 0,
    // A bare name nothing binds while a bounded type parameter is in scope,
    // refused with its fix-it.
    case Bare = 1,
    // A bare name in a refining trait's members, which names an associated
    // type the trait inherits when one is declared, as its own would.
    case Inherited = 2,
    // A refining trait's own associated type, refused when the trait inherits
    // one of its name (SL:open-questions D34).
    case Restated = 3
}

// A name whose meaning depends on traits' parents, settled once every module
// is walked, since a trait's parents may sit in a module not walked yet.
public struct ResPending {
    kind: ResPendingKind
    module: Int
    // The leaf of the associated type's name, or of the bare name.
    leaf: Int
    name: Int
    // The type parameter heading the path, as its TypeParam binding; Unbound
    // for `Self.Item` and for a bare name.
    param: ResBinding
    // The trait whose `Self` heads the path, or, for Inherited and Restated,
    // whose parents are searched; -1 otherwise.
    trait_decl: Int
    // The segment after the associated type, or -1.
    chain: Int
    // A bare name's in-scope type parameters: their leaves are
    // `first .. first + count` of `pending_params`.
    first: Int
    count: Int
    // An Inherited name the lookup bound outside the trait: an inherited
    // associated type of its name shadows that binding, and none leaves it.
    bound: Bool
}

// One name occurrence and what it denotes.
public struct ResName {
    module: Int
    leaf: Int
    binding: ResBinding
}

// How a call's head is classified, once (SL:architecture §3.3).
public enum ResCallClass: UInt8 {
    // `Foo(...)`: the type's `init` set.
    case Init = 0,
    // `f(...)`: an overload set.
    case Overload = 1,
    // `x(...)`: a local holding a function value.
    case Local = 2,
    // `T(...)`: a type parameter.
    case TypeParam = 3,
    // `E.Case(...)`: an enum case.
    case Case = 4,
    // `.Case(...)`: an enum case chosen by the expected type.
    case ImplicitCase = 5,
    // `x.f(...)`: a method, found from the receiver's type.
    case Method = 6,
    // `T.f(...)`: a static method of a named type.
    case StaticMethod = 7,
    // Any other callee: a function value, decided from its type (SL-73).
    case Value = 8
}

public struct ResCall {
    module: Int
    node: Int
    classification: ResCallClass
    binding: ResBinding
}

public enum ResImportForm: UInt8 {
    case Qualifier = 0,
    case Glob = 1,
    case Select = 2
}

public struct ResImport {
    module: Int
    node: Int
    // The Path node, and the leaf its last segment is.
    path: Int
    leaf: Int
    // The imported module, or -1 when it could not be found.
    target: Int
    form: ResImportForm
    reexport: Bool
    test_only: Bool
    // The qualifier a whole-module import binds, interned; -1 otherwise.
    qualifier: Int
    qualifier_leaf: Int
}

// One name a selective import takes.
public struct ResSymbol {
    import_at: Int
    module: Int
    // The name asked for, and the name it is bound to (its `as` rename).
    name: Int
    bound: Int
    leaf: Int
    bound_leaf: Int
    binding: ResBinding
}

// One name on a module's surface: its own public declarations and what it
// re-exports (design 229).
public struct ResExport {
    module: Int
    name: Int
    binding: ResBinding
    vis: ResVis
    // The module whose declaration grants the visibility.
    owner: Int
}

// A binding in scope in a body or a signature.
public struct ResLocal {
    name: Int
    binding: ResBinding
    // The scope depth it was declared at.
    depth: Int
    // Whether this is a type-level binding (a type parameter, `Self`, an
    // associated type), which a type position sees and a value position does not.
    type_level: Bool
}

public struct ResDiag {
    module: Int
    start: Int
    end: Int
    id: String
    message: String
    // A note about an interface module, which refuses nothing.
    note: Bool
}

// The `&self` twin `@synthesize(shared)` derives for an accessor: a copy of
// the accessor's member under the shared signature, its nodes the run
// `first ..= last` of its module's arena (`derive_shared_twins`).
public struct ResTwin {
    module: Int
    // The `@synthesize(shared)` member as written, and its copy.
    member: Int
    clone: Int
    first: Int
    last: Int
    // The accessor's declaration and the twin's, once collected; -1 before.
    decl: Int
    twin: Int
}

// A conformance an extension declares: which type, which trait, where.
public struct ResConformance {
    module: Int
    ext: Int
    path: Int
    target: ResBinding
    trait_binding: ResBinding
}

// The front-end image writes these types (sawmono.frontimage). They are
// derived, so a field added later is in the image by construction.
@synthesize
extension ResModule: Serialize {}
@synthesize
extension ResModule: Deserialize {}

@synthesize
extension ResDecl: Serialize {}
@synthesize
extension ResDecl: Deserialize {}

@synthesize
extension ResImport: Serialize {}
@synthesize
extension ResImport: Deserialize {}

@synthesize
extension ResSymbol: Serialize {}
@synthesize
extension ResSymbol: Deserialize {}

@synthesize
extension ResExport: Serialize {}
@synthesize
extension ResExport: Deserialize {}

@synthesize
extension ResName: Serialize {}
@synthesize
extension ResName: Deserialize {}

@synthesize
extension ResCall: Serialize {}
@synthesize
extension ResCall: Deserialize {}

@synthesize
extension ResConformance: Serialize {}
@synthesize
extension ResConformance: Deserialize {}

@synthesize
extension ResDiag: Serialize {}
@synthesize
extension ResDiag: Deserialize {}

@synthesize
extension ResTwin: Serialize {}
@synthesize
extension ResTwin: Deserialize {}

@synthesize
extension ResPending: Serialize {}
@synthesize
extension ResPending: Deserialize {}

@synthesize
extension ResLocal: Serialize {}
@synthesize
extension ResLocal: Deserialize {}

@synthesize
extension ResBinding: Serialize {}
@synthesize
extension ResBinding: Deserialize {}

@synthesize
extension ResVis: Serialize {}
@synthesize
extension ResVis: Deserialize {}

@synthesize
extension ResModuleKind: Serialize {}
@synthesize
extension ResModuleKind: Deserialize {}

@synthesize
extension ResDeclKind: Serialize {}
@synthesize
extension ResDeclKind: Deserialize {}

@synthesize
extension ResImportForm: Serialize {}
@synthesize
extension ResImportForm: Deserialize {}

@synthesize
extension ResCallClass: Serialize {}
@synthesize
extension ResCallClass: Deserialize {}

@synthesize
extension ResPendingKind: Serialize {}
@synthesize
extension ResPendingKind: Deserialize {}

@synthesize
extension ResBindKind: Serialize {}
@synthesize
extension ResBindKind: Deserialize {}
