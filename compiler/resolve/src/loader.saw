// Loading modules: a file to its module, the file to a parsed arena, the
// arena into the program. A module's identity is its file's real path, so a
// file is one module whatever spelling reached it. Each module is collected
// (phase 1) as soon as it is loaded, since its own table depends on nothing
// else.

import sawparse.api.{parse_interface, parse_source}
import sawparse.diag.{diagnostic_id}
import sawparse.parser.{Parser}
import sawparse.tree.{tree_problem}
import sawresolve.collect.{res_is_top_level}
import sawresolve.model.{ResModule, ResModuleKind, ResVis}
import sawresolve.prelude.{res_declare_synthetic_builtins}
import sawresolve.program.{ResPackage, ResProgram}
import std.file.{File}
import std.path.{Path}

static RES_SLASH: Int = 47
static RES_DOT: Int = 46
static RES_NEWLINE_BYTE: Int = 10
static RES_SPACE: Int = 32
static RES_CAPITAL_A: Int = 65
static RES_CAPITAL_Z: Int = 90
static RES_CASE_DISTANCE: Int = 32

// The text of the file at `path`, or None when it cannot be read as UTF-8.
public func res_read_file(path: String) -> String? {
    let opened = File.open(Path(s: path))
    var file = match opened {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            return None
        }
    }
    let read = file.read()
    let data = match read {
        case Ok(bytes) -> move bytes,
        case Err(e) -> {
            return None
        }
    }
    let decoded = data.to_string()
    match decoded {
        case Ok(text) -> text,
        case Err(e) -> None
    }
}

// The real path of `path`, every symbolic link, `.` and `..` resolved, or
// `path` itself when it cannot be resolved: a file that cannot be read is
// refused where it is read, and the empty path is the working directory.
public func res_real_path(path: &String) -> String {
    let spelled = if path.len() == 0 { "." } else { path.substring(0, path.len()) }
    match Path(s: spelled).canonical() {
        case Ok(real) -> real.as_string(),
        case Err(e) -> path.substring(0, path.len())
    }
}

// The last `/`-separated component of `path`, all of it when it has none.
public func res_last_component(path: &String) -> String {
    var i = path.len() - 1
    while i >= 0 {
        if (path.byte_at(i) as Int) == RES_SLASH {
            return path.substring(i + 1, path.len())
        }
        i = i - 1
    }
    path.substring(0, path.len())
}

// Whether `a` and `b` are one text when ASCII letters are compared without
// their case.
public func res_same_ignoring_case(a: &String, b: &String) -> Bool {
    let n = a.len()
    if n != b.len() {
        return false
    }
    var i = 0
    while i < n {
        if res_lower(a.byte_at(i) as Int) != res_lower(b.byte_at(i) as Int) {
            return false
        }
        i = i + 1
    }
    true
}

// An ASCII capital as its small letter; any other byte unchanged.
func res_lower(b: Int) -> Int {
    if b >= RES_CAPITAL_A && b <= RES_CAPITAL_Z {
        return b + RES_CASE_DISTANCE
    }
    b
}

// `text` with each `.` made a `/`: a module path's segments as directories.
public func res_dots_to_slashes(text: &String) -> String {
    var out = StringBuilder()
    var run = 0
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == RES_DOT {
            try! out.append(text.substring(run, i))
            try! out.append("/")
            run = i + 1
        }
        i = i + 1
    }
    try! out.append(text.substring(run, n))
    out.build()
}

// The directory part of `path`, without its last `/`; empty for a bare name.
public func res_dir_of(path: &String) -> String {
    var i = path.len() - 1
    while i >= 0 {
        if (path.byte_at(i) as Int) == RES_SLASH {
            return path.substring(0, i)
        }
        i = i - 1
    }
    ""
}

// `text` with each `/` made a `.`: a relative file path's directories as a
// module path's segments.
public func res_slashes_to_dots(text: &String) -> String {
    var out = StringBuilder()
    var run = 0
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == RES_SLASH {
            try! out.append(text.substring(run, i))
            try! out.append(".")
            run = i + 1
        }
        i = i + 1
    }
    try! out.append(text.substring(run, n))
    out.build()
}

// Whether `path` is directory `dir` or lies below it. Both are compared as
// written, so a package's directory and the files under it must be spelled
// from the same base.
public func res_is_within(path: &String, dir: &String) -> Bool {
    let n = dir.len()
    if n == 0 {
        return false
    }
    if path.equals(dir) {
        return true
    }
    if path.len() <= n || not path.starts_with(dir) {
        return false
    }
    (path.byte_at(n) as Int) == RES_SLASH
}

// `dir` without the `/` that may end it.
func res_trim_slash(dir: String) -> String {
    let n = dir.len()
    if n > 1 && (dir.byte_at(n - 1) as Int) == RES_SLASH {
        return dir.substring(0, n - 1)
    }
    dir
}

// `dir/rel`, or `rel` when `dir` is empty.
public func res_join(dir: String, rel: String) -> String {
    if dir.len() == 0 {
        return rel
    }
    var out = StringBuilder()
    try! out.append(dir)
    try! out.append("/")
    try! out.append(rel)
    out.build()
}

// The first `.`-separated segment of `text`.
public func res_first_segment(text: &String) -> String {
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == RES_DOT {
            return text.substring(0, i)
        }
        i = i + 1
    }
    text.substring(0, n)
}

// `text` past its first `.`-separated segment, or empty.
public func res_after_first_segment(text: &String) -> String {
    var i = 0
    let n = text.len()
    while i < n {
        if (text.byte_at(i) as Int) == RES_DOT {
            return text.substring(i + 1, n)
        }
        i = i + 1
    }
    ""
}

extension ResProgram {
    // Maps package `name` to directory `dir`. A directory is one package, so
    // a mapping whose directory another mapping's already is, or lies inside
    // or around another's, is refused at the entry, naming both mappings.
    public func add_package(&var self, name: String, dir: String) {
        let trimmed = res_trim_slash(dir)
        let real = res_real_path(&trimmed)
        var k = 0
        while k < self.packages.len() {
            let p = self.packages[k]
            let other = self.name_text(p.real)
            if res_is_within(&real, &other) || res_is_within(&other, &real) {
                var msg = StringBuilder()
                try! msg.append("`--module-path ")
                try! msg.append(name)
                try! msg.append("=")
                try! msg.append(dir)
                try! msg.append("` maps `")
                try! msg.append(real)
                if real.equals(other) {
                    try! msg.append("`, the directory `--module-path ")
                } else if res_is_within(&real, &other) {
                    try! msg.append("`, inside `")
                    try! msg.append(other)
                    try! msg.append("`, the directory `--module-path ")
                } else {
                    try! msg.append("`, which holds `")
                    try! msg.append(other)
                    try! msg.append("`, the directory `--module-path ")
                }
                try! msg.append(self.name_text(p.name))
                try! msg.append("=")
                try! msg.append(self.name_text(p.dir))
                try! msg.append("` maps: a directory is one package, and one package's directory holds no other's")
                try! self.mapping_refusals.push(msg.build())
            }
            k = k + 1
        }
        let n = self.intern(name)
        let d = self.intern(trimmed)
        let r = self.intern(real)
        try! self.packages.push(ResPackage(name: n, dir: d, real: r))
    }

    // The index of the mapped package whose directory holds the file whose
    // real path is `real`, or -1.
    public func package_holding(&self, real: &String) -> Int {
        var k = 0
        while k < self.packages.len() {
            let p = self.packages[k]
            let dir = self.name_text(p.real)
            if res_is_within(&real, &dir) {
                return k
            }
            k = k + 1
        }
        return -1
    }

    // The name of the module whose file's real path is `real`: the holding
    // package's name and the file's path from that package's root, else the
    // file's path from the entry's directory, else `written`, the spelling
    // that reached it.
    public func module_name_for(&self, real: &String, written: String) -> String {
        let named = self.package_name_for(&real)
        if named.len() > 0 {
            return named
        }
        let loose = self.loose_name_for(&real)
        if loose.len() > 0 {
            return loose
        }
        written
    }

    // The name of the module in the file whose real path is `real` when a
    // mapped package holds it, the package's name and the file's path from
    // the package's root; "" otherwise.
    func package_name_for(&self, real: &String) -> String {
        let k = self.package_holding(&real)
        if k < 0 {
            return ""
        }
        let p = self.packages[k]
        let name = self.name_text(p.name)
        let dir = self.name_text(p.real)
        let n = real.len()
        if n <= dir.len() + 5 || not real.substring(n - 4, n).equals(".saw") {
            return ""
        }
        let rel = real.substring(dir.len() + 1, n - 4)
        if rel.equals("lib") {
            return name
        }
        var out = StringBuilder()
        try! out.append(name)
        try! out.append(".")
        try! out.append(res_slashes_to_dots(&rel))
        out.build()
    }

    // The name of the module in the file whose real path is `real` when no
    // mapped package holds it: the file's path from the entry's directory, so
    // a sibling import inside a subdirectory and the entry's path to the same
    // file name one module; "" when the file lies outside that directory.
    func loose_name_for(&self, real: &String) -> String {
        let entry = self.modules[self.entry]
        let entry_real = self.name_text(entry.real)
        let root = res_dir_of(&entry_real)
        let n = real.len()
        if n <= 4 || not real.substring(n - 4, n).equals(".saw") || not res_is_within(&real, &root) {
            return ""
        }
        let rel = real.substring(root.len() + 1, n - 4)
        res_slashes_to_dots(&rel)
    }

    // The directory a package name is mapped to, or None.
    public func package_dir(&self, name: Int) -> String? {
        var k = 0
        while k < self.packages.len() {
            let p = self.packages[k]
            if p.name == name {
                return self.name_text(p.dir)
            }
            k = k + 1
        }
        None
    }

    // The module named `name`, or -1 when none is loaded.
    public func find_module(&self, name: Int) -> Int {
        let at = self.by_name.first(0, name)
        if at < 0 {
            return -1
        }
        self.by_name.value(at)
    }

    // The module read from the file whose real path is `real`, or -1.
    public func module_of_file(&var self, real: &String) -> Int {
        let key = self.intern(real.substring(0, real.len()))
        let at = self.by_file.first(0, key)
        if at < 0 {
            return -1
        }
        self.by_file.value(at)
    }

    // THE MODULE IDENTITY FUNNEL: the module in file `path`, whose real path
    // is `real`, loaded and collected unless a module holds that file already.
    // A module's identity is its file, so every spelling that reaches one file
    // reaches one module (LANGUAGE_SPEC, Package Structure); a new module is
    // named `name`. Returns its index, available or not.
    //
    // ENTRY POINTS:
    //     std_module
    //     load_entry
    //     load_import
    public func module_for_file(&var self, path: String, real: String, name: String,
                                kind: ResModuleKind, package: String) -> Int {
        let known = self.module_of_file(&real)
        if known >= 0 {
            return known
        }
        let key = self.intern(name)
        let m = self.new_module(key, path, real, kind, package)
        self.read_module(m, path)
        m
    }

    // Adds module `key`, read from `path`, whose real path is `real`, with
    // nothing in it yet.
    func new_module(&var self, key: Int, path: String, real: String, kind: ResModuleKind,
                    package: String) -> Int {
        let m = self.modules.len()
        // The new std's modules are compiled whole; Stage 0's std is read for
        // its interface only, since sawc never compiles its bodies.
        let interface = (kind == ResModuleKind.Std && not self.std_new) || kind == ResModuleKind.Builtin
        let dir_text = res_dir_of(&path)
        let dir = self.intern(dir_text)
        let file = self.intern(path)
        let real_key = self.intern(real)
        let pkg = self.intern(package)
        let first = self.decls.len()
        try! self.modules.push(ResModule(name: key, file: file, real: real_key, kind: kind, package: pkg,
                                         dir: dir, available: false, interface_only: interface,
                                         node_base: 0, node_count: 0, root: -1, line_base: 0,
                                         line_count: 0, decl_first: first, decl_count: 0))
        self.by_name.add(0, key, m)
        self.by_file.add(0, real_key, m)
        m
    }

    // Reads and parses module `m`, the module added last, into the arena, then
    // collects it. An interface module is parsed as one, its bodies skipped. A
    // file that cannot be read or that the parser refuses leaves the module
    // unavailable, with a refusal saying why: a note for an interface module,
    // which the parser refuses only as a whole file, since it drops a failing
    // declaration and keeps the rest. Pushes the module's text, empty when
    // there is none, so `texts` stays indexed by module.
    func read_module(&var self, m: Int, path: String) {
        let info = self.modules[m]
        let source = res_read_file(path)
        guard let text = source else {
            try! self.texts.push("")
            var msg = StringBuilder()
            try! msg.append("cannot read `")
            try! msg.append(path)
            try! msg.append("`")
            self.refuse_at(m, 0, "import.unreadable", msg.build(), info.interface_only)
            return
        }
        self.parse_module(m, path, text)
    }

    // Parses `text`, module `m`'s source read from `path`, into the arena and
    // collects it.
    func parse_module(&var self, m: Int, path: String, text: String) {
        let saved = self.current
        self.current = m
        let info = self.modules[m]
        try! self.texts.push(text)
        let line_base = self.index_lines(&text)
        var indexed = self.modules[m]
        indexed.line_base = line_base
        indexed.line_count = self.line_starts.len() - line_base
        self.modules[m] = indexed
        let parser = if info.interface_only { parse_interface(path, text) } else { parse_source(path, text, false) }
        let refused = if info.interface_only { not res_interface_intact(&parser) } else { parser.diagnostics.len() > 0 }
        if refused {
            var msg = StringBuilder()
            try! msg.append("the parser refuses `")
            try! msg.append(path)
            var at = 0
            if parser.diagnostics.len() > 0 {
                let first = parser.diagnostics[0]
                at = first.start
                try! msg.append("` (")
                try! msg.append(diagnostic_id(&first))
                try! msg.append("), so its declarations are not available")
            } else {
                try! msg.append("`: its interface breaks the arena's invariants")
            }
            self.refuse_at(m, at, "resolve.parse-refused", msg.build(), info.interface_only)
            self.current = saved
            return
        }
        if info.interface_only {
            self.note_dropped(m, &parser, &text)
        }
        let node_base = self.nodes.len()
        let root = self.adopt_tree(&parser.builder.tree)
        var updated = self.modules[m]
        updated.available = true
        updated.node_base = node_base
        updated.node_count = self.nodes.len() - node_base
        updated.root = root
        self.modules[m] = updated
        self.collect_module(m)
        self.current = saved
    }

    // A note for each declaration the interface parse of module `m` dropped,
    // at the declaration, naming it and the refusal that dropped it.
    func note_dropped(&var self, m: Int, parser: &Parser, text: &String) {
        var k = 0
        while k < parser.dropped_declarations.len() {
            let d = parser.dropped_declarations[k]
            var msg = StringBuilder()
            try! msg.append("the parser refuses the declaration `")
            try! msg.append(res_first_line(&text, d.start, d.end))
            try! msg.append("`")
            if d.count > 0 {
                let first = parser.diagnostics[d.first]
                try! msg.append(" (")
                try! msg.append(diagnostic_id(&first))
                try! msg.append(" at ")
                try! msg.append(self.position_text(m, first.start))
                try! msg.append(")")
            }
            try! msg.append(", so it is not available")
            self.refuse_at(m, d.start, "resolve.parse-refused", msg.build(), true)
            k = k + 1
        }
    }

    // Which std the root holds: the new std when it has a `prelude.saw`.
    public func detect_std_layout(&var self) {
        let prelude = self.std_file("prelude.saw")
        if let found = res_read_file(prelude) {
            self.std_new = true
        }
    }

    // The builtin module: its synthetic declarations, then, under Stage 0's
    // std root, `builtin.saw`'s. The new std declares that vocabulary in its
    // prelude, so the module has no source of its own there.
    public func load_builtin(&var self) {
        let path = if self.std_new { "<builtin>" } else { self.std_file("builtin.saw") }
        let key = self.intern("builtin")
        let real = if self.std_new { path } else { res_real_path(&path) }
        let m = self.new_module(key, path, real, ResModuleKind.Builtin, "std")
        self.builtin = m
        let saved = self.current
        self.current = m
        res_declare_synthetic_builtins(&var self)
        self.current = saved
        if self.std_new {
            self.parse_module(m, path, "")
        } else {
            self.read_module(m, path)
        }
    }

    // Every std module: the third of the tables prelude.saw describes.
    public func load_std_modules(&var self) {
        let dir = if self.std_new { self.std_root } else { self.std_file("std") }
        self.std_dir_real = res_real_path(&dir)
        if self.std_new {
            self.load_new_std_modules()
        } else {
            self.load_frozen_std_modules()
        }
    }

    // The new std's modules, each `std.X` at `<std root>/X.saw`.
    func load_new_std_modules(&var self) {
        self.std_module("prelude")
        self.std_module("alloc")
        self.std_module("mem")
        self.std_module("box")
        self.std_module("arc")
        self.std_module("panic")
        self.std_module("scalar")
        self.std_module("string")
        self.std_module("stringbuilder")
        self.std_module("vector")
        self.std_module("utf8")
        self.std_module("data")
        self.std_module("systemerror")
        self.std_module("path")
        self.std_module("env")
        self.std_module("file")
        self.std_module("directory")
        self.std_module("process")
        self.std_module("duration")
        self.std_module("map")
        self.std_module("set")
        self.std_module("task")
        self.std_module("taskgroup")
        self.std_module("channel")
        self.std_module("net")
        self.std_module("signal")
        self.std_module("time")
        self.std_module("spinlock")
        self.std_module("mutex")
        self.std_module("once")
        self.std_module("numeric")
        self.std_module("float")
        self.std_module("slab")
        self.std_module("json")
    }

    // Stage 0's std modules, each `std.X` at `<std root>/std/X.saw`.
    func load_frozen_std_modules(&var self) {
        self.std_module("alloc")
        self.std_module("arc")
        self.std_module("box")
        self.std_module("cbor")
        self.std_module("channel")
        self.std_module("data")
        self.std_module("directory")
        self.std_module("duration")
        self.std_module("env")
        self.std_module("file")
        self.std_module("fixedbuf")
        self.std_module("float")
        self.std_module("json")
        self.std_module("map")
        self.std_module("mutex")
        self.std_module("net")
        self.std_module("numeric")
        self.std_module("once")
        self.std_module("path")
        self.std_module("process")
        self.std_module("scalar")
        self.std_module("serde")
        self.std_module("set")
        self.std_module("signal")
        self.std_module("slab")
        self.std_module("spinlock")
        self.std_module("string")
        self.std_module("stringbuilder")
        self.std_module("task")
        self.std_module("taskgroup")
        self.std_module("time")
        self.std_module("vector")
        self.std_module("compiler.frame")
    }

    // `rel` under the std root.
    public func std_file(&self, rel: String) -> String {
        let root = self.std_root
        res_join(root, rel)
    }

    // Loads `std.<path>` from its file under the std root.
    public func std_module(&var self, path: String) {
        var identity = StringBuilder()
        try! identity.append("std.")
        try! identity.append(path)
        var rel = StringBuilder()
        if not self.std_new {
            try! rel.append("std/")
        }
        try! rel.append(res_dots_to_slashes(&path))
        try! rel.append(".saw")
        let file = self.std_file(rel.build())
        let real = res_real_path(&file)
        let _ = self.module_for_file(file, real, identity.build(), ResModuleKind.Std, "std")
    }

    // The gated tier (design 255): every public std declaration the prelude
    // leaves out, so a bare use can be told to import it.
    public func index_gated_std(&var self) {
        var d = 0
        while d < self.decls.len() {
            let decl = self.decls[d]
            let info = self.modules[decl.module]
            if res_is_top_level(&decl) && info.kind == ResModuleKind.Std && decl.vis == ResVis.Public {
                if self.prelude.first(0, decl.name) < 0 {
                    self.prelude.add(1, decl.name, d)
                }
            }
            d = d + 1
        }
    }

    // Loads the entry file named on the command line: a module named by its
    // file name without `.saw`, in the package whose directory holds it, else
    // in the empty package. The mappings `add_package` refused are reported
    // at its start.
    public func load_entry(&var self, path: String) -> Int {
        let base = res_base_name(&path)
        let real = res_real_path(&path)
        let k = self.package_holding(&real)
        var package = ""
        if k >= 0 {
            let p = self.packages[k]
            package = self.name_text(p.name)
        }
        let m = self.module_for_file(path, real, base, ResModuleKind.Entry, package)
        self.entry = m
        var r = 0
        while r < self.mapping_refusals.len() {
            let message = self.mapping_refusals[r]
            self.refuse_at(m, 0, "import.module-path-overlap", message, false)
            r = r + 1
        }
        m
    }
}

// Whether an interface parse's tree holds the module: every diagnostic is the
// reason a declaration was dropped, so none is about the file as a whole (a
// lex error, an unclosed bracket, a misplaced `//!`), and the tree keeps the
// arena's invariants.
func res_interface_intact(parser: &Parser) -> Bool {
    var covered = 0
    var k = 0
    while k < parser.dropped_declarations.len() {
        covered = covered + parser.dropped_declarations[k].count
        k = k + 1
    }
    if covered != parser.diagnostics.len() || parser.builder.tree.root < 0 {
        return false
    }
    if let _ = tree_problem(&parser.builder.tree) {
        return false
    }
    true
}

// The text of [start, end) up to its first line break, without the spaces
// around it.
func res_first_line(text: &String, start: Int, end: Int) -> String {
    var stop = start
    while stop < end && (text.byte_at(stop) as Int) != RES_NEWLINE_BYTE {
        stop = stop + 1
    }
    while stop > start && (text.byte_at(stop - 1) as Int) == RES_SPACE {
        stop = stop - 1
    }
    text.substring(start, stop)
}

// A path's last component without its `.saw` suffix.
public func res_base_name(path: &String) -> String {
    var start = 0
    var i = 0
    let n = path.len()
    while i < n {
        if (path.byte_at(i) as Int) == RES_SLASH {
            start = i + 1
        }
        i = i + 1
    }
    var end = n
    if n - start > 4 && path.substring(n - 4, n).equals(".saw") {
        end = n - 4
    }
    path.substring(start, end)
}
