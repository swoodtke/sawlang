// The paths `sawc mono --lowerings` cannot report lower their program once
// too: coroutine lowering's, the front half of `sawc build` and
// `sawc coro`, and a runtime source's, which `sawc runtime` builds (SL-523).
// Paths are the repository root's, where the runner runs.
import sawcoro.api.{coro_lower_file}
import sawmono.api.{mono_lower_file}
import sawtarget.layout.{target_front_end}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    let host = target_front_end("arm64-apple-darwin", "")
    var front = StringBuilder()
    let coro = coro_lower_file(out: &var front, path: "compiler/tests/run/statics.saw", std_root: "std",
                               notes: false, names: &names, dirs: &dirs, target: host)
    assert(not coro.blocked, "the statics program is refused before coroutine lowering")
    assert(coro.mono.lowerings == 1, "coroutine lowering's program was lowered {} times", coro.mono.lowerings)
    var head = StringBuilder()
    let runtime = mono_lower_file(out: &var head, path: "runtime/common/mem.saw", std_root: "std", notes: false,
                                  names: &names, dirs: &dirs, target: host, runtime: true)
    assert(not runtime.blocked, "the runtime source is refused before mono")
    assert(runtime.lowerings == 1, "the runtime source was lowered {} times", runtime.lowerings)
}
