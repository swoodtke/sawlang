// The worklist (SL:architecture §3.8): items reached from the roots, each
// instantiated once by substituting its concrete arguments into a copy of its
// source function, whose calls, closures, drops and copies then add the items
// they reach. Items are numbered in discovery order, and a body is walked
// block by block, statement by statement, so the order is a function of the
// program alone.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirAggregate, MirBlock, MirCall, MirCallKind, MirConstKind, MirDriveForm, MirFunc, MirFuncKind,
                         MirLocal, MirOperand, MirOperandKind, MirPlace, MirProj, MirRvalue, MirRvalueKind, MirStmt,
                         MirStmtKind, MirSuspend, MirSwitchKind, MirTermKind, MirWindow}
import sawmir.program.{MirProgram}
import sawmir.build.{mir_func_local}
import sawmono.dump.{mono_dump_layouts}
import sawmono.glue.{mono_copies_bitwise}
import sawtarget.layout.{target_struct_fields}
import sawmono.program.{MONO_DEPTH_LIMIT, MONO_KEY_COPY, MONO_KEY_DEALLOC, MONO_KEY_DISPATCHED, MONO_KEY_DROP,
                            MONO_KEY_EXTERN, MONO_KEY_FUNCTION, MONO_KEY_MEMBER, MONO_KEY_RELOCATIONS, MONO_KEY_RENDER,
                            MONO_KEY_RENDER_SLOT, MONO_KEY_TASK_ROOT, MONO_KEY_THREAD, MONO_KEY_VTABLE, MonoItem,
                            MonoItemKind, MonoProgram, MonoThreadSpawn, MonoVtable}
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.bodydump.{tc_dump_bodies}
import sawtypecheck.candidates.{tc_contains}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}
import sawresolve.lang.{ResLang}
import sawresolve.model.{ResDeclKind, ResModuleKind}
import sawresolve.program.{ResProgram}
import sawtypecheck.conform.{TcSubst}
import sawtypecheck.erasure.{tc_check_object_safety}
import sawtypecheck.model.{TC_CAUSE_BLOCKING, TC_CAUSE_PAIRED, TC_FLAG_BLOCKING, TC_FLAG_DEFAULT_BODY, TcStatusKind}
import sawtypecheck.summaries.{TcAcc, tc_thread_struck}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.tier.{tc_compute_tiers}
import sawtypecheck.types.{TcKind}

// Every rule monomorphization refuses by.
public func mono_rules() -> Vector<String> {
    var out = Vector<String>()
    try! out.push("atomic.width")
    try! out.push("mono.depth")
    try! out.push("mono.not-yet")
    try! out.push("static_assert.failed")
    try! out.push("transfer.no-move")
    move out
}

// THE BUILTIN FUNNEL's admission: the builtins the backend's slice lowers
// (`LlEmitter.builtin`), or coroutine lowering lowers away, by spelling.
// ENTRY POINTS:
//     resolve_call
func mono_builtin_supported(name: String) -> Bool {
    name.equals("print") || name.equals("panic") || name.equals("assert") || name.equals("init") || name.equals("len") || name.equals("swap") || name.equals("copy") || name.equals("sizeof") || name.equals("alignof") || name.equals("__saw_atomic_add_i64") || name.equals("__saw_atomic_sub_i64_release") || name.equals("__saw_atomic_fence_acquire") || name.equals("__saw_atomic_load_i64_relaxed") || mono_seq_cst_atomic(name) || mono_test_suspension(name) || name.equals("Thread.spawn")
}

// Whether a construction of kind `agg` is a collection literal: a fixed
// array, a repeat, or a `Vector`, `Map` or `Set` literal.
func mono_collection_literal(agg: MirAggregate) -> Bool {
    agg == MirAggregate.Array || agg == MirAggregate.Repeat || agg == MirAggregate.Vector || agg == MirAggregate.Map || agg == MirAggregate.Set
}

// The test intrinsics that suspend, `__saw_suspend` and `__saw_test_suspend`.
// The backend never meets a call of either: coroutine lowering replaces each
// with a ready park or a goto.
func mono_test_suspension(name: String) -> Bool {
    name.equals("__saw_suspend") || name.equals("__saw_test_suspend")
}

// The sequentially consistent atomic intrinsics (SL:open-questions D39).
func mono_seq_cst_atomic(name: String) -> Bool {
    name.equals("__saw_atomic_load_i64_seq_cst") || name.equals("__saw_atomic_store_i64_seq_cst") || name.equals("__saw_atomic_add_i64_seq_cst") || name.equals("__saw_atomic_cmpxchg_i64_seq_cst")
}

// A resolved call target: the declaration whose body runs, and the `Self`
// it runs under (a trait's default body), or -1; or the glue item that
// synthesizes the member, or -1.
struct MonoTarget {
    decl: Int
    self_type: Int
    item: Int
}

extension MonoProgram {
    // Runs the worklist to its end: the roots, then every item they reach.
    public func run(&var self) {
        if self.blocked {
            return
        }
        self.index_bodies()
        self.add_roots()
        var k = 0
        while k < self.items.len() {
            self.current = k
            self.instantiate(k)
            k = k + 1
        }
        self.current = -1
        self.report_depth()
    }

    func index_bodies(&var self) {
        var f = 0
        while f < self.concrete_first {
            let info = self.dp.bc.mir.funcs[f]
            if self.dp.elaborated[f] && info.decl >= 0 {
                if info.kind == MirFuncKind.Body && self.body_of[info.decl] < 0 {
                    self.body_of[info.decl] = f
                } else if info.kind == MirFuncKind.Default {
                    self.defaults.add(info.decl, info.param, f)
                }
            }
            f = f + 1
        }
    }

    // The roots, in order: the entry module's `main`, never a test-only one
    // (`top_decl`), which a runtime has none of; each exported function, in
    // declaration order; then the lang functions the backend's own lowering
    // calls: the panic sink, which every
    // check ends in, and the String roles a literal and a written-out String
    // are read through.
    func add_roots(&var self) {
        let entry = self.entry_module()
        let none = Vector<Int>()
        if not self.runtime {
            let main_decl = self.dp.bc.mir.tc.top_decl(entry, "main")
            if main_decl >= 0 {
                self.main_item = self.root_item(main_decl, &none)
            }
        }
        var d = 0
        while d < self.dp.bc.mir.tc.export_symbols.len() {
            let symbol = self.dp.bc.mir.tc.export_symbols.get(d) ?? ""
            if symbol.len() > 0 && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Func {
                let k = self.root_item(d, &none)
                if k >= 0 {
                    try! self.export_items.push(k)
                }
            }
            d = d + 1
        }
        let sink = self.dp.bc.mir.tc.res.lang_item(ResLang.PanicSinkFunction)
        self.panic_item = self.root_item(sink, &none)
        let literal = self.dp.bc.mir.tc.res.lang_item(ResLang.StringLiteralFunction)
        self.literal_item = self.root_item(literal, &none)
        let bytes = self.dp.bc.mir.tc.res.lang_item(ResLang.StringBytesFunction)
        self.bytes_item = self.root_item(bytes, &none)
        let length = self.dp.bc.mir.tc.res.lang_item(ResLang.StringLengthFunction)
        self.length_item = self.root_item(length, &none)
    }

    // The entry executor's item, rooted after the worklist ran and run to
    // its end like any root, or -1 when std declares none. Only a program
    // whose `main` has a lowered frame is handed to the executor, which
    // coroutine lowering decides after mono, so a program with a plain
    // `main` reaches no executor item at all.
    public func root_entry_executor(&var self) -> Int {
        if self.exec_item >= 0 || self.blocked {
            return self.exec_item
        }
        let none = Vector<Int>()
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.ExecRunMainFunction)
        // The worklist's run already made its one depth refusal, if any.
        let reported = self.depth_call >= 0 || self.depth_glue >= 0
        var k = self.items.len()
        self.exec_item = self.root_item(d, &none)
        while k < self.items.len() {
            self.current = k
            self.instantiate(k)
            k = k + 1
        }
        self.current = -1
        if not reported {
            self.report_depth()
        }
        self.exec_item
    }

    // The item a failed `print` renders its cause through, rooted after the
    // worklist ran and run to its end like any root, for a program that
    // prints; -1 for one that does not, or when std declares none. Rooted
    // late, as the entry executor is, so a program's item list before the
    // backend is what its source reaches.
    public func root_print_failure(&var self) -> Int {
        if self.print_failure_item >= 0 || self.blocked || not self.prints {
            return self.print_failure_item
        }
        let none = Vector<Int>()
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.PrintFailureFunction)
        let reported = self.depth_call >= 0 || self.depth_glue >= 0
        var k = self.items.len()
        self.print_failure_item = self.root_item(d, &none)
        while k < self.items.len() {
            self.current = k
            self.instantiate(k)
            k = k + 1
        }
        self.current = -1
        if not reported {
            self.report_depth()
        }
        self.print_failure_item
    }

    // The module of the file the program was named by.
    public func entry_module(&self) -> Int {
        var m = 0
        while m < self.dp.bc.mir.tc.res.module_count() {
            let info = self.dp.bc.mir.tc.res.module(m)
            if info.kind == ResModuleKind.Entry && info.available {
                return m
            }
            m = m + 1
        }
        return -1
    }

    // The item of non-generic declaration `d`'s body, or -1 when it has none.
    func root_item(&var self, d: Int, none: &Vector<Int>) -> Int {
        if d < 0 || self.body_of[d] < 0 {
            return -1
        }
        let f = self.body_of[d]
        let no_inst = Vector<Int>()
        self.function_item(f, -1, &none, -1, &no_inst, -1, -1, -1, MONO_KEY_FUNCTION)
    }

    // THE ITEM FUNNEL for functions: the item of source function `source` at
    // owner arguments `args` (for `type_decl`'s parameters), its own type
    // arguments `inst` (for `func_decl`'s) and `self_type`, made when new.
    // `key` is MONO_KEY_FUNCTION for the ordinary item, MONO_KEY_TASK_ROOT
    // for a task root and MONO_KEY_THREAD for a thread-context item, so the
    // specializations of one function are separate items.
    // ENTRY POINTS:
    //     root_item
    //     role_item
    //     call_item_of
    //     closure_body_item
    func function_item(&var self, source: Int, type_decl: Int, args: &Vector<Int>, func_decl: Int, inst: &Vector<Int>,
                       self_type: Int, origin: Int, node: Int, key: Int) -> Int {
        var at = self.by_key.first(source, key)
        while at >= 0 {
            let k = self.by_key.value(at)
            if self.same_arguments(k, &args, &inst, self_type) {
                return k
            }
            at = self.by_key.following(at)
        }
        var j = 0
        while j < args.len() {
            if self.depth_exceeded(args[j], node, true) {
                return -1
            }
            j = j + 1
        }
        j = 0
        while j < inst.len() {
            if self.depth_exceeded(inst[j], node, true) {
                return -1
            }
            j = j + 1
        }
        let args_first = self.item_types.len()
        j = 0
        while j < args.len() {
            try! self.item_types.push(args[j])
            j = j + 1
        }
        let inst_first = self.item_types.len()
        j = 0
        while j < inst.len() {
            try! self.item_types.push(inst[j])
            j = j + 1
        }
        let k = self.items.len()
        let decl = self.dp.bc.mir.funcs[source].decl
        try! self.items.push(MonoItem(kind: MonoItemKind.Function, source: source, type_decl: type_decl,
                                      func_decl: func_decl, args_first: args_first, args_count: args.len(),
                                      inst_first: inst_first, inst_count: inst.len(), self_type: self_type,
                                      glue_type: -1, decl: decl, body: -1, origin: origin, origin_node: node))
        self.by_key.add(source, key, k)
        k
    }

    func same_arguments(&self, k: Int, args: &Vector<Int>, inst: &Vector<Int>, self_type: Int) -> Bool {
        let it = self.items[k]
        if it.args_count != args.len() || it.inst_count != inst.len() || it.self_type != self_type {
            return false
        }
        var j = 0
        while j < args.len() {
            if self.item_types[it.args_first + j] != args[j] {
                return false
            }
            j = j + 1
        }
        j = 0
        while j < inst.len() {
            if self.item_types[it.inst_first + j] != inst[j] {
                return false
            }
            j = j + 1
        }
        true
    }

    // Whether concrete argument `t` nests past the depth limit: polymorphic
    // recursion grows a type without bound, and its ruled refusal before mono
    // is not built yet (SL-507). The first call `call` meets at is kept, and
    // the first drop or copy otherwise, for the one refusal `report_depth`
    // makes: one growing chain meets the limit at every item it reaches.
    func depth_exceeded(&var self, t: Int, node: Int, call: Bool) -> Bool {
        if self.dp.bc.mir.tc.nesting_depth(t) <= MONO_DEPTH_LIMIT {
            return false
        }
        if call && self.depth_call < 0 {
            self.depth_call = node
        } else if not call && self.depth_glue < 0 {
            self.depth_glue = node
        }
        true
    }

    // The depth limit's one refusal: at the first call that met it, else at
    // the first drop or copy.
    func report_depth(&var self) {
        var node = self.depth_call
        var what = "this call instantiates"
        if node < 0 {
            node = self.depth_glue
            what = "this value has"
        }
        if node < 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(" a type nested more than ")
        try! msg.append(MONO_DEPTH_LIMIT)
        try! msg.append(" deep: a generic that instantiates itself at a growing type has no finite set of instances (polymorphic recursion, SL-507)")
        self.refuse(node, "mono.depth", msg.build())
    }

    // Type `t` with item `k`'s concrete arguments in place of its parameters.
    public func concrete_type(&var self, k: Int, t: Int) -> Int {
        let out = self.substituted(k, t)
        self.refuse_narrow_atomics(k, out)
        out
    }

    // `concrete_type` without its refusal, for a type that only answers a
    // question about item `k` and is no position of its body.
    func substituted(&var self, k: Int, t: Int) -> Int {
        if t < 0 || not self.dp.bc.mir.tc.mentions_param(t) {
            return t
        }
        let it = self.items[k]
        var out = t
        if it.type_decl >= 0 || it.self_type >= 0 {
            var args = Vector<Int>()
            var j = 0
            while j < it.args_count {
                try! args.push(self.item_types[it.args_first + j])
                j = j + 1
            }
            var s = TcSubst(owner: it.type_decl, args: move args)
            s.self_type = it.self_type
            out = self.dp.bc.mir.tc.subst(out, &s)
        }
        if it.func_decl >= 0 && it.inst_count > 0 {
            var inst = Vector<Int>()
            var j = 0
            while j < it.inst_count {
                try! inst.push(self.item_types[it.inst_first + j])
                j = j + 1
            }
            let s = TcSubst(owner: it.func_decl, args: move inst)
            out = self.dp.bc.mir.tc.subst(out, &s)
        }
        out
    }

    func instantiate(&var self, k: Int) {
        let it = self.items[k]
        match it.kind {
            case Function -> {
                if not self.dp.elaborated[it.source] {
                    try! self.problems.push("an item's source function was not elaborated")
                    return
                }
                let f = self.copy_function(k)
                var done = self.items[k]
                done.body = f
                self.items[k] = done
                self.refuse_relocations(k)
                // A task root's descriptor destroys a result nobody takes,
                // which no statement of any body drops.
                if self.is_task_root(k) {
                    let result = self.dp.bc.mir.locals[self.dp.bc.mir.funcs[f].local_first].ty
                    self.need_drop(k, result, it.origin_node)
                }
            },
            case DropGlue -> {
                if self.dp.bc.mir.tc.dispatched_existential(it.glue_type) >= 0 {
                    self.erased_box_glue(k)
                } else {
                    self.build_drop_glue(k)
                }
            },
            case CopyGlue -> self.build_copy_glue(k),
            case MemberGlue -> self.build_member_glue(k),
            case Extern -> {}
        }
        let body = self.items[k].body
        if body >= 0 {
            self.resolve_function(k, body)
        }
    }

    // `NoMove` at an instantiation (SL-662): the first move out of a place
    // that typecheck recorded in a generic body (`check_relocation`) whose
    // type item `k`'s arguments make `NoMove` is refused, once for the
    // instantiation. A declaration's moves are judged once per set of
    // arguments, however many of its functions (its body, its closures, an
    // accessor's halves) are items.
    func refuse_relocations(&var self, k: Int) {
        let it = self.items[k]
        if it.decl < 0 || not tc_contains(&self.dp.bc.mir.tc.relocation_decls, it.decl) || self.relocations_judged(k) {
            return
        }
        self.by_key.add(it.decl, MONO_KEY_RELOCATIONS, k)
        var j = 0
        while j < self.dp.bc.mir.tc.relocations.len() {
            if self.dp.bc.mir.tc.relocation_decls[j] == it.decl {
                let written = self.dp.bc.mir.tc.relocation_types[j]
                let t = self.concrete_type(k, written)
                if self.dp.bc.mir.tc.is_no_move(t) {
                    let at = self.dp.bc.mir.tc.relocations[j]
                    let place = self.dp.bc.mir.tc.relocation_places[j]
                    let m = self.dp.bc.mir.tc.node_module(at)
                    let instance = self.item_name(k)
                    let how = self.dp.bc.mir.tc.relocation_hows[j]
                    let msg = self.dp.bc.mir.tc.relocation_text(m, place, t, how, instance)
                    self.refuse(at, "transfer.no-move", msg)
                    return
                }
            }
            j = j + 1
        }
    }

    // Whether an item of `k`'s declaration at `k`'s arguments has had its
    // moves judged.
    func relocations_judged(&self, k: Int) -> Bool {
        let it = self.items[k]
        var args = Vector<Int>()
        var j = 0
        while j < it.args_count {
            try! args.push(self.item_types[it.args_first + j])
            j = j + 1
        }
        var inst = Vector<Int>()
        j = 0
        while j < it.inst_count {
            try! inst.push(self.item_types[it.inst_first + j])
            j = j + 1
        }
        var at = self.by_key.first(it.decl, MONO_KEY_RELOCATIONS)
        while at >= 0 {
            let judged = self.by_key.value(at)
            if self.same_arguments(judged, &args, &inst, it.self_type) {
                return true
            }
            at = self.by_key.following(at)
        }
        false
    }

    // The atomic role's width rule at an instantiation (SL:open-questions
    // D38): an `Atomic<X>` at an `X` other than `Int` that item `k`'s
    // arguments put in concrete type `t`, and that no position typecheck saw
    // carried, is refused once, where the item was reached.
    func refuse_narrow_atomics(&var self, k: Int, t: Int) {
        var j = 0
        while j < self.dp.bc.mir.tc.narrow_atomics.len() {
            let narrow = self.dp.bc.mir.tc.narrow_atomics[j]
            if not self.dp.bc.mir.tc.narrow_reported[j] && self.dp.bc.mir.tc.type_holds(t, narrow) {
                self.dp.bc.mir.tc.narrow_reported[j] = true
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.dp.bc.mir.tc.type_text(narrow))
                try! msg.append("` is not an atomic this compiler lowers: v1 atomics are `Atomic<Int>` only")
                let site = self.items[k].origin_node
                self.refuse(site, "atomic.width", msg.build())
            }
            j = j + 1
        }
    }

    // THE GLUE FUNNEL: the drop glue of type `t` (`kind` MONO_KEY_DROP) or its
    // copy glue (MONO_KEY_COPY), made when new; -1 when refused.
    // ENTRY POINTS:
    //     need_drop
    //     need_operand
    //     need_builtin_copy
    //     glued
    public func glue_of(&var self, t: Int, kind: Int, origin: Int, node: Int) -> Int {
        let found = self.glue_item(t, kind)
        if found >= 0 {
            return found
        }
        if self.depth_exceeded(t, node, false) {
            return -1
        }
        var item_kind = MonoItemKind.DropGlue
        if kind == MONO_KEY_COPY {
            item_kind = MonoItemKind.CopyGlue
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: item_kind, source: -1, type_decl: -1, func_decl: -1, args_first: first,
                                      args_count: 0, inst_first: first, inst_count: 0, self_type: -1, glue_type: t,
                                      decl: -1, body: -1, origin: origin, origin_node: node))
        self.by_key.add(t, kind, k)
        k
    }

    // A drop of type `t` in item `k`: its glue, unless the type owns nothing.
    // A function value owns nothing in this slice: a closure capturing an
    // owning value is refused where it is built.
    func need_drop(&var self, k: Int, t: Int, node: Int) {
        if not self.dp.bc.mir.owns(t) || self.dp.bc.mir.tc.kind_of(t) == TcKind.Func {
            return
        }
        let _ = self.glue_of(t, MONO_KEY_DROP, k, node)
    }

    // An operand of item `k`: a copy of a type that is not the bits alone
    // runs that type's copy glue.
    func need_operand(&var self, k: Int, o: Int, node: Int) {
        if o < 0 {
            return
        }
        let info = self.dp.bc.mir.operands[o]
        if info.kind != MirOperandKind.Copy || mono_copies_bitwise(&var self.dp.bc.mir.tc, info.ty) {
            return
        }
        let _ = self.glue_of(info.ty, MONO_KEY_COPY, k, node)
    }

    // A spelled `.copy()` no declaration writes, in item `k`: a copy of its
    // receiver's referent, so that type's copy glue unless the copy is the
    // bits alone. The receiver's type is the call's own operand's, concrete
    // in the item where the call's owner is still the generic one.
    func need_builtin_copy(&var self, k: Int, info: &MirCall) {
        let o = self.dp.bc.mir.lists[info.arg_first]
        let receiver = self.dp.bc.mir.operands[o].ty
        let t = self.dp.bc.mir.tc.referent(receiver)
        if mono_copies_bitwise(&var self.dp.bc.mir.tc, t) {
            return
        }
        let _ = self.glue_of(t, MONO_KEY_COPY, k, info.node)
    }
}

// The copy: a concrete function appended after every generic one, its
// locals, blocks and statements numbered as its source's, every type
// substituted.
extension MonoProgram {
    func copy_function(&var self, k: Int) -> Int {
        let it = self.items[k]
        let src = self.dp.bc.mir.funcs[it.source]
        let local_first = self.dp.bc.mir.locals.len()
        var j = 0
        while j < src.local_count {
            var l = self.dp.bc.mir.locals[src.local_first + j]
            l.ty = self.concrete_type(k, l.ty)
            try! self.dp.bc.mir.locals.push(l)
            j = j + 1
        }
        let window_first = self.dp.bc.mir.windows.len()
        j = 0
        while j < src.window_count {
            let w = self.dp.bc.mir.windows[src.window_first + j]
            try! self.dp.bc.mir.windows.push(w)
            j = j + 1
        }
        let block_first = self.dp.bc.mir.blocks.len()
        j = 0
        while j < src.block_count {
            let b = self.dp.bc.mir.blocks[src.block_first + j]
            let copied = self.copy_block(k, &b)
            try! self.dp.bc.mir.blocks.push(copied)
            j = j + 1
        }
        let f = self.dp.bc.mir.funcs.len()
        try! self.dp.bc.mir.funcs.push(MirFunc(module: src.module, kind: src.kind, decl: src.decl, root: src.root,
                                               param: src.param, parent: src.parent, ordinal: src.ordinal,
                                               local_first: local_first, local_count: src.local_count,
                                               block_first: block_first, block_count: src.block_count,
                                               param_count: src.param_count, window_first: window_first,
                                               window_count: src.window_count, owner: src.owner, refused: false,
                                               order: src.order, record_first: src.record_first,
                                               record_count: src.record_count,
                                               record_flags_first: src.record_flags_first,
                                               carried_first: src.carried_first, carried_count: src.carried_count))
        f
    }

    func copy_block(&var self, k: Int, b: &MirBlock) -> MirBlock {
        var out = b
        out.first = -1
        out.last = -1
        var s = b.first
        while s >= 0 {
            let stmt = self.dp.bc.mir.stmts[s]
            let place = self.copy_place(k, stmt.place)
            var rvalue = -1
            if stmt.rvalue >= 0 {
                rvalue = self.copy_rvalue(k, stmt.rvalue)
            }
            let at = self.dp.bc.mir.stmts.len()
            try! self.dp.bc.mir.stmts.push(MirStmt(kind: stmt.kind, place: place, rvalue: rvalue, yields: stmt.yields,
                                                   next: -1, node: stmt.node, closing: stmt.closing))
            if out.first < 0 {
                out.first = at
            } else {
                var prev = self.dp.bc.mir.stmts[out.last]
                prev.next = at
                self.dp.bc.mir.stmts[out.last] = prev
            }
            out.last = at
            s = stmt.next
        }
        out.operand = self.copy_operand(k, b.operand)
        out.place = self.copy_place(k, b.place)
        if b.arm_count > 0 {
            let arm_first = self.dp.bc.mir.arms.len()
            var j = 0
            while j < b.arm_count {
                let arm = self.dp.bc.mir.arms[b.arm_first + j]
                try! self.dp.bc.mir.arms.push(arm)
                j = j + 1
            }
            out.arm_first = arm_first
        }
        if b.call >= 0 {
            out.call = self.copy_call(k, b.call)
        }
        out
    }

    func copy_place(&var self, k: Int, p: Int) -> Int {
        if p < 0 {
            return -1
        }
        let info = self.dp.bc.mir.places[p]
        let first = self.dp.bc.mir.projs.len()
        var j = 0
        while j < info.count {
            var step = self.dp.bc.mir.projs[info.first + j]
            step.ty = self.concrete_type(k, step.ty)
            try! self.dp.bc.mir.projs.push(step)
            j = j + 1
        }
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.places.len()
        try! self.dp.bc.mir.places.push(MirPlace(local: info.local, static_decl: info.static_decl, first: first,
                                                 count: info.count, ty: ty))
        at
    }

    func copy_operand(&var self, k: Int, o: Int) -> Int {
        if o < 0 {
            return -1
        }
        let info = self.dp.bc.mir.operands[o]
        let place = self.copy_place(k, info.place)
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.operands.len()
        try! self.dp.bc.mir.operands.push(MirOperand(kind: info.kind, place: place, ty: ty,
                                                     const_kind: info.const_kind, text: info.text))
        at
    }

    // Operands `first .. first + count` of the lists, copied into a new run.
    func copy_list(&var self, k: Int, first: Int, count: Int) -> Int {
        var copied = Vector<Int>()
        var j = 0
        while j < count {
            let o = self.dp.bc.mir.lists[first + j]
            try! copied.push(self.copy_operand(k, o))
            j = j + 1
        }
        let at = self.dp.bc.mir.lists.len()
        j = 0
        while j < copied.len() {
            try! self.dp.bc.mir.lists.push(copied[j])
            j = j + 1
        }
        at
    }

    // Whether call `info`, copied into thread-context item `k`, is a plain
    // call there though its source marks it a suspension point: one that
    // does not suspend at `k`'s arguments, or suspends there only by what
    // thread context runs plainly, a `blocking` extern or a pair's default,
    // made in a helper whose MIR its cooperative callers share
    // (`thread_plain_call`). A call through a bound is `When` in that MIR,
    // and its instance answers it. A plain call is one `callee_key` keys, so
    // a pair it reaches runs its twin even when the default never suspends.
    func thread_plain_copy(&var self, k: Int, info: &MirCall) -> Bool {
        if info.suspend == MirSuspend.Never || not self.is_thread_item(k) {
            return false
        }
        var acc = self.instance_effect(k, &info)
        not acc.suspends || self.dp.bc.mir.thread_plain_call(true, &acc)
    }

    // What call `info`, in item `k`'s body, adds at `k`'s arguments:
    // typecheck's evaluation at the call's source, each condition it keeps
    // over the source's own type parameters answered at the type `k` puts
    // there. A generic's summary before instantiation says only "when the
    // bound's method does", which no key may be chosen from (SL-776).
    func instance_effect(&var self, k: Int, info: &MirCall) -> TcAcc {
        let source = self.items[k].source
        let owner = self.dp.bc.mir.funcs[source].owner
        var acc = TcAcc(owner: owner, unit: -1)
        let node = info.node
        if node < 0 || self.dp.bc.mir.tc.call_at[node] < 0 {
            return move acc
        }
        self.dp.bc.mir.call_effect(node, &info, &var acc)
        var j = 0
        while j < acc.suspend_atoms.len() {
            let a = acc.suspend_atoms[j]
            j = j + 1
            let t = self.substituted(k, a.ty)
            var at = TcAcc(owner: -1, unit: -1)
            self.dp.bc.mir.tc.eval_condition(t, a.req, node, true, &var at)
            if at.suspends {
                acc.suspends = true
            }
            acc.causes = acc.causes | at.causes
            acc.thread_causes = acc.thread_causes | at.thread_causes
        }
        move acc
    }

    func copy_rvalue(&var self, k: Int, r: Int) -> Int {
        let info = self.dp.bc.mir.rvalues[r]
        let first = self.copy_list(k, info.first, info.count)
        let place = self.copy_place(k, info.place)
        let flag = self.copy_place(k, info.flag)
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.rvalues.len()
        try! self.dp.bc.mir.rvalues.push(MirRvalue(kind: info.kind, ty: ty, op: info.op, exclusive: info.exclusive,
                                                   place: place, first: first, count: info.count,
                                                   aggregate: info.aggregate, decl: info.decl, flag: flag))
        at
    }

    func copy_call(&var self, k: Int, c: Int) -> Int {
        var info = self.dp.bc.mir.calls[c]
        if self.thread_plain_copy(k, &info) {
            info.suspend = MirSuspend.Never
        }
        let args = self.copy_list(k, info.arg_first, info.arg_count)
        let callee = self.copy_operand(k, info.callee)
        let dest = self.copy_place(k, info.dest)
        var inst = Vector<Int>()
        var j = 0
        while j < info.inst_count {
            let t = self.dp.bc.mir.types[info.inst_first + j]
            try! inst.push(self.concrete_type(k, t))
            j = j + 1
        }
        let inst_first = self.dp.bc.mir.types.len()
        j = 0
        while j < inst.len() {
            try! self.dp.bc.mir.types.push(inst[j])
            j = j + 1
        }
        info.arg_first = args
        info.callee = callee
        info.dest = dest
        info.inst_first = inst_first
        info.owner = self.concrete_type(k, info.owner)
        let at = self.dp.bc.mir.calls.len()
        try! self.dp.bc.mir.calls.push(info)
        at
    }
}

// Resolution: what each concrete call, closure, drop and copy reaches.
extension MonoProgram {
    func resolve_function(&var self, k: Int, f: Int) {
        let info = self.dp.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.dp.bc.mir.blocks[info.block_first + b]
            var s = block.first
            while s >= 0 {
                let stmt = self.dp.bc.mir.stmts[s]
                self.resolve_stmt(k, &stmt)
                s = stmt.next
            }
            if block.term == MirTermKind.Call {
                self.resolve_call(k, block.call)
            } else if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Bool {
                self.need_operand(k, block.operand, block.term_node)
            }
            b = b + 1
        }
    }

    func resolve_stmt(&var self, k: Int, stmt: &MirStmt) {
        if stmt.kind == MirStmtKind.Drop {
            let t = self.dp.bc.mir.places[stmt.place].ty
            self.need_drop(k, t, stmt.node)
            return
        }
        if stmt.kind != MirStmtKind.Assign {
            return
        }
        let rv = self.dp.bc.mir.rvalues[stmt.rvalue]
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            self.need_operand(k, o, stmt.node)
            j = j + 1
        }
        if rv.kind == MirRvalueKind.Aggregate && rv.aggregate == MirAggregate.Closure {
            self.resolve_closure(k, stmt.rvalue, stmt.node)
        }
        if rv.kind == MirRvalueKind.Aggregate && mono_collection_literal(rv.aggregate) {
            self.resolve_collection_literal(k, stmt.rvalue, stmt.node)
        }
        if rv.kind == MirRvalueKind.Interpolate {
            self.resolve_interpolation(k, &rv, stmt.node)
        }
        if rv.kind == MirRvalueKind.Erase {
            self.resolve_erasure(k, stmt.rvalue, stmt.node)
        }
        if rv.kind == MirRvalueKind.Binary && rv.count == 2 {
            self.resolve_string_comparison(k, &rv, stmt.node)
        }
    }

    // A builtin comparison of Strings compares their bytes through the String
    // layer: `==` and `!=` through the equality role, an ordering through the
    // ordering role. Each role is an item made at the first comparison that
    // needs it.
    func resolve_string_comparison(&var self, k: Int, rv: &MirRvalue, node: Int) {
        let a = self.dp.bc.mir.lists[rv.first]
        let b = self.dp.bc.mir.lists[rv.first + 1]
        if not self.string_operand(a) && not self.string_operand(b) {
            return
        }
        let op = self.dp.bc.mir.tc.name_text(rv.op)
        if op.equals("==") || op.equals("!=") {
            if self.equals_item < 0 {
                let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringEqualsFunction)
                self.equals_item = self.role_item(d, k, node)
            }
        } else if op.equals("<") || op.equals("<=") || op.equals(">") || op.equals(">=") {
            if self.compare_item < 0 {
                let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringCompareFunction)
                self.compare_item = self.role_item(d, k, node)
            }
        }
    }

    // The item of non-generic lang function `d`, first reached from item `k`
    // at `node`, or -1 when the std root declares none.
    func role_item(&var self, d: Int, k: Int, node: Int) -> Int {
        if d < 0 || self.body_of[d] < 0 {
            return -1
        }
        let source = self.body_of[d]
        let none = Vector<Int>()
        let no_inst = Vector<Int>()
        self.function_item(source, -1, &none, -1, &no_inst, -1, k, node, MONO_KEY_FUNCTION)
    }

    // A closure construction's body is an item under its parent's arguments.
    // A capture that owns something would need the environment's release when
    // the closure value drops, which this slice does not make, so it is
    // refused rather than leaked. The backend builds every environment in the
    // frame that creates the closure, so an escaping closure that captures
    // anything is refused too: its environment would be read after that frame
    // is gone (SL-525).
    // A `Thread.spawn` brace's environment is neither: its site moves it to
    // the heap, and its body takes each capture as a parameter
    // (`resolve_thread_spawn`).
    func resolve_closure(&var self, k: Int, r: Int, node: Int) {
        let rv = self.dp.bc.mir.rvalues[r]
        let at = self.dp.bc.mir.func_of.first(rv.decl, 0)
        if at < 0 {
            try! self.problems.push("a closure construction names no lowered body")
            return
        }
        let body = self.dp.bc.mir.func_of.value(at)
        let threaded = self.dp.bc.mir.thread_body(body)
        // The captures, at this item's types: the construction's operands,
        // or the elements of the environment its one operand refers to
        // (`closure_environment`).
        var captured = Vector<Int>()
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            try! captured.push(self.dp.bc.mir.operands[o].ty)
            j = j + 1
        }
        if self.dp.bc.mir.closure_environment(rv.decl) && captured.len() == 1 {
            let env_tuple = self.dp.bc.mir.tc.referent(captured[0])
            captured = Vector<Int>()
            j = 0
            while env_tuple >= 0 && j < self.dp.bc.mir.tc.types.ty(env_tuple).count {
                try! captured.push(self.dp.bc.mir.tc.types.arg(env_tuple, j))
                j = j + 1
            }
        }
        j = 0
        while j < captured.len() && not threaded {
            let t = captured[j]
            if self.dp.bc.mir.owns(t) {
                self.refuse(node, "mono.not-yet", "a closure capturing a value that owns something is not in the backend slice yet")
                return
            }
            j = j + 1
        }
        if rv.count > 0 && not threaded && self.closure_escapes(rv.decl) {
            self.refuse(node, "mono.not-yet", "an escaping closure that captures a value is not in the backend slice yet: its environment would live in the frame that builds it, and heap environments are unbuilt (SL-525)")
            return
        }
        let item = self.closure_body_item(k, body, node)
        self.set_closure_item(r, item)
    }

    // The item of closure body `body`, written in item `k`'s function, under
    // `k`'s arguments.
    func closure_body_item(&var self, k: Int, body: Int, node: Int) -> Int {
        let it = self.items[k]
        var args = Vector<Int>()
        var j = 0
        while j < it.args_count {
            try! args.push(self.item_types[it.args_first + j])
            j = j + 1
        }
        var inst = Vector<Int>()
        j = 0
        while j < it.inst_count {
            try! inst.push(self.item_types[it.inst_first + j])
            j = j + 1
        }
        self.function_item(body, it.type_decl, &args, it.func_decl, &inst, it.self_type, k, node, MONO_KEY_FUNCTION)
    }

    // Whether the closure written at node `e` escapes, as typecheck's
    // `closure_escapes` decided it. That decision is by elimination: the one
    // non-escaping position is a direct argument whose parameter is a
    // function type that does not say `escaping`, so a field, a payload, an
    // element, a return, a binding or a type argument escapes without a rule
    // of its own. A closure with no capture table is taken to escape.
    func closure_escapes(&self, e: Int) -> Bool {
        let at = self.dp.bc.mir.tc.closure_index.first(e, 0)
        if at < 0 {
            return true
        }
        let ordinal = self.dp.bc.mir.tc.closure_index.value(at)
        ordinal >= self.dp.bc.mir.tc.closure_escaping.len() || self.dp.bc.mir.tc.closure_escaping[ordinal]
    }

    func resolve_call(&var self, k: Int, c: Int) {
        let info = self.dp.bc.mir.calls[c]
        var a = 0
        while a < info.arg_count {
            let o = self.dp.bc.mir.lists[info.arg_first + a]
            self.need_operand(k, o, info.node)
            a = a + 1
        }
        match info.kind {
            case Builtin -> {
                let name = self.dp.bc.mir.tc.res.name_text(info.spelling)
                if not mono_builtin_supported(name) {
                    var msg = StringBuilder()
                    try! msg.append("the builtin `")
                    try! msg.append(name)
                    try! msg.append("` is not in the backend slice yet")
                    self.refuse(info.node, "mono.not-yet", msg.build())
                    return
                }
                if name.equals("init") {
                    self.check_empty_construction(c)
                    return
                }
                if name.equals("copy") {
                    self.need_builtin_copy(k, &info)
                    return
                }
                if name.equals("Thread.spawn") {
                    self.resolve_thread_spawn(k, c, &info)
                    return
                }
                self.check_format_arguments(k, c, &name)
            },
            case Value -> self.need_operand(k, info.callee, info.node),
            case Lend -> try! self.problems.push("a lend outside an accessor's split reached mono"),
            case Function -> {
                let decl = self.dp.bc.mir.tc.res.decls[info.target]
                if decl.kind == ResDeclKind.Extern {
                    let item = self.extern_item(k, info.target)
                    self.set_call_item(c, item)
                    // A thread's `blocking` call is plain, and offloads nothing.
                    if info.suspend != MirSuspend.Never {
                        self.resolve_offload(k, info.target, info.node)
                    }
                    return
                }
                if decl.kind == ResDeclKind.Requirement && self.dp.bc.mir.tc.kind_of(info.owner) == TcKind.Any {
                    self.resolve_dispatch(k, c, &info)
                    return
                }
                if self.unruled_ordering(&info) {
                    return
                }
                var target = MonoTarget(decl: info.target, self_type: -1, item: -1)
                if decl.kind == ResDeclKind.Requirement {
                    target = self.resolve_requirement(info.target, info.owner, k, info.node)
                    if target.decl < 0 {
                        return
                    }
                    if target.item >= 0 {
                        self.set_call_item(c, target.item)
                        return
                    }
                }
                let chosen = self.selected_callee(k, target.decl)
                let body = self.body_of[chosen]
                let key = if chosen != target.decl { MONO_KEY_FUNCTION } else { self.callee_key(k, &info) }
                let item = self.call_item_of(k, body, chosen, target.self_type, &info, key)
                self.set_call_item(c, item)
                self.resolve_park(k, target.decl, info.node)
            },
            case Default -> {
                let at = self.defaults.first(info.target, info.param)
                if at < 0 {
                    self.refuse(info.node, "mono.not-yet", "a default value whose function was not lowered")
                    return
                }
                let body = self.defaults.value(at)
                let decl = info.target
                let key = self.callee_key(k, &info)
                let item = self.call_item_of(k, body, decl, -1, &info, key)
                self.set_call_item(c, item)
            },
            case WindowOpen -> self.resolve_window(k, c, &info),
            case WindowClose -> self.resolve_window(k, c, &info),
            case Spawn -> self.resolve_spawn(k, c, &info),
            case Drive -> self.resolve_drive(k, c, &info)
        }
    }

    // THE THREAD KEY FUNNEL: the key of the item call `info` in item `k`
    // reaches. A plain call from a thread-context item to a body that, at
    // the call's instance, suspends only by `blocking`, or reaches a pair,
    // reaches that body's thread-context item, where its own `blocking`
    // calls are plain too and its pairs run their twins; the ordinary item
    // is a frame there, which a plain call cannot run, or runs the pairs'
    // defaults. Every other call reaches the ordinary item.
    // ENTRY POINTS:
    //     resolve_call
    //     resolve_window
    func callee_key(&var self, k: Int, info: &MirCall) -> Int {
        if info.suspend != MirSuspend.Never || not self.is_thread_item(k) {
            return MONO_KEY_FUNCTION
        }
        var acc = self.instance_effect(k, &info)
        let reached = acc.thread_causes & (TC_CAUSE_BLOCKING | TC_CAUSE_PAIRED)
        if reached != 0 && tc_thread_struck(acc.thread_causes) == 0 {
            return MONO_KEY_THREAD
        }
        MONO_KEY_FUNCTION
    }

    // THE PAIR SELECTION: the declaration whose body a call of `decl` in
    // item `k` runs: a pair's `blocking` twin in a thread-context item, and
    // `decl` itself in every other (spec, Pairs). A twin's own body is thread
    // context wherever it is reached, so its item is the ordinary one.
    // ENTRY POINTS:
    //     resolve_call
    //     resolve_window
    func selected_callee(&self, k: Int, decl: Int) -> Int {
        let twin = self.dp.bc.mir.tc.blocking_twin_of(decl)
        if twin >= 0 && self.is_thread_item(k) {
            return twin
        }
        decl
    }

    // The half of accessor `twin` that does what `half`, one of its pair's
    // default's halves, does; -1 when it has none.
    func twin_half(&self, half: Int, twin: Int) -> Int {
        let kind = self.dp.bc.mir.funcs[half].kind
        var f = 0
        while f < self.dp.bc.mir.funcs.len() {
            let info = self.dp.bc.mir.funcs[f]
            if info.decl == twin && info.kind == kind {
                return f
            }
            f = f + 1
        }
        return -1
    }

    // A `Thread.spawn` site (SL-765) reaches what its lowering calls: its
    // brace's body, which the site's trampoline runs on the new thread;
    // `Thread<T>`'s `__saw_control_block`, `__saw_started` and `__saw_exit` at
    // the site's handle type; the live-thread count's raise; and the drop of
    // the brace's environment, which a refused spawn runs, the body never
    // having taken its captures.
    func resolve_thread_spawn(&var self, k: Int, c: Int, info: &MirCall) {
        let node = info.node
        if info.dest < 0 || info.arg_count != 1 {
            try! self.problems.push("a `Thread.spawn` site has no destination or not one brace")
            return
        }
        let brace = self.thread_brace(node)
        let at = if brace >= 0 { self.dp.bc.mir.func_of.first(brace, 0) } else { -1 }
        if at < 0 {
            try! self.problems.push("a `Thread.spawn` site names no lowered brace")
            return
        }
        let source = self.dp.bc.mir.func_of.value(at)
        let body = self.closure_body_item(k, source, node)
        let result = self.dp.bc.mir.places[info.dest].ty
        let handle = self.dp.bc.mir.tc.arg_of(result, 0)
        let d = self.dp.bc.mir.tc.nominal_decl(handle)
        let block = self.thread_member(k, d, handle, "__saw_control_block", node)
        let started = self.thread_member(k, d, handle, "__saw_started", node)
        let exit = self.thread_member(k, d, handle, "__saw_exit", node)
        let m = self.dp.bc.mir.tc.module_named("std.taskgroup")
        if self.thread_started_item < 0 {
            self.thread_started_item = self.exec_entry(k, m, "__saw_exec_thread_started", node, "a `Thread.spawn` site")
        }
        if body < 0 || block < 0 || started < 0 || exit < 0 {
            return
        }
        let env_local = self.dp.bc.mir.funcs[source].local_first + 1
        let written = self.dp.bc.mir.locals[env_local].ty
        let env = self.concrete_type(k, written)
        self.need_drop(k, env, node)
        self.set_thread_spawn(c, MonoThreadSpawn(body: body, block: block, started: started, exit: exit))
    }

    // The brace of the `Thread.spawn` form at node `e`, or -1.
    func thread_brace(&self, e: Int) -> Int {
        var j = 0
        while j < self.dp.bc.mir.tc.thread_forms.len() {
            if self.dp.bc.mir.tc.thread_forms[j] == e {
                return self.dp.bc.mir.tc.thread_braces[j]
            }
            j = j + 1
        }
        return -1
    }

    // The item of `Thread<T>`'s member `name` at concrete handle type
    // `handle`, declaration `d`; refused when std declares none.
    func thread_member(&var self, k: Int, d: Int, handle: Int, name: String, node: Int) -> Int {
        let member = self.named_member(d, name)
        if member < 0 {
            var msg = StringBuilder()
            try! msg.append("a `Thread.spawn` site whose handle type declares no `")
            try! msg.append(name)
            try! msg.append("`")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        self.member_item(k, member, handle, node)
    }

    // A window's open or close calls its accessor's half at the window's
    // instantiation; an accessor whose body this program does not lower has
    // no halves to call.
    func resolve_window(&var self, k: Int, c: Int, info: &MirCall) {
        if info.kind == MirCallKind.WindowClose && self.dp.bc.mir.closes_nothing(info.target) {
            return
        }
        if info.half < 0 {
            self.refuse(info.node, "mono.not-yet", "a borrow of an accessor whose body is not lowered")
            return
        }
        let chosen = self.selected_callee(k, info.target)
        if chosen != info.target {
            let twin = self.twin_half(info.half, chosen)
            if twin < 0 {
                self.refuse(info.node, "mono.not-yet", "a borrow of a pair's `blocking` accessor whose body is not lowered")
                return
            }
            let item = self.call_item_of(k, twin, chosen, -1, &info, MONO_KEY_FUNCTION)
            self.set_call_item(c, item)
            return
        }
        let half = info.half
        let decl = info.target
        let key = self.callee_key(k, &info)
        let item = self.call_item_of(k, half, decl, -1, &info, key)
        self.set_call_item(c, item)
    }

    // A spawn site reaches its task root, the specialization the task runs,
    // keyed apart from the root's ordinary item (SL:architecture §3.8): the
    // site is no call of the root, so it needs no ordinary item. It also
    // reaches what its lowering calls (SL:coroutines A7a): std's task box,
    // the background group and its close, and the handle type's
    // `__saw_spawn`, which the site's own handle type instantiates.
    func resolve_spawn(&var self, k: Int, c: Int, info: &MirCall) {
        let target = info.target
        let body = self.body_of[target]
        // Stage 0 workaround (SL:hazards S4): canonical: let root = self.call_item_of(k, body, info.target, -1, &info, MONO_KEY_TASK_ROOT)
        let root = self.call_item_of(k, body, target, -1, &info, MONO_KEY_TASK_ROOT)
        self.set_call_item(c, root)
        if root < 0 {
            return
        }
        let m = self.dp.bc.mir.tc.module_named("std.taskgroup")
        if self.spawn_box_item < 0 {
            self.spawn_box_item = self.spawn_entry(k, m, "__saw_exec_task_box", info.node)
        }
        if self.spawn_background_item < 0 {
            self.spawn_background_item = self.spawn_entry(k, m, "__saw_exec_background", info.node)
        }
        if self.spawn_close_item < 0 {
            self.spawn_close_item = self.spawn_entry(k, m, "__saw_exec_close_background", info.node)
        }
        if self.spawn_singleton < 0 {
            let provenance = self.dp.bc.mir.tc.top_decl(m, "TaskProvenance")
            let name = self.dp.bc.mir.tc.res.intern("Singleton")
            if provenance >= 0 {
                self.spawn_singleton = self.dp.bc.mir.tc.case_named(provenance, name)
            }
            if self.spawn_singleton < 0 {
                self.refuse(info.node, "mono.not-yet", "a spawn site under a std root that declares no `TaskProvenance.Singleton`")
            }
        }
        if info.dest < 0 {
            try! self.problems.push("a spawn site has no handle destination")
            return
        }
        let handle = self.dp.bc.mir.places[info.dest].ty
        let d = self.dp.bc.mir.tc.nominal_decl(handle)
        let minting = self.named_member(d, "__saw_spawn")
        if minting < 0 {
            self.refuse(info.node, "mono.not-yet", "a spawn site whose handle type declares no `__saw_spawn`")
            return
        }
        let item = self.member_item(k, minting, handle, info.node)
        self.set_spawn_handle_item(c, item)
    }

    // A drive site reaches its root's task root, as a spawn site does: a
    // driven root is framed and keeps its op-budget points whether or not it
    // suspends, as Stage 0's are (SL:coroutines A4b). It also reaches the std
    // driver its form's lowering calls.
    func resolve_drive(&var self, k: Int, c: Int, info: &MirCall) {
        let target = info.target
        let body = self.body_of[target]
        // Stage 0 workaround (SL:hazards S4): canonical: let root = self.call_item_of(k, body, info.target, -1, &info, MONO_KEY_TASK_ROOT)
        let root = self.call_item_of(k, body, target, -1, &info, MONO_KEY_TASK_ROOT)
        self.set_call_item(c, root)
        if root < 0 {
            return
        }
        let m = self.dp.bc.mir.tc.module_named("std.taskgroup")
        if info.drive == MirDriveForm.Steps {
            if self.drive_steps_item < 0 {
                self.drive_steps_item = self.exec_entry(k, m, "__saw_exec_drive_steps", info.node, "a drive site")
            }
        } else if self.drive_item < 0 {
            self.drive_item = self.exec_entry(k, m, "__saw_exec_drive", info.node, "a drive site")
        }
    }

    // A call of a park point, declaration `d`, reaches what its lowering
    // calls besides the park (SL:coroutines A3c): a timer park the deadline it
    // records, a descriptor park the reactor arm, and an offload park the arm,
    // its job's pipe and its park word. The other parks only record.
    func resolve_park(&var self, k: Int, d: Int, node: Int) {
        if d < 0 {
            return
        }
        let timer = d == self.dp.bc.mir.tc.res.lang_item(ResLang.ParkTimerFunction)
        let offload = d == self.dp.bc.mir.tc.res.lang_item(ResLang.ParkOffloadFunction)
        let fd = d == self.dp.bc.mir.tc.res.lang_item(ResLang.ParkFdFunction) || d == self.dp.bc.mir.tc.res.lang_item(ResLang.ParkFdUntilFunction)
        if not (timer || offload || fd) {
            return
        }
        let m = self.dp.bc.mir.tc.module_named("std.taskgroup")
        if timer && self.park_deadline_item < 0 {
            self.park_deadline_item = self.exec_entry(k, m, "__saw_exec_timer_deadline", node, "a timer park")
        }
        if (fd || offload) && self.park_register_item < 0 {
            self.park_register_item = self.exec_entry(k, m, "__saw_exec_io_register", node, "a descriptor park")
        }
        if offload && self.park_pipe_item < 0 {
            self.park_pipe_item = self.exec_entry(k, m, "__saw_exec_offload_pipe", node, "an offload park")
        }
        if offload {
            self.exec_entry(k, m, "__saw_exec_offload_park", node, "an offload park")
        }
    }

    // A call of a `blocking` extern, declaration `d`, reaches what its
    // offload calls (SL:coroutines A14a): the job's completion check, and the
    // offload park's word, pipe and reactor arm.
    func resolve_offload(&var self, k: Int, d: Int, node: Int) {
        if d < 0 || d >= self.dp.bc.mir.tc.sigs.len() || (self.dp.bc.mir.tc.sigs[d].flags & TC_FLAG_BLOCKING) == 0 {
            return
        }
        let m = self.dp.bc.mir.tc.module_named("std.taskgroup")
        if self.park_register_item < 0 {
            self.park_register_item = self.exec_entry(k, m, "__saw_exec_io_register", node, "an offload")
        }
        if self.park_pipe_item < 0 {
            self.park_pipe_item = self.exec_entry(k, m, "__saw_exec_offload_pipe", node, "an offload")
        }
        // Coroutine lowering finds the check's item and the park word's by
        // their declarations; each item is made once, however many calls
        // reach it.
        self.exec_entry(k, m, "__saw_exec_offload_done", node, "an offload")
        self.exec_entry(k, m, "__saw_exec_offload_park", node, "an offload")
    }

    func spawn_entry(&var self, k: Int, m: Int, name: String, node: Int) -> Int {
        self.exec_entry(k, m, name, node, "a spawn site")
    }

    // The item of top-level function `name` of module `m`, which the
    // lowering of `site` calls, first reached from item `k` at `node`;
    // refused when the std root declares none.
    func exec_entry(&var self, k: Int, m: Int, name: String, node: Int, site: String) -> Int {
        let d = self.dp.bc.mir.tc.top_decl(m, name)
        let item = self.role_item(d, k, node)
        if item < 0 {
            var msg = StringBuilder()
            try! msg.append(site)
            try! msg.append(" under a std root that declares no `")
            try! msg.append(name)
            try! msg.append("`")
            self.refuse(node, "mono.not-yet", msg.build())
        }
        item
    }

    // The member named `name` of type declaration `d`, or -1.
    func named_member(&self, d: Int, name: String) -> Int {
        if d < 0 || d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return -1
        }
        let id = self.dp.bc.mir.tc.res.names.find(name)
        let first = self.dp.bc.mir.tc.member_first[d]
        let count = self.dp.bc.mir.tc.member_count[d]
        var j = first
        while j < first + count {
            let member = self.dp.bc.mir.tc.members[j]
            if id >= 0 && member.name == id {
                return member.decl
            }
            j = j + 1
        }
        return -1
    }

    // The item a call of declaration `decl`, whose body is `body`, reaches:
    // the receiver type's arguments for the parameters of the type an
    // extension method extends, the call's own type arguments for `decl`'s;
    // the item of `key`'s kind (`function_item`).
    func call_item_of(&var self, k: Int, body: Int, decl: Int, self_type: Int, info: &MirCall, key: Int) -> Int {
        if body < 0 || not self.dp.elaborated[body] {
            var msg = StringBuilder()
            try! msg.append("a call of `")
            try! msg.append(self.dp.bc.mir.tc.target_text(decl))
            try! msg.append("`, whose body this program does not lower, is not in the backend slice yet")
            self.refuse(info.node, "mono.not-yet", msg.build())
            return -1
        }
        let type_decl = self.type_decl_of(decl)
        var args = Vector<Int>()
        if type_decl >= 0 && info.owner >= 0 {
            let owner = self.dp.bc.mir.tc.types.ty(info.owner)
            if owner.kind == TcKind.Nominal && owner.decl == type_decl {
                var j = 0
                while j < owner.count {
                    try! args.push(self.dp.bc.mir.tc.types.arg(info.owner, j))
                    j = j + 1
                }
            }
        }
        if type_decl >= 0 && self.dp.bc.mir.tc.sigs[type_decl].generic_count != args.len() {
            self.refuse(info.node, "mono.not-yet", "a call whose receiver type does not name the extended type's arguments")
            return -1
        }
        var inst = Vector<Int>()
        var j = 0
        while j < info.inst_count {
            try! inst.push(self.dp.bc.mir.types[info.inst_first + j])
            j = j + 1
        }
        self.function_item(body, type_decl, &args, decl, &inst, self_type, k, info.node, key)
    }

    // THE UNRULED ORDERING: whether call `info`, a `compare` that MIR's
    // ordering mark says a generic `<=` or `>=` desugars to, is at a `Float`
    // instance, which is refused. Over a NaN, `compare` answers `Equal`, so
    // the desugaring would answer `true` where a concrete `nan <= 1.0` is
    // `false`, and which one is right is unruled (SL-722 Q3).
    // ENTRY POINTS:
    //     resolve_call
    func unruled_ordering(&var self, info: &MirCall) -> Bool {
        if info.ordering_operator < 0 || not self.dp.bc.mir.tc.is_float(info.owner) {
            return false
        }
        self.refuse(info.node, "mono.not-yet", "a generic `<=`/`>=` over Float waits for SL-722 Q3 (NaN's answer)")
        true
    }

    // The type declaration whose parameters a member's body names: the type
    // an extension extends, or -1 for a free function and a trait's default
    // body, which reads `Self` instead.
    func type_decl_of(&self, decl: Int) -> Int {
        let parent = self.dp.bc.mir.tc.res.decls[decl].parent
        if parent < 0 {
            return -1
        }
        if self.dp.bc.mir.tc.res.decls[parent].kind == ResDeclKind.Extension {
            return self.dp.bc.mir.tc.ext_target(parent)
        }
        return -1
    }

    // THE REQUIREMENT FUNNEL: requirement `req` called on concrete `owner`,
    // the member the owner's conformance writes, or the trait's default body
    // under `Self` = owner; a requirement met with neither, by a derivation or
    // by a builtin type's own conformance, is the glue that synthesizes it.
    // A bound is also met with no conformance at all (`met_without_conformance`),
    // so that requirement reaches `glued` too. `item` is -1 unless the answer
    // is glue.
    // ENTRY POINTS:
    //     resolve_call
    //     render_of
    //     fill_slot
    func resolve_requirement(&var self, req: Int, owner: Int, k: Int, node: Int) -> MonoTarget {
        let trait_decl = self.dp.bc.mir.tc.res.decls[req].parent
        let d = self.dp.bc.mir.tc.nominal_decl(owner)
        var c = 0
        while c < self.dp.bc.mir.tc.conformances.len() {
            let one = self.dp.bc.mir.tc.conformances[c]
            c = c + 1
            if d < 0 || one.type_decl != d || not self.dp.bc.mir.tc.trait_refines(one.trait_decl, trait_decl) {
                continue
            }
            var s = 0
            while s < one.status_count {
                let status = self.dp.bc.mir.tc.statuses[one.status_first + s]
                s = s + 1
                if status.requirement != req {
                    continue
                }
                if status.kind == TcStatusKind.Written {
                    return MonoTarget(decl: status.member, self_type: -1, item: -1)
                }
                if status.kind == TcStatusKind.Default {
                    return MonoTarget(decl: req, self_type: owner, item: -1)
                }
                if status.kind == TcStatusKind.Synthesized || status.kind == TcStatusKind.Implicit {
                    return self.glued(req, owner, k, node)
                }
            }
        }
        if d >= 0 && self.dp.bc.mir.tc.primitive_grants(d, trait_decl) {
            if (self.dp.bc.mir.tc.sigs[req].flags & TC_FLAG_DEFAULT_BODY) != 0 {
                return MonoTarget(decl: req, self_type: owner, item: -1)
            }
            return self.glued(req, owner, k, node)
        }
        if self.met_without_conformance(req, owner) {
            return self.glued(req, owner, k, node)
        }
        var msg = StringBuilder()
        try! msg.append("a call of `")
        try! msg.append(self.dp.bc.mir.tc.target_text(req))
        try! msg.append("` on `")
        try! msg.append(self.dp.bc.mir.tc.type_text(owner))
        try! msg.append("`, which no conformance of it meets, is not in the backend slice yet")
        self.refuse(node, "mono.not-yet", msg.build())
        MonoTarget(decl: -1, self_type: -1, item: -1)
    }

    // Whether `owner` meets the trait of requirement `req` with no
    // conformance written. A `copy()` bound through the Copy tier or a
    // composite's parts, when copy glue builds the type; an `equals`,
    // `compare` or `hash` bound through a tuple's, an Optional's or a fixed
    // array's parts, or automatically for a trivially copyable struct or enum
    // (spec, Equality and Hashing). The member glue table then says which of
    // these the spec grants.
    func met_without_conformance(&var self, req: Int, owner: Int) -> Bool {
        if self.copy_hook(req) {
            return self.copy_glue_builds(owner)
        }
        if not self.structural_hook(req) {
            return false
        }
        match self.glue_kind(owner) {
            case Tuple -> true,
            case Optional -> true,
            case Array -> true,
            case Struct -> self.dp.bc.mir.tc.is_trivial(owner),
            case Enum -> self.dp.bc.mir.tc.is_trivial(owner),
            case _ -> false
        }
    }

    // THE HOOK GLUE FUNNEL: which glue answers requirement `req` on `owner`,
    // as a call target, or a refused one when glue for it is not in the
    // slice. A `copy()` on a struct, an enum, a tuple or an array is its copy
    // glue: the one copy its silent, spelled and generic copies all run
    // (spec, The Copy Trait Family). Every other hook is member glue, whose
    // table (`member_refusal`) decides each kind's cells; an aggregate's
    // member glue calls its parts' hooks, which come back here through the
    // requirement funnel.
    // ENTRY POINTS:
    //     resolve_requirement
    func glued(&var self, req: Int, owner: Int, k: Int, node: Int) -> MonoTarget {
        var item = -1
        if self.copy_hook(req) && self.copy_glue_builds(owner) {
            item = self.glue_of(owner, MONO_KEY_COPY, k, node)
        } else {
            item = self.member_glue_of(req, owner, k, node)
        }
        if item < 0 {
            return MonoTarget(decl: -1, self_type: -1, item: -1)
        }
        MonoTarget(decl: req, self_type: -1, item: item)
    }

    // THE MEMBER GLUE FUNNEL: the glue that synthesizes requirement `req` for
    // concrete type `t`, made when new; -1 when refused. In the slice: the
    // cells the member glue table admits (`member_refusal` in glue.saw).
    // ENTRY POINTS:
    //     glued
    public func member_glue_of(&var self, req: Int, t: Int, origin: Int, node: Int) -> Int {
        var at = self.by_key.first(t, MONO_KEY_MEMBER)
        while at >= 0 {
            let found = self.by_key.value(at)
            if self.items[found].decl == req {
                return found
            }
            at = self.by_key.following(at)
        }
        let why = self.member_refusal(req, t)
        if why.len() > 0 {
            var msg = StringBuilder()
            try! msg.append("a synthesized `")
            try! msg.append(self.dp.bc.mir.tc.target_text(req))
            try! msg.append("` on `")
            try! msg.append(self.dp.bc.mir.tc.type_text(t))
            try! msg.append("` is not in the backend slice yet: ")
            try! msg.append(why)
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: MonoItemKind.MemberGlue, source: -1, type_decl: -1, func_decl: -1,
                                      args_first: first, args_count: 0, inst_first: first, inst_count: 0,
                                      self_type: -1, glue_type: t, decl: req, body: -1, origin: origin,
                                      origin_node: node))
        self.by_key.add(t, MONO_KEY_MEMBER, k)
        k
    }

    // `T()` on a type parameter, at a concrete `T`: in the slice, a fieldless
    // struct with no `init` of its own, whose value is nothing (an
    // allocator's).
    func check_empty_construction(&var self, c: Int) {
        let info = self.dp.bc.mir.calls[c]
        let d = self.dp.bc.mir.tc.nominal_decl(info.owner)
        let fieldless = d >= 0 && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Struct && target_struct_fields(&self.dp.bc.mir.tc, d).len() == 0
        if fieldless && not self.declares_init(d) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("constructing `")
        try! msg.append(self.dp.bc.mir.tc.type_text(info.owner))
        try! msg.append("` through a type parameter is not in the backend slice yet: only a fieldless struct with no `init`")
        self.refuse(info.node, "mono.not-yet", msg.build())
    }

    // Whether type declaration `d` has an `init` among its members.
    func declares_init(&self, d: Int) -> Bool {
        if d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return false
        }
        let first = self.dp.bc.mir.tc.member_first[d]
        var j = first
        while j < first + self.dp.bc.mir.tc.member_count[d] {
            let member = self.dp.bc.mir.tc.members[j]
            if self.dp.bc.mir.tc.res.decls[member.decl].kind == ResDeclKind.Init {
                return true
            }
            j = j + 1
        }
        false
    }

    // A format argument of `print`, `panic` or `assert`: an integer, a `Bool`
    // or a `String`, or a reference to one, the backend writes as it is; any
    // other value renders through its `Printable.format` into a fixed builder
    // over stack scratch (design 137).
    func check_format_arguments(&var self, k: Int, c: Int, name: &String) {
        let info = self.dp.bc.mir.calls[c]
        let printing = name.equals("print") || name.equals("panic") || name.equals("assert")
        if not printing {
            return
        }
        if name.equals("print") {
            self.prints = true
        }
        var a = 0
        while a < info.arg_count {
            let o = self.dp.bc.mir.lists[info.arg_first + a]
            let op = self.dp.bc.mir.operands[o]
            a = a + 1
            if op.kind == MirOperandKind.Const {
                continue
            }
            var t = op.ty
            let referent = self.dp.bc.mir.tc.referent(t)
            if referent >= 0 {
                t = referent
            }
            let direct = self.dp.bc.mir.tc.is_integer(t) || self.dp.bc.mir.tc.is_bool(t) || self.dp.bc.mir.tc.is_string(t)
            if not direct && not self.need_fixed_render(k, t, info.node) {
                return
            }
        }
    }

    // A value of type `t` rendered into a fixed builder over stack scratch:
    // the builder's fixed `init`, its `len()` and its drop, and `t`'s
    // rendering. False when one of them is refused.
    func need_fixed_render(&var self, k: Int, t: Int, node: Int) -> Bool {
        let builder = self.builder_type()
        if builder < 0 {
            self.refuse(node, "mono.not-yet", "a rendering with no builder role bound")
            return false
        }
        if self.builder_fixed_item < 0 {
            var labels = Vector<String>()
            try! labels.push("bytes")
            try! labels.push("capacity")
            self.builder_fixed_item = self.builder_item("init", &labels, k, node)
        }
        if self.builder_len_item < 0 {
            let none = Vector<String>()
            self.builder_len_item = self.builder_item("len", &none, k, node)
        }
        self.need_drop(k, builder, node)
        if self.builder_fixed_item < 0 || self.builder_len_item < 0 {
            return false
        }
        self.render_of(k, t, node) >= 0
    }

    // An interpolation builds a String through the growable builder: its
    // `init()`, each part's rendering, `build()`, and the builder's drop.
    func resolve_interpolation(&var self, k: Int, rv: &MirRvalue, node: Int) {
        let builder = self.builder_type()
        if builder < 0 {
            self.refuse(node, "mono.not-yet", "an interpolation with no builder role bound")
            return
        }
        let none = Vector<String>()
        if self.builder_new_item < 0 {
            self.builder_new_item = self.builder_item("init", &none, k, node)
        }
        if self.builder_build_item < 0 {
            self.builder_build_item = self.builder_item("build", &none, k, node)
        }
        self.need_drop(k, builder, node)
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            j = j + 1
            let op = self.dp.bc.mir.operands[o]
            if op.kind == MirOperandKind.Const && op.const_kind == MirConstKind.Placeholder {
                self.refuse(node, "mono.not-yet", "a `\{\}` slot in an interpolation is not in the backend slice yet")
                return
            }
            var t = op.ty
            let referent = self.dp.bc.mir.tc.referent(t)
            if referent >= 0 {
                t = referent
            } else if op.kind == MirOperandKind.Move {
                self.need_drop(k, t, node)
            }
            if self.render_of(k, t, node) < 0 {
                return
            }
        }
    }

    // THE COLLECTION-LITERAL FUNNEL, mono's half: what literal `r` of item
    // `k` needs made for the backend's half, `collection_literal_into`. A
    // fixed array needs nothing past its operands; a repeat, its element's
    // copy glue (the copies after the first) and drop glue (a zero count's
    // value). A `Vector`, `Map` or `Set` needs `init()` and its entry op,
    // `push(value:)`, `insert(key:value:)` or `insert(value:)`, at the
    // literal's type, the rendering of the op's error a refused insertion
    // panics with, and for a `Map` the drop of a replaced value.
    // ENTRY POINTS:
    //     resolve_stmt
    func resolve_collection_literal(&var self, k: Int, r: Int, node: Int) {
        let rv = self.dp.bc.mir.rvalues[r]
        if rv.aggregate == MirAggregate.Array {
            return
        }
        if rv.aggregate == MirAggregate.Repeat {
            let element = self.dp.bc.mir.tc.types.ty(rv.ty).b
            if not mono_copies_bitwise(&var self.dp.bc.mir.tc, element) {
                let _ = self.glue_of(element, MONO_KEY_COPY, k, node)
            }
            self.need_drop(k, element, node)
            return
        }
        let d = self.dp.bc.mir.tc.nominal_decl(rv.ty)
        let known = self.dp.bc.mir.tc.known
        var labels = Vector<String>()
        var op = "insert"
        var expected = known.set
        if rv.aggregate == MirAggregate.Vector {
            op = "push"
            expected = known.vector
        } else if rv.aggregate == MirAggregate.Map {
            try! labels.push("key")
            expected = known.map
        }
        try! labels.push("value")
        if d < 0 || d != expected {
            self.refuse(node, "mono.not-yet", "a collection literal whose type is not its literal's collection")
            return
        }
        let none = Vector<String>()
        let made_decl = self.member_with(rv.ty, "init", &none)
        let op_decl = self.member_with(rv.ty, op, &labels)
        if made_decl < 0 || op_decl < 0 {
            var msg = StringBuilder()
            try! msg.append("a collection literal whose type has no `init()` or `")
            try! msg.append(op)
            try! msg.append("` taking its entries")
            self.refuse(node, "mono.not-yet", msg.build())
            return
        }
        let made = self.member_item(k, made_decl, rv.ty, node)
        let inserts = self.member_item(k, op_decl, rv.ty, node)
        if made < 0 || inserts < 0 {
            return
        }
        self.set_literal_items(r, made, inserts)
        let result = self.dp.bc.mir.tc.sigs[op_decl].result
        if self.dp.bc.mir.tc.is_result(result) {
            let error = self.dp.bc.mir.tc.types.arg(result, 1)
            let _ = self.need_fixed_render(k, error, node)
        }
        if rv.aggregate == MirAggregate.Map {
            let value = self.dp.bc.mir.tc.arg_of(rv.ty, 1)
            let replaced = self.dp.bc.mir.tc.mk_optional(value)
            self.need_drop(k, replaced, node)
        }
    }

    // THE RENDER FUNNEL: the item that formats a value of concrete type `t`
    // into the builder, `Printable.format(into:)` resolved on `t` through the
    // requirement funnel, made when new; for an erased `t` (`any Trait` or an
    // erased box) the vtable slot its `format` dispatches through
    // (`render_slot`); -1 when refused.
    // ENTRY POINTS:
    //     need_fixed_render
    //     resolve_interpolation
    func render_of(&var self, k: Int, t: Int, node: Int) -> Int {
        let found = self.render_item(t)
        if found >= 0 {
            return found
        }
        let req = self.format_requirement()
        if req < 0 {
            self.refuse(node, "mono.not-yet", "a rendering with no `Printable.format` requirement")
            return -1
        }
        let x = self.dp.bc.mir.tc.dispatched_existential(t)
        if x >= 0 {
            let known = self.render_slot(t)
            if known >= 0 {
                return known
            }
            let trait_decl = self.dp.bc.mir.tc.types.ty(x).decl
            let slot = self.dispatch_of(k, trait_decl, req, node)
            if slot >= 0 {
                self.by_key.add(t, MONO_KEY_RENDER_SLOT, slot)
            }
            return slot
        }
        let target = self.resolve_requirement(req, t, k, node)
        var item = target.item
        if target.decl >= 0 && item < 0 {
            item = self.member_item_at(k, target.decl, target.self_type, t, node)
        }
        if item >= 0 {
            self.by_key.add(t, MONO_KEY_RENDER, item)
        }
        item
    }

    // The item of member `decl` called on concrete owner `owner`, as a call
    // with no type arguments of its own reaches it.
    func member_item(&var self, k: Int, decl: Int, owner: Int, node: Int) -> Int {
        self.member_item_at(k, decl, -1, owner, node)
    }

    func member_item_at(&var self, k: Int, decl: Int, self_type: Int, owner: Int, node: Int) -> Int {
        var info = self.dp.bc.mir.blank_call(MirCallKind.Function, node)
        info.target = decl
        info.owner = owner
        let body = self.body_of[decl]
        self.call_item_of(k, body, decl, self_type, &info, MONO_KEY_FUNCTION)
    }

    // `Printable`'s `format` requirement, or -1.
    func format_requirement(&var self) -> Int {
        let printable = self.dp.bc.mir.tc.known.printable
        if printable < 0 {
            return -1
        }
        let reqs = self.dp.bc.mir.tc.members_of(printable)
        let format = self.dp.bc.mir.tc.res.intern("format")
        var j = 0
        while j < reqs.len() {
            if self.dp.bc.mir.tc.res.decls[reqs[j]].name == format {
                return reqs[j]
            }
            j = j + 1
        }
        return -1
    }

    // The builder role's type, or -1.
    func builder_type(&var self) -> Int {
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringBuilderStruct)
        if d < 0 {
            return -1
        }
        self.dp.bc.mir.tc.prim(d)
    }

    // The item of the builder's member `name` whose parameters carry `labels`.
    func builder_item(&var self, name: String, labels: &Vector<String>, k: Int, node: Int) -> Int {
        let builder = self.builder_type()
        let decl = self.member_with(builder, name, &labels)
        if decl < 0 {
            var msg = StringBuilder()
            try! msg.append("the builder role declares no `")
            try! msg.append(name)
            try! msg.append("` this rendering calls")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        self.member_item(k, decl, builder, node)
    }

    // The member of type `t` named `name` whose parameters carry `labels`, in
    // order, or -1: a member of its declaration's table that belongs to `t`
    // (`extension_applies`).
    func member_with(&var self, t: Int, name: String, labels: &Vector<String>) -> Int {
        let d = self.dp.bc.mir.tc.nominal_decl(t)
        if d < 0 || d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return -1
        }
        let first = self.dp.bc.mir.tc.member_first[d]
        let count = self.dp.bc.mir.tc.member_count[d]
        let id = self.dp.bc.mir.tc.res.intern(name)
        var j = first
        while j < first + count {
            let member = self.dp.bc.mir.tc.members[j]
            j = j + 1
            if member.name != id || not self.dp.bc.mir.tc.extension_applies(member.ext, t) {
                continue
            }
            let s = self.dp.bc.mir.tc.sigs[member.decl]
            if s.param_count != labels.len() {
                continue
            }
            var same = true
            var p = 0
            while p < s.param_count {
                let label = self.dp.bc.mir.tc.res.intern(labels.get(p) ?? "")
                if self.dp.bc.mir.tc.params[s.param_first + p].name != label {
                    same = false
                }
                p = p + 1
            }
            if same {
                return member.decl
            }
        }
        return -1
    }

    // The extern item of declaration `d`, one per C name: two modules
    // declaring one seam call one symbol.
    func extern_item(&var self, origin: Int, d: Int) -> Int {
        let name = self.dp.bc.mir.tc.res.decls[d].name
        let at = self.by_key.first(name, MONO_KEY_EXTERN)
        if at >= 0 {
            return self.by_key.value(at)
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: MonoItemKind.Extern, source: -1, type_decl: -1, func_decl: -1,
                                      args_first: first, args_count: 0, inst_first: first, inst_count: 0,
                                      self_type: -1, glue_type: -1, decl: d, body: -1, origin: origin,
                                      origin_node: -1))
        self.by_key.add(name, MONO_KEY_EXTERN, k)
        k
    }
}

// Erasure and dispatch through `any Trait` (spec, `any Trait` existentials):
// an erasure attaches the vtable of its concrete type at the existential's
// trait, and a dispatch calls one of that vtable's slots. A slot is filled
// only for a requirement some dispatch in the program calls, so an erased
// type's other requirements are never instantiated; whichever of the two
// arrives second fills it.
extension MonoProgram {
    // An erasure in item `k` at concrete rvalue `r`: a reference's into
    // `&any Trait`, a value's into an erased box, or a `Result`'s concrete
    // error into its erased box, the last two also reaching the box
    // allocator's `alloc`.
    func resolve_erasure(&var self, k: Int, r: Int, node: Int) {
        let rv = self.dp.bc.mir.rvalues[r]
        let o = self.dp.bc.mir.lists[rv.first]
        let from = self.dp.bc.mir.operands[o].ty
        var concrete = from
        var x = -1
        var alloc = -1
        if self.dp.bc.mir.tc.kind_of(rv.ty) == TcKind.Ref {
            concrete = self.dp.bc.mir.tc.referent(from)
            x = self.dp.bc.mir.tc.referent(rv.ty)
        } else {
            var box = rv.ty
            if self.dp.bc.mir.tc.is_result(rv.ty) && self.dp.bc.mir.tc.is_result(from) {
                box = self.dp.bc.mir.tc.arg_of(rv.ty, 1)
                concrete = self.dp.bc.mir.tc.arg_of(from, 1)
            }
            x = self.dp.bc.mir.tc.dispatched_existential(box)
            if x < 0 || x == box {
                try! self.problems.push("an erasure into neither a reference nor a box reached mono")
                return
            }
            alloc = self.allocator_member(k, box, "alloc", node)
            if alloc < 0 {
                return
            }
        }
        if concrete < 0 || x < 0 || self.dp.bc.mir.tc.kind_of(x) != TcKind.Any {
            try! self.problems.push("an erasure whose target is no existential reached mono")
            return
        }
        let trait_decl = self.dp.bc.mir.tc.types.ty(x).decl
        let v = self.vtable_of(k, concrete, trait_decl, node)
        self.set_erasure(r, v, alloc)
    }

    // THE VTABLE FUNNEL: the vtable of concrete type `concrete` at trait
    // `trait_decl`, made when new, with every slot a dispatch already calls
    // filled and the type's drop glue reached.
    // ENTRY POINTS:
    //     resolve_erasure
    func vtable_of(&var self, k: Int, concrete: Int, trait_decl: Int, node: Int) -> Int {
        var at = self.by_key.first(concrete, MONO_KEY_VTABLE)
        while at >= 0 {
            let found = self.by_key.value(at)
            if self.vtables[found].trait_decl == trait_decl {
                return found
            }
            at = self.by_key.following(at)
        }
        let slots = self.dp.bc.mir.tc.dispatch_requirements(trait_decl)
        let first = self.vtable_slots.len()
        var j = 0
        while j < slots.len() {
            try! self.vtable_slots.push(-1)
            j = j + 1
        }
        var drop = -1
        if self.dp.bc.mir.owns(concrete) {
            drop = self.glue_of(concrete, MONO_KEY_DROP, k, node)
        }
        let v = self.vtables.len()
        try! self.vtables.push(MonoVtable(concrete: concrete, trait_decl: trait_decl, slot_first: first,
                                          slot_count: slots.len(), drop: drop))
        self.by_key.add(concrete, MONO_KEY_VTABLE, v)
        j = 0
        while j < slots.len() {
            if self.is_dispatched(trait_decl, j) {
                self.fill_slot(k, v, j, node)
            }
            j = j + 1
        }
        v
    }

    // A dispatch through `any Trait` at concrete call `c` of item `k`.
    func resolve_dispatch(&var self, k: Int, c: Int, info: &MirCall) {
        let trait_decl = self.dp.bc.mir.tc.types.ty(info.owner).decl
        let slot = self.dispatch_of(k, trait_decl, info.target, info.node)
        if slot >= 0 {
            self.set_dispatch_slot(c, slot)
        }
    }

    // THE DISPATCH FUNNEL: the slot requirement `req` has in the vtables of
    // trait `trait_decl`, filled in each of them the first time anything
    // dispatches it; -1 for a requirement with no slot.
    // ENTRY POINTS:
    //     resolve_dispatch
    //     render_of
    func dispatch_of(&var self, k: Int, trait_decl: Int, req: Int, node: Int) -> Int {
        let slots = self.dp.bc.mir.tc.dispatch_requirements(trait_decl)
        var slot = -1
        var j = 0
        while j < slots.len() {
            if slots[j] == req {
                slot = j
            }
            j = j + 1
        }
        if slot < 0 {
            try! self.problems.push("a dispatch names a requirement its existential's vtable has no slot for")
            return -1
        }
        if self.is_dispatched(trait_decl, slot) {
            return slot
        }
        self.by_key.add(trait_decl, MONO_KEY_DISPATCHED, slot)
        var v = 0
        while v < self.vtables.len() {
            if self.vtables[v].trait_decl == trait_decl {
                self.fill_slot(k, v, slot, node)
            }
            v = v + 1
        }
        slot
    }

    // Whether some dispatch calls slot `slot` of trait `trait_decl`.
    func is_dispatched(&self, trait_decl: Int, slot: Int) -> Bool {
        var at = self.by_key.first(trait_decl, MONO_KEY_DISPATCHED)
        while at >= 0 {
            if self.by_key.value(at) == slot {
                return true
            }
            at = self.by_key.following(at)
        }
        false
    }

    // Slot `slot` of vtable `v`: its requirement resolved on the vtable's
    // concrete type through the requirement funnel.
    func fill_slot(&var self, k: Int, v: Int, slot: Int, node: Int) {
        let vt = self.vtables[v]
        let slots = self.dp.bc.mir.tc.dispatch_requirements(vt.trait_decl)
        let req = slots[slot]
        let target = self.resolve_requirement(req, vt.concrete, k, node)
        var item = target.item
        if target.decl >= 0 && item < 0 {
            item = self.member_item_at(k, target.decl, target.self_type, vt.concrete, node)
        }
        self.vtable_slots[vt.slot_first + slot] = item
    }

    // An erased box's drop glue (item `k`) has no MIR body: the backend runs
    // the payload's drop through its vtable and frees the allocation through
    // the box's allocator with the vtable's size and alignment, so all this
    // item reaches is that allocator's `dealloc`.
    func erased_box_glue(&var self, k: Int) {
        let it = self.items[k]
        let dealloc = self.allocator_member(k, it.glue_type, "dealloc", it.origin_node)
        if dealloc >= 0 {
            self.by_key.add(it.glue_type, MONO_KEY_DEALLOC, dealloc)
        }
    }

    // The `dealloc` item erased box type `t`'s drop glue calls, or -1.
    public func erased_dealloc(&self, t: Int) -> Int {
        let at = self.by_key.first(t, MONO_KEY_DEALLOC)
        if at < 0 {
            return -1
        }
        self.by_key.value(at)
    }

    // The item of allocator member `name` (`alloc` or `dealloc`) of erased
    // box type `box`'s allocator, reached from item `k`; -1 when refused.
    // The box builds its allocator as `A()`, so in the slice it is a
    // fieldless struct with no `init`, as a construction through a type
    // parameter is.
    func allocator_member(&var self, k: Int, box: Int, name: String, node: Int) -> Int {
        let a = self.dp.bc.mir.tc.arg_of(box, 1)
        let d = self.dp.bc.mir.tc.nominal_decl(a)
        let is_struct = d >= 0 && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Struct
        if not is_struct || target_struct_fields(&self.dp.bc.mir.tc, d).len() != 0 || self.declares_init(d) {
            var msg = StringBuilder()
            try! msg.append("an erased box over `")
            try! msg.append(self.dp.bc.mir.tc.type_text(a))
            try! msg.append("` is not in the backend slice yet: only an allocator that is a fieldless struct with no `init`")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        var labels = Vector<String>()
        if name.equals("dealloc") {
            try! labels.push("ptr")
        }
        try! labels.push("size")
        try! labels.push("align")
        let decl = self.member_with(a, name, &labels)
        if decl < 0 {
            var msg = StringBuilder()
            try! msg.append("an erased box whose allocator `")
            try! msg.append(self.dp.bc.mir.tc.type_text(a))
            try! msg.append("` declares no `")
            try! msg.append(name)
            try! msg.append("` is not in the backend slice yet")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        self.member_item(k, decl, a, node)
    }
}
