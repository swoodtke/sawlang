// The worklist (SL:architecture §3.8): items reached from the roots, each
// instantiated once by substituting its concrete arguments into a copy of its
// source function, whose calls, closures, drops and copies then add the items
// they reach. Items are numbered in discovery order, and a body is walked
// block by block, statement by statement, so the order is a function of the
// program alone.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirAggregate, MirBlock, MirCall, MirCallKind, MirConstKind, MirFunc, MirFuncKind, MirLocal,
                         MirOperand, MirOperandKind, MirPlace, MirProj, MirRvalue, MirRvalueKind, MirStmt,
                         MirStmtKind, MirSwitchKind, MirTermKind, MirWindow}
import sawmir.program.{MirProgram}
import sawmir.build.{mir_func_local}
import sawmono.glue.{mono_copies_bitwise}
import sawtarget.layout.{target_struct_fields}
import sawmono.program.{MONO_DEPTH_LIMIT, MONO_KEY_COPY, MONO_KEY_DROP, MONO_KEY_EXTERN, MONO_KEY_FUNCTION,
                            MONO_KEY_MEMBER, MONO_KEY_RENDER, MonoItem, MonoItemKind, MonoProgram}
import sawtypecheck.bodydump.{tc_dump_bodies}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}
import sawresolve.lang.{ResLang}
import sawresolve.model.{ResDeclKind, ResModuleKind}
import sawresolve.program.{ResProgram}
import sawtypecheck.conform.{tc_args_subst}
import sawtypecheck.model.{TC_FLAG_DEFAULT_BODY, TcStatusKind}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.tier.{tc_compute_tiers}
import sawtypecheck.types.{TcKind}

// Every rule monomorphization refuses by.
public func mono_rules() -> Vector<String> {
    var out = Vector<String>()
    try! out.push("atomic.width")
    try! out.push("mono.depth")
    try! out.push("mono.not-yet")
    try! out.push("static_assert.failed")
    move out
}

// The builtins the backend's slice lowers, by spelling.
func mono_builtin_supported(name: String) -> Bool {
    name.equals("print") || name.equals("panic") || name.equals("assert") || name.equals("init") || name.equals("sizeof") || name.equals("alignof") || name.equals("__saw_atomic_add_i64") || name.equals("__saw_atomic_sub_i64_release") || name.equals("__saw_atomic_fence_acquire") || name.equals("__saw_atomic_load_i64_relaxed") || mono_seq_cst_atomic(name)
}

// The sequentially consistent atomic intrinsics (SL:open-questions D39).
func mono_seq_cst_atomic(name: String) -> Bool {
    name.equals("__saw_atomic_load_i64_seq_cst") || name.equals("__saw_atomic_store_i64_seq_cst") || name.equals("__saw_atomic_add_i64_seq_cst") || name.equals("__saw_atomic_cmpxchg_i64_seq_cst")
}

// A resolved call target: the declaration whose body runs, and the `Self`
// it runs under (a trait's default body), or -1; or the glue item that
// synthesizes the member, or -1.
struct MonoTarget {
    decl: Int
    self_type: Int
    item: Int
}

extension MonoProgram {
    // Runs the worklist to its end: the roots, then every item they reach.
    public func run(&var self) {
        if self.blocked {
            return
        }
        self.index_bodies()
        self.add_roots()
        var k = 0
        while k < self.items.len() {
            self.current = k
            self.instantiate(k)
            k = k + 1
        }
        self.current = -1
        self.report_depth()
    }

    func index_bodies(&var self) {
        var f = 0
        while f < self.concrete_first {
            let info = self.dp.bc.mir.funcs[f]
            if self.dp.elaborated[f] && info.decl >= 0 {
                if info.kind == MirFuncKind.Body && self.body_of[info.decl] < 0 {
                    self.body_of[info.decl] = f
                } else if info.kind == MirFuncKind.Default {
                    self.defaults.add(info.decl, info.param, f)
                }
            }
            f = f + 1
        }
    }

    // The roots, in order: the entry module's `main`, which a runtime has
    // none of; each exported function, in declaration order; then the lang
    // functions the backend's own lowering calls: the panic sink, which every
    // check ends in, and the String roles a literal and a written-out String
    // are read through.
    func add_roots(&var self) {
        let entry = self.entry_module()
        let none = Vector<Int>()
        if not self.runtime {
            let main_decl = self.dp.bc.mir.tc.top_decl(entry, "main")
            if main_decl >= 0 {
                self.main_item = self.root_item(main_decl, &none)
            }
        }
        var d = 0
        while d < self.dp.bc.mir.tc.export_symbols.len() {
            let symbol = self.dp.bc.mir.tc.export_symbols.get(d) ?? ""
            if symbol.len() > 0 && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Func {
                let k = self.root_item(d, &none)
                if k >= 0 {
                    try! self.export_items.push(k)
                }
            }
            d = d + 1
        }
        let sink = self.dp.bc.mir.tc.res.lang_item(ResLang.PanicSinkFunction)
        self.panic_item = self.root_item(sink, &none)
        let literal = self.dp.bc.mir.tc.res.lang_item(ResLang.StringLiteralFunction)
        self.literal_item = self.root_item(literal, &none)
        let bytes = self.dp.bc.mir.tc.res.lang_item(ResLang.StringBytesFunction)
        self.bytes_item = self.root_item(bytes, &none)
        let length = self.dp.bc.mir.tc.res.lang_item(ResLang.StringLengthFunction)
        self.length_item = self.root_item(length, &none)
    }

    // The entry executor's item, rooted after the worklist ran and run to
    // its end like any root, or -1 when std declares none. Only a program
    // whose `main` has a lowered frame is handed to the executor, which
    // coroutine lowering decides after mono, so a program with a plain
    // `main` reaches no executor item at all.
    public func root_entry_executor(&var self) -> Int {
        if self.exec_item >= 0 || self.blocked {
            return self.exec_item
        }
        let none = Vector<Int>()
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.ExecRunMainFunction)
        // The worklist's run already made its one depth refusal, if any.
        let reported = self.depth_call >= 0 || self.depth_glue >= 0
        var k = self.items.len()
        self.exec_item = self.root_item(d, &none)
        while k < self.items.len() {
            self.current = k
            self.instantiate(k)
            k = k + 1
        }
        self.current = -1
        if not reported {
            self.report_depth()
        }
        self.exec_item
    }

    // The module of the file the program was named by.
    public func entry_module(&self) -> Int {
        var m = 0
        while m < self.dp.bc.mir.tc.res.module_count() {
            let info = self.dp.bc.mir.tc.res.module(m)
            if info.kind == ResModuleKind.Entry && info.available {
                return m
            }
            m = m + 1
        }
        return -1
    }

    // The item of non-generic declaration `d`'s body, or -1 when it has none.
    func root_item(&var self, d: Int, none: &Vector<Int>) -> Int {
        if d < 0 || self.body_of[d] < 0 {
            return -1
        }
        let f = self.body_of[d]
        let no_inst = Vector<Int>()
        self.function_item(f, -1, &none, -1, &no_inst, -1, -1, -1)
    }

    // THE ITEM FUNNEL for functions: the item of source function `source` at
    // owner arguments `args` (for `type_decl`'s parameters), its own type
    // arguments `inst` (for `func_decl`'s) and `self_type`, made when new.
    // ENTRY POINTS:
    //     root_item
    //     role_item
    //     call_item_of
    //     resolve_closure
    func function_item(&var self, source: Int, type_decl: Int, args: &Vector<Int>, func_decl: Int, inst: &Vector<Int>,
                       self_type: Int, origin: Int, node: Int) -> Int {
        var at = self.by_key.first(source, MONO_KEY_FUNCTION)
        while at >= 0 {
            let k = self.by_key.value(at)
            if self.same_arguments(k, &args, &inst, self_type) {
                return k
            }
            at = self.by_key.following(at)
        }
        var j = 0
        while j < args.len() {
            if self.depth_exceeded(args[j], node, true) {
                return -1
            }
            j = j + 1
        }
        j = 0
        while j < inst.len() {
            if self.depth_exceeded(inst[j], node, true) {
                return -1
            }
            j = j + 1
        }
        let args_first = self.item_types.len()
        j = 0
        while j < args.len() {
            try! self.item_types.push(args[j])
            j = j + 1
        }
        let inst_first = self.item_types.len()
        j = 0
        while j < inst.len() {
            try! self.item_types.push(inst[j])
            j = j + 1
        }
        let k = self.items.len()
        let decl = self.dp.bc.mir.funcs[source].decl
        try! self.items.push(MonoItem(kind: MonoItemKind.Function, source: source, type_decl: type_decl,
                                      func_decl: func_decl, args_first: args_first, args_count: args.len(),
                                      inst_first: inst_first, inst_count: inst.len(), self_type: self_type,
                                      glue_type: -1, decl: decl, body: -1, origin: origin, origin_node: node))
        self.by_key.add(source, MONO_KEY_FUNCTION, k)
        k
    }

    func same_arguments(&self, k: Int, args: &Vector<Int>, inst: &Vector<Int>, self_type: Int) -> Bool {
        let it = self.items[k]
        if it.args_count != args.len() || it.inst_count != inst.len() || it.self_type != self_type {
            return false
        }
        var j = 0
        while j < args.len() {
            if self.item_types[it.args_first + j] != args[j] {
                return false
            }
            j = j + 1
        }
        j = 0
        while j < inst.len() {
            if self.item_types[it.inst_first + j] != inst[j] {
                return false
            }
            j = j + 1
        }
        true
    }

    // Whether concrete argument `t` nests past the depth limit: polymorphic
    // recursion grows a type without bound, and its ruled refusal before mono
    // is not built yet (SL-507). The first call `call` meets at is kept, and
    // the first drop or copy otherwise, for the one refusal `report_depth`
    // makes: one growing chain meets the limit at every item it reaches.
    func depth_exceeded(&var self, t: Int, node: Int, call: Bool) -> Bool {
        if self.type_depth(t, 0) <= MONO_DEPTH_LIMIT {
            return false
        }
        if call && self.depth_call < 0 {
            self.depth_call = node
        } else if not call && self.depth_glue < 0 {
            self.depth_glue = node
        }
        true
    }

    // The depth limit's one refusal: at the first call that met it, else at
    // the first drop or copy.
    func report_depth(&var self) {
        var node = self.depth_call
        var what = "this call instantiates"
        if node < 0 {
            node = self.depth_glue
            what = "this value has"
        }
        if node < 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(" a type nested more than ")
        try! msg.append(MONO_DEPTH_LIMIT)
        try! msg.append(" deep: a generic that instantiates itself at a growing type has no finite set of instances (polymorphic recursion, SL-507)")
        self.refuse(node, "mono.depth", msg.build())
    }

    func type_depth(&self, t: Int, depth: Int) -> Int {
        if t < 0 || depth > MONO_DEPTH_LIMIT {
            return depth
        }
        let info = self.dp.bc.mir.tc.types.ty(t)
        var deepest = depth
        if info.b >= 0 && (info.kind == TcKind.Func || info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array) {
            let inner = self.type_depth(info.b, depth + 1)
            if inner > deepest {
                deepest = inner
            }
        }
        var k = 0
        while k < info.count {
            let arg = self.dp.bc.mir.tc.types.arg(t, k)
            let inner = self.type_depth(arg, depth + 1)
            if inner > deepest {
                deepest = inner
            }
            k = k + 1
        }
        deepest
    }

    // Type `t` with item `k`'s concrete arguments in place of its parameters.
    public func concrete_type(&var self, k: Int, t: Int) -> Int {
        if t < 0 || not self.dp.bc.mir.tc.mentions_param(t) {
            return t
        }
        let it = self.items[k]
        var out = t
        if it.type_decl >= 0 || it.self_type >= 0 {
            var args = Vector<Int>()
            var j = 0
            while j < it.args_count {
                try! args.push(self.item_types[it.args_first + j])
                j = j + 1
            }
            var s = tc_args_subst(it.type_decl, move args)
            s.self_type = it.self_type
            out = self.dp.bc.mir.tc.subst(out, &s)
        }
        if it.func_decl >= 0 && it.inst_count > 0 {
            var inst = Vector<Int>()
            var j = 0
            while j < it.inst_count {
                try! inst.push(self.item_types[it.inst_first + j])
                j = j + 1
            }
            let s = tc_args_subst(it.func_decl, move inst)
            out = self.dp.bc.mir.tc.subst(out, &s)
        }
        self.refuse_narrow_atomics(k, out)
        out
    }

    func instantiate(&var self, k: Int) {
        let it = self.items[k]
        match it.kind {
            case Function -> {
                if not self.dp.elaborated[it.source] {
                    try! self.problems.push("an item's source function was not elaborated")
                    return
                }
                let f = self.copy_function(k)
                var done = self.items[k]
                done.body = f
                self.items[k] = done
            },
            case DropGlue -> self.build_drop_glue(k),
            case CopyGlue -> self.build_copy_glue(k),
            case MemberGlue -> self.build_member_glue(k),
            case Extern -> {}
        }
        let body = self.items[k].body
        if body >= 0 {
            self.resolve_function(k, body)
        }
    }

    // The atomic role's width rule at an instantiation (SL:open-questions
    // D38): an `Atomic<X>` at an `X` other than `Int` that item `k`'s
    // arguments put in concrete type `t`, and that no position typecheck saw
    // carried, is refused once, where the item was reached.
    func refuse_narrow_atomics(&var self, k: Int, t: Int) {
        var j = 0
        while j < self.dp.bc.mir.tc.narrow_atomics.len() {
            let narrow = self.dp.bc.mir.tc.narrow_atomics[j]
            if not self.dp.bc.mir.tc.narrow_reported[j] && self.dp.bc.mir.tc.type_holds(t, narrow, 0) {
                self.dp.bc.mir.tc.narrow_reported[j] = true
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.dp.bc.mir.tc.type_text(narrow))
                try! msg.append("` is not an atomic this compiler lowers: v1 atomics are `Atomic<Int>` only")
                let site = self.items[k].origin_node
                self.refuse(site, "atomic.width", msg.build())
            }
            j = j + 1
        }
    }

    // THE GLUE FUNNEL: the drop glue of type `t` (`kind` MONO_KEY_DROP) or its
    // copy glue (MONO_KEY_COPY), made when new; -1 when refused.
    // ENTRY POINTS:
    //     need_drop
    //     need_operand
    public func glue_of(&var self, t: Int, kind: Int, origin: Int, node: Int) -> Int {
        let found = self.glue_item(t, kind)
        if found >= 0 {
            return found
        }
        if self.depth_exceeded(t, node, false) {
            return -1
        }
        var item_kind = MonoItemKind.DropGlue
        if kind == MONO_KEY_COPY {
            item_kind = MonoItemKind.CopyGlue
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: item_kind, source: -1, type_decl: -1, func_decl: -1, args_first: first,
                                      args_count: 0, inst_first: first, inst_count: 0, self_type: -1, glue_type: t,
                                      decl: -1, body: -1, origin: origin, origin_node: node))
        self.by_key.add(t, kind, k)
        k
    }

    // A drop of type `t` in item `k`: its glue, unless the type owns nothing.
    // A function value owns nothing in this slice: a closure capturing an
    // owning value is refused where it is built.
    func need_drop(&var self, k: Int, t: Int, node: Int) {
        if not self.dp.bc.mir.owns(t) || self.dp.bc.mir.tc.kind_of(t) == TcKind.Func {
            return
        }
        let _ = self.glue_of(t, MONO_KEY_DROP, k, node)
    }

    // An operand of item `k`: a copy of a type that is not the bits alone
    // runs that type's copy glue.
    func need_operand(&var self, k: Int, o: Int, node: Int) {
        if o < 0 {
            return
        }
        let info = self.dp.bc.mir.operands[o]
        if info.kind != MirOperandKind.Copy || mono_copies_bitwise(&var self.dp.bc.mir.tc, info.ty) {
            return
        }
        let _ = self.glue_of(info.ty, MONO_KEY_COPY, k, node)
    }
}

// The copy: a concrete function appended after every generic one, its
// locals, blocks and statements numbered as its source's, every type
// substituted.
extension MonoProgram {
    func copy_function(&var self, k: Int) -> Int {
        let it = self.items[k]
        let src = self.dp.bc.mir.funcs[it.source]
        let local_first = self.dp.bc.mir.locals.len()
        var j = 0
        while j < src.local_count {
            var l = self.dp.bc.mir.locals[src.local_first + j]
            l.ty = self.concrete_type(k, l.ty)
            try! self.dp.bc.mir.locals.push(l)
            j = j + 1
        }
        let window_first = self.dp.bc.mir.windows.len()
        j = 0
        while j < src.window_count {
            let w = self.dp.bc.mir.windows[src.window_first + j]
            try! self.dp.bc.mir.windows.push(w)
            j = j + 1
        }
        let block_first = self.dp.bc.mir.blocks.len()
        j = 0
        while j < src.block_count {
            let b = self.dp.bc.mir.blocks[src.block_first + j]
            let copied = self.copy_block(k, &b)
            try! self.dp.bc.mir.blocks.push(copied)
            j = j + 1
        }
        let f = self.dp.bc.mir.funcs.len()
        try! self.dp.bc.mir.funcs.push(MirFunc(module: src.module, kind: src.kind, decl: src.decl, root: src.root,
                                               param: src.param, parent: src.parent, ordinal: src.ordinal,
                                               local_first: local_first, local_count: src.local_count,
                                               block_first: block_first, block_count: src.block_count,
                                               param_count: src.param_count, window_first: window_first,
                                               window_count: src.window_count, owner: src.owner, refused: false,
                                               order: src.order, record_first: src.record_first,
                                               record_count: src.record_count,
                                               record_flags_first: src.record_flags_first,
                                               carried_first: src.carried_first, carried_count: src.carried_count))
        f
    }

    func copy_block(&var self, k: Int, b: &MirBlock) -> MirBlock {
        var out = b
        out.first = -1
        out.last = -1
        var s = b.first
        while s >= 0 {
            let stmt = self.dp.bc.mir.stmts[s]
            let place = self.copy_place(k, stmt.place)
            var rvalue = -1
            if stmt.rvalue >= 0 {
                rvalue = self.copy_rvalue(k, stmt.rvalue)
            }
            let at = self.dp.bc.mir.stmts.len()
            try! self.dp.bc.mir.stmts.push(MirStmt(kind: stmt.kind, place: place, rvalue: rvalue, yields: stmt.yields,
                                                   next: -1, node: stmt.node, closing: stmt.closing))
            if out.first < 0 {
                out.first = at
            } else {
                var prev = self.dp.bc.mir.stmts[out.last]
                prev.next = at
                self.dp.bc.mir.stmts[out.last] = prev
            }
            out.last = at
            s = stmt.next
        }
        out.operand = self.copy_operand(k, b.operand)
        out.place = self.copy_place(k, b.place)
        if b.arm_count > 0 {
            let arm_first = self.dp.bc.mir.arms.len()
            var j = 0
            while j < b.arm_count {
                let arm = self.dp.bc.mir.arms[b.arm_first + j]
                try! self.dp.bc.mir.arms.push(arm)
                j = j + 1
            }
            out.arm_first = arm_first
        }
        if b.call >= 0 {
            out.call = self.copy_call(k, b.call)
        }
        out
    }

    func copy_place(&var self, k: Int, p: Int) -> Int {
        if p < 0 {
            return -1
        }
        let info = self.dp.bc.mir.places[p]
        let first = self.dp.bc.mir.projs.len()
        var j = 0
        while j < info.count {
            var step = self.dp.bc.mir.projs[info.first + j]
            step.ty = self.concrete_type(k, step.ty)
            try! self.dp.bc.mir.projs.push(step)
            j = j + 1
        }
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.places.len()
        try! self.dp.bc.mir.places.push(MirPlace(local: info.local, static_decl: info.static_decl, first: first,
                                                 count: info.count, ty: ty))
        at
    }

    func copy_operand(&var self, k: Int, o: Int) -> Int {
        if o < 0 {
            return -1
        }
        let info = self.dp.bc.mir.operands[o]
        let place = self.copy_place(k, info.place)
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.operands.len()
        try! self.dp.bc.mir.operands.push(MirOperand(kind: info.kind, place: place, ty: ty,
                                                     const_kind: info.const_kind, text: info.text))
        at
    }

    // Operands `first .. first + count` of the lists, copied into a new run.
    func copy_list(&var self, k: Int, first: Int, count: Int) -> Int {
        var copied = Vector<Int>()
        var j = 0
        while j < count {
            let o = self.dp.bc.mir.lists[first + j]
            try! copied.push(self.copy_operand(k, o))
            j = j + 1
        }
        let at = self.dp.bc.mir.lists.len()
        j = 0
        while j < copied.len() {
            try! self.dp.bc.mir.lists.push(copied[j])
            j = j + 1
        }
        at
    }

    func copy_rvalue(&var self, k: Int, r: Int) -> Int {
        let info = self.dp.bc.mir.rvalues[r]
        let first = self.copy_list(k, info.first, info.count)
        let place = self.copy_place(k, info.place)
        let flag = self.copy_place(k, info.flag)
        let ty = self.concrete_type(k, info.ty)
        let at = self.dp.bc.mir.rvalues.len()
        try! self.dp.bc.mir.rvalues.push(MirRvalue(kind: info.kind, ty: ty, op: info.op, exclusive: info.exclusive,
                                                   place: place, first: first, count: info.count,
                                                   aggregate: info.aggregate, decl: info.decl, flag: flag))
        at
    }

    func copy_call(&var self, k: Int, c: Int) -> Int {
        var info = self.dp.bc.mir.calls[c]
        let args = self.copy_list(k, info.arg_first, info.arg_count)
        let callee = self.copy_operand(k, info.callee)
        let dest = self.copy_place(k, info.dest)
        var inst = Vector<Int>()
        var j = 0
        while j < info.inst_count {
            let t = self.dp.bc.mir.types[info.inst_first + j]
            try! inst.push(self.concrete_type(k, t))
            j = j + 1
        }
        let inst_first = self.dp.bc.mir.types.len()
        j = 0
        while j < inst.len() {
            try! self.dp.bc.mir.types.push(inst[j])
            j = j + 1
        }
        info.arg_first = args
        info.callee = callee
        info.dest = dest
        info.inst_first = inst_first
        info.owner = self.concrete_type(k, info.owner)
        let at = self.dp.bc.mir.calls.len()
        try! self.dp.bc.mir.calls.push(info)
        at
    }
}

// Resolution: what each concrete call, closure, drop and copy reaches.
extension MonoProgram {
    func resolve_function(&var self, k: Int, f: Int) {
        let info = self.dp.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = self.dp.bc.mir.blocks[info.block_first + b]
            var s = block.first
            while s >= 0 {
                let stmt = self.dp.bc.mir.stmts[s]
                self.resolve_stmt(k, &stmt)
                s = stmt.next
            }
            if block.term == MirTermKind.Call {
                self.resolve_call(k, block.call)
            } else if block.term == MirTermKind.Switch && block.switch_kind == MirSwitchKind.Bool {
                self.need_operand(k, block.operand, block.term_node)
            }
            b = b + 1
        }
    }

    func resolve_stmt(&var self, k: Int, stmt: &MirStmt) {
        if stmt.kind == MirStmtKind.Drop {
            let t = self.dp.bc.mir.places[stmt.place].ty
            self.need_drop(k, t, stmt.node)
            return
        }
        if stmt.kind != MirStmtKind.Assign {
            return
        }
        let rv = self.dp.bc.mir.rvalues[stmt.rvalue]
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            self.need_operand(k, o, stmt.node)
            j = j + 1
        }
        if rv.kind == MirRvalueKind.Aggregate && rv.aggregate == MirAggregate.Closure {
            self.resolve_closure(k, stmt.rvalue, stmt.node)
        }
        let collection = rv.aggregate == MirAggregate.Vector || rv.aggregate == MirAggregate.Map || rv.aggregate == MirAggregate.Set
        if rv.kind == MirRvalueKind.Aggregate && collection {
            self.resolve_collection_literal(k, stmt.rvalue, stmt.node)
        }
        if rv.kind == MirRvalueKind.Interpolate {
            self.resolve_interpolation(k, &rv, stmt.node)
        }
        if rv.kind == MirRvalueKind.Binary && rv.count == 2 {
            self.resolve_string_comparison(k, &rv, stmt.node)
        }
    }

    // A builtin comparison of Strings compares their bytes through the String
    // layer: `==` and `!=` through the equality role, an ordering through the
    // ordering role. Each role is an item made at the first comparison that
    // needs it.
    func resolve_string_comparison(&var self, k: Int, rv: &MirRvalue, node: Int) {
        let a = self.dp.bc.mir.lists[rv.first]
        let b = self.dp.bc.mir.lists[rv.first + 1]
        if not self.string_operand(a) && not self.string_operand(b) {
            return
        }
        let op = self.dp.bc.mir.tc.name_text(rv.op)
        if op.equals("==") || op.equals("!=") {
            if self.equals_item < 0 {
                let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringEqualsFunction)
                self.equals_item = self.role_item(d, k, node)
            }
        } else if op.equals("<") || op.equals("<=") || op.equals(">") || op.equals(">=") {
            if self.compare_item < 0 {
                let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringCompareFunction)
                self.compare_item = self.role_item(d, k, node)
            }
        }
    }

    // The item of non-generic lang function `d`, first reached from item `k`
    // at `node`, or -1 when the std root declares none.
    func role_item(&var self, d: Int, k: Int, node: Int) -> Int {
        if d < 0 || self.body_of[d] < 0 {
            return -1
        }
        let source = self.body_of[d]
        let none = Vector<Int>()
        let no_inst = Vector<Int>()
        self.function_item(source, -1, &none, -1, &no_inst, -1, k, node)
    }

    // A closure construction's body is an item under its parent's arguments.
    // A capture that owns something would need the environment's release when
    // the closure value drops, which this slice does not make, so it is
    // refused rather than leaked. The backend builds every environment in the
    // frame that creates the closure, so an escaping closure that captures
    // anything is refused too: its environment would be read after that frame
    // is gone (SL-525).
    func resolve_closure(&var self, k: Int, r: Int, node: Int) {
        let rv = self.dp.bc.mir.rvalues[r]
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            let t = self.dp.bc.mir.operands[o].ty
            if self.dp.bc.mir.owns(t) {
                self.refuse(node, "mono.not-yet", "a closure capturing a value that owns something is not in the backend slice yet")
                return
            }
            j = j + 1
        }
        if rv.count > 0 && self.closure_escapes(rv.decl) {
            self.refuse(node, "mono.not-yet", "an escaping closure that captures a value is not in the backend slice yet: its environment would live in the frame that builds it, and heap environments are unbuilt (SL-525)")
            return
        }
        let at = self.dp.bc.mir.func_of.first(rv.decl, 0)
        if at < 0 {
            try! self.problems.push("a closure construction names no lowered body")
            return
        }
        let body = self.dp.bc.mir.func_of.value(at)
        let it = self.items[k]
        var args = Vector<Int>()
        j = 0
        while j < it.args_count {
            try! args.push(self.item_types[it.args_first + j])
            j = j + 1
        }
        var inst = Vector<Int>()
        j = 0
        while j < it.inst_count {
            try! inst.push(self.item_types[it.inst_first + j])
            j = j + 1
        }
        let item = self.function_item(body, it.type_decl, &args, it.func_decl, &inst, it.self_type, k, node)
        self.set_closure_item(r, item)
    }

    // Whether the closure written at node `e` escapes, as typecheck's
    // `closure_escapes` decided it. That decision is by elimination: the one
    // non-escaping position is a direct argument whose parameter is a
    // function type that does not say `escaping`, so a field, a payload, an
    // element, a return, a binding or a type argument escapes without a rule
    // of its own. A closure with no capture table is taken to escape.
    func closure_escapes(&self, e: Int) -> Bool {
        let at = self.dp.bc.mir.tc.closure_index.first(e, 0)
        if at < 0 {
            return true
        }
        let ordinal = self.dp.bc.mir.tc.closure_index.value(at)
        ordinal >= self.dp.bc.mir.tc.closure_escaping.len() || self.dp.bc.mir.tc.closure_escaping[ordinal]
    }

    func resolve_call(&var self, k: Int, c: Int) {
        let info = self.dp.bc.mir.calls[c]
        var a = 0
        while a < info.arg_count {
            let o = self.dp.bc.mir.lists[info.arg_first + a]
            self.need_operand(k, o, info.node)
            a = a + 1
        }
        match info.kind {
            case Builtin -> {
                let name = self.dp.bc.mir.tc.res.name_text(info.spelling)
                if not mono_builtin_supported(name) {
                    var msg = StringBuilder()
                    try! msg.append("the builtin `")
                    try! msg.append(name)
                    try! msg.append("` is not in the backend slice yet")
                    self.refuse(info.node, "mono.not-yet", msg.build())
                    return
                }
                if name.equals("init") {
                    self.check_empty_construction(c)
                    return
                }
                self.check_format_arguments(k, c, &name)
            },
            case Value -> self.need_operand(k, info.callee, info.node),
            case Lend -> try! self.problems.push("a lend outside an accessor's split reached mono"),
            case Function -> {
                let decl = self.dp.bc.mir.tc.res.decls[info.target]
                if decl.kind == ResDeclKind.Extern {
                    let item = self.extern_item(k, info.target)
                    self.set_call_item(c, item)
                    return
                }
                var target = MonoTarget(decl: info.target, self_type: -1, item: -1)
                if decl.kind == ResDeclKind.Requirement {
                    target = self.resolve_requirement(info.target, info.owner, k, info.node)
                    if target.decl < 0 {
                        return
                    }
                    if target.item >= 0 {
                        self.set_call_item(c, target.item)
                        return
                    }
                }
                let body = self.body_of[target.decl]
                let item = self.call_item_of(k, body, target.decl, target.self_type, &info)
                self.set_call_item(c, item)
            },
            case Default -> {
                let at = self.defaults.first(info.target, info.param)
                if at < 0 {
                    self.refuse(info.node, "mono.not-yet", "a default value whose function was not lowered")
                    return
                }
                let body = self.defaults.value(at)
                let decl = info.target
                let item = self.call_item_of(k, body, decl, -1, &info)
                self.set_call_item(c, item)
            },
            case WindowOpen -> self.resolve_window(k, c, &info),
            case WindowClose -> self.resolve_window(k, c, &info)
        }
    }

    // A window's open or close calls its accessor's half at the window's
    // instantiation; an accessor whose body this program does not lower has
    // no halves to call.
    func resolve_window(&var self, k: Int, c: Int, info: &MirCall) {
        if info.half < 0 {
            self.refuse(info.node, "mono.not-yet", "a borrow of an accessor whose body is not lowered")
            return
        }
        let half = info.half
        let decl = info.target
        let item = self.call_item_of(k, half, decl, -1, &info)
        self.set_call_item(c, item)
    }

    // The item a call of declaration `decl`, whose body is `body`, reaches:
    // the receiver type's arguments for the parameters of the type an
    // extension method extends, the call's own type arguments for `decl`'s.
    func call_item_of(&var self, k: Int, body: Int, decl: Int, self_type: Int, info: &MirCall) -> Int {
        if body < 0 || not self.dp.elaborated[body] {
            var msg = StringBuilder()
            try! msg.append("a call of `")
            try! msg.append(self.dp.bc.mir.tc.target_text(decl))
            try! msg.append("`, whose body this program does not lower, is not in the backend slice yet")
            self.refuse(info.node, "mono.not-yet", msg.build())
            return -1
        }
        let type_decl = self.type_decl_of(decl)
        var args = Vector<Int>()
        if type_decl >= 0 && info.owner >= 0 {
            let owner = self.dp.bc.mir.tc.types.ty(info.owner)
            if owner.kind == TcKind.Nominal && owner.decl == type_decl {
                var j = 0
                while j < owner.count {
                    try! args.push(self.dp.bc.mir.tc.types.arg(info.owner, j))
                    j = j + 1
                }
            }
        }
        if type_decl >= 0 && self.dp.bc.mir.tc.sigs[type_decl].generic_count != args.len() {
            self.refuse(info.node, "mono.not-yet", "a call whose receiver type does not name the extended type's arguments")
            return -1
        }
        var inst = Vector<Int>()
        var j = 0
        while j < info.inst_count {
            try! inst.push(self.dp.bc.mir.types[info.inst_first + j])
            j = j + 1
        }
        self.function_item(body, type_decl, &args, decl, &inst, self_type, k, info.node)
    }

    // The type declaration whose parameters a member's body names: the type
    // an extension extends, or -1 for a free function and a trait's default
    // body, which reads `Self` instead.
    func type_decl_of(&self, decl: Int) -> Int {
        let parent = self.dp.bc.mir.tc.res.decls[decl].parent
        if parent < 0 {
            return -1
        }
        if self.dp.bc.mir.tc.res.decls[parent].kind == ResDeclKind.Extension {
            return self.dp.bc.mir.tc.ext_target(parent)
        }
        return -1
    }

    // THE REQUIREMENT FUNNEL: requirement `req` called on concrete `owner`,
    // the member the owner's conformance writes, or the trait's default body
    // under `Self` = owner; a requirement met with neither, by a derivation or
    // by a builtin type's own conformance, is the member glue that
    // synthesizes it. `item` is -1 unless the answer is glue.
    // ENTRY POINTS:
    //     resolve_call
    //     render_of
    func resolve_requirement(&var self, req: Int, owner: Int, k: Int, node: Int) -> MonoTarget {
        let trait_decl = self.dp.bc.mir.tc.res.decls[req].parent
        let d = self.dp.bc.mir.tc.nominal_decl(owner)
        var c = 0
        while c < self.dp.bc.mir.tc.conformances.len() {
            let one = self.dp.bc.mir.tc.conformances[c]
            c = c + 1
            if d < 0 || one.type_decl != d || not self.dp.bc.mir.tc.trait_refines(one.trait_decl, trait_decl) {
                continue
            }
            var s = 0
            while s < one.status_count {
                let status = self.dp.bc.mir.tc.statuses[one.status_first + s]
                s = s + 1
                if status.requirement != req {
                    continue
                }
                if status.kind == TcStatusKind.Written {
                    return MonoTarget(decl: status.member, self_type: -1, item: -1)
                }
                if status.kind == TcStatusKind.Default {
                    return MonoTarget(decl: req, self_type: owner, item: -1)
                }
                if status.kind == TcStatusKind.Synthesized || status.kind == TcStatusKind.Implicit {
                    return self.glued(req, owner, k, node)
                }
            }
        }
        if d >= 0 && self.dp.bc.mir.tc.primitive_grants(d, trait_decl) {
            if (self.dp.bc.mir.tc.sigs[req].flags & TC_FLAG_DEFAULT_BODY) != 0 {
                return MonoTarget(decl: req, self_type: owner, item: -1)
            }
            return self.glued(req, owner, k, node)
        }
        var msg = StringBuilder()
        try! msg.append("a call of `")
        try! msg.append(self.dp.bc.mir.tc.target_text(req))
        try! msg.append("` on `")
        try! msg.append(self.dp.bc.mir.tc.type_text(owner))
        try! msg.append("`, which no conformance of it meets, is not in the backend slice yet")
        self.refuse(node, "mono.not-yet", msg.build())
        MonoTarget(decl: -1, self_type: -1, item: -1)
    }

    // The member glue of `req` on `owner` as a call target, or a refused one
    // when glue for it is not in the slice.
    func glued(&var self, req: Int, owner: Int, k: Int, node: Int) -> MonoTarget {
        let item = self.member_glue_of(req, owner, k, node)
        if item < 0 {
            return MonoTarget(decl: -1, self_type: -1, item: -1)
        }
        MonoTarget(decl: req, self_type: -1, item: item)
    }

    // THE MEMBER GLUE FUNNEL: the glue that synthesizes requirement `req` for
    // concrete type `t`, made when new; -1 when refused. In the slice: a signed
    // integer's `Printable.format`, its decimal digits.
    // ENTRY POINTS:
    //     glued
    public func member_glue_of(&var self, req: Int, t: Int, origin: Int, node: Int) -> Int {
        var at = self.by_key.first(t, MONO_KEY_MEMBER)
        while at >= 0 {
            let found = self.by_key.value(at)
            if self.items[found].decl == req {
                return found
            }
            at = self.by_key.following(at)
        }
        if not self.integer_format(req, t) {
            var msg = StringBuilder()
            try! msg.append("a synthesized `")
            try! msg.append(self.dp.bc.mir.tc.target_text(req))
            try! msg.append("` on `")
            try! msg.append(self.dp.bc.mir.tc.type_text(t))
            try! msg.append("` is not in the backend slice yet: only a signed integer's `Printable.format`")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: MonoItemKind.MemberGlue, source: -1, type_decl: -1, func_decl: -1,
                                      args_first: first, args_count: 0, inst_first: first, inst_count: 0,
                                      self_type: -1, glue_type: t, decl: req, body: -1, origin: origin,
                                      origin_node: node))
        self.by_key.add(t, MONO_KEY_MEMBER, k)
        k
    }

    // Whether `req` is `Printable.format` and `t` a signed integer type: the
    // new std's builder renders an `Int` and has no unsigned rendering.
    public func integer_format(&var self, req: Int, t: Int) -> Bool {
        let info = self.dp.bc.mir.tc.res.decls[req]
        let format = self.dp.bc.mir.tc.res.intern("format")
        let printable = info.parent == self.dp.bc.mir.tc.known.printable && info.name == format
        printable && self.dp.bc.mir.tc.is_integer(t) && not self.dp.bc.mir.tc.is_unsigned(t)
    }

    // `T()` on a type parameter, at a concrete `T`: in the slice, a fieldless
    // struct with no `init` of its own, whose value is nothing (an
    // allocator's).
    func check_empty_construction(&var self, c: Int) {
        let info = self.dp.bc.mir.calls[c]
        let d = self.dp.bc.mir.tc.nominal_decl(info.owner)
        let fieldless = d >= 0 && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Struct && target_struct_fields(&self.dp.bc.mir.tc, d).len() == 0
        if fieldless && not self.declares_init(d) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("constructing `")
        try! msg.append(self.dp.bc.mir.tc.type_text(info.owner))
        try! msg.append("` through a type parameter is not in the backend slice yet: only a fieldless struct with no `init`")
        self.refuse(info.node, "mono.not-yet", msg.build())
    }

    // Whether type declaration `d` has an `init` among its members.
    func declares_init(&self, d: Int) -> Bool {
        if d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return false
        }
        let first = self.dp.bc.mir.tc.member_first[d]
        var j = first
        while j < first + self.dp.bc.mir.tc.member_count[d] {
            let member = self.dp.bc.mir.tc.members[j]
            if self.dp.bc.mir.tc.res.decls[member.decl].kind == ResDeclKind.Init {
                return true
            }
            j = j + 1
        }
        false
    }

    // A format argument of `print`, `panic` or `assert`: an integer, a `Bool`
    // or a `String`, or a reference to one, the backend writes as it is; any
    // other value renders through its `Printable.format` into a fixed builder
    // over stack scratch (design 137).
    func check_format_arguments(&var self, k: Int, c: Int, name: &String) {
        let info = self.dp.bc.mir.calls[c]
        let printing = name.equals("print") || name.equals("panic") || name.equals("assert")
        if not printing {
            return
        }
        var a = 0
        while a < info.arg_count {
            let o = self.dp.bc.mir.lists[info.arg_first + a]
            let op = self.dp.bc.mir.operands[o]
            a = a + 1
            if op.kind == MirOperandKind.Const {
                continue
            }
            var t = op.ty
            let referent = self.dp.bc.mir.tc.referent(t)
            if referent >= 0 {
                t = referent
            }
            let direct = self.dp.bc.mir.tc.is_integer(t) || self.dp.bc.mir.tc.is_bool(t) || self.dp.bc.mir.tc.is_string(t)
            if not direct && not self.need_fixed_render(k, t, info.node) {
                return
            }
        }
    }

    // A value of type `t` rendered into a fixed builder over stack scratch:
    // the builder's fixed `init`, its `len()` and its drop, and `t`'s
    // rendering. False when one of them is refused.
    func need_fixed_render(&var self, k: Int, t: Int, node: Int) -> Bool {
        let builder = self.builder_type()
        if builder < 0 {
            self.refuse(node, "mono.not-yet", "a rendering with no builder role bound")
            return false
        }
        if self.builder_fixed_item < 0 {
            var labels = Vector<String>()
            try! labels.push("bytes")
            try! labels.push("capacity")
            self.builder_fixed_item = self.builder_item("init", &labels, k, node)
        }
        if self.builder_len_item < 0 {
            let none = Vector<String>()
            self.builder_len_item = self.builder_item("len", &none, k, node)
        }
        self.need_drop(k, builder, node)
        if self.builder_fixed_item < 0 || self.builder_len_item < 0 {
            return false
        }
        self.render_of(k, t, node) >= 0
    }

    // An interpolation builds a String through the growable builder: its
    // `init()`, each part's rendering, `build()`, and the builder's drop.
    func resolve_interpolation(&var self, k: Int, rv: &MirRvalue, node: Int) {
        let builder = self.builder_type()
        if builder < 0 {
            self.refuse(node, "mono.not-yet", "an interpolation with no builder role bound")
            return
        }
        let none = Vector<String>()
        if self.builder_new_item < 0 {
            self.builder_new_item = self.builder_item("init", &none, k, node)
        }
        if self.builder_build_item < 0 {
            self.builder_build_item = self.builder_item("build", &none, k, node)
        }
        self.need_drop(k, builder, node)
        var j = 0
        while j < rv.count {
            let o = self.dp.bc.mir.lists[rv.first + j]
            j = j + 1
            let op = self.dp.bc.mir.operands[o]
            if op.kind == MirOperandKind.Const && op.const_kind == MirConstKind.Placeholder {
                self.refuse(node, "mono.not-yet", "a `\{\}` slot in an interpolation is not in the backend slice yet")
                return
            }
            var t = op.ty
            let referent = self.dp.bc.mir.tc.referent(t)
            if referent >= 0 {
                t = referent
            } else if op.kind == MirOperandKind.Move {
                self.need_drop(k, t, node)
            }
            if self.render_of(k, t, node) < 0 {
                return
            }
        }
    }

    // A collection literal: its container's `init()` and its element `push`,
    // each at the literal's type; in the slice, a `Vector`. A refused `push`
    // panics naming its error, rendered as a format argument is.
    func resolve_collection_literal(&var self, k: Int, r: Int, node: Int) {
        let rv = self.dp.bc.mir.rvalues[r]
        let d = self.dp.bc.mir.tc.nominal_decl(rv.ty)
        if rv.aggregate != MirAggregate.Vector || d < 0 || d != self.dp.bc.mir.tc.known.vector {
            self.refuse(node, "mono.not-yet", "a fixed array, a repeat, a `Map` or a `Set` literal is not in the backend slice yet")
            return
        }
        let none = Vector<String>()
        var labels = Vector<String>()
        try! labels.push("value")
        let made_decl = self.member_with(d, "init", &none)
        let push_decl = self.member_with(d, "push", &labels)
        if made_decl < 0 || push_decl < 0 {
            self.refuse(node, "mono.not-yet", "a collection literal whose type has no `init()` or `push(value:)`")
            return
        }
        let made = self.member_item(k, made_decl, rv.ty, node)
        let push = self.member_item(k, push_decl, rv.ty, node)
        if made < 0 || push < 0 {
            return
        }
        self.set_literal_items(r, made, push)
        let result = self.dp.bc.mir.tc.sigs[push_decl].result
        if self.dp.bc.mir.tc.is_result(result) {
            let error = self.dp.bc.mir.tc.types.arg(result, 1)
            let _ = self.need_fixed_render(k, error, node)
        }
    }

    // THE RENDER FUNNEL: the item that formats a value of concrete type `t`
    // into the builder, `Printable.format(into:)` resolved on `t` through the
    // requirement funnel, made when new; -1 when refused.
    // ENTRY POINTS:
    //     need_fixed_render
    //     resolve_interpolation
    func render_of(&var self, k: Int, t: Int, node: Int) -> Int {
        let found = self.render_item(t)
        if found >= 0 {
            return found
        }
        let req = self.format_requirement()
        if req < 0 {
            self.refuse(node, "mono.not-yet", "a rendering with no `Printable.format` requirement")
            return -1
        }
        let target = self.resolve_requirement(req, t, k, node)
        var item = target.item
        if target.decl >= 0 && item < 0 {
            item = self.member_item_at(k, target.decl, target.self_type, t, node)
        }
        if item >= 0 {
            self.by_key.add(t, MONO_KEY_RENDER, item)
        }
        item
    }

    // The item of member `decl` called on concrete owner `owner`, as a call
    // with no type arguments of its own reaches it.
    func member_item(&var self, k: Int, decl: Int, owner: Int, node: Int) -> Int {
        self.member_item_at(k, decl, -1, owner, node)
    }

    func member_item_at(&var self, k: Int, decl: Int, self_type: Int, owner: Int, node: Int) -> Int {
        var info = self.dp.bc.mir.blank_call(MirCallKind.Function, node)
        info.target = decl
        info.owner = owner
        let body = self.body_of[decl]
        self.call_item_of(k, body, decl, self_type, &info)
    }

    // `Printable`'s `format` requirement, or -1.
    func format_requirement(&var self) -> Int {
        let printable = self.dp.bc.mir.tc.known.printable
        if printable < 0 {
            return -1
        }
        let reqs = self.dp.bc.mir.tc.members_of(printable)
        let format = self.dp.bc.mir.tc.res.intern("format")
        var j = 0
        while j < reqs.len() {
            if self.dp.bc.mir.tc.res.decls[reqs[j]].name == format {
                return reqs[j]
            }
            j = j + 1
        }
        return -1
    }

    // The builder role's type, or -1.
    func builder_type(&var self) -> Int {
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringBuilderStruct)
        if d < 0 {
            return -1
        }
        self.dp.bc.mir.tc.prim(d)
    }

    // The item of the builder's member `name` whose parameters carry `labels`.
    func builder_item(&var self, name: String, labels: &Vector<String>, k: Int, node: Int) -> Int {
        let builder = self.builder_type()
        let d = self.dp.bc.mir.tc.res.lang_item(ResLang.StringBuilderStruct)
        let decl = self.member_with(d, name, &labels)
        if decl < 0 {
            var msg = StringBuilder()
            try! msg.append("the builder role declares no `")
            try! msg.append(name)
            try! msg.append("` this rendering calls")
            self.refuse(node, "mono.not-yet", msg.build())
            return -1
        }
        self.member_item(k, decl, builder, node)
    }

    // Type declaration `d`'s member named `name` whose parameters carry
    // `labels`, in order, or -1.
    func member_with(&var self, d: Int, name: String, labels: &Vector<String>) -> Int {
        if d < 0 || d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return -1
        }
        let first = self.dp.bc.mir.tc.member_first[d]
        let count = self.dp.bc.mir.tc.member_count[d]
        let id = self.dp.bc.mir.tc.res.intern(name)
        var j = first
        while j < first + count {
            let member = self.dp.bc.mir.tc.members[j]
            j = j + 1
            if member.name != id {
                continue
            }
            let s = self.dp.bc.mir.tc.sigs[member.decl]
            if s.param_count != labels.len() {
                continue
            }
            var same = true
            var p = 0
            while p < s.param_count {
                let label = self.dp.bc.mir.tc.res.intern(labels.get(p) ?? "")
                if self.dp.bc.mir.tc.params[s.param_first + p].name != label {
                    same = false
                }
                p = p + 1
            }
            if same {
                return member.decl
            }
        }
        return -1
    }

    // The extern item of declaration `d`, one per C name: two modules
    // declaring one seam call one symbol.
    func extern_item(&var self, origin: Int, d: Int) -> Int {
        let name = self.dp.bc.mir.tc.res.decls[d].name
        let at = self.by_key.first(name, MONO_KEY_EXTERN)
        if at >= 0 {
            return self.by_key.value(at)
        }
        let k = self.items.len()
        let first = self.item_types.len()
        try! self.items.push(MonoItem(kind: MonoItemKind.Extern, source: -1, type_decl: -1, func_decl: -1,
                                      args_first: first, args_count: 0, inst_first: first, inst_count: 0,
                                      self_type: -1, glue_type: -1, decl: d, body: -1, origin: origin,
                                      origin_node: -1))
        self.by_key.add(name, MONO_KEY_EXTERN, k)
        k
    }
}
