// Glue (SL:architecture §3.7, §3.8): what a drop or a copy of a concrete type
// does, made once per type as a synthesized concrete MIR function. A drop's
// glue follows drop elaboration's resolution: the type's written `deinit`,
// then its owning parts in reverse declaration order, an enum's active
// payload by a switch on its case. A copy's glue runs only where a value of a
// type that is not trivially copyable is copied, which concrete MIR spells
// as a `copy` operand only in a generic body, and where a `copy()`
// requirement call has no written member to reach: the type's written
// `copy()` when its conformance writes one, else a memberwise rebuild whose
// parts copy by their own glue.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawmir.build.{mir_func_local}
import sawmir.model.{MirAggregate, MirCall, MirCallKind, MirConstKind, MirFunc, MirFuncKind, MirLocalKind,
                         MirOperandKind, MirProjKind, MirRvalueKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MONO_KEY_COPY, MONO_KEY_DROP, MonoItem, MonoItemKind, MonoProgram}
import sawresolve.model.{ResDeclKind}
import sawresolve.program.{ResProgram}
import sawtarget.layout.{target_enum_cases, target_member_type, target_struct_fields}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.tier.{tc_compute_tiers}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// Whether a copy of type `t` is the bits alone: a trivially copyable type, a
// reference or a slice. A function value's copy retains the environment it
// may share, so it runs its copy glue.
public func mono_copies_bitwise(tc: &var TcProgram, t: Int) -> Bool {
    if t < 0 {
        return true
    }
    let kind = tc.kind_of(t)
    if kind == TcKind.Ref || kind == TcKind.Slice {
        return true
    }
    if kind == TcKind.Func {
        return false
    }
    tc.is_trivial(t)
}

// The length of concrete array type `t`, the folded constant its type
// carries.
public func mono_array_length(tc: &TcProgram, t: Int) -> Int {
    let length = tc.types.arg(t, 0)
    tc.types.ty(length).a
}

// A requirement member glue synthesizes: `ExplicitCopy.copy()`,
// `Equatable.equals`, `Comparable.compare`, `Hashable.hash` and
// `Printable.format`, in that order.
public enum MonoHook {
    case Duplicate,
    case Equals,
    case Compare,
    case Hash,
    case Format,
    case Other
}

// A row of the member glue table: the scalars (the integers, `Bool`,
// `Float`, a raw pointer, `Void`), then the aggregates whose hooks are their
// parts' (a struct, a tuple, an enum, an Optional, a fixed array).
public enum MonoGlueKind {
    case Integer,
    case Boolean,
    case Floating,
    case Pointer,
    case Empty,
    case Struct,
    case Tuple,
    case Enum,
    case Optional,
    case Array,
    case Other
}

extension MonoProgram {
    // A synthesized function's frame: `_0` of `result`, `_1` the parameter;
    // the builder positioned in its entry block.
    func begin_glue(&var self, result: Int, param: Int) -> Int {
        let f = self.dp.bc.mir.funcs.len()
        let local_first = self.dp.bc.mir.locals.len()
        let block_first = self.dp.bc.mir.blocks.len()
        let window_first = self.dp.bc.mir.windows.len()
        try! self.dp.bc.mir.funcs.push(MirFunc(module: -1, kind: MirFuncKind.Body, decl: -1, root: -1, param: -1,
                                               parent: -1, ordinal: 0, local_first: local_first, local_count: 0,
                                               block_first: block_first, block_count: 0, param_count: 1,
                                               window_first: window_first, window_count: 0, owner: -1,
                                               refused: false, order: 0, record_first: 0, record_count: 0,
                                               record_flags_first: 0, carried_first: 0, carried_count: 0))
        self.dp.bc.mir.cur = f
        self.dp.bc.mir.local_base = local_first
        self.dp.bc.mir.block_base = block_first
        self.dp.bc.mir.at = -1
        self.dp.bc.mir.at_closing = false
        let _ = self.dp.bc.mir.new_local(result, MirLocalKind.Return, -1, -1)
        let _ = self.dp.bc.mir.new_local(param, MirLocalKind.Param, -1, -1)
        let entry = self.dp.bc.mir.new_block()
        self.dp.bc.mir.enter(entry)
        f
    }

    func finish_glue(&var self, k: Int, f: Int) {
        var info = self.dp.bc.mir.funcs[f]
        info.local_count = self.dp.bc.mir.locals.len() - info.local_first
        info.block_count = self.dp.bc.mir.blocks.len() - info.block_first
        self.dp.bc.mir.funcs[f] = info
        self.dp.bc.mir.current = -1
        var done = self.items[k]
        done.body = f
        self.items[k] = done
    }

    // `(*_1)`: the value glue's parameter refers to.
    func glue_subject(&var self, t: Int) -> Int {
        self.referent_place(1, t)
    }

    // `(*_l)`, the referent of type `t` reference local `l` holds.
    func referent_place(&var self, l: Int, t: Int) -> Int {
        let p = self.dp.bc.mir.place_local(l)
        self.dp.bc.mir.project(p, MirProjKind.Deref, -1, -1, t)
    }

    public func build_drop_glue(&var self, k: Int) {
        let t = self.items[k].glue_type
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        let param = self.dp.bc.mir.tc.mk_ref(true, t)
        let f = self.begin_glue(void_type, param)
        let d = self.dp.bc.mir.tc.nominal_decl(t)
        if d >= 0 {
            let member = self.dp.bc.mir.deinit_member(d)
            if member >= 0 {
                let decl = self.dp.bc.mir.tc.members[member].decl
                let subject = self.glue_subject(t)
                let rv = self.dp.bc.mir.rv_ref(true, subject)
                let receiver = self.dp.bc.mir.temp_of(rv)
                let op = self.dp.bc.mir.move_local(receiver)
                var args = Vector<Int>()
                try! args.push(op)
                var c = self.dp.bc.mir.blank_call(MirCallKind.Function, -1)
                c.target = decl
                c.owner = t
                c.arg_first = self.dp.bc.mir.push_args(&args)
                c.arg_count = 1
                let _ = self.dp.bc.mir.call_and_continue(c)
            }
        }
        self.drop_parts(t)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // The drops of `(*_1)`'s owning parts: a tuple's elements and a struct's
    // fields in reverse declaration order, an enum's active payload.
    func drop_parts(&var self, t: Int) {
        let info = self.dp.bc.mir.tc.types.ty(t)
        if info.kind == TcKind.Tuple {
            var j = info.count - 1
            while j >= 0 {
                let element = self.dp.bc.mir.tc.types.arg(t, j)
                if self.dp.bc.mir.owns(element) {
                    let subject = self.glue_subject(t)
                    let part = self.dp.bc.mir.project(subject, MirProjKind.Tuple, -1, j, element)
                    self.dp.bc.mir.emit_drop(part)
                }
                j = j - 1
            }
            return
        }
        if info.kind == TcKind.Array {
            self.drop_elements(t)
            return
        }
        if info.kind != TcKind.Nominal {
            return
        }
        let d = info.decl
        let kind = self.dp.bc.mir.tc.res.decls[d].kind
        if kind == ResDeclKind.Struct {
            let fields = target_struct_fields(&self.dp.bc.mir.tc, d)
            var j = fields.len() - 1
            while j >= 0 {
                let written = self.dp.bc.mir.tc.sigs[fields[j]].result
                let ft = target_member_type(&var self.dp.bc.mir.tc, t, written)
                if self.dp.bc.mir.owns(ft) {
                    let subject = self.glue_subject(t)
                    let part = self.dp.bc.mir.project(subject, MirProjKind.Field, fields[j], -1, ft)
                    self.dp.bc.mir.emit_drop(part)
                }
                j = j - 1
            }
            return
        }
        if kind == ResDeclKind.Enum {
            self.by_case(t, false)
        }
    }

    // A switch on `(*_1)`'s case, each arm either dropping the case's owning
    // payload fields in reverse order (`copying` false), or building `_0` as
    // that case of copies of them, then joining.
    func by_case(&var self, t: Int, copying: Bool) {
        let d = self.dp.bc.mir.tc.types.ty(t).decl
        let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
        let join = self.dp.bc.mir.new_block()
        var arms = Vector<Int>()
        var j = 0
        while j < cases.len() {
            try! arms.push(self.dp.bc.mir.new_block())
            j = j + 1
        }
        let subject = self.glue_subject(t)
        self.dp.bc.mir.switch_cases(subject, &cases, &arms, -1)
        j = 0
        while j < cases.len() {
            self.dp.bc.mir.enter(arms[j])
            let case_decl = cases[j]
            let s = self.dp.bc.mir.tc.sigs[case_decl]
            var types = Vector<Int>()
            var p = 0
            while p < s.param_count {
                let written = self.dp.bc.mir.tc.params[s.param_first + p].ty
                try! types.push(target_member_type(&var self.dp.bc.mir.tc, t, written))
                p = p + 1
            }
            if copying {
                var ops = Vector<Int>()
                p = 0
                while p < types.len() {
                    let base = self.glue_subject(t)
                    let part = self.dp.bc.mir.project(base, MirProjKind.Payload, case_decl, p, types[p])
                    try! ops.push(self.dp.bc.mir.op_copy(part))
                    p = p + 1
                }
                let rv = self.dp.bc.mir.rv_aggregate(MirAggregate.Case, case_decl, t, &ops)
                let result = self.dp.bc.mir.place_local(0)
                self.dp.bc.mir.assign(result, rv)
            } else {
                p = types.len() - 1
                while p >= 0 {
                    if self.dp.bc.mir.owns(types[p]) {
                        let base = self.glue_subject(t)
                        let part = self.dp.bc.mir.project(base, MirProjKind.Payload, case_decl, p, types[p])
                        self.dp.bc.mir.emit_drop(part)
                    }
                    p = p - 1
                }
            }
            self.dp.bc.mir.goto(join)
            j = j + 1
        }
        self.dp.bc.mir.enter(join)
    }

    // The drops of `(*_1)`'s elements, array type `t`, in reverse index order
    // (spec, Fixed arrays): a loop counting down, so the glue's size does not
    // grow with the length.
    func drop_elements(&var self, t: Int) {
        let element = self.dp.bc.mir.tc.types.ty(t).b
        if not self.dp.bc.mir.owns(element) {
            return
        }
        // Stage 0 workaround (SL:hazards S4): canonical: let i = self.glue_counter(mono_array_length(&self.dp.bc.mir.tc, t))
        let length = mono_array_length(&self.dp.bc.mir.tc, t)
        let i = self.glue_counter(length)
        let exit = self.dp.bc.mir.new_block()
        let head = self.glue_loop(i, ">", 0, exit)
        self.glue_step(i, "&-")
        let subject = self.glue_subject(t)
        let part = self.dp.bc.mir.project(subject, MirProjKind.Index, -1, i, element)
        self.dp.bc.mir.emit_drop(part)
        self.dp.bc.mir.goto(head)
        self.dp.bc.mir.enter(exit)
    }

    // `_0` built from `(*_1)`, array type `t`, element by element in index
    // order, each element's copy its own glue's.
    func copy_elements(&var self, t: Int) {
        let element = self.dp.bc.mir.tc.types.ty(t).b
        let i = self.glue_counter(0)
        let exit = self.dp.bc.mir.new_block()
        // Stage 0 workaround (SL:hazards S4): canonical: let head = self.glue_loop(i, "<", mono_array_length(&self.dp.bc.mir.tc, t), exit)
        let length = mono_array_length(&self.dp.bc.mir.tc, t)
        let head = self.glue_loop(i, "<", length, exit)
        let subject = self.glue_subject(t)
        let part = self.dp.bc.mir.project(subject, MirProjKind.Index, -1, i, element)
        let result = self.dp.bc.mir.place_local(0)
        let slot = self.dp.bc.mir.project(result, MirProjKind.Index, -1, i, element)
        let o = self.dp.bc.mir.op_copy(part)
        let rv = self.dp.bc.mir.rv_use(o)
        self.dp.bc.mir.assign(slot, rv)
        self.glue_step(i, "&+")
        self.dp.bc.mir.goto(head)
        self.dp.bc.mir.enter(exit)
    }

    // A fresh `Int` local of the glue being built, holding `start`.
    func glue_counter(&var self, start: Int) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        let i = self.dp.bc.mir.new_temp(int_type)
        var text = StringBuilder()
        try! text.append(start)
        let o = self.dp.bc.mir.op_const(MirConstKind.Int, text.build(), int_type)
        let rv = self.dp.bc.mir.rv_use(o)
        self.dp.bc.mir.assign_local(i, rv)
        i
    }

    // A loop's head, entered from the current block, testing `i OP bound`
    // and leaving for block `exit` once the test fails; the builder is left
    // in the loop's body, whose end goes back to the returned head.
    func glue_loop(&var self, i: Int, op: String, bound: Int, exit: Int) -> Int {
        let head = self.dp.bc.mir.new_block()
        let body = self.dp.bc.mir.new_block()
        self.dp.bc.mir.goto(head)
        self.dp.bc.mir.enter(head)
        let int_type = self.dp.bc.mir.tc.int_type()
        let bool_type = self.dp.bc.mir.tc.bool_type()
        var text = StringBuilder()
        try! text.append(bound)
        var ops = Vector<Int>()
        let counter = self.dp.bc.mir.place_local(i)
        try! ops.push(self.dp.bc.mir.op_copy(counter))
        try! ops.push(self.dp.bc.mir.op_const(MirConstKind.Int, text.build(), int_type))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, bool_type, op, &ops)
        let test = self.dp.bc.mir.temp_of(rv)
        let o = self.dp.bc.mir.move_local(test)
        self.dp.bc.mir.switch_bool(o, body, exit)
        self.dp.bc.mir.enter(body)
        head
    }

    // `i = i OP 1`, a wrapping step that cannot overflow inside the bounds.
    func glue_step(&var self, i: Int, op: String) {
        let int_type = self.dp.bc.mir.tc.int_type()
        var ops = Vector<Int>()
        let counter = self.dp.bc.mir.place_local(i)
        try! ops.push(self.dp.bc.mir.op_copy(counter))
        try! ops.push(self.dp.bc.mir.op_const(MirConstKind.Int, "1", int_type))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, int_type, op, &ops)
        self.dp.bc.mir.assign_local(i, rv)
    }

    // Whether copy glue answers a copy of concrete type `t`: a struct, an
    // enum, a tuple or an array, which `build_copy_glue` builds, or a
    // function value, whose glue the backend writes (its retain). A scalar's
    // copy is its member glue.
    public func copy_glue_builds(&var self, t: Int) -> Bool {
        let info = self.dp.bc.mir.tc.types.ty(t)
        if info.kind == TcKind.Tuple || info.kind == TcKind.Array || info.kind == TcKind.Func {
            return true
        }
        if info.kind != TcKind.Nominal {
            return false
        }
        let kind = self.dp.bc.mir.tc.res.decls[info.decl].kind
        kind == ResDeclKind.Struct || kind == ResDeclKind.Enum
    }

    public func build_copy_glue(&var self, k: Int) {
        let t = self.items[k].glue_type
        let param = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_glue(t, param)
        let info = self.dp.bc.mir.tc.types.ty(t)
        let hook = self.copy_member(t)
        if hook >= 0 {
            let subject = self.glue_subject(t)
            let rv = self.dp.bc.mir.rv_ref(false, subject)
            let receiver = self.dp.bc.mir.temp_of(rv)
            let op = self.dp.bc.mir.move_local(receiver)
            var args = Vector<Int>()
            try! args.push(op)
            var c = self.dp.bc.mir.blank_call(MirCallKind.Function, -1)
            c.target = hook
            c.owner = t
            c.arg_first = self.dp.bc.mir.push_args(&args)
            c.arg_count = 1
            c.dest = self.dp.bc.mir.place_local(0)
            let _ = self.dp.bc.mir.call_and_continue(c)
        } else if info.kind == TcKind.Tuple {
            var ops = Vector<Int>()
            var j = 0
            while j < info.count {
                let element = self.dp.bc.mir.tc.types.arg(t, j)
                let subject = self.glue_subject(t)
                let part = self.dp.bc.mir.project(subject, MirProjKind.Tuple, -1, j, element)
                try! ops.push(self.dp.bc.mir.op_copy(part))
                j = j + 1
            }
            let rv = self.dp.bc.mir.rv_aggregate(MirAggregate.Tuple, -1, t, &ops)
            let result = self.dp.bc.mir.place_local(0)
            self.dp.bc.mir.assign(result, rv)
        } else if info.kind == TcKind.Nominal && self.dp.bc.mir.tc.res.decls[info.decl].kind == ResDeclKind.Struct {
            let fields = target_struct_fields(&self.dp.bc.mir.tc, info.decl)
            var ops = Vector<Int>()
            var j = 0
            while j < fields.len() {
                let written = self.dp.bc.mir.tc.sigs[fields[j]].result
                let ft = target_member_type(&var self.dp.bc.mir.tc, t, written)
                let subject = self.glue_subject(t)
                let part = self.dp.bc.mir.project(subject, MirProjKind.Field, fields[j], -1, ft)
                try! ops.push(self.dp.bc.mir.op_copy(part))
                j = j + 1
            }
            let rv = self.dp.bc.mir.rv_aggregate(MirAggregate.Struct, info.decl, t, &ops)
            let result = self.dp.bc.mir.place_local(0)
            self.dp.bc.mir.assign(result, rv)
        } else if info.kind == TcKind.Nominal && self.dp.bc.mir.tc.res.decls[info.decl].kind == ResDeclKind.Enum {
            self.by_case(t, true)
        } else if info.kind == TcKind.Array {
            self.copy_elements(t)
        } else {
            var msg = StringBuilder()
            try! msg.append("a copy of `")
            try! msg.append(self.dp.bc.mir.tc.type_text(t))
            try! msg.append("` is not in the backend slice yet")
            self.refuse(-1, "mono.not-yet", msg.build())
        }
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // The hook requirement `req` names; `Other` for one no member glue
    // answers.
    public func hook_of(&var self, req: Int) -> MonoHook {
        let info = self.dp.bc.mir.tc.res.decls[req]
        let k = self.dp.bc.mir.tc.known
        let name = self.dp.bc.mir.tc.res.name_text(info.name)
        if info.parent == k.explicit_copy && name.equals("copy") {
            return MonoHook.Duplicate
        }
        if info.parent == k.equatable && name.equals("equals") {
            return MonoHook.Equals
        }
        if info.parent == k.comparable && name.equals("compare") {
            return MonoHook.Compare
        }
        if info.parent == k.hashable && name.equals("hash") {
            return MonoHook.Hash
        }
        if info.parent == k.printable && name.equals("format") {
            return MonoHook.Format
        }
        MonoHook.Other
    }

    // Whether requirement `req` is a hook whose answer on an aggregate is
    // its parts': `equals`, `compare` or `hash`.
    public func structural_hook(&var self, req: Int) -> Bool {
        let hook = self.hook_of(req)
        hook == MonoHook.Equals || hook == MonoHook.Compare || hook == MonoHook.Hash
    }

    // Whether requirement `req` is the `copy()` of `Copy` or `ExplicitCopy`.
    public func copy_hook(&var self, req: Int) -> Bool {
        let info = self.dp.bc.mir.tc.res.decls[req]
        let k = self.dp.bc.mir.tc.known
        let policy = info.parent == k.copy || info.parent == k.explicit_copy
        policy && self.dp.bc.mir.tc.res.name_text(info.name).equals("copy")
    }

    // The member glue table's row for concrete type `t`; `Other` for a type
    // no row holds.
    public func glue_kind(&var self, t: Int) -> MonoGlueKind {
        if self.dp.bc.mir.tc.is_integer(t) {
            return MonoGlueKind.Integer
        }
        if self.dp.bc.mir.tc.is_bool(t) {
            return MonoGlueKind.Boolean
        }
        if self.dp.bc.mir.tc.is_float(t) {
            return MonoGlueKind.Floating
        }
        if self.dp.bc.mir.raw_pointer(t) {
            return MonoGlueKind.Pointer
        }
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        if t == void_type {
            return MonoGlueKind.Empty
        }
        let info = self.dp.bc.mir.tc.types.ty(t)
        if info.kind == TcKind.Tuple {
            return MonoGlueKind.Tuple
        }
        if info.kind == TcKind.Array {
            return MonoGlueKind.Array
        }
        if info.kind != TcKind.Nominal {
            return MonoGlueKind.Other
        }
        if info.decl == self.dp.bc.mir.tc.known.optional {
            return MonoGlueKind.Optional
        }
        let kind = self.dp.bc.mir.tc.res.decls[info.decl].kind
        if kind == ResDeclKind.Struct {
            return MonoGlueKind.Struct
        }
        if kind == ResDeclKind.Enum {
            return MonoGlueKind.Enum
        }
        MonoGlueKind.Other
    }

    // THE MEMBER GLUE TABLE: why member glue does not synthesize requirement
    // `req` on concrete type `t`, or "" when it does. A row is a glue kind, a
    // column a hook. A scalar's cell is lowered where the spec grants the kind
    // that builtin conformance (Equality, Ordering, Hashing, the Copy family)
    // and the backend lowers the kind's values. An aggregate's `equals`,
    // `compare` and `hash` are its parts' hooks, where the spec grants the
    // trait: by a written `@synthesize`, automatically (a trivial struct's or
    // a payload-free enum's `Equatable` and `Hashable`), or through the parts
    // (a tuple's, an Optional's or a fixed array's `Equatable` and
    // `Hashable`). Every other cell says what it lacks.
    // ENTRY POINTS:
    //     member_glue_of
    //     build_member_glue
    public func member_refusal(&var self, req: Int, t: Int) -> String {
        let hook = self.hook_of(req)
        let kind = self.glue_kind(t)
        let other = "only a scalar's builtin hooks and an aggregate's `equals`, `compare` and `hash`"
        if hook == MonoHook.Other {
            return other
        }
        match kind {
            case Integer -> "",
            case Boolean -> {
                if hook == MonoHook.Compare {
                    return "the spec gives `Bool` no builtin `Comparable` (SL-715)"
                }
                ""
            },
            case Floating -> {
                if hook == MonoHook.Format {
                    return "a Float's `format` waits for `std.float`'s formatter (SL-722 U5)"
                }
                ""
            },
            case Pointer -> {
                if hook == MonoHook.Duplicate {
                    return ""
                }
                if hook == MonoHook.Equals {
                    return "the spec gives a raw pointer no builtin `Equatable` (SL-715)"
                }
                other
            },
            case Empty -> {
                if hook == MonoHook.Duplicate {
                    return ""
                }
                other
            },
            case Struct -> self.nominal_refusal(req, t, false),
            case Enum -> self.nominal_refusal(req, t, true),
            case Tuple -> self.composite_refusal(hook, "a tuple"),
            case Optional -> self.composite_refusal(hook, "an Optional"),
            case Array -> self.composite_refusal(hook, "a fixed array"),
            case Other -> other
        }
    }

    // A struct's or an enum's cell: a written conformance's derivation, or
    // the automatic `Equatable` and `Hashable` of a trivially copyable struct
    // or a payload-free enum, which no conformance writes.
    func nominal_refusal(&var self, req: Int, t: Int, choice: Bool) -> String {
        if not self.structural_hook(req) {
            return "only a scalar's builtin hooks and an aggregate's `equals`, `compare` and `hash`"
        }
        let d = self.dp.bc.mir.tc.nominal_decl(t)
        let trait_decl = self.dp.bc.mir.tc.res.decls[req].parent
        if self.declares_trait(d, trait_decl) {
            return ""
        }
        if self.hook_of(req) == MonoHook.Compare {
            return "the spec gives a struct or an enum `Comparable` only through a written conformance"
        }
        if choice && self.has_payload(d) {
            return "the spec gives a payload-carrying enum no automatic `Equatable` or `Hashable`"
        }
        ""
    }

    // A tuple's, an Optional's or a fixed array's cell, named `what`: the
    // spec grants `Equatable` and `Hashable` through the parts, and nothing
    // grants `Comparable`.
    func composite_refusal(&var self, hook: MonoHook, what: String) -> String {
        if hook == MonoHook.Equals || hook == MonoHook.Hash {
            return ""
        }
        if hook == MonoHook.Compare {
            var msg = StringBuilder()
            try! msg.append("the spec gives ")
            try! msg.append(what)
            try! msg.append(" no `Comparable` (SL-754)")
            return msg.build()
        }
        "only a scalar's builtin hooks and an aggregate's `equals`, `compare` and `hash`"
    }

    // Whether type declaration `d` declares a conformance to trait `tr`.
    func declares_trait(&self, d: Int, tr: Int) -> Bool {
        var k = 0
        while k < self.dp.bc.mir.tc.conformances.len() {
            let c = self.dp.bc.mir.tc.conformances[k]
            if c.type_decl == d && c.trait_decl == tr {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether enum declaration `d` has a case carrying a payload.
    func has_payload(&self, d: Int) -> Bool {
        let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
        var k = 0
        while k < cases.len() {
            if self.dp.bc.mir.tc.sigs[cases[k]].param_count > 0 {
                return true
            }
            k = k + 1
        }
        false
    }

    // THE MEMBER GLUE BUILDER: member glue item `k`'s body, its requirement's
    // hook lowered for its type, a cell the member glue table admits. A
    // scalar's hook is computed in place; an aggregate's calls each part's
    // hook as a requirement call, which the requirement funnel resolves like
    // any other, so a part's hook is whatever answers it: a written member,
    // a default body, or member glue again. Each builder states what it
    // computes; every one matches Stage 0's answer.
    // ENTRY POINTS:
    //     instantiate
    public func build_member_glue(&var self, k: Int) {
        let t = self.items[k].glue_type
        let req = self.items[k].decl
        let why = self.member_refusal(req, t)
        if why.len() > 0 {
            try! self.problems.push("member glue was made for a cell the member glue table refuses")
            return
        }
        let kind = self.glue_kind(t)
        let aggregate = kind == MonoGlueKind.Struct || kind == MonoGlueKind.Tuple || kind == MonoGlueKind.Enum || kind == MonoGlueKind.Optional || kind == MonoGlueKind.Array
        if aggregate {
            match self.hook_of(req) {
                case Equals -> self.build_parts_equals(k, t, req, kind),
                case Compare -> self.build_parts_compare(k, t, req, kind),
                case Hash -> self.build_parts_hash(k, t, req, kind),
                case _ -> try! self.problems.push("member glue was made for an aggregate's non-structural hook")
            }
            return
        }
        match self.hook_of(req) {
            case Duplicate -> self.build_scalar_copy(k, t),
            case Equals -> self.build_scalar_equals(k, t),
            case Compare -> self.build_scalar_compare(k, t, req),
            case Hash -> self.build_scalar_hash(k, t, req),
            case Format -> self.build_scalar_format(k, t, req),
            case Other -> try! self.problems.push("member glue was made for no hook")
        }
    }

    // A hook's frame: `_0` of `result`, `_1` the `&t` receiver and, when
    // `second` is not -1, `_2` a parameter of type `second`.
    func begin_hook(&var self, result: Int, t: Int, second: Int) -> Int {
        let receiver = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_glue(result, receiver)
        if second >= 0 {
            let _ = self.dp.bc.mir.new_local(second, MirLocalKind.Param, -1, -1)
            var info = self.dp.bc.mir.funcs[f]
            info.param_count = 2
            self.dp.bc.mir.funcs[f] = info
        }
        f
    }

    // A copy of `(*_l)`, a referent of type `t`.
    func referent_copy(&var self, l: Int, t: Int) -> Int {
        let p = self.dp.bc.mir.place_local(l)
        let subject = self.dp.bc.mir.project(p, MirProjKind.Deref, -1, -1, t)
        self.dp.bc.mir.op_copy(subject)
    }

    // `_0 = op`, then the return.
    func return_value(&var self, k: Int, f: Int, op: Int) {
        let rv = self.dp.bc.mir.rv_use(op)
        let result = self.dp.bc.mir.place_local(0)
        self.dp.bc.mir.assign(result, rv)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `copy()`: the value itself, which a scalar copies bitwise.
    func build_scalar_copy(&var self, k: Int, t: Int) {
        let f = self.begin_hook(t, t, -1)
        let value = self.referent_copy(1, t)
        self.return_value(k, f, value)
    }

    // The Bool temp holding `(*_1) op (*_2)`, compared at `t`'s signedness.
    func compared(&var self, op: String, t: Int) -> Int {
        let bool_type = self.dp.bc.mir.tc.bool_type()
        var ops = Vector<Int>()
        try! ops.push(self.referent_copy(1, t))
        try! ops.push(self.referent_copy(2, t))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, bool_type, op, &ops)
        self.dp.bc.mir.temp_of(rv)
    }

    // `equals(other:)`: `==` of the two referents.
    func build_scalar_equals(&var self, k: Int, t: Int) {
        let bool_type = self.dp.bc.mir.tc.bool_type()
        let other = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_hook(bool_type, t, other)
        let same = self.compared("==", t)
        let value = self.dp.bc.mir.move_local(same)
        self.return_value(k, f, value)
    }

    // `compare(other:)`: `Less` when `<` holds. Then an integer is `Equal`
    // when `==` holds, else `Greater`; a Float is `Greater` when `>` holds,
    // else `Equal`, so a pair a NaN leaves unordered is `Equal`, never
    // `Greater`, as Stage 0 answers.
    func build_scalar_compare(&var self, k: Int, t: Int, req: Int) {
        let ordering = self.dp.bc.mir.tc.sigs[req].result
        let other = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_hook(ordering, t, other)
        let less = self.dp.bc.mir.new_block()
        let rest = self.dp.bc.mir.new_block()
        let equal = self.dp.bc.mir.new_block()
        let greater = self.dp.bc.mir.new_block()
        let join = self.dp.bc.mir.new_block()
        let below = self.compared("<", t)
        let below_op = self.dp.bc.mir.move_local(below)
        self.dp.bc.mir.switch_bool(below_op, less, rest)
        self.dp.bc.mir.enter(rest)
        if self.dp.bc.mir.tc.is_float(t) {
            let above = self.compared(">", t)
            let above_op = self.dp.bc.mir.move_local(above)
            self.dp.bc.mir.switch_bool(above_op, greater, equal)
        } else {
            let same = self.compared("==", t)
            let same_op = self.dp.bc.mir.move_local(same)
            self.dp.bc.mir.switch_bool(same_op, equal, greater)
        }
        self.ordering_arm(less, ordering, "Less", join)
        self.ordering_arm(equal, ordering, "Equal", join)
        self.ordering_arm(greater, ordering, "Greater", join)
        self.dp.bc.mir.enter(join)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // Block `b`: `_0` is `ordering`'s case `name`, then `join`.
    func ordering_arm(&var self, b: Int, ordering: Int, name: String, join: Int) {
        self.dp.bc.mir.enter(b)
        let d = self.dp.bc.mir.tc.nominal_decl(ordering)
        let id = self.dp.bc.mir.tc.res.intern(name)
        let case_decl = self.dp.bc.mir.tc.case_named(d, id)
        let none = Vector<Int>()
        let rv = self.dp.bc.mir.rv_aggregate(MirAggregate.Case, case_decl, ordering, &none)
        let result = self.dp.bc.mir.place_local(0)
        self.dp.bc.mir.assign(result, rv)
        self.dp.bc.mir.goto(join)
    }

    // `hash(h:)`: the value's bits fed to the hasher's `write_int(n:)` as an
    // `Int`, a narrow value zero-extended whatever its sign, a Bool as 1 or 0
    // and a Float as `float_word` reads it, which are the words Stage 0
    // feeds.
    func build_scalar_hash(&var self, k: Int, t: Int, req: Int) {
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        let s = self.dp.bc.mir.tc.sigs[req]
        let into = self.dp.bc.mir.tc.params[s.param_first].ty
        let f = self.begin_hook(void_type, t, into)
        let hasher = self.dp.bc.mir.tc.referent(into)
        let write = self.glue_member(hasher, "write_int", "n")
        if write < 0 {
            self.refuse(-1, "mono.not-yet", "a scalar's `Hashable.hash` with no `write_int(n:)` on the hasher")
            self.dp.bc.mir.ret()
            self.finish_glue(k, f)
            return
        }
        var value = -1
        if self.dp.bc.mir.tc.is_bool(t) {
            value = self.bool_word(t)
        } else if self.dp.bc.mir.tc.is_float(t) {
            value = self.float_word(t)
        } else {
            let bits = self.referent_copy(1, t)
            value = self.hash_word(bits, t)
        }
        let _ = self.call_member(write, hasher, value)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `(*_1)`, a Bool, as the `Int` 1 or 0.
    func bool_word(&var self, t: Int) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        let word = self.dp.bc.mir.new_temp(int_type)
        let yes = self.dp.bc.mir.new_block()
        let no = self.dp.bc.mir.new_block()
        let join = self.dp.bc.mir.new_block()
        let flag = self.referent_copy(1, t)
        self.dp.bc.mir.switch_bool(flag, yes, no)
        self.set_word(yes, word, "1", join)
        self.set_word(no, word, "0", join)
        self.dp.bc.mir.enter(join)
        self.dp.bc.mir.move_local(word)
    }

    // `(*_1)`, a Float, as an `Int`: 0 when it equals `0.0`, so `-0.0`
    // hashes as `0.0` does, else its bits, a NaN's unnormalized. The bits are
    // read through the address `_1` already holds, as `to_bits` reads them,
    // so the word needs no conversion the backend lacks.
    func float_word(&var self, t: Int) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        let bool_type = self.dp.bc.mir.tc.bool_type()
        let word = self.dp.bc.mir.new_temp(int_type)
        let zero = self.dp.bc.mir.new_block()
        let bits = self.dp.bc.mir.new_block()
        let join = self.dp.bc.mir.new_block()
        var test = Vector<Int>()
        try! test.push(self.referent_copy(1, t))
        try! test.push(self.dp.bc.mir.op_const(MirConstKind.Float, "0.0", t))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, bool_type, "==", &test)
        let is_zero = self.dp.bc.mir.temp_of(rv)
        let is_zero_op = self.dp.bc.mir.move_local(is_zero)
        self.dp.bc.mir.switch_bool(is_zero_op, zero, bits)
        self.set_word(zero, word, "0", join)
        self.dp.bc.mir.enter(bits)
        var targs = Vector<Int>()
        try! targs.push(int_type)
        let pointer_decl = self.dp.bc.mir.tc.known.unsafe_pointer
        let pointer = self.dp.bc.mir.tc.mk_nominal(pointer_decl, &targs)
        let receiver = self.dp.bc.mir.place_local(1)
        let address = self.dp.bc.mir.op_copy(receiver)
        let cast = self.dp.bc.mir.rv_one(MirRvalueKind.Cast, pointer, "", address)
        let at = self.dp.bc.mir.temp_of(cast)
        let read = self.referent_copy(at, int_type)
        let read_rv = self.dp.bc.mir.rv_use(read)
        let p = self.dp.bc.mir.place_local(word)
        self.dp.bc.mir.assign(p, read_rv)
        self.dp.bc.mir.goto(join)
        self.dp.bc.mir.enter(join)
        self.dp.bc.mir.move_local(word)
    }

    // Block `b`: `Int` local `word` is `text`, then `join`.
    func set_word(&var self, b: Int, word: Int, text: String, join: Int) {
        self.dp.bc.mir.enter(b)
        let int_type = self.dp.bc.mir.tc.int_type()
        let one = self.dp.bc.mir.op_const(MirConstKind.Int, text, int_type)
        let rv = self.dp.bc.mir.rv_use(one)
        let p = self.dp.bc.mir.place_local(word)
        self.dp.bc.mir.assign(p, rv)
        self.dp.bc.mir.goto(join)
    }

    // Operand `value`, an integer of type `t`, as the `Int` of its bits: the
    // platform pair and the 64-bit widths as they are, a narrower width
    // zero-extended.
    func hash_word(&var self, value: Int, t: Int) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        if t == int_type {
            return value
        }
        let width = self.dp.bc.mir.tc.int_width(t)
        if self.dp.bc.mir.tc.is_unsigned(t) && width == 64 {
            return self.to_int(value, "from(truncating:)")
        }
        let widened = self.to_int(value, "")
        if self.dp.bc.mir.tc.is_unsigned(t) || width == 64 {
            return widened
        }
        var mask = "255"
        if width == 16 {
            mask = "65535"
        } else if width == 32 {
            mask = "4294967295"
        }
        var ops = Vector<Int>()
        try! ops.push(widened)
        try! ops.push(self.dp.bc.mir.op_const(MirConstKind.Int, mask, int_type))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, int_type, "&", &ops)
        let low = self.dp.bc.mir.temp_of(rv)
        self.dp.bc.mir.move_local(low)
    }

    // Integer operand `value` as an `Int`: the implicit widening when `word`
    // is "", else the conversion `word` spells.
    func to_int(&var self, value: Int, word: String) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        var rv = -1
        if word.len() == 0 {
            rv = self.dp.bc.mir.rv_one(MirRvalueKind.Widen, int_type, "", value)
        } else {
            rv = self.dp.bc.mir.rv_one(MirRvalueKind.Conversion, int_type, word, value)
        }
        let l = self.dp.bc.mir.temp_of(rv)
        self.dp.bc.mir.move_local(l)
    }

    // `format(into:)`: a Bool's `true` or `false`, an integer's decimal
    // digits, each appended through the builder. An unsigned 64-bit value
    // past `Int.max` is no `Int`, so it is appended as its quotient by ten,
    // when not zero, then its last digit. An append fails only for a
    // growable builder's refused growth, which panics as `try!` does.
    func build_scalar_format(&var self, k: Int, t: Int, req: Int) {
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        let s = self.dp.bc.mir.tc.sigs[req]
        let into = self.dp.bc.mir.tc.params[s.param_first].ty
        let f = self.begin_hook(void_type, t, into)
        let builder = self.dp.bc.mir.tc.referent(into)
        let digits = self.glue_member(builder, "append", "value")
        let text = self.glue_member(builder, "append", "s")
        if digits < 0 || text < 0 {
            self.refuse(-1, "mono.not-yet", "a scalar's `Printable.format` with no `append(value: Int)` or `append(s:)` on the builder")
            self.dp.bc.mir.ret()
            self.finish_glue(k, f)
            return
        }
        if self.dp.bc.mir.tc.is_bool(t) {
            self.append_bool(t, text, builder)
        } else if self.dp.bc.mir.tc.is_unsigned(t) && self.dp.bc.mir.tc.int_width(t) == 64 {
            self.append_wide_unsigned(t, digits, builder)
        } else {
            let value = self.referent_copy(1, t)
            let int_type = self.dp.bc.mir.tc.int_type()
            if t == int_type {
                self.append_checked(digits, builder, value)
            } else {
                let wide = self.to_int(value, "")
                self.append_checked(digits, builder, wide)
            }
        }
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `true` or `false` by `(*_1)`, appended through `text`.
    func append_bool(&var self, t: Int, text: Int, builder: Int) {
        let yes = self.dp.bc.mir.new_block()
        let no = self.dp.bc.mir.new_block()
        let join = self.dp.bc.mir.new_block()
        let flag = self.referent_copy(1, t)
        self.dp.bc.mir.switch_bool(flag, yes, no)
        self.append_word(yes, text, builder, "\"true\"", join)
        self.append_word(no, text, builder, "\"false\"", join)
        self.dp.bc.mir.enter(join)
    }

    // Block `b`: String literal `spelling` appended through `text`, then
    // `join`.
    func append_word(&var self, b: Int, text: Int, builder: Int, spelling: String, join: Int) {
        self.dp.bc.mir.enter(b)
        let string_type = self.dp.bc.mir.tc.string_type()
        let word = self.dp.bc.mir.op_const(MirConstKind.String, spelling, string_type)
        self.append_checked(text, builder, word)
        self.dp.bc.mir.goto(join)
    }

    // An unsigned 64-bit `(*_1)` in decimal: its quotient by ten, when that
    // is not zero, then its remainder, each of which is an `Int`.
    func append_wide_unsigned(&var self, t: Int, digits: Int, builder: Int) {
        let bool_type = self.dp.bc.mir.tc.bool_type()
        let quotient = self.by_ten("/", t)
        let remainder = self.by_ten("%", t)
        var test = Vector<Int>()
        let q = self.dp.bc.mir.place_local(quotient)
        try! test.push(self.dp.bc.mir.op_copy(q))
        try! test.push(self.dp.bc.mir.op_const(MirConstKind.Int, "0", t))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, bool_type, "!=", &test)
        let more = self.dp.bc.mir.temp_of(rv)
        let lead = self.dp.bc.mir.new_block()
        let last = self.dp.bc.mir.new_block()
        let more_op = self.dp.bc.mir.move_local(more)
        self.dp.bc.mir.switch_bool(more_op, lead, last)
        self.dp.bc.mir.enter(lead)
        let lead_value = self.dp.bc.mir.move_local(quotient)
        let lead_int = self.to_int(lead_value, "from(truncating:)")
        self.append_checked(digits, builder, lead_int)
        self.dp.bc.mir.goto(last)
        self.dp.bc.mir.enter(last)
        let last_value = self.dp.bc.mir.move_local(remainder)
        let last_int = self.to_int(last_value, "from(truncating:)")
        self.append_checked(digits, builder, last_int)
    }

    // The temp holding `(*_1) op 10` at `t`.
    func by_ten(&var self, op: String, t: Int) -> Int {
        var ops = Vector<Int>()
        try! ops.push(self.referent_copy(1, t))
        try! ops.push(self.dp.bc.mir.op_const(MirConstKind.Int, "10", t))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, t, op, &ops)
        self.dp.bc.mir.temp_of(rv)
    }

    // `append` member `append` called on the builder `_2` refers to with
    // `value`, its `Result` forced as `try!` forces one.
    func append_checked(&var self, append: Int, builder: Int, value: Int) {
        let status = self.call_member(append, builder, value)
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        let ok = self.dp.bc.mir.result_case("Ok")
        let whole = self.dp.bc.mir.place_local(status)
        let payload = self.dp.bc.mir.project(whole, MirProjKind.Force, ok, 0, void_type)
        let checked = self.dp.bc.mir.op_copy(payload)
        let rv = self.dp.bc.mir.rv_use(checked)
        let _ = self.dp.bc.mir.temp_of(rv)
    }

    // Member `member` of `owner` called on the receiver `_2` refers to with
    // `value`; returns the temp its result lands in.
    func call_member(&var self, member: Int, owner: Int, value: Int) -> Int {
        let target = self.dp.bc.mir.place_local(2)
        var args = Vector<Int>()
        try! args.push(self.dp.bc.mir.op_copy(target))
        try! args.push(value)
        let result = self.dp.bc.mir.tc.sigs[member].result
        let status = self.dp.bc.mir.new_temp(result)
        var c = self.dp.bc.mir.blank_call(MirCallKind.Function, -1)
        c.target = member
        c.owner = owner
        c.arg_first = self.dp.bc.mir.push_args(&args)
        c.arg_count = 2
        c.dest = self.dp.bc.mir.place_local(status)
        let _ = self.dp.bc.mir.call_and_continue(c)
        status
    }

    // The member of type `t` named `name` taking one parameter labelled
    // `label`, the `Int` one where several share the label, or -1: a member
    // of its declaration's table that belongs to `t` (`extension_applies`).
    func glue_member(&var self, t: Int, name: String, label: String) -> Int {
        let d = self.dp.bc.mir.tc.nominal_decl(t)
        if d < 0 || d >= self.dp.bc.mir.tc.member_first.len() || self.dp.bc.mir.tc.member_first[d] < 0 {
            return -1
        }
        let first = self.dp.bc.mir.tc.member_first[d]
        let count = self.dp.bc.mir.tc.member_count[d]
        let name_id = self.dp.bc.mir.tc.res.intern(name)
        let label_id = self.dp.bc.mir.tc.res.intern(label)
        let int_type = self.dp.bc.mir.tc.int_type()
        var found = -1
        var j = first
        while j < first + count {
            let member = self.dp.bc.mir.tc.members[j]
            j = j + 1
            if member.name != name_id || not self.dp.bc.mir.tc.extension_applies(member.ext, t) {
                continue
            }
            let s = self.dp.bc.mir.tc.sigs[member.decl]
            if s.param_count != 1 || self.dp.bc.mir.tc.params[s.param_first].name != label_id {
                continue
            }
            if found < 0 || self.dp.bc.mir.tc.params[s.param_first].ty == int_type {
                found = member.decl
            }
        }
        found
    }

    // The `copy()` type `t`'s copy-policy conformance writes, or -1.
    func copy_member(&var self, t: Int) -> Int {
        self.dp.bc.mir.declared_copy(t)
    }
}

// An aggregate's member glue: each hook asks its parts' hooks in turn.
extension MonoProgram {
    // `equals(other:)` on an aggregate: `true` exactly when every part's
    // `equals` holds, asked in declaration order (a fixed array's in index
    // order) and stopping at the first that does not; an enum's or an
    // Optional's case first, then the payload of the case both hold.
    func build_parts_equals(&var self, k: Int, t: Int, req: Int, kind: MonoGlueKind) {
        let bool_type = self.dp.bc.mir.tc.bool_type()
        let other = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_hook(bool_type, t, other)
        let same = self.dp.bc.mir.new_block()
        let differ = self.dp.bc.mir.new_block()
        let done = self.dp.bc.mir.new_block()
        if kind == MonoGlueKind.Struct || kind == MonoGlueKind.Tuple {
            var decls = Vector<Int>()
            var types = Vector<Int>()
            self.record_parts(t, &var decls, &var types)
            var j = 0
            while j < types.len() {
                let a = self.record_part(1, t, j, decls[j], types[j])
                let b = self.record_part(2, t, j, decls[j], types[j])
                self.equal_or(k, req, types[j], a, b, differ)
                j = j + 1
            }
            self.dp.bc.mir.goto(same)
        } else if kind == MonoGlueKind.Array {
            let element = self.dp.bc.mir.tc.types.ty(t).b
            let i = self.glue_counter(0)
            // Stage 0 workaround (SL:hazards S4): canonical: let head = self.glue_loop(i, "<", mono_array_length(&self.dp.bc.mir.tc, t), same)
            let length = mono_array_length(&self.dp.bc.mir.tc, t)
            let head = self.glue_loop(i, "<", length, same)
            let a = self.element_part(1, t, i, element)
            let b = self.element_part(2, t, i, element)
            self.equal_or(k, req, element, a, b, differ)
            self.glue_step(i, "&+")
            self.dp.bc.mir.goto(head)
        } else {
            let d = self.dp.bc.mir.tc.nominal_decl(t)
            let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
            var arms = Vector<Int>()
            var j = 0
            while j < cases.len() {
                try! arms.push(self.dp.bc.mir.new_block())
                j = j + 1
            }
            let subject = self.referent_place(1, t)
            self.dp.bc.mir.switch_cases(subject, &cases, &arms, -1)
            j = 0
            while j < cases.len() {
                self.dp.bc.mir.enter(arms[j])
                let both = self.dp.bc.mir.new_block()
                var one = Vector<Int>()
                try! one.push(cases[j])
                var to = Vector<Int>()
                try! to.push(both)
                let second = self.referent_place(2, t)
                self.dp.bc.mir.switch_cases(second, &one, &to, differ)
                self.dp.bc.mir.enter(both)
                let types = self.payload_types(t, cases[j])
                var p = 0
                while p < types.len() {
                    let a = self.payload_part(1, t, cases[j], p, types[p])
                    let b = self.payload_part(2, t, cases[j], p, types[p])
                    self.equal_or(k, req, types[p], a, b, differ)
                    p = p + 1
                }
                self.dp.bc.mir.goto(same)
                j = j + 1
            }
        }
        self.bool_arm(same, "true", done)
        self.bool_arm(differ, "false", done)
        self.dp.bc.mir.enter(done)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `equals` of the parts at places `a` and `b`, of type `pt`: on to a new
    // block, where the builder is left, when it holds, else to `differ`.
    func equal_or(&var self, k: Int, req: Int, pt: Int, a: Int, b: Int, differ: Int) {
        let other = self.borrow_of(b)
        let answer = self.part_hook(k, req, pt, a, other)
        let next = self.dp.bc.mir.new_block()
        let o = self.dp.bc.mir.move_local(answer)
        self.dp.bc.mir.switch_bool(o, next, differ)
        self.dp.bc.mir.enter(next)
    }

    // Block `b`: `_0` is the Bool `text`, then `join`.
    func bool_arm(&var self, b: Int, text: String, join: Int) {
        self.dp.bc.mir.enter(b)
        let bool_type = self.dp.bc.mir.tc.bool_type()
        let value = self.dp.bc.mir.op_const(MirConstKind.Bool, text, bool_type)
        let rv = self.dp.bc.mir.rv_use(value)
        let result = self.dp.bc.mir.place_local(0)
        self.dp.bc.mir.assign(result, rv)
        self.dp.bc.mir.goto(join)
    }

    // `compare(other:)` on a struct or an enum: lexicographic. A struct's
    // fields in declaration order, the first whose `compare` is not `Equal`
    // deciding; an enum's cases first, by declaration order or, for a
    // raw-backed enum, by the values its cases state at the backing's
    // signedness, then the payload of the case both hold.
    func build_parts_compare(&var self, k: Int, t: Int, req: Int, kind: MonoGlueKind) {
        let ordering = self.dp.bc.mir.tc.sigs[req].result
        let other = self.dp.bc.mir.tc.mk_ref(false, t)
        let f = self.begin_hook(ordering, t, other)
        let equal = self.dp.bc.mir.new_block()
        let done = self.dp.bc.mir.new_block()
        if kind == MonoGlueKind.Struct || kind == MonoGlueKind.Tuple {
            var decls = Vector<Int>()
            var types = Vector<Int>()
            self.record_parts(t, &var decls, &var types)
            var j = 0
            while j < types.len() {
                let a = self.record_part(1, t, j, decls[j], types[j])
                let b = self.record_part(2, t, j, decls[j], types[j])
                self.order_or(k, req, ordering, types[j], a, b, done)
                j = j + 1
            }
            self.dp.bc.mir.goto(equal)
        } else {
            let d = self.dp.bc.mir.tc.nominal_decl(t)
            let backing = self.backing_of(d)
            if backing >= 0 {
                let x = self.cast_word(1, t, backing)
                let y = self.cast_word(2, t, backing)
                self.order_words(x, y, ordering, done)
                self.dp.bc.mir.goto(equal)
            } else {
                let x = self.ordinal_word(1, t)
                let y = self.ordinal_word(2, t)
                self.order_words(x, y, ordering, done)
                let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
                var arms = Vector<Int>()
                var j = 0
                while j < cases.len() {
                    try! arms.push(self.dp.bc.mir.new_block())
                    j = j + 1
                }
                let subject = self.referent_place(1, t)
                self.dp.bc.mir.switch_cases(subject, &cases, &arms, -1)
                j = 0
                while j < cases.len() {
                    self.dp.bc.mir.enter(arms[j])
                    let types = self.payload_types(t, cases[j])
                    var p = 0
                    while p < types.len() {
                        let a = self.payload_part(1, t, cases[j], p, types[p])
                        let b = self.payload_part(2, t, cases[j], p, types[p])
                        self.order_or(k, req, ordering, types[p], a, b, done)
                        p = p + 1
                    }
                    self.dp.bc.mir.goto(equal)
                    j = j + 1
                }
            }
        }
        self.ordering_arm(equal, ordering, "Equal", done)
        self.dp.bc.mir.enter(done)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `compare` of the parts at places `a` and `b`, of type `pt`: when it is
    // not `Equal`, it is `_0` and on to `done`; else on to a new block, where
    // the builder is left.
    func order_or(&var self, k: Int, req: Int, ordering: Int, pt: Int, a: Int, b: Int, done: Int) {
        let other = self.borrow_of(b)
        let answer = self.part_hook(k, req, pt, a, other)
        let next = self.dp.bc.mir.new_block()
        let decided = self.dp.bc.mir.new_block()
        let d = self.dp.bc.mir.tc.nominal_decl(ordering)
        let id = self.dp.bc.mir.tc.res.intern("Equal")
        var one = Vector<Int>()
        try! one.push(self.dp.bc.mir.tc.case_named(d, id))
        var to = Vector<Int>()
        try! to.push(next)
        let held = self.dp.bc.mir.place_local(answer)
        self.dp.bc.mir.switch_cases(held, &one, &to, decided)
        self.dp.bc.mir.enter(decided)
        let whole = self.dp.bc.mir.place_local(answer)
        let rv = self.dp.bc.mir.rv_move(whole)
        let result = self.dp.bc.mir.place_local(0)
        self.dp.bc.mir.assign(result, rv)
        self.dp.bc.mir.goto(done)
        self.dp.bc.mir.enter(next)
    }

    // `_0` is `Less` when word local `x` is below word local `y` and
    // `Greater` when above, each then `done`; the builder is left where they
    // are equal. The words compare at their own type's signedness.
    func order_words(&var self, x: Int, y: Int, ordering: Int, done: Int) {
        let less = self.dp.bc.mir.new_block()
        let rest = self.dp.bc.mir.new_block()
        let greater = self.dp.bc.mir.new_block()
        let equal = self.dp.bc.mir.new_block()
        let below = self.word_test("<", x, y)
        let below_op = self.dp.bc.mir.move_local(below)
        self.dp.bc.mir.switch_bool(below_op, less, rest)
        self.dp.bc.mir.enter(rest)
        let above = self.word_test(">", x, y)
        let above_op = self.dp.bc.mir.move_local(above)
        self.dp.bc.mir.switch_bool(above_op, greater, equal)
        self.ordering_arm(less, ordering, "Less", done)
        self.ordering_arm(greater, ordering, "Greater", done)
        self.dp.bc.mir.enter(equal)
    }

    // The Bool temp holding `x op y` of word locals `x` and `y`.
    func word_test(&var self, op: String, x: Int, y: Int) -> Int {
        let bool_type = self.dp.bc.mir.tc.bool_type()
        var ops = Vector<Int>()
        let px = self.dp.bc.mir.place_local(x)
        try! ops.push(self.dp.bc.mir.op_copy(px))
        let py = self.dp.bc.mir.place_local(y)
        try! ops.push(self.dp.bc.mir.op_copy(py))
        let rv = self.dp.bc.mir.rv_over(MirRvalueKind.Binary, bool_type, op, &ops)
        self.dp.bc.mir.temp_of(rv)
    }

    // `hash(h:)` on an aggregate: each part's `hash` in declaration order, a
    // struct's fields, a tuple's elements, a fixed array's elements in index
    // order. An enum feeds its case first, as an `Int` through the hasher's
    // `write_int(n:)`, then its payload: an Optional 1 for `Some` and 0 for
    // `None`, a raw-backed enum the value its case states, a narrow one
    // zero-extended, and any other enum its case's ordinal. These are the
    // words Stage 0 feeds, so a `Map`'s order is its.
    func build_parts_hash(&var self, k: Int, t: Int, req: Int, kind: MonoGlueKind) {
        let void_decl = self.dp.bc.mir.tc.known.void_type
        let void_type = self.dp.bc.mir.tc.prim(void_decl)
        let s = self.dp.bc.mir.tc.sigs[req]
        let into = self.dp.bc.mir.tc.params[s.param_first].ty
        let f = self.begin_hook(void_type, t, into)
        let done = self.dp.bc.mir.new_block()
        if kind == MonoGlueKind.Struct || kind == MonoGlueKind.Tuple {
            var decls = Vector<Int>()
            var types = Vector<Int>()
            self.record_parts(t, &var decls, &var types)
            var j = 0
            while j < types.len() {
                let a = self.record_part(1, t, j, decls[j], types[j])
                self.hash_part(k, req, types[j], a)
                j = j + 1
            }
            self.dp.bc.mir.goto(done)
        } else if kind == MonoGlueKind.Array {
            let element = self.dp.bc.mir.tc.types.ty(t).b
            let i = self.glue_counter(0)
            // Stage 0 workaround (SL:hazards S4): canonical: let head = self.glue_loop(i, "<", mono_array_length(&self.dp.bc.mir.tc, t), done)
            let length = mono_array_length(&self.dp.bc.mir.tc, t)
            let head = self.glue_loop(i, "<", length, done)
            let a = self.element_part(1, t, i, element)
            self.hash_part(k, req, element, a)
            self.glue_step(i, "&+")
            self.dp.bc.mir.goto(head)
        } else {
            let hasher = self.dp.bc.mir.tc.referent(into)
            let write = self.glue_member(hasher, "write_int", "n")
            if write < 0 {
                self.refuse(-1, "mono.not-yet", "an enum's `Hashable.hash` with no `write_int(n:)` on the hasher")
                self.dp.bc.mir.ret()
                self.finish_glue(k, f)
                return
            }
            let d = self.dp.bc.mir.tc.nominal_decl(t)
            let backing = self.backing_of(d)
            if backing >= 0 {
                let x = self.cast_word(1, t, backing)
                let bits = self.dp.bc.mir.move_local(x)
                let word = self.hash_word(bits, backing)
                let _ = self.call_member(write, hasher, word)
                self.dp.bc.mir.goto(done)
            } else {
                let int_type = self.dp.bc.mir.tc.int_type()
                let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
                var arms = Vector<Int>()
                var j = 0
                while j < cases.len() {
                    try! arms.push(self.dp.bc.mir.new_block())
                    j = j + 1
                }
                let subject = self.referent_place(1, t)
                self.dp.bc.mir.switch_cases(subject, &cases, &arms, -1)
                j = 0
                while j < cases.len() {
                    self.dp.bc.mir.enter(arms[j])
                    let text = self.case_word(t, cases[j], j)
                    let word = self.dp.bc.mir.op_const(MirConstKind.Int, text, int_type)
                    let _ = self.call_member(write, hasher, word)
                    let types = self.payload_types(t, cases[j])
                    var p = 0
                    while p < types.len() {
                        let a = self.payload_part(1, t, cases[j], p, types[p])
                        self.hash_part(k, req, types[p], a)
                        p = p + 1
                    }
                    self.dp.bc.mir.goto(done)
                    j = j + 1
                }
            }
        }
        self.dp.bc.mir.enter(done)
        self.dp.bc.mir.ret()
        self.finish_glue(k, f)
    }

    // `hash` of the part at place `part`, of type `pt`, into the hasher `_2`
    // refers to.
    func hash_part(&var self, k: Int, req: Int, pt: Int, part: Int) {
        let p = self.dp.bc.mir.place_local(2)
        let hasher = self.dp.bc.mir.op_copy(p)
        let _ = self.part_hook(k, req, pt, part, hasher)
    }

    // The word an enum of type `t` feeds for case `case_decl`, its `j`th: an
    // Optional's presence flag, else the ordinal.
    func case_word(&var self, t: Int, case_decl: Int, j: Int) -> String {
        var text = StringBuilder()
        if self.dp.bc.mir.tc.nominal_decl(t) == self.dp.bc.mir.tc.known.optional {
            if case_decl == self.dp.bc.mir.optional_case("Some") {
                try! text.append(1)
            } else {
                try! text.append(0)
            }
            return text.build()
        }
        try! text.append(j)
        text.build()
    }

    // The parts of record type `t`, a struct's fields or a tuple's elements,
    // in declaration order: each part's type into `types`, and its field's
    // declaration into `decls`, -1 for an element.
    func record_parts(&var self, t: Int, decls: &var Vector<Int>, types: &var Vector<Int>) {
        let info = self.dp.bc.mir.tc.types.ty(t)
        if info.kind == TcKind.Tuple {
            var j = 0
            while j < info.count {
                try! decls.push(-1)
                try! types.push(self.dp.bc.mir.tc.types.arg(t, j))
                j = j + 1
            }
            return
        }
        let fields = target_struct_fields(&self.dp.bc.mir.tc, info.decl)
        var j = 0
        while j < fields.len() {
            let written = self.dp.bc.mir.tc.sigs[fields[j]].result
            try! decls.push(fields[j])
            try! types.push(target_member_type(&var self.dp.bc.mir.tc, t, written))
            j = j + 1
        }
    }

    // Part `j` of the record `(*_l)`, of type `pt`: field `decl`, or element
    // `j` when `decl` is -1.
    func record_part(&var self, l: Int, t: Int, j: Int, decl: Int, pt: Int) -> Int {
        let subject = self.referent_place(l, t)
        if decl >= 0 {
            return self.dp.bc.mir.project(subject, MirProjKind.Field, decl, -1, pt)
        }
        self.dp.bc.mir.project(subject, MirProjKind.Tuple, -1, j, pt)
    }

    // The element of the fixed array `(*_l)` at the index Int local `i`
    // holds.
    func element_part(&var self, l: Int, t: Int, i: Int, element: Int) -> Int {
        let subject = self.referent_place(l, t)
        self.dp.bc.mir.project(subject, MirProjKind.Index, -1, i, element)
    }

    // The payload types of case `case_decl` of enum type `t`, in order.
    func payload_types(&var self, t: Int, case_decl: Int) -> Vector<Int> {
        let s = self.dp.bc.mir.tc.sigs[case_decl]
        var types = Vector<Int>()
        var p = 0
        while p < s.param_count {
            let written = self.dp.bc.mir.tc.params[s.param_first + p].ty
            try! types.push(target_member_type(&var self.dp.bc.mir.tc, t, written))
            p = p + 1
        }
        move types
    }

    // Payload field `p`, of type `pt`, of case `case_decl` of `(*_l)`, which
    // a switch has proven.
    func payload_part(&var self, l: Int, t: Int, case_decl: Int, p: Int, pt: Int) -> Int {
        let subject = self.referent_place(l, t)
        self.dp.bc.mir.project(subject, MirProjKind.Payload, case_decl, p, pt)
    }

    // A shared borrow of place `p`, as an operand.
    func borrow_of(&var self, p: Int) -> Int {
        let rv = self.dp.bc.mir.rv_ref(false, p)
        let l = self.dp.bc.mir.temp_of(rv)
        self.dp.bc.mir.move_local(l)
    }

    // A call of requirement `req` on part type `pt`, the part at place
    // `part` borrowed as its receiver and operand `second` its other
    // argument; returns the temp its result lands in. It is made at item
    // `k`'s origin, where a refusal of the part's hook is reported, and the
    // requirement funnel resolves it as it does every requirement call.
    func part_hook(&var self, k: Int, req: Int, pt: Int, part: Int, second: Int) -> Int {
        var args = Vector<Int>()
        try! args.push(self.borrow_of(part))
        try! args.push(second)
        let result = self.dp.bc.mir.tc.sigs[req].result
        let answer = self.dp.bc.mir.new_temp(result)
        // Stage 0 workaround (SL:hazards S4): canonical: var c = self.dp.bc.mir.blank_call(MirCallKind.Function, self.items[k].origin_node)
        let origin = self.items[k].origin_node
        var c = self.dp.bc.mir.blank_call(MirCallKind.Function, origin)
        c.target = req
        c.owner = pt
        c.arg_first = self.dp.bc.mir.push_args(&args)
        c.arg_count = 2
        c.dest = self.dp.bc.mir.place_local(answer)
        let _ = self.dp.bc.mir.call_and_continue(c)
        answer
    }

    // The backing integer type of raw-backed enum declaration `d`, or -1.
    func backing_of(&self, d: Int) -> Int {
        if d < 0 || self.dp.bc.mir.tc.res.decls[d].kind != ResDeclKind.Enum {
            return -1
        }
        self.dp.bc.mir.tc.sigs[d].result
    }

    // The temp holding `(*_l) as backing`, a raw-backed enum of type `t`
    // read as the value its case states.
    func cast_word(&var self, l: Int, t: Int, backing: Int) -> Int {
        let value = self.referent_copy(l, t)
        let rv = self.dp.bc.mir.rv_one(MirRvalueKind.Cast, backing, "", value)
        self.dp.bc.mir.temp_of(rv)
    }

    // The Int temp holding the ordinal of `(*_l)`'s case, an enum of type
    // `t`.
    func ordinal_word(&var self, l: Int, t: Int) -> Int {
        let int_type = self.dp.bc.mir.tc.int_type()
        let word = self.dp.bc.mir.new_temp(int_type)
        let d = self.dp.bc.mir.tc.nominal_decl(t)
        let cases = target_enum_cases(&self.dp.bc.mir.tc, d)
        let join = self.dp.bc.mir.new_block()
        var arms = Vector<Int>()
        var j = 0
        while j < cases.len() {
            try! arms.push(self.dp.bc.mir.new_block())
            j = j + 1
        }
        let subject = self.referent_place(l, t)
        self.dp.bc.mir.switch_cases(subject, &cases, &arms, -1)
        j = 0
        while j < cases.len() {
            var text = StringBuilder()
            try! text.append(j)
            self.set_word(arms[j], word, text.build(), join)
            j = j + 1
        }
        self.dp.bc.mir.enter(join)
        word
    }
}
