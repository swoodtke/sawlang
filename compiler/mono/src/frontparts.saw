public func front_part_snapshot(c: &FrontCut) -> FrontSnap {
    FrontSnap(s0: front_snapshot_0(&c),
              s1: front_snapshot_1(&c),
              s2: front_snapshot_2(&c),
              s3: front_snapshot_3(&c),
              s4: front_snapshot_4(&c),
              s5: front_snapshot_5(&c),
              s6: front_snapshot_6(&c),
              s7: front_snapshot_7(&c),
              s8: front_snapshot_8(&c),
              s9: front_snapshot_9(&c),
              s10: front_snapshot_10(&c),
              s11: front_snapshot_11(&c),
              s12: front_snapshot_12(&c),
              s13: front_snapshot_13(&c),
              s14: front_snapshot_14(&c))
}

// One layer's part: each appending table's suffix, each rewritten table's
// changed and added entries, and every scalar, in pieces of at most
// 32 fields.
public struct FrontPart {
    p0: FrontPart0
    p1: FrontPart1
    p2: FrontPart2
    p3: FrontPart3
    p4: FrontPart4
    p5: FrontPart5
    p6: FrontPart6
    p7: FrontPart7
    p8: FrontPart8
    p9: FrontPart9
    p10: FrontPart10
    p11: FrontPart11
    p12: FrontPart12
    p13: FrontPart13
    p14: FrontPart14
}

extension FrontPart: NoCopy {}

@synthesize
extension FrontPart: Serialize {}
@synthesize
extension FrontPart: Deserialize {}

// The part of the layer whose appending tables run from `lo` to `hi` in
// `c`, the state at the end of drops, and whose rewritten tables and
// scalars stood at `before` when it began and at `after` when it ended.
public func front_part_make(c: &FrontCut, lo: &Vector<Int>, hi: &Vector<Int>, before: &FrontSnap,
                            after: &FrontSnap) -> FrontPart {
    FrontPart(p0: front_make_0(&c, &lo, &hi, &before.s0, &after.s0),
              p1: front_make_1(&c, &lo, &hi, &before.s1, &after.s1),
              p2: front_make_2(&c, &lo, &hi, &before.s2, &after.s2),
              p3: front_make_3(&c, &lo, &hi, &before.s3, &after.s3),
              p4: front_make_4(&c, &lo, &hi, &before.s4, &after.s4),
              p5: front_make_5(&c, &lo, &hi, &before.s5, &after.s5),
              p6: front_make_6(&c, &lo, &hi, &before.s6, &after.s6),
              p7: front_make_7(&c, &lo, &hi, &before.s7, &after.s7),
              p8: front_make_8(&c, &lo, &hi, &before.s8, &after.s8),
              p9: front_make_9(&c, &lo, &hi, &before.s9, &after.s9),
              p10: front_make_10(&c, &lo, &hi, &before.s10, &after.s10),
              p11: front_make_11(&c, &lo, &hi, &before.s11, &after.s11),
              p12: front_make_12(&c, &lo, &hi, &before.s12, &after.s12),
              p13: front_make_13(&c, &lo, &hi, &before.s13, &after.s13),
              p14: front_make_14(&c, &lo, &hi, &before.s14, &after.s14))
}

// The first appending table of `c` that holds fewer than `hi` entries, or
// "": one that does was cut back after the layer `hi` ends, which only a
// rewritten table may be.
public func front_part_shrunk(c: &FrontCut, hi: &Vector<Int>) -> String {
    let s0 = front_shrunk_0(&c, &hi)
    if s0.len() > 0 {
        return s0
    }
    let s1 = front_shrunk_1(&c, &hi)
    if s1.len() > 0 {
        return s1
    }
    let s2 = front_shrunk_2(&c, &hi)
    if s2.len() > 0 {
        return s2
    }
    let s3 = front_shrunk_3(&c, &hi)
    if s3.len() > 0 {
        return s3
    }
    let s4 = front_shrunk_4(&c, &hi)
    if s4.len() > 0 {
        return s4
    }
    let s5 = front_shrunk_5(&c, &hi)
    if s5.len() > 0 {
        return s5
    }
    let s6 = front_shrunk_6(&c, &hi)
    if s6.len() > 0 {
        return s6
    }
    let s7 = front_shrunk_7(&c, &hi)
    if s7.len() > 0 {
        return s7
    }
    let s8 = front_shrunk_8(&c, &hi)
    if s8.len() > 0 {
        return s8
    }
    let s9 = front_shrunk_9(&c, &hi)
    if s9.len() > 0 {
        return s9
    }
    let s10 = front_shrunk_10(&c, &hi)
    if s10.len() > 0 {
        return s10
    }
    let s11 = front_shrunk_11(&c, &hi)
    if s11.len() > 0 {
        return s11
    }
    let s12 = front_shrunk_12(&c, &hi)
    if s12.len() > 0 {
        return s12
    }
    let s13 = front_shrunk_13(&c, &hi)
    if s13.len() > 0 {
        return s13
    }
    let s14 = front_shrunk_14(&c, &hi)
    if s14.len() > 0 {
        return s14
    }
    ""
}

// `part` applied to `c`, the state before its layer: `c` then holds the
// state after it.
public func front_part_apply(c: &var FrontCut, part: &FrontPart) {
    front_apply_0(&var c, &part.p0)
    front_apply_1(&var c, &part.p1)
    front_apply_2(&var c, &part.p2)
    front_apply_3(&var c, &part.p3)
    front_apply_4(&var c, &part.p4)
    front_apply_5(&var c, &part.p5)
    front_apply_6(&var c, &part.p6)
    front_apply_7(&var c, &part.p7)
    front_apply_8(&var c, &part.p8)
    front_apply_9(&var c, &part.p9)
    front_apply_10(&var c, &part.p10)
    front_apply_11(&var c, &part.p11)
    front_apply_12(&var c, &part.p12)
    front_apply_13(&var c, &part.p13)
    front_apply_14(&var c, &part.p14)
}

// What a layer did to a table of `Bool` that stood at `before` and ends at
// `after`: every entry that differs below the shorter length, then every
// entry past `before`'s.
func front_rewrite_Bool(before: &Vector<Bool>,
    after: &Vector<Bool>) -> FrontRewrite<Bool> {
    var at = Vector<Int>()
    var values = Vector<Bool>()
    let common = if before.len() < after.len() { before.len() } else { after.len() }
    var i = 0
    while i < common {
        if not (after[i] == before[i]) {
            try! at.push(i)
            try! values.push(after[i])
        }
        i = i + 1
    }
    while i < after.len() {
        try! at.push(i)
        try! values.push(after[i])
        i = i + 1
    }
    FrontRewrite<Bool>(length: after.len(), at: move at, values: move values)
}

