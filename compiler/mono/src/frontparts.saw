// Each table's length, by table index, which the pieces do not follow: a
// layer's watermarks.
public func front_part_lengths(c: &FrontCut) -> Vector<Int> {
    var out = Vector<Int>()
    var k = 0
    while k < 307 {
        try! out.push(0)
        k = k + 1
    }
    front_lengths_0(&c, &var out)
    front_lengths_1(&c, &var out)
    front_lengths_2(&c, &var out)
    front_lengths_3(&c, &var out)
    front_lengths_4(&c, &var out)
    front_lengths_5(&c, &var out)
    front_lengths_6(&c, &var out)
    front_lengths_7(&c, &var out)
    front_lengths_8(&c, &var out)
    front_lengths_9(&c, &var out)
    front_lengths_10(&c, &var out)
    front_lengths_11(&c, &var out)
    front_lengths_12(&c, &var out)
    front_lengths_13(&c, &var out)
    front_lengths_14(&c, &var out)
    move out
}

