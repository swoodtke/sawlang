// Monomorphization's dump (compiler/tests/mono/README.md): each item in item
// order, its identity, then its concrete function as the MIR dump prints a
// body, each call terminator followed by the item it reaches; and the layout
// table of every concrete type the items reach.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawmir.dump.{mir_module_functions}
import sawmir.model.{MirBlock, MirFuncKind, MirLocal, MirLocalKind, MirStmt, MirTermKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MonoItem, MonoItemKind, MonoProgram}
import sawresolve.dump.{res_sort_strings}
import sawresolve.lang.{ResLang}
import sawresolve.model.{ResDeclKind}
import sawresolve.program.{ResProgram}
import sawtypecheck.program.{TcProgram}
import sawtarget.layout.{Target}
import sawtypecheck.bodydump.{tc_dump_bodies}
import sawtypecheck.model.{TcLend}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}

extension MonoProgram {
    // Every item's dump, in item order.
    public func dump_items(&self, out: &var StringBuilder) {
        var k = 0
        while k < self.items.len() {
            if k > 0 {
                try! out.append("\n")
            }
            self.dump_item(&var out, k)
            k = k + 1
        }
    }

    // THE ITEM NAMING FUNNEL: item `k`'s name, which the dump, every later
    // stage's records and every LLVM symbol of an item spell. It is its
    // source function, glue type or extern, then what tells it apart from
    // other items of that source, so two items never share a name and no
    // symbol is defined twice (golden `names`). The backend's symbol spellers
    // all go through it.
    // ENTRY POINTS:
    //     ll_symbol
    //     ll_resume_symbol
    //     ll_descriptor_symbol
    //     ll_resume_value_symbol
    //     ll_result_drop_symbol
    public func item_name(&self, k: Int) -> String {
        let it = self.items[k]
        var out = StringBuilder()
        match it.kind {
            case Function -> {
                try! out.append(self.dp.bc.mir.func_name(it.source))
                // Stage 0 workaround (SL:hazards S4): canonical: self.append_qualifiers(&var out, self.root_decl(it.source))
                let decl = self.root_decl(it.source)
                self.append_qualifiers(&var out, decl)
                self.append_run(&var out, " args", it.args_first, it.args_count)
                self.append_run(&var out, " inst", it.inst_first, it.inst_count)
                if it.self_type >= 0 {
                    try! out.append(" self ")
                    try! out.append(self.dp.bc.mir.tc.type_text(it.self_type))
                }
                if self.is_task_root(k) {
                    try! out.append(" task root")
                }
                if self.thread_keyed(k) {
                    try! out.append(" thread")
                }
            },
            case DropGlue -> {
                try! out.append("drop glue ")
                try! out.append(self.dp.bc.mir.tc.type_text(it.glue_type))
            },
            case CopyGlue -> {
                try! out.append("copy glue ")
                try! out.append(self.dp.bc.mir.tc.type_text(it.glue_type))
            },
            case MemberGlue -> {
                try! out.append("member glue ")
                try! out.append(self.dp.bc.mir.tc.target_text(it.decl))
                try! out.append(" on ")
                try! out.append(self.dp.bc.mir.tc.type_text(it.glue_type))
            },
            case Extern -> {
                try! out.append("extern ")
                let name = self.dp.bc.mir.tc.res.decls[it.decl].name
                try! out.append(self.dp.bc.mir.tc.res.name_text(name))
            }
        }
        out.build()
    }

    // The declaration source function `f` belongs to, a closure's being its
    // enclosing function's; -1 for none.
    func root_decl(&self, f: Int) -> Int {
        var at = f
        while self.dp.bc.mir.funcs[at].kind == MirFuncKind.Closure && self.dp.bc.mir.funcs[at].parent >= 0 {
            at = self.dp.bc.mir.funcs[at].parent
        }
        self.dp.bc.mir.funcs[at].decl
    }

    // What the MIR dump's spelling of declaration `d` leaves out, wherever it
    // could tell `d` from another declaration of that spelling: a lending
    // member's receiver (an accessor's shared and exclusive pair), the type
    // an extension of another module's type extends (two extended types of
    // one name), and that a top-level function's module is a module when the
    // module is named like a vocabulary declaration, whose members print with
    // no module.
    func append_qualifiers(&self, out: &var StringBuilder, d: Int) {
        if d < 0 {
            return
        }
        let info = self.dp.bc.mir.tc.res.decls[d]
        let callable = info.kind == ResDeclKind.Func || info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init
        if not callable {
            return
        }
        let s = self.dp.bc.mir.tc.sigs[d]
        if s.lending != TcLend.NotBorrows {
            match s.receiver {
                case Shared -> try! out.append(" receiver shared"),
                case Exclusive -> try! out.append(" receiver exclusive"),
                case Absent -> {}
            }
        }
        if info.parent >= 0 && self.dp.bc.mir.tc.res.decls[info.parent].kind == ResDeclKind.Extension {
            let extended = self.dp.bc.mir.tc.ext_target(info.parent)
            if extended >= 0 && self.dp.bc.mir.tc.res.decls[extended].module != info.module {
                try! out.append(" extends ")
                try! out.append(self.dp.bc.mir.tc.nominal_name(extended))
            }
        }
        if info.parent < 0 && self.names_vocabulary(info.module) {
            try! out.append(" in module ")
            try! out.append(self.dp.bc.mir.tc.res.module_name(info.module))
        }
    }

    // Whether module `m` is outside the vocabulary and named like a top-level
    // vocabulary declaration, so its `M.f()` reads as that declaration's
    // member.
    func names_vocabulary(&self, m: Int) -> Bool {
        if self.dp.bc.mir.tc.res.is_vocabulary_module(m) {
            return false
        }
        // Stage 0 workaround (SL:hazards S4): canonical: let id = self.dp.bc.mir.tc.res.names.find(self.dp.bc.mir.tc.res.module_name(m))
        let name = self.dp.bc.mir.tc.res.module_name(m)
        let id = self.dp.bc.mir.tc.res.names.find(name)
        if id < 0 {
            return false
        }
        let builtin = self.dp.bc.mir.tc.res.builtin
        let prelude = self.dp.bc.mir.tc.res.std_prelude
        self.dp.bc.mir.tc.res.top.first(builtin, id) >= 0 || self.dp.bc.mir.tc.res.top.first(prelude, id) >= 0
    }

    func append_run(&self, out: &var StringBuilder, word: String, first: Int, count: Int) {
        if count == 0 {
            return
        }
        try! out.append(word)
        var j = 0
        while j < count {
            try! out.append(" ")
            let t = self.item_types[first + j]
            try! out.append(self.dp.bc.mir.tc.type_text(t))
            j = j + 1
        }
    }

    func dump_item(&self, out: &var StringBuilder, k: Int) {
        let it = self.items[k]
        try! out.append("item #")
        try! out.append(k)
        try! out.append(": ")
        try! out.append(self.item_name(k))
        if it.origin >= 0 {
            try! out.append("  (from #")
            try! out.append(it.origin)
            try! out.append(")")
        }
        try! out.append("\n")
        if it.body < 0 {
            return
        }
        let info = self.dp.bc.mir.funcs[it.body]
        try! out.append("fn -> ")
        let result = self.dp.bc.mir.locals[info.local_first].ty
        self.dp.bc.mir.append_type(&var out, result)
        try! out.append(" \{\n")
        var j = 0
        while j < info.local_count {
            let l = self.dp.bc.mir.locals[info.local_first + j]
            try! out.append("    let _")
            try! out.append(j)
            try! out.append(": ")
            self.dp.bc.mir.append_type(&var out, l.ty)
            try! out.append(";")
            self.append_note(&var out, &l)
            try! out.append("\n")
            j = j + 1
        }
        j = 0
        while j < info.block_count {
            try! out.append("\n    bb")
            try! out.append(j)
            try! out.append(": \{\n")
            let b = self.dp.bc.mir.blocks[info.block_first + j]
            var s = b.first
            while s >= 0 {
                let stmt = self.dp.bc.mir.stmts[s]
                try! out.append("        ")
                self.dp.bc.mir.append_stmt(&var out, info.local_first, &stmt)
                try! out.append("\n")
                s = stmt.next
            }
            try! out.append("        ")
            self.dp.bc.mir.append_term(&var out, info.local_first, &b)
            if b.term == MirTermKind.Call {
                let target = self.call_item(b.call)
                if target >= 0 {
                    try! out.append(" => #")
                    try! out.append(target)
                }
            }
            try! out.append("\n    \}\n")
            j = j + 1
        }
        try! out.append("\}\n")
    }

    func append_note(&self, out: &var StringBuilder, l: &MirLocal) {
        match l.kind {
            case Return -> try! out.append("  // return"),
            case Receiver -> try! out.append("  // self"),
            case Env -> try! out.append("  // env"),
            case Record -> try! out.append("  // record"),
            case Temp -> {},
            case Param -> {
                if l.name >= 0 {
                    try! out.append("  // param ")
                    try! out.append(self.dp.bc.mir.tc.name_text(l.name))
                } else {
                    try! out.append("  // param")
                }
            },
            case User -> {
                if l.reference {
                    try! out.append("  // ref ")
                } else {
                    try! out.append("  // ")
                }
                try! out.append(self.dp.bc.mir.tc.name_text(l.name))
            },
            case Flag -> {
                try! out.append("  // flag ")
                try! out.append(self.dp.bc.mir.tc.name_text(l.name))
            }
        }
    }

    // Every concrete type a local of an item's function has, each once,
    // sorted by spelling: the types whose layouts a backend asks for.
    public func reached_types(&self) -> Vector<Int> {
        var seen = Vector<Int>()
        var k = 0
        while k < self.items.len() {
            let it = self.items[k]
            k = k + 1
            if it.body < 0 {
                continue
            }
            let info = self.dp.bc.mir.funcs[it.body]
            var j = 0
            while j < info.local_count {
                let t = self.dp.bc.mir.locals[info.local_first + j].ty
                var known = false
                var i = 0
                while i < seen.len() {
                    if seen[i] == t {
                        known = true
                    }
                    i = i + 1
                }
                if not known && t >= 0 {
                    try! seen.push(t)
                }
                j = j + 1
            }
        }
        var texts = Vector<String>()
        var sorted = Vector<String>()
        k = 0
        while k < seen.len() {
            let t = seen[k]
            try! texts.push(self.dp.bc.mir.tc.type_text(t))
            try! sorted.push(self.dp.bc.mir.tc.type_text(t))
            k = k + 1
        }
        res_sort_strings(&var sorted)
        var out = Vector<Int>()
        var taken = Vector<Bool>()
        k = 0
        while k < seen.len() {
            try! taken.push(false)
            k = k + 1
        }
        k = 0
        while k < sorted.len() {
            let want = sorted.get(k) ?? ""
            var i = 0
            while i < seen.len() {
                let text = texts.get(i) ?? ""
                if not taken[i] && text.equals(want) {
                    try! out.push(seen[i])
                    taken[i] = true
                }
                i = i + 1
            }
            k = k + 1
        }
        move out
    }
}

// The layout table: one line per reached type, as the target describes it.
public func mono_dump_layouts(p: &var MonoProgram, target: &var Target, out: &var StringBuilder) {
    let types = p.reached_types()
    var k = 0
    while k < types.len() {
        try! out.append(target.dump_layout(&var p.dp.bc.mir.tc, types[k]))
        try! out.append("\n")
        k = k + 1
    }
}
