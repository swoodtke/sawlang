// Monomorphization's program (SL:architecture §3.8): drop elaboration's
// program, the item table a worklist from the roots fills, and the concrete
// MIR each item instantiates. Concrete functions are appended to the MIR's
// own arenas, after every generic one, which they never edit; side tables
// keyed by the concrete arenas' ids say which item each call and each closure
// reaches and which glue each drop and copy runs.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import saweval.program.{EvalKind, EvalValue}
import sawmir.build.{mir_func_local}
import sawmir.program.{MirProgram}
import sawtypecheck.arith.{TcFault}
import sawtypecheck.program.{TcProgram}
import sawmir.model.{MirDiag}
import sawparse.tree.{AstNode}
import sawresolve.names.{ResIndex}
import sawresolve.model.{ResDeclKind, ResModuleKind}
import sawtarget.layout.{Target}
import sawresolve.program.{ResProgram}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.typeops.{TcClient}

// What an item is: a function's body at concrete arguments, a type's drop or
// copy glue, the glue of a trait requirement a conformance meets with no
// written member and no default body, or an `extern` the program calls by its
// C name.
public enum MonoItemKind {
    case Function,
    case DropGlue,
    case CopyGlue,
    case MemberGlue,
    case Extern
}

// One item. A function's identity is its source MIR function and canonical
// concrete arguments: the receiver type's arguments for the parameters of
// `type_decl`, the function's own type arguments, and `Self` for a trait's
// default body. Typecheck interns types by canonical form with defaults
// filled, so two spellings of one instantiation are one item.
public struct MonoItem {
    kind: MonoItemKind
    // The generic MIR function a function item instantiates, or -1.
    source: Int
    // The declaration whose generic parameters `args` instantiate, or -1.
    type_decl: Int
    // The declaration whose own parameters `inst` instantiate, or -1.
    func_decl: Int
    // Runs of the item type pool.
    args_first: Int
    args_count: Int
    inst_first: Int
    inst_count: Int
    self_type: Int
    // A glue item's type; an extern's declaration, a member glue's
    // requirement.
    glue_type: Int
    decl: Int
    // The concrete MIR function, once instantiated, or -1.
    body: Int
    // The item whose body first reached this one, or -1 for a root, and the
    // node there that reached it, or -1.
    origin: Int
    origin_node: Int
}

// The vtable of concrete type `concrete` erased to `any` of trait
// `trait_decl` (spec, `any Trait` existentials): its slots, one per
// requirement `dispatch_requirements` lists, a run of `vtable_slots` holding
// each filled slot's item, or -1 for a requirement no dispatch in the
// program calls; and the concrete type's drop glue, or -1 for a type that
// owns nothing.
public struct MonoVtable {
    concrete: Int
    trait_decl: Int
    slot_first: Int
    slot_count: Int
    drop: Int
}

public struct MonoProgram {
    dp: DropsProgram
    items: Vector<MonoItem>
    item_types: Vector<Int>
    // (source function, 0), (type, 1) for drop glue, (type, 2) for copy glue,
    // (C name, 3) for an extern, (type, 4) for member glue, (source function,
    // 6) for a task root, (declaration, 7) for an item whose arguments its
    // declaration's moves were judged at -> the items with that key.
    by_key: ResIndex
    // By concrete call: the item it calls, or -1 for a builtin.
    call_items: Vector<Int>
    // By concrete rvalue: the item a closure construction's body is, or -1.
    closure_items: Vector<Int>
    // The first function index that is a concrete copy.
    concrete_first: Int
    // Refusals (`mono.not-yet`, `mono.depth`) and broken invariants.
    diags: Vector<MirDiag>
    problems: Vector<String>
    // By declaration: a static's evaluated value, `Missing` for none, and
    // the parts its aggregates name, numbered as the evaluator numbers them.
    static_values: Vector<EvalValue>
    static_parts: Vector<EvalValue>
    // The roots: the entry's `main`, then the lang functions the backend's
    // own lowering calls; -1 when absent.
    main_item: Int
    panic_item: Int
    literal_item: Int
    bytes_item: Int
    length_item: Int
    // The entry executor a suspending `main`'s frame is handed to, rooted
    // only once coroutine lowering lowers that frame (`root_entry_executor`);
    // -1 until then.
    exec_item: Int
    // What a spawn site's lowering calls (SL:coroutines A7a), made at the
    // first spawn site; -1 until then: std's task box, the background group,
    // and its close, which the C entry runs at a plain `main`'s return; and
    // the provenance case a singleton handle records. By concrete spawn
    // call, its handle type's `__saw_spawn` item, or -1.
    spawn_box_item: Int
    spawn_background_item: Int
    spawn_close_item: Int
    spawn_singleton: Int
    spawn_handle_items: Vector<Int>
    // What a `Thread.spawn` site's lowering calls (SL-765): the live-thread
    // count's raise, made at the first site, -1 until then; and by concrete
    // call, an index of `thread_spawns`, or -1.
    thread_started_item: Int
    thread_spawns: Vector<MonoThreadSpawn>
    thread_spawn_of: Vector<Int>
    // What a drive site's lowering calls (SL:coroutines A4b), made at the
    // first drive site of each form; -1 until then: std's driver that leaves
    // the root's result in its frame, and the one that counts its `Pending`s
    // and drops the result.
    drive_item: Int
    drive_steps_item: Int
    // What a park's lowering calls besides the park (SL:coroutines A3c),
    // made at the first park of each reason that needs it; -1 until then:
    // the timer's deadline, the reactor arm a descriptor or offload park
    // makes, and the offload job's pipe.
    park_deadline_item: Int
    park_register_item: Int
    park_pipe_item: Int
    // The String comparison roles, made when a comparison of Strings is
    // reached; -1 until then.
    equals_item: Int
    compare_item: Int
    // The builder role's members a rendering calls, made when the first one
    // that needs each is reached; -1 until then: `init()`, which an
    // interpolation builds through, `init(bytes:capacity:)`, the fixed mode a
    // format argument renders into over stack scratch, `build()` and `len()`.
    builder_new_item: Int
    builder_fixed_item: Int
    builder_build_item: Int
    builder_len_item: Int
    // By concrete rvalue: a collection literal's container `init()` and its
    // element `push`, or -1.
    literal_inits: Vector<Int>
    literal_pushes: Vector<Int>
    // The vtables erasures reach, and their slots' items. By concrete
    // rvalue: an erasure's vtable, or -1, and an erasure into a box's
    // allocator `alloc` item, or -1. By concrete call: the vtable slot a
    // dispatch through `any Trait` calls, or -1 for every other call.
    vtables: Vector<MonoVtable>
    vtable_slots: Vector<Int>
    erase_vtables: Vector<Int>
    erase_allocs: Vector<Int>
    dispatch_slots: Vector<Int>
    // Where the depth limit was first met: at a call, and at a drop or copy;
    // -1 for neither. The worklist's end refuses once, at the call when there
    // is one.
    depth_call: Int
    depth_glue: Int
    // The item being resolved or emitted, or -1: a refusal inside std is
    // reported at the user's call that reached it.
    current: Int
    // Whether an earlier stage refused the program, so nothing was made.
    blocked: Bool
    // By declaration: the elaborated MIR function of its body, or -1; and
    // (declaration, parameter) -> a default value's function.
    body_of: Vector<Int>
    defaults: ResIndex
    // Whether the program is a runtime, rooted at its exports with no `main`.
    runtime: Bool
    // The items of the exported functions, in declaration order, each a root
    // the backend defines under its C symbol.
    export_items: Vector<Int>
    // How many times the source was lowered to MIR to make this program: 1,
    // the one lowering the evaluator and every stage after it read.
    lowerings: Int
}

extension MonoProgram: NoCopy {}

// The items one concrete `Thread.spawn` call's lowering calls: the brace's
// body, which the site's trampoline runs on the new thread, and `Thread<T>`'s
// control-block allocation, settlement of the spawn seam's status into the
// site's `Result`, and the thread's exit.
public struct MonoThreadSpawn {
    body: Int
    block: Int
    started: Int
    exit: Int
}

// The key kinds of `by_key`. Beside those the comment on `by_key` names:
// (concrete type, 8) -> its vtables; (trait, 9) -> each slot a dispatch
// calls; (erased box type, 10) -> its allocator's `dealloc` item; (erased
// type, 11) -> the vtable slot its rendering dispatches.
public static MONO_KEY_FUNCTION: Int = 0
public static MONO_KEY_DROP: Int = 1
public static MONO_KEY_COPY: Int = 2
public static MONO_KEY_EXTERN: Int = 3
public static MONO_KEY_MEMBER: Int = 4
public static MONO_KEY_RENDER: Int = 5
public static MONO_KEY_TASK_ROOT: Int = 6
public static MONO_KEY_RELOCATIONS: Int = 7
public static MONO_KEY_VTABLE: Int = 8
public static MONO_KEY_DISPATCHED: Int = 9
public static MONO_KEY_DEALLOC: Int = 10
public static MONO_KEY_RENDER_SLOT: Int = 11
// (source function, 12) -> its thread-context items (`is_thread_item`).
public static MONO_KEY_THREAD: Int = 12

// How deeply a concrete argument may nest before mono refuses it: unbounded
// instantiation has no identity cycle to detect (SL-507).
public static MONO_DEPTH_LIMIT: Int = 64

public func mono_program(dp: DropsProgram, blocked: Bool) -> MonoProgram {
    let first = dp.bc.mir.funcs.len()
    var values = Vector<EvalValue>()
    var bodies = Vector<Int>()
    var k = 0
    while k < dp.bc.mir.tc.res.decls.len() {
        try! values.push(EvalValue.missing(fault: TcFault.NotConstant))
        try! bodies.push(-1)
        k = k + 1
    }
    MonoProgram(dp: move dp, items: Vector<MonoItem>(), item_types: Vector<Int>(), by_key: ResIndex(),
                call_items: Vector<Int>(), closure_items: Vector<Int>(), concrete_first: first,
                diags: Vector<MirDiag>(), problems: Vector<String>(), static_values: move values,
                static_parts: Vector<EvalValue>(), main_item: -1, panic_item: -1, literal_item: -1, bytes_item: -1,
                length_item: -1, exec_item: -1, spawn_box_item: -1, spawn_background_item: -1,
                spawn_close_item: -1, spawn_singleton: -1, spawn_handle_items: Vector<Int>(),
                thread_started_item: -1, thread_spawns: Vector<MonoThreadSpawn>(), thread_spawn_of: Vector<Int>(),
                drive_item: -1,
                drive_steps_item: -1, park_deadline_item: -1, park_register_item: -1, park_pipe_item: -1,
                equals_item: -1, compare_item: -1, builder_new_item: -1, builder_fixed_item: -1,
                builder_build_item: -1, builder_len_item: -1, literal_inits: Vector<Int>(),
                literal_pushes: Vector<Int>(), vtables: Vector<MonoVtable>(), vtable_slots: Vector<Int>(),
                erase_vtables: Vector<Int>(), erase_allocs: Vector<Int>(), dispatch_slots: Vector<Int>(), depth_call: -1, depth_glue: -1, current: -1, blocked: blocked,
                body_of: move bodies, defaults: ResIndex(), runtime: false, export_items: Vector<Int>(),
                lowerings: 0)
}

extension MonoProgram {
    public func item(&self, k: Int) -> MonoItem { self.items[k] }

    // The description of `triple` this program's layouts are asked of, given
    // the evaluated value of every raw-backed case, which its enum's layout
    // reads.
    public func target_for(&self, triple: String) -> Target {
        var target = Target(triple: triple)
        var d = 0
        while d < self.static_values.len() {
            let v = self.static_values[d]
            if v.kind == EvalKind.Integer && self.dp.bc.mir.tc.res.decls[d].kind == ResDeclKind.Case {
                target.set_case_value(d, v.bits)
            }
            d = d + 1
        }
        move target
    }

    // Whether operand `o` is a String, or a reference to one: the operands a
    // builtin comparison of Strings has.
    public func string_operand(&self, o: Int) -> Bool {
        let t = self.dp.bc.mir.operands[o].ty
        let r = self.dp.bc.mir.tc.referent(t)
        let inner = if r >= 0 { r } else { t }
        self.dp.bc.mir.tc.is_string(inner)
    }

    // The item concrete call `c` calls, or -1.
    public func call_item(&self, c: Int) -> Int {
        if c < 0 || c >= self.call_items.len() {
            return -1
        }
        self.call_items[c]
    }

    // The item that renders a value of concrete type `t` into the builder,
    // its `Printable.format(into:)`, or -1.
    public func render_item(&self, t: Int) -> Int {
        let at = self.by_key.first(t, MONO_KEY_RENDER)
        if at < 0 {
            return -1
        }
        self.by_key.value(at)
    }

    // The vtable slot a value of erased type `t` (`any Trait` or an erased
    // box) renders through, its `Printable.format`'s, or -1.
    public func render_slot(&self, t: Int) -> Int {
        let at = self.by_key.first(t, MONO_KEY_RENDER_SLOT)
        if at < 0 {
            return -1
        }
        self.by_key.value(at)
    }

    // A collection literal's container `init()` item at concrete rvalue `r`,
    // and its element `push` item, or -1.
    public func literal_init(&self, r: Int) -> Int {
        if r < 0 || r >= self.literal_inits.len() {
            return -1
        }
        self.literal_inits[r]
    }

    public func literal_push(&self, r: Int) -> Int {
        if r < 0 || r >= self.literal_pushes.len() {
            return -1
        }
        self.literal_pushes[r]
    }

    public func set_literal_items(&var self, r: Int, made: Int, push: Int) {
        while self.literal_inits.len() <= r {
            try! self.literal_inits.push(-1)
            try! self.literal_pushes.push(-1)
        }
        self.literal_inits[r] = made
        self.literal_pushes[r] = push
    }

    // The vtable concrete erasure `r` attaches, an index of `vtables`, or -1.
    public func erase_vtable(&self, r: Int) -> Int {
        if r < 0 || r >= self.erase_vtables.len() {
            return -1
        }
        self.erase_vtables[r]
    }

    // The allocator's `alloc` item concrete erasure `r` into a box calls, or
    // -1.
    public func erase_alloc(&self, r: Int) -> Int {
        if r < 0 || r >= self.erase_allocs.len() {
            return -1
        }
        self.erase_allocs[r]
    }

    public func set_erasure(&var self, r: Int, vtable: Int, alloc: Int) {
        while self.erase_vtables.len() <= r {
            try! self.erase_vtables.push(-1)
            try! self.erase_allocs.push(-1)
        }
        self.erase_vtables[r] = vtable
        self.erase_allocs[r] = alloc
    }

    // The vtable slot concrete call `c` dispatches through, or -1 for a call
    // that is no dispatch.
    public func dispatch_slot(&self, c: Int) -> Int {
        if c < 0 || c >= self.dispatch_slots.len() {
            return -1
        }
        self.dispatch_slots[c]
    }

    public func set_dispatch_slot(&var self, c: Int, slot: Int) {
        while self.dispatch_slots.len() <= c {
            try! self.dispatch_slots.push(-1)
        }
        self.dispatch_slots[c] = slot
    }

    // The item concrete closure construction `r` builds, or -1.
    public func closure_item(&self, r: Int) -> Int {
        if r < 0 || r >= self.closure_items.len() {
            return -1
        }
        self.closure_items[r]
    }

    // The glue item of `kind` (MONO_KEY_DROP or MONO_KEY_COPY) made for type
    // `t`, or -1 when `t` needs none.
    public func glue_item(&self, t: Int, kind: Int) -> Int {
        let at = self.by_key.first(t, kind)
        if at < 0 {
            return -1
        }
        self.by_key.value(at)
    }

    // Whether item `k` is a task root: the specialization a cooperative spawn
    // site or a drive site runs its root in, a separate item from the root's
    // ordinary one (SL:architecture §3.8).
    public func is_task_root(&self, k: Int) -> Bool {
        if k < 0 || k >= self.items.len() || self.items[k].kind != MonoItemKind.Function {
            return false
        }
        // Stage 0 workaround (SL:hazards S4): canonical: var at = self.by_key.first(self.items[k].source, MONO_KEY_TASK_ROOT)
        let source = self.items[k].source
        var at = self.by_key.first(source, MONO_KEY_TASK_ROOT)
        while at >= 0 {
            if self.by_key.value(at) == k {
                return true
            }
            at = self.by_key.following(at)
        }
        false
    }

    // The `__saw_spawn` item concrete spawn call `c` hands its frame to, or
    // -1.
    public func spawn_handle_item(&self, c: Int) -> Int {
        if c < 0 || c >= self.spawn_handle_items.len() {
            return -1
        }
        self.spawn_handle_items[c]
    }

    public func set_spawn_handle_item(&var self, c: Int, item: Int) {
        while self.spawn_handle_items.len() <= c {
            try! self.spawn_handle_items.push(-1)
        }
        self.spawn_handle_items[c] = item
    }

    // The index in `thread_spawns` of what concrete `Thread.spawn` call `c`
    // lowers through, or -1.
    public func thread_spawn_at(&self, c: Int) -> Int {
        if c < 0 || c >= self.thread_spawn_of.len() {
            return -1
        }
        self.thread_spawn_of[c]
    }

    public func set_thread_spawn(&var self, c: Int, site: MonoThreadSpawn) {
        while self.thread_spawn_of.len() <= c {
            try! self.thread_spawn_of.push(-1)
        }
        let at = self.thread_spawns.len()
        self.thread_spawn_of[c] = at
        try! self.thread_spawns.push(site)
    }

    // Whether item `k` runs in thread context, with no executor: a brace's
    // body or a `blocking` declaration's (`thread_context`), or a helper such
    // a body reaches through a call that suspends only by `blocking` or
    // reaches a pair, specialized apart from its ordinary item. A `blocking`
    // extern is a plain call in one (`thread_plain_call`), and a pair runs
    // its twin there (`selected_callee`).
    public func is_thread_item(&self, k: Int) -> Bool {
        if k < 0 || k >= self.items.len() || self.items[k].kind != MonoItemKind.Function {
            return false
        }
        let source = self.items[k].source
        self.dp.bc.mir.thread_context(source) || self.thread_keyed(k)
    }

    // Whether item `k` is a helper's thread-context item, a separate item from
    // its ordinary one.
    public func thread_keyed(&self, k: Int) -> Bool {
        if k < 0 || k >= self.items.len() || self.items[k].kind != MonoItemKind.Function {
            return false
        }
        let source = self.items[k].source
        var at = self.by_key.first(source, MONO_KEY_THREAD)
        while at >= 0 {
            if self.by_key.value(at) == k {
                return true
            }
            at = self.by_key.following(at)
        }
        false
    }

    public func set_call_item(&var self, c: Int, item: Int) {
        while self.call_items.len() <= c {
            try! self.call_items.push(-1)
        }
        self.call_items[c] = item
    }

    public func set_closure_item(&var self, r: Int, item: Int) {
        while self.closure_items.len() <= r {
            try! self.closure_items.push(-1)
        }
        self.closure_items[r] = item
    }

    // Records a refusal at source node `node`. A node inside std is reported
    // at the nearest call the program itself writes on the chain of items
    // that reached it, the std position named in the message, since the
    // program's author can change only that call.
    public func refuse(&var self, node: Int, rule: String, message: String) {
        if node < 0 {
            try! self.problems.push(message)
            return
        }
        let m = self.dp.bc.mir.tc.node_module(node)
        if m < 0 {
            try! self.problems.push(message)
            return
        }
        var at = node
        var text = message
        if self.std_module(m) {
            let site = self.user_site()
            if site >= 0 {
                at = site
                var msg = StringBuilder()
                try! msg.append(message)
                try! msg.append(" (inside ")
                try! msg.append(self.dp.bc.mir.tc.res.module_file(m))
                try! msg.append(":")
                try! msg.append(self.dp.bc.mir.tc.res.node_position(m, node))
                try! msg.append(")")
                text = msg.build()
            }
        }
        let am = self.dp.bc.mir.tc.node_module(at)
        let span = self.dp.bc.mir.tc.res.node(at)
        try! self.diags.push(MirDiag(module: am, start: span.start, end: span.end, id: rule, message: text))
    }

    // Whether module `m` is std's or the builtin module's.
    func std_module(&self, m: Int) -> Bool {
        let kind = self.dp.bc.mir.tc.res.module(m).kind
        kind == ResModuleKind.Std || kind == ResModuleKind.Builtin
    }

    // The node of the nearest program-written call on the chain of items
    // that reached the current one, or -1.
    func user_site(&self) -> Int {
        var k = self.current
        while k >= 0 {
            let it = self.items[k]
            let n = it.origin_node
            if n >= 0 {
                let m = self.dp.bc.mir.tc.node_module(n)
                if m >= 0 && not self.std_module(m) {
                    return n
                }
            }
            k = it.origin
        }
        return -1
    }

    // `FILE:LINE` of source node `node`, as a panic message names it: the
    // file's base name and the node's 1-based line.
    public func site_text(&self, node: Int) -> String {
        if node < 0 {
            return "?"
        }
        let m = self.dp.bc.mir.tc.node_module(node)
        if m < 0 {
            return "?"
        }
        let path = self.dp.bc.mir.tc.res.module_file(m)
        var cut = 0
        var i = 0
        // Stage 0 workaround (SL:hazards S4): canonical: let base = path.substring(cut, path.len())
        let size = path.len()
        while i < size {
            if (path.byte_at(i) as Int) == MONO_SLASH {
                cut = i + 1
            }
            i = i + 1
        }
        let base = path.substring(cut, size)
        let span = self.dp.bc.mir.tc.res.node(node)
        let position = self.dp.bc.mir.tc.res.position_text(m, span.start)
        var line_end = 0
        while line_end < position.len() && (position.byte_at(line_end) as Int) != MONO_COLON {
            line_end = line_end + 1
        }
        var out = StringBuilder()
        try! out.append(base)
        try! out.append(":")
        try! out.append(position.substring(0, line_end))
        out.build()
    }
}

static MONO_SLASH: Int = 47
static MONO_COLON: Int = 58
