// Monomorphization's entry points: a program checked, lowered, borrow
// checked and elaborated, its constants evaluated, then monomorphized from
// its roots; and the record `sawc mono` prints for it.

import sawborrowck.check.{borrowck_rules}
import sawborrowck.program.{BorrowckProgram, borrowck_program}
import sawdrops.elaborate.{drops_rules}
import sawborrowck.verify.{borrowck_verify_module}
import sawdrops.api.{drops_append_elaboration, drops_append_front, drops_has_invariant, drops_layer_elaborate,
                         drops_layer_front}
import sawdrops.program.{DropsProgram, drops_program}
import sawdrops.verify.{drops_verify_module}
import saweval.check
import saweval.program.{EvalEnd, EvalKind, EvalProgram, eval_program}
import saweval.interp.{eval_step_budget}
import sawlex.stagetime.{StageTime, stagetime_begin, stagetime_end}
import sawmir.api.{mir_append_diag, mir_append_invariants, mir_empty_front, mir_status}
import sawmir.program.{MirProgram}
import sawresolve.layer.{FrontInputs, FrontLayer, FrontLayerKind, FrontStep, front_inputs, front_layer}
import sawmono.dump.{mono_dump_layouts}
import sawmono.frontimage.{FrontCut}
import sawmono.program.{MonoItemKind, MonoProgram, mono_program}
import sawmono.worklist.{mono_rules}
import sawasserts.layout.{AssertsVerdict, asserts_inputs, asserts_verdict}
import sawtarget.layout.{Target}
import sawtypecheck.arith.{TcFault}
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.program.{TcTarget}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.typeops.{TcClient}

// How `sawc mono` treats one entry file.
public struct MonoOptions {
    std_root: String
    // The target the program is checked and laid out for (`target_front_end`).
    target: TcTarget
    // Print each item's concrete function.
    dump: Bool
    // Print the layout table of the types the items reach.
    layouts: Bool
    notes: Bool
}

// The program whose entry file is `path`, brought through every stage
// before mono, then monomorphized. Everything the stages before it report
// (as `sawc drops --check` prints it) is appended to `out`; when any of it
// is a refusal or a broken invariant, the program comes back blocked and
// nothing is instantiated. `runtime`, `freestanding` and `provider` are the
// driver's flags, from which typecheck builds the program's profile record
// (`TcProfile`); every stage after it reads the record, as it reads
// `target`'s through the program. The file is lowered once, and the
// program's `lowerings` says so.
// THE FRONT END: each layer brought through every stage before mono in turn,
// std's to drop elaboration before the program's first module is loaded
// (`mono_front_std`), then the program's from there (`mono_lower_cut`).
public func mono_lower_file(out: &var StringBuilder, path: String, std_root: String, notes: Bool,
                            names: &Vector<String>, dirs: &Vector<String>, target: TcTarget, runtime: Bool = false,
                            freestanding: Bool = false, provider: Bool = false,
                            no_hidden_alloc: Bool = false) -> MonoProgram {
    let inputs = asserts_inputs(path, &names, &dirs, target, freestanding)
    let front = mono_front_std(std_root, target, &inputs, runtime: runtime, freestanding: freestanding,
                               provider: provider)
    mono_lower_cut(out: &var out, front: move front, path: path, notes: notes, names: &names, dirs: &dirs,
                   no_hidden_alloc: no_hidden_alloc)
}

// The program whose entry file is `path` brought from `front`, std's cut,
// whether computed or read from an image, through every stage before mono,
// then monomorphized, as `mono_lower_file` describes. The cut fixes the std
// root, the target and the profile.
public func mono_lower_cut(out: &var StringBuilder, front: FrontCut, path: String, notes: Bool,
                           names: &Vector<String>, dirs: &Vector<String>, no_hidden_alloc: Bool = false) -> MonoProgram {
    var program = move front
    let inputs = mono_program_inputs(path, &names, &dirs)
    mono_front_program(&var program, &inputs, no_hidden_alloc)
    mono_from_front(out: &var out, front: move program, notes: notes)
}

// What the program's layer loads for entry file `path`: the entry and the
// `--module-path` packages. The target's builtins modules are std's, which
// std's layer loaded, so the program's names none.
public func mono_program_inputs(path: String, names: &Vector<String>, dirs: &Vector<String>) -> FrontInputs {
    front_inputs(path, &names, &dirs, Vector<String>())
}

// THE CUT: std's layer brought through drop elaboration with eval's values,
// before anything of the program is loaded. Of `inputs` it reads only the
// target's builtins modules, so the cut depends on the std root, the target,
// the profile and the compiler alone; the front-end image writes it down
// (`front_image_encode`) and reads it back as the same value. Every
// front-end entry starts from it, the stage subcommands that stop before
// drops included, so a cut loaded from the std front cache and one computed
// are one value for all of them. Making it runs every verifier over std's
// modules, the evaluator's too once std's constants are evaluated (std's MIR
// refused none), so a cut read back has been verified once and runs none;
// the evaluator's lines go among std's other verifier lines in `checked`.
// ENTRY POINTS:
//     mono_lower_file
//     driver_front_cut
//     pin_round_trip
//     pin_damage
//     pin_load_equals_run
//     write_std_image
public func mono_front_std(std_root: String, target: TcTarget, inputs: &FrontInputs, runtime: Bool = false,
                           freestanding: Bool = false, provider: Bool = false) -> FrontCut {
    // `--no-hidden-alloc` is not std's: std is exempt from it, so the cut is
    // made without it and the program's layer sets it (`mono_front_program`).
    var p = drops_program(borrowck_program(mir_empty_front(std_root, target, runtime: runtime,
                                                           freestanding: freestanding, provider: provider)))
    var ev = eval_program(&p.bc.mir)
    var checked = StringBuilder()
    var verified = StringBuilder()
    var elaborated = StringBuilder()
    var layer = front_layer(FrontLayerKind.Std)
    let blocked = mono_layer(&var p, &var ev, &var layer, &inputs, &var checked, &var verified, &var elaborated,
                             false, verify_values: true)
    var layers = Vector<FrontLayer>()
    try! layers.push(layer)
    FrontCut(drops: move p, eval: move ev, layers: move layers, checked: checked.build(), verified: verified.build(),
             elaborated: elaborated.build(), blocked: blocked)
}

// The program's layer run on `front`, std's state at the cut, whether
// computed or read from an image: the two are one value, so the program's
// layer cannot tell them apart. `front` then holds the whole front end.
public func mono_front_program(front: &var FrontCut, inputs: &FrontInputs, no_hidden_alloc: Bool) {
    mono_front_inputs(&var front, FrontLayerKind.Program, &inputs, no_hidden_alloc)
}

// One layer after std's run on `front`, the state the layers before it left,
// whether computed or read from the cache: the two are one value. A package
// layer and the program's are run alike, through drop elaboration.
// `--no-hidden-alloc` reaches every layer after std's.
// ENTRY POINTS:
//     mono_front_program
//     driver_front_chain
public func mono_front_layer(front: &var FrontCut, step: &FrontStep, no_hidden_alloc: Bool) {
    mono_front_inputs(&var front, step.kind, &step.inputs, no_hidden_alloc)
}

func mono_front_inputs(front: &var FrontCut, kind: FrontLayerKind, inputs: &FrontInputs, no_hidden_alloc: Bool) {
    front.drops.bc.mir.tc.no_hidden_alloc = no_hidden_alloc
    var checked = StringBuilder()
    try! checked.append(front.checked)
    var verified = StringBuilder()
    try! verified.append(front.verified)
    var elaborated = StringBuilder()
    try! elaborated.append(front.elaborated)
    var layer = front_layer(kind)
    let blocked = mono_layer(&var front.drops, &var front.eval, &var layer, &inputs, &var checked, &var verified,
                             &var elaborated, front.blocked)
    try! front.layers.push(layer)
    front.checked = checked.build()
    front.verified = verified.build()
    front.elaborated = elaborated.build()
    front.blocked = blocked
}

// One layer through every stage before mono: lowered, checked and borrow
// checked, its constants evaluated, then elaborated unless a layer so far is
// blocked. With `verify_values`, the evaluator's verifier then checks the
// layer's values, its lines appended to `checked`: std's layer is verified so
// in full once, when its cut is made, which is what lets a cut read from an
// image skip every verifier. Returns whether the program is blocked after it.
func mono_layer(p: &var DropsProgram, ev: &var EvalProgram, layer: &var FrontLayer, inputs: &FrontInputs,
                checked: &var StringBuilder, verified: &var StringBuilder, elaborated: &var StringBuilder,
                blocked_before: Bool, verify_values: Bool = false) -> Bool {
    var blocked = blocked_before
    if drops_layer_front(&var p, &var layer, &inputs, &var checked, &var verified) {
        blocked = true
    }
    // The constants are evaluated over the layer as lowered, before drop
    // elaboration rewrites its bodies; the evaluator only reads it. A
    // program refused here is blocked, and its values would never be read.
    stagetime_begin(StageTime.Eval)
    ev.grow(&p.bc.mir)
    let evaluated = mir_status(&p.bc.mir) == 0
    if evaluated {
        ev.evaluate_all(&p.bc.mir, &layer)
    }
    stagetime_end(StageTime.Eval)
    if verify_values && evaluated {
        var lines = StringBuilder()
        var m = layer.module_first
        while m < p.bc.mir.tc.res.module_count() {
            stagetime_begin(StageTime.VerifyEval)
            let found = ev.verify_module(&var p.bc.mir, m)
            stagetime_end(StageTime.VerifyEval)
            mir_append_invariants(out: &var lines, p: &p.bc.mir, m: m, problems: &found)
            m = m + 1
        }
        let text = lines.build()
        try! checked.append(text)
        if drops_has_invariant(text) {
            blocked = true
        }
    }
    if not blocked {
        drops_layer_elaborate(&var p, &layer, &var elaborated)
    }
    blocked
}

// The front end's report appended to `out`, as `sawc drops --check` prints it,
// then mono over `front` unless the report blocks it. The program is lowered
// once, and the program's `lowerings` says so.
public func mono_from_front(out: &var StringBuilder, front: FrontCut, notes: Bool) -> MonoProgram {
    let checked_text = front.checked
    let verified_text = front.verified
    let elaborated_text = front.elaborated
    var blocked = front.blocked
    let (p, ev) = (move front).take_program()
    var checked = StringBuilder()
    try! checked.append(checked_text)
    var verified = StringBuilder()
    try! verified.append(verified_text)
    var elaborated = StringBuilder()
    try! elaborated.append(elaborated_text)
    var head = StringBuilder()
    let status = drops_append_front(&var head, &p, notes, &checked, &verified)
    let before = head.build()
    try! out.append(before)
    if status != 0 || drops_has_invariant(before) {
        blocked = true
    }
    if not blocked {
        var tail = StringBuilder()
        let refused = drops_append_elaboration(&var tail, &p, &elaborated)
        let after = tail.build()
        try! out.append(after)
        if refused != 0 || drops_has_invariant(after) {
            blocked = true
        }
    }
    stagetime_begin(StageTime.Mono)
    var mono = mono_program(move p, blocked)
    mono.lowerings = 1
    if not blocked {
        mono_take_statics(&var mono, &ev)
        mono.run()
        mono_check_layout_asserts(&var mono)
    }
    stagetime_end(StageTime.Mono)
    move mono
}

// The deferred `static_assert`s over a type or const parameter, each checked
// at every instantiation of the function whose body holds it, against the
// layouts and const values its arguments give; one in a body never
// instantiated is never checked (SL:open-questions D40).
func mono_check_layout_asserts(mono: &var MonoProgram) {
    if mono.dp.bc.mir.tc.layout_asserts.len() == 0 {
        return
    }
    var target = Target(triple: mono.dp.bc.mir.tc.target.triple)
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        k = k + 1
        if it.kind != MonoItemKind.Function || it.decl < 0 {
            continue
        }
        var a = 0
        while a < mono.dp.bc.mir.tc.layout_asserts.len() {
            if mono.dp.bc.mir.tc.layout_assert_generic[a] && mono.dp.bc.mir.tc.layout_assert_decls[a] == it.decl {
                mono_check_instance(&var mono, &var target, k - 1, a)
            }
            a = a + 1
        }
    }
}

// Deferred assertion `a` at item `k`'s concrete arguments. A const parameter
// with no value at `k` has its invariant reported by `const_argument`.
func mono_check_instance(mono: &var MonoProgram, target: &var Target, k: Int, a: Int) {
    let cond = mono.dp.bc.mir.tc.layout_asserts[a]
    let message = mono.dp.bc.mir.tc.layout_assert_messages[a]
    let measures = mono.dp.bc.mir.tc.layout_measures(cond)
    var types = Vector<Int>()
    var j = 0
    while j < measures.len() {
        let written = mono.dp.bc.mir.tc.measured_type(measures[j])
        try! types.push(mono.concrete_type(k, written))
        j = j + 1
    }
    var instance = StringBuilder()
    try! instance.append("`")
    try! instance.append(mono.item_name(k))
    try! instance.append("`")
    // The const parameters the condition names, at item `k`'s values.
    let named = mono.dp.bc.mir.tc.const_parameters_named(cond)
    var params = Vector<Int>()
    var values = Vector<Int>()
    var kinds = Vector<Int>()
    j = 0
    while j < named.len() {
        let leaf = named[j]
        j = j + 1
        let ty = mono.dp.bc.mir.tc.const_parameter_type(leaf)
        let param = mono.dp.bc.mir.tc.param_type(leaf)
        let v = mono.const_argument(k, param, ty)
        if not v.ok {
            return
        }
        try! params.push(leaf)
        try! values.push(v.bits)
        try! kinds.push(ty)
    }
    mono.dp.bc.mir.tc.instance_params = move params
    mono.dp.bc.mir.tc.instance_values = move values
    mono.dp.bc.mir.tc.instance_types = move kinds
    let at = instance.build()
    let verdict = asserts_verdict(&var mono.dp.bc.mir.tc, &var target, cond, message, &measures, &types, at)
    // A condition over a const parameter that faults at this instance (a
    // shift by its value out of range, say) has no truth to hold, so it fails
    // rather than passing unread. A layout one's measurements are gone by
    // now, and its faults are the layout funnel's.
    var fault = TcFault.Clean
    if verdict.rule.len() == 0 && measures.len() == 0 && named.len() > 0 {
        let v = mono.dp.bc.mir.tc.fold_constant(cond)
        if not v.ok {
            fault = v.fault
        }
    }
    mono.dp.bc.mir.tc.instance_params = Vector<Int>()
    mono.dp.bc.mir.tc.instance_values = Vector<Int>()
    mono.dp.bc.mir.tc.instance_types = Vector<Int>()
    if verdict.rule.equals("static_assert.failed") {
        mono.refuse(cond, "static_assert.failed", verdict.message)
    } else if verdict.rule.len() > 0 {
        mono.refuse(cond, "mono.not-yet", verdict.message)
    } else if fault != TcFault.Clean && fault != TcFault.NotConstant && fault != TcFault.Cycle {
        var msg = StringBuilder()
        try! msg.append("static assertion failed: its condition ")
        try! msg.append(mono_fault_text(fault))
        if message >= 0 {
            try! msg.append(" (")
            try! msg.append(mono.dp.bc.mir.tc.assert_message_text(message))
            try! msg.append(")")
        }
        try! msg.append(", at ")
        try! msg.append(at)
        mono.refuse(cond, "static_assert.failed", msg.build())
    }
}

// What fault `f` did to a condition's fold, as a verb phrase.
func mono_fault_text(f: TcFault) -> String {
    match f {
        case Overflow -> "overflows its type",
        case ShiftRange -> "shifts by a count out of range",
        case DivideByZero -> "divides by zero",
        case NotFit -> "converts a value into a type that cannot hold it",
        case _ -> "does not fold"
    }
}

// Each static's evaluated value, by declaration, from the evaluation `ev` of
// this program's own lowering, with every aggregate part the values name. No
// stage between declares anything, so the two tables are one length.
func mono_take_statics(mono: &var MonoProgram, ev: &EvalProgram) {
    let count = ev.constant_of.len()
    if count != mono.static_values.len() {
        try! mono.problems.push("the evaluator's table and mono's number the declarations differently")
        return
    }
    var k = 0
    while k < ev.parts.len() {
        try! mono.static_parts.push(ev.parts[k])
        k = k + 1
    }
    var d = 0
    while d < count {
        let f = ev.constant_of[d]
        if f >= 0 && ev.ends[f] == EvalEnd.Valued {
            mono.static_values[d] = ev.values[f]
        }
        d = d + 1
    }
}

// The record of one program, after its `FILE` line: everything
// `sawc drops --check` prints for it, then mono's refusals, each an `ERROR`
// line, and an `INVARIANT` line per problem it met; then, as asked, each
// item's dump or the layout table. Returns 0 when nothing was refused and 1
// otherwise. The program's layer starts from `front`, std's cut for the
// options' std root and target. The program's lowerings are added to
// `lowerings`.
public func mono_record(out: &var StringBuilder, front: FrontCut, path: String, options: &MonoOptions,
                        names: &Vector<String>, dirs: &Vector<String>, lowerings: &var Int) -> Int {
    var mono = mono_lower_cut(out: &var out, front: move front, path: path, notes: options.notes, names: &names,
                              dirs: &dirs)
    lowerings = lowerings + mono.lowerings
    var status = 0
    if mono.blocked {
        status = 1
    }
    mono_append_findings(out: &var out, mono: &mono)
    if mono.diags.len() > 0 {
        status = 1
    }
    if mono.blocked {
        return status
    }
    if options.dump {
        mono.dump_items(&var out)
    }
    if options.layouts {
        var target = mono.target_for()
        mono_dump_layouts(&var mono, &var target, &var out)
    }
    status
}

// Mono's refusals and the invariants it met, in the order met.
public func mono_append_findings(out: &var StringBuilder, mono: &MonoProgram) {
    var k = 0
    while k < mono.diags.len() {
        let d = mono.diags[k]
        mir_append_diag(out: &var out, p: &mono.dp.bc.mir, d: &d)
        k = k + 1
    }
    k = 0
    while k < mono.problems.len() {
        try! out.append("INVARIANT\tmono\t")
        try! out.append(mono.problems.get(k) ?? "")
        try! out.append("\n")
        k = k + 1
    }
}
