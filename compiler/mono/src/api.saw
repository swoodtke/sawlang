// Monomorphization's entry points: a program checked, lowered, borrow
// checked and elaborated, its constants evaluated, then monomorphized from
// its roots; and the record `sawc2 mono` prints for it.

import sawborrowck.check.{borrowck_rules}
import sawborrowck.program.{BorrowckProgram, borrowck_program}
import sawdrops.elaborate.{drops_rules}
import sawborrowck.verify.{borrowck_verify_module}
import sawdrops.api.{drops_has_invariant}
import sawdrops.program.{DropsProgram, drops_program}
import sawdrops.verify.{drops_verify_module}
import saweval.program.{EvalEnd, EvalKind, EvalProgram, eval_program}
import saweval.interp.{eval_step_budget}
import sawmir.api.{mir_append_checks, mir_append_diag, mir_append_invariants, mir_lower_file}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoItemKind, MonoProgram, mono_program}
import sawmono.worklist.{mono_rules}
import sawasserts.layout.{AssertsVerdict, asserts_verdict}
import sawtarget.layout.{Target, target_named}
import sawtypecheck.bodies.{tc_check_bodies}

// How `sawc2 mono` treats one entry file.
public struct MonoOptions {
    std_root: String
    target: String
    // Print each item's concrete function.
    dump: Bool
    // Print the layout table of the types the items reach.
    layouts: Bool
    notes: Bool
}

// The program whose entry file is `path`, brought through every stage
// before mono, then monomorphized. Everything the stages before it report
// (as `sawc2 drops --check` prints it) is appended to `out`; when any of it
// is a refusal or a broken invariant, the program comes back blocked and
// nothing is instantiated. A `runtime` program is checked and rooted as a
// runtime: its roots are its exports, and it has no `main`. The file is
// lowered once, and the program's `lowerings` says so.
public func mono_lower_file(out: &var StringBuilder, path: String, std_root: String, notes: Bool,
                            names: &Vector<String>, dirs: &Vector<String>, runtime: Bool = false) -> MonoProgram {
    var lowerings = 0
    var lowered = mir_lower_file(path, std_root, &names, &dirs, &var lowerings, runtime: runtime)
    var head = StringBuilder()
    var status = mir_append_checks(out: &var head, p: &var lowered, notes: notes)
    // The constants are evaluated over the program as lowered, before the
    // borrow check and drop elaboration rewrite its bodies; the evaluator
    // only reads it. A program refused here is blocked, and its values
    // would never be read.
    var ev = eval_program(&lowered)
    if status == 0 {
        ev.evaluate_all(&lowered)
    }
    var bc = borrowck_program(move lowered)
    var m = 0
    while m < bc.mir.tc.res.module_count() {
        let info = bc.mir.tc.res.module(m)
        if info.available && not info.interface_only {
            bc.check_module(m)
        }
        m = m + 1
    }
    var k = 0
    while k < bc.diags.len() {
        let d = bc.diags[k]
        mir_append_diag(out: &var head, p: &bc.mir, d: &d)
        k = k + 1
    }
    if bc.diags.len() > 0 {
        status = 1
    }
    m = 0
    while m < bc.mir.tc.res.module_count() {
        let info = bc.mir.tc.res.module(m)
        if info.available && not info.interface_only {
            let found = borrowck_verify_module(&var bc, m)
            mir_append_invariants(out: &var head, p: &bc.mir, m: m, problems: &found)
        }
        m = m + 1
    }
    let before = head.build()
    try! out.append(before)
    var blocked = status != 0 || drops_has_invariant(before)
    var p = drops_program(move bc)
    if not blocked {
        var tail = StringBuilder()
        mono_elaborate(&var p, &var tail)
        let after = tail.build()
        try! out.append(after)
        if p.diags.len() > 0 || drops_has_invariant(after) {
            blocked = true
        }
    }
    var mono = mono_program(move p, blocked)
    mono.runtime = runtime
    mono.lowerings = lowerings
    if not blocked {
        mono_take_statics(&var mono, &ev)
        mono.run()
        mono_check_layout_asserts(&var mono)
    }
    move mono
}

// The deferred `static_assert`s over a type parameter (SL:open-questions
// D40), each checked at every instantiation of the function whose body holds
// it, against the layouts its arguments give; one in a body never
// instantiated is never checked.
func mono_check_layout_asserts(mono: &var MonoProgram) {
    if mono.dp.bc.mir.tc.layout_asserts.len() == 0 {
        return
    }
    // Every target sawc2 describes is LP64 with natural alignment, so one
    // answers for all of them, as the layout-assert funnel's does.
    var target = target_named("arm64-apple-darwin")
    var k = 0
    while k < mono.items.len() {
        let it = mono.items[k]
        k = k + 1
        if it.kind != MonoItemKind.Function || it.decl < 0 {
            continue
        }
        var a = 0
        while a < mono.dp.bc.mir.tc.layout_asserts.len() {
            if mono.dp.bc.mir.tc.layout_assert_generic[a] && mono.dp.bc.mir.tc.layout_assert_decls[a] == it.decl {
                mono_check_instance(&var mono, &var target, k - 1, a)
            }
            a = a + 1
        }
    }
}

// Deferred assertion `a` at item `k`'s concrete arguments.
func mono_check_instance(mono: &var MonoProgram, target: &var Target, k: Int, a: Int) {
    let cond = mono.dp.bc.mir.tc.layout_asserts[a]
    let message = mono.dp.bc.mir.tc.layout_assert_messages[a]
    let measures = mono.dp.bc.mir.tc.layout_measures(cond)
    var types = Vector<Int>()
    var j = 0
    while j < measures.len() {
        let written = mono.dp.bc.mir.tc.measured_type(measures[j])
        try! types.push(mono.concrete_type(k, written))
        j = j + 1
    }
    var instance = StringBuilder()
    try! instance.append("`")
    try! instance.append(mono.item_name(k))
    try! instance.append("`")
    let verdict = asserts_verdict(&var mono.dp.bc.mir.tc, &var target, cond, message, &measures, &types,
                                  instance.build())
    if verdict.rule.equals("static_assert.failed") {
        mono.refuse(cond, "static_assert.failed", verdict.message)
    } else if verdict.rule.len() > 0 {
        mono.refuse(cond, "mono.not-yet", verdict.message)
    }
}

// Drop elaboration over every module checked in full, its refusals and the
// invariants it met or its verifier finds appended to `out`.
func mono_elaborate(p: &var DropsProgram, out: &var StringBuilder) {
    var m = 0
    while m < p.bc.mir.tc.res.module_count() {
        let info = p.bc.mir.tc.res.module(m)
        if info.available && not info.interface_only {
            p.elaborate_module(m)
        }
        m = m + 1
    }
    var k = 0
    while k < p.diags.len() {
        let d = p.diags[k]
        mir_append_diag(out: &var out, p: &p.bc.mir, d: &d)
        k = k + 1
    }
    m = 0
    while m < p.bc.mir.tc.res.module_count() {
        let info = p.bc.mir.tc.res.module(m)
        if info.available && not info.interface_only {
            var met = Vector<String>()
            var j = 0
            while j < p.problems.len() {
                if p.problem_modules[j] == m {
                    try! met.push(p.problems.get(j) ?? "")
                }
                j = j + 1
            }
            mir_append_invariants(out: &var out, p: &p.bc.mir, m: m, problems: &met)
            let found = drops_verify_module(&var p, m)
            mir_append_invariants(out: &var out, p: &p.bc.mir, m: m, problems: &found)
        }
        m = m + 1
    }
}

// Each static's evaluated value, by declaration, from the evaluation `ev` of
// this program's own lowering. No stage between declares anything, so the
// two tables are one length.
func mono_take_statics(mono: &var MonoProgram, ev: &EvalProgram) {
    let count = ev.constant_of.len()
    if count != mono.static_kinds.len() {
        try! mono.problems.push("the evaluator's table and mono's number the declarations differently")
        return
    }
    var d = 0
    while d < count {
        let f = ev.constant_of[d]
        if f >= 0 && ev.ends[f] == EvalEnd.Valued {
            let v = ev.values[f]
            match v.kind {
                case Integer -> {
                    mono.static_kinds[d] = 0
                    mono.static_bits[d] = v.bits
                },
                case Boolean -> {
                    mono.static_kinds[d] = 1
                    mono.static_bits[d] = v.bits
                },
                case Case -> {
                    mono.static_kinds[d] = 2
                    mono.static_bits[d] = v.decl
                },
                case Cell -> {
                    mono.static_kinds[d] = 3
                    mono.static_bits[d] = v.bits
                },
                case _ -> {}
            }
        }
        d = d + 1
    }
}

// The record of one program, after its `FILE` line: everything
// `sawc2 drops --check` prints for it, then mono's refusals, each an `ERROR`
// line, and an `INVARIANT` line per problem it met; then, as asked, each
// item's dump or the layout table. Returns 0 when nothing was refused and 1
// otherwise. The program's lowerings are added to `lowerings`.
public func mono_record(out: &var StringBuilder, path: String, options: &MonoOptions, names: &Vector<String>,
                        dirs: &Vector<String>, lowerings: &var Int) -> Int {
    var mono = mono_lower_file(out: &var out, path: path, std_root: options.std_root, notes: options.notes,
                               names: &names, dirs: &dirs)
    lowerings = lowerings + mono.lowerings
    var status = 0
    if mono.blocked {
        status = 1
    }
    mono_append_findings(out: &var out, mono: &mono)
    if mono.diags.len() > 0 {
        status = 1
    }
    if mono.blocked {
        return status
    }
    if options.dump {
        mono.dump_items(&var out)
    }
    if options.layouts {
        var target = mono.target_for(options.target)
        mono_dump_layouts(&var mono, &var target, &var out)
    }
    status
}

// Mono's refusals and the invariants it met, in the order met.
public func mono_append_findings(out: &var StringBuilder, mono: &MonoProgram) {
    var k = 0
    while k < mono.diags.len() {
        let d = mono.diags[k]
        mir_append_diag(out: &var out, p: &mono.dp.bc.mir, d: &d)
        k = k + 1
    }
    k = 0
    while k < mono.problems.len() {
        try! out.append("INVARIANT\tmono\t")
        try! out.append(mono.problems.get(k) ?? "")
        try! out.append("\n")
        k = k + 1
    }
}
