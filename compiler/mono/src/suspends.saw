// Which items definitely suspend, decided over mono's items once every
// statically dispatched call has its concrete target (SL:architecture §3.9).
// Typecheck's flag on a call says whether it may suspend, as a condition over
// the caller's type parameters when the target is reached through a bound;
// here the condition is answered by the item the call reaches. The backend
// refuses what this marks, since no suspension is lowered yet.

import sawmir.model.{MirSuspend, MirTermKind}
import sawmono.program.{MonoProgram}
import sawresolve.names.{res_index}

// Marks every item that definitely suspends: one whose body holds a call that
// does. The least fixpoint, propagated from callee to caller, so a cycle
// suspends only when a call in it reaches a suspension, and each item is
// marked once.
public func mono_solve_suspension(mono: &var MonoProgram) {
    mono.suspending = Vector<Bool>()
    var k = 0
    while k < mono.items.len() {
        try! mono.suspending.push(false)
        k = k + 1
    }
    var callers = res_index()
    var work = Vector<Int>()
    k = 0
    while k < mono.items.len() {
        let caller = k
        k = k + 1
        let f = mono.items[caller].body
        if f < 0 {
            continue
        }
        let info = mono.dp.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = mono.dp.bc.mir.blocks[info.block_first + b]
            b = b + 1
            if block.term != MirTermKind.Call {
                continue
            }
            let c = block.call
            if mono.dp.bc.mir.calls[c].suspend == MirSuspend.Never {
                continue
            }
            let t = mono.call_item(c)
            if t >= 0 && mono.items[t].body >= 0 {
                callers.add(t, 0, caller)
            } else if not mono.suspending[caller] {
                mono.suspending[caller] = true
                try! work.push(caller)
            }
        }
    }
    var at = 0
    while at < work.len() {
        let t = work[at]
        at = at + 1
        var e = callers.first(t, 0)
        while e >= 0 {
            let caller = callers.value(e)
            if not mono.suspending[caller] {
                mono.suspending[caller] = true
                try! work.push(caller)
            }
            e = callers.following(e)
        }
    }
}

// Whether item `k` definitely suspends.
public func mono_item_suspends(mono: &MonoProgram, k: Int) -> Bool {
    k >= 0 && k < mono.suspending.len() && mono.suspending[k]
}

// Whether concrete call `c` definitely suspends: typecheck says it may, and
// the item it reaches suspends. A target with no body to look into, an
// `extern` or one mono could not make, keeps typecheck's answer, so an
// unanswerable condition counts as suspending.
public func mono_call_suspends(mono: &MonoProgram, c: Int) -> Bool {
    if mono.dp.bc.mir.calls[c].suspend == MirSuspend.Never {
        return false
    }
    let t = mono.call_item(c)
    if t < 0 || mono.items[t].body < 0 {
        return true
    }
    mono_item_suspends(&mono, t)
}
