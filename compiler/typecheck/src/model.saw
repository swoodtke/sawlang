@synthesize
extension TcConstPosition: Serialize {}
@synthesize
extension TcConstPosition: Deserialize {}

// A payload enum has no raw backing to derive from, so each case is written
// as an array of its tag, then its payload in declaration order. A case added
// here needs a tag in both bodies, and the image pin round-trips each case
// (compiler/mono/tests/front_image.saw).
extension TcPendingConstant: Serialize {
    public func serialize(&self, to: &var any Encoder) sync -> Result<Void, EncodeError> {
        match self {
            case Cast(e) -> {
                try to.begin_array(2)
                try to.write_uint(0)
                try e.serialize(to: &var to)
            },
            case CertainFault(e, count, shifted, divides) -> {
                try to.begin_array(5)
                try to.write_uint(1)
                try e.serialize(to: &var to)
                try count.serialize(to: &var to)
                try shifted.serialize(to: &var to)
                try divides.serialize(to: &var to)
            },
            case SlotRange(e) -> {
                try to.begin_array(2)
                try to.write_uint(2)
                try e.serialize(to: &var to)
            },
            case Position(e, pos, d, message) -> {
                try to.begin_array(5)
                try to.write_uint(3)
                try e.serialize(to: &var to)
                try pos.serialize(to: &var to)
                try d.serialize(to: &var to)
                try message.serialize(to: &var to)
            }
        }
        return
    }
}

extension TcPendingConstant: Deserialize {
    public static func deserialize(from: &var any Decoder) sync -> Result<TcPendingConstant, DecodeError> {
        let start = from.offset()
        let n = try from.begin_array()
        let tag = try from.read_uint()
        if tag == 0 && n == 2 {
            let e = try Int.deserialize(from: &var from)
            return TcPendingConstant.Cast(e: e)
        }
        if tag == 1 && n == 5 {
            let e = try Int.deserialize(from: &var from)
            let count = try Int.deserialize(from: &var from)
            let shifted = try Int.deserialize(from: &var from)
            let divides = try Bool.deserialize(from: &var from)
            return TcPendingConstant.CertainFault(e: e, count: count, shifted: shifted, divides: divides)
        }
        if tag == 2 && n == 2 {
            let e = try Int.deserialize(from: &var from)
            return TcPendingConstant.SlotRange(e: e)
        }
        if tag == 3 && n == 5 {
            let e = try Int.deserialize(from: &var from)
            let pos = try TcConstPosition.deserialize(from: &var from)
            let d = try Int.deserialize(from: &var from)
            let message = try Int.deserialize(from: &var from)
            return TcPendingConstant.Position(e: e, pos: pos, d: d, message: message)
        }
        return DecodeError(offset: start, fault: DecodeFault.UnknownCase)
    }
}
