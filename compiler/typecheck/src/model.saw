// The records the signature half of type checking produces (SL:architecture
// §3.4, "Order"): every declaration's signature, the trait conformance table,
// the member tables and the Copy tiers. Every record is plain data keyed by
// resolve's ids: a declaration by its index in resolve's table, a node by its
// arena id, a type by its interner id.

import sawresolve.src.model.{ResVis}

// The effect slot's words, as bits (syntax.rule.effect-slot).
public static TC_EFFECT_UNSAFE: Int = 1
public static TC_EFFECT_SYNC: Int = 2
public static TC_EFFECT_CONSUMES: Int = 4
public static TC_EFFECT_BORROWS: Int = 8
public static TC_EFFECT_BORROWS_SYNC: Int = 16
public static TC_EFFECT_ESCAPING: Int = 32
public static TC_EFFECT_CONSTEXPR: Int = 64

// What else a declaration's head says, as bits.
public static TC_FLAG_STATIC: Int = 1
public static TC_FLAG_DEFAULT_BODY: Int = 2
public static TC_FLAG_VARIADIC: Int = 4
public static TC_FLAG_BLOCKING: Int = 8
public static TC_FLAG_UNSAFE_STRUCT: Int = 16
public static TC_FLAG_BORROWS_STRUCT: Int = 32
public static TC_FLAG_SYNTHESIZE: Int = 64
public static TC_FLAG_SYNTHESIZE_SHARED: Int = 128
public static TC_FLAG_UNSAFE_VAR: Int = 256
public static TC_FLAG_WRITTEN_RETURN: Int = 512
// Set while an alias or type assignment is being resolved, to find a cycle.
public static TC_FLAG_ALIAS_BUILDING: Int = 1024

// The three Copy tiers (design 219), strongest last: a composite takes the
// strongest of its parts.
public static TC_TIER_COPY: Int = 0
public static TC_TIER_EXPLICIT: Int = 1
public static TC_TIER_NOCOPY: Int = 2

public enum TcReceiver {
    // A free function, a static method, an init: no receiver.
    case Absent,
    case Shared,
    case Exclusive
}

// What a `borrows` accessor lends, as the accessor-signature reader classifies
// its return type (SL:architecture §3.4).
public enum TcLend {
    case NotBorrows,
    // `&T`, `&var T`: a place.
    case Place,
    // `&T?`, `&var T?`: a place that may be absent.
    case ConditionalPlace,
    // `&[T]`, `&var [T]`.
    case Slice,
    // `&[T]?`.
    case ConditionalSlice,
    // A borrowing struct, lent by value.
    case BorrowingStruct,
    // Anything else, which the checks on `borrows` bodies refuse.
    case Other
}

// A declaration's signature. Which fields mean something depends on the kind:
// a function's generics, parameters, effects and result; a field's, static's
// or alias's result; a case's payload as parameters; an enum's raw backing as
// its result; a trait's parents and an extension's conformances as traits; an
// extension's target as its result and its generic parameters' bounds as the
// conditions its members hold under.
public struct TcSig {
    // 0 unbuilt, 1 generics under construction, 2 generics built, 3 built.
    public state: Int
    public generic_first: Int
    public generic_count: Int
    public param_first: Int
    public param_count: Int
    public trait_first: Int
    public trait_count: Int
    public receiver: TcReceiver
    public result: Int
    public effects: Int
    public flags: Int
    public lending: TcLend
    public lending_exclusive: Bool
}

public func tc_blank_sig() -> TcSig {
    TcSig(state: 0, generic_first: 0, generic_count: 0, param_first: 0, param_count: 0,
          trait_first: 0, trait_count: 0, receiver: TcReceiver.Absent, result: -1, effects: 0,
          flags: 0, lending: TcLend.NotBorrows, lending_exclusive: false)
}

// One generic parameter: its bounds are traits, its default a type (or a
// constant for a const parameter), and a const parameter's type.
public struct TcGeneric {
    public name: Int
    public leaf: Int
    public node: Int
    public is_const: Bool
    public bound_first: Int
    public bound_count: Int
    public default_type: Int
    public const_type: Int
}

// A parameter, a payload field, or a named-tuple element: its name and type.
public struct TcParam {
    public name: Int
    public leaf: Int
    public ty: Int
    public has_default: Bool
}

public enum TcStatusKind {
    // Written by the type: in the conformance, or another of its extensions.
    case Written,
    // Filled by the trait's default body.
    case Default,
    // Derived under `@synthesize` (design 128).
    case Synthesized,
    // Synthesized with no marker: a `deinit`, and an associated type's
    // absence never is.
    case Implicit,
    case Missing
}

// How one requirement of a conformance is met.
public struct TcStatus {
    public requirement: Int
    public kind: TcStatusKind
    // The member that meets it, when one is written.
    public member: Int
}

// One entry of the conformance table: (type, trait), where it is declared,
// and how each requirement is met.
public struct TcConformance {
    public module: Int
    public ext: Int
    public node: Int
    public type_decl: Int
    public trait_decl: Int
    public status_first: Int
    public status_count: Int
}

public enum TcSource {
    // A field or case the type's own declaration holds.
    case Declared,
    // A method, static, init or type assignment of an extension.
    case Extension,
    // A trait's default body, through a conformance.
    case Default,
    // Derived under `@synthesize`.
    case Synthesized,
    // A raw-backed enum's `from(raw:)`, which every such enum has (design
    // 145); its row's declaration is the enum's own.
    case RawConversion
}

// One member of a nominal type's table, built once per type; a module's view
// of it is a filter (`member_visible`), not a copy.
public struct TcMember {
    public type_decl: Int
    public decl: Int
    public source: TcSource
    public module: Int
    public ext: Int
    public trait_decl: Int
    public vis: ResVis
    public name: Int
}

// A nominal type's Copy tier: `base` joined with the tiers of the arguments
// whose parameter indices `mask` holds. A declared policy is uniform over the
// arguments, so its mask is empty.
public struct TcTier {
    public state: Int
    public base: Int
    public mask: Int
    public declared: Bool
}

// A type argument whose bound is checked once the conformance table exists.
public struct TcObligation {
    public module: Int
    public node: Int
    public arg: Int
    public trait_decl: Int
    // The generic parameter it is bound for: its declaration and index.
    public owner: Int
    public index: Int
    // Where the argument is written: the declaration and the extension whose
    // parameters' bounds are in scope there.
    public env_decl: Int
    public env_ext: Int
}

// How a body's expression is read where it stands (SL:architecture §3.4,
// "Out"). The first three are a value use's transfer kind; the rest read a
// place, or a temporary, without taking it.
public enum TcUse {
    // Not an expression, or one nothing has read yet.
    case Unused,
    // A spelled `move`: the moved place, and the value it yields.
    case Move,
    // An implicit copy of a place.
    case Copy,
    // The hand-off of an owned temporary.
    case Temp,
    // A shared borrow: a receiver, an `&`, a comparison operand, a format
    // argument, an interpolated segment.
    case Borrow,
    // An exclusive borrow: a receiver, an `&var`.
    case BorrowVar,
    // The base of a member, tuple index, force or subscript, which reads on
    // into a part of it.
    case Project,
    // An assignment's target.
    case Write,
    // A compound assignment's target, read then written.
    case Update,
    // What a pattern tests: a scrutinee or an optional binding's subject.
    case Test
}

// An implicit conversion, one step of an expression's adjustment chain.
public enum TcAdjustKind {
    // A literal or constant takes the type its position expects (design 87).
    case Adopt,
    // `Never` becomes whatever the position expects.
    case Never,
    // Auto-wrap into an Optional, a Result's `Ok` or its `Err`.
    case Some,
    case Ok,
    case Err,
    // `&v`, `&var v` of a `Vector` or an array, to a slice.
    case Slice,
    // A reference read through to its referent.
    case Deref,
    // A receiver's implicit borrow, shared or exclusive.
    case Borrow,
    case BorrowVar,
    // An exclusive reference passed where a shared one is expected.
    case Shared,
    // A concrete value becoming an existential: `any Trait`, `Box<any Error>`.
    case Erase,
    // An integer extended losslessly into a wider one, by its own signedness
    // (spec, Integer Width Agreement).
    case Widen
}

// What a funnel position lets a conversion build beyond the exact and
// structural steps: the matrix of compiler/tests/typecheck/README.md, "The
// wrap and erasure matrix".
public struct TcAllowance {
    // Optional wraps still allowed; TC_ANY_DEPTH for any number.
    public optionals: Int
    // Result wraps still allowed.
    public results: Int
    // Whether a concrete error erases into `Box<any Error>` under the `Err`
    // wrap: only a return target supplies the box's allocator.
    public erases: Bool
    // Whether an integer widens losslessly: every transfer, and never an
    // operator's peer, which must agree.
    public widens: Bool
}

// An allowance's `optionals` when a slot may nest optionals to any depth.
public static TC_ANY_DEPTH: Int = -1

public struct TcAdjust {
    public kind: TcAdjustKind
    // The type after this step.
    public to: Int
    // The next step of the same expression's chain, or -1.
    public next: Int
}

// What a call, operator, subscript or loop head calls.
public enum TcRole {
    // An ordinary call of a function, method, static method or init.
    case Call,
    // The memberwise construction of a struct, which no declaration writes.
    case Memberwise,
    // An enum case's construction.
    case Case,
    // A builtin function: `print`, `panic`, `assert`, `sizeof`, `alignof`.
    case Builtin,
    // A conversion no declaration writes: a raw-backed enum's `from(raw:)`
    // (design 145), an integer's `from` and `from(truncating:)` (design
    // 170), a distinct alias's construction.
    case Conversion,
    // An operator a builtin type answers, which no declaration writes.
    case BuiltinOperator,
    // An operator a declared method answers: `equals`, `compare`.
    case Operator,
    // The three subscript roles (SL:borrowing §5): a declared or derived
    // getitem or setitem, and the place accessor itself.
    case Getitem,
    case Setitem,
    case Place,
    // A `for` loop's `next`.
    case Iterator,
    // A function value's call: its type is the target.
    case Value
}

// One call's resolution: the declaration it calls, and at what. A member of a
// generic type is instantiated at `owner`, the receiver's type, and a
// generic declaration at its own type arguments.
public struct TcCall {
    public node: Int
    public target: Int
    public role: TcRole
    // Whether a getitem or setitem is derived from the place accessor.
    public derived: Bool
    public owner: Int
    public inst_first: Int
    public inst_count: Int
    // A builtin operator's or function's spelling, interned; -1 otherwise.
    public spelling: Int
    // The exclusive twin of a shared accessor the call chose, which a use
    // that writes switches to (design 141); -1 for none.
    public twin: Int
}

public struct TcDiag {
    public module: Int
    public start: Int
    public end: Int
    public id: String
    public message: String
    // A diagnostic in an interface module, which refuses nothing.
    public note: Bool
}
