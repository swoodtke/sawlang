// The records the signature half of type checking produces (SL:architecture
// §3.4, "Order"): every declaration's signature, the trait conformance table,
// the member tables and the Copy tiers. Every record is plain data keyed by
// resolve's ids: a declaration by its index in resolve's table, a node by its
// arena id, a type by its interner id.

import sawresolve.model.{ResVis}
import std.serialize.{DecodeError, DecodeFault, Decoder, EncodeError, Encoder}

// The effect slot's words, as bits (syntax.rule.effect-slot).
public static TC_EFFECT_UNSAFE: Int = 1
public static TC_EFFECT_SYNC: Int = 2
public static TC_EFFECT_CONSUMES: Int = 4
public static TC_EFFECT_BORROWS: Int = 8
public static TC_EFFECT_BORROWS_SYNC: Int = 16
public static TC_EFFECT_ESCAPING: Int = 32
public static TC_EFFECT_CONSTEXPR: Int = 64
// A Saw function whose body blocks its thread (spec, Blocking functions); an
// extern's `blocking` prefix is `TC_FLAG_BLOCKING`.
public static TC_EFFECT_BLOCKING: Int = 128
// A function type whose value is `Send` and `Sync`: written `sendable`, or
// carried by a closure whose every capture proves both, and by a named
// function, which captures nothing. It is part of the type, never of a
// declaration (spec, Sendable function types).
public static TC_EFFECT_SENDABLE: Int = 256

// What else a declaration's head says, as bits.
public static TC_FLAG_STATIC: Int = 1
public static TC_FLAG_DEFAULT_BODY: Int = 2
public static TC_FLAG_VARIADIC: Int = 4
public static TC_FLAG_BLOCKING: Int = 8
public static TC_FLAG_UNSAFE_STRUCT: Int = 16
public static TC_FLAG_BORROWS_STRUCT: Int = 32
public static TC_FLAG_SYNTHESIZE: Int = 64
public static TC_FLAG_SYNTHESIZE_SHARED: Int = 128
public static TC_FLAG_UNSAFE_VAR: Int = 256
public static TC_FLAG_WRITTEN_RETURN: Int = 512
// Set while an alias or type assignment is being resolved, to find a cycle.
public static TC_FLAG_ALIAS_BUILDING: Int = 1024
// The `&self` twin `@synthesize(shared)` derives, whose body is its
// accessor's checked again under the shared signature.
public static TC_FLAG_DERIVED_TWIN: Int = 2048

// The three Copy tiers (design 219), strongest last: a composite takes the
// strongest of its parts.
public static TC_TIER_COPY: Int = 0
public static TC_TIER_EXPLICIT: Int = 1
public static TC_TIER_NOCOPY: Int = 2

public enum TcReceiver: UInt8 {
    // A free function, a static method, an init: no receiver.
    case Absent = 0,
    case Shared = 1,
    case Exclusive = 2
}

// What a `borrows` accessor lends, as the accessor-signature reader classifies
// its return type (SL:architecture §3.4).
public enum TcLend: UInt8 {
    case NotBorrows = 0,
    // `&T`, `&var T`: a place.
    case Place = 1,
    // `&T?`, `&var T?`: a place that may be absent.
    case ConditionalPlace = 2,
    // `&[T]`, `&var [T]`.
    case Slice = 3,
    // `&[T]?`.
    case ConditionalSlice = 4,
    // A borrowing struct, lent by value.
    case BorrowingStruct = 5,
    // Anything else, which the checks on `borrows` bodies refuse.
    case Other = 6
}

// A declaration's signature. Which fields mean something depends on the kind:
// a function's generics, parameters, effects and result; a field's, static's
// or alias's result; a case's payload as parameters; an enum's raw backing as
// its result; a trait's parents and an extension's conformances as traits; an
// extension's target as its result and its generic parameters' bounds as the
// conditions its members hold under.
public struct TcSig {
    // 0 unbuilt, 1 generics under construction, 2 generics built, 3 built.
    state: Int
    generic_first: Int
    generic_count: Int
    param_first: Int
    param_count: Int
    trait_first: Int
    trait_count: Int
    receiver: TcReceiver
    result: Int
    effects: Int
    flags: Int
    lending: TcLend
    lending_exclusive: Bool
}

extension TcSig {
    public static func blank() -> TcSig {
        TcSig(state: 0, generic_first: 0, generic_count: 0, param_first: 0, param_count: 0,
              trait_first: 0, trait_count: 0, receiver: TcReceiver.Absent, result: -1, effects: 0,
              flags: 0, lending: TcLend.NotBorrows, lending_exclusive: false)
    }
}

// One generic parameter: its bounds are traits, its default a type (or a
// constant for a const parameter), and a const parameter's type.
public struct TcGeneric {
    name: Int
    leaf: Int
    node: Int
    is_const: Bool
    bound_first: Int
    bound_count: Int
    default_type: Int
    const_type: Int
}

// A parameter, a payload field, or a named-tuple element: its name and type.
public struct TcParam {
    name: Int
    leaf: Int
    ty: Int
    has_default: Bool
    // Whether the parameter's function type says `escaping`, which its type,
    // the storage form, does not carry (D35).
    escaping: Bool
}

public enum TcStatusKind: UInt8 {
    // Written by the type: in the conformance, or another of its extensions.
    case Written = 0,
    // Filled by the trait's default body.
    case Default = 1,
    // Derived under `@synthesize` (design 128).
    case Synthesized = 2,
    // Synthesized with no marker: a `deinit`, and an associated type's
    // absence never is.
    case Implicit = 3,
    case Missing = 4,
    // An init requirement a struct's memberwise construction meets: its
    // fields are the requirement's labels and types (spec, Init requirements).
    case Memberwise = 5
}

// How one requirement of a conformance is met.
public struct TcStatus {
    requirement: Int
    kind: TcStatusKind
    // The member that meets it, when one is written.
    member: Int
}

// One entry of the conformance table: (type, trait), where it is declared,
// and how each requirement is met.
public struct TcConformance {
    module: Int
    ext: Int
    node: Int
    type_decl: Int
    trait_decl: Int
    status_first: Int
    status_count: Int
}

public enum TcSource: UInt8 {
    // A field or case the type's own declaration holds.
    case Declared = 0,
    // A method, static, init or type assignment of an extension.
    case Extension = 1,
    // A trait's default body, through a conformance.
    case Default = 2,
    // Derived under `@synthesize`.
    case Synthesized = 3,
    // A raw-backed enum's `from(raw:)`, which every such enum has (design
    // 145); its row's declaration is the enum's own.
    case RawConversion = 4
}

// One member of a nominal type's table, built once per type; a module's view
// of it is a filter (`member_visible`), not a copy.
public struct TcMember {
    type_decl: Int
    decl: Int
    source: TcSource
    module: Int
    ext: Int
    trait_decl: Int
    vis: ResVis
    name: Int
}

// A bound a member's declaring extension puts on a parameter of its type that
// a receiver's argument does not meet: the parameter's index and the trait.
public struct TcUnmetBound {
    index: Int
    trait_decl: Int
}

// What an extension's head writes in its parameter list (`head_kind`).
public enum TcHeadKind {
    // Each one renames the extended type's parameter: a generic extension.
    case Generic,
    // Each one names a type: a specialized extension (spec, Type Extensions).
    case Specialized,
    // Some name a type and some rename a parameter, which is refused.
    case Partial
}

// A nominal type's Copy tier: `base` joined with the tiers of the arguments
// whose parameter indices `mask` holds. A declared policy is uniform over the
// arguments, so its mask is empty.
public struct TcTier {
    state: Int
    base: Int
    mask: Int
    declared: Bool
}

// A type argument whose bound is checked once the conformance table exists
// (`oblige`, THE BOUND FUNNEL).
public struct TcObligation {
    module: Int
    node: Int
    arg: Int
    trait_decl: Int
    // The generic parameter it is bound for: its declaration and index.
    owner: Int
    index: Int
    // Where the argument is written: the declaration and the extension whose
    // parameters' bounds are in scope there.
    env_decl: Int
    env_ext: Int
    // Whether it is written in test code, which may use the module's
    // test-only conformances.
    test: Bool
    // What the refusal says after the bound, when the place that formed the
    // instantiation knows more than the types do: a call's closure argument
    // that keeps a `Send` bound from holding. "" for the default hint.
    note: String
}

// How a body's expression is read where it stands (SL:architecture §3.4,
// "Out"). The first three are a value use's transfer kind; the rest read a
// place, or a temporary, without taking it.
public enum TcUse: UInt8 {
    // Not an expression, or one nothing has read yet.
    case Unused = 0,
    // A move: a spelled `move`'s place and the value it yields, or a local's
    // by-value read that no later use follows on any path (design 219).
    case Move = 1,
    // An implicit copy of a place.
    case Copy = 2,
    // The hand-off of an owned temporary.
    case Temp = 3,
    // A shared borrow: a receiver, an `&`, a comparison operand, a format
    // argument, an interpolated segment.
    case Borrow = 4,
    // An exclusive borrow: a receiver, an `&var`.
    case BorrowVar = 5,
    // The base of a member, tuple index, force or subscript, which reads on
    // into a part of it.
    case Project = 6,
    // An assignment's target.
    case Write = 7,
    // A compound assignment's target, read then written.
    case Update = 8,
    // What a pattern tests: a scrutinee or an optional binding's subject.
    case Test = 9
}

// How a move out of a place is written, which a `NoMove` refusal names.
public enum TcRelocation: UInt8 {
    // A spelled `move`.
    case Move = 0,
    // A generic body's by-value read of a local at its last use.
    case Read = 1,
    // A `[move x]` capture.
    case Capture = 2,
    // `take()` of an optional's payload.
    case Take = 3,
    // A `match` that consumes an owned binding.
    case Match = 4
}

// An implicit conversion, one step of an expression's adjustment chain.
public enum TcAdjustKind: UInt8 {
    // A literal or constant takes the type its position expects (design 87).
    case Adopt = 0,
    // `Never` becomes whatever the position expects.
    case Never = 1,
    // Auto-wrap into an Optional, a Result's `Ok` or its `Err`.
    case Some = 2,
    case Ok = 3,
    case Err = 4,
    // `&v`, `&var v` of a `Vector` or an array, to a slice.
    case Slice = 5,
    // A reference read through to its referent.
    case Deref = 6,
    // A receiver's implicit borrow, shared or exclusive.
    case Borrow = 7,
    case BorrowVar = 8,
    // An exclusive reference passed where a shared one is expected.
    case Shared = 9,
    // A concrete value becoming an existential: `any Trait`, `Box<any Error>`.
    case Erase = 10,
    // An integer extended losslessly into a wider one, by its own signedness
    // (spec, Integer Width Agreement).
    case Widen = 11,
    // A `sendable` function value taken at the same function type without
    // the word. The representation is one, so nothing is built.
    case ForgetSendable = 12,
    // The base of a `?.` hop read as its Optional's payload, on the path
    // where it is present; the absent path leaves the chain (spec, Optionals).
    // The hop holds the payload from its test to its use, exclusively where
    // that use writes (`settle_hops`).
    case Payload = 13,
    case PayloadVar = 14
}

// What a funnel position lets a conversion build beyond the exact and
// structural steps: the matrix of compiler/tests/typecheck/README.md, "The
// wrap and erasure matrix".
public struct TcAllowance {
    // Optional wraps still allowed; TC_ANY_DEPTH for any number.
    optionals: Int
    // Result wraps still allowed.
    results: Int
    // Whether a concrete error erases into `Box<any Error>` under the `Err`
    // wrap: only a return target supplies the box's allocator.
    erases: Bool
    // Whether an integer widens losslessly: every transfer, and never an
    // operator's peer, which must agree.
    widens: Bool
}

// An allowance's `optionals` when a slot may nest optionals to any depth.
public static TC_ANY_DEPTH: Int = -1

public struct TcAdjust {
    kind: TcAdjustKind
    // The type after this step.
    to: Int
    // The next step of the same expression's chain, or -1.
    next: Int
}

// What a call, operator, subscript or loop head calls.
public enum TcRole: UInt8 {
    // An ordinary call of a function, method, static method or init.
    case Call = 0,
    // The memberwise construction of a struct, which no declaration writes.
    case Memberwise = 1,
    // An enum case's construction.
    case Case = 2,
    // A builtin function: `print`, `panic`, `assert`, `sizeof`, `alignof`.
    case Builtin = 3,
    // A conversion no declaration writes: a raw-backed enum's `from(raw:)`
    // (design 145), an integer's `from` and `from(truncating:)` (design
    // 170), a distinct alias's construction.
    case Conversion = 4,
    // An operator a builtin type answers, which no declaration writes.
    case BuiltinOperator = 5,
    // An operator a declared method answers: `equals`, `compare`.
    case Operator = 6,
    // The three subscript roles (SL:borrowing §5): a declared or derived
    // getitem or setitem, and the place accessor itself.
    case Getitem = 7,
    case Setitem = 8,
    case Place = 9,
    // A `for` loop's `next`.
    case Iterator = 10,
    // A function value's call: its type is the target.
    case Value = 11,
    // A cooperative spawn form, `Task.spawn(f(x))`. No declaration answers
    // it, so the record names the form's spelling and no target; its root
    // call `f(x)` keeps a record of its own, and the task makes that call,
    // not the body the form is written in (`TcProgram.spawn_roots`). The
    // OS-thread form, `Thread.spawn { ... }`, takes a brace and is a
    // `Builtin` (`TcProgram.thread_spawn`).
    case Spawn = 12
}

// One call's resolution: the declaration it calls, and at what. A member of a
// generic type is instantiated at `owner`, the receiver's type, and a
// generic declaration at its own type arguments.
public struct TcCall {
    node: Int
    target: Int
    role: TcRole
    // Whether a getitem or setitem is derived from the place accessor.
    derived: Bool
    owner: Int
    inst_first: Int
    inst_count: Int
    // A builtin operator's or function's spelling, interned; -1 otherwise.
    spelling: Int
    // The exclusive twin of a shared accessor the call chose, which a use
    // that writes switches to (design 141); -1 for none.
    twin: Int
    // The member of the call's name and parameters on the other side of a
    // plain/`borrows` pair, which the call's position picks between
    // (SL:borrowing §12.4, SL-684); -1 for none.
    pair: Int
    // How the written arguments bind the target's parameters (design 66): a
    // run of `binds`, one entry per parameter in order, the index of the
    // written argument that binds it or TC_BIND_DEFAULT when its default
    // fills it. -1 for a record no overload filter resolved.
    bind_first: Int
    bind_count: Int
    // The first written argument a C variadic tail takes, or -1.
    variadic_from: Int
    // Whether the call is in test code, which the settling of its role
    // chooses an accessor for as its body's check did.
    test: Bool
}

// A parameter no written argument binds, which its default fills.
public static TC_BIND_DEFAULT: Int = -1

// One capture of a closure (spec, Capturing `self` and reference
// parameters): the enclosing binding its body names or its capture list
// writes, and how the closure takes it. `use` is `Copy` or `Move` for a
// by-value capture, `Borrow` or `BorrowVar` for a borrow of the enclosing
// frame; a reference parameter's value is copied, so it borrows through it.
// The capture that keeps a closure from being `sendable`: the binding it
// takes, its type and how it takes it, and the trait it fails, -1 when every
// capture proves `Send` and `Sync`.
public struct TcCaptureBlock {
    binding: Int
    ty: Int
    use: TcUse
    trait_decl: Int
}

public struct TcCapture {
    closure: Int
    // The leaf that declares the binding, or the receiver's parameter node
    // for `self`.
    binding: Int
    ty: Int
    use: TcUse
    // The capture-list entry, or the body's first mention of the binding.
    site: Int
    explicit: Bool
}

// Where a function's summary comes from (phase 2).
public static TC_SUMMARY_NONE: Int = 0
// The function's own checked body.
public static TC_SUMMARY_BODY: Int = 1
// Its declaration alone: an extern, a `sync` function whose body is not
// checked.
public static TC_SUMMARY_DECLARED: Int = 2
// A std function's row of compiler/tools/std_suspension.txt.
public static TC_SUMMARY_TABLE: Int = 3
// A std function no row names, taken as suspending.
public static TC_SUMMARY_UNTABLED: Int = 4

// What a unit's item is: a call, a copy of a place, a coercion to an
// existential, a closure's by-value capture copied where the closure is made.
// A capture item's `node` is its index in the capture table.
public static TC_ITEM_CALL: Int = 1
public static TC_ITEM_COPY: Int = 2
public static TC_ITEM_ERASE: Int = 3
public static TC_ITEM_CAPTURE: Int = 4

// `copy_partner`'s mark on a copy whose Copy requirement another read of the
// same local carries, so it adds no item of its own.
public static TC_COPY_COVERED: Int = -2

// What a forbidden condition makes illegal: a closure body that suspends, a
// dispatch through `any` to a suspending implementation, a `sync` body that
// calls what is not sync-callable.
public static TC_FORBID_CLOSURE: Int = 1
public static TC_FORBID_ERASE: Int = 2
public static TC_FORBID_SYNC: Int = 3
// A `blocking` body that suspends, which no thread can resume.
public static TC_FORBID_THREAD: Int = 4
// A copy that runs generated glue or a type parameter's copy, which cannot
// suspend (SL-877): refused where the copy's hook would.
public static TC_FORBID_COPY: Int = 5

// One condition of a summary: requirement `req` called through `ty`, a type
// parameter or a trait's `Self`. `site` is the node in the summarized body
// that brings it, and `origin` the construct it comes from, a closure's call
// or a coercion, possibly in another body. A Copy requirement's `req` is -1.
public struct TcAtom {
    ty: Int
    req: Int
    site: Int
    origin: Int
    kind: Int
}

// A function's three summaries: may-suspend and sync-callable, each a word
// and a condition list, the Copy requirement, and the conditions under which
// an instantiation of it is refused. Each list is a run of the atom pool.
public struct TcSummary {
    state: Int
    // The kinds of suspension source behind `suspends` and `nonsync`, a set
    // of `TC_CAUSE_*` bits; 0 when neither holds outright. `blocks thread`
    // is kept whatever the two words say, since it is no suspension.
    causes: Int
    // The causes the body has in a thread-context copy, where a pair runs
    // its `blocking` twin (spec, Pairs): `causes` but for each pair it
    // reaches, which adds its twin's and `paired`.
    thread_causes: Int
    suspends: Bool
    suspend_first: Int
    suspend_count: Int
    nonsync: Bool
    nonsync_first: Int
    nonsync_count: Int
    copy_first: Int
    copy_count: Int
    forbid_first: Int
    forbid_count: Int
}

extension TcSummary {
    public static func blank() -> TcSummary {
        TcSummary(state: TC_SUMMARY_NONE, causes: 0, thread_causes: 0, suspends: false, suspend_first: 0, suspend_count: 0,
                  nonsync: false, nonsync_first: 0, nonsync_count: 0, copy_first: 0, copy_count: 0,
                  forbid_first: 0, forbid_count: 0)
    }
}

// The kinds of suspension source a summary's `causes` holds, bit for bit as
// the std suspension table records them: a park point, a `blocking` extern, a
// test intrinsic, a call through `any`, a call through a function value not
// declared `sync`, and a call no rule classifies. A `Thread.spawn` body
// permits the `blocking` cause alone of these (`check_thread_call`).
public static TC_CAUSE_COOPERATIVE: Int = 1
public static TC_CAUSE_BLOCKING: Int = 2
public static TC_CAUSE_TEST_SUSPEND: Int = 4
public static TC_CAUSE_DISPATCH: Int = 8
public static TC_CAUSE_CLOSURE_CALL: Int = 16
public static TC_CAUSE_UNCLASSIFIED: Int = 32
// Two causes no std table row records, both of thread context (spec,
// Blocking functions): a call reaching a `blocking` Saw function, which
// blocks the thread and is refused at a task root (`check_task_root`), and,
// in `thread_causes` alone, a call reaching a pair, whose thread copy runs
// another body, so mono keys that copy apart (`callee_key`).
public static TC_CAUSE_BLOCKS_THREAD: Int = 64
public static TC_CAUSE_PAIRED: Int = 128

// A body's unit: a declaration's body, or a closure in it. `top` is the unit
// whose summary a closure's conditions join; a top unit's run of items covers
// its closures' too. `thread` marks a unit in thread context: a
// `Thread.spawn` brace's, or a `blocking` declaration's own, which may not
// suspend and may call a `blocking` extern.
public struct TcUnit {
    decl: Int
    node: Int
    top: Int
    sync: Bool
    thread: Bool
    item_first: Int
    item_end: Int
}

// Parameter `param`'s default value of function or requirement `decl`: its
// items, a run of the declaration's top unit `unit`, and the summary they make
// on their own. The caller evaluates a default, so a call that leaves the
// argument out owes this summary (`eval_default`), and the function's own
// summary leaves it out (LANGUAGE_SPEC, "Default parameter values").
public struct TcDefault {
    decl: Int
    param: Int
    unit: Int
    item_first: Int
    item_end: Int
    summary: TcSummary
}

public struct TcItem {
    kind: Int
    node: Int
    unit: Int
}

// The positions a constant serves, which its refusals name: a static's
// initializer, a raw case's value, an `@align` argument, a `static_assert`
// condition, and the three a type fixes at compile time, an array length, a
// repeat count, and a constant generic argument or a const parameter's
// default. The constant-position funnel judges every one of them but Length
// and Argument, which the small folder of `signatures.saw` still serves.
public enum TcConstPosition: UInt8 {
    case Static = 0,
    case RawValue = 1,
    case Align = 2,
    case Assert = 3,
    case Length = 4,
    case Repeat = 5,
    case Argument = 6
}

// How far a static's initializer, or a raw-backed case's value, is typed: not
// yet, being typed ahead of the body phase (so a constant it needs from
// itself is a cycle), or typed ahead.
public enum TcStaticTyping: UInt8 {
    case Untyped = 0,
    case Typing = 1,
    case Typed = 2
}

// What a static stands for where a type fixes a constant: not evaluated (it
// is named in no such position), the constant it folds to, a static that is
// no constant, one whose value does not fit an `Int`, or one whose value
// needs a layout the bootstrap slice does not fold yet, each with its
// reason; or one whose type or initializer was refused already, which its
// own declaration reports.
public enum TcStaticVerdict: UInt8 {
    case Unevaluated = 0,
    case Folds = 1,
    case NotConstant = 2,
    case Unfit = 3,
    case NotYet = 4,
    case Poisoned = 5
}

// A constant judgment held until every body is typed, by the nodes its check
// reads: its operand may fold through a static or a raw-backed case declared
// after it, whose value no body has typed yet where the check meets it.
public enum TcPendingConstant {
    // A cast to an integer type: the constant-cast funnel.
    case Cast(e: Int),
    // A count or divisor `count` of operation `e`, -1 for a compound one,
    // over type `shifted`: the certain-fault funnel.
    case CertainFault(e: Int, count: Int, shifted: Int, divides: Bool),
    // A constant expression adopting an integer slot.
    case SlotRange(e: Int),
    // A constant position other than a static's initializer: the
    // constant-position funnel.
    case Position(e: Int, pos: TcConstPosition, d: Int, message: Int)
}

public struct TcDiag {
    module: Int
    start: Int
    end: Int
    id: String
    message: String
    // A diagnostic in an interface module, which refuses nothing.
    note: Bool
}

// A warning, which refuses nothing, and its fix-it: the source bytes
// `fix_start..<fix_end` of `module` replaced by `fix_text`. A `kept` entry
// records an old `borrow` prefix whose meaning the unprefixed spelling does
// not have, so it draws no warning and no fix-it; `message` says why.
public struct TcWarning {
    module: Int
    start: Int
    id: String
    message: String
    form: String
    fix_start: Int
    fix_end: Int
    fix_text: String
    kept: Bool
}

// The front-end image writes these types (sawmono.frontimage). They are
// derived, so a field added later is in the image by construction; only
// TcPendingConstant, whose cases carry payloads, is written by hand below.
@synthesize
extension TcSig: Serialize {}
@synthesize
extension TcSig: Deserialize {}

@synthesize
extension TcGeneric: Serialize {}
@synthesize
extension TcGeneric: Deserialize {}

@synthesize
extension TcParam: Serialize {}
@synthesize
extension TcParam: Deserialize {}

@synthesize
extension TcConformance: Serialize {}
@synthesize
extension TcConformance: Deserialize {}

@synthesize
extension TcStatus: Serialize {}
@synthesize
extension TcStatus: Deserialize {}

@synthesize
extension TcMember: Serialize {}
@synthesize
extension TcMember: Deserialize {}

@synthesize
extension TcTier: Serialize {}
@synthesize
extension TcTier: Deserialize {}

@synthesize
extension TcObligation: Serialize {}
@synthesize
extension TcObligation: Deserialize {}

@synthesize
extension TcDiag: Serialize {}
@synthesize
extension TcDiag: Deserialize {}

