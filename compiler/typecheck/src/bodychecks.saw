// The checks that read a checked program's types, outside the walk that
// typed it (SL:architecture §3.4, "Other checks that need only types", and
// "Effects"): borrowing-struct containment, a static's type, the body half of
// `unsafe`, and the `borrows(sync)` contract.

import sawparse.grammar.{Alt}
import sawresolve.collect.{res_is_top_level}
import sawresolve.dump.{res_sort_strings}
import sawresolve.kinds.{res_is_type_alt}
import sawresolve.model.{ResBindKind, ResBinding, ResDecl, ResDeclKind, ResModule}
import sawtypecheck.adjust.{TC_FIT_EXACT}
import sawtypecheck.candidates.{tc_contains}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.conform.{TcSubst, tc_args_subst}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.model.{TC_EFFECT_BORROWS, TC_EFFECT_BORROWS_SYNC, TC_EFFECT_UNSAFE,
                               TC_FLAG_BORROWS_STRUCT, TC_FLAG_UNSAFE_VAR, TcAdjust, TcAdjustKind,
                               TcCall, TcLend, TcParam, TcSig, TcUse}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.summaries.{tc_acc}
import sawtypecheck.tier.{tc_tier}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind, TcType}
import sawtypecheck.walks.{TC_INSTANTIATION_DEPTH, TcMemo, tc_memo}

// Runs every check of this file.
public func tc_check_body_rules(p: &var TcProgram) {
    p.check_containment_signatures()
    p.check_body_rules()
}

extension TcProgram {
    // Whether declaration `d` is a borrowing struct (spec, Borrowing structs).
    public func is_borrowing_struct(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        let info = self.res.decls[d]
        info.kind == ResDeclKind.Struct && (self.sigs[d].flags & TC_FLAG_BORROWS_STRUCT) != 0
    }

    // The borrowing struct type `t` holds by value, directly or inside an
    // argument, an element, a payload, a reference or a function type; -1
    // for none.
    public func borrowing_named(&self, t: Int) -> Int {
        if t < 0 {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Nominal && self.is_borrowing_struct(info.decl) {
            return t
        }
        if info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array || info.kind == TcKind.Func {
            let inner = self.borrowing_named(info.b)
            if inner >= 0 {
                return inner
            }
        }
        if info.kind == TcKind.Nominal || info.kind == TcKind.Tuple || info.kind == TcKind.Func {
            var k = 0
            while k < info.count {
                let arg = self.types.arg(t, k)
                let found = self.borrowing_named(arg)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
        }
        return -1
    }

    // The signature positions a borrowing struct may not reach: a field or a
    // payload, a parameter taken by value, a result other than a `borrows`
    // function's lend of one, and a function type's parameters or result.
    func check_containment_signatures(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.node < 0 || self.is_interface(info.module) {
                continue
            }
            let decl = d - 1
            let site = self.decl_site(decl)
            if info.kind == ResDeclKind.Field {
                let t = self.sigs[decl].result
                let found = self.borrowing_named(t)
                if found >= 0 {
                    self.refuse_containment(info.module, site, found, "stored in a field")
                }
            } else if info.kind == ResDeclKind.Case {
                let s = self.sigs[decl]
                var k = 0
                while k < s.param_count {
                    let p = self.params[s.param_first + k]
                    let found = self.borrowing_named(p.ty)
                    if found >= 0 {
                        self.refuse_containment(info.module, site, found, "stored in a payload")
                    }
                    k = k + 1
                }
            } else if info.kind == ResDeclKind.Func || info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init || info.kind == ResDeclKind.Requirement {
                self.check_function_containment(decl)
            } else if info.kind == ResDeclKind.Enum {
                self.check_raw_backing(decl)
            } else if info.kind == ResDeclKind.Static {
                self.check_static_type(decl)
            }
        }
        var k = 0
        while k < self.func_nodes.len() {
            let node = self.func_nodes[k]
            k = k + 1
            let t = self.node_types[node]
            if t < 0 {
                continue
            }
            let m = self.node_module(node)
            if m < 0 || self.is_interface(m) {
                continue
            }
            let found = self.borrowing_named(t)
            if found >= 0 {
                self.refuse_containment(m, node, found, "carried by a function type")
            }
        }
    }

    func check_function_containment(&var self, d: Int) {
        let info = self.res.decls[d]
        let s = self.sigs[d]
        let site = self.decl_site(d)
        if (s.effects & TC_EFFECT_BORROWS) != 0 && s.lending == TcLend.Other {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` is declared `borrows`, and lends `")
            try! msg.append(self.type_text(s.result))
            try! msg.append("`: a `borrows` function lends a place (`&T`, `&var T`), a slice, an optional of either, or a borrowing struct")
            self.refuse_in(info.module, site, "borrows.result", msg.build())
        }
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            k = k + 1
            // A reference passes a bound place onward (SL:borrowing §2.7),
            // and a function type answers for itself.
            if self.is_reference(p.ty) || self.kind_of(p.ty) == TcKind.Func {
                continue
            }
            let found = self.borrowing_named(p.ty)
            if found >= 0 {
                self.refuse_containment(info.module, site, found, "taken as a parameter by value")
            }
        }
        if s.result < 0 {
            return
        }
        let lent_struct = (s.effects & TC_EFFECT_BORROWS) != 0 && s.lending == TcLend.BorrowingStruct
        if lent_struct || self.kind_of(s.result) == TcKind.Func {
            return
        }
        let found = self.borrowing_named(s.result)
        if found >= 0 {
            self.refuse_containment(info.module, site, found, "returned plainly, by a function that does not lend it with `borrows`")
        }
    }

    // An enum's raw backing (spec, Raw-backed enums): a fixed-width or
    // platform integer written as itself, since the backing pins the
    // representation and an alias is a distinct type, `Byte` included; and
    // only on an enum whose cases carry no payload.
    func check_raw_backing(&var self, d: Int) {
        let backing = self.sigs[d].result
        if backing < 0 || self.has_error(backing) {
            return
        }
        let info = self.res.decls[d]
        let written = self.backing_node(d)
        var msg = StringBuilder()
        try! msg.append("enum `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` is backed by `")
        if written >= 0 && self.names_alias(written) {
            try! msg.append(self.text(info.module, written))
            try! msg.append("`, a type alias: a raw backing is a fixed-width integer or the platform `Int`/`UInt`, written as itself, so write `")
            try! msg.append(self.type_text(backing))
            try! msg.append("`")
            self.refuse_in(info.module, written, "type.raw-backing", msg.build())
            return
        }
        if not self.is_integer(backing) {
            try! msg.append(self.type_text(backing))
            try! msg.append("`, which is not an integer type: a raw backing is a fixed-width integer or the platform `Int`/`UInt`")
            let site = if written >= 0 { written } else { self.decl_site(d) }
            self.refuse_in(info.module, site, "type.raw-backing", msg.build())
            return
        }
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let c = members[k]
            k = k + 1
            if self.res.decls[c].kind == ResDeclKind.Case && self.sigs[c].param_count > 0 {
                var why = StringBuilder()
                try! why.append("case `")
                try! why.append(self.res.decl_path(c))
                try! why.append("` carries a payload, so its enum cannot declare a raw backing: a case with a payload has no integer identity")
                let site = self.decl_site(c)
                self.refuse_in(info.module, site, "type.raw-backing", why.build())
                return
            }
        }
        self.check_raw_values(d, &members)
    }

    // Rule 2 of raw-backed enums: every case states its value, and no two
    // share one, compared by their folded values, so `1` and `0x01` are one
    // value. A value whose fold faulted was refused where it is written.
    func check_raw_values(&var self, d: Int, members: &Vector<Int>) {
        let info = self.res.decls[d]
        var cases = Vector<Int>()
        var values = Vector<Int>()
        var k = 0
        while k < members.len() {
            let c = members[k]
            k = k + 1
            if self.res.decls[c].kind != ResDeclKind.Case {
                continue
            }
            let node = self.raw_value_node(c)
            if node < 0 {
                var why = StringBuilder()
                try! why.append("case `")
                try! why.append(self.res.decl_path(c))
                try! why.append("` needs an explicit value: every case of an enum with a raw backing declares its own, since the backing says the numbers are ABI and none is assigned for you")
                let site = self.decl_site(c)
                self.refuse_in(info.module, site, "type.raw-value", why.build())
                continue
            }
            let v = self.fold_constant(node)
            if not v.ok {
                continue
            }
            var j = 0
            while j < values.len() {
                if values[j] == v.bits {
                    var why = StringBuilder()
                    try! why.append("cases `")
                    // Stage 0 workaround (SL:hazards S4): canonical: try! why.append(self.name_text(self.res.decls[cases[j]].name))
                    let first_name = self.res.decls[cases[j]].name
                    try! why.append(self.name_text(first_name))
                    try! why.append("` and `")
                    // Stage 0 workaround (SL:hazards S4): canonical: try! why.append(self.name_text(self.res.decls[c].name))
                    let second_name = self.res.decls[c].name
                    try! why.append(self.name_text(second_name))
                    try! why.append("` of enum `")
                    try! why.append(self.res.decl_path(d))
                    try! why.append("` both have raw value ")
                    try! why.append(self.fold_text(&v))
                    try! why.append(": raw values identify the cases on the wire, so they must be distinct")
                    self.refuse_in(info.module, node, "type.raw-value", why.build())
                    j = values.len()
                }
                j = j + 1
            }
            try! cases.push(c)
            try! values.push(v.bits)
        }
    }

    // The type node enum `d` writes its raw backing with, or -1.
    func backing_node(&self, d: Int) -> Int {
        let info = self.res.decls[d]
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if not self.is_leaf(c) && res_is_type_alt(self.node_alt(c)) {
                return c
            }
            k = k + 1
        }
        return -1
    }

    // Whether type node `t` names a type alias by its path's last segment.
    func names_alias(&self, t: Int) -> Bool {
        if self.child_count(t) == 0 {
            return false
        }
        let path = self.child(t, 0)
        let segments = self.child_count(path)
        if segments == 0 {
            return false
        }
        let leaf = self.child(path, segments - 1)
        let b = self.binding_at(leaf)
        b.kind == ResBindKind.Decl && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Alias
    }

    // A static's own type is never an optional (spec, Module-level statics:
    // "Never optional"); an `unsafe static var`, whose absence may be real,
    // is exempt.
    func check_static_type(&var self, d: Int) {
        let s = self.sigs[d]
        if s.result < 0 || (s.flags & TC_FLAG_UNSAFE_VAR) != 0 {
            return
        }
        self.check_static_sync(d)
        if not self.is_optional(s.result) {
            return
        }
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("the static `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` is `")
        try! msg.append(self.type_text(s.result))
        try! msg.append("`, and a static is never optional: it is initialized once and always present, so give it the payload's type, or compute absent state with `Once<T>` or an `unsafe static var`")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "static.optional", msg.build())
    }

    // A static's type is `Sync`, since every thread reaches it (spec,
    // Module-level statics: "Sync-only"); the caller exempts an
    // `unsafe static var`, whose declaration is the claim made by hand.
    func check_static_sync(&var self, d: Int) {
        let t = self.sigs[d].result
        if self.has_error(t) {
            return
        }
        let sync = self.known.sync
        if sync < 0 || self.satisfies(t, sync, -1, -1) {
            return
        }
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("the static `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` has type `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, which is not `Sync`, and a static is reachable from every thread")
        let why = self.sync_blocker_text(t)
        if why.len() > 0 {
            try! msg.append(": ")
            try! msg.append(why)
            try! msg.append("; or")
        } else {
            try! msg.append(";")
        }
        try! msg.append(" give the static a `Sync` type, such as `Atomic<Int>` or a `SpinLock`, or declare it an `unsafe static var` and own the argument that serializes it")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "static.not-sync", msg.build())
    }

    // Why type `t`, which is not `Sync`, derives none: the member that blocks
    // the derivation, followed down to the type that must declare
    // `UnsafeSync` when it holds a cell, or "" when nothing more is known.
    func sync_blocker_text(&var self, t: Int) -> String {
        var explained = tc_memo()
        self.sync_blocker_in(t, &var explained)
    }

    // One step of `sync_blocker_text`. A type already explained on the way
    // down adds nothing; past the instantiation depth, `satisfies` refuses
    // the derivation with its own diagnostic, so the explanation stops.
    func sync_blocker_in(&var self, t: Int, explained: &var TcMemo) -> String {
        if not explained.mark(t, 0) || self.nesting_depth(t) > TC_INSTANTIATION_DEPTH {
            return ""
        }
        let sync = self.known.sync
        let info = self.types.ty(t)
        if info.kind == TcKind.Array {
            return self.sync_blocker_in(info.b, &var explained)
        }
        if info.kind == TcKind.Tuple {
            var k = 0
            while k < info.count {
                let e = self.types.arg(t, k)
                if not self.satisfies(e, sync, -1, -1) {
                    return self.sync_blocker_in(e, &var explained)
                }
                k = k + 1
            }
            return ""
        }
        if info.kind != TcKind.Nominal {
            return ""
        }
        let d = info.decl
        if d == self.known.optional {
            let inner = self.types.arg(t, 0)
            return self.sync_blocker_in(inner, &var explained)
        }
        let unmet = self.unmet_sync_condition(t, &var explained)
        if unmet.len() > 0 {
            return unmet
        }
        let decl = self.res.decls[d]
        if decl.node < 0 {
            return ""
        }
        let arguments = self.nominal_args(t)
        let subst = tc_args_subst(d, move arguments)
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            let s = self.sigs[m]
            var blocked = -1
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                let ft = self.subst(s.result, &subst)
                if not self.satisfies(ft, sync, -1, -1) {
                    blocked = ft
                }
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count && blocked < 0 {
                    let p = self.params[s.param_first + j]
                    let pt = self.subst(p.ty, &subst)
                    if not self.satisfies(pt, sync, -1, -1) {
                        blocked = pt
                    }
                    j = j + 1
                }
            }
            if blocked < 0 {
                continue
            }
            var member = StringBuilder()
            if mi.kind == ResDeclKind.Case {
                try! member.append("the payload of ")
            }
            try! member.append("`")
            try! member.append(self.res.decl_path(m))
            try! member.append("`")
            let member_text = member.build()
            var out = StringBuilder()
            let owner = self.res.decl_path(d)
            let bi = self.types.ty(blocked)
            if bi.kind == TcKind.Nominal && bi.decl == self.known.interior {
                try! out.append("`")
                try! out.append(owner)
                try! out.append("` holds an interior cell in ")
                try! out.append(member_text)
                try! out.append(" (`")
                try! out.append(self.type_text(blocked))
                try! out.append("`), so it derives no `Sync`; when its synchronization is real, declare `extension ")
                try! out.append(owner)
                try! out.append(": UnsafeSync \{\}` beside the type")
                return out.build()
            }
            try! out.append(member_text)
            try! out.append(" has type `")
            try! out.append(self.type_text(blocked))
            try! out.append("`, which is not `Sync`")
            let deeper = self.sync_blocker_in(blocked, &var explained)
            if deeper.len() > 0 {
                try! out.append(": ")
                try! out.append(deeper)
            }
            return out.build()
        }
        ""
    }

    // For a type whose `UnsafeSync` conformance is conditional, the bound one
    // of its arguments fails, and why; "" when it declares none or none fails.
    func unmet_sync_condition(&var self, t: Int, explained: &var TcMemo) -> String {
        let info = self.types.ty(t)
        let sync = self.known.sync
        var c = 0
        while c < self.conformances.len() {
            let one = self.conformances[c]
            c = c + 1
            if one.type_decl != info.decl || not self.trait_refines(one.trait_decl, sync) {
                continue
            }
            self.ensure_generics(one.ext)
            let s = self.sigs[one.ext]
            var k = 0
            while k < s.generic_count && k < info.count {
                let g = self.generics[s.generic_first + k]
                let arg = self.types.arg(t, k)
                var j = 0
                while j < g.bound_count {
                    let bound = self.traits[g.bound_first + j]
                    j = j + 1
                    if self.satisfies(arg, bound, -1, -1) {
                        continue
                    }
                    var out = StringBuilder()
                    try! out.append("its `")
                    try! out.append(self.res.decl_path(one.trait_decl))
                    try! out.append("` conformance holds only where its argument meets `")
                    try! out.append(self.res.decl_path(bound))
                    try! out.append("`, and `")
                    try! out.append(self.type_text(arg))
                    try! out.append("` does not")
                    let deeper = self.sync_blocker_in(arg, &var explained)
                    if deeper.len() > 0 {
                        try! out.append(": ")
                        try! out.append(deeper)
                    }
                    return out.build()
                }
                k = k + 1
            }
        }
        ""
    }

    func refuse_containment(&var self, m: Int, at: Int, t: Int, how: String) {
        var msg = StringBuilder()
        try! msg.append("the borrowing struct `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is ")
        try! msg.append(how)
        try! msg.append(": it carries a loan, and lives only where a `borrows` function lends it, the head of a `borrow` or a `for`")
        self.refuse_in(m, at, "borrowing.containment", msg.build())
    }
}

// The walk over every checked body.
extension TcProgram {
    func check_body_rules(&var self) {
        var unsafe_noted = Vector<Int>()
        var k = 0
        while k < self.body_roots.len() {
            let root = self.body_roots[k]
            let d = self.body_decls[k]
            k = k + 1
            if tc_contains(&self.poisoned, root) {
                continue
            }
            var watch_unsafe = d >= 0 && self.needs_unsafe_watch(d) && not tc_contains(&unsafe_noted, d)
            var stack = Vector<Int>()
            var local = Vector<Bool>()
            try! stack.push(root)
            try! local.push(false)
            var depth = 1
            while depth > 0 {
                depth = depth - 1
                let id = stack[depth]
                var contained = local[depth]
                if tc_contains(&self.skipped, id) {
                    continue
                }
                self.check_node_containment(id)
                // A closure whose own signature names an unsafe type keeps
                // its contact local: the slot it is passed to declares the
                // effect (spec, Unsafe Code, "Closures").
                if self.has_alt(id, Alt.Expr_Closure) && self.expr_types[id] >= 0 {
                    let closure_type = self.expr_types[id]
                    if self.unsafe_named(closure_type) >= 0 {
                        contained = true
                    }
                }
                if watch_unsafe && not contained && self.touches_unsafe(d, id) {
                    try! unsafe_noted.push(d)
                    watch_unsafe = false
                }
                self.check_sync_window(id, d)
                var c = self.child_count(id) - 1
                while c >= 0 {
                    let child = self.child(id, c)
                    if not self.is_leaf(child) {
                        if depth < stack.len() {
                            stack[depth] = child
                            local[depth] = contained
                        } else {
                            try! stack.push(child)
                            try! local.push(contained)
                        }
                        depth = depth + 1
                    }
                    c = c - 1
                }
            }
        }
    }

    // A binding of a borrowing struct outside a `borrow` head, and an
    // erasure of one into an existential.
    func check_node_containment(&var self, id: Int) {
        let t = self.expr_types[id]
        if t < 0 {
            return
        }
        let binding = self.has_alt(id, Alt.Stmt_BindingName) || self.has_alt(id, Alt.Pat_Name)
        if binding && self.expr_place[id] {
            let u = self.expr_use[id]
            if u != TcUse.Borrow && u != TcUse.BorrowVar && u != TcUse.Test {
                let found = self.borrowing_named(t)
                if found >= 0 {
                    let m = self.node_in_module(id)
                    self.refuse_containment(m, id, found, "bound outside the head of a `borrow` or a `for`")
                    return
                }
            }
        }
        if self.erased_trait(id) >= 0 {
            let from = self.erased_from(id)
            let found = self.borrowing_named(from)
            if found >= 0 {
                let m = self.node_in_module(id)
                self.refuse_containment(m, id, found, "erased to an existential")
            }
        }
    }

    // Whether function `d` is one whose body the unsafe trigger rule asks
    // about: a function, method or init not declared `unsafe`.
    func needs_unsafe_watch(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        let callable = info.kind == ResDeclKind.Func || info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init || info.kind == ResDeclKind.Requirement
        callable && (self.sigs[d].effects & TC_EFFECT_UNSAFE) == 0
    }

    // The body half of `unsafe` (designs 130 and 136): node `id` of function
    // `d`'s body names, binds, receives or returns a value of an unsafe type,
    // or names an `unsafe static var`, so `d` must be declared `unsafe`.
    // Returns whether it refused.
    func touches_unsafe(&var self, d: Int, id: Int) -> Bool {
        let t = self.expr_types[id]
        if t < 0 {
            return false
        }
        var found = self.unsafe_named(t)
        var a = self.adj_head[id]
        while found < 0 && a >= 0 {
            let adj = self.adjusts[a]
            found = self.unsafe_named(adj.to)
            a = adj.next
        }
        let info = self.res.decls[d]
        let site = self.decl_site(d)
        if found >= 0 {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` is not declared `unsafe`, but its body names a value of unsafe type (`")
            try! msg.append(self.type_text(found))
            try! msg.append("`) at ")
            let m = self.node_in_module(id)
            try! msg.append(self.res.node_position(m, id))
            try! msg.append(": write `unsafe` after its parameter list, where every caller can see it")
            self.refuse_in(info.module, site, "unsafe.undeclared", msg.build())
            return true
        }
        if not self.has_alt(id, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(id)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return false
        }
        let target = self.res.decls[b.decl]
        if target.kind != ResDeclKind.Static || (self.sigs[b.decl].flags & TC_FLAG_UNSAFE_VAR) == 0 {
            return false
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` is not declared `unsafe`, but its body names an unsafe static (`")
        try! msg.append(self.res.decl_path(b.decl))
        try! msg.append("`): write `unsafe` after its parameter list, where every caller can see it")
        self.refuse_in(info.module, site, "unsafe.undeclared", msg.build())
        true
    }

    // A `borrow` block or `for` whose head calls a `borrows(sync)` accessor
    // holds a borrow no suspension may span (SL:borrowing §2.5): no call in
    // its block may suspend, for any type argument. `d` is the declaration
    // whose body holds it.
    func check_sync_window(&var self, id: Int, d: Int) {
        var block = -1
        var accessor = -1
        if self.has_alt(id, Alt.Borrow_Block) {
            let n = self.child_count(id)
            var k = 0
            while k < n {
                let c = self.child(id, k)
                k = k + 1
                if self.has_alt(c, Alt.Borrow_Binding_Let) || self.has_alt(c, Alt.Borrow_Binding_Var) {
                    let place = self.res.last_node_child(c)
                    let found = self.sync_lender(place)
                    if found >= 0 && accessor < 0 {
                        accessor = found
                    }
                } else if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                }
            }
        } else if self.has_alt(id, Alt.Expr_For_Plain) {
            let target = self.res.first_node_child(id)
            block = self.res.last_node_child(id)
            let n = self.child_count(id)
            var k = 0
            while k < n {
                let c = self.child(id, k)
                k = k + 1
                if c != target && c != block && not self.is_leaf(c) {
                    accessor = self.sync_lender(c)
                }
            }
        }
        if block < 0 || accessor < 0 {
            return
        }
        self.check_window_calls(block, accessor, d)
    }

    // The `borrows(sync)` accessor the call at `place` names, or -1.
    func sync_lender(&self, place: Int) -> Int {
        if place < 0 {
            return -1
        }
        let at = self.call_at[place]
        if at < 0 {
            return -1
        }
        let c = self.calls[at]
        if c.target < 0 {
            return -1
        }
        if (self.sigs[c.target].effects & TC_EFFECT_BORROWS_SYNC) == 0 {
            return -1
        }
        c.target
    }

    // Every call under `block`, outside a closure, that may suspend.
    func check_window_calls(&var self, block: Int, accessor: Int, d: Int) {
        var stack = Vector<Int>()
        try! stack.push(block)
        var depth = 1
        while depth > 0 {
            depth = depth - 1
            let id = stack[depth]
            if tc_contains(&self.skipped, id) || self.has_alt(id, Alt.Expr_Closure) {
                continue
            }
            if self.call_at[id] >= 0 {
                var acc = tc_acc(d, -1)
                self.eval_call(id, &var acc)
                if acc.suspends || acc.suspend_atoms.len() > 0 {
                    var msg = StringBuilder()
                    try! msg.append("this call may suspend while a borrow from `")
                    try! msg.append(self.res.decl_path(accessor))
                    try! msg.append("` is open, and that accessor is `borrows(sync)`: its borrow cannot be held across a suspension, so end the borrow before the call")
                    let m = self.node_in_module(id)
                    self.refuse_in(m, id, "borrows.sync-window", msg.build())
                }
            }
            var c = self.child_count(id) - 1
            while c >= 0 {
                let child = self.child(id, c)
                if not self.is_leaf(child) {
                    if depth < stack.len() {
                        stack[depth] = child
                    } else {
                        try! stack.push(child)
                    }
                    depth = depth + 1
                }
                c = c - 1
            }
        }
    }
}
