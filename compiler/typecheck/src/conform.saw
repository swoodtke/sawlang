// The conformance table: (type, trait) to how each requirement is met, a
// trait's default bodies filling the gaps. Also the checks it makes:
// completeness, signature agreement, and the rule that a declared derivation
// is asked for with `@synthesize` (SL:architecture §3.4, "Traits").

import sawparse.grammar.{Alt}
import sawresolve.dump.{res_sort_strings}
import sawresolve.imports.{res_decl_binding}
import sawresolve.model.{ResBindKind, ResConformance, ResDecl, ResDeclKind, ResModule,
                             ResModuleKind, ResVis}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.model.{TC_EFFECT_BORROWS, TC_EFFECT_BORROWS_SYNC, TC_EFFECT_CONSUMES,
                               TC_EFFECT_UNSAFE, TC_FLAG_DEFAULT_BODY, TC_FLAG_STATIC,
                               TC_FLAG_SYNTHESIZE, TcConformance, TcParam, TcReceiver, TcSig,
                               TcStatus, TcStatusKind}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.types.{TC_HOLDS_PARAM, TcKind, TcType}

// The conformance table's entries.
public func tc_collect_conformances(p: &var TcProgram) {
    p.collect_conformances()
}

// How each conformance's requirements are met, with `visible` each module's
// extension set.
public func tc_settle_conformances(p: &var TcProgram, visible: &Vector<Bool>) {
    p.settle_conformances(&visible)
}

// Every module's extension set, a row of flags per module.
public func tc_extension_sets(p: &TcProgram) -> Vector<Bool> {
    p.extension_sets()
}

// The refusal of a test-only `copy()` on a production type.
public func tc_check_test_only_copies(p: &var TcProgram) {
    p.check_test_only_copies()
}

// The refusals of a second copy policy on one type, and of a `copy()` a Copy
// or ExplicitCopy type writes outside its policy.
public func tc_check_copy_policies(p: &var TcProgram) {
    p.check_copy_policies()
    p.check_copy_placement()
}

// A substitution: `Self` to a type, a trait's associated types to the types a
// conformance assigns, one declaration's parameters to another's (a
// requirement's to its implementation's), and a type's parameters to
// arguments.
public struct TcSubst {
    self_type: Int
    from_owner: Int
    to_owner: Int
    args_owner: Int
    args: Vector<Int>
    assoc_decls: Vector<Int>
    assoc_types: Vector<Int>
}

extension TcSubst: NoCopy {}

// A copy of `v`, element by element.
public func tc_copy_ints(v: &Vector<Int>) -> Vector<Int> {
    var out = Vector<Int>()
    var k = 0
    while k < v.len() {
        try! out.push(v[k])
        k = k + 1
    }
    move out
}

public func tc_args_subst(owner: Int, args: Vector<Int>) -> TcSubst {
    TcSubst(self_type: -1, from_owner: -1, to_owner: -1, args_owner: owner, args: move args,
            assoc_decls: Vector<Int>(), assoc_types: Vector<Int>())
}

extension TcProgram {
    // Type `t` with substitution `s` applied. A substitution replaces only
    // parameters, `Self` and the projections on them, so a type holding
    // none is its own image, whatever parts it shares.
    public func subst(&var self, t: Int, s: &TcSubst) -> Int {
        let info = self.types.ty(t)
        if (info.holds & TC_HOLDS_PARAM) == 0 {
            return t
        }
        match info.kind {
            case SelfType -> {
                if s.self_type >= 0 {
                    return s.self_type
                }
                t
            },
            case Projection -> {
                let written = self.types.arg(t, 0)
                if self.types.ty(written).kind == TcKind.SelfType {
                    var k = 0
                    while k < s.assoc_decls.len() {
                        if s.assoc_decls[k] == info.decl {
                            return s.assoc_types[k]
                        }
                        k = k + 1
                    }
                }
                let base = self.subst(written, &s)
                self.project(base, info.decl)
            },
            case Param -> {
                if info.decl == s.from_owner && s.from_owner >= 0 {
                    return self.mk_param(s.to_owner, info.a)
                }
                if info.decl == s.args_owner && info.a < s.args.len() {
                    return s.args[info.a]
                }
                t
            },
            case Ref -> {
                let inner = self.subst(info.b, &s)
                self.mk_ref(info.a == 1, inner)
            },
            case Slice -> {
                let inner = self.subst(info.b, &s)
                self.mk_slice(info.a == 1, inner)
            },
            case Nominal -> {
                var args = self.subst_args(t, &s)
                self.mk_nominal(info.decl, &args)
            },
            case Tuple -> {
                var args = self.subst_args(t, &s)
                var labels = Vector<Int>()
                if info.labeled {
                    var k = 0
                    while k < info.count {
                        try! labels.push(self.types.label(t, k))
                        k = k + 1
                    }
                }
                self.mk_tuple(&args, &labels)
            },
            case Func -> {
                var args = self.subst_args(t, &s)
                let result = self.subst(info.b, &s)
                self.mk_func(&args, result, info.a)
            },
            case Array -> {
                let element = self.subst(info.b, &s)
                let written = self.types.arg(t, 0)
                let length = self.subst(written, &s)
                self.mk_array(element, length)
            },
            case _ -> t
        }
    }

    // `base.Item` for associated type `d`: a projection while `base` is
    // still generic, else the type `base`'s conformance assigns, a production
    // one's before a test-only one's. A base that assigns none fails a bound,
    // which is refused where it is written, so the projection is an error
    // type there.
    public func project(&var self, base: Int, d: Int) -> Int {
        let info = self.types.ty(base)
        let generic = info.kind == TcKind.Param || info.kind == TcKind.Projection || info.kind == TcKind.SelfType
        if generic {
            return self.mk_projection(base, d)
        }
        if info.kind != TcKind.Nominal {
            return self.error_type
        }
        var args = Vector<Int>()
        var j = 0
        while j < info.count {
            try! args.push(self.types.arg(base, j))
            j = j + 1
        }
        let by_args = tc_args_subst(info.decl, move args)
        var pass = 0
        while pass < 2 {
            var c = 0
            while c < self.conformances.len() {
                let one = self.conformances[c]
                c = c + 1
                if one.type_decl != info.decl || self.is_test_only_conformance(c - 1) != (pass == 1) {
                    continue
                }
                let s = self.conformance_subst(c - 1)
                var k = 0
                while k < s.assoc_decls.len() {
                    if s.assoc_decls[k] == d {
                        return self.subst(s.assoc_types[k], &by_args)
                    }
                    k = k + 1
                }
            }
            pass = pass + 1
        }
        self.error_type
    }

    // For requirement `req` called through a type parameter `T` (`recv`, its
    // references peeled), adds to `s` each associated type of its trait and
    // the traits it refines as `T.Item`: the signature's `Item` is `T`'s.
    public func bound_projections(&var self, req: Int, recv: Int, s: &var TcSubst) {
        let info = self.res.decls[req]
        if info.kind != ResDeclKind.Requirement {
            return
        }
        var r = recv
        while self.types.ty(r).kind == TcKind.Ref {
            r = self.types.ty(r).b
        }
        let kind = self.types.ty(r).kind
        if kind != TcKind.Param && kind != TcKind.Projection {
            return
        }
        let traits = self.trait_and_ancestors(info.parent)
        var k = 0
        while k < traits.len() {
            let members = self.members_of(traits[k])
            var j = 0
            while j < members.len() {
                let d = members[j]
                if self.res.decls[d].kind == ResDeclKind.AssocType {
                    try! s.assoc_decls.push(d)
                    try! s.assoc_types.push(self.mk_projection(r, d))
                }
                j = j + 1
            }
            k = k + 1
        }
    }

    func subst_args(&var self, t: Int, s: &TcSubst) -> Vector<Int> {
        let info = self.types.ty(t)
        var out = Vector<Int>()
        var k = 0
        while k < info.count {
            let a = self.types.arg(t, k)
            try! out.push(self.subst(a, &s))
            k = k + 1
        }
        move out
    }

    // The declarations whose parent is `d`, in source order: a struct's
    // fields, an enum's cases, a trait's or an extension's members. Collection
    // enters them right after their parent, so they are one run.
    public func members_of(&self, d: Int) -> Vector<Int> {
        var out = Vector<Int>()
        var k = d + 1
        while k < self.res.decls.len() {
            let info = self.res.decls[k]
            if info.parent != d {
                break
            }
            try! out.push(k)
            k = k + 1
        }
        move out
    }

    // Trait `t` and every trait it refines, transitively, each once.
    public func trait_and_ancestors(&self, t: Int) -> Vector<Int> {
        var out = Vector<Int>()
        try! out.push(t)
        var head = 0
        while head < out.len() {
            let at = out[head]
            head = head + 1
            let s = self.sigs[at]
            var k = 0
            while k < s.trait_count {
                let parent = self.traits[s.trait_first + k]
                var seen = false
                var j = 0
                while j < out.len() {
                    if out[j] == parent {
                        seen = true
                    }
                    j = j + 1
                }
                if not seen {
                    try! out.push(parent)
                }
                k = k + 1
            }
        }
        move out
    }

    // Whether trait `a` is trait `b` or refines it.
    public func trait_refines(&self, a: Int, b: Int) -> Bool {
        if a == b {
            return true
        }
        let all = self.trait_and_ancestors(a)
        var k = 0
        while k < all.len() {
            if all[k] == b {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether a conformance to trait `a` gives its type trait `tr`. `Send`
    // and `Sync` are given only by themselves or by their assertions,
    // `UnsafeSend` and `UnsafeSync`: a user trait refining one requires it of
    // its conformers, which `check_derived_conformances` checks, and grants
    // nothing. Any other parent is given through the refinement.
    // ENTRY POINTS:
    //     declares_conformance
    //     unmet_sync_condition
    public func conformance_grants(&self, a: Int, tr: Int) -> Bool {
        if a == tr {
            return true
        }
        if tr == self.known.send {
            return a == self.known.unsafe_send
        }
        if tr == self.known.sync {
            return a == self.known.unsafe_sync
        }
        self.trait_refines(a, tr)
    }

    // Whether module `m` sees the extensions of module `e` on a type defined
    // in module `owner` (design 142): its own, its direct imports' and those
    // they re-export, and the type's defining module's.
    public func sees_extensions_of(&self, m: Int, e: Int, owner: Int, visible: &Vector<Bool>) -> Bool {
        if e == m || e == owner || self.std_extends_builtin(e, owner) {
            return true
        }
        let n = self.res.modules.len()
        visible[m * n + e]
    }

    // Whether module `e` is a std module extending a type the synthetic
    // builtin module holds (SL:open-questions D12): std is where such a type's
    // methods are written, so its extensions count as the defining module's.
    public func std_extends_builtin(&self, e: Int, owner: Int) -> Bool {
        if owner != self.res.builtin || e < 0 {
            return false
        }
        let info = self.res.modules[e]
        info.kind == ResModuleKind.Std
    }

    // Every module's extension set, as a row of flags per module.
    public func extension_sets(&self) -> Vector<Bool> {
        var out = Vector<Bool>()
        let n = self.res.modules.len()
        var m = 0
        while m < n {
            let row = self.res.extension_modules(m)
            var k = 0
            while k < n {
                try! out.push(row[k])
                k = k + 1
            }
            m = m + 1
        }
        move out
    }

    // The conformance table's entries, one per conformance a program's
    // extensions declare whose type and trait resolved; how each requirement
    // is met is found once the members are known.
    public func collect_conformances(&var self) {
        var k = 0
        while k < self.res.conformances.len() {
            let c = self.res.conformances[k]
            k = k + 1
            let target = self.ext_target(c.ext)
            let tb = c.trait_binding
            if target < 0 || tb.kind != ResBindKind.Decl || not self.is_trait(tb.decl) {
                continue
            }
            try! self.conformances.push(TcConformance(module: c.module, ext: c.ext, node: c.path,
                                                      type_decl: target, trait_decl: tb.decl,
                                                      status_first: 0, status_count: 0))
        }
    }

    // Whether a trait's requirement is derived under `@synthesize` (design 128):
    // the copy policies, Equatable, Comparable and Hashable, and serde's pair.
    public func is_derivable(&self, requirement: Int) -> Bool {
        let info = self.res.decls[requirement]
        let t = info.parent
        t == self.known.copy || t == self.known.explicit_copy || t == self.known.equatable || t == self.known.comparable || t == self.known.hashable || t == self.known.serialize || t == self.known.deserialize
    }

    // Whether a requirement is `Deinit`'s `deinit`, which is synthesized for
    // every type that owns something, with no marker.
    public func is_implicit(&self, requirement: Int) -> Bool {
        let info = self.res.decls[requirement]
        info.parent == self.known.deinit
    }

    // How each requirement of each conformance is met, and the refusals for
    // the ones that are not: missing, disagreeing, or derivable but unasked.
    // The production conformances are settled first, since a test-only one
    // takes their answers (`production_status`).
    public func settle_conformances(&var self, visible: &Vector<Bool>) {
        var pass = 0
        while pass < 2 {
            var k = 0
            while k < self.conformances.len() {
                if self.is_test_only_conformance(k) == (pass == 1) {
                    self.settle_conformance(k, &visible)
                }
                k = k + 1
            }
            pass = pass + 1
        }
    }

    // Whether conformance `at` exists for code in module `viewer`, test code
    // when `in_test`. One a test-only extension declares exists for its own
    // module's test code alone (resolve's `may_use`), so ordinary code is
    // checked as if it did not (SL:testing). A policy declared outside its
    // type's file exists for no code (`policy_in_place`).
    //
    // ENTRY POINTS (conformance_visible):
    //     declares_conformance
    //     has_conformance
    //     unmet_sync_condition
    //     assignment_for
    //     zero_init_vouches
    public func conformance_visible(&self, at: Int, viewer: Int, in_test: Bool) -> Bool {
        let c = self.conformances[at]
        let ext = self.res.decls[c.ext]
        self.policy_in_place(at) && self.res.may_use(ResVis.Public, ext.module, ext.test_only, viewer, in_test)
    }

    // Whether trait `tr` states a policy of its conformers: a copy policy,
    // `NoMove`, `ZeroInit`, or a thread-safety assertion. Each is a fact
    // about the type's implementation that only its defining file can vouch
    // for (SL-659).
    public func is_policy_trait(&self, tr: Int) -> Bool {
        if tr < 0 {
            return false
        }
        tr == self.known.copy || tr == self.known.explicit_copy || tr == self.known.no_copy || tr == self.known.no_move || tr == self.known.zero_init || tr == self.known.unsafe_send || tr == self.known.unsafe_sync
    }

    // THE DEFINING-FILE FUNNEL: whether declaration `at_decl`, an extension
    // or a member of one, is written in the file that defines type `d`. Test
    // code is a file of its own (SL:testing), so a test-only declaration is
    // in the defining file of a test-only type of its module only; every
    // `@test` declaration and group of a module counts as one test file.
    // ENTRY POINTS:
    //     policy_in_place
    //     check_test_only_copies
    public func in_defining_file(&self, at_decl: Int, d: Int) -> Bool {
        let a = self.res.decls[at_decl]
        let t = self.res.decls[d]
        a.module == t.module && a.test_only == t.test_only
    }

    // Whether conformance `at` is in place: not a policy, or a policy its
    // type's defining file declares. One that is not is refused
    // (`conformance.policy-placement`) and counts for nothing, so nothing
    // else is refused or decided because of it.
    // ENTRY POINTS:
    //     check_policy_placement
    //     conformance_visible
    //     declared_policy
    //     declares_no_move
    //     check_no_move_declarations
    //     is_copy_policy_conformance
    //     policy_copy
    //     declares_misplaced_policy
    //     check_zero_inits
    //     check_thread_assertion
    public func policy_in_place(&self, at: Int) -> Bool {
        let c = self.conformances[at]
        if c.type_decl < 0 || not self.is_policy_trait(c.trait_decl) {
            return true
        }
        self.in_defining_file(c.ext, c.type_decl)
    }

    // Whether conformance `at` is declared by a test-only extension.
    public func is_test_only_conformance(&self, at: Int) -> Bool {
        let c = self.conformances[at]
        self.res.decls[c.ext].test_only
    }

    // Whether the members extension `ext` writes may meet conformance `at`'s
    // requirements: those a conformance's own code may use, so a test-only
    // extension's meet only a test-only conformance of its module, and a
    // production conformance is met as if no test-only declaration existed.
    func meets_from(&self, at: Int, ext: Int) -> Bool {
        let c = self.conformances[at]
        let other = self.res.decls[ext]
        let in_test = self.is_test_only_conformance(at)
        self.res.may_use(ResVis.Public, other.module, other.test_only, c.module, in_test)
    }

    // For test-only conformance `at`, the status a production conformance of
    // its type gives requirement `req`, when one reaches `req`'s trait; else
    // -1. A production generic has one instance at a production type, which
    // production code runs, so every conformance reaching the trait answers
    // as the production one does, which sees no test-only member.
    func production_status(&self, at: Int, req: Int) -> Int {
        if not self.is_test_only_conformance(at) {
            return -1
        }
        let c = self.conformances[at]
        let tr = self.res.decls[req].parent
        var k = 0
        while k < self.conformances.len() {
            let other = self.conformances[k]
            k = k + 1
            if other.type_decl != c.type_decl || self.is_test_only_conformance(k - 1) || not self.trait_refines(other.trait_decl, tr) {
                continue
            }
            var j = 0
            while j < other.status_count {
                if self.statuses[other.status_first + j].requirement == req {
                    return other.status_first + j
                }
                j = j + 1
            }
        }
        return -1
    }

    func settle_conformance(&var self, at: Int, visible: &Vector<Bool>) {
        let c = self.conformances[at]
        let ext_sig = self.sigs[c.ext]
        let synthesize = (ext_sig.flags & TC_FLAG_SYNTHESIZE) != 0
        let saved = self.save_context()
        self.enter_decl(c.ext)
        let first = self.statuses.len()
        var derived = false
        var refused = false
        let traits = self.trait_and_ancestors(c.trait_decl)
        var s = self.conformance_subst(at)
        var t = 0
        while t < traits.len() {
            let tr = traits[t]
            let requirements = self.members_of(tr)
            var r = 0
            while r < requirements.len() {
                let req = requirements[r]
                let info = self.res.decls[req]
                if info.kind == ResDeclKind.AssocType {
                    let assigned = self.assignment_for(at, req)
                    if assigned >= 0 {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Written,
                                                         member: assigned))
                        if self.restates_differently(at, req, assigned) {
                            refused = true
                        }
                    } else {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Missing,
                                                         member: -1))
                        self.refuse_missing(at, req)
                        refused = true
                    }
                } else if info.kind == ResDeclKind.Requirement {
                    let inherited = self.production_status(at, req)
                    if inherited >= 0 {
                        let st = self.statuses[inherited]
                        try! self.statuses.push(st)
                        if st.kind == TcStatusKind.Synthesized {
                            derived = true
                        } else if st.kind == TcStatusKind.Missing {
                            refused = true
                        }
                        r = r + 1
                        continue
                    }
                    let found = self.written_member(at, req, &s, &visible)
                    if found >= 0 {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Written,
                                                         member: found))
                    } else if found == -2 {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Missing,
                                                         member: -1))
                        refused = true
                    } else if (self.sigs[req].flags & TC_FLAG_DEFAULT_BODY) != 0 {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Default,
                                                         member: -1))
                    } else if self.is_implicit(req) {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Implicit,
                                                         member: -1))
                    } else if self.is_derivable(req) && synthesize {
                        try! self.statuses.push(TcStatus(requirement: req,
                                                         kind: TcStatusKind.Synthesized, member: -1))
                        derived = true
                    } else if self.is_derivable(req) {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Missing,
                                                         member: -1))
                        self.refuse_unsynthesized(at, req)
                        refused = true
                    } else {
                        try! self.statuses.push(TcStatus(requirement: req, kind: TcStatusKind.Missing,
                                                         member: -1))
                        self.refuse_missing(at, req)
                        refused = true
                    }
                }
                r = r + 1
            }
            t = t + 1
        }
        if synthesize && not derived && not refused {
            self.refuse_inert(at)
        }
        var done = self.conformances[at]
        done.status_first = first
        done.status_count = self.statuses.len() - first
        self.conformances[at] = done
        self.restore_context(saved)
    }

    // The `copy()` body type declaration `d`'s `Copy` or `ExplicitCopy`
    // conformance writes, or -1: the hook a copy of the type runs (spec, The
    // Copy trait). A `copy()` any other extension writes is refused
    // (`copy.outside-policy`), or is a NoCopy type's ordinary method, so the
    // answer is read from the conformance and never found by the name.
    //
    // ENTRY POINTS (policy_copy):
    //     declared_copy
    public func policy_copy(&self, d: Int) -> Int {
        if d < 0 {
            return -1
        }
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            let policy = c.trait_decl >= 0 && (c.trait_decl == self.known.copy || c.trait_decl == self.known.explicit_copy)
            if c.type_decl != d || not policy || not self.policy_in_place(k - 1) {
                continue
            }
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                let own = self.res.decls[st.requirement].parent == c.trait_decl
                if own && st.kind == TcStatusKind.Written && st.member >= 0 {
                    return st.member
                }
            }
        }
        return -1
    }

    // Test code cannot change how a production type copies: a test-only
    // `copy()` on one is refused, so that how it copies, silently or spelled,
    // is production code's alone (SL-630). The policy conformance itself is
    // `conformance.policy-placement`'s, which also covers a `copy()` written
    // inside a misplaced one.
    public func check_test_only_copies(&var self) {
        let name = self.res.intern("copy")
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Method || info.name != name || not info.test_only || info.parent < 0 || info.leaf < 0 {
                continue
            }
            let ext = info.parent
            if self.res.decls[ext].kind != ResDeclKind.Extension || self.declares_misplaced_policy(ext) {
                continue
            }
            let target = self.ext_target(ext)
            if target >= 0 && not self.in_defining_file(d - 1, target) {
                self.refuse_test_only_copy(d - 1, target)
            }
        }
    }

    // One copy policy per type: `Copy`, `ExplicitCopy` and `NoCopy` exclude
    // each other, whatever bounds their extensions carry, so whether a
    // transfer copies silently, needs a spelled `.copy()` or only moves has
    // one answer (SL-641). Each conformance after a type's first policy is
    // refused; `declared_policy` reads the one left.
    //
    // ENTRY POINTS (check_copy_policies):
    //     tc_check_copy_policies
    public func check_copy_policies(&var self) {
        var first = Vector<Int>()
        var d = 0
        while d < self.res.decls.len() {
            try! first.push(-1)
            d = d + 1
        }
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if not self.is_copy_policy_conformance(k - 1) {
                continue
            }
            let earlier = first[c.type_decl]
            if earlier < 0 {
                first[c.type_decl] = k - 1
            } else if self.conformances[earlier].trait_decl != c.trait_decl {
                self.refuse_second_policy(k - 1, earlier)
            }
        }
    }

    // Whether conformance `at` declares its type's copy policy: one to `Copy`,
    // `ExplicitCopy` or `NoCopy` in the type's defining file; one outside it
    // is `conformance.policy-placement`'s.
    public func is_copy_policy_conformance(&self, at: Int) -> Bool {
        let c = self.conformances[at]
        let tr = c.trait_decl
        let policy = tr >= 0 && (tr == self.known.copy || tr == self.known.explicit_copy || tr == self.known.no_copy)
        if not policy || c.type_decl < 0 {
            return false
        }
        self.policy_in_place(at)
    }

    func refuse_second_policy(&var self, at: Int, earlier: Int) {
        let c = self.conformances[at]
        let prior = self.conformances[earlier]
        let node = self.res.nodes[prior.node]
        let position = self.res.position_text(prior.module, node.start)
        var msg = StringBuilder()
        try! msg.append(self.conformance_head(at))
        try! msg.append(", a second copy policy beside `")
        try! msg.append(self.res.decl_path(prior.trait_decl))
        try! msg.append("` at ")
        try! msg.append(position)
        try! msg.append(": a type has one of `Copy`, `ExplicitCopy` and `NoCopy`, bounded or not, so a transfer of it copies silently, needs `.copy()`, or only moves; keep the one its values need")
        self.refuse_in(c.module, c.node, "copy.second-policy", msg.build())
    }

    // A Copy or ExplicitCopy type's `copy()` is written inside its policy
    // conformance, as the one copy its silent, spelled and generic copies all
    // run, so one written anywhere else is refused where it is declared; a
    // NoCopy type's is an ordinary method (SL-641).
    public func check_copy_placement(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            if self.is_stray_copy(d) {
                self.refuse_stray_copy(d)
            }
            d = d + 1
        }
    }

    // Whether declaration `d` is a `copy()` written outside its type's copy
    // policy on a type that does not declare `NoCopy`: a method named `copy`
    // that a call with no arguments reaches, so that `x.copy()` could mean it
    // or the policy's. A test-only one on a production type is
    // `copy.test-only-policy`'s.
    public func is_stray_copy(&var self, d: Int) -> Bool {
        let info = self.res.decls[d]
        let name = self.res.intern("copy")
        if info.kind != ResDeclKind.Method || info.name != name || info.parent < 0 || info.leaf < 0 {
            return false
        }
        let ext = info.parent
        if self.res.decls[ext].kind != ResDeclKind.Extension {
            return false
        }
        let target = self.ext_target(ext)
        if target < 0 {
            return false
        }
        if info.test_only && not self.res.decls[target].test_only {
            return false
        }
        if self.declared_copy_policy(target) == self.known.no_copy || self.writes_copy_policy(ext, target) {
            return false
        }
        self.build_decl(d)
        let s = self.sigs[d]
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if not p.has_default {
                return false
            }
            k = k + 1
        }
        true
    }

    // The trait of type `d`'s first copy-policy conformance, or -1.
    func declared_copy_policy(&self, d: Int) -> Int {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            if c.type_decl == d && self.is_copy_policy_conformance(k) {
                return c.trait_decl
            }
            k = k + 1
        }
        return -1
    }

    // Whether extension `ext` declares type `d`'s `Copy` or `ExplicitCopy`
    // conformance, the one place its `copy()` is written.
    func writes_copy_policy(&self, ext: Int, d: Int) -> Bool {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            let copying = c.trait_decl == self.known.copy || c.trait_decl == self.known.explicit_copy
            if c.ext == ext && c.type_decl == d && copying {
                return true
            }
        }
        false
    }

    func refuse_stray_copy(&var self, d: Int) {
        let info = self.res.decls[d]
        let target = self.ext_target(info.parent)
        let policy = self.declared_copy_policy(target)
        let type_name = self.res.decl_path(target)
        var msg = StringBuilder()
        if policy >= 0 {
            try! msg.append("this `copy()` is written outside `")
            try! msg.append(type_name)
            try! msg.append("`'s `")
            try! msg.append(self.res.decl_path(policy))
            try! msg.append("` conformance, whose `copy()` is the one every silent, spelled and generic copy of it runs: write it inside that conformance, or give this method another name")
        } else {
            try! msg.append("`")
            try! msg.append(type_name)
            try! msg.append("` declares no copy policy, so it copies by its members at every silent, spelled and generic copy, and this `copy()` would run only when spelled: write it as the hook, `extension ")
            try! msg.append(type_name)
            try! msg.append(": Copy \{ func copy(&self) -> ")
            try! msg.append(type_name)
            try! msg.append(" \{ ... \} \}`, or declare `")
            try! msg.append(type_name)
            try! msg.append("` `NoCopy`, where `copy()` is an ordinary method")
        }
        self.refuse_in(info.module, info.leaf, "copy.outside-policy", msg.build())
    }

    // Whether extension `ext` declares a policy outside its type's defining
    // file, whose own refusal covers the `copy()` written inside it.
    func declares_misplaced_policy(&self, ext: Int) -> Bool {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.ext == ext && not self.policy_in_place(k - 1) {
                return true
            }
        }
        false
    }

    func refuse_test_only_copy(&var self, d: Int, target: Int) {
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("a test-only `copy()` on a production type is refused: test code cannot change how `")
        try! msg.append(self.res.decl_path(target))
        try! msg.append("` copies; write it in production code, or make the type test-only too")
        self.refuse_in(info.module, info.leaf, "copy.test-only-policy", msg.build())
    }

    // The substitution from a trait's view to conformance `at`'s: `Self` the
    // conforming type, each associated type the extension assigns.
    public func conformance_subst(&var self, at: Int) -> TcSubst {
        let c = self.conformances[at]
        let self_type = self.self_type_of(c.type_decl)
        var decls = Vector<Int>()
        var types = Vector<Int>()
        let traits = self.trait_and_ancestors(c.trait_decl)
        var t = 0
        while t < traits.len() {
            let requirements = self.members_of(traits[t])
            var r = 0
            while r < requirements.len() {
                let req = requirements[r]
                let info = self.res.decls[req]
                if info.kind == ResDeclKind.AssocType {
                    let assigned = self.assignment_for(at, req)
                    if assigned >= 0 {
                        self.build_decl(assigned)
                        let s = self.sigs[assigned]
                        try! decls.push(req)
                        try! types.push(s.result)
                    }
                }
                r = r + 1
            }
            t = t + 1
        }
        TcSubst(self_type: self_type, from_owner: -1, to_owner: -1, args_owner: -1,
                args: Vector<Int>(), assoc_decls: move decls, assoc_types: move types)
    }

    // The type assignment that meets associated type `req` for conformance
    // `at`, or -1: the one its own extension writes, else the one written by
    // the conforming type's conformance to the trait that declares `req`. A
    // refining trait's conformance inherits its parent's associated types
    // from that one conformance, as it inherits the parent's methods from
    // any extension, so a parent's `Item` is never restated to be met. A
    // parent conformance its own code may not use, a test-only one for a
    // production conformance, assigns nothing to it.
    public func assignment_for(&self, at: Int, req: Int) -> Int {
        let c = self.conformances[at]
        let name = self.res.decls[req].name
        let own = self.assigned_type(c.ext, name)
        if own >= 0 {
            return own
        }
        let parent = self.parent_conformance(at, req)
        let in_test = self.is_test_only_conformance(at)
        if parent < 0 || not self.conformance_visible(parent, c.module, in_test) {
            return -1
        }
        let ext = self.conformances[parent].ext
        self.assigned_type(ext, name)
    }

    // Whether conformance `at`'s own assignment `assigned` of associated type
    // `req` names another type than the parent conformance's assignment does,
    // which is refused: a type has one `Item` per trait that declares it, or a
    // call through the parent and one through the refinement would disagree.
    // A test-only parent is compared too, since a binary has one `Item`. A
    // test-only conformance is also compared with each production one that
    // reaches `req` through a sibling refinement, so the `Item` ordinary code
    // projects never depends on where a test-only conformance is declared.
    func restates_differently(&var self, at: Int, req: Int, assigned: Int) -> Bool {
        let parent = self.parent_conformance(at, req)
        if parent >= 0 {
            let p = self.conformances[parent]
            let name = self.res.decls[req].name
            let theirs = self.assigned_type(p.ext, name)
            if self.assigns_differently(at, req, assigned, theirs, parent) {
                return true
            }
        }
        if not self.is_test_only_conformance(at) {
            return false
        }
        let c = self.conformances[at]
        let declaring = self.res.decls[req].parent
        var k = 0
        while k < self.conformances.len() {
            let other = self.conformances[k]
            k = k + 1
            let reaches = other.type_decl == c.type_decl && self.trait_refines(other.trait_decl, declaring)
            // A production refinement of `at`'s own trait is
            // `conformance.test-only-overlap`'s to refuse.
            let overlap = self.trait_refines(other.trait_decl, c.trait_decl)
            if k - 1 == parent || not reaches || overlap || self.is_test_only_conformance(k - 1) {
                continue
            }
            let theirs = self.assignment_for(k - 1, req)
            if self.assigns_differently(at, req, assigned, theirs, k - 1) {
                return true
            }
        }
        false
    }

    // Whether assignment `theirs`, which conformance `other` gives associated
    // type `req`, names another type than conformance `at`'s `assigned`; the
    // refusal when it does.
    func assigns_differently(&var self, at: Int, req: Int, assigned: Int, theirs: Int, other: Int) -> Bool {
        let p = self.conformances[other]
        if theirs < 0 || theirs == assigned {
            return false
        }
        self.build_decl(assigned)
        self.build_decl(theirs)
        let mine_type = self.sigs[assigned].result
        let their_type = self.sigs[theirs].result
        if mine_type == their_type || mine_type < 0 || their_type < 0 {
            return false
        }
        let c = self.conformances[at]
        var msg = StringBuilder()
        try! msg.append(self.conformance_head(at))
        try! msg.append(" and assigns `")
        try! msg.append(self.res.decl_path(req))
        try! msg.append("` as `")
        try! msg.append(self.type_text(mine_type))
        try! msg.append("`, but its conformance to `")
        try! msg.append(self.res.decl_path(p.trait_decl))
        try! msg.append("` assigns it as `")
        try! msg.append(self.type_text(their_type))
        try! msg.append("`: a type has one assignment per associated type, so drop this one or make the two agree")
        let site = self.decl_site(assigned)
        self.refuse_in(c.module, site, "conformance.associated-conflict", msg.build())
        true
    }

    // The conformance of conformance `at`'s type to the trait declaring
    // associated type `req`, when that is a trait `at`'s refines and not its
    // own; or -1.
    func parent_conformance(&self, at: Int, req: Int) -> Int {
        let c = self.conformances[at]
        let declaring = self.res.decls[req].parent
        if declaring == c.trait_decl {
            return -1
        }
        var k = 0
        while k < self.conformances.len() {
            let other = self.conformances[k]
            if k != at && other.type_decl == c.type_decl && other.trait_decl == declaring {
                return k
            }
            k = k + 1
        }
        return -1
    }

    // The type assignment of `name` extension `ext` writes, or -1.
    func assigned_type(&self, ext: Int, name: Int) -> Int {
        let members = self.members_of(ext)
        var k = 0
        while k < members.len() {
            let d = members[k]
            let info = self.res.decls[d]
            if info.kind == ResDeclKind.TypeAssign && info.name == name {
                return d
            }
            k = k + 1
        }
        return -1
    }

    // The member of the conforming type, written in an extension the
    // conformance's module sees and whose members may meet it (`meets_from`),
    // that meets requirement `req`: its declaration, -1 when none is written,
    // or -2 when every candidate of that name disagrees with the requirement,
    // which is refused here.
    func written_member(&var self, at: Int, req: Int, s: &TcSubst, visible: &Vector<Bool>) -> Int {
        let c = self.conformances[at]
        let name = self.res.decls[req].name
        let owner_module = self.res.decls[c.type_decl].module
        // A copy policy's `copy()` is written inside the conformance, as its
        // `deinit` is: one another extension writes is never the hook every
        // copy runs, and `copy.outside-policy` refuses it (spec, The Copy
        // trait).
        let trait_decl = self.res.decls[req].parent
        let inside_only = trait_decl == self.known.copy || trait_decl == self.known.explicit_copy
        var first_candidate = -1
        var chain = self.extensions_of.first(c.type_decl, 0)
        var exts = Vector<Int>()
        while chain >= 0 {
            try! exts.push(self.extensions_of.value(chain))
            chain = self.extensions_of.following(chain)
        }
        var e = exts.len() - 1
        while e >= 0 {
            let ext = exts[e]
            e = e - 1
            let ext_module = self.res.decls[ext].module
            if inside_only && ext != c.ext {
                continue
            }
            if not self.meets_from(at, ext) || not self.sees_extensions_of(c.module, ext_module, owner_module, &visible) {
                continue
            }
            let members = self.members_of(ext)
            var k = 0
            while k < members.len() {
                let d = members[k]
                let info = self.res.decls[d]
                let callable = info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init
                if callable && info.name == name {
                    self.build_decl(d)
                    if self.agrees(req, d, &s) {
                        return d
                    }
                    if first_candidate < 0 {
                        first_candidate = d
                    }
                }
                k = k + 1
            }
        }
        if first_candidate >= 0 {
            self.refuse_disagreement(at, req, first_candidate, &s)
            return -2
        }
        return -1
    }

    // Whether member `d` agrees with requirement `req`: the same receiver,
    // staticness, parameters and result once `Self` and the associated types
    // are the conformance's, and effects the requirement's callers can rely
    // on (SL:borrowing §2.5 for `borrows`).
    public func agrees(&var self, req: Int, d: Int, s: &TcSubst) -> Bool {
        let why = self.disagreement(req, d, &s)
        why.len() == 0
    }

    // What makes member `d` disagree with requirement `req`, or "" when it
    // agrees.
    func disagreement(&var self, req: Int, d: Int, s: &TcSubst) -> String {
        let r = self.sigs[req]
        let m = self.sigs[d]
        if (r.flags & TC_FLAG_STATIC) != (m.flags & TC_FLAG_STATIC) {
            return "one is static and the other is not"
        }
        if r.receiver != m.receiver {
            return "its receiver differs"
        }
        if r.generic_count != m.generic_count {
            return "its type parameters differ in number"
        }
        if r.param_count != m.param_count {
            return "its parameters differ in number"
        }
        let renamed = TcSubst(self_type: s.self_type, from_owner: req, to_owner: d,
                              args_owner: -1, args: Vector<Int>(),
                              assoc_decls: tc_copy_ints(&s.assoc_decls),
                              assoc_types: tc_copy_ints(&s.assoc_types))
        var k = 0
        while k < r.param_count {
            let rp = self.params[r.param_first + k]
            let mp = self.params[m.param_first + k]
            if rp.name != mp.name {
                return "a parameter's name differs"
            }
            let want = self.subst(rp.ty, &renamed)
            if want != mp.ty {
                return "a parameter's type differs"
            }
            // A caller through the requirement may hand a non-escaping
            // parameter a value it only lends, so only the requirement can
            // widen it to `escaping`; narrowing is safe (SL-504).
            if mp.escaping && not rp.escaping {
                return "a parameter says `escaping` where the requirement's does not, so it could keep a function value its callers only lend"
            }
            k = k + 1
        }
        let want_result = self.subst(r.result, &renamed)
        if want_result != m.result {
            return "its result type differs"
        }
        if (r.effects & TC_EFFECT_UNSAFE) != 0 && (m.effects & TC_EFFECT_UNSAFE) == 0 {
            return "the requirement declares `unsafe`, so the implementation must too"
        }
        if (m.effects & TC_EFFECT_CONSUMES) != 0 {
            return "a requirement is never met by a `consumes` method"
        }
        let r_borrows = (r.effects & TC_EFFECT_BORROWS) != 0
        let m_borrows = (m.effects & TC_EFFECT_BORROWS) != 0
        if r_borrows != m_borrows {
            return "one lends with `borrows` and the other does not"
        }
        if (m.effects & TC_EFFECT_BORROWS_SYNC) != 0 && (r.effects & TC_EFFECT_BORROWS_SYNC) == 0 {
            return "a `borrows(sync)` implementation cannot meet a plain `borrows` requirement"
        }
        ""
    }
}

// The conformance refusals.
extension TcProgram {
    func conformance_head(&self, at: Int) -> String {
        let c = self.conformances[at]
        var out = StringBuilder()
        try! out.append("`")
        try! out.append(self.res.decl_path(c.type_decl))
        try! out.append("` conforms to `")
        try! out.append(self.res.decl_path(c.trait_decl))
        try! out.append("`")
        out.build()
    }

    func refuse_missing(&var self, at: Int, req: Int) {
        let c = self.conformances[at]
        var msg = StringBuilder()
        try! msg.append(self.conformance_head(at))
        try! msg.append(", but nothing meets its requirement `")
        try! msg.append(self.res.decl_path(req))
        try! msg.append("`: no member of that name is written, and the trait gives no default")
        self.refuse_in(c.module, c.node, "conformance.incomplete", msg.build())
    }

    func refuse_unsynthesized(&var self, at: Int, req: Int) {
        let c = self.conformances[at]
        var msg = StringBuilder()
        try! msg.append(self.conformance_head(at))
        try! msg.append(" with no `")
        try! msg.append(self.res.decl_path(req))
        try! msg.append("` written: write it, or mark the extension `@synthesize` to derive it")
        self.refuse_in(c.module, c.node, "synthesize.required", msg.build())
    }

    func refuse_inert(&var self, at: Int) {
        let c = self.conformances[at]
        var msg = StringBuilder()
        try! msg.append("`@synthesize` derives nothing here: ")
        try! msg.append(self.conformance_head(at))
        try! msg.append(", whose requirements are all written or have defaults, or which derives none")
        self.refuse_in(c.module, c.node, "synthesize.inert", msg.build())
    }

    func refuse_disagreement(&var self, at: Int, req: Int, d: Int, s: &TcSubst) {
        let c = self.conformances[at]
        let why = self.disagreement(req, d, &s)
        let site = self.decl_site(d)
        let m = self.res.decls[d].module
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` does not meet `")
        try! msg.append(self.res.decl_path(req))
        try! msg.append("`, as ")
        try! msg.append(self.conformance_head(at))
        try! msg.append(" needs: ")
        try! msg.append(why)
        self.refuse_in(m, site, "conformance.signature", msg.build())
    }
}
