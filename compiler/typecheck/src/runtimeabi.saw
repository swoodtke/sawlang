// A host's runtime sources, relative to the runtime root, in build order.
public func tc_runtime_sources(host: String) -> Vector<String> {
    var out = Vector<String>()
    if host.equals("arm64-apple-darwin") {
        try! out.push("common/mem.saw")
        try! out.push("common/offload.saw")
        try! out.push("common/op_budget.saw")
        try! out.push("common/os_ops.saw")
        try! out.push("common/proc.saw")
        try! out.push("common/pthread.saw")
        try! out.push("common/sleep.saw")
        try! out.push("common/thread_executor.saw")
        try! out.push("host_macos/clock.saw")
        try! out.push("host_macos/dirent.saw")
        try! out.push("host_macos/executable_path.saw")
        try! out.push("host_macos/lock.saw")
        try! out.push("host_macos/net_os.saw")
        try! out.push("host_macos/proc_wait.saw")
        try! out.push("host_macos/reactor.saw")
    }
    if host.equals("x86_64-unknown-linux-gnu") {
        try! out.push("common/mem.saw")
        try! out.push("common/offload.saw")
        try! out.push("common/op_budget.saw")
        try! out.push("common/os_ops.saw")
        try! out.push("common/proc.saw")
        try! out.push("common/pthread.saw")
        try! out.push("common/sleep.saw")
        try! out.push("common/thread_executor.saw")
        try! out.push("host_linux/clock.saw")
        try! out.push("host_linux/dirent.saw")
        try! out.push("host_linux/executable_path.saw")
        try! out.push("host_linux/net_os.saw")
        try! out.push("host_linux/proc_wait.saw")
        try! out.push("host_linux/reactor.saw")
    }
    if host.equals("aarch64-unknown-linux-gnu") {
        try! out.push("common/mem.saw")
        try! out.push("common/offload.saw")
        try! out.push("common/op_budget.saw")
        try! out.push("common/os_ops.saw")
        try! out.push("common/proc.saw")
        try! out.push("common/pthread.saw")
        try! out.push("common/sleep.saw")
        try! out.push("common/thread_executor.saw")
        try! out.push("host_linux/clock.saw")
        try! out.push("host_linux/dirent.saw")
        try! out.push("host_linux/executable_path.saw")
        try! out.push("host_linux/net_os.saw")
        try! out.push("host_linux/proc_wait.saw")
        try! out.push("host_linux/reactor.saw")
    }
    move out
}

// The seams a host's C shim defines.
public func tc_runtime_shim_seams(host: String) -> Vector<String> {
    var out = Vector<String>()
    if host.equals("arm64-apple-darwin") {
        try! out.push("__saw_rt_output_lock")
        try! out.push("__saw_rt_output_unlock")
        try! out.push("__saw_rt_panic")
        try! out.push("__saw_rt_set_nonblocking")
        try! out.push("__saw_rt_thread_detach")
        try! out.push("__saw_rt_thread_spawn")
        try! out.push("__saw_rt_write")
        try! out.push("__saw_rt_write_error")
        try! out.push("__saw_rt_write_line")
    }
    if host.equals("x86_64-unknown-linux-gnu") {
        try! out.push("__saw_rt_lock_acquire")
        try! out.push("__saw_rt_lock_release")
        try! out.push("__saw_rt_output_lock")
        try! out.push("__saw_rt_output_unlock")
        try! out.push("__saw_rt_panic")
        try! out.push("__saw_rt_set_nonblocking")
        try! out.push("__saw_rt_thread_detach")
        try! out.push("__saw_rt_thread_spawn")
        try! out.push("__saw_rt_write")
        try! out.push("__saw_rt_write_error")
        try! out.push("__saw_rt_write_line")
    }
    if host.equals("aarch64-unknown-linux-gnu") {
        try! out.push("__saw_rt_lock_acquire")
        try! out.push("__saw_rt_lock_release")
        try! out.push("__saw_rt_output_lock")
        try! out.push("__saw_rt_output_unlock")
        try! out.push("__saw_rt_panic")
        try! out.push("__saw_rt_set_nonblocking")
        try! out.push("__saw_rt_thread_detach")
        try! out.push("__saw_rt_thread_spawn")
        try! out.push("__saw_rt_write")
        try! out.push("__saw_rt_write_error")
        try! out.push("__saw_rt_write_line")
    }
    move out
}

func tc_abi_row(names: &var Vector<String>, params: &var Vector<String>, results: &var Vector<String>,
                owners: &var Vector<String>, name: String, param: String, result: String, owner: String) {
    try! names.push(name)
    try! params.push(param)
    try! results.push(result)
    try! owners.push(owner)
}
