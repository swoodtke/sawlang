    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_unlink", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_write", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_get_argc", "", "i32", "program")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_get_argv", "", "word", "program")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_last_raw_code", "", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_last_syserror", "", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_lock_acquire", "word", "void", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_lock_release", "word", "void", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_offload_done", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_offload_pipe_fd", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_offload_start", "word, word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_offload_take", "word", "word", "runtime")
