// The runtime ABI table (runtime/ABI.md, as compiler/tools/runtime_table.py reads it),
// compiled in: written by that tool's --write, never by hand.

// Each seam's name, its parameters' machine classes separated by commas, its
// result's class, and whether the runtime or the program defines it.
public func tc_runtime_abi_rows(names: &var Vector<String>, params: &var Vector<String>,
                                results: &var Vector<String>, owners: &var Vector<String>) {
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_alloc", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_alloc_deny_after", "word", "void", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_blocking_sleep", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_clock_monotonic_nanos", "", "i64", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_dealloc", "word, word, word", "void", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_env_contains", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_env_get", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_env_set", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_env_unset", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_executable_path", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_chdir", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_dirent_name", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_getcwd", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_lseek", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_mkdir", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_open", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_opendir", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_fs_read", "word, word, word", "word", "runtime")
