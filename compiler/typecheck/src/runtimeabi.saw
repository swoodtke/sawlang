    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_accept", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_connect_check", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_connect_start", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_listen", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_listen_on", "word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_listen_with", "word, word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_local_port", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_read", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_socketpair", "word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_tcp_write", "word, word, word", "word", "runtime")
    tc_abi_row(&var names, &var params, &var results, &var owners, "__saw_rt_thread_detach", "word", "word", "runtime")
