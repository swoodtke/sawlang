// Mutability (spec, Variables and Mutability; Reference Types): every write
// lands in a place some binding or reference makes writable. Bindings always
// initialize, so a `let` is never written, on any path, and no flow analysis
// is needed: what decides a write is the place's root binding, `let` or
// `var`, and each reference along its path, `&T` or `&var T`. The rows are
// compiler/tests/typecheck/README.md's mutability matrix.

import sawparse.src.grammar.{Alt}
import sawparse.src.tree.{AstNode}
import sawresolve.src.collect.{res_is_top_level}
import sawresolve.src.dump.{res_sort_strings}
import sawresolve.src.model.{ResBindKind, ResBinding, ResDeclKind}
import sawtypecheck.src.adjust.{TC_FIT_EXACT}
import sawtypecheck.src.binders.{TcBinder, tc_binder_of, tc_binder_text}
import sawtypecheck.src.bodies.{tc_check_bodies}
import sawtypecheck.src.checks.{tc_check_unsafe}
import sawtypecheck.src.model.{TC_EFFECT_BORROWS, TC_FLAG_UNSAFE_VAR, TcReceiver, TcRole, TcUse}
import sawtypecheck.src.program.{TcProgram}
import sawtypecheck.src.typeops.{TcClient}
import sawtypecheck.src.types.{TcKind}

// Runs the mutability check over every checked body, once each place's use
// and each closure's captures are settled.
public func tc_check_mutability(p: &var TcProgram) {
    p.check_mutability()
}

// What decides a write: allowed, or the reason it is refused and the node
// that gives the reason.
struct TcWriteVerdict {
    ok: Bool
    reason: TcWriteRefusal
    at: Int
    // For an immutable binding, what declared it.
    binder: TcBinder
    // For a capture, the closure that captured it, or -1.
    closure: Int
}

// Why a place cannot be written.
enum TcWriteRefusal {
    // The write is allowed.
    case Allowed,
    // A `let`, a pattern's, a `for` loop's, a closure parameter's binding.
    case Immutable,
    // A parameter taken by value.
    case Parameter,
    // A place reached through a shared reference, `&T` or `&[T]`.
    case SharedReference,
    // `self` in a method whose receiver is `&self`, or a `[&self]` capture.
    case SharedReceiver,
    // A binding a closure captured by value, `move` or `copy`: a `let` in
    // the closure's body.
    case ValueCapture,
    // A binding a closure captured by shared borrow, `[&x]`.
    case SharedCapture,
    // A `static` that is not an `unsafe static var`.
    case Static,
    // A `borrows` accessor that lends read-only, `-> &T`.
    case ReadOnlyLend,
    // A bare `borrow` statement, which lends its place shared.
    case SharedBorrow
}

// The per-check tables: each node's parent and each declaration by its node.
struct TcMutTables {
    parents: Vector<Int>
    decl_of_node: Vector<Int>
}

extension TcMutTables: NoCopy {}

extension TcProgram {
    // THE writability funnel: each write-shaped use of a place asks whether
    // the place is writable, through one walk from the place to its root.
    // `&self` is read-only all the way down: storage the receiver points at
    // is as unwritable as its own fields, and only a raw pointer's pointee,
    // or a place a `&self` accessor lends, is written through it (SL-483).
    // A capture is judged as its closure declares it: a by-value, `move` or
    // `copy` capture is judged exactly as a `let` of its type in every
    // closure, and a `[&var x]` capture or an implicit `self` under
    // `&var self` borrows the caller's binding. The
    // captures judged are the ones source writes or names, never an
    // environment a lowering synthesizes, such as a place window's (SL-472).
    //
    // ENTRY POINTS (place_verdict):
    //     an assignment's target (`Write`)
    //     a compound assignment's target (`Update`)
    //     the place of a `borrow var` statement written whole (`borrow var
    //         PLACE = v`, `+=`), and of a bare `borrow` one, refused
    //     a write reached through a bare `borrow` statement's place, refused
    //     `&var PLACE`, `borrow var PLACE` as an argument (`BorrowVar`)
    //     a `borrow var` binding's head, `if borrow var` and `while borrow var`
    //     a `&var self` method's receiver, the builtin `take()` and `swap(i, j)`
    //     a `lend` in a `borrows -> &var T` body
    //     a `borrows` window opened exclusive: the window's own use, whose
    //         walk crosses the accessor to its receiver
    //     a window through an exclusive-only accessor whose use reads
    //         (check_exclusive_windows): a subscript read, a named
    //         accessor's call, a `borrow let` head, a `for` head, a
    //         forwarded `lend`, a nested window, a method call's receiver
    //     a `[&var x]` capture (capture_verdict)
    public func check_mutability(&var self) {
        let n = self.res.nodes.len()
        var tables = TcMutTables(parents: Vector<Int>(), decl_of_node: Vector<Int>())
        var k = 0
        while k < n {
            try! tables.parents.push(-1)
            try! tables.decl_of_node.push(-1)
            k = k + 1
        }
        k = 0
        while k < n {
            let count = self.child_count(k)
            var j = 0
            while j < count {
                let c = self.child(k, j)
                tables.parents[c] = k
                j = j + 1
            }
            k = k + 1
        }
        k = 0
        while k < self.res.decls.len() {
            let node = self.res.decls[k].node
            if node >= 0 {
                tables.decl_of_node[node] = k
            }
            k = k + 1
        }
        let receivers = self.window_receivers(n)
        let skipped = self.outside_slice_marks(n)
        k = 0
        while k < n {
            let at = k
            k = k + 1
            let u = self.expr_use[at]
            if u != TcUse.Write && u != TcUse.Update && u != TcUse.BorrowVar {
                continue
            }
            if skipped[at] || not self.expr_place[at] {
                continue
            }
            let statement = self.has_alt(at, Alt.Borrow_Place_Var) || self.has_alt(at, Alt.Borrow_Place_Shared)
            if not statement && (receivers[at] || not self.is_place_alt(at)) {
                continue
            }
            var verdict = tc_write_ok()
            let shared_at = self.shared_borrow_above(at, &tables)
            let place = if statement { self.res.first_node_child(at) } else { at }
            if shared_at >= 0 {
                verdict = tc_write_refused(TcWriteRefusal.SharedBorrow, shared_at)
            } else {
                verdict = self.place_verdict(place, &var tables)
            }
            if not verdict.ok {
                self.refuse_write(at, u, verdict)
            }
        }
        k = 0
        while k < self.captures.len() {
            let cap = self.captures[k]
            k = k + 1
            if cap.use != TcUse.BorrowVar || not cap.explicit || skipped[cap.closure] {
                continue
            }
            if self.has_alt(cap.site, Alt.Expr_Capture_SelfExclusive) {
                continue
            }
            // A reference binding is borrowed again through its own
            // reference, whatever declared it.
            var verdict = tc_write_ok()
            let bt = self.local_types[cap.binding]
            if bt >= 0 && (self.kind_of(bt) == TcKind.Ref || self.kind_of(bt) == TcKind.Slice) {
                if self.types.ty(bt).a != 1 {
                    verdict = tc_write_refused(TcWriteRefusal.SharedReference, cap.binding)
                }
            } else {
                verdict = self.binding_verdict(cap.binding, cap.closure, &var tables)
            }
            if not verdict.ok {
                self.refuse_write(cap.site, TcUse.BorrowVar, verdict)
            }
        }
        self.check_exclusive_windows(&skipped, &var tables)
    }

    // Every window through an accessor that borrows its receiver
    // exclusively at every use (`accessor_exclusive_only`) whose own use
    // reads: its receiver is judged as an exclusive borrow, since nothing
    // else asks. A window whose use writes is judged by that write's walk.
    func check_exclusive_windows(&var self, skipped: &Vector<Bool>, tables: &var TcMutTables) {
        var k = 0
        while k < self.calls.len() {
            let c = self.calls[k]
            k = k + 1
            if c.target < 0 || not self.accessor_exclusive_only(c.target) {
                continue
            }
            let e = c.node
            if skipped[e] || self.window_use_writes(e, &tables) {
                continue
            }
            let subscript = self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi)
            var receiver = -1
            let head = self.res.first_node_child(e)
            if subscript {
                receiver = head
            } else if head >= 0 && self.has_alt(head, Alt.Expr_Member) {
                receiver = self.res.first_node_child(head)
            }
            if receiver < 0 || not self.is_place_alt(receiver) {
                continue
            }
            let receiver_type = self.expr_types[receiver]
            if not self.expr_place[receiver] && self.referent(receiver_type) < 0 {
                continue
            }
            let verdict = self.place_verdict(receiver, &var tables)
            if not verdict.ok {
                self.refuse_exclusive_window(e, c.target, verdict)
            }
        }
    }

    // Whether the use that ends window `e`'s projection writes: an
    // assignment, a compound assignment, or an exclusive borrow.
    func window_use_writes(&self, e: Int, tables: &TcMutTables) -> Bool {
        var node = e
        var steps = 0
        while node >= 0 && steps < 10000 {
            let u = self.expr_use[node]
            if u != TcUse.Project {
                return u == TcUse.Write || u == TcUse.Update || u == TcUse.BorrowVar
            }
            node = tables.parents[node]
            steps = steps + 1
        }
        false
    }

    // The receivers of `borrows` accessor calls and subscripts: an exclusive
    // one is borrowed because its window's use writes, and that use's walk
    // judges it, crossing the accessor.
    func window_receivers(&self, n: Int) -> Vector<Bool> {
        var out = Vector<Bool>()
        var k = 0
        while k < n {
            try! out.push(false)
            k = k + 1
        }
        k = 0
        while k < self.calls.len() {
            let c = self.calls[k]
            k = k + 1
            if c.target < 0 || c.role == TcRole.BuiltinOperator || c.role == TcRole.Builtin {
                continue
            }
            let e = c.node
            let subscript = self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi)
            let head = self.res.first_node_child(e)
            if head < 0 {
                continue
            }
            if subscript {
                out[head] = true
            } else if c.role == TcRole.Call && (self.sigs[c.target].effects & TC_EFFECT_BORROWS) != 0 {
                let receiver = if self.has_alt(head, Alt.Expr_Member) { self.res.first_node_child(head) } else { -1 }
                if receiver >= 0 {
                    out[receiver] = true
                }
            }
        }
        move out
    }

    // The bare `borrow` statement whose place a write at node `at` reaches,
    // through its receiver chain, or -1: such a place is lent shared, so
    // nothing writes through it (SL:borrowing §2.2).
    func shared_borrow_above(&self, at: Int, tables: &TcMutTables) -> Int {
        var node = at
        var steps = 0
        while node >= 0 && steps < 64 {
            if self.has_alt(node, Alt.Borrow_Place_Shared) {
                return node
            }
            if self.has_alt(node, Alt.Borrow_Place_Var) {
                return -1
            }
            if node != at && self.expr_use[node] != TcUse.Unused && self.expr_use[node] != TcUse.Project {
                return -1
            }
            let up = tables.parents[node]
            if up < 0 || self.res.first_node_child(up) != node {
                return -1
            }
            let chain = self.is_place_alt(up) || self.has_alt(up, Alt.Borrow_Place_Shared) || self.has_alt(up, Alt.Borrow_Place_Var)
            if not chain {
                return -1
            }
            node = up
            steps = steps + 1
        }
        return -1
    }

    // Whether node `e` is an expression that can name a place.
    func is_place_alt(&self, e: Int) -> Bool {
        self.has_alt(e, Alt.Expr_Name) || self.has_alt(e, Alt.Expr_NameRef) || self.has_alt(e, Alt.Expr_Self) || self.has_alt(e, Alt.Expr_Member) || self.has_alt(e, Alt.Expr_TupleIndex) || self.has_alt(e, Alt.Expr_Force) || self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi) || self.has_alt(e, Alt.Expr_Deref) || self.has_alt(e, Alt.Expr_Paren) || self.has_alt(e, Alt.Expr_Call_Paren)
    }

    // Whether place `e` may be written, walked to its root. The walk stops
    // where nothing above decides: a raw pointer's pointee, a `&var`
    // reference, and a place a `&self` accessor lends, whose receiver is only
    // read, as the accessor's own `lend` was judged (SL:borrowing §3).
    func place_verdict(&var self, e: Int, tables: &var TcMutTables) -> TcWriteVerdict {
        if e < 0 {
            return tc_write_ok()
        }
        let t = self.expr_types[e]
        if t >= 0 {
            let info = self.types.ty(t)
            if info.kind == TcKind.Ref || info.kind == TcKind.Slice {
                if info.a == 1 {
                    return tc_write_ok()
                }
                return tc_write_refused(TcWriteRefusal.SharedReference, e)
            }
        }
        if self.has_alt(e, Alt.Expr_Paren) {
            let inner = self.res.first_node_child(e)
            return self.place_verdict(inner, &var tables)
        }
        if self.has_alt(e, Alt.Expr_Deref) {
            return tc_write_ok()
        }
        if self.has_alt(e, Alt.Expr_Name) || self.has_alt(e, Alt.Expr_NameRef) {
            let leaf = self.res.first_leaf(e)
            let b = self.binding_at(leaf)
            return self.named_verdict(e, b, &var tables)
        }
        if self.has_alt(e, Alt.Expr_Self) {
            let b = self.binding_at(e)
            if b.kind != ResBindKind.Local || b.node < 0 {
                return tc_write_ok()
            }
            return self.binding_verdict(b.node, e, &var tables)
        }
        if self.has_alt(e, Alt.Expr_Member) {
            let leaf = self.res.last_leaf_of(e)
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Decl && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Static {
                return self.static_verdict(e, b.decl)
            }
            let base = self.res.first_node_child(e)
            return self.place_verdict(base, &var tables)
        }
        if self.has_alt(e, Alt.Expr_TupleIndex) || self.has_alt(e, Alt.Expr_Force) {
            let base = self.res.first_node_child(e)
            return self.place_verdict(base, &var tables)
        }
        let at = self.call_at[e]
        if at < 0 {
            return tc_write_ok()
        }
        let c = self.calls[at]
        let subscript = self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi)
        if subscript && c.role == TcRole.BuiltinOperator {
            let base = self.res.first_node_child(e)
            if self.points(base) {
                return tc_write_ok()
            }
            return self.place_verdict(base, &var tables)
        }
        if c.target < 0 {
            return tc_write_ok()
        }
        let sig = self.sigs[c.target]
        let lending = (sig.effects & TC_EFFECT_BORROWS) != 0
        var receiver = -1
        if subscript {
            receiver = self.res.first_node_child(e)
        } else if lending {
            let callee = self.res.first_node_child(e)
            if callee >= 0 && self.has_alt(callee, Alt.Expr_Member) {
                receiver = self.res.first_node_child(callee)
            }
        }
        if receiver < 0 {
            return tc_write_ok()
        }
        if lending && not sig.lending_exclusive {
            // A subscript's read-only lend is `subscript.role`'s refusal.
            if subscript {
                return tc_write_ok()
            }
            return tc_write_refused(TcWriteRefusal.ReadOnlyLend, e)
        }
        if lending && sig.receiver == TcReceiver.Shared {
            return tc_write_ok()
        }
        let receiver_type = self.expr_types[receiver]
        if not self.expr_place[receiver] && self.referent(receiver_type) < 0 {
            return tc_write_ok()
        }
        self.place_verdict(receiver, &var tables)
    }

    // Whether expression `e`'s value is a raw pointer, through which a
    // subscript writes the pointee whatever binding holds the pointer.
    func points(&self, e: Int) -> Bool {
        var t = self.final_type(e)
        if t < 0 {
            return false
        }
        let r = self.referent(t)
        if r >= 0 {
            t = r
        }
        let info = self.types.ty(t)
        info.kind == TcKind.Nominal && (info.decl == self.known.unsafe_pointer || info.decl == self.known.unsafe_const_pointer)
    }

    // A name's place: a local's binding, or a static.
    func named_verdict(&var self, e: Int, b: ResBinding, tables: &var TcMutTables) -> TcWriteVerdict {
        if b.kind == ResBindKind.Local && b.node >= 0 {
            return self.binding_verdict(b.node, e, &var tables)
        }
        if b.kind == ResBindKind.Decl && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Static {
            return self.static_verdict(e, b.decl)
        }
        tc_write_ok()
    }

    // A static is written only as an `unsafe static var` (design 149).
    func static_verdict(&self, e: Int, d: Int) -> TcWriteVerdict {
        if (self.sigs[d].flags & TC_FLAG_UNSAFE_VAR) != 0 {
            return tc_write_ok()
        }
        tc_write_refused(TcWriteRefusal.Static, e)
    }

    // Whether the binding declared at `binding` may be written from `site`:
    // each closure between them captured it exclusively, and its declaration
    // makes it writable. A by-value capture is never written, even where the
    // write would land in a heap buffer the closure shares with its copies
    // (SL-472), and a shared one, `self`'s included, never either (SL-483).
    func binding_verdict(&var self, binding: Int, site: Int, tables: &var TcMutTables) -> TcWriteVerdict {
        let declared = self.res.nodes[binding]
        var at = site
        while at >= 0 {
            if self.closure_index.first(at, 0) >= 0 {
                let span = self.res.nodes[at]
                let inside = declared.start >= span.start && declared.end <= span.end
                if not inside {
                    let u = self.capture_use(at, binding)
                    if u == TcUse.Borrow {
                        return tc_capture_refused(TcWriteRefusal.SharedCapture, binding, at)
                    } else if u != TcUse.BorrowVar {
                        return tc_capture_refused(TcWriteRefusal.ValueCapture, binding, at)
                    }
                }
            }
            at = tables.parents[at]
        }
        if self.has_alt(binding, Alt.Decl_Param_Receiver) {
            let owner = tables.parents[binding]
            let d = if owner >= 0 { tables.decl_of_node[owner] } else { -1 }
            if d < 0 || self.sigs[d].receiver != TcReceiver.Shared {
                return tc_write_ok()
            }
            return tc_write_refused(TcWriteRefusal.SharedReceiver, binding)
        }
        let kind = self.binder_kind(binding, &tables)
        if kind == TcBinder.Mutable {
            return tc_write_ok()
        }
        if kind == TcBinder.Parameter {
            return tc_write_refused(TcWriteRefusal.Parameter, binding)
        }
        TcWriteVerdict(ok: false, reason: TcWriteRefusal.Immutable, at: binding, binder: kind, closure: -1)
    }

    // How closure `e` captured the binding declared at `binding`.
    func capture_use(&self, e: Int, binding: Int) -> TcUse {
        var k = 0
        while k < self.captures.len() {
            let cap = self.captures[k]
            if cap.closure == e && cap.binding == binding {
                return cap.use
            }
            k = k + 1
        }
        TcUse.Copy
    }

    // What declares the binding at leaf `binding`: the nearest binding
    // construct above it.
    func binder_kind(&self, binding: Int, tables: &TcMutTables) -> TcBinder {
        var at = tables.parents[binding]
        while at >= 0 {
            if let alt = self.node_alt(at) {
                let found = tc_binder_of(alt)
                if found != TcBinder.Unknown {
                    return found
                }
            }
            at = tables.parents[at]
        }
        TcBinder.Let
    }

    func refuse_write(&var self, e: Int, u: TcUse, verdict: TcWriteVerdict) {
        let m = self.node_module(e)
        var msg = StringBuilder()
        if u == TcUse.Write {
            try! msg.append("this assignment writes `")
        } else if u == TcUse.Update {
            try! msg.append("this compound assignment writes `")
        } else {
            try! msg.append("this exclusive borrow of `")
        }
        try! msg.append(self.text(m, e))
        if u == TcUse.BorrowVar {
            try! msg.append("` would let it be written")
        } else {
            try! msg.append("`")
        }
        self.append_write_reason(&var msg, verdict)
        self.refuse_in(m, e, "mutability.immutable", msg.build())
    }

    // A read through accessor `d`, which borrows its receiver exclusively at
    // every use, of window `e` whose receiver `verdict` refuses to write.
    func refuse_exclusive_window(&var self, e: Int, d: Int, verdict: TcWriteVerdict) {
        let m = self.node_module(e)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` takes `&var self` and declares no shared twin, so every use borrows its receiver exclusively, a read included; this use of `")
        try! msg.append(self.text(m, e))
        try! msg.append("` would let its receiver be written")
        self.append_write_reason(&var msg, verdict)
        try! msg.append("; or give the accessor a shared twin, `@synthesize(shared)` or a `&self` overload")
        self.refuse_in(m, e, "mutability.immutable", msg.build())
    }

    // Why a write `verdict` refuses is refused, appended to `msg`.
    func append_write_reason(&self, msg: &var StringBuilder, verdict: TcWriteVerdict) {
        let at = verdict.at
        let am = self.node_module(at)
        let name = if at >= 0 { self.text(am, at) } else { "" }
        match verdict.reason {
            case Immutable -> {
                try! msg.append(", and `")
                try! msg.append(name)
                try! msg.append("` is ")
                try! msg.append(tc_binder_text(verdict.binder))
                try! msg.append(", which is never written: every binding is initialized where it is declared, so only a `var` takes a new value")
            },
            case Parameter -> {
                try! msg.append(", and `")
                try! msg.append(name)
                try! msg.append("` is a parameter taken by value, which is never written: copy it into a `var`, or take it as `&var`")
            },
            case SharedReference -> {
                try! msg.append(", and `")
                try! msg.append(name)
                try! msg.append("` is a shared reference, through which nothing is written: take it as `&var`")
            },
            case SharedReceiver -> {
                try! msg.append(", and this method's receiver is `&self`, a shared borrow that writes neither the storage it borrows nor storage reached through it: declare the receiver `&var self`")
            },
            case ValueCapture -> {
                self.explain_value_capture(&var msg, verdict)
            },
            case SharedCapture -> {
                let captured = self.capture_name(verdict.at)
                try! msg.append(", and the closure captured `")
                try! msg.append(captured)
                try! msg.append("` by shared borrow, which never writes: capture it with `[&var ")
                try! msg.append(captured)
                try! msg.append("]`")
                if self.has_alt(verdict.at, Alt.Decl_Param_Receiver) {
                    try! msg.append(" in a `&var self` method")
                }
            },
            case Static -> {
                try! msg.append(", and a `static` is immutable: only an `unsafe static var` is written (design 149)")
            },
            case ReadOnlyLend -> {
                try! msg.append(", and `")
                try! msg.append(name)
                try! msg.append("` lends a read-only place (`-> &T`): declare the accessor `-> &var T` to lend a writable one")
            },
            case SharedBorrow -> {
                try! msg.append(", and `")
                try! msg.append(name)
                try! msg.append("` borrows its place shared, which never writes: write `borrow var`")
            },
            case Allowed -> {}
        }
    }

    // Why a by-value capture is not written, and what writes instead: a
    // borrow of the caller's binding where the closure does not escape, a
    // local of the body's own, or shared state for a closure that escapes,
    // whose copies all read one environment (SL-472).
    func explain_value_capture(&self, msg: &var StringBuilder, verdict: TcWriteVerdict) {
        let captured = self.capture_name(verdict.at)
        try! msg.append(", and `")
        try! msg.append(captured)
        try! msg.append("` is captured by value, which makes it a `let` in the closure's body: ")
        let k = if verdict.closure >= 0 { self.closure_index.first(verdict.closure, 0) } else { -1 }
        let ordinal = if k >= 0 { self.closure_index.value(k) } else { -1 }
        if ordinal >= 0 && ordinal < self.closure_escaping.len() && self.closure_escaping[ordinal] {
            try! msg.append("an escaping closure keeps no state that changes across calls, since every copy of it reads one environment; share the state as an `Arc<Mutex<T>>` and change it under the lock")
            return
        }
        try! msg.append("to write the caller's binding, capture it with `[&var ")
        try! msg.append(captured)
        try! msg.append("]`; to change a value of the body's own, bind it there, as `var w = ")
        if self.capture_use(verdict.closure, verdict.at) == TcUse.Move {
            try! msg.append("move ")
        }
        try! msg.append(captured)
        try! msg.append("`")
    }
}

func tc_write_ok() -> TcWriteVerdict {
    TcWriteVerdict(ok: true, reason: TcWriteRefusal.Allowed, at: -1, binder: TcBinder.Unknown, closure: -1)
}

func tc_write_refused(reason: TcWriteRefusal, at: Int) -> TcWriteVerdict {
    TcWriteVerdict(ok: false, reason: reason, at: at, binder: TcBinder.Unknown, closure: -1)
}

// A write refused because closure `closure` captured the binding declared at
// `binding` in a way that does not write it.
func tc_capture_refused(reason: TcWriteRefusal, binding: Int, closure: Int) -> TcWriteVerdict {
    TcWriteVerdict(ok: false, reason: reason, at: binding, binder: TcBinder.Unknown, closure: closure)
}
