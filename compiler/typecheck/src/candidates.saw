// The candidates a body's name or selector can mean: a free function's
// overload set as resolve bound it, a type's members as a module sees them
// (members.saw's two filters), and the requirements a type parameter's
// bounds grant. Each list is in declaration order, so every diagnostic that
// names candidates names them in one order.

import sawresolve.imports.{res_decl_binding}
import sawresolve.model.{ResBinding, ResBindKind, ResDecl, ResDeclKind}
import sawtypecheck.conform.{TcSubst, tc_args_subst, tc_copy_ints}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.members.{tc_build_members}
import sawtypecheck.model.{TC_FLAG_STATIC, TcMember, TcSig, TcSource, TcUnmetBound}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.tier.{tc_tier}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind, TcType}

// Whether an `init` matching its struct's fields may override the memberwise
// construction, and why not (`override_fault`).
public enum TcOverrideFault {
    case Accepted,
    // Declared outside the struct's module.
    case OutsideModule,
    // Test-only, on a production struct.
    case TestOnly,
    // In an extension whose type parameters carry bounds.
    case Bounded
}

extension TcProgram {
    // Whether code in module `viewer`, test code when `in_test`, sees member
    // `k` of the member tables, through the extension sets the body half
    // keeps (members.saw, `member_visible`).
    public func member_seen(&self, k: Int, viewer: Int, in_test: Bool) -> Bool {
        let member = self.members[k]
        let owner = self.res.decls[member.type_decl]
        if not self.extension_usable(k, viewer, in_test) {
            return false
        }
        match member.source {
            case Declared -> self.res.visible_to(member.vis, member.module, viewer),
            case Extension -> {
                if self.follows_trait(member.decl, viewer) == 1 {
                    return true
                }
                let e = member.module
                if e != viewer && e != owner.module && not self.std_extends_builtin(e, owner.module) {
                    let n = self.res.modules.len()
                    if not self.ext_visible[viewer * n + e] {
                        return false
                    }
                }
                self.res.visible_to(member.vis, member.module, viewer)
            },
            case Default -> true,
            case Synthesized -> true,
            case RawConversion -> true
        }
    }

    // The member-table entries of nominal `d` named `name` that module
    // `viewer`'s test code sees: a later stage re-finds a member typecheck
    // chose by name, and test code sees every member ordinary code does.
    public func members_named(&self, d: Int, name: Int, viewer: Int) -> Vector<Int> {
        self.visible_members(d, name, viewer, true)
    }

    // The member-table entries of nominal `d` named `name` that code in
    // module `viewer`, test code when `in_test`, sees.
    public func visible_members(&self, d: Int, name: Int, viewer: Int, in_test: Bool) -> Vector<Int> {
        var out = Vector<Int>()
        if d < 0 || d >= self.member_first.len() {
            return move out
        }
        let first = self.member_first[d]
        if first < 0 {
            return move out
        }
        let count = self.member_count[d]
        var k = first
        while k < first + count {
            let member = self.members[k]
            if member.name == name && self.member_seen(k, viewer, in_test) {
                try! out.push(k)
            }
            k = k + 1
        }
        move out
    }

    // The members named `name` a value of nominal type `owner` has, as code
    // in module `viewer`, test code when `in_test`, sees them:
    // `visible_members`, less each entry whose declaring extension's bounds
    // `owner`'s arguments do not meet. The
    // first entry dropped is kept in `unmet_member` for the refusal
    // (`refuse_unmet_member`), so a member that exists only under a bound
    // is never chosen and never mistaken for an absent one (SL-463).
    //
    // ENTRY POINTS:
    // - method_candidates (methods, statics, a subscript's `[]`)
    // - resolve_comparison (`==`, `!=`, `<` through `equals`, `compare`)
    // - iterator_item (a `for` loop's `next`)
    // - finish_call (an `init`, once inference solves its type's arguments)
    public func members_for(&var self, owner: Int, name: Int, viewer: Int, in_test: Bool) -> Vector<Int> {
        self.unmet_member = -1
        self.unmet_owner = -1
        let d = self.nominal_decl(owner)
        let found = self.visible_members(d, name, viewer, in_test)
        var out = Vector<Int>()
        var k = 0
        while k < found.len() {
            let at = found[k]
            k = k + 1
            if let _ = self.unmet_member_bound(at, owner) {
                if self.unmet_member < 0 {
                    self.unmet_member = at
                    self.unmet_owner = owner
                }
            } else {
                try! out.push(at)
            }
        }
        move out
    }

    // The first bound the extension declaring member-table entry `k` puts
    // on its type's parameters that `owner`'s arguments do not meet, or
    // none. A member of `extension Cell<T: Equatable>`, or of a conformance
    // that extension declares, exists only where `T` is `Equatable`. An
    // argument that is a type parameter is answered by the bounds in scope
    // where the member is named, the question `type.bound` asks.
    public func unmet_member_bound(&var self, k: Int, owner: Int) -> TcUnmetBound? {
        let member = self.members[k]
        let ext = member.ext
        if ext < 0 || owner < 0 {
            return None
        }
        let info = self.types.ty(owner)
        if info.kind != TcKind.Nominal || info.decl != member.type_decl {
            return None
        }
        self.ensure_generics(ext)
        let s = self.sigs[ext]
        let env = self.current_decl
        let env_ext = self.current_ext
        var i = 0
        while i < s.generic_count && i < info.count {
            let g = self.generics[s.generic_first + i]
            let arg = self.types.arg(owner, i)
            var j = 0
            while j < g.bound_count {
                let bound = self.traits[g.bound_first + j]
                if not self.satisfies(arg, bound, env, env_ext) {
                    return TcUnmetBound(index: i, trait_decl: bound)
                }
                j = j + 1
            }
            i = i + 1
        }
        None
    }

    // Whether a member-table entry is a method: static or not as `statics`
    // asks. A default body or a derived member is a requirement's.
    public func is_method_member(&self, k: Int, statics: Bool) -> Bool {
        let member = self.members[k]
        let info = self.res.decls[member.decl]
        if info.kind != ResDeclKind.Method && info.kind != ResDeclKind.Requirement {
            return false
        }
        let s = self.sigs[member.decl]
        let is_static = (s.flags & TC_FLAG_STATIC) != 0
        is_static == statics
    }

    // Every `init` of nominal `d` that code in module `viewer`, test code
    // when `in_test`, sees.
    public func inits_of(&self, d: Int, viewer: Int, in_test: Bool) -> Vector<Int> {
        var out = Vector<Int>()
        if d < 0 || d >= self.member_first.len() {
            return move out
        }
        let first = self.member_first[d]
        if first < 0 {
            return move out
        }
        let count = self.member_count[d]
        var k = first
        while k < first + count {
            let member = self.members[k]
            let info = self.res.decls[member.decl]
            if info.kind == ResDeclKind.Init && self.member_seen(k, viewer, in_test) {
                try! out.push(k)
            }
            k = k + 1
        }
        move out
    }

    // The `init` that overrides struct `d`'s memberwise construction, or -1:
    // one that matches its fields exactly and that the declaration-site rule
    // accepts (`override_fault`). Two such are `overload.indistinguishable`,
    // so the first in declaration order is the one.
    public func construction_override(&var self, d: Int) -> Int {
        if not self.is_struct_decl(d) {
            return -1
        }
        let exts = self.extensions_in_order(d)
        var k = 0
        while k < exts.len() {
            let listed = self.members_of(exts[k])
            k = k + 1
            var j = 0
            while j < listed.len() {
                let m = listed[j]
                j = j + 1
                if self.matches_fields(m) && self.override_fault(m) == TcOverrideFault.Accepted {
                    return m
                }
            }
        }
        return -1
    }

    // Whether declaration `m` is an `init` whose labels, in any order, and
    // types are its struct's fields exactly, every parameter one field: the
    // shape that overrides the memberwise construction (SL-648).
    public func matches_fields(&var self, m: Int) -> Bool {
        let info = self.res.decls[m]
        if info.kind != ResDeclKind.Init || info.parent < 0 {
            return false
        }
        let d = self.ext_target(info.parent)
        if not self.is_struct_decl(d) {
            return false
        }
        self.build_decl(m)
        let s = self.sigs[m]
        let members = self.members_of(d)
        var fields = 0
        var k = 0
        while k < members.len() {
            let f = members[k]
            k = k + 1
            if self.res.decls[f].kind != ResDeclKind.Field {
                continue
            }
            fields = fields + 1
            self.build_decl(f)
            if not self.takes_field(&s, f) {
                return false
            }
        }
        fields == s.param_count
    }

    // Whether signature `s` has a parameter of field `f`'s label and type.
    // Labels are distinct within a declaration, so a match is the only one.
    func takes_field(&self, s: &TcSig, f: Int) -> Bool {
        let name = self.res.decls[f].name
        let ty = self.sigs[f].result
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if p.name == name {
                return ty >= 0 && p.ty == ty && not self.has_error(ty)
            }
            k = k + 1
        }
        false
    }

    // Why `init` `m`, which matches its struct's fields, may not override the
    // construction: an importer's would change what every module's call
    // means, a test-only one what production code's means (SL:testing), and
    // a bounded extension's would give one generic call two meanings, chosen
    // per instantiation where no reader sees it.
    public func override_fault(&var self, m: Int) -> TcOverrideFault {
        let info = self.res.decls[m]
        let d = self.ext_target(info.parent)
        let owner = self.res.decls[d]
        if info.module != owner.module {
            return TcOverrideFault.OutsideModule
        }
        if info.test_only && not owner.test_only {
            return TcOverrideFault.TestOnly
        }
        if self.bounded_parameter(info.parent) >= 0 {
            return TcOverrideFault.Bounded
        }
        TcOverrideFault.Accepted
    }

    // The first of extension `ext`'s type parameters that carries a bound,
    // or -1.
    public func bounded_parameter(&var self, ext: Int) -> Int {
        self.ensure_generics(ext)
        let s = self.sigs[ext]
        var k = 0
        while k < s.generic_count {
            if self.generics[s.generic_first + k].bound_count > 0 {
                return k
            }
            k = k + 1
        }
        return -1
    }

    // The functions a free name's binding stands for where it is used: its
    // module's overload set, or a merged set's (design 249), externs and
    // builtin functions included, less each declaration the code being
    // checked may not use (resolve's `overload_decls`).
    public func free_candidates(&self, b: ResBinding) -> Vector<Int> {
        var out = Vector<Int>()
        if b.kind == ResBindKind.Overload {
            self.push_functions(&var out, b.module, b.name)
        } else if b.kind == ResBindKind.Overloads && b.decl >= 0 {
            let count = self.res.merges[b.decl]
            var k = 0
            while k < count {
                let m = self.res.merges[b.decl + 1 + k]
                self.push_functions(&var out, m, b.name)
                k = k + 1
            }
        }
        move out
    }

    func push_functions(&self, out: &var Vector<Int>, m: Int, name: Int) {
        let viewer = self.current
        let in_test = self.current_test
        let found = self.res.overload_decls(m, name, viewer, in_test)
        var k = 0
        while k < found.len() {
            try! out.push(found[k])
            k = k + 1
        }
    }

    // The requirements named `name` that the bounds of type parameter
    // `index` of `owner` grant, and the conditions of extension `ext` add.
    public func bound_requirements(&var self, owner: Int, index: Int, name: Int, ext: Int) -> Vector<Int> {
        var out = Vector<Int>()
        self.push_bound_requirements(&var out, owner, index, name)
        if ext >= 0 && self.ext_target(ext) == owner {
            self.push_bound_requirements(&var out, ext, index, name)
        }
        move out
    }

    func push_bound_requirements(&var self, out: &var Vector<Int>, d: Int, index: Int, name: Int) {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if index >= s.generic_count {
            return
        }
        let g = self.generics[s.generic_first + index]
        var k = 0
        while k < g.bound_count {
            let bound = self.traits[g.bound_first + k]
            let all = self.trait_and_ancestors(bound)
            var j = 0
            while j < all.len() {
                let reqs = self.members_of(all[j])
                var r = 0
                while r < reqs.len() {
                    let req = reqs[r]
                    let info = self.res.decls[req]
                    if info.kind == ResDeclKind.Requirement && info.name == name && not tc_contains(&out, req) {
                        try! out.push(req)
                    }
                    r = r + 1
                }
                j = j + 1
            }
            k = k + 1
        }
    }

    // The substitution that instantiates a member of nominal type `owner`:
    // the type's parameters to `owner`'s arguments, and, for a requirement a
    // trait's default body or a derivation fills, `Self` to `owner` and the
    // trait's associated types to what the type assigns.
    public func owner_subst(&var self, owner: Int) -> TcSubst {
        let info = self.types.ty(owner)
        if info.kind != TcKind.Nominal {
            return TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: -1,
                           args: Vector<Int>(), assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        let args = self.nominal_args(owner)
        let by_args = tc_args_subst(info.decl, tc_copy_ints(&args))
        var decls = Vector<Int>()
        var types = Vector<Int>()
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl != info.decl {
                continue
            }
            let one = self.conformance_subst(k - 1)
            var j = 0
            while j < one.assoc_decls.len() {
                try! decls.push(one.assoc_decls[j])
                try! types.push(self.subst(one.assoc_types[j], &by_args))
                j = j + 1
            }
        }
        var s = TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: info.decl,
                        args: move args, assoc_decls: move decls, assoc_types: move types)
        move s
    }
}

// Whether `v` holds `x`.
public func tc_contains(v: &Vector<Int>, x: Int) -> Bool {
    var k = 0
    while k < v.len() {
        if v[k] == x {
            return true
        }
        k = k + 1
    }
    false
}
