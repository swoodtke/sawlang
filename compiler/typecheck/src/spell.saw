// Canonical spelling: every type written so it reads back as the same type,
// every nominal type by its identity (design 144). The dump and every
// diagnostic that names a type spell it here.

import sawresolve.dump.{res_sort_strings}
import sawresolve.lang.{ResLang}
import sawtypecheck.model.{TC_EFFECT_BLOCKING, TC_EFFECT_BORROWS, TC_EFFECT_BORROWS_SYNC, TC_EFFECT_CONSTEXPR,
                               TC_EFFECT_CONSUMES, TC_EFFECT_ESCAPING, TC_EFFECT_SENDABLE, TC_EFFECT_SYNC,
                               TC_EFFECT_UNSAFE}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.types.{TC_CONST_ADD, TC_CONST_ADOPT, TC_CONST_AND, TC_CONST_CAST, TC_CONST_DIV, TC_CONST_MUL,
                               TC_CONST_NEG, TC_CONST_NOT, TC_CONST_OR, TC_CONST_REM, TC_CONST_SHL, TC_CONST_SHR,
                               TC_CONST_SUB, TC_CONST_WRAP_ADD, TC_CONST_WRAP_MUL, TC_CONST_WRAP_SUB, TC_CONST_XOR,
                               TcKind, TcType, tc_const_op_text}

// The effect words of `effects`, in the slot's order, each after a space.
public func tc_effects_text(effects: Int) -> String {
    var out = StringBuilder()
    if (effects & TC_EFFECT_CONSUMES) != 0 {
        try! out.append(" consumes")
    }
    if (effects & TC_EFFECT_UNSAFE) != 0 {
        try! out.append(" unsafe")
    }
    if (effects & TC_EFFECT_CONSTEXPR) != 0 {
        try! out.append(" constexpr")
    }
    if (effects & TC_EFFECT_BLOCKING) != 0 {
        try! out.append(" blocking")
    }
    if (effects & TC_EFFECT_SYNC) != 0 {
        try! out.append(" sync")
    }
    if (effects & TC_EFFECT_ESCAPING) != 0 {
        try! out.append(" escaping")
    }
    if (effects & TC_EFFECT_SENDABLE) != 0 {
        try! out.append(" sendable")
    }
    if (effects & TC_EFFECT_BORROWS_SYNC) != 0 {
        try! out.append(" borrows(sync)")
    } else if (effects & TC_EFFECT_BORROWS) != 0 {
        try! out.append(" borrows")
    }
    out.build()
}

extension TcProgram {
    // A nominal declaration's canonical name: bare for the language's
    // vocabulary, a builtin, the new std prelude's or `String`, else its
    // module's identity and its path (design 144).
    public func nominal_name(&self, d: Int) -> String {
        if self.res.prints_bare(d) {
            return self.res.decl_path(d)
        }
        self.res.decl_identity(d)
    }

    // Type `t`'s canonical spelling.
    public func type_text(&self, t: Int) -> String {
        var out = StringBuilder()
        self.append_type(&var out, t)
        out.build()
    }

    public func append_type(&self, out: &var StringBuilder, t: Int) {
        if t < 0 {
            try! out.append("?")
            return
        }
        let info = self.types.ty(t)
        match info.kind {
            case Nominal -> self.append_nominal(&var out, t),
            case Param -> {
                let s = self.sigs[info.decl]
                if info.a < s.generic_count {
                    let g = self.generics[s.generic_first + info.a]
                    try! out.append(self.name_text(g.name))
                } else {
                    try! out.append("?")
                }
            },
            case SelfType -> try! out.append("Self"),
            case Projection -> {
                let base = self.types.arg(t, 0)
                self.append_type(&var out, base)
                try! out.append(".")
                let d = self.res.decls[info.decl]
                try! out.append(self.name_text(d.name))
            },
            case Tuple -> self.append_tuple(&var out, t),
            case Func -> {
                try! out.append("(")
                var k = 0
                while k < info.count {
                    if k > 0 {
                        try! out.append(", ")
                    }
                    let part = self.types.arg(t, k)
                    self.append_type(&var out, part)
                    k = k + 1
                }
                try! out.append(")")
                try! out.append(tc_effects_text(info.a))
                try! out.append(" -> ")
                self.append_type(&var out, info.b)
            },
            case Ref -> {
                if info.a == 1 {
                    try! out.append("&var ")
                } else {
                    try! out.append("&")
                }
                self.append_type(&var out, info.b)
            },
            case Slice -> {
                if info.a == 1 {
                    try! out.append("&var [")
                } else {
                    try! out.append("&[")
                }
                self.append_type(&var out, info.b)
                try! out.append("]")
            },
            case Array -> {
                try! out.append("[")
                self.append_type(&var out, info.b)
                try! out.append("; ")
                let part = self.types.arg(t, 0)
                self.append_type(&var out, part)
                try! out.append("]")
            },
            case Any -> {
                try! out.append("any ")
                try! out.append(self.nominal_name(info.decl))
            },
            case ConstInt -> try! out.append(info.a),
            case ConstExpr -> self.append_const_expr(&var out, t),
            case Error -> try! out.append("(error)")
        }
    }

    // A constant expression as an author writes it: an implicit conversion
    // is no spelling, so it prints its operand alone.
    func append_const_expr(&self, out: &var StringBuilder, t: Int) {
        let info = self.types.ty(t)
        let first = self.types.arg(t, 0)
        if info.a == TC_CONST_ADOPT {
            self.append_type(&var out, first)
            return
        }
        if info.a == TC_CONST_NEG || info.a == TC_CONST_NOT {
            try! out.append(tc_const_op_text(info.a))
            self.append_const_operand(&var out, first, 0, false)
            return
        }
        if info.a == TC_CONST_CAST {
            self.append_const_operand(&var out, first, 0, false)
            try! out.append(" as ")
            self.append_type(&var out, info.b)
            return
        }
        let class = self.const_class(t)
        self.append_const_operand(&var out, first, class, true)
        try! out.append(" ")
        try! out.append(tc_const_op_text(info.a))
        try! out.append(" ")
        self.append_const_operand(&var out, self.types.arg(t, 1), class, false)
    }

    // Operand `t` of a parent of precedence `class` (0 for a unary operator
    // or a cast): parenthesized when it is a binary expression, unless it is
    // the left operand of a parent in its own class, and when it is a cast
    // under a binary parent or a negative constant.
    func append_const_operand(&self, out: &var StringBuilder, t: Int, class: Int, left: Bool) {
        let own = self.const_class(t)
        let info = self.types.ty(t)
        var parens = false
        if own > 0 {
            parens = not (left && own == class)
        } else if own < 0 {
            parens = class > 0
        } else if info.kind == TcKind.ConstInt {
            parens = info.a < 0
        }
        if parens {
            try! out.append("(")
        }
        self.append_type(&var out, t)
        if parens {
            try! out.append(")")
        }
    }

    // The precedence class of the expression `t` prints as: 1 for `+ - &+ &-`,
    // 2 for `* / % &*`, then `<< >>`, `&`, `|` and `^`; -1 for a cast; 0 for
    // anything else, an implicit conversion looked through.
    func const_class(&self, t: Int) -> Int {
        let info = self.types.ty(t)
        if info.kind != TcKind.ConstExpr {
            return 0
        }
        let op = info.a
        if op == TC_CONST_ADOPT {
            return self.const_class(self.types.arg(t, 0))
        }
        if op == TC_CONST_CAST {
            return -1
        }
        if op == TC_CONST_ADD || op == TC_CONST_SUB || op == TC_CONST_WRAP_ADD || op == TC_CONST_WRAP_SUB {
            return 1
        }
        if op == TC_CONST_MUL || op == TC_CONST_DIV || op == TC_CONST_REM || op == TC_CONST_WRAP_MUL {
            return 2
        }
        if op == TC_CONST_SHL || op == TC_CONST_SHR {
            return 3
        }
        if op == TC_CONST_AND {
            return 4
        }
        if op == TC_CONST_OR {
            return 5
        }
        if op == TC_CONST_XOR {
            return 6
        }
        0
    }

    // A nominal type: `T?` for Optional, else its name and its arguments.
    // A reference or function type under `?` is parenthesized, so the
    // spelling reads back as the same type.
    func append_nominal(&self, out: &var StringBuilder, t: Int) {
        let info = self.types.ty(t)
        if info.decl == self.known.optional && info.count == 1 {
            let inner = self.types.arg(t, 0)
            let inner_info = self.types.ty(inner)
            let wrap = inner_info.kind == TcKind.Ref || inner_info.kind == TcKind.Func
            if wrap {
                try! out.append("(")
            }
            self.append_type(&var out, inner)
            if wrap {
                try! out.append(")")
            }
            try! out.append("?")
            return
        }
        try! out.append(self.nominal_name(info.decl))
        if info.count == 0 {
            return
        }
        try! out.append("<")
        var k = 0
        while k < info.count {
            if k > 0 {
                try! out.append(", ")
            }
            let part = self.types.arg(t, k)
            self.append_type(&var out, part)
            k = k + 1
        }
        try! out.append(">")
    }

    func append_tuple(&self, out: &var StringBuilder, t: Int) {
        let info = self.types.ty(t)
        try! out.append("(")
        var k = 0
        while k < info.count {
            if k > 0 {
                try! out.append(", ")
            }
            let label = self.types.label(t, k)
            if label >= 0 {
                try! out.append(self.name_text(label))
                try! out.append(": ")
            }
            let part = self.types.arg(t, k)
            self.append_type(&var out, part)
            k = k + 1
        }
        if info.count == 1 && not info.labeled {
            try! out.append(",")
        }
        try! out.append(")")
    }}
