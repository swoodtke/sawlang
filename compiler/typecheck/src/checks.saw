// The signature-only checks that need every signature first: finite struct
// size, which is a cycle in the by-value containment graph (spec, Recursive
// types), the signature half of `unsafe` (designs 130 and 136), the rules on
// the traits the compiler only derives and on the thread-safety assertions,
// where a type's policies are declared, and a test-only conformance or member
// overlapping what production code meets.

import sawparse.grammar.{Alt}
import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResBindKind, ResDecl, ResDeclKind}
import sawtypecheck.candidates.{tc_contains}
import sawtypecheck.conform.{TcSubst}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.model.{TC_EFFECT_UNSAFE, TC_FLAG_UNSAFE_STRUCT, TC_FLAG_WRITTEN_RETURN, TcParam,
                               TcReceiver, TcSig, TcStatus, TcStatusKind}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.tier.{tc_bit}
import sawtypecheck.types.{TcKind, TcType}
import sawtypecheck.walks.{TcMemo, tc_memo}

// Finite struct size.
public func tc_check_finite_size(p: &var TcProgram) {
    p.check_finite_size()
}

// The signature half of `unsafe`.
public func tc_check_unsafe(p: &var TcProgram) {
    p.check_unsafe()
}

// The rules on the traits the compiler only derives.
public func tc_check_derived_conformances(p: &var TcProgram) {
    p.check_derived_conformances()
}

// The rule that a conformance to `Comparable` or `Hashable` requires
// `Equatable` beside it.
public func tc_check_required_conformances(p: &var TcProgram) {
    p.check_required_conformances()
}

// The rule that a type's policies are declared in its defining file.
public func tc_check_policy_placement(p: &var TcProgram) {
    p.check_policy_placement()
}

// What an `init` returns, and where `Deinit`'s body may be written.
public func tc_check_inits(p: &var TcProgram) {
    p.check_inits()
    p.check_deinit_placement()
}

static TC_MASK_UNSEEN: Int = 0
static TC_MASK_BUILDING: Int = 1
static TC_MASK_BUILT: Int = 2

// The by-value containment graph over declarations. A struct or enum's mask
// names the type parameters it holds inline; an edge runs to each
// declaration it holds inline, written there or reached through an inline
// parameter of another. A cycle in this graph is the whole test: a
// declaration on one holds an instance of itself inline, whatever the
// arguments, and a declaration on none has finitely many inline instances
// below it.
struct TcContainment {
    masks: Vector<Int>
    states: Vector<Int>
    // Whether a mask was read while it was being built, which only a cycle
    // does, so the masks are then solved to their fixpoint.
    met_building: Bool
    edge_first: Vector<Int>
    edge_count: Vector<Int>
    edges: Vector<Int>
}

extension TcContainment: NoCopy {}

// Tarjan's strongly connected components over the containment graph.
struct TcComponents {
    index: Vector<Int>
    low: Vector<Int>
    on_stack: Vector<Bool>
    stack: Vector<Int>
    depth: Int
    next: Int
    on_cycle: Vector<Bool>
}

extension TcComponents: NoCopy {}

func tc_ints(n: Int, value: Int) -> Vector<Int> {
    var out = Vector<Int>()
    var k = 0
    while k < n {
        try! out.push(value)
        k = k + 1
    }
    move out
}

func tc_bools(n: Int) -> Vector<Bool> {
    var out = Vector<Bool>()
    var k = 0
    while k < n {
        try! out.push(false)
        k = k + 1
    }
    move out
}

extension TcProgram {
    // Every struct and enum whose storage contains its own storage inline:
    // through a field, a payload, a tuple element, an Optional's payload, an
    // array's element, and the same positions of the generic declarations a
    // member instantiates. A pointer, a reference, a function value and an
    // `any` embed nothing. One refusal per cycle, at its first declaration.
    public func check_finite_size(&var self) {
        let n = self.res.decls.len()
        var c = TcContainment(masks: tc_ints(n, 0), states: tc_ints(n, TC_MASK_UNSEEN), met_building: false,
                              edge_first: tc_ints(n, 0), edge_count: tc_ints(n, 0), edges: Vector<Int>())
        var d = 0
        while d < n {
            if self.res.decls[d].node >= 0 && c.states[d] == TC_MASK_UNSEEN {
                self.build_inline_mask(d, &var c)
            }
            d = d + 1
        }
        if c.met_building {
            self.solve_inline_masks(&var c)
        }
        d = 0
        while d < n {
            // Stage 0 workaround (SL:hazards S4): canonical: c.edge_first[d] = c.edges.len()
            let first = c.edges.len()
            c.edge_first[d] = first
            if self.res.decls[d].node >= 0 {
                var seen = tc_memo()
                let members = self.members_of(d)
                var k = 0
                while k < members.len() {
                    let parts = self.inline_parts(members[k])
                    var j = 0
                    while j < parts.len() {
                        self.collect_inline_edges(parts[j], &var c, &var seen)
                        j = j + 1
                    }
                    k = k + 1
                }
            }
            // Stage 0 workaround (SL:hazards S4): canonical: c.edge_count[d] = c.edges.len() - c.edge_first[d]
            let count = c.edges.len() - first
            c.edge_count[d] = count
            d = d + 1
        }
        var g = TcComponents(index: tc_ints(n, -1), low: tc_ints(n, 0), on_stack: tc_bools(n),
                             stack: tc_ints(n, -1), depth: 0, next: 0, on_cycle: tc_bools(n))
        d = 0
        while d < n {
            if g.index[d] < 0 && c.edge_count[d] > 0 {
                self.containment_component(d, &c, &var g)
            }
            d = d + 1
        }
        var reported = tc_bools(n)
        d = 0
        while d < n {
            let info = self.res.decls[d]
            let own = info.kind == ResDeclKind.Struct || info.kind == ResDeclKind.Enum
            if own && g.on_cycle[d] && not reported[d] {
                self.refuse_infinite(d, &var reported)
            }
            d = d + 1
        }
    }

    func build_inline_mask(&var self, d: Int, c: &var TcContainment) {
        c.states[d] = TC_MASK_BUILDING
        var memo = tc_memo()
        let mask = self.inline_mask_of(d, &var c, true, &var memo)
        c.masks[d] = mask
        c.states[d] = TC_MASK_BUILT
    }

    // The masks of a graph with a cycle, each recomputed from the last
    // round's until none changes. A mask only grows, so this ends.
    func solve_inline_masks(&var self, c: &var TcContainment) {
        var changed = true
        while changed {
            changed = false
            var memo = tc_memo()
            var next = Vector<Int>()
            var d = 0
            while d < c.masks.len() {
                if self.res.decls[d].node >= 0 {
                    try! next.push(self.inline_mask_of(d, &var c, false, &var memo))
                } else {
                    try! next.push(0)
                }
                d = d + 1
            }
            d = 0
            while d < next.len() {
                if next[d] != c.masks[d] {
                    c.masks[d] = next[d]
                    changed = true
                }
                d = d + 1
            }
        }
    }

    func inline_mask_of(&var self, d: Int, c: &var TcContainment, build: Bool, memo: &var TcMemo) -> Int {
        var mask = 0
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let parts = self.inline_parts(members[k])
            var j = 0
            while j < parts.len() {
                mask = mask | self.inline_mask_walk(parts[j], &var c, build, &var memo)
                j = j + 1
            }
            k = k + 1
        }
        mask
    }

    // The parameters type `t` holds inline, as bits. With `build`, a
    // declaration whose mask is not built yet is built first. A mask read
    // while it is built is short, and the fixpoint that follows corrects
    // it, so an answer kept from it is never the last word.
    func inline_mask_walk(&var self, t: Int, c: &var TcContainment, build: Bool, memo: &var TcMemo) -> Int {
        if t < 0 {
            return 0
        }
        let known = memo.get(t, 0)
        if known >= 0 {
            return known
        }
        let info = self.types.ty(t)
        var mask = 0
        if info.kind == TcKind.Param {
            mask = tc_bit(info.a)
        } else if info.kind == TcKind.Array {
            mask = self.inline_mask_walk(info.b, &var c, build, &var memo)
        } else if info.kind == TcKind.Tuple || info.kind == TcKind.Nominal {
            var held = -1
            if info.kind == TcKind.Nominal {
                let e = info.decl
                if self.res.decls[e].node >= 0 {
                    if build && c.states[e] == TC_MASK_UNSEEN {
                        self.build_inline_mask(e, &var c)
                    }
                    if c.states[e] == TC_MASK_BUILDING {
                        c.met_building = true
                    }
                    held = c.masks[e]
                } else if e != self.known.optional && e != self.known.result {
                    held = 0
                }
            }
            var k = 0
            while k < info.count {
                if held < 0 || (held & tc_bit(k)) != 0 {
                    let arg = self.types.arg(t, k)
                    mask = mask | self.inline_mask_walk(arg, &var c, build, &var memo)
                }
                k = k + 1
            }
        }
        memo.set(t, 0, mask)
        mask
    }

    // The edges from the declaration whose part `t` is: each declaration `t`
    // holds inline. A type met twice adds nothing more.
    func collect_inline_edges(&var self, t: Int, c: &var TcContainment, seen: &var TcMemo) {
        if t < 0 || not seen.mark(t, 0) {
            return
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Array {
            self.collect_inline_edges(info.b, &var c, &var seen)
            return
        }
        if info.kind != TcKind.Tuple && info.kind != TcKind.Nominal {
            return
        }
        var held = -1
        if info.kind == TcKind.Nominal {
            let e = info.decl
            if self.res.decls[e].node >= 0 {
                try! c.edges.push(e)
                held = c.masks[e]
            } else if e != self.known.optional && e != self.known.result {
                return
            }
        }
        var k = 0
        while k < info.count {
            if held < 0 || (held & tc_bit(k)) != 0 {
                let arg = self.types.arg(t, k)
                self.collect_inline_edges(arg, &var c, &var seen)
            }
            k = k + 1
        }
    }

    // Tarjan's visit of declaration `v`: every declaration of a component
    // with more than one, or with an edge to itself, is on a cycle.
    func containment_component(&self, v: Int, c: &TcContainment, g: &var TcComponents) {
        let order = g.next
        // Stage 0 workaround (SL:hazards S4): canonical: g.index[v] = g.next
        g.index[v] = order
        // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.next
        g.low[v] = order
        g.next = order + 1
        g.stack[g.depth] = v
        g.depth = g.depth + 1
        g.on_stack[v] = true
        var k = 0
        while k < c.edge_count[v] {
            let w = c.edges[c.edge_first[v] + k]
            k = k + 1
            if w == v {
                g.on_cycle[v] = true
            }
            if g.index[w] < 0 {
                self.containment_component(w, &c, &var g)
                let reached = g.low[w]
                if reached < g.low[v] {
                    // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.low[w]
                    g.low[v] = reached
                }
            } else if g.on_stack[w] && g.index[w] < g.low[v] {
                let reached = g.index[w]
                // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.index[w]
                g.low[v] = reached
            }
        }
        if g.low[v] != g.index[v] {
            return
        }
        var first = g.depth - 1
        while g.stack[first] != v {
            first = first - 1
        }
        let size = g.depth - first
        var j = first
        while j < g.depth {
            let w = g.stack[j]
            g.on_stack[w] = false
            if size > 1 {
                g.on_cycle[w] = true
            }
            j = j + 1
        }
        g.depth = first
    }

    // The types member `m` holds inline: a field's type, a case's payloads.
    func inline_parts(&self, m: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let info = self.res.decls[m]
        let s = self.sigs[m]
        if info.kind == ResDeclKind.Field && s.result >= 0 {
            try! out.push(s.result)
        } else if info.kind == ResDeclKind.Case {
            var k = 0
            while k < s.param_count {
                let p = self.params[s.param_first + k]
                try! out.push(p.ty)
                k = k + 1
            }
        }
        move out
    }

    // Declaration `d`, which is on a containment cycle, refused with the
    // members that lead from its storage to an instance of itself: the
    // shortest such path, so the search ends however the graph branches. The
    // declarations the path crosses are reported with it.
    func refuse_infinite(&var self, d: Int, reported: &var Vector<Bool>) {
        let start = self.self_type_of(d)
        var types = Vector<Int>()
        var parents = Vector<Int>()
        var crossed = Vector<Int>()
        var seen = tc_memo()
        try! types.push(start)
        try! parents.push(-1)
        try! crossed.push(-1)
        let _ = seen.mark(start, 0)
        var found = -1
        var head = 0
        while head < types.len() && found < 0 {
            let at = head
            head = head + 1
            let t = types[at]
            let info = self.types.ty(t)
            var parts = Vector<Int>()
            var through = Vector<Int>()
            if info.kind == TcKind.Array {
                try! parts.push(info.b)
                try! through.push(-1)
            } else if info.kind == TcKind.Tuple || (info.kind == TcKind.Nominal && (info.decl == self.known.optional || info.decl == self.known.result) && self.res.decls[info.decl].node < 0) {
                var k = 0
                while k < info.count {
                    try! parts.push(self.types.arg(t, k))
                    try! through.push(-1)
                    k = k + 1
                }
            } else if info.kind == TcKind.Nominal && self.res.decls[info.decl].node >= 0 {
                let arguments = self.nominal_args(t)
                let subst = TcSubst(owner: info.decl, args: move arguments)
                let members = self.members_of(info.decl)
                var k = 0
                while k < members.len() {
                    let m = members[k]
                    let inline = self.inline_parts(m)
                    var j = 0
                    while j < inline.len() {
                        try! parts.push(self.subst(inline[j], &subst))
                        try! through.push(m)
                        j = j + 1
                    }
                    k = k + 1
                }
            }
            var k = 0
            while k < parts.len() && found < 0 {
                let part = parts[k]
                let pi = self.types.ty(part)
                if pi.kind == TcKind.Nominal && pi.decl == d {
                    found = types.len()
                }
                if found >= 0 || seen.mark(part, 0) {
                    try! types.push(part)
                    try! parents.push(at)
                    try! crossed.push(through[k])
                }
                k = k + 1
            }
        }
        var path = Vector<Int>()
        var at = found
        while at > 0 {
            if crossed[at] >= 0 {
                try! path.push(crossed[at])
            }
            at = parents[at]
        }
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("recursive type `")
        try! msg.append(self.res.decl_path(d))
        if found >= 0 && types[found] == start {
            try! msg.append("` has infinite size: its storage contains its own storage inline")
        } else if found >= 0 {
            try! msg.append("` has infinite size: its inline storage instantiates it again, as `")
            try! msg.append(self.type_text(types[found]))
            try! msg.append("`, and so on without end")
        } else {
            try! msg.append("` has infinite size: its storage contains an instance of itself inline")
        }
        if path.len() > 0 {
            try! msg.append(", through ")
            var k = path.len() - 1
            while k >= 0 {
                try! msg.append(self.res.decl_path(path[k]))
                try! msg.append(" -> ")
                let parent = self.res.decls[path[k]].parent
                if parent >= 0 {
                    reported[parent] = true
                }
                k = k - 1
            }
            try! msg.append(self.res.decl_path(d))
        }
        reported[d] = true
        try! msg.append("; hold the recursive member behind a heap indirection, such as `Box` or `Vector`")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "type.infinite-size", msg.build())
    }
}

// The traits the compiler only derives.
extension TcProgram {
    // THE DERIVED-ONLY FUNNEL: every rule on a trait the compiler only
    // derives. `Send` and `Sync` follow from the members, so a conformance
    // written to one is refused, and a user trait refining one requires it
    // of each conformer, checked under the extension's conditions; it never
    // grants it (`conformance_grants`), since that would assert thread-safety
    // past every check `UnsafeSend` and `UnsafeSync` make (spec, Send and
    // Sync). `Deinit` is carried by a copy policy, so neither a conformance
    // nor a user trait's parent list may name it. It reads the conformance
    // table, which holds every written conformance (a plain or conditional
    // head, a struct or an enum, several traits in one head, an `@synthesize`
    // one, a test-only extension and a test group's), and every trait's
    // parent list. The assertions, `UnsafeSend` and `UnsafeSync`, are the
    // assertion funnel's (`check_thread_assertion`).
    // ENTRY POINTS:
    //     tc_check_derived_conformances
    public func check_derived_conformances(&var self) {
        self.check_deinit_parents()
        self.check_assertion_positions()
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            let tr = c.trait_decl
            if tr == self.known.unsafe_send || tr == self.known.unsafe_sync {
                self.check_thread_assertion(k - 1)
                continue
            }
            if tr != self.known.deinit && tr != self.known.send && tr != self.known.sync {
                let send = self.known.send
                let sync = self.known.sync
                self.check_derived_parent(k - 1, send)
                self.check_derived_parent(k - 1, sync)
                continue
            }
            if tr == self.known.deinit {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.res.decl_path(c.type_decl))
                try! msg.append("` conforms to `Deinit` directly, and `Deinit` takes no conformance: a hand-written `deinit` goes in the type's copy policy, `NoCopy`, `ExplicitCopy` or `Copy`")
                self.refuse_in(c.module, c.node, "conformance.deinit", msg.build())
                continue
            }
            let name = self.res.decl_path(tr)
            let target = self.res.decl_path(c.type_decl)
            var msg = StringBuilder()
            try! msg.append("cannot explicitly implement `")
            try! msg.append(name)
            try! msg.append("`: it is a marker trait derived structurally by the compiler, so `")
            try! msg.append(target)
            try! msg.append("` is `")
            try! msg.append(name)
            try! msg.append("` exactly when its members are; where an unsafe-typed member blocks the derivation, a conformance to `Unsafe")
            try! msg.append(name)
            try! msg.append("` asserts it")
            self.refuse_in(c.module, c.node, "conformance.derived-only", msg.build())
        }
    }

    // What conformance `at` owes when its trait refines `parent`, `Send` or
    // `Sync`: its type derives `parent`, with the extension's conditions in
    // scope, as code that may use the conformance sees it.
    func check_derived_parent(&var self, at: Int, parent: Int) {
        let c = self.conformances[at]
        if parent < 0 || not self.trait_refines(c.trait_decl, parent) {
            return
        }
        let in_test = self.is_test_only_conformance(at)
        let t = self.self_type_of(c.type_decl)
        if self.satisfies(t, parent, c.type_decl, c.ext, c.module, in_test) {
            return
        }
        let name = self.res.decl_path(parent)
        let target = self.res.decl_path(c.type_decl)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(target)
        try! msg.append("` conforms to `")
        try! msg.append(self.res.decl_path(c.trait_decl))
        try! msg.append("`, which requires `")
        try! msg.append(name)
        try! msg.append("`, and `")
        try! msg.append(target)
        try! msg.append("` is not `")
        try! msg.append(name)
        try! msg.append("`")
        let blocker = self.derivation_blocker(t, parent, c.type_decl, c.ext, c.module, in_test)
        if blocker.len() > 0 {
            try! msg.append(": ")
            try! msg.append(blocker)
        }
        try! msg.append("; a conformance requires the parent and never grants it")
        self.refuse_in(c.module, c.node, "conformance.derived-parent", msg.build())
    }

    // A user trait listing `Deinit` as a parent. Only the copy policies,
    // `NoCopy` and `ExplicitCopy`, may: a conformance to any other would give
    // a type a `deinit` with no transfer rule, which no scope exit calls
    // (spec, The Deinit trait).
    func check_deinit_parents(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            let policy = d - 1 == self.known.no_copy || d - 1 == self.known.explicit_copy
            if info.kind != ResDeclKind.Trait || info.node < 0 || policy {
                continue
            }
            let n = self.child_count(info.node)
            var k = 0
            while k < n {
                let c = self.child(info.node, k)
                k = k + 1
                if not self.has_alt(c, Alt.Type_Path) {
                    continue
                }
                let last = self.child_count(c) - 1
                let leaf = self.child(c, last)
                let b = self.binding_at(leaf)
                if b.kind != ResBindKind.Decl || b.decl != self.known.deinit {
                    continue
                }
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.res.decl_path(d - 1))
                try! msg.append("` lists `Deinit` as a parent, which only the copy policies `NoCopy` and `ExplicitCopy` do: a conformance to it would give a type a `deinit` with no copy policy, and nothing would call it")
                self.refuse_in(info.module, c, "trait.deinit-parent", msg.build())
            }
        }
    }
}

// The traits a conformance requires and never grants.
extension TcProgram {
    // THE REQUIRES FUNNEL: a conformance to a trait `required_trait` names,
    // or to one refining it, is refused at its head unless its type meets the
    // required trait with the extension's conditions in scope, as code that
    // may use the conformance sees it. It reads the conformance table, so a
    // written, an `@synthesize`d, a conditional and a test-only conformance
    // are each asked; an automatic `Hashable` is met only where `Equatable`
    // is too, by the same trivial-type rule, and `Comparable` has none.
    // ENTRY POINTS:
    //     tc_check_required_conformances
    public func check_required_conformances(&var self) {
        var at = 0
        while at < self.conformances.len() {
            let c = self.conformances[at]
            let traits = self.trait_and_ancestors(c.trait_decl)
            var k = 0
            while k < traits.len() {
                let needs = self.required_trait(traits[k])
                if needs >= 0 {
                    self.check_required(at, traits[k], needs)
                }
                k = k + 1
            }
            at = at + 1
        }
    }

    func check_required(&var self, at: Int, tr: Int, needs: Int) {
        let c = self.conformances[at]
        let in_test = self.is_test_only_conformance(at)
        let t = self.self_type_of(c.type_decl)
        if self.satisfies(t, needs, c.type_decl, c.ext, c.module, in_test) {
            return
        }
        let target = self.res.decl_path(c.type_decl)
        let name = self.res.decl_path(tr)
        let needed = self.res.decl_path(needs)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(target)
        try! msg.append("` conforms to `")
        try! msg.append(self.res.decl_path(c.trait_decl))
        if c.trait_decl != tr {
            try! msg.append("`, which refines `")
            try! msg.append(name)
            try! msg.append("`,")
        } else {
            try! msg.append("`")
        }
        try! msg.append(" but not to `")
        try! msg.append(needed)
        try! msg.append("`: `")
        try! msg.append(name)
        try! msg.append("` requires `")
        try! msg.append(needed)
        try! msg.append("`, and a conformance never grants it; declare a conformance to `")
        try! msg.append(needed)
        try! msg.append("` beside it, `@synthesize`d or with a written `equals`")
        self.ensure_generic_list(c.type_decl)
        if self.sigs[c.type_decl].generic_count > 0 {
            try! msg.append(", whose conditions this conformance's bounds meet")
        }
        self.refuse_in(c.module, c.node, "conformance.requires", msg.build())
    }
}

// Where a type's policies are declared.
extension TcProgram {
    // A policy conformance, `Copy`, `ExplicitCopy`, `NoCopy`, `NoMove`,
    // `ZeroInit`, `UnsafeSend` or `UnsafeSync`, is declared in the file that
    // defines its type (`policy_in_place`), and test code is a file of its
    // own, so test code cannot give a production type a second tier,
    // movability, zero value or thread behaviour (SL-659). It reads every
    // written conformance: a plain or conditional head, an `@synthesize` one,
    // a test-only extension and a test group's.
    public func check_policy_placement(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let at = k
            k = k + 1
            if self.policy_in_place(at) {
                continue
            }
            let c = self.conformances[at]
            let target = self.res.decl_path(c.type_decl)
            let owner = self.res.decls[c.type_decl].module
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(target)
            try! msg.append("` conforms to `")
            try! msg.append(self.res.decl_path(c.trait_decl))
            if self.res.decls[c.ext].test_only && not self.res.decls[c.type_decl].test_only {
                try! msg.append("` in test code, and `")
                try! msg.append(target)
                try! msg.append("` is a production type")
            } else {
                try! msg.append("` outside the file that defines `")
                try! msg.append(target)
                try! msg.append("`, module `")
                try! msg.append(self.res.module_name(owner))
                try! msg.append("`")
            }
            try! msg.append(": a type's policies (`Copy`, `ExplicitCopy`, `NoCopy`, `NoMove`, `ZeroInit`, `UnsafeSend` and `UnsafeSync`) are declared beside it, in its defining file, and test code is a file of its own; declare this one with the type")
            if self.res.decls[c.ext].test_only {
                try! msg.append(", or make the type test-only too")
            }
            self.refuse_in(c.module, c.node, "conformance.policy-placement", msg.build())
        }
    }
}

// The thread-safety assertion, `UnsafeSend` and `UnsafeSync`.
extension TcProgram {
    // THE ASSERTION FUNNEL: every rule on `UnsafeSend` and `UnsafeSync` but
    // object safety's (spec, `UnsafeSync` / `UnsafeSend`). The assertion is
    // checked at its header: refused where the type derives the property from
    // its members under the extension's conditions, and past a member that
    // blocks the derivation unless the member's type names an unsafe type.
    // And it is written nowhere else: a generic parameter's bound naming it,
    // of any declaration or extension, and a trait's parent naming it are
    // refused. A specialized header is `extension.specialized-conformance`'s,
    // one outside its type's defining file `conformance.policy-placement`'s,
    // and an existential `check_object_safety`'s.
    // ENTRY POINTS:
    //     check_derived_conformances
    func check_thread_assertion(&var self, at: Int) {
        let c = self.conformances[at]
        let ext_node = self.res.decls[c.ext].node
        if tc_contains(&self.skipped, ext_node) || not self.policy_in_place(at) {
            return
        }
        let property = if c.trait_decl == self.known.unsafe_send { self.known.send } else { self.known.sync }
        if property < 0 {
            return
        }
        let in_test = self.is_test_only_conformance(at)
        let t = self.self_type_of(c.type_decl)
        let name = self.res.decl_path(c.trait_decl)
        let target = self.res.decl_path(c.type_decl)
        let property_name = self.res.decl_path(property)
        if self.satisfies_without(t, property, c.type_decl, c.type_decl, c.ext, c.module, in_test) {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(target)
            try! msg.append("` already derives `")
            try! msg.append(property_name)
            try! msg.append("`, so `")
            try! msg.append(name)
            try! msg.append("` asserts nothing: an assertion is legal only where the derivation fails, and one beside a type that derives cleanly tells the next reader something was needed; delete it")
            self.refuse_in(c.module, c.node, "conformance.assertion-derives", msg.build())
            return
        }
        // Empty when every blocking member is unsafe-typed, or when the type
        // is one no source declares, which has no member and whose assertion
        // the orphan rule keeps in the builtin module.
        let blocker = self.uncovered_blocker(t, property, c.type_decl, c.ext, c.module, in_test)
        if blocker.len() == 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append("cannot declare `")
        try! msg.append(name)
        try! msg.append("` for `")
        try! msg.append(target)
        try! msg.append("`: ")
        try! msg.append(blocker)
        try! msg.append(" and names no unsafe type; an assertion covers only what the unsafe domain owns, a raw pointer, an interior cell or an `UnsafeMemory`, so bound the parameter (`<T: ")
        try! msg.append(property_name)
        try! msg.append(">`) or hold the member behind a type that carries the synchronization")
        self.refuse_in(c.module, c.node, "conformance.assertion-safe-member", msg.build())
    }

    // The first field or case payload of nominal `t` that does not meet `tr`
    // and whose type names no unsafe type, named with its type; "" when
    // every one an assertion of `tr` would cover is unsafe-typed. Each is
    // judged as the derivation judged it, without `t`'s own assertions, so a
    // member reaching `t` again blocks with it.
    func uncovered_blocker(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, viewer: Int,
                           in_test: Bool) -> String {
        let info = self.types.ty(t)
        let arguments = self.nominal_args(t)
        let subst = TcSubst(owner: info.decl, args: move arguments)
        let members = self.members_of(info.decl)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            let s = self.sigs[m]
            var parts = Vector<Int>()
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                try! parts.push(self.subst(s.result, &subst))
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    try! parts.push(self.subst(p.ty, &subst))
                    j = j + 1
                }
            }
            var j = 0
            while j < parts.len() {
                let part = parts[j]
                j = j + 1
                if self.unsafe_named(part) >= 0 || self.satisfies_without(part, tr, info.decl, env_decl, env_ext, viewer, in_test) {
                    continue
                }
                var out = StringBuilder()
                if mi.kind == ResDeclKind.Field {
                    try! out.append("field `")
                    try! out.append(self.name_text(mi.name))
                    try! out.append("` has type `")
                } else {
                    try! out.append("case `")
                    try! out.append(self.name_text(mi.name))
                    try! out.append("` has a payload of type `")
                }
                try! out.append(self.type_text(part))
                try! out.append("`, which is not `")
                try! out.append(self.res.decl_path(tr))
                try! out.append("`")
                return out.build()
            }
        }
        ""
    }

    // Each generic parameter's bound and each trait parent that names
    // `UnsafeSend` or `UnsafeSync`, refused where it is written.
    func check_assertion_positions(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.node < 0 || info.kind == ResDeclKind.Field || info.kind == ResDeclKind.Case {
                continue
            }
            let n = self.child_count(info.node)
            var k = 0
            while k < n {
                let c = self.child(info.node, k)
                k = k + 1
                if info.kind == ResDeclKind.Trait && self.has_alt(c, Alt.Type_Path) {
                    let tr = self.assertion_named(c)
                    if tr >= 0 {
                        self.refuse_assertion_parent(d - 1, c, tr)
                    }
                } else if self.has_alt(c, Alt.Generic_Param_Type) {
                    self.check_assertion_bounds(info.module, c)
                }
            }
        }
    }

    // The bounds of generic parameter `g` that name an assertion.
    func check_assertion_bounds(&var self, m: Int, g: Int) {
        let n = self.child_count(g)
        var k = 0
        while k < n {
            let c = self.child(g, k)
            k = k + 1
            if not self.has_alt(c, Alt.Type_Path) {
                continue
            }
            let tr = self.assertion_named(c)
            if tr < 0 {
                continue
            }
            let name = self.res.decl_path(tr)
            let property = if tr == self.known.unsafe_send { self.known.send } else { self.known.sync }
            // Stage 0 workaround (SL:hazards S4): canonical: let param = self.text(m, self.child(g, 0))
            let leaf = self.child(g, 0)
            let param = self.text(m, leaf)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` is not a generic bound, so it cannot bound the type parameter `")
            try! msg.append(param)
            try! msg.append("`: bound it by the property, `")
            try! msg.append(param)
            try! msg.append(": ")
            try! msg.append(self.res.decl_path(property))
            try! msg.append("`, which a type declaring `")
            try! msg.append(name)
            try! msg.append("` meets through it; the assertion is written only in a conformance header, where it can be audited")
            self.refuse_in(m, c, "trait.assertion-position", msg.build())
        }
    }

    // Trait `d`'s parent `c`, which names assertion `tr`.
    func refuse_assertion_parent(&var self, d: Int, c: Int, tr: Int) {
        let info = self.res.decls[d]
        let name = self.res.decl_path(tr)
        let property = if tr == self.known.unsafe_send { self.known.send } else { self.known.sync }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` lists `")
        try! msg.append(name)
        try! msg.append("` as a parent, and the assertion is written only in a conformance header, where it can be audited: list the property, `")
        try! msg.append(self.res.decl_path(property))
        try! msg.append("`, as the parent, and declare `")
        try! msg.append(name)
        try! msg.append("` on each type that needs it")
        self.refuse_in(info.module, c, "trait.assertion-position", msg.build())
    }

    // The assertion trait path `c` names, `UnsafeSend` or `UnsafeSync`, or -1.
    func assertion_named(&self, c: Int) -> Int {
        let last = self.child_count(c) - 1
        let leaf = self.child(c, last)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return -1
        }
        if b.decl == self.known.unsafe_send || b.decl == self.known.unsafe_sync {
            return b.decl
        }
        return -1
    }
}

// What an `init` returns, and where a `deinit` is written.
extension TcProgram {
    // An `init` returns its receiver, or `Result<Receiver, E>`; an optional
    // is refused on its own terms, since a `None` names no cause (spec,
    // "What an init may return").
    public func check_inits(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Init || info.node < 0 {
                continue
            }
            let s = self.sigs[d - 1]
            if (s.flags & TC_FLAG_WRITTEN_RETURN) == 0 || self.has_error_type(s.result) {
                continue
            }
            let receiver = self.init_receiver(d - 1)
            if receiver < 0 || s.result == receiver {
                continue
            }
            let r = self.types.ty(s.result)
            if r.kind == TcKind.Nominal && r.decl == self.known.result && self.types.arg(s.result, 0) == receiver {
                continue
            }
            var msg = StringBuilder()
            if r.kind == TcKind.Nominal && r.decl == self.known.optional {
                try! msg.append("an `init` may not return an optional: an optional creation is `Result<")
                try! msg.append(self.type_text(receiver))
                try! msg.append(", E>`, because a `None` names no cause")
            } else {
                try! msg.append("an `init` returns its receiver, `")
                try! msg.append(self.type_text(receiver))
                try! msg.append("`, or `Result<")
                try! msg.append(self.type_text(receiver))
                try! msg.append(", E>`, and this one returns `")
                try! msg.append(self.type_text(s.result))
                try! msg.append("`")
            }
            let site = self.decl_site(d - 1)
            self.refuse_in(info.module, site, "init.result", msg.build())
        }
    }

    // The receiver an `init` builds: its extension's `Self`.
    func init_receiver(&var self, d: Int) -> Int {
        let info = self.res.decls[d]
        if info.parent < 0 {
            return -1
        }
        let target = self.ext_target(info.parent)
        if target < 0 {
            return -1
        }
        self.ext_self_type(info.parent)
    }

    func has_error_type(&self, t: Int) -> Bool {
        if t < 0 {
            return true
        }
        let info = self.types.ty(t)
        info.kind == TcKind.Error
    }

    // A hand-written `deinit` goes in the extension that declares the type's
    // copy policy (spec, The Deinit trait). Written in any other extension it
    // would be an ordinary method that no scope exit calls.
    public func check_deinit_placement(&var self) {
        let name = self.res.intern("deinit")
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Method || info.name != name || info.parent < 0 || info.leaf < 0 {
                continue
            }
            let ext = info.parent
            if self.res.decls[ext].kind != ResDeclKind.Extension || self.declares_policy(ext) {
                continue
            }
            let target = self.ext_target(ext)
            var msg = StringBuilder()
            try! msg.append("this `deinit` is written in an extension that declares no copy policy, where no scope exit calls it: write it inside ")
            if target >= 0 {
                try! msg.append("`")
                try! msg.append(self.res.decl_path(target))
                try! msg.append("`'s")
            } else {
                try! msg.append("the type's")
            }
            try! msg.append(" `NoCopy`, `ExplicitCopy` or `Copy` conformance")
            self.refuse_in(info.module, info.leaf, "deinit.outside-policy", msg.build())
        }
    }

    // Whether extension `ext` declares a copy policy, or `Deinit`, which
    // `conformance.deinit` refuses on its own.
    public func declares_policy(&var self, ext: Int) -> Bool {
        let deinit = self.known.deinit
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.ext != ext {
                continue
            }
            if c.trait_decl == self.known.copy || self.trait_refines(c.trait_decl, deinit) {
                return true
            }
        }
        false
    }
}

// The signature half of `unsafe`.
extension TcProgram {
    public func check_unsafe(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            let callable = info.kind == ResDeclKind.Func || info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init || info.kind == ResDeclKind.Requirement
            if callable && info.node >= 0 {
                self.check_declared_unsafe(d)
            } else if info.kind == ResDeclKind.Struct && info.node >= 0 {
                self.check_unsafe_name(d)
            }
            d = d + 1
        }
        var k = 0
        while k < self.func_nodes.len() {
            let node = self.func_nodes[k]
            self.check_function_type(node)
            k = k + 1
        }
    }

    // The unsafe type `t` names: itself, or one among its arguments, elements,
    // referent, parameters or result; -1 for none. A type is never unsafe for
    // what its own fields hold.
    public func unsafe_named(&self, t: Int) -> Int {
        var seen = tc_memo()
        self.unsafe_named_in(t, &var seen)
    }

    // One part of `unsafe_named`'s walk. A part met again was searched in
    // full the first time and named nothing.
    func unsafe_named_in(&self, t: Int, seen: &var TcMemo) -> Int {
        if t < 0 || not seen.mark(t, 0) {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Nominal && self.is_unsafe_decl(info.decl) {
            return t
        }
        if info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array || info.kind == TcKind.Func {
            let inner = self.unsafe_named_in(info.b, &var seen)
            if inner >= 0 {
                return inner
            }
        }
        if info.kind == TcKind.Nominal || info.kind == TcKind.Tuple || info.kind == TcKind.Func {
            var k = 0
            while k < info.count {
                let arg = self.types.arg(t, k)
                let found = self.unsafe_named_in(arg, &var seen)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
        }
        return -1
    }

    // A function whose signature names an unsafe type, through a parameter,
    // its result or its receiver, declares `unsafe` in its effect slot.
    func check_declared_unsafe(&var self, d: Int) {
        let s = self.sigs[d]
        if (s.effects & TC_EFFECT_UNSAFE) != 0 {
            return
        }
        var found = -1
        var k = 0
        while k < s.param_count && found < 0 {
            let p = self.params[s.param_first + k]
            found = self.unsafe_named(p.ty)
            k = k + 1
        }
        if found < 0 && s.result >= 0 {
            found = self.unsafe_named(s.result)
        }
        let info = self.res.decls[d]
        if found < 0 && s.receiver != TcReceiver.Absent && info.parent >= 0 {
            let target = self.ext_target(info.parent)
            if target >= 0 && self.is_unsafe_decl(target) {
                found = self.self_type_of(target)
            }
        }
        if found < 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` is not declared `unsafe`, but its signature names a value of unsafe type (`")
        try! msg.append(self.type_text(found))
        try! msg.append("`): write `unsafe` after its parameter list, where every caller can see it")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "unsafe.undeclared", msg.build())
    }

    // A function type says `unsafe` exactly when a parameter or its result
    // names an unsafe type, judged on the type as written.
    func check_function_type(&var self, node: Int) {
        let t = self.node_types[node]
        if t < 0 {
            return
        }
        let info = self.types.ty(t)
        if info.kind != TcKind.Func {
            return
        }
        let declared = (info.a & TC_EFFECT_UNSAFE) != 0
        let named = self.unsafe_named(t)
        let m = self.node_module(node)
        if named >= 0 && not declared {
            var msg = StringBuilder()
            try! msg.append("the function type `")
            try! msg.append(self.type_text(t))
            try! msg.append("` names an unsafe type (`")
            try! msg.append(self.type_text(named))
            try! msg.append("`) but its effect slot does not say `unsafe`")
            self.refuse_in(m, node, "unsafe.function-type", msg.build())
        } else if named < 0 && declared {
            var msg = StringBuilder()
            try! msg.append("the function type `")
            try! msg.append(self.type_text(t))
            try! msg.append("` declares `unsafe` but its signature names no unsafe type: a function taking only safe types must be sound for every input")
            self.refuse_in(m, node, "unsafe.function-type", msg.build())
        }
    }

    // An `unsafe struct` is named `Unsafe*`, so its unsafety shows wherever it
    // is named.
    func check_unsafe_name(&var self, d: Int) {
        let s = self.sigs[d]
        if (s.flags & TC_FLAG_UNSAFE_STRUCT) == 0 {
            return
        }
        let info = self.res.decls[d]
        let name = self.name_text(info.name)
        if name.starts_with("Unsafe") {
            return
        }
        var msg = StringBuilder()
        try! msg.append("an unsafe type must be named `Unsafe*`, but this one is named `")
        try! msg.append(name)
        try! msg.append("`: rename it to `Unsafe")
        try! msg.append(name)
        try! msg.append("`, or drop `unsafe` if the type is safe to name, hold and pass")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "unsafe.type-name", msg.build())
    }

    // The module whose arena range holds node `id`.
    public func node_module(&self, id: Int) -> Int {
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && id >= info.node_base && id < info.node_base + info.node_count {
                return m
            }
            m = m + 1
        }
        return -1
    }
}

// The atomic role's width rule (SL:open-questions D38): v1 atomics are
// `Atomic<Int>` only, since their operations are the `i64` intrinsics. Each
// `Atomic<X>` formed at another `X` (`narrow_atomics`) is refused once, where
// a position first carries exactly it, or else where one first carries a type
// holding it. One formed only by monomorphization is mono's to refuse.
public func tc_check_atomic_widths(p: &var TcProgram) {
    var k = 0
    while k < p.narrow_atomics.len() {
        let t = p.narrow_atomics[k]
        k = k + 1
        // A written type first, then an expression; exactly the type
        // first, then one holding it.
        var at = tc_first_carrier(&var p, false, t, true)
        if at < 0 {
            at = tc_first_carrier(&var p, true, t, true)
        }
        if at < 0 {
            at = tc_first_carrier(&var p, false, t, false)
        }
        if at < 0 {
            at = tc_first_carrier(&var p, true, t, false)
        }
        if at >= 0 {
            p.refuse_narrow_atomic(at, t)
            p.narrow_reported[k - 1] = true
        }
    }
}

// The first node whose written type, or with `expressions` whose
// expression's type, is `t`, or, unless `exact`, holds it; -1 when none is.
func tc_first_carrier(p: &var TcProgram, expressions: Bool, t: Int, exact: Bool) -> Int {
    let count = if expressions { p.expr_types.len() } else { p.node_types.len() }
    var n = 0
    while n < count {
        let carried = if expressions { p.expr_types[n] } else { p.node_types[n] }
        if carried == t || (not exact && carried >= 0 && p.type_holds(carried, t)) {
            return n
        }
        n = n + 1
    }
    return -1
}

extension TcProgram {
    public func refuse_narrow_atomic(&var self, at: Int, t: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` is not an atomic this compiler lowers: v1 atomics are `Atomic<Int>` only")
        let m = self.node_module(at)
        self.refuse_in(m, at, "atomic.width", msg.build())
    }
}

// The refusals of a test-only conformance to a trait a production type already
// meets in production code, and of a test-only member meeting a requirement a
// production conformance already meets.
public func tc_check_test_only_overlaps(p: &var TcProgram) {
    p.check_test_only_overlaps()
    p.check_test_only_shadows()
}

// Test-only conformances beside production ones.
extension TcProgram {
    // A test-only conformance to a trait a production type already meets in
    // production code is refused (SL:testing): a production generic has one
    // instance at the type, which production code runs, so it cannot also
    // run the test-only members. The type meets the trait through another
    // conformance that refines it, or, for `Equatable` and `Hashable`,
    // automatically as a trivially copyable type. The same pair twice is
    // resolve's `conformance.duplicate`.
    public func check_test_only_overlaps(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl < 0 || not self.is_test_only_conformance(k - 1) || self.res.decls[c.type_decl].test_only {
                continue
            }
            let through = self.production_refinement(k - 1)
            if through >= 0 {
                self.refuse_test_only_overlap(k - 1, through)
            } else if self.meets_automatically(c.type_decl, c.trait_decl) {
                self.refuse_test_only_overlap(k - 1, -1)
            }
        }
    }

    // A production conformance of conformance `at`'s type to a trait that
    // refines `at`'s own, or -1.
    func production_refinement(&self, at: Int) -> Int {
        let c = self.conformances[at]
        var k = 0
        while k < self.conformances.len() {
            let other = self.conformances[k]
            k = k + 1
            if other.type_decl != c.type_decl || other.trait_decl == c.trait_decl || self.is_test_only_conformance(k - 1) {
                continue
            }
            if self.trait_refines(other.trait_decl, c.trait_decl) {
                return k - 1
            }
        }
        return -1
    }

    // Whether nominal `d` meets `Equatable` or `Hashable` with no conformance
    // written, as a trivially copyable type, for some arguments of its
    // parameters.
    func meets_automatically(&var self, d: Int, tr: Int) -> Bool {
        if tr != self.known.equatable && tr != self.known.hashable {
            return false
        }
        let t = self.self_type_of(d)
        self.may_be_trivial(t)
    }

    func refuse_test_only_overlap(&var self, at: Int, through: Int) {
        let c = self.conformances[at]
        let type_name = self.res.decl_path(c.type_decl)
        var msg = StringBuilder()
        try! msg.append("a test-only conformance that overlaps a production one is refused: `")
        try! msg.append(type_name)
        try! msg.append("` already meets `")
        try! msg.append(self.res.decl_path(c.trait_decl))
        if through >= 0 {
            let other = self.conformances[through]
            try! msg.append("` in production code, through its conformance to `")
            try! msg.append(self.res.decl_path(other.trait_decl))
            try! msg.append("` at ")
            try! msg.append(self.res.node_position(other.module, other.node))
        } else {
            try! msg.append("` in production code, as a trivially copyable type")
        }
        try! msg.append(", and test code cannot change what a production generic runs for it; drop this conformance, or make the type test-only too")
        self.refuse_in(c.module, c.node, "conformance.test-only-overlap", msg.build())
    }

    // A test-only member of a production type whose signature meets a
    // requirement a production conformance of the type meets with the
    // trait's default or a derivation is refused where it is declared
    // (SL:testing): no call through the trait ever runs it, and test code's
    // direct call could not choose between the two. One met by a written
    // member is `overload.indistinguishable`'s, a copy policy's `copy()`
    // `copy.test-only-policy`'s and a `deinit` `deinit.outside-policy`'s.
    public func check_test_only_shadows(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            let callable = info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init
            if not callable || not info.test_only || info.parent < 0 || info.leaf < 0 {
                continue
            }
            let ext = info.parent
            if self.res.decls[ext].kind != ResDeclKind.Extension {
                continue
            }
            let target = self.ext_target(ext)
            if target >= 0 && not self.res.decls[target].test_only {
                self.check_test_only_shadow(d - 1, target)
            }
        }
    }

    // The refusal of test-only member `d` of production type `target`, when
    // it meets a requirement a production conformance of `target` meets with
    // a default or a derivation.
    func check_test_only_shadow(&var self, d: Int, target: Int) {
        let name = self.res.decls[d].name
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl != target || self.is_test_only_conformance(k - 1) {
                continue
            }
            let s = self.conformance_subst(k - 1)
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                let filled = st.kind == TcStatusKind.Default || st.kind == TcStatusKind.Synthesized
                let req = self.res.decls[st.requirement]
                let tr = req.parent
                let owned = tr == self.known.copy || tr == self.known.explicit_copy || tr == self.known.deinit
                if not filled || owned || req.name != name {
                    continue
                }
                self.build_decl(d)
                if self.agrees(st.requirement, d, &s) {
                    self.refuse_test_only_shadow(d, k - 1, st)
                    return
                }
            }
        }
    }

    func refuse_test_only_shadow(&var self, d: Int, at: Int, st: TcStatus) {
        let info = self.res.decls[d]
        let c = self.conformances[at]
        let type_name = self.res.decl_path(c.type_decl)
        var msg = StringBuilder()
        try! msg.append("a test-only member that meets a requirement production code already meets is refused: `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` meets `")
        try! msg.append(self.res.decl_path(st.requirement))
        try! msg.append("`, which `")
        try! msg.append(type_name)
        try! msg.append("`'s conformance to `")
        try! msg.append(self.res.decl_path(c.trait_decl))
        try! msg.append("` at ")
        try! msg.append(self.res.node_position(c.module, c.node))
        if st.kind == TcStatusKind.Synthesized {
            try! msg.append(" derives with `@synthesize`")
        } else {
            try! msg.append(" meets with the trait's default")
        }
        try! msg.append(", so no call through the trait runs it; to fake `")
        // Stage 0 workaround (SL:hazards S4): canonical: try! msg.append(self.res.decl_path(self.res.decls[st.requirement].parent))
        let trait_decl = self.res.decls[st.requirement].parent
        try! msg.append(self.res.decl_path(trait_decl))
        try! msg.append("`, pass a test-only type that conforms to it to the production generic, or give this member another name")
        self.refuse_in(info.module, info.leaf, "conformance.test-only-shadow", msg.build())
    }
}
