// The signature-only checks that need every signature first: finite struct
// size, which is a cycle in the by-value containment graph (spec, Recursive
// types), and the signature half of `unsafe` (designs 130 and 136).

import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResDecl, ResDeclKind}
import sawtypecheck.conform.{TcSubst, tc_args_subst}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.model.{TC_EFFECT_UNSAFE, TC_FLAG_UNSAFE_STRUCT, TC_FLAG_WRITTEN_RETURN, TcParam,
                               TcReceiver, TcSig}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.tier.{tc_bit, tc_tier}
import sawtypecheck.types.{TcKind, TcType}
import sawtypecheck.walks.{TcMemo, tc_memo}

// Finite struct size.
public func tc_check_finite_size(p: &var TcProgram) {
    p.check_finite_size()
}

// The signature half of `unsafe`.
public func tc_check_unsafe(p: &var TcProgram) {
    p.check_unsafe()
}

// What an `init` returns, and where `Deinit`'s body may be written.
public func tc_check_inits(p: &var TcProgram) {
    p.check_inits()
    p.check_deinit_conformances()
    p.check_deinit_placement()
}

static TC_MASK_UNSEEN: Int = 0
static TC_MASK_BUILDING: Int = 1
static TC_MASK_BUILT: Int = 2

// The by-value containment graph over declarations. A struct or enum's mask
// names the type parameters it holds inline; an edge runs to each
// declaration it holds inline, written there or reached through an inline
// parameter of another. A cycle in this graph is the whole test: a
// declaration on one holds an instance of itself inline, whatever the
// arguments, and a declaration on none has finitely many inline instances
// below it.
struct TcContainment {
    masks: Vector<Int>
    states: Vector<Int>
    // Whether a mask was read while it was being built, which only a cycle
    // does, so the masks are then solved to their fixpoint.
    met_building: Bool
    edge_first: Vector<Int>
    edge_count: Vector<Int>
    edges: Vector<Int>
}

extension TcContainment: NoCopy {}

// Tarjan's strongly connected components over the containment graph.
struct TcComponents {
    index: Vector<Int>
    low: Vector<Int>
    on_stack: Vector<Bool>
    stack: Vector<Int>
    depth: Int
    next: Int
    on_cycle: Vector<Bool>
}

extension TcComponents: NoCopy {}

func tc_ints(n: Int, value: Int) -> Vector<Int> {
    var out = Vector<Int>()
    var k = 0
    while k < n {
        try! out.push(value)
        k = k + 1
    }
    move out
}

func tc_bools(n: Int) -> Vector<Bool> {
    var out = Vector<Bool>()
    var k = 0
    while k < n {
        try! out.push(false)
        k = k + 1
    }
    move out
}

extension TcProgram {
    // Every struct and enum whose storage contains its own storage inline:
    // through a field, a payload, a tuple element, an Optional's payload, an
    // array's element, and the same positions of the generic declarations a
    // member instantiates. A pointer, a reference, a function value and an
    // `any` embed nothing. One refusal per cycle, at its first declaration.
    public func check_finite_size(&var self) {
        let n = self.res.decls.len()
        var c = TcContainment(masks: tc_ints(n, 0), states: tc_ints(n, TC_MASK_UNSEEN), met_building: false,
                              edge_first: tc_ints(n, 0), edge_count: tc_ints(n, 0), edges: Vector<Int>())
        var d = 0
        while d < n {
            if self.res.decls[d].node >= 0 && c.states[d] == TC_MASK_UNSEEN {
                self.build_inline_mask(d, &var c)
            }
            d = d + 1
        }
        if c.met_building {
            self.solve_inline_masks(&var c)
        }
        d = 0
        while d < n {
            // Stage 0 workaround (SL:hazards S4): canonical: c.edge_first[d] = c.edges.len()
            let first = c.edges.len()
            c.edge_first[d] = first
            if self.res.decls[d].node >= 0 {
                var seen = tc_memo()
                let members = self.members_of(d)
                var k = 0
                while k < members.len() {
                    let parts = self.inline_parts(members[k])
                    var j = 0
                    while j < parts.len() {
                        self.collect_inline_edges(parts[j], &var c, &var seen)
                        j = j + 1
                    }
                    k = k + 1
                }
            }
            // Stage 0 workaround (SL:hazards S4): canonical: c.edge_count[d] = c.edges.len() - c.edge_first[d]
            let count = c.edges.len() - first
            c.edge_count[d] = count
            d = d + 1
        }
        var g = TcComponents(index: tc_ints(n, -1), low: tc_ints(n, 0), on_stack: tc_bools(n),
                             stack: tc_ints(n, -1), depth: 0, next: 0, on_cycle: tc_bools(n))
        d = 0
        while d < n {
            if g.index[d] < 0 && c.edge_count[d] > 0 {
                self.containment_component(d, &c, &var g)
            }
            d = d + 1
        }
        var reported = tc_bools(n)
        d = 0
        while d < n {
            let info = self.res.decls[d]
            let own = info.kind == ResDeclKind.Struct || info.kind == ResDeclKind.Enum
            if own && g.on_cycle[d] && not reported[d] {
                self.refuse_infinite(d, &var reported)
            }
            d = d + 1
        }
    }

    func build_inline_mask(&var self, d: Int, c: &var TcContainment) {
        c.states[d] = TC_MASK_BUILDING
        var memo = tc_memo()
        let mask = self.inline_mask_of(d, &var c, true, &var memo)
        c.masks[d] = mask
        c.states[d] = TC_MASK_BUILT
    }

    // The masks of a graph with a cycle, each recomputed from the last
    // round's until none changes. A mask only grows, so this ends.
    func solve_inline_masks(&var self, c: &var TcContainment) {
        var changed = true
        while changed {
            changed = false
            var memo = tc_memo()
            var next = Vector<Int>()
            var d = 0
            while d < c.masks.len() {
                if self.res.decls[d].node >= 0 {
                    try! next.push(self.inline_mask_of(d, &var c, false, &var memo))
                } else {
                    try! next.push(0)
                }
                d = d + 1
            }
            d = 0
            while d < next.len() {
                if next[d] != c.masks[d] {
                    c.masks[d] = next[d]
                    changed = true
                }
                d = d + 1
            }
        }
    }

    func inline_mask_of(&var self, d: Int, c: &var TcContainment, build: Bool, memo: &var TcMemo) -> Int {
        var mask = 0
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let parts = self.inline_parts(members[k])
            var j = 0
            while j < parts.len() {
                mask = mask | self.inline_mask_walk(parts[j], &var c, build, &var memo)
                j = j + 1
            }
            k = k + 1
        }
        mask
    }

    // The parameters type `t` holds inline, as bits. With `build`, a
    // declaration whose mask is not built yet is built first. A mask read
    // while it is built is short, and the fixpoint that follows corrects
    // it, so an answer kept from it is never the last word.
    func inline_mask_walk(&var self, t: Int, c: &var TcContainment, build: Bool, memo: &var TcMemo) -> Int {
        if t < 0 {
            return 0
        }
        let known = memo.get(t, 0)
        if known >= 0 {
            return known
        }
        let info = self.types.ty(t)
        var mask = 0
        if info.kind == TcKind.Param {
            mask = tc_bit(info.a)
        } else if info.kind == TcKind.Array {
            mask = self.inline_mask_walk(info.b, &var c, build, &var memo)
        } else if info.kind == TcKind.Tuple || info.kind == TcKind.Nominal {
            var held = -1
            if info.kind == TcKind.Nominal {
                let e = info.decl
                if self.res.decls[e].node >= 0 {
                    if build && c.states[e] == TC_MASK_UNSEEN {
                        self.build_inline_mask(e, &var c)
                    }
                    if c.states[e] == TC_MASK_BUILDING {
                        c.met_building = true
                    }
                    held = c.masks[e]
                } else if e != self.known.optional && e != self.known.result {
                    held = 0
                }
            }
            var k = 0
            while k < info.count {
                if held < 0 || (held & tc_bit(k)) != 0 {
                    let arg = self.types.arg(t, k)
                    mask = mask | self.inline_mask_walk(arg, &var c, build, &var memo)
                }
                k = k + 1
            }
        }
        memo.set(t, 0, mask)
        mask
    }

    // The edges from the declaration whose part `t` is: each declaration `t`
    // holds inline. A type met twice adds nothing more.
    func collect_inline_edges(&var self, t: Int, c: &var TcContainment, seen: &var TcMemo) {
        if t < 0 || not seen.mark(t, 0) {
            return
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Array {
            self.collect_inline_edges(info.b, &var c, &var seen)
            return
        }
        if info.kind != TcKind.Tuple && info.kind != TcKind.Nominal {
            return
        }
        var held = -1
        if info.kind == TcKind.Nominal {
            let e = info.decl
            if self.res.decls[e].node >= 0 {
                try! c.edges.push(e)
                held = c.masks[e]
            } else if e != self.known.optional && e != self.known.result {
                return
            }
        }
        var k = 0
        while k < info.count {
            if held < 0 || (held & tc_bit(k)) != 0 {
                let arg = self.types.arg(t, k)
                self.collect_inline_edges(arg, &var c, &var seen)
            }
            k = k + 1
        }
    }

    // Tarjan's visit of declaration `v`: every declaration of a component
    // with more than one, or with an edge to itself, is on a cycle.
    func containment_component(&self, v: Int, c: &TcContainment, g: &var TcComponents) {
        let order = g.next
        // Stage 0 workaround (SL:hazards S4): canonical: g.index[v] = g.next
        g.index[v] = order
        // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.next
        g.low[v] = order
        g.next = order + 1
        g.stack[g.depth] = v
        g.depth = g.depth + 1
        g.on_stack[v] = true
        var k = 0
        while k < c.edge_count[v] {
            let w = c.edges[c.edge_first[v] + k]
            k = k + 1
            if w == v {
                g.on_cycle[v] = true
            }
            if g.index[w] < 0 {
                self.containment_component(w, &c, &var g)
                let reached = g.low[w]
                if reached < g.low[v] {
                    // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.low[w]
                    g.low[v] = reached
                }
            } else if g.on_stack[w] && g.index[w] < g.low[v] {
                let reached = g.index[w]
                // Stage 0 workaround (SL:hazards S4): canonical: g.low[v] = g.index[w]
                g.low[v] = reached
            }
        }
        if g.low[v] != g.index[v] {
            return
        }
        var first = g.depth - 1
        while g.stack[first] != v {
            first = first - 1
        }
        let size = g.depth - first
        var j = first
        while j < g.depth {
            let w = g.stack[j]
            g.on_stack[w] = false
            if size > 1 {
                g.on_cycle[w] = true
            }
            j = j + 1
        }
        g.depth = first
    }

    // The types member `m` holds inline: a field's type, a case's payloads.
    func inline_parts(&self, m: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let info = self.res.decls[m]
        let s = self.sigs[m]
        if info.kind == ResDeclKind.Field && s.result >= 0 {
            try! out.push(s.result)
        } else if info.kind == ResDeclKind.Case {
            var k = 0
            while k < s.param_count {
                let p = self.params[s.param_first + k]
                try! out.push(p.ty)
                k = k + 1
            }
        }
        move out
    }

    // Declaration `d`, which is on a containment cycle, refused with the
    // members that lead from its storage to an instance of itself: the
    // shortest such path, so the search ends however the graph branches. The
    // declarations the path crosses are reported with it.
    func refuse_infinite(&var self, d: Int, reported: &var Vector<Bool>) {
        let start = self.self_type_of(d)
        var types = Vector<Int>()
        var parents = Vector<Int>()
        var crossed = Vector<Int>()
        var seen = tc_memo()
        try! types.push(start)
        try! parents.push(-1)
        try! crossed.push(-1)
        let _ = seen.mark(start, 0)
        var found = -1
        var head = 0
        while head < types.len() && found < 0 {
            let at = head
            head = head + 1
            let t = types[at]
            let info = self.types.ty(t)
            var parts = Vector<Int>()
            var through = Vector<Int>()
            if info.kind == TcKind.Array {
                try! parts.push(info.b)
                try! through.push(-1)
            } else if info.kind == TcKind.Tuple || (info.kind == TcKind.Nominal && (info.decl == self.known.optional || info.decl == self.known.result) && self.res.decls[info.decl].node < 0) {
                var k = 0
                while k < info.count {
                    try! parts.push(self.types.arg(t, k))
                    try! through.push(-1)
                    k = k + 1
                }
            } else if info.kind == TcKind.Nominal && self.res.decls[info.decl].node >= 0 {
                let arguments = self.nominal_args(t)
                let subst = tc_args_subst(info.decl, move arguments)
                let members = self.members_of(info.decl)
                var k = 0
                while k < members.len() {
                    let m = members[k]
                    let inline = self.inline_parts(m)
                    var j = 0
                    while j < inline.len() {
                        try! parts.push(self.subst(inline[j], &subst))
                        try! through.push(m)
                        j = j + 1
                    }
                    k = k + 1
                }
            }
            var k = 0
            while k < parts.len() && found < 0 {
                let part = parts[k]
                let pi = self.types.ty(part)
                if pi.kind == TcKind.Nominal && pi.decl == d {
                    found = types.len()
                }
                if found >= 0 || seen.mark(part, 0) {
                    try! types.push(part)
                    try! parents.push(at)
                    try! crossed.push(through[k])
                }
                k = k + 1
            }
        }
        var path = Vector<Int>()
        var at = found
        while at > 0 {
            if crossed[at] >= 0 {
                try! path.push(crossed[at])
            }
            at = parents[at]
        }
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("recursive type `")
        try! msg.append(self.res.decl_path(d))
        if found >= 0 && types[found] == start {
            try! msg.append("` has infinite size: its storage contains its own storage inline")
        } else if found >= 0 {
            try! msg.append("` has infinite size: its inline storage instantiates it again, as `")
            try! msg.append(self.type_text(types[found]))
            try! msg.append("`, and so on without end")
        } else {
            try! msg.append("` has infinite size: its storage contains an instance of itself inline")
        }
        if path.len() > 0 {
            try! msg.append(", through ")
            var k = path.len() - 1
            while k >= 0 {
                try! msg.append(self.res.decl_path(path[k]))
                try! msg.append(" -> ")
                let parent = self.res.decls[path[k]].parent
                if parent >= 0 {
                    reported[parent] = true
                }
                k = k - 1
            }
            try! msg.append(self.res.decl_path(d))
        }
        reported[d] = true
        try! msg.append("; hold the recursive member behind a heap indirection, such as `Box` or `Vector`")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "type.infinite-size", msg.build())
    }
}

// What an `init` returns, and `Deinit`'s conformances.
extension TcProgram {
    // An `init` returns its receiver, or `Result<Receiver, E>`; an optional
    // is refused on its own terms, since a `None` names no cause (spec,
    // "What an init may return").
    public func check_inits(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Init || info.node < 0 {
                continue
            }
            let s = self.sigs[d - 1]
            if (s.flags & TC_FLAG_WRITTEN_RETURN) == 0 || self.has_error_type(s.result) {
                continue
            }
            let receiver = self.init_receiver(d - 1)
            if receiver < 0 || s.result == receiver {
                continue
            }
            let r = self.types.ty(s.result)
            if r.kind == TcKind.Nominal && r.decl == self.known.result && self.types.arg(s.result, 0) == receiver {
                continue
            }
            var msg = StringBuilder()
            if r.kind == TcKind.Nominal && r.decl == self.known.optional {
                try! msg.append("an `init` may not return an optional: an optional creation is `Result<")
                try! msg.append(self.type_text(receiver))
                try! msg.append(", E>`, because a `None` names no cause")
            } else {
                try! msg.append("an `init` returns its receiver, `")
                try! msg.append(self.type_text(receiver))
                try! msg.append("`, or `Result<")
                try! msg.append(self.type_text(receiver))
                try! msg.append(", E>`, and this one returns `")
                try! msg.append(self.type_text(s.result))
                try! msg.append("`")
            }
            let site = self.decl_site(d - 1)
            self.refuse_in(info.module, site, "init.result", msg.build())
        }
    }

    // The receiver an `init` builds: its extension's type, applied to the
    // extension's parameters.
    func init_receiver(&var self, d: Int) -> Int {
        let info = self.res.decls[d]
        if info.parent < 0 {
            return -1
        }
        let target = self.ext_target(info.parent)
        if target < 0 {
            return -1
        }
        self.self_type_of(target)
    }

    func has_error_type(&self, t: Int) -> Bool {
        if t < 0 {
            return true
        }
        let info = self.types.ty(t)
        info.kind == TcKind.Error
    }

    // `Deinit` is never conformed to directly: a hand-written body goes in
    // the type's copy policy (design 131).
    public func check_deinit_conformances(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.trait_decl != self.known.deinit {
                continue
            }
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.res.decl_path(c.type_decl))
            try! msg.append("` conforms to `Deinit` directly, and `Deinit` takes no conformance: a hand-written `deinit` goes in the type's copy policy, `NoCopy`, `ExplicitCopy` or `Copy`")
            self.refuse_in(c.module, c.node, "conformance.deinit", msg.build())
        }
    }

    // A hand-written `deinit` goes in the extension that declares the type's
    // copy policy (spec, The Deinit trait). Written in any other extension it
    // would be an ordinary method that no scope exit calls.
    public func check_deinit_placement(&var self) {
        let name = self.res.intern("deinit")
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Method || info.name != name || info.parent < 0 || info.leaf < 0 {
                continue
            }
            let ext = info.parent
            if self.res.decls[ext].kind != ResDeclKind.Extension || self.declares_policy(ext) {
                continue
            }
            let target = self.ext_target(ext)
            var msg = StringBuilder()
            try! msg.append("this `deinit` is written in an extension that declares no copy policy, where no scope exit calls it: write it inside ")
            if target >= 0 {
                try! msg.append("`")
                try! msg.append(self.res.decl_path(target))
                try! msg.append("`'s")
            } else {
                try! msg.append("the type's")
            }
            try! msg.append(" `NoCopy`, `ExplicitCopy` or `Copy` conformance")
            self.refuse_in(info.module, info.leaf, "deinit.outside-policy", msg.build())
        }
    }

    // Whether extension `ext` declares a copy policy, or `Deinit`, which
    // `conformance.deinit` refuses on its own.
    public func declares_policy(&var self, ext: Int) -> Bool {
        let deinit = self.known.deinit
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.ext != ext {
                continue
            }
            if c.trait_decl == self.known.copy || self.trait_refines(c.trait_decl, deinit) {
                return true
            }
        }
        false
    }
}

// The signature half of `unsafe`.
extension TcProgram {
    public func check_unsafe(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            let callable = info.kind == ResDeclKind.Func || info.kind == ResDeclKind.Method || info.kind == ResDeclKind.Init || info.kind == ResDeclKind.Requirement
            if callable && info.node >= 0 {
                self.check_declared_unsafe(d)
            } else if info.kind == ResDeclKind.Struct && info.node >= 0 {
                self.check_unsafe_name(d)
            }
            d = d + 1
        }
        var k = 0
        while k < self.func_nodes.len() {
            let node = self.func_nodes[k]
            self.check_function_type(node)
            k = k + 1
        }
    }

    // The unsafe type `t` names: itself, or one among its arguments, elements,
    // referent, parameters or result; -1 for none. A type is never unsafe for
    // what its own fields hold.
    public func unsafe_named(&self, t: Int) -> Int {
        var seen = tc_memo()
        self.unsafe_named_in(t, &var seen)
    }

    // One part of `unsafe_named`'s walk. A part met again was searched in
    // full the first time and named nothing.
    func unsafe_named_in(&self, t: Int, seen: &var TcMemo) -> Int {
        if t < 0 || not seen.mark(t, 0) {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Nominal && self.is_unsafe_decl(info.decl) {
            return t
        }
        if info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array || info.kind == TcKind.Func {
            let inner = self.unsafe_named_in(info.b, &var seen)
            if inner >= 0 {
                return inner
            }
        }
        if info.kind == TcKind.Nominal || info.kind == TcKind.Tuple || info.kind == TcKind.Func {
            var k = 0
            while k < info.count {
                let arg = self.types.arg(t, k)
                let found = self.unsafe_named_in(arg, &var seen)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
        }
        return -1
    }

    // A function whose signature names an unsafe type, through a parameter,
    // its result or its receiver, declares `unsafe` in its effect slot.
    func check_declared_unsafe(&var self, d: Int) {
        let s = self.sigs[d]
        if (s.effects & TC_EFFECT_UNSAFE) != 0 {
            return
        }
        var found = -1
        var k = 0
        while k < s.param_count && found < 0 {
            let p = self.params[s.param_first + k]
            found = self.unsafe_named(p.ty)
            k = k + 1
        }
        if found < 0 && s.result >= 0 {
            found = self.unsafe_named(s.result)
        }
        let info = self.res.decls[d]
        if found < 0 && s.receiver != TcReceiver.Absent && info.parent >= 0 {
            let target = self.ext_target(info.parent)
            if target >= 0 && self.is_unsafe_decl(target) {
                found = self.self_type_of(target)
            }
        }
        if found < 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` is not declared `unsafe`, but its signature names a value of unsafe type (`")
        try! msg.append(self.type_text(found))
        try! msg.append("`): write `unsafe` after its parameter list, where every caller can see it")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "unsafe.undeclared", msg.build())
    }

    // A function type says `unsafe` exactly when a parameter or its result
    // names an unsafe type, judged on the type as written.
    func check_function_type(&var self, node: Int) {
        let t = self.node_types[node]
        if t < 0 {
            return
        }
        let info = self.types.ty(t)
        if info.kind != TcKind.Func {
            return
        }
        let declared = (info.a & TC_EFFECT_UNSAFE) != 0
        let named = self.unsafe_named(t)
        let m = self.node_module(node)
        if named >= 0 && not declared {
            var msg = StringBuilder()
            try! msg.append("the function type `")
            try! msg.append(self.type_text(t))
            try! msg.append("` names an unsafe type (`")
            try! msg.append(self.type_text(named))
            try! msg.append("`) but its effect slot does not say `unsafe`")
            self.refuse_in(m, node, "unsafe.function-type", msg.build())
        } else if named < 0 && declared {
            var msg = StringBuilder()
            try! msg.append("the function type `")
            try! msg.append(self.type_text(t))
            try! msg.append("` declares `unsafe` but its signature names no unsafe type: a function taking only safe types must be sound for every input")
            self.refuse_in(m, node, "unsafe.function-type", msg.build())
        }
    }

    // An `unsafe struct` is named `Unsafe*`, so its unsafety shows wherever it
    // is named.
    func check_unsafe_name(&var self, d: Int) {
        let s = self.sigs[d]
        if (s.flags & TC_FLAG_UNSAFE_STRUCT) == 0 {
            return
        }
        let info = self.res.decls[d]
        let name = self.name_text(info.name)
        if name.starts_with("Unsafe") {
            return
        }
        var msg = StringBuilder()
        try! msg.append("an unsafe type must be named `Unsafe*`, but this one is named `")
        try! msg.append(name)
        try! msg.append("`: rename it to `Unsafe")
        try! msg.append(name)
        try! msg.append("`, or drop `unsafe` if the type is safe to name, hold and pass")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "unsafe.type-name", msg.build())
    }

    // The module whose arena range holds node `id`.
    public func node_module(&self, id: Int) -> Int {
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && id >= info.node_base && id < info.node_base + info.node_count {
                return m
            }
            m = m + 1
        }
        return -1
    }
}

// The atomic role's width rule (SL:open-questions D38): v1 atomics are
// `Atomic<Int>` only, since their operations are the `i64` intrinsics. Each
// `Atomic<X>` formed at another `X` (`narrow_atomics`) is refused once, where
// a position first carries exactly it, or else where one first carries a type
// holding it. One formed only by monomorphization is mono's to refuse.
public func tc_check_atomic_widths(p: &var TcProgram) {
    var k = 0
    while k < p.narrow_atomics.len() {
        let t = p.narrow_atomics[k]
        k = k + 1
        // A written type first, then an expression; exactly the type
        // first, then one holding it.
        var at = tc_first_carrier(&var p, false, t, true)
        if at < 0 {
            at = tc_first_carrier(&var p, true, t, true)
        }
        if at < 0 {
            at = tc_first_carrier(&var p, false, t, false)
        }
        if at < 0 {
            at = tc_first_carrier(&var p, true, t, false)
        }
        if at >= 0 {
            p.refuse_narrow_atomic(at, t)
            p.narrow_reported[k - 1] = true
        }
    }
}

// The first node whose written type, or with `expressions` whose
// expression's type, is `t`, or, unless `exact`, holds it; -1 when none is.
func tc_first_carrier(p: &var TcProgram, expressions: Bool, t: Int, exact: Bool) -> Int {
    let count = if expressions { p.expr_types.len() } else { p.node_types.len() }
    var n = 0
    while n < count {
        let carried = if expressions { p.expr_types[n] } else { p.node_types[n] }
        if carried == t || (not exact && carried >= 0 && p.type_holds(carried, t)) {
            return n
        }
        n = n + 1
    }
    return -1
}

extension TcProgram {
    public func refuse_narrow_atomic(&var self, at: Int, t: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` is not an atomic this compiler lowers: v1 atomics are `Atomic<Int>` only")
        let m = self.node_module(at)
        self.refuse_in(m, at, "atomic.width", msg.build())
    }
}
