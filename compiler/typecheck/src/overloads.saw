// The declaration-site overload rule: a declaration that no call could tell
// apart from an earlier one of its overload set is refused where it is
// written, so a call never meets two equal candidates and a member no call
// names, a `deinit` or a policy's `copy()`, has one body (spec, Overloading).
// A struct's memberwise construction is a member of its `init` set that no
// declaration writes, so the `init`s that meet it are judged here too.

// For the extension writing `is_doc`.
import sawresolve.collect.{res_is_top_level}
import sawresolve.dump.{res_sort_strings}
import sawresolve.imports.{res_decl_binding}
import sawresolve.model.{ResDeclKind}
import sawtypecheck.candidates.{TcOverrideFault}
import sawtypecheck.checks.{tc_check_inits}
import sawtypecheck.conform.{tc_check_copy_policies}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.members.{tc_build_members}
import sawtypecheck.model.{TC_EFFECT_BORROWS, TC_EFFECT_BORROWS_SYNC, TC_EFFECT_CONSTEXPR, TC_EFFECT_CONSUMES,
                               TC_EFFECT_UNSAFE, TC_FLAG_STATIC, TcSig}
import sawtypecheck.program.{TcProgram}
// For the extension writing `ext_self_type` and `extensions_disjoint`.
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.tier.{tc_max}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// Every overload set's indistinguishable redeclarations.
public func tc_check_redeclarations(p: &var TcProgram) {
    p.check_redeclarations()
}

extension TcProgram {
    // Every overload set, each handed to the funnel once: a module's free
    // functions of one name, the methods of one name and the `init`s one
    // module's extensions give a type, and a trait's requirements of one
    // name. A set is per module, since two modules' declarations meet only
    // at a call that sees both, which refuses an ambiguity there.
    public func check_redeclarations(&var self) {
        self.check_function_sets()
        self.check_member_sets()
        self.check_requirement_sets()
    }

    func check_function_sets(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            d = d + 1
            if info.kind != ResDeclKind.Func || info.parent >= 0 {
                continue
            }
            var newest = Vector<Int>()
            var at = self.res.top.first(info.module, info.name)
            while at >= 0 {
                let other = self.res.top.value(at)
                if self.res.decls[other].kind == ResDeclKind.Func {
                    try! newest.push(other)
                }
                at = self.res.top.following(at)
            }
            // The chain is newest first, so a set is checked once, from the
            // declaration that ends it.
            if newest.len() < 2 || newest[newest.len() - 1] != d - 1 {
                continue
            }
            var set = Vector<Int>()
            var k = newest.len() - 1
            while k >= 0 {
                try! set.push(newest[k])
                k = k - 1
            }
            self.refuse_indistinguishable(&set)
        }
    }

    func check_member_sets(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            if self.is_nominal(d) {
                self.check_members_of(d)
            }
            d = d + 1
        }
    }

    // The methods and `init`s every extension of type `d` writes, split into
    // sets by module, kind and name.
    func check_members_of(&var self, d: Int) {
        let exts = self.extensions_in_order(d)
        var written = Vector<Int>()
        var k = 0
        while k < exts.len() {
            let listed = self.members_of(exts[k])
            var j = 0
            while j < listed.len() {
                let m = listed[j]
                let kind = self.res.decls[m].kind
                if kind == ResDeclKind.Method || kind == ResDeclKind.Init {
                    try! written.push(m)
                }
                j = j + 1
            }
            k = k + 1
        }
        self.refuse_in_sets(&written)
        if self.is_struct_decl(d) {
            self.check_construction_inits(d, &written)
        }
    }

    // The `init`s among `written` that meet struct `d`'s memberwise
    // construction, the one member of its set no declaration writes: one
    // matching the fields exactly overrides it, where the override rule
    // allows (`override_fault`), and any other sharing a call shape with it
    // is refused as a redeclaration, in a module that sees every field
    // (SL-648).
    func check_construction_inits(&var self, d: Int, written: &Vector<Int>) {
        var k = 0
        while k < written.len() {
            let m = written[k]
            k = k + 1
            if self.res.decls[m].kind != ResDeclKind.Init {
                continue
            }
            if self.matches_fields(m) {
                match self.override_fault(m) {
                    case Accepted -> {},
                    case OutsideModule -> self.refuse_override_outside(m, d),
                    case TestOnly -> self.refuse_override_test_only(m, d),
                    case Bounded -> self.refuse_override_bounded(m, d),
                    case Specialized -> self.refuse_override_specialized(m, d)
                }
                continue
            }
            let viewer = self.res.decls[m].module
            if self.shares_field_shape(m, d) && self.sees_fields(d, viewer) {
                self.refuse_beside_memberwise(m, d)
            }
        }
    }

    // Whether one of `init` `m`'s call shapes binds struct `d`'s fields: its
    // first parameters, as many as the fields, are theirs in some order, each
    // of the same label and type with every type parameter one placeholder,
    // and the rest are defaulted. A field's type is read as `m`'s extension
    // sees it (`ext_field_type`).
    func shares_field_shape(&var self, m: Int, d: Int) -> Bool {
        self.build_decl(m)
        let s = self.sigs[m]
        let fields = self.field_list(d)
        let arity = fields.len()
        if arity > s.param_count || self.required_count(&s) > arity {
            return false
        }
        let ext = self.res.decls[m].parent
        var k = 0
        while k < arity {
            let f = fields[k]
            k = k + 1
            let name = self.res.decls[f].name
            let ty = self.ext_field_type(ext, f)
            var found = false
            var j = 0
            while j < arity && not found {
                let p = self.params[s.param_first + j]
                found = p.name == name && self.same_shape_type(p.ty, ty)
                j = j + 1
            }
            if not found {
                return false
            }
        }
        true
    }

    // Whether code in module `viewer` sees every field of struct `d`, so that
    // its memberwise construction is callable there.
    func sees_fields(&self, d: Int, viewer: Int) -> Bool {
        let fields = self.field_list(d)
        let owner = self.res.decls[d].module
        var k = 0
        while k < fields.len() {
            let info = self.res.decls[fields[k]]
            if not self.res.visible_to(info.vis, owner, viewer) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Struct `d`'s fields, in declaration order.
    func field_list(&self, d: Int) -> Vector<Int> {
        let members = self.members_of(d)
        var out = Vector<Int>()
        var k = 0
        while k < members.len() {
            if self.res.decls[members[k]].kind == ResDeclKind.Field {
                try! out.push(members[k])
            }
            k = k + 1
        }
        move out
    }

    func refuse_override_outside(&var self, m: Int, d: Int) {
        let info = self.res.decls[m]
        let owner = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(m))
        try! msg.append("` matches the fields of `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` exactly, so it would override `")
        try! msg.append(self.construction_text(d))
        try! msg.append("` in every module, and only `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`'s own module `")
        try! msg.append(self.res.module_name(owner.module))
        try! msg.append("` may change what its construction means: give this `init` another label, or write the override there")
        let site = self.decl_site(m)
        self.refuse_in(info.module, site, "init.override-outside-module", msg.build())
    }

    func refuse_override_test_only(&var self, m: Int, d: Int) {
        let info = self.res.decls[m]
        var msg = StringBuilder()
        try! msg.append("a test-only override of a production type's construction is refused: test code cannot change what `")
        try! msg.append(self.construction_text(d))
        try! msg.append("` means in production code; write it in production code, or make the type test-only too")
        let site = self.decl_site(m)
        self.refuse_in(info.module, site, "init.override-test-only", msg.build())
    }

    func refuse_override_bounded(&var self, m: Int, d: Int) {
        let info = self.res.decls[m]
        let ext = info.parent
        let index = self.bounded_parameter(ext)
        let s = self.sigs[ext]
        let g = self.generics[s.generic_first + index]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(m))
        try! msg.append("` matches the fields of `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` exactly, so it would override `")
        try! msg.append(self.construction_text(d))
        try! msg.append("`, but its extension declares it only where `")
        try! msg.append(self.name_text(g.name))
        try! msg.append("` is `")
        let bound = self.traits[g.bound_first]
        try! msg.append(self.res.decl_path(bound))
        try! msg.append("`, which would give one generic construction two meanings, chosen per instantiation: write the override in an extension with no bounds, `extension ")
        try! msg.append(self.unbounded_head(d, ext))
        try! msg.append("`, or give this `init` another label")
        let site = self.decl_site(m)
        self.refuse_in(info.module, site, "init.override-bounded", msg.build())
    }

    func refuse_override_specialized(&var self, m: Int, d: Int) {
        let info = self.res.decls[m]
        let own = self.ext_self_type(info.parent)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(m))
        try! msg.append("` matches the fields of `")
        try! msg.append(self.type_text(own))
        try! msg.append("` exactly, so it would override `")
        try! msg.append(self.construction_text(d))
        try! msg.append("`, but its specialized extension declares it for `")
        try! msg.append(self.type_text(own))
        try! msg.append("` alone, which would give one generic construction two meanings, chosen per instantiation: write the override in an extension for every instantiation, `extension ")
        try! msg.append(self.unbounded_head(d, d))
        try! msg.append("`, or give this `init` another label")
        let site = self.decl_site(m)
        self.refuse_in(info.module, site, "init.override-specialized", msg.build())
    }

    func refuse_beside_memberwise(&var self, m: Int, d: Int) {
        let info = self.res.decls[m]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(m))
        try! msg.append("` takes the call `")
        try! msg.append(self.construction_text(d))
        try! msg.append("`, which is `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`'s memberwise construction, and no call could tell the two apart: give it another label or a parameter without a default, or write the `init` that takes the fields exactly, which overrides the construction")
        let site = self.decl_site(m)
        self.refuse_in(info.module, site, "overload.indistinguishable", msg.build())
    }

    // Struct `d`'s construction as a call names it: `Port(value:)`.
    func construction_text(&self, d: Int) -> String {
        let fields = self.field_list(d)
        var out = StringBuilder()
        try! out.append(self.res.decl_path(d))
        try! out.append("(")
        var k = 0
        while k < fields.len() {
            let name = self.res.decls[fields[k]].name
            try! out.append(self.name_text(name))
            try! out.append(":")
            k = k + 1
        }
        try! out.append(")")
        out.build()
    }

    // Extension `ext`'s head on type `d` without its bounds: `Wrap<T>`.
    func unbounded_head(&self, d: Int, ext: Int) -> String {
        let s = self.sigs[ext]
        var out = StringBuilder()
        try! out.append(self.res.decl_path(d))
        if s.generic_count > 0 {
            try! out.append("<")
            var k = 0
            while k < s.generic_count {
                if k > 0 {
                    try! out.append(", ")
                }
                let name = self.generics[s.generic_first + k].name
                try! out.append(self.name_text(name))
                k = k + 1
            }
            try! out.append(">")
        }
        out.build()
    }

    func check_requirement_sets(&var self) {
        var t = 0
        while t < self.res.decls.len() {
            if self.res.decls[t].kind == ResDeclKind.Trait {
                let listed = self.members_of(t)
                var reqs = Vector<Int>()
                var k = 0
                while k < listed.len() {
                    let m = listed[k]
                    if self.res.decls[m].kind == ResDeclKind.Requirement {
                        try! reqs.push(m)
                    }
                    k = k + 1
                }
                self.refuse_in_sets(&reqs)
            }
            t = t + 1
        }
    }

    // Declarations `decls`, in declaration order, split into the sets that
    // share a module, a kind and a name, each set handed to the funnel.
    func refuse_in_sets(&var self, decls: &Vector<Int>) {
        var taken = Vector<Bool>()
        var k = 0
        while k < decls.len() {
            try! taken.push(false)
            k = k + 1
        }
        var i = 0
        while i < decls.len() {
            if taken[i] {
                i = i + 1
                continue
            }
            let first = self.res.decls[decls[i]]
            var set = Vector<Int>()
            try! set.push(decls[i])
            var j = i + 1
            while j < decls.len() {
                let other = self.res.decls[decls[j]]
                let same = other.module == first.module && other.kind == first.kind && other.name == first.name
                if not taken[j] && same {
                    try! set.push(decls[j])
                    taken[j] = true
                }
                j = j + 1
            }
            if set.len() > 1 {
                self.refuse_indistinguishable(&set)
            }
            i = i + 1
        }
    }

    // THE REDECLARATION FUNNEL: overload set `set`, in declaration order,
    // each declaration after the first refused, once, when it is
    // indistinguishable from an earlier one. A `copy()` or a `deinit` that
    // its placement rule refuses on its own is left to that rule. A default
    // and a `blocking` declaration that no call tells apart are a pair
    // instead, matched by `match_blocking_twin` (spec, Pairs).
    //
    // ENTRY POINTS:
    //     check_function_sets
    //     refuse_in_sets
    func refuse_indistinguishable(&var self, set: &Vector<Int>) {
        var j = 1
        while j < set.len() {
            let later = set[j]
            j = j + 1
            if self.placed_elsewhere(later) {
                continue
            }
            var i = 0
            while i < j - 1 {
                let earlier = set[i]
                i = i + 1
                if not self.placed_elsewhere(earlier) && self.indistinguishable(earlier, later) {
                    if self.pairs_with(earlier, later) {
                        self.match_blocking_twin(earlier, later)
                    } else {
                        self.refuse_redeclaration(later, earlier)
                    }
                    break
                }
            }
        }
    }

    // Whether indistinguishable declarations `a` and `b` are a pair's default
    // and twin: exactly one is `blocking`, neither is a trait requirement,
    // which takes no `blocking` at all, and neither is paired already, so a
    // second twin is a redeclaration.
    func pairs_with(&var self, a: Int, b: Int) -> Bool {
        let blocking_a = self.declares_blocking(a)
        let blocking_b = self.declares_blocking(b)
        if blocking_a == blocking_b {
            return false
        }
        let req = ResDeclKind.Requirement
        if self.res.decls[a].kind == req || self.res.decls[b].kind == req {
            return false
        }
        let free = self.blocking_twins[a] < 0 && self.pair_defaults[a] < 0
        free && self.blocking_twins[b] < 0 && self.pair_defaults[b] < 0
    }

    // THE PAIR FUNNEL: indistinguishable declarations `a` and `b`, one of them
    // `blocking`, recorded as a default and its twin (spec, Pairs). The twin
    // directly follows its default in one scope and repeats its signature,
    // or it is refused, once, naming the first difference. The pair is kept
    // either way, so no call sees the twin as a candidate.
    func match_blocking_twin(&var self, a: Int, b: Int) {
        let twin = if self.declares_blocking(a) { a } else { b }
        let def = if twin == a { b } else { a }
        self.blocking_twins[def] = twin
        self.pair_defaults[twin] = def
        if not self.twin_follows(def, twin) {
            self.refuse_twin(def, twin, "must be the declaration directly after it, in the same extension block, struct body or top level, with nothing between them but blank lines and comments: move it to directly follow `")
            return
        }
        let what = self.twin_difference(def, twin)
        if what.len() > 0 {
            self.refuse_twin(def, twin, what)
            return
        }
        if self.carries_doc(twin) {
            self.refuse_twin(def, twin, "carries a `///` comment, and a pair has one, on its default, describing both bodies: move the comment to `")
        }
    }

    // What `twin`'s signature does not repeat of `def`'s, as the refusal
    // words it, or "" when it repeats all of it.
    func twin_difference(&var self, def: Int, twin: Int) -> String {
        let sd = self.sigs[def]
        let st = self.sigs[twin]
        if (sd.flags & TC_FLAG_STATIC) != (st.flags & TC_FLAG_STATIC) {
            return "differs in `static`; a twin repeats its default's signature exactly: make it agree with `"
        }
        if sd.receiver != st.receiver {
            return "takes another receiver; a twin repeats its default's signature exactly: give it the receiver of `"
        }
        if self.res.decls[def].vis != self.res.decls[twin].vis {
            return "has another visibility; a twin repeats its default's signature exactly: give it the visibility of `"
        }
        if (sd.effects & TC_EFFECT_UNSAFE) != (st.effects & TC_EFFECT_UNSAFE) {
            return "differs in `unsafe`; a twin repeats its default's signature exactly: give it the effects of `"
        }
        let rest = TC_EFFECT_CONSUMES | TC_EFFECT_BORROWS | TC_EFFECT_BORROWS_SYNC | TC_EFFECT_CONSTEXPR
        if (sd.effects & rest) != (st.effects & rest) {
            return "has other effects; a twin repeats its default's signature exactly: give it the effects of `"
        }
        if not self.same_twin_generics(def, twin) {
            return "has other generic parameters or bounds; a twin repeats its default's signature exactly: give it the generic parameters and bounds of `"
        }
        if sd.param_count != st.param_count {
            return "takes other parameters; a twin repeats its default's signature exactly: give it the parameters of `"
        }
        var k = 0
        while k < st.param_count {
            let pd = self.params[sd.param_first + k]
            let pt = self.params[st.param_first + k]
            k = k + 1
            if pt.has_default {
                return "gives a parameter a default value, which a call evaluates from the default's declaration, so a twin writes none: delete it, and keep the one on `"
            }
            if pd.name != pt.name || not self.same_twin_type(pd.ty, pt.ty, def, twin) {
                return "takes other parameters; a twin repeats its default's signature exactly: give it the parameters of `"
            }
        }
        if not self.same_twin_type(sd.result, st.result, def, twin) {
            return "returns another type; a twin repeats its default's signature exactly: give it the return type of `"
        }
        ""
    }

    // Whether `def` and `twin` declare the same generic parameters, by name,
    // kind and bounds, in order.
    func same_twin_generics(&var self, def: Int, twin: Int) -> Bool {
        self.ensure_generics(def)
        self.ensure_generics(twin)
        let sd = self.sigs[def]
        let st = self.sigs[twin]
        if sd.generic_count != st.generic_count {
            return false
        }
        var k = 0
        while k < sd.generic_count {
            let gd = self.generics[sd.generic_first + k]
            let gt = self.generics[st.generic_first + k]
            k = k + 1
            if gd.name != gt.name || gd.is_const != gt.is_const || gd.bound_count != gt.bound_count {
                return false
            }
            var j = 0
            while j < gd.bound_count {
                if self.traits[gd.bound_first + j] != self.traits[gt.bound_first + j] {
                    return false
                }
                j = j + 1
            }
        }
        true
    }

    // Whether types `x` of `def`'s signature and `y` of `twin`'s are one
    // type, each function's own type parameter read as the other's of its
    // index.
    func same_twin_type(&self, x: Int, y: Int, def: Int, twin: Int) -> Bool {
        if x == y {
            return true
        }
        if x < 0 || y < 0 {
            return false
        }
        let a = self.types.ty(x)
        let b = self.types.ty(y)
        if a.kind == TcKind.Param && b.kind == TcKind.Param {
            return a.a == b.a && a.decl == def && b.decl == twin
        }
        if a.kind != b.kind || a.decl != b.decl || a.a != b.a || a.count != b.count || a.labeled != b.labeled {
            return false
        }
        if a.b != b.b && not self.same_twin_type(a.b, b.b, def, twin) {
            return false
        }
        var k = 0
        while k < a.count {
            if a.labeled && self.types.label(x, k) != self.types.label(y, k) {
                return false
            }
            let part_x = self.types.arg(x, k)
            let part_y = self.types.arg(y, k)
            if not self.same_twin_type(part_x, part_y, def, twin) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether `twin` is the declaration directly after `def` in their scope:
    // the two are neighbouring items of one extension block, or of the top
    // level of one module.
    func twin_follows(&self, def: Int, twin: Int) -> Bool {
        let di = self.res.decls[def]
        let ti = self.res.decls[twin]
        if di.parent != ti.parent || di.module != ti.module {
            return false
        }
        let scope = if di.parent >= 0 { self.res.decls[di.parent].node } else { self.res.modules[di.module].root }
        if scope < 0 {
            return false
        }
        let at_def = self.scope_item_holding(scope, di.outer)
        let at_twin = self.scope_item_holding(scope, ti.outer)
        at_def >= 0 && at_twin == at_def + 1
    }

    // The index, among the node children of `scope`, of the one whose span
    // holds node `id`, or -1.
    func scope_item_holding(&self, scope: Int, id: Int) -> Int {
        let target = self.res.nodes[id]
        var index = 0
        let n = self.child_count(scope)
        var k = 0
        while k < n {
            let c = self.child(scope, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            let item = self.res.nodes[c]
            if item.start <= target.start && target.end <= item.end {
                return index
            }
            index = index + 1
        }
        return -1
    }

    // Whether declaration `d` carries a `///` comment.
    func carries_doc(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        self.holds_doc(info.outer) || self.holds_doc(info.node)
    }

    func holds_doc(&self, id: Int) -> Bool {
        if id < 0 {
            return false
        }
        let n = self.child_count(id)
        var k = 0
        while k < n {
            let c = self.child(id, k)
            if self.res.is_doc(c) {
                return true
            }
            k = k + 1
        }
        false
    }

    // `twin` refused as `def`'s twin: `what`, which ends opening a quote,
    // then `def`'s name.
    func refuse_twin(&var self, def: Int, twin: Int, what: String) {
        let first = self.res.decls[def]
        let site = self.decl_site(def)
        let node = self.res.nodes[site]
        let position = self.res.position_text(first.module, node.start)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(twin))
        try! msg.append(" blocking` is the `blocking` twin of `")
        try! msg.append(self.overload_text(def))
        try! msg.append("` at ")
        try! msg.append(position)
        try! msg.append(", and ")
        try! msg.append(what)
        try! msg.append(self.res.decl_path(def))
        try! msg.append("`")
        let info = self.res.decls[twin]
        let leaf = self.decl_site(twin)
        self.refuse_in(info.module, leaf, "effect.blocking-twin", msg.build())
    }

    // Whether member `d` is a `copy()` or a `deinit` written outside its
    // type's copy policy, which `copy.outside-policy` or
    // `deinit.outside-policy` refuses.
    func placed_elsewhere(&var self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if info.kind != ResDeclKind.Method || info.parent < 0 {
            return false
        }
        let deinit_name = self.res.intern("deinit")
        if info.name == deinit_name {
            let ext = info.parent
            return self.res.decls[ext].kind == ResDeclKind.Extension && not self.declares_policy(ext)
        }
        self.is_stray_copy(d)
    }

    // Whether declarations `a` and `b` share a call shape: each declaration's
    // shapes are its parameter lists from the full one down to the one that
    // ends before its first defaulted parameter, and two shapes are one when
    // they bind parameters of the same labels and types, each type parameter
    // read as one placeholder (spec, Default parameter values). A function's
    // labels bind in order and an `init`'s by name in any order (spec,
    // Labeled arguments), so an `init`'s shapes compare as sets. A
    // signature's aliases are already their targets. A `borrows` member is
    // called only as a `borrow` head, so it never meets a plain one, and two
    // whose receivers differ are the shared and exclusive twins `borrow let`
    // and `borrow var` choose between (SL:borrowing §3, §4). Two members of
    // extensions no type shares, specializations at different arguments,
    // never meet at a call (`extensions_disjoint`). Otherwise the result, the
    // effects, the receiver and staticness never tell two apart.
    func indistinguishable(&var self, a: Int, b: Int) -> Bool {
        let parent_a = self.res.decls[a].parent
        let parent_b = self.res.decls[b].parent
        if self.extensions_disjoint(parent_a, parent_b) {
            return false
        }
        self.build_decl(a)
        self.build_decl(b)
        let sa = self.sigs[a]
        let sb = self.sigs[b]
        let lending = TC_EFFECT_BORROWS | TC_EFFECT_BORROWS_SYNC
        let lends_a = (sa.effects & lending) != 0
        let lends_b = (sb.effects & lending) != 0
        if lends_a != lends_b || (lends_a && sa.receiver != sb.receiver) {
            return false
        }
        let by_name = self.res.decls[a].kind == ResDeclKind.Init
        var arity = tc_max(self.required_count(&sa), self.required_count(&sb))
        while arity <= sa.param_count && arity <= sb.param_count {
            if by_name && self.same_shape_set(&sa, &sb, arity) {
                return true
            }
            if not by_name {
                return self.same_shape_prefix(&sa, &sb, arity)
            }
            arity = arity + 1
        }
        false
    }

    // Whether the first `arity` parameters of `sa` and `sb` agree in order,
    // label and type. A prefix that agrees is a part of every longer one
    // that does, so the shortest shared arity decides.
    func same_shape_prefix(&self, sa: &TcSig, sb: &TcSig, arity: Int) -> Bool {
        var k = 0
        while k < arity {
            let pa = self.params[sa.param_first + k]
            let pb = self.params[sb.param_first + k]
            if pa.name != pb.name || not self.same_shape_type(pa.ty, pb.ty) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether the first `arity` parameters of `sa` are those of `sb` in some
    // order, each of the same label and type. Labels are distinct within a
    // declaration, so one direction of the match is enough.
    func same_shape_set(&self, sa: &TcSig, sb: &TcSig, arity: Int) -> Bool {
        var k = 0
        while k < arity {
            let p = self.params[sa.param_first + k]
            var found = false
            var j = 0
            while j < arity && not found {
                let q = self.params[sb.param_first + j]
                found = q.name == p.name && self.same_shape_type(p.ty, q.ty)
                j = j + 1
            }
            if not found {
                return false
            }
            k = k + 1
        }
        true
    }

    // The parameters of `s` before its first defaulted one.
    func required_count(&self, s: &TcSig) -> Int {
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if p.has_default {
                return k
            }
            k = k + 1
        }
        s.param_count
    }

    // Whether types `x` and `y` are one type once every type parameter in
    // them is the same placeholder. A type that could not be formed is
    // refused elsewhere, and matches nothing here.
    func same_shape_type(&self, x: Int, y: Int) -> Bool {
        if x < 0 || y < 0 {
            return false
        }
        let a = self.types.ty(x)
        let b = self.types.ty(y)
        if a.kind == TcKind.Error || b.kind == TcKind.Error {
            return false
        }
        if x == y {
            return true
        }
        if a.kind == TcKind.Param && b.kind == TcKind.Param {
            return true
        }
        if a.kind != b.kind || a.decl != b.decl || a.a != b.a || a.count != b.count || a.labeled != b.labeled {
            return false
        }
        if a.b != b.b && not self.same_shape_type(a.b, b.b) {
            return false
        }
        var k = 0
        while k < a.count {
            if a.labeled && self.types.label(x, k) != self.types.label(y, k) {
                return false
            }
            let ax = self.types.arg(x, k)
            let by = self.types.arg(y, k)
            if not self.same_shape_type(ax, by) {
                return false
            }
            k = k + 1
        }
        true
    }

    func refuse_redeclaration(&var self, later: Int, earlier: Int) {
        let info = self.res.decls[later]
        let first = self.res.decls[earlier]
        let site = self.decl_site(earlier)
        let node = self.res.nodes[site]
        let position = self.res.position_text(first.module, node.start)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.overload_text(later))
        try! msg.append("` is already declared at ")
        try! msg.append(position)
        try! msg.append(" as `")
        try! msg.append(self.overload_text(earlier))
        try! msg.append("`, and no call could tell the two apart: overloads must differ in a parameter's label or type, or in how many arguments they take, reading aliases as their targets and every type parameter as one, with a defaulted parameter's shorter calls counted; the result, effects, receiver and staticness never tell two apart")
        let leaf = self.decl_site(later)
        self.refuse_in(info.module, leaf, "overload.indistinguishable", msg.build())
    }

    // Declaration `d` as a call would name it: its path and its labeled
    // parameter types.
    public func overload_text(&var self, d: Int) -> String {
        let s = self.sigs[d]
        var out = StringBuilder()
        try! out.append(self.res.decl_path(d))
        try! out.append("(")
        var k = 0
        while k < s.param_count {
            if k > 0 {
                try! out.append(", ")
            }
            let p = self.params[s.param_first + k]
            try! out.append(self.name_text(p.name))
            try! out.append(": ")
            try! out.append(self.type_text(p.ty))
            k = k + 1
        }
        try! out.append(")")
        out.build()
    }
}
