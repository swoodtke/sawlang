// One signature per declaration kind. Each builder reads its declaration's
// node and records the types its positions denote through `build_type`, so
// the node table is complete for every signature once the pass is done.

import sawparse.grammar.{Alt}
import sawparse.tree.{is_body_node}
import sawresolve.collect.{res_is_top_level}
import sawresolve.dump.{res_sort_strings}
import sawresolve.kinds.{res_is_type_alt}
import sawresolve.lang.{ResLang}
import sawresolve.layer.{FrontLayer}
import sawresolve.model.{ResBindKind, ResDecl, ResDeclKind, ResImportForm, ResModule}
import sawtypecheck.model.{TC_EFFECT_BORROWS, TC_EFFECT_BORROWS_SYNC, TC_FLAG_BLOCKING, TC_FLAG_BORROWS_STRUCT,
                               TC_FLAG_DEFAULT_BODY, TC_FLAG_DERIVED_TWIN, TC_FLAG_STATIC, TC_FLAG_SYNTHESIZE,
                               TC_FLAG_SYNTHESIZE_SHARED, TC_FLAG_UNSAFE_STRUCT, TC_FLAG_UNSAFE_VAR,
                               TC_FLAG_VARIADIC, TC_FLAG_WRITTEN_RETURN, TcHeadKind, TcLend,
                               TcParam, TcReceiver, TcSig}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{tc_effect_bit}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.types.{TcKind, TcType}

// Every declaration's signature of `layer`'s modules.
public func tc_build_signatures(p: &var TcProgram, layer: &FrontLayer) {
    p.build_signatures(&layer)
}

static TC_STATE_BUILDING: Int = 3
static TC_STATE_BUILT: Int = 4

extension TcProgram {
    // Every declaration's signature, modules in load order and declarations
    // in source order, which is the order types are interned in.
    public func build_signatures(&var self, layer: &FrontLayer) {
        var m = layer.module_first
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available {
                var d = info.decl_first
                while d < info.decl_first + info.decl_count {
                    self.build_decl(d)
                    d = d + 1
                }
            }
            m = m + 1
        }
    }

    // Declaration `d`'s signature, built once.
    public func build_decl(&var self, d: Int) {
        let s = self.sigs[d]
        if s.state >= TC_STATE_BUILDING {
            return
        }
        self.ensure_generics(d)
        var marked = self.sigs[d]
        marked.state = TC_STATE_BUILDING
        self.sigs[d] = marked
        let saved = self.save_context()
        self.enter_decl(d)
        let info = self.res.decls[d]
        // A synthetic builtin has no node: its parameters are all it has.
        let kind = if info.node < 0 { ResDeclKind.Primitive } else { info.kind }
        match kind {
            case Struct -> self.build_struct(d),
            case Enum -> self.build_enum(d),
            case Case -> self.build_case(d),
            case Field -> self.build_field(d),
            case Trait -> self.build_trait(d),
            case Alias -> self.build_alias(d),
            case Static -> self.build_static(d),
            case Func -> self.build_function(d),
            case Method -> self.build_function(d),
            case Init -> self.build_function(d),
            case Requirement -> self.build_function(d),
            case InitRequirement -> self.build_function(d),
            case Extern -> self.build_extern(d),
            case Extension -> self.build_extension(d),
            case TypeAssign -> self.build_type_assign(d),
            case _ -> {}
        }
        var done = self.sigs[d]
        done.state = TC_STATE_BUILT
        self.sigs[d] = done
        self.restore_context(saved)
    }

    func set_result(&var self, d: Int, t: Int) {
        var s = self.sigs[d]
        s.result = t
        self.sigs[d] = s
    }

    func add_flags(&var self, d: Int, flags: Int) {
        var s = self.sigs[d]
        s.flags = s.flags | flags
        self.sigs[d] = s
    }

    // The type `Void`, a function's result when it writes none.
    public func void_type(&var self) -> Int {
        let none = Vector<Int>()
        let d = self.known.void_type
        self.mk_nominal(d, &none)
    }

    // The words that open node `id`'s children before its first child node.
    func leading_words(&self, m: Int, id: Int) -> Vector<String> {
        var out = Vector<String>()
        let n = self.child_count(id)
        var k = 0
        while k < n {
            let c = self.child(id, k)
            if not self.is_leaf(c) {
                break
            }
            try! out.push(self.text(m, c))
            k = k + 1
        }
        move out
    }

    func build_struct(&var self, d: Int) {
        let info = self.res.decls[d]
        let words = self.leading_words(info.module, info.node)
        var flags = 0
        var k = 0
        while k < words.len() {
            let word = words.get(k) ?? ""
            if word.equals("unsafe") {
                flags = flags | TC_FLAG_UNSAFE_STRUCT
            } else if word.equals("borrows") {
                flags = flags | TC_FLAG_BORROWS_STRUCT
            }
            k = k + 1
        }
        self.add_flags(d, flags)
    }

    // An enum's raw backing type, as its result.
    func build_enum(&var self, d: Int) {
        let info = self.res.decls[d]
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if not self.is_leaf(c) && res_is_type_alt(self.node_alt(c)) {
                let t = self.build_type(c)
                self.set_result(d, t)
            }
            k = k + 1
        }
    }

    // A case's payload fields, as parameters.
    func build_case(&var self, d: Int) {
        let info = self.res.decls[d]
        let first = self.params.len()
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if self.has_alt(c, Alt.Decl_PayloadField) {
                let leaf = self.res.first_leaf(c)
                let text = self.text(info.module, leaf)
                let name = self.res.intern(text)
                let inner = self.res.last_node_child(c)
                let t = self.build_type(inner)
                try! self.params.push(TcParam(name: name, leaf: leaf, ty: t, has_default: false, escaping: false))
            }
            k = k + 1
        }
        var s = self.sigs[d]
        s.param_first = first
        s.param_count = self.params.len() - first
        self.sigs[d] = s
    }

    func build_field(&var self, d: Int) {
        let info = self.res.decls[d]
        let inner = self.res.last_node_child(info.node)
        let t = self.build_type(inner)
        self.set_result(d, t)
    }

    // A trait's parents.
    func build_trait(&var self, d: Int) {
        let info = self.res.decls[d]
        let first = self.traits.len()
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if self.has_alt(c, Alt.Type_Path) {
                let t = self.trait_of_path(c)
                if t >= 0 {
                    try! self.traits.push(t)
                }
            }
            k = k + 1
        }
        var s = self.sigs[d]
        s.trait_first = first
        s.trait_count = self.traits.len() - first
        self.sigs[d] = s
    }

    // An alias's type, which the type funnel resolves once, whichever reaches
    // it first: a use, or the declaration. An alias of an enum, a prelude
    // `Optional` or `Result` in any spelling included, is refused here, once
    // per alias at its own declaration (SL-1012).
    func build_alias(&var self, d: Int) {
        let t = self.alias_type(d, -1)
        if t < 0 || self.types.ty(t).kind != TcKind.Nominal {
            return
        }
        if self.res.decls[self.types.ty(t).decl].kind != ResDeclKind.Enum {
            return
        }
        let info = self.res.decls[d]
        let shown: String = self.name_text(self.res.decls[self.types.ty(t).decl].name)
        var msg = StringBuilder()
        try! msg.append("type alias `")
        try! msg.append(self.text(info.module, info.leaf))
        try! msg.append("` names the enum `")
        try! msg.append(shown)
        try! msg.append("`")
        let middle = self.alias_written_through(d)
        if middle != "" {
            try! msg.append(" (through `")
            try! msg.append(middle)
            try! msg.append("`)")
        }
        try! msg.append(", and an alias of an enum is not allowed: use `")
        try! msg.append(shown)
        try! msg.append("` itself, or wrap it in a struct you own")
        self.refuse_in(info.module, info.node, "type.alias-of-enum", msg.build())
    }

    // The name written for the alias that alias `d`'s written type is
    // (`type Step = Rank`), else "".
    func alias_written_through(&self, d: Int) -> String {
        let info = self.res.decls[d]
        let inner = self.res.last_node_child(info.node)
        if inner < 0 {
            return ""
        }
        if let alt = self.node_alt(inner) {
            if alt != Alt.Type_Named {
                return ""
            }
        } else {
            return ""
        }
        let path = self.child(inner, 0)
        let leaf = self.child(path, self.child_count(path) - 1)
        let b = self.binding_at(leaf)
        match b.kind {
            case Decl -> {
                if b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Alias {
                    return self.text(info.module, leaf)
                }
                ""
            },
            case _ -> ""
        }
    }

    func build_static(&var self, d: Int) {
        let info = self.res.decls[d]
        if self.has_alt(info.node, Alt.Decl_Static_UnsafeVar) {
            self.add_flags(d, TC_FLAG_UNSAFE_VAR)
        }
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if not self.is_leaf(c) && res_is_type_alt(self.node_alt(c)) {
                let t = self.build_type(c)
                self.set_result(d, t)
                return
            }
            k = k + 1
        }
    }

    func build_type_assign(&var self, d: Int) {
        let _ = self.alias_type(d, -1)
    }

    // A function, method, init, requirement or init requirement: its
    // receiver, parameters, effects and result, and what a `borrows` result
    // lends. An `init` or init requirement with no result produces `Self`.
    func build_function(&var self, d: Int) {
        let info = self.res.decls[d]
        let node = info.node
        let m = info.module
        let first = self.params.len()
        var effects = 0
        var flags = 0
        var result = -1
        var root_decl = -1
        var receiver = TcReceiver.Absent
        if info.flag && info.kind != ResDeclKind.Init {
            flags = flags | TC_FLAG_STATIC
        }
        let name_end = self.name_end(d)
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            let child_node = self.res.node(c)
            if is_body_node(&child_node) {
                if info.kind == ResDeclKind.Requirement {
                    flags = flags | TC_FLAG_DEFAULT_BODY
                }
            } else if self.is_leaf(c) {
                if k > name_end {
                    let word = self.text(m, c)
                    effects = tc_effect_bit(effects, &word)
                }
            } else if self.has_alt(c, Alt.Decl_BorrowsRoot) {
                // The root's first segment names a static of this module; its
                // field hops and every rule on it are judged once all
                // signatures stand (`check_borrows_root`). (SL-1156)
                effects = effects | TC_EFFECT_BORROWS
                let parts = self.res.child_count(c)
                var j = 0
                while j < parts {
                    let part = self.res.child(c, j)
                    j = j + 1
                    if self.is_leaf(part) {
                        effects = effects | TC_EFFECT_BORROWS_SYNC
                    } else {
                        let head = self.res.first_leaf(part)
                        root_decl = self.top_decl(m, self.text(m, head))
                    }
                }
            } else if self.has_alt(c, Alt.Decl_Param_Receiver) {
                let r = self.res.first_node_child(c)
                receiver = if self.has_alt(r, Alt.Decl_Receiver_Exclusive) { TcReceiver.Exclusive } else { TcReceiver.Shared }
            } else if self.has_alt(c, Alt.Decl_Param_Plain) || self.has_alt(c, Alt.Decl_Param_Default) {
                let leaf = self.res.first_leaf(c)
                let text = self.text(m, leaf)
                let name = self.res.intern(text)
                let type_node = self.res.first_node_child(c)
                let written = self.build_param_type(type_node)
                let escaping = self.says_escaping(written)
                let t = self.strip_escaping(written)
                let has_default = self.has_alt(c, Alt.Decl_Param_Default)
                try! self.params.push(TcParam(name: name, leaf: leaf, ty: t, has_default: has_default, escaping: escaping))
            } else if res_is_type_alt(self.node_alt(c)) {
                result = self.build_type(c)
                flags = flags | TC_FLAG_WRITTEN_RETURN
            }
            k = k + 1
        }
        if result < 0 {
            if info.kind == ResDeclKind.Init || info.kind == ResDeclKind.InitRequirement {
                result = self.current_self
            } else {
                result = self.void_type()
            }
        }
        if self.has_alt(info.outer, Alt.Decl_ExtensionMember_SynthesizedMethod) {
            flags = flags | TC_FLAG_SYNTHESIZE_SHARED
        }
        if self.res.twin_accessor(d) >= 0 {
            flags = flags | TC_FLAG_DERIVED_TWIN
        }
        if info.kind == ResDeclKind.Requirement && self.sigs[d].generic_count > 0 {
            self.refuse_generic_requirement(d)
        }
        var s = self.sigs[d]
        s.param_first = first
        s.param_count = self.params.len() - first
        s.receiver = receiver
        s.effects = effects
        s.flags = s.flags | flags
        s.result = result
        s.root_decl = root_decl
        if (effects & TC_EFFECT_BORROWS) != 0 {
            s.lending = self.lend_kind(result)
            s.lending_exclusive = self.lend_is_exclusive(result)
        }
        self.sigs[d] = s
    }

    // The grammar parses generic parameters on a trait requirement, and type
    // checking refuses them, once, at the requirement: the signature is still
    // built whole, so its conformances, default body and calls through a bound
    // add no second refusal (GRAMMAR §3.4).
    func refuse_generic_requirement(&var self, d: Int) {
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("trait requirement `")
        try! msg.append(self.text(info.module, info.leaf))
        try! msg.append("` declares generic parameters: generic trait requirements are not supported yet")
        self.refuse(info.leaf, "trait.generic-requirement", msg.build())
    }

    // The index among `d`'s node's children of the last token of its name,
    // which syntax.decl.method-name spells as an identifier, `[]` or `[]=`;
    // -1 for an `init`, which has none. Effect words are leaves after it.
    func name_end(&self, d: Int) -> Int {
        let info = self.res.decls[d]
        if info.leaf < 0 || info.kind == ResDeclKind.Init || info.kind == ResDeclKind.InitRequirement {
            return -1
        }
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            if self.child(info.node, k) == info.leaf {
                let written = self.text(info.module, info.leaf)
                if not written.equals("[") {
                    return k
                }
                var end = k
                var j = k + 1
                while j < n && j <= k + 2 {
                    let c = self.child(info.node, j)
                    if not self.is_leaf(c) {
                        return end
                    }
                    let text = self.text(info.module, c)
                    if text.equals("]") || (text.equals("=") && j == k + 2) {
                        end = j
                    } else {
                        return end
                    }
                    j = j + 1
                }
                return end
            }
            k = k + 1
        }
        return -1
    }

    // The accessor-signature reader (SL:architecture §3.4): what a `borrows`
    // result lends. `&T?` is `Ref(Optional(T))` and `&[T]?` is
    // `Optional(Slice(T))`; both are a conditional lend here, and only here,
    // so a parameter's `&var T?` stays a reference to an optional.
    public func lend_kind(&self, result: Int) -> TcLend {
        let info = self.types.ty(result)
        if info.kind == TcKind.Ref {
            let inner = self.types.ty(info.b)
            if inner.kind == TcKind.Nominal && inner.decl == self.known.optional {
                return TcLend.ConditionalPlace
            }
            return TcLend.Place
        }
        if info.kind == TcKind.Slice {
            return TcLend.Slice
        }
        if info.kind == TcKind.Nominal && info.decl == self.known.optional {
            let payload = self.types.arg(result, 0)
            let inner = self.types.ty(payload)
            if inner.kind == TcKind.Slice {
                return TcLend.ConditionalSlice
            }
        }
        if info.kind == TcKind.Nominal && self.is_borrows_struct(info.decl) {
            return TcLend.BorrowingStruct
        }
        TcLend.Other
    }

    // Whether `borrows` declaration `d` names no lendable result, the
    // bare `borrows -> T` that `borrows.result` refuses at the declaration;
    // a use through it reports nothing more, so one bad declaration is one
    // error. An accessor in an interface module is never one, since its
    // declaration is not checked here. (SL-916)
    public func lend_refused(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        let s = self.sigs[d]
        (s.effects & TC_EFFECT_BORROWS) != 0 && s.lending == TcLend.Other && not self.is_interface(self.res.decls[d].module)
    }

    // Whether what a `borrows` result lends is writable: `&var T`, `&var T?`
    // or `&var [T]`.
    public func lend_is_exclusive(&self, result: Int) -> Bool {
        let info = self.types.ty(result)
        if info.kind == TcKind.Ref || info.kind == TcKind.Slice {
            return info.a == 1
        }
        if info.kind == TcKind.Nominal && info.decl == self.known.optional {
            let payload = self.types.arg(result, 0)
            let inner = self.types.ty(payload)
            if inner.kind == TcKind.Slice {
                return inner.a == 1
            }
        }
        false
    }

    // Whether struct `d` is declared `borrows struct`, read off its head so
    // the answer does not wait on the order signatures are built in.
    public func is_borrows_struct(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if info.kind != ResDeclKind.Struct || info.node < 0 {
            return false
        }
        let words = self.leading_words(info.module, info.node)
        var k = 0
        while k < words.len() {
            let word = words.get(k) ?? ""
            if word.equals("borrows") {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether nominal `d` is an unsafe type: `unsafe struct`, or a raw pointer.
    public func is_unsafe_decl(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        if d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer {
            return true
        }
        let info = self.res.decls[d]
        if info.kind != ResDeclKind.Struct || info.node < 0 {
            return false
        }
        let words = self.leading_words(info.module, info.node)
        var k = 0
        while k < words.len() {
            let word = words.get(k) ?? ""
            if word.equals("unsafe") {
                return true
            }
            k = k + 1
        }
        false
    }

    func build_extern(&var self, d: Int) {
        let info = self.res.decls[d]
        let node = info.node
        let m = info.module
        let first = self.params.len()
        var flags = 0
        if self.has_alt(node, Alt.Decl_ExternFunc_Blocking) {
            flags = flags | TC_FLAG_BLOCKING
        }
        var result = -1
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            if self.is_leaf(c) {
                let word = self.text(m, c)
                if word.equals("...") {
                    flags = flags | TC_FLAG_VARIADIC
                }
            } else if self.has_alt(c, Alt.Decl_ExternParam) || self.has_alt(c, Alt.Decl_Param_Plain) {
                let leaf = self.res.first_leaf(c)
                let text = self.text(m, leaf)
                let name = self.res.intern(text)
                let type_node = self.res.last_node_child(c)
                let t = self.build_type(type_node)
                try! self.params.push(TcParam(name: name, leaf: leaf, ty: t, has_default: false, escaping: false))
            } else if res_is_type_alt(self.node_alt(c)) {
                result = self.build_type(c)
                flags = flags | TC_FLAG_WRITTEN_RETURN
            }
            k = k + 1
        }
        if result < 0 {
            result = self.void_type()
        }
        var s = self.sigs[d]
        s.param_first = first
        s.param_count = self.params.len() - first
        s.flags = s.flags | flags
        s.result = result
        self.sigs[d] = s
    }

    // An extension: the type it extends applied to its parameters, as its
    // result, and its conformances. Its parameters' bounds are the conditions
    // its members and conformances hold under.
    func build_extension(&var self, d: Int) {
        let info = self.res.decls[d]
        let node = info.node
        let head = self.res.first_node_child(node)
        let target = self.ext_target(d)
        if target < 0 && head >= 0 {
            let leaf = self.res.last_leaf_of(head)
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Decl && b.decl >= 0 {
                if self.res.decls[b.decl].kind == ResDeclKind.Alias {
                    self.refuse_extension_alias(leaf, b.decl)
                } else {
                    self.not_in_slice(head, Alt.Decl_Extension)
                }
            }
        }
        if target >= 0 {
            self.check_extension_head(d, head, target)
        }
        let first = self.traits.len()
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            if c != head && self.has_alt(c, Alt.Type_Path) {
                let t = self.trait_of_path(c)
                if t >= 0 {
                    try! self.traits.push(t)
                }
            }
            k = k + 1
        }
        var s = self.sigs[d]
        s.trait_first = first
        s.trait_count = self.traits.len() - first
        s.result = if target >= 0 { self.current_self } else { self.error_type }
        if self.res.decl_attribute(d, Alt.Attr_Attribute_Synthesize) >= 0 {
            s.flags = s.flags | TC_FLAG_SYNTHESIZE
        }
        self.sigs[d] = s
    }

    // An extension, or a conformance, written on alias `a`: an alias is a
    // distinct type with no members of its own, so there is nothing for the
    // extension to attach to. Refused once, at the head; the extension has no
    // target, so its members are never registered or checked. An alias
    // already refused at its declaration (a cycle, an enum) draws no second
    // refusal. (SL-1012)
    func refuse_extension_alias(&var self, leaf: Int, a: Int) {
        let parent = self.alias_type(a, -1)
        let of: String = self.written_text(parent)
        var bottom = parent
        while bottom >= 0 && self.types.ty(bottom).alias >= 0 {
            bottom = self.alias_type(self.types.ty(bottom).alias, -1)
        }
        if bottom < 0 || self.types.ty(bottom).kind == TcKind.Error {
            return
        }
        if self.types.ty(bottom).kind == TcKind.Nominal && self.res.decls[self.types.ty(bottom).decl].kind == ResDeclKind.Enum {
            return
        }
        let under: String = self.extension_spelling(bottom)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(self.current, leaf))
        try! msg.append("` is an alias of `")
        try! msg.append(of)
        try! msg.append("`, and an alias carries no members of its own: ")
        if under != "" {
            try! msg.append("extend `")
            try! msg.append(under)
            try! msg.append("`, or ")
        }
        try! msg.append("declare a struct that wraps it")
        self.refuse(leaf, "extension.alias", msg.build())
    }

    // The type an extension head can name, spelled as this module's source
    // writes it; "" for a kind that takes no extension. ENTRY POINTS:
    // written_text (any type), extension_spelling, append_written_type,
    // written_decl_name.
    public func written_text(&var self, t: Int) -> String {
        var out = StringBuilder()
        self.append_written_type(&var out, t)
        out.build()
    }

    func extension_spelling(&var self, t: Int) -> String {
        let info = self.types.ty(t)
        if info.kind != TcKind.Nominal || info.decl == self.known.optional {
            return ""
        }
        var out = StringBuilder()
        self.append_written_type(&var out, t)
        out.build()
    }

    // `t` as a head in this module writes it: nominal names as the module's
    // scope reaches them, defaulted trailing arguments left out.
    func append_written_type(&var self, out: &var StringBuilder, t: Int) {
        let info = self.types.ty(t)
        if info.alias >= 0 {
            try! out.append(self.written_decl_name(info.alias))
            return
        }
        if info.kind != TcKind.Nominal || (info.decl == self.known.optional && info.count == 1) {
            self.append_type(&var out, t)
            return
        }
        try! out.append(self.written_decl_name(info.decl))
        var count = info.count
        if count > 0 {
            self.ensure_generics(info.decl)
            let s = self.sigs[info.decl]
            while count > 0 && count <= s.generic_count {
                let g = self.generics[s.generic_first + count - 1]
                if g.default_type < 0 || g.default_type != self.types.arg(t, count - 1) {
                    break
                }
                count = count - 1
            }
        }
        if count == 0 {
            return
        }
        try! out.append("<")
        var k = 0
        while k < count {
            if k > 0 {
                try! out.append(", ")
            }
            self.append_written_type(&var out, self.types.arg(t, k))
            k = k + 1
        }
        try! out.append(">")
    }

    // Declaration `d` as this module's source names it: its path when the
    // module declares it, binds it bare or the language prints it bare; else
    // behind the qualifier a whole-module import of its module binds; else its
    // identity.
    func written_decl_name(&self, d: Int) -> String {
        let decl = self.res.decls[d]
        if self.res.prints_bare(d) || decl.module == self.current {
            return self.res.decl_path(d)
        }
        if decl.parent < 0 && self.head_named_decl(self.current, decl.name) == d {
            return self.res.decl_path(d)
        }
        var k = 0
        while k < self.res.imports.len() {
            let imp = self.res.imports[k]
            k = k + 1
            if imp.module == self.current && imp.form == ResImportForm.Qualifier && imp.target == decl.module && imp.qualifier >= 0 {
                var out = StringBuilder()
                try! out.append(self.name_text(imp.qualifier))
                try! out.append(".")
                try! out.append(self.res.decl_path(d))
                return out.build()
            }
        }
        self.res.decl_identity(d)
    }

    // An extension head's parameters rename its type's, or, in a specialized
    // extension, name the types its members are for. A specialized head names
    // a type for every parameter it writes and leaves out only defaulted ones,
    // which it fills (SL:open-questions D14); one that names a type for some
    // parameters and renames others is refused, since the spec leaves a
    // generic specialized extension planned. A pure rename that leaves out a
    // defaulted parameter is refused with the head written out, since filling
    // the default would specialize it instead (D14); any other count is an
    // arity error.
    func check_extension_head(&var self, d: Int, head: Int, target: Int) {
        self.ensure_generics(target)
        let written = self.sigs[d]
        let wanted = self.sigs[target]
        if written.generic_count == 0 {
            return
        }
        let leaf = self.res.last_leaf_of(head)
        let kind = self.head_kind(d)
        if kind == TcHeadKind.Partial {
            self.refuse_partial_specialization(d, leaf)
            let node = self.res.decls[d].node
            try! self.skipped.push(node)
            return
        }
        if written.generic_count > wanted.generic_count {
            self.refuse_extension_arity(leaf, written.generic_count, wanted.generic_count)
            return
        }
        var k = written.generic_count
        while k < wanted.generic_count {
            let g = self.generics[wanted.generic_first + k]
            if g.default_type < 0 {
                self.refuse_extension_arity(leaf, written.generic_count, wanted.generic_count)
                return
            }
            k = k + 1
        }
        if kind == TcHeadKind.Specialized || written.generic_count == wanted.generic_count {
            return
        }
        self.refuse_default_omitted(d, leaf, target)
    }

    // A head naming a type for some parameters and renaming others: the spec
    // leaves a generic specialized extension planned.
    func refuse_partial_specialization(&var self, d: Int, leaf: Int) {
        let m = self.current
        let s = self.sigs[d]
        var named = ""
        var renamed = ""
        var k = 0
        while k < s.generic_count {
            let g = self.generics[s.generic_first + k]
            k = k + 1
            if self.head_named_decl(m, g.name) >= 0 && named.len() == 0 {
                named = self.name_text(g.name)
            } else if self.head_named_decl(m, g.name) < 0 && renamed.len() == 0 {
                renamed = self.name_text(g.name)
            }
        }
        var msg = StringBuilder()
        try! msg.append("`extension ")
        try! msg.append(self.text(m, leaf))
        try! msg.append("<...>` names the type `")
        try! msg.append(named)
        try! msg.append("` and keeps `")
        try! msg.append(renamed)
        try! msg.append("` a parameter: an extension specialized in some parameters and generic in others is planned (spec, Type Extensions); specialize every parameter, or write the extension for every instantiation")
        self.refuse(leaf, "extension.partial-specialization", msg.build())
    }

    public func is_alias_decl(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        info.kind == ResDeclKind.Alias
    }

    // D14's refusal, with the head written out: the written names, then each
    // omitted parameter with its bounds.
    func refuse_default_omitted(&var self, d: Int, leaf: Int, target: Int) {
        let m = self.current
        let written = self.sigs[d]
        let wanted = self.sigs[target]
        var head = StringBuilder()
        try! head.append("extension ")
        try! head.append(self.text(m, leaf))
        try! head.append("<")
        var omitted = StringBuilder()
        var k = 0
        while k < wanted.generic_count {
            if k > 0 {
                try! head.append(", ")
            }
            if k < written.generic_count {
                let g = self.generics[written.generic_first + k]
                try! head.append(self.name_text(g.name))
            } else {
                let g = self.generics[wanted.generic_first + k]
                if k > written.generic_count {
                    try! omitted.append(", ")
                }
                try! omitted.append("`")
                try! omitted.append(self.name_text(g.name))
                try! omitted.append("`")
                try! head.append(self.name_text(g.name))
                var j = 0
                while j < g.bound_count {
                    if j == 0 {
                        try! head.append(": ")
                    } else {
                        try! head.append(" + ")
                    }
                    let bound = self.traits[g.bound_first + j]
                    let bound_name = self.res.decls[bound].name
                    try! head.append(self.name_text(bound_name))
                    j = j + 1
                }
            }
            k = k + 1
        }
        try! head.append(">")
        var msg = StringBuilder()
        try! msg.append("this extension head leaves out ")
        try! msg.append(omitted.build())
        try! msg.append(", which has a default: filling it would specialize the extension, and leaving it would rename a parameter the head does not name; write it out, as `")
        try! msg.append(head.build())
        try! msg.append("`")
        self.refuse(leaf, "extension.default-omitted", msg.build())
    }

    func refuse_extension_arity(&var self, leaf: Int, written: Int, wanted: Int) {
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("an extension of `")
        try! msg.append(self.text(m, leaf))
        try! msg.append("` renames its ")
        try! msg.append(wanted)
        try! msg.append(" type parameters, and ")
        try! msg.append(written)
        try! msg.append(" are written")
        self.refuse(leaf, "type.arity", msg.build())
    }
}
