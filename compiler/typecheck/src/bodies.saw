// The body half of type checking (SL:architecture §3.4, "Type inference is
// local and bidirectional"): every body is checked against signatures only,
// and its results go into side tables keyed by resolve's node ids, never
// onto the tree. Per expression: its type, its adjustment chain, whether it
// is a place, and how its position reads it; per call, operator, subscript
// and loop head: what it calls, at what instantiation.
//
// One module holds the whole walk, since statements, expressions, calls and
// patterns recurse into each other and modules may not import in a cycle.
// This file is the position matrix of compiler/tests/typecheck/README.md: one
// method per kind of position, each dispatching on the alternatives GRAMMAR.md
// builds there. A construct outside the bootstrap slice is refused by name
// (`not_in_slice`), and nothing under it is checked.
//
// The walk recurses only into a node's children, so its depth is the tree's
// height, which the parser's depth funnel bounds.

import sawparse.src.grammar.{Alt, alt_name}
import sawparse.src.tree.{AstNode, NodeShape}
import sawresolve.src.collect.{res_is_top_level}
import sawresolve.src.dump.{res_sort_strings}
import sawresolve.src.imports.{res_decl_binding}
import sawresolve.src.kinds.{res_is_statement_alt, res_is_type_alt}
import sawresolve.src.model.{ResBindKind, ResBinding, ResCall, ResCallClass, ResDecl, ResDeclKind,
                             ResModule, ResModuleKind}
import sawtypecheck.src.adjust.{TC_FIT_AMBIGUOUS, TC_FIT_CONVERTED, TC_FIT_EXACT, TC_FIT_NONE,
                                TC_PEEL_AMBIGUOUS, TC_PEEL_NONE}
import sawtypecheck.src.candidates.{tc_contains}
import sawtypecheck.src.checks.{tc_check_unsafe}
import sawtypecheck.src.conform.{TcSubst, tc_args_subst, tc_copy_ints, tc_extension_sets}
import sawtypecheck.src.declarations.{tc_build_signatures}
import sawtypecheck.src.fold.{TcFold, tc_fold_step}
import sawtypecheck.src.infer.{TcSolve, tc_solve}
import sawtypecheck.src.members.{tc_build_members}
import sawtypecheck.src.model.{TC_ANY_DEPTH, TC_EFFECT_BORROWS, TC_EFFECT_CONSUMES, TC_FLAG_STATIC, TC_FLAG_UNSAFE_VAR, TC_FLAG_VARIADIC,
                               TC_TIER_NOCOPY, TcAdjust, TcAdjustKind, TcAllowance, TcCall, TcLend, TcMember, TcParam, TcReceiver,
                               TcRole, TcSig, TcSource, TcUse}
import sawtypecheck.src.program.{TcProgram}
import sawtypecheck.src.signatures.{TcContext}
import sawtypecheck.src.spell.{tc_effects_text}
import sawtypecheck.src.tier.{tc_tier}
import sawtypecheck.src.typeops.{TcClient}
import sawtypecheck.src.types.{TcKind, TcType}

// Checks every body of every module checked in full.
public func tc_check_bodies(p: &var TcProgram) {
    p.check_bodies()
}

// A position that expects a value but names no type.
static TC_WANT_NONE: Int = -1
// A statement: the value is discarded, and a block's last expression is no
// tail.
static TC_WANT_STMT: Int = -2
// The kinds of operator a flat chain may hold.
static TC_OPS_ARITHMETIC: Int = 1
static TC_OPS_INTEGRAL: Int = 2
static TC_OPS_LOGICAL: Int = 4
static TC_INT_MAX: Int = 9223372036854775807

// The positions the expected-type funnel serves, which its refusals name.
public enum TcPosition {
    case Let,
    case Static,
    case Assign,
    case Argument,
    case Field,
    case Default,
    case Return,
    case Tail,
    case Branch,
    case Payload,
    case Compound,
    case Element,
    case ClosureTail,
    case Operand,
    case Coalesce
}

// Which funnel entry a block's tail goes through.
public enum TcTail {
    case Body,
    case Branch,
    case Closure,
    case Plain
}

// What a pattern's value comes from: a place, whose parts a binding copies,
// or an owned temporary, whose parts it takes.
public enum TcOrigin {
    // A place, whose part a binding copies out (design 131, the place rule).
    case Place,
    // An owned temporary, whose parts the bindings take.
    case Temporary,
    // An owned local a `match` consumes: each binding owns its part.
    case Owned,
    // A borrowed scrutinee, a field or a receiver: each binding aliases its
    // part.
    case Borrowed
}

extension TcProgram {
    // Sizes the side tables, then checks each body of each module that is
    // not an interface, and settles what each place's use decides.
    public func check_bodies(&var self) {
        let n = self.res.nodes.len()
        var k = 0
        while k < n {
            try! self.expr_types.push(-1)
            try! self.typed_count.push(0)
            try! self.expr_place.push(false)
            try! self.expr_use.push(TcUse.Unused)
            try! self.adj_head.push(-1)
            try! self.adj_tail.push(-1)
            try! self.call_at.push(-1)
            try! self.local_types.push(-1)
            try! self.res_call_at.push(-1)
            k = k + 1
        }
        k = 0
        while k < self.res.calls.len() {
            let c = self.res.calls[k]
            self.res_call_at[c.node] = k
            k = k + 1
        }
        let visible = tc_extension_sets(&self)
        self.ext_visible = move visible
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && not info.interface_only {
                self.check_module_bodies(m)
            }
            m = m + 1
        }
        self.settle_places()
    }

    func check_module_bodies(&var self, m: Int) {
        let info = self.res.modules[m]
        var d = info.decl_first
        while d < info.decl_first + info.decl_count {
            self.check_decl_body(d)
            d = d + 1
        }
        let root = info.root
        let n = self.child_count(root)
        var k = 0
        while k < n {
            let item = self.child(root, k)
            self.check_item_body(m, item)
            k = k + 1
        }
    }

    // The bodies at the top of a file that belong to no declaration: a
    // `static_assert`'s condition and a test case's block.
    func check_item_body(&var self, m: Int, item: Int) {
        guard let alt = self.node_alt(item) else {
            return
        }
        if alt == Alt.Decl_StaticAssert {
            self.enter_module(m)
            let c = self.res.first_node_child(item)
            self.begin_body(-1, c)
            self.check_condition(c)
        } else if alt == Alt.Test_Case_Run || alt == Alt.Test_Case_Panics || alt == Alt.Test_Case_Warns {
            self.enter_module(m)
            let body = self.res.last_node_child(item)
            self.begin_body(-1, body)
            self.body_result = self.void_type()
            let _ = self.check_block(body, TC_WANT_STMT, TcTail.Plain)
        } else if alt == Alt.Test_Group {
            let n = self.child_count(item)
            var k = 0
            while k < n {
                let sub = self.child(item, k)
                self.check_item_body(m, sub)
                k = k + 1
            }
        }
    }

    // Enters module `m` outside any declaration.
    func enter_module(&var self, m: Int) {
        self.current = m
        self.current_decl = -1
        self.current_trait = -1
        self.current_ext = -1
        self.current_self = -1
    }

    // Records `root` as a body of declaration `d`, for the dump and the
    // verifier, and resets what the walk tracks per body.
    func begin_body(&var self, d: Int, root: Int) {
        try! self.body_roots.push(root)
        try! self.body_decls.push(d)
        self.loop_breaks = Vector<Int>()
        self.current_root = root
    }

    // Marks the body being checked poisoned when `t`, a type a signature
    // gave it, could not be formed: the refusal that says why belongs to the
    // signature's module.
    public func poison_if(&var self, t: Int) {
        if t >= 0 && not self.has_error(t) {
            return
        }
        let root = self.current_root
        if root >= 0 && not tc_contains(&self.poisoned, root) {
            try! self.poisoned.push(root)
        }
    }

    // Declaration `d`'s bodies: a function's parameter defaults and block, a
    // static's initializer, a case's raw value.
    func check_decl_body(&var self, d: Int) {
        let info = self.res.decls[d]
        if info.node < 0 || self.in_refused_extension(d) {
            return
        }
        let saved = self.save_context()
        self.enter_decl(d)
        match info.kind {
            case Func -> self.check_function_body(d),
            case Method -> self.check_function_body(d),
            case Init -> self.check_function_body(d),
            case Requirement -> self.check_function_body(d),
            case Static -> self.check_static_body(d),
            case Case -> self.check_raw_value(d),
            case _ -> {}
        }
        self.check_align_attribute(d)
        self.restore_context(saved)
    }

    // Whether declaration `d` is a member of an extension refused as outside
    // the slice, whose parameters mean nothing a body could be checked by.
    func in_refused_extension(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if info.parent < 0 {
            return false
        }
        let parent = self.res.decls[info.parent]
        if parent.kind != ResDeclKind.Extension {
            return false
        }
        tc_contains(&self.skipped, parent.node)
    }

    // A function's parameters, their defaults, its receiver and its block.
    func check_function_body(&var self, d: Int) {
        let info = self.res.decls[d]
        let node = info.node
        let s = self.sigs[d]
        let n = self.child_count(node)
        var index = 0
        var block = -1
        var k = 0
        while k < n {
            let c = self.child(node, k)
            if self.has_alt(c, Alt.Decl_Param_Plain) || self.has_alt(c, Alt.Decl_Param_Default) {
                let leaf = self.res.first_leaf(c)
                var t = self.error_type
                if index < s.param_count {
                    let param = self.params[s.param_first + index]
                    t = param.ty
                }
                self.local_types[leaf] = t
                if self.has_alt(c, Alt.Decl_Param_Default) {
                    let value = self.res.last_node_child(c)
                    self.begin_body(d, value)
                    self.body_result = t
                    if self.kind_of(t) == TcKind.Param {
                        self.check_generic_default(value, t)
                    } else {
                        self.check_default_value(value, t)
                    }
                }
                index = index + 1
            } else if self.has_alt(c, Alt.Decl_Param_Receiver) {
                let receiver = self.current_self
                self.local_types[c] = receiver
            } else if self.has_alt(c, Alt.Stmt_Block) {
                block = c
            }
            k = k + 1
        }
        if block < 0 {
            return
        }
        self.begin_body(d, block)
        self.body_result = s.result
        // A `borrows` body lends rather than returns: its value is the place
        // a `lend` names, a conditional lend's absent path returns `None`,
        // and its coverage is the effect checks' question.
        let lending = (s.effects & TC_EFFECT_BORROWS) != 0
        let lent = self.referent(s.result)
        if lending && lent >= 0 {
            self.body_result = lent
        }
        if self.is_void(s.result) || lending {
            let _ = self.check_block(block, TC_WANT_STMT, TcTail.Body)
        } else {
            let t = self.check_block(block, s.result, TcTail.Body)
            if t >= 0 && self.is_void(t) && not self.is_never(s.result) && not self.returns_void_ok(s.result) {
                self.refuse_body_falls_off(block, s.result)
            }
        }
    }

    // A static's initializer, which expects the static's type.
    func check_static_body(&var self, d: Int) {
        let info = self.res.decls[d]
        let s = self.sigs[d]
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if not self.is_leaf(c) && not res_is_type_alt(self.node_alt(c)) {
                self.begin_body(d, c)
                self.body_result = s.result
                self.check_static_value(c, s.result)
            }
            k = k + 1
        }
    }

    // A raw-backed enum case's value, which expects the enum's backing type.
    func check_raw_value(&var self, d: Int) {
        let info = self.res.decls[d]
        let backing = self.sigs[info.parent].result
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            if not self.is_leaf(c) && not self.has_alt(c, Alt.Decl_PayloadField) {
                self.begin_body(d, c)
                self.body_result = backing
                if backing >= 0 {
                    self.check_static_value(c, backing)
                } else {
                    let _ = self.expr(c, TC_WANT_NONE)
                    self.consume(c)
                }
            }
            k = k + 1
        }
    }

    // An `@align(N)` argument, an integer.
    func check_align_attribute(&var self, d: Int) {
        let info = self.res.decls[d]
        let outer = info.outer
        if outer < 0 || outer == info.node {
            return
        }
        let n = self.child_count(outer)
        var k = 0
        while k < n {
            let c = self.child(outer, k)
            if self.has_alt(c, Alt.Attr_Attribute_Align) {
                let e = self.res.first_node_child(c)
                if e >= 0 {
                    self.begin_body(d, e)
                    let t = self.int_type()
                    self.body_result = t
                    self.check_static_value(e, t)
                }
            }
            k = k + 1
        }
    }

    func refuse_body_falls_off(&var self, block: Int, result: Int) {
        var msg = StringBuilder()
        try! msg.append("this body produces no value, and its function returns `")
        try! msg.append(self.type_text(result))
        try! msg.append("`: end it with an expression of that type, or return one")
        self.refuse(block, "type.mismatch", msg.build())
    }
}

// Side-table writes.
extension TcProgram {
    // Records expression `e`'s own type, and whether it is a place.
    public func set_type(&var self, e: Int, t: Int, place: Bool) -> Int {
        self.expr_types[e] = t
        self.typed_count[e] += 1
        self.expr_place[e] = place
        t
    }

    public func set_use(&var self, e: Int, u: TcUse) {
        if e >= 0 {
            self.expr_use[e] = u
        }
    }

    // Whether expression `e` has been typed.
    public func is_typed(&self, e: Int) -> Bool {
        self.typed_count[e] > 0
    }

    // Records a call's resolution; `receiver` is the node its receiver is
    // read from, or -1. Returns the record's index.
    public func record_call(&var self, e: Int, target: Int, role: TcRole, owner: Int,
                            inst: &Vector<Int>) -> Int {
        let first = self.insts.len()
        var k = 0
        while k < inst.len() {
            try! self.insts.push(inst[k])
            k = k + 1
        }
        let at = self.calls.len()
        try! self.calls.push(TcCall(node: e, target: target, role: role, derived: false, owner: owner,
                                    inst_first: first, inst_count: inst.len(), spelling: -1, twin: -1))
        self.call_at[e] = at
        at
    }

    // Records that builtin operator or function `spelling` answers `e`.
    public func record_builtin(&var self, e: Int, target: Int, role: TcRole, text: String) {
        let none = Vector<Int>()
        let at = self.record_call(e, target, role, -1, &none)
        var c = self.calls[at]
        c.spelling = self.res.intern(text)
        self.calls[at] = c
    }
}

// Statements and blocks.
extension TcProgram {
    // Block `b`'s statements; with a value wanted, its last expression
    // statement is its tail, checked through the funnel entry `tail` names.
    // Returns the block's type: its tail's, `Never` when a statement
    // diverges, `Void` otherwise.
    public func check_block(&var self, b: Int, want: Int, tail: TcTail) -> Int {
        if b < 0 {
            return self.error_type
        }
        let n = self.child_count(b)
        var last = -1
        var k = 0
        while k < n {
            let c = self.child(b, k)
            if not self.is_leaf(c) {
                last = c
            }
            k = k + 1
        }
        var diverges = false
        k = 0
        while k < n {
            let s = self.child(b, k)
            k = k + 1
            if self.is_leaf(s) {
                continue
            }
            if s == last && want != TC_WANT_STMT && self.has_alt(s, Alt.Stmt_Expr) {
                let e = self.res.first_node_child(s)
                let t = self.check_tail(e, want, tail)
                if diverges {
                    return self.never_type()
                }
                return t
            }
            if self.check_statement(s) {
                diverges = true
            }
        }
        if diverges {
            return self.never_type()
        }
        self.void_type()
    }

    // A block's tail, through the funnel entry for where the block stands.
    func check_tail(&var self, e: Int, want: Int, tail: TcTail) -> Int {
        if want < 0 {
            let _ = self.expr(e, TC_WANT_NONE)
            self.consume(e)
            return self.final_type(e)
        }
        match tail {
            case Body -> self.check_body_tail(e, want),
            case Branch -> self.check_branch(e, want),
            case Closure -> self.check_closure_tail(e, want),
            case Plain -> {
                let _ = self.expr(e, TC_WANT_NONE)
                self.consume(e)
                self.final_type(e)
            }
        }
    }

    // One statement. Returns whether it diverges: control never reaches the
    // statement after it.
    public func check_statement(&var self, s: Int) -> Bool {
        guard let alt = self.node_alt(s) else {
            return false
        }
        self.check_statement_as(s, alt)
    }

    func check_statement_as(&var self, s: Int, alt: Alt) -> Bool {
        match alt {
            case Stmt_Expr -> {
                let e = self.res.first_node_child(s)
                let t = self.expr(e, TC_WANT_STMT)
                self.consume(e)
                self.check_discarded(e)
                self.is_never(t)
            },
            case Stmt_Let_Immutable -> {
                self.check_let(s)
                false
            },
            case Stmt_Let_Mutable -> {
                self.check_let(s)
                false
            },
            case Stmt_Destructure_Immutable -> {
                self.check_destructure(s)
                false
            },
            case Stmt_Destructure_Mutable -> {
                self.check_destructure(s)
                false
            },
            case Stmt_AttributedLocal -> {
                let n = self.child_count(s)
                var k = 0
                while k < n {
                    let c = self.child(s, k)
                    if self.has_alt(c, Alt.Attr_Attribute_Align) {
                        let e = self.res.first_node_child(c)
                        if e >= 0 {
                            let t = self.int_type()
                            self.check_static_value(e, t)
                        }
                    }
                    k = k + 1
                }
                let local = self.res.last_node_child(s)
                self.check_statement(local)
            },
            case Stmt_Assign -> {
                self.check_assign(s)
                false
            },
            case Stmt_CompoundAssign -> {
                self.check_compound(s)
                false
            },
            case Stmt_Return -> {
                self.check_return(s)
                true
            },
            case Stmt_Break -> {
                self.check_break(s)
                true
            },
            case Stmt_Continue -> true,
            case Stmt_Lend -> {
                self.check_lend(s)
                false
            },
            case Stmt_Guard_Let -> {
                self.check_guard_let(s)
                false
            },
            case Stmt_Guard_Var -> {
                self.check_guard_let(s)
                false
            },
            case Stmt_Guard_Condition -> {
                self.check_guard_condition(s)
                false
            },
            case Decl_StaticAssert -> {
                let c = self.res.first_node_child(s)
                self.check_condition(c)
                false
            },
            case _ -> {
                self.not_in_slice(s, alt)
                false
            }
        }
    }

    // `let x = e`, `let x: T = e`, and their `var` forms.
    func check_let(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        var annotation = -1
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if c != target && c != value && not self.is_leaf(c) && res_is_type_alt(self.node_alt(c)) {
                annotation = c
            }
            k = k + 1
        }
        var t = self.error_type
        if annotation >= 0 {
            t = self.build_type(annotation)
            self.check_let_value(value, t)
        } else {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            t = self.final_type(value)
        }
        self.bind_target(target, t, TcOrigin.Temporary)
    }

    // `let (a, b) = e`: the tuple pattern against the value's type.
    func check_destructure(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let _ = self.expr(value, TC_WANT_NONE)
        self.consume(value)
        let t = self.final_type(value)
        let from = TcOrigin.Temporary
        self.check_pattern(target, t, from)
    }

    // A binding target: a BindingName, bound to `t`, or a tuple pattern.
    func bind_target(&var self, target: Int, t: Int, from: TcOrigin) {
        if self.has_alt(target, Alt.Stmt_BindingName) {
            let leaf = self.res.first_leaf(target)
            self.bind_part(target, leaf, t, from)
        } else {
            self.check_pattern(target, t, from)
        }
    }

    // A binding, at `node`, of a part of type `t`, declared at `leaf`: it
    // copies the part out of a place, takes it from a temporary or from a
    // consumed local, or aliases it in a borrowed scrutinee. `_` binds
    // nothing, so it reads no part.
    func bind_part(&var self, node: Int, leaf: Int, t: Int, from: TcOrigin) {
        if leaf >= 0 {
            self.local_types[leaf] = t
        }
        let _ = self.set_type(node, t, true)
        let m = self.current
        if leaf >= 0 {
            let written = self.text(m, leaf)
            if written.equals("_") {
                // `let _ = e` takes the value and drops it; `if let _ = e`
                // and a `_` payload only test.
                if from == TcOrigin.Temporary && self.has_alt(node, Alt.Stmt_BindingName) {
                    self.set_use(node, TcUse.Temp)
                } else {
                    self.set_use(node, TcUse.Test)
                }
                return
            }
        }
        match from {
            case Place -> {
                self.set_use(node, TcUse.Copy)
                if not self.copies_silently(t) {
                    self.refuse_implicit_copy(node, t)
                }
            },
            case Temporary -> self.set_use(node, TcUse.Temp),
            case Owned -> self.set_use(node, TcUse.Move),
            case Borrowed -> self.set_use(node, TcUse.Borrow)
        }
    }

    // What a `match` scrutinee's bindings take their parts from: a
    // temporary; an owned local, consumed unless its type copies silently;
    // or anything else a place is, which the match borrows.
    func scrutinee_origin(&var self, scrutinee: Int, t: Int) -> TcOrigin {
        let own = self.expr_types[scrutinee]
        if not self.expr_place[scrutinee] && self.referent(own) < 0 {
            return TcOrigin.Temporary
        }
        if self.has_alt(scrutinee, Alt.Expr_Name) && self.referent(own) < 0 {
            let leaf = self.res.first_leaf(scrutinee)
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Local && b.node >= 0 && not self.has_alt(b.node, Alt.Decl_Param_Receiver) {
                if self.copies_silently(t) {
                    return TcOrigin.Place
                }
                self.set_use(scrutinee, TcUse.Move)
                return TcOrigin.Owned
            }
        }
        TcOrigin.Borrowed
    }

    // `place = value`: the target is written, and names the value's
    // expected type at every target kind (design 87).
    func check_assign(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let t = self.check_target(target, TcUse.Write)
        self.check_assigned(value, t)
    }

    // `place op= value`: the target is read and written, and the value
    // expects the target's type, or `Int` for a shift's amount.
    func check_compound(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let t = self.check_target(target, TcUse.Update)
        let op = self.compound_op_text(s)
        if self.has_error(t) {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            return
        }
        let shift = op.equals("<<=") || op.equals(">>=")
        let arithmetic = op.equals("+=") || op.equals("-=") || op.equals("*=") || op.equals("/=") || op.equals("%=")
        if shift {
            let i = self.int_type()
            self.check_compound_value(value, i)
            if not self.is_integer(t) {
                self.refuse_operator_type(s, op, t)
            }
            return
        }
        self.check_compound_value(value, t)
        if arithmetic && not self.is_numeric(t) {
            self.refuse_operator_type(s, op, t)
        } else if not arithmetic && not self.is_integer(t) && not self.is_bool(t) {
            self.refuse_operator_type(s, op, t)
        }
    }

    // The operator a compound assignment writes.
    func compound_op_text(&self, s: Int) -> String {
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if self.is_leaf(c) {
                let m = self.current
                return self.text(m, c)
            }
            k = k + 1
        }
        ""
    }

    // An assignment target: a place, marked with how it is used. Returns
    // the type a value assigned to it must have, a reference's referent
    // when the target is a reference binding (design 110).
    func check_target(&var self, target: Int, u: TcUse) -> Int {
        let t = self.expr(target, TC_WANT_NONE)
        if self.has_error(t) {
            self.set_use(target, u)
            return self.error_type
        }
        if not self.expr_place[target] {
            self.refuse_not_a_place(target)
        }
        self.set_use(target, u)
        let inner = self.referent(t)
        if inner >= 0 {
            self.add_adjust(target, TcAdjustKind.Deref, inner)
            return inner
        }
        t
    }

    // `return` and `return e`.
    func check_return(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        let result = self.body_result
        if e < 0 {
            if result >= 0 && not self.is_void(result) && not self.has_error(result) && not self.returns_void_ok(result) {
                var msg = StringBuilder()
                try! msg.append("`return` with no value, where `")
                try! msg.append(self.type_text(result))
                try! msg.append("` is returned")
                self.refuse(s, "type.mismatch", msg.build())
            }
            return
        }
        if result < 0 {
            let _ = self.expr(e, TC_WANT_NONE)
            self.consume(e)
            return
        }
        self.check_returned(e, result)
    }

    // Whether `t` is a `Result<Void, E>`, whose `Ok` a bare `return` and a
    // body that ends in a statement give.
    func returns_void_ok(&self, t: Int) -> Bool {
        if not self.is_result(t) {
            return false
        }
        let ok = self.arg_of(t, 0)
        self.is_void(ok)
    }

    // `break`, which counts toward its loop; a value is outside the slice.
    func check_break(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        if e >= 0 {
            self.not_in_slice(s, Alt.Stmt_Break)
            return
        }
        let depth = self.loop_breaks.len()
        if depth > 0 {
            self.loop_breaks[depth - 1] += 1
        }
    }

    // `lend place`: the place a `borrows` body lends, of the lent type.
    func check_lend(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        let t = self.expr(e, TC_WANT_NONE)
        let d = self.current_decl
        if d < 0 || self.has_error(t) {
            self.set_use(e, TcUse.Borrow)
            return
        }
        let sig = self.sigs[d]
        var wanted = sig.result
        let inner = self.referent(wanted)
        if inner >= 0 {
            wanted = inner
        }
        if sig.lending_exclusive {
            self.set_use(e, TcUse.BorrowVar)
        } else {
            self.set_use(e, TcUse.Borrow)
        }
        // A conditional lend lends a present place of the payload, or passes
        // on another conditional lend whole.
        var also = -1
        if (sig.lending == TcLend.ConditionalPlace || sig.lending == TcLend.ConditionalSlice) && self.is_optional(wanted) {
            also = wanted
            wanted = self.arg_of(wanted, 0)
        }
        if t != wanted && t != also && not self.has_error(wanted) {
            var msg = StringBuilder()
            try! msg.append("`lend` hands out a place of type `")
            try! msg.append(self.type_text(t))
            try! msg.append("`, and this accessor lends `")
            try! msg.append(self.type_text(wanted))
            try! msg.append("`")
            self.refuse(e, "type.mismatch", msg.build())
        }
    }

    // `guard let x = e else { ... }`: the binding outlives the guard.
    func check_guard_let(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        var subject = -1
        var parts = 0
        var block = -1
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if c != target && not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else {
                    if subject < 0 {
                        subject = c
                    }
                    parts = parts + 1
                }
            }
            k = k + 1
        }
        if parts > 1 {
            self.not_in_slice(s, Alt.Stmt_BindingSubject_ChainAssign)
            return
        }
        self.check_optional_binding(target, subject)
        let _ = self.check_block(block, TC_WANT_STMT, TcTail.Plain)
    }

    // Whether an optional binding's head holds an assignment through an
    // optional chain as its subject, `let _ = a?.b = v`, which is outside the
    // slice: more parts than its target and one subject.
    func binds_chain_assignment(&self, head: Int) -> Bool {
        var parts = 0
        let n = self.child_count(head)
        var k = 0
        while k < n {
            let c = self.child(head, k)
            if not self.is_leaf(c) {
                parts = parts + 1
            }
            k = k + 1
        }
        parts > 2
    }

    // `guard cond else { ... }`.
    func check_guard_condition(&var self, s: Int) {
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    let _ = self.check_block(c, TC_WANT_STMT, TcTail.Plain)
                } else {
                    self.check_condition(c)
                }
            }
            k = k + 1
        }
    }

    // A condition: a `Bool`.
    public func check_condition(&var self, e: Int) {
        if e < 0 {
            return
        }
        let _ = self.expr(e, TC_WANT_NONE)
        self.consume(e)
        let ft = self.final_type(e)
        if self.is_bool(ft) || self.has_error(ft) || self.is_never(ft) {
            return
        }
        let inner = self.referent(ft)
        if inner >= 0 && self.is_bool(inner) {
            self.add_adjust(e, TcAdjustKind.Deref, inner)
            return
        }
        var msg = StringBuilder()
        try! msg.append("a condition is a `Bool`, and this is `")
        try! msg.append(self.type_text(ft))
        try! msg.append("`")
        self.refuse(e, "type.mismatch", msg.build())
    }
}

// The expected-type funnel and its entry points.
extension TcProgram {
    // The expected-type funnel (SL:architecture §3.4): checks expression `e`
    // where position `pos` expects `slot`, and records the conversions that
    // bring it there. A literal, a constant expression, an implicit member
    // and a construction take the slot as `peel` finds it, the same for every
    // position; any other expression is typed with the slot as a hint, then
    // converted within what the position allows (`allowance`). An expression
    // typed already, as argument inference types one first, is only
    // converted. The position takes the value, or, with `borrowed`, borrows
    // it. Returns the type the position receives.
    //
    // ENTRY POINTS (expect):
    //     check_let_value
    //     check_static_value
    //     check_assigned
    //     check_argument
    //     check_field_argument
    //     check_default_value
    //     check_returned
    //     check_body_tail
    //     check_branch
    //     check_payload
    //     check_compound_value
    //     check_element
    //     check_closure_tail
    //     check_operand
    //     check_compared
    //     check_coalesce_right
    func expect(&var self, e: Int, slot: Int, pos: TcPosition, borrowed: Bool) -> Int {
        let known = slot >= 0 && not self.has_error(slot)
        let allow = self.allowance(pos)
        if known && not self.is_typed(e) && self.raw_case_named(e) >= 0 && self.adopts_lone_case(pos) {
            // A lone raw-backed case is a constant of its backing, so an
            // integer slot takes its value (spec, Flag enums).
            let peeled = self.peel(slot, TcClient.Integer, -1, -1)
            if peeled >= 0 && self.is_integer(peeled) {
                let _ = self.expr(e, TC_WANT_NONE)
                self.add_adjust(e, TcAdjustKind.Adopt, peeled)
            }
        }
        if not self.is_typed(e) {
            if not known {
                let _ = self.expr(e, TC_WANT_NONE)
            } else {
                let target = self.peeled_target(e, slot)
                if target == TC_PEEL_AMBIGUOUS {
                    self.refuse_ambiguous_result(e, slot)
                    let poisoned = self.error_type
                    let _ = self.expr(e, poisoned)
                    self.take(e, borrowed)
                    return poisoned
                }
                let outer = self.branch_allow
                self.branch_allow = allow
                let _ = self.expr(e, target)
                self.branch_allow = outer
            }
        }
        let from = self.final_type(e)
        if not known {
            self.take(e, borrowed)
            return from
        }
        let how = self.coerce(e, from, slot, allow)
        self.take(e, borrowed)
        if how == TC_FIT_NONE {
            let fp = self.known.func_pointer
            if fp >= 0 && self.is_nominal_of(slot, fp) && self.kind_of(from) == TcKind.Func {
                self.not_yet(e, "a function passed as a `FuncPointer`")
                return from
            }
            self.refuse_mismatch(e, from, slot, pos, allow)
            return from
        }
        if how == TC_FIT_AMBIGUOUS {
            self.refuse_ambiguous_result(e, slot)
            return from
        }
        self.check_literal_range(e)
        slot
    }

    // A bare integer literal, or its negation, must fit the integer type it
    // adopts (spec, Primitive Types: "range-checked at the literal"). A
    // literal inside a larger constant expression is not checked alone: the
    // folded value is, with a static or a raw-backed case as a leaf, and so is
    // a lone case adopted by an integer slot (spec, Flag enums).
    func check_literal_range(&var self, e: Int) {
        var lit = e
        var negated = false
        if self.has_alt(e, Alt.Expr_Unary_Negate) {
            lit = self.res.first_node_child(e)
            negated = true
        }
        if not self.has_alt(lit, Alt.Expr_Int) {
            self.check_constant_range(e)
            return
        }
        if self.is_suffixed_literal(lit) {
            return
        }
        let t = self.adopted_type(lit)
        if not self.is_integer(t) {
            return
        }
        let v = self.literal_magnitude(lit)
        let unsigned = self.is_unsigned(t)
        let w = self.int_width(t)
        var fits = true
        if negated && unsigned {
            fits = v == 0
        } else if w < 64 {
            let top = if unsigned { (1 << w) - 1 } else { (1 << (w - 1)) - 1 }
            let bottom = if unsigned { 0 } else { 1 << (w - 1) }
            let bound = if negated { bottom } else { top }
            fits = v >= 0 && v <= bound
        } else if not negated && not unsigned {
            // A magnitude past `Int.max` reads as -1; a negated one may still
            // be the 64-bit minimum, and an unsigned one may still fit.
            fits = v >= 0
        }
        if fits {
            return
        }
        let m = self.current
        let leaf = self.res.first_leaf(lit)
        let at = if leaf >= 0 { leaf } else { lit }
        var msg = StringBuilder()
        try! msg.append("integer literal ")
        if negated {
            try! msg.append("-")
        }
        try! msg.append(self.text(m, at))
        try! msg.append(" does not fit in `")
        try! msg.append(self.type_text(t))
        try! msg.append("` (range ")
        try! msg.append(self.int_range_text(t))
        try! msg.append(")")
        self.refuse(e, "type.mismatch", msg.build())
    }

    // A constant expression, or a lone raw-backed case, must fit the
    // integer type it is typed or adopted as, by its folded value.
    func check_constant_range(&var self, e: Int) {
        if not self.is_constant_expr(e) && self.raw_case_named(e) < 0 {
            return
        }
        let t = self.adopted_type(e)
        if t < 0 || not self.is_integer(t) {
            return
        }
        let v = self.fold_constant(e)
        if not v.ok || self.value_fits(v.value, t) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("constant expression ")
        try! msg.append(v.value.to_string())
        try! msg.append(" does not fit in `")
        try! msg.append(self.type_text(t))
        try! msg.append("` (range ")
        try! msg.append(self.int_range_text(t))
        try! msg.append(")")
        self.refuse(e, "type.mismatch", msg.build())
    }

    // A literal with a signed width suffix fits the width's signed range
    // (SL:open-questions D6); the magnitude of its minimum is allowed only
    // under a unary minus, as `-128_i8`.
    func check_signed_suffix(&var self, e: Int, t: Int) {
        if self.is_unsigned(t) {
            return
        }
        let w = self.int_width(t)
        let v = self.fold_constant(e)
        let negated = self.negated_literal == e
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        var fits = true
        if w < 64 {
            let top = (1 << (w - 1)) - 1
            fits = v.ok && (v.value <= top || (negated && v.value == top + 1))
        } else if not v.ok {
            fits = negated && text.starts_with("9223372036854775808")
        }
        if fits {
            return
        }
        var msg = StringBuilder()
        try! msg.append("integer literal ")
        try! msg.append(text)
        try! msg.append(" does not fit in `")
        try! msg.append(self.type_text(t))
        try! msg.append("` (range ")
        try! msg.append(self.int_range_text(t))
        try! msg.append("): a signed suffix holds its literal to the signed range, and only a unary minus reaches its minimum")
        self.refuse(e, "type.mismatch", msg.build())
    }

    // The integer type literal `e` took: the one it adopted, or its own.
    func adopted_type(&self, e: Int) -> Int {
        var a = self.adj_head[e]
        while a >= 0 {
            let adj = self.adjusts[a]
            if adj.kind == TcAdjustKind.Adopt {
                return adj.to
            }
            a = adj.next
        }
        self.expr_types[e]
    }

    // An unsuffixed integer literal's value, or -1 past `Int.max`.
    func literal_magnitude(&self, e: Int) -> Int {
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        var radix = 10
        var i = 0
        let n = text.len()
        if n > 2 && (text.byte_at(0) as Int) == 48 {
            let letter = text.byte_at(1) as Int
            if letter == 120 {
                radix = 16
                i = 2
            } else if letter == 111 {
                radix = 8
                i = 2
            } else if letter == 98 {
                radix = 2
                i = 2
            }
        }
        var value = 0
        while i < n {
            let b = text.byte_at(i) as Int
            i = i + 1
            var digit = -1
            if b >= 48 && b <= 57 {
                digit = b - 48
            } else if b >= 97 && b <= 102 {
                digit = b - 87
            } else if b >= 65 && b <= 70 {
                digit = b - 55
            }
            if b == 95 {
                continue
            }
            if digit < 0 || digit >= radix || value > (TC_INT_MAX - digit) / radix {
                return -1
            }
            value = value * radix + digit
        }
        value
    }

    // Integer type `t`'s range, as the refusal spells it.
    func int_range_text(&self, t: Int) -> String {
        let w = self.int_width(t)
        if self.is_unsigned(t) {
            if w == 64 {
                return "0..=18446744073709551615"
            }
            var out = StringBuilder()
            try! out.append("0..=")
            try! out.append(((1 << w) - 1).to_string())
            return out.build()
        }
        if w == 64 {
            return "-9223372036854775808..=9223372036854775807"
        }
        var out = StringBuilder()
        try! out.append("-")
        try! out.append((1 << (w - 1)).to_string())
        try! out.append("..=")
        try! out.append(((1 << (w - 1)) - 1).to_string())
        out.build()
    }

    // How the funnel's position reads `e`: by value, or borrowed.
    func take(&var self, e: Int, borrowed: Bool) {
        if borrowed {
            if self.expr_use[e] == TcUse.Unused {
                self.set_use(e, TcUse.Borrow)
            }
            return
        }
        self.consume(e)
    }

    // What expression `e` is typed against in a slot of type `slot`: the
    // peeled slot for a literal, a constant expression, an implicit member
    // or a construction, the slot itself for anything else.
    func peeled_target(&var self, e: Int, slot: Int) -> Int {
        guard let alt = self.node_alt(e) else {
            return slot
        }
        if alt == Alt.Expr_Float {
            let peeled = self.peel(slot, TcClient.Floating, -1, -1)
            return self.peel_or_slot(peeled, slot)
        }
        if self.is_constant_expr(e) {
            let peeled = self.peel(slot, TcClient.Integer, -1, -1)
            return self.peel_or_slot(peeled, slot)
        }
        let name = self.implicit_member_name(e)
        if name >= 0 {
            let peeled = self.peel(slot, TcClient.Member, name, -1)
            return self.peel_or_slot(peeled, slot)
        }
        let constructed = self.constructed_decl(e)
        if constructed >= 0 {
            let peeled = self.peel(slot, TcClient.Construct, -1, constructed)
            return self.peel_or_slot(peeled, slot)
        }
        slot
    }

    func peel_or_slot(&self, peeled: Int, slot: Int) -> Int {
        if peeled == TC_PEEL_NONE {
            return slot
        }
        peeled
    }

    // Whether `e` is a constant expression over integer literals: a
    // literal, a negation, or an arithmetic, shift or bit operator over them.
    public func is_constant_expr(&self, e: Int) -> Bool {
        guard let alt = self.node_alt(e) else {
            return false
        }
        self.is_constant_alt(e, alt)
    }

    func is_constant_alt(&self, e: Int, alt: Alt) -> Bool {
        match alt {
            case Expr_Int -> not self.is_suffixed_literal(e),
            case Expr_Unary_Negate -> {
                let inner = self.res.first_node_child(e)
                self.is_constant_part(inner)
            },
            case Expr_Unary_Complement -> {
                let inner = self.res.first_node_child(e)
                self.is_constant_part(inner)
            },
            case Expr_Additive -> self.all_constant(e),
            case Expr_Multiplicative -> self.all_constant(e),
            case Expr_Shift -> self.all_constant(e),
            case Expr_Bitand -> self.all_constant(e),
            case Expr_Bitor -> self.all_constant(e),
            case Expr_Bitxor -> self.all_constant(e),
            case _ -> false
        }
    }

    func all_constant(&self, e: Int) -> Bool {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) && not self.is_constant_part(c) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether `e` may stand inside a constant expression: a constant
    // expression, or a name the fold reads, a module `static` of an integer
    // type (spec, Integer Width Agreement). A bare static anywhere else,
    // an operator's peer included, keeps its declared type.
    public func is_constant_part(&self, e: Int) -> Bool {
        self.is_constant_expr(e) || self.names_constant_static(e) || self.raw_case_named(e) >= 0
    }

    public func names_constant_static(&self, e: Int) -> Bool {
        if not self.has_alt(e, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return false
        }
        let info = self.res.decls[b.decl]
        if info.kind != ResDeclKind.Static {
            return false
        }
        let s = self.sigs[b.decl]
        (s.flags & TC_FLAG_UNSAFE_VAR) == 0 && s.result >= 0 && self.is_integer(s.result)
    }

    // Constant part `c` typed where a constant takes integer type `want`:
    // a literal or constant expression adopts it, and so does the folded
    // value of a static leaf or a raw-backed case (spec, Flag enums).
    func constant_part(&var self, c: Int, want: Int) {
        let _ = self.expr(c, want)
        let leaf = self.names_constant_static(c) || self.raw_case_named(c) >= 0
        if leaf && self.final_type(c) != want && self.is_integer(want) {
            self.add_adjust(c, TcAdjustKind.Adopt, want)
        }
    }

    // The backing integer of the first raw-backed case constant expression
    // `e` holds, which a chain of flags with no integer slot is typed as
    // (spec, Flag enums: "The result is the backing integer, never the
    // enum"); -1 when it holds none.
    func constant_backing(&self, e: Int) -> Int {
        let c = self.raw_case_named(e)
        if c >= 0 {
            let parent = self.res.decls[c].parent
            return self.sigs[parent].result
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let child = self.child(e, k)
            k = k + 1
            if not self.is_leaf(child) {
                let found = self.constant_backing(child)
                if found >= 0 {
                    return found
                }
            }
        }
        return -1
    }

    // Whether funnel position `pos` is an integer slot a lone raw-backed case
    // folds into (spec, Flag enums): a declared type in force, not an
    // operator's peer.
    func adopts_lone_case(&self, pos: TcPosition) -> Bool {
        match pos {
            case Operand -> false,
            case Compound -> false,
            case Coalesce -> false,
            case _ -> true
        }
    }

    // The case name an implicit member, or a call of one, selects; -1 for any
    // other expression.
    func implicit_member_name(&self, e: Int) -> Int {
        if self.has_alt(e, Alt.Expr_ImplicitMember) {
            let leaf = self.res.first_leaf(e)
            let b = self.binding_at(leaf)
            return b.name
        }
        if self.is_call_alt(e) {
            let callee = self.res.first_node_child(e)
            if self.has_alt(callee, Alt.Expr_ImplicitMember) {
                let leaf = self.res.first_leaf(callee)
                let b = self.binding_at(leaf)
                return b.name
            }
        }
        return -1
    }

    // The type a construction `T(...)` builds, when `e` is one; -1 otherwise.
    func constructed_decl(&self, e: Int) -> Int {
        if not self.is_call_alt(e) {
            return -1
        }
        let at = self.res_call_at[e]
        if at < 0 {
            return -1
        }
        let rc = self.res.calls[at]
        if rc.classification != ResCallClass.Init {
            return -1
        }
        let b = rc.binding
        if b.kind == ResBindKind.Decl && self.is_nominal(b.decl) {
            return b.decl
        }
        return -1
    }

    public func is_call_alt(&self, e: Int) -> Bool {
        self.has_alt(e, Alt.Expr_Call_Paren) || self.has_alt(e, Alt.Expr_Call_ParenTrailing) || self.has_alt(e, Alt.Expr_TrailingCall)
    }

    // How a position reads expression `e` by value: a spelled `move`, the
    // hand-off of a temporary, or an implicit copy of a place, which only a
    // Copy type allows silently (design 131).
    public func consume(&var self, e: Int) {
        if e < 0 || self.expr_use[e] != TcUse.Unused {
            return
        }
        if self.has_alt(e, Alt.Expr_Move_Place) || self.has_alt(e, Alt.Expr_MoveDeref_Name) || self.has_alt(e, Alt.Expr_MoveDeref_Self) {
            self.set_use(e, TcUse.Move)
            return
        }
        if not self.expr_place[e] {
            self.set_use(e, TcUse.Temp)
            return
        }
        self.set_use(e, TcUse.Copy)
        let t = self.read_type(e)
        if not self.copies_silently(t) {
            self.refuse_implicit_copy(e, t)
        }
    }

    // The type a copy of place `e` duplicates: its own, read through each
    // leading `deref`. A wrap or an erasure after that builds a new value
    // from the copy.
    func read_type(&self, e: Int) -> Int {
        var t = self.expr_types[e]
        var a = self.adj_head[e]
        while a >= 0 {
            let adj = self.adjusts[a]
            if adj.kind != TcAdjustKind.Deref {
                return t
            }
            t = adj.to
            a = adj.next
        }
        t
    }

    public func check_let_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Let, false)
    }

    public func check_static_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Static, false)
    }

    public func check_assigned(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Assign, false)
    }

    public func check_argument(&var self, e: Int, slot: Int) {
        let by_reference = self.has_alt(e, Alt.Borrow_Place_Shared) || self.has_alt(e, Alt.Borrow_Place_Var)
        if by_reference && slot >= 0 && self.kind_of(slot) == TcKind.Ref && not self.is_typed(e) {
            self.borrow_place_argument(e)
        }
        let _ = self.expect(e, slot, TcPosition.Argument, false)
    }

    public func check_field_argument(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Field, false)
    }

    public func check_default_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Default, false)
    }

    public func check_returned(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Return, false)
    }

    public func check_body_tail(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Tail, false)
    }

    public func check_branch(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Branch, false)
    }

    public func check_payload(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Payload, false)
    }

    public func check_compound_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Compound, false)
    }

    public func check_element(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Element, false)
    }

    public func check_closure_tail(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.ClosureTail, false)
    }

    public func check_operand(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Operand, false)
    }

    public func check_coalesce_right(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Coalesce, false)
    }

    func position_text(&self, pos: TcPosition) -> String {
        match pos {
            case Let -> "the annotated binding",
            case Static -> "the static's type",
            case Assign -> "the assignment's target",
            case Argument -> "the parameter",
            case Field -> "the field",
            case Default -> "the parameter this default fills",
            case Return -> "the function's result",
            case Tail -> "the function's result, which the body's last expression is",
            case Branch -> "the value the branches merge into",
            case Payload -> "the payload field",
            case Compound -> "the compound assignment's target",
            case Element -> "the collection's element",
            case ClosureTail -> "the closure's result",
            case Operand -> "the other operand",
            case Coalesce -> "the optional's payload, which `??` falls back to"
        }
    }

    // What position `pos` lets a conversion build: the wrap and erasure
    // matrix of compiler/tests/typecheck/README.md, where each cell's spec
    // line is quoted. A call argument wraps one optional level and never
    // builds the error box; a return target does both freely. Every transfer
    // widens an integer losslessly, and an operator's peers never do. A value
    // branch's arms inherit the position the branch stands in.
    func allowance(&self, pos: TcPosition) -> TcAllowance {
        match pos {
            case Let -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: false, widens: true),
            case Static -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Assign -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: false, widens: true),
            case Argument -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Field -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Default -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Return -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Tail -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Branch -> self.branch_allow,
            case Payload -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Compound -> TcAllowance(optionals: 1, results: 1, erases: false, widens: false),
            case Element -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case ClosureTail -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Operand -> TcAllowance(optionals: 1, results: 0, erases: false, widens: false),
            case Coalesce -> TcAllowance(optionals: 1, results: 0, erases: false, widens: true)
        }
    }

    // Why a value that does not fit within `allow` is refused, when it would
    // fit where more is allowed: the wrap depth, the error box or the Result
    // wrap.
    func allowance_reason(&var self, from: Int, slot: Int, allow: TcAllowance) -> String {
        let deeper = TcAllowance(optionals: TC_ANY_DEPTH, results: allow.results, erases: allow.erases,
                                 widens: allow.widens)
        if allow.optionals != TC_ANY_DEPTH && self.fit(from, slot, deeper) > TC_FIT_NONE {
            return "; this position wraps one optional level (`T` to `T?`, never `T??`), so pass a value one level below the slot"
        }
        let boxed = TcAllowance(optionals: allow.optionals, results: allow.results, erases: true,
                                widens: allow.widens)
        if not allow.erases && self.fit(from, slot, boxed) > TC_FIT_NONE {
            return "; only a return builds the `Box<any Error>` a concrete error erases into, so write an explicit `.Err(error: ...)` holding the box"
        }
        if not allow.widens && self.widens_losslessly(from, slot) {
            return "; an operator's operands agree, and only a transfer widens an integer, so convert one with `as`"
        }
        if allow.widens && self.is_integer(from) && self.is_integer(slot) {
            return "; only a lossless widening into or out of `Int` or `UInt` is implicit: write `as` to panic out of range, `.from(...)` for `None`, or `.from(truncating: ...)` for the low bits"
        }
        if allow.results == 0 {
            let wrapped = TcAllowance(optionals: allow.optionals, results: 1, erases: false, widens: allow.widens)
            if self.fit(from, slot, wrapped) > TC_FIT_NONE {
                return "; a Result wraps only where a value lands in a declared Result slot, so write `.Ok(value: ...)` or `.Err(error: ...)`"
            }
        }
        ""
    }
}

// Expressions.
extension TcProgram {
    // Expression `e`'s own type, recorded against it; `want` is what its
    // position expects: a type, TC_WANT_NONE, or TC_WANT_STMT for a
    // statement. The type an adjustment chain ends at is `final_type`.
    public func expr(&var self, e: Int, want: Int) -> Int {
        if e < 0 {
            return self.error_type
        }
        guard let alt = self.node_alt(e) else {
            self.not_in_slice(e, Alt.Expr_OptionalMember)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let t = self.expr_as(e, alt, want)
        if not self.is_typed(e) {
            let _ = self.set_type(e, t, false)
        }
        t
    }

    func expr_as(&var self, e: Int, alt: Alt, want: Int) -> Int {
        match alt {
            case Expr_Int -> self.int_literal(e, want),
            case Expr_Float -> {
                let t = self.float_type()
                self.set_type(e, t, false)
            },
            case Expr_String -> {
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_Bool_True -> {
                let t = self.bool_type()
                self.set_type(e, t, false)
            },
            case Expr_Bool_False -> {
                let t = self.bool_type()
                self.set_type(e, t, false)
            },
            case Expr_None -> self.none_literal(e, want),
            case Expr_Interpolation -> self.interpolation(e),
            case Expr_SourceLocation_File -> {
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_SourceLocation_Function -> {
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_SourceLocation_Line -> {
                let t = self.int_type()
                self.set_type(e, t, false)
            },
            case Expr_Name -> self.name_expr(e, want),
            case Expr_NameRef -> self.name_expr(e, want),
            case Expr_Self -> self.self_expr(e),
            case Expr_ImplicitMember -> self.implicit_member(e, want),
            case Expr_Member -> self.member_expr(e, want),
            case Expr_TupleIndex -> self.tuple_index(e),
            case Expr_Call_Paren -> self.call_expr(e, want),
            case Expr_Call_ParenTrailing -> self.call_expr(e, want),
            case Expr_TrailingCall -> self.call_expr(e, want),
            case Expr_Subscript_Single -> self.subscript_expr(e),
            case Expr_Subscript_Multi -> self.subscript_expr(e),
            case Expr_Force -> self.force_expr(e),
            case Expr_Unary_Negate -> self.unary_expr(e, want, 0),
            case Expr_Unary_Not -> self.unary_expr(e, want, 1),
            case Expr_Unary_Complement -> self.unary_expr(e, want, 2),
            case Expr_Additive -> self.arithmetic_expr(e, want),
            case Expr_Multiplicative -> self.arithmetic_expr(e, want),
            case Expr_Shift -> self.arithmetic_expr(e, want),
            case Expr_Bitand -> self.arithmetic_expr(e, want),
            case Expr_Bitor -> self.arithmetic_expr(e, want),
            case Expr_Bitxor -> self.arithmetic_expr(e, want),
            case Expr_And -> self.logic_expr(e),
            case Expr_Or -> self.logic_expr(e),
            case Expr_Compare_Pair -> self.compare_expr(e),
            case Expr_Coalesce -> self.coalesce_expr(e, want),
            case Expr_Range_Closed -> self.range_expr(e),
            case Expr_Cast -> self.cast_expr(e),
            case Expr_Ref_Shared -> self.ref_expr(e, false),
            case Expr_Ref_Exclusive -> self.ref_expr(e, true),
            case Expr_Move_Place -> self.move_expr(e),
            case Expr_Deref -> self.deref_expr(e),
            case Expr_Try_Propagate -> self.try_expr(e, 0),
            case Expr_Try_Force -> self.try_expr(e, 1),
            case Expr_Try_Optional -> self.try_expr(e, 2),
            case Expr_Tuple_Unit -> self.tuple_expr(e, want, false),
            case Expr_Tuple_Positional -> self.tuple_expr(e, want, false),
            case Expr_Tuple_Named -> self.tuple_expr(e, want, true),
            case Expr_Array -> self.array_expr(e, want),
            case Expr_Repeat -> self.repeat_expr(e, want),
            case Expr_Map_Empty -> self.map_expr(e, want),
            case Expr_Map_Entries -> self.map_expr(e, want),
            case Expr_Set -> self.set_expr(e, want),
            case Expr_Closure -> self.closure_expr(e, want),
            case Expr_If -> self.if_expr(e, want),
            case Expr_Match -> self.match_expr(e, want),
            case Expr_While_Conditional -> self.while_expr(e),
            case Expr_While_Infinite -> self.while_expr(e),
            case Expr_WhileLet_Let -> self.while_let_expr(e),
            case Expr_WhileLet_Var -> self.while_let_expr(e),
            case Expr_For_Plain -> self.for_expr(e),
            case Borrow_Block -> self.borrow_block(e, want),
            case Borrow_Place_Shared -> self.borrow_place(e, false),
            case Borrow_Place_Var -> self.borrow_place(e, true),
            case _ -> {
                self.not_in_slice(e, alt)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            }
        }
    }

    // An integer literal: `Int`, or its suffix's type; a bare one adopts an
    // integer type its position expects (design 87).
    func int_literal(&var self, e: Int, want: Int) -> Int {
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        let suffixed = self.suffix_type(&text)
        if suffixed >= 0 {
            self.check_signed_suffix(e, suffixed)
            return self.set_type(e, suffixed, false)
        }
        let t = self.int_type()
        let _ = self.set_type(e, t, false)
        if want >= 0 && want != t && self.is_integer(want) {
            self.add_adjust(e, TcAdjustKind.Adopt, want)
        }
        t
    }

    // The type a literal's suffix names (`255u8`, `7_i32`), or -1.
    func suffix_type(&var self, text: &String) -> Int {
        let d = self.suffix_decl(&text)
        if d < 0 {
            return -1
        }
        self.prim(d)
    }

    // Whether integer literal `e` is written with a width suffix, which makes
    // it exact-typed rather than adoptable (spec, Integer Width Agreement).
    func is_suffixed_literal(&self, e: Int) -> Bool {
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        self.suffix_decl(&text) >= 0
    }

    // The builtin declaration a literal's suffix names, or -1.
    func suffix_decl(&self, text: &String) -> Int {
        // A hex literal's digits include letters, but never `i` or `u`, so
        // the last of those begins the suffix.
        let n = text.len()
        var at = n - 1
        while at > 0 {
            let b = text.byte_at(at) as Int
            if b == 117 || b == 105 {
                break
            }
            at = at - 1
        }
        if at <= 0 {
            return -1
        }
        let suffix = text.substring(at, n)
        var d = -1
        if suffix.equals("u8") {
            d = self.known.uint8
        } else if suffix.equals("u16") {
            d = self.known.uint16
        } else if suffix.equals("u32") {
            d = self.known.uint32
        } else if suffix.equals("u64") {
            d = self.known.uint64
        } else if suffix.equals("i8") {
            d = self.known.int8
        } else if suffix.equals("i16") {
            d = self.known.int16
        } else if suffix.equals("i32") {
            d = self.known.int32
        } else if suffix.equals("i64") {
            d = self.known.int64
        }
        d
    }

    // `None`: the Optional its position expects. With none expected there
    // is nothing to say what it is a `None` of.
    func none_literal(&var self, e: Int, want: Int) -> Int {
        if want >= 0 && self.has_error(want) {
            return self.set_type(e, want, false)
        }
        if want >= 0 && self.is_optional(want) {
            return self.set_type(e, want, false)
        }
        // At a `Result<T?, E>` slot a bare `None` is `Ok(None)` (spec,
        // Auto-Wrap): the Ok payload's `None`, which the funnel wraps.
        if want >= 0 && self.is_result(want) {
            let ok = self.arg_of(want, 0)
            if self.is_optional(ok) {
                return self.set_type(e, ok, false)
            }
        }
        if want >= 0 {
            let t = self.mk_optional(want)
            return self.set_type(e, t, false)
        }
        self.refuse(e, "infer.failed",
                    "`None` has no type here: nothing says what it is a `None` of; annotate the binding, as `let x: Int? = None`")
        let poisoned = self.error_type
        self.set_type(e, poisoned, false)
    }

    func is_none_literal(&self, e: Int) -> Bool {
        self.has_alt(e, Alt.Expr_None)
    }

    // An interpolated string, whose segments are formatted: each is
    // Printable or a primitive, and is borrowed.
    func interpolation(&var self, e: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                let _ = self.expr(c, TC_WANT_NONE)
                self.check_formattable(c)
                self.set_use(c, TcUse.Borrow)
            }
            k = k + 1
        }
        let t = self.string_type()
        self.set_type(e, t, false)
    }

    // A value that is formatted, an interpolation's segment or a format
    // argument, is Printable or a primitive (design 137).
    func check_formattable(&var self, e: Int) {
        var t = self.final_type(e)
        let inner = self.referent(t)
        if inner >= 0 {
            t = inner
        }
        if self.has_error(t) {
            return
        }
        let printable = self.known.printable
        let env = self.current_decl
        let ext = self.current_ext
        if self.satisfies(t, printable, env, ext) {
            return
        }
        // An erased box, `Box<any Error>` above all, renders its payload
        // through the existential's vtable.
        if self.is_box(t) {
            let payload = self.arg_of(t, 0)
            if self.kind_of(payload) == TcKind.Any && self.satisfies(payload, printable, env, ext) {
                return
            }
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` is formatted here, and it is neither `Printable` nor a primitive")
        self.refuse(e, "format.argument", msg.build())
    }

    // A name in a value position: a local, a static, a function.
    func name_expr(&var self, e: Int, want: Int) -> Int {
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        match b.kind {
            case Local -> {
                let t = self.local_types[b.node]
                if t < 0 {
                    let poisoned = self.error_type
                    return self.set_type(e, poisoned, true)
                }
                self.set_type(e, t, true)
            },
            case Decl -> {
                let info = self.res.decls[b.decl]
                if info.kind == ResDeclKind.Static {
                    self.build_decl(b.decl)
                    let t = self.sigs[b.decl].result
                    self.poison_if(t)
                    return self.set_type(e, t, true)
                }
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Overload -> self.function_value(e, leaf, b),
            case Overloads -> self.function_value(e, leaf, b),
            case TypeParam -> {
                // A const parameter is a value of its declared type wherever
                // an expression wants one (design 148).
                let owner = self.param_owner(b.node)
                let index = self.param_index(b.node)
                if owner >= 0 && index >= 0 {
                    self.ensure_generics(owner)
                    let s = self.sigs[owner]
                    let g = self.generics[s.generic_first + index]
                    if g.is_const && g.const_type >= 0 {
                        return self.set_type(e, g.const_type, false)
                    }
                }
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Error -> {
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Unbound -> {
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case _ -> {
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            }
        }
    }

    // A function named as a value: the one function of its name, as a
    // function type.
    func function_value(&var self, e: Int, leaf: Int, b: ResBinding) -> Int {
        let cands = self.free_candidates(b)
        if cands.len() != 1 {
            let m = self.current
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.text(m, leaf))
            try! msg.append("` names ")
            try! msg.append(cands.len())
            try! msg.append(" functions; a function value names exactly one")
            self.refuse(e, "call.ambiguous", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = cands[0]
        self.build_decl(d)
        let s = self.sigs[d]
        let info = self.res.decls[d]
        if s.generic_count > 0 || info.kind == ResDeclKind.BuiltinFunc {
            self.not_in_slice(e, Alt.Expr_Name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var params = Vector<Int>()
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            try! params.push(p.ty)
            k = k + 1
        }
        let t = self.mk_func(&params, s.result, s.effects)
        let none = Vector<Int>()
        let _ = self.record_call(e, d, TcRole.Value, -1, &none)
        self.set_type(e, t, false)
    }

    // `self`: the receiver, a place of the enclosing type.
    func self_expr(&var self, e: Int) -> Int {
        let b = self.binding_at(e)
        if b.kind != ResBindKind.Local || b.node < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        let t = self.local_types[b.node]
        if t < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        self.set_type(e, t, true)
    }

    // `.Case`: a payload-free case of the enum its position expects.
    func implicit_member(&var self, e: Int, want: Int) -> Int {
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Cases {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if want >= 0 && self.has_error(want) {
            return self.set_type(e, want, false)
        }
        if want < 0 {
            self.refuse_implicit_without_type(e, b.name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.nominal_decl(want)
        let c = self.case_named(d, b.name)
        if c < 0 {
            // No layer of the slot has the case: the funnel's conversion
            // refuses the mismatch, naming the slot.
            self.refuse_no_such_case(e, b.name, want)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.case_has_payload(c) {
            self.refuse_payload_needed(e, c)
        }
        let none = Vector<Int>()
        let args = self.nominal_args(want)
        let _ = self.record_call(e, c, TcRole.Case, want, &args)
        self.set_type(e, want, false)
    }

    // Whether case `c` carries a payload.
    func case_has_payload(&self, c: Int) -> Bool {
        let info = self.res.decls[c]
        info.flag
    }

    // `base.name`: a field of a value, a tuple's labeled element, an enum's
    // case through its type, a module's member, or a builtin integer's
    // `max` and `min`.
    func member_expr(&var self, e: Int, want: Int) -> Int {
        let base = self.res.first_node_child(e)
        let leaf = self.res.first_leaf(e)
        let lb = self.binding_at(leaf)
        if lb.kind == ResBindKind.Case {
            return self.case_value(e, lb.decl, want)
        }
        if lb.kind == ResBindKind.Decl {
            let info = self.res.decls[lb.decl]
            if info.kind == ResDeclKind.Static {
                self.build_decl(lb.decl)
                let t = self.sigs[lb.decl].result
                self.poison_if(t)
                return self.set_type(e, t, true)
            }
            self.refuse_not_a_value(e, leaf)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if lb.kind == ResBindKind.Overload || lb.kind == ResBindKind.Overloads {
            return self.function_value(e, leaf, lb)
        }
        if lb.kind == ResBindKind.Error {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let type_decl = self.type_named_by(base)
        if type_decl >= 0 {
            return self.static_member(e, type_decl, leaf)
        }
        let m = self.current
        let member_text = self.text(m, leaf)
        let name = self.res.intern(member_text)
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        let place = self.expr_place[base] || self.referent(bt) >= 0
        let info = self.types.ty(t)
        if info.kind == TcKind.Tuple {
            var k = 0
            while k < info.count {
                if self.types.label(t, k) == name {
                    let et = self.types.arg(t, k)
                    return self.set_type(e, et, place)
                }
                k = k + 1
            }
            self.refuse_unknown_member(leaf, t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let d = self.nominal_decl(t)
        let found = self.members_named(d, name, m)
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            let mi = self.res.decls[member.decl]
            if mi.kind == ResDeclKind.Field {
                self.build_decl(member.decl)
                let written = self.sigs[member.decl].result
                let s = tc_args_subst(d, self.nominal_args(t))
                let ft = self.subst(written, &s)
                self.poison_if(ft)
                return self.set_type(e, ft, place)
            }
            k = k + 1
        }
        if found.len() > 0 {
            self.not_in_slice(e, Alt.Expr_Member)
        } else {
            self.refuse_unknown_member(leaf, t)
        }
        let poisoned = self.error_type
        self.set_type(e, poisoned, place)
    }

    // Expression `base`'s type read through any reference, recording the
    // read as a `Deref` step of its chain.
    func through_refs(&var self, base: Int) -> Int {
        let t = self.final_type(base)
        let inner = self.referent(t)
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
            return inner
        }
        t
    }

    // The nominal declaration expression `base` names as a type, not a
    // value: a type's name, `Self`, or a qualified type; -1 for a value.
    func type_named_by(&var self, base: Int) -> Int {
        if base < 0 {
            return -1
        }
        var leaf = -1
        if self.has_alt(base, Alt.Expr_Name) {
            leaf = self.res.first_leaf(base)
        } else if self.has_alt(base, Alt.Expr_Member) {
            leaf = self.res.first_leaf(base)
        } else {
            return -1
        }
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Decl && b.decl >= 0 {
            let info = self.res.decls[b.decl]
            if self.is_nominal(b.decl) {
                return b.decl
            }
            if info.kind == ResDeclKind.Alias || info.kind == ResDeclKind.TypeAssign {
                let t = self.alias_type(b.decl, -1)
                return self.nominal_decl(t)
            }
        }
        if b.kind == ResBindKind.SelfType && b.decl >= 0 && self.is_nominal(b.decl) {
            return b.decl
        }
        return -1
    }

    // `Type.name` that is no case: a builtin integer's `max` or `min`; a
    // static method named without its call is outside the slice.
    func static_member(&var self, e: Int, d: Int, leaf: Int) -> Int {
        let m = self.current
        let text = self.text(m, leaf)
        let t = self.prim_or_self(d)
        if self.is_integer(t) && (text.equals("max") || text.equals("min")) {
            return self.set_type(e, t, false)
        }
        let name = self.res.intern(text)
        let found = self.members_named(d, name, m)
        if found.len() > 0 {
            self.not_in_slice(e, Alt.Expr_Member)
        } else {
            self.refuse_unknown_member(leaf, t)
        }
        let poisoned = self.error_type
        self.set_type(e, poisoned, false)
    }

    // Nominal `d` applied to its own parameters: the type itself for one
    // with none.
    func prim_or_self(&var self, d: Int) -> Int {
        self.self_type_of(d)
    }

    // `E.Case` named as a value: a payload-free case. A generic enum takes
    // its arguments from the expected type.
    func case_value(&var self, e: Int, c: Int, want: Int) -> Int {
        let info = self.res.decls[c]
        let d = info.parent
        if self.case_has_payload(c) {
            self.refuse_payload_needed(e, c)
        }
        var t = self.written_enum_owner(e, d)
        if t < 0 {
            t = self.enum_type_for(e, d, want)
        }
        let args = self.nominal_args(t)
        let _ = self.record_call(e, c, TcRole.Case, t, &args)
        self.set_type(e, t, false)
    }

    // The enum type `E<A>.Case` names when its head writes the arguments:
    // `member` is the `E<A>.Case` node and `d` the enum. -1 when none are
    // written.
    func written_enum_owner(&var self, member: Int, d: Int) -> Int {
        if member < 0 || not self.has_alt(member, Alt.Expr_Member) {
            return -1
        }
        let base = self.res.first_node_child(member)
        let written = self.explicit_type_args(base)
        if written.len() == 0 {
            return -1
        }
        let leaf = self.res.first_leaf(base)
        self.named_owner(d, &written, leaf)
    }

    // Enum `d`'s type where `want` is expected: its own arguments when it
    // takes none, else the expected type's when that is `d`, else refused.
    func enum_type_for(&var self, e: Int, d: Int, want: Int) -> Int {
        self.ensure_generic_list(d)
        let s = self.sigs[d]
        if s.generic_count == 0 {
            return self.self_type_of(d)
        }
        let peeled = self.peel(want, TcClient.Construct, -1, d)
        if peeled >= 0 {
            return peeled
        }
        if want >= 0 && self.has_error(want) {
            return want
        }
        var msg = StringBuilder()
        try! msg.append("the type arguments of `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` cannot be inferred here; write them, or give the position a type")
        self.refuse(e, "infer.failed", msg.build())
        self.error_type
    }

    // `t.0`: a tuple's element.
    func tuple_index(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        let leaf = self.res.last_leaf_of(e)
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let m = self.current
        let text = self.text(m, leaf)
        var index = 0
        var i = 0
        while i < text.len() {
            index = index * 10 + (text.byte_at(i) as Int) - 48
            i = i + 1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Tuple && index < info.count {
            let et = self.types.arg(t, index)
            return self.set_type(e, et, place)
        }
        self.refuse_unknown_member(leaf, t)
        let poisoned = self.error_type
        self.set_type(e, poisoned, place)
    }

    // `o!`: an Optional's payload, a place when the Optional is one
    // (design 131).
    func force_expr(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        if not self.is_optional(t) {
            self.refuse_operand(e, "`!` unwraps an Optional", t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let payload = self.arg_of(t, 0)
        self.set_type(e, payload, place)
    }

    // `-x`, `not b`, `~x`: `which` is 0, 1 or 2.
    func unary_expr(&var self, e: Int, want: Int, which: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let outer = self.negated_literal
        if which == 0 {
            self.negated_literal = operand
        }
        if which != 1 && self.is_constant_expr(e) && want >= 0 && self.is_integer(want) {
            self.constant_part(operand, want)
        } else {
            let _ = self.expr(operand, TC_WANT_NONE)
        }
        self.negated_literal = outer
        self.consume(operand)
        let t = self.through_refs(operand)
        if self.has_error(t) {
            return self.set_type(e, t, false)
        }
        if which == 1 {
            if not self.is_bool(t) {
                self.refuse_operand(e, "`not` takes a `Bool`", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "not")
            let b = self.bool_type()
            return self.set_type(e, b, false)
        }
        if which == 0 {
            if not self.is_numeric(t) {
                self.refuse_operand(e, "`-` negates a number", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "-")
        } else {
            if not self.is_integer(t) {
                self.refuse_operand(e, "`~` complements an integer", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "~")
        }
        self.set_type(e, t, false)
    }

    // An arithmetic, shift or bit operator chain. Its operands agree on one
    // type: a constant operand adopts the others' (the funnel's mixed-operand
    // entry), and a chain of constants adopts the expected integer type.
    func arithmetic_expr(&var self, e: Int, want: Int) -> Int {
        let n = self.child_count(e)
        let spelling = self.operators_text(e)
        // A shift's counts are no peers: each is range-checked against the
        // value's width and gives the result nothing (spec, Integer Width
        // Agreement), so only its first operand agrees with anything.
        let shift = self.has_alt(e, Alt.Expr_Shift)
        let constant = self.is_constant_expr(e)
        var cwant = want
        if constant && not (want >= 0 && self.is_integer(want)) {
            let backing = self.constant_backing(e)
            if backing >= 0 {
                cwant = backing
            }
        }
        if constant && cwant >= 0 && self.is_integer(cwant) {
            var operand = 0
            var k = 0
            while k < n {
                let c = self.child(e, k)
                k = k + 1
                if self.is_leaf(c) {
                    continue
                }
                if shift && operand > 0 {
                    self.shift_count(c)
                } else {
                    self.constant_part(c, cwant)
                    self.consume(c)
                }
                operand = operand + 1
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
            return self.set_type(e, cwant, false)
        }
        var t = -1
        var poisoned = false
        var operand = 0
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            operand = operand + 1
            if (shift && operand > 1) || self.is_constant_expr(c) {
                continue
            }
            let _ = self.expr(c, TC_WANT_NONE)
            self.consume(c)
            let ct = self.through_refs(c)
            let cd = self.nominal_decl(ct)
            if cd >= 0 && (cd == self.known.unsafe_pointer || cd == self.known.unsafe_const_pointer) {
                self.not_yet(e, "pointer arithmetic, `p + i`,")
                let bad = self.error_type
                return self.set_type(e, bad, false)
            }
            if self.has_error(ct) {
                poisoned = true
            } else if t < 0 {
                t = ct
            } else if ct != t {
                self.refuse_operands_disagree(c, t, ct)
                poisoned = true
            }
        }
        if t < 0 {
            t = self.int_type()
        }
        operand = 0
        k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            operand = operand + 1
            if shift && operand > 1 {
                self.shift_count(c)
            } else if self.is_constant_expr(c) {
                let _ = self.check_operand(c, t)
            }
        }
        if poisoned {
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        let kinds = self.operator_kinds(e)
        let integral = (kinds & TC_OPS_INTEGRAL) != 0
        let logical = (kinds & TC_OPS_LOGICAL) != 0
        if integral && not self.is_integer(t) {
            self.refuse_operand(e, "a shift or remainder operator takes integers", t)
        } else if logical && not self.is_integer(t) && not self.is_bool(t) {
            self.refuse_operand(e, "a bit operator takes integers or `Bool`s", t)
        } else if (kinds & TC_OPS_ARITHMETIC) != 0 && not self.is_numeric(t) {
            self.refuse_operand(e, "an arithmetic operator takes numbers", t)
        }
        self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
        self.set_type(e, t, false)
    }

    // A shift's count: an integer of any width, a constant one an `Int`.
    func shift_count(&var self, c: Int) {
        if self.is_constant_part(c) {
            let i = self.int_type()
            self.constant_part(c, i)
            self.consume(c)
            return
        }
        let _ = self.expr(c, TC_WANT_NONE)
        self.consume(c)
        let ct = self.through_refs(c)
        if not self.has_error(ct) && not self.is_integer(ct) {
            self.refuse_operand(c, "a shift count is an integer", ct)
        }
    }

    // The operators of a flat chain, in order, separated by spaces.
    func operators_text(&self, e: Int) -> String {
        let m = self.current
        var out = StringBuilder()
        var first = true
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.is_leaf(c) {
                if not first {
                    try! out.append(" ")
                }
                try! out.append(self.text(m, c))
                first = false
            }
            k = k + 1
        }
        out.build()
    }

    // Which kinds of operator a flat chain holds, as TC_OPS_ bits.
    func operator_kinds(&self, e: Int) -> Int {
        let m = self.current
        var kinds = 0
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.is_leaf(c) {
                let op = self.text(m, c)
                if op.equals("<<") || op.equals(">>") || op.equals("%") {
                    kinds = kinds | TC_OPS_INTEGRAL
                } else if op.equals("&") || op.equals("|") || op.equals("^") {
                    kinds = kinds | TC_OPS_LOGICAL
                } else {
                    kinds = kinds | TC_OPS_ARITHMETIC
                }
            }
            k = k + 1
        }
        kinds
    }

    // `a && b`, `a || b`: conditions.
    func logic_expr(&var self, e: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                self.check_condition(c)
            }
            k = k + 1
        }
        let spelling = self.operators_text(e)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
        let t = self.bool_type()
        self.set_type(e, t, false)
    }

    // `a == b` and the other comparisons. The operand that types itself
    // goes first, and the other expects its type (the funnel's mixed-operand
    // entry); both are borrowed, since a comparison's operands are references.
    func compare_expr(&var self, e: Int) -> Int {
        let left = self.res.first_node_child(e)
        let right = self.res.last_node_child(e)
        let spelling = self.operators_text(e)
        var t = -1
        let left_peer = self.needs_expectation(left)
        let right_peer = self.needs_expectation(right)
        if left_peer && not right_peer {
            let _ = self.expr(right, TC_WANT_NONE)
            t = self.through_refs(right)
            let _ = self.check_compared(left, t)
        } else {
            let _ = self.expr(left, TC_WANT_NONE)
            t = self.through_refs(left)
            let _ = self.check_compared(right, t)
        }
        self.set_use(left, TcUse.Borrow)
        self.set_use(right, TcUse.Borrow)
        let b = self.bool_type()
        if self.has_error(t) {
            return self.set_type(e, b, false)
        }
        let equality = spelling.equals("==") || spelling.equals("!=")
        self.resolve_comparison(e, t, equality, spelling)
        self.set_type(e, b, false)
    }

    // A comparison's second operand, through the funnel's mixed-operand
    // entry, borrowed rather than consumed.
    func check_compared(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Operand, true)
    }

    // Whether expression `e` takes its type from its position: a literal,
    // a constant, `None`, an implicit member, a closure, or a collection
    // literal.
    public func needs_expectation(&self, e: Int) -> Bool {
        if self.is_constant_expr(e) || self.implicit_member_name(e) >= 0 {
            return true
        }
        guard let alt = self.node_alt(e) else {
            return false
        }
        alt == Alt.Expr_None || alt == Alt.Expr_Float || alt == Alt.Expr_Closure || alt == Alt.Expr_Array || alt == Alt.Expr_Map_Empty || alt == Alt.Expr_Map_Entries || alt == Alt.Expr_Set || alt == Alt.Expr_Repeat
    }

    // What answers a comparison of two `t`s: a builtin operator for the
    // numbers, `Bool`, `String`, the pointers, a payload-free enum and an
    // Optional of those; else the type's `equals` or `compare`, a bound's
    // requirement for a type parameter, or the structural comparison of a
    // trivially copyable type's automatic `Equatable` and of a tuple whose
    // elements all conform (spec, Equality).
    func resolve_comparison(&var self, e: Int, t: Int, equality: Bool, spelling: String) {
        if self.builtin_comparable(t, equality) {
            self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
            return
        }
        let d = self.nominal_decl(t)
        let wanted = if equality { "equals" } else { "compare" }
        let name = self.res.intern(wanted)
        let m = self.current
        let kind = self.kind_of(t)
        if kind == TcKind.Param || kind == TcKind.SelfType {
            var cands = Vector<TcCand>()
            self.method_candidates(&var cands, t, name, false)
            if cands.len() > 0 {
                let req = cands[0]
                let args = Vector<Int>()
                let at = self.record_call(e, req.decl, TcRole.Operator, t, &args)
                var rc = self.calls[at]
                rc.spelling = self.res.intern(spelling)
                self.calls[at] = rc
                return
            }
        }
        let found = self.members_named(d, name, m)
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            if self.is_method_member(found[k], false) {
                let args = Vector<Int>()
                let at = self.record_call(e, member.decl, TcRole.Operator, t, &args)
                var c = self.calls[at]
                c.spelling = self.res.intern(spelling)
                self.calls[at] = c
                return
            }
            k = k + 1
        }
        if equality && (kind == TcKind.Nominal || kind == TcKind.Tuple) {
            let equatable = self.known.equatable
            let env = self.current_decl
            let ext = self.current_ext
            if self.satisfies(t, equatable, env, ext) {
                self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
                return
            }
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(spelling)
        try! msg.append("` compares two `")
        try! msg.append(self.type_text(t))
        if equality {
            try! msg.append("`, which is not `Equatable`")
        } else {
            try! msg.append("`, which is not `Comparable`")
        }
        self.refuse(e, "operator.undefined", msg.build())
    }

    func builtin_comparable(&var self, t: Int, equality: Bool) -> Bool {
        if self.is_numeric(t) || self.is_string(t) {
            return true
        }
        if not equality {
            return false
        }
        if self.is_bool(t) {
            return true
        }
        let d = self.nominal_decl(t)
        if d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer {
            return true
        }
        if self.is_optional(t) {
            let inner = self.arg_of(t, 0)
            return self.builtin_comparable(inner, true)
        }
        if self.is_enum_decl(d) && self.declared_policy(d) < 0 {
            let members = self.members_of(d)
            var k = 0
            while k < members.len() {
                let c = members[k]
                let info = self.res.decls[c]
                if info.kind == ResDeclKind.Case && info.flag {
                    return false
                }
                k = k + 1
            }
            let equatable = self.known.equatable
            return not self.has_conformance(d, equatable)
        }
        false
    }

    // Whether nominal `d` declares a conformance to trait `tr`.
    func has_conformance(&self, d: Int, tr: Int) -> Bool {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            if c.type_decl == d && c.trait_decl == tr {
                return true
            }
            k = k + 1
        }
        false
    }

    // `a ?? b ?? c`: each operand but the last an Optional of one payload
    // type, and the last that payload (the funnel's `??` entry) or an
    // Optional of it, which keeps the result optional.
    func coalesce_expr(&var self, e: Int, want: Int) -> Int {
        var operands = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                try! operands.push(c)
            }
            k = k + 1
        }
        let first = operands[0]
        let _ = self.expr(first, TC_WANT_NONE)
        self.consume(first)
        let ft = self.through_refs(first)
        if self.has_error(ft) || not self.is_optional(ft) {
            if not self.has_error(ft) {
                self.refuse_operand(first, "`??` takes an Optional on its left", ft)
            }
            k = 1
            while k < operands.len() {
                let _ = self.expr(operands[k], TC_WANT_NONE)
                self.consume(operands[k])
                k = k + 1
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let payload = self.arg_of(ft, 0)
        k = 1
        while k + 1 < operands.len() {
            let _ = self.check_coalesce_right(operands[k], ft)
            k = k + 1
        }
        let last = operands[operands.len() - 1]
        if not self.needs_expectation(last) {
            let _ = self.expr(last, TC_WANT_NONE)
            if self.final_type(last) == ft {
                self.consume(last)
                self.record_builtin(e, -1, TcRole.BuiltinOperator, "??")
                return self.set_type(e, ft, false)
            }
            // The merged home would be the fallback's type, and no adjustment
            // widens a payload inside its Optional.
            let fallback = self.final_type(last)
            if self.widens_losslessly(payload, fallback) {
                self.not_yet(e, "a `??` whose fallback is wider than the optional's payload")
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
        }
        let _ = self.check_coalesce_right(last, payload)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, "??")
        self.set_type(e, payload, false)
    }

    // `a..b`, `a..=b`: a `Range` or `RangeInclusive` of `Int`s.
    func range_expr(&var self, e: Int) -> Int {
        let low = self.res.first_node_child(e)
        let high = self.res.last_node_child(e)
        let m = self.current
        let op_leaf = self.res.first_leaf(e)
        let op = self.text(m, op_leaf)
        let i = self.int_type()
        let _ = self.check_operand(low, i)
        let _ = self.check_operand(high, i)
        let d = if op.equals("..=") { self.known.range_inclusive } else { self.known.range }
        let t = self.prim(d)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, op)
        self.set_type(e, t, false)
    }

    // `x as T`: a numeric conversion, a raw-backed enum to its backing, or a
    // pointer's reinterpretation.
    func cast_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let target_node = self.res.last_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let to = self.build_type(target_node)
        // A reference cast to a raw pointer is the one crossing into the
        // unsafe tier, and takes the reference's address, not its referent.
        let own = self.final_type(operand)
        let to_decl = self.nominal_decl(to)
        let to_pointer = to_decl == self.known.unsafe_pointer || to_decl == self.known.unsafe_const_pointer
        if to_pointer && self.kind_of(own) == TcKind.Ref {
            return self.set_type(e, to, false)
        }
        let from = self.through_refs(operand)
        if self.has_error(from) || self.has_error(to) {
            return self.set_type(e, to, false)
        }
        if not self.cast_allowed(from, to) {
            var msg = StringBuilder()
            try! msg.append("`as` cannot convert `")
            try! msg.append(self.type_text(from))
            try! msg.append("` to `")
            try! msg.append(self.type_text(to))
            try! msg.append("`: it converts between numbers, from a raw-backed enum, and between pointers")
            self.refuse(e, "type.cast", msg.build())
        }
        self.set_type(e, to, false)
    }

    func cast_allowed(&var self, from: Int, to: Int) -> Bool {
        if from == to {
            return true
        }
        if self.is_numeric(from) && self.is_numeric(to) {
            return true
        }
        let fd = self.nominal_decl(from)
        let td = self.nominal_decl(to)
        if self.is_enum_decl(fd) && self.sigs[fd].result >= 0 && self.is_integer(to) {
            return true
        }
        if self.is_bool(from) && self.is_integer(to) {
            return true
        }
        let from_pointer = fd == self.known.unsafe_pointer || fd == self.known.unsafe_const_pointer
        let to_pointer = td == self.known.unsafe_pointer || td == self.known.unsafe_const_pointer
        if from_pointer && (to_pointer || self.is_integer(to)) {
            return true
        }
        if to_pointer && self.is_integer(from) {
            return true
        }
        false
    }

    // `&x`, `&var x`: a reference to a place, or, shared, to a temporary.
    // A reference binding is reborrowed, not referenced again.
    func ref_expr(&var self, e: Int, exclusive: Bool) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        if exclusive {
            self.set_use(operand, TcUse.BorrowVar)
        } else {
            self.set_use(operand, TcUse.Borrow)
        }
        let ot = self.final_type(operand)
        if self.has_error(ot) {
            return self.set_type(e, ot, false)
        }
        if exclusive && not self.expr_place[operand] {
            self.refuse_not_a_place(operand)
        }
        let inner = self.referent(ot)
        if inner >= 0 {
            self.add_adjust(operand, TcAdjustKind.Deref, inner)
            if exclusive && not self.is_exclusive_ref(ot) {
                self.refuse_not_a_place(operand)
            }
            let t = self.mk_ref(exclusive, inner)
            return self.set_type(e, t, false)
        }
        let t = self.mk_ref(exclusive, ot)
        self.set_type(e, t, false)
    }

    // `move x`: the place's value, taken; the place is moved from.
    func move_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let t = self.expr(operand, TC_WANT_NONE)
        self.set_use(operand, TcUse.Move)
        if self.rooted_in_self(operand) && not self.in_consuming_body() {
            var msg = StringBuilder()
            try! msg.append("`move` out of `self` is legal only in a `consumes` method, whose receiver ends with the call: declare the method `consumes`, or take the value with `take()` or `swap_out`")
            self.refuse(e, "consumes.move-self", msg.build())
        }
        if not self.has_error(t) && not self.expr_place[operand] {
            self.refuse_not_a_place(operand)
        }
        let ft = self.final_type(operand)
        // `move o!` moves the payload out of an optional place: the whole
        // place is `o!`, so the value is the payload (design 131).
        let last = self.res.last_leaf_of(e)
        let m = self.current
        let last_text = if last >= 0 { self.text(m, last) } else { "" }
        if last_text.equals("!") && not self.has_error(ft) {
            let ot = self.through_refs(operand)
            if not self.is_optional(ot) {
                self.refuse_operand(e, "`!` unwraps an Optional", ot)
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            let payload = self.arg_of(ot, 0)
            return self.set_type(e, payload, false)
        }
        self.set_type(e, ft, false)
    }

    // Whether place `e` is `self` or a part of it: a field, a tuple element
    // or a payload of `self`.
    func rooted_in_self(&self, e: Int) -> Bool {
        var at = e
        while at >= 0 {
            if self.has_alt(at, Alt.Expr_Self) {
                return true
            }
            let projected = self.has_alt(at, Alt.Expr_Member) || self.has_alt(at, Alt.Expr_TupleIndex) || self.has_alt(at, Alt.Expr_Force)
            if not projected {
                return false
            }
            at = self.res.first_node_child(at)
        }
        false
    }

    // Whether the body being checked is a `consumes` method's (SL-414).
    func in_consuming_body(&self) -> Bool {
        let d = self.current_decl
        d >= 0 && (self.sigs[d].effects & TC_EFFECT_CONSUMES) != 0
    }

    // `*p`: a raw pointer's pointee, a place.
    func deref_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let t = self.final_type(operand)
        if self.has_error(t) {
            return self.set_type(e, t, true)
        }
        let d = self.nominal_decl(t)
        if d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer {
            let pointee = self.arg_of(t, 0)
            return self.set_type(e, pointee, true)
        }
        self.refuse_operand(e, "`*` reads through a raw pointer", t)
        let poisoned = self.error_type
        self.set_type(e, poisoned, true)
    }

    // `try e` (which 0), `try! e` (1), `try? e` (2) over a Result. `try`
    // propagates the error into the body's own Result, erasing it into a
    // `Box<any Error>` there when that is the body's error type.
    func try_expr(&var self, e: Int, which: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let t = self.final_type(operand)
        if self.has_error(t) {
            return self.set_type(e, t, false)
        }
        if not self.is_result(t) {
            self.refuse_operand(e, "`try` unwraps a Result", t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let ok = self.arg_of(t, 0)
        let err = self.arg_of(t, 1)
        if which == 1 {
            return self.set_type(e, ok, false)
        }
        if which == 2 {
            let opt = self.mk_optional(ok)
            return self.set_type(e, opt, false)
        }
        let result = self.body_result
        if result < 0 || self.has_error(result) {
            return self.set_type(e, ok, false)
        }
        if not self.is_result(result) {
            var msg = StringBuilder()
            try! msg.append("`try` propagates an error, and this body returns `")
            try! msg.append(self.type_text(result))
            try! msg.append("`, not a Result; handle the error, or use `try!`")
            self.refuse(e, "type.try", msg.build())
            return self.set_type(e, ok, false)
        }
        let target_err = self.arg_of(result, 1)
        if target_err != err && not self.has_error(target_err) {
            if self.erases_to(err, target_err) {
                let erased = self.mk_result(ok, target_err)
                self.add_adjust(operand, TcAdjustKind.Erase, erased)
            } else {
                var msg = StringBuilder()
                try! msg.append("`try` propagates a `")
                try! msg.append(self.type_text(err))
                try! msg.append("`, and this body's error type is `")
                try! msg.append(self.type_text(target_err))
                try! msg.append("`")
                self.refuse(e, "type.try", msg.build())
            }
        }
        self.set_type(e, ok, false)
    }

    // A tuple: each element, against the expected tuple's element when one
    // of the same shape is expected.
    func tuple_expr(&var self, e: Int, want: Int, named: Bool) -> Int {
        var elements = Vector<Int>()
        var labels = Vector<Int>()
        var values = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                if named && self.has_alt(c, Alt.Expr_TupleField) {
                    let leaf = self.res.first_leaf(c)
                    let label = self.text(m, leaf)
                    try! labels.push(self.res.intern(label))
                    try! values.push(self.res.last_node_child(c))
                } else {
                    try! values.push(c)
                }
            }
            k = k + 1
        }
        var slot = -1
        if want >= 0 {
            let info = self.types.ty(want)
            if info.kind == TcKind.Tuple && info.count == values.len() {
                slot = want
            }
        }
        k = 0
        while k < values.len() {
            let v = values[k]
            if slot >= 0 {
                let et = self.types.arg(slot, k)
                self.check_element(v, et)
            } else {
                let _ = self.expr(v, TC_WANT_NONE)
                self.consume(v)
            }
            try! elements.push(self.final_type(v))
            k = k + 1
        }
        if slot >= 0 && not named {
            let info = self.types.ty(slot)
            if info.labeled {
                k = 0
                while k < info.count {
                    try! labels.push(self.types.label(slot, k))
                    k = k + 1
                }
            }
        }
        let t = self.mk_tuple(&elements, &labels)
        self.set_type(e, t, false)
    }

    // The collection type an expected type names, through Optionals: its
    // declaration when it is `d`, else -1.
    func collection_slot(&self, want: Int, d: Int) -> Int {
        var t = want
        while t >= 0 && self.is_optional(t) {
            t = self.arg_of(t, 0)
        }
        if t >= 0 && self.is_nominal_of(t, d) {
            return t
        }
        return -1
    }

    // A bracket literal: a `Vector` only where the position expects one, and
    // otherwise a fixed array `[T; N]` of its first element's type, N its
    // element count (spec, Composite Types).
    func array_expr(&var self, e: Int, want: Int) -> Int {
        var values = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                try! values.push(c)
            }
            k = k + 1
        }
        let vd = self.known.vector
        let vector = self.collection_slot(want, vd)
        var array = -1
        if want >= 0 {
            var w = want
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            let info = self.types.ty(w)
            if info.kind == TcKind.Array {
                array = w
            }
        }
        var element = -1
        var result = -1
        if vector >= 0 {
            element = self.arg_of(vector, 0)
            result = vector
        } else if array >= 0 {
            element = self.types.ty(array).b
            result = array
        }
        k = 0
        while k < values.len() {
            let v = values[k]
            if element >= 0 {
                self.check_element(v, element)
            } else {
                let _ = self.expr(v, TC_WANT_NONE)
                self.consume(v)
                element = self.final_type(v)
            }
            k = k + 1
        }
        if result < 0 {
            if element < 0 {
                self.refuse(e, "infer.failed",
                            "an empty array literal has no element type here; give the position a type")
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            let length = self.mk_const(values.len())
            result = self.mk_array(element, length)
        }
        if array >= 0 {
            let length = self.types.arg(array, 0)
            let li = self.types.ty(length)
            if li.kind == TcKind.ConstInt && li.a != values.len() {
                var msg = StringBuilder()
                try! msg.append("this array literal has ")
                try! msg.append(values.len())
                try! msg.append(" elements, and `")
                try! msg.append(self.type_text(array))
                try! msg.append("` holds ")
                try! msg.append(li.a)
                self.refuse(e, "type.mismatch", msg.build())
            }
        }
        self.set_type(e, result, false)
    }

    // `[v; N]`: a fixed array of `N` copies of `v`.
    func repeat_expr(&var self, e: Int, want: Int) -> Int {
        let value = self.res.first_node_child(e)
        let count = self.res.last_node_child(e)
        var element = -1
        if want >= 0 {
            let info = self.types.ty(want)
            if info.kind == TcKind.Array {
                element = info.b
            }
        }
        if element >= 0 {
            self.check_element(value, element)
        } else {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            element = self.final_type(value)
        }
        // The count is an `Int` expression of the body, and a constant the
        // array's type folds.
        let i = self.int_type()
        let _ = self.expr(count, i)
        self.consume(count)
        let length = self.build_const(count)
        let t = self.mk_array(element, length)
        self.set_type(e, t, false)
    }

    // A map literal, `{k: v}` or `{:}`: a `Map`'s keys and values.
    func map_expr(&var self, e: Int, want: Int) -> Int {
        let md = self.known.map
        let slot = self.collection_slot(want, md)
        var key = -1
        var value = -1
        if slot >= 0 {
            key = self.arg_of(slot, 0)
            value = self.arg_of(slot, 1)
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.has_alt(c, Alt.Expr_MapEntry) {
                continue
            }
            let kn = self.res.first_node_child(c)
            let vn = self.res.last_node_child(c)
            if key >= 0 {
                self.check_element(kn, key)
                self.check_element(vn, value)
            } else {
                let _ = self.expr(kn, TC_WANT_NONE)
                self.consume(kn)
                let _ = self.expr(vn, TC_WANT_NONE)
                self.consume(vn)
                key = self.final_type(kn)
                value = self.final_type(vn)
            }
        }
        if slot >= 0 {
            return self.set_type(e, slot, false)
        }
        if key < 0 {
            self.refuse(e, "infer.failed",
                        "an empty map literal has no key or value type here; give the position a type")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let t = self.defaulted(md, key, value)
        self.set_type(e, t, false)
    }

    // A set literal `{a, b}`: a `Set`'s elements.
    func set_expr(&var self, e: Int, want: Int) -> Int {
        let sd = self.known.set
        let slot = self.collection_slot(want, sd)
        var element = -1
        if slot >= 0 {
            element = self.arg_of(slot, 0)
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            if element >= 0 {
                self.check_element(c, element)
            } else {
                let _ = self.expr(c, TC_WANT_NONE)
                self.consume(c)
                element = self.final_type(c)
            }
        }
        if slot >= 0 {
            return self.set_type(e, slot, false)
        }
        let t = self.defaulted(sd, element, -1)
        self.set_type(e, t, false)
    }

    // Nominal `d` applied to `a`, then `b` when it is not -1, then its
    // remaining parameters' defaults.
    func defaulted(&var self, d: Int, a: Int, b: Int) -> Int {
        self.ensure_generics(d)
        let s = self.sigs[d]
        var args = Vector<Int>()
        try! args.push(a)
        var k = 1
        if b >= 0 {
            try! args.push(b)
            k = 2
        }
        while k < s.generic_count {
            let g = self.generics[s.generic_first + k]
            try! args.push(g.default_type)
            k = k + 1
        }
        self.mk_nominal(d, &args)
    }
}

// Closures and control flow.
extension TcProgram {
    // A closure: its parameters take their written types, or the expected
    // function type's; its body's tail and `return`s take the expected
    // result, or give the result when none is expected.
    func closure_expr(&var self, e: Int, want: Int) -> Int {
        self.closure_typed(e, want, false)
    }

    // A closure against `want`; with `open_result`, `want`'s parameters and
    // effects are known and its result is not, so the tail gives it, as when
    // inference has solved a parameter's function type all but its result.
    func closure_typed(&var self, e: Int, want: Int, open_result: Bool) -> Int {
        let fp = self.known.func_pointer
        if fp >= 0 && want >= 0 && self.is_nominal_of(want, fp) {
            self.not_yet(e, "a closure where a `FuncPointer` is expected")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var fwant = -1
        if want >= 0 {
            var w = want
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func {
                fwant = w
            }
        }
        var params = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.is_closure_param(c) {
                continue
            }
            let leaf = self.res.first_leaf(c)
            let annotation = self.res.last_node_child(c)
            var t = self.error_type
            if annotation >= 0 && res_is_type_alt(self.node_alt(annotation)) {
                t = self.build_type(annotation)
                if self.has_alt(c, Alt.Expr_ClosureParam_Ref) {
                    t = self.mk_ref(false, t)
                } else if self.has_alt(c, Alt.Expr_ClosureParam_RefExclusive) {
                    t = self.mk_ref(true, t)
                }
            } else if fwant >= 0 && params.len() < self.types.ty(fwant).count {
                t = self.types.arg(fwant, params.len())
            } else {
                self.refuse(c, "infer.failed",
                            "this closure parameter has no type: write one, as `x: Int`, or pass the closure where a function type is expected")
            }
            self.local_types[leaf] = t
            try! params.push(t)
        }
        var result = -1
        var effects = 0
        if fwant >= 0 {
            let info = self.types.ty(fwant)
            result = if open_result { -1 } else { info.b }
            effects = info.a
        }
        let saved_result = self.body_result
        let saved_loops = tc_copy_ints(&self.loop_breaks)
        self.loop_breaks = Vector<Int>()
        self.body_result = result
        var body = self.error_type
        if result >= 0 && self.is_void(result) {
            body = self.check_statements(e, TC_WANT_STMT, TcTail.Closure)
        } else if result >= 0 {
            body = self.check_statements(e, result, TcTail.Closure)
        } else {
            body = self.check_statements(e, TC_WANT_NONE, TcTail.Closure)
            result = body
            if self.is_never(result) {
                result = self.void_type()
            }
        }
        self.body_result = saved_result
        self.loop_breaks = move saved_loops
        let t = self.mk_func(&params, result, effects)
        self.set_type(e, t, false)
    }

    func is_closure_param(&self, c: Int) -> Bool {
        self.has_alt(c, Alt.Expr_ClosureParam_Value) || self.has_alt(c, Alt.Expr_ClosureParam_Ref) || self.has_alt(c, Alt.Expr_ClosureParam_RefExclusive)
    }

    func is_capture(&self, c: Int) -> Bool {
        self.has_alt(c, Alt.Expr_Capture_Value) || self.has_alt(c, Alt.Expr_Capture_Move) || self.has_alt(c, Alt.Expr_Capture_Copy) || self.has_alt(c, Alt.Expr_Capture_Borrow) || self.has_alt(c, Alt.Expr_Capture_BorrowExclusive) || self.has_alt(c, Alt.Expr_Capture_Self) || self.has_alt(c, Alt.Expr_Capture_SelfExclusive)
    }

    // The statements among node `id`'s children, a block's or a closure's,
    // as `check_block` checks a block's.
    func check_statements(&var self, id: Int, want: Int, tail: TcTail) -> Int {
        let n = self.child_count(id)
        var last = -1
        var k = 0
        while k < n {
            let c = self.child(id, k)
            if self.is_statement_child(c) {
                last = c
            }
            k = k + 1
        }
        var diverges = false
        k = 0
        while k < n {
            let s = self.child(id, k)
            k = k + 1
            if not self.is_statement_child(s) {
                continue
            }
            if s == last && want != TC_WANT_STMT && self.has_alt(s, Alt.Stmt_Expr) {
                let e = self.res.first_node_child(s)
                let t = self.check_tail(e, want, tail)
                if diverges {
                    return self.never_type()
                }
                return t
            }
            if self.check_statement(s) {
                diverges = true
            }
        }
        if diverges {
            return self.never_type()
        }
        self.void_type()
    }

    func is_statement_child(&self, c: Int) -> Bool {
        if self.is_leaf(c) || self.is_closure_param(c) || self.is_capture(c) {
            return false
        }
        true
    }

    // `if`: each arm's head and block, and an `else` block. With a value
    // wanted and an `else`, the branches merge into one type: the expected
    // one, or the arms' merged type, which a bare-literal arm adopts.
    func if_expr(&var self, e: Int, want: Int) -> Int {
        var blocks = Vector<Int>()
        var has_else = false
        var seen_else = false
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                let m = self.current
                let word = self.text(m, c)
                if word.equals("else") {
                    seen_else = true
                }
                continue
            }
            if self.has_alt(c, Alt.Stmt_Block) {
                try! blocks.push(c)
                if seen_else {
                    has_else = true
                }
            } else if self.has_alt(c, Alt.Expr_ElseIf) {
                try! blocks.push(c)
            } else {
                self.check_if_head(c)
            }
        }
        let stmt = want == TC_WANT_STMT || not has_else
        var slot = -1
        if want >= 0 {
            slot = want
        }
        var order = Vector<Int>()
        var deferred = Vector<Int>()
        k = 0
        while k < blocks.len() {
            let b = blocks[k]
            var block = b
            if self.has_alt(b, Alt.Expr_ElseIf) {
                block = self.arm_block(b)
            }
            let tail = self.block_tail(block)
            if not stmt && want < 0 && self.defers_arm(tail) {
                try! deferred.push(b)
            } else {
                try! order.push(b)
            }
            k = k + 1
        }
        self.append_arms(&var order, &deferred)
        var tails = Vector<Int>()
        var all_never = true
        k = 0
        while k < order.len() {
            let b = order[k]
            var block = b
            if self.has_alt(b, Alt.Expr_ElseIf) {
                block = self.check_arm_head(b)
            }
            var bt = self.error_type
            let tail = self.block_tail(block)
            if stmt {
                bt = self.check_block(block, TC_WANT_STMT, TcTail.Branch)
            } else if want < 0 && slot >= 0 && self.arm_merges(tail, slot) {
                bt = self.check_block(block, TC_WANT_NONE, TcTail.Branch)
                slot = self.merge_arm(tail, bt, slot, &var tails)
            } else if slot >= 0 {
                bt = self.check_block(block, slot, TcTail.Branch)
                self.check_branch_value(block, bt, slot)
                self.note_tail(tail, &var tails)
            } else {
                bt = self.check_block(block, TC_WANT_NONE, TcTail.Branch)
                if not self.is_never(bt) && not self.has_error(bt) {
                    slot = bt
                    self.note_tail(tail, &var tails)
                }
            }
            if not self.is_never(bt) {
                all_never = false
            }
            k = k + 1
        }
        if stmt {
            if has_else && all_never {
                let t = self.never_type()
                return self.set_type(e, t, false)
            }
            let t = self.void_type()
            return self.set_type(e, t, false)
        }
        if all_never {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        if slot < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.set_type(e, slot, false)
    }

    // The expression block `b` ends in, which is its value, or -1.
    func block_tail(&self, b: Int) -> Int {
        if b < 0 {
            return -1
        }
        if not self.has_alt(b, Alt.Stmt_Block) {
            if res_is_statement_alt(self.node_alt(b)) {
                return -1
            }
            return b
        }
        var last = -1
        let n = self.child_count(b)
        var k = 0
        while k < n {
            let c = self.child(b, k)
            if not self.is_leaf(c) {
                last = c
            }
            k = k + 1
        }
        if last >= 0 && self.has_alt(last, Alt.Stmt_Expr) {
            return self.res.first_node_child(last)
        }
        return -1
    }

    // Whether a value branch's later arm, ending in `tail`, is typed on its
    // own and merged, rather than against the arms before it: the arms so far
    // merged into an integer, and the tail types itself, so it may be the
    // wider arm the others widen into (spec, "Value-branch arms are
    // transfers").
    func arm_merges(&self, tail: Int, merged: Int) -> Bool {
        tail >= 0 && self.is_integer(merged) && not self.needs_expectation(tail)
    }

    // Whether a value branch with no expected type checks the arm ending in
    // `tail` after the others: a bare-literal arm is a peer whose width is
    // undecided, so it adopts the type the other arms merge into, as an
    // operand adopts its peer's (spec, "Value-branch arms are transfers").
    // With every arm a literal, the first is typed on its own, as `Int`.
    func defers_arm(&self, tail: Int) -> Bool {
        tail >= 0 && self.is_constant_expr(tail)
    }

    func append_arms(&self, into: &var Vector<Int>, from: &Vector<Int>) {
        var k = 0
        while k < from.len() {
            try! into.push(from[k])
            k = k + 1
        }
    }

    // An `else if` arm's block, found without checking its head.
    func arm_block(&self, arm: Int) -> Int {
        let n = self.child_count(arm)
        var k = 0
        while k < n {
            let c = self.child(arm, k)
            if not self.is_leaf(c) && self.has_alt(c, Alt.Stmt_Block) {
                return c
            }
            k = k + 1
        }
        return -1
    }

    func note_tail(&self, tail: Int, tails: &var Vector<Int>) {
        if tail >= 0 {
            try! tails.push(tail)
        }
    }

    // Merges an arm of type `bt` ending in `tail` into the arms before it,
    // whose tails are `tails` and whose merged type is `merged`: the merged
    // type is the arm type every other widens into losslessly, and each arm
    // records its widening. Returns the merged type.
    func merge_arm(&var self, tail: Int, bt: Int, merged: Int, tails: &var Vector<Int>) -> Int {
        if self.is_never(bt) || self.has_error(bt) || bt == merged {
            self.note_tail(tail, &var tails)
            return merged
        }
        let allow = TcAllowance(optionals: 0, results: 0, erases: false, widens: true)
        if self.widens_losslessly(bt, merged) {
            let _ = self.coerce(tail, bt, merged, allow)
            self.note_tail(tail, &var tails)
            return merged
        }
        if self.widens_losslessly(merged, bt) {
            var k = 0
            while k < tails.len() {
                let earlier = tails[k]
                if self.final_type(earlier) == merged {
                    let _ = self.coerce(earlier, merged, bt, allow)
                }
                k = k + 1
            }
            self.note_tail(tail, &var tails)
            return bt
        }
        var msg = StringBuilder()
        try! msg.append("the branches have no common type: `")
        try! msg.append(self.type_text(merged))
        try! msg.append("` and `")
        try! msg.append(self.type_text(bt))
        try! msg.append("`, and neither widens into the other without losing a value")
        self.refuse(tail, "type.mismatch", msg.build())
        merged
    }

    // An `else if` arm's head; returns its block.
    func check_arm_head(&var self, arm: Int) -> Int {
        var block = -1
        let n = self.child_count(arm)
        var k = 0
        while k < n {
            let c = self.child(arm, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else {
                    self.check_if_head(c)
                }
            }
            k = k + 1
        }
        block
    }

    // A branch that produced no value where one is wanted.
    func check_branch_value(&var self, block: Int, bt: Int, slot: Int) {
        if self.is_void(bt) && not self.is_void(slot) && not self.has_error(slot) {
            var msg = StringBuilder()
            try! msg.append("this branch produces no value, and the branches merge into `")
            try! msg.append(self.type_text(slot))
            try! msg.append("`")
            self.refuse(block, "type.mismatch", msg.build())
        }
    }

    // An `if` arm's head: a condition, `let x = e`, or `borrow let x = e`.
    func check_if_head(&var self, head: Int) {
        let binding = self.has_alt(head, Alt.Expr_OptionalBinding_Let) || self.has_alt(head, Alt.Expr_OptionalBinding_Var) || self.has_alt(head, Alt.Borrow_Unwrap_Let) || self.has_alt(head, Alt.Borrow_Unwrap_Var)
        if binding && self.binds_chain_assignment(head) {
            self.not_in_slice(head, Alt.Stmt_BindingSubject_ChainAssign)
            return
        }
        if self.has_alt(head, Alt.Expr_OptionalBinding_Let) || self.has_alt(head, Alt.Expr_OptionalBinding_Var) {
            let target = self.res.first_node_child(head)
            let subject = self.res.last_node_child(head)
            self.check_optional_binding(target, subject)
            return
        }
        if self.has_alt(head, Alt.Borrow_Unwrap_Let) || self.has_alt(head, Alt.Borrow_Unwrap_Var) {
            self.check_borrow_unwrap(head)
            return
        }
        self.check_condition(head)
    }

    // `let x = e` in an `if`, `while` or `guard` head: `e` is an Optional,
    // and `x` its payload, copied out of a place (design 131).
    func check_optional_binding(&var self, target: Int, subject: Int) {
        let _ = self.expr(subject, TC_WANT_NONE)
        self.set_use(subject, TcUse.Test)
        let t = self.through_refs(subject)
        if self.has_error(t) {
            let poisoned = self.error_type
            self.bind_target(target, poisoned, TcOrigin.Temporary)
            return
        }
        if not self.is_optional(t) {
            self.refuse_operand(subject, "an optional binding unwraps an Optional", t)
            let poisoned = self.error_type
            self.bind_target(target, poisoned, TcOrigin.Temporary)
            return
        }
        let payload = self.arg_of(t, 0)
        let from = if self.expr_place[subject] { TcOrigin.Place } else { TcOrigin.Temporary }
        self.bind_target(target, payload, from)
    }

    // `if borrow let x = e` and `while borrow var x = e`: `e` is an optional
    // place, and `x` a place of its payload.
    func check_borrow_unwrap(&var self, head: Int) {
        let target = self.res.first_node_child(head)
        let subject = self.res.last_node_child(head)
        let exclusive = self.has_alt(head, Alt.Borrow_Unwrap_Var)
        let _ = self.expr(subject, TC_WANT_NONE)
        if exclusive {
            self.set_use(subject, TcUse.BorrowVar)
        } else {
            self.set_use(subject, TcUse.Borrow)
        }
        let t = self.through_refs(subject)
        var payload = self.error_type
        if not self.has_error(t) {
            if self.is_optional(t) {
                payload = self.arg_of(t, 0)
            } else {
                self.refuse_operand(subject, "`borrow` unwraps an optional place", t)
            }
        }
        self.bind_borrow(target, payload, exclusive)
    }

    // A `borrow let` or `borrow var` binding of a place of type `t`.
    func bind_borrow(&var self, target: Int, t: Int, exclusive: Bool) {
        let leaf = self.res.first_leaf(target)
        if leaf >= 0 {
            self.local_types[leaf] = t
        }
        let _ = self.set_type(target, t, true)
        if exclusive {
            self.set_use(target, TcUse.BorrowVar)
        } else {
            self.set_use(target, TcUse.Borrow)
        }
    }

    // `match`: the scrutinee, then each arm's pattern, guard and body. With
    // a value wanted, the arms merge as `if` branches do, bare-literal arms
    // last.
    func match_expr(&var self, e: Int, want: Int) -> Int {
        let scrutinee = self.res.first_node_child(e)
        let _ = self.expr(scrutinee, TC_WANT_NONE)
        self.set_use(scrutinee, TcUse.Test)
        let t = self.through_refs(scrutinee)
        let from = self.scrutinee_origin(scrutinee, t)
        let stmt = want == TC_WANT_STMT
        var slot = -1
        if want >= 0 {
            slot = want
        }
        var order = Vector<Int>()
        var deferred = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let arm = self.child(e, k)
            k = k + 1
            if not self.has_alt(arm, Alt.Expr_MatchArm) {
                continue
            }
            let arm_body = self.res.last_node_child(arm)
            let arm_tail = self.block_tail(arm_body)
            if not stmt && want < 0 && self.defers_arm(arm_tail) {
                try! deferred.push(arm)
            } else {
                try! order.push(arm)
            }
        }
        self.append_arms(&var order, &deferred)
        var tails = Vector<Int>()
        var all_never = true
        let any_arm = order.len() > 0
        k = 0
        while k < order.len() {
            let arm = order[k]
            k = k + 1
            let pattern = self.res.first_node_child(arm)
            let body = self.res.last_node_child(arm)
            self.check_pattern(pattern, t, from)
            let an = self.child_count(arm)
            var j = 0
            while j < an {
                let c = self.child(arm, j)
                if c != pattern && c != body && not self.is_leaf(c) {
                    self.check_condition(c)
                }
                j = j + 1
            }
            let tail = self.block_tail(body)
            var bt = -1
            if not stmt && want < 0 && slot >= 0 && self.arm_merges(tail, slot) {
                bt = self.arm_body(body, false, -1)
                slot = self.merge_arm(tail, bt, slot, &var tails)
            } else {
                bt = self.arm_body(body, stmt, slot)
                if not stmt && not self.is_never(bt) && not self.has_error(bt) {
                    if slot < 0 {
                        slot = bt
                    }
                    self.note_tail(tail, &var tails)
                }
            }
            if not self.is_never(bt) {
                all_never = false
            }
        }
        if all_never && any_arm {
            let t2 = self.never_type()
            return self.set_type(e, t2, false)
        }
        if stmt {
            let v = self.void_type()
            return self.set_type(e, v, false)
        }
        if slot < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.set_type(e, slot, false)
    }

    // A match arm's body: a block, a statement, or an expression.
    func arm_body(&var self, body: Int, stmt: Bool, slot: Int) -> Int {
        if self.has_alt(body, Alt.Stmt_Block) {
            if stmt {
                return self.check_block(body, TC_WANT_STMT, TcTail.Branch)
            }
            if slot >= 0 {
                let bt = self.check_block(body, slot, TcTail.Branch)
                self.check_branch_value(body, bt, slot)
                return bt
            }
            return self.check_block(body, TC_WANT_NONE, TcTail.Branch)
        }
        if res_is_statement_alt(self.node_alt(body)) {
            if self.check_statement(body) {
                return self.never_type()
            }
            return self.void_type()
        }
        if stmt {
            let t = self.expr(body, TC_WANT_STMT)
            self.consume(body)
            self.check_discarded(body)
            return t
        }
        if slot >= 0 {
            return self.check_branch(body, slot)
        }
        let _ = self.expr(body, TC_WANT_NONE)
        self.consume(body)
        self.final_type(body)
    }

    // `while cond { }` and `while { }`, which diverges when nothing breaks it.
    func while_expr(&var self, e: Int) -> Int {
        let infinite = self.has_alt(e, Alt.Expr_While_Infinite)
        try! self.loop_breaks.push(0)
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    let _ = self.check_block(c, TC_WANT_STMT, TcTail.Plain)
                } else {
                    self.check_condition(c)
                }
            }
            k = k + 1
        }
        let breaks = self.pop_loop()
        if infinite && breaks == 0 {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // The innermost loop's count of `break`s, as it closes.
    func pop_loop(&var self) -> Int {
        let depth = self.loop_breaks.len()
        if depth == 0 {
            return 0
        }
        let breaks = self.loop_breaks[depth - 1]
        var kept = Vector<Int>()
        var k = 0
        while k + 1 < depth {
            try! kept.push(self.loop_breaks[k])
            k = k + 1
        }
        self.loop_breaks = move kept
        breaks
    }

    // `while let x = e { }`.
    func while_let_expr(&var self, e: Int) -> Int {
        let target = self.res.first_node_child(e)
        try! self.loop_breaks.push(0)
        var subject = -1
        var block = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if c != target && not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else if subject < 0 {
                    subject = c
                }
            }
            k = k + 1
        }
        self.check_optional_binding(target, subject)
        let _ = self.check_block(block, TC_WANT_STMT, TcTail.Plain)
        let _ = self.pop_loop()
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // `for x in seq { }`: the head is borrowed for the whole loop, and each
    // item is what its iterator's `next` hands out (SL:borrowing §2.6).
    func for_expr(&var self, e: Int) -> Int {
        let target = self.res.first_node_child(e)
        let body = self.res.last_node_child(e)
        var seq = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if c != target && c != body && not self.is_leaf(c) {
                seq = c
            }
            k = k + 1
        }
        let _ = self.expr(seq, TC_WANT_NONE)
        self.set_use(seq, TcUse.Borrow)
        let t = self.through_refs(seq)
        let item = self.iterator_item(e, seq, t)
        self.bind_target(target, item, TcOrigin.Temporary)
        try! self.loop_breaks.push(0)
        let _ = self.check_block(body, TC_WANT_STMT, TcTail.Plain)
        let _ = self.pop_loop()
        let v = self.void_type()
        self.set_type(e, v, false)
    }

    // What a `for` over a `t` hands out: the payload of its `next`'s
    // Optional, recorded as the loop's target.
    func iterator_item(&var self, e: Int, seq: Int, t: Int) -> Int {
        if self.has_error(t) {
            return self.error_type
        }
        let d = self.nominal_decl(t)
        let next_name = self.res.intern("next")
        let m = self.current
        let found = self.members_named(d, next_name, m)
        var k = 0
        while k < found.len() {
            let at = found[k]
            if self.is_method_member(at, false) {
                let member = self.members[at]
                self.build_decl(member.decl)
                let s = self.sigs[member.decl]
                let sub = self.member_subst(at, t)
                let result = self.subst(s.result, &sub)
                if self.is_optional(result) {
                    let none = Vector<Int>()
                    let _ = self.record_call(e, member.decl, TcRole.Iterator, t, &none)
                    return self.arg_of(result, 0)
                }
            }
            k = k + 1
        }
        var msg = StringBuilder()
        try! msg.append("`for` walks an iterator, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no `next` that hands out an Optional")
        self.refuse(seq, "type.mismatch", msg.build())
        self.error_type
    }

    // `borrow let x = place, var y = place { }`: each binding a place, then
    // the block, whose tail is the construct's value.
    func borrow_block(&var self, e: Int, want: Int) -> Int {
        var block = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.has_alt(c, Alt.Borrow_Binding_Let) || self.has_alt(c, Alt.Borrow_Binding_Var) {
                let target = self.res.first_node_child(c)
                let place = self.res.last_node_child(c)
                let exclusive = self.has_alt(c, Alt.Borrow_Binding_Var)
                let outer = self.borrow_head
                self.borrow_head = place
                let _ = self.expr(place, TC_WANT_NONE)
                self.borrow_head = outer
                if tc_contains(&self.skipped, place) {
                    // The head is outside the slice, so the block that
                    // borrows through it is too.
                    try! self.skipped.push(e)
                    let poisoned = self.error_type
                    return self.set_type(e, poisoned, false)
                }
                if exclusive {
                    self.set_use(place, TcUse.BorrowVar)
                } else {
                    self.set_use(place, TcUse.Borrow)
                }
                let pt = self.through_refs(place)
                if not self.has_error(pt) && not self.expr_place[place] {
                    self.refuse_not_a_place(place)
                }
                self.bind_borrow(target, pt, exclusive)
            } else if self.has_alt(c, Alt.Stmt_Block) {
                block = c
            }
        }
        var bw = TC_WANT_NONE
        if want == TC_WANT_STMT {
            bw = TC_WANT_STMT
        }
        let t = self.check_block(block, bw, TcTail.Plain)
        self.set_type(e, t, false)
    }

    // `borrow place` and `borrow var place` in a statement: the place,
    // borrowed for the statement.
    func borrow_place(&var self, e: Int, exclusive: Bool) -> Int {
        let inner = self.res.first_node_child(e)
        let t = self.expr(inner, TC_WANT_NONE)
        self.set_use(inner, TcUse.Project)
        let place = self.expr_place[inner]
        let ft = self.final_type(inner)
        self.set_type(e, ft, place)
    }

    // `borrow PLACE` or `borrow var PLACE` where a reference parameter
    // expects it: the place is passed by reference, `&` or `&var`, for the
    // call (SL:borrowing §2.2).
    func borrow_place_argument(&var self, e: Int) {
        let exclusive = self.has_alt(e, Alt.Borrow_Place_Var)
        let inner = self.res.first_node_child(e)
        let _ = self.expr(inner, TC_WANT_NONE)
        if exclusive {
            self.set_use(inner, TcUse.BorrowVar)
        } else {
            self.set_use(inner, TcUse.Borrow)
        }
        let ft = self.through_refs(inner)
        if self.has_error(ft) {
            let _ = self.set_type(e, ft, false)
            return
        }
        if exclusive && not self.expr_place[inner] {
            self.refuse_not_a_place(inner)
        }
        let r = self.mk_ref(exclusive, ft)
        let _ = self.set_type(e, r, false)
    }
}

// What a candidate of a call is.
public enum TcCandKind {
    // A function, method, requirement or init, with its own signature.
    case Function,
    // A struct's memberwise construction: its fields are the parameters.
    case Memberwise,
    // An enum case's construction: its payload fields are the parameters.
    case Case
}

// One candidate a call may mean: the declaration, the member-table entry it
// came from (-1 for none), and the type a member is instantiated at (-1 when
// that is what inference solves, or for a free function).
public struct TcCand {
    public decl: Int
    public kind: TcCandKind
    public member: Int
    public owner: Int
}

// A call's arguments: each value expression, and its label's name, or -1.
public struct TcArgs {
    public values: Vector<Int>
    public labels: Vector<Int>
}

extension TcArgs: NoCopy {}

// How a call's arguments bind to one candidate's parameters: the parameter
// each argument binds, and why binding failed.
public struct TcBind {
    public arg_param: Vector<Int>
    public status: Int
    public detail: Int
}

extension TcBind: NoCopy {}

static TC_BIND_OK: Int = 0
static TC_BIND_TOO_MANY: Int = 1
static TC_BIND_MISSING: Int = 2
static TC_BIND_UNKNOWN_LABEL: Int = 3
static TC_BIND_BACKWARD: Int = 4
static TC_BIND_REPEATED: Int = 5

// Calls.
extension TcProgram {
    // A call. Resolve classified its head once; the class decides where the
    // candidates come from, the overload filter picks one, and inference
    // instantiates it.
    func call_expr(&var self, e: Int, want: Int) -> Int {
        let callee = self.res.first_node_child(e)
        // The types its head writes are the body's whichever way the call is
        // resolved or refused, so every one is built here, once.
        let _ = self.explicit_type_args(callee)
        if self.has_alt(callee, Alt.Expr_Member) {
            let head_base = self.res.first_node_child(callee)
            let _ = self.explicit_type_args(head_base)
        }
        let at = self.res_call_at[e]
        if at < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let rc = self.res.calls[at]
        let args = self.call_args(e, callee)
        match rc.classification {
            case Overload -> self.free_call(e, callee, rc.binding, &args),
            case Init -> self.init_call(e, callee, rc.binding, &args, want),
            case Method -> self.method_call(e, callee, &args),
            case StaticMethod -> self.static_call(e, callee, rc.binding, &args),
            case Case -> self.case_call(e, callee, rc.binding.decl, &args, want),
            case ImplicitCase -> self.implicit_case_call(e, callee, rc.binding.name, &args, want),
            case Local -> self.value_call(e, callee, &args),
            case Value -> self.value_call(e, callee, &args),
            case TypeParam -> self.type_param_call(e, rc.binding, &args)
        }
    }

    // `A()` for a type parameter: a value of whatever type instantiates it,
    // the zero-sized allocator a std body builds (a construction that takes
    // arguments is outside the slice).
    func type_param_call(&var self, e: Int, b: ResBinding, args: &TcArgs) -> Int {
        let owner = self.param_owner(b.node)
        let index = self.param_index(b.node)
        if owner < 0 || args.values.len() > 0 {
            if owner >= 0 {
                self.not_in_slice(e, Alt.Expr_Call_Paren)
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let t = self.mk_param(owner, index)
        self.record_builtin(e, -1, TcRole.Builtin, "init")
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // A call's arguments, positional, labeled and trailing.
    func call_args(&var self, e: Int, callee: Int) -> TcArgs {
        var values = Vector<Int>()
        var labels = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == callee || self.is_leaf(c) {
                continue
            }
            if self.has_alt(c, Alt.Expr_Argument_Positional) {
                try! values.push(self.res.first_node_child(c))
                try! labels.push(-1)
            } else if self.has_alt(c, Alt.Expr_Argument_Labelled) {
                let leaf = self.res.first_leaf(c)
                let label = self.text(m, leaf)
                try! values.push(self.res.last_node_child(c))
                try! labels.push(self.res.intern(label))
            } else {
                try! values.push(c)
                try! labels.push(-1)
            }
        }
        TcArgs(values: move values, labels: move labels)
    }

    // The type arguments written on a call's head: `f<Int>(...)`,
    // `Vector<Int>()`, `x.f<T>(...)`.
    func explicit_type_args(&var self, callee: Int) -> Vector<Int> {
        var out = Vector<Int>()
        if callee < 0 {
            return move out
        }
        if not self.has_alt(callee, Alt.Expr_Name) && not self.has_alt(callee, Alt.Expr_Member) {
            return move out
        }
        let base = if self.has_alt(callee, Alt.Expr_Member) { self.res.first_node_child(callee) } else { -1 }
        let n = self.child_count(callee)
        var k = 0
        while k < n {
            let c = self.child(callee, k)
            k = k + 1
            if c == base || self.is_leaf(c) {
                continue
            }
            // A head's arguments are built once, when `call_expr` meets the
            // call, and read back here (the body verifier holds each to one
            // build).
            if self.type_builds[c] > 0 {
                try! out.push(self.node_types[c])
            } else if res_is_type_alt(self.node_alt(c)) {
                try! out.push(self.build_type(c))
            } else {
                let v = self.build_const(c)
                self.node_types[c] = v
                self.type_builds[c] += 1
                try! out.push(v)
            }
        }
        move out
    }

    // A free function call: an overload set, or a builtin function.
    func free_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs) -> Int {
        let decls = self.free_candidates(b)
        if decls.len() == 1 {
            let only = self.res.decls[decls[0]]
            if only.kind == ResDeclKind.BuiltinFunc {
                return self.builtin_call(e, callee, decls[0], &args)
            }
        }
        var cands = Vector<TcCand>()
        var k = 0
        while k < decls.len() {
            let d = decls[k]
            let info = self.res.decls[d]
            if info.kind != ResDeclKind.BuiltinFunc {
                self.build_decl(d)
                try! cands.push(TcCand(decl: d, kind: TcCandKind.Function, member: -1, owner: -1))
            }
            k = k + 1
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, -1, TC_WANT_NONE)
    }

    // `x.f(...)`: a method of the receiver's type, or of a type parameter's
    // bounds. The receiver is borrowed as the method's receiver declares; a
    // `borrows` accessor's use site decides (`settle_places`).
    func method_call(&var self, e: Int, callee: Int, args: &TcArgs) -> Int {
        let base = self.res.first_node_child(callee)
        let leaf = self.res.first_leaf(callee)
        let m = self.current
        let text = self.text(m, leaf)
        let name = self.res.intern(text)
        let bt = self.expr(base, TC_WANT_NONE)
        let rt = self.final_type(base)
        let inner = self.referent(rt)
        let t = if inner >= 0 { inner } else { rt }
        if self.has_error(t) {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let tk = self.kind_of(t)
        if (tk == TcKind.Array || tk == TcKind.Slice) && (text.equals("len") || text.equals("swap")) {
            return self.sequence_method(e, base, inner, t, &text, &args)
        }
        var cands = Vector<TcCand>()
        self.method_candidates(&var cands, t, name, false)
        let field = self.function_field(t, name)
        if field >= 0 {
            if cands.len() > 0 {
                self.refuse_field_method(e, base, field, &cands, &text)
                self.set_use(base, TcUse.Borrow)
                self.type_args_alone(&args)
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            return self.field_call(e, callee, base, bt, inner, field, t, &args)
        }
        if cands.len() == 0 && self.is_builtin_method(t, &text) {
            return self.builtin_method(e, base, inner, t, &text, &args)
        }
        let outside = self.method_outside_slice(e, t, name, &text, &cands, &args)
        if outside.len() > 0 {
            self.set_use(base, TcUse.Borrow)
            self.not_yet(e, outside)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if cands.len() == 0 {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            self.refuse_no_method(leaf, t, name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let explicit = self.explicit_type_args(callee)
        let result = self.resolve_call(e, &cands, &args, &explicit, base, TC_WANT_NONE)
        result
    }

    // What names method call `e`, of `name` on type `t`, as outside the
    // bootstrap slice, or "" when it is not: a call on an existential, a
    // method `Box` or `Arc` forwards to its payload, `TaskGroup.spawn`, and a
    // `borrow` block's head that lends through a closure parameter rather
    // than as a `borrows` accessor, as today's `Mutex.lock` does.
    func method_outside_slice(&var self, e: Int, t: Int, name: Int, text: &String, cands: &Vector<TcCand>,
                              args: &TcArgs) -> String {
        let kind = self.kind_of(t)
        let d = self.nominal_decl(t)
        if cands.len() == 0 {
            if kind == TcKind.Any {
                return "a method call on `any Trait`"
            }
            if d >= 0 && d == self.known.task_group && text.equals("spawn") {
                return "`TaskGroup.spawn`"
            }
            if d >= 0 && d == self.known.interior {
                return "a method of the interior cell `UnsafeMutableInterior`"
            }
            let forwarding = d >= 0 && (d == self.known.box || d == self.known.arc)
            if forwarding && self.nominal_args(t).len() > 0 {
                let payload = self.arg_of(t, 0)
                var forwarded = Vector<TcCand>()
                self.method_candidates(&var forwarded, payload, name, false)
                if forwarded.len() > 0 || self.kind_of(payload) == TcKind.Any {
                    if d == self.known.box {
                        return "a method `Box` forwards to its payload"
                    }
                    return "a method `Arc` forwards to its payload"
                }
            }
            return ""
        }
        if e != self.borrow_head {
            return ""
        }
        var k = 0
        while k < cands.len() {
            let c = cands[k]
            k = k + 1
            let s = self.sigs[c.decl]
            if (s.effects & TC_EFFECT_BORROWS) != 0 {
                return ""
            }
        }
        let first = cands[0]
        let s = self.sigs[first.decl]
        if s.param_count > args.values.len() {
            let p = self.params[s.param_first + s.param_count - 1]
            if self.kind_of(p.ty) == TcKind.Func {
                var what = StringBuilder()
                try! what.append("a `borrow` block over ")
                try! what.append(self.cand_text(first))
                try! what.append(", which lends through a closure parameter, not as a `borrows` accessor,")
                return what.build()
            }
        }
        ""
    }

    // The field named `name` of type `t` this module sees whose type is a
    // function type, or -1.
    func function_field(&var self, t: Int, name: Int) -> Int {
        let d = self.nominal_decl(t)
        if d < 0 {
            return -1
        }
        let m = self.current
        let found = self.members_named(d, name, m)
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            k = k + 1
            let mi = self.res.decls[member.decl]
            if mi.kind != ResDeclKind.Field {
                continue
            }
            let ft = self.field_type(t, member.decl)
            if self.kind_of(ft) == TcKind.Func {
                return member.decl
            }
        }
        return -1
    }

    // Field `f`'s type in nominal type `t`, its arguments substituted.
    func field_type(&var self, t: Int, f: Int) -> Int {
        self.build_decl(f)
        let d = self.nominal_decl(t)
        let written = self.sigs[f].result
        let s = tc_args_subst(d, self.nominal_args(t))
        self.subst(written, &s)
    }

    // `x.f(...)` where `f` is a field holding a function and no method of
    // that name is seen: the call of the field's value (SL:open-questions
    // D16).
    func field_call(&var self, e: Int, callee: Int, base: Int, bt: Int, inner: Int, field: Int, t: Int,
                    args: &TcArgs) -> Int {
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        self.set_use(base, TcUse.Project)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        let ft = self.field_type(t, field)
        let _ = self.set_type(callee, ft, place)
        self.set_use(callee, TcUse.Borrow)
        self.call_function_value(e, callee, ft, &args)
    }

    // `x.f(...)` where `f` names both a field holding a function and a
    // method this module sees: neither is chosen silently (D16).
    func refuse_field_method(&var self, e: Int, base: Int, field: Int, cands: &Vector<TcCand>, text: &String) {
        let m = self.current
        var receiver = "value"
        if self.has_alt(base, Alt.Expr_Name) || self.has_alt(base, Alt.Expr_Self) {
            let leaf = self.res.first_leaf(base)
            receiver = self.text(m, leaf)
        }
        let method = cands[0]
        let method_text = self.cand_text(method)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` names both the field `")
        try! msg.append(self.res.decl_path(field))
        try! msg.append("`, which holds a function, and the method ")
        try! msg.append(method_text)
        try! msg.append(", so this call could mean either; to call the field's function, bind it first: `let g = ")
        try! msg.append(receiver)
        try! msg.append(".")
        try! msg.append(text)
        try! msg.append("; g(...)`")
        self.refuse(e, "call.field-method-ambiguous", msg.build())
    }

    // Whether `t` answers method `text` with no declaration to find: an
    // Optional's `take`, `is_some` and `is_none` (design 131), and `copy`
    // on a type of the Copy or ExplicitCopy tier.
    func is_builtin_method(&var self, t: Int, text: &String) -> Bool {
        if self.is_optional(t) && (text.equals("take") || text.equals("is_some") || text.equals("is_none")) {
            return true
        }
        text.equals("copy") && not self.has_error(t)
    }

    // A method no declaration writes: `o.take()` swaps `None` into the place
    // and hands out what was there; `o.is_some()` and `o.is_none()` read the
    // tag alone; `x.copy()` duplicates a Copy or ExplicitCopy value, and is
    // refused for a NoCopy one.
    func builtin_method(&var self, e: Int, base: Int, inner: Int, t: Int, text: &String,
                        args: &TcArgs) -> Int {
        if args.values.len() > 0 {
            self.refuse(e, "call.arity", "this builtin method takes no arguments")
            self.type_args_alone(&args)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let exclusive = text.equals("take")
        let r = self.mk_ref(exclusive, t)
        if exclusive {
            if not self.expr_place[base] && inner < 0 {
                self.refuse_not_a_place(base)
            }
            self.add_adjust(base, TcAdjustKind.BorrowVar, r)
            self.set_use(base, TcUse.BorrowVar)
        } else {
            self.add_adjust(base, TcAdjustKind.Borrow, r)
            self.set_use(base, TcUse.Borrow)
        }
        var spelling = "copy"
        if text.equals("take") {
            spelling = "take"
        } else if text.equals("is_some") {
            spelling = "is_some"
        } else if text.equals("is_none") {
            spelling = "is_none"
        }
        self.record_builtin(e, -1, TcRole.Builtin, spelling)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        if text.equals("take") {
            return self.set_type(e, t, false)
        }
        if text.equals("copy") {
            let info = self.types.ty(t)
            let nocopy = info.kind == TcKind.Nominal && self.tier_of_decl(info.decl).base == TC_TIER_NOCOPY
            if nocopy || info.kind == TcKind.Any {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.type_text(t))
                try! msg.append("` is NoCopy, so it has no `copy()`; move it instead")
                self.refuse(e, "member.unknown", msg.build())
            }
            return self.set_type(e, t, false)
        }
        let b = self.bool_type()
        self.set_type(e, b, false)
    }

    // A fixed array's or a slice's builtin `len()` and `swap(i, j)`: the one
    // reads, the other writes, its receiver.
    func sequence_method(&var self, e: Int, base: Int, inner: Int, t: Int, text: &String,
                         args: &TcArgs) -> Int {
        let swap = text.equals("swap")
        let wanted = if swap { 2 } else { 0 }
        let i = self.int_type()
        var k = 0
        while k < args.values.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label", "a builtin method's arguments take no labels")
            }
            self.check_argument(args.values[k], i)
            k = k + 1
        }
        if args.values.len() != wanted {
            self.refuse(e, "call.arity", "`len()` takes no arguments, and `swap(i, j)` two indices")
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let is_array = self.kind_of(t) == TcKind.Array
        if swap {
            if is_array {
                let r = self.mk_ref(true, t)
                self.add_adjust(base, TcAdjustKind.BorrowVar, r)
            }
            self.set_use(base, TcUse.BorrowVar)
            self.record_builtin(e, -1, TcRole.Builtin, "swap")
            let v = self.void_type()
            return self.set_type(e, v, false)
        }
        if is_array {
            let r = self.mk_ref(false, t)
            self.add_adjust(base, TcAdjustKind.Borrow, r)
        }
        self.set_use(base, TcUse.Borrow)
        self.record_builtin(e, -1, TcRole.Builtin, "len")
        self.set_type(e, i, false)
    }

    // The instance (or, with `statics`, static) methods named `name` that
    // type `t` offers: its member table's, or its bounds' requirements for a
    // type parameter or a trait's `Self`.
    func method_candidates(&var self, out: &var Vector<TcCand>, t: Int, name: Int, statics: Bool) {
        let info = self.types.ty(t)
        let m = self.current
        if info.kind == TcKind.Nominal {
            let found = self.members_named(info.decl, name, m)
            var k = 0
            while k < found.len() {
                let at = found[k]
                if self.is_method_member(at, statics) {
                    let member = self.members[at]
                    self.build_decl(member.decl)
                    try! out.push(TcCand(decl: member.decl, kind: TcCandKind.Function, member: at,
                                         owner: t))
                }
                k = k + 1
            }
            if out.len() == 0 {
                self.primitive_requirements(&var out, t, info.decl, name, statics)
            }
            return
        }
        var reqs = Vector<Int>()
        if info.kind == TcKind.Param {
            let ext = self.current_ext
            reqs = self.bound_requirements(info.decl, info.a, name, ext)
        } else if info.kind == TcKind.SelfType {
            let all = self.trait_and_ancestors(info.decl)
            var j = 0
            while j < all.len() {
                let members = self.members_of(all[j])
                var r = 0
                while r < members.len() {
                    let req = members[r]
                    let ri = self.res.decls[req]
                    if ri.kind == ResDeclKind.Requirement && ri.name == name {
                        try! reqs.push(req)
                    }
                    r = r + 1
                }
                j = j + 1
            }
        }
        var k = 0
        while k < reqs.len() {
            let req = reqs[k]
            self.build_decl(req)
            let s = self.sigs[req]
            let is_static = (s.flags & TC_FLAG_STATIC) != 0
            if is_static == statics {
                try! out.push(TcCand(decl: req, kind: TcCandKind.Function, member: -1, owner: t))
            }
            k = k + 1
        }
    }

    // The methods named `name` a type answers through a conformance no
    // extension writes: a builtin type's builtin ones (design 109), `n.format`
    // and `7.to_string()` for Printable, `equals`, `compare`, `hash`; and a
    // trivially copyable type's automatic `Equatable` and `Hashable`.
    func primitive_requirements(&var self, out: &var Vector<TcCand>, t: Int, d: Int, name: Int, statics: Bool) {
        var traits = Vector<Int>()
        try! traits.push(self.known.printable)
        try! traits.push(self.known.equatable)
        try! traits.push(self.known.comparable)
        try! traits.push(self.known.hashable)
        let primitive = self.is_primitive_decl(d)
        var k = 0
        while k < traits.len() {
            let tr = traits[k]
            k = k + 1
            if tr < 0 {
                continue
            }
            var granted = false
            if primitive {
                granted = self.primitive_grants(d, tr)
            } else if tr == self.known.equatable || tr == self.known.hashable {
                granted = not self.has_conformance(d, tr) && self.is_trivial(t, 0)
            }
            if not granted {
                continue
            }
            let members = self.members_of(tr)
            var r = 0
            while r < members.len() {
                let req = members[r]
                r = r + 1
                let ri = self.res.decls[req]
                if ri.kind != ResDeclKind.Requirement || ri.name != name {
                    continue
                }
                self.build_decl(req)
                let s = self.sigs[req]
                let is_static = (s.flags & TC_FLAG_STATIC) != 0
                if is_static == statics {
                    try! out.push(TcCand(decl: req, kind: TcCandKind.Function, member: -1, owner: t))
                }
            }
        }
    }

    // `T.f(...)`: a static method of a named type, or of a type parameter's
    // bounds.
    func static_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs) -> Int {
        let base = self.res.first_node_child(callee)
        let leaf = self.res.first_leaf(callee)
        let m = self.current
        let text = self.text(m, leaf)
        let name = self.res.intern(text)
        var t = -1
        if b.decl >= 0 {
            let written = self.explicit_type_args(base)
            t = self.named_owner(b.decl, &written, leaf)
        } else if b.node >= 0 {
            let owner = self.param_owner(b.node)
            let index = self.param_index(b.node)
            if owner >= 0 {
                t = self.mk_param(owner, index)
            }
        }
        if t < 0 || self.has_error(t) {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.is_box(t) && text.equals("make") {
            let payload = self.arg_of(t, 0)
            if self.kind_of(payload) == TcKind.Any {
                // The erasing construction, which std's `Result`-returning
                // `make` does not declare.
                self.not_yet(e, "`Box<any Trait>.make`")
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
        }
        if text.equals("from") {
            if self.is_integer(t) {
                return self.integer_from(e, t, &args)
            }
            let d = self.nominal_decl(t)
            if self.is_enum_decl(d) && self.sigs[d].result >= 0 {
                return self.raw_from(e, d, t, &args)
            }
        }
        var cands = Vector<TcCand>()
        self.method_candidates(&var cands, t, name, true)
        if cands.len() == 0 {
            self.type_args_alone(&args)
            self.refuse_no_method(leaf, t, name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, -1, TC_WANT_NONE)
    }

    // `T.from(x)`, the checked conversion to `T?`, and `T.from(truncating:
    // x)`, which keeps the low bits: integer `T`, integer `x` (design 170).
    // The argument takes no expectation, since out of range is what `from`
    // answers.
    func integer_from(&var self, e: Int, t: Int, args: &TcArgs) -> Int {
        let truncating_name = self.res.intern("truncating")
        var truncating = false
        if args.values.len() != 1 {
            self.refuse(e, "call.arity", "an integer's `from` takes one argument")
            self.type_args_alone(&args)
        } else {
            let label = args.labels[0]
            if label == truncating_name {
                truncating = true
            } else if label >= 0 {
                self.refuse(args.values[0], "call.label",
                            "an integer's `from` takes an unlabeled argument, or `truncating:`")
            }
            let v = args.values[0]
            let _ = self.expr(v, TC_WANT_NONE)
            self.consume(v)
            let vt = self.through_refs(v)
            if not self.has_error(vt) && not self.is_integer(vt) {
                self.refuse_operand(v, "an integer's `from` converts an integer", vt)
            }
        }
        let spelling = if truncating { "from(truncating:)" } else { "from" }
        self.record_builtin(e, -1, TcRole.Conversion, spelling)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        if truncating {
            return self.set_type(e, t, false)
        }
        let opt = self.mk_optional(t)
        self.set_type(e, opt, false)
    }

    // `E.from(raw: x)`: a raw-backed enum's case for a backing value, or
    // `None` (design 145); the member table holds it as synthesized.
    func raw_from(&var self, e: Int, d: Int, t: Int, args: &TcArgs) -> Int {
        let raw_name = self.res.intern("raw")
        let backing = self.sigs[d].result
        if args.values.len() != 1 {
            self.refuse(e, "call.arity", "`from(raw:)` takes one argument")
            self.type_args_alone(&args)
        } else {
            if args.labels[0] != raw_name {
                self.refuse(args.values[0], "call.label", "`from` of a raw-backed enum takes `raw:`")
            }
            self.check_argument(args.values[0], backing)
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, d, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.spelling = self.res.intern("from(raw:)")
        self.calls[at] = c
        let opt = self.mk_optional(t)
        self.set_type(e, opt, false)
    }

    // `A(x)` for a distinct alias `A` over `T`: `x` becomes an `A`, which
    // reads as its `T` (design 250 names `Byte(...)` the way in).
    func alias_construct(&var self, e: Int, alias: Int, args: &TcArgs) -> Int {
        let t = self.alias_type(alias, -1)
        if args.values.len() != 1 || args.labels[0] >= 0 {
            self.refuse(e, "call.arity", "an alias is constructed from one unlabeled value of the type it names")
            self.type_args_alone(&args)
        } else {
            self.check_argument(args.values[0], t)
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, alias, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.spelling = self.res.intern("alias")
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // Nominal `d` named where a static member or a construction is written:
    // with its written arguments, or its own parameters when it takes some
    // and none are written, which inference then solves.
    func named_owner(&var self, d: Int, written: &Vector<Int>, leaf: Int) -> Int {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if written.len() == 0 {
            if s.generic_count == 0 {
                return self.self_type_of(d)
            }
            return -1
        }
        if written.len() > s.generic_count {
            self.refuse_type_arity(leaf, d, written.len())
            return self.error_type
        }
        var args = Vector<Int>()
        var k = 0
        while k < s.generic_count {
            if k < written.len() {
                try! args.push(written[k])
            } else {
                let g = self.generics[s.generic_first + k]
                if g.default_type < 0 {
                    self.refuse_type_arity(leaf, d, written.len())
                    return self.error_type
                }
                try! args.push(g.default_type)
            }
            k = k + 1
        }
        self.mk_nominal(d, &args)
    }

    // `T(...)`: the type's `init`s, and a struct's memberwise construction
    // when every field is visible here. A generic type takes its arguments
    // from the head, from the expected type (a construction peels it), or
    // from inference.
    func init_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs, want: Int) -> Int {
        var d = -1
        if b.kind == ResBindKind.Decl && b.decl >= 0 {
            if self.is_nominal(b.decl) {
                d = b.decl
            } else {
                let info = self.res.decls[b.decl]
                if info.kind == ResDeclKind.Alias || info.kind == ResDeclKind.TypeAssign {
                    let aliased = self.alias_type(b.decl, -1)
                    d = self.nominal_decl(aliased)
                    let bare = d < 0 || self.is_primitive_decl(d)
                    if info.kind == ResDeclKind.Alias && bare && not self.has_error(aliased) {
                        return self.alias_construct(e, b.decl, &args)
                    }
                }
            }
        } else if b.kind == ResBindKind.SelfType && b.decl >= 0 && self.is_nominal(b.decl) {
            d = b.decl
        }
        let leaf = self.res.first_leaf(callee)
        if d < 0 || self.is_enum_decl(d) {
            self.type_args_alone(&args)
            if d >= 0 {
                self.refuse_not_a_value(callee, leaf)
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let written = self.explicit_type_args(callee)
        let m = self.current
        // A partial prefix pins the type's leading parameters and inference
        // solves the rest (spec, Generics).
        var pinned = Vector<Int>()
        var owner = -1
        if self.partial_prefix(d, &written, m) {
            pinned = tc_copy_ints(&written)
        } else {
            owner = self.named_owner(d, &written, leaf)
        }
        if owner < 0 && pinned.len() == 0 && want >= 0 && self.is_nominal_of(want, d) {
            owner = want
        }
        if owner >= 0 && self.has_error(owner) {
            self.type_args_alone(&args)
            return self.set_type(e, owner, false)
        }
        var cands = Vector<TcCand>()
        let inits = self.inits_of(d, m)
        var k = 0
        while k < inits.len() {
            let at = inits[k]
            let member = self.members[at]
            self.build_decl(member.decl)
            try! cands.push(TcCand(decl: member.decl, kind: TcCandKind.Function, member: at,
                                   owner: owner))
            k = k + 1
        }
        if self.is_struct_decl(d) && self.memberwise_visible(d, m) {
            try! cands.push(TcCand(decl: d, kind: TcCandKind.Memberwise, member: -1, owner: owner))
        }
        let builtin_module = self.res.builtin
        if cands.len() == 0 && self.res.decls[d].module == builtin_module {
            // `Atomic(v)`, `UnsafeMutableInterior(v)`, `UnsafeMemory<T, U>(a)`:
            // a builtin type's construction, which no declaration writes.
            var what = StringBuilder()
            try! what.append("constructing the builtin type `")
            try! what.append(self.res.decl_path(d))
            try! what.append("`")
            self.not_yet(e, what.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if cands.len() == 0 {
            self.type_args_alone(&args)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` has no `init` this module can call, and its fields are not all visible here")
            self.refuse(e, "call.no-match", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.resolve_call(e, &cands, &args, &pinned, -1, want)
    }

    // Whether the type arguments `written` on generic type `d`'s head are a
    // partial prefix inference completes: fewer than its parameters, a
    // parameter after them with no default, and no `init` module `viewer`
    // sees with type parameters of its own, which the prefix would mistake
    // for the type's.
    func partial_prefix(&var self, d: Int, written: &Vector<Int>, viewer: Int) -> Bool {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if written.len() == 0 || written.len() >= s.generic_count {
            return false
        }
        var undefaulted = false
        var k = written.len()
        while k < s.generic_count {
            let g = self.generics[s.generic_first + k]
            if g.default_type < 0 {
                undefaulted = true
            }
            k = k + 1
        }
        if not undefaulted {
            return false
        }
        let inits = self.inits_of(d, viewer)
        k = 0
        while k < inits.len() {
            let member = self.members[inits[k]]
            self.build_decl(member.decl)
            if self.sigs[member.decl].generic_count > 0 {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether module `viewer` sees every field of struct `d`.
    func memberwise_visible(&self, d: Int, viewer: Int) -> Bool {
        let first = self.member_first[d]
        let count = self.member_count[d]
        var k = first
        while k < first + count {
            let member = self.members[k]
            if member.source == TcSource.Declared && not self.member_seen(k, viewer) {
                return false
            }
            k = k + 1
        }
        true
    }

    // `E.Case(...)`: the case's payload. A generic enum takes its arguments
    // from its head, the expected type, or the payload.
    func case_call(&var self, e: Int, callee: Int, c: Int, args: &TcArgs, want: Int) -> Int {
        if c < 0 {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.res.decls[c].parent
        self.ensure_generics(d)
        var owner = self.written_enum_owner(callee, d)
        if owner >= 0 {
            if self.has_error(owner) {
                self.type_args_alone(&args)
                return self.set_type(e, owner, false)
            }
        } else if self.sigs[d].generic_count == 0 {
            owner = self.self_type_of(d)
        } else {
            let peeled = self.peel(want, TcClient.Construct, -1, d)
            if peeled >= 0 {
                owner = peeled
            }
        }
        var cands = Vector<TcCand>()
        try! cands.push(TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: owner))
        let none = Vector<Int>()
        self.resolve_call(e, &cands, &args, &none, -1, want)
    }

    // `.Case(...)`: a case of the enum its position expects.
    func implicit_case_call(&var self, e: Int, callee: Int, name: Int, args: &TcArgs, want: Int) -> Int {
        if want >= 0 && self.has_error(want) {
            self.type_args_alone(&args)
            return self.set_type(e, want, false)
        }
        if want < 0 {
            self.refuse_implicit_without_type(callee, name)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.nominal_decl(want)
        let c = self.case_named(d, name)
        if c < 0 {
            self.refuse_no_such_case(callee, name, want)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var cands = Vector<TcCand>()
        try! cands.push(TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: want))
        let none = Vector<Int>()
        self.resolve_call(e, &cands, &args, &none, -1, want)
    }

    // A function value's call: positional arguments against its type.
    func value_call(&var self, e: Int, callee: Int, args: &TcArgs) -> Int {
        let _ = self.expr(callee, TC_WANT_NONE)
        self.set_use(callee, TcUse.Borrow)
        let t = self.through_refs(callee)
        self.call_function_value(e, callee, t, &args)
    }

    // The call of `callee`, a value of type `t` already typed: its
    // arguments by position against the function type's parameters.
    func call_function_value(&var self, e: Int, callee: Int, t: Int, args: &TcArgs) -> Int {
        let fp = self.known.func_pointer
        if fp >= 0 && self.is_nominal_of(t, fp) {
            self.not_yet(e, "calling a `FuncPointer`")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.has_error(t) {
            self.type_args_alone(&args)
            return self.set_type(e, t, false)
        }
        if self.kind_of(t) != TcKind.Func {
            self.type_args_alone(&args)
            var msg = StringBuilder()
            try! msg.append("this is called, and it is a `")
            try! msg.append(self.type_text(t))
            try! msg.append("`, not a function")
            self.refuse(callee, "call.not-callable", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let info = self.types.ty(t)
        var k = 0
        while k < args.values.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label",
                            "a function value's parameters have no labels; pass this argument by position")
            }
            if k < info.count {
                let p = self.types.arg(t, k)
                self.check_argument(args.values[k], p)
            } else {
                let _ = self.expr(args.values[k], TC_WANT_NONE)
                self.consume(args.values[k])
            }
            k = k + 1
        }
        if args.values.len() != info.count {
            var msg = StringBuilder()
            try! msg.append("this function value takes ")
            try! msg.append(info.count)
            try! msg.append(" arguments, and ")
            try! msg.append(args.values.len())
            try! msg.append(" are passed")
            self.refuse(e, "call.arity", msg.build())
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, -1, TcRole.Value, t, &none)
        self.set_type(e, info.b, false)
    }

    // Types every argument with no expectation, where the call itself could
    // not be resolved, so each still has a type.
    func type_args_alone(&var self, args: &TcArgs) {
        var k = 0
        while k < args.values.len() {
            let v = args.values[k]
            if not self.is_typed(v) {
                let poisoned = self.error_type
                let _ = self.expr(v, poisoned)
            }
            self.consume(v)
            k = k + 1
        }
    }
}

// Candidates' parameters.
extension TcProgram {
    public func cand_param_count(&self, c: TcCand) -> Int {
        match c.kind {
            case Function -> self.sigs[c.decl].param_count,
            case Memberwise -> self.struct_fields(c.decl).len(),
            case Case -> {
                if self.res.decls[c.decl].node < 0 {
                    if self.case_has_payload(c.decl) {
                        return 1
                    }
                    return 0
                }
                self.sigs[c.decl].param_count
            }
        }
    }

    // A struct's fields, in declaration order.
    func struct_fields(&self, d: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let f = members[k]
            let info = self.res.decls[f]
            if info.kind == ResDeclKind.Field {
                try! out.push(f)
            }
            k = k + 1
        }
        move out
    }

    // The name of candidate `c`'s parameter `k`.
    public func cand_param_name(&var self, c: TcCand, k: Int) -> Int {
        match c.kind {
            case Function -> self.params[self.sigs[c.decl].param_first + k].name,
            case Memberwise -> {
                let fields = self.struct_fields(c.decl)
                self.res.decls[fields[k]].name
            },
            case Case -> {
                let info = self.res.decls[c.decl]
                if info.node < 0 {
                    let err_name = self.res.intern("Err")
                    if info.name == err_name && info.parent == self.known.result {
                        return self.res.intern("error")
                    }
                    return self.res.intern("value")
                }
                self.params[self.sigs[c.decl].param_first + k].name
            }
        }
    }

    // The type of candidate `c`'s parameter `k`, as its declaration writes
    // it.
    public func cand_param_type(&var self, c: TcCand, k: Int) -> Int {
        match c.kind {
            case Function -> self.params[self.sigs[c.decl].param_first + k].ty,
            case Memberwise -> {
                let fields = self.struct_fields(c.decl)
                self.build_decl(fields[k])
                self.sigs[fields[k]].result
            },
            case Case -> {
                let info = self.res.decls[c.decl]
                if info.node < 0 {
                    let err_name = self.res.intern("Err")
                    let index = if info.name == err_name { 1 } else { 0 }
                    return self.mk_param(info.parent, index)
                }
                self.params[self.sigs[c.decl].param_first + k].ty
            }
        }
    }

    public func cand_param_default(&self, c: TcCand, k: Int) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let s = self.sigs[c.decl]
        let param = self.params[s.param_first + k]
        param.has_default
    }

    // Whether candidate `c` is a C variadic extern, `(..., ...)`.
    func cand_variadic(&self, c: TcCand) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let s = self.sigs[c.decl]
        (s.flags & TC_FLAG_VARIADIC) != 0
    }

    // Whether candidate `c`'s arguments bind in order (a function's), or by
    // name in any order (an `init`'s, a construction's, a payload's; design
    // 66).
    public func cand_ordered(&self, c: TcCand) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let info = self.res.decls[c.decl]
        info.kind != ResDeclKind.Init
    }

    // The type declaration a construction candidate builds, or -1.
    public func cand_type_decl(&self, c: TcCand) -> Int {
        match c.kind {
            case Function -> {
                let info = self.res.decls[c.decl]
                if info.kind == ResDeclKind.Init && info.parent >= 0 {
                    return self.ext_target(info.parent)
                }
                return -1
            },
            case Memberwise -> c.decl,
            case Case -> self.res.decls[c.decl].parent
        }
    }

    // The declaration whose type parameters a call of `c` infers: the
    // candidate's own, or a construction's type when its arguments are not
    // known. -1 when there is nothing to infer.
    public func cand_generic_owner(&var self, c: TcCand) -> Int {
        if c.kind == TcCandKind.Function {
            let s = self.sigs[c.decl]
            if s.generic_count > 0 {
                return c.decl
            }
        }
        let td = self.cand_type_decl(c)
        if td >= 0 && c.owner < 0 {
            self.ensure_generic_list(td)
            if self.sigs[td].generic_count > 0 {
                return td
            }
        }
        if c.kind == TcCandKind.Function && c.owner < 0 && c.member >= 0 {
            let member = self.members[c.member]
            self.ensure_generic_list(member.type_decl)
            if self.sigs[member.type_decl].generic_count > 0 {
                return member.type_decl
            }
        }
        return -1
    }

    // The substitution that instantiates candidate `c` at its owner: the
    // owner's arguments for its type's parameters, `Self`, and a trait's
    // associated types for a requirement a default or derivation fills.
    public func cand_subst(&var self, c: TcCand) -> TcSubst {
        if c.owner < 0 {
            return TcSubst(self_type: -1, from_owner: -1, to_owner: -1, args_owner: -1,
                           args: Vector<Int>(), assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        if c.member >= 0 {
            return self.member_subst(c.member, c.owner)
        }
        let td = self.cand_type_decl(c)
        if td >= 0 {
            let args = self.nominal_args(c.owner)
            return TcSubst(self_type: c.owner, from_owner: -1, to_owner: -1, args_owner: td,
                           args: move args, assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        TcSubst(self_type: c.owner, from_owner: -1, to_owner: -1, args_owner: -1,
                args: Vector<Int>(), assoc_decls: Vector<Int>(), assoc_types: Vector<Int>())
    }

    // The substitution that instantiates member-table entry `k` at `owner`.
    public func member_subst(&var self, k: Int, owner: Int) -> TcSubst {
        let member = self.members[k]
        if member.source == TcSource.Default || member.source == TcSource.Synthesized {
            return self.owner_subst(owner)
        }
        let info = self.types.ty(owner)
        if info.kind != TcKind.Nominal {
            return TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: -1,
                           args: Vector<Int>(), assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        let args = self.nominal_args(owner)
        TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: member.type_decl,
                args: move args, assoc_decls: Vector<Int>(), assoc_types: Vector<Int>())
    }

    // How `args` bind to candidate `c`'s parameters (design 66): in order,
    // a label skipping forward only over defaulted parameters; or, for a
    // construction, by name in any order with positional arguments filling
    // what is left.
    public func bind_args(&var self, c: TcCand, args: &TcArgs) -> TcBind {
        let count = self.cand_param_count(c)
        var arg_param = Vector<Int>()
        var bound = Vector<Bool>()
        var k = 0
        while k < count {
            try! bound.push(false)
            k = k + 1
        }
        k = 0
        while k < args.values.len() {
            try! arg_param.push(-1)
            k = k + 1
        }
        let ordered = self.cand_ordered(c)
        if not ordered {
            k = 0
            while k < args.values.len() {
                let label = args.labels[k]
                if label >= 0 {
                    var p = 0
                    var found = -1
                    while p < count {
                        if self.cand_param_name(c, p) == label {
                            found = p
                        }
                        p = p + 1
                    }
                    if found < 0 {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_UNKNOWN_LABEL, detail: k)
                    }
                    if bound[found] {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_REPEATED, detail: k)
                    }
                    bound[found] = true
                    arg_param[k] = found
                }
                k = k + 1
            }
        }
        var cursor = 0
        k = 0
        while k < args.values.len() {
            let label = args.labels[k]
            if label < 0 {
                while cursor < count && bound[cursor] {
                    cursor = cursor + 1
                }
                if cursor >= count {
                    // A C variadic extern takes the rest untyped by any
                    // parameter.
                    if self.cand_variadic(c) {
                        k = k + 1
                        continue
                    }
                    return TcBind(arg_param: move arg_param, status: TC_BIND_TOO_MANY, detail: k)
                }
                arg_param[k] = cursor
                bound[cursor] = true
                cursor = cursor + 1
            } else if ordered {
                var found = -1
                var p = cursor
                while p < count && found < 0 {
                    if self.cand_param_name(c, p) == label {
                        found = p
                    }
                    p = p + 1
                }
                if found < 0 {
                    p = 0
                    while p < cursor {
                        if self.cand_param_name(c, p) == label {
                            return TcBind(arg_param: move arg_param, status: TC_BIND_BACKWARD,
                                          detail: k)
                        }
                        p = p + 1
                    }
                    return TcBind(arg_param: move arg_param, status: TC_BIND_UNKNOWN_LABEL, detail: k)
                }
                p = cursor
                while p < found {
                    if not bound[p] && not self.cand_param_default(c, p) {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_MISSING, detail: p)
                    }
                    p = p + 1
                }
                arg_param[k] = found
                bound[found] = true
                cursor = found + 1
            }
            k = k + 1
        }
        k = 0
        while k < count {
            if not bound[k] && not self.cand_param_default(c, k) {
                return TcBind(arg_param: move arg_param, status: TC_BIND_MISSING, detail: k)
            }
            k = k + 1
        }
        TcBind(arg_param: move arg_param, status: TC_BIND_OK, detail: -1)
    }
}

// The overload filter, and the checking of the candidate it picks.
extension TcProgram {
    // Resolves call `e` among `cands` and checks it: the overload filter
    // picks a candidate, inference instantiates it, each argument goes
    // through the funnel, and the call is recorded. `receiver` is the
    // receiver's node for a method, else -1. Returns the call's type.
    func resolve_call(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs,
                      explicit: &Vector<Int>, receiver: Int, want: Int) -> Int {
        self.chosen_twin = -1
        let chosen = self.filter_candidates(e, &cands, &args)
        let twin = self.chosen_twin
        if chosen < 0 {
            if receiver >= 0 {
                self.set_use(receiver, TcUse.Borrow)
            }
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let c = cands[chosen]
        if c.kind == TcCandKind.Function && self.reaches_assoc_through_bound(c) {
            self.not_yet(e, "an associated type reached through a type parameter's bound")
            if receiver >= 0 {
                self.set_use(receiver, TcUse.Borrow)
            }
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if c.kind == TcCandKind.Function && self.names_unreadable_type(c.decl) {
            self.refuse_unreadable(e, c.decl)
            if receiver >= 0 {
                self.set_use(receiver, TcUse.Borrow)
            }
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let bind = self.bind_args(c, &args)
        let solve = self.check_candidate(e, c, &args, &bind, &explicit)
        let t = self.finish_call(e, c, &solve, receiver)
        let at = self.call_at[e]
        if twin >= 0 && at >= 0 {
            var record = self.calls[at]
            record.twin = twin
            self.calls[at] = record
        }
        t
    }

    // Whether candidate `c` is a requirement called through a type parameter
    // whose signature names the trait's associated type, which no
    // conformance is there to give (SL:open-questions W4).
    func reaches_assoc_through_bound(&self, c: TcCand) -> Bool {
        let info = self.res.decls[c.decl]
        if info.kind != ResDeclKind.Requirement || c.owner < 0 {
            return false
        }
        var recv = c.owner
        while self.kind_of(recv) == TcKind.Ref {
            recv = self.types.ty(recv).b
        }
        if self.kind_of(recv) != TcKind.Param {
            return false
        }
        let s = self.sigs[c.decl]
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if self.mentions_assoc(p.ty) {
                return true
            }
            k = k + 1
        }
        s.result >= 0 && self.mentions_assoc(s.result)
    }

    func mentions_assoc(&self, t: Int) -> Bool {
        if t < 0 {
            return false
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Assoc {
            return true
        }
        let has_inner = info.kind == TcKind.Func || info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array
        if has_inner && self.mentions_assoc(info.b) {
            return true
        }
        var k = 0
        while k < info.count {
            let a = self.types.arg(t, k)
            if self.mentions_assoc(a) {
                return true
            }
            k = k + 1
        }
        false
    }

    // Whether interface function `d`'s signature names a type it could not
    // form, which a std module the parser refuses would have declared.
    func names_unreadable_type(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if not self.is_interface(info.module) {
            return false
        }
        let s = self.sigs[d]
        if self.has_error(s.result) {
            return true
        }
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if self.has_error(p.ty) {
                return true
            }
            k = k + 1
        }
        false
    }

    // A call of an interface function whose signature names a type from a
    // std module the parser refuses: outside the slice until that module
    // reads, and refused at the use so nothing downstream is mis-typed.
    func refuse_unreadable(&var self, e: Int, d: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`'s signature names `")
        try! msg.append(self.unformed_type_text(d))
        try! msg.append("` from ")
        try! msg.append(self.unavailable_std_text())
        try! msg.append(", a module the parser refuses, so this call is not in the bootstrap slice yet")
        self.refuse(e, "slice.not-yet", msg.build())
        try! self.skipped.push(e)
    }

    // The spelling of the first type position in declaration `d`'s signature
    // that could not be formed.
    func unformed_type_text(&self, d: Int) -> String {
        let info = self.res.decls[d]
        var stack = Vector<Int>()
        try! stack.push(info.node)
        var head = 0
        while head < stack.len() {
            let id = stack[head]
            head = head + 1
            if self.has_alt(id, Alt.Stmt_Block) {
                continue
            }
            let t = self.node_types[id]
            if self.has_alt(id, Alt.Type_Named) && t >= 0 && self.is_error_type(t) {
                let path = self.child(id, 0)
                let leaf = self.res.last_leaf_of(path)
                return self.text(info.module, leaf)
            }
            let n = self.child_count(id)
            var k = 0
            while k < n {
                try! stack.push(self.child(id, k))
                k = k + 1
            }
        }
        "?"
    }

    // The std modules the program could not read, as `std.a`, `std.b`.
    func unavailable_std_text(&self) -> String {
        var out = StringBuilder()
        var none = true
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if not info.available && info.kind == ResModuleKind.Std {
                if not none {
                    try! out.append(", ")
                }
                try! out.append("`")
                try! out.append(self.res.module_name(m))
                try! out.append("`")
                none = false
            }
            m = m + 1
        }
        if none {
            return "a std module"
        }
        out.build()
    }

    // The overload filter (SL:architecture §3.4, "Overloads"): the one place
    // a call's candidates are narrowed, by labels and arity, then by the
    // arguments' types. An argument that types itself is typed once, first;
    // one that takes its type from its position fits by its shape, so an
    // implicit member fits any enum with that case. A concrete candidate
    // beats a generic one, and among the rest a unique best wins; otherwise
    // the call is refused naming every candidate. Returns the index chosen,
    // or -1 once refused.
    func filter_candidates(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs) -> Int {
        let n = cands.len()
        var survivors = Vector<Int>()
        var first_status = TC_BIND_OK
        var first_detail = -1
        var k = 0
        while k < n {
            let bind = self.bind_args(cands[k], &args)
            if bind.status == TC_BIND_OK {
                try! survivors.push(k)
            } else if k == 0 {
                first_status = bind.status
                first_detail = bind.detail
            }
            k = k + 1
        }
        if n == 1 {
            if survivors.len() == 1 {
                return 0
            }
            self.refuse_binding(e, cands[0], &args, first_status, first_detail)
            return -1
        }
        if survivors.len() == 0 {
            self.refuse_no_match(e, &cands, &args)
            return -1
        }
        if survivors.len() == 1 {
            return survivors[0]
        }
        k = 0
        while k < args.values.len() {
            let v = args.values[k]
            if not self.needs_expectation(v) && not self.is_typed(v) {
                let _ = self.expr(v, TC_WANT_NONE)
            }
            k = k + 1
        }
        var fitting = Vector<Int>()
        var scores = Vector<Int>()
        var any_concrete = false
        k = 0
        while k < survivors.len() {
            let at = survivors[k]
            let c = cands[at]
            let bind = self.bind_args(c, &args)
            let sub = self.cand_subst(c)
            let owner = self.cand_generic_owner(c)
            var all = true
            var j = 0
            var row = Vector<Int>()
            while j < args.values.len() {
                let p = bind.arg_param[j]
                var f = 1
                if p >= 0 {
                    let raw = self.cand_param_type(c, p)
                    let pt = self.subst(raw, &sub)
                    f = self.arg_fit(args.values[j], pt, owner)
                }
                if f <= 0 {
                    all = false
                }
                try! row.push(f)
                j = j + 1
            }
            if all {
                try! fitting.push(at)
                j = 0
                while j < row.len() {
                    try! scores.push(row[j])
                    j = j + 1
                }
                if owner < 0 {
                    any_concrete = true
                }
            }
            k = k + 1
        }
        if fitting.len() == 0 {
            self.refuse_no_match(e, &cands, &args)
            return -1
        }
        let width = args.values.len()
        var best = Vector<Int>()
        k = 0
        while k < fitting.len() {
            let c = cands[fitting[k]]
            let generic = self.cand_generic_owner(c) >= 0
            if not (any_concrete && generic) {
                var beaten = false
                var j = 0
                while j < fitting.len() {
                    let other = cands[fitting[j]]
                    let other_generic = self.cand_generic_owner(other) >= 0
                    if j != k && not (any_concrete && other_generic) && tc_dominates(&scores, j, k, width) {
                        beaten = true
                    }
                    j = j + 1
                }
                if not beaten {
                    try! best.push(fitting[k])
                }
            }
            k = k + 1
        }
        if best.len() == 1 {
            return best[0]
        }
        let shared = self.shared_twin(&cands, &best)
        if shared >= 0 {
            return shared
        }
        self.refuse_ambiguous(e, &cands, &best)
        return -1
    }

    // Of two tied candidates that are one accessor's shared and exclusive
    // twins, the shared one, the exclusive one kept in `chosen_twin` for a
    // use that writes (design 141); -1 for any other tie.
    func shared_twin(&var self, cands: &Vector<TcCand>, best: &Vector<Int>) -> Int {
        if best.len() != 2 {
            return -1
        }
        let a = cands[best[0]]
        let b = cands[best[1]]
        if a.kind != TcCandKind.Function || b.kind != TcCandKind.Function {
            return -1
        }
        let sa = self.sigs[a.decl]
        let sb = self.sigs[b.decl]
        if sa.param_count != sb.param_count {
            return -1
        }
        var k = 0
        while k < sa.param_count {
            let pa = self.params[sa.param_first + k]
            let pb = self.params[sb.param_first + k]
            if pa.ty != pb.ty || pa.name != pb.name {
                return -1
            }
            k = k + 1
        }
        if sa.receiver == TcReceiver.Shared && sb.receiver == TcReceiver.Exclusive {
            self.chosen_twin = b.decl
            return best[0]
        }
        if sa.receiver == TcReceiver.Exclusive && sb.receiver == TcReceiver.Shared {
            self.chosen_twin = a.decl
            return best[1]
        }
        return -1
    }

    // How well argument `v` fits a parameter of type `p`: exact 3, adopting
    // 2, converting or generic 1, not at all 0. `owner`'s parameters in `p`
    // are unknowns inference would solve.
    func arg_fit(&var self, v: Int, p: Int, owner: Int) -> Int {
        let generic = owner >= 0 && self.mentions_owner(p, owner)
        if self.is_typed(v) {
            let a = self.final_type(v)
            if self.has_error(a) {
                return 1
            }
            if generic {
                var s = tc_solve(owner, 64)
                if self.unify(p, a, &var s) {
                    return 1
                }
                return 0
            }
            let allow = self.allowance(TcPosition.Argument)
            let f = self.fit(a, p, allow)
            if f == TC_FIT_EXACT {
                return 3
            }
            if f == TC_FIT_CONVERTED {
                return 1
            }
            return 0
        }
        if generic {
            return 1
        }
        if self.is_constant_expr(v) {
            let peeled = self.peel(p, TcClient.Integer, -1, -1)
            if self.peeled_fits(peeled, p) {
                let i = self.int_type()
                if peeled == i && p == i {
                    return 3
                }
                if peeled == p {
                    return 2
                }
                return 1
            }
            return 0
        }
        let name = self.implicit_member_name(v)
        if name >= 0 {
            let peeled = self.peel(p, TcClient.Member, name, -1)
            if self.peeled_fits(peeled, p) {
                return 2
            }
            return 0
        }
        guard let alt = self.node_alt(v) else {
            return 1
        }
        if alt == Alt.Expr_None {
            if self.is_optional(p) {
                return 2
            }
            if self.is_result(p) {
                let ok = self.arg_of(p, 0)
                if self.is_optional(ok) {
                    return 2
                }
            }
            return 0
        }
        if alt == Alt.Expr_Float {
            let peeled = self.peel(p, TcClient.Floating, -1, -1)
            if self.peeled_fits(peeled, p) {
                return 2
            }
            return 0
        }
        if alt == Alt.Expr_Closure {
            var w = p
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func && self.peeled_fits(w, p) {
                return 2
            }
            return 0
        }
        1
    }

    // Whether a value of the peeled type `peeled` reaches parameter type `p`
    // within an argument's wraps.
    func peeled_fits(&var self, peeled: Int, p: Int) -> Bool {
        if peeled < 0 {
            return false
        }
        let allow = self.allowance(TcPosition.Argument)
        peeled == p || self.fit(peeled, p, allow) > TC_FIT_NONE
    }

    // Whether `t` mentions a parameter of declaration `owner`.
    func mentions_owner(&self, t: Int, owner: Int) -> Bool {
        let info = self.types.ty(t)
        if info.kind == TcKind.Param && info.decl == owner {
            return true
        }
        let has_inner = info.kind == TcKind.Func || info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array
        if has_inner && info.b >= 0 && self.mentions_owner(info.b, owner) {
            return true
        }
        var k = 0
        while k < info.count {
            let a = self.types.arg(t, k)
            if self.mentions_owner(a, owner) {
                return true
            }
            k = k + 1
        }
        false
    }

    // Checks the arguments of the chosen candidate `c` and solves its type
    // parameters: local unification over the arguments with the later-
    // argument fixpoint (designs 93 and 105). An argument whose parameter is
    // known goes through the funnel at once; one that types itself is typed
    // and unified; the rest wait for what the others solve, and a literal
    // left over takes its own default. Returns the solutions.
    func check_candidate(&var self, e: Int, c: TcCand, args: &TcArgs, bind: &TcBind,
                         explicit: &Vector<Int>) -> TcSolve {
        let owner = self.cand_generic_owner(c)
        var count = 0
        if owner >= 0 {
            self.ensure_generics(owner)
            count = self.sigs[owner].generic_count
        }
        var solve = tc_solve(owner, count)
        if explicit.len() > 0 {
            // A construction's head pins its type's leading parameters.
            let pins_type = c.owner < 0 && owner >= 0 && owner == self.cand_type_decl(c)
            if owner < 0 || explicit.len() > count || (owner != c.decl && not pins_type) {
                self.refuse(e, "type.arity",
                            "this call writes type arguments, and what it calls takes fewer")
            } else {
                var k = 0
                while k < explicit.len() {
                    solve.sol[k] = explicit[k]
                    k = k + 1
                }
            }
        }
        let sub = self.cand_subst(c)
        let n = args.values.len()
        var done = Vector<Bool>()
        var k = 0
        while k < n {
            // A variadic extern's extra argument has no parameter to expect.
            let extra = bind.arg_param[k] < 0
            try! done.push(extra)
            if extra {
                let v = args.values[k]
                if not self.is_typed(v) {
                    let _ = self.expr(v, TC_WANT_NONE)
                }
                self.consume(v)
            }
            k = k + 1
        }
        // Each pass first unifies every argument that types itself against a
        // parameter still unknown when the pass began, so two arguments that
        // disagree meet as a conflict; then it checks each argument whose
        // parameter is known.
        var progress = true
        while progress {
            progress = false
            var pending = Vector<Int>()
            k = 0
            while k < n {
                if not done[k] {
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if self.mentions_unsolved(pt, &solve) && not self.needs_expectation(args.values[k]) {
                        try! pending.push(k)
                    }
                }
                k = k + 1
            }
            k = 0
            while k < pending.len() {
                let at = pending[k]
                let v = args.values[at]
                let raw = self.cand_param_type(c, bind.arg_param[at])
                let pt = self.subst(raw, &sub)
                if not self.is_typed(v) {
                    let _ = self.expr(v, TC_WANT_NONE)
                }
                let before = self.solved_count(&solve)
                let a = self.final_type(v)
                let _ = self.unify(pt, a, &var solve)
                if self.solved_count(&solve) > before {
                    progress = true
                }
                k = k + 1
            }
            self.report_conflict(e, owner, &var solve)
            k = 0
            while k < n {
                if not done[k] {
                    let v = args.values[k]
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if not self.mentions_unsolved(pt, &solve) {
                        let s2 = self.solve_subst(&solve)
                        let target = self.subst(pt, &s2)
                        self.check_call_argument(c, v, target)
                        done[k] = true
                        progress = true
                    }
                }
                k = k + 1
            }
        }
        // What is left takes its type from its position. A literal or a
        // closure types itself when nothing solved its parameter, and what it
        // solves reaches the rest; `None`, an implicit member and an empty
        // collection wait for that, and are typed alone only at the end.
        var changed = true
        while changed {
            changed = false
            k = 0
            while k < n {
                if not done[k] {
                    let v = args.values[k]
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if not self.mentions_unsolved(pt, &solve) {
                        let s2 = self.solve_subst(&solve)
                        let target = self.subst(pt, &s2)
                        self.check_call_argument(c, v, target)
                        done[k] = true
                        changed = true
                    } else if not self.is_typed(v) && self.types_itself(v) {
                        self.type_alone(v, pt, &solve)
                        let a = self.final_type(v)
                        let _ = self.unify(pt, a, &var solve)
                        changed = true
                    }
                }
                k = k + 1
            }
        }
        k = 0
        while k < n {
            if not done[k] {
                let v = args.values[k]
                let raw = self.cand_param_type(c, bind.arg_param[k])
                let pt = self.subst(raw, &sub)
                if not self.is_typed(v) {
                    self.type_alone(v, pt, &solve)
                }
                let a = self.final_type(v)
                let _ = self.unify(pt, a, &var solve)
            }
            k = k + 1
        }
        let defaults = self.generic_defaults(c, &bind)
        self.infer_from_defaults(c, &defaults, &sub, &var solve)
        self.settle_solutions(e, owner, &var solve)
        k = 0
        while k < n {
            if not done[k] {
                let v = args.values[k]
                let raw = self.cand_param_type(c, bind.arg_param[k])
                let pt = self.subst(raw, &sub)
                let s2 = self.solve_subst(&solve)
                let target = self.subst(pt, &s2)
                self.check_call_argument(c, v, target)
            }
            k = k + 1
        }
        self.check_used_defaults(e, c, &defaults, &sub, &solve)
        move solve
    }

    // A default value whose parameter's type is a type parameter `t`: a
    // literal, typed as it is written, or `None`, typed `t`, which each call
    // then requires to be an Optional. Each call checks the value against its
    // own `t`, where a literal's type drives inference (design 108). Any
    // other value would need a typing per instantiation.
    func check_generic_default(&var self, value: Int, t: Int) {
        if self.is_none_literal(value) {
            let _ = self.set_type(value, t, false)
            self.consume(value)
            return
        }
        let own = self.default_literal_type(value)
        if own < 0 {
            self.not_yet(value, "a default value of a type parameter's type that is no literal and no `None`")
            let poisoned = self.error_type
            let _ = self.set_type(value, poisoned, false)
            return
        }
        let _ = self.expr(value, TC_WANT_NONE)
        self.consume(value)
    }

    // The type a literal default has as written: `Int` for a bare integer or
    // a constant expression, a suffix's type, `Float`, `String`, `Bool`; -1
    // for any other expression.
    func default_literal_type(&var self, v: Int) -> Int {
        if v < 0 {
            return -1
        }
        if self.is_constant_expr(v) {
            return self.int_type()
        }
        if self.has_alt(v, Alt.Expr_Int) {
            let m = self.current
            let leaf = self.res.first_leaf(v)
            let text = self.text(m, leaf)
            return self.suffix_type(&text)
        }
        if self.has_alt(v, Alt.Expr_Float) {
            return self.float_type()
        }
        if self.has_alt(v, Alt.Expr_String) {
            return self.string_type()
        }
        if self.has_alt(v, Alt.Expr_Bool_True) || self.has_alt(v, Alt.Expr_Bool_False) {
            return self.bool_type()
        }
        return -1
    }

    // The default value written for parameter `index` of function `d`, or -1.
    func param_default_node(&self, d: Int, index: Int) -> Int {
        let node = self.res.decls[d].node
        if node < 0 {
            return -1
        }
        var at = 0
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            k = k + 1
            let plain = self.has_alt(c, Alt.Decl_Param_Plain)
            let defaulted = self.has_alt(c, Alt.Decl_Param_Default)
            if not plain && not defaulted {
                continue
            }
            if at == index {
                if defaulted {
                    return self.res.last_node_child(c)
                }
                return -1
            }
            at = at + 1
        }
        return -1
    }

    // The parameters of candidate `c` no argument binds whose type is a type
    // parameter and whose default the call uses: design 108's defaults.
    func generic_defaults(&var self, c: TcCand, bind: &TcBind) -> Vector<Int> {
        var out = Vector<Int>()
        if c.kind != TcCandKind.Function {
            return move out
        }
        let count = self.cand_param_count(c)
        var j = 0
        while j < count {
            let raw = self.cand_param_type(c, j)
            if self.kind_of(raw) == TcKind.Param && not tc_contains(&bind.arg_param, j) {
                if self.param_default_node(c.decl, j) >= 0 {
                    try! out.push(j)
                }
            }
            j = j + 1
        }
        move out
    }

    // Unifies each used literal default's type with its parameter's, so the
    // default drives inference where nothing else does (design 108).
    func infer_from_defaults(&var self, c: TcCand, params: &Vector<Int>, sub: &TcSubst, solve: &var TcSolve) {
        var k = 0
        while k < params.len() {
            let j = params[k]
            k = k + 1
            let raw = self.cand_param_type(c, j)
            let pt = self.subst(raw, &sub)
            if not self.mentions_unsolved(pt, &solve) {
                continue
            }
            let v = self.param_default_node(c.decl, j)
            let own = self.default_literal_type(v)
            if own >= 0 {
                let _ = self.unify(pt, own, &var solve)
            }
        }
    }

    // Checks each used default against the type this call gives its
    // parameter: `None` needs an Optional, a bare integer an integer type it
    // adopts, and any other literal must fit.
    func check_used_defaults(&var self, e: Int, c: TcCand, params: &Vector<Int>, sub: &TcSubst, solve: &TcSolve) {
        var k = 0
        while k < params.len() {
            let j = params[k]
            k = k + 1
            let raw = self.cand_param_type(c, j)
            let pt = self.subst(raw, &sub)
            let s2 = self.solve_subst(&solve)
            let target = self.subst(pt, &s2)
            if self.has_error(target) {
                continue
            }
            let v = self.param_default_node(c.decl, j)
            var fits = false
            if self.is_none_literal(v) {
                fits = self.is_optional(target)
            } else if self.is_constant_expr(v) && self.is_integer(target) {
                fits = true
            } else {
                let own = self.default_literal_type(v)
                let allow = self.allowance(TcPosition.Default)
                fits = own >= 0 && self.fit(own, target, allow) > TC_FIT_NONE
            }
            if not fits {
                let first = self.sigs[c.decl].param_first
                let param = self.params[first + j]
                var msg = StringBuilder()
                try! msg.append("this call uses the default value of `")
                try! msg.append(self.name_text(param.name))
                try! msg.append("`, which does not fit `")
                try! msg.append(self.type_text(target))
                try! msg.append("`, the type this call gives it; pass the argument")
                self.refuse(e, "type.mismatch", msg.build())
            }
        }
    }

    // Types argument `v`, whose parameter type `pt` still names a type
    // argument inference has not solved, on its own: a closure takes the
    // parameters `pt` gives once every one is solved, and gives its result
    // (SL:architecture §3.4, "a closure's parameters take it").
    func type_alone(&var self, v: Int, pt: Int, solve: &TcSolve) {
        if self.has_alt(v, Alt.Expr_Closure) {
            let s2 = self.solve_subst(&solve)
            var w = self.subst(pt, &s2)
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func {
                let info = self.types.ty(w)
                var known = true
                var k = 0
                while k < info.count {
                    let p = self.types.arg(w, k)
                    if self.mentions_unsolved(p, &solve) {
                        known = false
                    }
                    k = k + 1
                }
                if known {
                    let _ = self.closure_typed(v, w, true)
                    return
                }
            }
        }
        let _ = self.expr(v, TC_WANT_NONE)
    }

    // Whether an argument that takes its type from its position can still
    // type itself alone: a literal, a constant, a closure, a collection
    // literal with elements. `None` and an implicit member cannot.
    func types_itself(&self, v: Int) -> Bool {
        if self.implicit_member_name(v) >= 0 {
            return false
        }
        guard let alt = self.node_alt(v) else {
            return false
        }
        if alt == Alt.Expr_None || alt == Alt.Expr_Map_Empty {
            return false
        }
        if alt == Alt.Expr_Array || alt == Alt.Expr_Set || alt == Alt.Expr_Map_Entries {
            return self.res.first_node_child(v) >= 0
        }
        true
    }

    // An argument, through the funnel entry for what it fills.
    func check_call_argument(&var self, c: TcCand, v: Int, target: Int) {
        match c.kind {
            case Function -> self.check_argument(v, target),
            case Memberwise -> self.check_field_argument(v, target),
            case Case -> self.check_payload(v, target)
        }
    }

    func solved_count(&self, s: &TcSolve) -> Int {
        var n = 0
        var k = 0
        while k < s.sol.len() {
            if s.sol[k] >= 0 {
                n = n + 1
            }
            k = k + 1
        }
        n
    }

    // What inference left unsolved takes its parameter's default, or is
    // refused naming the parameter; a solved or conflicting parameter is
    // held to its bounds (design 109).
    func settle_solutions(&var self, e: Int, owner: Int, solve: &var TcSolve) {
        if owner < 0 {
            return
        }
        self.report_conflict(e, owner, &var solve)
        let s = self.sigs[owner]
        var k = 0
        while k < solve.sol.len() {
            let g = self.generics[s.generic_first + k]
            if solve.sol[k] < 0 {
                if g.default_type >= 0 {
                    solve.sol[k] = g.default_type
                } else {
                    var msg = StringBuilder()
                    try! msg.append("cannot infer type argument `")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append("` of `")
                    try! msg.append(self.res.decl_path(owner))
                    try! msg.append("`: nothing in the call determines it; write it, as `<")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append(" = ...>` does for a type")
                    self.refuse(e, "infer.failed", msg.build())
                    solve.sol[k] = self.error_type
                }
            }
            k = k + 1
        }
        k = 0
        while k < solve.sol.len() {
            let g = self.generics[s.generic_first + k]
            let arg = solve.sol[k]
            var j = 0
            while j < g.bound_count {
                let bound = self.traits[g.bound_first + j]
                let env = self.current_decl
                let ext = self.current_ext
                if not self.satisfies(arg, bound, env, ext) {
                    var msg = StringBuilder()
                    try! msg.append("`")
                    try! msg.append(self.type_text(arg))
                    try! msg.append("` does not satisfy `")
                    try! msg.append(self.res.decl_path(bound))
                    try! msg.append("`, the bound on `")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append("` of `")
                    try! msg.append(self.res.decl_path(owner))
                    try! msg.append("`")
                    self.refuse(e, "type.bound", msg.build())
                }
                j = j + 1
            }
            k = k + 1
        }
    }

    // Refuses a conflict unification found, once, and poisons the parameter
    // it concerns, so the arguments that disagree draw no second refusal.
    func report_conflict(&var self, e: Int, owner: Int, solve: &var TcSolve) {
        if owner < 0 || solve.conflict_index < 0 {
            return
        }
        let s = self.sigs[owner]
        let index = solve.conflict_index
        let g = self.generics[s.generic_first + index]
        var msg = StringBuilder()
        try! msg.append("cannot infer `")
        try! msg.append(self.name_text(g.name))
        try! msg.append("` for `")
        try! msg.append(self.res.decl_path(owner))
        try! msg.append("`: it is required to be both `")
        try! msg.append(self.type_text(solve.conflict_a))
        try! msg.append("` and `")
        try! msg.append(self.type_text(solve.conflict_b))
        try! msg.append("`")
        self.refuse(e, "infer.failed", msg.build())
        solve.sol[index] = self.error_type
        solve.conflict_index = -2
    }

    // Records the chosen call and its receiver's borrow, and returns its
    // type: the result, instantiated; for a `borrows` accessor, the place
    // it lends.
    func finish_call(&var self, e: Int, c: TcCand, solve: &TcSolve, receiver: Int) -> Int {
        let owner_decl = solve.owner
        var owner = c.owner
        var inst = Vector<Int>()
        // Solutions for the candidate's own parameters are its instantiation;
        // solutions for its type's are the type it is instantiated at.
        let own = c.kind == TcCandKind.Function && owner_decl == c.decl
        if owner_decl >= 0 && not own {
            owner = self.mk_nominal(owner_decl, &solve.sol)
        } else if owner_decl >= 0 {
            inst = tc_copy_ints(&solve.sol)
        }
        let role = self.cand_role(c)
        let _ = self.record_call(e, c.decl, role, owner, &inst)
        let sub = if owner >= 0 { self.cand_subst_at(c, owner) } else { self.cand_subst(c) }
        let s2 = self.solve_subst(&solve)
        match c.kind {
            case Memberwise -> {
                let t = if owner >= 0 { owner } else { self.self_type_of(c.decl) }
                return self.set_type(e, t, false)
            },
            case Case -> {
                let d = self.res.decls[c.decl].parent
                let t = if owner >= 0 { owner } else { self.self_type_of(d) }
                return self.set_type(e, t, false)
            },
            case Function -> {}
        }
        let sig = self.sigs[c.decl]
        let written = self.subst(sig.result, &sub)
        let result = self.subst(written, &s2)
        self.poison_if(result)
        if receiver >= 0 {
            self.receive(receiver, c, sig)
        }
        if (sig.effects & TC_EFFECT_BORROWS) != 0 {
            let lent = self.referent(result)
            if lent >= 0 && (sig.lending == TcLend.Place || sig.lending == TcLend.ConditionalPlace) {
                return self.set_type(e, lent, true)
            }
        }
        self.set_type(e, result, false)
    }

    func cand_role(&self, c: TcCand) -> TcRole {
        match c.kind {
            case Function -> TcRole.Call,
            case Memberwise -> TcRole.Memberwise,
            case Case -> TcRole.Case
        }
    }

    // `cand_subst` with the owner inference settled.
    func cand_subst_at(&var self, c: TcCand, owner: Int) -> TcSubst {
        let at = TcCand(decl: c.decl, kind: c.kind, member: c.member, owner: owner)
        self.cand_subst(at)
    }

    // A method's receiver: borrowed shared or exclusive as its signature
    // declares, or consumed by a `consumes` method. A `borrows` accessor's
    // borrow waits for its use site (`settle_places`).
    func receive(&var self, receiver: Int, c: TcCand, sig: TcSig) {
        if (sig.effects & TC_EFFECT_CONSUMES) != 0 {
            let spelled = self.has_alt(receiver, Alt.Expr_Move_Place)
            if self.expr_place[receiver] && not spelled && self.expr_use[receiver] == TcUse.Unused {
                // Both ends of a consuming call are marked: at every Copy
                // tier the transfer is spelled at the call.
                self.set_use(receiver, TcUse.Copy)
                self.refuse_bare_consume(receiver, c.decl)
                return
            }
            self.consume(receiver)
            return
        }
        if (sig.effects & TC_EFFECT_BORROWS) != 0 {
            return
        }
        let t = self.final_type(receiver)
        if sig.receiver == TcReceiver.Exclusive {
            let r = self.mk_ref(true, t)
            self.add_adjust(receiver, TcAdjustKind.BorrowVar, r)
            self.set_use(receiver, TcUse.BorrowVar)
        } else {
            let r = self.mk_ref(false, t)
            self.add_adjust(receiver, TcAdjustKind.Borrow, r)
            self.set_use(receiver, TcUse.Borrow)
        }
    }
}

// Whether row `a` of `scores` beats row `b`: no worse at any argument, and
// better at one.
public func tc_dominates(scores: &Vector<Int>, a: Int, b: Int, width: Int) -> Bool {
    var better = false
    var k = 0
    while k < width {
        let x = scores[a * width + k]
        let y = scores[b * width + k]
        if x < y {
            return false
        }
        if x > y {
            better = true
        }
        k = k + 1
    }
    better
}

// Builtin functions and subscripts.
extension TcProgram {
    // A builtin function (SL:open-questions D12): `print`, `panic` and
    // `assert` with a message, or a format string whose `{}` slots its
    // arguments fill, each borrowed (design 137); `sizeof` and `alignof`.
    func builtin_call(&var self, e: Int, callee: Int, d: Int, args: &TcArgs) -> Int {
        let name_id = self.res.decls[d].name
        let name = self.name_text(name_id)
        var k = 0
        while k < args.labels.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label", "a builtin function's arguments take no labels")
            }
            k = k + 1
        }
        if name.equals("sizeof") || name.equals("alignof") {
            let explicit = self.explicit_type_args(callee)
            if explicit.len() != 1 {
                self.refuse(e, "type.arity", "`sizeof` and `alignof` take one type argument, as `sizeof<T>()`")
            }
            if args.values.len() > 0 {
                self.refuse(e, "call.arity", "`sizeof` and `alignof` take no arguments")
                self.type_args_alone(&args)
            }
            self.record_builtin(e, d, TcRole.Builtin, name)
            let t = self.int_type()
            return self.set_type(e, t, false)
        }
        if not (name.equals("print") || name.equals("panic") || name.equals("assert")) {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` is outside the sync-only bootstrap slice")
            self.refuse(e, "slice.not-yet", msg.build())
            try! self.skipped.push(e)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var start = 0
        if name.equals("assert") {
            if args.values.len() == 0 {
                self.refuse(e, "call.arity", "`assert` takes a condition")
            } else {
                self.check_condition(args.values[0])
            }
            start = 1
        } else if args.values.len() == 0 {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` takes a message")
            self.refuse(e, "call.arity", msg.build())
        }
        if args.values.len() > start {
            let fmt = args.values[start]
            let rest = args.values.len() - start - 1
            let slots = self.placeholder_count(fmt)
            if rest == 0 && slots == 0 {
                let _ = self.expr(fmt, TC_WANT_NONE)
                let ft = self.final_type(fmt)
                if self.is_string(ft) || self.has_error(ft) {
                    self.consume(fmt)
                } else {
                    self.check_formattable(fmt)
                    self.set_use(fmt, TcUse.Borrow)
                }
            } else {
                let literal = self.has_alt(fmt, Alt.Expr_String) || self.has_alt(fmt, Alt.Expr_Interpolation)
                let _ = self.expr(fmt, TC_WANT_NONE)
                self.consume(fmt)
                if not literal {
                    self.refuse(fmt, "format.slot-count",
                                "a message with format arguments is a string literal whose `\{\}` slots they fill")
                } else if slots != rest {
                    var msg = StringBuilder()
                    try! msg.append("the format string has ")
                    try! msg.append(slots)
                    try! msg.append(" `\{\}` slots, and ")
                    try! msg.append(rest)
                    try! msg.append(" arguments follow it; each slot takes one argument")
                    self.refuse(fmt, "format.slot-count", msg.build())
                }
                k = start + 1
                while k < args.values.len() {
                    let v = args.values[k]
                    let _ = self.expr(v, TC_WANT_NONE)
                    self.check_formattable(v)
                    self.set_use(v, TcUse.Borrow)
                    k = k + 1
                }
            }
        }
        self.record_builtin(e, d, TcRole.Builtin, name)
        if name.equals("panic") {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // How many `{}` format slots string literal `e` holds.
    func placeholder_count(&self, e: Int) -> Int {
        if not self.has_alt(e, Alt.Expr_Interpolation) {
            return 0
        }
        var count = 0
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            let node = self.res.nodes[c]
            if node.shape == NodeShape.Placeholder {
                count = count + 1
            }
            k = k + 1
        }
        count
    }

    // `v[i]`: a fixed array's or a slice's builtin element place, or a call
    // of the type's `[]`. Which of the three roles it plays waits for its
    // use (`settle_places`, SL:borrowing §5).
    func subscript_expr(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        var values = Vector<Int>()
        var labels = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == base || self.is_leaf(c) {
                continue
            }
            if self.has_alt(c, Alt.Expr_Argument_Positional) {
                try! values.push(self.res.first_node_child(c))
                try! labels.push(-1)
            } else if self.has_alt(c, Alt.Expr_Argument_Labelled) {
                let leaf = self.res.first_leaf(c)
                let label = self.text(m, leaf)
                try! values.push(self.res.last_node_child(c))
                try! labels.push(self.res.intern(label))
            } else {
                try! values.push(c)
                try! labels.push(-1)
            }
        }
        let args = TcArgs(values: move values, labels: move labels)
        let _ = self.expr(base, TC_WANT_NONE)
        let rt = self.final_type(base)
        let inner = self.referent(rt)
        let t = if inner >= 0 { inner } else { rt }
        if self.has_error(t) {
            self.set_use(base, TcUse.Project)
            self.type_args_alone(&args)
            return self.set_type(e, t, true)
        }
        let info = self.types.ty(t)
        let pointer = info.kind == TcKind.Nominal && (info.decl == self.known.unsafe_pointer || info.decl == self.known.unsafe_const_pointer)
        if info.kind == TcKind.Array || info.kind == TcKind.Slice || pointer {
            if inner >= 0 {
                self.add_adjust(base, TcAdjustKind.Deref, inner)
            }
            if pointer {
                self.consume(base)
            } else {
                self.set_use(base, TcUse.Project)
            }
            let i = self.int_type()
            k = 0
            while k < args.values.len() {
                self.check_argument(args.values[k], i)
                k = k + 1
            }
            if args.values.len() != 1 {
                self.refuse(e, "call.arity", "an array's, a slice's or a raw pointer's subscript takes one index")
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "[]")
            let element = if pointer { self.arg_of(t, 0) } else { info.b }
            return self.set_type(e, element, true)
        }
        var cands = Vector<TcCand>()
        let name = self.res.intern("[]")
        self.method_candidates(&var cands, t, name, false)
        if cands.len() == 0 {
            self.set_use(base, TcUse.Project)
            self.type_args_alone(&args)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.type_text(t))
            try! msg.append("` declares no subscript `[]`, so it has no getitem, setitem or place accessor")
            self.refuse(e, "subscript.role", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let none = Vector<Int>()
        let result = self.resolve_call(e, &cands, &args, &none, -1, TC_WANT_NONE)
        let at = self.call_at[e]
        if at >= 0 {
            var c = self.calls[at]
            c.role = TcRole.Getitem
            self.calls[at] = c
        } else {
            self.set_use(base, TcUse.Borrow)
        }
        self.expr_place[e] = true
        result
    }
}

// Patterns.
extension TcProgram {
    // Pattern `p` against a value of type `t` that comes from a place or a
    // temporary. Each pattern node takes the type it matches; a binding
    // copies its part out of a place, or takes it from a temporary.
    public func check_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        guard let alt = self.node_alt(p) else {
            return
        }
        self.check_pattern_as(p, alt, t, from)
    }

    func check_pattern_as(&var self, p: Int, alt: Alt, t: Int, from: TcOrigin) {
        match alt {
            case Pat_Wildcard -> self.test_pattern(p, t),
            case Pat_Literal_Int -> self.literal_pattern(p, t, 0),
            case Pat_Literal_NegativeInt -> self.literal_pattern(p, t, 0),
            case Pat_Literal_String -> self.literal_pattern(p, t, 1),
            case Pat_Literal_True -> self.literal_pattern(p, t, 2),
            case Pat_Literal_False -> self.literal_pattern(p, t, 2),
            case Pat_Range_Exclusive -> self.literal_pattern(p, t, 0),
            case Pat_Range_Inclusive -> self.literal_pattern(p, t, 0),
            case Pat_Tuple_Positional -> self.tuple_pattern(p, t, from),
            case Pat_Variant -> self.variant_pattern(p, t, from),
            case Pat_Name -> self.name_pattern(p, t, from),
            case Pat_None -> {
                self.test_pattern(p, t)
                if not self.has_error(t) && not self.is_optional(t) {
                    self.refuse_pattern(p, "`None` matches an Optional", t)
                }
            },
            case Pat_BorrowBinding_Let -> self.bind_borrow(p, t, false),
            case Pat_BorrowBinding_Var -> self.bind_borrow(p, t, true),
            case Stmt_BindingName -> self.bind_target(p, t, from),
            case _ -> {
                self.not_in_slice(p, alt)
            }
        }
    }

    // A pattern that tests its value and binds nothing.
    func test_pattern(&var self, p: Int, t: Int) {
        let _ = self.set_type(p, t, false)
        self.set_use(p, TcUse.Test)
    }

    // A literal or range pattern: an integer (0), a `String` (1), a `Bool`
    // (2).
    func literal_pattern(&var self, p: Int, t: Int, kind: Int) {
        self.test_pattern(p, t)
        if self.has_error(t) {
            return
        }
        let fits = (kind == 0 && self.is_integer(t)) || (kind == 1 && self.is_string(t)) || (kind == 2 && self.is_bool(t))
        if not fits {
            self.refuse_pattern(p, "this literal pattern does not match the value", t)
        }
    }

    // `(a, b)`: a tuple of as many elements.
    func tuple_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        self.test_pattern(p, t)
        var parts = Vector<Int>()
        let n = self.child_count(p)
        var k = 0
        while k < n {
            let c = self.child(p, k)
            if not self.is_leaf(c) {
                try! parts.push(c)
            }
            k = k + 1
        }
        let info = self.types.ty(t)
        let fits = info.kind == TcKind.Tuple && info.count == parts.len()
        if not fits && not self.has_error(t) {
            self.refuse_pattern(p, "a tuple pattern of this many elements does not match the value", t)
        }
        k = 0
        while k < parts.len() {
            var et = self.error_type
            if fits {
                et = self.types.arg(t, k)
            }
            self.check_pattern(parts[k], et, from)
            k = k + 1
        }
    }

    // `Case(p, ...)`: a case of the value's enum, chosen among the
    // candidates of its name, and a pattern per payload field.
    func variant_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        self.test_pattern(p, t)
        let leaf = self.res.first_leaf(p)
        let b = self.binding_at(leaf)
        var parts = Vector<Int>()
        let n = self.child_count(p)
        var k = 0
        while k < n {
            let c = self.child(p, k)
            if not self.is_leaf(c) {
                try! parts.push(c)
            }
            k = k + 1
        }
        var c = -1
        if b.kind == ResBindKind.Cases && not self.has_error(t) {
            let d = self.nominal_decl(t)
            c = self.case_named(d, b.name)
            if c < 0 {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.name_text(b.name))
                try! msg.append("` is no case of the matched `")
                try! msg.append(self.type_text(t))
                try! msg.append("`")
                self.refuse(p, "type.mismatch", msg.build())
            }
        } else if b.kind == ResBindKind.Decl {
            self.not_in_slice(p, Alt.Pat_Variant)
            return
        }
        var payload = Vector<Int>()
        if c >= 0 {
            let cand = TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: t)
            let count = self.cand_param_count(cand)
            let d = self.res.decls[c].parent
            let sub = tc_args_subst(d, self.nominal_args(t))
            k = 0
            while k < count {
                let raw = self.cand_param_type(cand, k)
                try! payload.push(self.subst(raw, &sub))
                k = k + 1
            }
            if count != parts.len() {
                var msg = StringBuilder()
                try! msg.append("case `")
                try! msg.append(self.res.decl_path(c))
                try! msg.append("` carries ")
                try! msg.append(count)
                try! msg.append(" payload fields, and the pattern names ")
                try! msg.append(parts.len())
                self.refuse(p, "type.mismatch", msg.build())
            }
            let none = Vector<Int>()
            let _ = self.record_call(p, c, TcRole.Case, t, &none)
        }
        k = 0
        while k < parts.len() {
            var pt = self.error_type
            if k < payload.len() {
                pt = payload[k]
            }
            self.check_pattern(parts[k], pt, from)
            k = k + 1
        }
    }

    // A lone name: a binding, or, when resolve took it for a case (SL:open-
    // questions D13), a payload-free case of the value's enum. A candidate
    // set with none in that enum is refused, naming the case it was taken
    // for, since the name neither binds nor matches.
    func name_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        let leaf = self.res.first_leaf(p)
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Cases {
            self.test_pattern(p, t)
            if self.has_error(t) {
                return
            }
            let d = self.nominal_decl(t)
            let c = self.case_named(d, b.name)
            if c >= 0 {
                if self.case_has_payload(c) {
                    var msg = StringBuilder()
                    try! msg.append("case `")
                    try! msg.append(self.res.decl_path(c))
                    try! msg.append("` carries a payload; match it as `")
                    try! msg.append(self.name_text(b.name))
                    try! msg.append("(...)`")
                    self.refuse(p, "type.mismatch", msg.build())
                }
                let none = Vector<Int>()
                let _ = self.record_call(p, c, TcRole.Case, t, &none)
                return
            }
            self.refuse_case_mismatch(p, b.name, t)
            return
        }
        self.bind_part(p, leaf, t, from)
    }

    // D13's refusal: the payload-free cases named `name` in the module's
    // import closure, none of which is a case of `t`.
    func refuse_case_mismatch(&var self, p: Int, name: Int, t: Int) {
        let m = self.current
        var names = Vector<String>()
        var at = self.res.cases.first(0, name)
        while at >= 0 {
            let c = self.res.cases.value(at)
            let info = self.res.decls[c]
            if self.res.in_closure(m, info.module) && not info.flag {
                try! names.push(self.res.decl_identity(c))
            }
            at = self.res.cases.following(at)
        }
        let text = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` names no case of the matched `")
        try! msg.append(self.type_text(t))
        try! msg.append("`: it is taken for ")
        var k = names.len() - 1
        var first = true
        while k >= 0 {
            if not first {
                try! msg.append(", ")
            }
            try! msg.append("`")
            try! msg.append(names.get(k) ?? "")
            try! msg.append("`")
            first = false
            k = k - 1
        }
        try! msg.append(", a case in scope, so it does not bind; rename the binding, as `")
        try! msg.append(text)
        try! msg.append("_value`")
        self.refuse(p, "pattern.case-mismatch", msg.build())
    }
}

// What each place's use decides, once every body is checked.
extension TcProgram {
    // Settles a subscript's role (SL:borrowing §5) and the borrow of a
    // `borrows` accessor's receiver: shared, unless the use writes through
    // the place it lends (design 141). Each is read off the use the place's
    // position recorded, following a projection outward to the use that
    // ends it.
    public func settle_places(&var self) {
        let n = self.res.nodes.len()
        var parents = Vector<Int>()
        var k = 0
        while k < n {
            try! parents.push(-1)
            k = k + 1
        }
        k = 0
        while k < n {
            let count = self.child_count(k)
            var j = 0
            while j < count {
                let c = self.child(k, j)
                parents[c] = k
                j = j + 1
            }
            k = k + 1
        }
        k = 0
        while k < self.calls.len() {
            self.settle_call(k, &parents)
            k = k + 1
        }
    }

    func settle_call(&var self, at: Int, parents: &Vector<Int>) {
        let c = self.calls[at]
        let e = c.node
        self.current = self.node_module(e)
        if c.target < 0 || c.role == TcRole.Case || c.role == TcRole.Memberwise || c.role == TcRole.Builtin {
            return
        }
        let subscript = self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi)
        let sig = self.sigs[c.target]
        let lending = (sig.effects & TC_EFFECT_BORROWS) != 0
        if not subscript && not lending {
            return
        }
        var receiver = -1
        if subscript {
            receiver = self.res.first_node_child(e)
        } else {
            let callee = self.res.first_node_child(e)
            if self.has_alt(callee, Alt.Expr_Member) {
                receiver = self.res.first_node_child(callee)
            }
        }
        let writes = self.use_writes(e, &parents)
        if writes && c.twin >= 0 {
            var switched = self.calls[at]
            switched.target = c.twin
            self.calls[at] = switched
        }
        var exclusive = writes
        if subscript {
            let direct = self.expr_use[e]
            var role = TcRole.Place
            if direct == TcUse.Write {
                role = TcRole.Setitem
            } else if direct == TcUse.Copy || direct == TcUse.Temp || direct == TcUse.Move || direct == TcUse.Test {
                role = TcRole.Getitem
            } else if direct == TcUse.Project && not writes {
                role = TcRole.Getitem
            }
            self.settle_subscript(at, role, writes, lending)
            let settled = self.calls[at]
            exclusive = settled.role == TcRole.Setitem || (settled.role == TcRole.Place && writes)
        }
        if receiver < 0 || self.expr_use[receiver] != TcUse.Unused {
            return
        }
        let t = self.final_type(receiver)
        if exclusive {
            let r = self.mk_ref(true, t)
            self.add_adjust(receiver, TcAdjustKind.BorrowVar, r)
            self.set_use(receiver, TcUse.BorrowVar)
        } else {
            let r = self.mk_ref(false, t)
            self.add_adjust(receiver, TcAdjustKind.Borrow, r)
            self.set_use(receiver, TcUse.Borrow)
        }
    }

    // Whether the use that ends place `e`'s projection writes: an
    // assignment, a compound assignment, or an exclusive borrow.
    func use_writes(&self, e: Int, parents: &Vector<Int>) -> Bool {
        var node = e
        var guard_steps = 0
        while guard_steps < 10000 {
            let u = self.expr_use[node]
            if u != TcUse.Project {
                return u == TcUse.Write || u == TcUse.Update || u == TcUse.BorrowVar
            }
            let up = parents[node]
            if up < 0 {
                return false
            }
            node = up
            guard_steps = guard_steps + 1
        }
        false
    }

    // A subscript's role: a setitem is the declared `[]=`, or derived from
    // an exclusive place accessor; a getitem the declared `[]`, or derived
    // from the place accessor; a place use needs the accessor itself, lending
    // writably when the use writes (SL:borrowing §5.2).
    func settle_subscript(&var self, at: Int, role: TcRole, writes: Bool, lending: Bool) {
        var c = self.calls[at]
        let target_sig = self.sigs[c.target]
        c.role = role
        if role == TcRole.Setitem {
            let setter = self.setitem_of(c.owner)
            if setter >= 0 {
                c.target = setter
                c.derived = false
            } else if lending && target_sig.lending_exclusive {
                c.derived = true
            } else {
                self.refuse_role(c.node, c.owner, "a setitem: it declares no `[]=`, and its `[]` lends no writable place")
            }
        } else if role == TcRole.Getitem {
            c.derived = lending
        } else {
            if not lending {
                self.refuse_role(c.node, c.owner, "a place accessor: its `[]` is a getitem, which copies the element out; write through a `borrows` accessor")
            } else if writes && not target_sig.lending_exclusive {
                self.refuse_role(c.node, c.owner, "a writable place: its `[]` lends read-only")
            }
        }
        self.calls[at] = c
    }

    // The `[]=` of type `t` this module sees, or -1.
    func setitem_of(&var self, t: Int) -> Int {
        let d = self.nominal_decl(t)
        if d < 0 {
            return -1
        }
        let name = self.res.intern("[]=")
        let m = self.current
        let found = self.members_named(d, name, m)
        var k = 0
        while k < found.len() {
            if self.is_method_member(found[k], false) {
                let member = self.members[found[k]]
                return member.decl
            }
            k = k + 1
        }
        return -1
    }

    func refuse_role(&var self, e: Int, t: Int, what: String) {
        var msg = StringBuilder()
        try! msg.append("this subscript is used as ")
        try! msg.append(what)
        try! msg.append(" (`")
        try! msg.append(self.type_text(t))
        try! msg.append("` declares or derives no such role)")
        let m = self.node_module(e)
        self.refuse_in(m, e, "subscript.role", msg.build())
    }
}

// The body half's refusals.
extension TcProgram {
    // A `Result` computed where nothing reads it is refused (design 151): a
    // statement, a `Void` body's or a loop body's tail, a statement-position
    // arm. A statement-position `if` or `match` forwards its arms' values,
    // which are statements of their own, so the refusal lands on the call
    // that produced the `Result`. `let _ =` is the explicit out.
    func check_discarded(&var self, e: Int) {
        if e < 0 || not self.is_typed(e) {
            return
        }
        if self.has_alt(e, Alt.Expr_If) || self.has_alt(e, Alt.Expr_Match) || self.has_alt(e, Alt.Borrow_Block) {
            return
        }
        let t = self.final_type(e)
        if t < 0 || self.has_error(t) || not self.is_result(t) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("the result of ")
        let at = self.call_at[e]
        if at >= 0 && self.calls[at].target >= 0 {
            let target = self.calls[at].target
            let name = self.res.decls[target].name
            try! msg.append("`")
            try! msg.append(self.name_text(name))
            try! msg.append("`")
        } else {
            try! msg.append("this expression")
        }
        try! msg.append(" is `")
        try! msg.append(self.type_text(t))
        try! msg.append("` and is silently discarded: handle it (`match` it, `try` or `try!` it, or return it), or write `let _ = ...` to discard it explicitly")
        self.refuse(e, "result.discarded", msg.build())
    }

    // A body construct outside the bootstrap slice, named by what it is
    // rather than by one grammar alternative; nothing under it is verified.
    func not_yet(&var self, e: Int, what: String) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(" is not in the bootstrap slice yet")
        self.refuse(e, "slice.not-yet", msg.build())
        try! self.skipped.push(e)
    }

    func refuse_mismatch(&var self, e: Int, from: Int, slot: Int, pos: TcPosition, allow: TcAllowance) {
        var msg = StringBuilder()
        try! msg.append("expected `")
        try! msg.append(self.type_text(slot))
        try! msg.append("`, the type of ")
        try! msg.append(self.position_text(pos))
        try! msg.append(", and found `")
        try! msg.append(self.type_text(from))
        try! msg.append("`")
        let hint = self.static_cast_hint(e, slot)
        if hint.len() > 0 {
            try! msg.append(hint)
        } else {
            try! msg.append(self.allowance_reason(from, slot, allow))
        }
        self.refuse(e, "type.mismatch", msg.build())
    }

    // The way out when `e` names a module static of an integer type where an
    // integer `to` is expected: outside a constant expression a static keeps
    // its declared type, as every named value does (SL:open-questions D17).
    // Empty otherwise.
    func static_cast_hint(&self, e: Int, to: Int) -> String {
        if not self.names_constant_static(e) || not self.is_integer(to) {
            return ""
        }
        let m = self.current
        let leaf = self.res.first_leaf(e)
        var out = StringBuilder()
        try! out.append("; a module static keeps its declared type outside a constant expression: write `")
        try! out.append(self.text(m, leaf))
        try! out.append(" as ")
        try! out.append(self.type_text(to))
        try! out.append("`")
        out.build()
    }

    func refuse_ambiguous_result(&var self, e: Int, slot: Int) {
        var msg = StringBuilder()
        try! msg.append("both payloads of `")
        try! msg.append(self.type_text(slot))
        try! msg.append("` can take this value, so it names neither: write `.Ok(value: ...)` or `.Err(error: ...)`")
        self.refuse(e, "type.ambiguous-result", msg.build())
    }

    func refuse_implicit_copy(&var self, e: Int, t: Int) {
        var msg = StringBuilder()
        try! msg.append("this reads a place of type `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, which is ")
        try! msg.append(self.tier_word(t))
        try! msg.append(", by value: only a Copy type copies silently; write `move` to take it, `.copy()` for a copy, or borrow it")
        self.refuse(e, "transfer.implicit-copy", msg.build())
    }

    // A bare call of a `consumes` method on a place (spec, `consumes`: "Both
    // ends are marked").
    func refuse_bare_consume(&var self, receiver: Int, d: Int) {
        let m = self.current
        let name_id = self.res.decls[d].name
        let name = self.name_text(name_id)
        let written = self.text(m, receiver)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(name)
        try! msg.append("` consumes its receiver, so the transfer is spelled at the call: write `(move ")
        try! msg.append(written)
        try! msg.append(").")
        try! msg.append(name)
        try! msg.append("(...)`; a temporary receiver needs no `move`")
        self.refuse(receiver, "consumes.move", msg.build())
    }

    func refuse_implicit_without_type(&var self, e: Int, name: Int) {
        let text = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`.")
        try! msg.append(text)
        try! msg.append("` is an implicit member, and nothing here expects a type it could be a case of: write `Enum.")
        try! msg.append(text)
        try! msg.append("`")
        self.refuse(e, "implicit-member.no-type", msg.build())
    }

    func refuse_no_such_case(&var self, e: Int, name: Int, want: Int) {
        var msg = StringBuilder()
        try! msg.append("`.")
        try! msg.append(self.name_text(name))
        try! msg.append("` is no case of the expected `")
        try! msg.append(self.type_text(want))
        try! msg.append("`")
        self.refuse(e, "type.mismatch", msg.build())
    }

    func refuse_payload_needed(&var self, e: Int, c: Int) {
        var msg = StringBuilder()
        try! msg.append("case `")
        try! msg.append(self.res.decl_path(c))
        try! msg.append("` carries a payload, so it is built with its payload: `")
        let name = self.res.decls[c].name
        try! msg.append(self.name_text(name))
        try! msg.append("(...)`")
        self.refuse(e, "call.arity", msg.build())
    }

    func refuse_not_a_value(&var self, e: Int, leaf: Int) {
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, leaf))
        try! msg.append("` names a type, a module or a trait, not a value")
        self.refuse(e, "type.not-a-value", msg.build())
    }

    func refuse_type_arity(&var self, leaf: Int, d: Int, written: Int) {
        let s = self.sigs[d]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` takes ")
        try! msg.append(s.generic_count)
        try! msg.append(" type arguments, and ")
        try! msg.append(written)
        try! msg.append(" are written")
        self.refuse(leaf, "type.arity", msg.build())
    }

    func refuse_not_a_place(&var self, e: Int) {
        self.refuse(e, "type.not-a-place",
                    "this is a value, not a place: it cannot be assigned, moved from or borrowed exclusively")
    }

    func refuse_unknown_member(&var self, leaf: Int, t: Int) {
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no member `")
        try! msg.append(self.text(m, leaf))
        try! msg.append("` this module can see")
        self.refuse(leaf, "member.unknown", msg.build())
    }

    func refuse_no_method(&var self, leaf: Int, t: Int, name: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no method `")
        try! msg.append(self.name_text(name))
        try! msg.append("` this module can see")
        self.refuse(leaf, "member.unknown", msg.build())
    }

    func refuse_operand(&var self, e: Int, what: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(", and this is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(e, "operator.undefined", msg.build())
    }

    func refuse_operator_type(&var self, s: Int, op: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(op)
        try! msg.append("` is not defined for `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(s, "operator.undefined", msg.build())
    }

    func refuse_operands_disagree(&var self, e: Int, a: Int, b: Int) {
        var msg = StringBuilder()
        try! msg.append("an operator's operands agree on one type, and these are `")
        try! msg.append(self.type_text(a))
        try! msg.append("` and `")
        try! msg.append(self.type_text(b))
        let hint = self.static_cast_hint(e, a)
        if hint.len() > 0 {
            try! msg.append("`")
            try! msg.append(hint)
        } else {
            try! msg.append("`; convert one with `as`")
        }
        self.refuse(e, "type.mismatch", msg.build())
    }

    func refuse_pattern(&var self, p: Int, what: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(": the matched value is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(p, "type.mismatch", msg.build())
    }

    // A candidate's signature for a message: its path, then each
    // parameter's label and type.
    func cand_text(&var self, c: TcCand) -> String {
        var out = StringBuilder()
        try! out.append(self.res.decl_path(c.decl))
        try! out.append("(")
        let count = self.cand_param_count(c)
        var k = 0
        while k < count {
            if k > 0 {
                try! out.append(", ")
            }
            let name = self.cand_param_name(c, k)
            try! out.append(self.name_text(name))
            try! out.append(": ")
            let t = self.cand_param_type(c, k)
            try! out.append(self.type_text(t))
            k = k + 1
        }
        try! out.append(")")
        let d = self.res.decls[c.decl]
        try! out.append(" [")
        try! out.append(self.res.module_name(d.module))
        try! out.append("]")
        out.build()
    }

    // Why the arguments bind to no parameter list of the one candidate.
    func refuse_binding(&var self, e: Int, c: TcCand, args: &TcArgs, status: Int, detail: Int) {
        var msg = StringBuilder()
        var rule = "call.arity"
        if status == TC_BIND_TOO_MANY {
            try! msg.append("too many arguments: ")
            try! msg.append(self.cand_text(c))
            try! msg.append(" takes ")
            try! msg.append(self.cand_param_count(c))
        } else if status == TC_BIND_MISSING {
            try! msg.append("missing an argument for `")
            let name = self.cand_param_name(c, detail)
            try! msg.append(self.name_text(name))
            try! msg.append("` of ")
            try! msg.append(self.cand_text(c))
        } else if status == TC_BIND_UNKNOWN_LABEL {
            rule = "call.label"
            try! msg.append("no parameter is labeled `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` in ")
            try! msg.append(self.cand_text(c))
        } else if status == TC_BIND_BACKWARD {
            rule = "call.label"
            try! msg.append("the label `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` names a parameter before one an earlier argument binds; arguments bind in order in ")
            try! msg.append(self.cand_text(c))
        } else {
            rule = "call.label"
            try! msg.append("the label `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` is written twice in a call of ")
            try! msg.append(self.cand_text(c))
        }
        self.refuse(e, rule, msg.build())
    }

    func refuse_no_match(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs) {
        var msg = StringBuilder()
        try! msg.append("no candidate takes these arguments; the candidates are ")
        var k = 0
        while k < cands.len() {
            if k > 0 {
                try! msg.append("; ")
            }
            try! msg.append(self.cand_text(cands[k]))
            k = k + 1
        }
        self.refuse(e, "call.no-match", msg.build())
    }

    func refuse_ambiguous(&var self, e: Int, cands: &Vector<TcCand>, best: &Vector<Int>) {
        var msg = StringBuilder()
        try! msg.append("ambiguous call: these candidates take the arguments equally well, so write labels or type arguments that pick one: ")
        var k = 0
        while k < best.len() {
            if k > 0 {
                try! msg.append("; ")
            }
            try! msg.append(self.cand_text(cands[best[k]]))
            k = k + 1
        }
        self.refuse(e, "call.ambiguous", msg.build())
    }
}
