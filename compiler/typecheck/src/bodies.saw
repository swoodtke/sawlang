// The body half of type checking (SL:architecture §3.4, "Type inference is
// local and bidirectional"): every body is checked against signatures only,
// and its results go into side tables keyed by resolve's node ids, never
// onto the tree. Per expression: its type, its adjustment chain, whether it
// is a place, and how its position reads it; per call, operator, subscript
// and loop head: what it calls, at what instantiation.
//
// One module holds the whole walk, since statements, expressions, calls and
// patterns recurse into each other and modules may not import in a cycle.
// This file is the position matrix of compiler/tests/typecheck/README.md: one
// method per kind of position, each dispatching on the alternatives GRAMMAR.md
// builds there. A construct outside the bootstrap slice is refused by name
// (`not_in_slice`), and nothing under it is checked.
//
// The walk recurses only into a node's children, so its depth is the tree's
// height, which the parser's depth funnel bounds.

import sawparse.grammar.{Alt, alt_name}
import sawparse.tree.{AstNode, NodeShape}
import sawresolve.collect.{res_is_top_level}
import sawresolve.dump.{res_sort_strings}
import sawresolve.imports.{res_decl_binding}
import sawresolve.kinds.{res_is_statement_alt, res_is_type_alt}
import sawresolve.prelude.{res_is_test_driver, res_is_test_intrinsic}
import sawresolve.model.{ResBindKind, ResBinding, ResCall, ResCallClass, ResDecl, ResDeclKind,
                             ResModule, ResModuleKind}
import sawtypecheck.adjust.{TC_FIT_AMBIGUOUS, TC_FIT_CONVERTED, TC_FIT_EXACT, TC_FIT_NONE,
                                TC_PEEL_AMBIGUOUS, TC_PEEL_NONE}
import sawtypecheck.candidates.{tc_contains}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.conform.{TcSubst, tc_copy_ints, tc_extension_sets}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.erasure.{tc_check_object_safety}
import sawtypecheck.arith.{TcFault, tc_arith_max, tc_arith_min, tc_arith_text}
import sawtypecheck.binders.{TcBinder, tc_binder_of, tc_binder_text}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.infer.{TcSolve, tc_solve}
import sawtypecheck.members.{tc_build_members}
import sawtypecheck.model.{TC_ANY_DEPTH, TC_BIND_DEFAULT, TC_EFFECT_BORROWS, TC_EFFECT_CONSUMES, TC_EFFECT_ESCAPING, TC_EFFECT_SENDABLE, TC_FLAG_STATIC, TC_FLAG_SYNTHESIZE_SHARED, TC_FLAG_UNSAFE_VAR, TC_FLAG_VARIADIC,
                               TC_TIER_EXPLICIT, TC_TIER_NOCOPY, TcAdjust, TcAdjustKind, TcAllowance, TcCall, TcCapture, TcCaptureBlock, TcConstPosition, TcHeadKind, TcLend, TcMember, TcParam,
                               TcPendingConstant, TcReceiver, TcRelocation, TcRole, TcSig, TcSource, TcUse}
import sawtypecheck.overloads.{tc_check_redeclarations}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.strings.{TcStringPosition}
// For the extension writing `satisfies`.
import sawtypecheck.tier.{tc_max}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TC_HOLDS_PARAM, TcKind, TcType, tc_kind_wraps}
import sawtypecheck.walks.{TcMemo, tc_memo}

// Checks every body of every module checked in full.
public func tc_check_bodies(p: &var TcProgram) {
    p.check_bodies()
}

// A position that expects a value but names no type.
static TC_WANT_NONE: Int = -1
// A statement: the value is discarded, and a block's last expression is no
// tail.
static TC_WANT_STMT: Int = -2
// `named_owner`'s answer for a generic type written without its arguments,
// which the call's inference solves: neither a type nor a refusal.
static TC_OWNER_INFER: Int = -2
// The kinds of operator a flat chain may hold.
static TC_OPS_ARITHMETIC: Int = 1
static TC_OPS_INTEGRAL: Int = 2
static TC_OPS_LOGICAL: Int = 4
static TC_OPS_WRAPPING: Int = 8

// The positions the expected-type funnel serves, which its refusals name.
public enum TcPosition {
    case Let,
    case Static,
    case Assign,
    case Argument,
    case Field,
    case Default,
    case Return,
    case Tail,
    case Branch,
    case Payload,
    case Compound,
    case Element,
    case ClosureTail,
    case Operand,
    case Coalesce
}

// Which funnel entry a block's tail goes through.
public enum TcTail {
    case Body,
    case Branch,
    case Closure,
    case Plain
}

// What a pattern's value comes from: a place, whose parts a binding copies,
// or an owned temporary, whose parts it takes.
public enum TcOrigin {
    // A place, whose part a binding copies out (design 131, the place rule).
    case Place,
    // An owned temporary, whose parts the bindings take.
    case Temporary,
    // An owned local a `match` consumes: each binding owns its part.
    case Owned,
    // A borrowed scrutinee, a field or a receiver: each binding aliases its
    // part.
    case Borrowed,
    // An optional place an accessor lends, reached through a `borrow`
    // binding: a plain binding copies its payload, as a place's does, and
    // `borrow let` is the way to read it in place (SL:borrowing §2.4).
    case Lent
}

extension TcProgram {
    // Sizes the side tables, then checks each body of each module that is
    // not an interface, and settles what each place's use decides.
    public func check_bodies(&var self) {
        let n = self.res.nodes.len()
        var k = 0
        while k < n {
            try! self.expr_types.push(-1)
            try! self.typed_count.push(0)
            try! self.expr_place.push(false)
            try! self.expr_use.push(TcUse.Unused)
            try! self.adj_head.push(-1)
            try! self.adj_tail.push(-1)
            try! self.call_at.push(-1)
            try! self.spawn_roots.push(false)
            try! self.drive_roots.push(false)
            try! self.local_types.push(-1)
            try! self.aliasing_bindings.push(false)
            try! self.lent_bindings.push(false)
            try! self.nonescaping_bindings.push(false)
            try! self.res_call_at.push(-1)
            try! self.string_positions.push(-1)
            try! self.implied_copies.push(-1)
            k = k + 1
        }
        k = 0
        while k < self.res.calls.len() {
            let c = self.res.calls[k]
            self.res_call_at[c.node] = k
            k = k + 1
        }
        let visible = tc_extension_sets(&self)
        self.ext_visible = move visible
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && not info.interface_only {
                self.check_module_bodies(m)
            }
            m = m + 1
        }
        self.judge_pending_constants()
        self.check_zero_inits()
        self.settle_places()
        self.settle_captures()
        self.check_thread_braces()
        self.check_task_spawn_environments()
    }

    func check_module_bodies(&var self, m: Int) {
        let info = self.res.modules[m]
        var d = info.decl_first
        while d < info.decl_first + info.decl_count {
            self.check_decl_body(d)
            d = d + 1
        }
        let root = info.root
        let n = self.child_count(root)
        var k = 0
        while k < n {
            let item = self.child(root, k)
            self.check_item_body(m, item)
            k = k + 1
        }
    }

    // The bodies at the top of a file that belong to no declaration: a
    // `static_assert`'s condition and a test case's block.
    func check_item_body(&var self, m: Int, item: Int) {
        guard let alt = self.node_alt(item) else {
            return
        }
        if alt == Alt.Decl_StaticAssert {
            self.enter_module(m)
            let c = self.res.first_node_child(item)
            self.begin_body(-1, c)
            self.check_condition(c)
            self.check_static_assert(item)
        } else if alt == Alt.Test_Case_Run || alt == Alt.Test_Case_Panics || alt == Alt.Test_Case_Warns {
            self.enter_module(m)
            self.current_test = true
            let body = self.res.last_node_child(item)
            self.begin_body(-1, body)
            self.body_result = self.void_type()
            let _ = self.check_block(body, TC_WANT_STMT, TcTail.Plain)
        } else if alt == Alt.Test_Group {
            let n = self.child_count(item)
            var k = 0
            while k < n {
                let sub = self.child(item, k)
                self.check_item_body(m, sub)
                k = k + 1
            }
        }
    }

    // Enters module `m` outside any declaration, in ordinary code.
    func enter_module(&var self, m: Int) {
        self.current = m
        self.current_decl = -1
        self.current_trait = -1
        self.current_ext = -1
        self.current_self = -1
        self.current_test = false
    }

    // Records `root` as a body of declaration `d`, for the dump and the
    // verifier, and resets what the walk tracks per body.
    func begin_body(&var self, d: Int, root: Int) {
        try! self.body_roots.push(root)
        try! self.body_decls.push(d)
        self.loop_breaks = Vector<Int>()
        self.catch_frames = Vector<Int>()
        self.catch_errors = Vector<Int>()
        self.referenced_params = Vector<Int>()
        self.current_root = root
    }

    // Marks the body being checked poisoned when `t`, a type a signature
    // gave it, could not be formed: the refusal that says why belongs to the
    // signature's module.
    public func poison_if(&var self, t: Int) {
        if t >= 0 && not self.has_error(t) {
            return
        }
        let root = self.current_root
        if root >= 0 && not tc_contains(&self.poisoned, root) {
            try! self.poisoned.push(root)
        }
    }

    // Declaration `d`'s bodies: a function's parameter defaults and block, a
    // static's initializer, a case's raw value.
    func check_decl_body(&var self, d: Int) {
        let info = self.res.decls[d]
        if info.node < 0 || self.in_refused_extension(d) {
            return
        }
        let saved = self.save_context()
        self.enter_decl(d)
        match info.kind {
            case Func -> self.check_function_body(d),
            case Method -> self.check_function_body(d),
            case Init -> self.check_function_body(d),
            case Requirement -> self.check_function_body(d),
            case Static -> self.check_static_body(d),
            case Case -> self.check_raw_value(d),
            case _ -> {}
        }
        self.check_align_attribute(d)
        self.restore_context(saved)
    }

    // Whether declaration `d` is a member of an extension refused as outside
    // the slice, whose parameters mean nothing a body could be checked by.
    func in_refused_extension(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if info.parent < 0 {
            return false
        }
        let parent = self.res.decls[info.parent]
        if parent.kind != ResDeclKind.Extension {
            return false
        }
        tc_contains(&self.skipped, parent.node)
    }

    // A function's parameters, their defaults, its receiver and its block.
    func check_function_body(&var self, d: Int) {
        let info = self.res.decls[d]
        let node = info.node
        let s = self.sigs[d]
        let n = self.child_count(node)
        var index = 0
        var block = -1
        var k = 0
        while k < n {
            let c = self.child(node, k)
            if self.has_alt(c, Alt.Decl_Param_Plain) || self.has_alt(c, Alt.Decl_Param_Default) {
                let leaf = self.res.first_leaf(c)
                var t = self.error_type
                var escaping = false
                if index < s.param_count {
                    let param = self.params[s.param_first + index]
                    t = param.ty
                    escaping = param.escaping
                }
                self.local_types[leaf] = t
                self.refuse_void_binding(c, leaf, t)
                if not escaping && self.kind_of(t) == TcKind.Func {
                    self.nonescaping_bindings[leaf] = true
                }
                try! self.param_leaves.push(leaf)
                if self.has_alt(c, Alt.Decl_Param_Default) {
                    let value = self.res.last_node_child(c)
                    self.begin_body(d, value)
                    self.body_result = t
                    if self.kind_of(t) == TcKind.Param {
                        self.check_generic_default(value, t)
                    } else {
                        self.check_default_value(value, t)
                    }
                }
                index = index + 1
            } else if self.has_alt(c, Alt.Decl_Param_Receiver) {
                let receiver = self.current_self
                self.local_types[c] = receiver
            } else if self.has_alt(c, Alt.Stmt_Block) {
                block = c
            }
            k = k + 1
        }
        if block < 0 {
            return
        }
        self.begin_body(d, block)
        self.body_result = s.result
        // A `borrows` body lends rather than returns: its value is the place
        // a `lend` names, a conditional lend's absent path returns `None`,
        // and its coverage is the effect checks' question.
        let lending = (s.effects & TC_EFFECT_BORROWS) != 0
        let lent = self.referent(s.result)
        if lending && lent >= 0 {
            self.body_result = lent
        }
        if self.is_void(s.result) || lending {
            let _ = self.check_block(block, TC_WANT_STMT, TcTail.Body)
        } else {
            let t = self.check_block(block, s.result, TcTail.Body)
            if t >= 0 && self.is_void(t) && not self.is_never(s.result) && not self.returns_void_ok(s.result) {
                self.refuse_body_falls_off(block, s.result)
            }
        }
    }

    // A static's initializer, which expects the static's type. One with none
    // is zero-initialized, which `check_zero_inits` checks once every body
    // is typed.
    func check_static_body(&var self, d: Int) {
        let s = self.sigs[d]
        let c = self.static_initializer(d)
        if c >= 0 {
            self.begin_body(d, c)
            self.body_result = s.result
            self.check_static_value(c, s.result)
            self.check_constant_position(c, TcConstPosition.Static, d, -1)
        }
    }

    // A raw-backed enum case's value, which expects the enum's backing type.
    func check_raw_value(&var self, d: Int) {
        let info = self.res.decls[d]
        let backing = self.sigs[info.parent].result
        let n = self.child_count(info.node)
        var k = 0
        while k < n {
            let c = self.child(info.node, k)
            // A documented case's doc comment is a child of its node too.
            if not self.is_leaf(c) && not self.has_alt(c, Alt.Decl_PayloadField) && not self.res.is_doc(c) {
                self.begin_body(d, c)
                self.body_result = backing
                if backing >= 0 {
                    self.check_static_value(c, backing)
                    self.check_constant_position(c, TcConstPosition.RawValue, d, -1)
                } else {
                    let _ = self.expr(c, TC_WANT_NONE)
                    self.consume(c)
                }
            }
            k = k + 1
        }
    }

    // An `@align(N)` argument, an integer.
    func check_align_attribute(&var self, d: Int) {
        let c = self.res.decl_attribute(d, Alt.Attr_Attribute_Align)
        if c < 0 {
            return
        }
        let e = self.res.first_node_child(c)
        if e >= 0 {
            self.begin_body(d, e)
            let t = self.int_type()
            self.body_result = t
            self.check_static_value(e, t)
            self.check_constant_position(e, TcConstPosition.Align, d, -1)
        }
    }

    func refuse_body_falls_off(&var self, block: Int, result: Int) {
        var msg = StringBuilder()
        try! msg.append("this body produces no value, and its function returns `")
        try! msg.append(self.type_text(result))
        try! msg.append("`: end it with an expression of that type, or return one")
        self.refuse(block, "type.mismatch", msg.build())
    }
}

// Side-table writes.
extension TcProgram {
    // Records expression `e`'s own type, and whether it is a place.
    public func set_type(&var self, e: Int, t: Int, place: Bool) -> Int {
        self.expr_types[e] = t
        self.typed_count[e] += 1
        self.expr_place[e] = place
        t
    }

    public func set_use(&var self, e: Int, u: TcUse) {
        if e >= 0 {
            self.expr_use[e] = u
        }
    }

    // Whether expression `e` has been typed.
    public func is_typed(&self, e: Int) -> Bool {
        self.typed_count[e] > 0
    }

    // Records a call's resolution; `receiver` is the node its receiver is
    // read from, or -1. Returns the record's index.
    public func record_call(&var self, e: Int, target: Int, role: TcRole, owner: Int,
                            inst: &Vector<Int>) -> Int {
        let first = self.insts.len()
        var k = 0
        while k < inst.len() {
            try! self.insts.push(inst[k])
            k = k + 1
        }
        let at = self.calls.len()
        let in_test = self.current_test
        try! self.calls.push(TcCall(node: e, target: target, role: role, derived: false, owner: owner,
                                    inst_first: first, inst_count: inst.len(), spelling: -1, twin: -1,
                                    bind_first: -1, bind_count: 0, variadic_from: -1,
                                    test: in_test))
        self.call_at[e] = at
        at
    }

    // Records that builtin operator or function `spelling` answers `e`.
    public func record_builtin(&var self, e: Int, target: Int, role: TcRole, text: String) {
        let none = Vector<Int>()
        let at = self.record_call(e, target, role, -1, &none)
        var c = self.calls[at]
        c.spelling = self.res.intern(text)
        self.calls[at] = c
    }
}

// Statements and blocks.
extension TcProgram {
    // Block `b`'s statements; with a value wanted, its last expression
    // statement is its tail, checked through the funnel entry `tail` names.
    // Returns the block's type: its tail's, `Never` when a statement
    // diverges, `Void` otherwise.
    public func check_block(&var self, b: Int, want: Int, tail: TcTail) -> Int {
        if b < 0 {
            return self.error_type
        }
        let n = self.child_count(b)
        var last = -1
        var k = 0
        while k < n {
            let c = self.child(b, k)
            if not self.is_leaf(c) {
                last = c
            }
            k = k + 1
        }
        var diverges = false
        k = 0
        while k < n {
            let s = self.child(b, k)
            k = k + 1
            if self.is_leaf(s) {
                continue
            }
            if s == last && want != TC_WANT_STMT && self.has_alt(s, Alt.Stmt_Expr) {
                let e = self.res.first_node_child(s)
                let t = self.check_tail(e, want, tail)
                if diverges {
                    return self.never_type()
                }
                return t
            }
            if self.check_statement(s) {
                diverges = true
            }
        }
        if diverges {
            return self.never_type()
        }
        self.void_type()
    }

    // A block's tail, through the funnel entry for where the block stands.
    func check_tail(&var self, e: Int, want: Int, tail: TcTail) -> Int {
        if want < 0 {
            let _ = self.expr(e, TC_WANT_NONE)
            let t = self.read_value(e)
            self.consume(e)
            return t
        }
        match tail {
            case Body -> self.check_body_tail(e, want),
            case Branch -> self.check_branch(e, want),
            case Closure -> self.check_closure_tail(e, want),
            case Plain -> {
                let _ = self.expr(e, TC_WANT_NONE)
                let t = self.read_value(e)
                self.consume(e)
                t
            }
        }
    }

    // One statement. Returns whether it diverges: control never reaches the
    // statement after it.
    public func check_statement(&var self, s: Int) -> Bool {
        guard let alt = self.node_alt(s) else {
            return false
        }
        self.check_statement_as(s, alt)
    }

    func check_statement_as(&var self, s: Int, alt: Alt) -> Bool {
        match alt {
            case Stmt_Expr -> {
                let e = self.res.first_node_child(s)
                let t = self.expr(e, TC_WANT_STMT)
                self.consume(e)
                self.check_discarded(e)
                self.is_never(t)
            },
            case Stmt_Let_Immutable -> {
                self.check_let(s)
                false
            },
            case Stmt_Let_Mutable -> {
                self.check_let(s)
                false
            },
            case Stmt_Destructure_Immutable -> {
                self.check_destructure(s)
                false
            },
            case Stmt_Destructure_Mutable -> {
                self.check_destructure(s)
                false
            },
            case Stmt_AttributedLocal -> {
                self.check_align_local(s)
                let local = self.res.last_node_child(s)
                self.check_statement(local)
            },
            case Stmt_Assign -> {
                self.check_assign(s)
                false
            },
            case Stmt_CompoundAssign -> {
                self.check_compound(s)
                false
            },
            case Stmt_OptionalAssign_Plain -> {
                self.check_optional_assign(s, false)
                false
            },
            case Stmt_OptionalAssign_Compound -> {
                self.check_optional_assign(s, true)
                false
            },
            case Stmt_OptionalAssign_BorrowPlain -> {
                self.check_optional_assign(s, false)
                false
            },
            case Stmt_OptionalAssign_BorrowCompound -> {
                self.check_optional_assign(s, true)
                false
            },
            case Stmt_Return -> {
                self.check_return(s)
                true
            },
            case Stmt_Break -> {
                self.check_break(s)
                true
            },
            case Stmt_Continue -> true,
            case Stmt_Lend -> {
                self.check_lend(s)
                false
            },
            case Stmt_Guard_Let -> {
                self.check_guard_let(s)
                false
            },
            case Stmt_Guard_Var -> {
                self.check_guard_let(s)
                false
            },
            case Stmt_Guard_Condition -> {
                self.check_guard_condition(s)
                false
            },
            case Decl_StaticAssert -> {
                let c = self.res.first_node_child(s)
                self.check_condition(c)
                self.check_static_assert(s)
                false
            },
            case _ -> {
                self.not_in_slice(s, alt)
                false
            }
        }
    }

    // `let x = e`, `let x: T = e`, and their `var` forms.
    func check_let(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        var annotation = -1
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if c != target && c != value && not self.is_leaf(c) && res_is_type_alt(self.node_alt(c)) {
                annotation = c
            }
            k = k + 1
        }
        var t = self.error_type
        if annotation >= 0 {
            t = self.build_type(annotation)
            self.check_let_value(value, t)
        } else {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            t = self.read_through_reference(value)
        }
        self.bind_target(target, t, TcOrigin.Temporary)
        // `let g = f` keeps a non-escaping `f`'s kind (SL:open-questions D35).
        if self.has_alt(target, Alt.Stmt_BindingName) && self.nonescaping_value(value) {
            let leaf = self.res.first_leaf(target)
            if leaf >= 0 {
                self.nonescaping_bindings[leaf] = true
            }
        }
    }

    // The type a position that names none takes from expression `e`: a
    // reference read through a binding gives its referent's value (spec,
    // Reference Semantics: "References auto-dereference on read"), copied
    // out as any place read is. A bare `&` keeps its reference type, which
    // the reference-position check refuses.
    func read_through_reference(&var self, e: Int) -> Int {
        let read = self.reads_reference(e)
        let t = self.read_value(e)
        if read && not self.copies_silently(t) {
            self.refuse_implicit_copy(e, t)
        }
        t
    }

    // Whether expression `e` reads a reference place, a reference binding or
    // a borrowing struct's reference field, whose read yields the referent
    // (SL-474). A bare `&x` is no place, and keeps its reference type.
    public func reads_reference(&self, e: Int) -> Bool {
        if e < 0 || not self.expr_place[e] {
            return false
        }
        let ft = self.final_type(e)
        if ft < 0 || self.kind_of(ft) != TcKind.Ref {
            return false
        }
        let inner = self.referent(ft)
        not self.has_error(inner)
    }

    // The type inference unifies argument `v` with, against parameter type
    // `pt`: a reference parameter meets the reference, which its sigil
    // forwards; any other reads `v`'s value (`read_value`).
    func arg_value_type(&var self, v: Int, pt: Int) -> Int {
        if self.kind_of(pt) == TcKind.Ref || self.kind_of(pt) == TcKind.Slice {
            return self.final_type(v)
        }
        self.read_value(v)
    }

    // The value a position that reads expression `e` receives: a reference
    // place's referent, its read recorded as a `Deref` step, or `e`'s own
    // type. Every by-value position reads through it, so `(p, 1)` over
    // `p: &Int` is an `(Int, Int)`, as `let n = p` is an `Int`; the copy
    // tier decides the read as any place read's (spec, Reference Semantics).
    //
    // ENTRY POINTS:
    //     expect (every position of the expected-type funnel)
    //     read_through_reference (an unannotated `let`, a closure's tail)
    //     arg_value_type (an argument's type, as inference reads it)
    //     tuple_expr, array_expr, repeat_expr, map_expr, set_expr (an element
    //         with nothing expected)
    //     coalesce_expr (a `??`'s left operand)
    //     cell_construct (a cell's value with nothing expected)
    //     check_tail, arm_body (a block's or an arm's value with nothing
    //         expected: a value `if`'s or `match`'s arm)
    public func read_value(&var self, e: Int) -> Int {
        let ft = self.final_type(e)
        if not self.reads_reference(e) {
            return ft
        }
        let inner = self.referent(ft)
        self.add_adjust(e, TcAdjustKind.Deref, inner)
        inner
    }

    // A reference place read by value, or a slice place passed bare, where a
    // reference parameter expects it: the call site spells the parameter's
    // sigil (spec, Reference forwarding), so the read is refused with the
    // forward written out.
    func refuse_unsigiled_reference(&var self, e: Int, slot: Int) {
        let m = self.current
        let sigil = if self.is_exclusive_ref(slot) { "&var " } else { "&" }
        var msg = StringBuilder()
        try! msg.append("this expects `")
        try! msg.append(self.type_text(slot))
        try! msg.append("`, and `")
        try! msg.append(self.text(m, e))
        let ft = self.final_type(e)
        if ft >= 0 && self.kind_of(ft) == TcKind.Slice {
            try! msg.append("` is a slice, which is forwarded as a reference is: forward it with its sigil, `")
        } else {
            try! msg.append("` read here is its referent's value: forward the reference with its sigil, `")
        }
        try! msg.append(sigil)
        try! msg.append(self.text(m, e))
        try! msg.append("`, as the parameter spells it")
        self.refuse(e, "type.mismatch", msg.build())
    }

    // A sigil written on argument `e` that its parameter's type, `slot`,
    // does not spell: `&x` or `&var x` for a parameter taken by value, and
    // `&var x` or `borrow var p` for a shared reference. Call sites mirror
    // the parameter's reference spelling both ways (spec, Reference
    // forwarding), so each is refused with the spelling that matches.
    func refuse_sigil_mismatch(&var self, e: Int, slot: Int, ref_slot: Bool) -> Bool {
        var arg = e
        while self.has_alt(arg, Alt.Expr_Paren) {
            arg = self.res.first_node_child(arg)
        }
        let reference = self.has_alt(arg, Alt.Expr_Ref_Shared) || self.has_alt(arg, Alt.Expr_Ref_Exclusive)
        let exclusive = self.has_alt(arg, Alt.Expr_Ref_Exclusive) || self.has_alt(arg, Alt.Borrow_Place_Var)
        if not reference && not exclusive {
            return false
        }
        let m = self.current
        let operand = self.res.first_node_child(arg)
        let operand_text = if operand >= 0 { self.text(m, operand) } else { "" }
        var msg = StringBuilder()
        if not ref_slot {
            if not reference {
                return false
            }
            try! msg.append("this parameter takes `")
            try! msg.append(self.type_text(slot))
            try! msg.append("` by value, and `")
            try! msg.append(self.text(m, arg))
            try! msg.append("` passes a reference: drop the sigil, `")
            try! msg.append(operand_text)
            try! msg.append("`")
            if not self.copies_silently(slot) {
                try! msg.append(", which hands the value over; ")
                if self.tier_word(slot).equals("ExplicitCopy") {
                    try! msg.append("`")
                    try! msg.append(operand_text)
                    try! msg.append(".copy()` passes a copy")
                } else {
                    try! msg.append("`move ")
                    try! msg.append(operand_text)
                    try! msg.append("` moves an owned one")
                }
            }
            try! msg.append(" (call sites mirror the parameter's reference spelling)")
            self.refuse(e, "type.mismatch", msg.build())
            return true
        }
        if not exclusive || self.is_exclusive_ref(slot) {
            return false
        }
        try! msg.append("this parameter is `")
        try! msg.append(self.type_text(slot))
        try! msg.append("`, a shared reference, and `")
        try! msg.append(self.text(m, arg))
        try! msg.append("` borrows exclusively: write `")
        if reference {
            try! msg.append("&")
        } else {
            try! msg.append("borrow ")
        }
        try! msg.append(operand_text)
        try! msg.append("` (call sites mirror the parameter's reference spelling)")
        self.refuse(e, "type.mismatch", msg.build())
        true
    }

    // `let (a, b) = e`: the tuple pattern against the value's type.
    func check_destructure(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let _ = self.expr(value, TC_WANT_NONE)
        self.consume(value)
        let t = self.final_type(value)
        let from = TcOrigin.Temporary
        self.check_pattern(target, t, from)
    }

    // A binding target: a BindingName, bound to `t`, or a tuple pattern.
    func bind_target(&var self, target: Int, t: Int, from: TcOrigin) {
        if self.has_alt(target, Alt.Stmt_BindingName) {
            let leaf = self.res.first_leaf(target)
            self.bind_part(target, leaf, t, from)
        } else {
            self.check_pattern(target, t, from)
        }
    }

    // A name bound, at `node`, to a value whose type is `Void` in the body
    // being checked: the value does not exist, so there is nothing to name,
    // and `_` is the spelling (spec, "Binding a `Void` expression"). A
    // generic body is checked once, so a binding a type parameter types
    // never reaches `Void` here, which keeps it instantiation-uniform.
    // A declared parameter is the one position `_` does not excuse: no
    // context dictates a signature, so the parameter is dropped instead, and
    // its refusal is `type.void-parameter`. `bind_part` and `bind_borrow`
    // call it for each pattern binding position:
    //
    // ENTRY POINTS:
    //     check_let (`let x = e`, `var x = e`, annotated or not)
    //     check_destructure (a tuple pattern's element)
    //     check_optional_binding (`if let`, `if var`, `guard let`, `while let`)
    //     name_pattern (a `match` arm's binding: a payload, a tuple element,
    //         the whole value)
    //     for_expr (a `for` variable)
    //     bind_borrow (a `borrow let` or `borrow var` binding)
    //     closure_typed (a closure parameter, its type written or expected)
    //     check_function_body (a function's, method's, `init`'s or
    //         requirement's declared parameter)
    func refuse_void_binding(&var self, node: Int, leaf: Int, t: Int) {
        if leaf < 0 || not self.is_void(t) {
            return
        }
        let m = self.current
        let name = self.text(m, leaf)
        if self.has_alt(node, Alt.Decl_Param_Plain) || self.has_alt(node, Alt.Decl_Param_Default) {
            var msg = StringBuilder()
            try! msg.append("parameter `")
            try! msg.append(name)
            try! msg.append("` is declared `Void`, a value that does not exist, so there is nothing to pass or to name: drop the parameter")
            self.refuse(node, "type.void-parameter", msg.build())
            return
        }
        if name.equals("_") {
            return
        }
        var msg = StringBuilder()
        try! msg.append("cannot bind `")
        try! msg.append(name)
        if self.is_closure_param(node) {
            try! msg.append("` to an expression of type `Void` — it produces no value: write `_` in its place to take the argument and bind nothing (`\{ _ in ... \}`)")
        } else {
            try! msg.append("` to an expression of type `Void` — it produces no value: write `_` in its place to evaluate it and bind nothing (`let _ = ...`, `if let _ = ...`, `case Ok(_)`), or call it as a statement on its own line")
        }
        self.refuse(node, "type.void-binding", msg.build())
    }

    // A binding, at `node`, of a part of type `t`, declared at `leaf`: it
    // copies the part out of a place, takes it from a temporary or from a
    // consumed local, or aliases it in a borrowed scrutinee. `_` binds
    // nothing, so it reads no part.
    func bind_part(&var self, node: Int, leaf: Int, t: Int, from: TcOrigin) {
        if leaf >= 0 {
            self.local_types[leaf] = t
        }
        let _ = self.set_type(node, t, true)
        let m = self.current
        if leaf >= 0 {
            let written = self.text(m, leaf)
            if written.equals("_") {
                // `let _ = e` takes the value and drops it; `if let _ = e`
                // and a `_` payload only test.
                if from == TcOrigin.Temporary && self.has_alt(node, Alt.Stmt_BindingName) {
                    self.set_use(node, TcUse.Temp)
                } else {
                    self.set_use(node, TcUse.Test)
                }
                return
            }
        }
        self.refuse_void_binding(node, leaf, t)
        match from {
            case Place -> {
                self.set_use(node, TcUse.Copy)
                if not self.copies_silently(t) {
                    self.refuse_implicit_copy(node, t)
                }
            },
            case Lent -> {
                self.set_use(node, TcUse.Copy)
                if not self.copies_silently(t) {
                    self.refuse_lent_copy(node, t)
                }
            },
            case Temporary -> self.set_use(node, TcUse.Temp),
            case Owned -> self.set_use(node, TcUse.Move),
            case Borrowed -> {
                self.set_use(node, TcUse.Borrow)
                if leaf >= 0 {
                    self.aliasing_bindings[leaf] = true
                }
            }
        }
    }

    // What a `match` scrutinee's bindings take their parts from: a
    // temporary; an owned local, consumed unless its type copies silently,
    // which moves it into the match's own storage and so is a relocation;
    // or anything else a place is, which the match borrows. A name that
    // reads through a borrow owns nothing, so a match borrows it as it
    // borrows a reference: a `borrow` binding, a payload binding aliasing a
    // borrowed scrutinee, a `[&x]` or `[&var x]` capture (SL-478).
    func scrutinee_origin(&var self, scrutinee: Int, t: Int) -> TcOrigin {
        let own = self.expr_types[scrutinee]
        if not self.expr_place[scrutinee] && not self.is_reference(own) {
            return TcOrigin.Temporary
        }
        if self.is_optional(t) && self.lent_place(scrutinee) {
            return TcOrigin.Lent
        }
        if self.has_alt(scrutinee, Alt.Expr_Name) && not self.is_reference(own) {
            let leaf = self.res.first_leaf(scrutinee)
            let b = self.binding_at(leaf)
            let owned = b.kind == ResBindKind.Local && b.node >= 0 && not self.has_alt(b.node, Alt.Decl_Param_Receiver)
            if owned && not self.aliasing_bindings[b.node] && not tc_contains(&self.borrow_captures, b.node) {
                if self.copies_silently(t) {
                    return TcOrigin.Place
                }
                self.set_use(scrutinee, TcUse.Move)
                let d = self.current_decl
                self.check_relocation(scrutinee, scrutinee, t, d, TcRelocation.Match)
                return TcOrigin.Owned
            }
        }
        TcOrigin.Borrowed
    }

    // `place = value`: the target is written, and names the value's
    // expected type at every target kind (design 87).
    func check_assign(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let t = self.check_target(target, TcUse.Write)
        let outer = self.placement_value
        if self.is_pointer_write(target) {
            self.placement_value = self.unparen(value)
        }
        self.check_assigned(value, t)
        let placed = self.placement_value
        if self.is_pointer_write(target) && self.is_fresh_parameter(placed) {
            try! self.fresh_placements.push(placed)
        }
        self.placement_value = outer
        // A non-escaping local may take another non-escaping value; any other
        // target holds it past the call (SL:open-questions D35).
        if self.nonescaping_value(value) && not self.nonescaping_value(target) {
            self.refuse_escape(value, "the assignment's target")
        }
    }

    // Whether assignment target `target` writes through a mutable raw
    // pointer, `ptr[i]`: the one write into storage nothing initialized.
    func is_pointer_write(&var self, target: Int) -> Bool {
        if not self.has_alt(target, Alt.Expr_Subscript_Single) {
            return false
        }
        let base = self.res.first_node_child(target)
        let bt = self.final_type(base)
        let inner = self.referent(bt)
        let t = if inner >= 0 { inner } else { bt }
        self.nominal_decl(t) == self.known.unsafe_pointer
    }

    // `place op= value`: the target is read and written, and the value
    // expects the target's type, but for a shift's count, which is checked as
    // a binary shift's is: no peer of the target (spec, Integer Width
    // Agreement, "The compound forms `<<=` and `>>=` follow").
    func check_compound(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        let t = self.check_target(target, TcUse.Update)
        self.check_compound_operands(s, value, t)
    }

    // A compound assignment's operator and right side `value`, against its
    // target's type `t`.
    func check_compound_operands(&var self, s: Int, value: Int, t: Int) {
        let op = self.compound_op_text(s)
        if self.has_error(t) {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            return
        }
        let shift = op.equals("<<=") || op.equals(">>=")
        let arithmetic = op.equals("+=") || op.equals("-=") || op.equals("*=") || op.equals("/=") || op.equals("%=")
        let integer = self.is_integer(t)
        if shift {
            let shifted = if integer { t } else { -1 }
            self.shift_count(value, -1, shifted)
            if not integer {
                self.refuse_operator_type(s, op, t)
            }
            return
        }
        self.check_compound_value(value, t)
        // `%=`, `&=`, `|=` and `^=` take integers alone, as their binary
        // operators do; a `Bool` takes the logical operators.
        if op.equals("%=") && not integer {
            self.refuse_operator_type(s, op, t)
        } else if arithmetic && not self.is_numeric(t) {
            self.refuse_operator_type(s, op, t)
        } else if not arithmetic && not integer {
            self.refuse_operator_type(s, op, t)
        } else if integer && (op.equals("/=") || op.equals("%=")) {
            self.check_certain_fault(-1, value, t, true)
        }
    }

    // The operator a compound assignment writes.
    func compound_op_text(&self, s: Int) -> String {
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if self.is_leaf(c) {
                let m = self.current
                return self.text(m, c)
            }
            k = k + 1
        }
        ""
    }

    // An assignment target: a place, marked with how it is used. Returns
    // the type a value assigned to it must have, a reference's referent
    // when the target is a reference binding (design 110).
    func check_target(&var self, target: Int, u: TcUse) -> Int {
        let t = self.expr(target, TC_WANT_NONE)
        if self.has_error(t) {
            self.set_use(target, u)
            return self.error_type
        }
        if not self.expr_place[target] {
            self.refuse_not_a_place(target)
        }
        self.set_use(target, u)
        let inner = self.referent(t)
        if inner >= 0 {
            self.add_adjust(target, TcAdjustKind.Deref, inner)
            return inner
        }
        t
    }

    // `a?.b = v` and `a?.b op= v` as a statement, whose `Void?` is discarded.
    func check_optional_assign(&var self, s: Int, compound: Bool) {
        let target = self.res.first_node_child(s)
        let value = self.res.last_node_child(s)
        self.check_chain_write(s, target, value, compound)
    }

    // An optional assignment (spec, Optionals, "Chained assignment"), `target`
    // its chain or its `borrow var` form, `value` its right side: the target
    // names a field reached through each optional hop's payload, written only
    // where every hop is present, and the value is checked against that field
    // as an assignment's or, `compound`, a compound assignment's operand is,
    // its operator `s`'s. A head that is a conditional lend takes no `?` past
    // its own (spec: "bind the lend first"). The assignment's value is
    // `Void?`, which its position discards or tests.
    //
    // ENTRY POINTS (check_chain_write):
    //     check_optional_assign
    //     check_optional_binding
    func check_chain_write(&var self, s: Int, target: Int, value: Int, compound: Bool) {
        var chain = target
        if self.has_alt(target, Alt.Borrow_OptionalTarget) {
            chain = self.res.first_node_child(target)
        }
        let top = self.res.first_node_child(chain)
        let t = self.chain_hop(top)
        self.check_lend_hops(top)
        if compound {
            self.set_use(top, TcUse.Update)
        } else {
            self.set_use(top, TcUse.Write)
        }
        if self.has_error(t) {
            let _ = self.expr(value, TC_WANT_NONE)
            self.consume(value)
            return
        }
        if not self.expr_place[top] {
            self.refuse_not_a_place(top)
        }
        if compound {
            self.check_compound_operands(s, value, t)
            return
        }
        self.check_assigned(value, t)
        if self.nonescaping_value(value) {
            self.refuse_escape(value, "the assignment's target")
        }
    }

    // Hop `e` of an optional assignment's target, and the hops under it
    // down to the chain's head: an optional hop names a field of its base's
    // payload, and a member hop above one a field of its base. The head, and
    // the part of the chain below its first `?.`, are ordinary expressions;
    // a call through a `?.` is an optional chain's read, outside the slice.
    // Returns the type of the place `e` names.
    func chain_hop(&var self, e: Int) -> Int {
        if not self.above_optional_hop(e) {
            return self.expr(e, TC_WANT_NONE)
        }
        let optional = self.has_alt(e, Alt.Expr_OptionalMember)
        let base = self.res.first_node_child(e)
        let leaf = self.res.first_leaf(e)
        let bt = self.chain_hop(base)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        if not optional {
            return self.member_place(e, leaf, t, place)
        }
        if not self.is_optional(t) {
            self.refuse_operand(e, "`?.` reads through an Optional", t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let payload = self.arg_of(t, 0)
        self.member_place(e, leaf, payload, place)
    }

    // An optional assignment's target whose top hop is `top`: when its head
    // is a conditional lend, whose `?` is the lend's own, a second `?` hop
    // is refused (spec, Optionals: "One fence").
    func check_lend_hops(&var self, top: Int) {
        var hops = Vector<Int>()
        var at = top
        while at >= 0 && self.above_optional_hop(at) {
            if self.has_alt(at, Alt.Expr_OptionalMember) {
                try! hops.push(at)
            }
            at = self.res.first_node_child(at)
        }
        if hops.len() < 2 || not self.lends_conditionally(at) {
            return
        }
        let past = hops[hops.len() - 2]
        self.refuse(past, "borrowing.lend-chain",
                    "a `?.` hop past a conditional lend's own `?` is not supported: bind the lend first, as `if borrow var p = m.find(&k) \{ p.a?.b = v \}`")
    }

    // Whether `e` calls or subscripts a `borrows` accessor that may lend
    // nothing.
    func lends_conditionally(&self, e: Int) -> Bool {
        if e < 0 || self.call_at[e] < 0 {
            return false
        }
        let target = self.calls[self.call_at[e]].target
        if target < 0 {
            return false
        }
        let s = self.sigs[target]
        let conditional = s.lending == TcLend.ConditionalPlace || s.lending == TcLend.ConditionalSlice
        (s.effects & TC_EFFECT_BORROWS) != 0 && conditional
    }

    // The optional assignment a binding construct `head` tests, `if let _ =
    // a?.b = v`: its target, a chain or its `borrow var` form, which a right
    // side follows; -1 when the head's subject is an ordinary expression, an
    // optional chain read among them.
    public func chain_subject(&self, head: Int) -> Int {
        let n = self.child_count(head)
        var k = 0
        while k < n {
            let c = self.child(head, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            if self.has_alt(c, Alt.Borrow_OptionalTarget) || self.res.nodes[c].shape == NodeShape.OptionalChain {
                let value = self.node_after(head, c)
                if value >= 0 && not self.has_alt(value, Alt.Stmt_Block) {
                    return c
                }
                return -1
            }
        }
        return -1
    }

    // The node child of `id` after `c`, or -1.
    public func node_after(&self, id: Int, c: Int) -> Int {
        let n = self.child_count(id)
        var seen = false
        var k = 0
        while k < n {
            let x = self.child(id, k)
            k = k + 1
            if seen && not self.is_leaf(x) {
                return x
            }
            if x == c {
                seen = true
            }
        }
        return -1
    }

    // Whether `e` is an optional hop, or a member hop over one.
    func above_optional_hop(&self, e: Int) -> Bool {
        var at = e
        var steps = 0
        while at >= 0 && steps < 10000 {
            if self.has_alt(at, Alt.Expr_OptionalMember) {
                return true
            }
            if not self.has_alt(at, Alt.Expr_Member) {
                return false
            }
            at = self.res.first_node_child(at)
            steps = steps + 1
        }
        false
    }

    // `return` and `return e`.
    func check_return(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        let result = self.body_result
        if result < 0 && self.result_open {
            self.open_return(e)
            return
        }
        if e < 0 {
            if result >= 0 && not self.is_void(result) && not self.has_error(result) && not self.returns_void_ok(result) {
                var msg = StringBuilder()
                try! msg.append("`return` with no value, where `")
                try! msg.append(self.type_text(result))
                try! msg.append("` is returned")
                self.refuse(s, "type.mismatch", msg.build())
            }
            return
        }
        if result < 0 {
            let _ = self.expr(e, TC_WANT_NONE)
            self.consume(e)
            return
        }
        self.check_returned(e, result)
    }

    // The first `return` of a closure with no expected result, `e` its value
    // or -1: it gives the closure's result, which every later `return` and
    // the tail are checked against (design 213). A reference binding returned
    // gives its value, as a reference tail does.
    func open_return(&var self, e: Int) {
        var t = self.void_type()
        if e >= 0 {
            t = self.expr(e, TC_WANT_NONE)
            self.consume(e)
            t = self.final_type(e)
            if self.referent(t) >= 0 && self.expr_place[e] {
                t = self.read_through_reference(e)
            } else if self.is_reference(t) && not self.has_alt(e, Alt.Expr_Ref_Shared) && not self.has_alt(e, Alt.Expr_Ref_Exclusive) {
                self.refuse_reference_result(e, t)
            }
        }
        if not self.has_error(t) && not self.is_never(t) {
            self.body_result = t
        }
    }

    // Whether `t` is a `Result<Void, E>`, whose `Ok` a bare `return` and a
    // body that ends in a statement give.
    func returns_void_ok(&self, t: Int) -> Bool {
        if not self.is_result(t) {
            return false
        }
        let ok = self.arg_of(t, 0)
        self.is_void(ok)
    }

    // `break`, which counts toward its loop; a value is outside the slice.
    func check_break(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        if e >= 0 {
            self.not_in_slice(s, Alt.Stmt_Break)
            return
        }
        let depth = self.loop_breaks.len()
        if depth > 0 {
            self.loop_breaks[depth - 1] += 1
        }
    }

    // `lend place`: the place a `borrows` body lends, of the lent type.
    func check_lend(&var self, s: Int) {
        let e = self.res.first_node_child(s)
        let t = self.expr(e, TC_WANT_NONE)
        let d = self.current_decl
        if d < 0 || self.has_error(t) {
            self.set_use(e, TcUse.Borrow)
            return
        }
        let sig = self.sigs[d]
        var wanted = sig.result
        let inner = self.referent(wanted)
        if inner >= 0 {
            wanted = inner
        }
        if sig.lending_exclusive {
            self.set_use(e, TcUse.BorrowVar)
        } else {
            self.set_use(e, TcUse.Borrow)
        }
        // A conditional lend lends a present place of the payload, or passes
        // on another conditional lend whole.
        var also = -1
        if (sig.lending == TcLend.ConditionalPlace || sig.lending == TcLend.ConditionalSlice) && self.is_optional(wanted) {
            also = wanted
            wanted = self.arg_of(wanted, 0)
        }
        if t != wanted && t != also && not self.has_error(wanted) {
            var msg = StringBuilder()
            try! msg.append("`lend` hands out a place of type `")
            try! msg.append(self.type_text(t))
            try! msg.append("`, and this accessor lends `")
            try! msg.append(self.type_text(wanted))
            try! msg.append("`")
            self.refuse(e, "type.mismatch", msg.build())
        }
    }

    // `guard let x = e else { ... }`: the binding outlives the guard.
    func check_guard_let(&var self, s: Int) {
        let target = self.res.first_node_child(s)
        var subject = -1
        var block = -1
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if c != target && not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else if subject < 0 {
                    subject = c
                }
            }
            k = k + 1
        }
        self.check_optional_binding(s, target, subject)
        let _ = self.check_block(block, TC_WANT_STMT, TcTail.Plain)
    }

    // `guard cond else { ... }`.
    func check_guard_condition(&var self, s: Int) {
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    let _ = self.check_block(c, TC_WANT_STMT, TcTail.Plain)
                } else {
                    self.check_condition(c)
                }
            }
            k = k + 1
        }
    }

    // A condition: a `Bool`.
    public func check_condition(&var self, e: Int) {
        if e < 0 {
            return
        }
        let _ = self.expr(e, TC_WANT_NONE)
        self.consume(e)
        let ft = self.final_type(e)
        if self.is_bool(ft) || self.has_error(ft) || self.is_never(ft) {
            return
        }
        let inner = self.referent(ft)
        if inner >= 0 && self.is_bool(inner) {
            self.add_adjust(e, TcAdjustKind.Deref, inner)
            return
        }
        var msg = StringBuilder()
        try! msg.append("a condition is a `Bool`, and this is `")
        try! msg.append(self.type_text(ft))
        try! msg.append("`")
        self.refuse(e, "type.mismatch", msg.build())
    }
}

// The expected-type funnel and its entry points.
extension TcProgram {
    // The expected-type funnel (SL:architecture §3.4): checks expression `e`
    // where position `pos` expects `slot`, and records the conversions that
    // bring it there. A literal, a constant expression, an implicit member
    // and a construction take the slot as `peel` finds it, the same for every
    // position; any other expression is typed with the slot as a hint, then
    // converted within what the position allows (`allowance`). An expression
    // typed already, as argument inference types one first, is only
    // converted. The position takes the value, or, with `borrowed`, borrows
    // it. Returns the type the position receives.
    //
    // ENTRY POINTS (expect):
    //     check_let_value
    //     check_static_value
    //     check_assigned
    //     check_argument
    //     check_field_argument
    //     check_default_value
    //     check_returned
    //     check_body_tail
    //     check_branch
    //     check_payload
    //     check_compound_value
    //     check_element
    //     repeat_expr
    //     check_closure_tail
    //     check_operand
    //     check_compared
    //     check_coalesce_right
    func expect(&var self, e: Int, slot: Int, pos: TcPosition, borrowed: Bool) -> Int {
        let known = slot >= 0 && not self.has_error(slot)
        let allow = self.allowance(pos)
        if known && not self.is_typed(e) && self.raw_case_named(e) >= 0 && self.adopts_lone_case(pos) {
            // A lone raw-backed case is a constant of its backing, so an
            // integer slot takes its value (spec, Flag enums).
            let peeled = self.peel(slot, TcClient.Integer, -1, -1)
            if peeled >= 0 && self.is_integer(peeled) {
                let _ = self.expr(e, TC_WANT_NONE)
                self.add_adjust(e, TcAdjustKind.Adopt, peeled)
            }
        }
        if not self.is_typed(e) {
            if not known {
                // A poisoned slot was refused where it was written, so it is
                // still the hint: a literal that needs a type adopts the
                // poison rather than refusing a second time.
                let hint = if slot >= 0 { slot } else { TC_WANT_NONE }
                let _ = self.expr(e, hint)
            } else {
                let target = self.peeled_target(e, slot)
                if target == TC_PEEL_AMBIGUOUS {
                    self.refuse_ambiguous_result(e, slot)
                    let poisoned = self.error_type
                    let _ = self.expr(e, poisoned)
                    self.take(e, borrowed)
                    return poisoned
                }
                let outer = self.branch_allow
                self.branch_allow = allow
                let _ = self.expr(e, target)
                self.branch_allow = outer
            }
        }
        // A reference slot outside a call keeps the reference, which the
        // reference-position check refuses where the slot is declared.
        let ref_slot = known && (self.kind_of(slot) == TcKind.Ref || self.kind_of(slot) == TcKind.Slice)
        let sigiled = pos == TcPosition.Argument || pos == TcPosition.Field
        let read = self.reads_reference(e) && (sigiled || not ref_slot)
        let from = if read { self.read_value(e) } else { self.final_type(e) }
        self.check_escape(e, slot, pos)
        if not known {
            self.take(e, borrowed)
            return from
        }
        // A slice place is forwarded as a reference is, by its sigil, which
        // reborrows it; passed bare it would be a second handle on the same
        // elements that no loan accounts for (SL-607).
        let bare_slice = sigiled && from >= 0 && self.expr_place[e] && self.kind_of(from) == TcKind.Slice
        if (read || bare_slice) && ref_slot {
            self.take(e, true)
            self.refuse_unsigiled_reference(e, slot)
            return from
        }
        if pos == TcPosition.Argument && self.refuse_sigil_mismatch(e, slot, ref_slot) {
            self.take(e, borrowed)
            return from
        }
        let how = self.coerce(e, from, slot, allow)
        self.take(e, borrowed)
        if how == TC_FIT_NONE {
            let fp = self.known.func_pointer
            if fp >= 0 && self.is_nominal_of(slot, fp) && self.kind_of(from) == TcKind.Func {
                self.not_yet(e, "a function passed as a `FuncPointer`")
                return from
            }
            self.refuse_mismatch(e, from, slot, pos, allow)
            return from
        }
        if how == TC_FIT_AMBIGUOUS {
            self.refuse_ambiguous_result(e, slot)
            return from
        }
        self.check_slot_constant(e)
        slot
    }

    // An expression an integer slot takes: a bare literal, or its negation,
    // was settled where it was typed (`settle_literal`); a larger constant
    // expression is judged by its folded value, with a static or a raw-backed
    // case as a leaf, and so is a lone case adopted by an integer slot (spec,
    // Flag enums).
    func check_slot_constant(&var self, e: Int) {
        var lit = e
        if self.has_alt(e, Alt.Expr_Unary_Negate) {
            lit = self.res.first_node_child(e)
        }
        if self.has_alt(lit, Alt.Expr_Int) {
            return
        }
        self.check_constant_range(e)
    }

    // A constant expression, or a lone raw-backed case, must fold at the
    // integer type it is typed or adopted as, by typed arithmetic
    // (SL:architecture §3.10): a value that does not fit where it adopts, or
    // an operation that overflows its type, leaves its range; a shift count
    // out of range and a division by zero are faults of their own. A fold that
    // waits on a later declaration is judged by `defer_constant`.
    func check_constant_range(&var self, e: Int) {
        if not self.is_constant_expr(e) && self.raw_case_named(e) < 0 {
            return
        }
        let t = self.adopted_type(e)
        if t < 0 || not self.is_integer(t) {
            return
        }
        let v = self.fold_constant(e)
        if self.awaits_typing(&v) {
            self.defer_constant(TcPendingConstant.SlotRange(e: e))
            return
        }
        if v.ok || v.fault == TcFault.NotConstant || v.fault == TcFault.Cycle {
            return
        }
        self.refuse_constant_fault(&v, e, t)
    }

    // A fault the fold met, reported at `at`; `t` is the type a value did
    // not fit, for `NotFit`. A value adopting a slot it does not fit is a
    // mismatch, but a cast's own conversion is the constant-cast funnel's;
    // the other faults are the run-time panics a constant turns into compile
    // errors, each by name.
    func refuse_constant_fault(&var self, v: &TcFold, at: Int, t: Int) {
        if v.fault == TcFault.NotFit && v.at >= 0 && self.has_alt(v.at, Alt.Expr_Int) {
            // A literal that does not fit was refused where it was typed
            // (`settle_literal`).
            return
        }
        if v.fault == TcFault.NotFit && v.at == at && self.has_alt(at, Alt.Expr_Cast) {
            self.refuse_constant_cast(&v, at)
            return
        }
        var msg = StringBuilder()
        var rule = "type.mismatch"
        if v.fault == TcFault.NotFit {
            try! msg.append("constant expression ")
            try! msg.append(self.fold_text(&v))
            try! msg.append(" does not fit in `")
            try! msg.append(self.type_text(t))
            try! msg.append("` (range ")
            try! msg.append(self.int_range_text(t))
            try! msg.append(")")
        } else if v.fault == TcFault.Overflow {
            rule = "constant.overflow"
            try! msg.append("constant expression overflows `")
            try! msg.append(self.type_text(v.ty))
            try! msg.append("` (range ")
            try! msg.append(self.int_range_text(v.ty))
            try! msg.append(")")
        } else if v.fault == TcFault.ShiftRange {
            rule = "constant.shift-range"
            try! msg.append("constant expression shifts a value of type `")
            try! msg.append(self.type_text(v.ty))
            try! msg.append("` by a count outside its width")
        } else {
            rule = "constant.divide-by-zero"
            try! msg.append("constant expression divides by zero")
        }
        self.refuse(at, rule, msg.build())
    }
}

// The pending-constant funnel.
extension TcProgram {
    // The pending-constant funnel: constant judgment `j`, held until every
    // body is typed. A static or a raw-backed case declared after the
    // expression that names it has no typed value yet, so a fold through it
    // stops short and would let a certain fault through. A cast is always
    // held; any other check holds its judgment only when its fold
    // `awaits_typing`, so one that folds where it is met is judged there. A
    // static's initializer holds nothing: it may name only the statics above
    // it (spec, Compile-Time Evaluation).
    //
    // ENTRY POINTS (defer_constant):
    //     cast_expr
    //     check_certain_fault
    //     check_constant_range
    //     check_constant_position
    func defer_constant(&var self, j: TcPendingConstant) {
        try! self.pending_constants.push(j)
    }

    // Whether fold `v` stopped at a node no body has typed yet, while some
    // body is still unchecked: a value its judgment must wait for.
    func awaits_typing(&self, v: &TcFold) -> Bool {
        if self.constants_final || v.ok || v.fault != TcFault.NotConstant || v.at < 0 {
            return false
        }
        self.expr_types[v.at] < 0
    }

    // Each held judgment, in the order it was met, now that every body is
    // typed, each in its own module; a judgment whose expression holds a
    // refusal already is not made again.
    func judge_pending_constants(&var self) {
        self.constants_final = true
        let saved = self.save_context()
        var k = 0
        while k < self.pending_constants.len() {
            let j = self.pending_constants[k]
            k = k + 1
            match j {
                case Cast(e) -> self.check_constant_cast(e),
                case CertainFault(e, count, shifted, divides) -> {
                    self.current = self.node_module(count)
                    self.check_certain_fault(e, count, shifted, divides)
                },
                case SlotRange(e) -> {
                    if not self.refused_within(e) {
                        self.current = self.node_module(e)
                        self.check_constant_range(e)
                    }
                },
                case Position(e, pos, d, message) -> {
                    self.current = self.node_module(e)
                    self.check_constant_position(e, pos, d, message)
                }
            }
        }
        self.restore_context(saved)
    }
}

// The constant-position funnel.
extension TcProgram {
    // The constant-position funnel (spec, Compile-Time Evaluation, "The
    // constant grammar"): expression `e`, typed already, at position `pos`
    // of declaration `d`. It refuses the first sub-expression outside the
    // position's grammar (`static.not-constant`), a static whose value
    // depends on itself (`static.cycle`), a fault the fold meets in `e`
    // itself, and a `static_assert` whose condition folds to `false`
    // (`static_assert.failed`). An expression already refused inside is not
    // judged again, and outside a static's initializer a fold that waits on a
    // later declaration is judged by `defer_constant`. What the grammar admits
    // and the fold does not compute (an aggregate, `sizeof`, a const
    // parameter) is constant and unfolded;
    // `sizeof` and `alignof` of a type code generation lays out are admitted
    // only in a `static_assert`.
    //
    // ENTRY POINTS (check_constant_position):
    //     check_static_body
    //     check_raw_value
    //     check_align_attribute
    //     check_align_local
    //     check_static_assert
    func check_constant_position(&var self, e: Int, pos: TcConstPosition, d: Int, message: Int) {
        if e < 0 || self.refused_within(e) {
            return
        }
        let t = self.final_type(e)
        if t < 0 || self.has_error(t) {
            return
        }
        // An optional static is `static.optional`'s refusal, whatever it holds.
        let declared = if d >= 0 { self.sigs[d].result } else { -1 }
        if pos == TcConstPosition.Static && declared >= 0 && self.is_optional(declared) {
            return
        }
        let offender = self.constant_offender(e, pos, d)
        if offender >= 0 {
            self.refuse_not_constant(offender, pos)
            return
        }
        if pos == TcConstPosition.Assert {
            let measures = self.layout_measures(e)
            if measures.len() > 0 {
                self.defer_layout_assert(e, message, &measures)
                return
            }
        }
        if pos == TcConstPosition.Static && d >= 0 && self.refuse_static_cycle(d, e) {
            return
        }
        if pos != TcConstPosition.Static {
            let early = self.fold_constant(e)
            if self.awaits_typing(&early) {
                self.defer_constant(TcPendingConstant.Position(e: e, pos: pos, d: d, message: message))
                return
            }
        }
        let v = self.check_constant_faults(e)
        if pos == TcConstPosition.Assert && v.ok && v.ty >= 0 && self.is_bool(v.ty) && v.bits == 0 {
            var msg = StringBuilder()
            try! msg.append("static assertion failed")
            if message >= 0 {
                try! msg.append(": ")
                try! msg.append(self.assert_message_text(message))
            }
            self.refuse(e, "static_assert.failed", msg.build())
        }
    }

    // Every `sizeof` and `alignof` call in constant expression `e`: what a
    // `static_assert` reads from a layout.
    public func layout_measures(&self, e: Int) -> Vector<Int> {
        var out = Vector<Int>()
        self.collect_measures(e, &var out)
        move out
    }

    func collect_measures(&self, e: Int, out: &var Vector<Int>) {
        if e < 0 || self.is_leaf(e) {
            return
        }
        if self.measured_type(e) >= 0 {
            try! out.push(e)
            return
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            // Stage 0 workaround (SL:hazards S4): canonical: self.collect_measures(self.child(e, k), &var out)
            let c = self.child(e, k)
            self.collect_measures(c, &var out)
            k = k + 1
        }
    }

    // Whether layout measurement `e` is a `sizeof`, not an `alignof`.
    public func measures_size(&self, e: Int) -> Bool {
        let at = if e < self.call_at.len() { self.call_at[e] } else { -1 }
        if at < 0 {
            return false
        }
        let c = self.calls[at]
        c.spelling >= 0 && self.name_text(c.spelling).equals("sizeof")
    }

    // Defers the `static_assert` whose condition `e` reads layouts through
    // `measures` (SL:open-questions D40): the layout-assert funnel checks one
    // over concrete types once typecheck ends, and mono one over a type
    // parameter, per instantiation.
    func defer_layout_assert(&var self, e: Int, message: Int, measures: &Vector<Int>) {
        var generic = false
        var k = 0
        while k < measures.len() {
            // Stage 0 workaround (SL:hazards S4): canonical: if self.mentions_param(self.measured_type(measures[k])) {
            let measured = self.measured_type(measures[k])
            if self.mentions_param(measured) {
                generic = true
            }
            k = k + 1
        }
        try! self.layout_asserts.push(e)
        try! self.layout_assert_messages.push(message)
        // Stage 0 workaround (SL:hazards S4): canonical: try! self.layout_assert_decls.push(self.current_decl)
        let holder = self.current_decl
        try! self.layout_assert_decls.push(holder)
        try! self.layout_assert_generic.push(generic)
    }

    // A `static_assert`'s condition, at the top of a file or in a body.
    func check_static_assert(&var self, item: Int) {
        let c = self.res.first_node_child(item)
        let m = self.node_module(item)
        var message = -1
        let n = self.child_count(item)
        var k = 0
        while k < n {
            let child = self.child(item, k)
            k = k + 1
            if self.is_leaf(child) && self.text(m, child).starts_with("\"") {
                message = child
            }
        }
        self.check_constant_position(c, TcConstPosition.Assert, -1, message)
    }

    // A local's `@align(N)` argument, an integer.
    func check_align_local(&var self, s: Int) {
        let n = self.child_count(s)
        var k = 0
        while k < n {
            let c = self.child(s, k)
            if self.has_alt(c, Alt.Attr_Attribute_Align) {
                let e = self.res.first_node_child(c)
                if e >= 0 {
                    let t = self.int_type()
                    self.check_static_value(e, t)
                    self.check_constant_position(e, TcConstPosition.Align, -1, -1)
                }
            }
            k = k + 1
        }
    }

    // A `static_assert` message leaf as the refusal quotes it: the string
    // literal's contents.
    public func assert_message_text(&self, e: Int) -> String {
        let m = self.node_module(e)
        let text = self.text(m, e)
        let n = text.len()
        if n >= 2 {
            return text.substring(1, n - 1)
        }
        text
    }

    // Whether a refusal already stands inside expression `e`.
    func refused_within(&self, e: Int) -> Bool {
        let m = self.node_module(e)
        let n = self.res.nodes[e]
        var k = 0
        while k < self.diags.len() {
            let diag = self.diags[k]
            if diag.module == m && diag.start >= n.start && diag.end <= n.end {
                return true
            }
            k = k + 1
        }
        false
    }

    // The first sub-expression of `e` outside position `pos`'s constant
    // grammar, or -1. A static's initializer also aggregates: a struct's
    // memberwise construction, an array or repeat literal, a float, and an
    // earlier static of any type. A raw case's value names no static and no
    // other enum's case, which are not yet known when its cases are fixed.
    func constant_offender(&self, e: Int, pos: TcConstPosition, d: Int) -> Int {
        guard let alt = self.node_alt(e) else {
            return e
        }
        self.constant_offender_as(e, alt, pos, d)
    }

    func constant_offender_as(&self, e: Int, alt: Alt, pos: TcConstPosition, d: Int) -> Int {
        let aggregate = pos == TcConstPosition.Static
        match alt {
            case Expr_Int -> -1,
            case Expr_Bool_True -> -1,
            case Expr_Bool_False -> -1,
            case Expr_SourceLocation_Line -> -1,
            case Expr_Float -> if aggregate { -1 } else { e },
            case Expr_Paren -> self.constant_parts(e, pos, d),
            case Expr_Unary_Negate -> self.constant_parts(e, pos, d),
            case Expr_Unary_Complement -> self.constant_parts(e, pos, d),
            case Expr_Unary_Not -> self.constant_parts(e, pos, d),
            case Expr_Additive -> self.constant_parts(e, pos, d),
            case Expr_Multiplicative -> self.constant_parts(e, pos, d),
            case Expr_Shift -> self.constant_parts(e, pos, d),
            case Expr_Bitand -> self.constant_parts(e, pos, d),
            case Expr_Bitor -> self.constant_parts(e, pos, d),
            case Expr_Bitxor -> self.constant_parts(e, pos, d),
            case Expr_Compare_Pair -> self.constant_parts(e, pos, d),
            case Expr_And -> self.constant_parts(e, pos, d),
            case Expr_Or -> self.constant_parts(e, pos, d),
            case Expr_Cast -> {
                let operand = self.res.first_node_child(e)
                self.constant_offender(operand, pos, d)
            },
            case Expr_Array -> if aggregate { self.constant_parts(e, pos, d) } else { e },
            case Expr_Repeat -> if aggregate { self.constant_parts(e, pos, d) } else { e },
            case Expr_Name -> self.constant_name(e, pos),
            case Expr_Member -> self.constant_member(e, pos, d),
            case Expr_ImplicitMember -> self.constant_member(e, pos, d),
            case Expr_Call_Paren -> self.constant_call(e, pos, d),
            case _ -> e
        }
    }

    // The first offender among `e`'s expression children, or -1; a type
    // written among them, a cast's or a repeat's, is no offender.
    func constant_parts(&self, e: Int, pos: TcConstPosition, d: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) || res_is_type_alt(self.node_alt(c)) {
                continue
            }
            let found = self.constant_offender(c, pos, d)
            if found >= 0 {
                return found
            }
        }
        return -1
    }

    // A bare name: a module static whose value is fixed, or a const
    // parameter, which a raw case's value may not name.
    func constant_name(&self, e: Int, pos: TcConstPosition) -> Int {
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.TypeParam && pos != TcConstPosition.RawValue {
            return -1
        }
        if b.kind == ResBindKind.Decl && self.fixed_static(b.decl) && pos != TcConstPosition.RawValue {
            return -1
        }
        e
    }

    // Whether declaration `d` is a static whose value the source fixes: one
    // that is not an `unsafe static var`.
    func fixed_static(&self, d: Int) -> Bool {
        if d < 0 || self.res.decls[d].kind != ResDeclKind.Static {
            return false
        }
        (self.sigs[d].flags & TC_FLAG_UNSAFE_VAR) == 0
    }

    // A member: a case of a raw-backed enum (of the enum being declared, in
    // a raw case's value), an integer type's `max` or `min`, or a static
    // named through its module.
    func constant_member(&self, e: Int, pos: TcConstPosition, d: Int) -> Int {
        let leaf = self.res.last_leaf_of(e)
        if leaf < 0 {
            return e
        }
        let b = self.binding_at(leaf)
        let t = self.expr_types[e]
        if b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Case {
            let owner = self.res.decls[b.decl].parent
            if not self.raw_backed(owner) {
                return e
            }
            if pos == TcConstPosition.RawValue && d >= 0 && owner != self.res.decls[d].parent {
                return e
            }
            return -1
        }
        if b.kind == ResBindKind.Decl && self.fixed_static(b.decl) {
            if pos == TcConstPosition.RawValue {
                return e
            }
            return -1
        }
        let base = self.res.first_node_child(e)
        if base >= 0 && self.expr_types[base] < 0 && t >= 0 && self.is_integer(t) && leaf >= 0 {
            let m = self.node_module(e)
            let name = self.text(m, leaf)
            if name.equals("max") || name.equals("min") {
                return -1
            }
        }
        e
    }

    // Whether enum `d` has a raw backing.
    func raw_backed(&self, d: Int) -> Bool {
        if d < 0 || self.res.decls[d].kind != ResDeclKind.Enum {
            return false
        }
        let backing = self.sigs[d].result
        backing >= 0 && self.is_integer(backing)
    }

    // A call: a type alias's construction over a constant, `sizeof` and
    // `alignof`, and in a static's initializer a struct's memberwise
    // construction over constants. Any other call runs only at run time.
    // `sizeof` and `alignof` measure any type in a `static_assert`, and
    // elsewhere only a type whose layout the target alone fixes (spec,
    // "Layout in a constant").
    func constant_call(&self, e: Int, pos: TcConstPosition, d: Int) -> Int {
        let at = if e < self.call_at.len() { self.call_at[e] } else { -1 }
        if at < 0 {
            return e
        }
        let c = self.calls[at]
        let spelling = if c.spelling >= 0 { self.name_text(c.spelling) } else { "" }
        if c.role == TcRole.Builtin && (spelling.equals("sizeof") || spelling.equals("alignof")) {
            let t = self.measured_type(e)
            if pos == TcConstPosition.Assert || t < 0 || self.has_error(t) || self.target_fixes_layout(t) {
                return -1
            }
            return e
        }
        let alias = c.role == TcRole.Conversion && spelling.equals("alias")
        let memberwise = c.role == TcRole.Memberwise && pos == TcConstPosition.Static
        // `Atomic(<int>)` is a static's constant, the form the spec names
        // (SL:open-questions D38); no other construction of a cell is.
        let atomic = c.role == TcRole.Conversion && spelling.equals("atomic") && pos == TcConstPosition.Static
        if not alias && not memberwise && not atomic {
            return e
        }
        let callee = self.res.first_node_child(e)
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let child = self.child(e, k)
            k = k + 1
            if child == callee || self.is_leaf(child) || res_is_type_alt(self.node_alt(child)) {
                continue
            }
            var value = child
            if self.has_alt(child, Alt.Expr_Argument_Positional) || self.has_alt(child, Alt.Expr_Argument_Labelled) {
                value = self.res.last_node_child(child)
            }
            let found = self.constant_offender(value, pos, d)
            if found >= 0 {
                return found
            }
        }
        return -1
    }

    // The type `sizeof<T>()` or `alignof<T>()` call `e` measures, or -1 when
    // `e` is no such call.
    public func measured_type(&self, e: Int) -> Int {
        let at = if e < self.call_at.len() { self.call_at[e] } else { -1 }
        if at < 0 {
            return -1
        }
        let c = self.calls[at]
        let spelling = if c.spelling >= 0 { self.name_text(c.spelling) } else { "" }
        if c.role != TcRole.Builtin || not (spelling.equals("sizeof") || spelling.equals("alignof")) {
            return -1
        }
        let callee = self.res.first_node_child(e)
        let n = self.child_count(callee)
        var k = 0
        while k < n {
            let arg = self.child(callee, k)
            k = k + 1
            if not self.is_leaf(arg) && self.type_builds[arg] > 0 {
                return self.node_types[arg]
            }
        }
        return -1
    }

    // Whether the target alone fixes type `t`'s layout: the integers, `Bool`,
    // `Float`, `String` and the raw pointers. Code generation lays out every
    // other type, after the positions that would measure it are resolved.
    func target_fixes_layout(&self, t: Int) -> Bool {
        if self.is_integer(t) || self.is_bool(t) || self.is_float(t) || self.is_string(t) {
            return true
        }
        let d = self.nominal_decl(t)
        d >= 0 && (d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer)
    }

    func refuse_not_constant(&var self, e: Int, pos: TcConstPosition) {
        let m = self.node_module(e)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, e))
        try! msg.append("` is not a constant, and ")
        if pos == TcConstPosition.Static {
            try! msg.append("a static's initializer")
        } else if pos == TcConstPosition.RawValue {
            try! msg.append("a raw case's value")
        } else if pos == TcConstPosition.Align {
            try! msg.append("an `@align` argument")
        } else {
            try! msg.append("a `static_assert` condition")
        }
        try! msg.append(" is a constant expression: ")
        try! msg.append(self.not_constant_reason(e, pos))
        if pos == TcConstPosition.Static && self.measured_type(e) < 0 {
            try! msg.append("; state that has to be computed wants `static X: Once<T>`, set once, or an `unsafe static var`")
        }
        self.refuse_in(m, e, "static.not-constant", msg.build())
    }

    // Why sub-expression `e` is no constant at position `pos`.
    func not_constant_reason(&self, e: Int, pos: TcConstPosition) -> String {
        let leaf = if self.has_alt(e, Alt.Expr_Name) { self.res.first_leaf(e) } else { self.res.last_leaf_of(e) }
        let named = leaf >= 0 && (self.has_alt(e, Alt.Expr_Name) || self.has_alt(e, Alt.Expr_Member) || self.has_alt(e, Alt.Expr_ImplicitMember))
        let b = self.binding_at(if leaf >= 0 { leaf } else { e })
        if named && pos == TcConstPosition.RawValue && (b.kind == ResBindKind.Decl || b.kind == ResBindKind.Case || b.kind == ResBindKind.TypeParam) {
            return "it may not name a static or another enum's case, since an enum's cases are fixed by its own declaration, before either is known"
        }
        if named && b.kind == ResBindKind.Local {
            return "it names a binding whose value is known only at run time"
        }
        if named && b.kind == ResBindKind.Decl && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Static {
            return "it names an `unsafe static var`, whose value belongs to the running program"
        }
        if named && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Case {
            return "it is a case of an enum with no raw backing, which has no constant value"
        }
        let measured = self.measured_type(e)
        if measured >= 0 {
            var out = StringBuilder()
            try! out.append("`")
            try! out.append(self.type_text(measured))
            try! out.append("` is laid out only by code generation, so `sizeof` and `alignof` measure it only in a `static_assert`; elsewhere they measure an integer, `Bool`, `Float`, `String` or a raw pointer")
            return out.build()
        }
        if self.has_alt(e, Alt.Expr_Call_Paren) {
            return "a call runs only at run time, an `init` body included; only a type alias's construction, `sizeof`, `alignof` and a static's memberwise construction are constants"
        }
        if self.has_alt(e, Alt.Expr_String) || self.has_alt(e, Alt.Expr_Interpolation) || self.has_alt(e, Alt.Expr_SourceLocation_File) || self.has_alt(e, Alt.Expr_SourceLocation_Function) {
            return "a `String` is never a constant"
        }
        "a constant is built from literals, statics, raw-backed cases and the integer limits, under operators, casts between integers and a type alias's construction"
    }

    // Refuses static `d`'s initializer `e` when `d`'s value depends on
    // itself, once per cycle: at the earliest-declared static on it.
    func refuse_static_cycle(&var self, d: Int, e: Int) -> Bool {
        let cycle = self.static_cycle(d)
        if cycle.len() == 0 {
            return false
        }
        var k = 0
        while k < cycle.len() {
            if cycle[k] < d {
                return true
            }
            k = k + 1
        }
        var msg = StringBuilder()
        try! msg.append("static `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` depends on itself: ")
        k = 0
        while k < cycle.len() {
            try! msg.append("`")
            try! msg.append(self.res.decl_path(cycle[k]))
            try! msg.append("` -> ")
            k = k + 1
        }
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`; a static's value is fixed at compile time, so its initializer may name only statics that do not lead back to it")
        self.refuse(e, "static.cycle", msg.build())
        true
    }

    // The statics static `d`'s initializer leads back to `d` through, in
    // order from `d`, or an empty list when it leads to no cycle through
    // `d`.
    func static_cycle(&self, d: Int) -> Vector<Int> {
        var path = Vector<Int>()
        try! path.push(d)
        var seen = Vector<Int>()
        if self.reaches_static(d, d, &var path, &var seen) {
            return move path
        }
        Vector<Int>()
    }

    // Whether static `from`'s initializer leads to static `target`, `path`
    // the statics walked to `from`.
    func reaches_static(&self, from: Int, target: Int, path: &var Vector<Int>, seen: &var Vector<Int>) -> Bool {
        var refs = Vector<Int>()
        let value = self.static_initializer(from)
        self.statics_named(value, &var refs)
        var k = 0
        while k < refs.len() {
            let r = refs[k]
            k = k + 1
            if r == target {
                return true
            }
            if tc_contains(&seen, r) {
                continue
            }
            try! seen.push(r)
            try! path.push(r)
            if self.reaches_static(r, target, &var path, &var seen) {
                return true
            }
            var kept = Vector<Int>()
            var j = 0
            while j + 1 < path.len() {
                try! kept.push(path[j])
                j = j + 1
            }
            path = move kept
        }
        false
    }

    // Each fixed static expression `e` names, in source order, into `out`.
    func statics_named(&self, e: Int, out: &var Vector<Int>) {
        if e < 0 || self.is_leaf(e) {
            return
        }
        if self.has_alt(e, Alt.Expr_Name) || self.has_alt(e, Alt.Expr_Member) {
            let leaf = if self.has_alt(e, Alt.Expr_Name) { self.res.first_leaf(e) } else { self.res.last_leaf_of(e) }
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Decl && self.fixed_static(b.decl) {
                try! out.push(b.decl)
                return
            }
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            self.statics_named(c, &var out)
            k = k + 1
        }
    }

    // Expression `e`'s fold, with the faults it meets inside `e` refused;
    // one met inside a static `e` names is that static's refusal. Where `e`
    // is constant but unfolded, as an aggregate is, its parts are folded.
    func check_constant_faults(&var self, e: Int) -> TcFold {
        let v = self.fold_constant(e)
        if v.ok || v.fault == TcFault.Cycle {
            return v
        }
        if v.fault == TcFault.NotConstant {
            let n = self.child_count(e)
            var k = 0
            while k < n {
                let c = self.child(e, k)
                k = k + 1
                if not self.is_leaf(c) && not res_is_type_alt(self.node_alt(c)) {
                    let _ = self.check_constant_faults(c)
                }
            }
            return v
        }
        if v.at >= 0 && self.node_within(v.at, e) {
            let at = v.at
            let target = self.fault_target(at)
            self.refuse_constant_fault(&v, at, target)
        }
        v
    }

    // The type a value converted at node `at` lands in: its last adoption or
    // widening, or its own type, which a cast's is.
    func fault_target(&self, at: Int) -> Int {
        var t = self.expr_types[at]
        var a = self.adj_head[at]
        while a >= 0 {
            let adj = self.adjusts[a]
            if adj.kind == TcAdjustKind.Adopt || adj.kind == TcAdjustKind.Widen {
                t = adj.to
            }
            a = adj.next
        }
        t
    }

    // Whether node `inner` lies inside node `outer`, in one module.
    func node_within(&self, inner: Int, outer: Int) -> Bool {
        if self.node_module(inner) != self.node_module(outer) {
            return false
        }
        let a = self.res.nodes[inner]
        let b = self.res.nodes[outer]
        a.start >= b.start && a.end <= b.end
    }

    // The integer type literal `e` took: the one it adopted, or its own.
    func adopted_type(&self, e: Int) -> Int {
        var a = self.adj_head[e]
        while a >= 0 {
            let adj = self.adjusts[a]
            if adj.kind == TcAdjustKind.Adopt {
                return adj.to
            }
            a = adj.next
        }
        self.expr_types[e]
    }

    // Integer type `t`'s range, as the refusal spells it.
    func int_range_text(&self, t: Int) -> String {
        let w = self.int_width(t)
        if self.is_unsigned(t) {
            if w == 64 {
                return "0..=18446744073709551615"
            }
            var out = StringBuilder()
            try! out.append("0..=")
            try! out.append(((1 << w) - 1).to_string())
            return out.build()
        }
        if w == 64 {
            return "-9223372036854775808..=9223372036854775807"
        }
        var out = StringBuilder()
        try! out.append("-")
        try! out.append((1 << (w - 1)).to_string())
        try! out.append("..=")
        try! out.append(((1 << (w - 1)) - 1).to_string())
        out.build()
    }

    // How the funnel's position reads `e`: by value, or borrowed.
    func take(&var self, e: Int, borrowed: Bool) {
        if borrowed {
            if self.expr_use[e] == TcUse.Unused {
                self.set_use(e, TcUse.Borrow)
            }
            return
        }
        self.consume(e)
    }

    // What expression `e` is typed against in a slot of type `slot`: the
    // peeled slot for a literal, a constant expression, an implicit member
    // or a construction, the slot itself for anything else.
    func peeled_target(&var self, e: Int, slot: Int) -> Int {
        guard let alt = self.node_alt(e) else {
            return slot
        }
        if alt == Alt.Expr_Float {
            let peeled = self.peel(slot, TcClient.Floating, -1, -1)
            return self.peel_or_slot(peeled, slot)
        }
        if self.is_constant_expr(e) {
            let peeled = self.peel(slot, TcClient.Integer, -1, -1)
            return self.peel_or_slot(peeled, slot)
        }
        let name = self.implicit_member_name(e)
        if name >= 0 {
            let peeled = self.peel(slot, TcClient.Member, name, -1)
            return self.peel_or_slot(peeled, slot)
        }
        let constructed = self.constructed_decl(e)
        if constructed >= 0 {
            let peeled = self.peel(slot, TcClient.Construct, -1, constructed)
            return self.peel_or_slot(peeled, slot)
        }
        slot
    }

    func peel_or_slot(&self, peeled: Int, slot: Int) -> Int {
        if peeled == TC_PEEL_NONE {
            return slot
        }
        peeled
    }

    // Whether `e` is a constant expression over integer literals: a
    // literal, a negation, or an arithmetic, shift or bit operator over them.
    public func is_constant_expr(&self, e: Int) -> Bool {
        guard let alt = self.node_alt(e) else {
            return false
        }
        self.is_constant_alt(e, alt)
    }

    func is_constant_alt(&self, e: Int, alt: Alt) -> Bool {
        match alt {
            case Expr_Int -> not self.is_suffixed_literal(e),
            case Expr_Unary_Negate -> {
                let inner = self.res.first_node_child(e)
                self.is_constant_part(inner)
            },
            case Expr_Unary_Complement -> {
                let inner = self.res.first_node_child(e)
                self.is_constant_part(inner)
            },
            case Expr_Additive -> self.all_constant(e),
            case Expr_Multiplicative -> self.all_constant(e),
            case Expr_Shift -> self.all_constant(e),
            case Expr_Bitand -> self.all_constant(e),
            case Expr_Bitor -> self.all_constant(e),
            case Expr_Bitxor -> self.all_constant(e),
            case _ -> false
        }
    }

    func all_constant(&self, e: Int) -> Bool {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) && not self.is_constant_part(c) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether `e` may stand inside a constant expression: a constant
    // expression, or a name the fold reads, a module `static` of an integer
    // type (spec, Integer Width Agreement). A bare static anywhere else,
    // an operator's peer included, keeps its declared type.
    public func is_constant_part(&self, e: Int) -> Bool {
        self.is_constant_expr(e) || self.names_constant_static(e) || self.raw_case_named(e) >= 0
    }

    public func names_constant_static(&self, e: Int) -> Bool {
        if not self.has_alt(e, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return false
        }
        let info = self.res.decls[b.decl]
        if info.kind != ResDeclKind.Static {
            return false
        }
        let s = self.sigs[b.decl]
        (s.flags & TC_FLAG_UNSAFE_VAR) == 0 && s.result >= 0 && self.is_integer(s.result)
    }

    // Constant part `c` typed where a constant takes integer type `want`:
    // a literal or constant expression adopts it, and so does the folded
    // value of a static leaf or a raw-backed case (spec, Flag enums).
    func constant_part(&var self, c: Int, want: Int) {
        let _ = self.expr(c, want)
        let leaf = self.names_constant_static(c) || self.raw_case_named(c) >= 0
        if leaf && want >= 0 && want == self.generic_default {
            self.refuse_generic_default_leaf(c)
            return
        }
        if leaf && self.final_type(c) != want && self.is_integer(want) {
            self.add_adjust(c, TcAdjustKind.Adopt, want)
        }
    }

    // A static or raw case named in a generic default: its value has one
    // type, which only one instantiation of the parameter's could hold.
    func refuse_generic_default_leaf(&var self, c: Int) {
        let t = self.final_type(c)
        var msg = StringBuilder()
        try! msg.append("a default of a type parameter's type is typed at that parameter, so it names only literals; this value's type is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, which only one instantiation could hold; give the parameter that type, or pass the argument")
        self.refuse(c, "type.mismatch", msg.build())
    }

    // The backing integer of the first raw-backed case constant expression
    // `e` holds, which a chain of flags with no integer slot is typed as
    // (spec, Flag enums: "The result is the backing integer, never the
    // enum"); -1 when it holds none.
    func constant_backing(&self, e: Int) -> Int {
        let c = self.raw_case_named(e)
        if c >= 0 {
            let parent = self.res.decls[c].parent
            return self.sigs[parent].result
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let child = self.child(e, k)
            k = k + 1
            if not self.is_leaf(child) {
                let found = self.constant_backing(child)
                if found >= 0 {
                    return found
                }
            }
        }
        return -1
    }

    // Whether funnel position `pos` is an integer slot a lone raw-backed case
    // folds into (spec, Flag enums): a declared type in force, not an
    // operator's peer.
    func adopts_lone_case(&self, pos: TcPosition) -> Bool {
        match pos {
            case Operand -> false,
            case Compound -> false,
            case Coalesce -> false,
            case _ -> true
        }
    }

    // The case name an implicit member, or a call of one, selects; -1 for any
    // other expression.
    func implicit_member_name(&self, e: Int) -> Int {
        if self.has_alt(e, Alt.Expr_ImplicitMember) {
            let leaf = self.res.first_leaf(e)
            let b = self.binding_at(leaf)
            return b.name
        }
        if self.is_call_alt(e) {
            let callee = self.res.first_node_child(e)
            if self.has_alt(callee, Alt.Expr_ImplicitMember) {
                let leaf = self.res.first_leaf(callee)
                let b = self.binding_at(leaf)
                return b.name
            }
        }
        return -1
    }

    // The type a construction `T(...)` builds, when `e` is one; -1 otherwise.
    func constructed_decl(&self, e: Int) -> Int {
        if not self.is_call_alt(e) {
            return -1
        }
        let at = self.res_call_at[e]
        if at < 0 {
            return -1
        }
        let rc = self.res.calls[at]
        if rc.classification != ResCallClass.Init {
            return -1
        }
        let b = rc.binding
        if b.kind == ResBindKind.Decl && self.is_nominal(b.decl) {
            return b.decl
        }
        return -1
    }

    public func is_call_alt(&self, e: Int) -> Bool {
        self.has_alt(e, Alt.Expr_Call_Paren) || self.has_alt(e, Alt.Expr_Call_ParenTrailing) || self.has_alt(e, Alt.Expr_TrailingCall)
    }

    // How a position reads expression `e` by value: a spelled `move`, the
    // hand-off of a temporary, or an implicit copy of a place, which only a
    // Copy type allows silently (design 131).
    public func consume(&var self, e: Int) {
        if e < 0 || self.expr_use[e] != TcUse.Unused {
            return
        }
        let u = self.by_value_use(e)
        self.set_use(e, u)
        if u != TcUse.Copy {
            return
        }
        let t = self.read_type(e)
        if not self.copies_silently(t) {
            self.refuse_implicit_copy(e, t)
        }
    }

    // The use a by-value read of expression `e` records: a `Move`, a `Temp`
    // or a `Copy` of a place.
    func by_value_use(&self, e: Int) -> TcUse {
        if self.has_alt(e, Alt.Expr_Move_Place) || self.has_alt(e, Alt.Expr_MoveDeref_Name) || self.has_alt(e, Alt.Expr_MoveDeref_Self) {
            return TcUse.Move
        }
        if not self.expr_place[e] {
            return TcUse.Temp
        }
        TcUse.Copy
    }

    // The type a copy of place `e` duplicates: its own, read through each
    // leading `deref`. A wrap or an erasure after that builds a new value
    // from the copy.
    func read_type(&self, e: Int) -> Int {
        var t = self.expr_types[e]
        var a = self.adj_head[e]
        while a >= 0 {
            let adj = self.adjusts[a]
            if adj.kind != TcAdjustKind.Deref {
                return t
            }
            t = adj.to
            a = adj.next
        }
        t
    }

    // Whether `t` is the type of a non-escaping function value: a function
    // type that does not say `escaping`, as a parameter declares one.
    func nonescaping_type(&self, t: Int) -> Bool {
        t >= 0 && self.kind_of(t) == TcKind.Func && (self.types.ty(t).a & TC_EFFECT_ESCAPING) == 0
    }

    // Whether expression `e` reads a non-escaping function value: a binding
    // `nonescaping_bindings` marks, read or moved.
    func nonescaping_value(&self, e: Int) -> Bool {
        var at = self.unparen(e)
        if at >= 0 && self.has_alt(at, Alt.Expr_Move_Place) {
            let operand = self.res.first_node_child(at)
            at = self.unparen(operand)
        }
        if at < 0 || not self.has_alt(at, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(at)
        let b = self.binding_at(leaf)
        b.kind == ResBindKind.Local && b.node >= 0 && self.nonescaping_bindings[b.node]
    }

    // A non-escaping function value may be called, passed to a non-escaping
    // parameter, captured by a non-escaping closure or bound to a local; any
    // other position holds it past the call (SL:open-questions D35). `slot`
    // is what position `pos` expects.
    func check_escape(&var self, e: Int, slot: Int, pos: TcPosition) {
        if not self.nonescaping_value(e) {
            return
        }
        // An argument is judged against its declared parameter type
        // (`check_call_argument`), and an assignment against its target
        // (`check_assign`).
        if pos == TcPosition.Argument || pos == TcPosition.Assign {
            return
        }
        if pos == TcPosition.Let && (slot < 0 || self.kind_of(slot) == TcKind.Func) {
            return
        }
        let holder = match pos {
            case Field -> "a field",
            case Payload -> "an enum payload",
            case Element -> "a collection element",
            case Static -> "a static",
            case Return -> "the function's result",
            case Tail -> "the function's result",
            case ClosureTail -> "the closure's result",
            case Let -> "the optional it is wrapped in",
            case Branch -> "the value the branch hands on",
            case _ -> "this position"
        }
        self.refuse_escape(e, holder)
    }

    func refuse_escape(&var self, e: Int, holder: String) {
        let m = self.node_module(e)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, e))
        try! msg.append("` is a non-escaping function value, a parameter whose type does not say `escaping` or a binding of one, and ")
        try! msg.append(holder)
        try! msg.append(" holds it past the call: mark the parameter `escaping`, as `() escaping -> T`, or only call it and pass it to parameters that do not escape")
        self.refuse_in(m, e, "escaping.stored", msg.build())
    }

    public func check_let_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Let, false)
    }

    public func check_static_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Static, false)
    }

    public func check_assigned(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Assign, false)
    }

    public func check_argument(&var self, e: Int, slot: Int) {
        let by_reference = self.has_alt(e, Alt.Borrow_Place_Shared) || self.has_alt(e, Alt.Borrow_Place_Var)
        if by_reference && slot >= 0 && self.kind_of(slot) == TcKind.Ref && not self.is_typed(e) {
            self.borrow_place_argument(e)
        }
        let _ = self.expect(e, slot, TcPosition.Argument, false)
    }

    public func check_field_argument(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Field, false)
    }

    public func check_default_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Default, false)
    }

    public func check_returned(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Return, false)
    }

    public func check_body_tail(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Tail, false)
    }

    public func check_branch(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Branch, false)
    }

    public func check_payload(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Payload, false)
    }

    public func check_compound_value(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Compound, false)
    }

    public func check_element(&var self, e: Int, slot: Int) {
        let _ = self.expect(e, slot, TcPosition.Element, false)
    }

    public func check_closure_tail(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.ClosureTail, false)
    }

    public func check_operand(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Operand, false)
    }

    public func check_coalesce_right(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Coalesce, false)
    }

    func position_text(&self, pos: TcPosition) -> String {
        match pos {
            case Let -> "the annotated binding",
            case Static -> "the static's type",
            case Assign -> "the assignment's target",
            case Argument -> "the parameter",
            case Field -> "the field",
            case Default -> "the parameter this default fills",
            case Return -> "the function's result",
            case Tail -> "the function's result, which the body's last expression is",
            case Branch -> "the value the branches merge into",
            case Payload -> "the payload field",
            case Compound -> "the compound assignment's target",
            case Element -> "the collection's element",
            case ClosureTail -> "the closure's result",
            case Operand -> "the other operand",
            case Coalesce -> "the optional's payload, which `??` falls back to"
        }
    }

    // What position `pos` lets a conversion build: the wrap and erasure
    // matrix of compiler/tests/typecheck/README.md, where each cell's spec
    // line is quoted. A call argument wraps one optional level and never
    // builds the error box; a return target does both freely. Every transfer
    // widens an integer losslessly, and an operator's peers never do. A value
    // branch's arms inherit the position the branch stands in.
    func allowance(&self, pos: TcPosition) -> TcAllowance {
        match pos {
            case Let -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: false, widens: true),
            case Static -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Assign -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: false, widens: true),
            case Argument -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Field -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Default -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Return -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Tail -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Branch -> self.branch_allow,
            case Payload -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case Compound -> TcAllowance(optionals: 1, results: 1, erases: false, widens: false),
            case Element -> TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
            case ClosureTail -> TcAllowance(optionals: TC_ANY_DEPTH, results: 1, erases: true, widens: true),
            case Operand -> TcAllowance(optionals: 1, results: 0, erases: false, widens: false),
            case Coalesce -> TcAllowance(optionals: 1, results: 0, erases: false, widens: true)
        }
    }

    // Why a value that does not fit within `allow` is refused, when it would
    // fit where more is allowed: the wrap depth, the error box or the Result
    // wrap.
    func allowance_reason(&var self, from: Int, slot: Int, allow: TcAllowance) -> String {
        let deeper = TcAllowance(optionals: TC_ANY_DEPTH, results: allow.results, erases: allow.erases,
                                 widens: allow.widens)
        if allow.optionals != TC_ANY_DEPTH && self.fit(from, slot, deeper) > TC_FIT_NONE {
            return "; this position wraps one optional level (`T` to `T?`, never `T??`), so pass a value one level below the slot"
        }
        let boxed = TcAllowance(optionals: allow.optionals, results: allow.results, erases: true,
                                widens: allow.widens)
        if not allow.erases && self.fit(from, slot, boxed) > TC_FIT_NONE {
            return "; only a return builds the `Box<any Error>` a concrete error erases into, so write an explicit `.Err(error: ...)` holding the box"
        }
        if not allow.widens && self.widens_losslessly(from, slot) {
            return "; an operator's operands agree, and only a transfer widens an integer, so convert one with `as`"
        }
        if allow.widens && self.is_integer(from) && self.is_integer(slot) {
            return "; only a lossless widening into or out of `Int` or `UInt` is implicit: write `as` to panic out of range, `.from(...)` for `None`, or `.from(truncating: ...)` for the low bits"
        }
        if allow.results == 0 {
            let wrapped = TcAllowance(optionals: allow.optionals, results: 1, erases: false, widens: allow.widens)
            if self.fit(from, slot, wrapped) > TC_FIT_NONE {
                return "; a Result wraps only where a value lands in a declared Result slot, so write `.Ok(value: ...)` or `.Err(error: ...)`"
            }
        }
        ""
    }
}

// Expressions.
extension TcProgram {
    // Expression `e`'s own type, recorded against it; `want` is what its
    // position expects: a type, TC_WANT_NONE, or TC_WANT_STMT for a
    // statement. The type an adjustment chain ends at is `final_type`.
    public func expr(&var self, e: Int, want: Int) -> Int {
        if e < 0 {
            return self.error_type
        }
        guard let alt = self.node_alt(e) else {
            self.not_in_slice(e, Alt.Expr_OptionalMember)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let t = self.expr_as(e, alt, want)
        if not self.is_typed(e) {
            let _ = self.set_type(e, t, false)
        }
        t
    }

    func expr_as(&var self, e: Int, alt: Alt, want: Int) -> Int {
        match alt {
            case Expr_Int -> self.int_literal(e, want),
            case Expr_Float -> {
                let t = self.float_type()
                self.set_type(e, t, false)
            },
            case Expr_String -> {
                self.string_position(e, TcStringPosition.Literal)
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_Bool_True -> {
                let t = self.bool_type()
                self.set_type(e, t, false)
            },
            case Expr_Bool_False -> {
                let t = self.bool_type()
                self.set_type(e, t, false)
            },
            case Expr_None -> self.none_literal(e, want),
            case Expr_Interpolation -> self.interpolation(e),
            case Expr_SourceLocation_File -> {
                self.string_position(e, TcStringPosition.SourceLocation)
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_SourceLocation_Function -> {
                self.string_position(e, TcStringPosition.SourceLocation)
                let t = self.string_type()
                self.set_type(e, t, false)
            },
            case Expr_SourceLocation_Line -> {
                let t = self.int_type()
                self.set_type(e, t, false)
            },
            case Expr_Name -> self.name_expr(e, want),
            case Expr_NameRef -> self.name_expr(e, want),
            case Expr_Self -> self.self_expr(e),
            case Expr_ImplicitMember -> self.implicit_member(e, want),
            case Expr_Member -> self.member_expr(e, want),
            case Expr_TupleIndex -> self.tuple_index(e),
            case Expr_Call_Paren -> self.call_expr(e, want),
            case Expr_Call_ParenTrailing -> self.call_expr(e, want),
            case Expr_TrailingCall -> self.call_expr(e, want),
            case Expr_Subscript_Single -> self.subscript_expr(e),
            case Expr_Subscript_Multi -> self.subscript_expr(e),
            case Expr_Force -> self.force_expr(e),
            case Expr_Unary_Negate -> self.unary_expr(e, want, 0),
            case Expr_Unary_Not -> self.unary_expr(e, want, 1),
            case Expr_Unary_Complement -> self.unary_expr(e, want, 2),
            case Expr_Additive -> self.arithmetic_expr(e, want),
            case Expr_Multiplicative -> self.arithmetic_expr(e, want),
            case Expr_Shift -> self.arithmetic_expr(e, want),
            case Expr_Bitand -> self.arithmetic_expr(e, want),
            case Expr_Bitor -> self.arithmetic_expr(e, want),
            case Expr_Bitxor -> self.arithmetic_expr(e, want),
            case Expr_And -> self.logic_expr(e),
            case Expr_Or -> self.logic_expr(e),
            case Expr_Compare_Pair -> self.compare_expr(e),
            case Expr_Coalesce -> self.coalesce_expr(e, want),
            case Expr_Range_Closed -> self.range_expr(e),
            case Expr_Cast -> self.cast_expr(e),
            case Expr_Ref_Shared -> self.ref_expr(e, false),
            case Expr_Ref_Exclusive -> self.ref_expr(e, true),
            case Expr_Lends -> self.lends_expr(e),
            case Expr_Move_Place -> self.move_expr(e),
            case Expr_Deref -> self.deref_expr(e),
            case Expr_Try_Propagate -> self.try_expr(e, 0),
            case Expr_Try_Force -> self.try_expr(e, 1),
            case Expr_Try_Optional -> self.try_expr(e, 2),
            case Expr_Try_Catch -> self.try_catch_expr(e, want),
            case Expr_TryBlock -> self.try_block_expr(e, want),
            case Expr_Tuple_Unit -> self.tuple_expr(e, want, false),
            case Expr_Tuple_Positional -> self.tuple_expr(e, want, false),
            case Expr_Tuple_Named -> self.tuple_expr(e, want, true),
            case Expr_Array -> self.array_expr(e, want),
            case Expr_Repeat -> self.repeat_expr(e, want),
            case Expr_Map_Empty -> self.map_expr(e, want),
            case Expr_Map_Entries -> self.map_expr(e, want),
            case Expr_Set -> self.set_expr(e, want),
            case Expr_Closure -> self.closure_expr(e, want),
            case Expr_If -> self.if_expr(e, want),
            case Expr_Match -> self.match_expr(e, want),
            case Expr_While_Conditional -> self.while_expr(e),
            case Expr_While_Infinite -> self.while_expr(e),
            case Expr_WhileLet_Let -> self.while_let_expr(e),
            case Expr_WhileLet_Var -> self.while_let_expr(e),
            case Expr_For_Plain -> self.for_expr(e),
            case Borrow_Block -> self.borrow_block(e, want),
            case Borrow_Place_Shared -> self.borrow_place(e, false),
            case Borrow_Place_Var -> self.borrow_place(e, true),
            case _ -> {
                self.not_in_slice(e, alt)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            }
        }
    }

    // An integer literal: `Int`, or its suffix's type; a bare one adopts an
    // integer type its position expects (design 87). A literal is typed once,
    // so the type it is written at is final here.
    func int_literal(&var self, e: Int, want: Int) -> Int {
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        let suffixed = self.suffix_type(&text)
        if suffixed >= 0 {
            let _ = self.set_type(e, suffixed, false)
            self.settle_literal(e, suffixed, want, true)
            return suffixed
        }
        let t = self.int_type()
        let _ = self.set_type(e, t, false)
        var written = t
        if want != t && self.adopts_integer(want) {
            self.add_adjust(e, TcAdjustKind.Adopt, want)
            written = want
        }
        self.settle_literal(e, written, want, false)
        t
    }

    // THE INTEGER-SLOT FUNNEL: whether a bare integer literal, or a chain of
    // constants, adopts expected type `want`: an integer type, or the type
    // parameter a generic default is typed at, so the default computes at
    // each instantiation's width and signedness. Its value at each call is
    // `fold_default`'s, which `check_used_defaults` range-checks.
    //
    // ENTRY POINTS (adopts_integer):
    //     int_literal
    //     unary_expr
    //     arithmetic_expr
    func adopts_integer(&self, want: Int) -> Bool {
        want >= 0 && (self.is_integer(want) || want == self.generic_default)
    }

    // The literal funnel: integer literal `e`, written at type `t` where
    // its position expects `want`, must fit `t` (spec, Primitive Types: "a
    // compile error *at the literal*"), and with nothing expected `t` is its
    // own `Int`. A negated literal is one literal, so `-9223372036854775808`
    // is `Int.min`. The rule is the fold's (`fold_literal`), and the platform
    // pair's range is `int_width`'s, so a 32-bit target narrows it there. A
    // literal under a poisoned or non-integer slot is that slot's mismatch
    // alone. A generic default's literals adopt its type parameter, which
    // each call instantiates, so they are judged by the per-call route
    // instead: `check_used_defaults` calls
    // `fold_default`, which writes each at the call's type.
    //
    // ENTRY POINTS (settle_literal):
    //     int_literal
    func settle_literal(&var self, e: Int, t: Int, want: Int, suffixed: Bool) {
        if suffixed && self.is_unsigned(t) {
            // The lexer holds an unsigned suffix to its width.
            return
        }
        if not suffixed {
            if self.generic_default >= 0 || (want >= 0 && (self.has_error(want) || not self.is_integer(want))) {
                return
            }
        }
        let negated = self.negated_literal == e
        let v = self.fold_literal(e, t, negated)
        if v.ok || v.fault != TcFault.NotFit {
            return
        }
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let text = self.text(m, if leaf >= 0 { leaf } else { e })
        var msg = StringBuilder()
        try! msg.append("integer literal ")
        if negated && not suffixed {
            try! msg.append("-")
        }
        try! msg.append(text)
        try! msg.append(" does not fit in `")
        try! msg.append(self.type_text(t))
        try! msg.append("` (range ")
        try! msg.append(self.int_range_text(t))
        try! msg.append(")")
        if suffixed {
            try! msg.append(": a signed suffix holds its literal to the signed range, and only a unary minus reaches its minimum")
        } else if want < 0 && not negated {
            try! msg.append(": a literal with no expected type is an `Int`; write `")
            try! msg.append(text)
            try! msg.append("u64` for a `UInt64`")
        }
        let at = if negated && not suffixed && self.negation >= 0 { self.negation } else { e }
        self.refuse(at, "type.mismatch", msg.build())
    }

    // The type a literal's suffix names (`255u8`, `7_i32`), or -1.
    func suffix_type(&var self, text: &String) -> Int {
        let d = self.suffix_decl(&text)
        if d < 0 {
            return -1
        }
        self.prim(d)
    }

    // Whether integer literal `e` is written with a width suffix, which makes
    // it exact-typed rather than adoptable (spec, Integer Width Agreement).
    func is_suffixed_literal(&self, e: Int) -> Bool {
        let m = self.current
        let leaf = self.res.first_leaf(e)
        let at = if leaf >= 0 { leaf } else { e }
        let text = self.text(m, at)
        self.suffix_decl(&text) >= 0
    }

    // The builtin declaration a literal's suffix names, or -1.
    func suffix_decl(&self, text: &String) -> Int {
        // A hex literal's digits include letters, but never `i` or `u`, so
        // the last of those begins the suffix.
        let n = text.len()
        var at = n - 1
        while at > 0 {
            let b = text.byte_at(at) as Int
            if b == 117 || b == 105 {
                break
            }
            at = at - 1
        }
        if at <= 0 {
            return -1
        }
        let suffix = text.substring(at, n)
        var d = -1
        if suffix.equals("u8") {
            d = self.known.uint8
        } else if suffix.equals("u16") {
            d = self.known.uint16
        } else if suffix.equals("u32") {
            d = self.known.uint32
        } else if suffix.equals("u64") {
            d = self.known.uint64
        } else if suffix.equals("i8") {
            d = self.known.int8
        } else if suffix.equals("i16") {
            d = self.known.int16
        } else if suffix.equals("i32") {
            d = self.known.int32
        } else if suffix.equals("i64") {
            d = self.known.int64
        }
        d
    }

    // `None`: the Optional its position expects. With none expected there
    // is nothing to say what it is a `None` of.
    func none_literal(&var self, e: Int, want: Int) -> Int {
        if want >= 0 && self.has_error(want) {
            return self.set_type(e, want, false)
        }
        if want >= 0 && self.is_optional(want) {
            return self.set_type(e, want, false)
        }
        // At a `Result<T?, E>` slot a bare `None` is `Ok(None)` (spec,
        // Auto-Wrap): the Ok payload's `None`, which the funnel wraps.
        if want >= 0 && self.is_result(want) {
            let ok = self.arg_of(want, 0)
            if self.is_optional(ok) {
                return self.set_type(e, ok, false)
            }
        }
        if want >= 0 {
            let t = self.mk_optional(want)
            return self.set_type(e, t, false)
        }
        self.refuse(e, "infer.failed",
                    "`None` has no type here: nothing says what it is a `None` of; annotate the binding, as `let x: Int? = None`")
        let poisoned = self.error_type
        self.set_type(e, poisoned, false)
    }

    func is_none_literal(&self, e: Int) -> Bool {
        self.has_alt(e, Alt.Expr_None)
    }

    // An interpolated string, whose segments are formatted: each is
    // Printable or a primitive, and is borrowed.
    func interpolation(&var self, e: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                let _ = self.expr(c, TC_WANT_NONE)
                self.check_formattable(c)
                self.set_use(c, TcUse.Borrow)
            }
            k = k + 1
        }
        self.string_position(e, TcStringPosition.Interpolation)
        let t = self.string_type()
        self.set_type(e, t, false)
    }

    // A value that is formatted, an interpolation's segment or a format
    // argument, is Printable or a primitive (design 137).
    func check_formattable(&var self, e: Int) {
        var t = self.final_type(e)
        let inner = self.referent(t)
        if inner >= 0 {
            t = inner
        }
        if self.has_error(t) {
            return
        }
        let printable = self.known.printable
        let env = self.current_decl
        let ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        if self.satisfies(t, printable, env, ext, viewer, in_test) {
            return
        }
        // An erased box, `Box<any Error>` above all, renders its payload
        // through the existential's vtable.
        if self.is_box(t) {
            let payload = self.arg_of(t, 0)
            if self.kind_of(payload) == TcKind.Any && self.satisfies(payload, printable, env, ext, viewer, in_test) {
                return
            }
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` is formatted here, and it is neither `Printable` nor a primitive")
        self.refuse(e, "format.argument", msg.build())
    }

    // A name in a value position: a local, a static, a function.
    func name_expr(&var self, e: Int, want: Int) -> Int {
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        match b.kind {
            case Local -> {
                let t = self.local_types[b.node]
                if t < 0 {
                    let poisoned = self.error_type
                    return self.set_type(e, poisoned, true)
                }
                self.set_type(e, t, true)
            },
            case Decl -> {
                let info = self.res.decls[b.decl]
                if info.kind == ResDeclKind.Static {
                    self.build_decl(b.decl)
                    let t = self.sigs[b.decl].result
                    self.poison_if(t)
                    return self.set_type(e, t, true)
                }
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Overload -> self.function_value(e, leaf, b),
            case Overloads -> self.function_value(e, leaf, b),
            case TypeParam -> {
                // A const parameter is a value of its declared type wherever
                // an expression wants one (design 148).
                let owner = self.param_owner(b.node)
                let index = self.param_index(b.node)
                if owner >= 0 && index >= 0 {
                    self.ensure_generics(owner)
                    let s = self.sigs[owner]
                    let g = self.generics[s.generic_first + index]
                    if g.is_const && g.const_type >= 0 {
                        return self.set_type(e, g.const_type, false)
                    }
                }
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Error -> {
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case Unbound -> {
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            },
            case _ -> {
                self.refuse_not_a_value(e, leaf)
                let poisoned = self.error_type
                self.set_type(e, poisoned, false)
            }
        }
    }

    // A function named as a value: the one function of its name, as a
    // function type.
    func function_value(&var self, e: Int, leaf: Int, b: ResBinding) -> Int {
        let cands = self.free_candidates(b)
        if cands.len() != 1 {
            let m = self.current
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.text(m, leaf))
            try! msg.append("` names ")
            try! msg.append(cands.len())
            try! msg.append(" functions; a function value names exactly one")
            self.refuse(e, "call.ambiguous", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = cands[0]
        self.build_decl(d)
        let s = self.sigs[d]
        let info = self.res.decls[d]
        if self.declares_blocking(d) {
            let m = self.current
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.text(m, leaf))
            try! msg.append("` is `blocking`, and a `blocking` function is never a value: a call through a function value has no context to choose a body by, and is made wherever the value goes, a task included. Call it by name")
            self.refuse(e, "effect.blocking-value", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if s.generic_count > 0 || info.kind == ResDeclKind.BuiltinFunc {
            self.not_in_slice(e, Alt.Expr_Name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var params = Vector<Int>()
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            try! params.push(p.ty)
            k = k + 1
        }
        // A named function captures nothing, so its value is `sendable`.
        let t = self.mk_func(&params, s.result, s.effects | TC_EFFECT_SENDABLE)
        let none = Vector<Int>()
        let _ = self.record_call(e, d, TcRole.Value, -1, &none)
        self.set_type(e, t, false)
    }

    // `self`: the receiver, a place of the enclosing type.
    func self_expr(&var self, e: Int) -> Int {
        let b = self.binding_at(e)
        if b.kind != ResBindKind.Local || b.node < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        let t = self.local_types[b.node]
        if t < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        self.set_type(e, t, true)
    }

    // `.Case`: a payload-free case of the enum its position expects.
    func implicit_member(&var self, e: Int, want: Int) -> Int {
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Cases {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if want >= 0 && self.has_error(want) {
            return self.set_type(e, want, false)
        }
        if want < 0 {
            self.refuse_implicit_without_type(e, b.name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.nominal_decl(want)
        let c = self.case_named(d, b.name)
        if c < 0 {
            // No layer of the slot has the case: the funnel's conversion
            // refuses the mismatch, naming the slot.
            self.refuse_no_such_case(e, b.name, want)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.case_has_payload(c) {
            self.refuse_payload_needed(e, c)
        }
        let none = Vector<Int>()
        let args = self.nominal_args(want)
        let _ = self.record_call(e, c, TcRole.Case, want, &args)
        self.set_type(e, want, false)
    }

    // Whether case `c` carries a payload.
    func case_has_payload(&self, c: Int) -> Bool {
        let info = self.res.decls[c]
        info.flag
    }

    // `base.name`: a field of a value, a tuple's labeled element, an enum's
    // case through its type, a module's member, or a builtin integer's
    // `max` and `min`.
    func member_expr(&var self, e: Int, want: Int) -> Int {
        let base = self.res.first_node_child(e)
        let leaf = self.res.first_leaf(e)
        let lb = self.binding_at(leaf)
        if lb.kind == ResBindKind.Case {
            return self.case_value(e, lb.decl, want)
        }
        if lb.kind == ResBindKind.Decl {
            let info = self.res.decls[lb.decl]
            if info.kind == ResDeclKind.Static {
                self.build_decl(lb.decl)
                let t = self.sigs[lb.decl].result
                self.poison_if(t)
                return self.set_type(e, t, true)
            }
            self.refuse_not_a_value(e, leaf)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if lb.kind == ResBindKind.Overload || lb.kind == ResBindKind.Overloads {
            return self.function_value(e, leaf, lb)
        }
        if lb.kind == ResBindKind.Error {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let type_decl = self.type_named_by(base)
        if type_decl >= 0 {
            return self.static_member(e, type_decl, leaf)
        }
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        let place = self.expr_place[base] || self.referent(bt) >= 0
        self.member_place(e, leaf, t, place)
    }

    // Member `leaf` of a value of type `t`, at `e`: a named tuple's element
    // or a field, a place when `place` is. A method named without its call is
    // outside the slice.
    func member_place(&var self, e: Int, leaf: Int, t: Int, place: Bool) -> Int {
        let m = self.current
        let member_text = self.text(m, leaf)
        let name = self.res.intern(member_text)
        let info = self.types.ty(t)
        if info.kind == TcKind.Tuple {
            var k = 0
            while k < info.count {
                if self.types.label(t, k) == name {
                    let et = self.types.arg(t, k)
                    return self.set_type(e, et, place)
                }
                k = k + 1
            }
            self.refuse_unknown_member(leaf, t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let d = self.nominal_decl(t)
        let in_test = self.current_test
        let seen = self.visible_members(d, name, m, in_test)
        var found = Vector<Int>()
        var j = 0
        while j < seen.len() {
            let ext = self.members[seen[j]].ext
            if self.extension_applies(ext, t) {
                try! found.push(seen[j])
            }
            j = j + 1
        }
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            let mi = self.res.decls[member.decl]
            if mi.kind == ResDeclKind.Field {
                self.build_decl(member.decl)
                let written = self.sigs[member.decl].result
                let s = TcSubst(owner: d, args: self.nominal_args(t))
                let ft = self.subst(written, &s)
                self.poison_if(ft)
                return self.set_type(e, ft, place)
            }
            k = k + 1
        }
        if found.len() > 0 {
            self.not_in_slice(e, Alt.Expr_Member)
        } else {
            self.refuse_unknown_member(leaf, t)
        }
        let poisoned = self.error_type
        self.set_type(e, poisoned, place)
    }

    // Expression `base`'s type read through any reference, recording the
    // read as a `Deref` step of its chain.
    func through_refs(&var self, base: Int) -> Int {
        let t = self.final_type(base)
        let inner = self.referent(t)
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
            return inner
        }
        t
    }

    // The nominal declaration expression `base` names as a type, not a
    // value: a type's name, `Self`, or a qualified type; -1 for a value.
    func type_named_by(&var self, base: Int) -> Int {
        if base < 0 {
            return -1
        }
        var leaf = -1
        if self.has_alt(base, Alt.Expr_Name) {
            leaf = self.res.first_leaf(base)
        } else if self.has_alt(base, Alt.Expr_Member) {
            leaf = self.res.first_leaf(base)
        } else {
            return -1
        }
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Decl && b.decl >= 0 {
            let info = self.res.decls[b.decl]
            if self.is_nominal(b.decl) {
                return b.decl
            }
            if info.kind == ResDeclKind.Alias || info.kind == ResDeclKind.TypeAssign {
                let t = self.alias_type(b.decl, -1)
                return self.nominal_decl(t)
            }
        }
        if b.kind == ResBindKind.SelfType && b.decl >= 0 && self.is_nominal(b.decl) {
            return b.decl
        }
        return -1
    }

    // `Type.name` that is no case: a builtin integer's `max` or `min`; a
    // static method named without its call is outside the slice.
    func static_member(&var self, e: Int, d: Int, leaf: Int) -> Int {
        let m = self.current
        let text = self.text(m, leaf)
        let t = self.prim_or_self(d)
        if self.is_integer(t) && (text.equals("max") || text.equals("min")) {
            return self.set_type(e, t, false)
        }
        let name = self.res.intern(text)
        let in_test = self.current_test
        let found = self.visible_members(d, name, m, in_test)
        if found.len() > 0 {
            self.not_in_slice(e, Alt.Expr_Member)
        } else {
            self.refuse_unknown_member(leaf, t)
        }
        let poisoned = self.error_type
        self.set_type(e, poisoned, false)
    }

    // Nominal `d` applied to its own parameters: the type itself for one
    // with none.
    func prim_or_self(&var self, d: Int) -> Int {
        self.self_type_of(d)
    }

    // `E.Case` named as a value: a payload-free case. A generic enum takes
    // its arguments from the expected type.
    func case_value(&var self, e: Int, c: Int, want: Int) -> Int {
        let info = self.res.decls[c]
        let d = info.parent
        if self.case_has_payload(c) {
            self.refuse_payload_needed(e, c)
        }
        var t = self.written_enum_owner(e, d)
        if t < 0 {
            t = self.enum_type_for(e, d, want)
        }
        let args = self.nominal_args(t)
        let _ = self.record_call(e, c, TcRole.Case, t, &args)
        self.set_type(e, t, false)
    }

    // The enum type `E<A>.Case` names when its head writes the arguments:
    // `member` is the `E<A>.Case` node and `d` the enum. -1 when none are
    // written.
    func written_enum_owner(&var self, member: Int, d: Int) -> Int {
        if member < 0 || not self.has_alt(member, Alt.Expr_Member) {
            return -1
        }
        let base = self.res.first_node_child(member)
        let written = self.explicit_type_args(base)
        if written.len() == 0 {
            return -1
        }
        let leaf = self.res.first_leaf(base)
        self.named_owner(d, &written, leaf)
    }

    // Enum `d`'s type where `want` is expected: its own arguments when it
    // takes none, else the expected type's when that is `d`, else refused.
    func enum_type_for(&var self, e: Int, d: Int, want: Int) -> Int {
        self.ensure_generic_list(d)
        let s = self.sigs[d]
        if s.generic_count == 0 {
            return self.self_type_of(d)
        }
        let peeled = self.peel(want, TcClient.Construct, -1, d)
        if peeled >= 0 {
            return peeled
        }
        if want >= 0 && self.has_error(want) {
            return want
        }
        var msg = StringBuilder()
        try! msg.append("the type arguments of `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` cannot be inferred here; write them, or give the position a type")
        self.refuse(e, "infer.failed", msg.build())
        self.error_type
    }

    // `t.0`: a tuple's element.
    func tuple_index(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        let leaf = self.res.last_leaf_of(e)
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let m = self.current
        let text = self.text(m, leaf)
        var index = 0
        var i = 0
        while i < text.len() {
            index = index * 10 + (text.byte_at(i) as Int) - 48
            i = i + 1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Tuple && index < info.count {
            let et = self.types.arg(t, index)
            return self.set_type(e, et, place)
        }
        self.refuse_unknown_member(leaf, t)
        let poisoned = self.error_type
        self.set_type(e, poisoned, place)
    }

    // `o!`: an Optional's payload, a place when the Optional is one
    // (design 131).
    func force_expr(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        let bt = self.expr(base, TC_WANT_NONE)
        self.set_use(base, TcUse.Project)
        let t = self.through_refs(base)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        if self.has_error(t) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        if not self.is_optional(t) {
            self.refuse_operand(e, "`!` unwraps an Optional", t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, place)
        }
        let payload = self.arg_of(t, 0)
        self.set_type(e, payload, place)
    }

    // `-x`, `not b`, `~x`: `which` is 0, 1 or 2.
    func unary_expr(&var self, e: Int, want: Int, which: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let outer = self.negated_literal
        let outer_negation = self.negation
        if which == 0 {
            self.negated_literal = operand
            self.negation = e
        }
        if which != 1 && self.is_constant_expr(e) && self.adopts_integer(want) {
            self.constant_part(operand, want)
        } else {
            // A negated literal is one literal, so it sees its slot even
            // where it adopts none.
            let hint = if which == 0 && self.has_alt(operand, Alt.Expr_Int) { want } else { TC_WANT_NONE }
            let _ = self.expr(operand, hint)
        }
        self.negated_literal = outer
        self.negation = outer_negation
        self.consume(operand)
        let t = self.through_refs(operand)
        if self.has_error(t) {
            return self.set_type(e, t, false)
        }
        if which == 1 {
            if not self.is_bool(t) {
                self.refuse_operand(e, "`not` takes a `Bool`", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "not")
            let b = self.bool_type()
            return self.set_type(e, b, false)
        }
        if which == 0 {
            if not self.is_numeric(t) && not self.adopts_integer(t) {
                self.refuse_operand(e, "`-` negates a number", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "-")
        } else {
            if not self.adopts_integer(t) {
                self.refuse_operand(e, "`~` complements an integer", t)
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "~")
        }
        self.set_type(e, t, false)
    }

    // An arithmetic, shift or bit operator chain. Its operands agree on one
    // type: a constant operand adopts the others' (the funnel's mixed-operand
    // entry), and a chain of constants adopts the expected integer type.
    func arithmetic_expr(&var self, e: Int, want: Int) -> Int {
        let n = self.child_count(e)
        let spelling = self.operators_text(e)
        // A shift's counts are no peers: each is range-checked against the
        // value's width and gives the result nothing (spec, Integer Width
        // Agreement), so only its first operand agrees with anything.
        let shift = self.has_alt(e, Alt.Expr_Shift)
        let constant = self.is_constant_expr(e)
        var cwant = want
        if constant && not self.adopts_integer(want) {
            let backing = self.constant_backing(e)
            if backing >= 0 {
                cwant = backing
            }
        }
        if constant && self.adopts_integer(cwant) {
            var operand = 0
            var k = 0
            while k < n {
                let c = self.child(e, k)
                k = k + 1
                if self.is_leaf(c) {
                    continue
                }
                if shift && operand > 0 {
                    // A wholly constant chain folds where it stands, and the
                    // fold there reports its faults.
                    self.shift_count(c, e, -1)
                } else {
                    self.constant_part(c, cwant)
                    self.consume(c)
                }
                operand = operand + 1
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
            return self.set_type(e, cwant, false)
        }
        var t = -1
        var poisoned = false
        var operand = 0
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            operand = operand + 1
            if (shift && operand > 1) || self.is_constant_expr(c) {
                continue
            }
            let _ = self.expr(c, TC_WANT_NONE)
            self.consume(c)
            let ct = self.through_refs(c)
            let cd = self.nominal_decl(ct)
            if cd >= 0 && (cd == self.known.unsafe_pointer || cd == self.known.unsafe_const_pointer) {
                return self.pointer_offset(e, ct, operand, spelling)
            }
            if self.has_error(ct) {
                poisoned = true
            } else if t < 0 {
                t = ct
            } else if ct != t {
                self.refuse_operands_disagree(c, t, ct)
                poisoned = true
            }
        }
        if t < 0 {
            t = self.int_type()
        }
        operand = 0
        k = 0
        let m = self.current
        var op = ""
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                op = self.text(m, c)
                continue
            }
            operand = operand + 1
            if shift && operand > 1 {
                self.shift_count(c, e, t)
                continue
            }
            if self.is_constant_expr(c) {
                let _ = self.check_operand(c, t)
            }
            if not poisoned && (op.equals("/") || op.equals("%")) {
                self.check_certain_fault(e, c, t, true)
            }
        }
        if poisoned {
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        let kinds = self.operator_kinds(e)
        let integral = (kinds & TC_OPS_INTEGRAL) != 0
        let logical = (kinds & TC_OPS_LOGICAL) != 0
        if integral && not self.is_integer(t) {
            self.refuse_operand(e, "a shift or remainder operator takes integers", t)
        } else if (kinds & TC_OPS_WRAPPING) != 0 && not self.is_integer(t) {
            self.refuse_operand(e, "a wrapping operator takes integers", t)
        } else if logical && not self.is_integer(t) {
            self.refuse_operand(e, "a bit operator takes integers; a `Bool` takes `&&`, `||` and `not`", t)
        } else if (kinds & TC_OPS_ARITHMETIC) != 0 && not self.is_numeric(t) {
            self.refuse_operand(e, "an arithmetic operator takes numbers", t)
        }
        self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
        self.set_type(e, t, false)
    }

    // `p + n` and `p - n` on a raw pointer `p` of type `pt`: the pointer `n`
    // elements on, or back, a stride of the pointee's size, at `p`'s type. `n` is an integer of any width, a constant one an
    // `Int`. Any other chain over a pointer is refused.
    func pointer_offset(&var self, e: Int, pt: Int, operand: Int, spelling: String) -> Int {
        var operands = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let child = self.child(e, k)
            if not self.is_leaf(child) {
                try! operands.push(child)
            }
            k = k + 1
        }
        let offsetting = spelling.equals("+") || spelling.equals("-")
        if not offsetting || operand != 1 || operands.len() != 2 {
            self.refuse_operand(e, "a raw pointer takes only `p + n` and `p - n`, an integer offset after the pointer", pt)
            // Every operand but the pointer is typed still, so none is left
            // without a type.
            var j = 0
            while j < operands.len() {
                let other = operands[j]
                if j + 1 != operand {
                    if self.is_constant_expr(other) {
                        let i = self.int_type()
                        self.constant_part(other, i)
                    } else {
                        let _ = self.expr(other, TC_WANT_NONE)
                    }
                    self.consume(other)
                }
                j = j + 1
            }
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        let count = operands[1]
        if self.is_constant_expr(count) {
            let i = self.int_type()
            self.constant_part(count, i)
            self.consume(count)
        } else {
            let _ = self.expr(count, TC_WANT_NONE)
            self.consume(count)
            let ct = self.through_refs(count)
            if not self.has_error(ct) && not self.is_integer(ct) {
                self.refuse_operand(count, "a pointer's offset is an integer", ct)
                let bad = self.error_type
                return self.set_type(e, bad, false)
            }
        }
        self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
        self.set_type(e, pt, false)
    }

    // A shift's count, binary or compound: an integer of any width, a
    // constant one an `Int`. `e` is the shift, -1 for a compound one, and
    // `shifted` the type the count shifts, or -1 when the whole shift folds
    // at an integer slot, which reports its faults.
    func shift_count(&var self, c: Int, e: Int, shifted: Int) {
        if self.is_constant_part(c) {
            let i = self.int_type()
            self.constant_part(c, i)
            self.consume(c)
        } else {
            let _ = self.expr(c, TC_WANT_NONE)
            self.consume(c)
            let ct = self.through_refs(c)
            if not self.has_error(ct) && not self.is_integer(ct) {
                self.refuse_operand(c, "a shift count is an integer", ct)
                return
            }
        }
        if shifted >= 0 {
            self.check_certain_fault(e, c, shifted, false)
        }
    }

    // The certain-fault funnel (spec, Compile-Time Evaluation, "The faults a
    // run-time operation would panic with"): count or divisor `c` of
    // operation `e` faults wherever it runs once `c` is constant before
    // instantiation, whatever the other operand is, so it is refused: a count
    // outside the width of `shifted` as `constant.shift-range`, a zero divisor
    // as `constant.divide-by-zero`. A constant `e` is refused at the fault its
    // own fold meets, as at a constant position. It serves `<<`, `>>`, `<<=`,
    // `>>=`, `/`, `%`, `/=` and `%=`, and asks nothing of reachability. A
    // fold that waits on a later declaration is judged by `defer_constant`.
    //
    // ENTRY POINTS (check_certain_fault):
    //     shift_count
    //     arithmetic_expr
    //     check_compound
    func check_certain_fault(&var self, e: Int, c: Int, shifted: Int, divides: Bool) {
        if c < 0 || shifted < 0 || not self.is_integer(shifted) || self.refused_within(c) {
            return
        }
        let ct = self.final_type(c)
        if ct < 0 || self.has_error(ct) {
            return
        }
        if e >= 0 {
            let whole = self.fold_before_instantiation(e)
            if whole.ok || whole.fault == TcFault.Cycle {
                return
            }
            if self.awaits_typing(&whole) {
                self.defer_constant(TcPendingConstant.CertainFault(e: e, count: c, shifted: shifted, divides: divides))
                return
            }
            if whole.fault != TcFault.NotConstant {
                if not self.refused_within(e) {
                    self.refuse_fold_fault(&whole, e)
                }
                return
            }
        }
        let v = self.fold_before_instantiation(c)
        if self.awaits_typing(&v) {
            self.defer_constant(TcPendingConstant.CertainFault(e: e, count: c, shifted: shifted, divides: divides))
            return
        }
        if v.fault == TcFault.NotConstant || v.fault == TcFault.Cycle {
            return
        }
        if not v.ok {
            self.refuse_fold_fault(&v, c)
            return
        }
        var msg = StringBuilder()
        if divides {
            if v.bits != 0 {
                return
            }
            try! msg.append("the divisor is the constant 0, so the operation panics wherever it runs")
            self.refuse(c, "constant.divide-by-zero", msg.build())
            return
        }
        let w = self.int_width(shifted)
        if v.bits >= 0 && v.bits < w {
            return
        }
        try! msg.append("the shift count is the constant ")
        try! msg.append(self.fold_text(&v))
        try! msg.append(", outside the width of `")
        try! msg.append(self.type_text(shifted))
        try! msg.append("` (0 to ")
        try! msg.append((w - 1).to_string())
        try! msg.append("), so the shift panics wherever it runs")
        self.refuse(c, "constant.shift-range", msg.build())
    }

    // Fault `v`, which the fold met inside expression `within`, refused where
    // it was met.
    func refuse_fold_fault(&var self, v: &TcFold, within: Int) {
        if v.at < 0 || not self.node_within(v.at, within) {
            return
        }
        let at = v.at
        let target = self.fault_target(at)
        self.refuse_constant_fault(&v, at, target)
    }

    // Operand `c`'s value when it is constant before generic instantiation:
    // it folds by the constant grammar and names no type or const parameter.
    // A value that depends on one is constant only per instantiation, and is
    // reported as no constant (SL:open-questions Q-shiftcount).
    func fold_before_instantiation(&var self, c: Int) -> TcFold {
        if self.mentions_generic_parameter(c) {
            return TcFold(fault: TcFault.NotConstant, ty: -1, at: c)
        }
        self.fold_constant(c)
    }

    // Whether expression `e` names a type or const parameter, or has a part
    // whose type mentions one.
    func mentions_generic_parameter(&self, e: Int) -> Bool {
        if e < 0 {
            return false
        }
        if self.is_leaf(e) {
            let b = self.binding_at(e)
            return b.kind == ResBindKind.TypeParam || b.kind == ResBindKind.Projection
        }
        if e < self.expr_types.len() {
            let t = self.expr_types[e]
            if t >= 0 && self.mentions_param(t) {
                return true
            }
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.mentions_generic_parameter(c) {
                return true
            }
            k = k + 1
        }
        false
    }

    // The operators of a flat chain, in order, separated by spaces.
    func operators_text(&self, e: Int) -> String {
        let m = self.current
        var out = StringBuilder()
        var first = true
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.is_leaf(c) {
                if not first {
                    try! out.append(" ")
                }
                try! out.append(self.text(m, c))
                first = false
            }
            k = k + 1
        }
        out.build()
    }

    // Which kinds of operator a flat chain holds, as TC_OPS_ bits.
    func operator_kinds(&self, e: Int) -> Int {
        let m = self.current
        var kinds = 0
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.is_leaf(c) {
                let op = self.text(m, c)
                if op.equals("<<") || op.equals(">>") || op.equals("%") {
                    kinds = kinds | TC_OPS_INTEGRAL
                } else if op.equals("&") || op.equals("|") || op.equals("^") {
                    kinds = kinds | TC_OPS_LOGICAL
                } else if op.equals("&+") || op.equals("&-") || op.equals("&*") {
                    kinds = kinds | TC_OPS_WRAPPING
                } else {
                    kinds = kinds | TC_OPS_ARITHMETIC
                }
            }
            k = k + 1
        }
        kinds
    }

    // `a && b`, `a || b`: conditions.
    func logic_expr(&var self, e: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                self.check_condition(c)
            }
            k = k + 1
        }
        let spelling = self.operators_text(e)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
        let t = self.bool_type()
        self.set_type(e, t, false)
    }

    // `a == b` and the other comparisons. The operand that types itself
    // goes first, and the other expects its type (the funnel's mixed-operand
    // entry); both are borrowed, since a comparison's operands are references.
    func compare_expr(&var self, e: Int) -> Int {
        let left = self.res.first_node_child(e)
        let right = self.res.last_node_child(e)
        let spelling = self.operators_text(e)
        var t = -1
        let left_peer = self.needs_expectation(left)
        let right_peer = self.needs_expectation(right)
        if left_peer && not right_peer {
            let _ = self.expr(right, TC_WANT_NONE)
            t = self.through_refs(right)
            let _ = self.check_compared(left, t)
        } else {
            let _ = self.expr(left, TC_WANT_NONE)
            t = self.through_refs(left)
            let _ = self.check_compared(right, t)
        }
        self.set_use(left, TcUse.Borrow)
        self.set_use(right, TcUse.Borrow)
        let b = self.bool_type()
        if self.has_error(t) {
            return self.set_type(e, b, false)
        }
        let equality = spelling.equals("==") || spelling.equals("!=")
        self.resolve_comparison(e, t, equality, spelling)
        self.set_type(e, b, false)
    }

    // A comparison's second operand, through the funnel's mixed-operand
    // entry, borrowed rather than consumed.
    func check_compared(&var self, e: Int, slot: Int) -> Int {
        self.expect(e, slot, TcPosition.Operand, true)
    }

    // Whether expression `e` takes its type from its position: a literal,
    // a constant, `None`, an implicit member, a closure, or a collection
    // literal.
    public func needs_expectation(&self, e: Int) -> Bool {
        if self.is_constant_expr(e) || self.implicit_member_name(e) >= 0 {
            return true
        }
        guard let alt = self.node_alt(e) else {
            return false
        }
        alt == Alt.Expr_None || alt == Alt.Expr_Float || alt == Alt.Expr_Closure || alt == Alt.Expr_Array || alt == Alt.Expr_Map_Empty || alt == Alt.Expr_Map_Entries || alt == Alt.Expr_Set || alt == Alt.Expr_Repeat
    }

    // What answers a comparison of two `t`s: a builtin operator for the
    // numbers, `Bool`, `String`, the pointers, a payload-free enum and an
    // Optional of those; else the type's `equals` or `compare`, a bound's
    // requirement for a type parameter, or the structural equality of
    // whatever `satisfies` grants `Equatable` without a member (spec,
    // Equality). Asking the bound's own funnel keeps `==` and a
    // `T: Equatable` bound from disagreeing; a structural `==` the backend
    // cannot do in place (`compares_in_place`) calls `equals`, as the bound does.
    func resolve_comparison(&var self, e: Int, t: Int, equality: Bool, spelling: String) {
        if self.builtin_comparable(t, equality) {
            self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
            if self.is_string(t) {
                let pos = if equality { TcStringPosition.Equality } else { TcStringPosition.Ordering }
                self.string_position(e, pos)
            }
            return
        }
        let wanted = if equality { "equals" } else { "compare" }
        let name = self.res.intern(wanted)
        let m = self.current
        let kind = self.kind_of(t)
        if kind == TcKind.Param || kind == TcKind.SelfType {
            var cands = Vector<TcCand>()
            self.method_candidates(&var cands, t, name, false)
            if cands.len() > 0 {
                let req = cands[0]
                let args = Vector<Int>()
                let at = self.record_call(e, req.decl, TcRole.Operator, t, &args)
                var rc = self.calls[at]
                rc.spelling = self.res.intern(spelling)
                self.calls[at] = rc
                return
            }
        }
        let in_test = self.current_test
        let found = self.members_for(t, name, m, in_test)
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            if self.is_method_member(found[k], false) {
                let args = Vector<Int>()
                let at = self.record_call(e, member.decl, TcRole.Operator, t, &args)
                var c = self.calls[at]
                c.spelling = self.res.intern(spelling)
                self.calls[at] = c
                return
            }
            k = k + 1
        }
        if equality {
            let equatable = self.known.equatable
            let env = self.current_decl
            let ext = self.current_ext
            if self.satisfies(t, equatable, env, ext, m, in_test) {
                if self.compares_in_place(t) {
                    self.record_builtin(e, -1, TcRole.BuiltinOperator, spelling)
                    return
                }
                self.record_structural_equals(e, t, name, spelling)
                return
            }
        }
        if self.refuse_unmet_member(e) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(spelling)
        try! msg.append("` compares two `")
        try! msg.append(self.type_text(t))
        if equality {
            try! msg.append("`, which is not `Equatable`")
        } else {
            try! msg.append("`, which is not `Comparable`")
        }
        self.refuse(e, "operator.undefined", msg.build())
    }

    // A structural `==` or `!=` the backend cannot compare in place, a fixed
    // array's or an aggregate holding a `String`'s: a call to `Equatable`'s
    // `equals` requirement at `t`, which mono's member glue answers exactly
    // as it answers the same call through a `T: Equatable` bound.
    func record_structural_equals(&var self, e: Int, t: Int, name: Int, spelling: String) {
        let equatable = self.known.equatable
        let members = self.members_of(equatable)
        var k = 0
        while k < members.len() {
            let req = members[k]
            k = k + 1
            let ri = self.res.decls[req]
            if ri.kind != ResDeclKind.Requirement || ri.name != name {
                continue
            }
            self.build_decl(req)
            let args = Vector<Int>()
            let at = self.record_call(e, req, TcRole.Operator, t, &args)
            var c = self.calls[at]
            c.spelling = self.res.intern(spelling)
            self.calls[at] = c
            return
        }
        self.refuse(e, "operator.undefined", "the `Equatable` trait declares no `equals` requirement")
    }

    func builtin_comparable(&var self, t: Int, equality: Bool) -> Bool {
        if self.is_numeric(t) || self.is_string(t) {
            return true
        }
        if not equality {
            return false
        }
        if self.is_bool(t) {
            return true
        }
        let d = self.nominal_decl(t)
        if d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer {
            return true
        }
        // An Optional of a `String` is no scalar the backend compares in
        // place, so it takes the structural `equals` instead.
        if self.is_optional(t) {
            let inner = self.arg_of(t, 0)
            return self.builtin_comparable(inner, true) && self.compares_in_place(t)
        }
        if self.is_enum_decl(d) && self.declared_policy(d) < 0 {
            let members = self.members_of(d)
            var k = 0
            while k < members.len() {
                let c = members[k]
                let info = self.res.decls[c]
                if info.kind == ResDeclKind.Case && info.flag {
                    return false
                }
                k = k + 1
            }
            let equatable = self.known.equatable
            return not self.has_conformance(d, equatable)
        }
        false
    }

    // Whether nominal `d` declares a conformance to trait `tr` that the code
    // being checked may use.
    func has_conformance(&self, d: Int, tr: Int) -> Bool {
        let viewer = self.current
        let in_test = self.current_test
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            if c.type_decl == d && c.trait_decl == tr && self.conformance_visible(k, viewer, in_test) {
                return true
            }
            k = k + 1
        }
        false
    }

    // `a ?? b ?? c`: each operand but the last an Optional of one payload
    // type, and the last that payload (the funnel's `??` entry) or an
    // Optional of it, which keeps the result optional.
    func coalesce_expr(&var self, e: Int, want: Int) -> Int {
        var operands = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                try! operands.push(c)
            }
            k = k + 1
        }
        let first = operands[0]
        let _ = self.expr(first, TC_WANT_NONE)
        // Read through a reference before the copy check, which must see the
        // referent's tier, not the reference's.
        let ft = self.read_value(first)
        self.consume(first)
        if self.has_error(ft) || not self.is_optional(ft) {
            if not self.has_error(ft) {
                self.refuse_operand(first, "`??` takes an Optional on its left", ft)
            }
            k = 1
            while k < operands.len() {
                let _ = self.expr(operands[k], TC_WANT_NONE)
                self.consume(operands[k])
                k = k + 1
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let payload = self.arg_of(ft, 0)
        k = 1
        while k + 1 < operands.len() {
            let _ = self.check_coalesce_right(operands[k], ft)
            k = k + 1
        }
        let last = operands[operands.len() - 1]
        if not self.needs_expectation(last) {
            let _ = self.expr(last, TC_WANT_NONE)
            if self.final_type(last) == ft {
                self.consume(last)
                self.record_builtin(e, -1, TcRole.BuiltinOperator, "??")
                return self.set_type(e, ft, false)
            }
            // The merged home would be the fallback's type, and no adjustment
            // widens a payload inside its Optional.
            let fallback = self.final_type(last)
            if self.widens_losslessly(payload, fallback) {
                self.not_yet(e, "a `??` whose fallback is wider than the optional's payload")
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
        }
        let _ = self.check_coalesce_right(last, payload)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, "??")
        self.set_type(e, payload, false)
    }

    // `a..b`, `a..=b`: a `Range` or `RangeInclusive` of `Int`s.
    func range_expr(&var self, e: Int) -> Int {
        let low = self.res.first_node_child(e)
        let high = self.res.last_node_child(e)
        let m = self.current
        let op_leaf = self.res.first_leaf(e)
        let op = self.text(m, op_leaf)
        let i = self.int_type()
        let _ = self.check_operand(low, i)
        let _ = self.check_operand(high, i)
        let d = if op.equals("..=") { self.known.range_inclusive } else { self.known.range }
        let t = self.prim(d)
        self.record_builtin(e, -1, TcRole.BuiltinOperator, op)
        self.set_type(e, t, false)
    }

    // `x as T`: a numeric conversion, a raw-backed enum to its backing, or a
    // pointer's reinterpretation.
    func cast_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let target_node = self.res.last_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        let to = self.build_type(target_node)
        // A reference cast to a raw pointer is the one crossing into the
        // unsafe tier, and takes the reference's address, not its referent.
        let own = self.final_type(operand)
        let to_decl = self.nominal_decl(to)
        let to_pointer = to_decl == self.known.unsafe_pointer || to_decl == self.known.unsafe_const_pointer
        if to_pointer && self.kind_of(own) == TcKind.Ref {
            self.consume(operand)
            return self.set_type(e, to, false)
        }
        // A raw-backed enum is its tag, so its cast borrows a place, read
        // through a reference or not, and copies nothing, whatever the enum's
        // copy policy. An owned value, a temporary or a spelled `move`, is
        // still handed off, and MIR keeps it for its statement to drop. Every
        // other arm reads a trivial value or, at the same type, forwards the
        // operand.
        let referent = self.referent(own)
        let read = if referent >= 0 { referent } else { own }
        let borrowed = referent >= 0 || self.by_value_use(operand) == TcUse.Copy
        if borrowed && self.casts_backing(read, to) {
            self.set_use(operand, TcUse.Borrow)
        } else {
            self.consume(operand)
        }
        let from = self.through_refs(operand)
        if self.has_error(from) || self.has_error(to) {
            return self.set_type(e, to, false)
        }
        if not self.cast_allowed(from, to) {
            var msg = StringBuilder()
            try! msg.append("`as` cannot convert `")
            try! msg.append(self.type_text(from))
            try! msg.append("` to `")
            try! msg.append(self.type_text(to))
            try! msg.append("`: it converts between numbers, from a raw-backed enum, and between pointers")
            self.refuse(e, "type.cast", msg.build())
        }
        if self.is_integer(to) {
            self.defer_constant(TcPendingConstant.Cast(e: e))
        }
        self.set_type(e, to, false)
    }

    // A cast to an integer type, once every body is typed: refused when its
    // own conversion is the fault its fold meets, so its operand is constant
    // before instantiation and its value does not fit the target.
    func check_constant_cast(&var self, e: Int) {
        let to = self.expr_types[e]
        if to < 0 || not self.is_integer(to) || self.refused_within(e) {
            return
        }
        let v = self.fold_before_instantiation(e)
        if v.ok || v.fault != TcFault.NotFit || v.at != e {
            return
        }
        self.refuse_constant_cast(&v, e)
    }

    // The constant-cast funnel (spec, Integer Conversions, "Constants"): cast
    // `e`, whose operand folds to `v` at the operand's type, a value the
    // cast's integer target cannot hold, panics wherever it runs, so it is
    // refused at its `as`, reachable or not, as `constant.cast-range`. The
    // fold reads through const arithmetic, statics and raw-backed cases, not
    // a `let`, and an operand naming a type or const parameter is constant
    // only per instantiation: both keep the run-time check.
    //
    // ENTRY POINTS (refuse_constant_cast):
    //     check_constant_cast
    //     refuse_constant_fault
    func refuse_constant_cast(&var self, v: &TcFold, e: Int) {
        let to = self.expr_types[e]
        let name = self.type_text(to)
        let w = self.int_width(to)
        let signed = not self.is_unsigned(to)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.fold_text(&v))
        try! msg.append("` is not representable as `")
        try! msg.append(name)
        try! msg.append("`, so this cast would always panic; `")
        try! msg.append(name)
        try! msg.append("` holds ")
        try! msg.append(tc_arith_text(tc_arith_min(w, signed), w, signed))
        try! msg.append(" through ")
        try! msg.append(tc_arith_text(tc_arith_max(w, signed), w, signed))
        try! msg.append("; write `")
        try! msg.append(name)
        try! msg.append(".from(truncating: ...)` to keep the low bits, or `")
        try! msg.append(name)
        try! msg.append(".from(...)` to get `None` instead")
        let m = self.node_module(e)
        var at = e
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) && self.text(m, c).equals("as") {
                at = c
            }
        }
        self.refuse_in(m, at, "constant.cast-range", msg.build())
    }

    func cast_allowed(&var self, from: Int, to: Int) -> Bool {
        if from == to {
            return true
        }
        if self.is_numeric(from) && self.is_numeric(to) {
            return true
        }
        if self.casts_backing(from, to) {
            return true
        }
        let fd = self.nominal_decl(from)
        let td = self.nominal_decl(to)
        if self.is_bool(from) && self.is_integer(to) {
            return true
        }
        let from_pointer = fd == self.known.unsafe_pointer || fd == self.known.unsafe_const_pointer
        let to_pointer = td == self.known.unsafe_pointer || td == self.known.unsafe_const_pointer
        if from_pointer && (to_pointer || self.is_integer(to)) {
            return true
        }
        if to_pointer && self.is_integer(from) {
            return true
        }
        false
    }

    // Whether `x as to` converts raw-backed enum type `from` to an integer:
    // the cast reads only the enum's backing (spec, Raw-backed enums).
    public func casts_backing(&self, from: Int, to: Int) -> Bool {
        let fd = self.nominal_decl(from)
        self.is_enum_decl(fd) && self.sigs[fd].result >= 0 && self.is_integer(to)
    }

    // `&x`, `&var x`: a reference to a place, or, shared, to a temporary.
    // A reference binding is reborrowed, not referenced again.
    func ref_expr(&var self, e: Int, exclusive: Bool) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.note_parameter_reference(operand)
        if exclusive {
            self.set_use(operand, TcUse.BorrowVar)
        } else {
            self.set_use(operand, TcUse.Borrow)
        }
        let ot = self.final_type(operand)
        if self.has_error(ot) {
            return self.set_type(e, ot, false)
        }
        if exclusive && not self.expr_place[operand] {
            self.refuse_not_a_place(operand)
        }
        let accessor = self.sigil_accessor(operand)
        if accessor >= 0 {
            self.refuse_sigil_place(e, operand, accessor, exclusive)
        }
        // Whether a `&var` may reborrow it is the writability funnel's
        // (mutability.saw).
        let inner = self.referent(ot)
        if inner >= 0 {
            self.add_adjust(operand, TcAdjustKind.Deref, inner)
            let t = self.mk_ref(exclusive, inner)
            return self.set_type(e, t, false)
        }
        // A slice's elements are no one value to deref to, so its reborrow
        // is the slice itself in the sigil's mode.
        if self.is_reference(ot) {
            let t = self.reborrowed(ot, exclusive)
            return self.set_type(e, t, false)
        }
        let t = self.mk_ref(exclusive, ot)
        self.set_type(e, t, false)
    }

    // `lends self`: the receiver lent, shared, to a reference field of the
    // borrowing struct a `borrows` function constructs, typed as `&self`
    // is. Where it may stand is the origin funnel's (bodychecks.saw); the
    // operand is checked here (spec, Borrowing structs, "The origin is the
    // receiver").
    func lends_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let place = self.unparen(operand)
        if not self.has_alt(place, Alt.Expr_Self) {
            let _ = self.expr(operand, TC_WANT_NONE)
            self.set_use(operand, TcUse.Borrow)
            self.refuse_lends_operand(e, place)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.current_decl
        if d >= 0 && self.sigs[d].receiver == TcReceiver.Exclusive {
            let _ = self.expr(operand, TC_WANT_NONE)
            self.set_use(operand, TcUse.Borrow)
            self.not_yet(e, "`lends self` from a `&var self` receiver")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.ref_expr(e, false)
    }

    // A `lends` whose operand is not `self`, refused by what it names.
    func refuse_lends_operand(&var self, e: Int, place: Int) {
        var what = "an expression"
        if self.rooted_in_self(place) {
            what = "a projection of the receiver"
        } else if self.has_alt(place, Alt.Expr_Name) || self.has_alt(place, Alt.Expr_NameRef) {
            let leaf = self.res.first_leaf(place)
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Local && b.node >= 0 && tc_contains(&self.param_leaves, b.node) {
                what = "a parameter"
            } else if b.kind == ResBindKind.Local {
                what = "a local"
            }
        }
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, e))
        try! msg.append("` lends ")
        try! msg.append(what)
        try! msg.append(", and `lends self` is the only spelling: the window a `borrows` call opens charges its receiver's root, and a projection (`lends self.buffer`), another reference parameter or a local names a root the call site cannot charge; lend the receiver, and read through the reference field on every access")
        self.refuse(e, "lends.origin", msg.build())
    }

    // The `borrows` call place `e` reaches storage through, following its
    // fields, tuple elements, payloads and builtin elements down, or -1: the
    // sigil a call argument writes reaches no accessor (SL:borrowing §9).
    func sigil_accessor(&self, e: Int) -> Int {
        var at = self.unparen(e)
        var steps = 0
        while at >= 0 && steps < 10000 {
            steps = steps + 1
            if self.has_alt(at, Alt.Expr_Member) || self.has_alt(at, Alt.Expr_TupleIndex) || self.has_alt(at, Alt.Expr_Force) || self.has_alt(at, Alt.Expr_Paren) {
                at = self.res.first_node_child(at)
                continue
            }
            let subscript = self.has_alt(at, Alt.Expr_Subscript_Single) || self.has_alt(at, Alt.Expr_Subscript_Multi)
            if not subscript && not self.has_alt(at, Alt.Expr_Call_Paren) {
                return -1
            }
            let c = self.call_at[at]
            let target = if c >= 0 { self.calls[c].target } else { -1 }
            if target >= 0 && (self.sigs[target].effects & TC_EFFECT_BORROWS) != 0 {
                // A borrowing struct is lent by value: `&` of it is a
                // reference to a temporary, which its own rules govern.
                let lent = self.sigs[target].lending
                if lent == TcLend.BorrowingStruct || lent == TcLend.Other {
                    return -1
                }
                return at
            }
            if not subscript {
                return -1
            }
            at = self.res.first_node_child(at)
        }
        return -1
    }

    // `&v[i]` or `&var v[i]`, a sigil on a place an accessor lends, which
    // SL:borrowing §9 retires: the place is passed with `borrow`.
    func refuse_sigil_place(&var self, e: Int, operand: Int, accessor: Int, exclusive: Bool) {
        let m = self.current
        let place = self.text(m, operand)
        let sigil = if exclusive { "&var " } else { "&" }
        let word = if exclusive { "borrow var " } else { "borrow " }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(sigil)
        try! msg.append(place)
        try! msg.append("` reaches a place through the accessor `")
        let c = self.call_at[accessor]
        let target = self.calls[c].target
        let name_id = self.res.decls[target].name
        try! msg.append(self.name_text(name_id))
        try! msg.append("`, and a sigil no longer passes one: write `")
        try! msg.append(word)
        try! msg.append(place)
        try! msg.append("`, which passes the place by reference for the call")
        self.refuse(e, "borrowing.sigil-place", msg.build())
    }

    // `move x`: the place's value, taken; the place is moved from.
    func move_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let t = self.expr(operand, TC_WANT_NONE)
        self.set_use(operand, TcUse.Move)
        if self.rooted_in_self(operand) && not self.in_consuming_body() {
            var msg = StringBuilder()
            try! msg.append("`move` out of `self` is legal only in a `consumes` method, whose receiver ends with the call: declare the method `consumes`, or take the value with `take()` or `swap_out`")
            self.refuse(e, "consumes.move-self", msg.build())
        } else if not self.has_error(t) {
            self.check_whole_move(e, operand)
            self.check_no_move(e, operand)
        }
        if not self.has_error(t) && not self.expr_place[operand] {
            self.refuse_not_a_place(operand)
        }
        let ft = self.final_type(operand)
        // `move o!` moves the payload out of an optional place: the whole
        // place is `o!`, so the value is the payload (design 131).
        let last = self.res.last_leaf_of(e)
        let m = self.current
        let last_text = if last >= 0 { self.text(m, last) } else { "" }
        if last_text.equals("!") && not self.has_error(ft) {
            let ot = self.through_refs(operand)
            if not self.is_optional(ot) {
                self.refuse_operand(e, "`!` unwraps an Optional", ot)
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            let payload = self.arg_of(ot, 0)
            return self.set_type(e, payload, false)
        }
        self.set_type(e, ft, false)
    }

    // Whether place `e` is `self` or a part of it: a field, a tuple element
    // or a payload of `self`.
    func rooted_in_self(&self, e: Int) -> Bool {
        var at = e
        while at >= 0 {
            if self.has_alt(at, Alt.Expr_Self) {
                return true
            }
            let projected = self.has_alt(at, Alt.Expr_Member) || self.has_alt(at, Alt.Expr_TupleIndex) || self.has_alt(at, Alt.Expr_Force)
            if not projected {
                return false
            }
            at = self.res.first_node_child(at)
        }
        false
    }

    // A spelled `move` takes a whole binding, never a part of one (spec,
    // "NO partial moves"): a field, a tuple element, a payload through `!` or
    // an element would leave its owner half-owned. Two places move a part
    // out: `move self.f` in a `consumes` body, whose receiver ends with the
    // call, and an element through a raw pointer, whose occupancy nothing
    // tracks (design 219). `move o!` moves the whole binding `o`.
    func check_whole_move(&var self, e: Int, operand: Int) {
        let place = self.unparen(operand)
        if self.has_alt(place, Alt.Expr_Name) || self.has_alt(place, Alt.Expr_NameRef) {
            self.check_owned_move(e, place)
            return
        }
        if self.has_alt(place, Alt.Expr_Self) || self.has_alt(place, Alt.Expr_Deref) {
            return
        }
        let member = self.has_alt(place, Alt.Expr_Member)
        let element = self.has_alt(place, Alt.Expr_TupleIndex)
        let payload = self.has_alt(place, Alt.Expr_Force)
        let subscript = self.has_alt(place, Alt.Expr_Subscript_Single) || self.has_alt(place, Alt.Expr_Subscript_Multi)
        if not member && not element && not payload && not subscript {
            return
        }
        let base = self.res.first_node_child(place)
        let base_type = self.final_type(base)
        if subscript && self.is_pointer_type(base_type) {
            return
        }
        let owner = self.unparen(base)
        if member && self.has_alt(owner, Alt.Expr_Self) && self.in_consuming_body() {
            return
        }
        let m = self.current
        let part = self.res.last_leaf_of(place)
        var msg = StringBuilder()
        try! msg.append("cannot move out of ")
        if member {
            try! msg.append("field `")
            try! msg.append(self.text(m, part))
            try! msg.append("` of `")
        } else if element {
            try! msg.append("tuple element `")
            try! msg.append(self.text(m, part))
            try! msg.append("` of `")
        } else if payload {
            try! msg.append("the payload of `")
        } else {
            try! msg.append("an element of `")
        }
        try! msg.append(self.text(m, base))
        try! msg.append("`: a `move` takes a whole binding, and taking a part would leave its owner half-owned; ")
        let last = self.res.last_leaf_of(e)
        let unwraps = last >= 0 && self.text(m, last).equals("!")
        let part_type = self.final_type(place)
        if subscript {
            try! msg.append("an indexed place moves out with `swap_out`, which leaves a value behind")
        } else if unwraps || self.is_optional(part_type) {
            try! msg.append("`take()` moves an optional part's payload out and leaves `None` behind")
        } else {
            try! msg.append("move the whole value, or keep the part in a binding of its own")
        }
        self.refuse(e, "transfer.partial-move", msg.build())
    }

    // A spelled `move`, judged by the relocation funnel. The one exception is
    // a by-value parameter placed into fresh storage, `ptr[i] = move param`,
    // before any `&`, `&var` or `borrow` named it: no caller can hand over a
    // bound one, so the parameter is a temporary on its way home (design 188).
    func check_no_move(&var self, e: Int, operand: Int) {
        let t = self.final_type(operand)
        let place = self.unparen(operand)
        if e == self.placement_value && self.is_fresh_parameter(place) {
            return
        }
        let d = self.current_decl
        self.check_relocation(e, place, t, d, TcRelocation.Move)
    }

    // THE RELOCATION FUNNEL: a move, written at `at`, of the value `place`
    // names, of type `t`, in the body of declaration `d`. A `NoMove` value
    // moves once, from its constructor into its home, so a move of one out of
    // a place is refused here; a NoCopy value leaves a place by no other road.
    // A type only an instantiation decides is recorded, and mono refuses it at
    // each instantiation that makes it `NoMove` (SL-662). A consumed match's
    // payload bindings are not entries: the scrutinee's move is the one
    // relocation, and a later move of a binding is a spelled `move`.
    // ENTRY POINTS:
    //     check_no_move
    //     scrutinee_origin
    //     add_capture
    //     check_take
    //     settle_body_paths
    public func check_relocation(&var self, at: Int, place: Int, t: Int, d: Int, how: TcRelocation) {
        if t < 0 || self.has_error(t) {
            return
        }
        if self.is_no_move(t) {
            let m = self.node_module(at)
            let msg = self.relocation_text(m, place, t, how, "")
            self.refuse_in(m, at, "transfer.no-move", msg)
            return
        }
        if d < 0 || (self.types.ty(t).holds & TC_HOLDS_PARAM) == 0 {
            return
        }
        try! self.relocations.push(at)
        try! self.relocation_places.push(place)
        try! self.relocation_types.push(t)
        try! self.relocation_decls.push(d)
        try! self.relocation_hows.push(how)
    }

    // The message a relocation `how` of `place`, at `NoMove` type `t`, is
    // refused with; `instance` names the instantiation that made `t`, or is
    // empty.
    public func relocation_text(&self, m: Int, place: Int, t: Int, how: TcRelocation,
                                instance: String) -> String {
        var verb = "`move`"
        var what = "may not be relocated"
        var hint = "pass `&var` to lend it, or build the value where it has to live"
        match how {
            case Capture -> {
                what = "may not be moved into a closure"
            },
            case Take -> {
                verb = "`take()` the payload of"
                what = "may not be moved out of its optional"
            },
            case Match -> {
                verb = "`match` on"
                what = "a `match` that consumes it would move it into the match's own storage"
                hint = "match it through a `&` or `&var` parameter, which borrows it where it lives"
            },
            case _ -> {}
        }
        var msg = StringBuilder()
        try! msg.append("cannot ")
        try! msg.append(verb)
        try! msg.append(" `")
        try! msg.append(self.text(m, place))
        if instance.len() > 0 {
            try! msg.append("` in the instantiation `")
            try! msg.append(instance)
        }
        try! msg.append("`: `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is `NoMove`, so it lives where its constructor built it and ")
        try! msg.append(what)
        if instance.len() > 0 {
            try! msg.append("; a generic that relocates its values cannot hold one")
        } else {
            try! msg.append("; ")
            try! msg.append(hint)
        }
        msg.build()
    }

    // Whether name `place` is a by-value parameter of the body being checked
    // that no reference has named yet.
    func is_fresh_parameter(&self, place: Int) -> Bool {
        if not self.has_alt(place, Alt.Expr_Name) && not self.has_alt(place, Alt.Expr_NameRef) {
            return false
        }
        let leaf = self.res.first_leaf(place)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Local || b.node < 0 {
            return false
        }
        tc_contains(&self.param_leaves, b.node) && not tc_contains(&self.referenced_params, b.node)
    }

    // Notes a reference to a parameter, which ends its fresh journey.
    func note_parameter_reference(&var self, operand: Int) {
        let place = self.unparen(operand)
        if not self.has_alt(place, Alt.Expr_Name) && not self.has_alt(place, Alt.Expr_NameRef) {
            return
        }
        let leaf = self.res.first_leaf(place)
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Local && b.node >= 0 && not tc_contains(&self.referenced_params, b.node) {
            try! self.referenced_params.push(b.node)
        }
    }

    // `take()` at `e` moves the payload of optional `base`, of type `t`, out.
    func check_take(&var self, e: Int, base: Int, t: Int) {
        let payload = self.arg_of(t, 0)
        let d = self.current_decl
        self.check_relocation(e, base, payload, d, TcRelocation.Take)
    }

    // A `move` of a whole binding takes what the binding owns, never what it
    // borrows (spec, Reference Semantics: "Moving out of references is not
    // allowed"): a reference binding, a closure's reference parameter, and a
    // pattern's binding that aliases a part of a borrowed scrutinee each name
    // storage their owner still ends (DF-288a).
    func check_owned_move(&var self, e: Int, name: Int) {
        let t = self.expr_types[name]
        let leaf = self.res.first_leaf(name)
        let b = self.binding_at(leaf)
        let local = if b.kind == ResBindKind.Local { b.node } else { -1 }
        let borrowed = local >= 0 && tc_contains(&self.borrow_captures, local)
        let reason = self.move_from_borrow_reason(t, local, borrowed)
        if reason.len() > 0 {
            let m = self.current
            let written = self.text(m, name)
            self.refuse_move_from_borrow(e, written, reason)
        }
    }

    // Why a value of type `t` bound at `binding` (-1 for none) may not be
    // moved out, or "" when it may: it is a reference, it aliases a place a
    // `borrow` or a match only borrows, or, `borrowed`, a closure around the
    // move captured it by borrow. One rule for `move x` and a `[move x]`
    // capture (SL-607).
    func move_from_borrow_reason(&self, t: Int, binding: Int, borrowed: Bool) -> String {
        if self.is_reference(t) {
            return "it is a reference, which borrows storage its caller owns and ends"
        }
        if binding >= 0 && self.aliasing_bindings[binding] {
            return "it names a place it only borrows, a `borrow` binding or a part of a scrutinee a match borrows, so the place's owner still ends it"
        }
        if borrowed {
            return "the closure captured it by borrow, so its owner outside the closure still ends it"
        }
        ""
    }

    func refuse_move_from_borrow(&var self, at: Int, name: String, reason: String) {
        var msg = StringBuilder()
        try! msg.append("cannot move out of `")
        try! msg.append(name)
        try! msg.append("`: ")
        try! msg.append(reason)
        try! msg.append("; read or borrow it instead, or give the owner a move-out (`take()` on an optional, `swap_out` on an indexed place)")
        self.refuse(at, "transfer.move-from-borrow", msg.build())
    }

    // Expression `e` with its parentheses taken off.
    public func unparen(&self, e: Int) -> Int {
        var at = e
        while at >= 0 && self.has_alt(at, Alt.Expr_Paren) {
            at = self.res.first_node_child(at)
        }
        at
    }

    // Whether `t`, read through a reference, is a raw pointer.
    func is_pointer_type(&self, t: Int) -> Bool {
        if t < 0 {
            return false
        }
        var inner = t
        let r = self.referent(t)
        if r >= 0 {
            inner = r
        }
        let info = self.types.ty(inner)
        info.kind == TcKind.Nominal && (info.decl == self.known.unsafe_pointer || info.decl == self.known.unsafe_const_pointer)
    }

    // Whether the body being checked is a `consumes` method's (SL-414).
    func in_consuming_body(&self) -> Bool {
        let d = self.current_decl
        d >= 0 && (self.sigs[d].effects & TC_EFFECT_CONSUMES) != 0
    }

    // `*p`: a raw pointer's pointee, a place.
    func deref_expr(&var self, e: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let t = self.final_type(operand)
        if self.has_error(t) {
            return self.set_type(e, t, true)
        }
        let d = self.nominal_decl(t)
        if d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer {
            let pointee = self.arg_of(t, 0)
            return self.set_type(e, pointee, true)
        }
        self.refuse_operand(e, "`*` reads through a raw pointer", t)
        let poisoned = self.error_type
        self.set_type(e, poisoned, true)
    }

    // `try e` (which 0), `try! e` (1), `try? e` (2) over a Result. `try`
    // propagates the error into the innermost `try` block around it, or else
    // into the body's own Result, erasing it into a `Box<any Error>` there
    // when that is the body's error type.
    func try_expr(&var self, e: Int, which: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let t = self.final_type(operand)
        if self.has_error(t) {
            return self.set_type(e, t, false)
        }
        if not self.is_result(t) {
            self.refuse_operand(e, "`try` unwraps a Result", t)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let ok = self.arg_of(t, 0)
        let err = self.arg_of(t, 1)
        if which == 1 {
            return self.set_type(e, ok, false)
        }
        if which == 2 {
            let opt = self.mk_optional(ok)
            return self.set_type(e, opt, false)
        }
        if self.catch_frames.len() > 0 {
            self.note_caught(err)
            return self.set_type(e, ok, false)
        }
        let result = self.body_result
        if result < 0 || self.has_error(result) {
            return self.set_type(e, ok, false)
        }
        if not self.is_result(result) {
            var msg = StringBuilder()
            try! msg.append("`try` propagates an error, and this body returns `")
            try! msg.append(self.type_text(result))
            try! msg.append("`, not a Result; handle the error, or use `try!`")
            self.refuse(e, "type.try", msg.build())
            return self.set_type(e, ok, false)
        }
        let target_err = self.arg_of(result, 1)
        if target_err != err && not self.has_error(target_err) {
            if self.erases_to(err, target_err) {
                let erased = self.mk_result(ok, target_err)
                self.add_adjust(operand, TcAdjustKind.Erase, erased)
            } else {
                var msg = StringBuilder()
                try! msg.append("`try` propagates a `")
                try! msg.append(self.type_text(err))
                try! msg.append("`, and this body's error type is `")
                try! msg.append(self.type_text(target_err))
                try! msg.append("`")
                self.refuse(e, "type.try", msg.build())
            }
        }
        self.set_type(e, ok, false)
    }

    // Error type `err`, which a `try` propagates into the innermost open
    // `try` block, noted once per block (spec, The error union:
    // "Deduplicated").
    func note_caught(&var self, err: Int) {
        let start = self.catch_frames[self.catch_frames.len() - 1]
        var k = start
        while k < self.catch_errors.len() {
            if self.catch_errors[k] == err {
                return
            }
            k = k + 1
        }
        try! self.catch_errors.push(err)
    }

    // Closes the innermost `try` block, whose errors start at `start` in
    // `catch_errors`, and returns them.
    func close_catch_frame(&var self, start: Int) -> Vector<Int> {
        var caught = Vector<Int>()
        var kept = Vector<Int>()
        var k = 0
        while k < self.catch_errors.len() {
            if k < start {
                try! kept.push(self.catch_errors[k])
            } else {
                try! caught.push(self.catch_errors[k])
            }
            k = k + 1
        }
        self.catch_errors = move kept
        var frames = Vector<Int>()
        k = 0
        while k + 1 < self.catch_frames.len() {
            try! frames.push(self.catch_frames[k])
            k = k + 1
        }
        self.catch_frames = move frames
        move caught
    }

    // `try e catch { … }` (spec, Inline Catch): the catch block runs on `e`'s
    // error, bound as `error` of `e`'s error type, and gives the value in the
    // `Ok` payload's place, or leaves, in a statement too ("The catch block
    // either produces the fallback value or diverges").
    func try_catch_expr(&var self, e: Int, want: Int) -> Int {
        let operand = self.res.first_node_child(e)
        let clause = self.res.last_node_child(e)
        let handler = self.res.first_node_child(clause)
        let _ = self.expr(operand, TC_WANT_NONE)
        self.consume(operand)
        let t = self.final_type(operand)
        var ok = self.error_type
        var err = self.error_type
        if not self.has_error(t) {
            if self.is_result(t) {
                ok = self.arg_of(t, 0)
                err = self.arg_of(t, 1)
            } else {
                self.refuse_operand(e, "`try` unwraps a Result", t)
            }
        }
        self.local_types[handler] = err
        if self.has_error(ok) {
            let _ = self.check_block(handler, TC_WANT_NONE, TcTail.Branch)
        } else {
            let ct = self.check_block(handler, ok, TcTail.Branch)
            self.check_branch_value(handler, ct, ok)
        }
        self.set_type(e, ok, false)
    }

    // `try { … } catch { … }` (spec, Block Try-Catch): each `try` in the
    // body that no nested block or closure takes propagates into the catch
    // block, whose `error` holds the error type they propagate, or `Never`
    // when none does and the catch block cannot run. The two blocks give the
    // construct's value and merge as an `if`'s branches do, the body's type
    // the one the catch block meets; a statement discards that value, and its
    // blocks agree on it all the same, as Stage 0 has them. More than one
    // error type forms the error union, which is outside the slice.
    func try_block_expr(&var self, e: Int, want: Int) -> Int {
        let body = self.res.first_node_child(e)
        let handler = self.res.last_node_child(e)
        var slot = -1
        if want >= 0 {
            slot = want
        }
        let start = self.catch_errors.len()
        try! self.catch_frames.push(start)
        let bt = self.try_block_arm(body, slot)
        if slot < 0 && not self.is_never(bt) && not self.has_error(bt) {
            slot = bt
        }
        let caught = self.close_catch_frame(start)
        var et = self.never_type()
        if caught.len() == 1 {
            et = caught[0]
        } else if caught.len() > 1 {
            self.refuse_error_union(e, &caught)
            et = self.error_type
        }
        self.local_types[handler] = et
        let ct = self.try_block_arm(handler, slot)
        if slot < 0 && not self.is_never(ct) && not self.has_error(ct) {
            slot = ct
        }
        if self.is_never(bt) && self.is_never(ct) {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        if slot < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.set_type(e, slot, false)
    }

    // One block of a `try` block, a branch merging into `slot` when there is
    // one.
    func try_block_arm(&var self, block: Int, slot: Int) -> Int {
        if slot >= 0 {
            let t = self.check_block(block, slot, TcTail.Branch)
            self.check_branch_value(block, t, slot)
            return t
        }
        self.check_block(block, TC_WANT_NONE, TcTail.Branch)
    }

    // A `try` block whose `try`s propagate more than one error type, which
    // its `error` would hold as their closed union (spec, The error union).
    func refuse_error_union(&var self, e: Int, caught: &Vector<Int>) {
        var what = StringBuilder()
        try! what.append("a `try` block whose `try`s propagate more than one error type (")
        var k = 0
        while k < caught.len() {
            if k > 0 {
                try! what.append(", ")
            }
            try! what.append("`")
            try! what.append(self.type_text(caught[k]))
            try! what.append("`")
            k = k + 1
        }
        try! what.append("), which its `error` holds as their union,")
        self.not_yet(e, what.build())
    }

    // A tuple: each element, against the expected tuple's element when one
    // of the same shape is expected.
    func tuple_expr(&var self, e: Int, want: Int, named: Bool) -> Int {
        var elements = Vector<Int>()
        var labels = Vector<Int>()
        var values = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                if named && self.has_alt(c, Alt.Expr_TupleField) {
                    let leaf = self.res.first_leaf(c)
                    let label = self.text(m, leaf)
                    try! labels.push(self.res.intern(label))
                    try! values.push(self.res.last_node_child(c))
                } else {
                    try! values.push(c)
                }
            }
            k = k + 1
        }
        var slot = -1
        if want >= 0 {
            let info = self.types.ty(want)
            if info.kind == TcKind.Tuple && info.count == values.len() {
                slot = want
            }
        }
        k = 0
        while k < values.len() {
            let v = values[k]
            if slot >= 0 {
                let et = self.types.arg(slot, k)
                self.check_element(v, et)
            } else {
                let _ = self.expr(v, TC_WANT_NONE)
                let _ = self.read_value(v)
                self.consume(v)
            }
            try! elements.push(self.final_type(v))
            k = k + 1
        }
        if slot >= 0 && not named {
            let info = self.types.ty(slot)
            if info.labeled {
                k = 0
                while k < info.count {
                    try! labels.push(self.types.label(slot, k))
                    k = k + 1
                }
            }
        }
        let t = self.mk_tuple(&elements, &labels)
        self.set_type(e, t, false)
    }

    // The collection type an expected type names, through Optionals: its
    // declaration when it is `d`, else -1.
    func collection_slot(&self, want: Int, d: Int) -> Int {
        var t = want
        while t >= 0 && self.is_optional(t) {
            t = self.arg_of(t, 0)
        }
        if t >= 0 && self.is_nominal_of(t, d) {
            return t
        }
        return -1
    }

    // A bracket literal: a `Vector` only where the position expects one, and
    // otherwise a fixed array `[T; N]` of its first element's type, N its
    // element count (spec, Composite Types).
    func array_expr(&var self, e: Int, want: Int) -> Int {
        var values = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                try! values.push(c)
            }
            k = k + 1
        }
        let vd = self.known.vector
        let vector = self.collection_slot(want, vd)
        var array = -1
        if want >= 0 {
            var w = want
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            let info = self.types.ty(w)
            if info.kind == TcKind.Array {
                array = w
            }
        }
        var element = -1
        var result = -1
        if vector >= 0 {
            element = self.arg_of(vector, 0)
            result = vector
        } else if array >= 0 {
            element = self.types.ty(array).b
            result = array
        }
        k = 0
        while k < values.len() {
            let v = values[k]
            if element >= 0 {
                self.check_element(v, element)
            } else {
                let _ = self.expr(v, TC_WANT_NONE)
                element = self.read_value(v)
                if values.len() > 1 {
                    element = self.peer_slot(v, element, TcPosition.Element)
                }
                self.consume(v)
            }
            k = k + 1
        }
        if result < 0 {
            if element < 0 {
                self.refuse(e, "infer.failed",
                            "an empty array literal has no element type here; give the position a type")
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            let length = self.mk_const(values.len())
            result = self.mk_array(element, length)
        }
        if array >= 0 {
            let length = self.types.arg(array, 0)
            let li = self.types.ty(length)
            if li.kind == TcKind.ConstInt && li.a != values.len() {
                var msg = StringBuilder()
                try! msg.append("this array literal has ")
                try! msg.append(values.len())
                try! msg.append(" elements, and `")
                try! msg.append(self.type_text(array))
                try! msg.append("` holds ")
                try! msg.append(li.a)
                self.refuse(e, "type.mismatch", msg.build())
            }
        }
        self.set_type(e, result, false)
    }

    // `[v; N]`: a fixed array of `N` copies of `v`. The copies are made with
    // nowhere to write a `.copy()`, so the element must copy silently
    // whatever `v` is, a temporary included (spec, Composite Types). Once
    // that is refused, the read of `v` is recorded unchecked, since a place
    // read's own refusal would offer a `move` the repeat still refuses.
    func repeat_expr(&var self, e: Int, want: Int) -> Int {
        let value = self.res.first_node_child(e)
        let count = self.res.last_node_child(e)
        var element = -1
        if want >= 0 {
            let info = self.types.ty(want)
            if info.kind == TcKind.Array {
                element = info.b
            }
        }
        if element >= 0 {
            let refused = self.check_repeat_element(e, value, element)
            let _ = self.expect(value, element, TcPosition.Element, refused)
            if refused {
                let u = self.by_value_use(value)
                self.set_use(value, u)
            }
        } else {
            let _ = self.expr(value, TC_WANT_NONE)
            element = self.read_value(value)
            if self.check_repeat_element(e, value, element) {
                let u = self.by_value_use(value)
                self.set_use(value, u)
            } else {
                self.consume(value)
            }
        }
        // The count is an `Int` expression of the body, and a constant the
        // array's type folds.
        let i = self.int_type()
        let _ = self.expr(count, i)
        self.consume(count)
        let length = self.build_const(count)
        let t = self.mk_array(element, length)
        self.set_type(e, t, false)
    }

    // Whether repeat literal `e`'s element type `t`, read from `value`, is
    // refused: it is unless it copies silently. In a generic body a type
    // parameter's copy is design 219's inferred requirement, an implied copy
    // at the literal, since the value's one read alone would settle as a move.
    func check_repeat_element(&var self, e: Int, value: Int, t: Int) -> Bool {
        if t < 0 || self.has_error(t) {
            return false
        }
        if self.copies_silently(t) {
            if self.mentions_param(t) {
                self.implied_copies[e] = t
            }
            return false
        }
        var msg = StringBuilder()
        try! msg.append("a repeat literal needs a freely copyable element, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is ")
        let tier = self.established_tier(t)
        if tier.len() > 0 {
            try! msg.append(tier)
        } else {
            try! msg.append("made `Copy` by no bound in scope")
        }
        try! msg.append(": write the elements out, or build the array from a Copy value")
        self.refuse(value, "transfer.implicit-copy", msg.build())
        true
    }

    // A map literal, `{k: v}` or `{:}`: a `Map`'s keys and values.
    func map_expr(&var self, e: Int, want: Int) -> Int {
        let md = self.known.map
        let slot = self.collection_slot(want, md)
        var key = -1
        var value = -1
        if slot >= 0 {
            key = self.arg_of(slot, 0)
            value = self.arg_of(slot, 1)
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.has_alt(c, Alt.Expr_MapEntry) {
                continue
            }
            let kn = self.res.first_node_child(c)
            let vn = self.res.last_node_child(c)
            if key >= 0 {
                self.check_element(kn, key)
                self.check_element(vn, value)
            } else {
                let _ = self.expr(kn, TC_WANT_NONE)
                key = self.read_value(kn)
                self.consume(kn)
                let _ = self.expr(vn, TC_WANT_NONE)
                value = self.read_value(vn)
                self.consume(vn)
            }
        }
        if slot >= 0 {
            return self.set_type(e, slot, false)
        }
        if key < 0 {
            self.refuse(e, "infer.failed",
                        "an empty map literal has no key or value type here; give the position a type")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let t = self.defaulted(md, key, value)
        self.set_type(e, t, false)
    }

    // A set literal `{a, b}`: a `Set`'s elements.
    func set_expr(&var self, e: Int, want: Int) -> Int {
        let sd = self.known.set
        let slot = self.collection_slot(want, sd)
        var element = -1
        if slot >= 0 {
            element = self.arg_of(slot, 0)
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            if element >= 0 {
                self.check_element(c, element)
            } else {
                let _ = self.expr(c, TC_WANT_NONE)
                element = self.read_value(c)
                self.consume(c)
            }
        }
        if slot >= 0 {
            return self.set_type(e, slot, false)
        }
        let t = self.defaulted(sd, element, -1)
        self.set_type(e, t, false)
    }

    // Nominal `d` applied to `a`, then `b` when it is not -1, then its
    // remaining parameters' defaults.
    func defaulted(&var self, d: Int, a: Int, b: Int) -> Int {
        self.ensure_generics(d)
        let s = self.sigs[d]
        var args = Vector<Int>()
        try! args.push(a)
        var k = 1
        if b >= 0 {
            try! args.push(b)
            k = 2
        }
        while k < s.generic_count {
            let g = self.generics[s.generic_first + k]
            try! args.push(g.default_type)
            k = k + 1
        }
        self.mk_nominal(d, &args)
    }
}

// Closures and control flow.
extension TcProgram {
    // A closure: its parameters take their written types, or the expected
    // function type's; its body's tail and `return`s take the expected
    // result, or give the result when none is expected.
    func closure_expr(&var self, e: Int, want: Int) -> Int {
        self.closure_typed(e, want, false)
    }

    // A closure against `want`; with `open_result`, `want`'s parameters and
    // effects are known and its result is not, so the tail gives it, as when
    // inference has solved a parameter's function type all but its result.
    func closure_typed(&var self, e: Int, want: Int, open_result: Bool) -> Int {
        let fp = self.known.func_pointer
        if fp >= 0 && want >= 0 && self.is_nominal_of(want, fp) {
            self.not_yet(e, "a closure where a `FuncPointer` is expected")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var fwant = -1
        if want >= 0 {
            var w = want
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func {
                fwant = w
            }
        }
        if self.closure_index.first(e, 0) < 0 {
            let ordinal = self.closures.len()
            let enclosing = self.current_decl
            self.closure_index.add(e, 0, ordinal)
            try! self.closures.push(e)
            try! self.closure_decls.push(enclosing)
        }
        var params = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.is_closure_param(c) {
                continue
            }
            let leaf = self.res.first_leaf(c)
            let annotation = self.res.last_node_child(c)
            var t = self.error_type
            if annotation >= 0 && res_is_type_alt(self.node_alt(annotation)) {
                t = self.build_param_type(annotation)
                if self.has_alt(c, Alt.Expr_ClosureParam_Ref) {
                    t = self.mk_ref(false, t)
                } else if self.has_alt(c, Alt.Expr_ClosureParam_RefExclusive) {
                    t = self.mk_ref(true, t)
                }
            } else if fwant >= 0 && params.len() < self.types.ty(fwant).count {
                t = self.types.arg(fwant, params.len())
            } else {
                self.refuse(c, "infer.failed",
                            "this closure parameter has no type: write one, as `x: Int`, or pass the closure where a function type is expected")
            }
            // The closure's function type keeps the parameter's `escaping`;
            // the binding holds the value in its storage form (D35).
            if self.nonescaping_type(t) {
                self.nonescaping_bindings[leaf] = true
            }
            let held = self.strip_escaping(t)
            self.local_types[leaf] = held
            self.refuse_void_binding(c, leaf, held)
            try! params.push(t)
        }
        var result = -1
        var effects = 0
        if fwant >= 0 {
            let info = self.types.ty(fwant)
            result = if open_result { -1 } else { info.b }
            effects = info.a
        }
        let saved_result = self.body_result
        let saved_open = self.result_open
        let saved_loops = tc_copy_ints(&self.loop_breaks)
        // A `try` in the closure's body propagates out of the closure, never
        // into a `try` block around it.
        let saved_frames = tc_copy_ints(&self.catch_frames)
        let saved_errors = tc_copy_ints(&self.catch_errors)
        let saved_captures = self.borrow_captures.len()
        self.note_borrow_captures(e)
        self.loop_breaks = Vector<Int>()
        self.catch_frames = Vector<Int>()
        self.catch_errors = Vector<Int>()
        self.body_result = result
        self.result_open = result < 0
        var body = self.error_type
        var never = false
        if result >= 0 && self.is_void(result) {
            body = self.check_statements(e, TC_WANT_STMT, TcTail.Closure)
        } else if result >= 0 {
            body = self.check_statements(e, result, TcTail.Closure)
        } else {
            body = self.check_statements(e, TC_WANT_NONE, TcTail.Closure)
            never = self.is_never(body) && self.body_result < 0
            result = body
            if self.is_reference(result) {
                result = self.closure_result_value(e, result)
            }
            result = self.merge_open_result(e, result)
        }
        self.body_result = saved_result
        self.result_open = saved_open
        self.loop_breaks = move saved_loops
        self.catch_frames = move saved_frames
        self.catch_errors = move saved_errors
        if self.borrow_captures.len() > saved_captures {
            var kept = Vector<Int>()
            var j = 0
            while j < saved_captures {
                try! kept.push(self.borrow_captures[j])
                j = j + 1
            }
            self.borrow_captures = move kept
        }
        // With no function type expected, the closure's own type says what
        // its captures prove (spec, Sendable function types).
        if fwant < 0 {
            let enclosing = self.current_decl
            let block = self.closure_blocker(e, enclosing)
            if block.trait_decl < 0 {
                effects = effects | TC_EFFECT_SENDABLE
            }
        }
        let t = self.mk_func(&params, result, effects)
        self.closure_never = never
        self.set_type(e, t, false)
    }

    // An inferred closure result: the tail's type `tail`, against what its
    // `return`s gave (`body_result`). A body whose every path returns ends in
    // `Never` and takes the returns' type; a tail with a value must agree with
    // them; a body with neither is `Void` (design 213).
    func merge_open_result(&var self, e: Int, tail: Int) -> Int {
        let returned = self.body_result
        if returned < 0 {
            if self.is_never(tail) {
                return self.void_type()
            }
            return tail
        }
        if self.is_never(tail) || self.has_error(tail) || tail == returned {
            return returned
        }
        var msg = StringBuilder()
        try! msg.append("this closure's `return` gives `")
        try! msg.append(self.type_text(returned))
        if self.is_void(tail) {
            try! msg.append("`, and its body can end without a value: end it with an expression of that type, or return one")
        } else {
            try! msg.append("`, and its body ends in `")
            try! msg.append(self.type_text(tail))
            try! msg.append("`: a closure's result is one type")
        }
        self.refuse(e, "type.mismatch", msg.build())
        returned
    }

    // Notes the bindings closure `e`'s capture list borrows, `[&x]` and
    // `[&var x]`, for the walk of its body.
    func note_borrow_captures(&var self, e: Int) {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.has_alt(c, Alt.Expr_Capture_Borrow) && not self.has_alt(c, Alt.Expr_Capture_BorrowExclusive) {
                continue
            }
            let leaf = self.res.first_leaf(c)
            let b = self.binding_at(leaf)
            if b.kind == ResBindKind.Local && b.node >= 0 {
                try! self.borrow_captures.push(b.node)
            }
        }
    }

    // A closure whose result is inferred, and whose tail is a reference: a
    // reference binding read there gives its value, as `{ e in e }` over a
    // `&T` returns a `T`; any other reference, a slice binding's included,
    // would leave the call it borrows for, and is refused (`{ &x }` at the
    // `&`).
    func closure_result_value(&var self, e: Int, result: Int) -> Int {
        var tail = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if self.is_statement_child(c) {
                tail = if self.has_alt(c, Alt.Stmt_Expr) { self.res.first_node_child(c) } else { -1 }
            }
            k = k + 1
        }
        if tail >= 0 && self.expr_place[tail] && self.referent(result) >= 0 {
            return self.read_through_reference(tail)
        }
        let bare = tail >= 0 && (self.has_alt(tail, Alt.Expr_Ref_Shared) || self.has_alt(tail, Alt.Expr_Ref_Exclusive))
        if not bare {
            let at = if tail >= 0 { tail } else { e }
            self.refuse_reference_result(at, result)
        }
        result
    }

    func refuse_reference_result(&var self, at: Int, result: Int) {
        var msg = StringBuilder()
        try! msg.append("a closure's result may not be a reference: this body's value is `")
        try! msg.append(self.type_text(result))
        try! msg.append("`, and references are parameters only, so one handed out of the closure would outlive the call it borrows for; yield the value instead")
        self.refuse(at, "type.reference-position", msg.build())
    }

    func is_closure_param(&self, c: Int) -> Bool {
        self.has_alt(c, Alt.Expr_ClosureParam_Value) || self.has_alt(c, Alt.Expr_ClosureParam_Ref) || self.has_alt(c, Alt.Expr_ClosureParam_RefExclusive)
    }

    func is_capture(&self, c: Int) -> Bool {
        self.has_alt(c, Alt.Expr_Capture_Value) || self.has_alt(c, Alt.Expr_Capture_Move) || self.has_alt(c, Alt.Expr_Capture_Copy) || self.has_alt(c, Alt.Expr_Capture_Borrow) || self.has_alt(c, Alt.Expr_Capture_BorrowExclusive) || self.has_alt(c, Alt.Expr_Capture_Self) || self.has_alt(c, Alt.Expr_Capture_SelfExclusive)
    }

    // The statements among node `id`'s children, a block's or a closure's,
    // as `check_block` checks a block's.
    func check_statements(&var self, id: Int, want: Int, tail: TcTail) -> Int {
        let n = self.child_count(id)
        var last = -1
        var k = 0
        while k < n {
            let c = self.child(id, k)
            if self.is_statement_child(c) {
                last = c
            }
            k = k + 1
        }
        var diverges = false
        k = 0
        while k < n {
            let s = self.child(id, k)
            k = k + 1
            if not self.is_statement_child(s) {
                continue
            }
            if s == last && want != TC_WANT_STMT && self.has_alt(s, Alt.Stmt_Expr) {
                let e = self.res.first_node_child(s)
                let t = self.check_tail(e, want, tail)
                if diverges {
                    return self.never_type()
                }
                return t
            }
            if self.check_statement(s) {
                diverges = true
            }
        }
        if diverges {
            return self.never_type()
        }
        self.void_type()
    }

    func is_statement_child(&self, c: Int) -> Bool {
        if self.is_leaf(c) || self.is_closure_param(c) || self.is_capture(c) {
            return false
        }
        true
    }

    // `if`: each arm's head and block, and an `else` block. With a value
    // wanted and an `else`, the branches merge into one type: the expected
    // one, or the arms' merged type, which a bare-literal arm adopts.
    func if_expr(&var self, e: Int, want: Int) -> Int {
        var blocks = Vector<Int>()
        var has_else = false
        var seen_else = false
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                let m = self.current
                let word = self.text(m, c)
                if word.equals("else") {
                    seen_else = true
                }
                continue
            }
            if self.has_alt(c, Alt.Stmt_Block) {
                try! blocks.push(c)
                if seen_else {
                    has_else = true
                }
            } else if self.has_alt(c, Alt.Expr_ElseIf) {
                try! blocks.push(c)
            } else {
                self.check_if_head(c)
            }
        }
        let stmt = want == TC_WANT_STMT || not has_else
        var slot = -1
        if want >= 0 {
            slot = want
        }
        var order = Vector<Int>()
        var deferred = Vector<Int>()
        k = 0
        while k < blocks.len() {
            let b = blocks[k]
            var block = b
            if self.has_alt(b, Alt.Expr_ElseIf) {
                block = self.arm_block(b)
            }
            let tail = self.block_tail(block)
            if not stmt && want < 0 && self.defers_arm(tail) {
                try! deferred.push(b)
            } else {
                try! order.push(b)
            }
            k = k + 1
        }
        self.append_arms(&var order, &deferred)
        var tails = Vector<Int>()
        var all_never = true
        k = 0
        while k < order.len() {
            let b = order[k]
            var block = b
            if self.has_alt(b, Alt.Expr_ElseIf) {
                block = self.check_arm_head(b)
            }
            var bt = self.error_type
            let tail = self.block_tail(block)
            if stmt {
                bt = self.check_block(block, TC_WANT_STMT, TcTail.Branch)
            } else if want < 0 && slot >= 0 && self.arm_merges(tail, slot) {
                bt = self.check_block(block, TC_WANT_NONE, TcTail.Branch)
                slot = self.merge_arm(tail, bt, slot, &var tails)
            } else if slot >= 0 {
                bt = self.check_block(block, slot, TcTail.Branch)
                self.check_branch_value(block, bt, slot)
                self.note_tail(tail, &var tails)
            } else {
                bt = self.check_block(block, TC_WANT_NONE, TcTail.Branch)
                if not self.is_never(bt) && not self.has_error(bt) {
                    slot = if k + 1 < order.len() { self.peer_slot(tail, bt, TcPosition.Branch) } else { bt }
                    self.note_tail(tail, &var tails)
                }
            }
            if not self.is_never(bt) {
                all_never = false
            }
            k = k + 1
        }
        if stmt {
            if has_else && all_never {
                let t = self.never_type()
                return self.set_type(e, t, false)
            }
            let t = self.void_type()
            return self.set_type(e, t, false)
        }
        if all_never {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        if slot < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.set_type(e, slot, false)
    }

    // The expression block `b` ends in, which is its value, or -1.
    public func block_tail(&self, b: Int) -> Int {
        if b < 0 {
            return -1
        }
        if not self.has_alt(b, Alt.Stmt_Block) {
            if res_is_statement_alt(self.node_alt(b)) {
                return -1
            }
            return b
        }
        var last = -1
        let n = self.child_count(b)
        var k = 0
        while k < n {
            let c = self.child(b, k)
            if not self.is_leaf(c) {
                last = c
            }
            k = k + 1
        }
        if last >= 0 && self.has_alt(last, Alt.Stmt_Expr) {
            return self.res.first_node_child(last)
        }
        return -1
    }

    // Whether a value branch's later arm, ending in `tail`, is typed on its
    // own and merged, rather than against the arms before it: the arms so far
    // merged into an integer, and the tail types itself, so it may be the
    // wider arm the others widen into (spec, "Value-branch arms are
    // transfers").
    func arm_merges(&self, tail: Int, merged: Int) -> Bool {
        tail >= 0 && self.is_integer(merged) && not self.needs_expectation(tail)
    }

    // Whether a value branch with no expected type checks the arm ending in
    // `tail` after the others: a bare-literal arm is a peer whose width is
    // undecided, so it adopts the type the other arms merge into, as an
    // operand adopts its peer's (spec, "Value-branch arms are transfers").
    // With every arm a literal, the first is typed on its own, as `Int`.
    func defers_arm(&self, tail: Int) -> Bool {
        tail >= 0 && self.is_constant_expr(tail)
    }

    func append_arms(&self, into: &var Vector<Int>, from: &Vector<Int>) {
        var k = 0
        while k < from.len() {
            try! into.push(from[k])
            k = k + 1
        }
    }

    // An `else if` arm's block, found without checking its head.
    public func arm_block(&self, arm: Int) -> Int {
        let n = self.child_count(arm)
        var k = 0
        while k < n {
            let c = self.child(arm, k)
            if not self.is_leaf(c) && self.has_alt(c, Alt.Stmt_Block) {
                return c
            }
            k = k + 1
        }
        return -1
    }

    func note_tail(&self, tail: Int, tails: &var Vector<Int>) {
        if tail >= 0 {
            try! tails.push(tail)
        }
    }

    // The type a peer's value `t` gives the peers after it, an array
    // literal's later elements or a value branch's later arms: `t` without
    // `sendable`, which their captures were never asked to prove, with the
    // peer's own value, ending at `tail`, converted to it.
    // ENTRY POINTS:
    //     array_expr
    //     if_expr
    //     match_expr
    func peer_slot(&var self, tail: Int, t: Int, pos: TcPosition) -> Int {
        let plain = self.types.unmarked(t)
        if plain != t && tail >= 0 {
            let allow = self.allowance(pos)
            let _ = self.coerce(tail, t, plain, allow)
        }
        plain
    }

    // Merges an arm of type `bt` ending in `tail` into the arms before it,
    // whose tails are `tails` and whose merged type is `merged`: the merged
    // type is the arm type every other widens into losslessly, and each arm
    // records its widening. Returns the merged type.
    func merge_arm(&var self, tail: Int, bt: Int, merged: Int, tails: &var Vector<Int>) -> Int {
        if self.is_never(bt) || self.has_error(bt) || bt == merged {
            self.note_tail(tail, &var tails)
            return merged
        }
        let allow = TcAllowance(optionals: 0, results: 0, erases: false, widens: true)
        if self.widens_losslessly(bt, merged) {
            let _ = self.coerce(tail, bt, merged, allow)
            self.note_tail(tail, &var tails)
            return merged
        }
        if self.widens_losslessly(merged, bt) {
            var k = 0
            while k < tails.len() {
                let earlier = tails[k]
                if self.final_type(earlier) == merged {
                    let _ = self.coerce(earlier, merged, bt, allow)
                }
                k = k + 1
            }
            self.note_tail(tail, &var tails)
            return bt
        }
        var msg = StringBuilder()
        try! msg.append("the branches have no common type: `")
        try! msg.append(self.type_text(merged))
        try! msg.append("` and `")
        try! msg.append(self.type_text(bt))
        try! msg.append("`, and neither widens into the other without losing a value")
        self.refuse(tail, "type.mismatch", msg.build())
        merged
    }

    // An `else if` arm's head; returns its block.
    func check_arm_head(&var self, arm: Int) -> Int {
        var block = -1
        let n = self.child_count(arm)
        var k = 0
        while k < n {
            let c = self.child(arm, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else {
                    self.check_if_head(c)
                }
            }
            k = k + 1
        }
        block
    }

    // A branch that produced no value where one is wanted.
    func check_branch_value(&var self, block: Int, bt: Int, slot: Int) {
        if self.is_void(bt) && not self.is_void(slot) && not self.has_error(slot) {
            var msg = StringBuilder()
            try! msg.append("this branch produces no value, and the branches merge into `")
            try! msg.append(self.type_text(slot))
            try! msg.append("`")
            self.refuse(block, "type.mismatch", msg.build())
        }
    }

    // An `if` arm's head: a condition, `let x = e`, or `borrow let x = e`.
    func check_if_head(&var self, head: Int) {
        if self.has_alt(head, Alt.Expr_OptionalBinding_Let) || self.has_alt(head, Alt.Expr_OptionalBinding_Var) {
            let target = self.res.first_node_child(head)
            let subject = self.res.last_node_child(head)
            self.check_optional_binding(head, target, subject)
            return
        }
        if self.has_alt(head, Alt.Borrow_Unwrap_Let) || self.has_alt(head, Alt.Borrow_Unwrap_Var) {
            self.check_borrow_unwrap(head)
            return
        }
        self.check_condition(head)
    }

    // `let x = e` in an `if`, `while` or `guard` head (`head`, the binding
    // construct): `e` is an Optional, and `x` its payload, copied out of a
    // place (design 131). Out of an optional place an accessor lends, the
    // copy is spelled `let`: a `var` would write the copy and never the
    // place (SL:borrowing §2.4). An optional assignment as the subject,
    // `let _ = a?.b = v`, is tested by its `Void?`, present where it wrote
    // (spec, Optionals, "Chained assignment").
    func check_optional_binding(&var self, head: Int, target: Int, subject: Int) {
        let chain = self.chain_subject(head)
        if chain >= 0 {
            let value = self.node_after(head, chain)
            self.check_chain_write(head, chain, value, false)
            let written = self.void_type()
            self.bind_target(target, written, TcOrigin.Temporary)
            return
        }
        let _ = self.expr(subject, TC_WANT_NONE)
        self.set_use(subject, TcUse.Test)
        let t = self.through_refs(subject)
        if self.has_error(t) {
            let poisoned = self.error_type
            self.bind_target(target, poisoned, TcOrigin.Temporary)
            return
        }
        if not self.is_optional(t) {
            self.refuse_operand(subject, "an optional binding unwraps an Optional", t)
            let poisoned = self.error_type
            self.bind_target(target, poisoned, TcOrigin.Temporary)
            return
        }
        let payload = self.arg_of(t, 0)
        var from = if self.expr_place[subject] { TcOrigin.Place } else { TcOrigin.Temporary }
        if self.lent_place(subject) {
            from = TcOrigin.Lent
            if self.has_alt(head, Alt.Expr_OptionalBinding_Var) || self.has_alt(head, Alt.Stmt_Guard_Var) || self.has_alt(head, Alt.Expr_WhileLet_Var) {
                self.refuse_var_unwrap(head, target, subject)
            }
        }
        self.bind_target(target, payload, from)
    }

    // Whether expression `e` names storage a `borrow` binding reaches: the
    // binding itself, or a field or tuple element of it.
    func lent_place(&self, e: Int) -> Bool {
        var at = self.unparen(e)
        var steps = 0
        while at >= 0 && steps < 10000 {
            steps = steps + 1
            if self.has_alt(at, Alt.Expr_Member) || self.has_alt(at, Alt.Expr_TupleIndex) || self.has_alt(at, Alt.Expr_Paren) {
                at = self.res.first_node_child(at)
                continue
            }
            if not self.has_alt(at, Alt.Expr_Name) {
                return false
            }
            let leaf = self.res.first_leaf(at)
            let b = self.binding_at(leaf)
            return b.kind == ResBindKind.Local && b.node >= 0 && self.lent_bindings[b.node]
        }
        false
    }

    // `if var x = e`, `guard var` or `while var` over an optional place an
    // accessor lends (SL:borrowing §2.4).
    func refuse_var_unwrap(&var self, head: Int, target: Int, subject: Int) {
        let m = self.current
        let name = self.text(m, target)
        let place = self.text(m, subject)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(place)
        try! msg.append("` is a place an accessor lends, and a `var` binding of its payload would write a copy, never the place: write `")
        if self.has_alt(head, Alt.Expr_WhileLet_Var) {
            try! msg.append("while")
        } else {
            try! msg.append("if")
        }
        try! msg.append(" borrow var ")
        try! msg.append(name)
        try! msg.append(" = ")
        try! msg.append(place)
        try! msg.append("` to write the place, or `")
        if self.has_alt(head, Alt.Stmt_Guard_Var) {
            try! msg.append("guard")
        } else if self.has_alt(head, Alt.Expr_WhileLet_Var) {
            try! msg.append("while")
        } else {
            try! msg.append("if")
        }
        try! msg.append(" let ")
        try! msg.append(name)
        try! msg.append(" = ")
        try! msg.append(place)
        try! msg.append("` for a copy")
        self.refuse(head, "borrowing.var-unwrap", msg.build())
    }

    // `if borrow let x = e` and `while borrow var x = e`: `e` is an optional
    // place, and `x` a place of its payload.
    func check_borrow_unwrap(&var self, head: Int) {
        let target = self.res.first_node_child(head)
        let subject = self.res.last_node_child(head)
        let exclusive = self.has_alt(head, Alt.Borrow_Unwrap_Var)
        let _ = self.expr(subject, TC_WANT_NONE)
        if exclusive {
            self.set_use(subject, TcUse.BorrowVar)
        } else {
            self.set_use(subject, TcUse.Borrow)
        }
        let t = self.through_refs(subject)
        var payload = self.error_type
        if not self.has_error(t) {
            if self.is_optional(t) {
                payload = self.arg_of(t, 0)
            } else {
                self.refuse_operand(subject, "`borrow` unwraps an optional place", t)
            }
        }
        self.bind_borrow(target, payload, exclusive)
    }

    // A `borrow let` or `borrow var` binding of a place of type `t`.
    func bind_borrow(&var self, target: Int, t: Int, exclusive: Bool) {
        let leaf = self.res.first_leaf(target)
        if leaf >= 0 {
            self.local_types[leaf] = t
            // The binding names the borrowed place, which its owner ends.
            self.aliasing_bindings[leaf] = true
            self.lent_bindings[leaf] = true
        }
        self.refuse_void_binding(target, leaf, t)
        let _ = self.set_type(target, t, true)
        if exclusive {
            self.set_use(target, TcUse.BorrowVar)
        } else {
            self.set_use(target, TcUse.Borrow)
        }
    }

    // `match`: the scrutinee, then each arm's pattern, guard and body. With
    // a value wanted, the arms merge as `if` branches do, bare-literal arms
    // last.
    func match_expr(&var self, e: Int, want: Int) -> Int {
        let scrutinee = self.res.first_node_child(e)
        let _ = self.expr(scrutinee, TC_WANT_NONE)
        self.set_use(scrutinee, TcUse.Test)
        let t = self.through_refs(scrutinee)
        let from = self.scrutinee_origin(scrutinee, t)
        let stmt = want == TC_WANT_STMT
        var slot = -1
        if want >= 0 {
            slot = want
        }
        var order = Vector<Int>()
        var deferred = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let arm = self.child(e, k)
            k = k + 1
            if not self.has_alt(arm, Alt.Expr_MatchArm) {
                continue
            }
            let arm_body = self.res.last_node_child(arm)
            let arm_tail = self.block_tail(arm_body)
            if not stmt && want < 0 && self.defers_arm(arm_tail) {
                try! deferred.push(arm)
            } else {
                try! order.push(arm)
            }
        }
        self.append_arms(&var order, &deferred)
        var tails = Vector<Int>()
        var all_never = true
        let any_arm = order.len() > 0
        k = 0
        while k < order.len() {
            let arm = order[k]
            k = k + 1
            let pattern = self.res.first_node_child(arm)
            let body = self.res.last_node_child(arm)
            self.check_pattern(pattern, t, from)
            let an = self.child_count(arm)
            var j = 0
            while j < an {
                let c = self.child(arm, j)
                if c != pattern && c != body && not self.is_leaf(c) {
                    self.check_condition(c)
                }
                j = j + 1
            }
            let tail = self.block_tail(body)
            var bt = -1
            if not stmt && want < 0 && slot >= 0 && self.arm_merges(tail, slot) {
                bt = self.arm_body(body, false, -1)
                slot = self.merge_arm(tail, bt, slot, &var tails)
            } else {
                bt = self.arm_body(body, stmt, slot)
                if not stmt && not self.is_never(bt) && not self.has_error(bt) {
                    if slot < 0 {
                        slot = if k < order.len() { self.peer_slot(tail, bt, TcPosition.Branch) } else { bt }
                    }
                    self.note_tail(tail, &var tails)
                }
            }
            if not self.is_never(bt) {
                all_never = false
            }
        }
        if all_never && any_arm {
            let t2 = self.never_type()
            return self.set_type(e, t2, false)
        }
        if stmt {
            let v = self.void_type()
            return self.set_type(e, v, false)
        }
        if slot < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.set_type(e, slot, false)
    }

    // A match arm's body: a block, a statement, or an expression.
    func arm_body(&var self, body: Int, stmt: Bool, slot: Int) -> Int {
        if self.has_alt(body, Alt.Stmt_Block) {
            if stmt {
                return self.check_block(body, TC_WANT_STMT, TcTail.Branch)
            }
            if slot >= 0 {
                let bt = self.check_block(body, slot, TcTail.Branch)
                self.check_branch_value(body, bt, slot)
                return bt
            }
            return self.check_block(body, TC_WANT_NONE, TcTail.Branch)
        }
        if res_is_statement_alt(self.node_alt(body)) {
            if self.check_statement(body) {
                return self.never_type()
            }
            return self.void_type()
        }
        if stmt {
            let t = self.expr(body, TC_WANT_STMT)
            self.consume(body)
            self.check_discarded(body)
            return t
        }
        if slot >= 0 {
            return self.check_branch(body, slot)
        }
        let _ = self.expr(body, TC_WANT_NONE)
        let t = self.read_value(body)
        self.consume(body)
        t
    }

    // `while cond { }` and `while { }`, which diverges when nothing breaks it.
    func while_expr(&var self, e: Int) -> Int {
        let infinite = self.has_alt(e, Alt.Expr_While_Infinite)
        try! self.loop_breaks.push(0)
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    let _ = self.check_block(c, TC_WANT_STMT, TcTail.Plain)
                } else {
                    self.check_condition(c)
                }
            }
            k = k + 1
        }
        let breaks = self.pop_loop()
        if infinite && breaks == 0 {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // The innermost loop's count of `break`s, as it closes.
    func pop_loop(&var self) -> Int {
        let depth = self.loop_breaks.len()
        if depth == 0 {
            return 0
        }
        let breaks = self.loop_breaks[depth - 1]
        var kept = Vector<Int>()
        var k = 0
        while k + 1 < depth {
            try! kept.push(self.loop_breaks[k])
            k = k + 1
        }
        self.loop_breaks = move kept
        breaks
    }

    // `while let x = e { }`.
    func while_let_expr(&var self, e: Int) -> Int {
        let target = self.res.first_node_child(e)
        try! self.loop_breaks.push(0)
        var subject = -1
        var block = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if c != target && not self.is_leaf(c) {
                if self.has_alt(c, Alt.Stmt_Block) {
                    block = c
                } else if subject < 0 {
                    subject = c
                }
            }
            k = k + 1
        }
        self.check_optional_binding(e, target, subject)
        let _ = self.check_block(block, TC_WANT_STMT, TcTail.Plain)
        let _ = self.pop_loop()
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // `for x in seq { }`: the head is borrowed for the whole loop, and each
    // item is what its iterator's `next` hands out (SL:borrowing §2.6).
    func for_expr(&var self, e: Int) -> Int {
        let target = self.res.first_node_child(e)
        let body = self.res.last_node_child(e)
        var seq = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            if c != target && c != body && not self.is_leaf(c) {
                seq = c
            }
            k = k + 1
        }
        let _ = self.expr(seq, TC_WANT_NONE)
        self.set_use(seq, TcUse.Borrow)
        let t = self.through_refs(seq)
        let item = self.iterator_item(e, seq, t)
        self.bind_target(target, item, TcOrigin.Temporary)
        try! self.loop_breaks.push(0)
        let _ = self.check_block(body, TC_WANT_STMT, TcTail.Plain)
        let _ = self.pop_loop()
        let v = self.void_type()
        self.set_type(e, v, false)
    }

    // What a `for` over a `t` hands out: the payload of its `next`'s
    // Optional, recorded as the loop's target.
    func iterator_item(&var self, e: Int, seq: Int, t: Int) -> Int {
        if self.has_error(t) {
            return self.error_type
        }
        let next_name = self.res.intern("next")
        let m = self.current
        let in_test = self.current_test
        let found = self.members_for(t, next_name, m, in_test)
        var k = 0
        while k < found.len() {
            let at = found[k]
            if self.is_method_member(at, false) {
                let member = self.members[at]
                self.build_decl(member.decl)
                let s = self.sigs[member.decl]
                let sub = self.member_subst(at, t)
                let result = self.subst(s.result, &sub)
                if self.is_optional(result) {
                    let none = Vector<Int>()
                    let _ = self.record_call(e, member.decl, TcRole.Iterator, t, &none)
                    return self.arg_of(result, 0)
                }
            }
            k = k + 1
        }
        if self.refuse_unmet_member(seq) {
            return self.error_type
        }
        var msg = StringBuilder()
        try! msg.append("`for` walks an iterator, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no `next` that hands out an Optional")
        self.refuse(seq, "type.mismatch", msg.build())
        self.error_type
    }

    // `borrow let x = place, var y = place { }`: each binding a place, then
    // the block, whose tail is the construct's value.
    func borrow_block(&var self, e: Int, want: Int) -> Int {
        var block = -1
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.has_alt(c, Alt.Borrow_Binding_Let) || self.has_alt(c, Alt.Borrow_Binding_Var) {
                let target = self.res.first_node_child(c)
                let place = self.res.last_node_child(c)
                let exclusive = self.has_alt(c, Alt.Borrow_Binding_Var)
                let outer = self.borrow_head
                self.borrow_head = place
                let _ = self.expr(place, TC_WANT_NONE)
                self.borrow_head = outer
                if tc_contains(&self.skipped, place) {
                    // The head is outside the slice, so the block that
                    // borrows through it is too.
                    try! self.skipped.push(e)
                    let poisoned = self.error_type
                    return self.set_type(e, poisoned, false)
                }
                if exclusive {
                    self.set_use(place, TcUse.BorrowVar)
                } else {
                    self.set_use(place, TcUse.Borrow)
                }
                let pt = self.through_refs(place)
                if not self.has_error(pt) && not self.expr_place[place] {
                    self.refuse_not_a_place(place)
                }
                self.bind_borrow(target, pt, exclusive)
            } else if self.has_alt(c, Alt.Stmt_Block) {
                block = c
            }
        }
        var bw = TC_WANT_NONE
        if want == TC_WANT_STMT {
            bw = TC_WANT_STMT
        }
        let t = self.check_block(block, bw, TcTail.Plain)
        self.set_type(e, t, false)
    }

    // `borrow place` and `borrow var place` in a statement: the place,
    // borrowed for the statement.
    func borrow_place(&var self, e: Int, exclusive: Bool) -> Int {
        let inner = self.res.first_node_child(e)
        let t = self.expr(inner, TC_WANT_NONE)
        self.set_use(inner, TcUse.Project)
        let place = self.expr_place[inner]
        let ft = self.final_type(inner)
        self.set_type(e, ft, place)
    }

    // `borrow PLACE` or `borrow var PLACE` where a reference parameter
    // expects it: the place is passed by reference, `&` or `&var`, for the
    // call (SL:borrowing §2.2).
    func borrow_place_argument(&var self, e: Int) {
        let exclusive = self.has_alt(e, Alt.Borrow_Place_Var)
        let inner = self.res.first_node_child(e)
        let _ = self.expr(inner, TC_WANT_NONE)
        self.note_parameter_reference(inner)
        if exclusive {
            self.set_use(inner, TcUse.BorrowVar)
        } else {
            self.set_use(inner, TcUse.Borrow)
        }
        let ft = self.through_refs(inner)
        if self.has_error(ft) {
            let _ = self.set_type(e, ft, false)
            return
        }
        if exclusive && not self.expr_place[inner] {
            self.refuse_not_a_place(inner)
        }
        let r = self.mk_ref(exclusive, ft)
        let _ = self.set_type(e, r, false)
    }
}

// What a candidate of a call is.
public enum TcCandKind {
    // A function, method, requirement or init, with its own signature.
    case Function,
    // A struct's memberwise construction: its fields are the parameters.
    case Memberwise,
    // An enum case's construction: its payload fields are the parameters.
    case Case
}

// One candidate a call may mean: the declaration, the member-table entry it
// came from (-1 for none), and the type a member is instantiated at (-1 when
// that is what inference solves, or for a free function).
public struct TcCand {
    decl: Int
    kind: TcCandKind
    member: Int
    owner: Int
}

// How the body being checked may construct a struct (`construction_route`):
// the `init` that overrides its memberwise construction, or -1; whether the
// body is that `init`'s own block; and the first field it does not see, or -1.
public struct TcRoute {
    override_init: Int
    raw: Bool
    hidden: Int
}

// What refuses an all-zero value (`zero_fault`): nothing, an override the
// zero would skip, a field the code cannot see, or a part with no valid zero.
public enum TcZeroFault {
    case Valid,
    case Override,
    case Hidden,
    case Invalid
}

// One verdict of the zero-init walk: its fault, the type at fault, and the
// override or the hidden field it names, else -1.
public struct TcZero {
    fault: TcZeroFault
    ty: Int
    decl: Int
}

// The root a hint's proposed write would land in: its node, or -1, whether a
// write through the place lands, and what declared a root binding.
struct TcHintRoot {
    node: Int
    writable: Bool
    binder: TcBinder
}

// A call's arguments: each value expression, and its label's name, or -1.
public struct TcArgs {
    values: Vector<Int>
    labels: Vector<Int>
}

extension TcArgs: NoCopy {}

// How a call's arguments bind to one candidate's parameters: the parameter
// each argument binds, and why binding failed.
public struct TcBind {
    arg_param: Vector<Int>
    status: Int
    detail: Int
}

extension TcBind: NoCopy {}

static TC_BIND_OK: Int = 0
static TC_BIND_TOO_MANY: Int = 1
static TC_BIND_MISSING: Int = 2
static TC_BIND_UNKNOWN_LABEL: Int = 3
static TC_BIND_BACKWARD: Int = 4
static TC_BIND_REPEATED: Int = 5

// Calls.
extension TcProgram {
    // A call. Resolve classified its head once; the class decides where the
    // candidates come from, the overload filter picks one, and inference
    // instantiates it.
    func call_expr(&var self, e: Int, want: Int) -> Int {
        let callee = self.res.first_node_child(e)
        // The types its head writes are the body's whichever way the call is
        // resolved or refused, so every one is built here, once.
        let _ = self.explicit_type_args(callee)
        if self.has_alt(callee, Alt.Expr_Member) {
            let head_base = self.res.first_node_child(callee)
            let _ = self.explicit_type_args(head_base)
        }
        let at = self.res_call_at[e]
        if at < 0 {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let rc = self.res.calls[at]
        let args = self.call_args(e, callee)
        if self.is_thread_spawn_head(callee) {
            return self.thread_spawn(e, &args)
        }
        match rc.classification {
            case Overload -> self.free_call(e, callee, rc.binding, &args),
            case Init -> self.init_call(e, callee, rc.binding, &args, want),
            case Method -> self.method_call(e, callee, &args),
            case StaticMethod -> self.static_call(e, callee, rc.binding, &args, want),
            case Case -> self.case_call(e, callee, rc.binding.decl, &args, want),
            case ImplicitCase -> self.implicit_case_call(e, callee, rc.binding.name, &args, want),
            case Local -> self.value_call(e, callee, &args),
            case Value -> self.value_call(e, callee, &args),
            case TypeParam -> self.type_param_call(e, rc.binding, &args)
        }
    }

    // `A()` for a type parameter: a value of whatever type instantiates it,
    // the zero-sized allocator a std body builds (a construction that takes
    // arguments is outside the slice).
    func type_param_call(&var self, e: Int, b: ResBinding, args: &TcArgs) -> Int {
        let t = self.param_type(b.node)
        if t >= 0 && self.kind_of(t) != TcKind.Param {
            // A specialized extension's head names the type, which its own
            // name constructs, through its `init`s.
            let d = self.nominal_decl(t)
            let named = ResBinding(kind: ResBindKind.Decl, module: b.module, decl: d, name: b.name, node: -1)
            let callee = self.res.first_node_child(e)
            return self.init_call(e, callee, named, &args, TC_WANT_NONE)
        }
        if t < 0 || args.values.len() > 0 {
            if t >= 0 {
                self.not_in_slice(e, Alt.Expr_Call_Paren)
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.record_builtin(e, -1, TcRole.Builtin, "init")
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // A call's arguments, positional, labeled and trailing.
    func call_args(&var self, e: Int, callee: Int) -> TcArgs {
        var values = Vector<Int>()
        var labels = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == callee || self.is_leaf(c) {
                continue
            }
            if self.has_alt(c, Alt.Expr_Argument_Positional) {
                try! values.push(self.res.first_node_child(c))
                try! labels.push(-1)
            } else if self.has_alt(c, Alt.Expr_Argument_Labelled) {
                let leaf = self.res.first_leaf(c)
                let label = self.text(m, leaf)
                try! values.push(self.res.last_node_child(c))
                try! labels.push(self.res.intern(label))
            } else {
                try! values.push(c)
                try! labels.push(-1)
            }
        }
        TcArgs(values: move values, labels: move labels)
    }

    // The type arguments written on a call's head: `f<Int>(...)`,
    // `Vector<Int>()`, `x.f<T>(...)`.
    func explicit_type_args(&var self, callee: Int) -> Vector<Int> {
        var out = Vector<Int>()
        if callee < 0 {
            return move out
        }
        if not self.has_alt(callee, Alt.Expr_Name) && not self.has_alt(callee, Alt.Expr_Member) {
            return move out
        }
        let base = if self.has_alt(callee, Alt.Expr_Member) { self.res.first_node_child(callee) } else { -1 }
        let n = self.child_count(callee)
        var k = 0
        while k < n {
            let c = self.child(callee, k)
            k = k + 1
            if c == base || self.is_leaf(c) {
                continue
            }
            // A head's arguments are built once, when `call_expr` meets the
            // call, and read back here (the body verifier holds each to one
            // build).
            if self.type_builds[c] > 0 {
                try! out.push(self.node_types[c])
            } else if res_is_type_alt(self.node_alt(c)) {
                try! out.push(self.build_type(c))
            } else {
                let v = self.build_const(c)
                self.node_types[c] = v
                self.type_builds[c] += 1
                try! out.push(v)
            }
        }
        move out
    }

    // A free function call: an overload set, or a builtin function.
    func free_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs) -> Int {
        let decls = self.free_candidates(b)
        if decls.len() == 1 {
            let only = self.res.decls[decls[0]]
            if only.kind == ResDeclKind.BuiltinFunc {
                return self.builtin_call(e, callee, decls[0], &args)
            }
        }
        var cands = Vector<TcCand>()
        var k = 0
        while k < decls.len() {
            let d = decls[k]
            let info = self.res.decls[d]
            if info.kind != ResDeclKind.BuiltinFunc {
                self.build_decl(d)
                try! cands.push(TcCand(decl: d, kind: TcCandKind.Function, member: -1, owner: -1))
            }
            k = k + 1
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, -1, TC_WANT_NONE)
    }

    // `x.f(...)`: a method of the receiver's type, or of a type parameter's
    // bounds. The receiver is borrowed as the method's receiver declares; a
    // `borrows` accessor's use site decides (`settle_places`).
    func method_call(&var self, e: Int, callee: Int, args: &TcArgs) -> Int {
        let base = self.res.first_node_child(callee)
        let leaf = self.res.first_leaf(callee)
        let m = self.current
        let text = self.text(m, leaf)
        let name = self.res.intern(text)
        let bt = self.expr(base, TC_WANT_NONE)
        let rt = self.final_type(base)
        let inner = self.referent(rt)
        let t = if inner >= 0 { inner } else { rt }
        if self.has_error(t) {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let erased = self.dispatched_existential(t)
        if erased >= 0 {
            return self.dispatch_call(e, callee, base, inner, t, erased, name, &text, &args)
        }
        let tk = self.kind_of(t)
        if (tk == TcKind.Array || tk == TcKind.Slice) && (text.equals("len") || text.equals("swap")) {
            return self.sequence_method(e, base, inner, t, &text, &args)
        }
        var cands = Vector<TcCand>()
        self.method_candidates(&var cands, t, name, false)
        let field = self.function_field(t, name)
        if field >= 0 {
            if cands.len() > 0 {
                self.refuse_field_method(e, base, field, &cands, &text)
                self.set_use(base, TcUse.Borrow)
                self.type_args_alone(&args)
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            return self.field_call(e, callee, base, bt, inner, field, t, &args)
        }
        // A member its extension's bound withholds is refused as such, not
        // answered by a builtin of its name (`copy`).
        if cands.len() == 0 && self.refuse_unmet_member(leaf) {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if cands.len() == 0 && self.is_builtin_method(t, &text) {
            return self.builtin_method(e, base, inner, t, &text, &args)
        }
        let d = self.nominal_decl(t)
        if cands.len() == 0 && d >= 0 && d == self.known.task_group && text.equals("spawn") {
            return self.group_spawn(e, base, inner, t, &args)
        }
        let outside = self.method_outside_slice(e, t, name, &text, &cands, &args)
        if outside.len() > 0 {
            self.set_use(base, TcUse.Borrow)
            self.not_yet(e, outside)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if cands.len() == 0 {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            if self.refuse_through_pointer(leaf, base, t, name) {
                let poisoned = self.error_type
                return self.set_type(e, poisoned, false)
            }
            self.refuse_no_method(leaf, t, name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        // An Optional the new std declares writes its own `take`, which
        // moves the payload out as the builtin one does.
        if text.equals("take") && self.is_optional(t) {
            self.check_take(e, base, t)
        }
        if text.equals("deinit") {
            self.refuse_manual_deinit(leaf)
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let explicit = self.explicit_type_args(callee)
        let result = self.resolve_call(e, &cands, &args, &explicit, base, TC_WANT_NONE)
        result
    }

    // The existential a method call on receiver type `t` dispatches
    // through: `t` itself for an `any Trait`, the payload of an erased
    // `Box<any Trait>`; -1 for any other type.
    public func dispatched_existential(&self, t: Int) -> Int {
        if self.kind_of(t) == TcKind.Any {
            return t
        }
        if not self.is_box(t) {
            return -1
        }
        let payload = self.arg_of(t, 0)
        if self.kind_of(payload) == TcKind.Any { payload } else { -1 }
    }

    // THE DISPATCH FUNNEL: method call `e`, of `name` on receiver type `t`
    // that dispatches through existential `x` (`dispatched_existential`),
    // resolved against the requirements `x`'s vtable carries. The receiver
    // is borrowed as the requirement declares through a reference to `x`: a
    // reference receiver is dereferenced to the existential, and an erased
    // box to its payload, so every dispatch's receiver is `&any Trait` or
    // `&var any Trait` and its owner is `x` (spec, `any Trait`
    // existentials). A trait that is not object-safe was refused where the
    // existential is written, so its calls are poisoned without a second
    // refusal.
    // ENTRY POINTS:
    //     method_call
    func dispatch_call(&var self, e: Int, callee: Int, base: Int, inner: Int, t: Int, x: Int, name: Int,
                       text: &String, args: &TcArgs) -> Int {
        let leaf = self.res.first_leaf(callee)
        let boxed = x != t
        if boxed && (text.equals("is") || text.equals("take")) {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            self.not_yet(e, "downcasting an erased box with `is` or `take`")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let tr = self.types.ty(x).decl
        if self.object_safety_reason(tr).len() > 0 {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var cands = Vector<TcCand>()
        let slots = self.dispatch_requirements(tr)
        var k = 0
        while k < slots.len() {
            let req = slots[k]
            k = k + 1
            if self.res.decls[req].name == name {
                try! cands.push(TcCand(decl: req, kind: TcCandKind.Function, member: -1, owner: x))
            }
        }
        if cands.len() == 0 {
            self.set_use(base, TcUse.Borrow)
            self.type_args_alone(&args)
            self.refuse_no_method(leaf, t, name)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        if boxed {
            self.add_adjust(base, TcAdjustKind.Deref, x)
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, base, TC_WANT_NONE)
    }

    // A `deinit` runs once, where its value's scope ends or a consuming
    // call takes it; a call written by hand would run it a second time
    // (spec, The Deinit trait).
    func refuse_manual_deinit(&var self, leaf: Int) {
        var msg = StringBuilder()
        try! msg.append("cannot call `deinit` manually: it runs once, where the value's scope ends; let the value go out of scope, or `move` it into a call that takes it")
        self.refuse(leaf, "deinit.manual-call", msg.build())
    }

    // What names method call `e`, of `name` on type `t`, as outside the
    // bootstrap slice, or "" when it is not: a method of the interior cell,
    // and a `borrow` block's head that lends through a closure parameter
    // rather
    // than as a `borrows` accessor, as today's `Mutex.lock` does.
    func method_outside_slice(&var self, e: Int, t: Int, name: Int, text: &String, cands: &Vector<TcCand>,
                              args: &TcArgs) -> String {
        let d = self.nominal_decl(t)
        if cands.len() == 0 {
            if d >= 0 && d == self.known.interior {
                return "a method of the interior cell `UnsafeMutableInterior`"
            }
            return ""
        }
        if e != self.borrow_head {
            return ""
        }
        var k = 0
        while k < cands.len() {
            let c = cands[k]
            k = k + 1
            let s = self.sigs[c.decl]
            if (s.effects & TC_EFFECT_BORROWS) != 0 {
                return ""
            }
        }
        let first = cands[0]
        let s = self.sigs[first.decl]
        if s.param_count > args.values.len() {
            let p = self.params[s.param_first + s.param_count - 1]
            if self.kind_of(p.ty) == TcKind.Func {
                var what = StringBuilder()
                try! what.append("a `borrow` block over ")
                try! what.append(self.cand_text(first))
                try! what.append(", which lends through a closure parameter, not as a `borrows` accessor,")
                return what.build()
            }
        }
        ""
    }

    // Refuses method call `name` on smart pointer `t` when the pointer does
    // not declare it and its payload does, naming the spelling that reaches
    // the payload, `borrow b.value().m(…)`; and says whether it refused.
    // A pointer forwards nothing, whatever the method's receiver, so every
    // `borrows` call stays spelled with `borrow` (SL:borrowing §2.2). An
    // erased payload is `method_outside_slice`'s.
    func refuse_through_pointer(&var self, leaf: Int, base: Int, t: Int, name: Int) -> Bool {
        let d = self.nominal_decl(t)
        if d < 0 || (d != self.known.box && d != self.known.arc) || self.nominal_args(t).len() == 0 {
            return false
        }
        let payload = self.arg_of(t, 0)
        // The payload's lookup must not stand in for the pointer's when
        // `refuse_no_method` reports a member its bound withholds.
        let unmet_member = self.unmet_member
        let unmet_owner = self.unmet_owner
        var cands = Vector<TcCand>()
        self.method_candidates(&var cands, payload, name, false)
        self.unmet_member = unmet_member
        self.unmet_owner = unmet_owner
        if cands.len() == 0 {
            return false
        }
        var shared = false
        var exclusive = false
        var k = 0
        while k < cands.len() {
            let s = self.sigs[cands[k].decl]
            k = k + 1
            if (s.effects & TC_EFFECT_CONSUMES) != 0 {
                continue
            }
            if s.receiver == TcReceiver.Exclusive {
                exclusive = true
            } else {
                shared = true
            }
        }
        let arc = d == self.known.arc
        let pointer = if arc { "Arc" } else { "Box" }
        let method = self.name_text(name)
        let m = self.current
        let receiver = self.text(m, base)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(method)
        try! msg.append("` is a method of the payload, `")
        try! msg.append(self.type_text(payload))
        try! msg.append("`, not of the `")
        try! msg.append(pointer)
        try! msg.append("`; ")
        if shared || (exclusive && not arc) {
            try! msg.append("reach it with `borrow ")
            if not shared {
                try! msg.append("var ")
            }
            try! msg.append(receiver)
            try! msg.append(".value().")
            try! msg.append(method)
            try! msg.append("(…)`")
            if not shared {
                try! msg.append(" on a `var` box")
            }
        } else if exclusive {
            try! msg.append("it takes `&var self`, and an `Arc` lends its payload shared, since every handle names it; write to it through a lock, `Arc<Mutex<T>>`, as `borrow var p = ")
            try! msg.append(receiver)
            try! msg.append(".value().lock() \{ p.")
            try! msg.append(method)
            try! msg.append("(…) \}`, or on a `var` handle that is the only strong owner, as `if borrow var p = ")
            try! msg.append(receiver)
            try! msg.append(".unique() \{ p.")
            try! msg.append(method)
            try! msg.append("(…) \}`")
        } else if arc {
            try! msg.append("it consumes its receiver, and an `Arc`'s payload is shared by every handle, so no call can take it")
        } else {
            try! msg.append("it consumes its receiver, and `value()` only lends the payload where the box keeps it")
        }
        self.refuse(leaf, "member.through-pointer", msg.build())
        true
    }

    // The node call `e`'s receiver is read from, or -1 for a call with
    // none: a subscript's base, or a method call's callee base.
    //
    // ENTRY POINTS:
    // - settle_call
    // - place_verdict
    // - lends_arc_payload
    // - window_receivers
    // - check_exclusive_windows
    // - MIR's call_operands
    // - MIR's prepare_lend
    // - MIR's lent_copy
    // - MIR's lend_receiver
    // - MIR's iterator_of
    public func call_receiver(&self, e: Int) -> Int {
        if self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi) {
            return self.res.first_node_child(e)
        }
        let callee = self.res.first_node_child(e)
        if callee < 0 || not self.has_alt(callee, Alt.Expr_Member) {
            return -1
        }
        self.res.first_node_child(callee)
    }

    // The field named `name` of type `t` this module sees whose type is a
    // function type, or -1.
    func function_field(&var self, t: Int, name: Int) -> Int {
        let d = self.nominal_decl(t)
        if d < 0 {
            return -1
        }
        let m = self.current
        let in_test = self.current_test
        let found = self.visible_members(d, name, m, in_test)
        var k = 0
        while k < found.len() {
            let member = self.members[found[k]]
            k = k + 1
            let mi = self.res.decls[member.decl]
            if mi.kind != ResDeclKind.Field {
                continue
            }
            let ft = self.field_type(t, member.decl)
            if self.kind_of(ft) == TcKind.Func {
                return member.decl
            }
        }
        return -1
    }

    // Field `f`'s type in nominal type `t`, its arguments substituted.
    func field_type(&var self, t: Int, f: Int) -> Int {
        self.build_decl(f)
        let d = self.nominal_decl(t)
        let written = self.sigs[f].result
        let s = TcSubst(owner: d, args: self.nominal_args(t))
        self.subst(written, &s)
    }

    // `x.f(...)` where `f` is a field holding a function and no method of
    // that name is seen: the call of the field's value (SL:open-questions
    // D16).
    func field_call(&var self, e: Int, callee: Int, base: Int, bt: Int, inner: Int, field: Int, t: Int,
                    args: &TcArgs) -> Int {
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        self.set_use(base, TcUse.Project)
        let place = self.expr_place[base] || self.referent(bt) >= 0
        let ft = self.field_type(t, field)
        let _ = self.set_type(callee, ft, place)
        self.set_use(callee, TcUse.Borrow)
        self.call_function_value(e, callee, ft, &args)
    }

    // `x.f(...)` where `f` names both a field holding a function and a
    // method this module sees: neither is chosen silently (D16).
    func refuse_field_method(&var self, e: Int, base: Int, field: Int, cands: &Vector<TcCand>, text: &String) {
        let m = self.current
        var receiver = "value"
        if self.has_alt(base, Alt.Expr_Name) || self.has_alt(base, Alt.Expr_Self) {
            let leaf = self.res.first_leaf(base)
            receiver = self.text(m, leaf)
        }
        let method = cands[0]
        let method_text = self.cand_text(method)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` names both the field `")
        try! msg.append(self.res.decl_path(field))
        try! msg.append("`, which holds a function, and the method ")
        try! msg.append(method_text)
        try! msg.append(", so this call could mean either; to call the field's function, bind it first: `let g = ")
        try! msg.append(receiver)
        try! msg.append(".")
        try! msg.append(text)
        try! msg.append("; g(...)`")
        self.refuse(e, "call.field-method-ambiguous", msg.build())
    }

    // Whether `t` answers method `text` with no declaration to find: an
    // Optional's `take`, `is_some` and `is_none` (design 131) while the
    // Optional lang item is the synthesized one, since an Optional a std
    // declares writes its own, and `copy` on a type of the Copy or
    // ExplicitCopy tier.
    func is_builtin_method(&var self, t: Int, text: &String) -> Bool {
        let synthesized = self.known.optional >= 0 && self.res.decls[self.known.optional].node < 0
        if synthesized && self.is_optional(t) && (text.equals("take") || text.equals("is_some") || text.equals("is_none")) {
            return true
        }
        text.equals("copy") && not self.has_error(t)
    }

    // A method no declaration writes: `o.take()` swaps `None` into the place
    // and hands out what was there; `o.is_some()` and `o.is_none()` read the
    // tag alone; `x.copy()` duplicates a Copy or ExplicitCopy value, and is
    // refused for a NoCopy one.
    func builtin_method(&var self, e: Int, base: Int, inner: Int, t: Int, text: &String,
                        args: &TcArgs) -> Int {
        if args.values.len() > 0 {
            self.refuse(e, "call.arity", "this builtin method takes no arguments")
            self.type_args_alone(&args)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let exclusive = text.equals("take")
        let r = self.mk_ref(exclusive, t)
        if exclusive {
            if not self.expr_place[base] && inner < 0 {
                self.refuse_not_a_place(base)
            }
            self.add_adjust(base, TcAdjustKind.BorrowVar, r)
            self.set_use(base, TcUse.BorrowVar)
        } else {
            self.add_adjust(base, TcAdjustKind.Borrow, r)
            self.set_use(base, TcUse.Borrow)
        }
        var spelling = "copy"
        if text.equals("take") {
            spelling = "take"
        } else if text.equals("is_some") {
            spelling = "is_some"
        } else if text.equals("is_none") {
            spelling = "is_none"
        }
        self.record_builtin(e, -1, TcRole.Builtin, spelling)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        if text.equals("take") {
            self.check_take(e, base, t)
            return self.set_type(e, t, false)
        }
        if text.equals("copy") {
            self.check_builtin_copy(e, t)
            return self.set_type(e, t, false)
        }
        let b = self.bool_type()
        self.set_type(e, b, false)
    }

    // The builtin `copy()` exists on a type that meets `ExplicitCopy` where
    // it is named, through its tier or a conformance whose conditions hold,
    // at any depth of a tuple, an array or an Optional; a part that is a type
    // parameter is answered by the bounds in scope (design 219).
    func check_builtin_copy(&var self, e: Int, t: Int) {
        let ec = self.known.explicit_copy
        let env = self.current_decl
        let ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        if ec < 0 || self.satisfies(t, ec, env, ext, viewer, in_test) {
            return
        }
        let blocker = self.unbounded_part(t, ec)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        if blocker == t {
            try! msg.append("` has no `copy()`: no bound makes it `ExplicitCopy`; declare `")
            try! msg.append(self.type_text(blocker))
            try! msg.append(": ExplicitCopy`, or `Copy`")
            self.refuse(e, "type.bound", msg.build())
            return
        }
        if blocker >= 0 {
            try! msg.append("` has no `copy()`: its copy reaches the type parameter `")
            try! msg.append(self.type_text(blocker))
            try! msg.append("`, which no bound makes `ExplicitCopy`; declare `")
            try! msg.append(self.type_text(blocker))
            try! msg.append(": ExplicitCopy`, or `Copy`")
            self.refuse(e, "type.bound", msg.build())
            return
        }
        try! msg.append("` is NoCopy, so it has no `copy()`; move it instead")
        self.refuse(e, "member.unknown", msg.build())
    }

    // The first type parameter in `t` that does not meet trait `tr`, or -1.
    func unbounded_part(&var self, t: Int, tr: Int) -> Int {
        var seen = tc_memo()
        self.unbounded_part_in(t, tr, &var seen)
    }

    // One part of `unbounded_part`'s walk. A part met again was searched in
    // full the first time and found nothing.
    func unbounded_part_in(&var self, t: Int, tr: Int, seen: &var TcMemo) -> Int {
        if t < 0 || not seen.mark(t, 0) {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Param {
            let env = self.current_decl
            let ext = self.current_ext
            let viewer = self.current
            let in_test = self.current_test
            if self.satisfies(t, tr, env, ext, viewer, in_test) {
                return -1
            }
            return t
        }
        if info.kind == TcKind.Array {
            return self.unbounded_part_in(info.b, tr, &var seen)
        }
        if info.kind == TcKind.Tuple || info.kind == TcKind.Nominal {
            var k = 0
            while k < info.count {
                let part = self.types.arg(t, k)
                let found = self.unbounded_part_in(part, tr, &var seen)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
        }
        return -1
    }

    // A fixed array's or a slice's builtin `len()` and `swap(i, j)`: the one
    // reads, the other writes, its receiver.
    func sequence_method(&var self, e: Int, base: Int, inner: Int, t: Int, text: &String,
                         args: &TcArgs) -> Int {
        let swap = text.equals("swap")
        let wanted = if swap { 2 } else { 0 }
        let i = self.int_type()
        var k = 0
        while k < args.values.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label", "a builtin method's arguments take no labels")
            }
            self.check_argument(args.values[k], i)
            k = k + 1
        }
        if args.values.len() != wanted {
            self.refuse(e, "call.arity", "`len()` takes no arguments, and `swap(i, j)` two indices")
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let is_array = self.kind_of(t) == TcKind.Array
        if swap {
            if is_array {
                let r = self.mk_ref(true, t)
                self.add_adjust(base, TcAdjustKind.BorrowVar, r)
            }
            self.set_use(base, TcUse.BorrowVar)
            self.record_builtin(e, -1, TcRole.Builtin, "swap")
            let v = self.void_type()
            return self.set_type(e, v, false)
        }
        if is_array {
            let r = self.mk_ref(false, t)
            self.add_adjust(base, TcAdjustKind.Borrow, r)
        }
        self.set_use(base, TcUse.Borrow)
        self.record_builtin(e, -1, TcRole.Builtin, "len")
        self.set_type(e, i, false)
    }

    // The instance (or, with `statics`, static) methods named `name` that
    // type `t` offers: its member table's, or its bounds' requirements for a
    // type parameter or a trait's `Self`.
    func method_candidates(&var self, out: &var Vector<TcCand>, t: Int, name: Int, statics: Bool) {
        let info = self.types.ty(t)
        let m = self.current
        self.unmet_member = -1
        if info.kind == TcKind.Nominal {
            let in_test = self.current_test
            let found = self.members_for(t, name, m, in_test)
            var k = 0
            while k < found.len() {
                let at = found[k]
                if self.is_method_member(at, statics) {
                    let member = self.members[at]
                    self.build_decl(member.decl)
                    try! out.push(TcCand(decl: member.decl, kind: TcCandKind.Function, member: at,
                                         owner: t))
                }
                k = k + 1
            }
            if out.len() == 0 {
                self.primitive_requirements(&var out, t, info.decl, name, statics)
            } else if self.is_primitive_decl(info.decl) {
                // A builtin type's own method beside its builtin conformance's
                // requirement of one name, Stage 0's `String.compare(other:
                // String)` beside `compare(other: &Self)`, overload by their
                // parameters, so the call site's sigil picks one.
                var reqs = Vector<TcCand>()
                self.primitive_requirements(&var reqs, t, info.decl, name, statics)
                var r = 0
                while r < reqs.len() {
                    let req = reqs[r]
                    r = r + 1
                    if not self.shadowed_requirement(&out, req, t) {
                        try! out.push(req)
                    }
                }
            }
            return
        }
        var reqs = Vector<Int>()
        if info.kind == TcKind.Param {
            let ext = self.current_ext
            reqs = self.bound_requirements(info.decl, info.a, name, ext)
        } else if info.kind == TcKind.SelfType {
            let all = self.carried_traits(info.decl)
            var j = 0
            while j < all.len() {
                let members = self.members_of(all[j])
                var r = 0
                while r < members.len() {
                    let req = members[r]
                    let ri = self.res.decls[req]
                    if ri.kind == ResDeclKind.Requirement && ri.name == name {
                        try! reqs.push(req)
                    }
                    r = r + 1
                }
                j = j + 1
            }
        }
        var k = 0
        while k < reqs.len() {
            let req = reqs[k]
            self.build_decl(req)
            let s = self.sigs[req]
            let is_static = (s.flags & TC_FLAG_STATIC) != 0
            if is_static == statics {
                try! out.push(TcCand(decl: req, kind: TcCandKind.Function, member: -1, owner: t))
            }
            k = k + 1
        }
    }

    // Whether candidate `req`, a requirement on type `t`, takes the same
    // parameters as one of `found`, which then answers for it.
    func shadowed_requirement(&var self, found: &Vector<TcCand>, req: TcCand, t: Int) -> Bool {
        let n = self.cand_param_count(req)
        var k = 0
        while k < found.len() {
            let c = found[k]
            k = k + 1
            if self.cand_param_count(c) != n {
                continue
            }
            var same = true
            var j = 0
            while j < n && same {
                let a = self.cand_param_type(req, j)
                let b = self.cand_param_type(c, j)
                same = self.same_under_self(a, b, t)
                j = j + 1
            }
            if same {
                return true
            }
        }
        false
    }

    // Whether type `a`, which may name `Self`, is type `b` once `Self` is `t`.
    func same_under_self(&self, a: Int, b: Int, t: Int) -> Bool {
        if a == b {
            return true
        }
        let ia = self.types.ty(a)
        let ib = self.types.ty(b)
        if ia.kind == TcKind.SelfType {
            return b == t
        }
        if self.is_reference(a) && ia.kind == ib.kind && ia.a == ib.a {
            return self.same_under_self(ia.b, ib.b, t)
        }
        false
    }

    // The methods named `name` a type answers through a conformance no
    // extension writes: a builtin type's builtin ones (design 109), `n.format`
    // and `7.to_string()` for Printable, `equals`, `compare`, `hash`; and a
    // trivially copyable type's automatic `Equatable` and `Hashable`.
    func primitive_requirements(&var self, out: &var Vector<TcCand>, t: Int, d: Int, name: Int, statics: Bool) {
        var traits = Vector<Int>()
        try! traits.push(self.known.printable)
        try! traits.push(self.known.equatable)
        try! traits.push(self.known.comparable)
        try! traits.push(self.known.hashable)
        let primitive = self.is_primitive_decl(d)
        var k = 0
        while k < traits.len() {
            let tr = traits[k]
            k = k + 1
            if tr < 0 {
                continue
            }
            var granted = false
            if primitive {
                granted = self.primitive_grants(d, tr)
            } else if tr == self.known.equatable || tr == self.known.hashable {
                granted = not self.has_conformance(d, tr) && self.is_trivial(t)
            }
            if not granted {
                continue
            }
            let members = self.members_of(tr)
            var r = 0
            while r < members.len() {
                let req = members[r]
                r = r + 1
                let ri = self.res.decls[req]
                if ri.kind != ResDeclKind.Requirement || ri.name != name {
                    continue
                }
                self.build_decl(req)
                let s = self.sigs[req]
                let is_static = (s.flags & TC_FLAG_STATIC) != 0
                if is_static == statics {
                    try! out.push(TcCand(decl: req, kind: TcCandKind.Function, member: -1, owner: t))
                }
            }
        }
    }

    // `T.f(...)`: a static method of a named type, or of a type parameter's
    // bounds. A generic type written without its arguments takes them from
    // the call (`named_owner`).
    func static_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs, want: Int) -> Int {
        let base = self.res.first_node_child(callee)
        let leaf = self.res.first_leaf(callee)
        let m = self.current
        let text = self.text(m, leaf)
        let name = self.res.intern(text)
        if b.decl >= 0 && b.decl == self.known.task && text.equals("spawn") {
            return self.task_spawn(e, &args)
        }
        var t = -1
        if b.decl >= 0 {
            let written = self.explicit_type_args(base)
            t = self.named_owner(b.decl, &written, leaf)
            if t == TC_OWNER_INFER {
                return self.inferred_static_call(e, callee, b.decl, name, &args, want)
            }
        } else if b.node >= 0 {
            t = self.param_type(b.node)
        }
        if t < 0 || self.has_error(t) {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.is_box(t) && text.equals("make") {
            let payload = self.arg_of(t, 0)
            if self.kind_of(payload) == TcKind.Any {
                return self.erasing_make(e, t, &args)
            }
        }
        if text.equals("from") {
            if self.is_integer(t) {
                return self.integer_from(e, t, &args)
            }
            let d = self.nominal_decl(t)
            if self.is_enum_decl(d) && self.sigs[d].result >= 0 {
                return self.raw_from(e, d, t, &args)
            }
        }
        var cands = Vector<TcCand>()
        self.method_candidates(&var cands, t, name, true)
        if cands.len() == 0 {
            self.type_args_alone(&args)
            if text.equals("deinit") {
                self.refuse_manual_deinit(leaf)
            } else {
                self.refuse_no_method(leaf, t, name)
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, -1, TC_WANT_NONE)
    }

    // `G.f(...)` on generic type `d` written without its arguments: its
    // statics named `name`, owner-less, so the call's inference solves the
    // type's parameters from the arguments and from `want` through the
    // result (`check_candidate`); a raw-backed enum's `from(raw:)` takes them
    // from `want` as a case does. A bound of the declaring extension is met
    // once they are solved (`finish_call`).
    func inferred_static_call(&var self, e: Int, callee: Int, d: Int, name: Int, args: &TcArgs, want: Int) -> Int {
        let leaf = self.res.first_leaf(callee)
        let text = self.name_text(name)
        if text.equals("from") && self.is_enum_decl(d) && self.sigs[d].result >= 0 {
            let t = self.enum_type_for(e, d, want)
            if self.has_error(t) {
                self.type_args_alone(&args)
                return self.set_type(e, t, false)
            }
            return self.raw_from(e, d, t, &args)
        }
        let m = self.current
        let in_test = self.current_test
        let found = self.visible_members(d, name, m, in_test)
        var cands = Vector<TcCand>()
        var own_generics = false
        var k = 0
        while k < found.len() {
            let at = found[k]
            k = k + 1
            if self.is_method_member(at, true) {
                let member = self.members[at]
                self.build_decl(member.decl)
                if self.sigs[member.decl].generic_count > 0 {
                    own_generics = true
                }
                let owner = self.found_owner(at, -1)
                try! cands.push(TcCand(decl: member.decl, kind: TcCandKind.Function, member: at, owner: owner))
            }
        }
        if cands.len() == 0 {
            self.type_args_alone(&args)
            if text.equals("deinit") {
                self.refuse_manual_deinit(leaf)
            } else {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.nominal_name(d))
                try! msg.append("` has no method `")
                try! msg.append(text)
                try! msg.append("` this module can see")
                self.refuse(leaf, "member.unknown", msg.build())
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if own_generics {
            // One solve holds one declaration's parameters, and this call
            // would need the type's and the method's at once.
            self.type_args_alone(&args)
            self.not_yet(e, "a generic static method called on a generic type written without its type arguments")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let explicit = self.explicit_type_args(callee)
        self.resolve_call(e, &cands, &args, &explicit, -1, want)
    }

    // Whether candidate `c` is a static method found on a generic type
    // written without its arguments, which the call's inference instantiates
    // (`inferred_static_call`).
    func infers_static_owner(&self, c: TcCand) -> Bool {
        if c.kind != TcCandKind.Function || c.owner >= 0 || c.member < 0 {
            return false
        }
        self.res.decls[c.decl].kind != ResDeclKind.Init
    }

    // `Task.spawn(f(x))`, the background spawn form (design 242). Its one
    // argument is the task's root, a call of a free function that the task
    // makes; the form hands back `Task<T>` for a root of type `T`, `Void`
    // included. The background group has no scope to end a borrow at, so the
    // root takes none. A freestanding image has no `main` whose return closes
    // that group, so the form is refused there.
    func task_spawn(&var self, e: Int, args: &TcArgs) -> Int {
        let form = "Task.spawn"
        if self.freestanding {
            self.refuse(e, "spawn.freestanding", "freestanding profile: `Task.spawn` needs the process-wide background task group, which is closed at `main`'s return — a freestanding image has no such entry point; declare a `TaskGroup` and spawn into it with `group.spawn(work(...))`: the group is the scope that says where the tasks end")
        }
        let root = self.spawned_root(e, &args, form)
        if root < 0 {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let body = self.expr(root, TC_WANT_NONE)
        self.consume(root)
        self.spawn_roots[root] = true
        self.record_builtin(e, -1, TcRole.Spawn, form)
        let subject = self.root_subject(root)
        let refused = self.refuse_never_task_body(e, subject, "the task never completes and `join` on its handle could never return", body)
        let borrowed = self.refuse_spawn_borrows(root, form)
        if refused || borrowed || self.has_error(body) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let handle = self.task_handle(body)
        self.set_type(e, handle, false)
    }

    // Whether call head `callee` is `Thread.spawn`, the OS-thread form. Its
    // namespace names an engine, not a declaration, so it is known by its
    // spelling and a program's own `Thread` does not change it (design 242).
    func is_thread_spawn_head(&self, callee: Int) -> Bool {
        if callee < 0 || not self.has_alt(callee, Alt.Expr_Member) {
            return false
        }
        let base = self.res.first_node_child(callee)
        if base < 0 || not self.has_alt(base, Alt.Expr_Name) || self.child_count(base) != 1 {
            return false
        }
        let m = self.node_module(callee)
        let head = self.text(m, base)
        let last = self.res.last_leaf_of(callee)
        let member = self.text(m, last)
        member.equals("spawn") && head.equals("Thread")
    }

    // `Thread.spawn { ... }`, the OS-thread form (design 242). Its one
    // argument is a brace with no parameters, whose capture list is its
    // parameter list (`check_thread_braces`); the body is a `sync` context
    // that may call a `blocking` extern (`check_thread_call`). It hands back
    // `Result<Thread<T>, SystemError>` for a body of type `T`, `Void`
    // included: the OS may refuse a thread. The result crosses back to the
    // spawner, so it must be `Send`.
    func thread_spawn(&var self, e: Int, args: &TcArgs) -> Int {
        let form = "Thread.spawn"
        let brace = if args.values.len() == 1 && args.labels[0] < 0 { args.values[0] } else { -1 }
        if brace < 0 || not self.has_alt(brace, Alt.Expr_Closure) {
            self.refuse(e, "spawn.argument", "`Thread.spawn` takes exactly one closure argument: `Thread.spawn \{ ... \}`")
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let body = self.thread_body_type(brace)
        self.consume(brace)
        try! self.thread_forms.push(e)
        try! self.thread_braces.push(brace)
        self.record_builtin(e, -1, TcRole.Builtin, form)
        if self.has_error(body) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        // An inferred closure result reads a body that ends in `Never` as
        // `Void` (`merge_open_result`), so the brace's own ending is asked.
        let ends = if self.closure_never { self.never_type() } else { body }
        if self.refuse_never_task_body(e, "this closure's body", "the task never completes and `join` on its handle could never return", ends) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.refuse_unsent_result(brace, body)
        let d = self.known.thread
        let error = self.known.system_error
        let result = self.known.result
        if d < 0 || error < 0 || result < 0 {
            // The brace is still checked whole: Stage 0's std declares no
            // `SystemError`, and its summary table is what a body there reads.
            self.refuse(e, "slice.not-yet", "`Thread.spawn` under a std root that declares no `Thread` or `SystemError` is not in the bootstrap slice yet")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var handle_args = Vector<Int>()
        try! handle_args.push(body)
        let handle = self.mk_nominal(d, &handle_args)
        let none = Vector<Int>()
        let failure = self.mk_nominal(error, &none)
        var result_args = Vector<Int>()
        try! result_args.push(handle)
        try! result_args.push(failure)
        let t = self.mk_nominal(result, &result_args)
        self.set_type(e, t, false)
    }

    // The type `Thread.spawn`'s brace gives: its body's, refused when the
    // brace declares parameters, since nothing calls it with any.
    func thread_body_type(&var self, brace: Int) -> Int {
        let ct = self.expr(brace, TC_WANT_NONE)
        let n = self.child_count(brace)
        var k = 0
        while k < n {
            let c = self.child(brace, k)
            k = k + 1
            if self.is_closure_param(c) {
                self.refuse(c, "spawn.argument", "`Thread.spawn`'s closure takes no parameters")
                return self.error_type
            }
        }
        if self.has_error(ct) || self.kind_of(ct) != TcKind.Func {
            return self.error_type
        }
        self.types.ty(ct).b
    }

    // Refuses a `Thread.spawn` body whose type `body` is not `Send`: the value
    // is made on the spawned thread and `join()` hands it to this one. A type
    // naming a type parameter is judged where its instantiation is made.
    func refuse_unsent_result(&var self, brace: Int, body: Int) {
        let send = self.known.send
        if send < 0 || self.is_void(body) || self.mentions_param(body) {
            return
        }
        let env_decl = self.current_decl
        let env_ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        if self.satisfies(body, send, env_decl, env_ext, viewer, in_test) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("cannot `Thread.spawn`: the closure's result type `")
        try! msg.append(self.type_text(body))
        try! msg.append("` is not `Send`, so it cannot travel back from the spawned thread to `join()`. Return a Send value; share thread-unsafe state through `Arc` (and `Mutex` for mutation) or a `Channel` instead of handing it back")
        self.refuse(brace, "spawn.send", msg.build())
    }

    // `group.spawn(f(x))`, the group spawn form: `group`, of type `t` (through
    // a reference when `inner` is not -1), is borrowed shared for the spawn
    // alone, since a group enqueues through its address and a task may spawn
    // siblings into a group it was handed as `&TaskGroup` (spec, TaskGroup).
    // The root is `Task.spawn`'s, and so is the handle. A borrow the root
    // takes of its spawner lasts the task's life, a loan the handle carries,
    // which the borrow check judges (`spawn_loans`, SL:coroutines A8c).
    func group_spawn(&var self, e: Int, base: Int, inner: Int, t: Int, args: &TcArgs) -> Int {
        let form = "group.spawn"
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let r = self.mk_ref(false, t)
        self.add_adjust(base, TcAdjustKind.Borrow, r)
        self.set_use(base, TcUse.Borrow)
        let root = self.spawned_root(e, &args, form)
        if root < 0 {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let body = self.expr(root, TC_WANT_NONE)
        self.consume(root)
        self.spawn_roots[root] = true
        self.record_builtin(e, -1, TcRole.Spawn, form)
        let subject = self.root_subject(root)
        let refused = self.refuse_never_task_body(e, subject, "the task never completes and `join` on its handle could never return", body)
        if refused || self.has_error(body) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let handle = self.task_handle(body)
        self.set_type(e, handle, false)
    }

    // `__saw_drive(f(x))` and `__saw_drive_steps(f(x))`, the test drivers
    // (design 44). The one argument is the root, a call of a function or a
    // method that the driver runs to its end over a frame of its own;
    // `__saw_drive` gives the root's result and `__saw_drive_steps` how many
    // times it reported `Pending`. The root's suspensions are the driver's,
    // so the site is sync from outside (`TcProgram.drive_roots`).
    func test_drive(&var self, e: Int, d: Int, name: String, args: &TcArgs) -> Int {
        let root = self.driven_root(e, &args, name)
        if root < 0 {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let body = self.expr(root, TC_WANT_NONE)
        self.consume(root)
        self.drive_roots[root] = true
        self.record_builtin(e, d, TcRole.Builtin, name)
        let at = self.call_at[root]
        let called = at >= 0 && self.calls[at].role == TcRole.Call
        if not self.has_error(body) && not called {
            self.refuse_driven_root(root, name)
        }
        if self.has_error(body) || not called {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var consequence = StringBuilder()
        try! consequence.append("`")
        try! consequence.append(name)
        try! consequence.append("` would drive it for ever")
        let subject = self.root_subject(root)
        if self.refuse_never_task_body(e, subject, consequence.build(), body) {
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if name.equals("__saw_drive_steps") {
            let t = self.int_type()
            return self.set_type(e, t, false)
        }
        self.set_type(e, body, false)
    }

    // The root call of drive site `e`, its one positional argument, or -1
    // once refused.
    func driven_root(&var self, e: Int, args: &TcArgs, name: String) -> Int {
        if args.values.len() != 1 || args.labels[0] >= 0 {
            self.refuse_driven_root(e, name)
            return -1
        }
        let root = args.values[0]
        let at = if self.is_call_alt(root) { self.res_call_at[root] } else { -1 }
        let class = if at >= 0 { self.res.calls[at].classification } else { ResCallClass.Value }
        if class != ResCallClass.Overload && class != ResCallClass.Method && class != ResCallClass.StaticMethod {
            self.refuse_driven_root(root, name)
            return -1
        }
        root
    }

    func refuse_driven_root(&var self, at: Int, name: String) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(name)
        try! msg.append("(...)` takes exactly one positional argument, a call of a function or a method to drive, as in `")
        try! msg.append(name)
        try! msg.append("(worker(n))`: a frame is built for a named function, so a closure or a value cannot be the root")
        self.refuse(at, "drive.argument", msg.build())
    }

    // The root call of spawn form `e`, its one positional argument, or -1
    // once refused: a call of a free function, since a task's frame is built
    // for a named function.
    func spawned_root(&var self, e: Int, args: &TcArgs, form: String) -> Int {
        if args.values.len() != 1 || args.labels[0] >= 0 {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(form)
            try! msg.append("(...)` takes exactly one positional argument: a call of the function to run as a task, as in `")
            try! msg.append(form)
            try! msg.append("(worker(n))`")
            self.refuse(e, "spawn.argument", msg.build())
            return -1
        }
        let root = args.values[0]
        let at = if self.is_call_alt(root) { self.res_call_at[root] } else { -1 }
        if at < 0 || self.res.calls[at].classification != ResCallClass.Overload {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(form)
            try! msg.append("(...)` takes a call of a free function, as in `")
            try! msg.append(form)
            try! msg.append("(worker(n))`: a task's frame is built for a named function, so a method, a closure or a value cannot be its root")
            self.refuse(root, "spawn.argument", msg.build())
            return -1
        }
        root
    }

    // THE NEVER-BODY FUNNEL: a task body may not be `Never`, since a task is
    // something to wait for and a `Never` body would give it a result that
    // cannot exist (design 228). Refuses at `at` when the body `subject`
    // names has type `body`, with `consequence` saying what would follow, and
    // returns whether it refused.
    // ENTRY POINTS:
    //     task_spawn
    //     test_drive
    //     group_spawn
    //     thread_spawn
    func refuse_never_task_body(&var self, at: Int, subject: String, consequence: String, body: Int) -> Bool {
        if not self.is_never(body) {
            return false
        }
        var msg = StringBuilder()
        try! msg.append("a task body may not be `Never`: ")
        try! msg.append(subject)
        try! msg.append(" never returns, so ")
        try! msg.append(consequence)
        try! msg.append(". Write a forever-task as `-> Void` with a loop, `func serve() \{ while \{ ... \} \}`, and end it by cancelling the task or breaking the loop")
        self.refuse(at, "spawn.never-body", msg.build())
        true
    }

    // How the Never-body funnel names root call `root`'s body: its callee,
    // as written.
    func root_subject(&self, root: Int) -> String {
        let callee = self.res.first_node_child(root)
        let m = self.node_module(root)
        var out = StringBuilder()
        try! out.append("`")
        try! out.append(self.text(m, callee))
        try! out.append("`")
        out.build()
    }

    // THE SPAWN-BORROW FUNNEL: each place where root call `root` takes a
    // borrow of its spawner for the task's life: a `&` or `&var` argument of
    // the call, then each borrow capture a closure anywhere inside it writes
    // (`[&x]`, `[&var x]`, `[&self]`, `[&var self]`). A reference that a call
    // nested in the arguments makes is none: that call runs at the spawn, and
    // its borrow ends with the statement. A closure argument's own borrow of
    // its environment is the second half's (`spawn_environment_sources`).
    // ENTRY POINTS:
    //     refuse_spawn_borrows
    func spawn_borrow_sources(&self, root: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let callee = self.res.first_node_child(root)
        let n = self.child_count(root)
        var k = 0
        while k < n {
            var arg = self.child(root, k)
            k = k + 1
            if arg == callee || self.is_leaf(arg) {
                continue
            }
            if self.has_alt(arg, Alt.Expr_Argument_Positional) {
                arg = self.res.first_node_child(arg)
            } else if self.has_alt(arg, Alt.Expr_Argument_Labelled) {
                arg = self.res.last_node_child(arg)
            }
            if self.has_alt(arg, Alt.Expr_Ref_Shared) || self.has_alt(arg, Alt.Expr_Ref_Exclusive) {
                try! out.push(arg)
            }
        }
        var stack = Vector<Int>()
        try! stack.push(root)
        var top = 1
        while top > 0 {
            top = top - 1
            let id = stack[top]
            if self.has_alt(id, Alt.Expr_Capture_Borrow) || self.has_alt(id, Alt.Expr_Capture_BorrowExclusive) || self.has_alt(id, Alt.Expr_Capture_Self) || self.has_alt(id, Alt.Expr_Capture_SelfExclusive) {
                try! out.push(id)
            }
            var c = self.child_count(id) - 1
            while c >= 0 {
                let child = self.child(id, c)
                c = c - 1
                if self.is_leaf(child) {
                    continue
                }
                if top < stack.len() {
                    stack[top] = child
                } else {
                    try! stack.push(child)
                }
                top = top + 1
            }
        }
        move out
    }

    // The spawn-borrow funnel's second half, which reads the capture tables
    // `settle_captures` builds: each argument of root call `root` that is a
    // borrow of an environment, a capturing closure that does not escape,
    // whose value is a reference to its environment in the spawning function,
    // or a binding of a non-escaping function value, whose environment some
    // caller holds. A capture-less closure has no environment (SL-805).
    // ENTRY POINTS:
    //     check_task_spawn_environments
    func spawn_environment_sources(&self, root: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let callee = self.res.first_node_child(root)
        let n = self.child_count(root)
        var k = 0
        while k < n {
            var arg = self.child(root, k)
            k = k + 1
            if arg == callee || self.is_leaf(arg) {
                continue
            }
            if self.has_alt(arg, Alt.Expr_Argument_Positional) {
                arg = self.res.first_node_child(arg)
            } else if self.has_alt(arg, Alt.Expr_Argument_Labelled) {
                arg = self.res.last_node_child(arg)
            }
            if self.nonescaping_value(arg) {
                try! out.push(arg)
                continue
            }
            let at = self.unparen(arg)
            if at < 0 || not self.has_alt(at, Alt.Expr_Closure) {
                continue
            }
            let found = self.closure_index.first(at, 0)
            if found < 0 {
                continue
            }
            let ordinal = self.closure_index.value(found)
            let escapes = ordinal >= self.closure_escaping.len() || self.closure_escaping[ordinal]
            if not escapes && ordinal < self.capture_count.len() && self.capture_count[ordinal] > 0 {
                try! out.push(at)
            }
        }
        move out
    }

    // Each `Task.spawn` root's arguments that borrow an environment
    // (`spawn_environment_sources`), refused as `spawn.borrow` refuses a
    // written `&x`: the background task may outlive the environment.
    func check_task_spawn_environments(&var self) {
        var k = 0
        while k < self.calls.len() {
            let c = self.calls[k]
            k = k + 1
            if c.role != TcRole.Spawn || c.spelling < 0 || not self.name_text(c.spelling).equals("Task.spawn") {
                continue
            }
            let root = self.spawned_root_of(c.node)
            if root < 0 {
                continue
            }
            let sources = self.spawn_environment_sources(root)
            let m = self.node_module(root)
            var j = 0
            while j < sources.len() {
                let at = sources[j]
                j = j + 1
                var msg = StringBuilder()
                try! msg.append("`Task.spawn` accepts no borrows: ")
                if self.has_alt(at, Alt.Expr_Closure) {
                    try! msg.append("the closure at ")
                    let start = self.res.nodes[at].start
                    try! msg.append(self.res.position_text(m, start))
                    try! msg.append(" borrows its environment, which lives in the function that spawns it")
                } else {
                    try! msg.append("the closure `")
                    try! msg.append(self.text(m, at))
                    try! msg.append("` borrows an environment a caller holds")
                }
                try! msg.append(". A background task outlives the statement that spawned it and may be detached, so no join ends the borrow: spawn into a `TaskGroup`, since a group's scope is the borrow's extent, or hand the task an owned value, an `Arc` or a `Channel`")
                self.refuse(at, "spawn.borrow", msg.build())
            }
        }
    }

    // The root call of spawn form `e`: its argument the form marked as a
    // spawn root, or -1.
    func spawned_root_of(&self, e: Int) -> Int {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            if self.spawn_roots[c] {
                return c
            }
            let inner = self.child_count(c)
            var j = 0
            while j < inner {
                let g = self.child(c, j)
                j = j + 1
                if not self.is_leaf(g) && self.spawn_roots[g] {
                    return g
                }
            }
        }
        return -1
    }

    // Refuses each borrow root call `root` of spawn form `form` would take,
    // and returns whether it refused one.
    func refuse_spawn_borrows(&var self, root: Int, form: String) -> Bool {
        let sources = self.spawn_borrow_sources(root)
        let m = self.node_module(root)
        var k = 0
        while k < sources.len() {
            let at = sources[k]
            k = k + 1
            let capture = self.is_capture(at)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(form)
            try! msg.append("` accepts no borrows: `")
            try! msg.append(self.text(m, at))
            if capture {
                try! msg.append("` is a capture of the spawned call")
            } else {
                try! msg.append("` is an argument of the spawned call")
            }
            try! msg.append(". A background task outlives the statement that spawned it and may be detached, so no join ends the borrow: spawn into a `TaskGroup`, since a group's scope is the borrow's extent, or hand the task an owned value, an `Arc` or a `Channel`")
            self.refuse(at, "spawn.borrow", msg.build())
        }
        sources.len() > 0
    }

    // The handle a spawn form hands back for a root of type `body`: `Task<T>`
    // at every `T`, `Void` included.
    func task_handle(&var self, body: Int) -> Int {
        var args = Vector<Int>()
        try! args.push(body)
        let d = self.known.task
        self.mk_nominal(d, &args)
    }

    // `T.from(x)`, the checked conversion to `T?`, and `T.from(truncating:
    // x)`, which keeps the low bits: integer `T`, integer `x` (design 170).
    // The argument takes no expectation, since out of range is what `from`
    // answers.
    func integer_from(&var self, e: Int, t: Int, args: &TcArgs) -> Int {
        let truncating_name = self.res.intern("truncating")
        var truncating = false
        if args.values.len() != 1 {
            self.refuse(e, "call.arity", "an integer's `from` takes one argument")
            self.type_args_alone(&args)
        } else {
            let label = args.labels[0]
            if label == truncating_name {
                truncating = true
            } else if label >= 0 {
                self.refuse(args.values[0], "call.label",
                            "an integer's `from` takes an unlabeled argument, or `truncating:`")
            }
            let v = args.values[0]
            let _ = self.expr(v, TC_WANT_NONE)
            self.consume(v)
            let vt = self.through_refs(v)
            if not self.has_error(vt) && not self.is_integer(vt) {
                self.refuse_operand(v, "an integer's `from` converts an integer", vt)
            }
        }
        let spelling = if truncating { "from(truncating:)" } else { "from" }
        self.record_builtin(e, -1, TcRole.Conversion, spelling)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.owner = t
        self.calls[at] = c
        if truncating {
            return self.set_type(e, t, false)
        }
        let opt = self.mk_optional(t)
        self.set_type(e, opt, false)
    }

    // `E.from(raw: x)`: a raw-backed enum's case for a backing value, or
    // `None` (design 145); the member table holds it as synthesized.
    func raw_from(&var self, e: Int, d: Int, t: Int, args: &TcArgs) -> Int {
        let raw_name = self.res.intern("raw")
        let backing = self.sigs[d].result
        if args.values.len() != 1 {
            self.refuse(e, "call.arity", "`from(raw:)` takes one argument")
            self.type_args_alone(&args)
        } else {
            if args.labels[0] != raw_name {
                self.refuse(args.values[0], "call.label", "`from` of a raw-backed enum takes `raw:`")
            }
            self.check_argument(args.values[0], backing)
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, d, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.spelling = self.res.intern("from(raw:)")
        self.calls[at] = c
        let opt = self.mk_optional(t)
        self.set_type(e, opt, false)
    }

    // `UnsafeMutableInterior(v)` and `Atomic(v)`: the cell, or the atomic word
    // over one, built from one value, bare or labeled `value:` (design 186;
    // SL:open-questions D38). The cell is layout-transparent, so each is a
    // conversion of `v` at the wrapper's type. The payload's type is the
    // wanted wrapper's argument when one is wanted, else `v`'s own.
    func cell_construct(&var self, e: Int, d: Int, args: &TcArgs, want: Int) -> Int {
        let value_name = self.res.intern("value")
        if args.values.len() != 1 || (args.labels[0] >= 0 && args.labels[0] != value_name) {
            self.refuse(e, "call.arity", "a cell is constructed from one value, written bare or as `value:`")
            self.type_args_alone(&args)
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        let v = args.values[0]
        var payload = -1
        if want >= 0 && self.is_nominal_of(want, d) && self.nominal_args(want).len() == 1 {
            payload = self.arg_of(want, 0)
        }
        if payload >= 0 {
            self.check_argument(v, payload)
        } else {
            let _ = self.expr(v, TC_WANT_NONE)
            // Read through a reference before the copy check, which must see
            // the referent's tier, not the reference's.
            payload = self.read_value(v)
            self.consume(v)
        }
        if self.has_error(payload) {
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        var targs = Vector<Int>()
        try! targs.push(payload)
        let t = self.mk_nominal(d, &targs)
        let none = Vector<Int>()
        let _ = self.record_call(e, d, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        // Stage 0 workaround (SL:hazards S4): canonical: c.spelling = self.res.intern(if d == self.known.atomic { "atomic" } else { "interior" })
        let word = if d == self.known.atomic { "atomic" } else { "interior" }
        c.spelling = self.res.intern(word)
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // `Box<any Trait, A>.make(v)`, the erasing construction (spec, `any
    // Trait` existentials): `v`, of a concrete type that conforms, moved into
    // a box allocated through `A`. It is no call of std's `make`, whose
    // `Result` it does not return: the argument carries the erasure into box
    // type `t`, as an erased error's return does, and a refused allocation
    // panics, as that erasure's does.
    func erasing_make(&var self, e: Int, t: Int, args: &TcArgs) -> Int {
        let value_name = self.res.intern("value")
        if args.values.len() != 1 || (args.labels[0] >= 0 && args.labels[0] != value_name) {
            self.refuse(e, "call.arity", "`Box<any Trait>.make` takes one value, written bare or as `value:`")
            self.type_args_alone(&args)
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        let v = args.values[0]
        let _ = self.expr(v, TC_WANT_NONE)
        let from = self.read_value(v)
        self.consume(v)
        if self.has_error(from) {
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        if not self.erases_to(from, t) {
            let x = self.arg_of(t, 0)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.type_text(from))
            try! msg.append("` does not conform to `")
            let tr = self.types.ty(x).decl
            try! msg.append(self.res.decl_path(tr))
            try! msg.append("`, so it cannot be erased to `")
            try! msg.append(self.type_text(x))
            try! msg.append("`")
            self.refuse(v, "type.mismatch", msg.build())
            let bad = self.error_type
            return self.set_type(e, bad, false)
        }
        self.add_adjust(v, TcAdjustKind.Erase, t)
        self.refuse_primitive_erasure(v, from, t)
        let none = Vector<Int>()
        let box_decl = self.known.box
        let _ = self.record_call(e, box_decl, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.spelling = self.res.intern("erase")
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // `A(x)` for a distinct alias `A` over `T`: `x` becomes an `A`, which
    // reads as its `T` (design 250 names `Byte(...)` the way in).
    func alias_construct(&var self, e: Int, alias: Int, args: &TcArgs) -> Int {
        let t = self.alias_type(alias, -1)
        if args.values.len() != 1 || args.labels[0] >= 0 {
            self.refuse(e, "call.arity", "an alias is constructed from one unlabeled value of the type it names")
            self.type_args_alone(&args)
        } else {
            self.check_argument(args.values[0], t)
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, alias, TcRole.Conversion, t, &none)
        let at = self.call_at[e]
        var c = self.calls[at]
        c.spelling = self.res.intern("alias")
        self.calls[at] = c
        self.set_type(e, t, false)
    }

    // THE TYPE-HEAD FUNNEL: nominal `d` named as the head of a construction,
    // a static call or a case, with the type arguments `written` there. Its
    // three answers are distinct: the type; the error type once a written
    // list is refused; or `TC_OWNER_INFER` for a generic type written bare,
    // whose call builds its candidates owner-less so that inference solves
    // the type's parameters from the arguments and the expected type, and
    // refuses `infer.failed` where nothing determines one (SL-657).
    //
    // ENTRY POINTS:
    //     written_enum_owner
    //     init_call
    //     static_call
    func named_owner(&var self, d: Int, written: &Vector<Int>, leaf: Int) -> Int {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if written.len() == 0 {
            if s.generic_count == 0 {
                return self.self_type_of(d)
            }
            return TC_OWNER_INFER
        }
        if written.len() > s.generic_count {
            self.refuse_type_arity(leaf, d, written.len())
            return self.error_type
        }
        var args = Vector<Int>()
        var k = 0
        while k < s.generic_count {
            if k < written.len() {
                try! args.push(written[k])
            } else {
                let g = self.generics[s.generic_first + k]
                if g.default_type < 0 {
                    self.refuse_type_arity(leaf, d, written.len())
                    return self.error_type
                }
                try! args.push(g.default_type)
            }
            k = k + 1
        }
        self.mk_nominal(d, &args)
    }

    // `T(...)`: the constructions the funnel, `construction_candidates`,
    // leaves this call. A generic type takes its arguments
    // from the head, from the expected type (a construction peels it), or
    // from inference.
    func init_call(&var self, e: Int, callee: Int, b: ResBinding, args: &TcArgs, want: Int) -> Int {
        var d = -1
        if b.kind == ResBindKind.Decl && b.decl >= 0 {
            if self.is_nominal(b.decl) {
                d = b.decl
            } else {
                let info = self.res.decls[b.decl]
                if info.kind == ResDeclKind.Alias || info.kind == ResDeclKind.TypeAssign {
                    let aliased = self.alias_type(b.decl, -1)
                    d = self.nominal_decl(aliased)
                    let bare = d < 0 || self.is_primitive_decl(d)
                    if info.kind == ResDeclKind.Alias && bare && not self.has_error(aliased) {
                        return self.alias_construct(e, b.decl, &args)
                    }
                }
            }
        } else if b.kind == ResBindKind.SelfType && b.decl >= 0 && self.is_nominal(b.decl) {
            d = b.decl
        }
        let leaf = self.res.first_leaf(callee)
        if d < 0 || self.is_enum_decl(d) {
            self.type_args_alone(&args)
            if d >= 0 {
                self.refuse_not_a_value(callee, leaf)
            }
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let written = self.explicit_type_args(callee)
        let m = self.current
        // A partial prefix pins the type's leading parameters and inference
        // solves the rest (spec, Generics).
        var pinned = Vector<Int>()
        var owner = -1
        if self.partial_prefix(d, &written, m) {
            pinned = tc_copy_ints(&written)
        } else {
            owner = self.named_owner(d, &written, leaf)
            if owner == TC_OWNER_INFER {
                owner = -1
            }
        }
        if owner < 0 && pinned.len() == 0 && want >= 0 && self.is_nominal_of(want, d) {
            owner = want
        }
        if owner >= 0 && self.has_error(owner) {
            self.type_args_alone(&args)
            return self.set_type(e, owner, false)
        }
        if d >= 0 && (d == self.known.interior || d == self.known.atomic) {
            let wanted = if owner >= 0 { owner } else { want }
            return self.cell_construct(e, d, &args, wanted)
        }
        var cands = Vector<TcCand>()
        if not self.construction_candidates(e, d, owner, &args, &var cands) {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let builtin_module = self.res.builtin
        if cands.len() == 0 && self.res.decls[d].module == builtin_module {
            // `Atomic(v)`, `UnsafeMutableInterior(v)`, `UnsafeMemory<T, U>(a)`:
            // a builtin type's construction, which no declaration writes.
            var what = StringBuilder()
            try! what.append("constructing the builtin type `")
            try! what.append(self.res.decl_path(d))
            try! what.append("`")
            self.not_yet(e, what.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if cands.len() == 0 {
            self.type_args_alone(&args)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` has no `init` this module can call, and its fields are not all visible here")
            self.refuse(e, "call.no-match", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        self.resolve_call(e, &cands, &args, &pinned, -1, want)
    }

    // THE CONSTRUCTION FUNNEL: how the body being checked may construct
    // nominal `d`. An `init` matching a struct's fields exactly overrides its
    // memberwise construction everywhere but its own block, the one place
    // the raw construction is reached, and the memberwise construction needs
    // every field visible (SL-648). A zero-initialized static constructs too.
    //
    // ENTRY POINTS:
    //     construction_candidates
    //     zero_fault
    func construction_route(&var self, d: Int) -> TcRoute {
        if not self.is_struct_decl(d) {
            return TcRoute(override_init: -1, raw: false, hidden: -1)
        }
        let ov = self.construction_override(d)
        let raw = ov >= 0 && self.in_own_block(ov)
        let m = self.current
        let hidden = self.hidden_field(d, m)
        TcRoute(override_init: ov, raw: raw, hidden: hidden)
    }

    // The candidates construction `e` of nominal `d` may reach, into `cands`:
    // the `init`s this code sees, an override in place of the memberwise
    // construction outside its own block, and no exact match the override
    // rule refuses. False when it refused the call: one only an override this
    // code does not see could take.
    func construction_candidates(&var self, e: Int, d: Int, owner: Int, args: &TcArgs,
                                 cands: &var Vector<TcCand>) -> Bool {
        let m = self.current
        let in_test = self.current_test
        let route = self.construction_route(d)
        let ov = route.override_init
        let raw = route.raw
        var seen = false
        let inits = self.inits_of(d, m, in_test)
        var k = 0
        while k < inits.len() {
            let at = inits[k]
            k = k + 1
            let member = self.members[at]
            if not self.extension_applies(member.ext, owner) {
                continue
            }
            if member.decl == ov {
                seen = true
                if raw {
                    continue
                }
            } else if self.matches_fields(member.decl) {
                continue
            }
            self.build_decl(member.decl)
            let found = self.found_owner(at, owner)
            try! cands.push(TcCand(decl: member.decl, kind: TcCandKind.Function, member: at,
                                   owner: found))
        }
        let memberwise = TcCand(decl: d, kind: TcCandKind.Memberwise, member: -1, owner: owner)
        if ov >= 0 && not seen && not raw {
            let shape = self.bind_args(memberwise, &args)
            if shape.status == TC_BIND_OK {
                self.refuse_hidden_override(e, d, ov)
                return false
            }
        }
        if (ov < 0 || raw) && self.is_struct_decl(d) && route.hidden < 0 {
            try! cands.push(memberwise)
        }
        true
    }

    // Every zero-initialized value the program writes, after every body is
    // typed, so a raw-backed case's value has been folded wherever its enum
    // sits: each `ZeroInit` declaration, then each static with no
    // initializer, in modules checked in full.
    func check_zero_inits(&var self) {
        let zi = self.known.zero_init
        var k = 0
        while zi >= 0 && k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            let available = self.res.modules[c.module].available
            let checked = available && not self.is_interface(c.module) && self.policy_in_place(k - 1)
            if c.trait_decl == zi && c.type_decl >= 0 && checked {
                let saved = self.save_context()
                self.enter_decl(c.ext)
                self.check_zero_init_declaration(k - 1)
                self.restore_context(saved)
            }
        }
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            m = m + 1
            if not info.available || info.interface_only {
                continue
            }
            var d = info.decl_first
            while d < info.decl_first + info.decl_count {
                let decl = self.res.decls[d]
                if decl.kind == ResDeclKind.Static && decl.node >= 0 && self.static_initializer(d) < 0 {
                    let saved = self.save_context()
                    self.enter_decl(d)
                    self.check_zero_static(d)
                    self.restore_context(saved)
                }
                d = d + 1
            }
        }
    }

    // Static `d`, which has no initializer: its all-zero value is a
    // construction, legal where this module could build it field by field or
    // a `ZeroInit` declaration vouches for it (SL-660).
    func check_zero_static(&var self, d: Int) {
        let t = self.sigs[d].result
        if t < 0 || self.has_error(t) {
            return
        }
        var walked = Vector<Int>()
        let z = self.zero_fault(t, -1, &var walked)
        if z.fault == TcZeroFault.Valid {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` has no initializer, so its all-zero value builds a `")
        try! msg.append(self.type_text(z.ty))
        let site = self.decl_site(d)
        match z.fault {
            case Override -> {
                try! msg.append("` that `")
                try! msg.append(self.overload_text(z.decl))
                try! msg.append("`, which overrides its construction, never checked; a static's initializer cannot call it either, so hold the value somewhere an `init` builds it")
                self.refuse(site, "static.zero-init", msg.build())
            },
            case Hidden -> {
                try! msg.append("` field by field, and this module cannot see its field `")
                let field_name = self.res.decls[z.decl].name
                try! msg.append(self.name_text(field_name))
                try! msg.append("`: only code that sees every field may make that construction. Give the static an initializer, or, if zero is a valid `")
                try! msg.append(self.type_text(z.ty))
                try! msg.append("`, its own module may declare `ZeroInit` for it")
                self.refuse(site, "static.zero-hidden", msg.build())
            },
            case Invalid -> {
                try! msg.append("`, and ")
                let why = self.zero_invalid_reason(z.ty)
                try! msg.append(why)
                try! msg.append(": give the static an initializer")
                self.refuse(site, "static.zero-invalid", msg.build())
            },
            case Valid -> {}
        }
    }

    // The declaration-site check of `ZeroInit` conformance `at`, which the
    // caller entered: a struct with no override whose every field is valid at
    // zero, its parameters taken as the conformance's bounds give them, or an
    // enum whose zero is one of its cases (SL-660).
    func check_zero_init_declaration(&var self, at: Int) {
        let c = self.conformances[at]
        let d = c.type_decl
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` declares `ZeroInit`, ")
        if self.is_struct_decl(d) {
            let ov = self.construction_override(d)
            if ov >= 0 {
                try! msg.append("but `")
                try! msg.append(self.overload_text(ov))
                try! msg.append("` overrides its construction, and a zero value would skip that check: drop the declaration, or the override")
                self.refuse_in(c.module, c.node, "zeroinit.override", msg.build())
                return
            }
            let fields = self.struct_fields(d)
            var walked = Vector<Int>()
            var k = 0
            while k < fields.len() {
                let f = fields[k]
                k = k + 1
                self.build_decl(f)
                let written = self.sigs[f].result
                let z = self.zero_fault(written, c.ext, &var walked)
                if z.fault != TcZeroFault.Valid {
                    try! msg.append("but its field `")
                    let field_name = self.res.decls[f].name
                    try! msg.append(self.name_text(field_name))
                    try! msg.append("` has no valid zero: ")
                    let why = self.zero_fault_text(z)
                    try! msg.append(why)
                    self.refuse_in(c.module, c.node, "zeroinit.invalid", msg.build())
                    return
                }
            }
            return
        }
        if self.is_enum_decl(d) && not self.enum_zero_valid(d) {
            let self_type = self.self_type_of(d)
            try! msg.append("but ")
            let why = self.zero_invalid_reason(self_type)
            try! msg.append(why)
            self.refuse_in(c.module, c.node, "zeroinit.invalid", msg.build())
        }
    }

    // THE ZERO-INIT FUNNEL: whether the all-zero value of type `t` is one the
    // code being checked may make, or the first part that refuses it. A part
    // is valid when it is a scalar, a raw pointer, an Optional (zero is
    // `None`), an enum whose zero is a case, a cell, tuple or array of valid
    // parts, a type parameter `env_ext` or its declaration bounds by
    // `ZeroInit`, a struct declaring `ZeroInit` with its conditions met, or a
    // struct with no override whose fields this code sees and are all valid
    // (SL-660). A type `walked` holds was found valid or is being walked.
    //
    // ENTRY POINTS:
    //     check_zero_static
    //     check_zero_init_declaration
    func zero_fault(&var self, t: Int, env_ext: Int, walked: &var Vector<Int>) -> TcZero {
        if t < 0 || tc_contains(&walked, t) {
            return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
        }
        try! walked.push(t)
        let info = self.types.ty(t)
        // A reference is refused wherever a static or a field names one
        // (`type.reference-position`), so its zero is no second fault.
        if info.kind == TcKind.Error || info.kind == TcKind.Ref || info.kind == TcKind.Slice {
            return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
        }
        if info.kind == TcKind.Tuple {
            return self.zero_parts(t, env_ext, &var walked)
        }
        if info.kind == TcKind.Array {
            return self.zero_fault(info.b, env_ext, &var walked)
        }
        if info.kind == TcKind.Param && self.param_zero_init(info.decl, info.a, env_ext) {
            return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
        }
        if info.kind != TcKind.Nominal {
            return TcZero(fault: TcZeroFault.Invalid, ty: t, decl: -1)
        }
        let d = info.decl
        if d == self.known.string || d == self.known.never || d == self.known.func_pointer {
            return TcZero(fault: TcZeroFault.Invalid, ty: t, decl: -1)
        }
        if self.is_primitive_decl(d) || d == self.known.optional {
            return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
        }
        // A cell is built positionally from any module, so its payload is
        // what the zero constructs.
        if d == self.known.interior || d == self.known.atomic {
            return self.zero_parts(t, env_ext, &var walked)
        }
        if self.is_enum_decl(d) {
            if self.enum_zero_valid(d) {
                return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
            }
            return TcZero(fault: TcZeroFault.Invalid, ty: t, decl: -1)
        }
        if not self.is_struct_decl(d) {
            return TcZero(fault: TcZeroFault.Invalid, ty: t, decl: -1)
        }
        let route = self.construction_route(d)
        if route.override_init >= 0 {
            return TcZero(fault: TcZeroFault.Override, ty: t, decl: route.override_init)
        }
        let vouched = self.zero_init_vouches(t, env_ext, &var walked)
        if vouched.fault != TcZeroFault.Valid {
            return vouched
        }
        if vouched.decl >= 0 {
            return TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
        }
        if route.hidden >= 0 {
            return TcZero(fault: TcZeroFault.Hidden, ty: t, decl: route.hidden)
        }
        let sub = self.owner_subst(t)
        let fields = self.struct_fields(d)
        var k = 0
        while k < fields.len() {
            let f = fields[k]
            k = k + 1
            self.build_decl(f)
            let written = self.sigs[f].result
            let ft = self.subst(written, &sub)
            let z = self.zero_fault(ft, env_ext, &var walked)
            if z.fault != TcZeroFault.Valid {
                return z
            }
        }
        TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
    }

    // `zero_fault` over each argument of `t`, the first fault.
    func zero_parts(&var self, t: Int, env_ext: Int, walked: &var Vector<Int>) -> TcZero {
        let info = self.types.ty(t)
        var k = 0
        while k < info.count {
            let part = self.types.arg(t, k)
            k = k + 1
            let z = self.zero_fault(part, env_ext, &var walked)
            if z.fault != TcZeroFault.Valid {
                return z
            }
        }
        TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
    }

    // Whether a `ZeroInit` conformance the code being checked may use vouches
    // for struct type `t`: valid with `decl` 0 when one does, valid with
    // `decl` -1 when none applies, and the first fault of a `ZeroInit`
    // condition's argument when that is what stops one. A condition of
    // another trait is met as any bound is.
    func zero_init_vouches(&var self, t: Int, env_ext: Int, walked: &var Vector<Int>) -> TcZero {
        let zi = self.known.zero_init
        let info = self.types.ty(t)
        let viewer = self.current
        let in_test = self.current_test
        var k = 0
        while zi >= 0 && k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl != info.decl || c.trait_decl != zi || not self.conformance_visible(k - 1, viewer, in_test) {
                continue
            }
            self.ensure_generics(c.ext)
            let s = self.sigs[c.ext]
            var met = true
            var j = 0
            while met && j < s.generic_count && j < info.count {
                let g = self.generics[s.generic_first + j]
                let arg = self.types.arg(t, j)
                j = j + 1
                var b = 0
                while met && b < g.bound_count {
                    let bound = self.traits[g.bound_first + b]
                    b = b + 1
                    if bound == zi {
                        let z = self.zero_fault(arg, env_ext, &var walked)
                        if z.fault != TcZeroFault.Valid {
                            return z
                        }
                    } else if not self.satisfies(arg, bound, -1, env_ext, viewer, in_test) {
                        met = false
                    }
                }
            }
            if met {
                return TcZero(fault: TcZeroFault.Valid, ty: t, decl: 0)
            }
        }
        TcZero(fault: TcZeroFault.Valid, ty: t, decl: -1)
    }

    // Whether parameter `index` of `owner` is bound by `ZeroInit`: by its
    // declaration, or by extension `env_ext` of `owner`.
    func param_zero_init(&var self, owner: Int, index: Int, env_ext: Int) -> Bool {
        let zi = self.known.zero_init
        if zi < 0 {
            return false
        }
        if self.generic_grants(owner, index, zi) {
            return true
        }
        env_ext >= 0 && self.ext_target(env_ext) == owner && self.generic_grants(env_ext, index, zi)
    }

    // Whether enum `d`'s all-zero value is one of its cases: the first case
    // of a payload-free enum, or the case whose raw value is 0.
    func enum_zero_valid(&var self, d: Int) -> Bool {
        let backing = self.sigs[d].result
        let raw = backing >= 0 && self.is_integer(backing)
        let members = self.members_of(d)
        var cases = 0
        var k = 0
        while k < members.len() {
            let c = members[k]
            k = k + 1
            if self.res.decls[c].kind != ResDeclKind.Case {
                continue
            }
            cases = cases + 1
            self.build_decl(c)
            if self.sigs[c].param_count > 0 {
                return false
            }
            if raw {
                let node = self.raw_value_node(c)
                if node >= 0 {
                    let v = self.fold_constant(node)
                    if v.ok && v.bits == 0 {
                        return true
                    }
                }
            }
        }
        not raw && cases > 0
    }

    // What a fault of the zero-init walk says, for a refusal's message.
    func zero_fault_text(&var self, z: TcZero) -> String {
        var out = StringBuilder()
        match z.fault {
            case Override -> {
                try! out.append("it builds a `")
                try! out.append(self.type_text(z.ty))
                try! out.append("` that `")
                try! out.append(self.overload_text(z.decl))
                try! out.append("`, which overrides its construction, never checked")
            },
            case Hidden -> {
                try! out.append("it builds a `")
                try! out.append(self.type_text(z.ty))
                try! out.append("` whose field `")
                let field_name = self.res.decls[z.decl].name
                try! out.append(self.name_text(field_name))
                try! out.append("` this module cannot see, and `")
                try! out.append(self.type_text(z.ty))
                try! out.append("` does not declare `ZeroInit`")
            },
            case Invalid -> {
                let why = self.zero_invalid_reason(z.ty)
                try! out.append(why)
            },
            case Valid -> {}
        }
        out.build()
    }

    // Why all-zero is not a valid value of `t`, a part the walk refused.
    func zero_invalid_reason(&var self, t: Int) -> String {
        var out = StringBuilder()
        let info = self.types.ty(t)
        try! out.append("`")
        try! out.append(self.type_text(t))
        if info.kind == TcKind.Param {
            try! out.append("` is a type parameter that is not bound by `ZeroInit`")
            return out.build()
        }
        if info.kind != TcKind.Nominal {
            try! out.append("` has no all-zero value")
            return out.build()
        }
        let d = info.decl
        if d == self.known.string {
            try! out.append("` owns its bytes, so all-zero is not a valid `String`")
        } else if d == self.known.never {
            try! out.append("` has no value")
        } else if d == self.known.func_pointer {
            try! out.append("` is never null: a zero one would name no function")
        } else if self.is_enum_decl(d) {
            let backing = self.sigs[d].result
            if backing >= 0 && self.is_integer(backing) {
                try! out.append("` has no case whose raw value is 0, so zero would be a value no case names")
            } else if self.enum_has_payload(d) {
                try! out.append("` has a case with a payload, so zero is not a valid value of it")
            } else {
                try! out.append("` has no case")
            }
        } else {
            try! out.append("` has no all-zero value")
        }
        out.build()
    }

    // Whether enum `d` has a case that carries a payload.
    func enum_has_payload(&var self, d: Int) -> Bool {
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let c = members[k]
            k = k + 1
            if self.res.decls[c].kind == ResDeclKind.Case {
                self.build_decl(c)
                if self.sigs[c].param_count > 0 {
                    return true
                }
            }
        }
        false
    }

    // Whether the body being checked is the block of function `f`, a closure
    // in it included: its parameters' defaults are not.
    func in_own_block(&self, f: Int) -> Bool {
        if self.current_decl != f || self.current_root < 0 {
            return false
        }
        let node = self.res.decls[f].node
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            if self.has_alt(c, Alt.Stmt_Block) {
                return c == self.current_root
            }
            k = k + 1
        }
        false
    }

    func refuse_hidden_override(&var self, e: Int, d: Int, ov: Int) {
        let info = self.res.decls[ov]
        var msg = StringBuilder()
        try! msg.append("this call is `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`'s construction, which `")
        try! msg.append(self.overload_text(ov))
        try! msg.append("` overrides, and that `init`, declared in module `")
        try! msg.append(self.res.module_name(info.module))
        try! msg.append("`, is not visible here: mark it `public` to make it the type's public construction, or build the value through an `init` this module sees")
        self.refuse(e, "call.no-match", msg.build())
    }

    // Whether the type arguments `written` on generic type `d`'s head are a
    // partial prefix inference completes: fewer than its parameters, a
    // parameter after them with no default, and no `init` module `viewer`
    // sees with type parameters of its own, which the prefix would mistake
    // for the type's.
    func partial_prefix(&var self, d: Int, written: &Vector<Int>, viewer: Int) -> Bool {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if written.len() == 0 || written.len() >= s.generic_count {
            return false
        }
        var undefaulted = false
        var k = written.len()
        while k < s.generic_count {
            let g = self.generics[s.generic_first + k]
            if g.default_type < 0 {
                undefaulted = true
            }
            k = k + 1
        }
        if not undefaulted {
            return false
        }
        let in_test = self.current_test
        let inits = self.inits_of(d, viewer, in_test)
        k = 0
        while k < inits.len() {
            let member = self.members[inits[k]]
            self.build_decl(member.decl)
            if self.sigs[member.decl].generic_count > 0 {
                return false
            }
            k = k + 1
        }
        true
    }

    // The first field of struct `d` that module `viewer`, test code when the
    // body being checked is, does not see, or -1.
    func hidden_field(&self, d: Int, viewer: Int) -> Int {
        let first = self.member_first[d]
        let count = self.member_count[d]
        let in_test = self.current_test
        var k = first
        while k < first + count {
            let member = self.members[k]
            if member.source == TcSource.Declared && not self.member_seen(k, viewer, in_test) {
                return member.decl
            }
            k = k + 1
        }
        return -1
    }

    // `E.Case(...)`: the case's payload. A generic enum takes its arguments
    // from its head, the expected type, or the payload.
    func case_call(&var self, e: Int, callee: Int, c: Int, args: &TcArgs, want: Int) -> Int {
        if c < 0 {
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.res.decls[c].parent
        self.ensure_generics(d)
        var owner = self.written_enum_owner(callee, d)
        if owner >= 0 {
            if self.has_error(owner) {
                self.type_args_alone(&args)
                return self.set_type(e, owner, false)
            }
        } else if self.sigs[d].generic_count == 0 {
            owner = self.self_type_of(d)
        } else {
            let peeled = self.peel(want, TcClient.Construct, -1, d)
            if peeled >= 0 {
                owner = peeled
            }
        }
        var cands = Vector<TcCand>()
        try! cands.push(TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: owner))
        let none = Vector<Int>()
        self.resolve_call(e, &cands, &args, &none, -1, want)
    }

    // `.Case(...)`: a case of the enum its position expects.
    func implicit_case_call(&var self, e: Int, callee: Int, name: Int, args: &TcArgs, want: Int) -> Int {
        if want >= 0 && self.has_error(want) {
            self.type_args_alone(&args)
            return self.set_type(e, want, false)
        }
        if want < 0 {
            self.refuse_implicit_without_type(callee, name)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let d = self.nominal_decl(want)
        let c = self.case_named(d, name)
        if c < 0 {
            self.refuse_no_such_case(callee, name, want)
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var cands = Vector<TcCand>()
        try! cands.push(TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: want))
        let none = Vector<Int>()
        self.resolve_call(e, &cands, &args, &none, -1, want)
    }

    // A function value's call: positional arguments against its type.
    func value_call(&var self, e: Int, callee: Int, args: &TcArgs) -> Int {
        let _ = self.expr(callee, TC_WANT_NONE)
        self.set_use(callee, TcUse.Borrow)
        let t = self.through_refs(callee)
        self.call_function_value(e, callee, t, &args)
    }

    // The call of `callee`, a value of type `t` already typed: its
    // arguments by position against the function type's parameters.
    func call_function_value(&var self, e: Int, callee: Int, t: Int, args: &TcArgs) -> Int {
        let fp = self.known.func_pointer
        if fp >= 0 && self.is_nominal_of(t, fp) {
            self.not_yet(e, "calling a `FuncPointer`")
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        if self.has_error(t) {
            self.type_args_alone(&args)
            return self.set_type(e, t, false)
        }
        if self.kind_of(t) != TcKind.Func {
            self.type_args_alone(&args)
            var msg = StringBuilder()
            try! msg.append("this is called, and it is a `")
            try! msg.append(self.type_text(t))
            try! msg.append("`, not a function")
            self.refuse(callee, "call.not-callable", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let info = self.types.ty(t)
        var k = 0
        while k < args.values.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label",
                            "a function value's parameters have no labels; pass this argument by position")
            }
            if k < info.count {
                let p = self.types.arg(t, k)
                self.check_argument(args.values[k], p)
                let says = self.says_escaping(p)
                self.check_escaping_argument(args.values[k], p, says)
            } else {
                let _ = self.expr(args.values[k], TC_WANT_NONE)
                self.consume(args.values[k])
            }
            k = k + 1
        }
        if args.values.len() != info.count {
            var msg = StringBuilder()
            try! msg.append("this function value takes ")
            try! msg.append(info.count)
            try! msg.append(" arguments, and ")
            try! msg.append(args.values.len())
            try! msg.append(" are passed")
            self.refuse(e, "call.arity", msg.build())
        }
        let none = Vector<Int>()
        let _ = self.record_call(e, -1, TcRole.Value, t, &none)
        self.set_type(e, info.b, false)
    }

    // Types every argument with no expectation, where the call itself could
    // not be resolved, so each still has a type.
    func type_args_alone(&var self, args: &TcArgs) {
        var k = 0
        while k < args.values.len() {
            let v = args.values[k]
            if not self.is_typed(v) {
                let poisoned = self.error_type
                let _ = self.expr(v, poisoned)
            }
            self.consume(v)
            k = k + 1
        }
    }
}

// Candidates' parameters.
extension TcProgram {
    public func cand_param_count(&self, c: TcCand) -> Int {
        match c.kind {
            case Function -> self.sigs[c.decl].param_count,
            case Memberwise -> self.struct_fields(c.decl).len(),
            case Case -> {
                if self.res.decls[c.decl].node < 0 {
                    if self.case_has_payload(c.decl) {
                        return 1
                    }
                    return 0
                }
                self.sigs[c.decl].param_count
            }
        }
    }

    // A struct's fields, in declaration order.
    func struct_fields(&self, d: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let f = members[k]
            let info = self.res.decls[f]
            if info.kind == ResDeclKind.Field {
                try! out.push(f)
            }
            k = k + 1
        }
        move out
    }

    // The name of candidate `c`'s parameter `k`.
    public func cand_param_name(&var self, c: TcCand, k: Int) -> Int {
        match c.kind {
            case Function -> self.params[self.sigs[c.decl].param_first + k].name,
            case Memberwise -> {
                let fields = self.struct_fields(c.decl)
                self.res.decls[fields[k]].name
            },
            case Case -> {
                let info = self.res.decls[c.decl]
                if info.node < 0 {
                    let err_name = self.res.intern("Err")
                    if info.name == err_name && info.parent == self.known.result {
                        return self.res.intern("error")
                    }
                    return self.res.intern("value")
                }
                self.params[self.sigs[c.decl].param_first + k].name
            }
        }
    }

    // The type of candidate `c`'s parameter `k`, as its declaration writes
    // it.
    public func cand_param_type(&var self, c: TcCand, k: Int) -> Int {
        match c.kind {
            case Function -> self.params[self.sigs[c.decl].param_first + k].ty,
            case Memberwise -> {
                let fields = self.struct_fields(c.decl)
                self.build_decl(fields[k])
                self.sigs[fields[k]].result
            },
            case Case -> {
                let info = self.res.decls[c.decl]
                if info.node < 0 {
                    let err_name = self.res.intern("Err")
                    let index = if info.name == err_name { 1 } else { 0 }
                    return self.mk_param(info.parent, index)
                }
                self.params[self.sigs[c.decl].param_first + k].ty
            }
        }
    }

    public func cand_param_default(&self, c: TcCand, k: Int) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let s = self.sigs[c.decl]
        let param = self.params[s.param_first + k]
        param.has_default
    }

    // Whether candidate `c` is a C variadic extern, `(..., ...)`.
    func cand_variadic(&self, c: TcCand) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let s = self.sigs[c.decl]
        (s.flags & TC_FLAG_VARIADIC) != 0
    }

    // Whether candidate `c`'s arguments bind in order (a function's), or by
    // name in any order (an `init`'s, a construction's, a payload's; design
    // 66).
    public func cand_ordered(&self, c: TcCand) -> Bool {
        if c.kind != TcCandKind.Function {
            return false
        }
        let info = self.res.decls[c.decl]
        info.kind != ResDeclKind.Init
    }

    // The type declaration a construction candidate builds, or -1.
    public func cand_type_decl(&self, c: TcCand) -> Int {
        match c.kind {
            case Function -> {
                let info = self.res.decls[c.decl]
                if info.kind == ResDeclKind.Init && info.parent >= 0 {
                    return self.ext_target(info.parent)
                }
                return -1
            },
            case Memberwise -> c.decl,
            case Case -> self.res.decls[c.decl].parent
        }
    }

    // The declaration whose type parameters a call of `c` infers: the
    // candidate's own, or a construction's type when its arguments are not
    // known. -1 when there is nothing to infer.
    public func cand_generic_owner(&var self, c: TcCand) -> Int {
        if c.kind == TcCandKind.Function {
            let s = self.sigs[c.decl]
            if s.generic_count > 0 {
                return c.decl
            }
        }
        let td = self.cand_type_decl(c)
        if td >= 0 && c.owner < 0 {
            self.ensure_generic_list(td)
            if self.sigs[td].generic_count > 0 {
                return td
            }
        }
        if c.kind == TcCandKind.Function && c.owner < 0 && c.member >= 0 {
            let member = self.members[c.member]
            self.ensure_generic_list(member.type_decl)
            if self.sigs[member.type_decl].generic_count > 0 {
                return member.type_decl
            }
        }
        return -1
    }

    // The substitution that instantiates candidate `c` at its owner: the
    // owner's arguments for its type's parameters, `Self`, and a trait's
    // associated types for a requirement a default or derivation fills.
    public func cand_subst(&var self, c: TcCand) -> TcSubst {
        if self.infers_static_owner(c) {
            // `Self` is the type at its own parameters, which inference solves.
            let td = self.members[c.member].type_decl
            let own = self.self_type_of(td)
            return self.member_subst(c.member, own)
        }
        if c.owner < 0 {
            return TcSubst(self_type: -1, from_owner: -1, to_owner: -1, args_owner: -1,
                           args: Vector<Int>(), assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        if c.member >= 0 {
            return self.member_subst(c.member, c.owner)
        }
        let td = self.cand_type_decl(c)
        if td >= 0 {
            let args = self.nominal_args(c.owner)
            return TcSubst(self_type: c.owner, from_owner: -1, to_owner: -1, args_owner: td,
                           args: move args, assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        var s = TcSubst(self_type: c.owner, from_owner: -1, to_owner: -1, args_owner: -1,
                        args: Vector<Int>(), assoc_decls: Vector<Int>(),
                        assoc_types: Vector<Int>())
        if c.owner >= 0 {
            self.bound_projections(c.decl, c.owner, &var s)
        }
        move s
    }

    // The substitution that instantiates member-table entry `k` at `owner`.
    public func member_subst(&var self, k: Int, owner: Int) -> TcSubst {
        let member = self.members[k]
        if member.source == TcSource.Default || member.source == TcSource.Synthesized {
            return self.owner_subst(owner)
        }
        let info = self.types.ty(owner)
        if info.kind != TcKind.Nominal {
            return TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: -1,
                           args: Vector<Int>(), assoc_decls: Vector<Int>(),
                           assoc_types: Vector<Int>())
        }
        let args = self.nominal_args(owner)
        TcSubst(self_type: owner, from_owner: -1, to_owner: -1, args_owner: member.type_decl,
                args: move args, assoc_decls: Vector<Int>(), assoc_types: Vector<Int>())
    }

    // How `args` bind to candidate `c`'s parameters (design 66): in order,
    // a label skipping forward only over defaulted parameters; or, for a
    // construction, by name in any order with positional arguments filling
    // what is left.
    public func bind_args(&var self, c: TcCand, args: &TcArgs) -> TcBind {
        let count = self.cand_param_count(c)
        var arg_param = Vector<Int>()
        var bound = Vector<Bool>()
        var k = 0
        while k < count {
            try! bound.push(false)
            k = k + 1
        }
        k = 0
        while k < args.values.len() {
            try! arg_param.push(-1)
            k = k + 1
        }
        let ordered = self.cand_ordered(c)
        if not ordered {
            k = 0
            while k < args.values.len() {
                let label = args.labels[k]
                if label >= 0 {
                    var p = 0
                    var found = -1
                    while p < count {
                        if self.cand_param_name(c, p) == label {
                            found = p
                        }
                        p = p + 1
                    }
                    if found < 0 {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_UNKNOWN_LABEL, detail: k)
                    }
                    if bound[found] {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_REPEATED, detail: k)
                    }
                    bound[found] = true
                    arg_param[k] = found
                }
                k = k + 1
            }
        }
        var cursor = 0
        k = 0
        while k < args.values.len() {
            let label = args.labels[k]
            if label < 0 {
                while cursor < count && bound[cursor] {
                    cursor = cursor + 1
                }
                if cursor >= count {
                    // A C variadic extern takes the rest untyped by any
                    // parameter.
                    if self.cand_variadic(c) {
                        k = k + 1
                        continue
                    }
                    return TcBind(arg_param: move arg_param, status: TC_BIND_TOO_MANY, detail: k)
                }
                arg_param[k] = cursor
                bound[cursor] = true
                cursor = cursor + 1
            } else if ordered {
                var found = -1
                var p = cursor
                while p < count && found < 0 {
                    if self.cand_param_name(c, p) == label {
                        found = p
                    }
                    p = p + 1
                }
                if found < 0 {
                    p = 0
                    while p < cursor {
                        if self.cand_param_name(c, p) == label {
                            return TcBind(arg_param: move arg_param, status: TC_BIND_BACKWARD,
                                          detail: k)
                        }
                        p = p + 1
                    }
                    return TcBind(arg_param: move arg_param, status: TC_BIND_UNKNOWN_LABEL, detail: k)
                }
                p = cursor
                while p < found {
                    if not bound[p] && not self.cand_param_default(c, p) {
                        return TcBind(arg_param: move arg_param, status: TC_BIND_MISSING, detail: p)
                    }
                    p = p + 1
                }
                arg_param[k] = found
                bound[found] = true
                cursor = found + 1
            }
            k = k + 1
        }
        k = 0
        while k < count {
            if not bound[k] && not self.cand_param_default(c, k) {
                return TcBind(arg_param: move arg_param, status: TC_BIND_MISSING, detail: k)
            }
            k = k + 1
        }
        TcBind(arg_param: move arg_param, status: TC_BIND_OK, detail: -1)
    }
}

// The overload filter, and the checking of the candidate it picks.
extension TcProgram {
    // Resolves call `e` among `cands` and checks it: the overload filter
    // picks a candidate, inference instantiates it, each argument goes
    // through the funnel, and the call is recorded. `receiver` is the
    // receiver's node for a method, else -1. Returns the call's type.
    func resolve_call(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs,
                      explicit: &Vector<Int>, receiver: Int, want: Int) -> Int {
        self.chosen_twin = -1
        let chosen = self.filter_candidates(e, &cands, &args)
        let twin = self.chosen_twin
        if chosen < 0 {
            if receiver >= 0 {
                self.set_use(receiver, TcUse.Borrow)
            }
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let c = cands[chosen]
        if c.kind == TcCandKind.Function && self.names_unreadable_type(c.decl) {
            self.refuse_unreadable(e, c.decl)
            if receiver >= 0 {
                self.set_use(receiver, TcUse.Borrow)
            }
            self.type_args_alone(&args)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        let bind = self.bind_args(c, &args)
        let solve = self.check_candidate(e, c, &args, &bind, &explicit, want)
        let t = self.finish_call(e, c, &solve, receiver)
        let at = self.call_at[e]
        if at >= 0 {
            self.record_binding(at, c, &bind)
        }
        if twin >= 0 && at >= 0 {
            var record = self.calls[at]
            record.twin = twin
            self.calls[at] = record
        }
        t
    }

    // Records on call record `at` how its written arguments bind candidate
    // `c`'s parameters: per parameter, the argument that binds it or its
    // default, and where a C variadic tail begins.
    func record_binding(&var self, at: Int, c: TcCand, bind: &TcBind) {
        let count = self.cand_param_count(c)
        let first = self.binds.len()
        var j = 0
        while j < count {
            try! self.binds.push(TC_BIND_DEFAULT)
            j = j + 1
        }
        var variadic = -1
        var k = 0
        while k < bind.arg_param.len() {
            let p = bind.arg_param[k]
            if p >= 0 {
                self.binds[first + p] = k
            } else if variadic < 0 {
                variadic = k
            }
            k = k + 1
        }
        var record = self.calls[at]
        record.bind_first = first
        record.bind_count = count
        record.variadic_from = variadic
        self.calls[at] = record
    }

    // Whether interface function `d`'s signature names a type it could not
    // form, which a std module the parser refuses would have declared.
    func names_unreadable_type(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if not self.is_interface(info.module) {
            return false
        }
        let s = self.sigs[d]
        if self.has_error(s.result) {
            return true
        }
        var k = 0
        while k < s.param_count {
            let p = self.params[s.param_first + k]
            if self.has_error(p.ty) {
                return true
            }
            k = k + 1
        }
        false
    }

    // A call of an interface function whose signature names a type from a
    // std module the parser refuses: outside the slice until that module
    // reads, and refused at the use so nothing downstream is mis-typed.
    func refuse_unreadable(&var self, e: Int, d: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("`'s signature names `")
        try! msg.append(self.unformed_type_text(d))
        try! msg.append("` from ")
        try! msg.append(self.unavailable_std_text())
        try! msg.append(", a module the parser refuses, so this call is not in the bootstrap slice yet")
        self.refuse(e, "slice.not-yet", msg.build())
        try! self.skipped.push(e)
    }

    // The spelling of the first type position in declaration `d`'s signature
    // that could not be formed.
    func unformed_type_text(&self, d: Int) -> String {
        let info = self.res.decls[d]
        var stack = Vector<Int>()
        try! stack.push(info.node)
        var head = 0
        while head < stack.len() {
            let id = stack[head]
            head = head + 1
            if self.has_alt(id, Alt.Stmt_Block) {
                continue
            }
            let t = self.node_types[id]
            if self.has_alt(id, Alt.Type_Named) && t >= 0 && self.is_error_type(t) {
                let path = self.child(id, 0)
                let leaf = self.res.last_leaf_of(path)
                return self.text(info.module, leaf)
            }
            let n = self.child_count(id)
            var k = 0
            while k < n {
                try! stack.push(self.child(id, k))
                k = k + 1
            }
        }
        "?"
    }

    // The std modules the program could not read, as `std.a`, `std.b`.
    func unavailable_std_text(&self) -> String {
        var out = StringBuilder()
        var none = true
        var m = 0
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if not info.available && info.kind == ResModuleKind.Std {
                if not none {
                    try! out.append(", ")
                }
                try! out.append("`")
                try! out.append(self.res.module_name(m))
                try! out.append("`")
                none = false
            }
            m = m + 1
        }
        if none {
            return "a std module"
        }
        out.build()
    }

    // The overload filter (SL:architecture §3.4, "Overloads"): the one place
    // a call's candidates are narrowed, by labels and arity, then by the
    // arguments' types. An argument that types itself is typed once, first;
    // one that takes its type from its position fits by its shape, so an
    // implicit member fits any enum with that case. A concrete candidate
    // beats a generic one, and among the rest a unique best wins; otherwise
    // the call is refused naming every candidate. Returns the index chosen,
    // or -1 once refused.
    func filter_candidates(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs) -> Int {
        let n = cands.len()
        var survivors = Vector<Int>()
        var first_status = TC_BIND_OK
        var first_detail = -1
        var k = 0
        while k < n {
            let bind = self.bind_args(cands[k], &args)
            if bind.status == TC_BIND_OK {
                try! survivors.push(k)
            } else if k == 0 {
                first_status = bind.status
                first_detail = bind.detail
            }
            k = k + 1
        }
        if n == 1 {
            if survivors.len() == 1 {
                return 0
            }
            self.refuse_binding(e, cands[0], &args, first_status, first_detail)
            return -1
        }
        if survivors.len() == 0 {
            self.refuse_no_match(e, &cands, &args)
            return -1
        }
        if survivors.len() == 1 {
            return survivors[0]
        }
        k = 0
        while k < args.values.len() {
            let v = args.values[k]
            if not self.needs_expectation(v) && not self.is_typed(v) {
                let _ = self.expr(v, TC_WANT_NONE)
            }
            k = k + 1
        }
        var fitting = Vector<Int>()
        var scores = Vector<Int>()
        var any_concrete = false
        k = 0
        while k < survivors.len() {
            let at = survivors[k]
            let c = cands[at]
            let bind = self.bind_args(c, &args)
            let sub = self.cand_subst(c)
            let owner = self.cand_generic_owner(c)
            var all = true
            var j = 0
            var row = Vector<Int>()
            while j < args.values.len() {
                let p = bind.arg_param[j]
                var f = 1
                if p >= 0 {
                    let raw = self.cand_param_type(c, p)
                    let pt = self.subst(raw, &sub)
                    f = self.arg_fit(args.values[j], pt, owner)
                }
                if f <= 0 {
                    all = false
                }
                try! row.push(f)
                j = j + 1
            }
            if all {
                try! fitting.push(at)
                j = 0
                while j < row.len() {
                    try! scores.push(row[j])
                    j = j + 1
                }
                if owner < 0 {
                    any_concrete = true
                }
            }
            k = k + 1
        }
        if fitting.len() == 0 {
            self.refuse_no_match(e, &cands, &args)
            return -1
        }
        let width = args.values.len()
        var best = Vector<Int>()
        k = 0
        while k < fitting.len() {
            let c = cands[fitting[k]]
            let generic = self.cand_generic_owner(c) >= 0
            if not (any_concrete && generic) {
                var beaten = false
                var j = 0
                while j < fitting.len() {
                    let other = cands[fitting[j]]
                    let other_generic = self.cand_generic_owner(other) >= 0
                    if j != k && not (any_concrete && other_generic) && tc_dominates(&scores, j, k, width) {
                        beaten = true
                    }
                    j = j + 1
                }
                if not beaten {
                    try! best.push(fitting[k])
                }
            }
            k = k + 1
        }
        if best.len() == 1 {
            return best[0]
        }
        let shared = self.shared_twin(&cands, &best)
        if shared >= 0 {
            return shared
        }
        self.refuse_ambiguous(e, &cands, &best)
        return -1
    }

    // Of two tied candidates that are one accessor's shared and exclusive
    // twins, the shared one, the exclusive one kept in `chosen_twin` for a
    // use that writes (design 141); -1 for any other tie.
    func shared_twin(&var self, cands: &Vector<TcCand>, best: &Vector<Int>) -> Int {
        if best.len() != 2 {
            return -1
        }
        let a = cands[best[0]]
        let b = cands[best[1]]
        if a.kind != TcCandKind.Function || b.kind != TcCandKind.Function {
            return -1
        }
        let sa = self.sigs[a.decl]
        let sb = self.sigs[b.decl]
        if sa.param_count != sb.param_count {
            return -1
        }
        var k = 0
        while k < sa.param_count {
            let pa = self.params[sa.param_first + k]
            let pb = self.params[sb.param_first + k]
            if pa.ty != pb.ty || pa.name != pb.name {
                return -1
            }
            k = k + 1
        }
        if sa.receiver == TcReceiver.Shared && sb.receiver == TcReceiver.Exclusive {
            self.chosen_twin = b.decl
            return best[0]
        }
        if sa.receiver == TcReceiver.Exclusive && sb.receiver == TcReceiver.Shared {
            self.chosen_twin = a.decl
            return best[1]
        }
        return -1
    }

    // How well argument `v` fits a parameter of type `p`: exact 3, adopting
    // 2, converting or generic 1, not at all 0. `owner`'s parameters in `p`
    // are unknowns inference would solve.
    // An argument of type `a` against parameter type `p`: 3 exact, 1
    // converted, 0 no fit.
    func fit_score(&var self, a: Int, p: Int, allow: TcAllowance) -> Int {
        let f = self.fit(a, p, allow)
        if f == TC_FIT_EXACT {
            return 3
        }
        if f == TC_FIT_CONVERTED {
            return 1
        }
        return 0
    }

    func arg_fit(&var self, v: Int, p: Int, owner: Int) -> Int {
        let generic = owner >= 0 && self.mentions_owner(p, owner)
        if self.is_typed(v) {
            let a = self.final_type(v)
            if self.has_error(a) {
                return 1
            }
            if generic {
                var s = tc_solve(owner, 64)
                if self.unify(p, a, &var s) {
                    return 1
                }
                return 0
            }
            let allow = self.allowance(TcPosition.Argument)
            if self.reads_reference(v) {
                // A bare reference binding reads its referent's value, as
                // every by-value position does; a reference parameter it
                // fits only by its sigil, which `expect` then asks for.
                let inner = self.referent(a)
                let by_value = self.fit_score(inner, p, allow)
                if by_value > 0 {
                    return by_value
                }
                if self.fit(a, p, allow) != TC_FIT_NONE {
                    return 1
                }
                return 0
            }
            return self.fit_score(a, p, allow)
        }
        if generic {
            return 1
        }
        if self.is_constant_expr(v) {
            // Only an `Int` parameter outranks the other integer widths a
            // literal adopts; between two of those it ties, and an optional's
            // wrap ranks below both (spec, Overloading, tie-break 4).
            let peeled = self.peel(p, TcClient.Integer, -1, -1)
            if self.peeled_fits(peeled, p) {
                let i = self.int_type()
                if peeled == i && p == i {
                    return 3
                }
                if peeled == p {
                    return 2
                }
                return 1
            }
            return 0
        }
        let name = self.implicit_member_name(v)
        if name >= 0 {
            let peeled = self.peel(p, TcClient.Member, name, -1)
            if self.peeled_fits(peeled, p) {
                return 2
            }
            return 0
        }
        guard let alt = self.node_alt(v) else {
            return 1
        }
        if alt == Alt.Expr_None {
            if self.is_optional(p) {
                return 2
            }
            if self.is_result(p) {
                let ok = self.arg_of(p, 0)
                if self.is_optional(ok) {
                    return 2
                }
            }
            return 0
        }
        if alt == Alt.Expr_Float {
            let peeled = self.peel(p, TcClient.Floating, -1, -1)
            if self.peeled_fits(peeled, p) {
                return 2
            }
            return 0
        }
        if alt == Alt.Expr_Closure {
            var w = p
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func && self.peeled_fits(w, p) {
                return 2
            }
            return 0
        }
        1
    }

    // Whether a value of the peeled type `peeled` reaches parameter type `p`
    // within an argument's wraps.
    func peeled_fits(&var self, peeled: Int, p: Int) -> Bool {
        if peeled < 0 {
            return false
        }
        let allow = self.allowance(TcPosition.Argument)
        peeled == p || self.fit(peeled, p, allow) > TC_FIT_NONE
    }

    // Whether `t` mentions a parameter of declaration `owner`.
    func mentions_owner(&self, t: Int, owner: Int) -> Bool {
        var seen = TcMemo.empty()
        self.mentions_owner_in(t, owner, &var seen)
    }

    // One part of `mentions_owner`. The walk stops at the first such
    // parameter, so a branching part it has seen mentions none.
    func mentions_owner_in(&self, t: Int, owner: Int, seen: &var TcMemo) -> Bool {
        let info = self.types.ty(t)
        if (info.holds & TC_HOLDS_PARAM) == 0 {
            return false
        }
        if info.kind == TcKind.Param && info.decl == owner {
            return true
        }
        if self.types.branches(t) && not seen.mark(t, 0) {
            return false
        }
        if tc_kind_wraps(info.kind) && info.b >= 0 && self.mentions_owner_in(info.b, owner, &var seen) {
            return true
        }
        var k = 0
        while k < info.count {
            let a = self.types.arg(t, k)
            if self.mentions_owner_in(a, owner, &var seen) {
                return true
            }
            k = k + 1
        }
        false
    }

    // Checks the arguments of the chosen candidate `c` and solves its type
    // parameters: local unification over the arguments with the later-
    // argument fixpoint (designs 93 and 105). An argument whose parameter is
    // known goes through the funnel at once; one that types itself is typed
    // and unified; the rest wait for what the others solve, and a literal
    // left over takes its own default. A static on a generic type written
    // bare first takes what `want` fixes through its result, as a
    // construction takes its slot. Returns the solutions.
    func check_candidate(&var self, e: Int, c: TcCand, args: &TcArgs, bind: &TcBind,
                         explicit: &Vector<Int>, want: Int) -> TcSolve {
        let owner = self.cand_generic_owner(c)
        var count = 0
        if owner >= 0 {
            self.ensure_generics(owner)
            count = self.sigs[owner].generic_count
        }
        var solve = tc_solve(owner, count)
        if explicit.len() > 0 {
            // A construction's head pins its type's leading parameters.
            let pins_type = c.owner < 0 && owner >= 0 && owner == self.cand_type_decl(c)
            if owner < 0 || explicit.len() > count || (owner != c.decl && not pins_type) {
                self.refuse(e, "type.arity",
                            "this call writes type arguments, and what it calls takes fewer")
            } else {
                var k = 0
                while k < explicit.len() {
                    solve.sol[k] = explicit[k]
                    k = k + 1
                }
            }
        }
        let sub = self.cand_subst(c)
        if want >= 0 && owner >= 0 && self.infers_static_owner(c) {
            self.solve_from_slot(c, want, &sub, &var solve)
        }
        let n = args.values.len()
        var done = Vector<Bool>()
        var k = 0
        while k < n {
            // A variadic extern's extra argument has no parameter to expect.
            let extra = bind.arg_param[k] < 0
            try! done.push(extra)
            if extra {
                let v = args.values[k]
                if not self.is_typed(v) {
                    let _ = self.expr(v, TC_WANT_NONE)
                }
                self.consume(v)
            }
            k = k + 1
        }
        // Each pass first unifies every argument that types itself against a
        // parameter still unknown when the pass began, so two arguments that
        // disagree meet as a conflict; then it checks each argument whose
        // parameter is known.
        var progress = true
        while progress {
            progress = false
            var pending = Vector<Int>()
            k = 0
            while k < n {
                if not done[k] {
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if self.mentions_unsolved(pt, &solve) && not self.needs_expectation(args.values[k]) {
                        try! pending.push(k)
                    }
                }
                k = k + 1
            }
            k = 0
            while k < pending.len() {
                let at = pending[k]
                let v = args.values[at]
                let raw = self.cand_param_type(c, bind.arg_param[at])
                let pt = self.subst(raw, &sub)
                if not self.is_typed(v) {
                    let _ = self.expr(v, TC_WANT_NONE)
                }
                let before = self.solved_count(&solve)
                let a = self.arg_value_type(v, pt)
                let _ = self.unify(pt, a, &var solve)
                if self.solved_count(&solve) > before {
                    progress = true
                }
                k = k + 1
            }
            self.report_conflict(e, owner, &var solve)
            k = 0
            while k < n {
                if not done[k] {
                    let v = args.values[k]
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if not self.mentions_unsolved(pt, &solve) {
                        let s2 = self.solve_subst(&solve)
                        let target = self.subst(pt, &s2)
                        self.check_call_argument(c, v, target, raw, bind.arg_param[k])
                        done[k] = true
                        progress = true
                    }
                }
                k = k + 1
            }
        }
        // What is left takes its type from its position. A literal or a
        // closure types itself when nothing solved its parameter, and what it
        // solves reaches the rest; `None`, an implicit member and an empty
        // collection wait for that, and are typed alone only at the end.
        var changed = true
        while changed {
            changed = false
            k = 0
            while k < n {
                if not done[k] {
                    let v = args.values[k]
                    let raw = self.cand_param_type(c, bind.arg_param[k])
                    let pt = self.subst(raw, &sub)
                    if not self.mentions_unsolved(pt, &solve) {
                        let s2 = self.solve_subst(&solve)
                        let target = self.subst(pt, &s2)
                        self.check_call_argument(c, v, target, raw, bind.arg_param[k])
                        done[k] = true
                        changed = true
                    } else if not self.is_typed(v) && self.types_itself(v) {
                        self.type_alone(v, pt, &solve)
                        let a = self.arg_value_type(v, pt)
                        let _ = self.unify(pt, a, &var solve)
                        changed = true
                    }
                }
                k = k + 1
            }
        }
        k = 0
        while k < n {
            if not done[k] {
                let v = args.values[k]
                let raw = self.cand_param_type(c, bind.arg_param[k])
                let pt = self.subst(raw, &sub)
                if not self.is_typed(v) {
                    self.type_alone(v, pt, &solve)
                }
                let a = self.arg_value_type(v, pt)
                let _ = self.unify(pt, a, &var solve)
            }
            k = k + 1
        }
        let defaults = self.generic_defaults(c, &bind)
        self.infer_from_defaults(c, &defaults, &sub, &var solve)
        self.settle_solutions(e, owner, &var solve)
        k = 0
        while k < n {
            if not done[k] {
                let v = args.values[k]
                let raw = self.cand_param_type(c, bind.arg_param[k])
                let pt = self.subst(raw, &sub)
                let s2 = self.solve_subst(&solve)
                let target = self.subst(pt, &s2)
                self.check_call_argument(c, v, target, raw, bind.arg_param[k])
            }
            k = k + 1
        }
        self.check_used_defaults(e, c, &defaults, &sub, &solve)
        move solve
    }

    // Pins what expected type `slot` fixes of candidate `c`'s parameters by
    // unifying `c`'s result with the slot or with a layer the slot
    // auto-wraps, an Optional's payload or a Result's `Ok`. A slot the result
    // does not match fixes nothing, and the call's arguments are then the
    // only source.
    func solve_from_slot(&var self, c: TcCand, slot: Int, sub: &TcSubst, solve: &var TcSolve) {
        let raw = self.sigs[c.decl].result
        let result = self.subst(raw, &sub)
        var w = slot
        while w >= 0 && not self.has_error(w) {
            var trial = tc_solve(solve.owner, solve.sol.len())
            if self.unify(result, w, &var trial) && trial.conflict_index < 0 && self.solved_count(&trial) > 0 {
                var k = 0
                while k < trial.sol.len() {
                    if solve.sol[k] < 0 && trial.sol[k] >= 0 {
                        solve.sol[k] = trial.sol[k]
                    }
                    k = k + 1
                }
                return
            }
            if self.is_optional(w) || self.is_result(w) {
                w = self.arg_of(w, 0)
            } else {
                return
            }
        }
    }

    // A default value whose parameter's type is a type parameter `t`: a
    // literal or `None`, each typed `t`. A bare integer literal and a
    // constant chain adopt `t` (`adopts_integer`), so each instantiation
    // computes the value at its own type, and `None` needs each call's `t`
    // optional. Each call checks the value against its own `t`, where the
    // literal's own type drives inference (design 108). Any other value would
    // need a typing per instantiation.
    func check_generic_default(&var self, value: Int, t: Int) {
        if self.is_none_literal(value) {
            let _ = self.set_type(value, t, false)
            self.consume(value)
            return
        }
        let own = self.default_literal_type(value)
        if own < 0 {
            self.not_yet(value, "a default value of a type parameter's type that is no literal and no `None`")
            let poisoned = self.error_type
            let _ = self.set_type(value, poisoned, false)
            return
        }
        // A literal of any other kind fits only the `t` that is its own type,
        // so it is typed `t`, as `None` is.
        let string = self.has_alt(value, Alt.Expr_String)
        let boolean = self.has_alt(value, Alt.Expr_Bool_True) || self.has_alt(value, Alt.Expr_Bool_False)
        if string || boolean || self.has_alt(value, Alt.Expr_Float) {
            if string {
                self.string_position(value, TcStringPosition.Literal)
            }
            let _ = self.set_type(value, t, false)
            self.consume(value)
            return
        }
        let outer = self.generic_default
        self.generic_default = t
        let _ = self.expr(value, t)
        self.generic_default = outer
        // A suffixed literal keeps its suffix's type, which each call
        // requires `t` to be, so it adopts `t` as a bare one does.
        let written = self.final_type(value)
        if written != t && self.is_integer(written) {
            self.add_adjust(value, TcAdjustKind.Adopt, t)
        }
        self.consume(value)
    }

    // The type a literal default has as written: `Int` for a bare integer or
    // a constant expression, a suffix's type, `Float`, `String`, `Bool`; -1
    // for any other expression.
    func default_literal_type(&var self, v: Int) -> Int {
        if v < 0 {
            return -1
        }
        if self.is_constant_expr(v) {
            return self.int_type()
        }
        if self.has_alt(v, Alt.Expr_Int) {
            let m = self.current
            let leaf = self.res.first_leaf(v)
            let text = self.text(m, leaf)
            return self.suffix_type(&text)
        }
        if self.has_alt(v, Alt.Expr_Float) {
            return self.float_type()
        }
        if self.has_alt(v, Alt.Expr_String) {
            return self.string_type()
        }
        if self.has_alt(v, Alt.Expr_Bool_True) || self.has_alt(v, Alt.Expr_Bool_False) {
            return self.bool_type()
        }
        return -1
    }

    // The default value written for parameter `index` of function `d`, or -1.
    func param_default_node(&self, d: Int, index: Int) -> Int {
        let node = self.res.decls[d].node
        if node < 0 {
            return -1
        }
        var at = 0
        let n = self.child_count(node)
        var k = 0
        while k < n {
            let c = self.child(node, k)
            k = k + 1
            let plain = self.has_alt(c, Alt.Decl_Param_Plain)
            let defaulted = self.has_alt(c, Alt.Decl_Param_Default)
            if not plain && not defaulted {
                continue
            }
            if at == index {
                if defaulted {
                    return self.res.last_node_child(c)
                }
                return -1
            }
            at = at + 1
        }
        return -1
    }

    // The parameters of candidate `c` no argument binds whose type is a type
    // parameter and whose default the call uses: design 108's defaults.
    func generic_defaults(&var self, c: TcCand, bind: &TcBind) -> Vector<Int> {
        var out = Vector<Int>()
        if c.kind != TcCandKind.Function {
            return move out
        }
        let count = self.cand_param_count(c)
        var j = 0
        while j < count {
            let raw = self.cand_param_type(c, j)
            if self.kind_of(raw) == TcKind.Param && not tc_contains(&bind.arg_param, j) {
                if self.param_default_node(c.decl, j) >= 0 {
                    try! out.push(j)
                }
            }
            j = j + 1
        }
        move out
    }

    // Unifies each used literal default's type with its parameter's, so the
    // default drives inference where nothing else does (design 108). A type
    // parameter with a written default type takes that type instead, which
    // is more specific than a literal's, and the value is checked at it.
    func infer_from_defaults(&var self, c: TcCand, params: &Vector<Int>, sub: &TcSubst, solve: &var TcSolve) {
        var k = 0
        while k < params.len() {
            let j = params[k]
            k = k + 1
            let raw = self.cand_param_type(c, j)
            let pt = self.subst(raw, &sub)
            if not self.mentions_unsolved(pt, &solve) || self.has_default_type(raw) {
                continue
            }
            let v = self.param_default_node(c.decl, j)
            let own = self.default_literal_type(v)
            if own >= 0 {
                let _ = self.unify(pt, own, &var solve)
            }
        }
    }

    // Whether `t` is a type parameter declared with a default type.
    func has_default_type(&var self, t: Int) -> Bool {
        let info = self.types.ty(t)
        if info.kind != TcKind.Param || info.decl < 0 {
            return false
        }
        self.ensure_generic_list(info.decl)
        let s = self.sigs[info.decl]
        info.a < s.generic_count && self.generics[s.generic_first + info.a].default_type >= 0
    }

    // Checks each used default against the type this call gives its
    // parameter: `None` needs an Optional, a bare integer or a constant
    // expression an integer type whose fold at it holds every literal and
    // result, and any other literal must fit.
    func check_used_defaults(&var self, e: Int, c: TcCand, params: &Vector<Int>, sub: &TcSubst, solve: &TcSolve) {
        var k = 0
        while k < params.len() {
            let j = params[k]
            k = k + 1
            let raw = self.cand_param_type(c, j)
            let pt = self.subst(raw, &sub)
            let s2 = self.solve_subst(&solve)
            let target = self.subst(pt, &s2)
            if self.has_error(target) {
                continue
            }
            let v = self.param_default_node(c.decl, j)
            var fits = false
            if self.is_none_literal(v) {
                fits = self.is_optional(target)
            } else if self.is_constant_expr(v) && self.is_integer(target) {
                let folded = self.fold_default(v, target)
                fits = folded.ok || folded.fault == TcFault.NotConstant || folded.fault == TcFault.Cycle
            } else {
                let own = self.default_literal_type(v)
                let allow = self.allowance(TcPosition.Default)
                fits = own >= 0 && self.fit(own, target, allow) > TC_FIT_NONE
            }
            if not fits {
                let first = self.sigs[c.decl].param_first
                let param = self.params[first + j]
                var msg = StringBuilder()
                try! msg.append("this call uses the default value of `")
                try! msg.append(self.name_text(param.name))
                try! msg.append("`, which does not fit `")
                try! msg.append(self.type_text(target))
                try! msg.append("`, the type this call gives it; pass the argument")
                self.refuse(e, "type.mismatch", msg.build())
            }
        }
    }

    // Types argument `v`, whose parameter type `pt` still names a type
    // argument inference has not solved, on its own: a closure takes the
    // parameters `pt` gives once every one is solved, and gives its result
    // (SL:architecture §3.4, "a closure's parameters take it").
    func type_alone(&var self, v: Int, pt: Int, solve: &TcSolve) {
        if self.has_alt(v, Alt.Expr_Closure) {
            let s2 = self.solve_subst(&solve)
            var w = self.subst(pt, &s2)
            while self.is_optional(w) {
                w = self.arg_of(w, 0)
            }
            if self.kind_of(w) == TcKind.Func {
                let info = self.types.ty(w)
                var known = true
                var k = 0
                while k < info.count {
                    let p = self.types.arg(w, k)
                    if self.mentions_unsolved(p, &solve) {
                        known = false
                    }
                    k = k + 1
                }
                if known {
                    let _ = self.closure_typed(v, w, true)
                    return
                }
            }
        }
        let _ = self.expr(v, TC_WANT_NONE)
    }

    // Whether an argument that takes its type from its position can still
    // type itself alone: a literal, a constant, a closure, a collection
    // literal with elements. `None` and an implicit member cannot.
    func types_itself(&self, v: Int) -> Bool {
        if self.implicit_member_name(v) >= 0 {
            return false
        }
        guard let alt = self.node_alt(v) else {
            return false
        }
        if alt == Alt.Expr_None || alt == Alt.Expr_Map_Empty {
            return false
        }
        if alt == Alt.Expr_Array || alt == Alt.Expr_Set || alt == Alt.Expr_Map_Entries {
            return self.res.first_node_child(v) >= 0
        }
        true
    }

    // An argument, through the funnel entry for what it fills; `raw` is the
    // parameter's declared type, before any type argument is substituted,
    // and `k` the parameter.
    func check_call_argument(&var self, c: TcCand, v: Int, target: Int, raw: Int, k: Int) {
        match c.kind {
            case Function -> {
                self.check_argument(v, target)
                let p = self.params[self.sigs[c.decl].param_first + k]
                self.check_escaping_argument(v, raw, p.escaping)
            },
            case Memberwise -> self.check_field_argument(v, target),
            case Case -> self.check_payload(v, target)
        }
    }

    // A non-escaping function value passed as an argument: legal only for a
    // parameter whose declared type is a function type that does not say
    // `escaping`. A type parameter holds its argument as storage, written or
    // inferred, as it does a reference (SL:open-questions D35).
    func check_escaping_argument(&var self, v: Int, raw: Int, escaping: Bool) {
        if not self.nonescaping_value(v) || raw < 0 || self.has_error(raw) {
            return
        }
        if self.kind_of(raw) == TcKind.Func && not escaping {
            return
        }
        if self.kind_of(raw) == TcKind.Func {
            self.refuse_escape(v, "an `escaping` parameter")
        } else {
            self.refuse_escape(v, "a type argument, which a generic holds as storage,")
        }
    }

    func solved_count(&self, s: &TcSolve) -> Int {
        var n = 0
        var k = 0
        while k < s.sol.len() {
            if s.sol[k] >= 0 {
                n = n + 1
            }
            k = k + 1
        }
        n
    }

    // What inference left unsolved takes its parameter's default, or is
    // refused naming the parameter; a solved or conflicting parameter is
    // held to its bounds (design 109).
    func settle_solutions(&var self, e: Int, owner: Int, solve: &var TcSolve) {
        if owner < 0 {
            return
        }
        self.report_conflict(e, owner, &var solve)
        let s = self.sigs[owner]
        var k = 0
        while k < solve.sol.len() {
            let g = self.generics[s.generic_first + k]
            if solve.sol[k] < 0 {
                if g.default_type >= 0 {
                    solve.sol[k] = g.default_type
                } else {
                    var msg = StringBuilder()
                    try! msg.append("cannot infer type argument `")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append("` of `")
                    try! msg.append(self.res.decl_path(owner))
                    try! msg.append("`: nothing in the call determines it; write it, as `<")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append(" = ...>` does for a type")
                    self.refuse(e, "infer.failed", msg.build())
                    solve.sol[k] = self.error_type
                }
            }
            k = k + 1
        }
        k = 0
        while k < solve.sol.len() {
            let g = self.generics[s.generic_first + k]
            let arg = solve.sol[k]
            var j = 0
            while j < g.bound_count {
                let bound = self.traits[g.bound_first + j]
                let env = self.current_decl
                let ext = self.current_ext
                let viewer = self.current
                let in_test = self.current_test
                if not self.satisfies(arg, bound, env, ext, viewer, in_test) {
                    var msg = StringBuilder()
                    try! msg.append("`")
                    try! msg.append(self.type_text(arg))
                    try! msg.append("` does not satisfy `")
                    try! msg.append(self.res.decl_path(bound))
                    try! msg.append("`, the bound on `")
                    try! msg.append(self.name_text(g.name))
                    try! msg.append("` of `")
                    try! msg.append(self.res.decl_path(owner))
                    try! msg.append("`")
                    if bound == self.known.send || bound == self.known.sync {
                        try! msg.append(self.unsendable_argument_text(e, arg))
                    }
                    self.refuse(e, "type.bound", msg.build())
                }
                j = j + 1
            }
            k = k + 1
        }
    }

    // Refuses a conflict unification found, once, and poisons the parameter
    // it concerns, so the arguments that disagree draw no second refusal.
    // Why type argument `arg` of call `e` falls short of `Send` or `Sync`
    // when a function type without `sendable` is the reason: the hint, and
    // the capture that keeps a closure written as an argument from being
    // `sendable`. "" when no function type is the reason.
    func unsendable_argument_text(&var self, e: Int, arg: Int) -> String {
        let hint = self.sendable_hint(arg)
        if hint.len() == 0 {
            return hint
        }
        var out = StringBuilder()
        try! out.append(hint)
        let callee = self.res.first_node_child(e)
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == callee || self.is_leaf(c) {
                continue
            }
            var v = c
            if self.has_alt(c, Alt.Expr_Argument_Positional) {
                v = self.res.first_node_child(c)
            } else if self.has_alt(c, Alt.Expr_Argument_Labelled) {
                v = self.res.last_node_child(c)
            }
            if not self.has_alt(v, Alt.Expr_Closure) {
                continue
            }
            let enclosing = self.current_decl
            let block = self.closure_blocker(v, enclosing)
            if block.trait_decl >= 0 {
                try! out.append("; the closure passed here is not `sendable`, since ")
                try! out.append(self.capture_block_text(&block))
                break
            }
        }
        out.build()
    }

    func report_conflict(&var self, e: Int, owner: Int, solve: &var TcSolve) {
        if owner < 0 || solve.conflict_index < 0 {
            return
        }
        let s = self.sigs[owner]
        let index = solve.conflict_index
        let g = self.generics[s.generic_first + index]
        var msg = StringBuilder()
        try! msg.append("cannot infer `")
        try! msg.append(self.name_text(g.name))
        try! msg.append("` for `")
        try! msg.append(self.res.decl_path(owner))
        try! msg.append("`: it is required to be both `")
        try! msg.append(self.type_text(solve.conflict_a))
        try! msg.append("` and `")
        try! msg.append(self.type_text(solve.conflict_b))
        try! msg.append("`")
        self.refuse(e, "infer.failed", msg.build())
        solve.sol[index] = self.error_type
        solve.conflict_index = -2
    }

    // Records the chosen call and its receiver's borrow, and returns its
    // type: the result, instantiated; for a `borrows` accessor, the place
    // it lends.
    func finish_call(&var self, e: Int, c: TcCand, solve: &TcSolve, receiver: Int) -> Int {
        let owner_decl = solve.owner
        var owner = c.owner
        var inst = Vector<Int>()
        // Solutions for the candidate's own parameters are its instantiation;
        // solutions for its type's are the type it is instantiated at.
        let own = c.kind == TcCandKind.Function && owner_decl == c.decl
        if owner_decl >= 0 && not own {
            owner = self.mk_nominal(owner_decl, &solve.sol)
        } else if owner_decl >= 0 {
            inst = tc_copy_ints(&solve.sol)
        }
        // An `init`, and a static on a type written bare, is found by its
        // type alone, often before inference solves the type's arguments, so
        // it meets its extension's bounds here (`members_for`). A specialized
        // extension's is found at the type its head names (`found_owner`).
        let found_by_type = self.res.decls[c.decl].kind == ResDeclKind.Init || self.infers_static_owner(c)
        if c.member >= 0 && found_by_type && owner >= 0 {
            self.unmet_member = c.member
            self.unmet_owner = owner
            let _ = self.refuse_unmet_member(e)
        }
        let role = self.cand_role(c)
        let _ = self.record_call(e, c.decl, role, owner, &inst)
        let sub = if owner >= 0 { self.cand_subst_at(c, owner) } else { self.cand_subst(c) }
        let s2 = self.solve_subst(&solve)
        match c.kind {
            case Memberwise -> {
                let t = if owner >= 0 { owner } else { self.self_type_of(c.decl) }
                return self.set_type(e, t, false)
            },
            case Case -> {
                let d = self.res.decls[c.decl].parent
                let t = if owner >= 0 { owner } else { self.self_type_of(d) }
                return self.set_type(e, t, false)
            },
            case Function -> {}
        }
        let sig = self.sigs[c.decl]
        let written = self.subst(sig.result, &sub)
        let result = self.subst(written, &s2)
        self.poison_if(result)
        if receiver >= 0 {
            self.receive(receiver, c, sig)
        }
        if (sig.effects & TC_EFFECT_BORROWS) != 0 {
            let lent = self.referent(result)
            if lent >= 0 && (sig.lending == TcLend.Place || sig.lending == TcLend.ConditionalPlace) {
                return self.set_type(e, lent, true)
            }
        }
        self.set_type(e, result, false)
    }

    func cand_role(&self, c: TcCand) -> TcRole {
        match c.kind {
            case Function -> TcRole.Call,
            case Memberwise -> TcRole.Memberwise,
            case Case -> TcRole.Case
        }
    }

    // `cand_subst` with the owner inference settled.
    func cand_subst_at(&var self, c: TcCand, owner: Int) -> TcSubst {
        let at = TcCand(decl: c.decl, kind: c.kind, member: c.member, owner: owner)
        self.cand_subst(at)
    }

    // A method's receiver: borrowed shared or exclusive as its signature
    // declares, or consumed by a `consumes` method. A `borrows` accessor's
    // borrow waits for its use site (`settle_places`).
    func receive(&var self, receiver: Int, c: TcCand, sig: TcSig) {
        if (sig.effects & TC_EFFECT_CONSUMES) != 0 {
            let spelled = self.has_alt(receiver, Alt.Expr_Move_Place)
            if self.expr_place[receiver] && not spelled && self.expr_use[receiver] == TcUse.Unused {
                // Both ends of a consuming call are marked: at every Copy
                // tier the transfer is spelled at the call.
                self.set_use(receiver, TcUse.Copy)
                self.refuse_bare_consume(receiver, c.decl)
                return
            }
            self.consume(receiver)
            return
        }
        if (sig.effects & TC_EFFECT_BORROWS) != 0 {
            return
        }
        let t = self.final_type(receiver)
        if sig.receiver == TcReceiver.Exclusive {
            let r = self.mk_ref(true, t)
            self.add_adjust(receiver, TcAdjustKind.BorrowVar, r)
            self.set_use(receiver, TcUse.BorrowVar)
        } else {
            let r = self.mk_ref(false, t)
            self.add_adjust(receiver, TcAdjustKind.Borrow, r)
            self.set_use(receiver, TcUse.Borrow)
        }
    }
}

// Whether row `a` of `scores` beats row `b`: no worse at any argument, and
// better at one.
public func tc_dominates(scores: &Vector<Int>, a: Int, b: Int, width: Int) -> Bool {
    var better = false
    var k = 0
    while k < width {
        let x = scores[a * width + k]
        let y = scores[b * width + k]
        if x < y {
            return false
        }
        if x > y {
            better = true
        }
        k = k + 1
    }
    better
}

// Builtin functions and subscripts.
extension TcProgram {
    // A builtin function (SL:open-questions D12): `print`, `panic` and
    // `assert` with a message, or a format string whose `{}` slots its
    // arguments fill, each borrowed (design 137); `sizeof` and `alignof`;
    // the test intrinsics, which take nothing and return Void; and the test
    // drivers (`test_drive`).
    func builtin_call(&var self, e: Int, callee: Int, d: Int, args: &TcArgs) -> Int {
        let name_id = self.res.decls[d].name
        let name = self.name_text(name_id)
        var k = 0
        while k < args.labels.len() {
            if args.labels[k] >= 0 {
                self.refuse(args.values[k], "call.label", "a builtin function's arguments take no labels")
            }
            k = k + 1
        }
        if name.equals("sizeof") || name.equals("alignof") {
            let explicit = self.explicit_type_args(callee)
            if explicit.len() != 1 {
                self.refuse(e, "type.arity", "`sizeof` and `alignof` take one type argument, as `sizeof<T>()`")
            }
            if args.values.len() > 0 {
                self.refuse(e, "call.arity", "`sizeof` and `alignof` take no arguments")
                self.type_args_alone(&args)
            }
            self.record_builtin(e, d, TcRole.Builtin, name)
            let t = self.int_type()
            return self.set_type(e, t, false)
        }
        if name.starts_with("__saw_atomic_") {
            return self.atomic_intrinsic(e, d, name, &args)
        }
        if name.equals("__saw_deinit_in_place") {
            return self.deinit_in_place(e, d, name, &args)
        }
        if res_is_test_intrinsic(name) {
            if args.values.len() > 0 {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(name)
                try! msg.append("` takes no arguments")
                self.refuse(e, "call.arity", msg.build())
                self.type_args_alone(&args)
            }
            self.record_builtin(e, d, TcRole.Builtin, name)
            let t = self.void_type()
            return self.set_type(e, t, false)
        }
        if res_is_test_driver(name) {
            return self.test_drive(e, d, name, &args)
        }
        if not (name.equals("print") || name.equals("panic") || name.equals("assert")) {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` is outside the sync-only bootstrap slice")
            self.refuse(e, "slice.not-yet", msg.build())
            try! self.skipped.push(e)
            let poisoned = self.error_type
            return self.set_type(e, poisoned, false)
        }
        var start = 0
        if name.equals("assert") {
            if args.values.len() == 0 {
                self.refuse(e, "call.arity", "`assert` takes a condition")
            } else {
                self.check_condition(args.values[0])
            }
            start = 1
        } else if args.values.len() == 0 && not name.equals("print") {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` takes a message")
            self.refuse(e, "call.arity", msg.build())
        }
        if args.values.len() > start {
            let fmt = args.values[start]
            let rest = args.values.len() - start - 1
            let slots = self.placeholder_count(fmt)
            if rest == 0 && slots == 0 {
                let _ = self.expr(fmt, TC_WANT_NONE)
                let ft = self.final_type(fmt)
                if self.has_alt(fmt, Alt.Expr_String) {
                    self.string_position(fmt, TcStringPosition.Message)
                } else if self.has_alt(fmt, Alt.Expr_Interpolation) {
                    // An interpolation builds the String the message prints,
                    // so the position stays the builder's.
                    self.string_position(fmt, TcStringPosition.Interpolation)
                } else if self.is_string(ft) {
                    self.string_position(fmt, TcStringPosition.Argument)
                } else if self.renders_through_to_string(ft) {
                    self.string_position(fmt, TcStringPosition.Rendered)
                }
                if self.is_string(ft) || self.has_error(ft) {
                    self.consume(fmt)
                } else {
                    self.check_formattable(fmt)
                    self.set_use(fmt, TcUse.Borrow)
                }
            } else {
                let literal = self.has_alt(fmt, Alt.Expr_String) || self.has_alt(fmt, Alt.Expr_Interpolation)
                let _ = self.expr(fmt, TC_WANT_NONE)
                if literal {
                    self.string_position(fmt, TcStringPosition.Format)
                }
                self.consume(fmt)
                if not literal {
                    self.refuse(fmt, "format.slot-count",
                                "a message with format arguments is a string literal whose `\{\}` slots they fill")
                } else if slots != rest {
                    var msg = StringBuilder()
                    try! msg.append("the format string has ")
                    try! msg.append(slots)
                    try! msg.append(" `\{\}` slots, and ")
                    try! msg.append(rest)
                    try! msg.append(" arguments follow it; each slot takes one argument")
                    self.refuse(fmt, "format.slot-count", msg.build())
                }
                k = start + 1
                while k < args.values.len() {
                    let v = args.values[k]
                    let _ = self.expr(v, TC_WANT_NONE)
                    self.check_formattable(v)
                    self.set_use(v, TcUse.Borrow)
                    let vt = self.final_type(v)
                    let inner = self.referent(vt)
                    if self.is_string(vt) || (inner >= 0 && self.is_string(inner)) {
                        self.string_position(v, TcStringPosition.Argument)
                    }
                    k = k + 1
                }
            }
        }
        self.record_builtin(e, d, TcRole.Builtin, name)
        if name.equals("panic") || name.equals("assert") {
            self.string_position(e, TcStringPosition.Panic)
        }
        if name.equals("panic") {
            let t = self.never_type()
            return self.set_type(e, t, false)
        }
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // Whether a message of type `t` renders through a synthesized
    // `to_string()` (design 135): a Printable value off the builtin fast
    // path, which writes the numbers and `Bool` directly.
    func renders_through_to_string(&self, t: Int) -> Bool {
        if self.has_error(t) || self.is_string(t) {
            return false
        }
        let d = self.nominal_decl(t)
        if d < 0 {
            return true
        }
        let kind = self.res.decls[d].kind
        kind != ResDeclKind.Primitive && kind != ResDeclKind.Alias
    }

    // An atomic intrinsic of the new std's builtin module (SL:open-questions
    // D23, D39), typed as Stage 0's synthesized helper of its name: an add or
    // the release subtract takes a word pointer and a delta and returns the
    // old value, a load takes a word pointer and returns the word, a store
    // takes a word pointer and the word, the compare-exchange takes a word
    // pointer, the expected word and the desired one and returns whether it
    // swapped, and the acquire fence takes nothing.
    func atomic_intrinsic(&var self, e: Int, d: Int, name: String, args: &TcArgs) -> Int {
        let fence = name.equals("__saw_atomic_fence_acquire")
        let load = name.equals("__saw_atomic_load_i64_relaxed") || name.equals("__saw_atomic_load_i64_seq_cst")
        let store = name.equals("__saw_atomic_store_i64_seq_cst")
        let exchange = name.equals("__saw_atomic_cmpxchg_i64_seq_cst")
        var wanted = 2
        if fence {
            wanted = 0
        } else if load {
            wanted = 1
        } else if exchange {
            wanted = 3
        }
        if args.values.len() != wanted {
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(name)
            try! msg.append("` takes ")
            try! msg.append(wanted)
            try! msg.append(" arguments")
            self.refuse(e, "call.arity", msg.build())
            self.type_args_alone(&args)
        } else if not fence {
            let word = self.int_type()
            var targs = Vector<Int>()
            try! targs.push(word)
            let pointer_decl = self.known.unsafe_pointer
            let pointer = self.mk_nominal(pointer_decl, &targs)
            self.check_argument(args.values[0], pointer)
            if not load {
                self.check_argument(args.values[1], word)
            }
            if exchange {
                self.check_argument(args.values[2], word)
            }
        }
        self.record_builtin(e, d, TcRole.Builtin, name)
        if fence || store {
            let t = self.void_type()
            return self.set_type(e, t, false)
        }
        if exchange {
            let t = self.bool_type()
            return self.set_type(e, t, false)
        }
        let t = self.int_type()
        self.set_type(e, t, false)
    }

    // The new std's in-place drop (SL-662): one `UnsafePointer<T>`, whose
    // pointee MIR drops where it lies, so a `NoMove` value is destroyed at
    // its home. A const pointer is refused, since destroying writes.
    func deinit_in_place(&var self, e: Int, d: Int, name: String, args: &TcArgs) -> Int {
        if args.values.len() != 1 {
            self.refuse(e, "call.arity", "`__saw_deinit_in_place` takes the pointer to the value it destroys")
            self.type_args_alone(&args)
        } else {
            let at = args.values[0]
            let _ = self.expr(at, TC_WANT_NONE)
            self.consume(at)
            let t = self.final_type(at)
            if not self.has_error(t) && self.nominal_decl(t) != self.known.unsafe_pointer {
                self.refuse_operand(at, "`__saw_deinit_in_place` destroys the pointee of an `UnsafePointer<T>`", t)
            }
        }
        self.record_builtin(e, d, TcRole.Builtin, name)
        let t = self.void_type()
        self.set_type(e, t, false)
    }

    // How many `{}` format slots string literal `e` holds.
    func placeholder_count(&self, e: Int) -> Int {
        if not self.has_alt(e, Alt.Expr_Interpolation) {
            return 0
        }
        var count = 0
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            let node = self.res.nodes[c]
            if node.shape == NodeShape.Placeholder {
                count = count + 1
            }
            k = k + 1
        }
        count
    }

    // `v[i]`: a fixed array's or a slice's builtin element place, or a call
    // of the type's `[]`. Which of the three roles it plays waits for its
    // use (`settle_places`, SL:borrowing §5).
    func subscript_expr(&var self, e: Int) -> Int {
        let base = self.res.first_node_child(e)
        var values = Vector<Int>()
        var labels = Vector<Int>()
        let m = self.current
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == base || self.is_leaf(c) {
                continue
            }
            if self.has_alt(c, Alt.Expr_Argument_Positional) {
                try! values.push(self.res.first_node_child(c))
                try! labels.push(-1)
            } else if self.has_alt(c, Alt.Expr_Argument_Labelled) {
                let leaf = self.res.first_leaf(c)
                let label = self.text(m, leaf)
                try! values.push(self.res.last_node_child(c))
                try! labels.push(self.res.intern(label))
            } else {
                try! values.push(c)
                try! labels.push(-1)
            }
        }
        let args = TcArgs(values: move values, labels: move labels)
        let _ = self.expr(base, TC_WANT_NONE)
        let rt = self.final_type(base)
        let inner = self.referent(rt)
        let t = if inner >= 0 { inner } else { rt }
        if self.has_error(t) {
            self.set_use(base, TcUse.Project)
            self.type_args_alone(&args)
            return self.set_type(e, t, true)
        }
        let info = self.types.ty(t)
        let pointer = info.kind == TcKind.Nominal && (info.decl == self.known.unsafe_pointer || info.decl == self.known.unsafe_const_pointer)
        if info.kind == TcKind.Array || info.kind == TcKind.Slice || pointer {
            if inner >= 0 {
                self.add_adjust(base, TcAdjustKind.Deref, inner)
            }
            if pointer {
                self.consume(base)
            } else {
                self.set_use(base, TcUse.Project)
            }
            let i = self.int_type()
            k = 0
            while k < args.values.len() {
                self.check_argument(args.values[k], i)
                k = k + 1
            }
            if args.values.len() != 1 {
                self.refuse(e, "call.arity", "an array's, a slice's or a raw pointer's subscript takes one index")
            }
            self.record_builtin(e, -1, TcRole.BuiltinOperator, "[]")
            let element = if pointer { self.arg_of(t, 0) } else { info.b }
            return self.set_type(e, element, true)
        }
        var cands = Vector<TcCand>()
        let name = self.res.intern("[]")
        self.method_candidates(&var cands, t, name, false)
        if cands.len() == 0 {
            self.set_use(base, TcUse.Project)
            self.type_args_alone(&args)
            if self.refuse_unmet_member(e) {
                let poisoned = self.error_type
                return self.set_type(e, poisoned, true)
            }
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(self.type_text(t))
            try! msg.append("` declares no subscript `[]`, so it has no getitem, setitem or place accessor")
            self.refuse(e, "subscript.role", msg.build())
            let poisoned = self.error_type
            return self.set_type(e, poisoned, true)
        }
        if inner >= 0 {
            self.add_adjust(base, TcAdjustKind.Deref, inner)
        }
        let none = Vector<Int>()
        let result = self.resolve_call(e, &cands, &args, &none, -1, TC_WANT_NONE)
        let at = self.call_at[e]
        if at >= 0 {
            var c = self.calls[at]
            c.role = TcRole.Getitem
            self.calls[at] = c
        } else {
            self.set_use(base, TcUse.Borrow)
        }
        self.expr_place[e] = true
        result
    }
}

// Patterns.
extension TcProgram {
    // Pattern `p` against a value of type `t` that comes from a place or a
    // temporary. Each pattern node takes the type it matches; a binding
    // copies its part out of a place, or takes it from a temporary.
    public func check_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        guard let alt = self.node_alt(p) else {
            return
        }
        self.check_pattern_as(p, alt, t, from)
    }

    func check_pattern_as(&var self, p: Int, alt: Alt, t: Int, from: TcOrigin) {
        match alt {
            case Pat_Wildcard -> self.test_pattern(p, t),
            case Pat_Literal_Int -> self.literal_pattern(p, t, 0),
            case Pat_Literal_NegativeInt -> self.literal_pattern(p, t, 0),
            case Pat_Literal_String -> self.literal_pattern(p, t, 1),
            case Pat_Literal_True -> self.literal_pattern(p, t, 2),
            case Pat_Literal_False -> self.literal_pattern(p, t, 2),
            case Pat_Range_Exclusive -> self.literal_pattern(p, t, 0),
            case Pat_Range_Inclusive -> self.literal_pattern(p, t, 0),
            case Pat_Tuple_Positional -> self.tuple_pattern(p, t, from),
            case Pat_Variant -> self.variant_pattern(p, t, from),
            case Pat_Name -> self.name_pattern(p, t, from),
            case Pat_None -> {
                self.test_pattern(p, t)
                if not self.has_error(t) && not self.is_optional(t) {
                    self.refuse_pattern(p, "`None` matches an Optional", t)
                }
            },
            case Pat_BorrowBinding_Let -> self.bind_borrow(p, t, false),
            case Pat_BorrowBinding_Var -> self.bind_borrow(p, t, true),
            case Stmt_BindingName -> self.bind_target(p, t, from),
            case _ -> {
                self.not_in_slice(p, alt)
            }
        }
    }

    // A pattern that tests its value and binds nothing.
    func test_pattern(&var self, p: Int, t: Int) {
        let _ = self.set_type(p, t, false)
        self.set_use(p, TcUse.Test)
    }

    // A literal or range pattern: an integer (0), a `String` (1), a `Bool`
    // (2).
    func literal_pattern(&var self, p: Int, t: Int, kind: Int) {
        self.test_pattern(p, t)
        if self.has_error(t) {
            return
        }
        let fits = (kind == 0 && self.is_integer(t)) || (kind == 1 && self.is_string(t)) || (kind == 2 && self.is_bool(t))
        if not fits {
            self.refuse_pattern(p, "this literal pattern does not match the value", t)
        } else if kind == 1 {
            self.string_position(p, TcStringPosition.Pattern)
        } else if kind == 0 {
            self.check_pattern_range(p, t)
        }
    }

    // An integer pattern's literals adopt the matched type whole, as a bare
    // literal adopts its slot, so one that type cannot hold is refused as
    // such a literal is.
    func check_pattern_range(&var self, p: Int, t: Int) {
        let v = self.pattern_value(p)
        if v.misfit < 0 {
            return
        }
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("integer literal ")
        if v.misfit_negated {
            try! msg.append("-")
        }
        try! msg.append(self.text(m, v.misfit))
        try! msg.append(" does not fit in `")
        try! msg.append(self.type_text(t))
        try! msg.append("` (range ")
        try! msg.append(self.int_range_text(t))
        try! msg.append(")")
        self.refuse(p, "type.mismatch", msg.build())
    }

    // `(a, b)`: a tuple of as many elements.
    func tuple_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        self.test_pattern(p, t)
        var parts = Vector<Int>()
        let n = self.child_count(p)
        var k = 0
        while k < n {
            let c = self.child(p, k)
            if not self.is_leaf(c) {
                try! parts.push(c)
            }
            k = k + 1
        }
        let info = self.types.ty(t)
        let fits = info.kind == TcKind.Tuple && info.count == parts.len()
        if not fits && not self.has_error(t) {
            self.refuse_pattern(p, "a tuple pattern of this many elements does not match the value", t)
        }
        k = 0
        while k < parts.len() {
            var et = self.error_type
            if fits {
                et = self.types.arg(t, k)
            }
            self.check_pattern(parts[k], et, from)
            k = k + 1
        }
    }

    // `Case(p, ...)`: a case of the value's enum, chosen among the
    // candidates of its name, and a pattern per payload field.
    func variant_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        self.test_pattern(p, t)
        let leaf = self.res.first_leaf(p)
        let b = self.binding_at(leaf)
        var parts = Vector<Int>()
        let n = self.child_count(p)
        var k = 0
        while k < n {
            let c = self.child(p, k)
            if not self.is_leaf(c) {
                try! parts.push(c)
            }
            k = k + 1
        }
        var c = -1
        if b.kind == ResBindKind.Cases && not self.has_error(t) {
            let d = self.nominal_decl(t)
            c = self.case_named(d, b.name)
            if c < 0 {
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.name_text(b.name))
                try! msg.append("` is no case of the matched `")
                try! msg.append(self.type_text(t))
                try! msg.append("`")
                self.refuse(p, "type.mismatch", msg.build())
            }
        } else if b.kind == ResBindKind.Decl && not self.has_error(t) {
            // An error union's arm names an error type; the union itself is
            // outside the slice, and refused where its `try` block stands.
            self.not_in_slice(p, Alt.Pat_Variant)
            return
        }
        var payload = Vector<Int>()
        if c >= 0 {
            let cand = TcCand(decl: c, kind: TcCandKind.Case, member: -1, owner: t)
            let count = self.cand_param_count(cand)
            let d = self.res.decls[c].parent
            let sub = TcSubst(owner: d, args: self.nominal_args(t))
            k = 0
            while k < count {
                let raw = self.cand_param_type(cand, k)
                try! payload.push(self.subst(raw, &sub))
                k = k + 1
            }
            if count != parts.len() {
                var msg = StringBuilder()
                try! msg.append("case `")
                try! msg.append(self.res.decl_path(c))
                try! msg.append("` carries ")
                try! msg.append(count)
                try! msg.append(" payload fields, and the pattern names ")
                try! msg.append(parts.len())
                self.refuse(p, "type.mismatch", msg.build())
            }
            let none = Vector<Int>()
            let _ = self.record_call(p, c, TcRole.Case, t, &none)
        }
        k = 0
        while k < parts.len() {
            var pt = self.error_type
            if k < payload.len() {
                pt = payload[k]
            }
            self.check_pattern(parts[k], pt, from)
            k = k + 1
        }
    }

    // A lone name: a binding, or, when resolve took it for a case (SL:open-
    // questions D13), a payload-free case of the value's enum. A candidate
    // set with none in that enum is refused, naming the case it was taken
    // for, since the name neither binds nor matches.
    func name_pattern(&var self, p: Int, t: Int, from: TcOrigin) {
        let leaf = self.res.first_leaf(p)
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Cases {
            self.test_pattern(p, t)
            if self.has_error(t) {
                return
            }
            let d = self.nominal_decl(t)
            let c = self.case_named(d, b.name)
            if c >= 0 {
                if self.case_has_payload(c) {
                    var msg = StringBuilder()
                    try! msg.append("case `")
                    try! msg.append(self.res.decl_path(c))
                    try! msg.append("` carries a payload; match it as `")
                    try! msg.append(self.name_text(b.name))
                    try! msg.append("(...)`")
                    self.refuse(p, "type.mismatch", msg.build())
                }
                let none = Vector<Int>()
                let _ = self.record_call(p, c, TcRole.Case, t, &none)
                return
            }
            self.refuse_case_mismatch(p, b.name, t)
            return
        }
        self.bind_part(p, leaf, t, from)
    }

    // D13's refusal: the payload-free cases named `name` in the module's
    // import closure, none of which is a case of `t`.
    func refuse_case_mismatch(&var self, p: Int, name: Int, t: Int) {
        let m = self.current
        var names = Vector<String>()
        var at = self.res.cases.first(0, name)
        while at >= 0 {
            let c = self.res.cases.value(at)
            let info = self.res.decls[c]
            if self.res.in_closure(m, info.module) && not info.flag {
                try! names.push(self.res.decl_identity(c))
            }
            at = self.res.cases.following(at)
        }
        let text = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(text)
        try! msg.append("` names no case of the matched `")
        try! msg.append(self.type_text(t))
        try! msg.append("`: it is taken for ")
        var k = names.len() - 1
        var first = true
        while k >= 0 {
            if not first {
                try! msg.append(", ")
            }
            try! msg.append("`")
            try! msg.append(names.get(k) ?? "")
            try! msg.append("`")
            first = false
            k = k - 1
        }
        try! msg.append(", a case in scope, so it does not bind; rename the binding, as `")
        try! msg.append(text)
        try! msg.append("_value`")
        self.refuse(p, "pattern.case-mismatch", msg.build())
    }
}

// How many ancestors node `e` has, memoised in `depth`.
func tc_node_depth(e: Int, parents: &Vector<Int>, depth: &var Vector<Int>) -> Int {
    var path = Vector<Int>()
    var node = e
    while node >= 0 && depth[node] < 0 {
        try! path.push(node)
        node = parents[node]
    }
    var d = if node >= 0 { depth[node] } else { -1 }
    var k = path.len() - 1
    while k >= 0 {
        d = d + 1
        depth[path[k]] = d
        k = k - 1
    }
    depth[e]
}

// What each place's use decides, once every body is checked.
extension TcProgram {
    // Settles a subscript's role (SL:borrowing §5) and the borrow of a
    // `borrows` accessor's receiver: shared, unless the use writes through
    // the place it lends (design 141). Each is read off the use the place's
    // position recorded, following a projection outward to the use that
    // ends it.
    public func settle_places(&var self) {
        let n = self.res.nodes.len()
        var parents = Vector<Int>()
        var k = 0
        while k < n {
            try! parents.push(-1)
            k = k + 1
        }
        k = 0
        while k < n {
            let count = self.child_count(k)
            var j = 0
            while j < count {
                let c = self.child(k, j)
                parents[c] = k
                j = j + 1
            }
            k = k + 1
        }
        let order = self.consumer_first(&parents)
        k = 0
        while k < order.len() {
            self.settle_call(order[k], &parents)
            k = k + 1
        }
        self.check_plain_subscript_reads(&parents)
    }

    // The calls in the order they settle: each before every call nested in
    // it, so a chain's later hop has settled how it borrows the place the
    // earlier hop lends before that earlier hop reads its own use. A hop
    // under an exclusive one is then exclusive too, and charges its root so
    // (SL:borrowing §2.2, §3; pinned by borrowck's loan.window-root.chain-*).
    func consumer_first(&self, parents: &Vector<Int>) -> Vector<Int> {
        let n = self.res.nodes.len()
        var depth = Vector<Int>()
        var k = 0
        while k < n {
            try! depth.push(-1)
            k = k + 1
        }
        var counts = Vector<Int>()
        k = 0
        while k < self.calls.len() {
            let d = tc_node_depth(self.calls[k].node, &parents, &var depth)
            while counts.len() <= d {
                try! counts.push(0)
            }
            counts[d] += 1
            k = k + 1
        }
        var starts = Vector<Int>()
        var at = 0
        k = 0
        while k < counts.len() {
            try! starts.push(at)
            at = at + counts[k]
            k = k + 1
        }
        var order = Vector<Int>()
        k = 0
        while k < self.calls.len() {
            try! order.push(-1)
            k = k + 1
        }
        k = 0
        while k < self.calls.len() {
            let d = depth[self.calls[k].node]
            order[starts[d]] = k
            starts[d] += 1
            k = k + 1
        }
        return move order
    }

    // A plain subscript is a getitem wherever it is read, so it copies its
    // element out even where its position keeps nothing: an interpolation
    // hole, a message or format argument, a comparison operand, a match's
    // scrutinee, the receiver of a member hop (SL:borrowing §1, §5; D29).
    // Only a Copy element copies silently, `.copy()` spells an ExplicitCopy
    // one, and `borrow` reads either in place; an element that copies only
    // by inference owes design 219's requirement (`implied_copies`).
    // The positions that lend a place, and so exempt it, are the `borrow`
    // forms, `lend` and a `for` head (`lent_in_place`); a sigil on an
    // accessor's place is `borrowing.sigil-place`.
    func check_plain_subscript_reads(&var self, parents: &Vector<Int>) {
        let n = self.res.nodes.len()
        let skipped = self.outside_slice_marks(n)
        var k = 0
        while k < self.calls.len() {
            let c = self.calls[k]
            k = k + 1
            let e = c.node
            if c.target < 0 || skipped[e] || (c.role != TcRole.Getitem && c.role != TcRole.Place) {
                continue
            }
            if not self.has_alt(e, Alt.Expr_Subscript_Single) && not self.has_alt(e, Alt.Expr_Subscript_Multi) {
                continue
            }
            let u = self.expr_use[e]
            let reads = u == TcUse.Borrow || u == TcUse.Project || (u == TcUse.Test && self.scrutinizes_bound(e, &parents))
            if not reads {
                continue
            }
            if self.use_writes(e, &parents) {
                continue
            }
            let top = self.projection_top(e, &parents)
            if self.lent_in_place(e, &parents) || self.spells_copy(e, &parents) {
                continue
            }
            let t = self.expr_types[e]
            if t < 0 || self.has_error(t) {
                continue
            }
            if self.copies_silently(t) {
                self.implied_copies[e] = t
                continue
            }
            self.refuse_getitem_read(e, top, t, u == TcUse.Test)
        }
    }

    // Whether `e` is a `match`'s scrutinee and some arm's pattern binds a
    // name: the arm reads a part, where one binding nothing tests a tag.
    func scrutinizes_bound(&self, e: Int, parents: &Vector<Int>) -> Bool {
        let m = parents[e]
        if m < 0 || not self.has_alt(m, Alt.Expr_Match) || self.res.first_node_child(m) != e {
            return false
        }
        var stack = Vector<Int>()
        var k = 0
        while k < self.child_count(m) {
            let c = self.child(m, k)
            k = k + 1
            if self.has_alt(c, Alt.Expr_MatchArm) {
                try! stack.push(self.res.first_node_child(c))
            } else if self.has_alt(c, Alt.Expr_MatchArms) {
                var j = 0
                while j < self.child_count(c) {
                    let arm = self.child(c, j)
                    if self.has_alt(arm, Alt.Expr_MatchArm) {
                        try! stack.push(self.res.first_node_child(arm))
                    }
                    j = j + 1
                }
            }
        }
        var top = stack.len()
        while top > 0 {
            top = top - 1
            let p = stack[top]
            if p < 0 || self.is_leaf(p) {
                continue
            }
            if self.has_alt(p, Alt.Pat_BorrowBinding_Let) || self.has_alt(p, Alt.Pat_BorrowBinding_Var) {
                return true
            }
            if self.has_alt(p, Alt.Pat_Name) {
                let leaf = self.res.first_leaf(p)
                if self.binding_at(leaf).kind != ResBindKind.Cases {
                    return true
                }
            }
            var j = 0
            while j < self.child_count(p) {
                let c = self.child(p, j)
                if top < stack.len() {
                    stack[top] = c
                } else {
                    try! stack.push(c)
                }
                top = top + 1
                j = j + 1
            }
        }
        false
    }

    // The outermost node of the projection `e` heads: each step a member, a
    // call, a subscript, a tuple element, a force or parentheses whose first
    // operand is the step below.
    func projection_top(&self, e: Int, parents: &Vector<Int>) -> Int {
        var node = e
        var steps = 0
        while steps < 10000 {
            let up = parents[node]
            if up < 0 || self.res.first_node_child(up) != node {
                return node
            }
            let step = self.has_alt(up, Alt.Expr_Member) || self.has_alt(up, Alt.Expr_Call_Paren) || self.has_alt(up, Alt.Expr_Subscript_Single) || self.has_alt(up, Alt.Expr_Subscript_Multi) || self.has_alt(up, Alt.Expr_TupleIndex) || self.has_alt(up, Alt.Expr_Force) || self.has_alt(up, Alt.Expr_Paren)
            if not step {
                return node
            }
            node = up
            steps = steps + 1
        }
        return node
    }

    // Whether the projection subscript `e` heads ends where its place is
    // lent, so the subscript is a place there and never a getitem's copy
    // (SL:borrowing §5.1). Its entry points:
    //     settle_call
    //     check_plain_subscript_reads
    func lent_in_place(&self, e: Int, parents: &Vector<Int>) -> Bool {
        let top = self.projection_top(e, &parents)
        self.lends_in_place(parents[top])
    }

    // Whether node `p`, holding a projection, lends the place it names
    // rather than reading it by value.
    func lends_in_place(&self, p: Int) -> Bool {
        if p < 0 {
            return false
        }
        guard let alt = self.node_alt(p) else {
            return false
        }
        alt == Alt.Borrow_Place_Shared || alt == Alt.Borrow_Place_Var || alt == Alt.Borrow_OptionalTarget || alt == Alt.Borrow_Block || alt == Alt.Borrow_Binding_Let || alt == Alt.Borrow_Binding_Var || alt == Alt.Borrow_Unwrap_Let || alt == Alt.Borrow_Unwrap_Var || alt == Alt.Borrow_For_Let || alt == Alt.Borrow_For_Var || alt == Alt.Stmt_Lend || alt == Alt.Expr_Lends || alt == Alt.Expr_For_Plain || alt == Alt.Expr_For_Borrow
    }

    // Whether subscript `e` is the receiver of a `.copy()` call, which spells
    // the copy its getitem makes.
    func spells_copy(&self, e: Int, parents: &Vector<Int>) -> Bool {
        let member = parents[e]
        if member < 0 || not self.has_alt(member, Alt.Expr_Member) {
            return false
        }
        let call = parents[member]
        if call < 0 || not self.has_alt(call, Alt.Expr_Call_Paren) || self.res.first_node_child(call) != member {
            return false
        }
        var operands = 0
        var k = 0
        while k < self.child_count(call) {
            let c = self.child(call, k)
            if not self.is_leaf(c) {
                operands = operands + 1
            }
            k = k + 1
        }
        let m = self.node_module(e)
        let leaf = self.res.last_leaf_of(member)
        operands == 1 && self.text(m, leaf).equals("copy")
    }

    func refuse_getitem_read(&var self, e: Int, top: Int, t: Int, scrutinee: Bool) {
        let m = self.node_module(e)
        self.current = m
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, e))
        try! msg.append("` is a plain subscript, a getitem that copies its element out, and the element is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, which is ")
        let word = self.tier_word(t)
        try! msg.append(word)
        if scrutinee {
            try! msg.append(": match it in place as `borrow let e = ")
            try! msg.append(self.text(m, top))
            try! msg.append(" \{ match e \{ ... \} \}`")
        } else {
            try! msg.append(": write `borrow ")
            try! msg.append(self.text(m, top))
            try! msg.append("` to read it in place")
        }
        if word.equals("ExplicitCopy") {
            try! msg.append(", or `.copy()` on it for a copy")
        }
        self.refuse(e, "transfer.implicit-copy", msg.build())
    }

    func settle_call(&var self, at: Int, parents: &Vector<Int>) {
        let c = self.calls[at]
        let e = c.node
        self.current = self.node_module(e)
        self.current_test = c.test
        if c.target < 0 || c.role == TcRole.Case || c.role == TcRole.Memberwise || c.role == TcRole.Builtin {
            return
        }
        let subscript = self.has_alt(e, Alt.Expr_Subscript_Single) || self.has_alt(e, Alt.Expr_Subscript_Multi)
        let sig = self.sigs[c.target]
        let lending = (sig.effects & TC_EFFECT_BORROWS) != 0
        if not subscript && not lending {
            return
        }
        let receiver = self.call_receiver(e)
        let writes = self.use_writes(e, &parents)
        if writes && c.twin >= 0 {
            var switched = self.calls[at]
            switched.target = c.twin
            self.calls[at] = switched
        }
        var exclusive = writes
        let settled_target = self.calls[at].target
        if lending && self.accessor_exclusive_only(settled_target) {
            exclusive = true
        }
        if subscript {
            let direct = self.expr_use[e]
            var role = TcRole.Place
            if direct == TcUse.Write {
                role = TcRole.Setitem
            } else if direct == TcUse.Copy || direct == TcUse.Temp || direct == TcUse.Move || direct == TcUse.Test {
                role = TcRole.Getitem
            } else if direct == TcUse.Project && not writes && not self.lent_in_place(e, &parents) {
                role = TcRole.Getitem
            }
            self.settle_subscript(at, role, writes, lending)
            let settled = self.calls[at]
            let forced = self.accessor_exclusive_only(settled.target)
            exclusive = settled.role == TcRole.Setitem || (settled.role == TcRole.Place && writes) || forced
        }
        if receiver < 0 || self.expr_use[receiver] != TcUse.Unused {
            return
        }
        let t = self.final_type(receiver)
        if exclusive {
            let r = self.mk_ref(true, t)
            self.add_adjust(receiver, TcAdjustKind.BorrowVar, r)
            self.set_use(receiver, TcUse.BorrowVar)
        } else {
            let r = self.mk_ref(false, t)
            self.add_adjust(receiver, TcAdjustKind.Borrow, r)
            self.set_use(receiver, TcUse.Borrow)
        }
    }

    // Whether `borrows` accessor `d` borrows its receiver exclusively at
    // every use, a read included, so its root must be writable: it takes
    // `&var self` and declares no shared twin with `@synthesize(shared)`.
    // The receiver decides, not the lend: a cell-carrying `&self` accessor
    // lending `&var` serves a `let` root (SL:borrowing §3). A hand-written
    // `&self` twin is chosen for a read by the overload filter, so it never
    // reaches here. Stage 0's std predates declared modes: each of its
    // accessors serves both from one declaration, the use site choosing
    // (design 141).
    public func accessor_exclusive_only(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        let s = self.sigs[d]
        if (s.effects & TC_EFFECT_BORROWS) == 0 || (s.flags & TC_FLAG_SYNTHESIZE_SHARED) != 0 {
            return false
        }
        let m = self.res.decls[d].module
        if m >= 0 && self.res.modules[m].kind == ResModuleKind.Std && not self.res.std_new {
            return false
        }
        s.receiver == TcReceiver.Exclusive
    }

    // Whether the use that ends place `e`'s projection writes: an
    // assignment, a compound assignment, or an exclusive borrow.
    func use_writes(&self, e: Int, parents: &Vector<Int>) -> Bool {
        var node = e
        var guard_steps = 0
        while guard_steps < 10000 {
            let u = self.expr_use[node]
            if u != TcUse.Project {
                return u == TcUse.Write || u == TcUse.Update || u == TcUse.BorrowVar
            }
            let up = parents[node]
            if up < 0 {
                return false
            }
            node = up
            guard_steps = guard_steps + 1
        }
        false
    }

    // A subscript's role: a setitem is the declared `[]=`, or derived from
    // an exclusive place accessor; a getitem the declared `[]`, or derived
    // from the place accessor; a place use needs the accessor itself, lending
    // writably when the use writes (SL:borrowing §5.2).
    func settle_subscript(&var self, at: Int, role: TcRole, writes: Bool, lending: Bool) {
        var c = self.calls[at]
        let target_sig = self.sigs[c.target]
        c.role = role
        if role == TcRole.Setitem {
            let setter = self.setitem_of(c.owner)
            if setter >= 0 {
                c.target = setter
                c.derived = false
            } else if lending && target_sig.lending_exclusive {
                c.derived = true
            } else {
                self.refuse_role(c.node, c.owner, "a setitem: it declares no `[]=`, and its `[]` lends no writable place")
            }
        } else if role == TcRole.Getitem {
            c.derived = lending
        } else {
            if not lending {
                self.refuse_role(c.node, c.owner, "a place accessor: its `[]` is a getitem, which copies the element out; write through a `borrows` accessor")
            } else if writes && not target_sig.lending_exclusive {
                self.refuse_role(c.node, c.owner, "a writable place: its `[]` lends read-only")
            }
        }
        self.calls[at] = c
    }

    // The `[]=` of type `t` this module sees, or -1.
    func setitem_of(&var self, t: Int) -> Int {
        let d = self.nominal_decl(t)
        if d < 0 {
            return -1
        }
        let name = self.res.intern("[]=")
        let m = self.current
        let in_test = self.current_test
        let found = self.visible_members(d, name, m, in_test)
        var k = 0
        while k < found.len() {
            if self.is_method_member(found[k], false) {
                let member = self.members[found[k]]
                return member.decl
            }
            k = k + 1
        }
        return -1
    }

    func refuse_role(&var self, e: Int, t: Int, what: String) {
        var msg = StringBuilder()
        try! msg.append("this subscript is used as ")
        try! msg.append(what)
        try! msg.append(" (`")
        try! msg.append(self.type_text(t))
        try! msg.append("` declares or derives no such role)")
        let m = self.node_module(e)
        self.refuse_in(m, e, "subscript.role", msg.build())
    }
}

// Each closure's captures (spec, Capturing `self` and reference parameters).
extension TcProgram {
    // Records every closure's captures once every body is checked: the
    // enclosing bindings its capture list writes, in order, then those its
    // body names, in the order it first names them. A capture takes its
    // transfer by the rules a value use takes elsewhere: the capture list's
    // word when one is written; a borrow for `self`, as its receiver
    // declares, and for a reference parameter, whose reference is copied;
    // otherwise a copy, which only a Copy type makes silently. A borrow of
    // the enclosing frame is refused in a closure that escapes.
    public func settle_captures(&var self) {
        if self.closures.len() == 0 {
            return
        }
        let n = self.res.nodes.len()
        var parents = Vector<Int>()
        var k = 0
        while k < n {
            try! parents.push(-1)
            k = k + 1
        }
        k = 0
        while k < n {
            let count = self.child_count(k)
            var j = 0
            while j < count {
                let c = self.child(k, j)
                parents[c] = k
                j = j + 1
            }
            k = k + 1
        }
        k = 0
        while k < self.closures.len() {
            let e = self.closures[k]
            let d = self.closure_decls[k]
            let first = self.captures.len()
            try! self.capture_first.push(first)
            self.current = self.node_module(e)
            let escapes = self.closure_escapes(e, &parents)
            try! self.closure_escaping.push(escapes)
            self.collect_captures(e, d, escapes)
            let count = self.captures.len() - first
            try! self.capture_count.push(count)
            k = k + 1
        }
    }

    // Each `Thread.spawn` brace's captures, once they are settled. The capture
    // list is the body's parameter list, so a binding the body names that the
    // list does not is refused; and each capture crosses to the spawned
    // thread, so its type must be `Send`, a generic body's declared bounds
    // answering for its parameters (design 242).
    func check_thread_braces(&var self) {
        var k = 0
        while k < self.thread_braces.len() {
            let brace = self.thread_braces[k]
            k = k + 1
            let found = self.closure_index.first(brace, 0)
            if found < 0 {
                continue
            }
            let ordinal = self.closure_index.value(found)
            self.refuse_implicit_captures(brace, ordinal)
            self.refuse_unsent_capture(brace, ordinal)
        }
    }

    func refuse_implicit_captures(&var self, brace: Int, ordinal: Int) {
        let first = self.capture_first[ordinal]
        let end = first + self.capture_count[ordinal]
        var names = StringBuilder()
        var list = StringBuilder()
        var count = 0
        var at = first
        while at < end {
            let cap = self.captures[at]
            at = at + 1
            if cap.explicit {
                continue
            }
            let name = self.capture_name(cap.binding)
            if count > 0 {
                try! names.append(", ")
                try! list.append(", ")
            }
            try! names.append("`")
            try! names.append(name)
            try! names.append("`")
            try! list.append(name)
            count = count + 1
        }
        if count == 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append("a spawned brace captures nothing implicitly, and this body names ")
        try! msg.append(names.build())
        try! msg.append(". Name what crosses in the capture list — `Thread.spawn \{ [")
        try! msg.append(list.build())
        try! msg.append("] in ... \}`. The list IS the body's parameter list: each entry transfers at the spawn, by value, at its own copy tier, and `[move x]` is how a move-only value goes. Everything that crosses a concurrency boundary is spelled at the crossing")
        let m = self.node_module(brace)
        self.refuse_in(m, brace, "spawn.implicit-capture", msg.build())
    }

    // Refuses the first capture of brace `brace` whose type is not `Send`,
    // judged in the declaration that holds the brace.
    func refuse_unsent_capture(&var self, brace: Int, ordinal: Int) {
        let send = self.known.send
        let d = self.closure_decls[ordinal]
        if send < 0 {
            return
        }
        let saved = self.save_context()
        if d >= 0 {
            self.enter_decl(d)
        }
        let env_decl = self.current_decl
        let env_ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        let first = self.capture_first[ordinal]
        let end = first + self.capture_count[ordinal]
        var unsent = -1
        var at = first
        while at < end && unsent < 0 {
            let cap = self.captures[at]
            if self.capture_blocks_sendable(cap.ty, cap.use, true, env_decl, env_ext, viewer, in_test) >= 0 {
                unsent = at
            }
            at = at + 1
        }
        self.restore_context(saved)
        if unsent < 0 {
            return
        }
        let cap = self.captures[unsent]
        var msg = StringBuilder()
        try! msg.append("cannot `Thread.spawn`: captured `")
        try! msg.append(self.capture_name(cap.binding))
        try! msg.append("` of type `")
        try! msg.append(self.type_text(cap.ty))
        try! msg.append("` is not `Send`")
        try! msg.append(self.sendable_hint(cap.ty))
        try! msg.append(". Only Send values may cross to another thread; share through `Arc` (and `Mutex` for mutation)")
        let m = self.node_module(brace)
        self.refuse_in(m, cap.site, "spawn.send", msg.build())
    }

    // Closure `e`'s captures, recorded in order.
    func collect_captures(&var self, e: Int, d: Int, escapes: Bool) {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.is_capture(c) {
                continue
            }
            var b = self.binding_at(c)
            if not self.has_alt(c, Alt.Expr_Capture_Self) && not self.has_alt(c, Alt.Expr_Capture_SelfExclusive) {
                let leaf = self.res.first_leaf(c)
                b = self.binding_at(leaf)
            }
            if b.kind == ResBindKind.Local && b.node >= 0 && not self.captured_already(e, b.node) {
                self.add_capture(e, d, b.node, c, c, escapes)
            }
        }
        let mentions = tc_closure_mentions(&self, e)
        k = 0
        while k < mentions.len() {
            let site = mentions[k]
            let b = self.mention_binding(site)
            if not self.captured_already(e, b.node) {
                self.add_capture(e, d, b.node, site, -1, escapes)
            }
            k = k + 1
        }
    }

    // The binding a mention found by `tc_closure_mentions` names.
    public func mention_binding(&self, site: Int) -> ResBinding {
        if self.has_alt(site, Alt.Expr_Self) {
            return self.binding_at(site)
        }
        let leaf = self.res.first_leaf(site)
        self.binding_at(leaf)
    }

    // Whether closure `e`'s run already captures the binding declared at
    // `binding`.
    func captured_already(&self, e: Int, binding: Int) -> Bool {
        var at = self.capture_first[self.capture_first.len() - 1]
        while at < self.captures.len() {
            let cap = self.captures[at]
            if cap.closure == e && cap.binding == binding {
                return true
            }
            at = at + 1
        }
        false
    }

    // Whether a closure around closure `e` captured the binding declared at
    // `binding` by borrow. An enclosing closure's captures are recorded
    // first, since a closure is listed before the closures its body holds.
    func borrowed_by_enclosing_capture(&self, e: Int, binding: Int) -> Bool {
        let inner = self.res.nodes[e]
        var k = 0
        while k < self.captures.len() {
            let cap = self.captures[k]
            k = k + 1
            if cap.binding != binding || cap.closure == e {
                continue
            }
            if cap.use != TcUse.Borrow && cap.use != TcUse.BorrowVar {
                continue
            }
            let outer = self.res.nodes[cap.closure]
            if inner.start >= outer.start && inner.end <= outer.end {
                return true
            }
        }
        false
    }

    // How a closure in declaration `d` takes the binding declared at
    // `binding`, written as capture-list entry `entry` or named in its body
    // (`entry` -1): the entry's word, a borrow of `self` as its receiver
    // declares, else a copy. A capture of a reference reborrows it whatever
    // the word, which the capture rule reads off its type.
    // ENTRY POINTS:
    //     add_capture
    //     closure_blocker
    func capture_mode(&self, entry: Int, binding: Int, d: Int) -> TcUse {
        if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_Move) {
            return TcUse.Move
        }
        if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_Copy) {
            return TcUse.Copy
        }
        if entry >= 0 && (self.has_alt(entry, Alt.Expr_Capture_Borrow) || self.has_alt(entry, Alt.Expr_Capture_Self)) {
            return TcUse.Borrow
        }
        if entry >= 0 && (self.has_alt(entry, Alt.Expr_Capture_BorrowExclusive) || self.has_alt(entry, Alt.Expr_Capture_SelfExclusive)) {
            return TcUse.BorrowVar
        }
        var s = TcSig.blank()
        if d >= 0 {
            s = self.sigs[d]
        }
        if self.has_alt(binding, Alt.Decl_Param_Receiver) && (s.effects & TC_EFFECT_CONSUMES) == 0 {
            return if s.receiver == TcReceiver.Exclusive { TcUse.BorrowVar } else { TcUse.Borrow }
        }
        TcUse.Copy
    }

    // The first capture of closure `e`, in declaration `d`, that keeps it
    // from being `sendable` by the capture rule, in the current context. It
    // reads the capture list and the body's mentions `collect_captures`
    // records, before they settle, so a closure's own type can say
    // `sendable`; `check_closure_traits` judges the settled records again.
    public func closure_blocker(&var self, e: Int, d: Int) -> TcCaptureBlock {
        let env_decl = self.current_decl
        let env_ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        var seen = Vector<Int>()
        var entries = Vector<Int>()
        var sites = Vector<Int>()
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if not self.is_capture(c) {
                continue
            }
            var b = self.binding_at(c)
            if not self.has_alt(c, Alt.Expr_Capture_Self) && not self.has_alt(c, Alt.Expr_Capture_SelfExclusive) {
                let leaf = self.res.first_leaf(c)
                b = self.binding_at(leaf)
            }
            if b.kind == ResBindKind.Local && b.node >= 0 && not tc_contains(&seen, b.node) {
                try! seen.push(b.node)
                try! entries.push(c)
            }
        }
        let mentions = tc_closure_mentions(&self, e)
        k = 0
        while k < mentions.len() {
            let b = self.mention_binding(mentions[k])
            k = k + 1
            if b.kind == ResBindKind.Local && b.node >= 0 && not tc_contains(&seen, b.node) {
                try! seen.push(b.node)
                try! entries.push(-1)
            }
        }
        k = 0
        while k < seen.len() {
            let binding = seen[k]
            let t = self.local_types[binding]
            let u = self.capture_mode(entries[k], binding, d)
            k = k + 1
            let tr = self.capture_blocks_sendable(t, u, false, env_decl, env_ext, viewer, in_test)
            if tr >= 0 {
                return TcCaptureBlock(binding: binding, ty: t, use: u, trait_decl: tr)
            }
        }
        TcCaptureBlock(binding: -1, ty: -1, use: TcUse.Copy, trait_decl: -1)
    }

    // Why capture `block` keeps its closure from being `sendable`, as a
    // clause: the binding, its type, and what would let it cross.
    public func capture_block_text(&self, block: &TcCaptureBlock) -> String {
        let borrowed = block.use == TcUse.Borrow || block.use == TcUse.BorrowVar || self.is_reference(block.ty)
        var msg = StringBuilder()
        try! msg.append("it captures `")
        try! msg.append(self.capture_name(block.binding))
        try! msg.append("` of type `")
        try! msg.append(self.type_text(block.ty))
        if borrowed {
            try! msg.append("` by borrow, and the borrowed value is not `")
            try! msg.append(self.res.decl_path(block.trait_decl))
            try! msg.append("`: a borrow `[&x]` crosses a thread when `x` is `Sync`, and `[&var x]` when `x` is `Send`")
        } else {
            try! msg.append("`, which is not `")
            try! msg.append(self.res.decl_path(block.trait_decl))
            try! msg.append("`: every copy of a closure shares what it captured, so each capture must be `Send` and `Sync`")
        }
        msg.build()
    }

    // Records one capture of the binding declared at `binding`, written as
    // capture-list entry `entry` or first named at `site` (`entry` -1).
    func add_capture(&var self, e: Int, d: Int, binding: Int, site: Int, entry: Int, escapes: Bool) {
        let t = self.local_types[binding]
        let receiver = self.has_alt(binding, Alt.Decl_Param_Receiver)
        var s = TcSig.blank()
        if d >= 0 {
            s = self.sigs[d]
        }
        let consumes = (s.effects & TC_EFFECT_CONSUMES) != 0
        let u = self.capture_mode(entry, binding, d)
        // A reference is a borrow of storage the caller owns whichever word
        // captures it: every capture of one reborrows its referent, in the
        // reference's own mode for `[r]`, `[copy r]` and the implicit
        // capture, so the frame rule holds under every word (SL-607).
        let reference = self.is_reference(t)
        var frame = reference
        if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_Move) {
            let borrowed = self.borrowed_by_enclosing_capture(e, binding)
            let reason = self.move_from_borrow_reason(t, binding, borrowed)
            if reason.len() > 0 {
                let name = self.capture_name(binding)
                self.refuse_move_from_borrow(entry, name, reason)
                frame = false
            } else {
                self.check_relocation(entry, binding, t, d, TcRelocation.Capture)
            }
        } else if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_Copy) {
            let value = not reference && t >= 0 && not self.has_error(t)
            if reference && self.is_exclusive_ref(t) {
                self.refuse_copy_exclusive_reference(entry, binding, t)
            } else if value && not self.copies_silently(t) && self.tier_word(t).equals("NoCopy") {
                self.refuse_capture_copy(entry, binding, t)
            } else if value && self.mentions_param(t) && not self.capture_copies(t, d) {
                self.refuse_generic_capture(entry, binding, t)
            }
        } else if entry >= 0 && (self.has_alt(entry, Alt.Expr_Capture_Borrow) || self.has_alt(entry, Alt.Expr_Capture_Self)) {
            frame = true
        } else if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_BorrowExclusive) {
            frame = true
        } else if entry >= 0 && self.has_alt(entry, Alt.Expr_Capture_SelfExclusive) {
            frame = true
            if s.receiver != TcReceiver.Exclusive {
                self.refuse_exclusive_self(entry, d)
            }
        } else if receiver && not consumes {
            frame = true
        } else if not reference && t >= 0 && not self.has_error(t) && not self.copies_silently(t) {
            self.refuse_capture_by_value(site, binding, t)
        } else if not reference && t >= 0 && not self.has_error(t) && self.mentions_param(t) {
            // A silent by-value capture copies at the closure's creation,
            // design 219's inferred requirement, checked at each call (D30).
            self.implied_copies[site] = t
        }
        // A borrow of the enclosing frame lowers to a pointer into it.
        if frame && escapes {
            let sigiled = entry >= 0 && (u == TcUse.Borrow || u == TcUse.BorrowVar)
            self.refuse_escaping_borrow(site, binding, t, sigiled)
        }
        // A non-escaping closure may capture a non-escaping function value,
        // which keeps its kind in the body (SL:open-questions D35).
        if escapes && binding >= 0 && self.nonescaping_bindings[binding] {
            self.refuse_escape(site, "an escaping closure that captures it")
        }
        try! self.captures.push(TcCapture(closure: e, binding: binding, ty: t, use: u, site: site,
                                          explicit: entry >= 0))
    }

    // Whether a spelled `[copy x]` of a value of type `t`, which names a type
    // parameter, has a copy declaration `d`'s bounds grant: `Copy` for every
    // parameter it names, or `ExplicitCopy` on a bare parameter, whose
    // `copy()` the lowering calls. Design 219 refuses a spelled copy no bound
    // grants at the definition (D30).
    func capture_copies(&var self, t: Int, d: Int) -> Bool {
        if d < 0 {
            return true
        }
        let saved = self.save_context()
        self.enter_decl(d)
        let env_decl = self.current_decl
        let env_ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        let copy = self.known.copy
        let explicit_copy = self.known.explicit_copy
        var met = copy >= 0 && self.satisfies(t, copy, env_decl, env_ext, viewer, in_test)
        if not met && self.kind_of(t) == TcKind.Param && explicit_copy >= 0 {
            met = self.satisfies(t, explicit_copy, env_decl, env_ext, viewer, in_test)
        }
        self.restore_context(saved)
        met
    }

    func refuse_generic_capture(&var self, at: Int, binding: Int, t: Int) {
        let name = self.capture_name(binding)
        var msg = StringBuilder()
        try! msg.append("`[copy ")
        try! msg.append(name)
        try! msg.append("]` copies `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, and no bound lets this generic body spell that copy: bound its parameter `Copy`, or `ExplicitCopy` on a bare parameter; or capture it with `[move ")
        try! msg.append(name)
        try! msg.append("]`, or `[")
        try! msg.append(name)
        try! msg.append("]` for a copy each call checks")
        self.refuse(at, "capture.copy", msg.build())
    }

    // Whether closure `e` escapes: anything but a direct argument of a call
    // whose parameter is a function type that does not say `escaping`. A new
    // storage position therefore escapes with no change here. Every reader
    // takes the answer from `closure_escaping`, mono's environment refusal
    // among them (SL-608).
    func closure_escapes(&var self, e: Int, parents: &Vector<Int>) -> Bool {
        let up = parents[e]
        if up < 0 {
            return true
        }
        var call = -1
        var arg = e
        if self.has_alt(up, Alt.Expr_Argument_Positional) || self.has_alt(up, Alt.Expr_Argument_Labelled) {
            arg = up
            call = parents[up]
        } else if self.is_call_alt(up) && self.res.first_node_child(up) != e {
            call = up
        }
        if call < 0 || not self.is_call_alt(call) {
            return true
        }
        let at = self.call_at[call]
        if at < 0 {
            return true
        }
        let c = self.calls[at]
        let callee = self.res.first_node_child(call)
        var index = 0
        var found = -1
        let n = self.child_count(call)
        var k = 0
        while k < n {
            let child = self.child(call, k)
            k = k + 1
            if child == callee || self.is_leaf(child) {
                continue
            }
            if child == arg {
                found = index
            }
            index = index + 1
        }
        if found < 0 {
            return true
        }
        var pt = -1
        var says = false
        if c.role == TcRole.Value && c.owner >= 0 && self.kind_of(c.owner) == TcKind.Func {
            if found < self.types.ty(c.owner).count {
                pt = self.types.arg(c.owner, found)
                says = (self.types.ty(pt).a & TC_EFFECT_ESCAPING) != 0
            }
        } else if c.role == TcRole.Call && c.bind_first >= 0 {
            var j = 0
            while j < c.bind_count {
                if self.binds[c.bind_first + j] == found {
                    let s = self.sigs[c.target]
                    let p = self.params[s.param_first + j]
                    pt = p.ty
                    says = p.escaping
                }
                j = j + 1
            }
        }
        if pt < 0 || self.kind_of(pt) != TcKind.Func {
            return true
        }
        says
    }

    // The name a capture's binding is written with.
    public func capture_name(&self, binding: Int) -> String {
        if self.has_alt(binding, Alt.Decl_Param_Receiver) {
            return "self"
        }
        let m = self.node_module(binding)
        self.text(m, binding)
    }

    func refuse_capture_by_value(&var self, site: Int, binding: Int, t: Int) {
        let name = self.capture_name(binding)
        var msg = StringBuilder()
        try! msg.append("the closure captures `")
        try! msg.append(name)
        try! msg.append("` by value, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is ")
        try! msg.append(self.tier_word(t))
        try! msg.append(", which does not copy silently: capture it with `[move ")
        try! msg.append(name)
        try! msg.append("]`, or copy it into a local the closure captures")
        self.refuse(site, "transfer.implicit-copy", msg.build())
    }

    func refuse_capture_copy(&var self, entry: Int, binding: Int, t: Int) {
        let name = self.capture_name(binding)
        var msg = StringBuilder()
        try! msg.append("`[copy ")
        try! msg.append(name)
        try! msg.append("]` copies `")
        try! msg.append(name)
        try! msg.append("`, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is NoCopy, so it has no copy: capture it with `[move ")
        try! msg.append(name)
        try! msg.append("]`")
        self.refuse(entry, "capture.copy", msg.build())
    }

    // `[copy r]` of a `&var` reference would be a second writer beside `r`;
    // `[&var r]` is the capture that hands the closure the one writer.
    func refuse_copy_exclusive_reference(&var self, entry: Int, binding: Int, t: Int) {
        let name = self.capture_name(binding)
        var msg = StringBuilder()
        try! msg.append("`[copy ")
        try! msg.append(name)
        try! msg.append("]` copies `")
        try! msg.append(name)
        try! msg.append("`, an exclusive reference (`")
        try! msg.append(self.type_text(t))
        try! msg.append("`), and a copy would be a second writer of what it refers to: capture it with `[&var ")
        try! msg.append(name)
        try! msg.append("]`, which reborrows it for the closure's life")
        self.refuse(entry, "capture.copy", msg.build())
    }

    func refuse_exclusive_self(&var self, entry: Int, d: Int) {
        var msg = StringBuilder()
        try! msg.append("`[&var self]` needs a `&var self` receiver")
        if d >= 0 {
            try! msg.append(", and `")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` takes `&self`")
        }
        try! msg.append(": a shared borrow has no exclusive borrow to hand out; write `[&self]`")
        self.refuse(entry, "capture.exclusive-self", msg.build())
    }

    // `sigiled`: the capture list spells the borrow, `[&x]` or `[&var x]`.
    func refuse_escaping_borrow(&var self, site: Int, binding: Int, t: Int, sigiled: Bool) {
        let name = self.capture_name(binding)
        var msg = StringBuilder()
        try! msg.append("an escaping closure cannot capture `")
        try! msg.append(name)
        if self.has_alt(binding, Alt.Decl_Param_Receiver) {
            try! msg.append("`: a method's receiver is a borrow of storage the caller owns")
        } else if not sigiled && self.is_reference(t) {
            try! msg.append("`, a reference (`")
            try! msg.append(self.type_text(t))
            try! msg.append("`)")
        } else {
            try! msg.append("` by borrow")
        }
        try! msg.append(", and a borrow may not outlive the frame it points into: pass the closure straight to a parameter that does not escape, or copy what its body needs into locals and capture those")
        self.refuse(site, "capture.escaping-borrow", msg.build())
    }
}

// The places closure `e`'s body names an enclosing local or `self`, in
// source order: each a name or `self` node whose binding is a local declared
// outside the closure. A capture list's entries are not among them.
public func tc_closure_mentions(p: &TcProgram, e: Int) -> Vector<Int> {
    var out = Vector<Int>()
    let span = p.res.nodes[e]
    var stack = Vector<Int>()
    try! stack.push(e)
    var top = 1
    while top > 0 {
        top = top - 1
        let id = stack[top]
        if id != e && p.is_capture(id) {
            continue
        }
        if p.has_alt(id, Alt.Expr_Name) || p.has_alt(id, Alt.Expr_NameRef) || p.has_alt(id, Alt.Expr_Self) {
            let b = p.mention_binding(id)
            if b.kind == ResBindKind.Local && b.node >= 0 {
                let declared = p.res.nodes[b.node]
                let inside = declared.start >= span.start && declared.end <= span.end
                if not inside {
                    try! out.push(id)
                }
            }
        }
        var c = p.child_count(id) - 1
        while c >= 0 {
            let child = p.child(id, c)
            if not p.is_leaf(child) {
                if top < stack.len() {
                    stack[top] = child
                } else {
                    try! stack.push(child)
                }
                top = top + 1
            }
            c = c - 1
        }
    }
    move out
}

// The body half's refusals.
extension TcProgram {
    // A `Result` computed where nothing reads it is refused (design 151): a
    // statement, a `Void` body's or a loop body's tail, a statement-position
    // arm. A statement-position `if` or `match` forwards its arms' values,
    // which are statements of their own, so the refusal lands on the call
    // that produced the `Result`. `let _ =` is the explicit out.
    func check_discarded(&var self, e: Int) {
        if e < 0 || not self.is_typed(e) {
            return
        }
        if self.has_alt(e, Alt.Expr_If) || self.has_alt(e, Alt.Expr_Match) || self.has_alt(e, Alt.Borrow_Block) {
            return
        }
        let t = self.final_type(e)
        if t < 0 || self.has_error(t) || not self.is_result(t) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("the result of ")
        let at = self.call_at[e]
        if at >= 0 && self.calls[at].target >= 0 {
            let target = self.calls[at].target
            let name = self.res.decls[target].name
            try! msg.append("`")
            try! msg.append(self.name_text(name))
            try! msg.append("`")
        } else {
            try! msg.append("this expression")
        }
        try! msg.append(" is `")
        try! msg.append(self.type_text(t))
        try! msg.append("` and is silently discarded: handle it (`match` it, `try` or `try!` it, or return it), or write `let _ = ...` to discard it explicitly")
        self.refuse(e, "result.discarded", msg.build())
    }

    // A body construct outside the bootstrap slice, named by what it is
    // rather than by one grammar alternative; nothing under it is verified.
    func not_yet(&var self, e: Int, what: String) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(" is not in the bootstrap slice yet")
        self.refuse(e, "slice.not-yet", msg.build())
        try! self.skipped.push(e)
    }

    func refuse_mismatch(&var self, e: Int, from: Int, slot: Int, pos: TcPosition, allow: TcAllowance) {
        var msg = StringBuilder()
        try! msg.append("expected `")
        try! msg.append(self.type_text(slot))
        try! msg.append("`, the type of ")
        try! msg.append(self.position_text(pos))
        try! msg.append(", and found `")
        try! msg.append(self.type_text(from))
        try! msg.append("`")
        let hint = self.static_cast_hint(e, slot)
        if hint.len() > 0 {
            try! msg.append(hint)
        } else {
            try! msg.append(self.allowance_reason(from, slot, allow))
        }
        self.refuse(e, "type.mismatch", msg.build())
    }

    // The way out when `e` names a module static of an integer type where an
    // integer `to` is expected: outside a constant expression a static keeps
    // its declared type, as every named value does (SL:open-questions D17).
    // Empty otherwise.
    func static_cast_hint(&self, e: Int, to: Int) -> String {
        if not self.names_constant_static(e) || not self.is_integer(to) {
            return ""
        }
        let m = self.current
        let leaf = self.res.first_leaf(e)
        var out = StringBuilder()
        try! out.append("; a module static keeps its declared type outside a constant expression: write `")
        try! out.append(self.text(m, leaf))
        try! out.append(" as ")
        try! out.append(self.type_text(to))
        try! out.append("`")
        out.build()
    }

    func refuse_ambiguous_result(&var self, e: Int, slot: Int) {
        var msg = StringBuilder()
        try! msg.append("both payloads of `")
        try! msg.append(self.type_text(slot))
        try! msg.append("` can take this value, so it names neither: write `.Ok(value: ...)` or `.Err(error: ...)`")
        self.refuse(e, "type.ambiguous-result", msg.build())
    }

    // An implicit copy of place `e` of type `t`. The hint offers only what
    // compiles for the refused shape, and names a tier only where the type
    // establishes one: a projection's or `Self`'s is the bounds' question
    // (SL-500).
    func refuse_implicit_copy(&var self, e: Int, t: Int) {
        var msg = StringBuilder()
        try! msg.append("this reads a place of type `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        let tier = self.established_tier(t)
        if tier.len() > 0 {
            try! msg.append(", which is ")
            try! msg.append(tier)
        } else {
            try! msg.append(", which no bound in scope makes `Copy`")
        }
        try! msg.append(", by value: only a Copy type copies silently; ")
        if self.reads_expression(e) {
            try! msg.append(self.implicit_copy_fixes(e, t))
        } else {
            try! msg.append(self.binding_copy_fixes(t))
        }
        self.refuse(e, "transfer.implicit-copy", msg.build())
    }

    // Whether node `e` is an expression, not a pattern's binding.
    func reads_expression(&self, e: Int) -> Bool {
        guard let alt = self.node_alt(e) else {
            return false
        }
        alt_name(alt).starts_with("syntax.expr.")
    }

    // The ways out of a pattern binding a copy of a place's part: bind from
    // a `move` of the scrutinee or a `take()` of an optional place; `.copy()`
    // where the type meets `ExplicitCopy`; a borrow of the place.
    func binding_copy_fixes(&var self, t: Int) -> String {
        var out = StringBuilder()
        try! out.append("match a `move` of the value when its binding owns it, or its `take()` when it is an optional place, ")
        let ec = self.known.explicit_copy
        let env = self.current_decl
        let ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        if ec >= 0 && not self.open_tier(t) && self.satisfies(t, ec, env, ext, viewer, in_test) {
            try! out.append("bind its `.copy()`, ")
        }
        try! out.append("or borrow it")
        out.build()
    }

    // `t`'s copy tier as a refusal names it, `ExplicitCopy` or `NoCopy`, or
    // "" where a type parameter, `Self` or a projection leaves it open.
    func established_tier(&var self, t: Int) -> String {
        if self.open_tier(t) {
            return ""
        }
        let tier = self.type_tier(t, -1)
        if tier.base == TC_TIER_EXPLICIT {
            return "ExplicitCopy"
        }
        if tier.base == TC_TIER_NOCOPY {
            return "NoCopy"
        }
        ""
    }

    // Whether `t` mentions a type parameter, `Self` or a projection.
    func open_tier(&self, t: Int) -> Bool {
        var seen = TcMemo.empty()
        self.open_tier_in(t, &var seen)
    }

    // One part of `open_tier`. A projection holds the parameter it projects
    // from, so a type holding none is closed; the walk stops at the first
    // open part, so a branching part it has seen is closed.
    func open_tier_in(&self, t: Int, seen: &var TcMemo) -> Bool {
        if t < 0 {
            return false
        }
        let info = self.types.ty(t)
        if (info.holds & TC_HOLDS_PARAM) == 0 {
            return false
        }
        if info.kind == TcKind.Param || info.kind == TcKind.SelfType || info.kind == TcKind.Projection {
            return true
        }
        if self.types.branches(t) && not seen.mark(t, 0) {
            return false
        }
        if info.b >= 0 && (info.kind == TcKind.Ref || info.kind == TcKind.Slice || info.kind == TcKind.Array) && self.open_tier_in(info.b, &var seen) {
            return true
        }
        if info.kind == TcKind.Nominal || info.kind == TcKind.Tuple {
            var k = 0
            while k < info.count {
                let a = self.types.arg(t, k)
                if self.open_tier_in(a, &var seen) {
                    return true
                }
                k = k + 1
            }
        }
        false
    }

    // The ways out of an implicit copy of place `e` that compile for its
    // shape: `move` on a binding that owns its value, or on its optional's
    // payload; `take()` on an optional field, or on the optional a payload is
    // forced from, where a write through the place lands, and otherwise a
    // move of an owned root into a `var` first; `.copy()` where the type
    // meets `ExplicitCopy`; a borrow.
    func implicit_copy_fixes(&var self, e: Int, t: Int) -> String {
        let place = self.unparenthesized(e)
        let m = self.node_module(place)
        let text = self.text(m, place)
        var out = StringBuilder()
        var offered = false
        var part = ""
        if self.owns_binding(place) {
            try! out.append("write `move ")
            try! out.append(text)
            try! out.append("` to take it, ")
            offered = true
        } else if self.has_alt(place, Alt.Expr_Force) {
            let base = self.res.first_node_child(place)
            let base_text = self.text(m, base)
            if self.owns_binding(base) {
                try! out.append("write `move ")
                try! out.append(text)
                try! out.append("` to take the payload, ")
                offered = true
            } else if self.expr_place[base] {
                offered = self.offer_take(&var out, base, &base_text, "the payload")
            }
        } else if self.is_optional(t) && (self.has_alt(place, Alt.Expr_Member) || self.has_alt(place, Alt.Expr_TupleIndex)) {
            offered = self.offer_take(&var out, place, &text, "it")
        } else if self.has_alt(place, Alt.Expr_Member) {
            part = "a field"
        } else if self.has_alt(place, Alt.Expr_TupleIndex) {
            part = "a tuple element"
        }
        let ec = self.known.explicit_copy
        let env = self.current_decl
        let ext = self.current_ext
        let viewer = self.current
        let in_test = self.current_test
        let copies = ec >= 0 && not self.open_tier(t) && self.satisfies(t, ec, env, ext, viewer, in_test)
        if part.len() > 0 {
            try! out.append(part)
            try! out.append(" is not moved out on its own")
            if not copies {
                try! out.append(", so borrow it")
                return out.build()
            }
            try! out.append(": ")
        }
        if copies {
            try! out.append("`")
            try! out.append(text)
            try! out.append(".copy()` for a copy, ")
            offered = true
        }
        if not offered && part.len() == 0 {
            try! out.append("a binding that only borrows has nothing to move, so borrow it")
        } else {
            try! out.append("or borrow it")
        }
        out.build()
    }

    // `take()` on optional place `opt`, written `written`, when a write
    // through it lands; through an owned root that is never written, a move
    // of the root into a `var` first, as the mutability refusal names it.
    // Whether it offered either.
    func offer_take(&var self, out: &var StringBuilder, opt: Int, written: &String, what: String) -> Bool {
        let root = self.hint_root(opt)
        if root.writable {
            try! out.append("write `")
            try! out.append(written)
            try! out.append(".take()` to take ")
            try! out.append(what)
            try! out.append(" and leave `None`, ")
            return true
        }
        if root.node < 0 || (root.binder != TcBinder.Let && root.binder != TcBinder.Parameter) {
            return false
        }
        let m = self.node_module(root.node)
        let name = self.text(m, root.node)
        try! out.append("`")
        try! out.append(written)
        try! out.append(".take()` would write `")
        try! out.append(name)
        try! out.append("`, ")
        try! out.append(tc_binder_text(root.binder))
        try! out.append(", which is never written: move it into a `var` first, `var w = move ")
        try! out.append(name)
        try! out.append("`, and take ")
        try! out.append(what)
        try! out.append(" from `w`, ")
        true
    }

    // The root of field, element or payload place `e`, and whether a write
    // through `e` lands there: `self` under `&var self`, a `&var` reference,
    // or a `var` the place's own closure declares. Anything else, a subscript
    // or a call on the way included, answers no root (the mutability funnel
    // judges the write itself once it runs).
    func hint_root(&self, e: Int) -> TcHintRoot {
        let none = TcHintRoot(node: -1, writable: false, binder: TcBinder.Unknown)
        var at = e
        var steps = 0
        while steps < 64 && (self.has_alt(at, Alt.Expr_Member) || self.has_alt(at, Alt.Expr_TupleIndex) || self.has_alt(at, Alt.Expr_Force) || self.has_alt(at, Alt.Expr_Paren)) {
            at = self.res.first_node_child(at)
            if at < 0 {
                return none
            }
            steps = steps + 1
        }
        if self.has_alt(at, Alt.Expr_Self) {
            let d = self.current_decl
            let exclusive = d >= 0 && self.sigs[d].receiver == TcReceiver.Exclusive
            return TcHintRoot(node: at, writable: exclusive, binder: TcBinder.Unknown)
        }
        if not self.has_alt(at, Alt.Expr_Name) {
            return none
        }
        let leaf = self.res.first_leaf(at)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Local || b.node < 0 {
            return none
        }
        let t = self.expr_types[at]
        if t >= 0 && (self.kind_of(t) == TcKind.Ref || self.kind_of(t) == TcKind.Slice) {
            return TcHintRoot(node: at, writable: self.types.ty(t).a == 1, binder: TcBinder.Unknown)
        }
        if self.aliasing_bindings[b.node] || tc_contains(&self.borrow_captures, b.node) {
            return none
        }
        if self.captured_by_value(e, b.node) {
            return none
        }
        let binder = self.binder_above(b.node)
        TcHintRoot(node: at, writable: binder == TcBinder.Mutable, binder: binder)
    }

    // Whether a closure around place `e` captures the binding declared at
    // `binding` other than by `[&var x]`: a by-value capture is never written
    // (SL-472), and a shared one never either.
    func captured_by_value(&self, e: Int, binding: Int) -> Bool {
        let declared = self.res.nodes[binding]
        let path = self.path_to(e)
        var k = 0
        while k < path.len() {
            let at = path[k]
            k = k + 1
            if self.closure_index.first(at, 0) < 0 {
                continue
            }
            let span = self.res.nodes[at]
            if declared.start >= span.start && declared.end <= span.end {
                continue
            }
            var exclusive = false
            var j = 0
            while j < self.captures.len() {
                let cap = self.captures[j]
                j = j + 1
                if cap.closure == at && cap.binding == binding && cap.use == TcUse.BorrowVar {
                    exclusive = true
                }
            }
            if not exclusive {
                return true
            }
        }
        false
    }

    // What declares the binding at leaf `binding`: the nearest binding
    // construct above it, as the mutability funnel reads it.
    func binder_above(&self, binding: Int) -> TcBinder {
        let path = self.path_to(binding)
        if path.len() == 0 {
            return TcBinder.Unknown
        }
        var k = path.len()
        while k > 0 {
            k = k - 1
            if let alt = self.node_alt(path[k]) {
                let found = tc_binder_of(alt)
                if found != TcBinder.Unknown {
                    return found
                }
            }
        }
        TcBinder.Let
    }

    // The nodes from the current declaration's node down to node `target`'s
    // parent, found by span, or nothing when `target` lies outside it.
    func path_to(&self, target: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let d = self.current_decl
        if d < 0 || target < 0 {
            return move out
        }
        let goal = self.res.nodes[target]
        var at = self.res.decls[d].node
        var steps = 0
        while at >= 0 && steps < 100000 {
            steps = steps + 1
            try! out.push(at)
            let n = self.child_count(at)
            var next = -1
            var k = 0
            while k < n && next < 0 {
                let c = self.child(at, k)
                k = k + 1
                if c == target {
                    return move out
                }
                if self.is_leaf(c) {
                    continue
                }
                let span = self.res.nodes[c]
                if span.start <= goal.start && goal.end <= span.end {
                    next = c
                }
            }
            at = next
        }
        Vector<Int>()
    }

    // Expression `e` with its parentheses taken off. Each step goes to a
    // child, so the walk ends at the tree's depth.
    func unparenthesized(&self, e: Int) -> Int {
        var at = e
        while self.has_alt(at, Alt.Expr_Paren) {
            let inner = self.res.first_node_child(at)
            if inner < 0 {
                return at
            }
            at = inner
        }
        at
    }

    // Whether expression `e` names a binding that owns its value, which a
    // `move` takes: no reference, no `borrow` binding or borrowed pattern
    // part, and no capture by borrow.
    func owns_binding(&self, e: Int) -> Bool {
        if not self.has_alt(e, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(e)
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Local || b.node < 0 {
            return false
        }
        let t = self.expr_types[e]
        if t >= 0 && (self.kind_of(t) == TcKind.Ref || self.kind_of(t) == TcKind.Slice) {
            return false
        }
        not self.aliasing_bindings[b.node] && not tc_contains(&self.borrow_captures, b.node)
    }

    // A plain binding of the payload of an optional place an accessor lends,
    // which copies it (SL:borrowing §2.4).
    func refuse_lent_copy(&var self, e: Int, t: Int) {
        var msg = StringBuilder()
        try! msg.append("this binding copies the payload of a place an accessor lends, of type `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, which is ")
        try! msg.append(self.tier_word(t))
        try! msg.append(": only a Copy type copies silently; write `borrow let` to bind the payload in place")
        self.refuse(e, "transfer.implicit-copy", msg.build())
    }

    // A bare call of a `consumes` method on a place (spec, `consumes`: "Both
    // ends are marked").
    func refuse_bare_consume(&var self, receiver: Int, d: Int) {
        let m = self.current
        let name_id = self.res.decls[d].name
        let name = self.name_text(name_id)
        let written = self.text(m, receiver)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(name)
        try! msg.append("` consumes its receiver, so the transfer is spelled at the call: write `(move ")
        try! msg.append(written)
        try! msg.append(").")
        try! msg.append(name)
        try! msg.append("(...)`; a temporary receiver needs no `move`")
        self.refuse(receiver, "consumes.move", msg.build())
    }

    func refuse_implicit_without_type(&var self, e: Int, name: Int) {
        let text = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`.")
        try! msg.append(text)
        try! msg.append("` is an implicit member, and nothing here expects a type it could be a case of: write `Enum.")
        try! msg.append(text)
        try! msg.append("`")
        self.refuse(e, "implicit-member.no-type", msg.build())
    }

    func refuse_no_such_case(&var self, e: Int, name: Int, want: Int) {
        var msg = StringBuilder()
        try! msg.append("`.")
        try! msg.append(self.name_text(name))
        try! msg.append("` is no case of the expected `")
        try! msg.append(self.type_text(want))
        try! msg.append("`")
        self.refuse(e, "type.mismatch", msg.build())
    }

    func refuse_payload_needed(&var self, e: Int, c: Int) {
        var msg = StringBuilder()
        try! msg.append("case `")
        try! msg.append(self.res.decl_path(c))
        try! msg.append("` carries a payload, so it is built with its payload: `")
        let name = self.res.decls[c].name
        try! msg.append(self.name_text(name))
        try! msg.append("(...)`")
        self.refuse(e, "call.arity", msg.build())
    }

    func refuse_not_a_value(&var self, e: Int, leaf: Int) {
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.text(m, leaf))
        try! msg.append("` names a type, a module or a trait, not a value")
        self.refuse(e, "type.not-a-value", msg.build())
    }

    func refuse_type_arity(&var self, leaf: Int, d: Int, written: Int) {
        let s = self.sigs[d]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` takes ")
        try! msg.append(s.generic_count)
        try! msg.append(" type arguments, and ")
        try! msg.append(written)
        try! msg.append(" are written")
        self.refuse(leaf, "type.arity", msg.build())
    }

    func refuse_not_a_place(&var self, e: Int) {
        self.refuse(e, "type.not-a-place",
                    "this is a value, not a place: it cannot be assigned, moved from or borrowed exclusively")
    }

    func refuse_unknown_member(&var self, leaf: Int, t: Int) {
        let m = self.current
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no member `")
        try! msg.append(self.text(m, leaf))
        try! msg.append("` this module can see")
        self.refuse(leaf, "member.unknown", msg.build())
    }

    func refuse_no_method(&var self, leaf: Int, t: Int, name: Int) {
        if self.refuse_unmet_member(leaf) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(t))
        try! msg.append("` has no method `")
        try! msg.append(self.name_text(name))
        try! msg.append("` this module can see")
        self.refuse(leaf, "member.unknown", msg.build())
    }

    // The owner member-table entry `k`, found by its type alone, is called
    // at: `owner` when the call names it, else a specialized extension's
    // `Self`, which leaves inference nothing to solve, else -1 for inference
    // to solve.
    func found_owner(&var self, k: Int, owner: Int) -> Int {
        if owner >= 0 {
            return owner
        }
        let ext = self.members[k].ext
        if ext >= 0 && self.head_kind(ext) == TcHeadKind.Specialized {
            return self.ext_self_type(ext)
        }
        return -1
    }

    // Refuses the member the latest lookup dropped because its declaring
    // extension's bound fails for the receiver, naming the bound, and
    // whether there was one (`members_for`).
    func refuse_unmet_member(&var self, at: Int) -> Bool {
        let k = self.unmet_member
        let owner = self.unmet_owner
        if k < 0 {
            return false
        }
        guard let unmet = self.unmet_member_bound(k, owner) else {
            return false
        }
        let member = self.members[k]
        let g = self.generic(member.ext, unmet.index)
        let arg = self.types.arg(owner, unmet.index)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(owner))
        try! msg.append("` has no member `")
        try! msg.append(self.name_text(member.name))
        try! msg.append("`: it is declared where `")
        try! msg.append(self.name_text(g.name))
        try! msg.append(": ")
        try! msg.append(self.res.decl_path(unmet.trait_decl))
        try! msg.append("`, and `")
        try! msg.append(self.type_text(arg))
        try! msg.append("` does not satisfy `")
        try! msg.append(self.res.decl_path(unmet.trait_decl))
        try! msg.append("`")
        self.refuse(at, "type.bound", msg.build())
        true
    }

    func refuse_operand(&var self, e: Int, what: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(", and this is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(e, "operator.undefined", msg.build())
    }

    func refuse_operator_type(&var self, s: Int, op: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(op)
        try! msg.append("` is not defined for `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(s, "operator.undefined", msg.build())
    }

    func refuse_operands_disagree(&var self, e: Int, a: Int, b: Int) {
        var msg = StringBuilder()
        try! msg.append("an operator's operands agree on one type, and these are `")
        try! msg.append(self.type_text(a))
        try! msg.append("` and `")
        try! msg.append(self.type_text(b))
        let hint = self.static_cast_hint(e, a)
        if hint.len() > 0 {
            try! msg.append("`")
            try! msg.append(hint)
        } else {
            try! msg.append("`; convert one with `as`")
        }
        self.refuse(e, "type.mismatch", msg.build())
    }

    func refuse_pattern(&var self, p: Int, what: String, t: Int) {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(": the matched value is `")
        try! msg.append(self.type_text(t))
        try! msg.append("`")
        self.refuse(p, "type.mismatch", msg.build())
    }

    // A candidate's signature for a message: its path, then each
    // parameter's label and type.
    func cand_text(&var self, c: TcCand) -> String {
        var out = StringBuilder()
        try! out.append(self.res.decl_path(c.decl))
        try! out.append("(")
        let count = self.cand_param_count(c)
        var k = 0
        while k < count {
            if k > 0 {
                try! out.append(", ")
            }
            let name = self.cand_param_name(c, k)
            try! out.append(self.name_text(name))
            try! out.append(": ")
            let t = self.cand_param_type(c, k)
            try! out.append(self.type_text(t))
            k = k + 1
        }
        try! out.append(")")
        let d = self.res.decls[c.decl]
        try! out.append(" [")
        try! out.append(self.res.module_name(d.module))
        try! out.append("]")
        out.build()
    }

    // Why the arguments bind to no parameter list of the one candidate.
    func refuse_binding(&var self, e: Int, c: TcCand, args: &TcArgs, status: Int, detail: Int) {
        var msg = StringBuilder()
        var rule = "call.arity"
        if status == TC_BIND_TOO_MANY {
            try! msg.append("too many arguments: ")
            try! msg.append(self.cand_text(c))
            try! msg.append(" takes ")
            try! msg.append(self.cand_param_count(c))
        } else if status == TC_BIND_MISSING {
            try! msg.append("missing an argument for `")
            let name = self.cand_param_name(c, detail)
            try! msg.append(self.name_text(name))
            try! msg.append("` of ")
            try! msg.append(self.cand_text(c))
        } else if status == TC_BIND_UNKNOWN_LABEL {
            rule = "call.label"
            try! msg.append("no parameter is labeled `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` in ")
            try! msg.append(self.cand_text(c))
        } else if status == TC_BIND_BACKWARD {
            rule = "call.label"
            try! msg.append("the label `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` names a parameter before one an earlier argument binds; arguments bind in order in ")
            try! msg.append(self.cand_text(c))
        } else {
            rule = "call.label"
            try! msg.append("the label `")
            try! msg.append(self.name_text(args.labels[detail]))
            try! msg.append("` is written twice in a call of ")
            try! msg.append(self.cand_text(c))
        }
        self.refuse(e, rule, msg.build())
    }

    func refuse_no_match(&var self, e: Int, cands: &Vector<TcCand>, args: &TcArgs) {
        var msg = StringBuilder()
        try! msg.append("no candidate takes these arguments; the candidates are ")
        var k = 0
        while k < cands.len() {
            if k > 0 {
                try! msg.append("; ")
            }
            try! msg.append(self.cand_text(cands[k]))
            k = k + 1
        }
        self.refuse(e, "call.no-match", msg.build())
    }

    func refuse_ambiguous(&var self, e: Int, cands: &Vector<TcCand>, best: &Vector<Int>) {
        var msg = StringBuilder()
        try! msg.append("ambiguous call: these candidates take the arguments equally well, so write labels or type arguments that pick one: ")
        var k = 0
        while k < best.len() {
            if k > 0 {
                try! msg.append("; ")
            }
            try! msg.append(self.cand_text(cands[best[k]]))
            k = k + 1
        }
        self.refuse(e, "call.ambiguous", msg.build())
    }
}
