// The constants a type fixes (spec, Module-level statics, "A static is a
// constant where a constant is required"): an array length, a repeat count,
// a constant generic argument and a const parameter's default may name an
// integer static whose initializer folds, and a length and an argument are
// themselves constant expressions. A type is built while signatures are,
// before any body is typed, and the value comes from the one fold over a
// typed expression (`fold.saw`), so each such static's initializer, each
// array length, each constant argument and each raw-backed case's value is
// typed and folded first, here, ahead of the staged order
// (SL:architecture §3.10).

import sawparse.grammar.{Alt}
import sawresolve.collect.{res_is_top_level}
import sawresolve.kinds.{res_is_type_alt}
import sawresolve.layer.{FrontLayer}
import sawresolve.model.{ResBindKind, ResDeclKind}
import sawtypecheck.arith.{tc_arith_convert, tc_arith_text}
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.candidates.{tc_contains}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.declarations.{tc_build_signatures}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.model.{TC_FLAG_UNSAFE_VAR, TC_LENGTH_PENDING, TcConstPosition, TcStaticTyping, TcStaticVerdict}
import sawtypecheck.program.{TcEvaluateHook, TcProgram, tc_idle_hook}
import sawtypecheck.signatures.{TcArgSlot}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}

// What the walk finds about const parameters that size arrays: the
// declaring leaf of each written bare as a length or a repeat count, and each
// passed bare as an argument, from `params[k]` into parameter `indexes[k]`
// of declaration `targets[k]`; and every array type's length expression,
// `nodes`, and every constant argument written as a value, `arguments`.
struct TcLengthFlow {
    nodes: Vector<Int>
    arguments: Vector<Int>
    lengths: Vector<Int>
    params: Vector<Int>
    targets: Vector<Int>
    indexes: Vector<Int>
}

extension TcLengthFlow: NoCopy {}

// Evaluates every static a type position of `layer`'s modules names, types
// and folds every array length, and readies every raw-backed case, before
// signatures are built.
public func tc_evaluate_constant_statics(p: &var TcProgram, layer: &FrontLayer) {
    p.evaluate_constant_statics(&layer)
}

// Constant `node`, which no one has evaluated yet, evaluated at the moment a
// type being built reads it (`evaluate_hook`): order in the pass's lists does
// not matter, since a constant written inside a type another constant's
// evaluation builds is reached by that build. `node_types[node]` says where
// it stands (-1 not started, `TC_LENGTH_PENDING` under way, a type once
// done); one met under way is a cycle, which its reader refuses once.
// Answers what is left at `node`.
func tc_evaluate_on_demand(p: &var TcProgram, node: Int, pos: TcConstPosition) -> Int {
    let root = p.current_root
    p.evaluate_constant(node, pos)
    p.current_root = root
    p.node_types[node]
}

// What a static's refusal adds, wherever a type fixes a constant.
func tc_static_hint() -> String {
    "; a static is a constant here when it is an immutable static of an integer type whose own initializer folds"
}

extension TcProgram {
    // Each array length folded, each static named where a type fixes a
    // constant evaluated in turn (the statics its initializer names first),
    // and each raw-backed case's value readied: a case is named from a body
    // that precedes its enum, and a body cannot ready one on demand.
    // The same walk records each const parameter that sizes an array.
    func evaluate_constant_statics(&var self, layer: &FrontLayer) {
        var found = Vector<Int>()
        var flow = TcLengthFlow(nodes: Vector<Int>(), arguments: Vector<Int>(), lengths: Vector<Int>(),
                                params: Vector<Int>(), targets: Vector<Int>(), indexes: Vector<Int>())
        var m = layer.module_first
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && not info.interface_only {
                self.collect_constant_statics(info.root, false, &var found, &var flow)
            }
            m = m + 1
        }
        self.record_length_params(&flow)
        self.constants_running = true
        self.evaluate_hook = TcEvaluateHook(run: tc_evaluate_on_demand)
        var k = 0
        while k < flow.nodes.len() {
            self.evaluate_length(flow.nodes[k])
            k = k + 1
        }
        k = 0
        while k < flow.arguments.len() {
            self.evaluate_argument(flow.arguments[k])
            k = k + 1
        }
        k = 0
        while k < found.len() {
            self.evaluate_static(found[k])
            k = k + 1
        }
        m = layer.module_first
        while m < self.res.modules.len() {
            let info = self.res.modules[m]
            if info.available && not info.interface_only {
                self.evaluate_module_cases(info.decl_first, info.decl_count)
            }
            m = m + 1
        }
        self.constants_running = false
        self.evaluate_hook = tc_idle_hook()
    }

    // Each case among declarations `first` for `count` that states a raw
    // value, evaluated; a case of an enum with no integer backing is left to
    // its own declaration.
    func evaluate_module_cases(&var self, first: Int, count: Int) {
        var d = first
        while d < first + count {
            if self.res.decls[d].kind == ResDeclKind.Case && self.raw_value_node(d) >= 0 {
                self.evaluate_raw_case(d)
            }
            d = d + 1
        }
    }

    // Every static node `e` names where a type fixes a constant, into `out`:
    // under a type, a generic parameter, a repeat count and a call head's
    // type arguments. `inside` says `e` is in such a position. The declaring
    // leaf of each type parameter written bare as a length or a repeat count
    // goes into `lengths`.
    func collect_constant_statics(&self, e: Int, inside: Bool, out: &var Vector<Int>, flow: &var TcLengthFlow) {
        if e < 0 {
            return
        }
        if self.has_alt(e, Alt.Type_Array) {
            let length = self.res.last_node_child(e)
            if length >= 0 {
                try! flow.nodes.push(length)
            }
        }
        if self.has_alt(e, Alt.Type_Array) || self.has_alt(e, Alt.Expr_Repeat) {
            let param = self.bare_param(self.res.last_node_child(e))
            if param >= 0 && not tc_contains(&flow.lengths, param) {
                try! flow.lengths.push(param)
            }
        }
        if self.has_alt(e, Alt.Type_Named) || self.has_alt(e, Alt.Expr_Name) {
            self.collect_parameter_flows(e, &var flow)
        }
        self.collect_value_arguments(e, &var flow)
        if self.is_leaf(e) {
            if inside {
                let d = self.static_bound(e)
                if d >= 0 && not tc_contains(&out, d) {
                    try! out.push(d)
                }
            }
            return
        }
        let here = inside || res_is_type_alt(self.node_alt(e)) || self.has_alt(e, Alt.Generic_Param_Const)
        let count = if self.has_alt(e, Alt.Expr_Repeat) { self.res.last_node_child(e) } else { -1 }
        let head = self.has_alt(e, Alt.Expr_Name) || self.has_alt(e, Alt.Expr_Member)
        let base = if self.has_alt(e, Alt.Expr_Member) { self.res.first_node_child(e) } else { -1 }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            let argument = head && c != base && not self.is_leaf(c)
            self.collect_constant_statics(c, here || c == count || argument, &var out, &var flow)
        }
    }

    // Each constant argument `e` writes as a value, into `flow.arguments`.
    func collect_value_arguments(&self, e: Int, flow: &var TcLengthFlow) {
        let found = self.value_arguments(e)
        var k = 0
        while k < found.len() {
            try! flow.arguments.push(found[k])
            k = k + 1
        }
    }

    // The constant arguments node `e` writes as values: those of a type
    // applied (`Buf<N + 1>`), of a call's head and of a member's, and a const
    // parameter's default. A type-spelled one is the generic-argument
    // classifier's.
    func value_arguments(&self, e: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let member = self.has_alt(e, Alt.Expr_Member)
        let holds = self.has_alt(e, Alt.Type_Named) || self.has_alt(e, Alt.Expr_Name) || member || self.has_alt(e, Alt.Generic_Param_Const)
        if not holds {
            return move out
        }
        let base = if member { self.res.first_node_child(e) } else { -1 }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            // A named type's own path is no argument; a path alone as one is a
            // type, which the classifier reads.
            if c != base && not self.is_leaf(c) && not res_is_type_alt(self.node_alt(c)) && not self.has_alt(c, Alt.Type_Path) {
                try! out.push(c)
            }
        }
        move out
    }

    // Each const parameter that sizes an array: one written bare as a
    // length or a repeat count, and, to a fixed point, one passed bare to
    // another declaration's parameter that sizes one, so a negative argument
    // is refused where it is written however far it is passed on.
    func record_length_params(&var self, flow: &TcLengthFlow) {
        var k = 0
        while k < flow.lengths.len() {
            self.add_length_param(flow.lengths[k])
            k = k + 1
        }
        var grew = true
        while grew {
            grew = false
            k = 0
            while k < flow.params.len() {
                let p = flow.params[k]
                let owner = self.param_owner(p)
                let index = self.param_index(p)
                if owner >= 0 && self.is_length_param(flow.targets[k], flow.indexes[k]) && not self.is_length_param(owner, index) {
                    self.add_length_param(p)
                    grew = true
                }
                k = k + 1
            }
        }
    }

    func add_length_param(&var self, leaf: Int) {
        let owner = self.param_owner(leaf)
        let index = self.param_index(leaf)
        if owner >= 0 && index >= 0 && not self.is_length_param(owner, index) {
            try! self.length_param_owners.push(owner)
            try! self.length_param_indexes.push(index)
        }
    }

    // The declaring leaf of the type parameter node `e` names bare, or -1.
    func bare_param(&self, e: Int) -> Int {
        if e < 0 || self.child_count(e) > 1 {
            return -1
        }
        // A type-spelled argument is a path inside the named type.
        let leaf = if self.has_alt(e, Alt.Type_Named) { self.res.last_leaf_of(self.child(e, 0)) } else { self.res.first_leaf(e) }
        if leaf < 0 {
            return -1
        }
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.TypeParam {
            return -1
        }
        b.node
    }

    // Each type parameter written bare as an argument of the generic type or
    // function `e` names (`Buf<M>`, `fill<M>()`): a flow from that parameter
    // into the target's parameter at the argument's place.
    func collect_parameter_flows(&self, e: Int, flow: &var TcLengthFlow) {
        let named = self.has_alt(e, Alt.Type_Named)
        let leaf = if named { self.res.last_leaf_of(self.child(e, 0)) } else { self.res.first_leaf(e) }
        if leaf < 0 {
            return
        }
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return
        }
        let kind = self.res.decls[b.decl].kind
        if kind != ResDeclKind.Struct && kind != ResDeclKind.Enum && kind != ResDeclKind.Func {
            return
        }
        let first = if named { 1 } else { 0 }
        var index = 0
        let n = self.child_count(e)
        var k = first
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) {
                continue
            }
            let param = self.bare_param(c)
            if param >= 0 {
                try! flow.params.push(param)
                try! flow.targets.push(b.decl)
                try! flow.indexes.push(index)
            }
            index = index + 1
        }
    }

    // Readies what initializer `e` of declaration `owner` names before it is
    // typed ahead: each static is evaluated first, each raw-backed case's
    // value typed, and every other declaration's signature built, since no
    // signature is built yet.
    func prepare_ahead(&var self, e: Int, owner: Int) {
        if e < 0 {
            return
        }
        if self.is_leaf(e) {
            let b = self.binding_at(e)
            if (b.kind != ResBindKind.Decl && b.kind != ResBindKind.Case) || b.decl < 0 || b.decl == owner {
                return
            }
            let kind = self.res.decls[b.decl].kind
            if kind == ResDeclKind.Static {
                self.evaluate_static(b.decl)
            } else if kind == ResDeclKind.Case {
                self.evaluate_raw_case(b.decl)
            } else {
                self.build_ready(b.decl)
            }
            return
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            self.prepare_ahead(c, owner)
        }
    }

    // Raw-backed case `c`'s value, typed ahead after what it names, so a
    // fold through the case reads a typed value. A case of an enum with no
    // raw backing has none, and is no constant.
    func evaluate_raw_case(&var self, c: Int) {
        if self.static_typing[c] != TcStaticTyping.Untyped {
            return
        }
        let parent = self.res.decls[c].parent
        if parent < 0 {
            return
        }
        self.build_ready(parent)
        self.build_ready(c)
        let backing = self.sigs[parent].result
        let value = self.raw_value_node(c)
        if backing < 0 || not self.is_integer(backing) || value < 0 || not self.constant_shape(value) {
            return
        }
        self.static_typing[c] = TcStaticTyping.Typing
        self.prepare_ahead(value, c)
        self.type_raw_case_ahead(c)
        self.static_typing[c] = TcStaticTyping.Typed
    }

    // Declaration `d`'s signature, built once every array length its types
    // hold is typed, since a type built earlier would take the small folder.
    // A type alias named in them is read through, as building one builds its
    // type.
    // ENTRY POINTS:
    //     prepare_ahead
    //     evaluate_raw_case
    //     evaluate_static
    func build_ready(&var self, d: Int) {
        var seen = Vector<Int>()
        try! seen.push(d)
        self.ready_lengths(self.res.decls[d].node, &var seen)
        self.build_decl(d)
    }

    // Each array length under node `e`, evaluated, and through each alias
    // `e` names, `seen` the declarations walked.
    func ready_lengths(&var self, e: Int, seen: &var Vector<Int>) {
        if e < 0 {
            return
        }
        if self.is_leaf(e) {
            let b = self.binding_at(e)
            if b.kind == ResBindKind.Decl && b.decl >= 0 && not tc_contains(&seen, b.decl) {
                let kind = self.res.decls[b.decl].kind
                if kind == ResDeclKind.Alias || kind == ResDeclKind.TypeAssign {
                    try! seen.push(b.decl)
                    self.ready_lengths(self.res.decls[b.decl].node, &var seen)
                }
            }
            return
        }
        if self.has_alt(e, Alt.Type_Array) {
            self.evaluate_length(self.res.last_node_child(e))
        }
        let arguments = self.value_arguments(e)
        var j = 0
        while j < arguments.len() {
            self.evaluate_argument(arguments[j])
            j = j + 1
        }
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            self.ready_lengths(c, &var seen)
        }
    }

    // Array length expression `node`, typed ahead, folded by the
    // constant-position funnel and left as its length type at `node` in
    // `node_types`, where `build_type` reads it (`array_length`).
    func evaluate_length(&var self, node: Int) {
        self.evaluate_constant(node, TcConstPosition.Length)
    }

    // Constant argument `node`, a value written in a generic list or as a
    // const parameter's default, evaluated as a length is: its constant type
    // is left at `node` for `generic_arg`.
    func evaluate_argument(&var self, node: Int) {
        self.evaluate_constant(node, TcConstPosition.Argument)
    }

    // THE AHEAD-EVALUATION FUNNEL: expression `node` at position `pos`, a
    // length or an argument, typed and folded before signatures, and left as
    // the constant type it stands for, a const parameter's type, or the error
    // type once refused. One the constant grammar does not shape (a const
    // parameter's, a local's), one that names a static that is no constant,
    // and one the fold leaves unfolded are `const_parameter_value`'s.
    // ENTRY POINTS:
    //     evaluate_length
    //     evaluate_argument
    func evaluate_constant(&var self, node: Int, pos: TcConstPosition) {
        if node < 0 || self.node_types[node] != -1 {
            return
        }
        if self.bare_const_parameter(node) >= 0 {
            self.node_types[node] = self.parameter_value_in_module(node, pos)
            return
        }
        if not self.shaped(node, pos == TcConstPosition.Length, true) {
            self.node_types[node] = self.parameter_value_in_module(node, pos)
            return
        }
        self.node_types[node] = TC_LENGTH_PENDING
        self.prepare_ahead(node, -1)
        var constant = -1
        if not self.names_unfolded_static(node) {
            constant = self.type_constant_ahead(node, pos)
        }
        if constant < 0 {
            constant = self.parameter_value_in_module(node, pos)
        }
        self.node_types[node] = constant
    }

    // `const_parameter_value` for `node`, in the module that holds it, which
    // no body is open around.
    func parameter_value_in_module(&var self, node: Int, pos: TcConstPosition) -> Int {
        let saved = self.save_context()
        self.enter_module(self.node_module(node))
        let v = self.const_parameter_value(node, pos)
        self.restore_context(saved)
        v
    }

    // Whether expression `e` names a static whose verdict is neither a folded
    // value nor a value past `Int`, which the fold reports by its own
    // position's wording.
    func names_unfolded_static(&self, e: Int) -> Bool {
        self.unfolded_static_leaf(e, true) >= 0
    }

    // Static `d`'s verdict where a type fixes a constant, its initializer
    // typed and folded, after the statics it names. One already being
    // evaluated is on a cycle, which its own declaration refuses. One an
    // earlier layer's body phase typed, since none of that layer's types
    // named it, is folded as it was typed.
    func evaluate_static(&var self, d: Int) {
        if self.static_verdicts[d] != TcStaticVerdict.Unevaluated {
            return
        }
        let typed = self.static_typing[d] == TcStaticTyping.Typed
        if self.static_typing[d] != TcStaticTyping.Untyped && not typed {
            return
        }
        self.build_ready(d)
        let s = self.sigs[d]
        let info = self.res.decls[d]
        let m = info.module
        let name = self.text(m, self.decl_site(d))
        if s.result < 0 || self.has_error(s.result) {
            self.static_verdicts[d] = TcStaticVerdict.Poisoned
            return
        }
        if (s.flags & TC_FLAG_UNSAFE_VAR) != 0 {
            self.static_refused(d, "the mutable static `", &name, "` is not allowed here")
            return
        }
        if not self.is_integer(s.result) {
            var what = StringBuilder()
            try! what.append("the `")
            try! what.append(self.type_text(s.result))
            try! what.append("` static `")
            self.static_refused(d, what.build(), &name, "` is not allowed here")
            return
        }
        let value = self.static_initializer(d)
        if value < 0 {
            self.static_refused(d, "the static `", &name, "` is declared without an initializer, so it is not allowed here")
            return
        }
        if not self.constant_shape(value) {
            self.static_refused(d, "the static `", &name, "`'s initializer is not a constant expression")
            return
        }
        if not typed {
            self.static_typing[d] = TcStaticTyping.Typing
            self.prepare_ahead(value, d)
        }
        let before = self.diags.len()
        if not typed {
            self.type_static_ahead(d)
            self.static_typing[d] = TcStaticTyping.Typed
        }
        if self.refused_within(value) {
            // Its own declaration says why it is no constant, once.
            self.static_verdicts[d] = TcStaticVerdict.Poisoned
            return
        }
        let v = self.fold_constant(value)
        if not v.ok || self.diags.len() > before {
            self.static_refused(d, "the static `", &name, "`'s initializer does not fold")
            return
        }
        let int_t = self.int_type()
        let r = tc_arith_convert(v.bits, self.int_width(v.ty), not self.is_unsigned(v.ty), self.int_width(int_t), true)
        if not r.ok {
            var why = StringBuilder()
            try! why.append("the static `")
            try! why.append(name)
            try! why.append("` is ")
            try! why.append(tc_arith_text(v.bits, self.int_width(v.ty), not self.is_unsigned(v.ty)))
            try! why.append(", which does not fit `Int`")
            self.static_reasons[d] = why.build()
            self.static_verdicts[d] = TcStaticVerdict.Unfit
            return
        }
        self.static_values[d] = r.bits
        self.static_verdicts[d] = TcStaticVerdict.Folds
    }

    // Records static `d` as no constant, for the reason `lead`, its name and
    // `rest` spell.
    func static_refused(&var self, d: Int, lead: String, name: &String, rest: String) {
        var why = StringBuilder()
        try! why.append(lead)
        try! why.append(name)
        try! why.append(rest)
        try! why.append(tc_static_hint())
        self.static_reasons[d] = why.build()
        self.static_verdicts[d] = TcStaticVerdict.NotConstant
    }

    // Whether initializer `e` is shaped as an integer constant: integer
    // literals, `#line`, statics, raw-backed cases and the integer limits, under the
    // arithmetic and bit operators, casts, `sizeof`, `alignof` and a type
    // alias's construction. Only such an initializer is typed ahead, since
    // nothing in it asks a conformance or a member table, neither of which
    // exists before signatures (a comparison would ask `Equatable`, and can
    // only make a `Bool`); any other is no integer constant, which its own
    // declaration refuses.
    func constant_shape(&var self, e: Int) -> Bool {
        self.shaped(e, false, false)
    }

    // `constant_shape`, and with `bools` the `Bool` forms an array length may
    // be written with, which the funnel refuses by name: `true`, `false`,
    // `not`, `&&`, `||` and a comparison of constant-shaped operands. A
    // comparison between integers needs no conformance. With `params` a const
    // parameter is a leaf too.
    func shaped(&var self, e: Int, bools: Bool, params: Bool) -> Bool {
        if e < 0 {
            return false
        }
        guard let alt = self.node_alt(e) else {
            return false
        }
        match alt {
            case Expr_Int -> true,
            case Expr_SourceLocation_Line -> true,
            case Expr_Bool_True -> bools,
            case Expr_Bool_False -> bools,
            case Expr_Unary_Not -> bools && self.shaped_parts(e, bools, params),
            case Expr_And -> bools && self.shaped_parts(e, bools, params),
            case Expr_Or -> bools && self.shaped_parts(e, bools, params),
            case Expr_Compare_Pair -> bools && self.shaped_pair(e, bools, params),
            case Expr_Paren -> self.shaped_parts(e, bools, params),
            case Expr_Unary_Negate -> self.shaped_parts(e, bools, params),
            case Expr_Unary_Complement -> self.shaped_parts(e, bools, params),
            case Expr_Additive -> self.shaped_parts(e, bools, params),
            case Expr_Multiplicative -> self.shaped_parts(e, bools, params),
            case Expr_Shift -> self.shaped_parts(e, bools, params),
            case Expr_Bitand -> self.shaped_parts(e, bools, params),
            case Expr_Bitor -> self.shaped_parts(e, bools, params),
            case Expr_Bitxor -> self.shaped_parts(e, bools, params),
            case Expr_Cast -> self.shaped_parts(e, bools, params),
            case Const_Expr -> self.shaped_parts(e, bools, params),
            case Const_Term -> self.shaped_parts(e, bools, params),
            case Const_Negate -> self.shaped_parts(e, bools, params),
            case Const_LayoutQuery_Size -> true,
            case Const_LayoutQuery_Align -> true,
            case Type_Path -> self.constant_shaped_path(e) || (params && self.const_param_leaf(self.res.last_leaf_of(e))),
            case Expr_Name -> {
                let leaf = self.res.first_leaf(e)
                self.static_bound(leaf) >= 0 || (params && self.const_param_leaf(leaf))
            },
            case Expr_Member -> self.constant_shaped_member(e),
            case Expr_Call_Paren -> self.constant_shaped_call(e, params),
            case _ -> false
        }
    }

    // Whether `leaf` binds a const parameter.
    func const_param_leaf(&var self, leaf: Int) -> Bool {
        if leaf < 0 {
            return false
        }
        let b = self.binding_at(leaf)
        if b.kind != ResBindKind.TypeParam {
            return false
        }
        let owner = self.param_owner(b.node)
        let index = self.param_index(b.node)
        owner >= 0 && index >= 0 && self.target_param_is_const(owner, index)
    }

    // Whether comparison `e`'s two operands are shaped; the operator between
    // them is a node of its own.
    func shaped_pair(&var self, e: Int, bools: Bool, params: Bool) -> Bool {
        self.shaped(self.res.first_node_child(e), bools, params) && self.shaped(self.res.last_node_child(e), bools, params)
    }

    // Whether each expression child of `e` is shaped; a type among them, a
    // cast's, is no part.
    func shaped_parts(&var self, e: Int, bools: Bool, params: Bool) -> Bool {
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if self.is_leaf(c) || res_is_type_alt(self.node_alt(c)) {
                continue
            }
            if not self.shaped(c, bools, params) {
                return false
            }
        }
        true
    }

    // A path atom of a constant generic argument: a static, or a case of an
    // enum, named through its module or its type.
    func constant_shaped_path(&self, e: Int) -> Bool {
        let leaf = self.res.last_leaf_of(e)
        if leaf < 0 {
            return false
        }
        if self.static_bound(leaf) >= 0 {
            return true
        }
        let b = self.binding_at(leaf)
        (b.kind == ResBindKind.Case || b.kind == ResBindKind.Decl) && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Case
    }

    // `m.S`, a static named through its module; `E.Case`; `Int.max`.
    func constant_shaped_member(&self, e: Int) -> Bool {
        let leaf = self.res.last_leaf_of(e)
        if leaf < 0 {
            return false
        }
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Decl && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Static {
            return true
        }
        if (b.kind == ResBindKind.Case || b.kind == ResBindKind.Decl) && b.decl >= 0 && self.res.decls[b.decl].kind == ResDeclKind.Case {
            return true
        }
        let text = self.text(self.node_module(e), leaf)
        let base = self.res.first_node_child(e)
        let bb = self.binding_at(self.res.first_leaf(base))
        (text.equals("max") || text.equals("min")) && bb.kind == ResBindKind.Decl && bb.decl >= 0
    }

    // `sizeof<T>()`, `alignof<T>()`, and a type alias's construction over a
    // constant-shaped argument.
    func constant_shaped_call(&var self, e: Int, params: Bool) -> Bool {
        let callee = self.res.first_node_child(e)
        if callee < 0 || not self.has_alt(callee, Alt.Expr_Name) {
            return false
        }
        let leaf = self.res.first_leaf(callee)
        let b = self.binding_at(leaf)
        if b.kind == ResBindKind.Overload && b.module == self.res.builtin {
            let text = self.text(self.node_module(e), leaf)
            return text.equals("sizeof") || text.equals("alignof")
        }
        if b.kind != ResBindKind.Decl || b.decl < 0 {
            return false
        }
        let kind = self.res.decls[b.decl].kind
        if kind != ResDeclKind.Alias && kind != ResDeclKind.TypeAssign {
            return false
        }
        var args = 0
        let n = self.child_count(e)
        var k = 0
        while k < n {
            let c = self.child(e, k)
            k = k + 1
            if c == callee || self.is_leaf(c) {
                continue
            }
            args = args + 1
            let value = if self.has_alt(c, Alt.Expr_Argument_Positional) { self.res.first_node_child(c) } else { c }
            if not self.shaped(value, false, params) {
                return false
            }
        }
        args == 1
    }
}
