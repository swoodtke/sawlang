// The Copy-tier classifier and bound satisfaction. One function,
// `tier_of_decl`, classifies a nominal type as Copy, ExplicitCopy or NoCopy
// from its declared policy, else from its members; for a generic type the
// answer is a rule over its arguments, which monomorphization evaluates
// (design 219).
//
// `satisfies` answers whether a type meets a bound, for every kind of type an
// argument can be, primitives included (design 109).

import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResDecl, ResDeclKind, ResModuleKind}
import sawtypecheck.conform.{TcSubst}
import sawtypecheck.model.{TC_EFFECT_SENDABLE, TC_TIER_COPY, TC_TIER_EXPLICIT, TC_TIER_NOCOPY, TcConformance,
                               TcGeneric, TcObligation, TcSig, TcTier, TcUse}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.types.{TC_HOLDS_ERROR, TcKind, TcType}
import sawtypecheck.walks.{TC_INSTANTIATION_DEPTH, TC_WALK_CELL, TC_WALK_DEPTH_REFUSED, TC_WALK_NO_MOVE,
                           TC_WALK_TRIVIAL, TcMemo, tc_memo}

// Every nominal type's Copy tier.
public func tc_compute_tiers(p: &var TcProgram) {
    p.compute_tiers()
}

// Every type argument against its bound.
public func tc_check_obligations(p: &var TcProgram) {
    p.check_obligations()
}

// The containment rules: the Copy policy's, and `NoMove`'s declared
// cascade with the policy it requires.
public func tc_check_containment(p: &var TcProgram) {
    p.check_containment()
    p.check_no_move_declarations()
}

static TC_TIER_UNSEEN: Int = 0
static TC_TIER_COMPUTING: Int = 1
static TC_TIER_DONE: Int = 2
// A tier rule's mask holds one bit per parameter index below this.
static TC_MASK_BITS: Int = 62
// A declaration's inline rule while it is being built.
static TC_RULE_BUILDING: Int = -2
// A `satisfies` pair's state past the frame indices: decided, either way,
// or true while a frame it leaned on is open, that frame's index below
// TC_SATISFY_LEANING.
static TC_SATISFY_FALSE: Int = -2
static TC_SATISFY_TRUE: Int = -3
static TC_SATISFY_LEANING: Int = -4
// A run's lowest frame reached back to, when no cycle has reached any.
static TC_SATISFY_NO_LOW: Int = 0x7FFF_FFFF_FFFF

extension TcTier {
    public init(base: Int, mask: Int, declared: Bool) -> TcTier {
        TcTier(state: TC_TIER_DONE, base: base, mask: mask, declared: declared)
    }
}

public func tc_max(a: Int, b: Int) -> Int {
    if a > b {
        return a
    }
    b
}

// The mask bit of parameter index `k`, or 0 past the mask's width.
public func tc_bit(k: Int) -> Int {
    if k < 0 || k >= TC_MASK_BITS {
        return 0
    }
    1 << k
}

extension TcProgram {
    // Every nominal type's tier, in declaration order.
    public func compute_tiers(&var self) {
        var k = 0
        while k < self.res.decls.len() {
            try! self.tiers.push(TcTier(state: TC_TIER_UNSEEN, base: TC_TIER_COPY, mask: 0,
                                        declared: false))
            k = k + 1
        }
        k = 0
        while k < self.res.decls.len() {
            if self.is_nominal(k) {
                let _ = self.tier_of_decl(k)
            }
            k = k + 1
        }
    }

    // The policy nominal `d` declares by conformance, or -1 for none. A type
    // declares one (`copy.second-policy`); the order NoCopy, then Copy, then
    // ExplicitCopy answers for a type that declares more, so the rest of a
    // refused program is still checked against one tier. A policy declared
    // outside the type's file counts for nothing.
    public func declared_policy(&self, d: Int) -> Int {
        var found = -1
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            if c.type_decl == d && self.policy_in_place(k) {
                if c.trait_decl == self.known.no_copy {
                    return TC_TIER_NOCOPY
                }
                if c.trait_decl == self.known.copy {
                    found = TC_TIER_COPY
                } else if c.trait_decl == self.known.explicit_copy && found < 0 {
                    found = TC_TIER_EXPLICIT
                }
            }
            k = k + 1
        }
        found
    }

    // Nominal `d`'s tier. A declared policy is uniform over the arguments;
    // an undeclared type joins its members, and a member reaching back to a
    // type being classified adds nothing of its own, since a pointer closes
    // any cycle a finite type has.
    public func tier_of_decl(&var self, d: Int) -> TcTier {
        let known = self.tiers[d]
        if known.state == TC_TIER_DONE {
            return known
        }
        if known.state == TC_TIER_COMPUTING {
            return TcTier(base: TC_TIER_COPY, mask: 0, declared: false)
        }
        var marking = known
        marking.state = TC_TIER_COMPUTING
        self.tiers[d] = marking
        let result = self.classify(d)
        self.tiers[d] = result
        result
    }

    func classify(&var self, d: Int) -> TcTier {
        let declared = self.declared_policy(d)
        if declared >= 0 {
            return TcTier(base: declared, mask: 0, declared: true)
        }
        let info = self.res.decls[d]
        if d == self.known.optional {
            return TcTier(base: TC_TIER_COPY, mask: tc_bit(0), declared: false)
        }
        if d == self.known.result {
            return TcTier(base: TC_TIER_COPY, mask: tc_bit(0) | tc_bit(1), declared: false)
        }
        if info.kind == ResDeclKind.Primitive || info.node < 0 {
            return TcTier(base: TC_TIER_COPY, mask: 0, declared: false)
        }
        var base = TC_TIER_COPY
        var mask = 0
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            let mi = self.res.decls[m]
            if mi.kind == ResDeclKind.Field {
                let s = self.sigs[m]
                if s.result >= 0 {
                    let part = self.member_tier(s.result, d)
                    base = tc_max(base, part.base)
                    mask = mask | part.mask
                }
            } else if mi.kind == ResDeclKind.Case {
                let s = self.sigs[m]
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    let part = self.member_tier(p.ty, d)
                    base = tc_max(base, part.base)
                    mask = mask | part.mask
                    j = j + 1
                }
            }
            k = k + 1
        }
        TcTier(base: base, mask: mask, declared: false)
    }

    // The tier type `t` contributes to type `cls`, whose parameters it may
    // name: a rule over `cls`'s parameters, joined with every part's.
    public func type_tier(&var self, t: Int, cls: Int) -> TcTier {
        var parts = tc_memo()
        self.type_tier_in(t, cls, &var parts)
    }

    // One part of `type_tier`. Each part's tier is kept for the one call,
    // since a tier read while its declaration is classified is not final.
    func type_tier_in(&var self, t: Int, cls: Int, parts: &var TcMemo) -> TcTier {
        let known = parts.get(t, 0)
        if known >= 0 {
            return TcTier(base: known, mask: parts.get(t, 1), declared: false)
        }
        let tier = self.type_tier_of(t, cls, &var parts)
        parts.set(t, 0, tier.base)
        parts.set(t, 1, tier.mask)
        tier
    }

    func type_tier_of(&var self, t: Int, cls: Int, parts: &var TcMemo) -> TcTier {
        let info = self.types.ty(t)
        match info.kind {
            case Nominal -> {
                let rule = self.tier_of_decl(info.decl)
                var base = rule.base
                var mask = 0
                var k = 0
                while k < info.count {
                    if (rule.mask & tc_bit(k)) != 0 {
                        let arg = self.types.arg(t, k)
                        let part = self.type_tier_in(arg, cls, &var parts)
                        base = tc_max(base, part.base)
                        mask = mask | part.mask
                    }
                    k = k + 1
                }
                TcTier(base: base, mask: mask, declared: false)
            },
            case Param -> {
                if info.decl == cls {
                    return TcTier(base: TC_TIER_COPY, mask: tc_bit(info.a), declared: false)
                }
                TcTier(base: TC_TIER_NOCOPY, mask: 0, declared: false)
            },
            case Tuple -> {
                var base = TC_TIER_COPY
                var mask = 0
                var k = 0
                while k < info.count {
                    let arg = self.types.arg(t, k)
                    let part = self.type_tier_in(arg, cls, &var parts)
                    base = tc_max(base, part.base)
                    mask = mask | part.mask
                    k = k + 1
                }
                TcTier(base: base, mask: mask, declared: false)
            },
            case Array -> self.type_tier_in(info.b, cls, &var parts),
            case Any -> TcTier(base: TC_TIER_NOCOPY, mask: 0, declared: false),
            case SelfType -> TcTier(base: TC_TIER_NOCOPY, mask: 0, declared: false),
            case Projection -> TcTier(base: TC_TIER_NOCOPY, mask: 0, declared: false),
            case _ -> TcTier(base: TC_TIER_COPY, mask: 0, declared: false)
        }
    }

    // The type a member of type `t` contributes: an interior-mutability cell
    // field contributes its payload's tier, since the cell's own NoCopy is
    // for the cell as a value, and the holder states its own policy.
    public func member_type(&self, t: Int) -> Int {
        let info = self.types.ty(t)
        if info.kind == TcKind.Nominal && info.decl == self.known.interior && info.count > 0 {
            return self.types.arg(t, 0)
        }
        t
    }

    // `type_tier` of what a member of type `t` contributes to `cls`.
    public func member_tier(&var self, t: Int, cls: Int) -> TcTier {
        let contributed = self.member_type(t)
        self.type_tier(contributed, cls)
    }

    // Whether a struct field of type `t` is of a declared Copy type, directly
    // or as a fixed array's element: a retain hook, which an undeclared struct
    // may not absorb silently. A tuple, an optional and an enum's payload
    // carry one without a declaration. `String` is the exception even where
    // std declares its Copy: its retain is the compiler's own, so the spec
    // puts a `String` field on the automatic tier. The tier table keeps
    // recording that declaration, since it answers what a type declares and
    // not whose retain it is.
    func holds_declared_copy(&var self, t: Int) -> Bool {
        let info = self.types.ty(t)
        if info.kind == TcKind.Nominal {
            if info.decl == self.known.string {
                return false
            }
            let rule = self.tier_of_decl(info.decl)
            return rule.declared && rule.base == TC_TIER_COPY
        }
        if info.kind == TcKind.Array {
            return self.holds_declared_copy(info.b)
        }
        false
    }

    // A struct or enum holding an ExplicitCopy or NoCopy member, or a struct
    // with a field of a declared Copy type, declares its own policy (spec, The
    // Copy Trait Family, "Containment").
    public func check_containment(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            let own = info.kind == ResDeclKind.Struct || info.kind == ResDeclKind.Enum
            if own && info.node >= 0 && self.declared_policy(d) < 0 {
                self.check_members_policy(d)
            }
            d = d + 1
        }
    }

    func check_members_policy(&var self, d: Int) {
        let is_struct = self.res.decls[d].kind == ResDeclKind.Struct
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            let mi = self.res.decls[m]
            var types = Vector<Int>()
            let s = self.sigs[m]
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                try! types.push(s.result)
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    try! types.push(p.ty)
                    j = j + 1
                }
            }
            var j = 0
            while j < types.len() {
                let t = types[j]
                let part = self.member_tier(t, d)
                let contributed = self.member_type(t)
                if part.base > TC_TIER_COPY || (is_struct && self.holds_declared_copy(contributed)) {
                    self.refuse_undeclared_policy(d, m, t, part.base)
                    return
                }
                j = j + 1
            }
            k = k + 1
        }
    }

    func refuse_undeclared_policy(&var self, d: Int, member: Int, t: Int, base: Int) {
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` holds `")
        try! msg.append(self.res.decl_path(member))
        try! msg.append("` of type `")
        try! msg.append(self.type_text(t))
        if base == TC_TIER_NOCOPY {
            try! msg.append("`, which is NoCopy")
        } else if base == TC_TIER_EXPLICIT {
            try! msg.append("`, which is ExplicitCopy")
        } else {
            try! msg.append("`, which declares Copy")
        }
        try! msg.append(", so it declares its own policy: `extension ")
        try! msg.append(self.name_text(info.name))
        try! msg.append(": NoCopy \{\}`, or `@synthesize` an ExplicitCopy")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "copy.undeclared-policy", msg.build())
    }
}

// Relocation: the `NoMove` axis, apart from the Copy tier.
extension TcProgram {
    // The declaration side of design 188: `NoMove` stands only beside a
    // declared `NoCopy`, and a struct or enum holding a `NoMove` value inline
    // declares `NoMove` itself, so no field's movability changes a type
    // behind its author's back (spec, The `NoMove` trait). A generic holding
    // a type parameter derives it per instance instead.
    public func check_no_move_declarations(&var self) {
        let tr = self.known.no_move
        if tr < 0 {
            return
        }
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.trait_decl == tr && c.type_decl >= 0 && self.policy_in_place(k - 1) && self.declared_policy(c.type_decl) != TC_TIER_NOCOPY {
                self.refuse_no_move_policy(c)
            }
        }
        var d = 0
        while d < self.res.decls.len() {
            let info = self.res.decls[d]
            let own = info.kind == ResDeclKind.Struct || info.kind == ResDeclKind.Enum
            if own && info.node >= 0 && not self.declares_no_move(d) {
                self.check_members_no_move(d)
            }
            d = d + 1
        }
    }

    // Whether type `d` declares `NoMove` in its defining file.
    func declares_no_move(&self, d: Int) -> Bool {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            if c.type_decl == d && c.trait_decl == self.known.no_move && self.policy_in_place(k) {
                return true
            }
            k = k + 1
        }
        false
    }

    func check_members_no_move(&var self, d: Int) {
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            var types = Vector<Int>()
            let s = self.sigs[m]
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                try! types.push(s.result)
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    try! types.push(p.ty)
                    j = j + 1
                }
            }
            var j = 0
            while j < types.len() {
                let t = types[j]
                j = j + 1
                if self.is_no_move(t) {
                    self.refuse_undeclared_no_move(d, m, t)
                    return
                }
            }
        }
    }

    func refuse_undeclared_no_move(&var self, d: Int, member: Int, t: Int) {
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        let member_name = self.res.decls[member].name
        try! msg.append("` contains NoMove member `")
        try! msg.append(self.name_text(member_name))
        try! msg.append("` of type `")
        try! msg.append(self.type_text(t))
        try! msg.append("` but does not declare `NoMove`: declare `extension ")
        try! msg.append(self.name_text(info.name))
        try! msg.append(": NoMove \{\}` beside its `NoCopy`, or hold the member behind a `Box` for a movable handle")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "nomove.undeclared", msg.build())
    }

    func refuse_no_move_policy(&var self, c: TcConformance) {
        let info = self.res.decls[c.type_decl]
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(c.type_decl))
        try! msg.append("` declares `NoMove` without a declared `NoCopy`: a pinned type is move-only first, so declare `extension ")
        try! msg.append(self.name_text(info.name))
        try! msg.append(": NoCopy \{\}` beside it")
        self.refuse_in(c.module, c.node, "nomove.requires-nocopy", msg.build())
    }

    // Whether a value of type `t` may not be relocated: its type declares
    // `NoMove`, or holds such a value inline, an Optional's payload, a tuple's
    // or an array's element, or a generic instance's field or payload at its
    // arguments included (design 188). A pointer, and so a `Box`, holds its
    // value behind an indirection, which moving the pointer leaves in place.
    // A non-generic type that holds one without declaring it answers no,
    // since `nomove.undeclared` refuses it.
    public func is_no_move(&var self, t: Int) -> Bool {
        if t < 0 || self.known.no_move < 0 {
            return false
        }
        tc_summary_holds(self.inline_summary(t, TC_WALK_NO_MOVE))
    }
}

// Interior mutability: the cell-carrying property, apart from `Sync`.
extension TcProgram {
    // Whether a value of type `t` holds an `UnsafeMutableInterior` in its own
    // storage: the cell itself, or one inline in a field, a case payload, an
    // Optional's payload, a tuple's or an array's element, a generic
    // instance's members at its arguments included (spec, Interior
    // mutability). A pointer, a reference, a slice and a closure hold what
    // they reach behind an indirection, so a cell there leaves `t` cell-free.
    // `Sync` is no answer: a type declaring `UnsafeSync`, `Atomic` among
    // them, carries a cell and is `Sync`. A type this cannot see into, a type
    // parameter among them, answers true.
    public func is_cell_carrying(&var self, t: Int) -> Bool {
        if t < 0 {
            return false
        }
        let s = self.inline_summary(t, TC_WALK_CELL)
        tc_summary_holds(s) || tc_summary_mask(s) != 0
    }
}

// The inline walks: `is_no_move`, `is_cell_carrying` and `is_trivial`, one
// memoized walk keyed by TypeId over what a value holds inline. A type's
// summary is (holds, mask): for NoMove and the cell, whether it holds one and
// which type parameters it holds inline, through which it might; for
// triviality, whether it can be trivial and which parameters must be. A
// generic declaration's rule is its members' summary over its own
// parameters, so an instance is its declaration's rule with its arguments'
// summaries in place, and the walk never substitutes into a member. A
// declaration met while its own rule is being built holds itself inline,
// which `check_finite_size` refuses, so that meeting adds nothing.
extension TcProgram {
    func inline_summary(&var self, t: Int, q: Int) -> Int {
        if t < 0 {
            return tc_summary(false, 0)
        }
        let known = self.walks.get(t, q)
        if known >= 0 {
            return known
        }
        let s = self.inline_summary_of(t, q)
        self.walks.set(t, q, s)
        s
    }

    func inline_summary_of(&var self, t: Int, q: Int) -> Int {
        let any_part = q != TC_WALK_TRIVIAL
        let info = self.types.ty(t)
        match info.kind {
            case Tuple -> {
                var s = tc_summary(not any_part, 0)
                var k = 0
                while k < info.count {
                    let part = self.types.arg(t, k)
                    s = tc_summary_join(s, self.inline_summary(part, q), any_part)
                    k = k + 1
                }
                s
            },
            case Array -> self.inline_summary(info.b, q),
            case Nominal -> self.nominal_summary(t, q),
            case Param -> {
                let bit = tc_bit(info.a)
                if bit == 0 {
                    // Past the mask's width a parameter cannot be named, so
                    // it answers the refusing side.
                    return tc_summary(any_part, 0)
                }
                tc_summary(not any_part, bit)
            },
            case Ref -> tc_summary(false, 0),
            case Slice -> tc_summary(false, 0),
            case Func -> tc_summary(false, 0),
            case ConstInt -> tc_summary(false, 0),
            case _ -> tc_summary(q == TC_WALK_CELL, 0)
        }
    }

    func nominal_summary(&var self, t: Int, q: Int) -> Int {
        let info = self.types.ty(t)
        let d = info.decl
        let k = self.known
        let pointer = d == k.unsafe_pointer || d == k.unsafe_const_pointer
        if q == TC_WALK_NO_MOVE {
            if self.declares_no_move(d) {
                return tc_summary(true, 0)
            }
            if info.count == 0 || pointer {
                return tc_summary(false, 0)
            }
        } else if q == TC_WALK_CELL {
            if d == k.interior {
                return tc_summary(true, 0)
            }
            if pointer || d == k.func_pointer {
                return tc_summary(false, 0)
            }
        } else {
            if d == k.string {
                return tc_summary(false, 0)
            }
            if self.res.decls[d].kind == ResDeclKind.Primitive {
                return tc_summary(true, 0)
            }
        }
        if d == k.optional {
            let payload = self.types.arg(t, 0)
            return self.inline_summary(payload, q)
        }
        if q == TC_WALK_TRIVIAL && (self.declared_policy(d) >= 0 || self.res.decls[d].node < 0) {
            return tc_summary(false, 0)
        }
        let rule = self.inline_rule(d, q)
        let any_part = q != TC_WALK_TRIVIAL
        var s = tc_summary(tc_summary_holds(rule), 0)
        var j = 0
        while j < info.count {
            if (tc_summary_mask(rule) & tc_bit(j)) != 0 {
                let arg = self.types.arg(t, j)
                s = tc_summary_join(s, self.inline_summary(arg, q), any_part)
            }
            j = j + 1
        }
        s
    }

    // Declaration `d`'s rule for question `q`: its fields' and payloads'
    // summaries joined, over its own parameters.
    func inline_rule(&var self, d: Int, q: Int) -> Int {
        let key = q + 1
        let known = self.walks.get(d, key)
        if known == TC_RULE_BUILDING {
            return tc_summary(false, 0)
        }
        if known >= 0 {
            return known
        }
        self.walks.set(d, key, TC_RULE_BUILDING)
        let any_part = q != TC_WALK_TRIVIAL
        var s = tc_summary(not any_part, 0)
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            let ms = self.sigs[m]
            if mi.kind == ResDeclKind.Field && ms.result >= 0 {
                var ft = ms.result
                if q == TC_WALK_TRIVIAL {
                    ft = self.member_type(ft)
                }
                s = tc_summary_join(s, self.inline_summary(ft, q), any_part)
            } else if mi.kind == ResDeclKind.Case {
                if q == TC_WALK_TRIVIAL && ms.param_count > 0 {
                    s = tc_summary_join(s, tc_summary(false, 0), false)
                }
                var j = 0
                while j < ms.param_count && any_part {
                    let p = self.params[ms.param_first + j]
                    s = tc_summary_join(s, self.inline_summary(p.ty, q), true)
                    j = j + 1
                }
            }
        }
        self.walks.set(d, key, s)
        s
    }
}

// A summary packed in one Int: bit 0 whether it holds, the mask above it.
func tc_summary(holds: Bool, mask: Int) -> Int {
    if holds {
        return (mask << 1) | 1
    }
    mask << 1
}

func tc_summary_holds(s: Int) -> Bool {
    (s & 1) != 0
}

func tc_summary_mask(s: Int) -> Int {
    s >> 1
}

// Two summaries joined: an existence question holds when either part does,
// a question over every part when both do.
func tc_summary_join(a: Int, b: Int, any_part: Bool) -> Int {
    let mask = tc_summary_mask(a) | tc_summary_mask(b)
    if any_part {
        return tc_summary(tc_summary_holds(a) || tc_summary_holds(b), mask)
    }
    tc_summary(tc_summary_holds(a) && tc_summary_holds(b), mask)
}

// One `satisfies` question: each (type, trait) pair it asks, its answer or the
// frame asking it; the pairs that hold while a frame they leaned on is open,
// the first `leaning` of `leaning_types` and `leaning_traits`, in the order
// they were decided; the lowest frame a cycle reached back to; the type whose
// derivation from its members nested past the instantiation depth; the code
// asking, whose conformances every pair is answered by; and the declaration
// whose own conformances are not consulted for trait `hidden_trait`, -1 for
// none.
struct TcSatisfyRun {
    states: TcMemo
    leaning_types: Vector<Int>
    leaning_traits: Vector<Int>
    leaning: Int
    frames: Int
    low: Int
    overflow: Int
    overflow_trait: Int
    viewer: Int
    in_test: Bool
    hidden: Int
    hidden_trait: Int
}

extension TcSatisfyRun: NoCopy {}

extension TcSatisfyRun {
    init(viewer: Int, in_test: Bool) -> TcSatisfyRun {
        TcSatisfyRun(states: tc_memo(), leaning_types: Vector<Int>(), leaning_traits: Vector<Int>(), leaning: 0,
                     frames: 0, low: TC_SATISFY_NO_LOW, overflow: -1, overflow_trait: -1,
                     viewer: viewer, in_test: in_test, hidden: -1, hidden_trait: -1)
    }


    // Lowers the frame the pair being decided leans on to `frame`.
    func lean(&var self, frame: Int) {
        if frame < self.low {
            self.low = frame
        }
    }

    // Records that (t, tr) holds while frame `low` is open.
    func add_leaning(&var self, t: Int, tr: Int, low: Int) {
        self.states.set(t, tr, TC_SATISFY_LEANING - low)
        if self.leaning < self.leaning_types.len() {
            self.leaning_types[self.leaning] = t
            self.leaning_traits[self.leaning] = tr
        } else {
            try! self.leaning_types.push(t)
            try! self.leaning_traits.push(tr)
        }
        self.leaning = self.leaning + 1
    }

    // Settles the leaning pairs decided since `mark` to `state`, dropping them
    // from the leaning list unless they still lean on an open frame.
    func settle_leaning(&var self, mark: Int, state: Int, still_leaning: Bool) {
        var k = mark
        while k < self.leaning {
            let t = self.leaning_types[k]
            let tr = self.leaning_traits[k]
            self.states.set(t, tr, state)
            k = k + 1
        }
        if not still_leaning {
            self.leaning = mark
        }
    }
}

// Bound satisfaction.
extension TcProgram {
    // Every recorded type argument against its parameter's bound.
    public func check_obligations(&var self) {
        var k = 0
        while k < self.obligations.len() {
            let o = self.obligations[k]
            if not self.satisfies(o.arg, o.trait_decl, o.env_decl, o.env_ext, o.module, o.test) {
                self.refuse_bound(&o)
            }
            k = k + 1
        }
    }

    func refuse_bound(&var self, o: &TcObligation) {
        let g = self.generic(o.owner, o.index)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(o.arg))
        try! msg.append("` does not satisfy `")
        try! msg.append(self.res.decl_path(o.trait_decl))
        try! msg.append("`, the bound on `")
        try! msg.append(self.name_text(g.name))
        try! msg.append("` of `")
        try! msg.append(self.res.decl_path(o.owner))
        try! msg.append("`")
        if o.trait_decl == self.known.send || o.trait_decl == self.known.sync {
            try! msg.append(self.sendable_hint(o.arg))
        }
        self.refuse_in(o.module, o.node, "type.bound", msg.build())
    }

    // Whether type `t` satisfies trait `tr`, where the parameters of
    // `env_decl` and the conditions of extension `env_ext` are in scope. A
    // derivation from members that reaches back to a pair it is still
    // deciding holds there, as a recursive type's `Send` does through its
    // `Box`; one that nests past the instantiation depth is refused. The
    // conformances are those code in module `viewer`, test code when
    // `in_test`, may use (`conformance_visible`).
    public func satisfies(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, viewer: Int,
                          in_test: Bool) -> Bool {
        var run = TcSatisfyRun(viewer: viewer, in_test: in_test)
        let answer = self.satisfies_in(t, tr, env_decl, env_ext, &var run)
        if run.overflow >= 0 {
            self.refuse_instantiation_depth(run.overflow, run.overflow_trait)
        }
        answer
    }

    // `satisfies`, with no conformance of declaration `hidden` answering for
    // `tr` at any depth: what `t` meets were `hidden`'s assertions of `tr`
    // deleted.
    public func satisfies_without(&var self, t: Int, tr: Int, hidden: Int, env_decl: Int, env_ext: Int,
                                  viewer: Int, in_test: Bool) -> Bool {
        var run = TcSatisfyRun(viewer: viewer, in_test: in_test)
        run.hidden = hidden
        run.hidden_trait = tr
        let answer = self.satisfies_in(t, tr, env_decl, env_ext, &var run)
        if run.overflow >= 0 {
            self.refuse_instantiation_depth(run.overflow, run.overflow_trait)
        }
        answer
    }

    // One pair of a run. A false answer is final, since a cycle assumes
    // only that a pair holds. A true one that leaned on a frame below its own
    // holds while that frame is open, and every pair decided inside a frame
    // settles when the frame does: final when it holds and leaned on nothing
    // below it, forgotten when it fails, else leaning on the lowest frame it
    // reached. So no leaning pair outlives the frame it names, and a frame's
    // index, reused after it closes, never answers for a pair decided
    // before.
    func satisfies_in(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let state = run.states.get(t, tr)
        if state == TC_SATISFY_FALSE {
            return false
        }
        if state == TC_SATISFY_TRUE {
            return true
        }
        if state >= 0 {
            run.lean(state)
            return true
        }
        if state <= TC_SATISFY_LEANING {
            run.lean(TC_SATISFY_LEANING - state)
            return true
        }
        let frame = run.frames
        run.frames = frame + 1
        run.states.set(t, tr, frame)
        let mark = run.leaning
        let outer_low = run.low
        run.low = TC_SATISFY_NO_LOW
        let answer = self.satisfies_at(t, tr, env_decl, env_ext, &var run)
        run.frames = frame
        let low = run.low
        if not answer {
            run.settle_leaning(mark, -1, false)
            run.states.set(t, tr, TC_SATISFY_FALSE)
        } else if low >= frame {
            run.settle_leaning(mark, TC_SATISFY_TRUE, false)
            run.states.set(t, tr, TC_SATISFY_TRUE)
        } else {
            run.settle_leaning(mark, TC_SATISFY_LEANING - low, true)
            run.add_leaning(t, tr, low)
        }
        run.lean(outer_low)
        answer
    }

    func satisfies_at(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let info = self.types.ty(t)
        match info.kind {
            case Error -> true,
            case ConstInt -> true,
            // An associated type carries no bound, so its projection meets none.
            case Projection -> false,
            case Param -> self.param_satisfies(info.decl, info.a, tr, env_decl, env_ext),
            case SelfType -> self.bound_carries(info.decl, tr),
            case Any -> self.trait_refines(info.decl, tr),
            case Nominal -> self.nominal_satisfies(t, tr, env_decl, env_ext, &var run),
            case Tuple -> {
                if not self.structural_trait(tr) {
                    return false
                }
                var k = 0
                while k < info.count {
                    let arg = self.types.arg(t, k)
                    if not self.satisfies_in(arg, tr, env_decl, env_ext, &var run) {
                        return false
                    }
                    k = k + 1
                }
                true
            },
            case Array -> {
                if not self.structural_trait(tr) {
                    return false
                }
                self.satisfies_in(info.b, tr, env_decl, env_ext, &var run)
            },
            case Func -> {
                if tr == self.known.copy || tr == self.known.explicit_copy {
                    return true
                }
                (tr == self.known.send || tr == self.known.sync) && (info.a & TC_EFFECT_SENDABLE) != 0
            },
            case Ref -> {
                if tr == self.known.copy || tr == self.known.explicit_copy {
                    return true
                }
                self.reference_satisfies(info.b, info.a == 1, tr, env_decl, env_ext, &var run)
            },
            case Slice -> {
                if tr == self.known.copy || tr == self.known.explicit_copy {
                    return true
                }
                self.reference_satisfies(info.b, info.a == 1, tr, env_decl, env_ext, &var run)
            }
        }
    }

    // Send and Sync of a reference to `referent`, or to a slice of it, by
    // Rust's rule at any depth: a shared one is `Send` when its referent is
    // `Sync`, since both threads may read it; an exclusive one is `Send` when
    // its referent is, since only the holder reaches it; and either is `Sync`
    // when its referent is.
    func reference_satisfies(&var self, referent: Int, exclusive: Bool, tr: Int, env_decl: Int, env_ext: Int,
                             run: &var TcSatisfyRun) -> Bool {
        if tr == self.known.send {
            let needed = if exclusive { self.known.send } else { self.known.sync }
            return self.satisfies_in(referent, needed, env_decl, env_ext, &var run)
        }
        if tr == self.known.sync {
            let s = self.known.sync
            return self.satisfies_in(referent, s, env_decl, env_ext, &var run)
        }
        false
    }

    // The traits a tuple, an Optional or a fixed array meets when each of its
    // parts does: the copy tiers, `Send` and `Sync`, `Equatable` and
    // `Hashable`. `Comparable` is not one, since the spec grants it only
    // builtin and through a written conformance (spec, Ordering).
    // ENTRY POINTS:
    //     satisfies_at
    //     nominal_satisfies
    func structural_trait(&self, tr: Int) -> Bool {
        tr == self.known.copy || tr == self.known.explicit_copy || tr == self.known.equatable || tr == self.known.hashable || tr == self.known.send || tr == self.known.sync
    }

    // A type parameter meets what its bounds grant: its declaration's, and
    // the conditions of the extension around the position.
    func param_satisfies(&var self, owner: Int, index: Int, tr: Int, env_decl: Int, env_ext: Int) -> Bool {
        if self.generic_grants(owner, index, tr) {
            return true
        }
        if env_ext >= 0 && self.ext_target(env_ext) == owner {
            if self.generic_grants(env_ext, index, tr) {
                return true
            }
        }
        if tr == self.known.explicit_copy {
            let c = self.known.copy
            return self.param_satisfies(owner, index, c, env_decl, env_ext)
        }
        false
    }

    // Whether parameter `index` of `d` has a bound that is `tr` or refines it.
    public func generic_grants(&var self, d: Int, index: Int, tr: Int) -> Bool {
        self.ensure_generics(d)
        let s = self.sigs[d]
        if index >= s.generic_count {
            return false
        }
        let g = self.generics[s.generic_first + index]
        var k = 0
        while k < g.bound_count {
            let bound = self.traits[g.bound_first + k]
            if self.bound_carries(bound, tr) {
                return true
            }
            k = k + 1
        }
        false
    }

    func nominal_satisfies(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let info = self.types.ty(t)
        let d = info.decl
        if d == self.known.never {
            return true
        }
        if tr == self.known.copy {
            return self.tier_is_copy(t, env_decl, env_ext, &var run)
        }
        if tr == self.known.explicit_copy {
            if self.tier_is_copy(t, env_decl, env_ext, &var run) {
                return true
            }
        }
        if self.declares_conformance(t, tr, env_decl, env_ext, &var run) {
            return true
        }
        if self.primitive_grants(d, tr) {
            return true
        }
        if d == self.known.optional && self.structural_trait(tr) {
            let inner = self.types.arg(t, 0)
            return self.satisfies_in(inner, tr, env_decl, env_ext, &var run)
        }
        if tr == self.known.equatable || tr == self.known.hashable {
            return self.is_trivial(t)
        }
        // A value mutable through a shared borrow derives no `Sync`: the block
        // sits at the cell, so only a type holding one directly owes
        // `UnsafeSync` (spec, Interior mutability).
        if tr == self.known.sync && d == self.known.interior {
            return false
        }
        if tr == self.known.send || tr == self.known.sync {
            return self.members_satisfy(t, tr, env_decl, env_ext, &var run)
        }
        false
    }

    // Whether `t`'s tier is Copy, its rule's parameters evaluated with its
    // arguments.
    func tier_is_copy(&var self, t: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let info = self.types.ty(t)
        let rule = self.tier_of_decl(info.decl)
        if rule.base != TC_TIER_COPY {
            return false
        }
        var k = 0
        while k < info.count {
            if (rule.mask & tc_bit(k)) != 0 {
                let arg = self.types.arg(t, k)
                let c = self.known.copy
                if not self.satisfies_in(arg, c, env_decl, env_ext, &var run) {
                    return false
                }
            }
            k = k + 1
        }
        true
    }

    // Whether a conformance of `t`'s declaration to `tr`, or to a trait that
    // refines it, that the run's code may use holds for `t`'s arguments.
    func declares_conformance(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let info = self.types.ty(t)
        if info.decl == run.hidden && tr == run.hidden_trait {
            return false
        }
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl != info.decl || not self.conformance_grants(c.trait_decl, tr) {
                continue
            }
            if not self.conformance_visible(k - 1, run.viewer, run.in_test) {
                continue
            }
            if self.conditions_hold(c.ext, t, env_decl, env_ext, &var run) {
                return true
            }
        }
        false
    }

    // Whether `t`'s arguments meet the bounds extension `ext` puts on the
    // parameters they fill.
    func conditions_hold(&var self, ext: Int, t: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        self.ensure_generics(ext)
        let s = self.sigs[ext]
        let info = self.types.ty(t)
        var k = 0
        while k < s.generic_count && k < info.count {
            let g = self.generics[s.generic_first + k]
            let arg = self.types.arg(t, k)
            var j = 0
            while j < g.bound_count {
                let bound = self.traits[g.bound_first + j]
                if not self.satisfies_in(arg, bound, env_decl, env_ext, &var run) {
                    return false
                }
                j = j + 1
            }
            k = k + 1
        }
        true
    }

    // The builtin conformances of the types no source declares (design 109):
    // the numbers, `Bool` and `String` meet the value traits, and the raw
    // pointers only Copy and Equatable. `Void` is granted `Send` and `Sync`
    // here (it holds no state); its Copy comes from `classify`, and its
    // Equatable and Hashable from `is_trivial` through `nominal_satisfies`.
    public func primitive_grants(&self, d: Int, tr: Int) -> Bool {
        let info = self.res.decls[d]
        if info.kind != ResDeclKind.Primitive {
            return false
        }
        if d == self.known.void_type {
            return tr == self.known.explicit_copy || tr == self.known.send || tr == self.known.sync
        }
        let pointer = d == self.known.unsafe_pointer || d == self.known.unsafe_const_pointer
        if pointer {
            return tr == self.known.explicit_copy || tr == self.known.equatable
        }
        tr == self.known.explicit_copy || tr == self.known.equatable || tr == self.known.comparable || tr == self.known.hashable || tr == self.known.printable || tr == self.known.send || tr == self.known.sync
    }

    // Whether `t` is trivially copyable: a number, `Bool`, a pointer, or a
    // type declaring no policy whose members all are. Such a struct, and a
    // payload-free enum, meets Equatable and Hashable with no declaration.
    public func is_trivial(&var self, t: Int) -> Bool {
        if t < 0 {
            return false
        }
        let s = self.inline_summary(t, TC_WALK_TRIVIAL)
        tc_summary_holds(s) && tc_summary_mask(s) == 0
    }

    // Whether `t` is trivially copyable for some arguments of the type
    // parameters it names: `is_trivial` once each of them is.
    public func may_be_trivial(&var self, t: Int) -> Bool {
        if t < 0 {
            return false
        }
        tc_summary_holds(self.inline_summary(t, TC_WALK_TRIVIAL))
    }

    // Send and Sync, derived from the members, with each argument in place.
    // A primitive derives neither: a raw pointer is `Send` only through a
    // type that asserts it.
    func members_satisfy(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, run: &var TcSatisfyRun) -> Bool {
        let info = self.types.ty(t)
        let d = info.decl
        let decl = self.res.decls[d]
        if decl.kind == ResDeclKind.Primitive {
            return false
        }
        if decl.node < 0 {
            var k = 0
            while k < info.count {
                let arg = self.types.arg(t, k)
                if not self.satisfies_in(arg, tr, env_decl, env_ext, &var run) {
                    return false
                }
                k = k + 1
            }
            return true
        }
        // A member deriving from a growing instance of its own type nests
        // without bound, which the instantiation depth limit refuses.
        if self.nesting_depth(t) > TC_INSTANTIATION_DEPTH {
            if run.overflow < 0 {
                run.overflow = t
                run.overflow_trait = tr
            }
            return false
        }
        let arguments = self.nominal_args(t)
        let subst = TcSubst(owner: d, args: move arguments)
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            let mi = self.res.decls[m]
            let s = self.sigs[m]
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                let ft = self.subst(s.result, &subst)
                if ft == t || not self.satisfies_in(ft, tr, env_decl, env_ext, &var run) {
                    return false
                }
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    let pt = self.subst(p.ty, &subst)
                    if pt == t || not self.satisfies_in(pt, tr, env_decl, env_ext, &var run) {
                        return false
                    }
                    j = j + 1
                }
            }
            k = k + 1
        }
        true
    }

    // Why nominal `t` does not derive `tr`, `Send` or `Sync`: its first field
    // or case payload that does not meet it, named with its type; "" when
    // none is found.
    public func derivation_blocker(&var self, t: Int, tr: Int, env_decl: Int, env_ext: Int, viewer: Int,
                                   in_test: Bool) -> String {
        let info = self.types.ty(t)
        if info.kind != TcKind.Nominal || self.res.decls[info.decl].node < 0 {
            return ""
        }
        let arguments = self.nominal_args(t)
        let subst = TcSubst(owner: info.decl, args: move arguments)
        let members = self.members_of(info.decl)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            let s = self.sigs[m]
            var out = StringBuilder()
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                let ft = self.subst(s.result, &subst)
                if self.satisfies(ft, tr, env_decl, env_ext, viewer, in_test) {
                    continue
                }
                try! out.append("field `")
                try! out.append(self.name_text(mi.name))
                try! out.append("` has type `")
                try! out.append(self.type_text(ft))
            } else if mi.kind == ResDeclKind.Case {
                var blocked = -1
                var j = 0
                while j < s.param_count && blocked < 0 {
                    let p = self.params[s.param_first + j]
                    let pt = self.subst(p.ty, &subst)
                    if not self.satisfies(pt, tr, env_decl, env_ext, viewer, in_test) {
                        blocked = pt
                    }
                    j = j + 1
                }
                if blocked < 0 {
                    continue
                }
                try! out.append("case `")
                try! out.append(self.name_text(mi.name))
                try! out.append("` has a payload of type `")
                try! out.append(self.type_text(blocked))
            } else {
                continue
            }
            try! out.append("`, which is not `")
            try! out.append(self.res.decl_path(tr))
            try! out.append("`")
            return out.build()
        }
        ""
    }

    // THE CAPTURE RULE for a `sendable` closure: -1 when a capture of type
    // `t`, taken by `use`, lets its closure be `Send` and `Sync`, else the
    // trait it fails. Copies of a closure share one environment, so an owned
    // capture must be both; a borrow is judged as the reference it is, `&T`
    // by `T: Sync` and `&var T` by `T: Send`, and a capture of reference type
    // reborrows in its own mode. A `Thread.spawn` body takes its environment
    // once, by value, so there an owned capture needs `Send` alone.
    // ENTRY POINTS:
    //     closure_blocker
    //     check_closure_traits
    //     refuse_unsent_capture
    public func capture_blocks_sendable(&var self, t: Int, use: TcUse, thread_body: Bool, env_decl: Int,
                                        env_ext: Int, viewer: Int, in_test: Bool) -> Int {
        if t < 0 || (self.types.ty(t).holds & TC_HOLDS_ERROR) != 0 {
            return -1
        }
        let send = self.known.send
        let sync = self.known.sync
        if thread_body {
            return if self.satisfies(t, send, env_decl, env_ext, viewer, in_test) { -1 } else { send }
        }
        let info = self.types.ty(t)
        var referent = -1
        var exclusive = false
        if use == TcUse.Borrow || use == TcUse.BorrowVar {
            referent = t
            exclusive = use == TcUse.BorrowVar
        } else if info.kind == TcKind.Ref {
            referent = info.b
            exclusive = info.a == 1
        }
        if referent >= 0 {
            let needed = if exclusive { send } else { sync }
            return if self.satisfies(referent, needed, env_decl, env_ext, viewer, in_test) { -1 } else { needed }
        }
        if not self.satisfies(t, send, env_decl, env_ext, viewer, in_test) {
            return send
        }
        if not self.satisfies(t, sync, env_decl, env_ext, viewer, in_test) {
            return sync
        }
        return -1
    }

    // Why `t` falls short of `Send` or `Sync` when a function type without
    // `sendable` is the reason, as a sentence to append to a refusal; "" when
    // `t` holds none.
    public func sendable_hint(&var self, t: Int) -> String {
        var seen = Vector<Int>()
        let f = self.unmarked_function_in(t, 0, &var seen)
        if f < 0 {
            return ""
        }
        var out = StringBuilder()
        try! out.append("; the function type `")
        try! out.append(self.type_text(f))
        try! out.append("` is not `sendable`: a written function type is `Send` and `Sync` only when it says `sendable`, and a closure's own type says it when everything the closure captures is both")
        out.build()
    }

    // The first function type without `sendable` in `t`, -1 when none: `t`
    // itself, or one of its parts, a declared type's fields and case payloads
    // among them, since a function value held in a field keeps its written
    // type. A type already in `seen` is not walked again, so a type reaching
    // itself through several fields costs one walk.
    func unmarked_function_in(&var self, t: Int, depth: Int, seen: &var Vector<Int>) -> Int {
        if t < 0 || depth > TC_INSTANTIATION_DEPTH {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Func {
            return if (info.a & TC_EFFECT_SENDABLE) == 0 { t } else { -1 }
        }
        if info.kind == TcKind.Nominal || info.kind == TcKind.Tuple {
            var j = 0
            while j < seen.len() {
                if seen[j] == t {
                    return -1
                }
                j = j + 1
            }
            try! seen.push(t)
            var k = 0
            while k < info.count {
                let part = self.types.arg(t, k)
                let found = self.unmarked_function_in(part, depth + 1, &var seen)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
            // A std type's fields are its own representation, which writing
            // `sendable` cannot change, so only the program's are walked.
            if info.kind == TcKind.Nominal && self.res.decls[info.decl].node >= 0 {
                let m = self.res.decls[info.decl].module
                if self.res.module(m).kind != ResModuleKind.Std {
                    return self.unmarked_function_in_members(t, depth, &var seen)
                }
            }
            return -1
        }
        if info.kind == TcKind.Ref || info.kind == TcKind.Array {
            return self.unmarked_function_in(info.b, depth + 1, &var seen)
        }
        return -1
    }

    // `unmarked_function_in` over declared type `t`'s fields and case
    // payloads, each with `t`'s arguments in place.
    func unmarked_function_in_members(&var self, t: Int, depth: Int, seen: &var Vector<Int>) -> Int {
        let d = self.types.ty(t).decl
        let arguments = self.nominal_args(t)
        let subst = TcSubst(owner: d, args: move arguments)
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let mi = self.res.decls[m]
            let s = self.sigs[m]
            if mi.kind == ResDeclKind.Field && s.result >= 0 {
                let ft = self.subst(s.result, &subst)
                let found = self.unmarked_function_in(ft, depth + 1, &var seen)
                if found >= 0 {
                    return found
                }
            } else if mi.kind == ResDeclKind.Case {
                var j = 0
                while j < s.param_count {
                    let p = self.params[s.param_first + j]
                    let pt = self.subst(p.ty, &subst)
                    j = j + 1
                    let found = self.unmarked_function_in(pt, depth + 1, &var seen)
                    if found >= 0 {
                        return found
                    }
                }
            }
        }
        return -1
    }

    // The instantiation depth limit's refusal (spec, "Instantiation depth is
    // bounded"), once per declaration, where the growing type is declared.
    func refuse_instantiation_depth(&var self, t: Int, tr: Int) {
        let d = self.types.ty(t).decl
        if not self.walks.mark(d, TC_WALK_DEPTH_REFUSED) {
            return
        }
        let info = self.res.decls[d]
        var msg = StringBuilder()
        try! msg.append("deriving `")
        try! msg.append(self.res.decl_path(tr))
        try! msg.append("` for `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` from its members reaches `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, a type nested more than ")
        try! msg.append(TC_INSTANTIATION_DEPTH)
        try! msg.append(" deep: a type whose members instantiate it at ever larger arguments has no finite set of instances; hold the growing argument behind a type that does not instantiate it, or stop the growth")
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "type.instantiation-depth", msg.build())
    }

    // A nominal type's arguments.
    public func nominal_args(&self, t: Int) -> Vector<Int> {
        let info = self.types.ty(t)
        var out = Vector<Int>()
        var k = 0
        while k < info.count {
            try! out.push(self.types.arg(t, k))
            k = k + 1
        }
        move out
    }
}
