// The typecheck stage's entry points: a program resolved and its signatures
// checked, and the record `sawc2 typecheck` prints for it.

import sawresolve.src.api.{append_res_diag, resolve_program}
import sawresolve.src.lang.{ResLang}
import sawresolve.src.model.{ResDiag, ResModule}
import sawresolve.src.program.{ResProgram}
import sawresolve.src.verify.{res_verify_module}
import sawtypecheck.src.bodies.{tc_check_bodies}
import sawtypecheck.src.bodychecks.{tc_check_body_rules}
import sawtypecheck.src.bodyverify.{tc_verify_bodies}
import sawtypecheck.src.checks.{tc_check_finite_size, tc_check_inits, tc_check_unsafe}
import sawtypecheck.src.conform.{tc_collect_conformances, tc_extension_sets,
                                 tc_settle_conformances}
import sawtypecheck.src.declarations.{tc_build_signatures}
import sawtypecheck.src.dump.{tc_dump_module}
import sawtypecheck.src.effects.{tc_check_effects}
import sawtypecheck.src.exhaust.{tc_check_exhaustive}
import sawtypecheck.src.lang.{tc_check_lang_shapes}
import sawtypecheck.src.members.{tc_build_members}
import sawtypecheck.src.model.{TcDiag}
import sawtypecheck.src.paths.{tc_settle_path_uses}
import sawtypecheck.src.program.{TcKnown, TcProgram, tc_program}
import sawtypecheck.src.signatures.{tc_index_generics}
import sawtypecheck.src.summaries.{tc_solve_summaries, tc_verify_all_summaries}
import sawtypecheck.src.tier.{tc_check_containment, tc_check_obligations, tc_compute_tiers}
import sawtypecheck.src.verify.{tc_verify_module}

// How `sawc2 typecheck` treats one entry file.
public struct TypecheckOptions {
    // The directory holding `std/` and `builtin.saw`.
    public std_root: String
    // Print each checked module's dump.
    public dump: Bool
    // Print the notes about interface modules as well as the refusals.
    public notes: Bool
    // Dump the std and builtin modules too, whose signatures are checked as
    // interfaces.
    public interfaces: Bool
    // Print a `SUMMARY` line per function of the modules checked in full.
    public summaries: Bool
}

// Resolves the program whose entry file is `path`, then builds every
// declaration's signature, the conformance table, the member tables and the
// Copy tiers, and runs the checks that need only those (SL:architecture §3.4,
// "Order").
public func typecheck_program(path: String, std_root: String, names: &Vector<String>,
                              dirs: &Vector<String>) -> TcProgram {
    let res = resolve_program(path, std_root, &names, &dirs)
    var p = tc_program(move res)
    p.find_known()
    tc_index_generics(&var p)
    tc_build_signatures(&var p)
    tc_collect_conformances(&var p)
    let visible = tc_extension_sets(&p)
    tc_settle_conformances(&var p, &visible)
    tc_build_members(&var p)
    tc_compute_tiers(&var p)
    tc_check_obligations(&var p)
    tc_check_containment(&var p)
    tc_check_finite_size(&var p)
    tc_check_unsafe(&var p)
    tc_check_inits(&var p)
    tc_check_lang_shapes(&var p)
    tc_check_bodies(&var p)
    tc_check_exhaustive(&var p)
    tc_settle_path_uses(&var p)
    tc_solve_summaries(&var p)
    tc_check_effects(&var p)
    tc_check_body_rules(&var p)
    tc_verify_all_summaries(&var p)
    move p
}

extension TcProgram {
    // The declarations typecheck knows by identity: each lang item from
    // resolve's table, and the primitives and std types it builds or refuses
    // with no name occurrence to read.
    func find_known(&var self) {
        let b = self.res.builtin
        let serde = self.module_named("std.serde")
        let std_box = self.module_named("std.box")
        let std_vector = self.module_named("std.vector")
        let std_map = self.module_named("std.map")
        let std_set = self.module_named("std.set")
        let std_arc = self.module_named("std.arc")
        let std_task_group = self.module_named("std.taskgroup")
        let k = TcKnown(optional: self.res.lang_item(ResLang.OptionalEnum),
                        result: self.res.lang_item(ResLang.ResultEnum),
                        string: self.top_decl(b, "String"), void_type: self.top_decl(b, "Void"),
                        never: self.top_decl(b, "Never"),
                        unsafe_pointer: self.top_decl(b, "UnsafePointer"),
                        unsafe_const_pointer: self.top_decl(b, "UnsafeConstPointer"),
                        copy: self.res.lang_item(ResLang.CopyTrait),
                        explicit_copy: self.res.lang_item(ResLang.ExplicitCopyTrait),
                        no_copy: self.res.lang_item(ResLang.NoCopyTrait),
                        deinit: self.res.lang_item(ResLang.DeinitTrait),
                        no_move: self.res.lang_item(ResLang.NoMoveTrait),
                        equatable: self.res.lang_item(ResLang.EquatableTrait),
                        comparable: self.res.lang_item(ResLang.ComparableTrait),
                        hashable: self.res.lang_item(ResLang.HashableTrait),
                        printable: self.res.lang_item(ResLang.PrintableTrait),
                        error: self.res.lang_item(ResLang.ErrorTrait),
                        send: self.res.lang_item(ResLang.SendTrait),
                        sync: self.res.lang_item(ResLang.SyncTrait),
                        unsafe_send: self.res.lang_item(ResLang.UnsafeSendTrait),
                        unsafe_sync: self.res.lang_item(ResLang.UnsafeSyncTrait),
                        interior: self.top_decl(b, "UnsafeMutableInterior"),
                        serialize: self.top_decl(serde, "Serialize"),
                        deserialize: self.top_decl(serde, "Deserialize"),
                        int: self.top_decl(b, "Int"), uint: self.top_decl(b, "UInt"),
                        int8: self.top_decl(b, "Int8"), int16: self.top_decl(b, "Int16"),
                        int32: self.top_decl(b, "Int32"), int64: self.top_decl(b, "Int64"),
                        uint8: self.top_decl(b, "UInt8"), uint16: self.top_decl(b, "UInt16"),
                        uint32: self.top_decl(b, "UInt32"), uint64: self.top_decl(b, "UInt64"),
                        float: self.top_decl(b, "Float"), bool_type: self.top_decl(b, "Bool"),
                        range: self.res.lang_item(ResLang.RangeStruct),
                        range_inclusive: self.res.lang_item(ResLang.RangeInclusiveStruct),
                        iterator: self.res.lang_item(ResLang.IteratorTrait),
                        box: self.top_decl(std_box, "Box"),
                        vector: self.top_decl(std_vector, "Vector"),
                        map: self.top_decl(std_map, "Map"), set: self.top_decl(std_set, "Set"),
                        arc: self.top_decl(std_arc, "Arc"),
                        task_group: self.top_decl(std_task_group, "TaskGroup"),
                        func_pointer: self.top_decl(b, "FuncPointer"),
                        ordering: self.res.lang_item(ResLang.OrderingEnum),
                        hasher: self.res.lang_item(ResLang.HasherStruct),
                        panic_sink: self.res.lang_item(ResLang.PanicSinkFunction))
        self.known = k
    }
}

// The record of one checked program, after its `FILE` line: resolve's
// refusals, then typecheck's, each an `ERROR` line, `NOTE` lines when asked
// for, an `INVARIANT` line per problem either verifier finds, and each checked
// module's dump when asked for. Returns 0 when nothing was refused and 1
// otherwise.
public func typecheck_record(out: &var StringBuilder, path: String, options: &TypecheckOptions,
                             names: &Vector<String>, dirs: &Vector<String>) -> Int {
    let p = typecheck_program(path, options.std_root, &names, &dirs)
    var k = 0
    while k < p.res.diags.len() {
        let d = p.res.diags[k]
        if not d.note || options.notes {
            append_res_diag(out: &var out, p: &p.res, d: &d)
        }
        k = k + 1
    }
    k = 0
    while k < p.diags.len() {
        let d = p.diags[k]
        if not d.note || options.notes {
            append_tc_diag(out: &var out, p: &p, d: &d)
        }
        k = k + 1
    }
    var m = 0
    while m < p.res.module_count() {
        let found = res_verify_module(&p.res, m)
        append_invariants(out: &var out, p: &p, m: m, problems: &found)
        let own = tc_verify_module(&p, m)
        append_invariants(out: &var out, p: &p, m: m, problems: &own)
        let bodies = tc_verify_bodies(&p, m)
        append_invariants(out: &var out, p: &p, m: m, problems: &bodies)
        var summarized = Vector<String>()
        var j = 0
        while j < p.summary_problems.len() {
            if p.summary_problem_modules[j] == m {
                try! summarized.push(p.summary_problems.get(j) ?? "")
            }
            j = j + 1
        }
        append_invariants(out: &var out, p: &p, m: m, problems: &summarized)
        m = m + 1
    }
    if options.summaries {
        p.summary_lines(&var out)
    }
    if options.dump {
        let visible = tc_extension_sets(&p)
        m = 0
        while m < p.res.module_count() {
            let info = p.res.module(m)
            if info.available && (options.interfaces || not info.interface_only) {
                tc_dump_module(&p, &var out, m, &visible)
                try! out.append("\n")
            }
            m = m + 1
        }
    }
    if p.error_count() > 0 {
        return 1
    }
    0
}

func append_invariants(out: &var StringBuilder, p: &TcProgram, m: Int, problems: &Vector<String>) {
    var j = 0
    while j < problems.len() {
        try! out.append("INVARIANT\t")
        try! out.append(p.res.module_name(m))
        try! out.append("\t")
        try! out.append(problems.get(j) ?? "")
        try! out.append("\n")
        j = j + 1
    }
}

// `ERROR<TAB>id<TAB>file:line:col<TAB>message`, or `NOTE` for a note.
public func append_tc_diag(out: &var StringBuilder, p: &TcProgram, d: &TcDiag) {
    if d.note {
        try! out.append("NOTE\t")
    } else {
        try! out.append("ERROR\t")
    }
    try! out.append(d.id)
    try! out.append("\t")
    try! out.append(p.res.module_file(d.module))
    try! out.append(":")
    try! out.append(p.res.position_text(d.module, d.start))
    try! out.append("\t")
    try! out.append(d.message)
    try! out.append("\n")
}
