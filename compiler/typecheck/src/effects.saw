// Phase 3 of type checking (SL:architecture §3.4, "Order", "Effects"): the
// checks that consume phase 2's summaries. A `sync` body calls only
// sync-callable targets; a copy-policy `copy()` never suspends; each call
// site meets its callee's inferred Copy requirement at its own type
// arguments; a closure body never suspends; and a
// coercion to `any Trait` is refused when an implementation it dispatches to
// may suspend. The last two are what make a call through a function value or
// an existential sound to treat as never suspending.

import sawparse.grammar.{Alt}
import sawresolve.collect.{res_is_top_level}
import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResDecl, ResDeclKind, ResModule, ResModuleKind, ResVis}
import sawtypecheck.candidates.{tc_contains}
// For the extension writing `generic_grants`.
import sawtypecheck.tier.{tc_max}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.conform.{TcSubst}
// For the extension giving `export_class`, the C-ABI set an offload carries.
import sawtypecheck.exports.{tc_export_rules}
import sawtypecheck.members.{tc_build_members}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.model.{TC_BIND_DEFAULT, TC_CAUSE_BLOCKS_THREAD, TC_CAUSE_PAIRED, TC_EFFECT_BLOCKING,
                               TC_EFFECT_CONSTEXPR, TC_EFFECT_SYNC, TC_FLAG_BLOCKING, TC_FLAG_VARIADIC, TC_FLAG_DEFAULT_BODY, TC_FLAG_STATIC, TC_FLAG_WRITTEN_RETURN,
                               TC_FORBID_CLOSURE, TC_FORBID_ERASE, TC_FORBID_SYNC, TC_FORBID_THREAD, TcReceiver,
                               TC_ITEM_CALL, TC_ITEM_ERASE, TC_SUMMARY_BODY, TC_SUMMARY_TABLE, TC_SUMMARY_UNTABLED,
                               TcAtom, TcCall, TcConformance, TcItem, TcRole, TcStatus, TcStatusKind,
                               TcSummary, TcUnit, TcUse}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.summaries.{TcAcc, tc_thread_struck}
import sawtypecheck.types.{TcKind, TcType}

// Runs every check that reads the summaries (phase 3).
public func tc_check_effects(p: &var TcProgram) {
    p.check_effects()
}

// Why a `Printable.format` that suspends is refused, the sentence both halves
// of the check end with: typecheck's, at every instantiation, and coroutine
// lowering's, at one.
public func tc_format_sync_reason() -> String {
    "A render (an interpolation, a `\{\}` argument of `print`, `panic` or `assert`, `print(x)`, `try!`'s message and `to_string()`) calls `format` synchronously into stack scratch, where nothing may suspend and a `blocking` extern cannot be offloaded, so `format` is `sync`. Do the suspending work first, in a method of its own, and render what it returns"
}

extension TcProgram {
    public func check_effects(&var self) {
        var u = 0
        while u < self.units.len() {
            let unit = self.units[u]
            if unit.top == u {
                self.check_unit_items(u)
            }
            u = u + 1
        }
        self.check_sync_requirements()
        self.check_copy_hooks()
        self.check_format_hooks()
        self.check_declared_requirements()
        self.check_entry_root()
        self.check_blocking_declarations()
    }

    // A hand-written `copy()` of a copy-policy conformance must not suspend
    // (spec: "A hand-written `copy()` must be `sync`"): the compiler calls it
    // at transfer sites no source construct names, so it is refused at the
    // conformance. A suspension conditional on a type argument's own `copy()`
    // is answered by that conformance's check.
    func check_copy_hooks(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.trait_decl < 0 || c.type_decl < 0 || (c.trait_decl != self.known.copy && c.trait_decl != self.known.explicit_copy) {
                continue
            }
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                if st.kind != TcStatusKind.Written || st.member < 0 || not self.is_function_decl(st.member) {
                    continue
                }
                if not self.summaries[st.member].suspends {
                    continue
                }
                let trait_name = self.res.decls[c.trait_decl].name
                let type_name = self.res.decls[c.type_decl].name
                var msg = StringBuilder()
                try! msg.append("cannot suspend in the `")
                try! msg.append(self.name_text(trait_name))
                try! msg.append("` `copy()` of `")
                try! msg.append(self.name_text(type_name))
                try! msg.append("`: `")
                try! msg.append(self.res.decl_path(st.member))
                try! msg.append("` may suspend, and a copy-policy `copy()` runs at compiler-inserted call sites, so it must be `sync`")
                let info = self.res.decls[st.member]
                let site = self.decl_site(st.member)
                self.refuse_in(info.module, site, "effect.sync", msg.build())
            }
        }
    }

    // THE SYNC-FORMAT CHECK, its declaration half: a written `Printable.format`
    // must not suspend (spec, Printable). A render calls it at positions no
    // source call names, into stack scratch, so one that suspends at every
    // instantiation is refused at the conformance, instantiated or not. One
    // that suspends only at some, through a bound, is coroutine lowering's
    // `coro_refuse_suspending_formats`, decided per instance.
    // ENTRY POINTS:
    //     check_effects
    func check_format_hooks(&var self) {
        let req = self.format_requirement()
        if req < 0 {
            return
        }
        // A refining trait's conformance (`Error`'s) lists the member again.
        var refused = Vector<Int>()
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            if c.type_decl < 0 {
                continue
            }
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                if st.kind != TcStatusKind.Written || st.requirement != req || st.member < 0 || not self.is_function_decl(st.member) {
                    continue
                }
                if not self.summaries[st.member].suspends || tc_contains(&refused, st.member) {
                    continue
                }
                try! refused.push(st.member)
                var msg = StringBuilder()
                try! msg.append("`Printable.format` must not suspend, and `")
                try! msg.append(self.nominal_name(c.type_decl))
                try! msg.append("`'s does: ")
                try! msg.append(self.suspend_chain(st.member))
                try! msg.append(". ")
                try! msg.append(tc_format_sync_reason())
                let info = self.res.decls[st.member]
                let site = self.decl_site(st.member)
                self.refuse_in(info.module, site, "effect.format-suspends", msg.build())
            }
        }
    }

    // `Printable`'s `format` requirement, or -1.
    func format_requirement(&self) -> Int {
        let printable = self.known.printable
        if printable < 0 {
            return -1
        }
        let reqs = self.members_of(printable)
        var j = 0
        while j < reqs.len() {
            // Stage 0 workaround (SL:hazards S4): canonical: if self.name_text(self.res.decls[reqs[j]].name).equals("format") {
            let name = self.res.decls[reqs[j]].name
            if self.name_text(name).equals("format") {
                return reqs[j]
            }
            j = j + 1
        }
        return -1
    }

    // `` `f` → `g` (parks the task) ``: function `d`, then each function its
    // first suspending call passes, to the source. A park point is std's
    // internal, so the path ends at the function that calls it; a `blocking`
    // extern is named as one.
    func suspend_chain(&var self, d: Int) -> String {
        var out = StringBuilder()
        try! out.append("`")
        try! out.append(self.res.decl_path(d))
        try! out.append("`")
        var visited = Vector<Int>()
        try! visited.push(d)
        var at = self.suspending_call_in(d)
        while at >= 0 {
            if self.parks_at(at) {
                try! out.append(" (parks the task)")
                return out.build()
            }
            try! out.append(" → ")
            let ci = self.call_at[at]
            let target = if ci >= 0 { self.calls[ci].target } else { -1 }
            let role = if ci >= 0 { self.calls[ci].role } else { TcRole.Builtin }
            if target >= 0 && role != TcRole.Builtin && role != TcRole.Value && self.res.decls[target].kind == ResDeclKind.Extern && (self.sigs[target].flags & TC_FLAG_BLOCKING) != 0 {
                try! out.append("blocking extern ")
            }
            try! out.append(self.callee_text(at))
            if target < 0 || role == TcRole.Builtin || role == TcRole.Value || tc_contains(&visited, target) || self.summaries[target].state != TC_SUMMARY_BODY {
                return out.build()
            }
            try! visited.push(target)
            at = self.suspending_call_in(target)
        }
        out.build()
    }

    // The first call in function `d`'s own body that may suspend, or -1.
    func suspending_call_in(&var self, d: Int) -> Int {
        let u = self.decl_unit[d]
        if u < 0 {
            return -1
        }
        let unit = self.units[u]
        var k = unit.item_first
        while k < unit.item_end {
            let item = self.items[k]
            k = k + 1
            if item.kind != TC_ITEM_CALL || item.unit != u {
                continue
            }
            var acc = TcAcc(owner: d, unit: -1)
            self.eval_call(item.node, &var acc)
            if acc.suspends {
                return item.node
            }
        }
        return -1
    }

    // A generic body's inferred Copy requirement against what its signature
    // declares (design 219): a public generic declares the tier its body
    // needs, so editing the body cannot tighten a published contract, and a
    // declared `ExplicitCopy` licenses a spelled `.copy()` only, never a
    // silent copy. Each is refused at the declaration, once per parameter.
    // A requirement on a parameter of a method's type is declared by the
    // method's extension, as `extension Vector<T: Copy>` (SL-501).
    func check_declared_requirements(&var self) {
        var d = 0
        while d < self.summaries.len() {
            let s = self.summaries[d]
            if s.state == TC_SUMMARY_BODY && s.copy_count > 0 {
                self.check_declared_copy(d, &s)
            }
            d = d + 1
        }
    }

    func check_declared_copy(&var self, d: Int, s: &TcSummary) {
        var seen = Vector<Int>()
        let ext = self.enclosing_extension(d)
        let owner = if ext >= 0 { self.ext_target(ext) } else { -1 }
        var k = 0
        while k < s.copy_count {
            let a = self.atoms[s.copy_first + k]
            k = k + 1
            let info = self.types.ty(a.ty)
            let on_type = owner >= 0 && info.decl == owner
            if info.kind != TcKind.Param || (info.decl != d && not on_type) || tc_contains(&seen, a.ty) {
                continue
            }
            try! seen.push(a.ty)
            let declarer = if on_type { ext } else { d }
            let g = self.generic(declarer, info.a)
            let ec = self.known.explicit_copy
            let c = self.known.copy
            if on_type && c >= 0 && self.generic_grants(ext, info.a, c) {
                continue
            }
            if ec >= 0 && self.generic_grants(declarer, info.a, ec) {
                let declares = if on_type { "is in an extension that declares `" } else { "declares `" }
                self.refuse_declared_copy(d, &a, g.name, declares, ": ExplicitCopy`, which licenses a spelled `.copy()`, but its body needs `", on_type)
            } else if self.publishes(d) {
                let declares = if on_type { "is public, so its extension must declare the tier it requires: `" } else { "is public, so it must declare the tier it requires: `" }
                self.refuse_declared_copy(d, &a, g.name, declares, "` is undeclared, and its body needs `", on_type)
            }
        }
    }

    // Whether declaration `d` is published: written `public`, or a trait
    // default body of a `public` trait, which is as visible as its trait.
    func publishes(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        if info.vis == ResVis.Public {
            return true
        }
        info.kind == ResDeclKind.Requirement && info.parent >= 0 && self.res.decls[info.parent].vis == ResVis.Public
    }

    // The extension method `d` is a member of, or -1.
    func enclosing_extension(&self, d: Int) -> Int {
        let parent = self.res.decls[d].parent
        if parent < 0 || self.res.decls[parent].kind != ResDeclKind.Extension {
            return -1
        }
        parent
    }

    func refuse_declared_copy(&var self, d: Int, a: &TcAtom, name: Int, before: String, after: String, on_type: Bool) {
        let info = self.res.decls[d]
        let param = self.name_text(name)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` ")
        try! msg.append(before)
        try! msg.append(param)
        try! msg.append(after)
        try! msg.append(param)
        try! msg.append("` to be `Copy`, as it ")
        try! msg.append(self.copy_origin_text(a.origin))
        try! msg.append(" with nothing written: declare `")
        try! msg.append(param)
        if on_type {
            try! msg.append(": Copy` on the extension, or move the method to an extension that does, or write `.copy()` where it duplicates")
        } else {
            try! msg.append(": Copy`, or write `.copy()` where it duplicates")
        }
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "copy.declared-bound", msg.build())
    }

    // Every item of top unit `u` and its closures.
    func check_unit_items(&var self, u: Int) {
        let top = self.units[u]
        let owner = top.decl
        var k = top.item_first
        while k < top.item_end {
            let item = self.items[k]
            k = k + 1
            let unit = self.units[item.unit]
            if item.kind == TC_ITEM_CALL {
                self.note_untabled(item.node)
                if unit.sync {
                    self.check_sync_call(item.node, unit, owner)
                }
                if unit.thread {
                    self.check_thread_call(item.node, owner, unit.node < 0)
                } else if unit.node >= 0 {
                    self.check_closure_call(item.node, owner)
                }
                if self.spawn_roots[item.node] || self.drive_roots[item.node] {
                    self.check_task_root(item.node, owner)
                }
                self.check_call_site(item.node, owner)
            } else if item.kind == TC_ITEM_ERASE {
                self.check_erasure(item.node, owner)
            }
        }
    }

    // A call inside a `sync` body must be sync-callable. Inside a generic
    // body a call whose answer depends on a type argument is judged at each
    // instantiation, through the body's `refuses-when` conditions.
    func check_sync_call(&var self, e: Int, unit: TcUnit, owner: Int) {
        var acc = TcAcc(owner: owner, unit: -1)
        self.eval_call(e, &var acc)
        if not acc.nonsync && not acc.suspends {
            return
        }
        var msg = StringBuilder()
        var hook = false
        if unit.node >= 0 {
            try! msg.append("this closure's type is `sync`, and it calls ")
        } else {
            let info = self.res.decls[owner]
            let name = self.name_text(info.name)
            try! msg.append("`")
            try! msg.append(self.res.decl_path(owner))
            if name.equals("deinit") && not self.declares_sync(owner) {
                hook = true
                try! msg.append("` is a `deinit`, which runs where nothing may suspend, and it calls ")
            } else {
                try! msg.append("` is declared `sync`, and it calls ")
            }
        }
        try! msg.append(self.blamed_call_text(e, owner, acc.suspends))
        // A pair, `Thread.join` among them, blocks in thread context, which a
        // `deinit` declared `blocking` is (spec, Blocking drops).
        if hook && (acc.thread_causes & TC_CAUSE_PAIRED) != 0 && tc_thread_struck(acc.thread_causes) == 0 {
            try! msg.append(". In thread context the call blocks instead: declare it `func deinit(&var self) blocking`, so that a `")
            try! msg.append(self.deinit_owner_text(owner))
            try! msg.append("` drops only in thread context")
        }
        self.refuse_at(e, "effect.sync", msg.build())
    }

    // What the call at `e` does that suspends, or, when `suspends` is false,
    // that is not sync-callable: its target, or else a default it leaves
    // out, which the caller evaluates. `` `f`, which may suspend `` or
    // `` `f` leaving out `n`, whose default value may suspend ``.
    func blamed_call_text(&var self, e: Int, owner: Int, suspends: Bool) -> String {
        let effect = if suspends { "may suspend" } else { "is not sync-callable" }
        var out = StringBuilder()
        try! out.append(self.callee_text(e))
        var target = TcAcc(owner: owner, unit: -1)
        self.eval_target(e, &var target)
        let at = self.call_at[e]
        if (target.suspends || (not suspends && target.nonsync)) || at < 0 {
            try! out.append(", which ")
            try! out.append(effect)
            return out.build()
        }
        let c = self.calls[at]
        var j = 0
        while j < c.bind_count && c.bind_first >= 0 {
            if self.binds[c.bind_first + j] == TC_BIND_DEFAULT {
                var one = TcAcc(owner: owner, unit: -1)
                self.eval_default(e, j, &var one)
                if one.suspends || (not suspends && one.nonsync) {
                    let param = self.params[self.sigs[c.target].param_first + j]
                    try! out.append(" leaving out `")
                    try! out.append(self.name_text(param.name))
                    try! out.append("`, whose default value ")
                    try! out.append(effect)
                    return out.build()
                }
            }
            j = j + 1
        }
        try! out.append(", which ")
        try! out.append(effect)
        out.build()
    }

    // A call inside a closure body must not suspend (spec: suspension, "a
    // closure body cannot suspend"); one that suspends only at some
    // instantiation is refused at the call that makes it.
    func check_closure_call(&var self, e: Int, owner: Int) {
        var acc = TcAcc(owner: owner, unit: -1)
        self.eval_call(e, &var acc)
        if not acc.suspends {
            if (acc.causes & TC_CAUSE_BLOCKS_THREAD) != 0 {
                self.refuse_closure_block(e)
            }
            return
        }
        var msg = StringBuilder()
        try! msg.append("a closure body cannot suspend, and this calls ")
        try! msg.append(self.blamed_call_text(e, owner, true))
        try! msg.append(": call it outside the closure")
        self.refuse_at(e, "effect.closure-suspends", msg.build())
    }

    // A call in a closure body that blocks the thread (spec, Where
    // `blocking` is written): a closure is called wherever its value goes,
    // where no task root sees the call, so it may not block, as it may not
    // suspend. A `Thread.spawn` brace is thread context, and no closure here.
    func refuse_closure_block(&var self, e: Int) {
        var msg = StringBuilder()
        try! msg.append("a closure body cannot block its thread, and this calls ")
        try! msg.append(self.block_chain(e))
        try! msg.append(": a closure runs wherever its value is called, a task included, where nothing sees the call; call it outside the closure")
        self.refuse_at(e, "effect.closure-blocks", msg.build())
    }

    // A call in a thread-context body, a `Thread.spawn` brace's or a
    // `blocking` function's (`own`), must not suspend: a `blocking` extern
    // blocks the thread on purpose, a `blocking` function blocks it too, and
    // a pair runs its twin (spec, The thread body; Blocking functions), but
    // the thread runs no executor to resume any other suspension. The
    // refusal names the path to the first source it strikes on.
    func check_thread_call(&var self, e: Int, owner: Int, own: Bool) {
        var acc = TcAcc(owner: owner, unit: -1)
        self.eval_call(e, &var acc)
        if tc_thread_struck(acc.thread_causes) == 0 {
            return
        }
        var msg = StringBuilder()
        if own {
            try! msg.append("cannot suspend in `")
            try! msg.append(self.res.decl_path(owner))
            try! msg.append("`, which is `blocking`: it calls ")
            try! msg.append(self.thread_chain(e))
            try! msg.append(": a `blocking` body is thread context, where no executor runs to resume a suspension. A `blocking` extern, another `blocking` function and a pair, which runs its `blocking` twin there, are what it may call")
            self.refuse_at(e, "effect.blocking-body", msg.build())
            return
        }
        try! msg.append("cannot suspend in a `Thread.spawn \{ ... \}` body: closure calls ")
        try! msg.append(self.thread_chain(e))
        try! msg.append(": a spawned thread runs no executor, so there is nothing there to resume a suspension, and it would simply not cede. For suspending work on a dedicated thread write `TaskGroup(threads: 1)`, which brings an executor with it; a `blocking` extern is the one thing this body may do, and it blocks the spawned thread on purpose")
        self.refuse_at(e, "effect.thread-body", msg.build())
    }

    // The path from the call at `e` to the first suspension source a
    // `Thread.spawn` body refuses: each function it passes, `` `f` → ``, then
    // the source, `__saw_suspend` or a call through a function value; a std
    // function the table answers for ends in its row's label. A park point is
    // std's internal, so the path ends at the function that calls it, `` `f`
    // (parks the task) ``.
    func thread_chain(&var self, e: Int) -> String {
        var out = StringBuilder()
        var visited = Vector<Int>()
        var at = e
        while at >= 0 {
            let ci = self.call_at[at]
            let c = self.calls[ci]
            if c.role == TcRole.Value {
                try! out.append("a call through a non-`sync` function value")
                return out.build()
            }
            let d = c.target
            if d < 0 || c.role == TcRole.Builtin {
                try! out.append(self.callee_text(at))
                return out.build()
            }
            let info = self.res.decls[d]
            let name = self.name_text(info.name)
            if self.is_park_point(d) {
                try! out.append(self.callee_text(at))
                try! out.append(" (parks the task)")
                return out.build()
            }
            if info.kind == ResDeclKind.Extern {
                try! out.append(self.callee_text(at))
                return out.build()
            }
            let s = self.summaries[d]
            if s.state == TC_SUMMARY_TABLE {
                let row = self.std_row_of(d)
                let label = if row >= 0 { self.std_rows.labels.get(row) ?? "" } else { "" }
                if label.equals(name) {
                    try! out.append(label)
                    return out.build()
                }
                try! out.append(self.callee_text(at))
                if label.len() > 0 {
                    try! out.append(" → ")
                    try! out.append(label)
                }
                return out.build()
            }
            try! out.append(self.callee_text(at))
            if s.state != TC_SUMMARY_BODY || tc_contains(&visited, d) {
                return out.build()
            }
            try! visited.push(d)
            at = self.struck_call_in(d)
            if at >= 0 && self.parks_at(at) {
                try! out.append(" (parks the task)")
                return out.build()
            }
            if at >= 0 {
                try! out.append(" → ")
            }
        }
        out.build()
    }

    // Whether the call at `e` is a park point's.
    func parks_at(&self, e: Int) -> Bool {
        let ci = self.call_at[e]
        if ci < 0 {
            return false
        }
        let c = self.calls[ci]
        c.target >= 0 && c.role != TcRole.Builtin && c.role != TcRole.Value && self.is_park_point(c.target)
    }

    // The first call in function `d`'s own body that may suspend by a cause a
    // `Thread.spawn` body refuses, or -1.
    func struck_call_in(&var self, d: Int) -> Int {
        let u = self.decl_unit[d]
        if u < 0 {
            return -1
        }
        let unit = self.units[u]
        var k = unit.item_first
        while k < unit.item_end {
            let item = self.items[k]
            k = k + 1
            if item.kind != TC_ITEM_CALL || item.unit != u {
                continue
            }
            var acc = TcAcc(owner: d, unit: -1)
            self.eval_call(item.node, &var acc)
            if tc_thread_struck(acc.thread_causes) != 0 {
                return item.node
            }
        }
        return -1
    }

    // The path from the call at `e` to the `blocking` function it blocks the
    // thread through: each function it passes, `` `f` → ``, then the
    // `blocking` one, `` `g` (blocking) ``.
    func block_chain(&var self, e: Int) -> String {
        var out = StringBuilder()
        var visited = Vector<Int>()
        var at = e
        while at >= 0 {
            let ci = self.call_at[at]
            if ci < 0 {
                break
            }
            let d = self.calls[ci].target
            try! out.append(self.callee_text(at))
            if d < 0 || self.declares_blocking(d) {
                try! out.append(" (blocking)")
                return out.build()
            }
            if tc_contains(&visited, d) {
                return out.build()
            }
            try! visited.push(d)
            at = self.blocking_call_in(d)
            if at >= 0 {
                try! out.append(" → ")
            }
        }
        out.build()
    }

    // The first call in function `d`'s own body that blocks the thread, or
    // -1.
    func blocking_call_in(&var self, d: Int) -> Int {
        let u = self.decl_unit[d]
        if u < 0 {
            return -1
        }
        let unit = self.units[u]
        var k = unit.item_first
        while k < unit.item_end {
            let item = self.items[k]
            k = k + 1
            if item.kind != TC_ITEM_CALL || item.unit != u {
                continue
            }
            var acc = TcAcc(owner: d, unit: -1)
            self.eval_call(item.node, &var acc)
            if (acc.causes & TC_CAUSE_BLOCKS_THREAD) != 0 {
                return item.node
            }
        }
        return -1
    }

    // THE TASK-ROOT FUNNEL: a task root that reaches a `blocking` function,
    // refused at the root with the path (spec, Blocking functions): a task
    // runs on the executor's thread, so blocking it stops every task there,
    // the one that would wake the block included. A call in an ordinary
    // function is never refused for it. The roots are a `Task.spawn` or
    // `group.spawn` root and a drive's, and a `main` that suspends.
    //
    // ENTRY POINTS:
    //     check_unit_items
    //     check_entry_root
    func check_task_root(&var self, e: Int, owner: Int) {
        var acc = TcAcc(owner: owner, unit: -1)
        self.eval_made_call(e, &var acc)
        if (acc.causes & TC_CAUSE_BLOCKS_THREAD) == 0 {
            return
        }
        var msg = StringBuilder()
        if self.drive_roots[e] {
            try! msg.append("a driven root blocks its thread here: the drive runs ")
        } else {
            try! msg.append("a task blocks its thread here: the task runs ")
        }
        try! msg.append(self.block_chain(e))
        try! msg.append(", which would stop the executor's thread and every task on it. Call it from a `Thread.spawn` body, or from a `main` that runs no executor")
        self.refuse_at(e, "effect.task-blocks", msg.build())
    }

    // The entry module's `main` when it suspends, which makes it run the
    // executor, and blocks: `check_task_root`'s refusal, at `main`'s first
    // call that blocks.
    func check_entry_root(&var self) {
        let m = self.entry_module_index()
        if m < 0 {
            return
        }
        let d = self.top_decl(m, "main")
        if d < 0 || not self.is_function_decl(d) || self.declares_blocking(d) {
            return
        }
        let s = self.summaries[d]
        if not s.suspends || (s.causes & TC_CAUSE_BLOCKS_THREAD) == 0 {
            return
        }
        let at = self.blocking_call_in(d)
        if at < 0 {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`main` suspends, so it runs the executor, and it blocks its thread here: it calls ")
        try! msg.append(self.block_chain(at))
        try! msg.append(", which would stop the executor's thread and every task on it. Call it from a `Thread.spawn` body, or from a `main` that never suspends")
        self.refuse_at(at, "effect.task-blocks", msg.build())
    }

    // The entry module's index, or -1.
    func entry_module_index(&self) -> Int {
        var m = 0
        while m < self.res.module_count() {
            let info = self.res.module(m)
            if info.kind == ResModuleKind.Entry && info.available {
                return m
            }
            m = m + 1
        }
        return -1
    }

    // The call at `e`, where its callee's Copy requirement and forbidden
    // conditions meet the call's type arguments, and so do those of each
    // default it leaves out, which the caller evaluates.
    func check_call_site(&var self, e: Int, owner: Int) {
        let at = self.call_at[e]
        if at < 0 {
            return
        }
        let c = self.calls[at]
        if c.target < 0 {
            return
        }
        let d = c.target
        if self.is_function_decl(d) {
            let s = self.summaries[d]
            self.check_summary_at(e, owner, d, &s, &c)
        }
        var j = 0
        while j < c.bind_count && c.bind_first >= 0 {
            let filled = self.binds[c.bind_first + j] == TC_BIND_DEFAULT
            let k = if filled { self.default_at.first(d, j) } else { -1 }
            j = j + 1
            if k >= 0 {
                let s = self.defaults[self.default_at.value(k)].summary
                self.check_summary_at(e, owner, d, &s, &c)
            }
        }
    }

    // Summary `s`, of function `d` or one of its defaults, at call `c` at
    // `e`: each Copy requirement and forbidden condition at the call's type
    // arguments.
    func check_summary_at(&var self, e: Int, owner: Int, d: Int, s: &TcSummary, c: &TcCall) {
        var k = 0
        while k < s.copy_count {
            let a = self.atoms[s.copy_first + k]
            k = k + 1
            let t = self.call_subst(a.ty, d, &c)
            var acc = TcAcc(owner: owner, unit: -1)
            if not self.copy_needs(t, e, a.origin, &var acc) {
                self.refuse_copy_requirement(e, d, &a, t)
            }
        }
        k = 0
        while k < s.forbid_count {
            let a = self.atoms[s.forbid_first + k]
            k = k + 1
            let t = self.call_subst(a.ty, d, &c)
            let recv = self.strip_refs(t)
            if self.is_own_condition(recv, owner) {
                continue
            }
            var acc = TcAcc(owner: owner, unit: -1)
            let sync_kind = a.kind == TC_FORBID_SYNC
            self.eval_condition(recv, a.req, e, not sync_kind, &var acc)
            if a.kind == TC_FORBID_THREAD {
                if acc.suspends && tc_thread_struck(acc.thread_causes) != 0 {
                    self.refuse_forbidden(e, d, &a, recv)
                }
            } else if (sync_kind && acc.nonsync) || (not sync_kind && acc.suspends) {
                self.refuse_forbidden(e, d, &a, recv)
            }
        }
    }

    // A coercion of a concrete value into `any Trait` at `id`: refused when
    // the implementation of a requirement the dispatch reaches, not declared
    // `sync`, may suspend (spec: suspension, "a dispatch to a suspending
    // implementation is refused").
    func check_erasure(&var self, id: Int, owner: Int) {
        let tr = self.erased_trait(id)
        let before = self.erased_from(id)
        let from = self.strip_refs(before)
        if tr < 0 || self.is_own_condition(from, owner) || self.kind_of(from) == TcKind.Error {
            return
        }
        let reqs = self.dispatched_requirements(tr)
        var k = 0
        while k < reqs.len() {
            let req = reqs[k]
            k = k + 1
            var acc = TcAcc(owner: owner, unit: -1)
            self.eval_condition(from, req, id, true, &var acc)
            if acc.suspends {
                self.refuse_suspending_dispatch(id, from, tr, req)
                return
            }
        }
    }

    // A `sync` requirement met by a member not declared `sync` holds when
    // the member is sync-callable, which its summary answers.
    func check_sync_requirements(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                if st.kind != TcStatusKind.Written || st.member < 0 || not self.declares_sync(st.requirement) {
                    continue
                }
                if self.declares_sync(st.member) || not self.is_function_decl(st.member) {
                    continue
                }
                let s = self.summaries[st.member]
                if not s.nonsync && s.nonsync_count == 0 {
                    continue
                }
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.res.decl_path(st.member))
                try! msg.append("` meets `")
                try! msg.append(self.res.decl_path(st.requirement))
                try! msg.append("`, which is declared `sync`, but it is not sync-callable: declare it `sync`, and call only sync-callable targets in it")
                let info = self.res.decls[st.member]
                let site = self.decl_site(st.member)
                self.refuse_in(info.module, site, "effect.sync", msg.build())
            }
        }
    }

    // The declaration-site rules of blocking functions (spec, Blocking
    // functions): where `blocking` may stand, what may not block because no
    // task root sees its call, a pair's default, and the public boundary.
    func check_blocking_declarations(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let kind = self.res.decls[d].kind
            if kind == ResDeclKind.Func || kind == ResDeclKind.Method || kind == ResDeclKind.Init || kind == ResDeclKind.Requirement {
                self.check_blocking_declaration(d)
            }
            d = d + 1
        }
        self.check_blocking_conformances()
        self.check_blocking_containment()
        self.check_extern_declarations()
    }

    // THE EXTERN FUNNEL: every extern declaration of the program, std's
    // included. A `blocking` one is refused under the freestanding profile,
    // which has no offload thread pool, and otherwise takes and returns only
    // the C-ABI set an `@export` admits. Every declaration of one C symbol
    // agrees on its whole signature and on `blocking`, since the program calls
    // one C function by that name; each is judged against one reference, a
    // std module's when there is one, so a redeclaration of a std seam is
    // refused where the program writes it.
    // ENTRY POINTS:
    //     check_blocking_declarations
    func check_extern_declarations(&var self) {
        var symbols = Vector<String>()
        var references = Vector<Int>()
        var d = 0
        while d < self.res.decls.len() {
            if self.is_checked_extern(d) {
                // Stage 0 workaround (SL:hazards S4): canonical: let symbol = self.name_text(self.res.decls[d].name)
                let name = self.res.decls[d].name
                let symbol = self.name_text(name)
                let at = tc_symbol_index(&symbols, symbol)
                if at < 0 {
                    try! symbols.push(symbol)
                    try! references.push(d)
                } else {
                    let first = references[at]
                    if not self.is_std_decl(first) && self.is_std_decl(d) {
                        references[at] = d
                    }
                }
            }
            d = d + 1
        }
        d = 0
        while d < self.res.decls.len() {
            if self.is_checked_extern(d) {
                // Stage 0 workaround (SL:hazards S4): canonical: let symbol = self.name_text(self.res.decls[d].name)
                let name = self.res.decls[d].name
                let symbol = self.name_text(name)
                let reference = references[tc_symbol_index(&symbols, symbol)]
                if self.check_extern_profile(d) && self.check_offload_signature(d) && reference != d {
                    self.check_extern_agreement(d, reference)
                }
            }
            d = d + 1
        }
    }

    // Whether declaration `d` is an extern of an available module.
    func is_checked_extern(&self, d: Int) -> Bool {
        let info = self.res.decls[d]
        info.kind == ResDeclKind.Extern && self.res.module(info.module).available
    }

    // Whether declaration `d` belongs to a std module.
    func is_std_decl(&self, d: Int) -> Bool {
        // Stage 0 workaround (SL:hazards S4): canonical: self.res.module(self.res.decls[d].module).kind == ResModuleKind.Std
        let m = self.res.decls[d].module
        self.res.module(m).kind == ResModuleKind.Std
    }

    // Whether extern `d` may stand under the program's profile: a `blocking`
    // one is offloaded, and the freestanding runtime has no thread pool to
    // offload it to. Every std module is read whatever a program imports, so
    // a std module's extern says nothing about the program, and only the
    // program's own declarations are judged.
    func check_extern_profile(&var self, d: Int) -> Bool {
        if not self.freestanding || (self.sigs[d].flags & TC_FLAG_BLOCKING) == 0 || self.is_std_decl(d) {
            return true
        }
        var msg = StringBuilder()
        try! msg.append("`extern blocking func ")
        // Stage 0 workaround (SL:hazards S4): canonical: try! msg.append(self.name_text(self.res.decls[d].name))
        let name = self.res.decls[d].name
        try! msg.append(self.name_text(name))
        try! msg.append("` is not available in the freestanding profile: blocking-call offload needs the hosted thread pool, which the freestanding runtime does not provide; drop `blocking` (an unannotated extern promises promptness) or keep this module out of the freestanding build")
        self.refuse_blocking_decl(d, "extern.freestanding-blocking", msg.build())
        false
    }

    // Whether `blocking` extern `d`'s signature is one the offload thunk can
    // carry: each parameter and the result are C-ABI words, as an `@export`'s
    // are, since a worker thread makes the plain C call with them. Every
    // parameter out of that set is refused, then the result.
    func check_offload_signature(&var self, d: Int) -> Bool {
        let s = self.sigs[d]
        if (s.flags & TC_FLAG_BLOCKING) == 0 {
            return true
        }
        // Stage 0 workaround (SL:hazards S4): canonical: let name = self.name_text(self.res.decls[d].name)
        let id = self.res.decls[d].name
        let name = self.name_text(id)
        var ok = true
        var k = 0
        while k < s.param_count {
            let prm = self.params[s.param_first + k]
            k = k + 1
            if self.export_class(prm.ty, false).len() > 0 {
                continue
            }
            var msg = StringBuilder()
            try! msg.append("`extern blocking func ")
            try! msg.append(name)
            try! msg.append("`: parameter `")
            try! msg.append(self.name_text(prm.name))
            try! msg.append("` has type ")
            try! msg.append(self.c_abi_type_text(prm.ty))
            try! msg.append(", which is not C-ABI-safe: an offloaded signature allows fixed-width integers, `Int`/`UInt`, `Float` and pointers; pass an aggregate by `UnsafePointer<S>`, and keep what it points at in frame-owned or heap storage so it outlives the park")
            let info = self.res.decls[d]
            let at = if prm.leaf >= 0 { prm.leaf } else { self.decl_site(d) }
            self.refuse_in(info.module, at, "extern.offload-c-abi", msg.build())
            ok = false
        }
        if self.export_class(s.result, true).len() == 0 {
            var msg = StringBuilder()
            try! msg.append("`extern blocking func ")
            try! msg.append(name)
            try! msg.append("`: return type ")
            try! msg.append(self.c_abi_type_text(s.result))
            try! msg.append(" is not C-ABI-safe: an offloaded return allows a fixed-width integer, `Int`/`UInt`, `Float`, a pointer, `Void` or `Never`, the one value the job carries back")
            self.refuse_blocking_decl(d, "extern.offload-c-abi", msg.build())
            ok = false
        }
        ok
    }

    // Type `t` as a C-ABI refusal names it: an optional by its kind, since
    // no optional crosses the C boundary, and any other type by its spelling.
    func c_abi_type_text(&self, t: Int) -> String {
        if self.nominal_decl(t) == self.known.optional {
            return "an optional (`T?`)"
        }
        var out = StringBuilder()
        try! out.append("`")
        try! out.append(self.type_text(t))
        try! out.append("`")
        out.build()
    }

    // Extern `d` against `reference`, another declaration of its C symbol:
    // the same parameter types, variadic or not, and result, and the same
    // `blocking`.
    func check_extern_agreement(&var self, d: Int, reference: Int) {
        // Stage 0 workaround (SL:hazards S4): canonical: let symbol = self.name_text(self.res.decls[d].name)
        let name = self.res.decls[d].name
        let symbol = self.name_text(name)
        // Stage 0 workaround (SL:hazards S4): canonical: let other = self.res.module_name(self.res.decls[reference].module)
        let home = self.res.decls[reference].module
        let other = self.res.module_name(home)
        if not self.same_extern_types(d, reference) {
            let mine = self.extern_signature_text(d)
            let theirs = self.extern_signature_text(reference)
            var msg = StringBuilder()
            try! msg.append("`")
            try! msg.append(symbol)
            try! msg.append("` is declared here as `")
            try! msg.append(mine)
            try! msg.append("`, but another declaration of the same symbol, in `")
            try! msg.append(other)
            try! msg.append("`, declares it `")
            try! msg.append(theirs)
            try! msg.append("`: the program calls one C function by that name, so every declaration of one symbol must agree on its parameters and its result; declare it as the other does, or offload or wrap a distinctly-named function of your own")
            self.refuse_blocking_decl(d, "extern.signature-disagree", msg.build())
        }
        let blocks = (self.sigs[d].flags & TC_FLAG_BLOCKING) != 0
        if blocks == ((self.sigs[reference].flags & TC_FLAG_BLOCKING) != 0) {
            return
        }
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(symbol)
        if blocks {
            try! msg.append("` is declared `blocking` here, but another declaration of the same symbol, in `")
            try! msg.append(other)
            try! msg.append("`, says the opposite")
        } else {
            try! msg.append("` is declared without `blocking` here, but another declaration of the same symbol, in `")
            try! msg.append(other)
            try! msg.append("`, says `blocking`")
        }
        try! msg.append(": `blocking` is part of an extern's contract (it makes every call a suspension point), so every declaration of one symbol must agree; annotate the declaration they share, or offload a distinctly-named wrapper of your own instead")
        self.refuse_blocking_decl(d, "extern.blocking-disagree", msg.build())
    }

    // Whether externs `d` and `e` agree on arity, variadic-ness, and each
    // parameter's and the result's type (`extern_types_agree`).
    func same_extern_types(&self, d: Int, e: Int) -> Bool {
        let a = self.sigs[d]
        let b = self.sigs[e]
        if (a.param_count != b.param_count || not self.extern_types_agree(a.result, b.result)
            || (a.flags & TC_FLAG_VARIADIC) != (b.flags & TC_FLAG_VARIADIC)) {
            return false
        }
        var k = 0
        while k < a.param_count {
            let mine = self.params[a.param_first + k].ty
            let theirs = self.params[b.param_first + k].ty
            if not self.extern_types_agree(mine, theirs) {
                return false
            }
            k = k + 1
        }
        true
    }

    // Whether two declarations' types at one position of a C symbol agree:
    // the same interned type, or two pointers, since a pointer is one machine
    // word to C and one `ptr` to the backend whatever it points at.
    func extern_types_agree(&self, a: Int, b: Int) -> Bool {
        a == b || (self.is_extern_pointer(a) && self.is_extern_pointer(b))
    }

    // Whether type `t` is a raw pointer: `UnsafePointer`, `UnsafeConstPointer`
    // or `FuncPointer`.
    func is_extern_pointer(&self, t: Int) -> Bool {
        let d = self.nominal_decl(t)
        let k = self.known
        d >= 0 && (d == k.unsafe_pointer || d == k.unsafe_const_pointer || d == k.func_pointer)
    }

    // Extern `d`'s signature as a refusal spells it: `(T, U, ...) -> R`.
    func extern_signature_text(&self, d: Int) -> String {
        let s = self.sigs[d]
        var out = StringBuilder()
        try! out.append("(")
        var k = 0
        while k < s.param_count {
            if k > 0 {
                try! out.append(", ")
            }
            // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(self.type_text(self.params[s.param_first + k].ty))
            let t = self.params[s.param_first + k].ty
            try! out.append(self.type_text(t))
            k = k + 1
        }
        if (s.flags & TC_FLAG_VARIADIC) != 0 {
            if s.param_count > 0 {
                try! out.append(", ")
            }
            try! out.append("...")
        }
        try! out.append(") -> ")
        try! out.append(self.type_text(s.result))
        out.build()
    }

    // A `deinit` not declared `blocking` whose body blocks: it runs wherever
    // its value drops, a task included, where no task root sees the call.
    func refuse_deinit_block(&var self, d: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` blocks its thread")
        self.append_block_reason(&var msg, d)
        try! msg.append(", and a `deinit` not declared `blocking` runs wherever its value drops, a task included. Declare it `func deinit(&var self) blocking`, so that a `")
        try! msg.append(self.deinit_owner_text(d))
        try! msg.append("` drops only in thread context, or keep the blocking work in a method called from thread context")
        self.refuse_blocking_decl(d, "effect.blocking-hook", msg.build())
    }

    // The path of the type `deinit` `d` belongs to.
    func deinit_owner_text(&self, d: Int) -> String {
        let ext = self.enclosing_extension(d)
        if ext < 0 {
            let parent = self.res.decls[d].parent
            return self.res.decl_path(parent)
        }
        let target = self.ext_target(ext)
        self.res.decl_path(target)
    }

    // The `blocking` `deinit` some extension of type declaration `d` writes,
    // or -1.
    func blocking_deinit_of(&var self, d: Int) -> Int {
        let name = self.res.intern("deinit")
        var at = self.extensions_of.first(d, 0)
        while at >= 0 {
            let ext = self.extensions_of.value(at)
            let listed = self.members_of(ext)
            var k = 0
            while k < listed.len() {
                let m = listed[k]
                k = k + 1
                if self.res.decls[m].kind == ResDeclKind.Method && self.res.decls[m].name == name && self.declares_blocking(m) {
                    return m
                }
            }
            at = self.extensions_of.following(at)
        }
        return -1
    }

    // THE CONTAINMENT FUNNEL: the type declaration whose `blocking` `deinit`
    // a drop of type `t` reaches, judged from the declarations alone, or -1
    // (spec, Blocking drops). A generic type that writes a `deinit` is taken
    // to drop its arguments, since it may hold them through raw storage. This
    // answers only the public declaration's question; the post-mono drop
    // check decides each real drop. `seen` holds the nominal types on the
    // way, so a recursive type ends.
    // ENTRY POINTS:
    //     check_blocking_containment
    func drop_blocks_through(&var self, t: Int, seen: &var Vector<Int>) -> Int {
        if t < 0 {
            return -1
        }
        let info = self.types.ty(t)
        if info.kind == TcKind.Tuple {
            var k = 0
            while k < info.count {
                let element = self.types.arg(t, k)
                let found = self.drop_blocks_through(element, &var seen)
                if found >= 0 {
                    return found
                }
                k = k + 1
            }
            return -1
        }
        if info.kind == TcKind.Array {
            return self.drop_blocks_through(info.b, &var seen)
        }
        if info.kind != TcKind.Nominal {
            return -1
        }
        var k = 0
        while k < seen.len() {
            if seen[k] == t {
                return -1
            }
            k = k + 1
        }
        try! seen.push(t)
        let d = info.decl
        if self.blocking_deinit_of(d) >= 0 {
            return d
        }
        let sub = TcSubst(owner: d, args: self.nominal_args(t))
        let parts = self.owned_part_types(d)
        k = 0
        while k < parts.len() {
            let part = self.subst(parts[k], &sub)
            let found = self.drop_blocks_through(part, &var seen)
            if found >= 0 {
                return found
            }
            k = k + 1
        }
        let deinit_name = self.res.intern("deinit")
        if not self.has_written_deinit(d, deinit_name) {
            return -1
        }
        k = 0
        while k < info.count {
            let argument = self.types.arg(t, k)
            let found = self.drop_blocks_through(argument, &var seen)
            if found >= 0 {
                return found
            }
            k = k + 1
        }
        return -1
    }

    // The written types of type declaration `d`'s owned parts: each field's,
    // and each case's payload types.
    func owned_part_types(&self, d: Int) -> Vector<Int> {
        var out = Vector<Int>()
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let kind = self.res.decls[m].kind
            if kind == ResDeclKind.Field {
                try! out.push(self.sigs[m].result)
            } else if kind == ResDeclKind.Case {
                let s = self.sigs[m]
                var p = 0
                while p < s.param_count {
                    try! out.push(self.params[s.param_first + p].ty)
                    p = p + 1
                }
            }
        }
        move out
    }

    // A public struct or enum whose drop blocks at every instantiation, by a
    // part whose type names none of its own parameters, must declare a
    // `blocking` `deinit`, since its declaration is what another module
    // reads (spec, Blocking drops). A part typed by a parameter is the
    // instance's, decided post-mono.
    func check_blocking_containment(&var self) {
        var d = 0
        while d < self.res.decls.len() {
            let kind = self.res.decls[d].kind
            if (kind == ResDeclKind.Struct || kind == ResDeclKind.Enum) && self.publishes(d) && self.blocking_deinit_of(d) < 0 {
                self.check_type_containment(d)
            }
            d = d + 1
        }
    }

    func check_type_containment(&var self, d: Int) {
        let members = self.members_of(d)
        var k = 0
        while k < members.len() {
            let m = members[k]
            k = k + 1
            let kind = self.res.decls[m].kind
            var types = Vector<Int>()
            if kind == ResDeclKind.Field {
                try! types.push(self.sigs[m].result)
            } else if kind == ResDeclKind.Case {
                let s = self.sigs[m]
                var p = 0
                while p < s.param_count {
                    try! types.push(self.params[s.param_first + p].ty)
                    p = p + 1
                }
            }
            var j = 0
            while j < types.len() {
                let written = types[j]
                j = j + 1
                if self.mentions_param(written) {
                    continue
                }
                var seen = Vector<Int>()
                let blocker = self.drop_blocks_through(written, &var seen)
                if blocker >= 0 {
                    self.refuse_undeclared_containment(d, m, written, blocker)
                    return
                }
            }
        }
    }

    func refuse_undeclared_containment(&var self, d: Int, part: Int, written: Int, blocker: Int) {
        let name = self.res.decl_path(d)
        let part_name = self.res.decls[part].name
        let part_text = self.name_text(part_name)
        let deinit_name = self.res.intern("deinit")
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(name)
        try! msg.append("` is public and its drop blocks its thread (")
        if self.res.decls[part].kind == ResDeclKind.Field {
            try! msg.append("field `")
            try! msg.append(part_text)
            try! msg.append(": ")
        } else {
            try! msg.append("case `")
            try! msg.append(part_text)
            try! msg.append("` holding `")
        }
        try! msg.append(self.type_text(written))
        try! msg.append("` reaches `")
        try! msg.append(self.res.decl_path(blocker))
        try! msg.append("`'s `blocking` `deinit`), so its declaration must say so: ")
        if self.has_written_deinit(d, deinit_name) {
            try! msg.append("declare its `deinit` `blocking`")
        } else {
            try! msg.append("declare `func deinit(&var self) blocking \{\}` in its copy-policy extension")
        }
        self.refuse_blocking_decl(d, "effect.blocking-drop-undeclared", msg.build())
    }

    // Whether function `d` blocks its thread: declared `blocking`, or its body
    // reaches a function that is.
    func blocks_thread(&self, d: Int) -> Bool {
        self.declares_blocking(d) || (self.summaries[d].causes & TC_CAUSE_BLOCKS_THREAD) != 0
    }

    func check_blocking_declaration(&var self, d: Int) {
        let info = self.res.decls[d]
        let s = self.sigs[d]
        let declared = self.declares_blocking(d)
        if info.kind == ResDeclKind.Requirement {
            let default_body = (s.flags & TC_FLAG_DEFAULT_BODY) != 0
            if declared && default_body {
                self.refuse_blocking_decl(d, "effect.blocking-position", "a trait's default body is never `blocking`: it is an implementation, called through the requirement by a dispatch or a bound, where no task root sees the call. Write the blocking operation as a function of its own, and call it from thread context")
            } else if declared {
                self.refuse_blocking_decl(d, "effect.blocking-position", "a trait requirement is never `blocking`: its implementations are called through it, by a dispatch or a bound, where no task root sees the call. Write the blocking operation as a function of its own, and call it from thread context")
            } else if default_body && self.is_function_decl(d) && self.blocks_thread(d) {
                self.refuse_inferred_block(d, "effect.blocking-position", "is a trait's default body, an implementation called through the requirement where no task root sees the call, and it blocks its thread")
            }
            return
        }
        if declared && (s.effects & TC_EFFECT_SYNC) != 0 {
            self.refuse_blocking_decl(d, "effect.blocking-slot", "`blocking sync`: a `blocking` body never suspends, so `sync` adds nothing. Delete `sync`")
            return
        }
        if declared && (s.effects & TC_EFFECT_CONSTEXPR) != 0 {
            self.refuse_blocking_decl(d, "effect.blocking-slot", "`constexpr blocking`: compile-time evaluation runs on no thread a function could block. Delete one of the two")
            return
        }
        let name = self.name_text(info.name)
        if info.kind == ResDeclKind.Method && name.equals("deinit") {
            // A declared `blocking` deinit makes its type's drop block, which
            // the post-mono drop check holds to thread context (spec,
            // Blocking drops).
            if not declared && self.blocks_thread(d) {
                self.refuse_deinit_block(d)
            }
            return
        }
        if self.blocking_twin_of(d) >= 0 && (self.summaries[d].causes & TC_CAUSE_BLOCKS_THREAD) != 0 {
            self.refuse_inferred_block(d, "effect.blocking-default", "is a pair's default, the body every task runs, and it blocks its thread")
            return
        }
        if declared || (self.summaries[d].causes & TC_CAUSE_BLOCKS_THREAD) == 0 {
            return
        }
        let exported = self.res.decl_attribute(d, Alt.Attr_Attribute_Export) >= 0 || self.res.decl_attribute(d, Alt.Attr_Attribute_ExportSymbol) >= 0
        if self.publishes(d) || exported {
            self.refuse_undeclared_block(d, exported)
        }
    }

    // An implementation of a requirement that blocks its thread, declared or
    // inferred: refused at the implementation, since a call through the
    // requirement, by a dispatch or a bound, reaches it where no task root
    // sees the call. A copy policy's `copy()` is the compiler's own call.
    func check_blocking_conformances(&var self) {
        var k = 0
        while k < self.conformances.len() {
            let c = self.conformances[k]
            k = k + 1
            var j = 0
            while j < c.status_count {
                let st = self.statuses[c.status_first + j]
                j = j + 1
                if st.kind != TcStatusKind.Written || st.member < 0 || not self.is_function_decl(st.member) {
                    continue
                }
                let member_name = self.res.decls[st.member].name
                let name = self.name_text(member_name)
                if name.equals("deinit") || not self.blocks_thread(st.member) {
                    continue
                }
                if c.trait_decl == self.known.copy || c.trait_decl == self.known.explicit_copy {
                    self.refuse_hook_block(st.member, "a copy policy's `copy()` runs where the compiler copies the value, a task included")
                    continue
                }
                var msg = StringBuilder()
                try! msg.append("`")
                try! msg.append(self.res.decl_path(st.member))
                try! msg.append("` meets `")
                try! msg.append(self.res.decl_path(st.requirement))
                try! msg.append("`, and it blocks its thread")
                self.append_block_reason(&var msg, st.member)
                try! msg.append(": an implementation is called through its requirement, by a dispatch or a bound, where no task root sees the call, so it may not block. Keep the blocking work in a function of its own, called from thread context; a pair's default, which does not block, may meet a requirement")
                let info = self.res.decls[st.member]
                let site = self.decl_site(st.member)
                self.refuse_in(info.module, site, "effect.blocking-conformance", msg.build())
            }
        }
    }

    // ` (`f` → `g` (blocking))` for function `d` whose body blocks, or ""
    // for one declared `blocking`.
    func append_block_reason(&var self, msg: &var StringBuilder, d: Int) {
        if self.declares_blocking(d) {
            try! msg.append(", declared `blocking`")
            return
        }
        let at = self.blocking_call_in(d)
        if at < 0 {
            return
        }
        try! msg.append(" (`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` → ")
        try! msg.append(self.block_chain(at))
        try! msg.append(")")
    }

    func refuse_blocking_decl(&var self, d: Int, rule: String, message: String) {
        let info = self.res.decls[d]
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, rule, message)
    }

    // Function `d`, `what` (the refusal's middle), refused with the path.
    func refuse_inferred_block(&var self, d: Int, rule: String, what: String) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` ")
        try! msg.append(what)
        self.append_block_reason(&var msg, d)
        try! msg.append(": a task that runs it would stop the executor's thread and every task on it")
        self.refuse_blocking_decl(d, rule, msg.build())
    }

    // A body the compiler calls with no source call naming it, `what`, that
    // blocks its thread.
    func refuse_hook_block(&var self, d: Int, what: String) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` blocks its thread")
        self.append_block_reason(&var msg, d)
        try! msg.append(", and ")
        try! msg.append(what)
        try! msg.append(", where no source call names it and no task root sees it, so it may not block. Keep the blocking work in a method called from thread context")
        self.refuse_blocking_decl(d, "effect.blocking-hook", msg.build())
    }

    // A published function whose body blocks its thread, not declared
    // `blocking`: its signature is what a caller in another module reads,
    // and C's callers read nothing else.
    func refuse_undeclared_block(&var self, d: Int, exported: Bool) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        if exported {
            try! msg.append("` is `@export`ed and its body blocks the thread")
        } else {
            try! msg.append("` is public and its body blocks the thread")
        }
        self.append_block_reason(&var msg, d)
        try! msg.append(", so its signature must say so: declare it `")
        try! msg.append(self.blocking_fixit(d))
        try! msg.append("`")
        self.refuse_blocking_decl(d, "effect.blocking-undeclared", msg.build())
    }

    // Function `d`'s head with `blocking` in its effect slot, as the fix-it
    // writes it: `public func load(path: String) blocking -> Config`.
    func blocking_fixit(&var self, d: Int) -> String {
        let info = self.res.decls[d]
        let s = self.sigs[d]
        var out = StringBuilder()
        if info.vis == ResVis.Public {
            try! out.append("public ")
        }
        if (s.flags & TC_FLAG_STATIC) != 0 {
            try! out.append("static ")
        }
        if info.kind == ResDeclKind.Init {
            try! out.append("init(")
        } else {
            try! out.append("func ")
            try! out.append(self.name_text(info.name))
            try! out.append("(")
        }
        var k = 0
        var first = true
        match s.receiver {
            case Shared -> {
                try! out.append("&self")
                first = false
            },
            case Exclusive -> {
                try! out.append("&var self")
                first = false
            },
            case Absent -> {}
        }
        while k < s.param_count {
            if not first {
                try! out.append(", ")
            }
            first = false
            let p = self.params[s.param_first + k]
            try! out.append(self.name_text(p.name))
            try! out.append(": ")
            try! out.append(self.type_text(p.ty))
            k = k + 1
        }
        try! out.append(")")
        try! out.append(tc_effects_text(s.effects | TC_EFFECT_BLOCKING))
        if (s.flags & TC_FLAG_WRITTEN_RETURN) != 0 {
            try! out.append(" -> ")
            try! out.append(self.type_text(s.result))
        }
        out.build()
    }

    // A NOTE, once per function, for a std function the suspension table has
    // no row for, which phase 2 takes as suspending.
    func note_untabled(&var self, e: Int) {
        let at = self.call_at[e]
        if at < 0 {
            return
        }
        let c = self.calls[at]
        if c.target < 0 || c.target >= self.summaries.len() {
            return
        }
        let s = self.summaries[c.target]
        if s.state != TC_SUMMARY_UNTABLED {
            return
        }
        var k = 0
        while k < self.untabled.len() {
            if self.untabled[k] == c.target {
                return
            }
            k = k + 1
        }
        try! self.untabled.push(c.target)
        let d = c.target
        var msg = StringBuilder()
        try! msg.append("compiler/tools/std_suspension.txt has no row for `")
        try! msg.append(self.std_key(d))
        try! msg.append("`, so its callers take it as suspending: rerun compiler/tools/std_suspension.py --write")
        let info = self.res.decls[d]
        let site = self.decl_site(d)
        self.refuse_in(info.module, site, "summary.untabled", msg.build())
    }
}

// The texts and refusals.
extension TcProgram {
    // A refusal at node `id`, in the module that holds it.
    func refuse_at(&var self, id: Int, rule: String, message: String) {
        let m = self.node_module(id)
        self.refuse_in(m, id, rule, message)
    }

    // What the call at `e` calls, as a refusal names it.
    public func callee_text(&self, e: Int) -> String {
        let at = self.call_at[e]
        if at < 0 {
            return "this"
        }
        let c = self.calls[at]
        if c.role == TcRole.Value {
            return "a function value whose type is not `sync`"
        }
        if c.target < 0 {
            return "this"
        }
        var out = StringBuilder()
        let info = self.res.decls[c.target]
        if info.kind == ResDeclKind.Requirement && c.owner >= 0 {
            let recv = self.strip_refs(c.owner)
            let rk = self.kind_of(recv)
            if rk == TcKind.Param || rk == TcKind.SelfType {
                try! out.append("`")
                try! out.append(self.res.decl_path(c.target))
                try! out.append("` through `")
                try! out.append(self.type_text(recv))
                try! out.append("`")
                return out.build()
            }
            if rk == TcKind.Any {
                try! out.append("`")
                try! out.append(self.res.decl_path(c.target))
                try! out.append("` through `")
                try! out.append(self.type_text(recv))
                try! out.append("`, a requirement not declared `sync`")
                return out.build()
            }
        }
        try! out.append("`")
        try! out.append(self.res.decl_path(c.target))
        try! out.append("`")
        out.build()
    }

    // A condition as the dump and a refusal write it: `T.Worker.step`.
    public func atom_text(&self, a: &TcAtom) -> String {
        var out = StringBuilder()
        try! out.append(self.type_text(a.ty))
        if a.req >= 0 {
            try! out.append(".")
            try! out.append(self.res.decl_path(a.req))
        }
        out.build()
    }

    func refuse_copy_requirement(&var self, e: Int, d: Int, a: &TcAtom, t: Int) {
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` requires `")
        try! msg.append(self.type_text(a.ty))
        try! msg.append("` to be Copy, as its body ")
        try! msg.append(self.copy_origin_text(a.origin))
        try! msg.append(" with nothing written, and `")
        try! msg.append(self.type_text(t))
        try! msg.append("` is ")
        try! msg.append(self.tier_word(t))
        try! msg.append(": pass a Copy type, or declare the parameter `ExplicitCopy` and write `.copy()` in the body")
        self.refuse_at(e, "copy.requirement", msg.build())
    }

    // How the copy at `origin` duplicates a value: a read out of storage the
    // body does not own, or a local used again on one path, both uses quoted
    // (spec, "The rule is per PATH, not per mention").
    func copy_origin_text(&self, origin: Int) -> String {
        let m = self.node_module(origin)
        var out = StringBuilder()
        let other = self.copy_partner[origin]
        if other < 0 {
            try! out.append("copies one at ")
            try! out.append(self.res.module_file(m))
            try! out.append(":")
            try! out.append(self.res.node_position(m, origin))
            return out.build()
        }
        let leaf = self.res.first_leaf(origin)
        try! out.append("binds `")
        try! out.append(self.text(m, leaf))
        if other == origin {
            try! out.append("` at ")
            try! out.append(self.res.module_file(m))
            try! out.append(":")
            try! out.append(self.res.node_position(m, origin))
            try! out.append(" in a loop or closure, which runs it again,")
            return out.build()
        }
        let first = if other < origin { other } else { origin }
        let second = if other < origin { origin } else { other }
        let again = self.expr_use[second]
        if again == TcUse.Copy || again == TcUse.Move {
            try! out.append("` twice on one path, at ")
        } else {
            try! out.append("` at ")
        }
        try! out.append(self.res.module_file(m))
        try! out.append(":")
        try! out.append(self.res.node_position(m, first))
        if again == TcUse.Copy || again == TcUse.Move {
            try! out.append(" and ")
        } else {
            try! out.append(" and uses it again at ")
        }
        try! out.append(self.res.node_position(m, second))
        try! out.append(",")
        out.build()
    }

    func refuse_forbidden(&var self, e: Int, d: Int, a: &TcAtom, t: Int) {
        let m = self.node_module(a.origin)
        var msg = StringBuilder()
        try! msg.append("this calls `")
        try! msg.append(self.res.decl_path(d))
        try! msg.append("` with `")
        try! msg.append(self.type_text(a.ty))
        try! msg.append("` as `")
        try! msg.append(self.type_text(t))
        try! msg.append("`, whose `")
        try! msg.append(self.res.decl_path(a.req))
        if a.kind == TC_FORBID_SYNC {
            try! msg.append("` is not sync-callable, and its body calls it in a `sync` context at ")
            try! msg.append(self.res.module_file(m))
            try! msg.append(":")
            try! msg.append(self.res.node_position(m, a.origin))
            self.refuse_at(e, "effect.sync", msg.build())
            return
        }
        try! msg.append("` may suspend, and ")
        if a.kind == TC_FORBID_THREAD {
            try! msg.append("`")
            try! msg.append(self.res.decl_path(d))
            try! msg.append("` is `blocking`, whose body calls it at ")
            try! msg.append(self.res.module_file(m))
            try! msg.append(":")
            try! msg.append(self.res.node_position(m, a.origin))
            try! msg.append(": a `blocking` body is thread context, where no executor runs to resume a suspension")
            self.refuse_at(e, "effect.blocking-body", msg.build())
            return
        }
        if a.kind == TC_FORBID_ERASE {
            try! msg.append("its body makes it `any` at ")
            try! msg.append(self.res.module_file(m))
            try! msg.append(":")
            try! msg.append(self.res.node_position(m, a.origin))
            try! msg.append(": a dispatch through `any` to a suspending implementation is refused")
            self.refuse_at(e, "effect.any-suspends", msg.build())
            return
        }
        try! msg.append("its closure calls it at ")
        try! msg.append(self.res.module_file(m))
        try! msg.append(":")
        try! msg.append(self.res.node_position(m, a.origin))
        try! msg.append(": a closure body cannot suspend")
        self.refuse_at(e, "effect.closure-suspends", msg.build())
    }

    func refuse_suspending_dispatch(&var self, id: Int, from: Int, tr: Int, req: Int) {
        let impl = self.impl_of(from, req)
        var msg = StringBuilder()
        try! msg.append("`")
        try! msg.append(self.type_text(from))
        try! msg.append("` becomes `any ")
        try! msg.append(self.nominal_name(tr))
        try! msg.append("` here, and its implementation of `")
        try! msg.append(self.res.decl_path(req))
        try! msg.append("`")
        if impl >= 0 {
            try! msg.append(", `")
            try! msg.append(self.res.decl_path(impl))
            try! msg.append("`,")
        }
        try! msg.append(" may suspend: a dispatch through `any` to a suspending implementation is refused, so call it on the concrete type, or take it as a generic parameter bounded by the trait")
        self.refuse_at(id, "effect.any-suspends", msg.build())
    }
}

// The index of `symbol` in `symbols`, or -1.
func tc_symbol_index(symbols: &Vector<String>, symbol: String) -> Int {
    var k = 0
    while k < symbols.len() {
        let name = symbols.get(k) ?? ""
        if name.equals(symbol) {
            return k
        }
        k = k + 1
    }
    return -1
}
