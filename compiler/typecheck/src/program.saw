// The program under type checking: resolve's program, unchanged, and every
// table the signature half fills. One value holds it all, so each phase is a
// set of methods on it, as in resolve.

import sawparse.grammar.{Alt}
import sawresolve.collect.{res_is_top_level}
import sawresolve.model.{ResBindKind, ResBinding, ResDecl, ResDeclKind, ResModule}
import sawresolve.names.{ResIndex}
import sawresolve.program.{ResProgram}
import sawtypecheck.model.{TC_EFFECT_BLOCKING, TcAdjust, TcAllowance, TcAtom, TcCall, TcCapture, TcConformance, TcDefault, TcDiag,
                               TcGeneric, TcItem, TcMember, TcObligation, TcParam, TcPendingConstant, TcSig, TcStatus,
                               TcSummary, TcRelocation, TcTier, TcUnit, TcUse}
import sawtypecheck.stdsuspension.{TcStdRows}
import sawtypecheck.types.{TC_HOLDS_PARAM, TcKind, TcType, TcTypes, tc_types}
import sawtypecheck.walks.{TcMemo, tc_memo}

// The declarations typecheck knows by identity, found once: `T?` names
// `Optional` with no name occurrence, and the Copy family, the derivable
// traits and the unsafe pointers have rules of their own. A lang item's field
// is filled from resolve's lang-item table, never by a name (`find_known`).
public struct TcKnown {
    optional: Int
    result: Int
    string: Int
    void_type: Int
    never: Int
    unsafe_pointer: Int
    unsafe_const_pointer: Int
    copy: Int
    explicit_copy: Int
    no_copy: Int
    deinit: Int
    no_move: Int
    equatable: Int
    comparable: Int
    hashable: Int
    printable: Int
    error: Int
    send: Int
    sync: Int
    unsafe_send: Int
    unsafe_sync: Int
    interior: Int
    atomic: Int
    serialize: Int
    deserialize: Int
    // The body half's vocabulary: the numbers, `Bool`, the range types and
    // `Iterator` a literal, a condition, a range and a `for` loop name with no
    // name occurrence, and the std types a conversion or literal builds.
    int: Int
    uint: Int
    int8: Int
    int16: Int
    int32: Int
    int64: Int
    uint8: Int
    uint16: Int
    uint32: Int
    uint64: Int
    float: Int
    bool_type: Int
    range: Int
    range_inclusive: Int
    iterator: Int
    box: Int
    vector: Int
    map: Int
    set: Int
    // The declarations whose uses lie outside the bootstrap slice and are
    // refused by name: `Arc`'s forwarding, `FuncPointer`.
    arc: Int
    // The group `group.spawn` spawns into.
    task_group: Int
    // The handle a cooperative spawn form hands back, found in the module
    // that declares `TaskGroup`; -1 under a std root that declares none.
    task: Int
    // The OS-thread handle `Thread.spawn` hands back inside its `Result`, and
    // that `Result`'s error, found by module; -1 under a std root that
    // declares neither (Stage 0's has no `SystemError`).
    thread: Int
    system_error: Int
    func_pointer: Int
    ordering: Int
    hasher: Int
    // The function every panic calls once its message is formatted: the new
    // std's panic sink, or the builtin `panic` under Stage 0's std.
    panic_sink: Int
    // The marker that vouches for a type's all-zero value; -1 under Stage 0's
    // std, which has none.
    zero_init: Int
}

public struct TcProgram {
    res: ResProgram
    types: TcTypes
    // Each declaration's signature, by resolve's declaration index.
    sigs: Vector<TcSig>
    generics: Vector<TcGeneric>
    // Trait declarations: generic bounds, trait parents, conformance lists.
    traits: Vector<Int>
    params: Vector<TcParam>
    // The type each type-position node denotes, a signature's or a body's, or
    // -1; and how many times each was built, which the body verifier holds to
    // one for a type written in a body.
    node_types: Vector<Int>
    type_builds: Vector<Int>
    // (leaf, 0) -> the declaration a generic parameter declared at `leaf`
    // belongs to, (leaf, 1) -> its index there. An extension's parameters
    // belong to the type it extends, and (leaf, 2) -> the extension.
    param_owners: ResIndex
    // (declaration, 0) -> each extension of that type.
    extensions_of: ResIndex
    conformances: Vector<TcConformance>
    statuses: Vector<TcStatus>
    // The member table: each nominal type's members are `member_first[d] ..
    // member_first[d] + member_count[d]`.
    members: Vector<TcMember>
    member_first: Vector<Int>
    member_count: Vector<Int>
    tiers: Vector<TcTier>
    obligations: Vector<TcObligation>
    // Every function-type node of a signature, for the unsafe check.
    func_nodes: Vector<Int>
    // Whether the type being built is a parameter's, whose `escaping` the
    // function type keeps; anywhere else a function type holds its value past
    // the call, so it is escaping whether or not it says so (D35).
    keep_escaping: Bool
    diags: Vector<TcDiag>
    known: TcKnown
    // The module and declaration being built, and what `Self` and the
    // enclosing extension are there.
    current: Int
    current_decl: Int
    current_trait: Int
    current_ext: Int
    current_self: Int
    // Whether the code being checked is test code: a test-only declaration's
    // or a test case's, which may use the module's test-only declarations.
    current_test: Bool
    error_type: Int
    // The semantic walks' answers, keyed by (TypeId or declaration, the
    // walk's question), and `type_holds`'s, keyed by (outer, inner).
    walks: TcMemo
    holds: TcMemo
    // The nodes refused as outside the bootstrap slice; the verifier asks
    // nothing of what lies under one.
    skipped: Vector<Int>
    // Keyed by node id: the String position a node is, a TcStringPosition's
    // index, or -1 (strings.saw).
    string_positions: Vector<Int>
    // The body half's side tables, keyed by node id: each expression's own
    // type before its adjustments (-1 for none), how many times it was
    // typed, whether it is a place, and how its position reads it.
    expr_types: Vector<Int>
    typed_count: Vector<Int>
    expr_place: Vector<Bool>
    expr_use: Vector<TcUse>
    // By read: the other use of a local that makes the read a copy, the
    // read itself when a loop repeats it, TC_COPY_COVERED when another read
    // of that local carries the requirement, or -1 (`settle_path_uses`).
    copy_partner: Vector<Int>
    // Each expression's adjustment chain: `adj_head[e]` its first step in
    // `adjusts`, `adj_tail[e]` its last.
    adj_head: Vector<Int>
    adj_tail: Vector<Int>
    adjusts: Vector<TcAdjust>
    // Each call, operator, subscript and loop head's resolution: `call_at[e]`
    // indexes `calls`, whose instantiations are runs of `insts`.
    call_at: Vector<Int>
    calls: Vector<TcCall>
    insts: Vector<Int>
    // Whether a call node is a spawn form's root, `f(x)` in `Task.spawn(f(x))`:
    // the task makes that call, not the body it is written in.
    spawn_roots: Vector<Bool>
    // Whether a call node is a drive site's root, `f(x)` in
    // `__saw_drive(f(x))`: the driver runs it to its end, so its suspensions
    // are not the body's it is written in.
    drive_roots: Vector<Bool>
    // The argument bindings of the calls the overload filter resolved: each
    // call's run holds, per parameter, the argument binding it or
    // TC_BIND_DEFAULT.
    binds: Vector<Int>
    // A local's type, by the leaf that declares it.
    local_types: Vector<Int>
    // Whether the pattern binding a leaf declares aliases a part of a
    // borrowed scrutinee, which it may not move out.
    aliasing_bindings: Vector<Bool>
    // Whether a leaf declares a `borrow let|var` binding, which names a place
    // an accessor lends.
    lent_bindings: Vector<Bool>
    // Whether a leaf declares a non-escaping function value: a parameter
    // whose function type does not say `escaping`, or a local bound to one.
    nonescaping_bindings: Vector<Bool>
    // Resolve's call record for a call node, or -1.
    res_call_at: Vector<Int>
    // The roots of every body checked, and the declaration each belongs to.
    body_roots: Vector<Int>
    body_decls: Vector<Int>
    // Every module's extension set, as `tc_extension_sets` builds it.
    ext_visible: Vector<Bool>
    // What `return` expects in the body or closure being checked, and the
    // loops around the position: each open loop's count of `break`s.
    body_result: Int
    loop_breaks: Vector<Int>
    // The `try` blocks open around the position, innermost last: each one's
    // first entry in `catch_errors`, which holds the error types their
    // `try`s propagate, each once per block.
    catch_frames: Vector<Int>
    catch_errors: Vector<Int>
    // Whether the closure being checked has no expected result, so its first
    // `return` gives `body_result` and the later ones are checked against it.
    result_open: Bool
    // What the funnel position a value branch stands in allows, which its
    // arms inherit.
    branch_allow: TcAllowance
    // The exclusive twin the overload filter set aside when it chose a
    // shared accessor, for the call being resolved; -1 for none.
    chosen_twin: Int
    // The latest member lookup's first entry dropped because its declaring
    // extension's bounds fail for the receiver, and that receiver's type; -1
    // for none (`members_for`).
    unmet_member: Int
    unmet_owner: Int
    // The value of the placement write `ptr[i] = v` being checked, or -1;
    // the leaf of every function parameter checked so far; and the ones of
    // the body being checked that a `&`, `&var` or `borrow` argument has
    // named so far (design 188's fresh journey).
    placement_value: Int
    // The bindings the closures being walked capture by borrow, `[&x]` or
    // `[&var x]`, by declaring leaf: inside them a name owns nothing.
    borrow_captures: Vector<Int>
    param_leaves: Vector<Int>
    referenced_params: Vector<Int>
    // The unspelled value of each placement write `ptr[i] = param` whose
    // parameter no reference had named, the fresh journey a later by-value
    // read may still be.
    fresh_placements: Vector<Int>
    // Each move a generic body makes of a value whose type names a type
    // parameter: the node it is reported at, the node naming what moves, that
    // type, the declaration whose body holds it, and how it is written. Mono
    // refuses one whose instantiated type is `NoMove` (`check_relocation`).
    relocations: Vector<Int>
    relocation_places: Vector<Int>
    relocation_types: Vector<Int>
    relocation_decls: Vector<Int>
    relocation_hows: Vector<TcRelocation>
    // The body being checked, and the bodies poisoned by a signature another
    // module's refusal left unformed (SL:architecture §3.0): their error
    // types are that refusal's, not this body's.
    current_root: Int
    poisoned: Vector<Int>
    // The place a `borrow` block's binding names while it is typed, or -1: a
    // call there must lend.
    borrow_head: Int
    // Phase 2's summaries, by declaration, their conditions' pool, the
    // bodies' units and items, and each declaration's top unit.
    summaries: Vector<TcSummary>
    atoms: Vector<TcAtom>
    units: Vector<TcUnit>
    items: Vector<TcItem>
    decl_unit: Vector<Int>
    // (declaration, 0) -> each unit whose summary read that declaration's.
    summary_deps: ResIndex
    // Each checked default value, and (function, parameter) -> its index.
    defaults: Vector<TcDefault>
    default_at: ResIndex
    // The std suspension table: (key's name id, 0) -> its row, the keys in
    // row order, and the rows' columns.
    std_verdicts: ResIndex
    std_keys: Vector<Int>
    std_rows: TcStdRows
    // The std functions a NOTE already names as missing from the table.
    untabled: Vector<Int>
    // Each problem the summary verifier found, and its module.
    summary_problems: Vector<String>
    summary_problem_modules: Vector<Int>
    // The literal a unary minus is typing, or -1, and that minus: a negated
    // literal is one literal, so its range is its negation's (SL:open-questions
    // D6), and a refusal of it is anchored at the minus.
    negated_literal: Int
    negation: Int
    // The type parameter a generic default value is being typed at, or -1:
    // its literals adopt it and take their values per call, so none is
    // settled where it is written.
    generic_default: Int
    // The type a generic default's literals are folded at for one call, or
    // -1 (`fold_default`).
    fold_written: Int
    // By declaration: the trait whose requirement a written member meets, or
    // -1.
    meets_trait: Vector<Int>
    // Every closure checked, in the order the walk met them, with the
    // declaration whose body holds it; and each one's captures, a run of
    // `captures` (`settle_captures`). (closure node, 0) -> its ordinal.
    closures: Vector<Int>
    closure_decls: Vector<Int>
    capture_first: Vector<Int>
    capture_count: Vector<Int>
    captures: Vector<TcCapture>
    closure_index: ResIndex
    // By closure ordinal: whether the closure escapes (`closure_escapes`).
    closure_escaping: Vector<Bool>
    // By closure ordinal, once captures settle: the first capture that keeps
    // the closure from being `sendable`, an index into `captures`, and the
    // trait it fails; -1 for a closure whose captures prove both
    // (`check_closure_traits`). The Send-on-frames gate reads them for a
    // closure passed to a spawned call.
    closure_blocker: Vector<Int>
    closure_blocker_trait: Vector<Int>
    // Every `Thread.spawn` form typed, and its brace, in the order the walk
    // met them (`thread_spawn`).
    thread_forms: Vector<Int>
    thread_braces: Vector<Int>
    // Whether the closure `closure_typed` finished last has a body that ends
    // in `Never` and returns nowhere, which its inferred result reads as
    // `Void` (`merge_open_result`).
    closure_never: Bool
    // Keyed by node id: the type a position copies though no transfer
    // records the copy, or -1; in a generic body it owes design 219's
    // inferred Copy requirement (D27): a plain subscript read where its
    // position keeps nothing (`check_plain_subscript_reads`), a closure's
    // silent by-value capture, `[x]` or implicit, at creation (`add_capture`),
    // and a repeat literal's copies of its element (`check_repeat_element`).
    implied_copies: Vector<Int>
    // Every `Atomic<X>` type formed at an `X` other than `Int`, whether
    // written, inferred or substituted (`mk_nominal`), which the atomic role
    // refuses where a position carries one (SL:open-questions D38).
    narrow_atomics: Vector<Int>
    // By entry of `narrow_atomics`: whether its refusal is reported.
    narrow_reported: Vector<Bool>
    // The `static_assert`s whose condition measures a layout, deferred from
    // the fold (SL:open-questions D40), by condition node: its message leaf
    // or -1, the function whose body holds it or -1, and whether it measures
    // a type parameter. One over concrete types is checked by the
    // layout-assert funnel once typecheck ends, one over a parameter by mono
    // per instantiation.
    layout_asserts: Vector<Int>
    layout_assert_messages: Vector<Int>
    layout_assert_decls: Vector<Int>
    layout_assert_generic: Vector<Bool>
    // The measurements a layout assert's fold reads: each `sizeof`/`alignof`
    // call node, and its value at the layout being checked.
    measured_nodes: Vector<Int>
    measured_values: Vector<Int>
    // The constant judgments held until every body is typed, in the order
    // they were met (`defer_constant`), and whether that point is reached,
    // after which a judgment is final where it is met.
    pending_constants: Vector<TcPendingConstant>
    constants_final: Bool
    // Whether the program is a runtime, whose `@export`s may be the frozen
    // `__saw_rt_*` seams, as `sawc2 runtime` checks one (design 149).
    runtime_build: Bool
    // Whether the program is built for the freestanding profile: no hosted
    // runtime under it, so no background task group and no offload thread
    // pool. It is the one place the profile is known; every later stage reads
    // it here.
    freestanding: Bool
    // By declaration: the C symbol an `@export` gives it, or "" for none, and
    // the attribute that says so, or -1 (`check_exports`).
    export_symbols: Vector<String>
    export_nodes: Vector<Int>
    // Every written `any Trait` node, in the order `mk_any` formed it, which
    // the object-safety funnel judges once requirements are known.
    erased_nodes: Vector<Int>
    // By declaration: a pair's `blocking` twin of a default, and the default
    // of a twin, or -1 (`match_blocking_twin`).
    blocking_twins: Vector<Int>
    pair_defaults: Vector<Int>
}

extension TcProgram: NoCopy {}

public func tc_program(res: ResProgram) -> TcProgram {
    let decl_total = res.decls.len()
    let node_total = res.nodes.len()
    var sigs = Vector<TcSig>()
    var firsts = Vector<Int>()
    var counts = Vector<Int>()
    var symbols = Vector<String>()
    var export_nodes = Vector<Int>()
    var twins = Vector<Int>()
    var defaults = Vector<Int>()
    var k = 0
    while k < decl_total {
        try! sigs.push(TcSig.blank())
        try! firsts.push(-1)
        try! counts.push(0)
        try! symbols.push("")
        try! export_nodes.push(-1)
        try! twins.push(-1)
        try! defaults.push(-1)
        k = k + 1
    }
    var node_types = Vector<Int>()
    var type_builds = Vector<Int>()
    k = 0
    while k < node_total {
        try! node_types.push(-1)
        try! type_builds.push(0)
        k = k + 1
    }
    let known = TcKnown(optional: -1, result: -1, string: -1, void_type: -1, never: -1,
                        unsafe_pointer: -1, unsafe_const_pointer: -1, copy: -1, explicit_copy: -1,
                        no_copy: -1, deinit: -1, no_move: -1, equatable: -1, comparable: -1,
                        hashable: -1, printable: -1, error: -1, send: -1, sync: -1,
                        unsafe_send: -1, unsafe_sync: -1, interior: -1, atomic: -1, serialize: -1,
                        deserialize: -1, int: -1, uint: -1, int8: -1, int16: -1, int32: -1,
                        int64: -1, uint8: -1, uint16: -1, uint32: -1, uint64: -1, float: -1,
                        bool_type: -1, range: -1, range_inclusive: -1, iterator: -1, box: -1,
                        vector: -1, map: -1, set: -1, arc: -1, task_group: -1, task: -1,
                        thread: -1, system_error: -1, func_pointer: -1,
                        ordering: -1, hasher: -1, panic_sink: -1, zero_init: -1)
    var p = TcProgram(res: move res, types: tc_types(), sigs: move sigs,
                      generics: Vector<TcGeneric>(), traits: Vector<Int>(),
                      params: Vector<TcParam>(), node_types: move node_types,
                      type_builds: move type_builds,
                      param_owners: ResIndex(), extensions_of: ResIndex(),
                      conformances: Vector<TcConformance>(), statuses: Vector<TcStatus>(),
                      members: Vector<TcMember>(), member_first: move firsts,
                      member_count: move counts, tiers: Vector<TcTier>(),
                      obligations: Vector<TcObligation>(), func_nodes: Vector<Int>(), keep_escaping: false,
                      diags: Vector<TcDiag>(), known: known, current: -1, current_decl: -1,
                      current_trait: -1, current_ext: -1, current_self: -1, current_test: false,
                      error_type: -1,
                      walks: tc_memo(), holds: tc_memo(), skipped: Vector<Int>(), string_positions: Vector<Int>(),
                      expr_types: Vector<Int>(),
                      typed_count: Vector<Int>(), expr_place: Vector<Bool>(),
                      expr_use: Vector<TcUse>(), copy_partner: Vector<Int>(), adj_head: Vector<Int>(),
                      adj_tail: Vector<Int>(), adjusts: Vector<TcAdjust>(),
                      call_at: Vector<Int>(), calls: Vector<TcCall>(), insts: Vector<Int>(),
                      spawn_roots: Vector<Bool>(), drive_roots: Vector<Bool>(),
                      binds: Vector<Int>(),
                      local_types: Vector<Int>(), aliasing_bindings: Vector<Bool>(), lent_bindings: Vector<Bool>(), nonescaping_bindings: Vector<Bool>(),
                      res_call_at: Vector<Int>(),
                      body_roots: Vector<Int>(), body_decls: Vector<Int>(),
                      ext_visible: Vector<Bool>(), body_result: -1, loop_breaks: Vector<Int>(),
                      catch_frames: Vector<Int>(), catch_errors: Vector<Int>(), result_open: false,
                      branch_allow: TcAllowance(optionals: 1, results: 1, erases: false, widens: true),
                      chosen_twin: -1, unmet_member: -1, unmet_owner: -1,
                      placement_value: -1, borrow_captures: Vector<Int>(), param_leaves: Vector<Int>(), referenced_params: Vector<Int>(), fresh_placements: Vector<Int>(), relocations: Vector<Int>(), relocation_places: Vector<Int>(), relocation_types: Vector<Int>(), relocation_decls: Vector<Int>(), relocation_hows: Vector<TcRelocation>(), current_root: -1, poisoned: Vector<Int>(), borrow_head: -1,
                      summaries: Vector<TcSummary>(), atoms: Vector<TcAtom>(), units: Vector<TcUnit>(),
                      items: Vector<TcItem>(), decl_unit: Vector<Int>(), summary_deps: ResIndex(),
                      defaults: Vector<TcDefault>(), default_at: ResIndex(),
                      std_verdicts: ResIndex(), std_keys: Vector<Int>(),
                      std_rows: TcStdRows(keys: Vector<String>(), verdicts: Vector<Int>(), causes: Vector<Int>(),
                                          labels: Vector<String>()),
                      untabled: Vector<Int>(),
                      summary_problems: Vector<String>(), summary_problem_modules: Vector<Int>(),
                      negated_literal: -1, negation: -1, generic_default: -1, fold_written: -1,
                      meets_trait: Vector<Int>(), closures: Vector<Int>(),
                      closure_decls: Vector<Int>(), capture_first: Vector<Int>(),
                      capture_count: Vector<Int>(), captures: Vector<TcCapture>(),
                      closure_index: ResIndex(), closure_escaping: Vector<Bool>(),
                      closure_blocker: Vector<Int>(), closure_blocker_trait: Vector<Int>(),
                      thread_forms: Vector<Int>(), thread_braces: Vector<Int>(), closure_never: false,
                      implied_copies: Vector<Int>(), narrow_atomics: Vector<Int>(), narrow_reported: Vector<Bool>(),
                      layout_asserts: Vector<Int>(), layout_assert_messages: Vector<Int>(),
                      layout_assert_decls: Vector<Int>(), layout_assert_generic: Vector<Bool>(),
                      measured_nodes: Vector<Int>(), measured_values: Vector<Int>(),
                      pending_constants: Vector<TcPendingConstant>(), constants_final: false,
                      runtime_build: false, freestanding: false,
                      export_symbols: move symbols, export_nodes: move export_nodes,
                      erased_nodes: Vector<Int>(), blocking_twins: move twins, pair_defaults: move defaults)
    let empty = Vector<Int>()
    let unlabeled = Vector<Int>()
    p.error_type = p.types.intern(TcKind.Error, -1, 0, 0, &empty, &unlabeled)
    move p
}

extension TcProgram {
    public func decl(&self, d: Int) -> ResDecl { self.res.decls[d] }

    public func sig(&self, d: Int) -> TcSig { self.sigs[d] }

    public func ty(&self, t: Int) -> TcType { self.types.ty(t) }

    // Whether declaration `d` is a Saw function declared `blocking`, alone
    // or as a pair's twin (spec, Blocking functions).
    public func declares_blocking(&self, d: Int) -> Bool {
        d >= 0 && d < self.sigs.len() && (self.sigs[d].effects & TC_EFFECT_BLOCKING) != 0
    }

    // Whether declaration `d` is a pair's `blocking` twin, which no call
    // names: the default is the operation's one declaration.
    public func is_blocking_twin(&self, d: Int) -> Bool {
        d >= 0 && d < self.pair_defaults.len() && self.pair_defaults[d] >= 0
    }

    // The `blocking` twin of pair default `d`, or -1.
    public func blocking_twin_of(&self, d: Int) -> Int {
        if d < 0 || d >= self.blocking_twins.len() {
            return -1
        }
        self.blocking_twins[d]
    }

    // Per node, whether it lies under a construct refused as outside the
    // slice, whose uses no check after the walk may read.
    public func outside_slice_marks(&self, n: Int) -> Vector<Bool> {
        var out = Vector<Bool>()
        var k = 0
        while k < n {
            try! out.push(false)
            k = k + 1
        }
        var stack = Vector<Int>()
        k = 0
        while k < self.skipped.len() {
            try! stack.push(self.skipped[k])
            k = k + 1
        }
        k = 0
        while k < self.res.skipped.len() {
            try! stack.push(self.res.skipped[k])
            k = k + 1
        }
        var top = stack.len()
        while top > 0 {
            top = top - 1
            let at = stack[top]
            if at < 0 || out[at] {
                continue
            }
            out[at] = true
            let count = self.child_count(at)
            var j = 0
            while j < count {
                let c = self.child(at, j)
                if top < stack.len() {
                    stack[top] = c
                } else {
                    try! stack.push(c)
                }
                top = top + 1
                j = j + 1
            }
        }
        move out
    }

    public func node_alt(&self, id: Int) -> Alt? { self.res.alt_of(id) }

    public func has_alt(&self, id: Int, alt: Alt) -> Bool { self.res.is_alt(id, alt) }

    public func child(&self, id: Int, k: Int) -> Int { self.res.child(id, k) }

    public func child_count(&self, id: Int) -> Int { self.res.child_count(id) }

    public func is_leaf(&self, id: Int) -> Bool { self.res.is_leaf(id) }

    // The catch block of an inline `catch` or a `try` block at `id`, which
    // declares its `error` binding, or -1.
    public func catch_block_of(&self, id: Int) -> Int {
        if self.has_alt(id, Alt.Expr_TryBlock) {
            return self.res.last_node_child(id)
        }
        if self.has_alt(id, Alt.Expr_Try_Catch) {
            let clause = self.res.last_node_child(id)
            return self.res.first_node_child(clause)
        }
        return -1
    }

    // The source text of node `id` in module `m`.
    public func text(&self, m: Int, id: Int) -> String { self.res.text_of(m, id) }

    public func name_text(&self, id: Int) -> String { self.res.name_text(id) }

    // The binding resolve recorded on leaf `leaf`, or an unbound one.
    public func binding_at(&self, leaf: Int) -> ResBinding {
        let r = self.res.record_of[leaf]
        if r < 0 {
            return ResBinding(kind: ResBindKind.Unbound, module: -1, decl: -1, name: -1, node: -1)
        }
        self.res.records[r].binding
    }

    // The node a declaration is reported at: its name, else its own node.
    public func decl_site(&self, d: Int) -> Int {
        let info = self.res.decls[d]
        if info.leaf >= 0 {
            return info.leaf
        }
        info.node
    }

    // Whether module `m` is read as an interface, whose refusals are notes.
    public func is_interface(&self, m: Int) -> Bool {
        let info = self.res.modules[m]
        info.interface_only
    }

    // Records a refusal at node `id` of module `m`.
    public func refuse_in(&var self, m: Int, id: Int, rule: String, message: String) {
        let n = self.res.nodes[id]
        let note = self.is_interface(m)
        try! self.diags.push(TcDiag(module: m, start: n.start, end: n.end, id: rule,
                                    message: message, note: note))
    }

    // A refusal at node `id` of the module being built.
    public func refuse(&var self, id: Int, rule: String, message: String) {
        let m = self.current
        self.refuse_in(m, id, rule, message)
    }

    // Whether module `m` has a refusal of its own, from resolve or from here.
    public func module_refused(&self, m: Int) -> Bool {
        var k = 0
        while k < self.diags.len() {
            let d = self.diags[k]
            if d.module == m {
                return true
            }
            k = k + 1
        }
        k = 0
        while k < self.res.diags.len() {
            let d = self.res.diags[k]
            if d.module == m {
                return true
            }
            k = k + 1
        }
        false
    }

    public func error_count(&self) -> Int {
        var n = self.res.error_count()
        var k = 0
        while k < self.diags.len() {
            let d = self.diags[k]
            if not d.note {
                n = n + 1
            }
            k = k + 1
        }
        n
    }

    // The module whose identity is `identity`, or -1 when none is loaded.
    public func module_named(&self, identity: String) -> Int {
        let id = self.res.names.find(identity)
        if id < 0 {
            return -1
        }
        let at = self.res.by_name.first(0, id)
        if at < 0 {
            return -1
        }
        self.res.by_name.value(at)
    }

    // The newest production declaration named `name` at the top of module
    // `module`, or -1. Each caller picks by name a declaration whose body or
    // type a normal build emits, which a test-only declaration never is, so
    // a test-only one of that name is passed over as if absent (SL:testing,
    // "No rot"). Pinned by mono's golden `test_only_main` and the run probe
    // `test_only_main_overloads`.
    //
    // ENTRY POINTS:
    //     add_roots (mono: the entry module's `main`)
    //     exec_entry (mono)
    //     resolve_spawn (mono)
    //     coro_context_shape (coro)
    //     find_known (typecheck)
    public func top_decl(&self, module: Int, name: String) -> Int {
        if module < 0 {
            return -1
        }
        let id = self.res.names.find(name)
        if id < 0 {
            return -1
        }
        var at = self.res.top.first(module, id)
        while at >= 0 {
            let d = self.res.top.value(at)
            if not self.res.decls[d].test_only {
                return d
            }
            at = self.res.top.following(at)
        }
        return -1
    }

    // The owner and index of the generic parameter declared at `leaf`.
    public func param_owner(&self, leaf: Int) -> Int {
        let at = self.param_owners.first(leaf, 0)
        if at < 0 {
            return -1
        }
        self.param_owners.value(at)
    }

    public func param_index(&self, leaf: Int) -> Int {
        let at = self.param_owners.first(leaf, 1)
        if at < 0 {
            return -1
        }
        self.param_owners.value(at)
    }

    // The extension whose head declares the parameter at `leaf`, or -1 for
    // a parameter of any other declaration.
    public func param_ext(&self, leaf: Int) -> Int {
        let at = self.param_owners.first(leaf, 2)
        if at < 0 {
            return -1
        }
        self.param_owners.value(at)
    }

    // Whether declaration `d` is a nominal type: a struct, an enum, or a
    // builtin type.
    public func is_nominal(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        let info = self.res.decls[d]
        info.kind == ResDeclKind.Struct || info.kind == ResDeclKind.Enum || info.kind == ResDeclKind.Primitive
    }

    public func is_trait(&self, d: Int) -> Bool {
        if d < 0 {
            return false
        }
        let info = self.res.decls[d]
        info.kind == ResDeclKind.Trait
    }

    // The generic parameter `k` of declaration `d`.
    public func generic(&self, d: Int, k: Int) -> TcGeneric {
        let s = self.sigs[d]
        self.generics[s.generic_first + k]
    }

    public func param(&self, d: Int, k: Int) -> TcParam {
        let s = self.sigs[d]
        self.params[s.param_first + k]
    }

    public func trait_of(&self, d: Int, k: Int) -> Int {
        let s = self.sigs[d]
        self.traits[s.trait_first + k]
    }
}
