// Typed integer arithmetic, the one rule every constant follows
// (SL:architecture §3.10, "Constant arithmetic is ordinary typed arithmetic"):
// a value is its type's, and an operation is its operands' type's, exactly as
// it runs, at the target's width. Typecheck's folder and the MIR evaluator
// both compute through these functions, so they cannot disagree about one.
//
// A value is held as the bits of an `Int`, two's complement of its low 64
// bits: a narrow type's value exactly, sign- or zero-extended, and a 64-bit
// unsigned value at or above 2^63 as the negative `Int` with the same bits.
// No function here traps on the host: every product, sum and quotient that
// could leave an `Int` is taken apart into 32-bit or 16-bit pieces first.

public enum TcFault {
    // No fault: the value stands.
    case Clean,
    // An arithmetic result its type cannot hold.
    case Overflow,
    // A shift count negative, or at or past the shifted type's width.
    case ShiftRange,
    case DivideByZero,
    // A value converted or adopted into a type that cannot hold it.
    case NotFit,
    // An expression outside the constant grammar.
    case NotConstant,
    // A static whose value depends on itself.
    case Cycle
}

// An evaluated value, or the fault that stopped it.
public struct TcValue {
    ok: Bool
    bits: Int
    fault: TcFault
}

static TC_ARITH_LOW32: Int = 0xFFFF_FFFF
static TC_ARITH_LOW16: Int = 0xFFFF
static TC_ARITH_MAX: Int = Int.max
static TC_ARITH_MIN: Int = Int.min

extension TcValue {
    public init(value: Int) -> TcValue {
        TcValue(ok: true, bits: value, fault: TcFault.Clean)
    }

    public init(fault: TcFault) -> TcValue {
        TcValue(ok: false, bits: 0, fault: fault)
    }
}

// The bits of `bits` read as a value of `w` bits, signed or not.
public func tc_arith_normalize(bits: Int, w: Int, signed: Bool) -> Int {
    if w >= 64 {
        return bits
    }
    let mask = (1 << w) - 1
    let low = bits & mask
    if signed && low >= (1 << (w - 1)) {
        return low - (1 << w)
    }
    low
}

// The smallest and largest value of a `w`-bit type, as its bits.
public func tc_arith_min(w: Int, signed: Bool) -> Int {
    if not signed {
        return 0
    }
    if w >= 64 {
        return TC_ARITH_MIN
    }
    0 - (1 << (w - 1))
}

public func tc_arith_max(w: Int, signed: Bool) -> Int {
    if w >= 64 {
        if signed {
            return TC_ARITH_MAX
        }
        return -1
    }
    if signed {
        return (1 << (w - 1)) - 1
    }
    (1 << w) - 1
}

// Whether 64-bit patterns `a` < `b` read unsigned.
public func tc_arith_ult(a: Int, b: Int) -> Bool {
    (a ^ TC_ARITH_MIN) < (b ^ TC_ARITH_MIN)
}

func tc_high(x: Int) -> Int {
    (x >> 32) & TC_ARITH_LOW32
}

func tc_low(x: Int) -> Int {
    x & TC_ARITH_LOW32
}

func tc_join(high: Int, low: Int) -> Int {
    (high << 32) | (low & TC_ARITH_LOW32)
}

// `a + b` of 64-bit patterns, wrapped, with whether it carried out.
func tc_add64(a: Int, b: Int) -> TcValue {
    let low = tc_low(a) + tc_low(b)
    let high = tc_high(a) + tc_high(b) + (low >> 32)
    let bits = tc_join(high & TC_ARITH_LOW32, low)
    if high > TC_ARITH_LOW32 {
        return TcValue(ok: false, bits: bits, fault: TcFault.Overflow)
    }
    TcValue(value: bits)
}

// `a - b` of 64-bit patterns, wrapped, with whether it went below zero.
func tc_sub64(a: Int, b: Int) -> TcValue {
    var low = tc_low(a) - tc_low(b)
    var owed = 0
    if low < 0 {
        low = low + (1 << 32)
        owed = 1
    }
    var high = tc_high(a) - tc_high(b) - owed
    var out = false
    if high < 0 {
        high = high + (1 << 32)
        out = true
    }
    let bits = tc_join(high, low)
    if out {
        return TcValue(ok: false, bits: bits, fault: TcFault.Overflow)
    }
    TcValue(value: bits)
}

// `x * y` mod 2^32, for `x` and `y` below 2^32.
func tc_mul32_low(x: Int, y: Int) -> Int {
    let y0 = y & TC_ARITH_LOW16
    let y1 = (y >> 16) & TC_ARITH_LOW16
    let a = x * y0
    let b = (x * y1) & TC_ARITH_LOW16
    (a + (b << 16)) & TC_ARITH_LOW32
}

// `x * y` for `x` and `y` below 2^32: the 64-bit pattern of the product,
// which may exceed `Int.max` as unsigned.
func tc_mul32_full(x: Int, y: Int) -> Int {
    let y0 = y & TC_ARITH_LOW16
    let y1 = (y >> 16) & TC_ARITH_LOW16
    let t0 = x * y0
    let t1 = x * y1
    let low = (t0 & TC_ARITH_LOW32) + ((t1 & TC_ARITH_LOW16) << 16)
    let high = (t0 >> 32) + (t1 >> 16) + (low >> 32)
    tc_join(high & TC_ARITH_LOW32, low)
}

// `a * b` of 64-bit patterns read unsigned, wrapped, with whether the true
// product passes 2^64 - 1.
func tc_mul64(a: Int, b: Int) -> TcValue {
    let ah = tc_high(a)
    let al = tc_low(a)
    let bh = tc_high(b)
    let bl = tc_low(b)
    let low = tc_mul32_full(al, bl)
    let cross = (tc_mul32_low(ah, bl) + tc_mul32_low(al, bh)) & TC_ARITH_LOW32
    let high = (tc_high(low) + cross) & TC_ARITH_LOW32
    let bits = tc_join(high, low)
    var over = ah != 0 && bh != 0
    if not over && (ah != 0 || bh != 0) {
        let x = if ah != 0 { ah } else { bh }
        let y = if ah != 0 { bl } else { al }
        if y != 0 && x > TC_ARITH_LOW32 / y {
            over = true
        } else if tc_high(low) + x * y > TC_ARITH_LOW32 {
            over = true
        }
    }
    if over {
        return TcValue(ok: false, bits: bits, fault: TcFault.Overflow)
    }
    TcValue(value: bits)
}

// `a / b` and `a % b` of 64-bit patterns read unsigned, `b` not zero.
func tc_divmod64(a: Int, b: Int, remainder: Bool) -> Int {
    if a >= 0 && b > 0 {
        if remainder {
            return a % b
        }
        return a / b
    }
    if tc_arith_ult(a, b) {
        if remainder {
            return a
        }
        return 0
    }
    if b < 0 {
        // `b` is at least 2^63, so `a` holds it once.
        if remainder {
            return tc_sub64(a, b).bits
        }
        return 1
    }
    var quotient = 0
    var rest = 0
    var i = 63
    while i >= 0 {
        rest = (rest << 1) | ((a >> i) & 1)
        if not tc_arith_ult(rest, b) {
            rest = tc_sub64(rest, b).bits
            quotient = quotient | (1 << i)
        }
        i = i - 1
    }
    if remainder {
        return rest
    }
    quotient
}

// Whether value `v` of a `fw`-bit type, signed or not, has a value a
// `tw`-bit type holds.
public func tc_arith_fits(v: Int, fw: Int, fs: Bool, tw: Int, ts: Bool) -> Bool {
    let huge = fw >= 64 && not fs && v < 0
    if huge {
        return tw >= 64 && not ts
    }
    if tw >= 64 {
        return ts || v >= 0
    }
    v >= tc_arith_min(tw, ts) && v <= tc_arith_max(tw, ts)
}

// Value `v` of a `fw`-bit type converted to a `tw`-bit one, which must hold
// it: `as`, a widening, a constant's adoption.
public func tc_arith_convert(v: Int, fw: Int, fs: Bool, tw: Int, ts: Bool) -> TcValue {
    if not tc_arith_fits(v, fw, fs, tw, ts) {
        return TcValue(ok: false, bits: v, fault: TcFault.NotFit)
    }
    TcValue(value: tc_arith_normalize(v, tw, ts))
}

// `a op b` for two values of one `w`-bit type: `+ - * / %`, the wrapping
// `&+ &- &*`, and `& | ^`.
public func tc_arith_binary(op: &String, a: Int, b: Int, w: Int, signed: Bool) -> TcValue {
    if op.equals("&") {
        return TcValue(value: tc_arith_normalize(a & b, w, signed))
    }
    if op.equals("|") {
        return TcValue(value: tc_arith_normalize(a | b, w, signed))
    }
    if op.equals("^") {
        return TcValue(value: tc_arith_normalize(a ^ b, w, signed))
    }
    if op.equals("&+") {
        return TcValue(value: tc_arith_normalize(tc_add64(a, b).bits, w, signed))
    }
    if op.equals("&-") {
        return TcValue(value: tc_arith_normalize(tc_sub64(a, b).bits, w, signed))
    }
    if op.equals("&*") {
        return TcValue(value: tc_arith_normalize(tc_mul64(a, b).bits, w, signed))
    }
    if op.equals("/") || op.equals("%") {
        return tc_arith_divide(op.equals("%"), a, b, w, signed)
    }
    if w < 64 {
        // Narrow operands are under 2^32 in magnitude, so a sum is exact; a
        // product that could leave an `Int` overflows the type anyway.
        var exact = 0
        if op.equals("+") {
            exact = a + b
        } else if op.equals("-") {
            exact = a - b
        } else if op.equals("*") {
            let ma = if a < 0 { 0 - a } else { a }
            let mb = if b < 0 { 0 - b } else { b }
            if ma != 0 && mb > (1 << 62) / ma {
                return TcValue(fault: TcFault.Overflow)
            }
            exact = a * b
        } else {
            return TcValue(fault: TcFault.NotConstant)
        }
        if exact < tc_arith_min(w, signed) || exact > tc_arith_max(w, signed) {
            return TcValue(fault: TcFault.Overflow)
        }
        return TcValue(value: exact)
    }
    if signed {
        return tc_arith_signed64(&op, a, b)
    }
    var r = TcValue(fault: TcFault.NotConstant)
    if op.equals("+") {
        r = tc_add64(a, b)
    } else if op.equals("-") {
        r = tc_sub64(a, b)
    } else if op.equals("*") {
        r = tc_mul64(a, b)
    }
    if not r.ok && r.fault == TcFault.Overflow {
        return TcValue(fault: TcFault.Overflow)
    }
    r
}

// `a op b` of two signed 64-bit values: `+`, `-`, `*`.
func tc_arith_signed64(op: &String, a: Int, b: Int) -> TcValue {
    if op.equals("+") {
        if (b > 0 && a > TC_ARITH_MAX - b) || (b < 0 && a < TC_ARITH_MIN - b) {
            return TcValue(fault: TcFault.Overflow)
        }
        return TcValue(value: a + b)
    }
    if op.equals("-") {
        if (b < 0 && a > TC_ARITH_MAX + b) || (b > 0 && a < TC_ARITH_MIN + b) {
            return TcValue(fault: TcFault.Overflow)
        }
        return TcValue(value: a - b)
    }
    if op.equals("*") {
        if a == 0 || b == 0 {
            return TcValue(value: 0)
        }
        if a == 1 {
            return TcValue(value: b)
        }
        if b == 1 {
            return TcValue(value: a)
        }
        if a == TC_ARITH_MIN || b == TC_ARITH_MIN {
            return TcValue(fault: TcFault.Overflow)
        }
        let ma = if a < 0 { 0 - a } else { a }
        let mb = if b < 0 { 0 - b } else { b }
        if ma > TC_ARITH_MAX / mb {
            return TcValue(fault: TcFault.Overflow)
        }
        return TcValue(value: a * b)
    }
    TcValue(fault: TcFault.NotConstant)
}

// `a / b`, or `a % b`, truncated toward zero.
func tc_arith_divide(remainder: Bool, a: Int, b: Int, w: Int, signed: Bool) -> TcValue {
    if b == 0 {
        return TcValue(fault: TcFault.DivideByZero)
    }
    if not signed {
        if w >= 64 {
            return TcValue(value: tc_divmod64(a, b, remainder))
        }
        if remainder {
            return TcValue(value: a % b)
        }
        return TcValue(value: a / b)
    }
    if b == -1 && a == tc_arith_min(w, true) {
        return TcValue(fault: TcFault.Overflow)
    }
    if remainder {
        return TcValue(value: a % b)
    }
    TcValue(value: a / b)
}

// `a << count` or `a >> count` for `a` of a `w`-bit type and a count of
// its own `cw`-bit type: a count outside `0..<w` is out of range; `<<` keeps
// the low bits, `>>` is arithmetic on a signed type and logical otherwise.
public func tc_arith_shift(op: &String, a: Int, w: Int, signed: Bool, count: Int, cw: Int, cs: Bool) -> TcValue {
    let huge = cw >= 64 && not cs && count < 0
    if huge || count < 0 || count >= w {
        return TcValue(fault: TcFault.ShiftRange)
    }
    if op.equals("<<") {
        return TcValue(value: tc_arith_normalize(a << count, w, signed))
    }
    if signed || a >= 0 || count == 0 {
        return TcValue(value: a >> count)
    }
    let mask = ~(-1 << (64 - count))
    TcValue(value: (a >> count) & mask)
}

// `-a` and `~a` for `a` of a `w`-bit type.
public func tc_arith_unary(op: &String, a: Int, w: Int, signed: Bool) -> TcValue {
    if op.equals("~") {
        return TcValue(value: tc_arith_normalize(~a, w, signed))
    }
    if op.equals("-") {
        if not signed {
            if a == 0 {
                return TcValue(value: 0)
            }
            return TcValue(fault: TcFault.Overflow)
        }
        if a == tc_arith_min(w, true) {
            return TcValue(fault: TcFault.Overflow)
        }
        return TcValue(value: 0 - a)
    }
    TcValue(fault: TcFault.NotConstant)
}

// `a op b` for two values of one `w`-bit type: `==`, `!=`, `<`, `<=`, `>`,
// `>=`.
public func tc_arith_compare(op: &String, a: Int, b: Int, w: Int, signed: Bool) -> Bool {
    if op.equals("==") {
        return a == b
    }
    if op.equals("!=") {
        return a != b
    }
    var less = a < b
    var greater = a > b
    if w >= 64 && not signed {
        less = tc_arith_ult(a, b)
        greater = tc_arith_ult(b, a)
    }
    if op.equals("<") {
        return less
    }
    if op.equals("<=") {
        return not greater
    }
    if op.equals(">") {
        return greater
    }
    not less
}

// An integer literal's magnitude, its `_`s and its suffix left off, as a
// 64-bit pattern read unsigned; past 2^64 - 1 it does not fit.
public func tc_arith_literal(text: &String) -> TcValue {
    var radix = 10
    var i = 0
    let n = text.len()
    if n > 2 && (text.byte_at(0) as Int) == 48 {
        let letter = text.byte_at(1) as Int
        if letter == 120 {
            radix = 16
            i = 2
        } else if letter == 111 {
            radix = 8
            i = 2
        } else if letter == 98 {
            radix = 2
            i = 2
        }
    }
    var high = 0
    var low = 0
    var digits = 0
    while i < n {
        let b = text.byte_at(i) as Int
        i = i + 1
        if b == 95 {
            continue
        }
        if b == 105 || b == 117 {
            break
        }
        var digit = -1
        if b >= 48 && b <= 57 {
            digit = b - 48
        } else if b >= 97 && b <= 102 {
            digit = b - 87
        } else if b >= 65 && b <= 70 {
            digit = b - 55
        }
        if digit < 0 || digit >= radix {
            return TcValue(fault: TcFault.NotConstant)
        }
        let next_low = low * radix + digit
        high = high * radix + (next_low >> 32)
        low = next_low & TC_ARITH_LOW32
        if high > TC_ARITH_LOW32 {
            return TcValue(fault: TcFault.NotFit)
        }
        digits = digits + 1
    }
    if digits == 0 {
        return TcValue(fault: TcFault.NotConstant)
    }
    TcValue(value: tc_join(high, low))
}

// A literal of magnitude `m` (a 64-bit pattern read unsigned), negated, at a
// `w`-bit type: one constant, so `-128` is an `Int8` though `128` is not, and
// `-9223372036854775808` an `Int`.
public func tc_arith_negative_literal(m: Int, w: Int, signed: Bool) -> TcValue {
    if m == 0 {
        return TcValue(value: 0)
    }
    let low = tc_arith_min(w, signed)
    if signed && m == low {
        return TcValue(value: low)
    }
    if not signed || m < 0 || 0 - m < low {
        return TcValue(ok: false, bits: 0 - m, fault: TcFault.NotFit)
    }
    TcValue(value: 0 - m)
}

// The float literal's exact decimal path (design 253), in `Int` arithmetic
// alone, so that the compiler needs no `Float` of its own. The digits kept:
// past them only whether a dropped digit was nonzero can still decide a
// rounding, which `truncated` records.
static TC_FLOAT_DIGITS_MAX: Int = 800
// The widest shift one pass takes: the accumulator reaches `10 * 2^shift`,
// which has to stay inside an `Int`.
static TC_FLOAT_MAX_SHIFT: Int = 59
// A decimal point this many places right of the digits is infinite, and this
// many left of them is zero, with no shifting.
static TC_FLOAT_MAX_POINT: Int = 310
static TC_FLOAT_MIN_POINT_DISTANCE: Int = 330
static TC_FLOAT_MANTISSA_BITS: Int = 52
static TC_FLOAT_EXPONENT_BIAS: Int = 1023
static TC_FLOAT_EXPONENT_ALL_ONES: Int = 2047
static TC_FLOAT_IMPLICIT_BIT: Int = 0x0010_0000_0000_0000
static TC_FLOAT_MANTISSA_MASK: Int = 0x000F_FFFF_FFFF_FFFF
static TC_FLOAT_INFINITY: Int = 0x7FF0_0000_0000_0000

// A decimal as its digits, `0.<digits> * 10^point`, one digit's value per
// element of a buffer `TC_FLOAT_DIGITS_MAX` long, `count` of them in use.
// `truncated` says a nonzero digit past the buffer was dropped, which is what
// sends an apparent halfway tie upward.
struct TcFloatDecimal {
    digits: Vector<Int>
    count: Int
    point: Int
    truncated: Bool
}

extension TcFloatDecimal: NoCopy {}

// The bits of a float literal's value, its `_`s left off: the nearest
// binary64, ties to even, as the 64-bit pattern of an `Int`. A literal past
// the largest finite value saturates to infinity, and a nonzero one below
// half the smallest subnormal to zero; both report `NotFit` beside the
// saturated bits. Text outside the literal's grammar is `NotConstant`.
//
// THE FLOAT LITERAL FUNNEL: every compile-time float literal's value is this.
// ENTRY POINTS:
//     LlEmitter.const_value
public func tc_float_bits(text: &String) -> TcValue {
    var decimal = TcFloatDecimal(digits: Vector<Int>(), count: 0, point: 0, truncated: false)
    var k = 0
    while k < TC_FLOAT_DIGITS_MAX {
        try! decimal.digits.push(0)
        k = k + 1
    }
    let n = text.len()
    var i = 0
    var digits = 0
    var fraction = 0
    var lead = 0
    var seen_point = false
    while i < n {
        let b = text.byte_at(i) as Int
        i = i + 1
        if b == 95 {
            continue
        }
        if b == 46 && not seen_point {
            seen_point = true
            continue
        }
        if b < 48 || b > 57 {
            return TcValue(fault: TcFault.NotConstant)
        }
        digits = digits + 1
        if seen_point {
            fraction = fraction + 1
        }
        if decimal.count == 0 && b == 48 {
            lead = lead + 1
        } else {
            decimal.add_digit(b - 48)
        }
    }
    if digits == 0 {
        return TcValue(fault: TcFault.NotConstant)
    }
    if lead == digits {
        return TcValue(value: 0)
    }
    // The point sits after every significant digit, then moves left past the
    // fraction; a trailing zero trimmed below still held its place.
    decimal.point = (digits - lead) - fraction
    decimal.trim()
    let bits = decimal.nearest_bits()
    if bits == TC_FLOAT_INFINITY || bits == 0 {
        return TcValue(ok: false, bits: bits, fault: TcFault.NotFit)
    }
    TcValue(value: bits)
}

// The shift that moves a decimal point `distance` places out toward zero
// without stepping past it: floor(distance * log2(10)), and 1 for a point
// already there.
func tc_float_power_step(distance: Int) -> Int {
    if distance >= 9 {
        return 27
    }
    if distance >= 8 {
        return 26
    }
    if distance >= 7 {
        return 23
    }
    if distance >= 6 {
        return 19
    }
    if distance >= 5 {
        return 16
    }
    if distance >= 4 {
        return 13
    }
    if distance >= 3 {
        return 9
    }
    if distance >= 2 {
        return 6
    }
    if distance >= 1 {
        return 3
    }
    1
}

extension TcFloatDecimal {
    func add_digit(&var self, digit: Int) {
        if self.count < TC_FLOAT_DIGITS_MAX {
            self.digits[self.count] = digit
            self.count = self.count + 1
        } else if digit != 0 {
            self.truncated = true
        }
    }

    // Trailing zeros carry no value and only lengthen every shift.
    func trim(&var self) {
        while self.count > 0 && self.digits[self.count - 1] == 0 {
            self.count = self.count - 1
        }
        if self.count == 0 {
            self.point = 0
        }
    }

    // Divides by 2^shift exactly: long division over the digits in one pass.
    // The accumulator stays below `10 * 2^shift` (`TC_FLOAT_MAX_SHIFT`).
    func scale_down(&var self, shift: Int) {
        var read = 0
        var write = 0
        var n = 0
        while (n >> shift) == 0 {
            if read >= self.count {
                if n == 0 {
                    self.count = 0
                    return
                }
                while (n >> shift) == 0 {
                    n = n * 10
                    read = read + 1
                }
                break
            }
            n = n * 10 + self.digits[read]
            read = read + 1
        }
        self.point = self.point - (read - 1)
        let mask = (1 << shift) - 1
        while read < self.count {
            let carried = self.digits[read]
            let digit = n >> shift
            n = n & mask
            self.digits[write] = digit
            write = write + 1
            n = n * 10 + carried
            read = read + 1
        }
        while n > 0 {
            let digit = n >> shift
            n = n & mask
            if write < TC_FLOAT_DIGITS_MAX {
                self.digits[write] = digit
                write = write + 1
            } else if digit > 0 {
                self.truncated = true
            }
            n = n * 10
        }
        self.count = write
        self.trim()
    }

    // Multiplies by 2^shift exactly, right to left. The new leading digits
    // number floor(shift * log10(2)) or one more; the upper bound is written
    // and the leading zero it may leave is stripped.
    func scale_up(&var self, shift: Int) {
        let delta = ((shift * 30103) / 100000) + 1
        var read = self.count - 1
        var write = self.count + delta
        var n = 0
        while read >= 0 {
            n = n + (self.digits[read] << shift)
            let quotient = n / 10
            let remainder = n - 10 * quotient
            write = write - 1
            if write >= 0 && write < TC_FLOAT_DIGITS_MAX {
                self.digits[write] = remainder
            } else if remainder != 0 {
                self.truncated = true
            }
            n = quotient
            read = read - 1
        }
        while n > 0 {
            let quotient = n / 10
            let remainder = n - 10 * quotient
            write = write - 1
            if write >= 0 && write < TC_FLOAT_DIGITS_MAX {
                self.digits[write] = remainder
            } else if remainder != 0 {
                self.truncated = true
            }
            n = quotient
        }
        while write > 0 {
            write = write - 1
            if write < TC_FLOAT_DIGITS_MAX {
                self.digits[write] = 0
            }
        }
        self.count = self.count + delta
        if self.count > TC_FLOAT_DIGITS_MAX {
            self.count = TC_FLOAT_DIGITS_MAX
        }
        self.point = self.point + delta
        var zeros = 0
        while zeros < self.count && self.digits[zeros] == 0 {
            zeros = zeros + 1
        }
        if zeros > 0 {
            var i = zeros
            while i < self.count {
                let moved = self.digits[i]
                self.digits[i - zeros] = moved
                i = i + 1
            }
            self.count = self.count - zeros
            self.point = self.point - zeros
        }
        self.trim()
    }

    // Multiplies by 2^amount, or divides for a negative one, in passes no
    // wider than the accumulator holds.
    func scale(&var self, amount: Int) {
        if self.count == 0 {
            return
        }
        var remaining = amount
        if remaining > 0 {
            while remaining > TC_FLOAT_MAX_SHIFT {
                self.scale_up(TC_FLOAT_MAX_SHIFT)
                remaining = remaining - TC_FLOAT_MAX_SHIFT
            }
            self.scale_up(remaining)
            return
        }
        remaining = 0 - remaining
        while remaining > TC_FLOAT_MAX_SHIFT {
            self.scale_down(TC_FLOAT_MAX_SHIFT)
            remaining = remaining - TC_FLOAT_MAX_SHIFT
        }
        self.scale_down(remaining)
    }

    // Whether the digits from `at` on round the value up. A lone `5` with
    // nothing after it is a tie, broken to even unless a nonzero digit was
    // dropped past the buffer, which puts the value above the half.
    func rounds_up(&self, at: Int) -> Bool {
        if at < 0 || at >= self.count {
            return false
        }
        if self.digits[at] == 5 && at + 1 == self.count {
            if self.truncated {
                return true
            }
            return at > 0 && (self.digits[at - 1] % 2) != 0
        }
        self.digits[at] >= 5
    }

    // The integer part, rounded; called once the value is in a mantissa's
    // range, so it fits an `Int`.
    func rounded_integer(&self) -> Int {
        if self.point > 18 {
            return TC_ARITH_MAX
        }
        var n = 0
        var i = 0
        while i < self.point && i < self.count {
            n = n * 10 + self.digits[i]
            i = i + 1
        }
        while i < self.point {
            n = n * 10
            i = i + 1
        }
        let at = self.point
        if self.rounds_up(at) {
            n = n + 1
        }
        n
    }

    // The nearest binary64 to this nonnegative decimal, as its bits.
    // Rewrites the decimal in place.
    func nearest_bits(&var self) -> Int {
        if self.count == 0 {
            return 0
        }
        if self.point > TC_FLOAT_MAX_POINT {
            return TC_FLOAT_INFINITY
        }
        if self.point < 0 - TC_FLOAT_MIN_POINT_DISTANCE {
            return 0
        }
        // Scale by powers of two until the value sits in [0.5, 1).
        var power = 0
        while self.point > 0 {
            let out = self.point
            let step = tc_float_power_step(out)
            self.scale(0 - step)
            power = power + step
        }
        var below_half = self.point == 0 && self.digits[0] < 5
        while self.point < 0 || below_half {
            let distance = 0 - self.point
            let step = tc_float_power_step(distance)
            self.scale(step)
            power = power - step
            below_half = self.point == 0 && self.digits[0] < 5
        }
        // A significand's range is [1, 2), one binade below.
        power = power - 1
        // Below the smallest normal exponent the value is subnormal, spelled
        // by shifting further right rather than by a smaller exponent.
        let minimum = 1 - TC_FLOAT_EXPONENT_BIAS
        if power < minimum {
            let back = minimum - power
            self.scale(0 - back)
            power = power + back
        }
        if power + TC_FLOAT_EXPONENT_BIAS >= TC_FLOAT_EXPONENT_ALL_ONES {
            return TC_FLOAT_INFINITY
        }
        self.scale(1 + TC_FLOAT_MANTISSA_BITS)
        var mantissa = self.rounded_integer()
        if mantissa == 2 * TC_FLOAT_IMPLICIT_BIT {
            // The rounding carried into the next binade.
            mantissa = mantissa >> 1
            power = power + 1
            if power + TC_FLOAT_EXPONENT_BIAS >= TC_FLOAT_EXPONENT_ALL_ONES {
                return TC_FLOAT_INFINITY
            }
        }
        var stored = power + TC_FLOAT_EXPONENT_BIAS
        if (mantissa & TC_FLOAT_IMPLICIT_BIT) == 0 {
            stored = 0
        }
        ((stored & TC_FLOAT_EXPONENT_ALL_ONES) << TC_FLOAT_MANTISSA_BITS) | (mantissa & TC_FLOAT_MANTISSA_MASK)
    }
}

// Value `v` of a `w`-bit type, in decimal.
public func tc_arith_text(v: Int, w: Int, signed: Bool) -> String {
    if signed || v >= 0 {
        return v.to_string()
    }
    let tens = tc_divmod64(v, 10, false)
    let unit = tc_divmod64(v, 10, true)
    var out = StringBuilder()
    try! out.append(tens.to_string())
    try! out.append(unit.to_string())
    out.build()
}
