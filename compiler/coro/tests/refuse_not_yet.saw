// The `coro.not-yet` refusal (compiler/tests/coro/README.md, "Refusals"):
// an item that needs a frame holding a suspension this compiler does not
// lower is refused at that suspension, the chain through the frames that are
// not lowered in its message. No source program reaches it, so the fixture
// `compiler/tests/coro/inject/not_yet.saw` is decided clean, then `caller`'s
// call of `poke` is left reaching no item, and the decision is made again.
// `main` holds a ready park this compiler lowers beside its drive of
// `caller`, and its refusal must name the drive, not the park. Paths are the
// repository root's, where the runner runs.
import sawcoro.api.{coro_append_findings, coro_lower_file}
import sawcoro.lower.{coro_decide_lowering, coro_refuse_unlowered}
import sawcoro.program.{CoroProgram}
import sawmir.model.{MirTermKind}
// For the extension writing `item_name`.
import sawmono.dump.{mono_dump_layouts}

// Whether `text` holds `word` at some byte.
func holds(text: &String, word: String) -> Bool {
    let n = text.len()
    let w = word.len()
    var at = 0
    while at + w <= n {
        var k = 0
        while k < w && text.byte_at(at + k) == word.byte_at(k) {
            k = k + 1
        }
        if k == w {
            return true
        }
        at = at + 1
    }
    false
}

// Leaves the call of the item named `callee` in the body of the framed item
// named `caller` reaching no item; returns whether there is one.
func unresolve(coro: &var CoroProgram, caller: String, callee: String) -> Bool {
    var k = 0
    while k < coro.frames.len() {
        let frame = coro.frames[k]
        k = k + 1
        let name = coro.mono.item_name(frame.item)
        if not holds(&name, caller) {
            continue
        }
        let info = coro.mono.dp.bc.mir.funcs[frame.body]
        var b = 0
        while b < info.block_count {
            let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
            b = b + 1
            if block.term != MirTermKind.Call {
                continue
            }
            let t = coro.mono.call_item(block.call)
            if t < 0 {
                continue
            }
            let target = coro.mono.item_name(t)
            if holds(&target, callee) {
                coro.mono.set_call_item(block.call, -1)
                return true
            }
        }
    }
    false
}

func main() {
    let names = Vector<String>()
    let dirs = Vector<String>()
    var front = StringBuilder()
    var coro = coro_lower_file(out: &var front, path: "compiler/tests/coro/inject/not_yet.saw", std_root: "std",
                               notes: false, names: &names, dirs: &dirs)
    assert(not coro.blocked && coro.diags.len() == 0, "the fixture is refused: run from the repository root")
    assert(coro.problems.len() == 0, "the fixture's decision is not clean: {}", coro.problems.get(0) ?? "")
    assert(unresolve(&var coro, "caller", "poke"), "`caller` has no frame calling `poke`")
    coro_decide_lowering(&var coro)
    coro_refuse_unlowered(&var coro)
    assert(coro.diags.len() == 2, "{} refusals, not `caller`'s and `main`'s", coro.diags.len())
    var out = StringBuilder()
    coro_append_findings(out: &var out, coro: &coro)
    let found = out.build()
    assert(holds(&found, "coro.not-yet"), "the refusal is not coro.not-yet: {}", found)
    assert(holds(&found, "`caller` suspends (caller -> poke), so it needs a coroutine frame, which is not lowered yet"),
           "`caller`'s refusal does not name its call of `poke`: {}", found)
    assert(holds(&found, "`main` suspends (main -> caller -> poke), so it needs a coroutine frame"),
           "`main`'s refusal does not name the chain through `caller`: {}", found)
    assert(not holds(&found, "main -> yield_now"), "`main`'s refusal names the park it lowers: {}", found)
}
