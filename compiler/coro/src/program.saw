// Coroutine lowering's program (SL:architecture §3.9): mono's program, and
// what this stage decides about each of its items. Every decision is keyed by
// mono's item ids; the items and their concrete MIR stay mono's.

import sawborrowck.program.{BorrowckProgram}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirCall, MirDiag, MirPlace}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoItemKind, MonoProgram}
import sawresolve.dump.{res_sort_strings}
import sawresolve.model.{ResModuleKind}
import sawresolve.program.{ResProgram}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.program.{TcProgram}

public struct CoroProgram {
    mono: MonoProgram
    // Whether mono's program came refused or with a broken invariant, so
    // nothing was decided.
    blocked: Bool
    // By item: whether it definitely suspends (`coro_solve_suspension`),
    // which is whether it needs a frame.
    suspending: Vector<Bool>
    // By item that suspends: the call its suspension was found through, and
    // the item that call reaches, or -1 when the call is itself the source.
    cause_call: Vector<Int>
    cause_item: Vector<Int>
    // Whether a cycle among the items that suspend was refused, so no frame
    // is finite.
    cyclic: Bool
    // By item: its frame in `frames`, or -1 (`coro_find_frames`).
    frame_of: Vector<Int>
    frames: Vector<CoroFrame>
    // The frames' runs: their values, their suspension points, and each
    // value's storage lifetime, one entry per program point of its item.
    values: Vector<CoroValue>
    suspends: Vector<CoroSuspend>
    live: Vector<Bool>
    // By item: whether its frame is lowered (`coro_decide_lowering`), and
    // when it is not, what is not: a `CoroUnlowered`.
    lowered: Vector<Bool>
    unlowered: Vector<CoroUnlowered>
    // The lowered frames' resume functions (`coro_lower_frames`), by item
    // their index or -1, and the runs of their points.
    resume_of: Vector<Int>
    resumes: Vector<CoroResume>
    points: Vector<CoroPoint>
    resident: Vector<Bool>
    // The lowered spawn sites (`coro_lower_spawn_sites`), in item and block
    // order.
    spawns: Vector<CoroSpawn>
    // The lowered drive sites (`coro_lower_drive_sites`), in item and block
    // order.
    drives: Vector<CoroDriveSite>
    // Refusals (`coro_rules`) and broken invariants.
    diags: Vector<MirDiag>
    problems: Vector<String>
    // What the bodies the lowering rewrites were before it, which the
    // post-lowering verifier compares them with (`coro_verify_snapshot`).
    before: CoroBefore
    // Whether the build is `--sanitize address`, so the verifier also writes
    // each lowered frame's poison list (`coro_poison_lists`), and the runs of
    // those lists, one per resume function.
    sanitize: Bool
    poisons: Vector<CoroPoison>
}

extension CoroProgram: NoCopy {}

public func coro_program(mono: MonoProgram) -> CoroProgram {
    let blocked = mono.blocked || mono.diags.len() > 0 || mono.problems.len() > 0
    CoroProgram(mono: move mono, blocked: blocked, suspending: Vector<Bool>(), cause_call: Vector<Int>(),
                cause_item: Vector<Int>(), cyclic: false, frame_of: Vector<Int>(), frames: Vector<CoroFrame>(),
                values: Vector<CoroValue>(), suspends: Vector<CoroSuspend>(), live: Vector<Bool>(),
                lowered: Vector<Bool>(), unlowered: Vector<CoroUnlowered>(), resume_of: Vector<Int>(),
                resumes: Vector<CoroResume>(), points: Vector<CoroPoint>(), resident: Vector<Bool>(),
                spawns: Vector<CoroSpawn>(), drives: Vector<CoroDriveSite>(), diags: Vector<MirDiag>(),
                problems: Vector<String>(), before: CoroBefore.empty(), sanitize: false,
                poisons: Vector<CoroPoison>())
}

// The verifier's record of the bodies the lowering may rewrite, taken just
// before it runs (compiler/tests/coro/README.md, "The verifier"): each body's
// places and calls as they were, its drops, and for a lowered frame's body its
// suspension points with the initialisation analysis's answer at each. The
// lowering rewrites places and calls in place, so this is the only record of
// what it started from.
public struct CoroBefore {
    bodies: Vector<CoroBeforeBody>
    // Runs per body: each place index the body names and its value then.
    place_ids: Vector<Int>
    places: Vector<MirPlace>
    // Runs per body: each call terminator and its value then.
    call_ids: Vector<Int>
    calls: Vector<MirCall>
    // Runs per body: each drop statement and the block holding it.
    drops: Vector<Int>
    drop_blocks: Vector<Int>
    // Runs per body: the suspension points, and per point a run of
    // `local_count` entries, each local's conditions there.
    points: Vector<CoroBeforePoint>
    conditions: Vector<Int>
}

extension CoroBefore: NoCopy {}

extension CoroBefore {
    public static func empty() -> CoroBefore {
        CoroBefore(bodies: Vector<CoroBeforeBody>(), place_ids: Vector<Int>(), places: Vector<MirPlace>(),
                   call_ids: Vector<Int>(), calls: Vector<MirCall>(), drops: Vector<Int>(), drop_blocks: Vector<Int>(),
                   points: Vector<CoroBeforePoint>(), conditions: Vector<Int>())
    }
}

// One body the verifier checks: its item, its MIR function, whether it is a
// lowered frame's (else it holds a spawn or a drive site), its local count
// before lowering, and its runs in `CoroBefore`.
public struct CoroBeforeBody {
    item: Int
    body: Int
    framed: Bool
    local_count: Int
    place_first: Int
    place_count: Int
    call_first: Int
    call_count: Int
    drop_first: Int
    drop_count: Int
    point_first: Int
    point_count: Int
}

// One suspension point of a body before lowering: the call that suspends
// there, or for an op-budget point -1 and its statement; the block holding
// it; and its state, numbered in block order from 1. Its run of conditions
// starts at `conditions_first`.
public struct CoroBeforePoint {
    call: Int
    stmt: Int
    block: Int
    state: Int
    conditions_first: Int
}

// What a frame value is: the state word the resume function switches on,
// the op-budget counter its loops charge, the result the caller moves out
// after `Ready`, a parameter the caller writes before the first resume, a
// local resident across a suspension, the embedded frame of a child the
// item drives, or an offloaded `blocking` extern call's storage: its job
// word, then one word per argument, which the job's thread reads.
public enum CoroValueKind {
    case State,
    case Budget,
    case Result,
    case Param,
    case Local,
    case Child,
    case Offload
}

// One value of a frame. `local` is the item body's local, or -1 for the
// state word, the op-budget counter, a child and an offload's storage;
// `child` is the item a child slot's frame is, or the extern an offload's
// storage serves, else -1; `ty` is -1 for a child, whose bytes are its
// frame's. `live_first`
// starts its lifetime's run of `live`. The offset, size and alignment are
// the layout's, -1 until it runs.
public struct CoroValue {
    kind: CoroValueKind
    local: Int
    child: Int
    ty: Int
    live_first: Int
    offset: Int
    size: Int
    align: Int
}

// Why a frame is not lowered: the first of its suspension points this
// compiler does not lower (`suspend`, an index of `suspends`), or a shape of
// the frame as a whole (`suspend` -1), with what it is.
public struct CoroUnlowered {
    suspend: Int
    what: CoroUnloweredKind
}

public enum CoroUnloweredKind {
    // Lowered, or never framed.
    case Lowered,
    // A call that is a suspension source other than a park or an offloaded
    // `blocking` extern.
    case Source,
    // A call driving a child whose frame is not lowered.
    case Child,
    // A conditional window whose open suspends.
    case Window
}

// What a resume function does at a suspension point (SL:coroutines §3.1).
// A park, of each reason, records the state and returns `Pending`; on
// resume, it continues. Its record in the task's context, and its arm, are
// MIR the lowering wrote before the park's call (`coro_lower_park`).
public enum CoroPointKind {
    // A ready yield: `yield_now`, the test intrinsic `__saw_suspend`, or an
    // op-budget point whose counter ran out.
    case ParkReady,
    // A timer: `sleep`.
    case ParkTimer,
    // A descriptor's readiness, with a deadline or without; a signal watch
    // parks this way too.
    case ParkFd,
    // A channel's readiness word.
    case ParkChannel,
    // An offload job's completion, through its pipe.
    case ParkOffload,
    // A thread's exit, through its control block's handshake word.
    case ParkThread,
    // Drives an embedded child: starts it at state 0, then resumes it,
    // returning `Pending` while it pends and continuing once it is `Ready`.
    // The call's own block has already written the child's parameter slots,
    // and the block it continues to moves the child's result out.
    case Drive,
    // An offloaded `blocking` extern's start: the extern's own call, its
    // arguments kept, widens each into its argument word of the offload's
    // storage, starts the job with the extern's thunk, and records the job
    // in the storage's job word. Nothing suspends here.
    case OffloadStart,
    // The offload's take: joins the job's thread and narrows the extern's
    // result into the call's destination. Nothing suspends here either.
    case OffloadTake
}

// One point of a lowered frame: the state the frame records when it pends
// there, or -1 for an offload's start and take, which never pend; the block
// whose call terminator the point replaces (for an op-budget point, the
// block lowering added for its yield); for a drive the child item, its
// slot's offset in the frame, and the place the call wrote its result to
// and the block that moves it there from the child's result slot, each -1
// for a call with no destination; for an offload's start and take the
// extern, as `child`, and its storage's offset, as `slot`.
public struct CoroPoint {
    kind: CoroPointKind
    state: Int
    block: Int
    call: Int
    child: Int
    slot: Int
    dest: Int
    result_block: Int
}

// A lowered frame's resume function: its item, its frame, the body's local
// holding the frame pointer, the one holding the task's context pointer when
// the frame parks (else -1), its points, `points[point_first ..]`, and by
// local of its body whether the frame holds it, `resident[resident_first
// ..]`. The frame's size and alignment and the result's offset are the
// layout's. Its poison list is `poisons[poison_first ..]`, empty unless the
// build sanitizes.
public struct CoroResume {
    item: Int
    frame: Int
    frame_local: Int
    context_local: Int
    point_first: Int
    point_count: Int
    resident_first: Int
    size: Int
    align: Int
    result: Int
    poison_first: Int
    poison_count: Int
}

// Where in a resume function a poison-list step runs, as the backend emits a
// block: before statement `ordinal`, before the terminator, on the path that
// records the block's suspension state and returns `Pending`, or on the path
// that leaves that state for the call's return block.
public enum CoroPoisonAt {
    case Statement,
    case Terminator,
    case State,
    case Resume
}

// One step of a lowered frame's poison list (SL:coroutines B3): at `at` in
// block `block`, the frame's bytes `[offset, offset + size)` are poisoned for
// AddressSanitizer, or unpoisoned. `ordinal` is the statement's, else 0.
public struct CoroPoison {
    block: Int
    at: CoroPoisonAt
    ordinal: Int
    offset: Int
    size: Int
    poison: Bool
}

// One lowered spawn site (compiler/tests/coro/README.md, "Spawn sites"): the
// spawner item, the block whose spawn terminator now leaves the task root's
// frame descriptor in local `descriptor`, the root item, the local holding
// the task box, and the blocks the lowering added: the box's allocation, the
// writes into it, and the handle's minting, which is the writes' own block
// at a group site.
public struct CoroSpawn {
    item: Int
    block: Int
    call: Int
    root: Int
    descriptor: Int
    frame: Int
    box_block: Int
    write_block: Int
    handle_block: Int
}

// One lowered drive site (compiler/tests/coro/README.md, "Drive sites"): the
// item holding it, the block whose drive terminator now leaves the root's
// frame descriptor in local `descriptor`, the root item, its task root, and
// local `frame`, which points at the storage for the root's frame the
// backend reserves on the item's stack and whose writes the site's block
// ends with; then the blocks the lowering added: the driver's call, and for
// a result moved out of the frame, the move-out, else -1.
public struct CoroDriveSite {
    item: Int
    block: Int
    call: Int
    root: Int
    descriptor: Int
    frame: Int
    drive_block: Int
    result_block: Int
}

// A suspension point of a frame's item: a call that definitely suspends,
// `call`, at the point after its block's terminator; or a yield-capable
// op-budget point, `call` -1, at its statement's point. The first is
// state 1, in block order.
public struct CoroSuspend {
    block: Int
    point: Int
    call: Int
}

// One item's frame: runs of the program's values and suspension points,
// over its body's `points` program points. The size and alignment are the
// layout's, -1 until it runs; `unsupported` is the value whose type the
// target cannot lay out, or -1.
public struct CoroFrame {
    item: Int
    body: Int
    points: Int
    suspend_first: Int
    suspend_count: Int
    value_first: Int
    value_count: Int
    size: Int
    align: Int
    unsupported: Int
}

extension CoroProgram {
    // Whether item `k` needs a frame: it suspends, or it is a task root, which
    // has one even when it does not (SL:architecture §3.9).
    public func needs_frame(&self, k: Int) -> Bool {
        if k < 0 || k >= self.suspending.len() {
            return false
        }
        self.suspending[k] || self.mono.is_task_root(k)
    }

    // The declaration whose body item `k` runs, or -1: a function item's
    // source function's, or an extern's.
    public func item_decl(&self, k: Int) -> Int {
        let it = self.mono.items[k]
        if it.kind == MonoItemKind.Extern {
            return it.decl
        }
        if it.kind != MonoItemKind.Function || it.source < 0 {
            return -1
        }
        self.mono.dp.bc.mir.funcs[it.source].decl
    }

    // How a cause chain or a cycle names item `k`: its declaration's path
    // inside its module (`ping`, `Walker.walk`), or the dump's name of an
    // item that has no declaration.
    public func item_label(&self, k: Int) -> String {
        let d = self.item_decl(k)
        if d < 0 {
            return self.mono.item_name(k)
        }
        self.mono.dp.bc.mir.tc.res.decl_path(d)
    }

    // The declaration node of item `k`, or -1.
    public func item_node(&self, k: Int) -> Int {
        let d = self.item_decl(k)
        if d < 0 {
            return -1
        }
        self.mono.dp.bc.mir.tc.res.decls[d].node
    }

    // Whether item `k`'s declaration is in std or the builtin module.
    public func std_item(&self, k: Int) -> Bool {
        let node = self.item_node(k)
        if node < 0 {
            return true
        }
        let m = self.mono.dp.bc.mir.tc.node_module(node)
        m < 0 || self.std_module(m)
    }

    func std_module(&self, m: Int) -> Bool {
        let kind = self.mono.dp.bc.mir.tc.res.module(m).kind
        kind == ResModuleKind.Std || kind == ResModuleKind.Builtin
    }

    // Records a refusal at source node `node`, found while deciding item
    // `k`. A node inside std is reported at the nearest call the program
    // itself writes on the chain of items that reached `k`, with the std
    // position named in the message, as mono reports its own.
    public func refuse(&var self, k: Int, node: Int, rule: String, message: String) {
        if node < 0 {
            try! self.problems.push(message)
            return
        }
        let m = self.mono.dp.bc.mir.tc.node_module(node)
        if m < 0 {
            try! self.problems.push(message)
            return
        }
        var at = node
        var text = message
        if self.std_module(m) {
            let site = self.user_site(k)
            if site >= 0 {
                at = site
                var msg = StringBuilder()
                try! msg.append(message)
                try! msg.append(" (inside ")
                try! msg.append(self.mono.dp.bc.mir.tc.res.module_file(m))
                try! msg.append(":")
                try! msg.append(self.mono.dp.bc.mir.tc.res.node_position(m, node))
                try! msg.append(")")
                text = msg.build()
            }
        }
        let am = self.mono.dp.bc.mir.tc.node_module(at)
        let span = self.mono.dp.bc.mir.tc.res.node(at)
        try! self.diags.push(MirDiag(module: am, start: span.start, end: span.end, id: rule, message: text))
    }

    // The node of the nearest program-written call on the chain of items
    // that reached item `k`, or -1.
    func user_site(&self, k: Int) -> Int {
        var at = k
        while at >= 0 {
            let it = self.mono.items[at]
            let n = it.origin_node
            if n >= 0 {
                let m = self.mono.dp.bc.mir.tc.node_module(n)
                if m >= 0 && not self.std_module(m) {
                    return n
                }
            }
            at = it.origin
        }
        return -1
    }
}
