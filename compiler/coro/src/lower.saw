// Which frames this compiler lowers, and the lowering (SL:coroutines §3.1):
// a lowered item's concrete body has every frame value's place rewritten in
// place to its slot, `(*_F).[OFFSET: T]` through the frame pointer `_F`, and
// each suspension point becomes a point of its resume function, a park or a
// child's drive, which the backend emits around the body's own blocks. A
// drive's arguments and result travel through the child's slots by ordinary
// MIR statements, so the backend's drive passes nothing. An
// item that needs a frame and is not lowered is refused (`coro.not-yet`),
// naming the suspension that is not, so nothing half lowered reaches the
// backend.
//
// ENTRY POINTS of the lowering decision:
//   coro_decide_lowering
//   coro_frame_lowered
//   coro_refuse_unlowered
//   coro_lower_frames
//   coro_check_drives

import sawborrowck.program.{BorrowckProgram}
import sawcoro.frames.{coro_driven_child, coro_frame_of}
import sawcoro.program.{CoroFrame, CoroPoint, CoroPointKind, CoroProgram, CoroResume, CoroSuspend, CoroUnlowered,
                        CoroUnloweredKind, CoroValue, CoroValueKind}
import sawcoro.suspends.{coro_cause_chain, coro_source_label}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirAggregate, MirBlock, MirCallKind, MirConstKind, MirLocal, MirLocalKind, MirOperand,
                     MirOperandKind, MirPlace, MirProj, MirProjKind, MirRvalue, MirRvalueKind, MirStmt, MirStmtKind,
                     MirSwitchKind, MirTermKind}
import sawmir.program.{MirProgram}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoProgram}
import sawresolve.lang.{ResLang}
import sawresolve.program.{ResProgram}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.typeops.{TcClient}

// The state word: a frame not yet resumed, and one that has returned. Each
// suspension point is its own state, numbered from 1.
public static CORO_STATE_START: Int = 0
public static CORO_STATE_DONE: Int = -1

// What a resume function returns.
public static CORO_POLL_READY: Int = 0
public static CORO_POLL_PENDING: Int = 1

// What a ready park records in the root's park word: the park word
// vocabulary's ready yield (sawc/std/taskgroup.saw).
public static CORO_PARK_READY: Int = 0

// Decides, for every item, whether its frame is lowered: every suspension
// point of the frame is a shape this compiler lowers, a ready park, an
// effect-only suspension or the drive of a lowered child, and the frame
// holds nothing else it does not (an op-budget point, a borrow window, a
// frame value an index projection reads). Children are decided before their
// callers; once frames are found the suspending call graph is acyclic.
public func coro_decide_lowering(coro: &var CoroProgram) {
    coro.lowered = Vector<Bool>()
    coro.unlowered = Vector<CoroUnlowered>()
    var k = 0
    while k < coro.mono.items.len() {
        try! coro.lowered.push(false)
        try! coro.unlowered.push(CoroUnlowered(suspend: -1, what: CoroUnloweredKind.Lowered))
        k = k + 1
    }
    var decided = Vector<Bool>()
    k = 0
    while k < coro.frames.len() {
        try! decided.push(false)
        k = k + 1
    }
    var left = coro.frames.len()
    var progress = true
    while left > 0 && progress {
        progress = false
        k = 0
        while k < coro.frames.len() {
            if not decided[k] && coro_children_decided(&coro, &decided, k) {
                coro_decide_frame(&var coro, k)
                decided[k] = true
                left = left - 1
                progress = true
            }
            k = k + 1
        }
    }
    if left > 0 {
        try! coro.problems.push("a frame's children were never decided: the suspending call graph has a cycle")
    }
}

// Whether item `k` has a frame and it is lowered.
public func coro_frame_lowered(coro: &CoroProgram, k: Int) -> Bool {
    k >= 0 && k < coro.lowered.len() && coro.lowered[k]
}

func coro_children_decided(coro: &CoroProgram, decided: &Vector<Bool>, f: Int) -> Bool {
    let frame = coro.frames[f]
    var j = 0
    while j < frame.suspend_count {
        // Stage 0 workaround (SL:hazards S4): canonical: let child = coro_driven_child(&coro, coro.suspends[frame.suspend_first + j].call)
        let call = coro.suspends[frame.suspend_first + j].call
        let child = coro_driven_child(&coro, call)
        j = j + 1
        let c = coro_frame_of(&coro, child)
        if child >= 0 && (c < 0 || not decided[c]) {
            return false
        }
    }
    true
}

// Frame `f`'s decision: its first suspending call this compiler does not
// lower, else its first op-budget point, else a shape of the frame as a
// whole.
func coro_decide_frame(coro: &var CoroProgram, f: Int) {
    let frame = coro.frames[f]
    var why = CoroUnlowered(suspend: -1, what: CoroUnloweredKind.Lowered)
    var j = 0
    while j < frame.suspend_count && why.what == CoroUnloweredKind.Lowered {
        let s = frame.suspend_first + j
        j = j + 1
        let call = coro.suspends[s].call
        if call >= 0 {
            let what = coro_call_unlowered(&coro, call)
            if what != CoroUnloweredKind.Lowered {
                why = CoroUnlowered(suspend: s, what: what)
            }
        }
    }
    j = 0
    while j < frame.suspend_count && why.what == CoroUnloweredKind.Lowered {
        let s = frame.suspend_first + j
        j = j + 1
        if coro.suspends[s].call < 0 {
            why = CoroUnlowered(suspend: s, what: CoroUnloweredKind.Budget)
        }
    }
    if why.what == CoroUnloweredKind.Lowered && coro.mono.dp.bc.mir.funcs[frame.body].window_count > 0 {
        why = CoroUnlowered(suspend: -1, what: CoroUnloweredKind.Window)
    }
    if why.what == CoroUnloweredKind.Lowered && coro_indexes_frame_value(&coro, f) {
        why = CoroUnlowered(suspend: -1, what: CoroUnloweredKind.Index)
    }
    coro.unlowered[frame.item] = why
    coro.lowered[frame.item] = why.what == CoroUnloweredKind.Lowered
}

// What is not lowered about suspending call `c`, or `Lowered`: a ready park,
// an effect-only suspension and the drive of a lowered child are.
func coro_call_unlowered(coro: &CoroProgram, c: Int) -> CoroUnloweredKind {
    if coro_parks_ready(&coro, c) || coro_effect_only(&coro, c) {
        return CoroUnloweredKind.Lowered
    }
    let child = coro_driven_child(&coro, c)
    if child < 0 {
        return CoroUnloweredKind.Source
    }
    if not coro_frame_lowered(&coro, child) {
        return CoroUnloweredKind.Child
    }
    CoroUnloweredKind.Lowered
}

// Whether call `c` is a ready park: a call of std's ready park point, by its
// lang role, or of the test intrinsic `__saw_suspend`.
func coro_parks_ready(coro: &CoroProgram, c: Int) -> Bool {
    if coro_calls_builtin(&coro, c, "__saw_suspend") {
        return true
    }
    let t = coro.mono.call_item(c)
    t >= 0 && coro.item_decl(t) >= 0 && coro.item_decl(t) == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkReadyFunction)
}

// Whether call `c` is the test intrinsic `__saw_test_suspend`, a suspension
// for the effects alone (design 22): it makes its caller suspend, and runs as
// nothing, never pending.
func coro_effect_only(coro: &CoroProgram, c: Int) -> Bool {
    coro_calls_builtin(&coro, c, "__saw_test_suspend")
}

// Whether call `c` is a call of the builtin spelled `name`.
func coro_calls_builtin(coro: &CoroProgram, c: Int, name: String) -> Bool {
    if c < 0 {
        return false
    }
    let info = coro.mono.dp.bc.mir.calls[c]
    info.kind == MirCallKind.Builtin && info.spelling >= 0 && coro.mono.dp.bc.mir.tc.name_text(info.spelling).equals(name)
}

// Whether an index projection in frame `f`'s body reads a frame-resident
// local, which a place cannot name as a frame slot.
func coro_indexes_frame_value(coro: &CoroProgram, f: Int) -> Bool {
    let frame = coro.frames[f]
    let resident = coro_resident_locals(&coro, &frame)
    let places = coro_body_places(&coro, frame.body)
    var k = 0
    while k < places.len() {
        let pl = coro.mono.dp.bc.mir.places[places[k]]
        k = k + 1
        var j = 0
        while j < pl.count {
            let step = coro.mono.dp.bc.mir.projs[pl.first + j]
            j = j + 1
            if step.kind == MirProjKind.Index && step.index >= 0 && step.index < resident.len() && resident[step.index] >= 0 {
                return true
            }
        }
    }
    false
}

// By local of frame `frame`'s body: the frame value holding it, an index of
// `coro.values`, or -1 for a local on the resume function's stack.
func coro_resident_locals(coro: &CoroProgram, frame: &CoroFrame) -> Vector<Int> {
    let info = coro.mono.dp.bc.mir.funcs[frame.body]
    var out = Vector<Int>()
    var l = 0
    while l < info.local_count {
        try! out.push(-1)
        l = l + 1
    }
    var j = 0
    while j < frame.value_count {
        let v = coro.values[frame.value_first + j]
        if v.local >= 0 {
            out[v.local] = frame.value_first + j
        }
        j = j + 1
    }
    move out
}

// Every place function `f`'s statements and terminators name, each once, in
// block order: a statement's place and its rvalue's, every operand's, and a
// terminator's switch operand or place, call arguments, callee and
// destination.
func coro_body_places(coro: &CoroProgram, f: Int) -> Vector<Int> {
    var out = Vector<Int>()
    let info = coro.mono.dp.bc.mir.funcs[f]
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        b = b + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            coro_add_place(&var out, stmt.place)
            if stmt.rvalue >= 0 {
                let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
                coro_add_place(&var out, rv.place)
                coro_add_place(&var out, rv.flag)
                coro_add_operands(&coro, &var out, rv.first, rv.count)
            }
        }
        if block.term == MirTermKind.Switch {
            coro_add_operand(&coro, &var out, block.operand)
            coro_add_place(&var out, block.place)
        } else if block.term == MirTermKind.Call {
            let call = coro.mono.dp.bc.mir.calls[block.call]
            coro_add_operands(&coro, &var out, call.arg_first, call.arg_count)
            coro_add_operand(&coro, &var out, call.callee)
            coro_add_place(&var out, call.dest)
        }
    }
    move out
}

func coro_add_place(out: &var Vector<Int>, p: Int) {
    if p < 0 {
        return
    }
    var k = 0
    while k < out.len() {
        if out[k] == p {
            return
        }
        k = k + 1
    }
    try! out.push(p)
}

func coro_add_operand(coro: &CoroProgram, out: &var Vector<Int>, o: Int) {
    if o >= 0 {
        coro_add_place(&var out, coro.mono.dp.bc.mir.operands[o].place)
    }
}

func coro_add_operands(coro: &CoroProgram, out: &var Vector<Int>, first: Int, count: Int) {
    var k = 0
    while k < count {
        let o = coro.mono.dp.bc.mir.lists[first + k]
        coro_add_operand(&coro, &var out, o)
        k = k + 1
    }
}

// Refuses each item that needs a frame and whose frame is not lowered, at
// the call or point that is not, naming it: the cause chain through that
// suspension, so a frame that also holds a lowered park names the one it
// cannot. Only the program's own items are refused when any of them is,
// since every std item that suspends is reached from one; nothing is
// refused here when a cycle was.
public func coro_refuse_unlowered(coro: &var CoroProgram) {
    if coro.cyclic {
        return
    }
    var own = false
    var k = 0
    while k < coro.lowered.len() {
        if coro.needs_frame(k) && not coro.lowered[k] && not coro.std_item(k) {
            own = true
        }
        k = k + 1
    }
    k = 0
    while k < coro.lowered.len() {
        let item = k
        k = k + 1
        if not coro.needs_frame(item) || coro.lowered[item] || (own && coro.std_item(item)) {
            continue
        }
        coro_refuse_item(&var coro, item)
    }
}

func coro_refuse_item(coro: &var CoroProgram, item: Int) {
    let why = coro.unlowered[item]
    var call = coro.cause_call[item]
    if why.suspend >= 0 && coro.suspends[why.suspend].call >= 0 {
        call = coro.suspends[why.suspend].call
    }
    var msg = StringBuilder()
    try! msg.append("`")
    try! msg.append(coro.item_label(item))
    try! msg.append("` suspends (")
    let calls = why.what == CoroUnloweredKind.Source || why.what == CoroUnloweredKind.Child
    if calls {
        try! msg.append(coro_unlowered_chain(&coro, item))
    } else {
        try! msg.append(coro_cause_chain(&coro, item))
    }
    try! msg.append("), so it needs a coroutine frame, ")
    match why.what {
        case Budget -> try! msg.append("and its op-budget point is not lowered yet (SL-545)"),
        case Window -> try! msg.append("and a borrow window in it is not lowered yet (SL-545)"),
        case Index -> try! msg.append("and an index read from its frame is not lowered yet (SL-545)"),
        case _ -> try! msg.append("which is not lowered yet (SL-545)")
    }
    let node = coro.mono.dp.bc.mir.calls[call].node
    coro.refuse(item, node, "coro.not-yet", msg.build())
}

// Item `item`'s chain through the suspensions that are not lowered: each
// child driven at one, then the source or the child that ends it.
func coro_unlowered_chain(coro: &CoroProgram, item: Int) -> String {
    var out = StringBuilder()
    try! out.append(coro.item_label(item))
    var at = item
    while at >= 0 {
        let why = coro.unlowered[at]
        if why.suspend < 0 {
            return out.build()
        }
        let c = coro.suspends[why.suspend].call
        try! out.append(" -> ")
        if why.what == CoroUnloweredKind.Source {
            // Stage 0 workaround (SL:hazards S4): canonical: try! out.append(coro_source_label(&coro, coro.suspends[why.suspend].call))
            try! out.append(coro_source_label(&coro, c))
            return out.build()
        }
        let child = coro_driven_child(&coro, c)
        try! out.append(coro.item_label(child))
        if why.what != CoroUnloweredKind.Child {
            return out.build()
        }
        at = child
    }
    out.build()
}

// Lowers every lowered frame, once the frames are laid out: rewrites its
// body's places to frame slots through a new frame-pointer local, lowers each
// drive's arguments and result into its child's slots, and records its resume
// function's points; then checks every drive's invariant. A frame the target
// cannot lay out is left for the backend, which refuses the type.
public func coro_lower_frames(coro: &var CoroProgram) {
    coro.resume_of = Vector<Int>()
    coro.resumes = Vector<CoroResume>()
    coro.points = Vector<CoroPoint>()
    coro.resident = Vector<Bool>()
    var k = 0
    while k < coro.mono.items.len() {
        try! coro.resume_of.push(-1)
        k = k + 1
    }
    var f = 0
    while f < coro.frames.len() {
        let frame = coro.frames[f]
        if coro_frame_lowered(&coro, frame.item) && frame.unsupported < 0 && frame.size >= 0 {
            coro_lower_frame(&var coro, f)
        }
        f = f + 1
    }
    coro_check_drives(&var coro)
}

func coro_lower_frame(coro: &var CoroProgram, f: Int) {
    let frame = coro.frames[f]
    let resident = coro_resident_locals(&coro, &frame)
    let places = coro_body_places(&coro, frame.body)
    let frame_local = coro_add_frame_local(&var coro, frame.body)
    let word = coro.mono.dp.bc.mir.tc.int_type()
    var k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        if pl.local < 0 || pl.local >= resident.len() || resident[pl.local] < 0 {
            continue
        }
        let v = coro.values[resident[pl.local]]
        let local_ty = coro.mono.dp.bc.mir.locals[coro.mono.dp.bc.mir.funcs[frame.body].local_first + pl.local].ty
        let first = coro.mono.dp.bc.mir.projs.len()
        try! coro.mono.dp.bc.mir.projs.push(MirProj(kind: MirProjKind.Deref, decl: -1, index: -1, ty: word))
        try! coro.mono.dp.bc.mir.projs.push(MirProj(kind: MirProjKind.FrameSlot, decl: -1, index: v.offset,
                                                    ty: local_ty))
        var j = 0
        while j < pl.count {
            let step = coro.mono.dp.bc.mir.projs[pl.first + j]
            try! coro.mono.dp.bc.mir.projs.push(step)
            j = j + 1
        }
        coro.mono.dp.bc.mir.places[p] = MirPlace(local: frame_local, static_decl: -1, first: first,
                                                  count: pl.count + 2, ty: pl.ty)
    }
    let point_first = coro.points.len()
    // The frame's child slots are in the order of the suspensions that
    // drive them, one each.
    var slot_at = 0
    var s = 0
    while s < frame.suspend_count {
        let point = coro.suspends[frame.suspend_first + s]
        s = s + 1
        let block = point.block
        if coro_effect_only(&coro, point.call) {
            coro_skip_call(&var coro, frame.body, block)
        } else if coro_parks_ready(&coro, point.call) {
            try! coro.points.push(CoroPoint(kind: CoroPointKind.ParkReady, state: s, block: block, call: point.call,
                                            child: -1, slot: -1, dest: -1, result_block: -1))
        } else {
            let child = coro_driven_child(&coro, point.call)
            slot_at = coro_next_child_slot(&coro, &frame, slot_at)
            let slot = coro.values[frame.value_first + slot_at].offset
            slot_at = slot_at + 1
            let drive = coro_lower_drive(&var coro, frame.body, frame_local, block, child, slot)
            try! coro.points.push(CoroPoint(kind: CoroPointKind.Drive, state: s, block: block, call: point.call,
                                            child: child, slot: slot, dest: drive.dest,
                                            result_block: drive.result_block))
        }
    }
    let resident_first = coro.resident.len()
    var l = 0
    var result = -1
    while l < resident.len() {
        try! coro.resident.push(resident[l] >= 0)
        if l == 0 && resident[l] >= 0 {
            result = coro.values[resident[l]].offset
        }
        l = l + 1
    }
    // The frame pointer is the resume function's own stack local.
    try! coro.resident.push(false)
    let at = coro.resumes.len()
    coro.resume_of[frame.item] = at
    let point_count = coro.points.len() - point_first
    try! coro.resumes.push(CoroResume(item: frame.item, frame: f, frame_local: frame_local, point_first: point_first,
                                      point_count: point_count, resident_first: resident_first, size: frame.size,
                                      align: frame.align, result: result))
}

// Where a drive's lowering left the call's result: the place the call wrote,
// and the block that moves it there, each -1 for a call with no destination.
struct CoroDrive {
    dest: Int
    result_block: Int
}

// Lowers the call ending block `b` of function `f` into a drive of `child`,
// whose frame is the slot at offset `slot` of the frame `_F` (local
// `frame_local`) points at (SL:coroutines §3.1). `dest = g(args)` becomes the
// block's statements writing each argument into its parameter slot,
// `(*_F).[slot + P: T] = arg`, then the call, with no arguments and no
// destination, which the drive resumes; and, on its return edge, a new block
// `dest = move (*_F).[slot + R: T]`, the child's result moved out, then a
// goto where the call returned. Each argument moves or copies as the call
// passed it, so the rewrite adds no ownership operation.
func coro_lower_drive(coro: &var CoroProgram, f: Int, frame_local: Int, b: Int, child: Int, slot: Int) -> CoroDrive {
    let block = coro.mono.dp.bc.mir.blocks[coro.mono.dp.bc.mir.funcs[f].block_first + b]
    let c = block.call
    var call = coro.mono.dp.bc.mir.calls[c]
    let cf = coro.frames[coro_frame_of(&coro, child)]
    let child_info = coro.mono.dp.bc.mir.funcs[cf.body]
    if call.arg_count != child_info.param_count {
        try! coro.problems.push("a drive's call passes another number of arguments than its child has parameters")
    }
    var j = 0
    while j < call.arg_count && j < child_info.param_count {
        let o = coro.mono.dp.bc.mir.lists[call.arg_first + j]
        j = j + 1
        let off = coro_child_offset(&coro, &cf, CoroValueKind.Param, j)
        let ty = coro.mono.dp.bc.mir.locals[child_info.local_first + j].ty
        let place = coro_frame_place(&var coro, frame_local, slot + off, ty)
        let first = coro.mono.dp.bc.mir.lists.len()
        try! coro.mono.dp.bc.mir.lists.push(o)
        let arg_ty = coro.mono.dp.bc.mir.operands[o].ty
        let rv = coro_use_rvalue(&var coro, arg_ty, first)
        coro_append_stmt(&var coro, f, b, place, rv, call.node)
    }
    var out = CoroDrive(dest: call.dest, result_block: -1)
    if call.dest >= 0 && call.next >= 0 {
        let off = coro_child_offset(&coro, &cf, CoroValueKind.Result, 0)
        let ty = coro.mono.dp.bc.mir.locals[child_info.local_first].ty
        let from = coro_frame_place(&var coro, frame_local, slot + off, ty)
        let o = coro.mono.dp.bc.mir.operands.len()
        try! coro.mono.dp.bc.mir.operands.push(MirOperand(kind: MirOperandKind.Move, place: from, ty: ty,
                                                          const_kind: MirConstKind.Unit, text: -1))
        let first = coro.mono.dp.bc.mir.lists.len()
        try! coro.mono.dp.bc.mir.lists.push(o)
        let rv = coro_use_rvalue(&var coro, ty, first)
        let moved = coro_add_goto_block(&var coro, f, call.next, call.node)
        coro_append_stmt(&var coro, f, moved, call.dest, rv, call.node)
        call.next = moved
        out.result_block = moved
    }
    call.arg_count = 0
    call.dest = -1
    coro.mono.dp.bc.mir.calls[c] = call
    out
}

// Ends block `b` of function `f`, whose call is an effect-only suspension,
// in a goto where the call returns, so nothing runs in its place.
func coro_skip_call(coro: &var CoroProgram, f: Int, b: Int) {
    let at = coro.mono.dp.bc.mir.funcs[f].block_first + b
    var block = coro.mono.dp.bc.mir.blocks[at]
    let next = coro.mono.dp.bc.mir.calls[block.call].next
    if next < 0 {
        block.term = MirTermKind.Unreachable
    } else {
        block.term = MirTermKind.Goto
        block.target = next
    }
    block.call = -1
    coro.mono.dp.bc.mir.blocks[at] = block
}

// The offset in child frame `cf` of its value of kind `kind` for local `l`.
func coro_child_offset(coro: &CoroProgram, cf: &CoroFrame, kind: CoroValueKind, l: Int) -> Int {
    var k = 0
    while k < cf.value_count {
        let v = coro.values[cf.value_first + k]
        if v.kind == kind && v.local == l {
            return v.offset
        }
        k = k + 1
    }
    return -1
}

// A new place, the frame slot `(*_F).[offset: T]` through local
// `frame_local`.
func coro_frame_place(coro: &var CoroProgram, frame_local: Int, offset: Int, ty: Int) -> Int {
    let word = coro.mono.dp.bc.mir.tc.int_type()
    let first = coro.mono.dp.bc.mir.projs.len()
    try! coro.mono.dp.bc.mir.projs.push(MirProj(kind: MirProjKind.Deref, decl: -1, index: -1, ty: word))
    try! coro.mono.dp.bc.mir.projs.push(MirProj(kind: MirProjKind.FrameSlot, decl: -1, index: offset, ty: ty))
    let at = coro.mono.dp.bc.mir.places.len()
    try! coro.mono.dp.bc.mir.places.push(MirPlace(local: frame_local, static_decl: -1, first: first, count: 2,
                                                  ty: ty))
    at
}

// A new rvalue using the one operand at `lists[first]`, of type `ty`.
func coro_use_rvalue(coro: &var CoroProgram, ty: Int, first: Int) -> Int {
    let at = coro.mono.dp.bc.mir.rvalues.len()
    try! coro.mono.dp.bc.mir.rvalues.push(MirRvalue(kind: MirRvalueKind.Use, ty: ty, op: -1, exclusive: false,
                                                    place: -1, first: first, count: 1,
                                                    aggregate: MirAggregate.Plain, decl: -1, flag: -1))
    at
}

// Appends `place = rvalue` to block `b` of function `f`, carrying source node
// `node`.
func coro_append_stmt(coro: &var CoroProgram, f: Int, b: Int, place: Int, rv: Int, node: Int) {
    let s = coro.mono.dp.bc.mir.stmts.len()
    try! coro.mono.dp.bc.mir.stmts.push(MirStmt(kind: MirStmtKind.Assign, place: place, rvalue: rv, yields: false,
                                                next: -1, node: node, closing: false))
    let at = coro.mono.dp.bc.mir.funcs[f].block_first + b
    var block = coro.mono.dp.bc.mir.blocks[at]
    if block.first < 0 {
        block.first = s
    } else {
        var prev = coro.mono.dp.bc.mir.stmts[block.last]
        prev.next = s
        coro.mono.dp.bc.mir.stmts[block.last] = prev
    }
    block.last = s
    coro.mono.dp.bc.mir.blocks[at] = block
}

// Gives function `f` one more block, empty and ending in a goto to block
// `target`, and returns its number; its blocks move to a fresh run of the
// arena, numbered as before, since the run after them is another
// function's.
func coro_add_goto_block(coro: &var CoroProgram, f: Int, target: Int, node: Int) -> Int {
    var info = coro.mono.dp.bc.mir.funcs[f]
    let first = coro.mono.dp.bc.mir.blocks.len()
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        try! coro.mono.dp.bc.mir.blocks.push(block)
        b = b + 1
    }
    try! coro.mono.dp.bc.mir.blocks.push(MirBlock(first: -1, last: -1, term: MirTermKind.Goto, target: target,
                                                  switch_kind: MirSwitchKind.Bool, operand: -1, place: -1,
                                                  arm_first: 0, arm_count: 0, otherwise: -1, call: -1,
                                                  term_node: node, term_closing: false))
    let made = info.block_count
    info.block_first = first
    info.block_count = info.block_count + 1
    coro.mono.dp.bc.mir.funcs[f] = info
    made
}

// The structural invariant of every lowered drive: its call carries no
// arguments and no destination; its block writes each of the child's
// parameter slots exactly once, `(*_F).[slot + P: T] = ...`; and when the
// call had a destination, the block it returns to is the move-out, `dest =
// move (*_F).[slot + R: T]` then a goto. The slots are read from the child's
// frame, not from the lowering. A broken one is an `INVARIANT` line.
public func coro_check_drives(coro: &var CoroProgram) {
    var r = 0
    while r < coro.resumes.len() {
        let resume = coro.resumes[r]
        r = r + 1
        let frame = coro.frames[resume.frame]
        var j = 0
        while j < resume.point_count {
            let point = coro.points[resume.point_first + j]
            j = j + 1
            if point.kind == CoroPointKind.Drive {
                coro_check_drive(&var coro, frame.item, frame.body, resume.frame_local, &point)
            }
        }
    }
}

func coro_check_drive(coro: &var CoroProgram, item: Int, f: Int, frame_local: Int, point: &CoroPoint) {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + point.block]
    let call = coro.mono.dp.bc.mir.calls[point.call]
    let cf = coro.frames[coro_frame_of(&coro, point.child)]
    let child_info = coro.mono.dp.bc.mir.funcs[cf.body]
    if call.arg_count != 0 || call.dest >= 0 {
        coro_drive_problem(&var coro, item, &point, "its call still carries arguments or a destination")
    }
    var l = 1
    while l <= child_info.param_count {
        let off = point.slot + coro_child_offset(&coro, &cf, CoroValueKind.Param, l)
        var writes = 0
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            if stmt.kind == MirStmtKind.Assign && coro_is_frame_slot(&coro, stmt.place, frame_local, off) {
                writes = writes + 1
            }
        }
        if writes != 1 {
            var what = StringBuilder()
            try! what.append("parameter _")
            try! what.append(l)
            try! what.append("'s slot (*frame).[")
            try! what.append(off)
            try! what.append("] is written ")
            try! what.append(writes)
            try! what.append(" times in bb")
            try! what.append(point.block)
            try! what.append(", not once")
            coro_drive_problem(&var coro, item, &point, what.build())
        }
        l = l + 1
    }
    if point.dest < 0 {
        return
    }
    let off = point.slot + coro_child_offset(&coro, &cf, CoroValueKind.Result, 0)
    var moves = point.result_block >= 0 && call.next == point.result_block
    if moves {
        let after = coro.mono.dp.bc.mir.blocks[info.block_first + point.result_block]
        moves = after.term == MirTermKind.Goto && after.first >= 0 && after.first == after.last
        if moves {
            let stmt = coro.mono.dp.bc.mir.stmts[after.first]
            moves = stmt.kind == MirStmtKind.Assign && stmt.place == point.dest && stmt.rvalue >= 0
            if moves {
                let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
                moves = rv.kind == MirRvalueKind.Use && rv.count == 1
                if moves {
                    let o = coro.mono.dp.bc.mir.operands[coro.mono.dp.bc.mir.lists[rv.first]]
                    moves = o.kind == MirOperandKind.Move && coro_is_frame_slot(&coro, o.place, frame_local, off)
                }
            }
        }
    }
    if not moves {
        coro_drive_problem(&var coro, item, &point, "the block its call returns to does not move the child's result out into the call's destination")
    }
}

// Whether place `p` is the frame slot `(*_F).[offset: T]` through local
// `frame_local`, with no step after it.
func coro_is_frame_slot(coro: &CoroProgram, p: Int, frame_local: Int, offset: Int) -> Bool {
    if p < 0 {
        return false
    }
    let place = coro.mono.dp.bc.mir.places[p]
    if place.local != frame_local || place.count != 2 {
        return false
    }
    let deref = coro.mono.dp.bc.mir.projs[place.first]
    let step = coro.mono.dp.bc.mir.projs[place.first + 1]
    deref.kind == MirProjKind.Deref && step.kind == MirProjKind.FrameSlot && step.index == offset
}

func coro_drive_problem(coro: &var CoroProgram, item: Int, point: &CoroPoint, what: String) {
    var msg = StringBuilder()
    try! msg.append("`")
    try! msg.append(coro.mono.item_name(item))
    try! msg.append("`'s drive of `")
    try! msg.append(coro.mono.item_name(point.child))
    try! msg.append("` at state ")
    try! msg.append(point.state)
    try! msg.append(": ")
    try! msg.append(what)
    try! coro.problems.push(msg.build())
}

// The index in `frame`'s values of its first child slot from `from` on.
func coro_next_child_slot(coro: &CoroProgram, frame: &CoroFrame, from: Int) -> Int {
    var j = from
    while j < frame.value_count && coro.values[frame.value_first + j].kind != CoroValueKind.Child {
        j = j + 1
    }
    j
}

// Gives function `f` one more local, the frame pointer, a `&var Int` that
// points at the frame's state word; its locals move to a fresh run of the
// arena, numbered as before, since the run after them is another function's.
func coro_add_frame_local(coro: &var CoroProgram, f: Int) -> Int {
    var info = coro.mono.dp.bc.mir.funcs[f]
    let first = coro.mono.dp.bc.mir.locals.len()
    var l = 0
    while l < info.local_count {
        let local = coro.mono.dp.bc.mir.locals[info.local_first + l]
        try! coro.mono.dp.bc.mir.locals.push(local)
        l = l + 1
    }
    let word = coro.mono.dp.bc.mir.tc.int_type()
    let pointer = coro.mono.dp.bc.mir.tc.mk_ref(true, word)
    try! coro.mono.dp.bc.mir.locals.push(MirLocal(ty: pointer, kind: MirLocalKind.Temp, name: -1, node: -1,
                                                  owned: false, reference: false))
    let frame_local = info.local_count
    info.local_first = first
    info.local_count = info.local_count + 1
    coro.mono.dp.bc.mir.funcs[f] = info
    frame_local
}
