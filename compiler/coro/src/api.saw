// Coroutine lowering's entry points: a program brought through mono, then
// each item's frame decided; and the record `sawc coro` prints for it.

import sawcoro.dump.{coro_dump_items, coro_dump_layouts, coro_dump_lowered}
import sawcoro.drive.{coro_check_drive_sites, coro_lower_drive_sites, coro_refuse_drive_sites}
import sawcoro.frames.{coro_find_frames}
import sawcoro.layout.{coro_lay_out_frames}
import sawcoro.lower.{coro_decide_lowering, coro_frame_lowered, coro_lower_frames, coro_refuse_unlowered}
import sawcoro.program.{CoroProgram, coro_program}
import sawcoro.dropblocks.{coro_check_blocking_drops}
import sawcoro.send.{coro_check_frame_send}
import sawcoro.spawn.{coro_check_spawns, coro_lower_spawn_sites}
import sawcoro.suspends.{coro_solve_suspension}
import sawcoro.verify.{coro_verify_lowering, coro_verify_snapshot}
import sawmir.api.{mir_append_diag}
import sawmir.program.{MirProgram}
import sawmono.api.{mono_append_findings, mono_lower_file}
import sawmono.program.{MonoProgram}
import sawmono.worklist.{mono_rules}
import sawtarget.layout.{Target}

// How `sawc coro` treats one entry file.
public struct CoroOptions {
    std_root: String
    // The target triple frames are laid out for.
    target: String
    // Print each item's frame decision.
    dump: Bool
    // Print each frame's layout.
    layouts: Bool
    // Print each lowered frame's resume function.
    lowered: Bool
    notes: Bool
}

// The program whose entry file is `path`, brought through mono, then
// decided, each frame's contents found, and which frames are lowered. Everything the stages before
// mono report is appended to `out`, as `mono_lower_file` appends it; mono's
// own findings and this stage's are `coro_append_findings`'. When mono's
// program comes refused or with a broken invariant, nothing is decided.
public func coro_lower_file(out: &var StringBuilder, path: String, std_root: String, notes: Bool,
                            names: &Vector<String>, dirs: &Vector<String>, runtime: Bool = false) -> CoroProgram {
    var mono = mono_lower_file(out: &var out, path: path, std_root: std_root, notes: notes, names: &names,
                               dirs: &dirs, runtime: runtime)
    var coro = coro_program(move mono)
    if not coro.blocked {
        coro_solve_suspension(&var coro)
        coro_refuse_drive_sites(&var coro)
        coro_find_frames(&var coro)
        coro_check_frame_send(&var coro)
        coro_check_blocking_drops(&var coro)
        coro_decide_lowering(&var coro)
        coro_refuse_unlowered(&var coro)
        coro_root_entry_executor(&var coro)
    }
    move coro
}

// A program whose `main` has a lowered frame is handed to the entry
// executor, which is rooted for it; std declaring none is a broken
// invariant, since the ready park it lowers is std's too.
func coro_root_entry_executor(coro: &var CoroProgram) {
    // Stage 0 workaround (SL:hazards S4): canonical: if not coro_frame_lowered(&coro, coro.mono.main_item) || coro.diags.len() > 0 {
    let main = coro.mono.main_item
    if not coro_frame_lowered(&coro, main) || coro.diags.len() > 0 {
        return
    }
    if coro.mono.root_entry_executor() < 0 {
        try! coro.problems.push("`main` has a lowered frame, and std declares no entry executor")
    }
}

// Lays out every frame for `target`, then lowers every spawn site and every
// drive site, then each lowered frame: what the backend consumes, and what
// `--lowered` prints. A spawn site is lowered first, so the locals and blocks
// it adds to a framed spawner are in that frame's body when the frame is
// lowered; a drive site is only ever in an item with no frame. The verifier
// records every body the lowering rewrites before it starts, and checks them
// once it is done.
public func coro_lower_for(coro: &var CoroProgram, target: &var Target) {
    // The backend lowers a failed `print`, so the renderer of its cause is
    // rooted for every program that is lowered, after the decisions the
    // dumps print and before the lowering that emits its calls.
    let _ = coro.mono.root_print_failure()
    coro_lay_out_frames(&var coro, &var target)
    coro_verify_snapshot(&var coro)
    coro_lower_spawn_sites(&var coro)
    coro_lower_drive_sites(&var coro)
    coro_lower_frames(&var coro)
    coro_check_spawns(&var coro)
    coro_check_drive_sites(&var coro)
    coro_verify_lowering(&var coro, &var target)
}

// The record of one program, after its `FILE` line: everything
// `sawc mono --check` prints for it, then this stage's refusals, each an
// `ERROR` line, and an `INVARIANT` line per problem it met; then, with
// `dump`, each item's frame decision, with `layouts`, each frame laid out
// for the options' target, or with `lowered`, an `INVARIANT` line per problem
// the lowering meets, then each lowered frame's resume function for it.
// Returns 0 when nothing was refused or broken and 1 otherwise.
public func coro_record(out: &var StringBuilder, path: String, options: &CoroOptions, names: &Vector<String>,
                        dirs: &Vector<String>) -> Int {
    var coro = coro_lower_file(out: &var out, path: path, std_root: options.std_root, notes: options.notes,
                               names: &names, dirs: &dirs)
    coro_append_findings(out: &var out, coro: &coro)
    var status = 0
    if coro.blocked || coro.diags.len() > 0 || coro.problems.len() > 0 {
        status = 1
    }
    if options.dump && not coro.blocked {
        coro_dump_items(&coro, &var out)
    }
    if options.layouts && not coro.blocked {
        var target = coro.mono.target_for(options.target)
        coro_lay_out_frames(&var coro, &var target)
        coro_dump_layouts(&coro, &var out)
    }
    if options.lowered && not coro.blocked {
        var target = coro.mono.target_for(options.target)
        let before = coro.problems.len()
        coro_lower_for(&var coro, &var target)
        var k = before
        while k < coro.problems.len() {
            try! out.append("INVARIANT\tcoro\t")
            try! out.append(coro.problems.get(k) ?? "")
            try! out.append("\n")
            k = k + 1
        }
        if coro.problems.len() > before {
            status = 1
        }
        coro_dump_lowered(&coro, &var out)
    }
    status
}

// Mono's refusals and the invariants it met, then this stage's, each in the
// order met.
public func coro_append_findings(out: &var StringBuilder, coro: &CoroProgram) {
    mono_append_findings(out: &var out, mono: &coro.mono)
    var k = 0
    while k < coro.diags.len() {
        let d = coro.diags[k]
        mir_append_diag(out: &var out, p: &coro.mono.dp.bc.mir, d: &d)
        k = k + 1
    }
    k = 0
    while k < coro.problems.len() {
        try! out.append("INVARIANT\tcoro\t")
        try! out.append(coro.problems.get(k) ?? "")
        try! out.append("\n")
        k = k + 1
    }
}
