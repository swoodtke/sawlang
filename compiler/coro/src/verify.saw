// The post-lowering verifier: the borrow check ran before coroutine lowering,
// so it never sees the resume paths lowering makes; this checks that lowering
// preserved what was decided before it. Every fact is recomputed from the
// MIR, as it was and as lowering left it, and none is read from the
// lowering's own records; it reads only which frames were lowered, their
// layouts, and the target's size of each slot's type. Five rules, each broken
// one an `INVARIANT` line naming its rule (compiler/tests/coro/README.md, "The
// verifier"):
//   1, frame in place: a frame value is reached only in its slot through the
//      frame pointer, and the frame never as a whole, so nothing relocates it;
//   2, teardown by state: at each suspension state the frame's values are
//      initialised as the analysis says the body's were, the record of each
//      window open there is in the frame, every drop is one drop elaboration
//      placed, and each transfer a rewritten call made happens once;
//   3, windows close once: on every path, resumed states included;
//   4, record before arm: a park's record reaches its arm and its park;
//   5, lifetimes disjoint: no two frame values that share a byte are live at
//      one program point, each value's lifetime recomputed from the lowered
//      body (`coro_verify_lifetimes`).
//
// ENTRY POINTS of the verifier:
//   coro_verify_snapshot
//   coro_verify_lowering

import sawborrowck.program.{BorrowckProgram}
import sawcoro.frames.{coro_driven_child, coro_frame_of, coro_offloaded_extern}
import sawcoro.lifetimes.{CoroSpans}
import sawcoro.lower.{CORO_PARK_FD, CORO_PARK_READY, CORO_PARK_TIMER, CoroContext, coro_call_decl, coro_cancel_read,
                      coro_child_offset, coro_context_shape, coro_frame_lowered, coro_offload_done_item,
                      coro_offload_park_item, coro_past_target}
import sawcoro.program.{CoroBefore, CoroBeforeBody, CoroBeforePoint, CoroFrame, CoroPoison, CoroPoisonAt,
                        CoroProgram, CoroValue, CoroValueKind}
import sawcoro.suspends.{coro_call_suspends}
import sawdrops.program.{DropsProgram}
import sawmir.dump.{mir_dump_module}
import sawmir.initialisation.{MIR_INIT_DROPPED, MIR_INIT_MOVED, MIR_INIT_PARTIAL, MIR_INIT_UNASSIGNED,
                              MIR_INIT_WHOLE, MirAccess, MirAccessKind, MirInit}
import sawmir.model.{MirBlock, MirCall, MirCallKind, MirConstKind, MirFuncKind, MirOperandKind, MirPlace, MirProj,
                     MirProjKind, MirRvalueKind, MirStmtKind, MirSwitchKind, MirTermKind, mir_spawn_leading}
import sawmir.program.{MirProgram}
import sawmir.states.{MirCursor}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoProgram}
import sawresolve.lang.{ResLang}
import sawresolve.program.{ResProgram}
import sawtarget.layout.{Target}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.typeops.{TcClient}

// A local's entry in a run of conditions: the conditions of its own move path,
// the analysis's bits, plus this bit when some path inside it may be whole or
// partial, which is the analysis's "maybe initialised".
static CORO_VERIFY_LIVE: Int = 32

// What rule 4's dataflow knows of a record at a point: no path reaches it
// yet, some path reaches it with no record since its last suspension, or
// records made by several statements reach it. A statement's index stands for
// the one record that reaches on every path.
static CORO_RECORD_UNREACHED: Int = -3
static CORO_RECORD_MANY: Int = -2
static CORO_RECORD_NONE: Int = -1

// What a window may be at a point, for rule 3: one bit each.
static CORO_WINDOW_OPEN: Int = 1
static CORO_WINDOW_CLOSED: Int = 2

// A park point, by the lang role of the std function a call reaches.
enum CoroVerifyPark {
    case NotAPark,
    case Ready,
    case Timer,
    case Fd,
    case FdUntil,
    case Channel,
    case Offload,
    case Thread
}

// Records, before the lowering runs, every body it may rewrite: each lowered
// frame's, which it rewrites throughout, and each one holding a spawn or a
// drive site, whose sites it rewrites. A body's places, calls and drops are
// kept as they are, and a frame's suspension points with the conditions the
// initialisation analysis gives each local there.
public func coro_verify_snapshot(coro: &var CoroProgram) {
    coro.before = CoroBefore.empty()
    var k = 0
    while k < coro.mono.items.len() {
        let item = k
        k = k + 1
        let f = coro.mono.items[item].body
        if f < 0 {
            continue
        }
        let framed = coro_verify_framed(&coro, item)
        if framed || coro_verify_holds_site(&coro, f) {
            coro_snapshot_body(&var coro, item, f, framed)
        }
    }
}

// Whether item `item` has a frame the lowering rewrites: it is lowered, and
// the target lays it out.
func coro_verify_framed(coro: &CoroProgram, item: Int) -> Bool {
    let fr = coro_frame_of(&coro, item)
    if fr < 0 || not coro_frame_lowered(&coro, item) {
        return false
    }
    let frame = coro.frames[fr]
    frame.unsupported < 0 && frame.size >= 0
}

// Whether function `f` holds a spawn or a drive site.
func coro_verify_holds_site(coro: &CoroProgram, f: Int) -> Bool {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        b = b + 1
        if block.term == MirTermKind.Call {
            let kind = coro.mono.dp.bc.mir.calls[block.call].kind
            if kind == MirCallKind.Spawn || kind == MirCallKind.Drive {
                return true
            }
        }
    }
    false
}

func coro_snapshot_body(coro: &var CoroProgram, item: Int, f: Int, framed: Bool) {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let place_first = coro.before.place_ids.len()
    let call_first = coro.before.call_ids.len()
    let drop_first = coro.before.drops.len()
    let point_first = coro.before.points.len()
    let places = coro_verify_places(&coro, f)
    var k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        try! coro.before.place_ids.push(p)
        try! coro.before.places.push(pl)
    }
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            if stmt.kind == MirStmtKind.Drop {
                try! coro.before.drops.push(s)
                try! coro.before.drop_blocks.push(b)
            }
            s = stmt.next
        }
        if block.term == MirTermKind.Call {
            let call = coro.mono.dp.bc.mir.calls[block.call]
            try! coro.before.call_ids.push(block.call)
            try! coro.before.calls.push(call)
        }
        b = b + 1
    }
    if framed {
        coro_snapshot_points(&var coro, f)
    }
    let place_count = coro.before.place_ids.len() - place_first
    let call_count = coro.before.call_ids.len() - call_first
    let drop_count = coro.before.drops.len() - drop_first
    let point_count = coro.before.points.len() - point_first
    try! coro.before.bodies.push(CoroBeforeBody(item: item, body: f, framed: framed, local_count: info.local_count,
                                                place_first: place_first, place_count: place_count,
                                                call_first: call_first, call_count: call_count,
                                                drop_first: drop_first, drop_count: drop_count,
                                                point_first: point_first, point_count: point_count))
}

// Function `f`'s suspension points, in block order as its frame numbers its
// states: each yield-capable op-budget point, and each call that definitely
// suspends; with each local's conditions at each.
func coro_snapshot_points(coro: &var CoroProgram, f: Int) {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var calls = Vector<Int>()
    var stmts = Vector<Int>()
    var blocks = Vector<Int>()
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            if stmt.kind == MirStmtKind.Budget && stmt.yields {
                try! calls.push(-1)
                try! stmts.push(s)
                try! blocks.push(b)
            }
            s = stmt.next
        }
        if block.term == MirTermKind.Call && coro_call_suspends(&coro, block.call) {
            try! calls.push(block.call)
            try! stmts.push(-1)
            try! blocks.push(b)
        }
        b = b + 1
    }
    let runs = coro_verify_condition_runs(&coro, f, &calls, &stmts, &blocks, info.local_count)
    var at = 0
    var j = 0
    while j < calls.len() {
        let conditions_first = coro.before.conditions.len()
        let count = runs[at]
        let length = if count < 0 { 1 } else { 1 + 2 * count }
        var k = 0
        while k < length {
            try! coro.before.conditions.push(runs[at + k])
            k = k + 1
        }
        at = at + length
        try! coro.before.points.push(CoroBeforePoint(call: calls[j], stmt: stmts[j], block: blocks[j], state: j + 1,
                                                     conditions_first: conditions_first))
        j = j + 1
    }
}

// Each local's conditions, below `local_count`, at each point of function
// `f`, as one run per point in point order. Point `j` is just before
// statement `stmts[j]` of block `blocks[j]`, or for a call `calls[j]`, which
// ends that block, the moment it suspends, its arguments taken and its
// destination not yet written; only the first point naming a statement or a
// call is recorded there. A point's run is -1 when no path reaches it, or
// `f` no longer holds it, which gives 0 for every local; else the count of
// locals whose conditions differ from those at the last point with a run,
// then each such local and its conditions (`CoroBefore.conditions`). Only
// the blocks holding a point are walked, each by an initialisation cursor
// from its entry, so a point costs what changed since the one before it
// rather than every local (SL-970).
func coro_verify_condition_runs(coro: &CoroProgram, f: Int, calls: &Vector<Int>, stmts: &Vector<Int>,
                                blocks: &Vector<Int>, local_count: Int) -> Vector<Int> {
    var out = Vector<Int>()
    let facts = coro.mono.dp.bc.mir.init_analysis(f)
    let info = coro.mono.dp.bc.mir.funcs[f]
    var first_stmt = Map<Int, Int>()
    var first_call = Map<Int, Int>()
    var j = 0
    while j < calls.len() {
        if stmts[j] >= 0 && not first_stmt.contains_key(stmts[j]) {
            let _ = try! first_stmt.insert(stmts[j], j)
        }
        if stmts[j] < 0 && calls[j] >= 0 && not first_call.contains_key(calls[j]) {
            let _ = try! first_call.insert(calls[j], j)
        }
        j = j + 1
    }
    var conditions = CoroVerifyConditions(facts: &facts, local_count: local_count)
    var cur = facts.cursor()
    // The block the cursor walks, the next statement of it to apply, and
    // whether its terminator's accesses are applied.
    var walked = -1
    var next = -1
    var ended = false
    j = 0
    while j < calls.len() {
        let b = blocks[j]
        let s = stmts[j]
        let c = calls[j]
        let point = j
        j = j + 1
        var recorded = false
        let own = (s >= 0 && (first_stmt.get(s) ?? -1) == point) || (s < 0 && c >= 0 && (first_call.get(c) ?? -1) == point)
        if own && b >= 0 && b < info.block_count && facts.reached[b] {
            let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
            if walked != b || ended {
                conditions.enter(&facts, &var cur, b)
                walked = b
                next = block.first
                ended = false
            }
            if s >= 0 {
                // A statement behind the walk is reached from its block's
                // entry again.
                var pass = 0
                while pass < 2 && not recorded {
                    while next >= 0 && next != s {
                        let accesses = coro.mono.dp.bc.mir.init_stmt_accesses(f, next, &facts)
                        conditions.apply(&facts, &var cur, &accesses)
                        next = coro.mono.dp.bc.mir.stmts[next].next
                    }
                    if next == s {
                        conditions.record(&cur, &var out)
                        recorded = true
                    } else if pass == 0 {
                        conditions.enter(&facts, &var cur, b)
                        next = block.first
                    }
                    pass = pass + 1
                }
            } else if block.term == MirTermKind.Call && block.call == c {
                while next >= 0 {
                    let accesses = coro.mono.dp.bc.mir.init_stmt_accesses(f, next, &facts)
                    conditions.apply(&facts, &var cur, &accesses)
                    next = coro.mono.dp.bc.mir.stmts[next].next
                }
                let accesses = coro.mono.dp.bc.mir.init_term_accesses(f, b, &facts)
                let dest = coro.mono.dp.bc.mir.calls[c].dest
                var taken = Vector<MirAccess>()
                var a = 0
                while a < accesses.len() {
                    let access = accesses[a]
                    a = a + 1
                    if not (access.kind == MirAccessKind.Write && access.place == dest) {
                        try! taken.push(access)
                    }
                }
                conditions.apply(&facts, &var cur, &taken)
                ended = true
                conditions.record(&cur, &var out)
                recorded = true
            }
        }
        if not recorded {
            try! out.push(-1)
        }
    }
    move out
}

// The conditions of each local below a body's local count as a walk moves an
// initialisation cursor through the body: a local's own path's conditions,
// plus CORO_VERIFY_LIVE while some path inside it may be whole or partial. A
// local is looked at again only where one of its paths may have changed.
struct CoroVerifyConditions {
    // By move path: its local when that is below the count, else -1, and
    // whether it may be whole or partial now.
    path_owner: Vector<Int>
    path_live: Vector<Bool>
    // By local: how many of its paths may be whole or partial now, and its
    // conditions at the last point recorded with a run.
    live_paths: Vector<Int>
    last: Vector<Int>
    // The locals one of whose paths changed since the last point recorded.
    dirty: Vector<Int>
    dirty_mark: Vector<Bool>
}

extension CoroVerifyConditions: NoCopy {}

extension CoroVerifyConditions {
    init(facts: &MirInit, local_count: Int) -> CoroVerifyConditions {
        var path_owner = Vector<Int>()
        var path_live = Vector<Bool>()
        var q = 0
        while q < facts.path_count() {
            let l = facts.path_local[q]
            try! path_owner.push(if l < local_count { l } else { -1 })
            try! path_live.push(false)
            q = q + 1
        }
        var live_paths = Vector<Int>()
        var last = Vector<Int>()
        var dirty_mark = Vector<Bool>()
        var l = 0
        while l < local_count {
            try! live_paths.push(0)
            try! last.push(0)
            try! dirty_mark.push(false)
            l = l + 1
        }
        CoroVerifyConditions(path_owner: move path_owner, path_live: move path_live, live_paths: move live_paths,
                             last: move last, dirty: Vector<Int>(), dirty_mark: move dirty_mark)
    }

    // Moves `cur` to block `b`'s entry conditions in `facts`.
    func enter(&var self, facts: &MirInit, cur: &var MirCursor, b: Int) {
        var changed = Vector<Int>()
        cur.load_noting(&facts.states, facts.entry_roots[b], &var changed)
        var k = 0
        while k < changed.len() {
            let q = changed[k]
            k = k + 1
            self.note(q, cur.state[q])
        }
    }

    // Applies each of `accesses` to `cur`, in order: an access changes
    // nothing but the paths inside its own and, for a move, those around it.
    func apply(&var self, facts: &MirInit, cur: &var MirCursor, accesses: &Vector<MirAccess>) {
        var k = 0
        while k < accesses.len() {
            let a = accesses[k]
            k = k + 1
            facts.apply_to(&var cur, &a)
            if a.path < 0 || a.cut || a.kind == MirAccessKind.Read || a.kind == MirAccessKind.Borrow {
                continue
            }
            let inside = facts.subtree(a.path)
            var j = 0
            while j < inside.len() {
                let q = inside[j]
                j = j + 1
                self.note(q, cur.state[q])
            }
            var up = facts.path_parent[a.path]
            while up >= 0 {
                self.note(up, cur.state[up])
                up = facts.path_parent[up]
            }
        }
    }

    // Appends the run of the point `cur` stands at: each local whose
    // conditions differ from the last point recorded with a run.
    func record(&var self, cur: &MirCursor, out: &var Vector<Int>) {
        let at = out.len()
        try! out.push(0)
        var count = 0
        var k = 0
        while k < self.dirty.len() {
            let l = self.dirty[k]
            k = k + 1
            self.dirty_mark[l] = false
            var c = cur.state[l]
            if self.live_paths[l] > 0 {
                c = c | CORO_VERIFY_LIVE
            }
            if c != self.last[l] {
                self.last[l] = c
                try! out.push(l)
                try! out.push(c)
                count = count + 1
            }
        }
        self.dirty.clear()
        out[at] = count
    }

    func note(&var self, q: Int, cond: Int) {
        let l = self.path_owner[q]
        if l < 0 {
            return
        }
        let now = (cond & (MIR_INIT_WHOLE | MIR_INIT_PARTIAL)) != 0
        if now != self.path_live[q] {
            self.path_live[q] = now
            if now {
                self.live_paths[l] = self.live_paths[l] + 1
            } else {
                self.live_paths[l] = self.live_paths[l] - 1
            }
        }
        if not self.dirty_mark[l] {
            self.dirty_mark[l] = true
            try! self.dirty.push(l)
        }
    }
}

// The index of `value` in `values`, or -1; -1 itself is never found.
func coro_verify_find(values: &Vector<Int>, value: Int) -> Int {
    if value < 0 {
        return -1
    }
    var k = 0
    while k < values.len() {
        if values[k] == value {
            return k
        }
        k = k + 1
    }
    return -1
}

// Checks every body the snapshot recorded, as the lowering left it, against
// the five rules, sizing each slot's type for `target`, the target the frames
// were laid out for; each broken one is a problem of `coro`. A sanitizing
// build also gets each lowered frame's poison list, written afresh.
public func coro_verify_lowering(coro: &var CoroProgram, target: &var Target) {
    let context = coro_context_shape(&var coro)
    coro.poisons = Vector<CoroPoison>()
    var k = 0
    while k < coro.before.bodies.len() {
        let body = coro.before.bodies[k]
        k = k + 1
        coro_verify_body(&var coro, &var target, &context, &body)
    }
}

func coro_verify_body(coro: &var CoroProgram, target: &var Target, cx: &CoroContext, b: &CoroBeforeBody) {
    let places = coro_verify_places(&coro, b.body)
    let frame = coro_verify_frame_pointer(&var coro, &var target, &b, &places)
    let idx = coro_verify_index(&coro, &b, frame)
    let slots = coro_verify_residents(&var coro, &b, &idx, frame)
    coro_verify_index_reads(&var coro, &b, &places, &slots)
    if b.framed {
        coro_verify_point_states(&var coro, &b, &idx, &slots)
    }
    coro_verify_drops(&var coro, &b, &idx)
    coro_verify_transfers(&var coro, &var target, &cx, &b, &idx, frame, &slots, &places)
    coro_verify_windows(&var coro, &b, &idx, &slots)
    if b.framed {
        coro_verify_records(&var coro, &cx, &b, &idx)
        let lifetimes = coro_lowered_lifetimes(&var coro, &b, &idx, frame)
        coro_verify_lifetimes(&var coro, &b, &lifetimes)
        if coro.sanitize {
            coro_poison_lists(&var coro, &b, &lifetimes)
        }
    }
}

// What the checks of one body ask of it again and again, of the body as
// lowering left it and of its record from before lowering, each found once,
// so that a check costs the body rather than the body for each element it
// asks about (SL-970).
struct CoroVerifyIndex {
    // By call: the first block of the body that ends in it.
    block_of: Map<Int, Int>
    // By place: how many times the body writes it, as an assignment's place
    // or a call's destination.
    writes: Map<Int, Int>
    // By operand: how many times the body uses it, and the assignment making
    // the last of those uses, or -1 for a terminator's.
    uses: Map<Int, Int>
    use_stmt: Map<Int, Int>
    // By place, call and drop statement of the record: its index there.
    named: Map<Int, Int>
    pre_call: Map<Int, Int>
    drop_at: Map<Int, Int>
    // By the call, or the op-budget statement, of a suspension point of the
    // record: its state.
    call_state: Map<Int, Int>
    stmt_state: Map<Int, Int>
    // By local before lowering: the offset of the frame value holding it, or
    // -1 (`coro_verify_layout_offset`).
    local_offset: Vector<Int>
    // The frame's child slots and offload storages, as indices of its values,
    // in its order.
    children: Vector<Int>
    offloads: Vector<Int>
    // By call of one of the record's suspension points: how many drives come
    // before the first point it makes; `drives`, all of them, for any other.
    drive_nth: Map<Int, Int>
    drives: Int
    // By return edge: the first offload park, in block order, that returns
    // there.
    offload_park: Map<Int, Int>
    // By local lowering added, from the record's local count on: the frame
    // slot step every write of it copies (`coro_verify_index_slot`).
    index_slots: Vector<Int>
    // The body's statements in block order, each with its block; and the
    // places each assignment writes and each rvalue reads, as `place * count
    // + ordinal` for the statement's ordinal there, sorted.
    stmt_at: Vector<Int>
    stmt_block: Vector<Int>
    assigned: Vector<Int>
    reads: Vector<Int>
    // By statement: the block holding it.
    stmt_home: Map<Int, Int>
}

extension CoroVerifyIndex: NoCopy {}

func coro_verify_index(coro: &CoroProgram, b: &CoroBeforeBody, frame: Int) -> CoroVerifyIndex {
    var idx = CoroVerifyIndex(block_of: Map<Int, Int>(), writes: Map<Int, Int>(), uses: Map<Int, Int>(),
                              use_stmt: Map<Int, Int>(), named: Map<Int, Int>(), pre_call: Map<Int, Int>(),
                              drop_at: Map<Int, Int>(), call_state: Map<Int, Int>(), stmt_state: Map<Int, Int>(),
                              local_offset: Vector<Int>(), children: Vector<Int>(), offloads: Vector<Int>(),
                              drive_nth: Map<Int, Int>(), drives: 0, offload_park: Map<Int, Int>(),
                              index_slots: Vector<Int>(), stmt_at: Vector<Int>(), stmt_block: Vector<Int>(),
                              assigned: Vector<Int>(), reads: Vector<Int>(), stmt_home: Map<Int, Int>())
    let f = b.body
    let info = coro.mono.dp.bc.mir.funcs[f]
    // Pairs of a place and a statement's ordinal, encoded once the count of
    // statements is known.
    var assigned = Vector<Int>()
    var reads = Vector<Int>()
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        let here = bb
        bb = bb + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            let ordinal = idx.stmt_at.len()
            try! idx.stmt_at.push(s)
            try! idx.stmt_block.push(here)
            let _ = try! idx.stmt_home.insert(s, here)
            if stmt.kind == MirStmtKind.Assign && stmt.place >= 0 {
                coro_verify_count(&var idx.writes, stmt.place)
                try! assigned.push(stmt.place)
                try! assigned.push(ordinal)
            }
            if stmt.rvalue >= 0 {
                let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
                var named = Vector<Int>()
                if rv.place >= 0 {
                    try! named.push(rv.place)
                }
                var j = 0
                while j < rv.count {
                    let o = coro.mono.dp.bc.mir.lists[rv.first + j]
                    j = j + 1
                    coro_verify_count(&var idx.uses, o)
                    let _ = try! idx.use_stmt.insert(o, s)
                    let read = if o >= 0 { coro.mono.dp.bc.mir.operands[o].place } else { -1 }
                    if read >= 0 && coro_verify_find(&named, read) < 0 {
                        try! named.push(read)
                    }
                }
                j = 0
                while j < named.len() {
                    try! reads.push(named[j])
                    try! reads.push(ordinal)
                    j = j + 1
                }
            }
            s = stmt.next
        }
        if block.term == MirTermKind.Switch && block.operand >= 0 {
            coro_verify_count(&var idx.uses, block.operand)
            let _ = try! idx.use_stmt.insert(block.operand, -1)
        } else if block.term == MirTermKind.Call {
            let call = coro.mono.dp.bc.mir.calls[block.call]
            if not idx.block_of.contains_key(block.call) {
                let _ = try! idx.block_of.insert(block.call, here)
            }
            if call.dest >= 0 {
                coro_verify_count(&var idx.writes, call.dest)
            }
            var j = 0
            while j < call.arg_count {
                let o = coro.mono.dp.bc.mir.lists[call.arg_first + j]
                j = j + 1
                coro_verify_count(&var idx.uses, o)
                let _ = try! idx.use_stmt.insert(o, -1)
            }
            if call.callee >= 0 {
                coro_verify_count(&var idx.uses, call.callee)
                let _ = try! idx.use_stmt.insert(call.callee, -1)
            }
            if coro_verify_park(&coro, block.call) == CoroVerifyPark.Offload && not idx.offload_park.contains_key(call.next) {
                let _ = try! idx.offload_park.insert(call.next, block.call)
            }
        }
    }
    let count = idx.stmt_at.len()
    idx.assigned = coro_verify_encode(&assigned, count)
    idx.reads = coro_verify_encode(&reads, count)
    var k = 0
    while k < b.place_count {
        let p = coro.before.place_ids[b.place_first + k]
        if not idx.named.contains_key(p) {
            let _ = try! idx.named.insert(p, k)
        }
        k = k + 1
    }
    k = 0
    while k < b.call_count {
        let c = coro.before.call_ids[b.call_first + k]
        if not idx.pre_call.contains_key(c) {
            let _ = try! idx.pre_call.insert(c, k)
        }
        k = k + 1
    }
    k = 0
    while k < b.drop_count {
        let s = coro.before.drops[b.drop_first + k]
        if not idx.drop_at.contains_key(s) {
            let _ = try! idx.drop_at.insert(s, k)
        }
        k = k + 1
    }
    k = 0
    while k < b.point_count {
        let point = coro.before.points[b.point_first + k]
        k = k + 1
        if point.call >= 0 && not idx.call_state.contains_key(point.call) {
            let _ = try! idx.call_state.insert(point.call, point.state)
        }
        if point.stmt >= 0 && not idx.stmt_state.contains_key(point.stmt) {
            let _ = try! idx.stmt_state.insert(point.stmt, point.state)
        }
        if point.call >= 0 && not idx.drive_nth.contains_key(point.call) {
            let _ = try! idx.drive_nth.insert(point.call, idx.drives)
        }
        if point.call >= 0 && coro_driven_child(&coro, point.call) >= 0 {
            idx.drives = idx.drives + 1
        }
    }
    var laid = Vector<Bool>()
    var l = 0
    while l < b.local_count {
        try! idx.local_offset.push(-1)
        try! laid.push(false)
        l = l + 1
    }
    // The frame values that hold a local, by offset and type.
    var held = Map<Int, Bool>()
    var types = 0
    let fr = coro_frame_of(&coro, b.item)
    if fr >= 0 {
        let fv = coro.frames[fr]
        k = 0
        while k < fv.value_count {
            let v = coro.values[fv.value_first + k]
            if v.ty >= types {
                types = v.ty + 1
            }
            k = k + 1
        }
        k = 0
        while k < fv.value_count {
            let v = coro.values[fv.value_first + k]
            let at = k
            k = k + 1
            if v.kind == CoroValueKind.Child {
                try! idx.children.push(at)
            } else if v.kind == CoroValueKind.Offload {
                try! idx.offloads.push(at)
            }
            let holds = v.kind != CoroValueKind.Child && v.kind != CoroValueKind.State
            if holds && v.local >= 0 && v.local < b.local_count && not laid[v.local] {
                laid[v.local] = true
                idx.local_offset[v.local] = v.offset
            }
            if holds && v.size > 0 && v.local >= 0 && v.offset >= 0 && v.ty >= 0 {
                let _ = try! held.insert(v.offset * types + v.ty, true)
            }
        }
    }
    let slots = coro_verify_index_slots(&coro, &b, &idx, frame, &held, types)
    idx.index_slots = move slots
    move idx
}

// Adds one to `counts`'s entry for `key`.
func coro_verify_count(counts: &var Map<Int, Int>, key: Int) {
    let had = counts.get(key) ?? 0
    let _ = try! counts.insert(key, had + 1)
}

// The pairs of `pairs`, a place then an ordinal below `count`, each as
// `place * count + ordinal`, sorted.
func coro_verify_encode(pairs: &Vector<Int>, count: Int) -> Vector<Int> {
    var out = Vector<Int>()
    var k = 0
    while k < pairs.len() {
        try! out.push(pairs[k] * count + pairs[k + 1])
        k = k + 2
    }
    out.sort()
    move out
}

// The ordinals `keys` (`coro_verify_encode`) pairs with place `p`, in order.
func coro_verify_ordinals(keys: &Vector<Int>, count: Int, p: Int) -> Vector<Int> {
    var out = Vector<Int>()
    if p < 0 || count == 0 {
        return move out
    }
    var a = 0
    var z = keys.len()
    while a < z {
        let m = (a + z) / 2
        if keys[m] < p * count {
            a = m + 1
        } else {
            z = m
        }
    }
    while a < keys.len() && keys[a] / count == p {
        try! out.push(keys[a] % count)
        a = a + 1
    }
    move out
}

// By local lowering added to body `b`, from its record's local count on, the
// frame slot step every write of it copies through frame pointer `frame`, at
// one offset and type at which the frame lays a local's value, else -1: a
// local whose every write is `_t = copy (*_F).[OFFSET: T]`. `held` holds
// `offset * types + type` for each frame value holding a local.
func coro_verify_index_slots(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, frame: Int,
                             held: &Map<Int, Bool>, types: Int) -> Vector<Int> {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let added = if info.local_count > b.local_count { info.local_count - b.local_count } else { 0 }
    var out = Vector<Int>()
    var spoiled = Vector<Bool>()
    var k = 0
    while k < added {
        try! out.push(-1)
        try! spoiled.push(frame < 0)
        k = k + 1
    }
    if added == 0 || frame < 0 {
        return move out
    }
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        bb = bb + 1
        if block.term == MirTermKind.Call {
            let dest = coro.mono.dp.bc.mir.calls[block.call].dest
            let t = if dest >= 0 { coro.mono.dp.bc.mir.places[dest].local } else { -1 }
            if t >= b.local_count && t < info.local_count {
                spoiled[t - b.local_count] = true
            }
        }
    }
    k = 0
    while k < idx.stmt_at.len() {
        let s = idx.stmt_at[k]
        k = k + 1
        let stmt = coro.mono.dp.bc.mir.stmts[s]
        if stmt.kind != MirStmtKind.Assign || stmt.place < 0 {
            continue
        }
        let t = coro.mono.dp.bc.mir.places[stmt.place].local
        if t < b.local_count || t >= info.local_count || spoiled[t - b.local_count] {
            continue
        }
        let at = t - b.local_count
        let from = coro_verify_copied_slot(&coro, stmt.rvalue, frame)
        var fits = from >= 0
        if fits {
            let slot = coro.mono.dp.bc.mir.projs[from]
            fits = slot.index >= 0 && slot.ty >= 0 && slot.ty < types && held.contains_key(slot.index * types + slot.ty)
            if fits && out[at] >= 0 {
                let first = coro.mono.dp.bc.mir.projs[out[at]]
                fits = first.index == slot.index && first.ty == slot.ty
            }
        }
        if fits {
            if out[at] < 0 {
                out[at] = from
            }
        } else {
            spoiled[at] = true
        }
    }
    k = 0
    while k < added {
        if spoiled[k] {
            out[k] = -1
        }
        k = k + 1
    }
    move out
}

func coro_verify_problem(coro: &var CoroProgram, rule: Int, item: Int, what: String) {
    var msg = StringBuilder()
    try! msg.append("verify rule ")
    try! msg.append(rule)
    if rule == 1 {
        try! msg.append(" (frame in place)")
    } else if rule == 2 {
        try! msg.append(" (teardown by state)")
    } else if rule == 3 {
        try! msg.append(" (windows close once)")
    } else if rule == 4 {
        try! msg.append(" (record before arm)")
    } else {
        try! msg.append(" (lifetimes disjoint)")
    }
    try! msg.append(": `")
    try! msg.append(coro.mono.item_name(item))
    try! msg.append("`: ")
    try! msg.append(what)
    try! coro.problems.push(msg.build())
}

// Every place function `f`'s statements and terminators name, each once, in
// block order.
func coro_verify_places(coro: &CoroProgram, f: Int) -> Vector<Int> {
    var out = Vector<Int>()
    let info = coro.mono.dp.bc.mir.funcs[f]
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        b = b + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            coro_verify_add_place(&var out, stmt.place)
            if stmt.rvalue >= 0 {
                let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
                coro_verify_add_place(&var out, rv.place)
                coro_verify_add_place(&var out, rv.flag)
                coro_verify_add_operands(&coro, &var out, rv.first, rv.count)
            }
        }
        if block.term == MirTermKind.Switch {
            coro_verify_add_operand(&coro, &var out, block.operand)
            coro_verify_add_place(&var out, block.place)
        } else if block.term == MirTermKind.Call {
            let call = coro.mono.dp.bc.mir.calls[block.call]
            coro_verify_add_operands(&coro, &var out, call.arg_first, call.arg_count)
            coro_verify_add_operand(&coro, &var out, call.callee)
            coro_verify_add_place(&var out, call.dest)
        }
    }
    // Each place once, at its first naming, kept by a table rather than a
    // search of the places so far (SL-970).
    var seen = Map<Int, Bool>()
    var once = Vector<Int>()
    var k = 0
    while k < out.len() {
        let p = out[k]
        k = k + 1
        if not seen.contains_key(p) {
            let _ = try! seen.insert(p, true)
            try! once.push(p)
        }
    }
    move once
}

func coro_verify_add_place(out: &var Vector<Int>, p: Int) {
    if p >= 0 {
        try! out.push(p)
    }
}

func coro_verify_add_operand(coro: &CoroProgram, out: &var Vector<Int>, o: Int) {
    if o >= 0 {
        coro_verify_add_place(&var out, coro.mono.dp.bc.mir.operands[o].place)
    }
}

func coro_verify_add_operands(coro: &CoroProgram, out: &var Vector<Int>, first: Int, count: Int) {
    var k = 0
    while k < count {
        let o = coro.mono.dp.bc.mir.lists[first + k]
        coro_verify_add_operand(&coro, &var out, o)
        k = k + 1
    }
}

// Rule 1 over the places of body `b`: a frame slot is only ever the second
// step of its place, right after the dereference of the local pointing at the
// frame, at an offset of at least 0; no place dereferences such a local
// without a slot, which would read, write or move the frame's bytes as a
// whole. A lowered frame's own pointer is the one such local the body never
// writes, which the resume function points at the frame on every entry; it
// is used for nothing but its slots, and each slot's bytes lie inside the
// frame. Returns that local, or -1.
func coro_verify_frame_pointer(coro: &var CoroProgram, target: &var Target, b: &CoroBeforeBody,
                               places: &Vector<Int>) -> Int {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var roots = Vector<Bool>()
    var writes = Vector<Int>()
    var l = 0
    while l < info.local_count {
        try! roots.push(false)
        try! writes.push(0)
        l = l + 1
    }
    var k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        var j = 0
        while j < pl.count {
            let step = coro.mono.dp.bc.mir.projs[pl.first + j]
            if step.kind == MirProjKind.FrameSlot {
                let first = coro.mono.dp.bc.mir.projs[pl.first]
                if j != 1 || first.kind != MirProjKind.Deref || pl.local < 0 || step.index < 0 {
                    var what = StringBuilder()
                    try! what.append("a frame slot stands other than as the second step after the frame pointer's dereference, at a non-negative offset: ")
                    coro.mono.dp.bc.mir.append_place(&var what, p)
                    coro_verify_problem(&var coro, 1, b.item, what.build())
                } else {
                    roots[pl.local] = true
                }
            }
            j = j + 1
        }
    }
    coro_verify_count_writes(&coro, b.body, &var writes)
    var frame = -1
    if b.framed {
        l = 0
        while l < info.local_count {
            if roots[l] && writes[l] == 0 {
                if frame >= 0 {
                    coro_verify_problem(&var coro, 1, b.item, "two locals the body never writes point at frames, so its own frame's pointer is not one local")
                }
                frame = l
            }
            l = l + 1
        }
    }
    let size = coro_verify_frame_size(&coro, b.item)
    k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        if pl.local < 0 || not roots[pl.local] {
            continue
        }
        if pl.count == 0 {
            if pl.local == frame {
                var what = StringBuilder()
                try! what.append("the frame pointer _")
                try! what.append(frame)
                try! what.append(" is used as a value, which repoints or copies the frame's address")
                coro_verify_problem(&var coro, 1, b.item, what.build())
            }
            continue
        }
        let first = coro.mono.dp.bc.mir.projs[pl.first]
        if first.kind != MirProjKind.Deref {
            continue
        }
        if pl.count < 2 || coro.mono.dp.bc.mir.projs[pl.first + 1].kind != MirProjKind.FrameSlot {
            var what = StringBuilder()
            try! what.append("the frame _")
            try! what.append(pl.local)
            try! what.append(" points at is addressed as a whole, not in a slot: ")
            coro.mono.dp.bc.mir.append_place(&var what, p)
            coro_verify_problem(&var coro, 1, b.item, what.build())
            continue
        }
        let slot = coro.mono.dp.bc.mir.projs[pl.first + 1]
        if pl.local == frame && size >= 0 && coro_verify_slot_end(&var coro, &var target, &slot) > size {
            var what = StringBuilder()
            try! what.append("a slot lies past the frame's end, ")
            try! what.append(size)
            try! what.append(" bytes: ")
            coro.mono.dp.bc.mir.append_place(&var what, p)
            coro_verify_problem(&var coro, 1, b.item, what.build())
        }
    }
    frame
}

// How many times function `f` writes each local whole: as an assignment's
// place or a call's destination.
func coro_verify_count_writes(coro: &CoroProgram, f: Int, writes: &var Vector<Int>) {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        b = b + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            if stmt.kind == MirStmtKind.Assign {
                coro_verify_count_write(&coro, &var writes, stmt.place)
            }
        }
        if block.term == MirTermKind.Call {
            let dest = coro.mono.dp.bc.mir.calls[block.call].dest
            coro_verify_count_write(&coro, &var writes, dest)
        }
    }
}

func coro_verify_count_write(coro: &CoroProgram, writes: &var Vector<Int>, p: Int) {
    if p < 0 {
        return
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.count == 0 && pl.local >= 0 && pl.local < writes.len() {
        writes[pl.local] += 1
    }
}

// Where frame slot `slot`'s bytes end: its offset plus its type's size. A
// zero-size value occupies no byte, so its slot may sit at the frame's end,
// or at the offset of the value after it.
func coro_verify_slot_end(coro: &var CoroProgram, target: &var Target, slot: &MirProj) -> Int {
    slot.index + target.layout(&var coro.mono.dp.bc.mir.tc, slot.ty).size
}

// Item `item`'s frame size, by its layout, or -1.
func coro_verify_frame_size(coro: &CoroProgram, item: Int) -> Int {
    let fr = coro_frame_of(&coro, item)
    if fr < 0 {
        return -1
    }
    coro.frames[fr].size
}

// Rule 1 over the places body `b` named before lowering: each is either as
// it was, or, for a frame value of a lowered frame, its slot through frame
// pointer `frame` followed by its own steps, `(*_F).[OFFSET: T]...`, at one
// offset for all of the local's places, the one its frame's layout gives it.
// A local reached both ways would have two storages; the result and the
// parameters, which the caller reaches in the frame, are never left on the
// stack. Returns, by local before lowering, its slot's offset or -1.
func coro_verify_residents(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, frame: Int) -> Vector<Int> {
    var slots = Vector<Int>()
    var stack = Vector<Bool>()
    var l = 0
    while l < b.local_count {
        try! slots.push(-1)
        try! stack.push(false)
        l = l + 1
    }
    var k = 0
    while k < b.place_count {
        let p = coro.before.place_ids[b.place_first + k]
        let pre = coro.before.places[b.place_first + k]
        k = k + 1
        let post = coro.mono.dp.bc.mir.places[p]
        if coro_verify_same_place(&coro, &b, &idx, frame, &pre, &post) {
            if pre.local >= 0 && pre.local < b.local_count {
                stack[pre.local] = true
            }
            continue
        }
        let offset = coro_verify_slot_of(&coro, &b, &idx, &pre, &post, frame)
        if pre.local < 0 || pre.local >= b.local_count || offset < 0 {
            var what = StringBuilder()
            try! what.append("a place the body names is rewritten into something other than its local's frame slot: ")
            coro.mono.dp.bc.mir.append_place(&var what, p)
            coro_verify_problem(&var coro, 1, b.item, what.build())
            continue
        }
        let had = slots[pre.local]
        if had >= 0 && had != offset {
            var what = StringBuilder()
            try! what.append("_")
            try! what.append(pre.local)
            try! what.append(" is reached at two slots, (*frame).[")
            try! what.append(had)
            try! what.append("] and (*frame).[")
            try! what.append(offset)
            try! what.append("]")
            coro_verify_problem(&var coro, 1, b.item, what.build())
        }
        slots[pre.local] = offset
    }
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    // The result and every parameter live in a lowered frame whether or not
    // the body names them, since the caller reaches them there; one the body
    // never names has no place to show its slot, so its layout's stands.
    if b.framed {
        l = 0
        while l <= info.param_count && l < b.local_count {
            if slots[l] < 0 && not stack[l] {
                slots[l] = coro_verify_layout_offset(&idx, l)
            }
            l = l + 1
        }
    }
    l = 0
    while l < b.local_count {
        let local = l
        l = l + 1
        if slots[local] >= 0 && stack[local] {
            var what = StringBuilder()
            try! what.append("_")
            try! what.append(local)
            try! what.append(" is reached both in its slot (*frame).[")
            try! what.append(slots[local])
            try! what.append("] and on the resume function's stack")
            coro_verify_problem(&var coro, 1, b.item, what.build())
        }
        if b.framed && stack[local] && local <= info.param_count {
            var what = StringBuilder()
            if local == 0 {
                try! what.append("the result _0 stays on the resume function's stack, where its caller cannot read it")
            } else {
                try! what.append("parameter _")
                try! what.append(local)
                try! what.append(" stays on the resume function's stack, where its caller cannot write it")
            }
            coro_verify_problem(&var coro, 1, b.item, what.build())
        }
        if slots[local] >= 0 {
            let laid = coro_verify_layout_offset(&idx, local)
            if laid != slots[local] {
                var what = StringBuilder()
                try! what.append("_")
                try! what.append(local)
                try! what.append(" is reached at (*frame).[")
                try! what.append(slots[local])
                if laid < 0 {
                    try! what.append("], but its frame's layout holds no value for it")
                } else {
                    try! what.append("], but its frame's layout puts it at (*frame).[")
                    try! what.append(laid)
                    try! what.append("]")
                }
                coro_verify_problem(&var coro, 1, b.item, what.build())
            }
        }
    }
    move slots
}

// Whether places `pre` and `post` of body `body` are the same: one root and
// equal steps, an index by a frame value's local and one by its index
// temporary counting as equal.
func coro_verify_same_place(coro: &CoroProgram, body: &CoroBeforeBody, idx: &CoroVerifyIndex, frame: Int,
                            pre: &MirPlace, post: &MirPlace) -> Bool {
    if pre.local != post.local || pre.static_decl != post.static_decl || pre.count != post.count || pre.ty != post.ty {
        return false
    }
    coro_verify_same_steps(&coro, &body, &idx, frame, pre.first, post.first, pre.count)
}

// Whether the `count` steps from `a`, as body `body` named them, and from
// `b`, as lowering left them, are equal. An index by local `_x` may become an
// index by a temporary lowering added that only ever copies `_x`'s frame
// slot (`coro_verify_index_copies`), since a projection cannot name a slot.
func coro_verify_same_steps(coro: &CoroProgram, body: &CoroBeforeBody, idx: &CoroVerifyIndex, frame: Int, a: Int,
                            b: Int, count: Int) -> Bool {
    var j = 0
    while j < count {
        let x = coro.mono.dp.bc.mir.projs[a + j]
        let y = coro.mono.dp.bc.mir.projs[b + j]
        j = j + 1
        if x.kind != y.kind || x.decl != y.decl || x.ty != y.ty {
            return false
        }
        if x.index != y.index {
            let loaded = x.kind == MirProjKind.Index && coro_verify_index_copies(&coro, &body, &idx, y.index, x.index)
            if not loaded {
                return false
            }
        }
    }
    true
}

// Whether local `t` is a temporary lowering added that only ever copies the
// frame slot of local `l` of body `b`: the slot its frame's layout gives `l`,
// of `l`'s type. Locals whose lifetimes never meet may share an offset, so
// the slot is matched against `l`'s own, never mapped back to a local.
func coro_verify_index_copies(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, t: Int, l: Int) -> Bool {
    let s = coro_verify_index_slot(&b, &idx, t)
    if s < 0 || l < 0 || l >= b.local_count {
        return false
    }
    let slot = coro.mono.dp.bc.mir.projs[s]
    let ty = coro.mono.dp.bc.mir.locals[coro.mono.dp.bc.mir.funcs[b.body].local_first + l].ty
    slot.index == coro_verify_layout_offset(&idx, l) && slot.ty == ty
}

// The frame slot step every write of local `t` copies, when `t` is a local
// lowering added to body `b` whose every write is `_t = copy (*_F).[OFFSET:
// T]` through its frame pointer, at one offset and type at which its frame
// lays a local's value; else -1 (`coro_verify_index_slots`).
func coro_verify_index_slot(b: &CoroBeforeBody, idx: &CoroVerifyIndex, t: Int) -> Int {
    if t < b.local_count || t - b.local_count >= idx.index_slots.len() {
        return -1
    }
    idx.index_slots[t - b.local_count]
}

// The frame slot step of the place rvalue `rv` copies whole, `copy
// (*_F).[OFFSET: T]` through `frame`, or -1.
func coro_verify_copied_slot(coro: &CoroProgram, rv: Int, frame: Int) -> Int {
    if rv < 0 {
        return -1
    }
    let r = coro.mono.dp.bc.mir.rvalues[rv]
    if r.kind != MirRvalueKind.Use || r.count != 1 {
        return -1
    }
    let o = coro.mono.dp.bc.mir.operands[coro.mono.dp.bc.mir.lists[r.first]]
    if o.kind != MirOperandKind.Copy || coro_verify_slot_offset(&coro, o.place, frame) < 0 {
        return -1
    }
    coro.mono.dp.bc.mir.places[o.place].first + 1
}

// The offset of the slot `post` reaches local `pre.local`'s value at, when
// `post` is `pre` rewritten into it through frame pointer `frame`: the
// dereference, a slot of the local's type, then `pre`'s own steps; else -1.
func coro_verify_slot_of(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, pre: &MirPlace,
                         post: &MirPlace, frame: Int) -> Int {
    let f = b.body
    if frame < 0 || pre.local < 0 || post.local != frame || post.count != pre.count + 2 || post.ty != pre.ty {
        return -1
    }
    let deref = coro.mono.dp.bc.mir.projs[post.first]
    let slot = coro.mono.dp.bc.mir.projs[post.first + 1]
    if deref.kind != MirProjKind.Deref || slot.kind != MirProjKind.FrameSlot || slot.index < 0 {
        return -1
    }
    let info = coro.mono.dp.bc.mir.funcs[f]
    if slot.ty != coro.mono.dp.bc.mir.locals[info.local_first + pre.local].ty {
        return -1
    }
    if not coro_verify_same_steps(&coro, &b, &idx, frame, pre.first, post.first + 2, pre.count) {
        return -1
    }
    slot.index
}

// The offset the body's frame layout gives the value of local `l`: its
// result, a parameter or a resident local; -1 when it holds none.
func coro_verify_layout_offset(idx: &CoroVerifyIndex, l: Int) -> Int {
    if l < 0 || l >= idx.local_offset.len() {
        return -1
    }
    idx.local_offset[l]
}

// Rule 1: no index projection reads a frame value's local on the stack, where
// it no longer is.
func coro_verify_index_reads(coro: &var CoroProgram, b: &CoroBeforeBody, places: &Vector<Int>, slots: &Vector<Int>) {
    var k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        var j = 0
        while j < pl.count {
            let step = coro.mono.dp.bc.mir.projs[pl.first + j]
            j = j + 1
            if step.kind == MirProjKind.Index && step.index >= 0 && step.index < slots.len() && slots[step.index] >= 0 {
                var what = StringBuilder()
                try! what.append("an index reads _")
                try! what.append(step.index)
                try! what.append(" on the stack, though its value lives in the frame: ")
                coro.mono.dp.bc.mir.append_place(&var what, p)
                coro_verify_problem(&var coro, 1, b.item, what.build())
            }
        }
    }
}

// Rule 2 at each suspension state of lowered frame `b`: the conditions of
// each local, recomputed over the lowered body read with every place as it
// was before lowering, equal the ones before lowering, and a local that may
// be initialised there lives in the frame, since a suspension loses the
// resume function's stack. A point is matched by its call, or an op-budget
// point by the ready park its block's test of the counter yields at; an
// effect-only suspension, `__saw_test_suspend`, is the one that lowering
// removes.
func coro_verify_point_states(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, slots: &Vector<Int>) {
    var calls = Vector<Int>()
    var stmts = Vector<Int>()
    var blocks = Vector<Int>()
    var k = 0
    while k < b.point_count {
        let point = coro.before.points[b.point_first + k]
        k = k + 1
        var call = point.call
        if call >= 0 && not coro_verify_ends_block(&idx, call) {
            if not coro_verify_effect_only(&coro, call) {
                var what = StringBuilder()
                try! what.append("state ")
                try! what.append(point.state)
                try! what.append("'s suspension, the call that ended bb")
                try! what.append(point.block)
                try! what.append(", is gone from the lowered body")
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
            call = -1
        }
        if point.stmt >= 0 {
            call = coro_verify_budget_yield(&coro, b.body, point.block)
            if call < 0 {
                var what = StringBuilder()
                try! what.append("state ")
                try! what.append(point.state)
                try! what.append("'s op-budget point in bb")
                try! what.append(point.block)
                try! what.append(" does not end its block in a test whose true edge parks ready")
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
        }
        try! calls.push(call)
        try! stmts.push(-1)
        try! blocks.push(if call >= 0 { idx.block_of.get(call) ?? -1 } else { -1 })
    }
    let saved = coro_verify_restore(&var coro, &b)
    let after = coro_verify_condition_runs(&coro, b.body, &calls, &stmts, &blocks, b.local_count)
    coro_verify_put_back(&var coro, &b, &saved)
    // Each local's conditions before and after lowering at the last point
    // with a run of each; the frame values whose two differ, and the stack
    // locals the record leaves maybe initialised. A point then costs its own
    // changes and the problems it reports, not every local.
    var was = Vector<Int>()
    var now = Vector<Int>()
    var resident = Vector<Int>()
    var l = 0
    while l < b.local_count {
        try! was.push(0)
        try! now.push(0)
        if slots[l] >= 0 {
            try! resident.push(l)
        }
        l = l + 1
    }
    var differ = CoroVerifySet(count: b.local_count)
    var stacked = CoroVerifySet(count: b.local_count)
    var a = 0
    k = 0
    while k < b.point_count {
        let point = coro.before.points[b.point_first + k]
        let j = k
        k = k + 1
        let from = point.conditions_first
        let before = coro.before.conditions[from]
        var i = 0
        while i < before {
            let local = coro.before.conditions[from + 1 + 2 * i]
            was[local] = coro.before.conditions[from + 2 + 2 * i]
            coro_verify_compare(&was, &now, &slots, local, &var differ, &var stacked)
            i = i + 1
        }
        let changes = after[a]
        i = 0
        while i < changes {
            let local = after[a + 1 + 2 * i]
            now[local] = after[a + 2 + 2 * i]
            coro_verify_compare(&was, &now, &slots, local, &var differ, &var stacked)
            i = i + 1
        }
        let length = if changes < 0 { 1 } else { 1 + 2 * changes }
        a = a + length
        if calls[j] < 0 && stmts[j] < 0 {
            continue
        }
        // A point no path reaches reads 0 for every local, so only the frame
        // values can differ there, and no local may be initialised.
        var reported = Vector<Int>()
        if before >= 0 {
            stacked.append_to(&var reported)
        }
        if before >= 0 && changes >= 0 {
            differ.append_to(&var reported)
        } else if before >= 0 || changes >= 0 {
            i = 0
            while i < resident.len() {
                let local = resident[i]
                i = i + 1
                let x = if before >= 0 { was[local] } else { 0 }
                let y = if changes >= 0 { now[local] } else { 0 }
                if x != y {
                    try! reported.push(local)
                }
            }
        }
        reported.sort()
        i = 0
        while i < reported.len() {
            let local = reported[i]
            i = i + 1
            let x = if before >= 0 { was[local] } else { 0 }
            let y = if changes >= 0 { now[local] } else { 0 }
            if slots[local] < 0 {
                var what = StringBuilder()
                try! what.append("_")
                try! what.append(local)
                try! what.append(" may be initialised at state ")
                try! what.append(point.state)
                try! what.append(" (bb")
                try! what.append(point.block)
                try! what.append("), but lives on the resume function's stack, which the suspension loses")
                coro_verify_problem(&var coro, 2, b.item, what.build())
            } else {
                var what = StringBuilder()
                try! what.append("frame value _")
                try! what.append(local)
                try! what.append(" at state ")
                try! what.append(point.state)
                try! what.append(" (bb")
                try! what.append(point.block)
                try! what.append(") is ")
                coro_verify_append_conditions(&var what, y)
                try! what.append(" after lowering, where the body before it leaves it ")
                coro_verify_append_conditions(&var what, x)
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
        }
    }
}

// Files local `l` by its conditions before lowering, `was`, and after it,
// `now`: a frame value (`slots`) in `differ` when the two differ, a stack
// local in `stacked` when the record leaves it maybe initialised.
func coro_verify_compare(was: &Vector<Int>, now: &Vector<Int>, slots: &Vector<Int>, l: Int,
                         differ: &var CoroVerifySet, stacked: &var CoroVerifySet) {
    if slots[l] >= 0 {
        differ.put(l, was[l] != now[l])
    } else {
        stacked.put(l, (was[l] & CORO_VERIFY_LIVE) != 0)
    }
}

// A set of the integers below a count, each added and removed in constant
// time, its members in no order.
struct CoroVerifySet {
    members: Vector<Int>
    at: Vector<Int>
}

extension CoroVerifySet: NoCopy {}

extension CoroVerifySet {
    init(count: Int) -> CoroVerifySet {
        var at = Vector<Int>()
        var k = 0
        while k < count {
            try! at.push(-1)
            k = k + 1
        }
        CoroVerifySet(members: Vector<Int>(), at: move at)
    }

    // Makes `x` a member when `member` says so, and not one otherwise.
    func put(&var self, x: Int, member: Bool) {
        let here = self.at[x]
        if member && here < 0 {
            self.at[x] = self.members.len()
            try! self.members.push(x)
        } else if not member && here >= 0 {
            let last = self.members.len() - 1
            let moved = self.members[last]
            self.members[here] = moved
            self.at[moved] = here
            let _ = self.members.pop()
            self.at[x] = -1
        }
    }

    func append_to(&self, out: &var Vector<Int>) {
        var k = 0
        while k < self.members.len() {
            try! out.push(self.members[k])
            k = k + 1
        }
    }
}

func coro_verify_append_conditions(out: &var StringBuilder, bits: Int) {
    var any = false
    if (bits & MIR_INIT_UNASSIGNED) != 0 {
        coro_verify_append_word(&var out, &var any, "unassigned")
    }
    if (bits & MIR_INIT_WHOLE) != 0 {
        coro_verify_append_word(&var out, &var any, "whole")
    }
    if (bits & MIR_INIT_PARTIAL) != 0 {
        coro_verify_append_word(&var out, &var any, "partial")
    }
    if (bits & MIR_INIT_MOVED) != 0 {
        coro_verify_append_word(&var out, &var any, "moved")
    }
    if (bits & MIR_INIT_DROPPED) != 0 {
        coro_verify_append_word(&var out, &var any, "dropped")
    }
    if not any {
        try! out.append("unreached")
    }
    if (bits & CORO_VERIFY_LIVE) != 0 {
        try! out.append(" (maybe initialised)")
    }
}

func coro_verify_append_word(out: &var StringBuilder, any: &var Bool, word: String) {
    if any {
        try! out.append("|")
    }
    try! out.append(word)
    any = true
}

// Whether call `c` ends a block of the body `idx` indexes.
func coro_verify_ends_block(idx: &CoroVerifyIndex, c: Int) -> Bool {
    idx.block_of.contains_key(c)
}

// The first block of the body `idx` indexes that call `c` ends, or -1.
func coro_verify_block_of_call(idx: &CoroVerifyIndex, c: Int) -> Int {
    idx.block_of.get(c) ?? -1
}

// The ready park an op-budget point of block `bb` of function `f` yields at:
// the call ending the block its `Bool` switch's true edge reaches, or -1.
func coro_verify_budget_yield(coro: &CoroProgram, f: Int, bb: Int) -> Int {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
    if block.term != MirTermKind.Switch || block.switch_kind != MirSwitchKind.Bool {
        return -1
    }
    var j = 0
    while j < block.arm_count {
        let arm = coro.mono.dp.bc.mir.arms[block.arm_first + j]
        j = j + 1
        if arm.value == 1 {
            let c = coro_verify_park_at(&coro, f, arm.target)
            if c >= 0 && coro_verify_park(&coro, c) == CoroVerifyPark.Ready {
                return c
            }
        }
    }
    return -1
}

// Whether call `c` is the effect-only test intrinsic `__saw_test_suspend`.
func coro_verify_effect_only(coro: &CoroProgram, c: Int) -> Bool {
    coro_verify_builtin(&coro, c, "__saw_test_suspend")
}

func coro_verify_builtin(coro: &CoroProgram, c: Int, name: String) -> Bool {
    let info = coro.mono.dp.bc.mir.calls[c]
    if info.kind != MirCallKind.Builtin || info.spelling < 0 {
        return false
    }
    let text = coro.mono.dp.bc.mir.tc.name_text(info.spelling)
    text.equals(name)
}

// Puts every place body `b` named back as it was before lowering, and returns
// what lowering had made of each, for `coro_verify_put_back`. Read so, the
// lowered body is the source's again, but for what lowering added.
func coro_verify_restore(coro: &var CoroProgram, b: &CoroBeforeBody) -> Vector<MirPlace> {
    var saved = Vector<MirPlace>()
    var k = 0
    while k < b.place_count {
        let p = coro.before.place_ids[b.place_first + k]
        let pre = coro.before.places[b.place_first + k]
        k = k + 1
        let post = coro.mono.dp.bc.mir.places[p]
        try! saved.push(post)
        coro.mono.dp.bc.mir.places[p] = pre
    }
    move saved
}

func coro_verify_put_back(coro: &var CoroProgram, b: &CoroBeforeBody, saved: &Vector<MirPlace>) {
    var k = 0
    while k < b.place_count {
        let p = coro.before.place_ids[b.place_first + k]
        coro.mono.dp.bc.mir.places[p] = saved[k]
        k = k + 1
    }
}

// Rule 2: the lowered body's drops are exactly drop elaboration's, each once,
// in the block it was placed in.
func coro_verify_drops(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var seen = Vector<Int>()
    var k = 0
    while k < b.drop_count {
        try! seen.push(0)
        k = k + 1
    }
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        let here = bb
        bb = bb + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            if stmt.kind == MirStmtKind.Drop {
                let j = idx.drop_at.get(s) ?? -1
                if j < 0 {
                    var what = StringBuilder()
                    try! what.append("bb")
                    try! what.append(here)
                    try! what.append(" drops ")
                    coro.mono.dp.bc.mir.append_place(&var what, stmt.place)
                    try! what.append(", which drop elaboration did not place")
                    coro_verify_problem(&var coro, 2, b.item, what.build())
                } else {
                    seen[j] += 1
                    let placed = coro.before.drop_blocks[b.drop_first + j]
                    if placed != here {
                        var what = StringBuilder()
                        try! what.append("the drop of ")
                        coro.mono.dp.bc.mir.append_place(&var what, stmt.place)
                        try! what.append(" moved from bb")
                        try! what.append(placed)
                        try! what.append(" to bb")
                        try! what.append(here)
                        coro_verify_problem(&var coro, 2, b.item, what.build())
                    }
                }
            }
            s = stmt.next
        }
    }
    k = 0
    while k < b.drop_count {
        if seen[k] != 1 {
            let s = coro.before.drops[b.drop_first + k]
            let place = coro.mono.dp.bc.mir.stmts[s].place
            var what = StringBuilder()
            try! what.append("drop elaboration's drop of ")
            coro.mono.dp.bc.mir.append_place(&var what, place)
            try! what.append(" in bb")
            try! what.append(coro.before.drop_blocks[b.drop_first + k])
            if seen[k] == 0 {
                try! what.append(" is gone from the lowered body")
            } else {
                try! what.append(" runs ")
                try! what.append(seen[k])
                try! what.append(" times in the lowered body")
            }
            coro_verify_problem(&var coro, 2, b.item, what.build())
        }
        k = k + 1
    }
}

// Rule 2 over the calls lowering rewrote in body `b`: only a child's drive,
// a park, a spawn site and a drive site lose their arguments or destination,
// and then all of them, and an offload's start its destination alone
// (`coro_verify_offload`); each operand the call passed is used exactly once
// after lowering, so lowering adds no transfer and loses none. A drive or a
// site writes each into its parameter's slot, a drive in its own block, which
// its state re-enters past. A drive's result is moved out of the child's
// result slot once, on its return edge, into the call's destination; nothing
// else reaches into a child's frame, and no place lowering adds reaches a
// frame value of the body's own. A call gone from the body is an effect-only
// suspension, or a read of the cancel word whose destination one read of the
// word through the task's context writes.
func coro_verify_transfers(coro: &var CoroProgram, target: &var Target, cx: &CoroContext, b: &CoroBeforeBody,
                           idx: &CoroVerifyIndex, frame: Int, slots: &Vector<Int>, places: &Vector<Int>) {
    // The places a drive may reach its child's frame through, and each
    // child's region of the frame.
    var allowed = Vector<Int>()
    var region_start = Vector<Int>()
    var region_end = Vector<Int>()
    var region_child = Vector<Int>()
    var k = 0
    while k < b.call_count {
        let c = coro.before.call_ids[b.call_first + k]
        let pre = coro.before.calls[b.call_first + k]
        k = k + 1
        let post = coro.mono.dp.bc.mir.calls[c]
        if not coro_verify_ends_block(&idx, c) {
            coro_verify_gone_call(&var coro, &cx, &b, &idx, c, &pre)
            continue
        }
        if coro_verify_same_args(&coro, &pre, &post) && pre.dest == post.dest {
            continue
        }
        let offloaded = if b.framed { coro_offloaded_extern(&coro, c) } else { -1 }
        if offloaded >= 0 {
            coro_verify_offload(&var coro, &cx, &b, &idx, c, &pre, offloaded)
            continue
        }
        let child = if b.framed { coro_driven_child(&coro, c) } else { -1 }
        let drive = child >= 0 && coro_call_suspends(&coro, c)
        let park = coro_verify_park(&coro, c) != CoroVerifyPark.NotAPark
        let site = pre.kind == MirCallKind.Spawn || pre.kind == MirCallKind.Drive
        if not drive && not park && not site {
            var what = StringBuilder()
            try! what.append("a call lost its arguments or destination, and it is no drive, park, spawn or drive site: ")
            coro_verify_append_callee(&coro, &var what, c)
            coro_verify_problem(&var coro, 2, b.item, what.build())
            continue
        }
        if post.arg_count != 0 {
            var what = StringBuilder()
            try! what.append("a rewritten call still passes arguments: ")
            coro_verify_append_callee(&coro, &var what, c)
            coro_verify_problem(&var coro, 2, b.item, what.build())
        }
        var base = -1
        var root = -1
        if drive {
            base = coro_verify_child_slot(&coro, &b, &idx, c)
            root = child
        } else if site {
            base = 0
            root = coro.mono.call_item(c)
        }
        let rf = coro_frame_of(&coro, root)
        // A group site's group reference becomes the group's pointer, not a
        // parameter.
        let leading = mir_spawn_leading(&pre)
        var j = 0
        while j < pre.arg_count {
            let o = coro.mono.dp.bc.mir.lists[pre.arg_first + j]
            j = j + 1
            let at = coro_verify_single_use(&var coro, &b, &idx, o, c)
            if at < 0 || base < 0 || rf < 0 || j <= leading {
                continue
            }
            let rframe = coro.frames[rf]
            let want = base + coro_child_offset(&coro, &rframe, CoroValueKind.Param, j - leading)
            let stmt = coro.mono.dp.bc.mir.stmts[at]
            var through = -1
            if drive {
                through = frame
            }
            let into = coro_verify_slot_offset(&coro, stmt.place, through)
            var placed = stmt.kind == MirStmtKind.Assign && into == want
            if placed && drive {
                let home = coro_verify_block_of_call(&idx, c)
                placed = home >= 0 && (idx.stmt_home.get(at) ?? -1) == home
                if placed {
                    try! allowed.push(stmt.place)
                }
            }
            if not placed {
                var what = StringBuilder()
                try! what.append("argument ")
                try! what.append(j - leading)
                try! what.append(" of ")
                coro_verify_append_callee(&coro, &var what, c)
                if drive {
                    try! what.append(" is not written into its parameter's slot, (*frame).[")
                } else {
                    try! what.append(" is not written into its task root's parameter slot, (*frame).[")
                }
                try! what.append(want)
                if drive {
                    try! what.append("], in the drive's own block, which its state re-enters past")
                } else {
                    try! what.append("]")
                }
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
        }
        if drive && rf >= 0 {
            let rframe = coro.frames[rf]
            try! region_start.push(base)
            try! region_end.push(base + rframe.size)
            try! region_child.push(child)
            let result = base + coro_child_offset(&coro, &rframe, CoroValueKind.Result, 0)
            coro_verify_move_out(&var coro, &b, c, &pre, frame, result, &var allowed)
        } else if site && pre.dest >= 0 && pre.next >= 0 {
            let written = coro_verify_writes_of(&idx, pre.dest)
            if written != 1 {
                var what = StringBuilder()
                try! what.append("the destination of ")
                coro_verify_append_callee(&coro, &var what, c)
                try! what.append(" is written ")
                try! what.append(written)
                try! what.append(" times after lowering, not once")
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
        }
    }
    coro_verify_regions(&var coro, &var target, &b, &idx, frame, &slots, &places, &allowed, &region_start,
                        &region_end, &region_child)
}

// Offloaded call `c` of `blocking` extern item `ext` in lowered frame `b`, as
// `pre` was before lowering: the start keeps its arguments, each used there
// alone, and loses its destination; it continues to its job's completion
// check, whose result alone, never the cancel word, is tested, and whose true
// edge reaches the take, a call of the same extern with no arguments that
// writes the destination, the only write of it, and goes where the call
// returned. So the offload moves no value and loses none, and only a
// finished job, cancelled task or not, is taken.
func coro_verify_offload(coro: &var CoroProgram, cx: &CoroContext, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                         c: Int, pre: &MirCall, ext: Int) {
    let post = coro.mono.dp.bc.mir.calls[c]
    if not coro_verify_same_args(&coro, &pre, &post) || post.dest >= 0 {
        var what = StringBuilder()
        try! what.append("the offload's start, ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(", does not keep its arguments and lose its destination")
        coro_verify_problem(&var coro, 2, b.item, what.build())
        return
    }
    var j = 0
    while j < pre.arg_count {
        let o = coro.mono.dp.bc.mir.lists[pre.arg_first + j]
        j = j + 1
        let _at = coro_verify_single_use(&var coro, &b, &idx, o, c)
    }
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var take = -1
    var check_call = -1
    if post.next >= 0 && post.next < info.block_count {
        let checking = coro.mono.dp.bc.mir.blocks[info.block_first + post.next]
        if checking.term == MirTermKind.Call && coro.mono.call_item(checking.call) == coro_offload_done_item(&coro) {
            check_call = checking.call
        }
    }
    if check_call >= 0 {
        let check = coro.mono.dp.bc.mir.calls[check_call]
        if check.next >= 0 && check.next < info.block_count && check.dest >= 0 {
            let test = coro.mono.dp.bc.mir.blocks[info.block_first + check.next]
            if test.term == MirTermKind.Switch && test.switch_kind == MirSwitchKind.Bool && test.operand >= 0 {
                let tested = coro.mono.dp.bc.mir.operands[test.operand].place
                let done = coro.mono.dp.bc.mir.places[check.dest].local
                var k = 0
                while k < test.arm_count {
                    let arm = coro.mono.dp.bc.mir.arms[test.arm_first + k]
                    k = k + 1
                    if arm.value == 1 {
                        take = arm.target
                    }
                }
                if tested < 0 || coro.mono.dp.bc.mir.places[tested].local != done || coro_verify_tests_cancel(&coro, &cx, &test) {
                    take = -1
                }
            }
        }
    }
    var taken = take >= 0
    if taken {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + take]
        taken = block.term == MirTermKind.Call
        if taken {
            let t = coro.mono.dp.bc.mir.calls[block.call]
            taken = block.call != c && coro.mono.call_item(block.call) == ext && t.arg_count == 0 && t.dest == pre.dest && t.next == pre.next
        }
    }
    if taken && pre.dest >= 0 {
        taken = coro_verify_writes_of(&idx, pre.dest) == 1
    }
    if not taken {
        var what = StringBuilder()
        try! what.append("the offload of ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" does not go to its job's completion check, tested alone, whose true edge takes the job into its destination, its one write, and returns where the call returned")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
}

// Whether `block`, a `Bool` switch, tests a local whose last write in the
// block is a copy of the cancel word through the task's context.
func coro_verify_tests_cancel(coro: &CoroProgram, cx: &CoroContext, block: &MirBlock) -> Bool {
    if block.operand < 0 {
        return false
    }
    let tested = coro.mono.dp.bc.mir.operands[block.operand].place
    if tested < 0 {
        return false
    }
    let local = coro.mono.dp.bc.mir.places[tested].local
    var read = false
    var s = block.first
    while s >= 0 {
        let here = s
        let stmt = coro.mono.dp.bc.mir.stmts[here]
        s = stmt.next
        if stmt.kind != MirStmtKind.Assign || stmt.place < 0 || coro.mono.dp.bc.mir.places[stmt.place].local != local {
            continue
        }
        let o = coro_verify_record_operand(&coro, here)
        read = o >= 0 && coro.mono.dp.bc.mir.operands[o].kind == MirOperandKind.Copy
        if read {
            // Stage 0 workaround (SL:hazards S4): canonical: read = coro_verify_is_cancel(&coro, &cx, coro.mono.dp.bc.mir.operands[o].place)
            let source = coro.mono.dp.bc.mir.operands[o].place
            read = coro_verify_is_cancel(&coro, &cx, source)
        }
    }
    read
}

// Call `c` of body `b`, as `pre` was before lowering, ends no block after it:
// it is an effect-only suspension, which runs as nothing, or a read of the
// cancel word in a lowered frame, whose destination exactly one statement
// writes, with a copy of the word through the task's context, in a block that
// goes where the call returned.
func coro_verify_gone_call(coro: &var CoroProgram, cx: &CoroContext, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int,
                           pre: &MirCall) {
    if coro_verify_effect_only(&coro, c) {
        return
    }
    if not b.framed || not coro_cancel_read(&coro, c) {
        var what = StringBuilder()
        try! what.append("a call is gone from the lowered body, and it is no effect-only suspension or read of the cancel word: ")
        coro_verify_append_callee(&coro, &var what, c)
        coro_verify_problem(&var coro, 2, b.item, what.build())
        return
    }
    if pre.dest < 0 {
        return
    }
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var reads = 0
    var writes = 0
    let assignments = coro_verify_ordinals(&idx.assigned, idx.stmt_at.len(), pre.dest)
    var k = 0
    while k < assignments.len() {
        let here = idx.stmt_at[assignments[k]]
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + idx.stmt_block[assignments[k]]]
        k = k + 1
        let stmt = coro.mono.dp.bc.mir.stmts[here]
        writes = writes + 1
        let o = coro_verify_record_operand(&coro, here)
        let read = o >= 0 && coro.mono.dp.bc.mir.operands[o].kind == MirOperandKind.Copy
        let returns = (block.term == MirTermKind.Goto && block.target == pre.next) || (block.term == MirTermKind.Unreachable && pre.next < 0)
        // Stage 0 workaround (SL:hazards S4): canonical: if read && returns && stmt.next < 0 && coro_verify_is_cancel(&coro, &cx, coro.mono.dp.bc.mir.operands[o].place) {
        let source = if o >= 0 { coro.mono.dp.bc.mir.operands[o].place } else { -1 }
        if read && returns && stmt.next < 0 && coro_verify_is_cancel(&coro, &cx, source) {
            reads = reads + 1
        }
    }
    if reads != 1 || writes != 1 {
        var what = StringBuilder()
        try! what.append("the read of the cancel word by ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" is not one copy of the word through the task's context into its destination, last in a block going where the call returned")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
}

// Whether place `p` is the cancel word through the task's context,
// `(*(*_C).cancel)`.
func coro_verify_is_cancel(coro: &CoroProgram, cx: &CoroContext, p: Int) -> Bool {
    if p < 0 || cx.cancel < 0 {
        return false
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.local < 0 || pl.count != 3 {
        return false
    }
    let a = coro.mono.dp.bc.mir.projs[pl.first]
    let field = coro.mono.dp.bc.mir.projs[pl.first + 1]
    let d = coro.mono.dp.bc.mir.projs[pl.first + 2]
    let through = a.kind == MirProjKind.Deref && a.ty == cx.ty && d.kind == MirProjKind.Deref
    through && field.kind == MirProjKind.Field && field.decl == cx.cancel
}

// Whether calls `a` and `b` pass the same operands.
func coro_verify_same_args(coro: &CoroProgram, a: &MirCall, b: &MirCall) -> Bool {
    if a.arg_count != b.arg_count {
        return false
    }
    var j = 0
    while j < a.arg_count {
        if coro.mono.dp.bc.mir.lists[a.arg_first + j] != coro.mono.dp.bc.mir.lists[b.arg_first + j] {
            return false
        }
        j = j + 1
    }
    true
}

func coro_verify_append_callee(coro: &CoroProgram, out: &var StringBuilder, c: Int) {
    let t = coro.mono.call_item(c)
    if t >= 0 {
        try! out.append("the call of `")
        try! out.append(coro.mono.item_name(t))
        try! out.append("`")
    } else {
        try! out.append("a call with no item")
    }
}

// The assignment that is operand `o`'s one use in body `b`, reporting it
// when there is not exactly one; -1 when there is none, or it is a
// terminator's.
func coro_verify_single_use(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, o: Int,
                            c: Int) -> Int {
    let count = idx.uses.get(o) ?? 0
    let at = idx.use_stmt.get(o) ?? -1
    if count != 1 {
        var what = StringBuilder()
        try! what.append("an operand ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" passed, ")
        coro.mono.dp.bc.mir.append_operand(&var what, o)
        try! what.append(", is used ")
        try! what.append(count)
        try! what.append(" times after lowering, not once")
        coro_verify_problem(&var coro, 2, b.item, what.build())
        return -1
    }
    at
}

// The offset of the frame slot place `p` is, `(*P).[OFFSET: T]` with no
// step after it, through local `frame` or, when that is -1, any local; else
// -1.
func coro_verify_slot_offset(coro: &CoroProgram, p: Int, frame: Int) -> Int {
    if p < 0 {
        return -1
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.local < 0 || pl.count != 2 || (frame >= 0 && pl.local != frame) {
        return -1
    }
    let deref = coro.mono.dp.bc.mir.projs[pl.first]
    let slot = coro.mono.dp.bc.mir.projs[pl.first + 1]
    if deref.kind != MirProjKind.Deref || slot.kind != MirProjKind.FrameSlot {
        return -1
    }
    slot.index
}

// How many times the body `idx` indexes writes place `p`: as an
// assignment's place or a call's destination.
func coro_verify_writes_of(idx: &CoroVerifyIndex, p: Int) -> Int {
    idx.writes.get(p) ?? 0
}

// The offset of the child slot drive call `c` of lowered frame `b` drives
// its child in: the frame's child slots are in the order of its drives.
func coro_verify_child_slot(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int) -> Int {
    let nth = idx.drive_nth.get(c) ?? idx.drives
    let fr = coro_frame_of(&coro, b.item)
    if fr < 0 || nth >= idx.children.len() {
        return -1
    }
    coro.values[coro.frames[fr].value_first + idx.children[nth]].offset
}

// A drive's result: the call has no destination after lowering; when it had
// one and returns, the block it returns to holds one statement moving the
// child's result slot, at `result`, into that destination, then goes where
// the call returned. A conditional open's drive has no absent edge after
// lowering: its block moves the slot into the window's presence local and
// switches on it, `None` to where the absent edge went and `Some` to one
// move of the payload into the destination, then where the call returned.
func coro_verify_move_out(coro: &var CoroProgram, b: &CoroBeforeBody, c: Int, pre: &MirCall, frame: Int,
                          result: Int, allowed: &var Vector<Int>) {
    let post = coro.mono.dp.bc.mir.calls[c]
    if post.dest >= 0 {
        var what = StringBuilder()
        try! what.append("the drive of ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" still writes a destination, which its child's frame holds until the move-out")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
    if post.absent >= 0 {
        var what = StringBuilder()
        try! what.append("the drive of ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" keeps an absent edge, which a drive does not take")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
    if pre.dest < 0 || pre.next < 0 {
        return
    }
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    // The return edge writes the state past the drive first
    // (`coro_lower_drive`), and reaches the move-out through that write.
    var returns = post.next
    let fr = coro_frame_of(&coro, b.item)
    if fr >= 0 {
        let fv = coro.frames[fr]
        let state_at = coro_child_offset(&coro, &fv, CoroValueKind.State, -1)
        let through = coro_past_target(&coro, b.body, post.next, frame, state_at)
        if through >= 0 {
            returns = through
        }
    }
    var moves = returns >= 0 && returns < info.block_count
    if moves {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + returns]
        let from = coro_verify_one_move(&coro, &block)
        moves = from >= 0 && coro_verify_slot_offset(&coro, from, frame) == result
        if moves && pre.absent >= 0 {
            moves = coro_verify_presence_test(&coro, b.body, &pre, &block)
        } else if moves {
            let stmt = coro.mono.dp.bc.mir.stmts[block.first]
            moves = block.term == MirTermKind.Goto && block.target == pre.next && stmt.place == pre.dest
        }
        if moves {
            try! allowed.push(from)
        }
    }
    if not moves {
        var what = StringBuilder()
        try! what.append("the drive of ")
        coro_verify_append_callee(&coro, &var what, c)
        try! what.append(" does not return to one move of its child's result slot, (*frame).[")
        try! what.append(result)
        try! what.append("], into its destination before going where the call returned")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
}

// The place `block`'s one statement moves from when that statement is a
// whole move, `x = move p`, else -1.
func coro_verify_one_move(coro: &CoroProgram, block: &MirBlock) -> Int {
    if block.first < 0 || block.first != block.last {
        return -1
    }
    let stmt = coro.mono.dp.bc.mir.stmts[block.first]
    if stmt.kind != MirStmtKind.Assign || stmt.place < 0 || stmt.rvalue < 0 {
        return -1
    }
    let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
    if rv.kind != MirRvalueKind.Use || rv.count != 1 {
        return -1
    }
    let o = coro.mono.dp.bc.mir.operands[coro.mono.dp.bc.mir.lists[rv.first]]
    if o.kind != MirOperandKind.Move {
        return -1
    }
    o.place
}

// Whether `block`, whose one statement moves a conditional open's result,
// writes it whole into its window's presence local and switches on that
// local: `Some` to a block moving the payload into `pre`'s destination and
// going to its return edge, `None` to its absent edge.
func coro_verify_presence_test(coro: &CoroProgram, f: Int, pre: &MirCall, block: &MirBlock) -> Bool {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let into = coro.mono.dp.bc.mir.places[coro.mono.dp.bc.mir.stmts[block.first].place]
    if into.count != 0 || pre.window < 0 || pre.window >= info.window_count {
        return false
    }
    let held = into.local
    if coro.mono.dp.bc.mir.windows[info.window_first + pre.window].presence != held {
        return false
    }
    if block.term != MirTermKind.Switch || block.switch_kind != MirSwitchKind.Discriminant || block.place < 0 {
        return false
    }
    let on = coro.mono.dp.bc.mir.places[block.place]
    if on.local != held || on.count != 0 || block.arm_count != 2 || block.otherwise >= 0 {
        return false
    }
    var present = -1
    var absent = -1
    var k = 0
    while k < block.arm_count {
        let arm = coro.mono.dp.bc.mir.arms[block.arm_first + k]
        k = k + 1
        let name = coro.mono.dp.bc.mir.tc.name_text(coro.mono.dp.bc.mir.tc.res.decls[arm.value].name)
        if name.equals("Some") {
            present = arm.target
        } else if name.equals("None") {
            absent = arm.target
        }
    }
    if absent != pre.absent || present < 0 || present >= info.block_count {
        return false
    }
    let some = coro.mono.dp.bc.mir.blocks[info.block_first + present]
    let from = coro_verify_one_move(&coro, &some)
    if from < 0 || some.term != MirTermKind.Goto || some.target != pre.next {
        return false
    }
    if coro.mono.dp.bc.mir.stmts[some.first].place != pre.dest {
        return false
    }
    let payload = coro.mono.dp.bc.mir.places[from]
    payload.local == held && payload.count == 1 && coro.mono.dp.bc.mir.projs[payload.first].kind == MirProjKind.Payload
}

// Every place lowering added through frame pointer `frame` inside a child's
// region is one the child's drive was found to reach it by; and none reaches
// one of the body's own frame values, whose accesses are the body's.
func coro_verify_regions(coro: &var CoroProgram, target: &var Target, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                         frame: Int, slots: &Vector<Int>, places: &Vector<Int>, allowed: &Vector<Int>,
                         starts: &Vector<Int>, ends: &Vector<Int>, children: &Vector<Int>) {
    if frame < 0 {
        return
    }
    // What each place is asked of where it lies, found once per offset rather
    // than once per place (SL-970): the allowed places, by offset the offload
    // storage holding it and the first child region holding it, and the
    // frame values at each offset, as `offset * count + local` sorted.
    var allows = Map<Int, Bool>()
    var k = 0
    while k < allowed.len() {
        let _ = try! allows.insert(allowed[k], true)
        k = k + 1
    }
    var storages = Map<Int, Int>()
    var regions = Map<Int, Int>()
    var at_offset = Vector<Int>()
    let count = slots.len()
    k = 0
    while k < count {
        if slots[k] >= 0 {
            try! at_offset.push(slots[k] * count + k)
        }
        k = k + 1
    }
    at_offset.sort()
    k = 0
    while k < places.len() {
        let p = places[k]
        k = k + 1
        let pl = coro.mono.dp.bc.mir.places[p]
        if pl.local != frame || pl.count < 2 {
            continue
        }
        let slot = coro.mono.dp.bc.mir.projs[pl.first + 1]
        if slot.kind != MirProjKind.FrameSlot {
            continue
        }
        // A place the body named is its own value's slot, which rule 1 holds
        // to its layout; a zero-sized value may sit where a child's begins.
        if coro_verify_named_before(&idx, p) {
            continue
        }
        // Values whose lifetimes never meet may share bytes, so an offset can
        // lie in a child's region, an offload's storage and a local's slot at
        // once: a place is judged by what reaches it before where it lies.
        if allows.contains_key(p) || coro_verify_index_load(&coro, &b, &idx, p) {
            continue
        }
        // A zero-size slot at a child's end is that child's: its last value,
        // whose offset is where the next child's region begins.
        let offset = slot.index
        if not storages.contains_key(offset) {
            let _ = try! storages.insert(offset, coro_verify_offload_storage(&coro, b.item, &idx, offset))
        }
        let storage = storages.get(offset) ?? -1
        if storage >= 0 {
            let word = coro.mono.dp.bc.mir.tc.int_type()
            let job = offset == storage && pl.count == 2 && slot.ty == word
            if not job || coro_verify_written(&idx, p) {
                var what = StringBuilder()
                try! what.append("a place reaches into an offload's storage other than to read its job word, which the backend writes: ")
                coro.mono.dp.bc.mir.append_place(&var what, p)
                coro_verify_problem(&var coro, 2, b.item, what.build())
            }
            continue
        }
        let end = coro_verify_slot_end(&var coro, &var target, &slot)
        let empty = if end == offset { 1 } else { 0 }
        let key = 2 * offset + empty
        if not regions.contains_key(key) {
            var inside = -1
            var r = 0
            while r < starts.len() && inside < 0 {
                if offset >= starts[r] && (offset < ends[r] || (end == offset && offset == ends[r])) {
                    inside = r
                }
                r = r + 1
            }
            let _ = try! regions.insert(key, inside)
        }
        let inside = regions.get(key) ?? -1
        if inside >= 0 {
            var what = StringBuilder()
            try! what.append("a place reaches into the frame of child `")
            try! what.append(coro.mono.item_name(children[inside]))
            try! what.append("`, which only its argument writes and its result's move-out may: ")
            coro.mono.dp.bc.mir.append_place(&var what, p)
            coro_verify_problem(&var coro, 2, b.item, what.build())
            continue
        }
        var reached = Vector<Int>()
        if offset < 0 {
            var l = 0
            while l < count {
                if slots[l] == offset {
                    try! reached.push(l)
                }
                l = l + 1
            }
        } else {
            var a = 0
            var z = at_offset.len()
            while a < z {
                let m = (a + z) / 2
                if at_offset[m] < offset * count {
                    a = m + 1
                } else {
                    z = m
                }
            }
            while a < at_offset.len() && at_offset[a] / count == offset {
                try! reached.push(at_offset[a] % count)
                a = a + 1
            }
        }
        var j = 0
        while j < reached.len() {
            let l = reached[j]
            j = j + 1
            var what = StringBuilder()
            try! what.append("lowering adds an access to frame value _")
            try! what.append(l)
            try! what.append(", an ownership operation the body did not make: ")
            coro.mono.dp.bc.mir.append_place(&var what, p)
            coro_verify_problem(&var coro, 2, b.item, what.build())
        }
    }
}

// The offset of the offload storage in item `item`'s frame layout whose
// bytes hold `offset`, or -1.
func coro_verify_offload_storage(coro: &CoroProgram, item: Int, idx: &CoroVerifyIndex, offset: Int) -> Int {
    let fr = coro_frame_of(&coro, item)
    if fr < 0 {
        return -1
    }
    let frame = coro.frames[fr]
    var k = 0
    while k < idx.offloads.len() {
        let v = coro.values[frame.value_first + idx.offloads[k]]
        k = k + 1
        if offset >= v.offset && offset < v.offset + v.size {
            return v.offset
        }
    }
    return -1
}

// Whether the body `idx` indexes writes place `p`, as an assignment's place
// or a call's destination.
func coro_verify_written(idx: &CoroVerifyIndex, p: Int) -> Bool {
    coro_verify_writes_of(&idx, p) > 0
}

// Whether place `p` is only read by an index temporary's load, `_t = copy p`
// for a `_t` whose every write copies one frame value
// (`coro_verify_index_slot`): a copy of an index, which no ownership
// operation is.
func coro_verify_index_load(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, p: Int) -> Bool {
    let readers = coro_verify_ordinals(&idx.reads, idx.stmt_at.len(), p)
    var k = 0
    while k < readers.len() {
        let stmt = coro.mono.dp.bc.mir.stmts[idx.stmt_at[readers[k]]]
        k = k + 1
        if stmt.kind != MirStmtKind.Assign || stmt.place < 0 {
            return false
        }
        let target = coro.mono.dp.bc.mir.places[stmt.place]
        if target.count != 0 || coro_verify_index_slot(&b, &idx, target.local) < 0 {
            return false
        }
    }
    readers.len() > 0
}

// Whether body `b`, which `idx` indexes, named place `p` before lowering.
func coro_verify_named_before(idx: &CoroVerifyIndex, p: Int) -> Bool {
    idx.named.contains_key(p)
}

// Rule 3 over body `b`: each window it opens is closed exactly once on every
// path, a resumed state's included, since a state re-enters at its
// suspension with the windows open there: no window opens while it may be
// open, none closes while it may already be closed (closed twice, or never
// opened), and none may be open at a `return`. An accessor's epilogue starts
// with the windows its prologue carries, which the prologue may leave open.
// The same dataflow serves rule 2's check of window records
// (`coro_verify_window_records`) and rule 5's lifetimes of them.
func coro_verify_windows(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, slots: &Vector<Int>) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let width = info.window_count
    if width == 0 || info.block_count == 0 {
        return
    }
    let entry = coro_verify_window_entry(&coro, &b, &idx)
    var k = 0
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        let here = bb
        bb = bb + 1
        if not coro_verify_window_reached(&entry, here, width) {
            continue
        }
        if b.framed {
            coro_verify_window_records(&var coro, &b, &idx, &slots, &entry, here)
        }
        if block.term == MirTermKind.Call {
            let c = coro.mono.dp.bc.mir.calls[block.call]
            if c.window >= 0 && c.window < width {
                let bits = entry[here * width + c.window]
                if c.kind == MirCallKind.WindowOpen && (bits & CORO_WINDOW_OPEN) != 0 {
                    coro_verify_window_problem(&var coro, &b, c.window, here, " opens again where it may still be open")
                }
                if c.kind == MirCallKind.WindowClose && (bits & CORO_WINDOW_CLOSED) != 0 {
                    coro_verify_window_problem(&var coro, &b, c.window, here, " closes where it may already be closed: twice on some path, or never opened")
                }
            }
        }
        if block.term == MirTermKind.Return {
            k = 0
            while k < width {
                let carried = info.kind == MirFuncKind.Prologue && coro_verify_carried(&coro, b.body, k)
                if (entry[here * width + k] & CORO_WINDOW_OPEN) != 0 && not carried {
                    coro_verify_window_problem(&var coro, &b, k, here, " may still be open at a `return`: a path out does not close it")
                }
                k = k + 1
            }
        }
    }
}

// What each window of body `b` may be at each block's entry, solved to a
// fixpoint over the body as it is: `entry[b * window_count + w]`, of
// CORO_WINDOW_OPEN and CORO_WINDOW_CLOSED, 0 at a block no path reaches,
// over the edges `window_open_after` describes; an accessor's epilogue starts
// with the windows its prologue carries open.
func coro_verify_window_entry(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex) -> Vector<Int> {
    let f = b.body
    let info = coro.mono.dp.bc.mir.funcs[f]
    let width = info.window_count
    var entry = Vector<Int>()
    var k = 0
    while k < info.block_count * width {
        try! entry.push(0)
        k = k + 1
    }
    if width == 0 || info.block_count == 0 {
        return move entry
    }
    k = 0
    while k < width {
        entry[k] = CORO_WINDOW_CLOSED
        k = k + 1
    }
    if info.kind == MirFuncKind.Epilogue {
        k = 0
        while k < info.carried_count {
            let w = coro.mono.dp.bc.mir.aux[info.carried_first + k]
            if w >= 0 && w < width {
                entry[w] = CORO_WINDOW_OPEN
            }
            k = k + 1
        }
    }
    let order = coro.mono.dp.bc.mir.init_block_order(f)
    var changed = true
    while changed {
        changed = false
        var i = 0
        while i < order.len() {
            let bb = order[i]
            i = i + 1
            if not coro_verify_window_reached(&entry, bb, width) {
                continue
            }
            let switched = coro_verify_switched_local(&coro, &b, &idx, bb)
            let succ = coro.mono.dp.bc.mir.init_successors(f, bb)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                j = j + 1
                k = 0
                while k < width {
                    let was = entry[bb * width + k]
                    var bits = 0
                    if (was & CORO_WINDOW_OPEN) != 0 {
                        bits |= coro_window_bit(coro.mono.dp.bc.mir.window_open_after(f, bb, target, k, true, switched))
                    }
                    if (was & CORO_WINDOW_CLOSED) != 0 {
                        bits |= coro_window_bit(coro.mono.dp.bc.mir.window_open_after(f, bb, target, k, false, switched))
                    }
                    let at = target * width + k
                    if (entry[at] | bits) != entry[at] {
                        entry[at] |= bits
                        changed = true
                    }
                    k = k + 1
                }
            }
        }
    }
    move entry
}

func coro_window_bit(open: Bool) -> Int {
    if open { CORO_WINDOW_OPEN } else { CORO_WINDOW_CLOSED }
}

// The local block `bb` of body `b` switches on whole, as the body named it
// before lowering, which moves a frame value's places into the frame; or -1.
func coro_verify_switched_local(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, bb: Int) -> Int {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
    if block.term != MirTermKind.Switch || block.switch_kind != MirSwitchKind.Discriminant || block.place < 0 {
        return -1
    }
    let k = idx.named.get(block.place) ?? -1
    if k >= 0 {
        let pre = coro.before.places[b.place_first + k]
        if pre.count != 0 {
            return -1
        }
        return pre.local
    }
    coro.mono.dp.bc.mir.switched_local(b.body, bb)
}

// Rule 2 at each suspension point in block `here` of framed body `b`: the
// state record of every window that may be open there, or that the
// suspending call opens, lives in a frame slot. The accessor's halves write
// and read a record through a reference, which the initialisation analysis
// never sees, so the conditions rule 2 compares cannot show one left on the
// stack. `entry` is rule 3's windows by block; `slots` is rule 1's offsets.
func coro_verify_window_records(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                                slots: &Vector<Int>, entry: &Vector<Int>, here: Int) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let width = info.window_count
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
    var s = block.first
    while s >= 0 {
        let state = coro_verify_point_state(&idx, -1, s)
        if state > 0 {
            coro_verify_records_resident(&var coro, &b, &slots, &entry, here, -1, state)
        }
        s = coro.mono.dp.bc.mir.stmts[s].next
    }
    if block.term != MirTermKind.Call {
        return
    }
    let state = coro_verify_point_state(&idx, block.call, -1)
    if state > 0 {
        let c = coro.mono.dp.bc.mir.calls[block.call]
        var opening = -1
        if c.kind == MirCallKind.WindowOpen && c.window >= 0 && c.window < width {
            opening = c.window
        }
        coro_verify_records_resident(&var coro, &b, &slots, &entry, here, opening, state)
    }
}

// The state of the indexed body's suspension point at call `c`, or else at
// statement `s`, as the snapshot numbered it, or 0 when neither is one.
func coro_verify_point_state(idx: &CoroVerifyIndex, c: Int, s: Int) -> Int {
    if c >= 0 {
        return idx.call_state.get(c) ?? 0
    }
    if s >= 0 {
        return idx.stmt_state.get(s) ?? 0
    }
    0
}

func coro_verify_records_resident(coro: &var CoroProgram, b: &CoroBeforeBody, slots: &Vector<Int>,
                                  entry: &Vector<Int>, here: Int, opening: Int, state: Int) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let width = info.window_count
    var w = 0
    while w < width {
        let window = w
        w = w + 1
        let open = (entry[here * width + window] & CORO_WINDOW_OPEN) != 0
        if not open && window != opening {
            continue
        }
        let record = coro.mono.dp.bc.mir.windows[info.window_first + window].record
        if record < 0 || record >= slots.len() || slots[record] >= 0 {
            continue
        }
        var what = StringBuilder()
        try! what.append("window w")
        try! what.append(window)
        try! what.append("'s state record _")
        try! what.append(record)
        try! what.append(" stays on the resume function's stack at state ")
        try! what.append(state)
        try! what.append(", inside its window, where the suspension loses it")
        coro_verify_problem(&var coro, 2, b.item, what.build())
    }
}

func coro_verify_window_reached(entry: &Vector<Int>, bb: Int, width: Int) -> Bool {
    entry[bb * width] != 0
}

// Whether prologue `f` carries window `w` open across its `lend`.
func coro_verify_carried(coro: &CoroProgram, f: Int, w: Int) -> Bool {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var k = 0
    while k < info.carried_count {
        if coro.mono.dp.bc.mir.aux[info.carried_first + k] == w {
            return true
        }
        k = k + 1
    }
    false
}

func coro_verify_window_problem(coro: &var CoroProgram, b: &CoroBeforeBody, w: Int, bb: Int, what: String) {
    var text = StringBuilder()
    try! text.append("window w")
    try! text.append(w)
    try! text.append(" in bb")
    try! text.append(bb)
    try! text.append(what)
    coro_verify_problem(&var coro, 3, b.item, text.build())
}

// The park call `c` is, by the lang role of the std park point it reaches; the
// test intrinsic `__saw_suspend` is a ready park.
func coro_verify_park(coro: &CoroProgram, c: Int) -> CoroVerifyPark {
    if coro_verify_builtin(&coro, c, "__saw_suspend") {
        return CoroVerifyPark.Ready
    }
    let d = coro_call_decl(&coro, c)
    if d < 0 {
        return CoroVerifyPark.NotAPark
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkReadyFunction) {
        return CoroVerifyPark.Ready
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkTimerFunction) {
        return CoroVerifyPark.Timer
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkFdFunction) {
        return CoroVerifyPark.Fd
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkFdUntilFunction) {
        return CoroVerifyPark.FdUntil
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkChannelFunction) {
        return CoroVerifyPark.Channel
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkOffloadFunction) {
        return CoroVerifyPark.Offload
    }
    if d == coro.mono.dp.bc.mir.tc.res.lang_item(ResLang.ParkThreadFunction) {
        return CoroVerifyPark.Thread
    }
    CoroVerifyPark.NotAPark
}

func coro_verify_park_name(park: CoroVerifyPark) -> String {
    match park {
        case Ready -> "ready",
        case Timer -> "timer",
        case Fd -> "descriptor",
        case FdUntil -> "descriptor",
        case Channel -> "channel",
        case Offload -> "offload",
        case Thread -> "thread",
        case NotAPark -> "no"
    }
}

// What a park records, by its reason: the park word, then whether its reason
// records a deadline and arms the reactor.
func coro_verify_records_deadline(park: CoroVerifyPark) -> Bool {
    park == CoroVerifyPark.Timer || coro_verify_arms(park)
}

func coro_verify_arms(park: CoroVerifyPark) -> Bool {
    park == CoroVerifyPark.Fd || park == CoroVerifyPark.FdUntil || park == CoroVerifyPark.Offload
}

// The flow rule 4 reads: at each block's entry, the record of the park word
// and of the deadline that reaches it.
struct CoroRecordFlow {
    word: Vector<Int>
    deadline: Vector<Int>
}

extension CoroRecordFlow: NoCopy {}

// Rule 4 over lowered frame `b`: each park records itself in the task's
// context, its park word and, by its reason, its deadline, and the record
// reaches the park, and its arm when its reason arms the reactor, on every
// path with no suspension since, so an event the arm lets in finds the
// record (SL-355). The record holds its reason's value: 0 ready, 1 a timer,
// -1 a descriptor, an offload's completion word, and a channel's word; the
// deadline, 0 or a descriptor park's bound; and an arm registers its park's descriptor. An
// armed park is entered only from its arm.
func coro_verify_records(coro: &var CoroProgram, cx: &CoroContext, b: &CoroBeforeBody, idx: &CoroVerifyIndex) {
    if cx.park < 0 || cx.deadline < 0 {
        return
    }
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let flow = coro_verify_record_flow(&coro, &cx, b.body)
    // What an armed park's and an offload park's checks ask of the whole
    // body, found once, when the first such park asks.
    var entries = Vector<Int>()
    var words = Map<Int, Bool>()
    var found = false
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        bb = bb + 1
        if block.term != MirTermKind.Call || found {
            continue
        }
        let park = coro_verify_park(&coro, block.call)
        let register = coro.mono.park_register_item >= 0 && coro.mono.call_item(block.call) == coro.mono.park_register_item
        if coro_verify_arms(park) || register {
            entries = coro_verify_entries(&coro, b.body)
            words = coro_verify_offload_words(&coro, b.body)
            found = true
        }
    }
    bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        let here = bb
        bb = bb + 1
        if block.term != MirTermKind.Call || flow.word[here] == CORO_RECORD_UNREACHED {
            continue
        }
        var word = flow.word[here]
        var deadline = flow.deadline[here]
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            if coro_verify_is_word(&coro, &cx, stmt.place) && stmt.kind == MirStmtKind.Assign {
                word = s
            }
            if coro_verify_is_deadline(&coro, &cx, stmt.place) && stmt.kind == MirStmtKind.Assign {
                deadline = s
            }
            s = stmt.next
        }
        let c = block.call
        let park = coro_verify_park(&coro, c)
        if park != CoroVerifyPark.NotAPark {
            coro_verify_park_records(&var coro, &b, &idx, &words, c, here, park, word, deadline, "its park")
            if coro_verify_arms(park) {
                coro_verify_armed(&var coro, &b, &entries, here, park)
            }
        }
        if coro.mono.park_register_item >= 0 && coro.mono.call_item(c) == coro.mono.park_register_item {
            let call = coro.mono.dp.bc.mir.calls[c]
            let parked = if call.next >= 0 { coro_verify_park_at(&coro, b.body, call.next) } else { -1 }
            let reason = if parked >= 0 { coro_verify_park(&coro, parked) } else { CoroVerifyPark.NotAPark }
            if not coro_verify_arms(reason) {
                var what = StringBuilder()
                try! what.append("the arm in bb")
                try! what.append(here)
                try! what.append(" returns to no descriptor or offload park")
                coro_verify_problem(&var coro, 4, b.item, what.build())
            } else {
                coro_verify_park_records(&var coro, &b, &idx, &words, parked, here, reason, word, deadline, "its arm")
                if reason != CoroVerifyPark.Offload {
                    coro_verify_arm_operands(&var coro, &b, &idx, c, here, parked)
                }
            }
        }
    }
}

// The flow of rule 4's records over function `f`, to a fixpoint: an
// assignment to the park word or the deadline is the record reaching what
// follows, a call that definitely suspends leaves none, since the executor
// consumes the record when the task parks, and a join of differing records
// is several.
func coro_verify_record_flow(coro: &CoroProgram, cx: &CoroContext, f: Int) -> CoroRecordFlow {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var flow = CoroRecordFlow(word: Vector<Int>(), deadline: Vector<Int>())
    var k = 0
    while k < info.block_count {
        let start = if k == 0 { CORO_RECORD_NONE } else { CORO_RECORD_UNREACHED }
        try! flow.word.push(start)
        try! flow.deadline.push(start)
        k = k + 1
    }
    let order = coro.mono.dp.bc.mir.init_block_order(f)
    var changed = info.block_count > 0
    while changed {
        changed = false
        var i = 0
        while i < order.len() {
            let bb = order[i]
            i = i + 1
            if flow.word[bb] == CORO_RECORD_UNREACHED {
                continue
            }
            let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
            var word = flow.word[bb]
            var deadline = flow.deadline[bb]
            var s = block.first
            while s >= 0 {
                let stmt = coro.mono.dp.bc.mir.stmts[s]
                if stmt.kind == MirStmtKind.Assign && coro_verify_is_word(&coro, &cx, stmt.place) {
                    word = s
                }
                if stmt.kind == MirStmtKind.Assign && coro_verify_is_deadline(&coro, &cx, stmt.place) {
                    deadline = s
                }
                s = stmt.next
            }
            if block.term == MirTermKind.Call && coro_call_suspends(&coro, block.call) {
                word = CORO_RECORD_NONE
                deadline = CORO_RECORD_NONE
            }
            let succ = coro.mono.dp.bc.mir.init_successors(f, bb)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                j = j + 1
                let w = coro_verify_join(flow.word[target], word)
                if w != flow.word[target] {
                    flow.word[target] = w
                    changed = true
                }
                let d = coro_verify_join(flow.deadline[target], deadline)
                if d != flow.deadline[target] {
                    flow.deadline[target] = d
                    changed = true
                }
            }
        }
    }
    move flow
}

func coro_verify_join(a: Int, b: Int) -> Int {
    if a == CORO_RECORD_UNREACHED {
        return b
    }
    if b == CORO_RECORD_UNREACHED {
        return a
    }
    if a == CORO_RECORD_NONE || b == CORO_RECORD_NONE {
        return CORO_RECORD_NONE
    }
    if a == b {
        return a
    }
    CORO_RECORD_MANY
}

// Whether place `p` is the park word through the task's context,
// `(*(*_C).park)`.
func coro_verify_is_word(coro: &CoroProgram, cx: &CoroContext, p: Int) -> Bool {
    if p < 0 {
        return false
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.local < 0 || pl.count != 3 {
        return false
    }
    let a = coro.mono.dp.bc.mir.projs[pl.first]
    let field = coro.mono.dp.bc.mir.projs[pl.first + 1]
    let c = coro.mono.dp.bc.mir.projs[pl.first + 2]
    let through = a.kind == MirProjKind.Deref && a.ty == cx.ty && c.kind == MirProjKind.Deref
    through && field.kind == MirProjKind.Field && field.decl == cx.park
}

// Whether place `p` is the deadline in the task's context, `(*_C).deadline`.
func coro_verify_is_deadline(coro: &CoroProgram, cx: &CoroContext, p: Int) -> Bool {
    if p < 0 {
        return false
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.local < 0 || pl.count != 2 {
        return false
    }
    let a = coro.mono.dp.bc.mir.projs[pl.first]
    let field = coro.mono.dp.bc.mir.projs[pl.first + 1]
    a.kind == MirProjKind.Deref && a.ty == cx.ty && field.kind == MirProjKind.Field && field.decl == cx.deadline
}

// The park call ending block `bb` of function `f`, or -1.
func coro_verify_park_at(coro: &CoroProgram, f: Int, bb: Int) -> Int {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
    if block.term != MirTermKind.Call || coro_verify_park(&coro, block.call) == CoroVerifyPark.NotAPark {
        return -1
    }
    block.call
}

// The records reaching `what` of park `c`, its park itself or its arm, in
// block `bb`: the park word's, and the deadline's when its reason records
// one, each one record on every path since the last suspension, holding the
// reason's value.
func coro_verify_park_records(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                              words: &Map<Int, Bool>, c: Int, bb: Int, park: CoroVerifyPark, word: Int, deadline: Int,
                              what: String) {
    if word < 0 {
        coro_verify_record_problem(&var coro, &b, &idx, c, bb, park, what, "its park word", word)
    } else {
        let value = coro_verify_record_operand(&coro, word)
        var ok = false
        if park == CoroVerifyPark.Ready {
            ok = coro_verify_const_is(&coro, value, CORO_PARK_READY)
        } else if park == CoroVerifyPark.Timer {
            ok = coro_verify_const_is(&coro, value, CORO_PARK_TIMER)
        } else if park == CoroVerifyPark.Channel || park == CoroVerifyPark.Thread {
            ok = value >= 0 && value == coro_verify_pre_arg(&coro, &b, &idx, c, 0)
        } else if park == CoroVerifyPark.Offload {
            ok = coro_verify_offload_word(&coro, &words, value)
        } else {
            ok = coro_verify_const_is(&coro, value, CORO_PARK_FD)
        }
        if not ok {
            var text = StringBuilder()
            try! text.append("the ")
            try! text.append(coro_verify_park_name(park))
            try! text.append(" park ending bb")
            try! text.append(coro_verify_block_of_call(&idx, c))
            try! text.append(" records the wrong value in its park word: ")
            coro.mono.dp.bc.mir.append_operand(&var text, value)
            coro_verify_problem(&var coro, 4, b.item, text.build())
        }
    }
    if not coro_verify_records_deadline(park) {
        return
    }
    if deadline < 0 {
        coro_verify_record_problem(&var coro, &b, &idx, c, bb, park, what, "its deadline", deadline)
        return
    }
    let value = coro_verify_record_operand(&coro, deadline)
    var ok = true
    if park == CoroVerifyPark.Fd || park == CoroVerifyPark.Offload {
        ok = coro_verify_const_is(&coro, value, 0)
    } else if park == CoroVerifyPark.FdUntil {
        ok = value >= 0 && value == coro_verify_pre_arg(&coro, &b, &idx, c, 2)
    }
    if not ok {
        var text = StringBuilder()
        try! text.append("the ")
        try! text.append(coro_verify_park_name(park))
        try! text.append(" park ending bb")
        try! text.append(coro_verify_block_of_call(&idx, c))
        try! text.append(" records the wrong deadline: ")
        coro.mono.dp.bc.mir.append_operand(&var text, value)
        coro_verify_problem(&var coro, 4, b.item, text.build())
    }
}

// Whether operand `o`, an offload park's record, is a whole local of the body
// that a call of `__saw_exec_offload_park` writes, one of `words`
// (`coro_verify_offload_words`): the job's completion word, which no cancel
// wakes.
func coro_verify_offload_word(coro: &CoroProgram, words: &Map<Int, Bool>, o: Int) -> Bool {
    if o < 0 {
        return false
    }
    let op = coro.mono.dp.bc.mir.operands[o]
    if op.kind == MirOperandKind.Const || op.place < 0 || coro.mono.dp.bc.mir.places[op.place].count != 0 {
        return false
    }
    words.contains_key(coro.mono.dp.bc.mir.places[op.place].local)
}

// The locals of body `f` a call of `__saw_exec_offload_park` writes whole.
func coro_verify_offload_words(coro: &CoroProgram, f: Int) -> Map<Int, Bool> {
    var out = Map<Int, Bool>()
    let item = coro_offload_park_item(&coro)
    if item < 0 {
        return move out
    }
    let info = coro.mono.dp.bc.mir.funcs[f]
    var bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        bb = bb + 1
        if block.term != MirTermKind.Call || coro.mono.call_item(block.call) != item {
            continue
        }
        let dest = coro.mono.dp.bc.mir.calls[block.call].dest
        if dest >= 0 && coro.mono.dp.bc.mir.places[dest].count == 0 {
            let _ = try! out.insert(coro.mono.dp.bc.mir.places[dest].local, true)
        }
    }
    move out
}

func coro_verify_record_problem(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int, bb: Int,
                                park: CoroVerifyPark, what: String, record: String, state: Int) {
    var text = StringBuilder()
    try! text.append("the ")
    try! text.append(coro_verify_park_name(park))
    try! text.append(" park ending bb")
    try! text.append(coro_verify_block_of_call(&idx, c))
    try! text.append(": ")
    try! text.append(what)
    try! text.append(" in bb")
    try! text.append(bb)
    if state == CORO_RECORD_MANY {
        try! text.append(" is reached by records of ")
        try! text.append(record)
        try! text.append(" from several statements, not one")
    } else {
        try! text.append(" is reached on some path with no record of ")
        try! text.append(record)
        try! text.append(" since the last suspension")
    }
    coro_verify_problem(&var coro, 4, b.item, text.build())
}

// The operand record statement `s` stores, or -1 when its rvalue is not one
// operand used as it is.
func coro_verify_record_operand(coro: &CoroProgram, s: Int) -> Int {
    let stmt = coro.mono.dp.bc.mir.stmts[s]
    if stmt.rvalue < 0 {
        return -1
    }
    let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
    if rv.kind != MirRvalueKind.Use || rv.count != 1 {
        return -1
    }
    coro.mono.dp.bc.mir.lists[rv.first]
}

// Whether operand `o` is the integer constant `value`.
func coro_verify_const_is(coro: &CoroProgram, o: Int, value: Int) -> Bool {
    if o < 0 {
        return false
    }
    let op = coro.mono.dp.bc.mir.operands[o]
    if op.kind != MirOperandKind.Const || op.const_kind != MirConstKind.Int || op.text < 0 {
        return false
    }
    var spelled = StringBuilder()
    try! spelled.append(value)
    let want = spelled.build()
    let text = coro.mono.dp.bc.mir.tc.name_text(op.text)
    text.equals(want)
}

// Operand `j` that call `c` of body `b` passed before lowering, or -1.
func coro_verify_pre_arg(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int, j: Int) -> Int {
    let k = idx.pre_call.get(c) ?? -1
    if k < 0 {
        return -1
    }
    let pre = coro.before.calls[b.call_first + k]
    if j < pre.arg_count {
        return coro.mono.dp.bc.mir.lists[pre.arg_first + j]
    }
    return -1
}

// By block of function `f`: how many blocks it is a successor of, then how
// many of those end in an arm, two cells each.
func coro_verify_entries(coro: &CoroProgram, f: Int) -> Vector<Int> {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var out = Vector<Int>()
    var k = 0
    while k < 2 * info.block_count {
        try! out.push(0)
        k = k + 1
    }
    k = 0
    while k < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + k]
        let succ = coro.mono.dp.bc.mir.init_successors(f, k)
        k = k + 1
        let arm = block.term == MirTermKind.Call && coro.mono.call_item(block.call) == coro.mono.park_register_item
        var j = 0
        while j < succ.len() {
            let target = succ[j]
            if coro_verify_find(&succ, target) == j {
                out[2 * target] += 1
                if arm {
                    out[2 * target + 1] += 1
                }
            }
            j = j + 1
        }
    }
    move out
}

// An armed park ending block `bb` is entered only from its arm: its block's
// one predecessor ends in the arm, which returns to it. `entries` counts each
// block's predecessors and arms (`coro_verify_entries`).
func coro_verify_armed(coro: &var CoroProgram, b: &CoroBeforeBody, entries: &Vector<Int>, bb: Int, park: CoroVerifyPark) {
    let preds = entries[2 * bb]
    let armed = entries[2 * bb + 1]
    if preds != 1 || armed != 1 {
        var text = StringBuilder()
        try! text.append("the ")
        try! text.append(coro_verify_park_name(park))
        try! text.append(" park ending bb")
        try! text.append(bb)
        try! text.append(" is entered other than from its arm alone")
        coro_verify_problem(&var coro, 4, b.item, text.build())
    }
}

// The arm ending block `bb` registers its descriptor park `parked`'s own
// descriptor and direction, the operands the park passed before lowering.
func coro_verify_arm_operands(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int, bb: Int,
                              parked: Int) {
    let call = coro.mono.dp.bc.mir.calls[c]
    var ok = call.arg_count == 3
    if ok {
        let fd = coro_verify_pre_arg(&coro, &b, &idx, parked, 0)
        let dir = coro_verify_pre_arg(&coro, &b, &idx, parked, 1)
        ok = coro.mono.dp.bc.mir.lists[call.arg_first] == fd && coro.mono.dp.bc.mir.lists[call.arg_first + 1] == dir
    }
    if not ok {
        var text = StringBuilder()
        try! text.append("the arm in bb")
        try! text.append(bb)
        try! text.append(" does not register the descriptor and direction its park was given")
        coro_verify_problem(&var coro, 4, b.item, text.build())
    }
}

// The program points of a lowered body, as rule 5 numbers them: each
// statement and each terminator in block order, and after the terminator of
// a block whose call parks, the state it parks in, then, when the call
// returns, the resume transition out of that state. By block: the point of
// its first statement, of its terminator, of its state or -1, and of its
// resume or -1; the state its call parks in, or 0; and the lowest state whose
// run reaches it since a suspension, 0 for the start, or -1 when none does.
struct CoroVerifyPoints {
    count: Int
    first: Vector<Int>
    term: Vector<Int>
    state: Vector<Int>
    resume: Vector<Int>
    parked: Vector<Int>
    region: Vector<Int>
}

extension CoroVerifyPoints: NoCopy {}

// A lowered frame's storage lifetimes as rule 5 recomputes them
// (`coro_lowered_lifetimes`): its frame, an index of `coro.frames` or -1 when
// there is nothing to check, its program points, and by value `v` of the
// frame the points just before which it needs its bytes, as the spans of
// `runs` from `first[v]` up to `first[v + 1]`, each a first point and the
// point past its last (`CoroSpans`).
struct CoroLoweredLifetimes {
    frame: Int
    points: CoroVerifyPoints
    first: Vector<Int>
    runs: Vector<Int>
}

extension CoroLoweredLifetimes: NoCopy {}

// THE LOWERED-LIFETIME FUNNEL: each value's storage lifetime in lowered frame
// `b`, whose frame pointer is local `frame`, recomputed from the lowered
// body's own accesses (SL:architecture §3.9). A lifetime is the one
// compiler/tests/coro/README.md, "Storage lifetimes", defines, read off the
// body as lowering left it rather than from the sets the layout packed by.
// Values that share an offset share its spelling, so a place is attributed to
// a value by what the body named before lowering, or, for a place lowering
// added, by the call it serves. Its two consumers read one computation: rule
// 5 (`coro_verify_lifetimes`) and the sanitizer's poison lists
// (`coro_poison_lists`), so the run-time check cross-checks the packer, not
// a second analysis.
//
// ENTRY POINTS:
//   coro_verify_body
func coro_lowered_lifetimes(coro: &var CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                            frame: Int) -> CoroLoweredLifetimes {
    let fr = coro_frame_of(&coro, b.item)
    let pts = coro_verify_lowered_points(&coro, &b, &idx)
    var out = CoroLoweredLifetimes(frame: -1, points: move pts, first: Vector<Int>(), runs: Vector<Int>())
    if fr < 0 || frame < 0 {
        return move out
    }
    let fv = coro.frames[fr]
    let n = fv.value_count
    let values = coro_verify_local_values(&coro, &b, &fv)
    // The initialisation analysis over the lowered body read with every
    // place put back as it was: it then sees every access lowering moved or
    // kept as an access of the local it was, and an access lowering added
    // reads a slot, which no move path holds.
    let saved = coro_verify_restore(&var coro, &b)
    let facts = coro.mono.dp.bc.mir.init_analysis(b.body)
    var rows = Vector<Int>()
    var q = 0
    while q < facts.path_count() {
        let l = facts.path_local[q]
        try! rows.push(if l < values.len() { values[l] } else { -1 })
        q = q + 1
    }
    var spans = CoroSpans(rows: n, path_row: move rows)
    var k = 0
    while k < n {
        let v = coro.values[fv.value_first + k]
        if v.kind == CoroValueKind.State || v.kind == CoroValueKind.Budget {
            spans.mark(k, 0, out.points.count)
        }
        k = k + 1
    }
    coro_verify_local_lifetimes(&coro, &b, &facts, &values, &out.points, &var spans)
    coro_verify_put_back(&var coro, &b, &saved)
    coro_verify_record_lifetimes(&coro, &b, &idx, &values, &out.points, &var spans)
    coro_verify_call_lifetimes(&coro, &b, &idx, &fv, frame, &out.points, &var spans)
    spans.finish(out.points.count, &var out.first, &var out.runs)
    out.frame = fr
    move out
}

// Rule 5 over lowered frame `b`: no two values that share a byte are live at
// one point, by the lifetimes `lt` the funnel recomputed. One sweep of the
// spans' ends in point order meets each pair of values at the first point
// both are live, so it costs the spans and the pairs that meet, not every
// pair at every point; the pairs are reported in value order (SL-970).
func coro_verify_lifetimes(coro: &var CoroProgram, b: &CoroBeforeBody, lt: &CoroLoweredLifetimes) {
    if lt.frame < 0 {
        return
    }
    let fv = coro.frames[lt.frame]
    let n = fv.value_count
    if n == 0 {
        return
    }
    // A span's end sorts before a start at the same point, which it does not
    // reach.
    var events = Vector<Int>()
    var k = 0
    while k < n {
        var s = lt.first[k]
        while s < lt.first[k + 1] {
            try! events.push((2 * lt.runs[s] + 1) * n + k)
            try! events.push(2 * lt.runs[s + 1] * n + k)
            s = s + 2
        }
        k = k + 1
    }
    events.sort()
    var active = CoroVerifySet(count: n)
    var found = Map<Int, Int>()
    var keys = Vector<Int>()
    k = 0
    while k < events.len() {
        let e = events[k]
        k = k + 1
        let i = e % n
        if (e / n) % 2 == 0 {
            active.put(i, false)
            continue
        }
        let point = e / n / 2
        let a = coro.values[fv.value_first + i]
        var j = 0
        while j < active.members.len() {
            let w = active.members[j]
            j = j + 1
            let low = if i < w { i } else { w }
            let high = if i < w { w } else { i }
            let key = low * n + high
            if found.contains_key(key) {
                continue
            }
            let c = coro.values[fv.value_first + w]
            let shared = a.size > 0 && c.size > 0 && a.offset >= 0 && c.offset >= 0 && a.offset < c.offset + c.size && c.offset < a.offset + a.size
            if shared {
                let _ = try! found.insert(key, point)
                try! keys.push(key)
            }
        }
        active.put(i, true)
    }
    keys.sort()
    k = 0
    while k < keys.len() {
        let key = keys[k]
        k = k + 1
        let a = coro.values[fv.value_first + key / n]
        let c = coro.values[fv.value_first + key % n]
        let p = found.get(key) ?? 0
        let lo = if a.offset > c.offset { a.offset } else { c.offset }
        let hi = if a.offset + a.size < c.offset + c.size { a.offset + a.size } else { c.offset + c.size }
        var what = StringBuilder()
        coro_verify_append_value(&coro, &var what, &fv, &a)
        try! what.append(" and ")
        coro_verify_append_value(&coro, &var what, &fv, &c)
        try! what.append(" share bytes [")
        try! what.append(lo)
        try! what.append(", ")
        try! what.append(hi)
        try! what.append(") of the frame, and both are live at ")
        coro_verify_append_point(&var what, &lt.points, p)
        coro_verify_problem(&var coro, 5, b.item, what.build())
    }
}

// Lifetimes `lt` as one cell per value and point, `live[v * points + p]`,
// which the poison lists read: a sanitizing build's, so a check of every
// build pays nothing for it.
func coro_lowered_dense(lt: &CoroLoweredLifetimes, values: Int) -> Vector<Bool> {
    var live = Vector<Bool>()
    let count = lt.points.count
    var k = 0
    while k < values * count {
        try! live.push(false)
        k = k + 1
    }
    var v = 0
    while v < values {
        var s = lt.first[v]
        while s < lt.first[v + 1] {
            var p = lt.runs[s]
            while p < lt.runs[s + 1] {
                live[v * count + p] = true
                p = p + 1
            }
            s = s + 2
        }
        v = v + 1
    }
    move live
}

// Lowered frame `b`'s poison list, from the lifetimes `lt` rule 5 checked, so
// that a frame access outside its value's lifetime reports at the access
// (risk R2). At creation, where state 0 enters `bb0`, the whole frame is
// poisoned and each value live there unpoisoned; at each point, each value
// dead there but live at a point that can run just before it is poisoned,
// then each value live there but dead at such a point unpoisoned; at each
// return, before `Ready`, the whole frame is unpoisoned, since the caller or
// the executor reads the result and frees the frame outside its code. The
// state word and the op-budget counter are live at every point, so the
// executor's and a drive's reads and writes of them never meet poison, and
// an offload's storage, which the job's thread reads, is live until the take
// joins that thread.
func coro_poison_lists(coro: &var CoroProgram, b: &CoroBeforeBody, lt: &CoroLoweredLifetimes) {
    let r = if b.item < coro.resume_of.len() { coro.resume_of[b.item] } else { -1 }
    if r < 0 || lt.frame < 0 {
        return
    }
    let fv = coro.frames[lt.frame]
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let live = coro_lowered_dense(&lt, fv.value_count)
    // Each control edge into a block, by the point that runs just before
    // its first: a parking call's return edge leaves its resume transition,
    // every other edge its block's terminator. Gathered by block, each
    // block's in edge order: `from[into_first[b]]` up to `from[into_first[b +
    // 1]]`.
    var into = Vector<Int>()
    var from = Vector<Int>()
    var q = 0
    while q < info.block_count {
        let here = q
        q = q + 1
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        var resumed = -1
        if lt.points.parked[here] > 0 {
            resumed = coro.mono.dp.bc.mir.calls[block.call].next
        }
        let succ = coro.mono.dp.bc.mir.init_successors(b.body, here)
        var j = 0
        while j < succ.len() {
            let target = succ[j]
            j = j + 1
            try! into.push(target)
            if target == resumed && lt.points.resume[here] >= 0 {
                try! from.push(lt.points.resume[here])
            } else {
                try! from.push(lt.points.term[here])
            }
        }
    }
    var into_first = Vector<Int>()
    q = 0
    while q <= info.block_count {
        try! into_first.push(0)
        q = q + 1
    }
    var e = 0
    while e < into.len() {
        into_first[into[e] + 1] += 1
        e = e + 1
    }
    q = 0
    while q < info.block_count {
        into_first[q + 1] += into_first[q]
        q = q + 1
    }
    var filled = Vector<Int>()
    var sources = Vector<Int>()
    q = 0
    while q < info.block_count {
        try! filled.push(into_first[q])
        q = q + 1
    }
    e = 0
    while e < into.len() {
        try! sources.push(0)
        e = e + 1
    }
    e = 0
    while e < into.len() {
        let at = filled[into[e]]
        filled[into[e]] = at + 1
        sources[at] = from[e]
        e = e + 1
    }
    let first = coro.poisons.len()
    var bb = 0
    while bb < info.block_count {
        let here = bb
        bb = bb + 1
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        var before = Vector<Int>()
        e = into_first[here]
        while e < into_first[here + 1] {
            try! before.push(sources[e])
            e = e + 1
        }
        var p = lt.points.first[here]
        var ordinal = 0
        var s = block.first
        while s >= 0 {
            if here == 0 && ordinal == 0 {
                coro_poison_creation(&var coro, &fv, &lt, &live, CoroPoisonAt.Statement)
            }
            coro_poison_step(&var coro, &fv, &lt, &live, &before, p, here, CoroPoisonAt.Statement, ordinal)
            before = Vector<Int>()
            try! before.push(p)
            p = p + 1
            ordinal = ordinal + 1
            s = coro.mono.dp.bc.mir.stmts[s].next
        }
        if here == 0 && ordinal == 0 {
            coro_poison_creation(&var coro, &fv, &lt, &live, CoroPoisonAt.Terminator)
        }
        let term = lt.points.term[here]
        coro_poison_step(&var coro, &fv, &lt, &live, &before, term, here, CoroPoisonAt.Terminator, 0)
        if block.term == MirTermKind.Return {
            try! coro.poisons.push(CoroPoison(block: here, at: CoroPoisonAt.Terminator, ordinal: 0, offset: 0,
                                              size: fv.size, poison: false))
        }
        let state = lt.points.state[here]
        let resumes = lt.points.resume[here]
        if state >= 0 {
            var parking = Vector<Int>()
            try! parking.push(term)
            coro_poison_step(&var coro, &fv, &lt, &live, &parking, state, here, CoroPoisonAt.State, 0)
            if resumes >= 0 {
                // A drive's child may be `Ready` at once, so its return edge
                // follows the terminator as well as the state.
                try! parking.push(state)
                coro_poison_step(&var coro, &fv, &lt, &live, &parking, resumes, here, CoroPoisonAt.Resume, 0)
            }
        }
    }
    var resume = coro.resumes[r]
    resume.poison_first = first
    resume.poison_count = coro.poisons.len() - first
    coro.resumes[r] = resume
}

// The frame's creation, in front of `bb0`'s first point (`coro_poison_lists`):
// every byte poisoned, then each value live at point 0 unpoisoned.
func coro_poison_creation(coro: &var CoroProgram, fv: &CoroFrame, lt: &CoroLoweredLifetimes, live: &Vector<Bool>,
                          at: CoroPoisonAt) {
    try! coro.poisons.push(CoroPoison(block: 0, at: at, ordinal: 0, offset: 0, size: fv.size, poison: true))
    var k = 0
    while k < fv.value_count {
        let v = coro.values[fv.value_first + k]
        if v.size > 0 && v.offset >= 0 && lt.points.count > 0 && live[k * lt.points.count] {
            try! coro.poisons.push(CoroPoison(block: 0, at: at, ordinal: 0, offset: v.offset, size: v.size,
                                              poison: false))
        }
        k = k + 1
    }
}

// The steps at point `p`, which runs at `at` (statement `ordinal`) of block
// `block`, after any one of the points `before`: first each value dead at
// `p` and live at one of them is poisoned, then each value live at `p` and
// dead at one of them unpoisoned. Two values live at one point never share
// a byte, so a poisoning never covers a value live on both sides of it.
func coro_poison_step(coro: &var CoroProgram, fv: &CoroFrame, lt: &CoroLoweredLifetimes, live: &Vector<Bool>,
                      before: &Vector<Int>, p: Int, block: Int, at: CoroPoisonAt, ordinal: Int) {
    let count = lt.points.count
    var pass = 0
    while pass < 2 {
        let poison = pass == 0
        pass = pass + 1
        var k = 0
        while k < fv.value_count {
            let v = coro.values[fv.value_first + k]
            let here = live[k * count + p]
            var changed = false
            if v.size > 0 && v.offset >= 0 && here != poison {
                var j = 0
                while j < before.len() && not changed {
                    changed = live[k * count + before[j]] == poison
                    j = j + 1
                }
            }
            if changed {
                try! coro.poisons.push(CoroPoison(block: block, at: at, ordinal: ordinal, offset: v.offset,
                                                  size: v.size, poison: poison))
            }
            k = k + 1
        }
    }
}

// Lowered frame `b`'s program points (`CoroVerifyPoints`). A block parks when
// its call is the one that stands for a suspension point the snapshot
// numbered: a drive or a park keeps its call, an op-budget point yields at
// the ready park its test reaches, and an offload parks on its job in the
// park that returns to its start's continuation.
func coro_verify_lowered_points(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex) -> CoroVerifyPoints {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var pts = CoroVerifyPoints(count: 0, first: Vector<Int>(), term: Vector<Int>(), state: Vector<Int>(),
                               resume: Vector<Int>(), parked: Vector<Int>(), region: Vector<Int>())
    var bb = 0
    while bb < info.block_count {
        try! pts.parked.push(0)
        try! pts.region.push(-1)
        bb = bb + 1
    }
    var k = 0
    while k < b.point_count {
        let point = coro.before.points[b.point_first + k]
        k = k + 1
        let c = coro_verify_point_call(&coro, &b, &idx, &point)
        let at = if c >= 0 { coro_verify_block_of_call(&idx, c) } else { -1 }
        if at >= 0 {
            pts.parked[at] = point.state
        }
    }
    bb = 0
    while bb < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
        // Stage 0 workaround (SL:hazards S4): canonical: try! pts.first.push(pts.count)
        let first = pts.count
        try! pts.first.push(first)
        var s = block.first
        while s >= 0 {
            pts.count = pts.count + 1
            s = coro.mono.dp.bc.mir.stmts[s].next
        }
        // Stage 0 workaround (SL:hazards S4): canonical: try! pts.term.push(pts.count)
        let term = pts.count
        try! pts.term.push(term)
        pts.count = pts.count + 1
        var state = -1
        var resume = -1
        if pts.parked[bb] > 0 {
            state = pts.count
            pts.count = pts.count + 1
            if coro.mono.dp.bc.mir.calls[block.call].next >= 0 {
                resume = pts.count
                pts.count = pts.count + 1
            }
        }
        try! pts.state.push(state)
        try! pts.resume.push(resume)
        bb = bb + 1
    }
    if info.block_count == 0 {
        return move pts
    }
    // Each block's region, the lowest state reaching it, from a work list: a
    // block is looked at again only when its own region fell, so a chain of
    // blocks numbered out of their order settles in one pass of it (SL-970).
    pts.region[0] = 0
    var work = Vector<Int>()
    var queued = Vector<Bool>()
    bb = 0
    while bb < info.block_count {
        try! queued.push(bb == 0)
        bb = bb + 1
    }
    try! work.push(0)
    var w = 0
    while w < work.len() {
        let here = work[w]
        w = w + 1
        queued[here] = false
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        var resumed = -1
        if pts.parked[here] > 0 {
            resumed = coro.mono.dp.bc.mir.calls[block.call].next
        }
        let succ = coro.mono.dp.bc.mir.init_successors(b.body, here)
        var j = 0
        while j < succ.len() {
            let target = succ[j]
            j = j + 1
            let state = if target == resumed { pts.parked[here] } else { pts.region[here] }
            if pts.region[target] < 0 || state < pts.region[target] {
                pts.region[target] = state
                if not queued[target] {
                    queued[target] = true
                    try! work.push(target)
                }
            }
        }
    }
    move pts
}

// The call of lowered body `b` that parks for its suspension point `point`,
// or -1 when lowering left none: an effect-only suspension runs as nothing.
func coro_verify_point_call(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, point: &CoroBeforePoint) -> Int {
    if point.stmt >= 0 {
        return coro_verify_budget_yield(&coro, b.body, point.block)
    }
    let c = point.call
    if c < 0 || coro_verify_effect_only(&coro, c) || not coro_verify_ends_block(&idx, c) {
        return -1
    }
    if coro_offloaded_extern(&coro, c) < 0 {
        return c
    }
    let next = coro.mono.dp.bc.mir.calls[c].next
    let parked = idx.offload_park.get(next) ?? -1
    if parked == c {
        return -1
    }
    parked
}

// Marks the lifetime of each local the frame holds, `values` by local: the
// points just before which `facts`, the initialisation analysis over the
// lowered body read with every place put back as it was, says it may be
// initialised, whole or in part, and the point of each assignment, and of
// each call that does not park, writing into it other than through a
// dereference. A cursor walks the reached blocks from each one's entry.
func coro_verify_local_lifetimes(coro: &CoroProgram, b: &CoroBeforeBody, facts: &MirInit, values: &Vector<Int>,
                                 pts: &CoroVerifyPoints, spans: &var CoroSpans) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    var cur = facts.cursor()
    var bb = 0
    while bb < info.block_count {
        let here = bb
        bb = bb + 1
        if not facts.reached[here] {
            continue
        }
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        spans.enter(&facts, &var cur, here)
        var p = pts.first[here]
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            spans.live_at(p)
            if stmt.kind == MirStmtKind.Assign {
                let l = coro_verify_written_local(&coro, stmt.place)
                if l >= 0 && l < values.len() && values[l] >= 0 {
                    spans.mark(values[l], p, p + 1)
                }
            }
            let accesses = coro.mono.dp.bc.mir.init_stmt_accesses(b.body, s, &facts)
            spans.apply(&facts, &var cur, &accesses)
            p = p + 1
            s = stmt.next
        }
        spans.live_at(pts.term[here])
        // The definition: a destination is live at the point that writes it,
        // which is an assignment's statement, and the terminator of a call
        // that does not park, since that call writes its destination before
        // control leaves the terminator; a parking call writes its at the
        // resume transition. lifetimes.saw computes the same definition for
        // the packer, independently (`coro_mark_written`).
        if pts.state[here] < 0 && block.term == MirTermKind.Call {
            // Stage 0 workaround (SL:hazards S4): canonical: let l = coro_verify_written_local(&coro, coro.mono.dp.bc.mir.calls[block.call].dest)
            let dest = coro.mono.dp.bc.mir.calls[block.call].dest
            let l = coro_verify_written_local(&coro, dest)
            if l >= 0 && l < values.len() && values[l] >= 0 {
                spans.mark(values[l], pts.term[here], pts.term[here] + 1)
            }
        }
        if pts.state[here] >= 0 {
            let accesses = coro.mono.dp.bc.mir.init_term_accesses(b.body, here, &facts)
            let dest = coro.mono.dp.bc.mir.calls[block.call].dest
            var taken = Vector<MirAccess>()
            var written = Vector<MirAccess>()
            var j = 0
            while j < accesses.len() {
                let a = accesses[j]
                j = j + 1
                if a.kind == MirAccessKind.Write && a.place == dest {
                    try! written.push(a)
                } else {
                    try! taken.push(a)
                }
            }
            spans.apply(&facts, &var cur, &taken)
            spans.live_at(pts.state[here])
            if pts.resume[here] >= 0 {
                spans.apply(&facts, &var cur, &written)
                spans.live_at(pts.resume[here])
            }
        }
    }
}

// By local of body `b` before lowering: the index in frame `fv` of the value
// holding it, or -1.
func coro_verify_local_values(coro: &CoroProgram, b: &CoroBeforeBody, fv: &CoroFrame) -> Vector<Int> {
    var out = Vector<Int>()
    var l = 0
    while l < b.local_count {
        try! out.push(-1)
        l = l + 1
    }
    var k = 0
    while k < fv.value_count {
        let v = coro.values[fv.value_first + k]
        let held = v.kind == CoroValueKind.Result || v.kind == CoroValueKind.Param || v.kind == CoroValueKind.Local
        if held && v.local >= 0 && v.local < b.local_count {
            out[v.local] = k
        }
        k = k + 1
    }
    move out
}

// The local place `p` writes into, whole or in part, when no dereference
// stands between it and its root; else -1.
func coro_verify_written_local(coro: &CoroProgram, p: Int) -> Int {
    if p < 0 {
        return -1
    }
    let place = coro.mono.dp.bc.mir.places[p]
    var j = 0
    while j < place.count {
        if coro.mono.dp.bc.mir.projs[place.first + j].kind == MirProjKind.Deref {
            return -1
        }
        j = j + 1
    }
    place.local
}

// Marks, for the state record of each window of lowered body `b` that frame
// `fv` holds, every point at which its window may be open: from its open's
// terminator, through the time a suspending half runs, to its close's call.
// The accessor's halves reach a record through a reference the
// initialisation analysis never sees.
func coro_verify_record_lifetimes(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, values: &Vector<Int>,
                                  pts: &CoroVerifyPoints, spans: &var CoroSpans) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let width = info.window_count
    if width == 0 || info.block_count == 0 {
        return
    }
    let entry = coro_verify_window_entry(&coro, &b, &idx)
    var bb = 0
    while bb < info.block_count {
        let here = bb
        bb = bb + 1
        if not coro_verify_window_reached(&entry, here, width) {
            continue
        }
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        var opening = -1
        var closing = -1
        if block.term == MirTermKind.Call {
            let c = coro.mono.dp.bc.mir.calls[block.call]
            if c.kind == MirCallKind.WindowOpen {
                opening = c.window
            } else if c.kind == MirCallKind.WindowClose {
                closing = c.window
            }
        }
        var w = 0
        while w < width {
            let window = w
            w = w + 1
            let record = coro.mono.dp.bc.mir.windows[info.window_first + window].record
            if record < 0 || record >= values.len() || values[record] < 0 {
                continue
            }
            let at = values[record]
            let open = (entry[here * width + window] & CORO_WINDOW_OPEN) != 0
            if open {
                spans.mark(at, pts.first[here], pts.term[here])
            }
            if open || window == opening {
                spans.mark(at, pts.term[here], pts.term[here] + 1)
                if pts.state[here] >= 0 {
                    spans.mark(at, pts.state[here], pts.state[here] + 1)
                }
            }
            if pts.resume[here] >= 0 && ((open && window != closing) || window == opening) {
                spans.mark(at, pts.resume[here], pts.resume[here] + 1)
            }
        }
    }
}

// Marks the lifetime of each child slot and offload storage frame `fv` holds,
// from the calls lowered body `b` drives and offloads, in the order of its
// suspension points, which is the order of the frame's child slots and of
// its offload storages. A child is live from its parameter writes, which
// lowering added to its drive's block, through its drive and its state, and
// when its result is taken, its resume and the move-out of the result, which
// the block it returns to starts with. An offload's storage is live from its
// start through every point that reaches its take, which ends it.
func coro_verify_call_lifetimes(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, fv: &CoroFrame,
                                frame: Int, pts: &CoroVerifyPoints, spans: &var CoroSpans) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    // By block, the offload whose walk last reached it, so the walks share
    // one table rather than each making its own.
    var seen = Vector<Int>()
    var bb = 0
    while bb < info.block_count {
        try! seen.push(-1)
        bb = bb + 1
    }
    var children = 0
    var storages = 0
    var k = 0
    while k < b.point_count {
        let point = coro.before.points[b.point_first + k]
        k = k + 1
        let c = point.call
        if c < 0 {
            continue
        }
        let ext = coro_offloaded_extern(&coro, c)
        var j = -1
        if ext >= 0 {
            j = if storages < idx.offloads.len() { idx.offloads[storages] } else { -1 }
            storages = storages + 1
        } else if coro_driven_child(&coro, c) >= 0 {
            j = if children < idx.children.len() { idx.children[children] } else { -1 }
            children = children + 1
        }
        let at_block = coro_verify_block_of_call(&idx, c)
        if j < 0 || at_block < 0 {
            continue
        }
        let v = coro.values[fv.value_first + j]
        if ext >= 0 {
            coro_verify_offload_lifetime(&coro, &b, &idx, &pts, c, ext, j, storages, &var seen, &var spans)
            continue
        }
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + at_block]
        var started = false
        var p = pts.first[at_block]
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            if not started && stmt.kind == MirStmtKind.Assign {
                started = coro_verify_added_slot(&coro, &idx, frame, stmt.place, v.offset, v.offset + v.size)
                if started {
                    spans.mark(j, p, pts.term[at_block])
                }
            }
            p = p + 1
        }
        spans.mark(j, pts.term[at_block], pts.term[at_block] + 1)
        if pts.state[at_block] >= 0 {
            spans.mark(j, pts.state[at_block], pts.state[at_block] + 1)
        }
        var next = coro.mono.dp.bc.mir.calls[c].next
        if coro_verify_pre_dest(&coro, &b, &idx, c) < 0 || next < 0 || pts.resume[at_block] < 0 {
            continue
        }
        spans.mark(j, pts.resume[at_block], pts.resume[at_block] + 1)
        // The return edge writes the state past the drive before the move-out
        // (`coro_lower_drive`), so the child stays live across that write.
        let state_at = coro_child_offset(&coro, &fv, CoroValueKind.State, -1)
        let through = coro_past_target(&coro, b.body, next, frame, state_at)
        if through >= 0 {
            spans.mark(j, pts.first[next], pts.first[next] + 1)
            spans.mark(j, pts.term[next], pts.term[next] + 1)
            next = through
        }
        let out = coro.mono.dp.bc.mir.blocks[info.block_first + next]
        p = pts.first[next]
        s = out.first
        var taken = false
        while s >= 0 && not taken {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            spans.mark(j, p, p + 1)
            p = p + 1
            taken = coro_verify_reads_added(&coro, &idx, frame, stmt.rvalue, v.offset, v.offset + v.size)
        }
    }
}

// Marks, for frame value `value`, an offload's storage from the start `c` of
// its job for `blocking` extern item `ext`, through every point of every
// block its continuation reaches before its take, a call of the same
// extern, ends it. `seen` holds, by block, the walk that last reached it;
// this walk is `walk`.
func coro_verify_offload_lifetime(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex,
                                  pts: &CoroVerifyPoints, c: Int, ext: Int, value: Int, walk: Int,
                                  seen: &var Vector<Int>, spans: &var CoroSpans) {
    let info = coro.mono.dp.bc.mir.funcs[b.body]
    let start = coro_verify_block_of_call(&idx, c)
    spans.mark(value, pts.term[start], pts.term[start] + 1)
    var work = Vector<Int>()
    let next = coro.mono.dp.bc.mir.calls[c].next
    if next >= 0 {
        try! work.push(next)
        seen[next] = walk
    }
    var k = 0
    while k < work.len() {
        let here = work[k]
        k = k + 1
        spans.mark(value, pts.first[here], pts.term[here] + 1)
        if pts.state[here] >= 0 {
            spans.mark(value, pts.state[here], pts.state[here] + 1)
        }
        if pts.resume[here] >= 0 {
            spans.mark(value, pts.resume[here], pts.resume[here] + 1)
        }
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + here]
        if block.term == MirTermKind.Call && block.call != c && coro.mono.call_item(block.call) == ext {
            continue
        }
        let succ = coro.mono.dp.bc.mir.init_successors(b.body, here)
        var j = 0
        while j < succ.len() {
            let target = succ[j]
            j = j + 1
            if seen[target] != walk {
                seen[target] = walk
                try! work.push(target)
            }
        }
    }
}

// The destination call `c` of body `b` wrote before lowering, or -1.
func coro_verify_pre_dest(coro: &CoroProgram, b: &CoroBeforeBody, idx: &CoroVerifyIndex, c: Int) -> Int {
    let k = idx.pre_call.get(c) ?? -1
    if k < 0 {
        return -1
    }
    coro.before.calls[b.call_first + k].dest
}

// Whether place `p` is one lowering added to the indexed body, a frame slot
// through frame pointer `frame` whose offset lies in `[lo, hi)`.
func coro_verify_added_slot(coro: &CoroProgram, idx: &CoroVerifyIndex, frame: Int, p: Int, lo: Int, hi: Int) -> Bool {
    if p < 0 || coro_verify_named_before(&idx, p) {
        return false
    }
    let pl = coro.mono.dp.bc.mir.places[p]
    if pl.local != frame || pl.count < 2 {
        return false
    }
    let deref = coro.mono.dp.bc.mir.projs[pl.first]
    let slot = coro.mono.dp.bc.mir.projs[pl.first + 1]
    deref.kind == MirProjKind.Deref && slot.kind == MirProjKind.FrameSlot && slot.index >= lo && slot.index < hi
}

// Whether rvalue `rv` reads a place lowering added to body `b` in the frame's
// bytes `[lo, hi)` (`coro_verify_added_slot`).
func coro_verify_reads_added(coro: &CoroProgram, idx: &CoroVerifyIndex, frame: Int, rv: Int, lo: Int, hi: Int) -> Bool {
    if rv < 0 {
        return false
    }
    let r = coro.mono.dp.bc.mir.rvalues[rv]
    if coro_verify_added_slot(&coro, &idx, frame, r.place, lo, hi) {
        return true
    }
    var k = 0
    while k < r.count {
        let o = coro.mono.dp.bc.mir.lists[r.first + k]
        k = k + 1
        // Stage 0 workaround (SL:hazards S4): canonical: if o >= 0 && coro_verify_added_slot(&coro, &idx, frame, coro.mono.dp.bc.mir.operands[o].place, lo, hi) {
        let read = if o >= 0 { coro.mono.dp.bc.mir.operands[o].place } else { -1 }
        if coro_verify_added_slot(&coro, &idx, frame, read, lo, hi) {
            return true
        }
    }
    false
}

// How rule 5 names frame value `v` of frame `fv`: a local by its number, its
// binding's name and its slot; a child slot or an offload's storage by what
// it serves and its offset; the state word and the op-budget counter.
func coro_verify_append_value(coro: &CoroProgram, out: &var StringBuilder, fv: &CoroFrame, v: &CoroValue) {
    if v.kind == CoroValueKind.State {
        try! out.append("the state word")
        return
    }
    if v.kind == CoroValueKind.Budget {
        try! out.append("the op-budget counter")
        return
    }
    if v.kind == CoroValueKind.Child || v.kind == CoroValueKind.Offload {
        if v.kind == CoroValueKind.Child {
            try! out.append("child `")
            try! out.append(coro.mono.item_name(v.child))
        } else {
            try! out.append("offload `")
            try! out.append(coro.item_label(v.child))
        }
        try! out.append("` at (*frame).[")
        try! out.append(v.offset)
        try! out.append("]")
        return
    }
    try! out.append("_")
    try! out.append(v.local)
    let local = coro.mono.dp.bc.mir.locals[coro.mono.dp.bc.mir.funcs[fv.body].local_first + v.local]
    if local.name >= 0 {
        try! out.append(" `")
        try! out.append(coro.mono.dp.bc.mir.tc.name_text(local.name))
        try! out.append("`")
    }
    try! out.append(" at ")
    coro.mono.dp.bc.mir.append_frame_slot(&var out, "(*frame)", v.offset, v.ty)
}

// Point `p` of `pts`, as the dump spells a program point, then the state it
// runs in: `bbB.N` statement N of block B and `bbB.t` its terminator, in the
// lowest state whose run reaches the block; `sK` parked in state K and `rK`
// the resume transition out of it, in state K.
func coro_verify_append_point(out: &var StringBuilder, pts: &CoroVerifyPoints, p: Int) {
    var bb = 0
    while bb < pts.first.len() {
        let here = bb
        bb = bb + 1
        if p == pts.state[here] || p == pts.resume[here] {
            if p == pts.state[here] {
                try! out.append("s")
            } else {
                try! out.append("r")
            }
            try! out.append(pts.parked[here])
            try! out.append(", in state ")
            try! out.append(pts.parked[here])
            return
        }
        if p >= pts.first[here] && p <= pts.term[here] {
            try! out.append("bb")
            try! out.append(here)
            if p == pts.term[here] {
                try! out.append(".t")
            } else {
                try! out.append(".")
                try! out.append(p - pts.first[here])
            }
            try! out.append(", in state ")
            try! out.append(pts.region[here])
            return
        }
    }
    try! out.append("?")
}
