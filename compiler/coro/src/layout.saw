// Frame layout: each frame value's offset, from its size and alignment and
// from which values' storage lifetimes intersect. `coro_assign` is the one
// place a policy decides which values share bytes, and two values share a
// byte only when their lifetimes have no point in common, so a value is never
// overwritten while its bytes are needed (SL:architecture §3.9).
//
// ENTRY POINTS of the frame layout:
//   coro_lay_out_frames
//   coro_interference
//   coro_assign
//   coro_lower_bound

import sawcoro.frames.{coro_frame_of}
import sawcoro.lifetimes.{coro_lifetime_neighbours, coro_lifetime_spans}
import sawcoro.program.{CoroFrame, CoroProgram, CoroValue, CoroValueKind}
import sawtarget.layout.{Target, TargetKind, target_overflow_subject}

// What one frame value needs of its bytes; `pinned` holds it at offset 0.
public struct CoroNeed {
    size: Int
    align: Int
    pinned: Bool
}

// Which frame values' storage lifetimes intersect, for the `count` values of
// one frame in its value order: value `i` interferes with each other value
// `near[first[i]]` up to `near[first[i + 1]]`, ascending.
public struct CoroInterference {
    count: Int
    first: Vector<Int>
    near: Vector<Int>
}

extension CoroInterference: NoCopy {}

extension CoroInterference {
    // Whether values `i` and `j`, two of the frame's, interfere.
    public func interferes(&self, i: Int, j: Int) -> Bool {
        var a = self.first[i]
        var z = self.first[i + 1]
        while a < z {
            let m = (a + z) / 2
            if self.near[m] < j {
                a = m + 1
            } else {
                z = m
            }
        }
        a < self.first[i + 1] && self.near[a] == j
    }
}

// Lays out every frame found for `target`: each value's size, alignment and
// offset, and the frame's size and alignment. A child's slot is its frame's
// bytes, so frames are laid out callees first; the suspending call graph is
// acyclic once frames are found, so each pass lays out at least one. A frame
// holding a value the target cannot lay out, a child's frame among them,
// gets no offsets, and names that value.
public func coro_lay_out_frames(coro: &var CoroProgram, target: &var Target) {
    var done = Vector<Bool>()
    var k = 0
    while k < coro.frames.len() {
        try! done.push(false)
        k = k + 1
    }
    var left = coro.frames.len()
    var progress = true
    while left > 0 && progress {
        progress = false
        k = 0
        while k < coro.frames.len() {
            if not done[k] && coro_children_laid_out(&coro, &done, k) {
                coro_lay_out_frame(&var coro, &var target, k)
                done[k] = true
                left = left - 1
                progress = true
            }
            k = k + 1
        }
    }
    if left > 0 {
        try! coro.problems.push("a frame's children never finished laying out: the suspending call graph has a cycle")
    }
}

// Whether every child frame `k` embeds is laid out.
func coro_children_laid_out(coro: &CoroProgram, done: &Vector<Bool>, k: Int) -> Bool {
    let frame = coro.frames[k]
    var j = 0
    while j < frame.value_count {
        let v = coro.values[frame.value_first + j]
        j = j + 1
        if v.kind == CoroValueKind.Child {
            let c = coro_frame_of(&coro, v.child)
            if c < 0 || not done[c] {
                return false
            }
        }
    }
    true
}

func coro_lay_out_frame(coro: &var CoroProgram, target: &var Target, k: Int) {
    var frame = coro.frames[k]
    var needs = Vector<CoroNeed>()
    var j = 0
    while j < frame.value_count {
        var v = coro.values[frame.value_first + j]
        if v.kind == CoroValueKind.Child {
            let child = coro.frames[coro_frame_of(&coro, v.child)]
            if child.unsupported >= 0 && frame.unsupported < 0 {
                frame.unsupported = j
            }
            v.size = if child.size > 0 { child.size } else { 0 }
            v.align = if child.align > 0 { child.align } else { 1 }
        } else {
            let l = target.layout(&var coro.mono.dp.bc.mir.tc, v.ty)
            if l.kind == TargetKind.Unsupported && frame.unsupported < 0 {
                frame.unsupported = j
            }
            v.size = l.size
            v.align = if l.align > 0 { l.align } else { 1 }
        }
        coro.values[frame.value_first + j] = v
        try! needs.push(CoroNeed(size: v.size, align: v.align, pinned: v.kind == CoroValueKind.State))
        j = j + 1
    }
    if frame.unsupported >= 0 {
        coro.frames[k] = frame
        return
    }
    let interference = coro_interference(&coro, k)
    let placement = coro_assign(&needs, &interference, &target)
    var size = 0
    var align = 1
    var fits = placement.fits
    j = 0
    while fits && j < frame.value_count {
        var v = coro.values[frame.value_first + j]
        v.offset = placement.offsets[j]
        coro.values[frame.value_first + j] = v
        let end = target.size_sum(v.offset, v.size) ?? -1
        if end < 0 {
            fits = false
        } else if end > size {
            size = end
        }
        if v.align > align {
            align = v.align
        }
        j = j + 1
    }
    var total = -1
    if fits {
        total = target.size_aligned(size, align) ?? -1
    }
    if total < 0 {
        // The frame's one refusal, which names the function; later stages
        // read a frame with no size as one with nothing to lower.
        coro.frames[k] = frame
        coro_refuse_frame_size(&var coro, frame.item)
        return
    }
    frame.size = total
    frame.align = align
    coro.frames[k] = frame
}

// Refuses frame item `item` as one whose bytes do not fit the target's `Int`,
// at the function that suspends.
func coro_refuse_frame_size(coro: &var CoroProgram, item: Int) {
    var node = coro.mono.items[item].origin_node
    let d = coro.item_decl(item)
    if d >= 0 {
        node = coro.mono.dp.bc.mir.tc.decl_site(d)
    }
    var subject = StringBuilder()
    try! subject.append("the frame of `")
    try! subject.append(coro.mono.item_name(item))
    try! subject.append("`")
    coro.refuse(item, node, "constant.overflow", target_overflow_subject(subject.build()))
}

// Which of frame `k`'s values interfere: two whose storage lifetimes share
// a program point (`compiler/coro/src/lifetimes.saw`).
public func coro_interference(coro: &CoroProgram, k: Int) -> CoroInterference {
    let frame = coro.frames[k]
    var out = CoroInterference(count: frame.value_count, first: Vector<Int>(), near: Vector<Int>())
    coro_lifetime_neighbours(&coro, &frame, &var out.first, &var out.near)
    move out
}

// Each value's offset, in the order given: a deterministic greedy packing.
// The pinned value, the state word, takes offset 0 first, since the resume
// function loads the state from the frame's first byte and a drive starts a
// child at its slot's base. Then each other value in turn, by decreasing
// size and then by its order here, takes the lowest offset its alignment
// allows whose bytes no value already placed that interferes with it holds.
// The state word counts as interfering with every value. A zero-size value
// holds no byte, so it comes last, and it never stands on a byte another
// value holds, so a place at the offset of a value with bytes never also
// names a zero-size value's slot.
public func coro_assign(values: &Vector<CoroNeed>, interference: &CoroInterference,
                        target: &Target) -> CoroPlacement {
    var out = Vector<Int>()
    var placed = Vector<Bool>()
    var k = 0
    while k < values.len() {
        let pinned = values[k].pinned
        try! placed.push(pinned)
        if pinned {
            try! out.push(0)
        } else {
            try! out.push(-1)
        }
        k = k + 1
    }
    // The order the packing takes the values in, by decreasing size and then
    // by their order here, sorted once rather than searched for each value.
    // A key is a size's rank among the distinct sizes, largest first, times
    // `n`, plus the order: no key multiplies a size, so none can overflow.
    let n = values.len()
    var sizes = Vector<Int>()
    k = 0
    while k < n {
        try! sizes.push(values[k].size)
        k = k + 1
    }
    let distinct = coro_distinct_sorted(&sizes)
    var keys = Vector<Int>()
    var pinned = Vector<Int>()
    k = 0
    while k < n {
        if placed[k] {
            try! pinned.push(k)
        } else {
            let rank = distinct.len() - 1 - coro_rank(&distinct, values[k].size)
            try! keys.push(rank * n + k)
        }
        k = k + 1
    }
    keys.sort()
    // The bytes every value with bytes holds, merged, once the zero-size
    // values' turn comes: every value with bytes is placed by then.
    var held = Vector<Int>()
    var held_made = false
    k = 0
    while k < keys.len() {
        let next = keys[k] % n
        k = k + 1
        var found: Int? = 0
        if values[next].size > 0 {
            found = coro_first_fit(&values, &interference, &pinned, &out, &placed, next, &target)
        } else {
            if not held_made {
                if not coro_held_bytes(&values, &out, &placed, &target, &var held) {
                    return CoroPlacement(offsets: Vector<Int>(), fits: false)
                }
                held_made = true
            }
            found = coro_first_clear(&held, values[next].align, &target)
        }
        let at = found ?? -1
        if at < 0 {
            return CoroPlacement(offsets: Vector<Int>(), fits: false)
        }
        out[next] = at
        placed[next] = true
    }
    CoroPlacement(offsets: move out, fits: true)
}

// Where `coro_assign` put each value, in the order given; `fits` is false
// when some value could not be placed within the target's `Int`.
public struct CoroPlacement {
    offsets: Vector<Int>
    fits: Bool
}

extension CoroPlacement: NoCopy {}

// `sizes`, sorted ascending with each distinct value once.
func coro_distinct_sorted(sizes: &Vector<Int>) -> Vector<Int> {
    var sorted = Vector<Int>()
    var k = 0
    while k < sizes.len() {
        try! sorted.push(sizes[k])
        k = k + 1
    }
    sorted.sort()
    var out = Vector<Int>()
    k = 0
    while k < sorted.len() {
        if out.len() == 0 || out[out.len() - 1] != sorted[k] {
            try! out.push(sorted[k])
        }
        k = k + 1
    }
    move out
}

// The index of `x` in `distinct`, which holds it, sorted ascending.
func coro_rank(distinct: &Vector<Int>, x: Int) -> Int {
    var a = 0
    var z = distinct.len()
    while a < z {
        let m = (a + z) / 2
        if distinct[m] < x {
            a = m + 1
        } else {
            z = m
        }
    }
    a
}

// The lowest offset aligned for value `i`, which has bytes, whose bytes no
// placed value that interferes with it holds, the pinned values counting as
// interfering with every value. Every offset skipped lies inside the value
// that moved past it, so the first one found clear is the lowest. Only the
// pinned values and those `i` interferes with can stand in its way, so each
// pass walks those alone, in value order, as a walk of every value meets them
// (SL-970).
func coro_first_fit(values: &Vector<CoroNeed>, interference: &CoroInterference, pinned: &Vector<Int>,
                    out: &Vector<Int>, placed: &Vector<Bool>, i: Int, target: &Target) -> Int? {
    let v = values[i]
    let width = v.size
    let end = interference.first[i + 1]
    var at = 0
    var moved = true
    while moved {
        moved = false
        var a = 0
        var b = interference.first[i]
        while a < pinned.len() || b < end {
            var j = -1
            if b >= end || (a < pinned.len() && pinned[a] <= interference.near[b]) {
                j = pinned[a]
                if b < end && interference.near[b] == j {
                    b = b + 1
                }
                a = a + 1
            } else {
                j = interference.near[b]
                b = b + 1
            }
            let w = values[j]
            let blocks = placed[j] && j != i && w.size > 0
            if blocks {
                // A bound that passes the target's `Int` means no offset holds
                // the value, so the frame does not fit.
                let reach = target.size_sum(at, width) ?? -1
                let past = target.size_sum(out[j], w.size) ?? -1
                if reach < 0 || past < 0 {
                    return None
                }
                if out[j] < reach && at < past {
                    at = target.size_aligned(past, v.align) ?? -1
                    if at < 0 {
                        return None
                    }
                    moved = true
                }
            }
        }
    }
    let last = target.size_sum(at, width) ?? -1
    if last < 0 {
        return None
    }
    at
}

// The bytes the placed values with bytes hold, as spans in offset order,
// merged where they meet or touch: each a first byte and the byte past its
// last.
// Fills `held`, and answers false when a value's end passes the target's
// `Int`, which a value `coro_first_fit` placed never does. Spans are ordered
// by the rank of their start among the distinct starts, so no key multiplies
// an offset.
func coro_held_bytes(values: &Vector<CoroNeed>, out: &Vector<Int>, placed: &Vector<Bool>, target: &Target,
                     held: &var Vector<Int>) -> Bool {
    var starts = Vector<Int>()
    var ends = Vector<Int>()
    var k = 0
    while k < values.len() {
        if placed[k] && values[k].size > 0 {
            try! starts.push(out[k])
            let end = target.size_sum(out[k], values[k].size) ?? -1
            if end < 0 {
                return false
            }
            try! ends.push(end)
        }
        k = k + 1
    }
    let distinct = coro_distinct_sorted(&starts)
    var by_start = Vector<Int>()
    k = 0
    while k < starts.len() {
        try! by_start.push(coro_rank(&distinct, starts[k]) * values.len() + k)
        k = k + 1
    }
    by_start.sort()
    k = 0
    while k < by_start.len() {
        let j = by_start[k] % values.len()
        k = k + 1
        let last = held.len() - 1
        if held.len() > 0 && starts[j] <= held[last] {
            if ends[j] > held[last] {
                held[last] = ends[j]
            }
        } else {
            try! held.push(starts[j])
            try! held.push(ends[j])
        }
    }
    true
}

// The lowest offset aligned to `align` that lies on no byte of `held`: what
// a zero-size value takes. Every offset skipped lies inside a span that
// moved past it, so the first one found clear is the lowest.
func coro_first_clear(held: &Vector<Int>, align: Int, target: &Target) -> Int? {
    var at = 0
    var k = 0
    while k < held.len() {
        if at < held[k] {
            return at
        }
        if at < held[k + 1] {
            at = target.size_aligned(held[k + 1], align) ?? -1
            if at < 0 {
                return None
            }
        }
        k = k + 2
    }
    at
}

// Frame `k`'s lower bound: the most bytes its values need at one program
// point. With fixed offsets over a general control-flow graph, a packing
// may not reach it, and alignment adds to it (SL:architecture §3.9).
public func coro_lower_bound(coro: &CoroProgram, k: Int) -> Int {
    let frame = coro.frames[k]
    // What the bytes needed change by at each point, from each span's ends.
    var change = Vector<Int>()
    var p = 0
    while p <= frame.points {
        try! change.push(0)
        p = p + 1
    }
    var j = 0
    while j < frame.value_count {
        let v = coro.values[frame.value_first + j]
        j = j + 1
        if v.size <= 0 {
            continue
        }
        let spans = coro_lifetime_spans(&coro, &v)
        var s = 0
        while s < spans.len() {
            change[spans[s]] += v.size
            change[spans[s + 1]] -= v.size
            s = s + 2
        }
    }
    var best = 0
    var sum = 0
    p = 0
    while p < frame.points {
        sum = sum + change[p]
        if sum > best {
            best = sum
        }
        p = p + 1
    }
    best
}
