// Coroutine lowering's dump (compiler/tests/coro/README.md): each item in
// mono's item order, named as mono's dump names it, with its frame decision
// and, for one that needs a frame, the chain its suspension was found
// through, and each frame's storage lifetimes; and each frame's layout.

import sawcoro.lifetimes.{CoroPointLabel, CoroPointRole, coro_lifetime_across, coro_lifetime_at, coro_point_labels}
import sawcoro.program.{CoroFrame, CoroPoint, CoroPointKind, CoroProgram, CoroResume, CoroValue, CoroValueKind}
import sawcoro.suspends.{coro_cause_chain, coro_source_label}
import sawmir.dump.{mir_dump_module}
import sawmir.model.{MirLocal}
import sawmono.dump.{mono_dump_layouts}
import sawmono.program.{MonoProgram}

// `item #K: NAME  (frame yes (via CHAIN))` or `item #K: NAME  (frame no)`,
// one line per item; a task root says so, before its chain when it also
// suspends. Then each frame's storage lifetimes, in item order.
public func coro_dump_items(coro: &CoroProgram, out: &var StringBuilder) {
    var k = 0
    while k < coro.mono.items.len() {
        try! out.append("item #")
        try! out.append(k)
        try! out.append(": ")
        try! out.append(coro.mono.item_name(k))
        if coro.needs_frame(k) {
            try! out.append("  (frame yes (")
            let root = coro.mono.is_task_root(k)
            if root {
                try! out.append("task root")
            }
            if coro.suspending[k] {
                if root {
                    try! out.append(", ")
                }
                try! out.append("via ")
                try! out.append(coro_cause_chain(&coro, k))
            }
            try! out.append("))\n")
        } else {
            try! out.append("  (frame no)\n")
        }
        k = k + 1
    }
    k = 0
    while k < coro.frames.len() {
        coro_dump_lifetimes(&coro, &var out, k)
        k = k + 1
    }
}

// Frame `k`'s storage lifetimes: a header naming its item, then one line per
// value, in the frame's order, `    WHAT: POINTS`. POINTS is `every point`,
// `none`, or the points in order: `bbB.N` statement N of block B, `bbB.t`
// its terminator, a run of them in one block as `bbB.N-M`; `sK` state K, a
// suspension point; `rK` the resume transition out of state K, its call's
// return edge. The body is read as it is before lowering.
func coro_dump_lifetimes(coro: &CoroProgram, out: &var StringBuilder, k: Int) {
    let frame = coro.frames[k]
    let labels = coro_point_labels(&coro, frame.body)
    try! out.append("lifetimes #")
    try! out.append(frame.item)
    try! out.append(": ")
    try! out.append(coro.mono.item_name(frame.item))
    try! out.append("\n")
    var j = 0
    while j < frame.value_count {
        let v = coro.values[frame.value_first + j]
        j = j + 1
        try! out.append("    ")
        if v.kind == CoroValueKind.State {
            try! out.append("state")
        } else if v.kind == CoroValueKind.Budget {
            try! out.append("op budget")
        } else if v.kind == CoroValueKind.Child {
            try! out.append("child ")
            try! out.append(coro.mono.item_name(v.child))
        } else if v.kind == CoroValueKind.Offload {
            try! out.append("offload ")
            try! out.append(coro.item_label(v.child))
        } else {
            try! out.append("_")
            try! out.append(v.local)
            let local = coro.mono.dp.bc.mir.locals[coro.mono.dp.bc.mir.funcs[frame.body].local_first + v.local]
            coro_append_local_note(&coro, &var out, &local)
        }
        try! out.append(": ")
        if labels.len() != frame.points {
            try! out.append("unknown: the body was rewritten\n")
            continue
        }
        coro_append_points(&coro, &var out, &v, &labels)
        try! out.append("\n")
    }
}

// Value `v`'s lifetime over the points `labels` names, as
// `coro_dump_lifetimes` writes it.
func coro_append_points(coro: &CoroProgram, out: &var StringBuilder, v: &CoroValue, labels: &Vector<CoroPointLabel>) {
    let n = labels.len()
    var count = 0
    var p = 0
    while p < n {
        if coro_lifetime_at(&coro, &v, p) {
            count = count + 1
        }
        p = p + 1
    }
    if count == n {
        try! out.append("every point")
        return
    }
    if count == 0 {
        try! out.append("none")
        return
    }
    var first = true
    p = 0
    while p < n {
        if not coro_lifetime_at(&coro, &v, p) {
            p = p + 1
            continue
        }
        if not first {
            try! out.append(" ")
        }
        first = false
        let label = labels[p]
        if label.role == CoroPointRole.State {
            try! out.append("s")
            try! out.append(label.state)
            p = p + 1
            continue
        }
        if label.role == CoroPointRole.Resume {
            try! out.append("r")
            try! out.append(label.state)
            p = p + 1
            continue
        }
        var q = p
        while q + 1 < n && coro_lifetime_at(&coro, &v, q + 1) && coro_in_run(&labels, q + 1, label.block) {
            q = q + 1
        }
        try! out.append("bb")
        try! out.append(label.block)
        try! out.append(".")
        coro_append_ordinal(&var out, &labels, p)
        if q > p {
            try! out.append("-")
            coro_append_ordinal(&var out, &labels, q)
        }
        p = q + 1
    }
}

// Whether point `p` is a statement or the terminator of block `block`, and
// so continues a run of that block's points.
func coro_in_run(labels: &Vector<CoroPointLabel>, p: Int, block: Int) -> Bool {
    let label = labels[p]
    label.block == block && (label.role == CoroPointRole.Statement || label.role == CoroPointRole.Terminator)
}

// A statement's ordinal in its block, or `t` for a terminator.
func coro_append_ordinal(out: &var StringBuilder, labels: &Vector<CoroPointLabel>, p: Int) {
    let label = labels[p]
    if label.role == CoroPointRole.Terminator {
        try! out.append("t")
    } else {
        try! out.append(label.ordinal)
    }
}

// Each frame laid out, in item order: its header, its suspension points by
// state, one line per value at its frame slot, then the locals that stay on
// the resume function's stack; or `no frame` for a program with none.
public func coro_dump_layouts(coro: &CoroProgram, out: &var StringBuilder) {
    if coro.frames.len() == 0 {
        try! out.append("no frame\n")
        return
    }
    var k = 0
    while k < coro.frames.len() {
        coro_dump_frame(&coro, &var out, k)
        k = k + 1
    }
}

func coro_dump_frame(coro: &CoroProgram, out: &var StringBuilder, k: Int) {
    let frame = coro.frames[k]
    try! out.append("frame #")
    try! out.append(frame.item)
    try! out.append(": ")
    try! out.append(coro.mono.item_name(frame.item))
    if frame.unsupported >= 0 {
        let v = coro.values[frame.value_first + frame.unsupported]
        try! out.append("  (unsupported: ")
        coro_append_value_type(&coro, &var out, &v)
        try! out.append(")\n")
    } else {
        try! out.append("  (size ")
        try! out.append(frame.size)
        try! out.append(" align ")
        try! out.append(frame.align)
        try! out.append(")\n")
    }
    var s = 0
    while s < frame.suspend_count {
        let point = coro.suspends[frame.suspend_first + s]
        try! out.append("    suspend ")
        try! out.append(s + 1)
        try! out.append(": bb")
        try! out.append(point.block)
        if point.call >= 0 {
            try! out.append(" call ")
            try! out.append(coro_source_label(&coro, point.call))
        } else {
            try! out.append(" budget")
        }
        try! out.append("\n")
        s = s + 1
    }
    var in_frame = Vector<Bool>()
    let info = coro.mono.dp.bc.mir.funcs[frame.body]
    var l = 0
    while l < info.local_count {
        try! in_frame.push(false)
        l = l + 1
    }
    var j = 0
    while j < frame.value_count {
        let v = coro.values[frame.value_first + j]
        if v.local >= 0 {
            in_frame[v.local] = true
        }
        coro_dump_value(&coro, &var out, &frame, &v)
        j = j + 1
    }
    try! out.append("    stack:")
    var none = true
    l = 1
    while l < info.local_count {
        if not in_frame[l] {
            try! out.append(" _")
            try! out.append(l)
            none = false
        }
        l = l + 1
    }
    if none {
        try! out.append(" none")
    }
    try! out.append("\n")
}

// `    (*frame).[OFFSET: T]  size S align A  WHAT  (across STATES)`, the
// across list naming each suspension state the value's lifetime contains.
func coro_dump_value(coro: &CoroProgram, out: &var StringBuilder, frame: &CoroFrame, v: &CoroValue) {
    try! out.append("    ")
    if v.offset >= 0 && v.kind != CoroValueKind.Child {
        coro.mono.dp.bc.mir.append_frame_slot(&var out, "(*frame)", v.offset, v.ty)
    } else {
        try! out.append("(*frame).[")
        if v.offset >= 0 {
            try! out.append(v.offset)
        } else {
            try! out.append("?")
        }
        try! out.append(": ")
        coro_append_value_type(&coro, &var out, &v)
        try! out.append("]")
    }
    try! out.append("  size ")
    try! out.append(v.size)
    try! out.append(" align ")
    try! out.append(v.align)
    try! out.append("  ")
    if v.kind == CoroValueKind.State {
        try! out.append("state\n")
        return
    }
    if v.kind == CoroValueKind.Budget {
        try! out.append("op budget\n")
        return
    }
    if v.kind == CoroValueKind.Child {
        try! out.append("child")
    } else if v.kind == CoroValueKind.Offload {
        try! out.append("offload ")
        try! out.append(coro.item_label(v.child))
    } else {
        try! out.append("_")
        try! out.append(v.local)
        let local = coro.mono.dp.bc.mir.locals[coro.mono.dp.bc.mir.funcs[frame.body].local_first + v.local]
        coro_append_local_note(&coro, &var out, &local)
    }
    var across = StringBuilder()
    var s = 0
    while s < frame.suspend_count {
        if coro_lifetime_across(&coro, &frame, &v, s) {
            try! across.append(" ")
            try! across.append(s + 1)
        }
        s = s + 1
    }
    let states = across.build()
    if states.len() > 0 {
        try! out.append("  (across")
        try! out.append(states)
        try! out.append(")")
    }
    try! out.append("\n")
}

// A frame value's type: its local's, or for a child slot `frame NAME`, the
// child item's frame.
func coro_append_value_type(coro: &CoroProgram, out: &var StringBuilder, v: &CoroValue) {
    if v.kind == CoroValueKind.Child {
        try! out.append("frame ")
        try! out.append(coro.mono.item_name(v.child))
        return
    }
    coro.mono.dp.bc.mir.append_type(&var out, v.ty)
}

// Each lowered frame's resume function, in item order: a header naming its
// item, its frame and the local holding the frame pointer, a line per state,
// a line per lowered spawn site, then its body as lowered, every frame value
// reached through a frame slot; or `no lowered frame` for a program with
// none. Then each item with no lowered frame that holds a lowered spawn or
// drive site, in item order: a header, `spawner` for one that spawns and
// `driver` otherwise, a line per site, then its body.
public func coro_dump_lowered(coro: &CoroProgram, out: &var StringBuilder) {
    if coro.resumes.len() == 0 {
        try! out.append("no lowered frame\n")
    }
    coro_dump_resumes(&coro, &var out)
    var item = 0
    while item < coro.mono.items.len() {
        let k = item
        item = item + 1
        let spawns = coro_holds_spawn(&coro, k)
        if coro.resume_of[k] >= 0 || not (spawns || coro_holds_drive(&coro, k)) {
            continue
        }
        if spawns {
            try! out.append("spawner #")
        } else {
            try! out.append("driver #")
        }
        try! out.append(k)
        try! out.append(": ")
        try! out.append(coro.mono.item_name(k))
        try! out.append("\n")
        coro_dump_spawns(&coro, &var out, k)
        coro_dump_drives(&coro, &var out, k)
        // Stage 0 workaround (SL:hazards S4): canonical: coro.mono.dp.bc.mir.dump_func(&var out, coro.mono.items[k].body, false)
        let body = coro.mono.items[k].body
        coro.mono.dp.bc.mir.dump_func(&var out, body, false)
    }
}

func coro_holds_spawn(coro: &CoroProgram, item: Int) -> Bool {
    var k = 0
    while k < coro.spawns.len() {
        if coro.spawns[k].item == item {
            return true
        }
        k = k + 1
    }
    false
}

func coro_holds_drive(coro: &CoroProgram, item: Int) -> Bool {
    var k = 0
    while k < coro.drives.len() {
        if coro.drives[k].item == item {
            return true
        }
        k = k + 1
    }
    false
}

// `    drive bbB task root #J NAME, descriptor _D, frame _R`, one line per
// lowered drive site of item `item`, in block order.
func coro_dump_drives(coro: &CoroProgram, out: &var StringBuilder, item: Int) {
    var k = 0
    while k < coro.drives.len() {
        let d = coro.drives[k]
        k = k + 1
        if d.item != item {
            continue
        }
        try! out.append("    drive bb")
        try! out.append(d.block)
        try! out.append(" task root #")
        try! out.append(d.root)
        try! out.append(" ")
        try! out.append(coro.mono.item_name(d.root))
        try! out.append(", descriptor _")
        try! out.append(d.descriptor)
        try! out.append(", frame _")
        try! out.append(d.frame)
        try! out.append("\n")
    }
}

// `    spawn bbB task root #J NAME, descriptor _D, box _B`, one line per
// lowered spawn site of item `item`, in block order.
func coro_dump_spawns(coro: &CoroProgram, out: &var StringBuilder, item: Int) {
    var k = 0
    while k < coro.spawns.len() {
        let s = coro.spawns[k]
        k = k + 1
        if s.item != item {
            continue
        }
        try! out.append("    spawn bb")
        try! out.append(s.block)
        try! out.append(" task root #")
        try! out.append(s.root)
        try! out.append(" ")
        try! out.append(coro.mono.item_name(s.root))
        try! out.append(", descriptor _")
        try! out.append(s.descriptor)
        try! out.append(", box _")
        try! out.append(s.frame)
        try! out.append("\n")
    }
}

func coro_dump_resumes(coro: &CoroProgram, out: &var StringBuilder) {
    var k = 0
    while k < coro.resumes.len() {
        let r = coro.resumes[k]
        let frame = coro.frames[r.frame]
        try! out.append("resume #")
        try! out.append(r.item)
        try! out.append(": ")
        try! out.append(coro.mono.item_name(r.item))
        try! out.append("  (frame size ")
        try! out.append(frame.size)
        try! out.append(" align ")
        try! out.append(frame.align)
        try! out.append(", pointer _")
        try! out.append(r.frame_local)
        if r.context_local >= 0 {
            try! out.append(", context _")
            try! out.append(r.context_local)
        }
        try! out.append(")\n    state 0: bb0\n")
        var j = 0
        while j < r.point_count {
            let point = coro.points[r.point_first + j]
            j = j + 1
            if point.kind == CoroPointKind.OffloadStart || point.kind == CoroPointKind.OffloadTake {
                try! out.append("    offload bb")
                try! out.append(point.block)
                if point.kind == CoroPointKind.OffloadStart {
                    try! out.append(" start #")
                } else {
                    try! out.append(" take #")
                }
                try! out.append(point.child)
                try! out.append(" ")
                try! out.append(coro.mono.item_name(point.child))
                try! out.append(", storage (*frame).[")
                try! out.append(point.slot)
                try! out.append("]\n")
                continue
            }
            try! out.append("    state ")
            try! out.append(point.state)
            try! out.append(": bb")
            try! out.append(point.block)
            match point.kind {
                case ParkReady -> try! out.append(" park ready\n"),
                case ParkTimer -> try! out.append(" park timer\n"),
                case ParkFd -> try! out.append(" park fd\n"),
                case ParkChannel -> try! out.append(" park channel\n"),
                case ParkOffload -> try! out.append(" park offload\n"),
                case Drive -> {
                    try! out.append(" drive #")
                    try! out.append(point.child)
                    try! out.append(" ")
                    try! out.append(coro.mono.item_name(point.child))
                    try! out.append(" at (*frame).[")
                    try! out.append(point.slot)
                    try! out.append("]\n")
                },
                case OffloadStart -> {},
                case OffloadTake -> {}
            }
        }
        coro_dump_spawns(&coro, &var out, r.item)
        coro.mono.dp.bc.mir.dump_func(&var out, frame.body, false)
        k = k + 1
    }
}

// What a frame value's local is, as mono's dump notes it.
func coro_append_local_note(coro: &CoroProgram, out: &var StringBuilder, l: &MirLocal) {
    match l.kind {
        case Return -> try! out.append(" result"),
        case Receiver -> try! out.append(" self"),
        case Env -> try! out.append(" env"),
        case Record -> try! out.append(" record"),
        case Temp -> {},
        case Param -> {
            try! out.append(" param")
            if l.name >= 0 {
                try! out.append(" ")
                try! out.append(coro.mono.dp.bc.mir.tc.name_text(l.name))
            }
        },
        case User -> {
            if l.reference {
                try! out.append(" ref")
            }
            try! out.append(" ")
            try! out.append(coro.mono.dp.bc.mir.tc.name_text(l.name))
        },
        case Flag -> {
            try! out.append(" flag ")
            try! out.append(coro.mono.dp.bc.mir.tc.name_text(l.name))
        }
    }
}
