// Storage lifetimes: for each value a frame holds, the set of its item's
// program points at which its bytes are needed (SL:architecture §3.9).
// Residency, the layout's interference and the dump all read the sets from
// here, so they agree on what a lifetime is; compiler/tests/coro/README.md,
// "Storage lifetimes", defines each kind's set.
//
// The bound on every set: an owning value is read by its own scope-end drop
// (the spec's "Scope-end release"), so its storage is never dead before that
// drop. Only a value with no drop could end at its last use, and no set here
// ends there.
//
// ENTRY POINTS of storage lifetimes:
//   coro_lifetimes_of
//   coro_lifetime_append
//   coro_lifetime_resident
//   coro_lifetimes_meet
//   coro_lifetime_across
//   coro_lifetime_at
//   coro_point_labels

import sawcoro.program.{CoroFrame, CoroProgram, CoroSuspend, CoroValue, CoroValueKind}
import sawcoro.suspends.{coro_call_suspends}
import sawmir.initialisation.{MIR_INIT_PARTIAL, MIR_INIT_WHOLE, MirAccess, MirAccessKind, MirInit,
                              mir_init_apply_all}
import sawmir.model.{MirCallKind, MirFuncKind, MirStmtKind, MirTermKind}

// One function's program points and its locals' lifetimes over them:
// `live[l * points + p]` says local `l`'s bytes are needed just before point
// `p`. `suspends` are its suspension points in block order, and `returns`,
// by suspension point, its return edge's point, or -1 for an op-budget
// point and a call that never returns. `charges` says the body has an
// op-budget point.
public struct CoroLifetimes {
    points: Int
    live: Vector<Bool>
    suspends: Vector<CoroSuspend>
    returns: Vector<Int>
    charges: Bool
}

extension CoroLifetimes: NoCopy {}

// What a program point of a body is: a statement, a terminator, a
// suspension point, which is a state the frame parks in, or the return edge
// of a suspending call, the resume transition out of its state.
public enum CoroPointRole {
    case Statement,
    case Terminator,
    case State,
    case Resume
}

// How the dump names a program point: its role; its block; a statement's
// ordinal in its block; and the state a suspension point or a resume
// transition is of, numbered in block order from 1. An op-budget point that
// may yield is a state, though it is its block's statement too.
public struct CoroPointLabel {
    role: CoroPointRole
    block: Int
    ordinal: Int
    state: Int
}

// The program points of function `f` and its locals' lifetimes. A point is
// each statement and each terminator, in block order, and a suspending call
// adds two after its terminator's: the moment it is suspended, its arguments
// taken and its destination not yet written, then, when it returns, its
// return edge, where its destination is written.
public func coro_lifetimes_of(coro: &CoroProgram, f: Int) -> CoroLifetimes {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let facts = coro.mono.dp.bc.mir.init_analysis(f)
    let labels = coro_point_labels(&coro, f)
    let points = labels.len()
    var lt = CoroLifetimes(points: points, live: Vector<Bool>(), suspends: Vector<CoroSuspend>(),
                           returns: Vector<Int>(), charges: false)
    var k = 0
    while k < info.local_count * points {
        try! lt.live.push(false)
        k = k + 1
    }
    let open = coro_windows_open(&coro, f)
    let width = info.window_count
    var p = 0
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        var state = facts.entry_state(b)
        // The window this block's terminator opens, whose record its prologue
        // writes from the terminator on, and the one it closes, whose record
        // its epilogue reads until the call returns.
        var opening = -1
        var closing = -1
        if block.term == MirTermKind.Call {
            let call = coro.mono.dp.bc.mir.calls[block.call]
            if call.kind == MirCallKind.WindowOpen {
                opening = call.window
            } else if call.kind == MirCallKind.WindowClose {
                closing = call.window
            }
        }
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            coro_mark_live(&facts, &state, &var lt, p)
            coro_mark_records(&coro, f, &open, b * width, -1, -1, &var lt, p)
            if stmt.kind == MirStmtKind.Budget {
                lt.charges = true
                if stmt.yields {
                    try! lt.suspends.push(CoroSuspend(block: b, point: p, call: -1))
                    try! lt.returns.push(-1)
                }
            }
            let accesses = coro.mono.dp.bc.mir.init_stmt_accesses(f, s, &facts)
            mir_init_apply_all(&facts, &var state, &accesses)
            p = p + 1
            s = stmt.next
        }
        coro_mark_live(&facts, &state, &var lt, p)
        coro_mark_records(&coro, f, &open, b * width, opening, -1, &var lt, p)
        p = p + 1
        if coro_block_suspends(&coro, f, b) {
            coro_mark_records(&coro, f, &open, b * width, opening, -1, &var lt, p)
            let accesses = coro.mono.dp.bc.mir.init_term_accesses(f, b, &facts)
            let dest = coro.mono.dp.bc.mir.calls[block.call].dest
            var taken = Vector<MirAccess>()
            var written = Vector<MirAccess>()
            var j = 0
            while j < accesses.len() {
                let a = accesses[j]
                j = j + 1
                if a.kind == MirAccessKind.Write && a.place == dest {
                    try! written.push(a)
                } else {
                    try! taken.push(a)
                }
            }
            mir_init_apply_all(&facts, &var state, &taken)
            coro_mark_live(&facts, &state, &var lt, p)
            try! lt.suspends.push(CoroSuspend(block: b, point: p, call: block.call))
            p = p + 1
            if coro_block_returns(&coro, f, b) {
                mir_init_apply_all(&facts, &var state, &written)
                coro_mark_live(&facts, &state, &var lt, p)
                coro_mark_records(&coro, f, &open, b * width, opening, closing, &var lt, p)
                try! lt.returns.push(p)
                p = p + 1
            } else {
                try! lt.returns.push(-1)
            }
        }
        b = b + 1
    }
    move lt
}

// Appends to `coro.live` the lifetime of one value of `lt`'s frame, and
// returns where it starts: every point for the state word and the op-budget
// counter, `lt`'s set for local `l`, and for the child slot or offload
// storage of suspension point `s` (an index of `lt.suspends`), its call's
// terminator, which writes the parameter slots or starts the job, its
// suspension point, and its return edge, where the take reads the job word
// or a child's result is moved out, which only a call with a destination has.
public func coro_lifetime_append(coro: &var CoroProgram, lt: &CoroLifetimes, kind: CoroValueKind, l: Int,
                                 s: Int) -> Int {
    let live_first = coro.live.len()
    var p = 0
    if kind == CoroValueKind.State || kind == CoroValueKind.Budget {
        while p < lt.points {
            try! coro.live.push(true)
            p = p + 1
        }
        return live_first
    }
    if kind == CoroValueKind.Child || kind == CoroValueKind.Offload {
        let point = lt.suspends[s]
        var through = lt.returns[s]
        if kind == CoroValueKind.Child && coro.mono.dp.bc.mir.calls[point.call].dest < 0 {
            through = -1
        }
        while p < lt.points {
            try! coro.live.push(p == point.point - 1 || p == point.point || p == through)
            p = p + 1
        }
        return live_first
    }
    while p < lt.points {
        try! coro.live.push(lt.live[l * lt.points + p])
        p = p + 1
    }
    live_first
}

// Whether local `l`'s lifetime contains one of the suspension points: what
// makes a local frame-resident.
public func coro_lifetime_resident(lt: &CoroLifetimes, l: Int) -> Bool {
    var k = 0
    while k < lt.suspends.len() {
        if lt.live[l * lt.points + lt.suspends[k].point] {
            return true
        }
        k = k + 1
    }
    false
}

// Whether values `a` and `b` of `frame` have a program point in common.
public func coro_lifetimes_meet(coro: &CoroProgram, frame: &CoroFrame, a: &CoroValue, b: &CoroValue) -> Bool {
    var p = 0
    while p < frame.points {
        if coro.live[a.live_first + p] && coro.live[b.live_first + p] {
            return true
        }
        p = p + 1
    }
    false
}

// Whether value `v` of `frame` is live in the frame's `s`th suspension
// state, counting from 0.
public func coro_lifetime_across(coro: &CoroProgram, frame: &CoroFrame, v: &CoroValue, s: Int) -> Bool {
    let point = coro.suspends[frame.suspend_first + s]
    coro.live[v.live_first + point.point]
}

// Whether value `v`'s bytes are needed just before program point `p`.
public func coro_lifetime_at(coro: &CoroProgram, v: &CoroValue, p: Int) -> Bool {
    coro.live[v.live_first + p]
}

// The program points of function `f`, in order, each named for the dump.
// Their count is the function's point count.
public func coro_point_labels(coro: &CoroProgram, f: Int) -> Vector<CoroPointLabel> {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var out = Vector<CoroPointLabel>()
    var states = 0
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        var ordinal = 0
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            if stmt.kind == MirStmtKind.Budget && stmt.yields {
                states = states + 1
                try! out.push(CoroPointLabel(role: CoroPointRole.State, block: b, ordinal: ordinal, state: states))
            } else {
                try! out.push(CoroPointLabel(role: CoroPointRole.Statement, block: b, ordinal: ordinal, state: -1))
            }
            ordinal = ordinal + 1
            s = stmt.next
        }
        try! out.push(CoroPointLabel(role: CoroPointRole.Terminator, block: b, ordinal: -1, state: -1))
        if coro_block_suspends(&coro, f, b) {
            states = states + 1
            try! out.push(CoroPointLabel(role: CoroPointRole.State, block: b, ordinal: -1, state: states))
            if coro_block_returns(&coro, f, b) {
                try! out.push(CoroPointLabel(role: CoroPointRole.Resume, block: b, ordinal: -1, state: states))
            }
        }
        b = b + 1
    }
    move out
}

// Whether block `b` of function `f` ends in a call that definitely suspends.
func coro_block_suspends(coro: &CoroProgram, f: Int, b: Int) -> Bool {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
    block.term == MirTermKind.Call && coro_call_suspends(&coro, block.call)
}

// Whether block `b` of function `f` ends in a suspending call that returns.
func coro_block_returns(coro: &CoroProgram, f: Int, b: Int) -> Bool {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
    coro_block_suspends(&coro, f, b) && coro.mono.dp.bc.mir.calls[block.call].next >= 0
}

// Marks, at point `p`, each local `state` says may be initialised: some
// move path inside it may be whole or partial.
func coro_mark_live(facts: &MirInit, state: &Vector<Int>, lt: &var CoroLifetimes, p: Int) {
    var q = 0
    while q < facts.path_count() {
        if (facts.own(&state, q) & (MIR_INIT_WHOLE | MIR_INIT_PARTIAL)) != 0 {
            let l = facts.path_local[q]
            lt.live[l * lt.points + p] = true
        }
        q = q + 1
    }
}

// The windows of function `f` that may be open on entry to each block:
// `open[b * window_count + w]`. A window opens on its open's present edge and
// closes on its close's; an accessor's epilogue starts with the windows its
// prologue carries open.
func coro_windows_open(coro: &CoroProgram, f: Int) -> Vector<Bool> {
    let info = coro.mono.dp.bc.mir.funcs[f]
    let width = info.window_count
    var open = Vector<Bool>()
    var reached = Vector<Bool>()
    var k = 0
    while k < info.block_count * width {
        try! open.push(false)
        k = k + 1
    }
    k = 0
    while k < info.block_count {
        try! reached.push(k == 0)
        k = k + 1
    }
    if width == 0 || info.block_count == 0 {
        return move open
    }
    if info.kind == MirFuncKind.Epilogue {
        k = 0
        while k < info.carried_count {
            let w = coro.mono.dp.bc.mir.aux[info.carried_first + k]
            if w >= 0 && w < width {
                open[w] = true
            }
            k = k + 1
        }
    }
    let order = coro.mono.dp.bc.mir.init_block_order(f)
    var changed = true
    while changed {
        changed = false
        var i = 0
        while i < order.len() {
            let bb = order[i]
            i = i + 1
            if not reached[bb] {
                continue
            }
            let block = coro.mono.dp.bc.mir.blocks[info.block_first + bb]
            var opened = -1
            var closed = -1
            var absent = -1
            if block.term == MirTermKind.Call {
                let c = coro.mono.dp.bc.mir.calls[block.call]
                if c.kind == MirCallKind.WindowOpen {
                    opened = c.window
                    absent = c.absent
                } else if c.kind == MirCallKind.WindowClose {
                    closed = c.window
                }
            }
            let succ = coro.mono.dp.bc.mir.init_successors(f, bb)
            var j = 0
            while j < succ.len() {
                let target = succ[j]
                j = j + 1
                if not reached[target] {
                    reached[target] = true
                    changed = true
                }
                var w = 0
                while w < width {
                    let here = (open[bb * width + w] && w != closed) || (w == opened && target != absent)
                    if here && not open[target * width + w] {
                        open[target * width + w] = true
                        changed = true
                    }
                    w = w + 1
                }
            }
        }
    }
    move open
}

// Marks, at point `p`, the record of each window `open` holds from `at` on
// other than window `closed`, and of window `opening`; either is -1 when
// there is none. A record's accessor halves write and read it through a
// reference the initialisation analysis never sees, so its lifetime is
// every point at which its window may be open.
func coro_mark_records(coro: &CoroProgram, f: Int, open: &Vector<Bool>, at: Int, opening: Int, closed: Int,
                       lt: &var CoroLifetimes, p: Int) {
    let info = coro.mono.dp.bc.mir.funcs[f]
    var w = 0
    while w < info.window_count {
        if (open[at + w] && w != closed) || w == opening {
            let record = coro.mono.dp.bc.mir.windows[info.window_first + w].record
            if record >= 0 {
                lt.live[record * lt.points + p] = true
            }
        }
        w = w + 1
    }
}
