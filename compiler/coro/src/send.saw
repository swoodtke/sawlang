// The Send-on-frames gate (spec, Multi-threaded execution): every cooperative
// spawn, `group.spawn(...)` into any group and `Task.spawn(...)`, requires
// the spawned task's frame to be `Send`, so a frame's verdict never depends on
// which engine runs it. The frame is the root's parameters, its resident
// locals, the by-value parameters and resident locals of every child it
// embeds, and the root's result, which `join()` takes on the spawner's
// thread. A reference crosses by Rust's rule at any depth, `&T` when `T` is
// `Sync` and `&var T` when `T` is `Send`, so a borrowing struct crosses when
// each reference it holds does; the spawn-borrow rules keep the referent
// alive for the task's life. A function-typed parameter holds exactly the
// value passed, so when that is a closure the parameter crosses when the
// closure's captures prove `sendable`, whatever its written type says.
//
// ENTRY POINTS of the Send-on-frames gate:
//   coro_check_frame_send

import sawborrowck.program.{BorrowckProgram}
import sawresolve.collect.{res_is_top_level}
import sawcoro.frames.{coro_driven_child, coro_frame_of}
import sawcoro.program.{CoroProgram, CoroValueKind}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirAggregate, MirCallKind, MirRvalueKind, MirSpawnForm, MirStmtKind, MirTermKind, mir_spawn_leading}
import sawmir.program.{MirProgram}
import sawmono.program.{MonoProgram}
import sawresolve.program.{ResProgram}
import sawtypecheck.bodies.{tc_check_bodies}
import sawtypecheck.bodychecks.{tc_check_body_rules}
import sawtypecheck.captures.{tc_check_closure_traits}
import sawtypecheck.checks.{tc_check_unsafe}
import sawtypecheck.model.{TcCaptureBlock}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.tier.{tc_compute_tiers}
import sawtypecheck.typeops.{TcClient}
import sawtypecheck.types.{TcKind}

// Refuses, once per task root, the first value of a spawned root's frame
// that is not `Send` (`coro.spawn-not-send`), at the declaration holding the
// value, for every `group.spawn` and `Task.spawn` site.
public func coro_check_frame_send(coro: &var CoroProgram) {
    var checked = Vector<Bool>()
    var k = 0
    while k < coro.mono.items.len() {
        try! checked.push(false)
        k = k + 1
    }
    let none = Vector<Int>()
    k = 0
    while k < coro.mono.items.len() {
        let item = k
        k = k + 1
        let f = coro.mono.items[item].body
        if f < 0 {
            continue
        }
        let info = coro.mono.dp.bc.mir.funcs[f]
        var b = 0
        while b < info.block_count {
            let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
            b = b + 1
            if block.term != MirTermKind.Call {
                continue
            }
            let site = coro.mono.dp.bc.mir.calls[block.call]
            if site.kind != MirCallKind.Spawn || (site.spawn != MirSpawnForm.Group && site.spawn != MirSpawnForm.Singleton) {
                continue
            }
            let root = coro.mono.call_item(block.call)
            if root < 0 || checked[root] {
                continue
            }
            // A site passing a closure is judged by that closure, so a root
            // is checked once only when no site of it passes one. The
            // spawner's own parameters are no frame's, so they pass nothing.
            let closures = coro_call_closures(&coro, f, block.call, &none)
            if not coro_passes_closure(&closures) {
                checked[root] = true
            }
            if coro_check_root(&var coro, root, info.module, &closures) {
                checked[root] = true
            }
        }
    }
}

// The closures call `c` in MIR function `f` passes its callee, by the
// callee's parameter local: each one's ordinal in typecheck's closure table,
// or -1. An argument passes a closure when it is a closure written there, or
// a parameter of `f` that `outer`, by `f`'s own parameter locals, says holds
// one; so a closure handed down a chain of calls reaches every frame on it.
// Any other function value, a field's, an element's or a named local's, keeps
// its written type.
func coro_call_closures(coro: &CoroProgram, f: Int, c: Int, outer: &Vector<Int>) -> Vector<Int> {
    var out = Vector<Int>()
    try! out.push(-1)
    let call = coro.mono.dp.bc.mir.calls[c]
    var k = mir_spawn_leading(&call)
    while k < call.arg_count {
        let o = coro.mono.dp.bc.mir.operands[coro.mono.dp.bc.mir.lists[call.arg_first + k]]
        try! out.push(coro_operand_closure(&coro, f, o.place, &outer, 0))
        k = k + 1
    }
    move out
}

// The closure place `p` of MIR function `f` holds as a call's argument, or
// -1: one of `f`'s parameters holds what `outer` says, and a temporary holds
// the closure or the argument its one definition makes.
func coro_operand_closure(coro: &CoroProgram, f: Int, p: Int, outer: &Vector<Int>, depth: Int) -> Int {
    let info = coro.mono.dp.bc.mir.funcs[f]
    if p < 0 || depth > info.local_count {
        return -1
    }
    let place = coro.mono.dp.bc.mir.places[p]
    let l = place.local
    if l < 1 || place.count != 0 {
        return -1
    }
    if l <= info.param_count {
        return if l < outer.len() { outer[l] } else { -1 }
    }
    if coro.mono.dp.bc.mir.locals[info.local_first + l].name >= 0 {
        return -1
    }
    var found = -1
    var defs = 0
    var b = 0
    while b < info.block_count {
        let block = coro.mono.dp.bc.mir.blocks[info.block_first + b]
        b = b + 1
        var s = block.first
        while s >= 0 {
            let stmt = coro.mono.dp.bc.mir.stmts[s]
            s = stmt.next
            if stmt.kind != MirStmtKind.Assign {
                continue
            }
            let dest = coro.mono.dp.bc.mir.places[stmt.place]
            if dest.local != l || dest.count != 0 {
                continue
            }
            defs = defs + 1
            let rv = coro.mono.dp.bc.mir.rvalues[stmt.rvalue]
            found = -1
            if rv.kind == MirRvalueKind.Aggregate && rv.aggregate == MirAggregate.Closure && rv.decl >= 0 {
                let at = coro.mono.dp.bc.mir.tc.closure_index.first(rv.decl, 0)
                if at >= 0 {
                    found = coro.mono.dp.bc.mir.tc.closure_index.value(at)
                }
            } else if rv.kind == MirRvalueKind.Use && rv.count == 1 {
                let o = coro.mono.dp.bc.mir.operands[coro.mono.dp.bc.mir.lists[rv.first]]
                found = coro_operand_closure(&coro, f, o.place, &outer, depth + 1)
            }
        }
    }
    if defs != 1 {
        return -1
    }
    found
}

// Whether a call's closures, `coro_call_closures`, hold any.
func coro_passes_closure(closures: &Vector<Int>) -> Bool {
    var k = 0
    while k < closures.len() {
        if closures[k] >= 0 {
            return true
        }
        k = k + 1
    }
    false
}

// THE FRAME'S SEND JUDGMENT: checks task root `root`'s frame, its children's,
// and its result, judging conformances as module `viewer`, where the spawn is
// written, sees them, and a function-typed parameter a closure is passed to
// by that closure (`closures`, the root's, by parameter local). Returns
// whether it refused one. A `group.spawn` site and a `Task.spawn` site reach
// it through `coro_check_frame_send`'s walk, whatever the group; a root's
// function-typed parameter and an embedded child's both get what
// `coro_call_closures` finds their call passing.
// ENTRY POINTS:
//     group.spawn
//     Task.spawn
//     coro_call_closures
func coro_check_root(coro: &var CoroProgram, root: Int, viewer: Int, closures: &Vector<Int>) -> Bool {
    let rf = coro_frame_of(&coro, root)
    if rf < 0 {
        return false
    }
    var seen = Vector<Bool>()
    var k = 0
    while k < coro.mono.items.len() {
        try! seen.push(false)
        k = k + 1
    }
    if coro_check_frame(&var coro, root, root, viewer, &closures, &var seen) {
        return true
    }
    let frame = coro.frames[rf]
    let info = coro.mono.dp.bc.mir.funcs[frame.body]
    let result = coro.mono.dp.bc.mir.locals[info.local_first].ty
    if coro_crosses(&var coro, result, viewer) {
        return false
    }
    var msg = coro_send_lead(&coro, root)
    try! msg.append("its result type `")
    try! msg.append(coro.mono.dp.bc.mir.tc.type_text(result))
    try! msg.append("` is not `Send`")
    try! msg.append(coro.mono.dp.bc.mir.tc.sendable_hint(result))
    try! msg.append(", so the value cannot travel back from the worker thread to `join()`.")
    let node = coro.item_node(root)
    coro.refuse(root, node, "coro.spawn-not-send", msg.build())
    true
}

// Refuses the first value of item `item`'s frame that cannot cross, or of
// a child's it embeds, in the order Stage 0 names them: parameters, then
// resident locals, then each child's. `closures` is what the item's call
// passes its parameters. An item on the walk's path is not entered again,
// and one passed no closure is judged once. Returns whether it refused one.
func coro_check_frame(coro: &var CoroProgram, root: Int, item: Int, viewer: Int, closures: &Vector<Int>,
                      seen: &var Vector<Bool>) -> Bool {
    if seen[item] {
        return false
    }
    let rf = coro_frame_of(&coro, item)
    if rf < 0 {
        return false
    }
    seen[item] = true
    let refused = coro_check_frame_values(&var coro, root, item, rf, viewer, &closures, &var seen)
    if coro_passes_closure(&closures) {
        seen[item] = false
    }
    refused
}

// `coro_check_frame`'s walk of frame `rf`, item `item`'s.
func coro_check_frame_values(coro: &var CoroProgram, root: Int, item: Int, rf: Int, viewer: Int,
                             closures: &Vector<Int>, seen: &var Vector<Bool>) -> Bool {
    let frame = coro.frames[rf]
    let info = coro.mono.dp.bc.mir.funcs[frame.body]
    var pass = 0
    while pass < 2 {
        var v = 0
        while v < frame.value_count {
            let value = coro.values[frame.value_first + v]
            v = v + 1
            let wanted = if pass == 0 { CoroValueKind.Param } else { CoroValueKind.Local }
            if value.kind != wanted || value.ty < 0 {
                continue
            }
            let passed = if pass == 0 && value.local < closures.len() { closures[value.local] } else { -1 }
            if passed >= 0 && coro.mono.dp.bc.mir.tc.kind_of(value.ty) == TcKind.Func {
                let block = coro.mono.dp.bc.mir.tc.settled_blocker(passed)
                if block.trait_decl < 0 {
                    continue
                }
                let local = coro.mono.dp.bc.mir.locals[info.local_first + value.local]
                coro_refuse_closure(&var coro, root, item, local.name, value.ty, passed, &block)
                return true
            }
            if coro_crosses(&var coro, value.ty, viewer) {
                continue
            }
            let local = coro.mono.dp.bc.mir.locals[info.local_first + value.local]
            coro_refuse_value(&var coro, root, item, pass == 0, local.name, value.ty)
            return true
        }
        pass = pass + 1
    }
    // The children, in the order of the calls that drive them, which is the
    // frame's order of their slots.
    var j = 0
    while j < frame.suspend_count {
        let call = coro.suspends[frame.suspend_first + j].call
        j = j + 1
        let child = coro_driven_child(&coro, call)
        if child < 0 {
            continue
        }
        let passed = coro_call_closures(&coro, frame.body, call, &closures)
        if coro_check_frame(&var coro, root, child, viewer, &passed, &var seen) {
            return true
        }
    }
    false
}

func coro_refuse_value(coro: &var CoroProgram, root: Int, item: Int, param: Bool, name: Int, ty: Int) {
    var msg = coro_send_lead(&coro, root)
    if param {
        try! msg.append("parameter `")
    } else if name >= 0 {
        try! msg.append("local `")
    } else {
        try! msg.append("a temporary")
    }
    if name >= 0 {
        try! msg.append(coro.mono.dp.bc.mir.tc.name_text(name))
        try! msg.append("`")
    }
    try! msg.append(" of type `")
    try! msg.append(coro.mono.dp.bc.mir.tc.type_text(ty))
    try! msg.append("`")
    if item != root {
        try! msg.append(" in `")
        try! msg.append(coro.item_label(item))
        try! msg.append("`")
    }
    let hint = coro.mono.dp.bc.mir.tc.sendable_hint(ty)
    if param {
        try! msg.append(" is not `Send`")
        try! msg.append(hint)
        try! msg.append(", so the task frame cannot cross to a worker thread. Share thread-safe state via `Arc` (and `Mutex` for mutation) or a `Channel` instead of moving it in.")
    } else {
        try! msg.append(" is held across a suspension but is not `Send`")
        try! msg.append(hint)
        try! msg.append(", so the task frame cannot cross to a worker thread.")
    }
    let node = coro.item_node(item)
    coro.refuse(item, node, "coro.spawn-not-send", msg.build())
}

// Refuses parameter `name` of item `item`, in root `root`'s frame, of
// function type `ty`, which holds the closure its call passes (`passed`, its
// ordinal), for the capture
// `block` that keeps the closure from being `sendable`. The refusal sits at
// the closure, where the capture to change is written.
func coro_refuse_closure(coro: &var CoroProgram, root: Int, item: Int, name: Int, ty: Int, passed: Int,
                         block: &TcCaptureBlock) {
    var msg = coro_send_lead(&coro, root)
    try! msg.append("parameter `")
    if name >= 0 {
        try! msg.append(coro.mono.dp.bc.mir.tc.name_text(name))
    }
    try! msg.append("` of type `")
    try! msg.append(coro.mono.dp.bc.mir.tc.type_text(ty))
    try! msg.append("`")
    if item != root {
        try! msg.append(" in `")
        try! msg.append(coro.item_label(item))
        try! msg.append("`")
    }
    try! msg.append(" holds this closure, and the closure is not `sendable`, since ")
    try! msg.append(coro.mono.dp.bc.mir.tc.capture_block_text(&block))
    try! msg.append(", so the task frame cannot cross to a worker thread.")
    let node = coro.mono.dp.bc.mir.tc.closures[passed]
    coro.refuse(root, node, "coro.spawn-not-send", msg.build())
}

// The sentence every refusal of the gate starts with, naming root `root`.
func coro_send_lead(coro: &CoroProgram, root: Int) -> StringBuilder {
    var msg = StringBuilder()
    try! msg.append("cannot spawn `")
    try! msg.append(coro.item_label(root))
    try! msg.append("`: ")
    move msg
}

// Whether a value of type `t` can cross to another thread: it is `Send`, as
// module `viewer` sees the conformances. `Void` and `Never` hold no bytes to
// carry, though neither derives `Send`.
func coro_crosses(coro: &var CoroProgram, t: Int, viewer: Int) -> Bool {
    let send = coro.mono.dp.bc.mir.tc.known.send
    if send < 0 || coro.mono.dp.bc.mir.tc.is_void(t) || coro.mono.dp.bc.mir.tc.is_never(t) {
        return true
    }
    coro.mono.dp.bc.mir.tc.satisfies(t, send, -1, -1, viewer, false)
}
