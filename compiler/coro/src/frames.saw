// What each framed item's frame holds: the state word, the op-budget counter
// when the body has an op-budget point, the result `_0`, every parameter,
// which the caller writes into the frame before the first resume, every
// other local whose storage lifetime contains a suspension point, the
// embedded frame of each child it drives, and the storage of each `blocking`
// extern call it offloads. A local whose lifetime holds none stays on the
// resume function's stack. The frame has no drop glue: every drop stays
// where drop elaboration placed it. Each value's lifetime is the lifetimes
// funnel's (`compiler/coro/src/lifetimes.saw`).
//
// ENTRY POINTS of the frame contents:
//   coro_find_frames
//   coro_frame_of
//   coro_driven_child
//   coro_offloaded_extern

import sawborrowck.program.{BorrowckProgram}
import sawcoro.lifetimes.{CoroLifetimes, coro_lifetime_append, coro_lifetime_resident, coro_lifetimes_of}
import sawcoro.program.{CoroFrame, CoroProgram, CoroValue, CoroValueKind}
import sawdrops.program.{DropsProgram}
import sawmir.model.{MirCallKind}
import sawmir.program.{MirProgram}
import sawmono.program.{MonoItemKind, MonoProgram}
import sawtypecheck.model.{TC_FLAG_BLOCKING}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.signatures.{TcContext}
import sawtypecheck.typeops.{TcClient}

// Finds the frame of every item that needs one: its suspension points, each
// value it holds, and each value's storage lifetime over the item's program
// points. Nothing is found for a program whose suspending-call graph has a
// cycle, since no frame in it is finite.
public func coro_find_frames(coro: &var CoroProgram) {
    coro.frame_of = Vector<Int>()
    var k = 0
    while k < coro.mono.items.len() {
        try! coro.frame_of.push(-1)
        k = k + 1
    }
    if coro.cyclic {
        return
    }
    k = 0
    while k < coro.mono.items.len() {
        let item = k
        k = k + 1
        if coro.needs_frame(item) && coro.mono.items[item].body >= 0 {
            // Stage 0 workaround (SL:hazards S4): canonical: coro.frame_of[item] = coro.frames.len()
            let at = coro.frames.len()
            coro.frame_of[item] = at
            coro_find_frame(&var coro, item)
        }
    }
}

// The index of item `k`'s frame in `coro.frames`, or -1 when it has none.
public func coro_frame_of(coro: &CoroProgram, k: Int) -> Int {
    if k < 0 || k >= coro.frame_of.len() {
        return -1
    }
    coro.frame_of[k]
}

// Item `item`'s frame, appended to `coro.frames`, with its suspension points
// and its values in the frame's order, each with its lifetime.
func coro_find_frame(coro: &var CoroProgram, item: Int) {
    let f = coro.mono.items[item].body
    let info = coro.mono.dp.bc.mir.funcs[f]
    let lt = coro_lifetimes_of(&coro, f)
    let suspend_first = coro.suspends.len()
    var j = 0
    while j < lt.suspends.len() {
        try! coro.suspends.push(lt.suspends[j])
        j = j + 1
    }
    let value_first = coro.values.len()
    let word = coro.mono.dp.bc.mir.tc.int_type()
    coro_add_value(&var coro, &lt, CoroValueKind.State, -1, -1, word, -1)
    if lt.charges {
        coro_add_value(&var coro, &lt, CoroValueKind.Budget, -1, -1, word, -1)
    }
    var l = 0
    while l < info.local_count {
        let local = coro.mono.dp.bc.mir.locals[info.local_first + l]
        var kind = CoroValueKind.Local
        if l == 0 {
            kind = CoroValueKind.Result
        } else if l <= info.param_count {
            kind = CoroValueKind.Param
        }
        if kind != CoroValueKind.Local || coro_lifetime_resident(&lt, l) {
            coro_add_value(&var coro, &lt, kind, l, -1, local.ty, -1)
        }
        l = l + 1
    }
    // A child slot and an offload's storage each serve one suspending call,
    // in the order of the calls.
    j = 0
    while j < lt.suspends.len() {
        let call = lt.suspends[j].call
        let s = j
        j = j + 1
        let child = coro_driven_child(&coro, call)
        let offloaded = coro_offloaded_extern(&coro, call)
        if child >= 0 {
            coro_add_value(&var coro, &lt, CoroValueKind.Child, -1, child, -1, s)
        } else if offloaded >= 0 {
            let ty = coro_offload_storage_type(&var coro, call)
            coro_add_value(&var coro, &lt, CoroValueKind.Offload, -1, offloaded, ty, s)
        }
    }
    // Stage 0 workaround (SL:hazards S4): canonical: try! coro.frames.push(CoroFrame(item: item, body: f, points: lt.points, suspend_first: suspend_first, suspend_count: coro.suspends.len() - suspend_first, value_first: value_first, value_count: coro.values.len() - value_first, size: -1, align: -1, unsupported: -1))
    let suspend_count = coro.suspends.len() - suspend_first
    let value_count = coro.values.len() - value_first
    try! coro.frames.push(CoroFrame(item: item, body: f, points: lt.points, suspend_first: suspend_first,
                                    suspend_count: suspend_count, value_first: value_first, value_count: value_count,
                                    size: -1, align: -1, unsupported: -1))
}

// Appends a frame value of kind `kind`, with its lifetime: `l` is its local
// or -1, `child` the item a child slot is the frame of or the extern an
// offload's storage serves, else -1, and `s` a child's or an offload's
// suspension point, else -1.
func coro_add_value(coro: &var CoroProgram, lt: &CoroLifetimes, kind: CoroValueKind, l: Int, child: Int, ty: Int,
                    s: Int) {
    let live_first = coro_lifetime_append(&var coro, &lt, kind, l, s)
    try! coro.values.push(CoroValue(kind: kind, local: l, child: child, ty: ty, live_first: live_first, offset: -1,
                                    size: -1, align: -1))
}

// The item a suspending call `c` drives as an embedded child, or -1: the
// call's target needs a frame of its own. A source has none to drive.
public func coro_driven_child(coro: &CoroProgram, c: Int) -> Int {
    if c < 0 {
        return -1
    }
    let t = coro.mono.call_item(c)
    if t < 0 || not coro.needs_frame(t) || coro.mono.items[t].body < 0 {
        return -1
    }
    t
}

// The extern a suspending call `c` offloads, or -1: a call of a `blocking`
// extern runs on a thread of its own while its frame parks (design 103).
// Every offloaded call is found here, so the frame's storage, its lowering
// and the verifier's check of it agree on which calls they are.
public func coro_offloaded_extern(coro: &CoroProgram, c: Int) -> Int {
    if c < 0 || coro.mono.dp.bc.mir.calls[c].kind != MirCallKind.Function {
        return -1
    }
    let t = coro.mono.call_item(c)
    if t < 0 || coro.mono.items[t].kind != MonoItemKind.Extern {
        return -1
    }
    let d = coro.mono.items[t].decl
    if d < 0 || d >= coro.mono.dp.bc.mir.tc.sigs.len() || (coro.mono.dp.bc.mir.tc.sigs[d].flags & TC_FLAG_BLOCKING) == 0 {
        return -1
    }
    t
}

// The type of offloaded call `c`'s storage, `[Int; N + 1]` for an extern of
// N parameters: the job word, then each argument widened to a word, which is
// the slot array the runtime's offload seam copies (runtime/ABI.md).
func coro_offload_storage_type(coro: &var CoroProgram, c: Int) -> Int {
    let word = coro.mono.dp.bc.mir.tc.int_type()
    let t = coro.mono.call_item(c)
    let d = coro.mono.items[t].decl
    let count = coro.mono.dp.bc.mir.tc.sigs[d].param_count + 1
    let length = coro.mono.dp.bc.mir.tc.mk_const(count)
    coro.mono.dp.bc.mir.tc.mk_array(word, length)
}
