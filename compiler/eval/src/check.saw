// The evaluator's verifier and its dump. The verifier checks that every
// constant position lowered has an evaluation that ended: a value of its own
// type, or a refusal, or no value because a constant it reads was refused;
// and that typecheck's fold (`fold.saw`), which computes the same constants
// from the tree, agrees with every one: the same value at the same type, or
// the same fault. The only constants it skips are those the fold has no form
// for: a position of a type that is neither an integer nor a `Bool`, and a
// value that is an enum case, an atomic or an aggregate.

import sawmir.dump.{mir_module_functions}
import sawmir.model.{MirFuncKind}
import sawmir.program.{MirProgram}
import saweval.program.{EvalEnd, EvalKind, EvalProgram, EvalValue, eval_is_constant_kind}
import sawresolve.dump.{res_sort_strings}
import sawresolve.program.{ResProgram}
import sawtypecheck.arith.{TcFault, tc_arith_text}
import sawtypecheck.fold.{TcFold}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}

extension EvalProgram {
    // Every problem the verifier finds with module `m`'s constants. The
    // program is borrowed exclusively because typecheck's fold, which the
    // agreement check runs, takes its program so.
    public func verify_module(&var self, mir: &var MirProgram, m: Int) -> Vector<String> {
        var out = Vector<String>()
        let order = mir_module_functions(&mir, m)
        var k = 0
        while k < order.len() {
            let f = order[k]
            k = k + 1
            let info = mir.funcs[f]
            if not eval_is_constant_kind(info.kind) {
                continue
            }
            let v = self.values[f]
            let end = self.ends[f]
            if end == EvalEnd.Pending {
                self.problem(&mir, f, &var out, "a constant position was never evaluated")
                continue
            }
            if end == EvalEnd.Deferred {
                continue
            }
            if end == EvalEnd.Valued {
                let want = mir.locals[info.local_first].ty
                if v.kind == EvalKind.Missing || v.ty != want {
                    self.problem(&mir, f, &var out, "a constant's value is not of its position's type")
                }
            }
            self.verify_agreement(&var mir, f, &var out)
        }
        move out
    }

    // The evaluator and typecheck's fold agree on constant `f`.
    func verify_agreement(&var self, mir: &var MirProgram, f: Int, out: &var Vector<String>) {
        let v = self.values[f]
        if v.kind == EvalKind.Case || v.kind == EvalKind.Cell || v.kind == EvalKind.Aggregate || v.kind == EvalKind.Repeat {
            return
        }
        // The fold folds integers and `Bool`s only, so at a position of any
        // other type it has nothing to agree with, a fault included.
        let t = mir.locals[mir.funcs[f].local_first].ty
        if not mir.tc.is_integer(t) && not mir.tc.is_bool(t) {
            return
        }
        let root = mir.funcs[f].root
        let fold = mir.tc.fold_constant(root)
        var same = false
        if v.kind == EvalKind.Integer || v.kind == EvalKind.Boolean {
            same = fold.ok && fold.ty == v.ty && fold.bits == v.bits
        } else if v.kind == EvalKind.Missing {
            same = not fold.ok && fold.fault == v.fault
        }
        if same {
            return
        }
        var text = StringBuilder()
        try! text.append("the evaluator and typecheck's fold disagree: the evaluator's ")
        try! text.append(self.value_text(&mir, &v))
        try! text.append(", the fold's ")
        try! text.append(self.fold_text_of(&mir, &fold))
        self.problem(&mir, f, &var out, text.build())
    }

    func problem(&self, mir: &MirProgram, f: Int, out: &var Vector<String>, text: String) {
        let info = mir.funcs[f]
        var line = StringBuilder()
        try! line.append(mir.tc.res.node_position(info.module, info.root))
        try! line.append(" ")
        try! line.append(mir.func_name(f))
        try! line.append(": ")
        try! line.append(text)
        try! out.push(line.build())
    }

    // A value as the dump writes it: an integer in decimal, `true`, `false`,
    // a case's identity, an aggregate's parts in order (`TYPE { a, b }` for
    // a struct, `[a, b]` for an array, `[v; N]` for a repeat), or the fault
    // that left none.
    public func value_text(&self, mir: &MirProgram, v: &EvalValue) -> String {
        match v.kind {
            case Aggregate -> {
                var out = StringBuilder()
                if v.decl >= 0 {
                    try! out.append(mir.tc.type_text(v.ty))
                    try! out.append(" \{ ")
                } else {
                    try! out.append("[")
                }
                var k = 0
                while k < v.count {
                    if k > 0 {
                        try! out.append(", ")
                    }
                    let part = self.parts[v.bits + k]
                    try! out.append(self.value_text(&mir, &part))
                    k = k + 1
                }
                if v.decl >= 0 {
                    try! out.append(" \}")
                } else {
                    try! out.append("]")
                }
                out.build()
            },
            case Repeat -> {
                var out = StringBuilder()
                try! out.append("[")
                let part = self.parts[v.bits]
                try! out.append(self.value_text(&mir, &part))
                try! out.append("; ")
                try! out.append(v.count)
                try! out.append("]")
                out.build()
            },
            case Integer -> tc_arith_text(v.bits, mir.tc.int_width(v.ty), not mir.tc.is_unsigned(v.ty)),
            case Boolean -> if v.bits != 0 { "true" } else { "false" },
            case Case -> mir.tc.res.decl_identity(v.decl),
            case Unit -> "()",
            case Cell -> {
                var out = StringBuilder()
                try! out.append(mir.tc.type_text(v.ty))
                try! out.append("(")
                try! out.append(tc_arith_text(v.bits, 64, true))
                try! out.append(")")
                out.build()
            },
            case Missing -> eval_fault_name(v.fault)
        }
    }

    func fold_text_of(&self, mir: &MirProgram, fold: &TcFold) -> String {
        if fold.ok {
            var out = StringBuilder()
            try! out.append(mir.tc.fold_text(&fold))
            try! out.append(": ")
            try! out.append(mir.tc.type_text(fold.ty))
            return out.build()
        }
        eval_fault_name(fold.fault)
    }

    // Module `m`'s constants, one line each: `NAME: TYPE = VALUE`, or
    // `NAME: TYPE (no value)` when its evaluation was refused or read a
    // refused constant.
    public func dump_module(&self, mir: &MirProgram, out: &var StringBuilder, m: Int) {
        try! out.append("module ")
        try! out.append(mir.tc.res.module_name(m))
        try! out.append("\n")
        let order = mir_module_functions(&mir, m)
        var k = 0
        while k < order.len() {
            let f = order[k]
            k = k + 1
            let info = mir.funcs[f]
            if not eval_is_constant_kind(info.kind) {
                continue
            }
            try! out.append(mir.func_name(f))
            try! out.append(": ")
            let t = mir.locals[info.local_first].ty
            mir.append_type(&var out, t)
            let v = self.values[f]
            if self.ends[f] == EvalEnd.Deferred {
                try! out.append(" (checked against the layout)\n")
            } else if v.kind == EvalKind.Missing {
                try! out.append(" (no value)\n")
            } else {
                try! out.append(" = ")
                try! out.append(self.value_text(&mir, &v))
                try! out.append("\n")
            }
        }
    }
}

public func eval_fault_name(fault: TcFault) -> String {
    match fault {
        case Clean -> "no fault",
        case Overflow -> "an overflow",
        case ShiftRange -> "a shift out of range",
        case DivideByZero -> "a division by zero",
        case NotFit -> "a value that does not fit",
        case NotConstant -> "no constant",
        case Cycle -> "a cycle"
    }
}
