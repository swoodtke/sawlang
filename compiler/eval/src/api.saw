// The evaluator's entry point: a program checked, lowered, its constants
// evaluated, and the record `sawc eval` prints for it.

import sawasserts.layout.{asserts_inputs}
import sawmir.api.{mir_append_diag, mir_append_dumps, mir_append_invariants, mir_append_module_checks,
                       mir_append_refusals, mir_empty_front, mir_run_layer, mir_status}
import sawmir.program.{MirProgram}
import sawresolve.layer.{FrontLayer, FrontLayerKind, front_layer}
import saweval.check.{eval_fault_name}
import saweval.interp.{eval_step_budget}
import saweval.program.{EvalProgram, eval_program}
import saweval.report.{eval_rules}
import sawtypecheck.program.{TcTarget}

// How `sawc eval` treats one entry file.
public struct EvalOptions {
    std_root: String
    // Print each module's constants and their values.
    dump: Bool
    notes: Bool
    // The target the program is checked for (`target_front_end`).
    target: TcTarget
}

// What std's layer left a record to print: its modules' verifier lines from
// the MIR stage, when its layer verified them as it ran; with `verified_std`
// false, nothing was verified yet, and the record verifies every module.
public struct EvalStart {
    checked: String
    verified_std: Bool
}

// The record of one program evaluated, after its `FILE` line: everything
// `sawc mir --check` prints, then the evaluator's refusals, each an `ERROR`
// line, then an `INVARIANT` line per problem its verifier finds, and with
// `dump` each lowered module's constants. Returns 0 when nothing was refused
// and 1 otherwise. The lowering is counted in `lowerings`.
// Each layer's constants are evaluated in its step, as a build evaluates them.
public func eval_record(out: &var StringBuilder, path: String, options: &EvalOptions, names: &Vector<String>,
                        dirs: &Vector<String>, lowerings: &var Int) -> Int {
    var lowered = mir_empty_front(options.std_root, options.target)
    var p = eval_program(&lowered)
    let inputs = asserts_inputs(path, &names, &dirs, options.target, false)
    var layer = front_layer(FrontLayerKind.Std)
    mir_run_layer(&var lowered, &var layer, &inputs)
    p.grow(&lowered)
    p.evaluate_all(&lowered, &layer)
    let start = EvalStart(checked: "", verified_std: false)
    eval_record_from(out: &var out, lowered: &var lowered, p: &var p, start: start, path: path, options: &options,
                     names: &names, dirs: &dirs, lowerings: &var lowerings)
}

// `eval_record` for program `lowered` and its values `p`, which std's layer
// has already run over, leaving `start`: std's cut, computed here or by mono,
// or read from an image. The program's layer runs from there. The
// evaluator's verifier checks only the program's modules when std's layer
// was verified as it ran: making the cut verified std's values, and its
// lines are in `start.checked`.
public func eval_record_from(out: &var StringBuilder, lowered: &var MirProgram, p: &var EvalProgram,
                             start: EvalStart, path: String, options: &EvalOptions, names: &Vector<String>,
                             dirs: &Vector<String>, lowerings: &var Int) -> Int {
    let inputs = asserts_inputs(path, &names, &dirs, options.target, false)
    var layer = front_layer(FrontLayerKind.Program)
    mir_run_layer(&var lowered, &var layer, &inputs)
    p.grow(&lowered)
    p.evaluate_all(&lowered, &layer)
    lowerings = lowerings + 1
    let first = if start.verified_std { layer.module_first } else { 0 }
    mir_append_refusals(out: &var out, p: &lowered, notes: options.notes)
    try! out.append(start.checked)
    mir_append_module_checks(out: &var out, p: &var lowered, first: first)
    var status = mir_status(&lowered)
    var k = 0
    while k < p.diags.len() {
        let d = p.diags[k]
        mir_append_diag(out: &var out, p: &lowered, d: &d)
        k = k + 1
    }
    if p.diags.len() > 0 {
        status = 1
    }
    var m = first
    while m < lowered.tc.res.module_count() {
        let found = p.verify_module(&var lowered, m)
        mir_append_invariants(out: &var out, p: &lowered, m: m, problems: &found)
        m = m + 1
    }
    if options.dump {
        m = 0
        while m < lowered.tc.res.module_count() {
            let info = lowered.tc.res.module(m)
            if info.available && not info.interface_only {
                p.dump_module(&lowered, &var out, m)
                try! out.append("\n")
            }
            m = m + 1
        }
    }
    status
}
