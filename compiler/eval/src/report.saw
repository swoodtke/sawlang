// The evaluator's refusals. Each is reported once, at the constant whose
// evaluation met it, with the statics the evaluation went through to get
// there; a constant that reads a refused one is left with no value and no
// refusal of its own.

import sawmir.dump.{mir_operator_name}
import sawmir.model.{MirDiag, MirFuncKind}
import sawmir.program.{MirProgram}
import saweval.program.{EvalEnd, EvalKind, EvalProgram, EvalValue, eval_missing}
import sawtypecheck.arith.{TcFault, tc_arith_max, tc_arith_min, tc_arith_text}
import sawtypecheck.program.{TcProgram}
import sawtypecheck.spell.{tc_effects_text}
import sawtypecheck.typeops.{TcClient}

// Every rule the evaluator refuses by.
public func eval_rules() -> Vector<String> {
    var out = Vector<String>()
    try! out.push("eval.assert")
    try! out.push("eval.cycle")
    try! out.push("eval.divide-by-zero")
    try! out.push("eval.not-fit")
    try! out.push("eval.overflow")
    try! out.push("eval.shift-range")
    try! out.push("slice.not-yet")
    move out
}

extension EvalProgram {
    // Constant `f` as a refusal's subject names it: `static m.A` quoted, or
    // the `static_assert` at its condition's position, which has no name of
    // its own.
    public func constant_subject(&self, mir: &MirProgram, f: Int) -> String {
        var out = StringBuilder()
        let info = mir.funcs[f]
        if info.kind == MirFuncKind.Assert {
            try! out.append("the `static_assert` at ")
            try! out.append(mir.tc.res.node_position(info.module, info.root))
            return out.build()
        }
        try! out.append("`")
        try! out.append(mir.func_name(f))
        try! out.append("`")
        out.build()
    }

    // Constant `f` as a list of the statics an evaluation went through names
    // it: its MIR function's name, or the `static_assert` at its position.
    public func constant_listed(&self, mir: &MirProgram, f: Int) -> String {
        let info = mir.funcs[f]
        if info.kind == MirFuncKind.Assert {
            return self.constant_subject(&mir, f)
        }
        mir.func_name(f)
    }

    // A construct outside the evaluator's set, met in function `f`.
    public func not_yet(&var self, mir: &MirProgram, f: Int, what: String) -> EvalValue {
        var msg = StringBuilder()
        try! msg.append(what)
        try! msg.append(" in ")
        try! msg.append(self.constant_subject(&mir, f))
        try! msg.append(" is not evaluated as a constant in the bootstrap slice yet")
        self.report_at(&mir, f, "slice.not-yet", msg.build())
        self.last_fault = TcFault.NotConstant
        eval_missing(TcFault.NotConstant)
    }

    // An arithmetic fault in function `f`, in an operation at type `t`.
    public func fault(&var self, mir: &MirProgram, f: Int, fault: TcFault, bits: Int, t: Int) -> EvalValue {
        if fault == TcFault.NotFit {
            return self.fault_value(&mir, f, bits, -1, t)
        }
        var msg = StringBuilder()
        try! msg.append(self.constant_subject(&mir, f))
        var rule = "eval.overflow"
        if fault == TcFault.Overflow {
            try! msg.append(" overflows `")
            try! msg.append(mir.tc.type_text(t))
            try! msg.append("` (range ")
            try! msg.append(self.range_text(&mir, t))
            try! msg.append(")")
        } else if fault == TcFault.ShiftRange {
            rule = "eval.shift-range"
            try! msg.append(" shifts a value of type `")
            try! msg.append(mir.tc.type_text(t))
            try! msg.append("` by a count outside its width")
        } else if fault == TcFault.DivideByZero {
            rule = "eval.divide-by-zero"
            try! msg.append(" divides by zero")
        } else {
            rule = "slice.not-yet"
            try! msg.append(" is not a constant the bootstrap slice evaluates yet")
        }
        self.report_at(&mir, f, rule, msg.build())
        self.last_fault = fault
        eval_missing(fault)
    }

    // Value `bits` of type `from` (-1 for a literal's magnitude, read
    // unsigned) that type `to` cannot hold, met in function `f`.
    public func fault_value(&var self, mir: &MirProgram, f: Int, bits: Int, from: Int, to: Int) -> EvalValue {
        var msg = StringBuilder()
        try! msg.append(self.constant_subject(&mir, f))
        try! msg.append(": ")
        if from >= 0 && mir.tc.is_integer(from) {
            try! msg.append(tc_arith_text(bits, mir.tc.int_width(from), not mir.tc.is_unsigned(from)))
        } else {
            try! msg.append(tc_arith_text(bits, 64, from >= 0))
        }
        try! msg.append(" does not fit in `")
        try! msg.append(mir.tc.type_text(to))
        try! msg.append("` (range ")
        try! msg.append(self.range_text(&mir, to))
        try! msg.append(")")
        self.report_at(&mir, f, "eval.not-fit", msg.build())
        self.last_fault = TcFault.NotFit
        eval_missing(TcFault.NotFit)
    }

    // Integer type `t`'s range.
    func range_text(&self, mir: &MirProgram, t: Int) -> String {
        let w = mir.tc.int_width(t)
        let signed = not mir.tc.is_unsigned(t)
        var out = StringBuilder()
        try! out.append(tc_arith_text(tc_arith_min(w, signed), w, signed))
        try! out.append("..=")
        try! out.append(tc_arith_text(tc_arith_max(w, signed), w, signed))
        out.build()
    }

    // Function `f` reached again while it is being evaluated: the statics
    // from its first entry to here, and itself again.
    public func report_cycle(&var self, mir: &MirProgram, f: Int) {
        var msg = StringBuilder()
        try! msg.append(self.constant_subject(&mir, f))
        try! msg.append(" depends on its own value: ")
        var from = 0
        var k = 0
        while k < self.stack.len() {
            if self.stack[k] == f {
                from = k
            }
            k = k + 1
        }
        k = from
        while k < self.stack.len() {
            let g = self.stack[k]
            try! msg.append(self.constant_listed(&mir, g))
            try! msg.append(", ")
            k = k + 1
        }
        try! msg.append(self.constant_listed(&mir, f))
        self.report_bare(&mir, f, "eval.cycle", msg.build())
        self.last_fault = TcFault.Cycle
    }

    // The step budget's refusal: the statics under way when it ran out.
    public func budget_text(&self, mir: &MirProgram) -> String {
        var msg = StringBuilder()
        try! msg.append("the evaluation runs past its step budget, through ")
        var k = 0
        while k < self.stack.len() {
            if k > 0 {
                try! msg.append(", ")
            }
            let g = self.stack[k]
            try! msg.append(self.constant_listed(&mir, g))
            k = k + 1
        }
        msg.build()
    }

    // A refusal at constant `f`'s expression, with the statics evaluated to
    // reach it, outermost first.
    public func report_at(&var self, mir: &MirProgram, f: Int, rule: String, message: String) {
        var msg = StringBuilder()
        try! msg.append(message)
        if self.stack.len() > 1 {
            try! msg.append("; evaluated for ")
            var k = 0
            while k + 1 < self.stack.len() {
                if k > 0 {
                    try! msg.append(", ")
                }
                let g = self.stack[k]
                try! msg.append(self.constant_listed(&mir, g))
                k = k + 1
            }
        }
        self.report_bare(&mir, f, rule, msg.build())
    }

    func report_bare(&var self, mir: &MirProgram, f: Int, rule: String, message: String) {
        let info = mir.funcs[f]
        let n = mir.tc.res.nodes[info.root]
        try! self.diags.push(MirDiag(module: info.module, start: n.start, end: n.end, id: rule, message: message))
        self.ends[f] = EvalEnd.Refused
    }
}
