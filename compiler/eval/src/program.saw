// The constant evaluator's program: the value table it fills over a MIR
// program it borrows, one entry per MIR function, of which the constant
// positions' are read by later stages (SL:architecture §3.10). The MIR
// program stays its owner's, and the evaluation only reads it, so the one
// lowering a build makes feeds the evaluator and every stage after it.

import sawmir.model.{MirDiag, MirFuncKind}
import sawmir.program.{MirProgram}
import sawresolve.program.{ResProgram}
import sawtypecheck.arith.{TcFault}
import sawtypecheck.program.{TcProgram}

// What an evaluated value is: an integer of type `ty`, a `Bool`, a
// payload-free case `decl` of an enum, `()`, an `Atomic(<int>)` of type `ty`
// whose word is `bits` (SL:open-questions D38), or no value.
public enum EvalKind {
    case Integer,
    case Boolean,
    case Case,
    case Unit,
    case Cell,
    case Missing
}

// A value, or, `Missing`, the fault that left none.
public struct EvalValue {
    kind: EvalKind
    bits: Int
    ty: Int
    decl: Int
    fault: TcFault
}

public func eval_value(kind: EvalKind, bits: Int, ty: Int) -> EvalValue {
    EvalValue(kind: kind, bits: bits, ty: ty, decl: -1, fault: TcFault.Clean)
}

public func eval_missing(fault: TcFault) -> EvalValue {
    EvalValue(kind: EvalKind.Missing, bits: 0, ty: -1, decl: -1, fault: fault)
}

// How a function's evaluation ended: with a value, refused with a
// diagnostic of its own, with no value because a constant it reads was
// refused, or deferred: a `static_assert` over a layout, which is checked
// once layouts exist (SL:open-questions D40).
public enum EvalEnd {
    case Pending,
    case Valued,
    case Refused,
    case Poisoned,
    case Deferred
}

public struct EvalProgram {
    // By MIR function: its value, how its evaluation ended, and whether it is
    // under way.
    values: Vector<EvalValue>
    ends: Vector<EvalEnd>
    active: Vector<Bool>
    // By declaration: the MIR function computing a static's initializer or a
    // raw-backed case's value, or -1.
    constant_of: Vector<Int>
    // The functions being evaluated, outermost first.
    stack: Vector<Int>
    // Steps taken by the evaluation under way, which the step budget bounds.
    steps: Int
    diags: Vector<MirDiag>
    // The fault that stopped the last evaluation step that had one.
    last_fault: TcFault
}

extension EvalProgram: NoCopy {}

// Whether MIR function kind `kind` is a constant position the evaluator
// computes: a static's initializer, a raw-backed case's value, an `@align`
// argument and a `static_assert`'s condition.
public func eval_is_constant_kind(kind: MirFuncKind) -> Bool {
    kind == MirFuncKind.Static || kind == MirFuncKind.RawValue || kind == MirFuncKind.Align || kind == MirFuncKind.Assert
}

// The empty value table over `mir`, every constant position pending.
public func eval_program(mir: &MirProgram) -> EvalProgram {
    var values = Vector<EvalValue>()
    var ends = Vector<EvalEnd>()
    var active = Vector<Bool>()
    let funcs = mir.funcs.len()
    var k = 0
    while k < funcs {
        try! values.push(eval_missing(TcFault.NotConstant))
        try! ends.push(EvalEnd.Pending)
        try! active.push(false)
        k = k + 1
    }
    var constant_of = Vector<Int>()
    let decl_count = mir.tc.res.decl_count()
    k = 0
    while k < decl_count {
        try! constant_of.push(-1)
        k = k + 1
    }
    k = 0
    while k < funcs {
        let info = mir.funcs[k]
        let named = info.kind == MirFuncKind.Static || info.kind == MirFuncKind.RawValue
        if named && info.decl >= 0 && not info.refused {
            constant_of[info.decl] = k
        }
        k = k + 1
    }
    EvalProgram(values: move values, ends: move ends, active: move active,
                constant_of: move constant_of, stack: Vector<Int>(), steps: 0, diags: Vector<MirDiag>(),
                last_fault: TcFault.Clean)
}
