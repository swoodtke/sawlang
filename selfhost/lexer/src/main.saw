// sawlex — the CLI front end for the Saw lexer (design 116).
//
// Usage: sawlex [--docs] <file.saw>
//
// Emits the canonical token dump (one record per line):
//   KIND<TAB>line:col<TAB>escaped-text[<TAB>suffix]
// With `--docs` it instead emits the doc-comment trivia (design 121), one per
// captured `///`/`//!` line:
//   DOC<TAB>line:col<TAB>kind<TAB>escaped-text
// On a lex error either mode emits a single record
//   ERROR<TAB>line:col<TAB>message
// and exits nonzero. See README.md for the format contract.

import src.lib.*
import std.file.{File}
import std.path.{Path}
import std.env.{Env}

func main() -> Int {
    let args = Env.args()
    // Parse an optional leading `--docs` flag, then the file path.
    var docs_mode = false
    var path = ""
    var i = 1
    while i < args.len() {
        let a = args.get(i) ?? ""
        if a.equals("--docs") {
            docs_mode = true
        } else {
            path = a
        }
        i = i + 1
    }
    if path.equals("") {
        print("usage: sawlex [--docs] <file.saw>")
        return 2
    }

    guard var f = File.open(Path(s: path)) else {
        print("sawlex: cannot open {path}")
        return 2
    }
    guard let data = f.read() else {
        print("sawlex: cannot read {path}")
        return 2
    }
    let source = match data.to_string() {
        case Ok(s) -> s,
        case Err(e) -> {
            print("sawlex: {path} is not valid UTF-8 (byte {e.offset})")
            return 2
        }
    }

    if docs_mode {
        match lex_all(source) {
            case Ok(r) -> {
                var j = 0
                while j < r.docs.len() {
                    if let d = r.docs.get(j) {
                        print(format_doc(&d))
                    }
                    j = j + 1
                }
                0
            },
            case Err(e) -> {
                print(format_error(&e))
                1
            }
        }
    } else {
        match lex(source) {
            case Ok(tokens) -> {
                var j = 0
                while j < tokens.len() {
                    if let t = tokens.get(j) {
                        print(format_token(&t))
                    }
                    j = j + 1
                }
                0
            },
            case Err(e) -> {
                print(format_error(&e))
                1
            }
        }
    }
}
