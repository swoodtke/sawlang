// Lex-error cases: positions must match sawc/lexer.py (prose need not).
import src.lib.*

// Assert that lexing `s` fails at exactly line:col.
func expect_err(s: String, line: Int, col: Int, why: String) {
    match lex(s) {
        case Ok(_) -> panic("expected a lex error ({why})"),
        case Err(e) -> {
            assert(e.line == line, "{why}: line {e.line} != {line} ({e.message})")
            assert(e.col == col, "{why}: col {e.col} != {col} ({e.message})")
        }
    }
}

func main() {
    // Unterminated string: quote + "abc" runs to EOF (col past the last byte).
    var us = StringBuilder()
    us.append_char(34 as Int8)      // "
    us.append("abc")
    expect_err(us.build(), 1, 5, "unterminated string")

    // Unknown escape `\q`: error at the escaped char position.
    var be = StringBuilder()
    be.append_char(34 as Int8)      // "
    be.append_char(92 as Int8)      // backslash
    be.append_char(113 as Int8)     // q
    be.append_char(34 as Int8)      // "
    expect_err(be.build(), 1, 4, "unknown escape")

    // Stray `#name`: unknown directive, anchored at the `#`.
    expect_err("#foo", 1, 1, "unknown hash directive")
    // Bare `#` with no name: anchored at the `#`.
    expect_err("#", 1, 1, "empty hash directive")
    // `#` followed by a non-name (space): also an empty-name error at the `#`.
    expect_err("# x", 1, 1, "hash then space")

    // `$` with no digits: error just past the `$`.
    expect_err("$x", 1, 2, "dollar without digits")

    // Out-of-range suffixed literal: 256 does not fit u8 (anchored at the start).
    expect_err("256u8", 1, 1, "256u8 out of range")
    // A hex literal wider than 16 digits overflows a 64-bit integer.
    expect_err("0x1_0000_0000_0000_0000", 1, 1, "hex > 2**64-1")

    // Unexpected character (backtick is not in the grammar).
    var bt = StringBuilder()
    bt.append_char(96 as Int8)      // `
    expect_err(bt.build(), 1, 1, "unexpected char")

    print("errors: ok")
}
