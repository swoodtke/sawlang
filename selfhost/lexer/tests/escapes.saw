// String escapes: \n \t \r \0 \\ \" \{ and \u{...} (incl. non-ASCII).
import src.lib.*

func lexed(s: String) -> LexResult {
    match lex(s) {
        case Ok(r) -> move r,
        case Err(e) -> panic("unexpected lex error at {e.line}:{e.col}: {e.message}")
    }
}

// The canonical dump line for the FIRST token of `s` (String by value, so no
// reference-to-temporary is needed).
func dump0(s: String) -> String {
    let r = lexed(s)
    if let t = r.tokens.get(0) {
        format_token(&t, &r.segments)
    } else {
        panic("no tokens")
    }
}

// Wrap `inner` (the raw bytes between the quotes) into a source string literal.
func lit(inner: String) -> String {
    var sb = StringBuilder()
    try! sb.append(Byte(34))      // opening "
    try! sb.append(inner)
    try! sb.append(Byte(34))      // closing "
    sb.build()
}

func main() {
    // \n \t \r \0 decode to their control bytes; the dump re-escapes them.
    assert(dump0(lit("a\\nb")).equals("STRING\t1:1\ta\\nb"), "backslash-n")
    assert(dump0(lit("a\\tb")).equals("STRING\t1:1\ta\\tb"), "backslash-t")
    assert(dump0(lit("a\\rb")).equals("STRING\t1:1\ta\\rb"), "backslash-r")
    assert(dump0(lit("a\\0b")).equals("STRING\t1:1\ta\\0b"), "backslash-0 NUL")

    // \\ -> one backslash;  \" -> one quote.
    assert(dump0(lit("a\\\\b")).equals("STRING\t1:1\ta\\\\b"), "backslash-backslash")
    assert(dump0(lit("a\\\"b")).equals("STRING\t1:1\ta\"b"), "backslash-quote")

    // \u{41} -> 'A'  (source built byte-wise so the braces are literal).
    var u1 = StringBuilder()
    try! u1.append(Byte(34))      // "
    try! u1.append(Byte(92))      // backslash
    try! u1.append(Byte(117))     // u
    try! u1.append(Byte(123))     // {
    try! u1.append("41")
    try! u1.append(Byte(125))     // }
    try! u1.append(Byte(34))      // "
    assert(dump0(u1.build()).equals("STRING\t1:1\tA"), "backslash-u{41} -> A")

    // \u{1F600} -> the emoji's 4 UTF-8 bytes, emitted verbatim in the dump.
    var u2 = StringBuilder()
    try! u2.append(Byte(34))
    try! u2.append(Byte(92))
    try! u2.append(Byte(117))
    try! u2.append(Byte(123))
    try! u2.append("1F600")
    try! u2.append(Byte(125))
    try! u2.append(Byte(34))
    var exp = StringBuilder()
    try! exp.append("STRING\t1:1\t")
    try! exp.append("😀")
    assert(dump0(u2.build()).equals(exp.build()), "backslash-u{1F600} -> emoji bytes")

    // \{ escaped brace: the value is fully DECODED, so the brace is an ordinary
    // byte and nothing is encoded beside it (design 268 deleted the 0x01
    // sentinel that used to sit here — SL-238); it stays a plain STRING (NOT an
    // interpolation). Expected uses \{ for a literal brace.
    var e1 = StringBuilder()
    try! e1.append(Byte(34))      // "
    try! e1.append(Byte(97))      // a
    try! e1.append(Byte(92))      // backslash
    try! e1.append(Byte(123))     // {
    try! e1.append(Byte(98))      // b
    try! e1.append(Byte(34))      // "
    assert(dump0(e1.build()).equals("STRING\t1:1\ta\{b"), "escaped-brace STRING")

    // A real U+0001 before an escaped brace is CONTENT, not a marker: the two
    // bytes the old protocol used are exactly what `\u{1}\{` produces, and the
    // decode used to delete the U+0001 (SL-238). Both bytes survive now.
    var e2 = StringBuilder()
    try! e2.append(Byte(34))      // "
    try! e2.append(Byte(92))      // backslash
    try! e2.append(Byte(117))     // u
    try! e2.append(Byte(123))     // {
    try! e2.append("1")
    try! e2.append(Byte(125))     // }
    try! e2.append(Byte(92))      // backslash
    try! e2.append(Byte(123))     // {
    try! e2.append(Byte(34))      // "
    assert(dump0(e2.build()).equals("STRING\t1:1\t\\x01\{"), "U+0001 before a brace")

    print("escapes: ok")
}
