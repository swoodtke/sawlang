// Operators, compound assignments, wrapping ops, punctuation, $-params, @.
import src.lib.*

func toks(s: String) -> Vector<Token> {
    match lex(s) {
        case Ok(t) -> move t,
        case Err(e) -> panic("unexpected lex error at {e.line}:{e.col}: {e.message}")
    }
}

func kind(ts: &Vector<Token>, i: Int) -> TokenKind {
    if let t = ts.get(i) { t.kind } else { panic("no token at index {i}") }
}

func at(ts: &Vector<Token>, i: Int) -> String {
    if let t = ts.get(i) { format_token(&t) } else { panic("no token at index {i}") }
}

func main() {
    // Multi-char operators and their single-char fallbacks.
    let a = toks("+= -> && &+ &- &* &= <<= >>= <= >= == != ?? ?. |= ^= %=")
    assert(kind(&a, 0) == TokenKind.PlusAssign, "+=")
    assert(kind(&a, 1) == TokenKind.Arrow, "->")
    assert(kind(&a, 2) == TokenKind.And, "&&")
    assert(kind(&a, 3) == TokenKind.WrapAdd, "&+")
    assert(kind(&a, 4) == TokenKind.WrapSub, "&-")
    assert(kind(&a, 5) == TokenKind.WrapMul, "&*")
    assert(kind(&a, 6) == TokenKind.AmpAssign, "&=")
    assert(kind(&a, 7) == TokenKind.ShlAssign, "<<=")
    assert(kind(&a, 8) == TokenKind.ShrAssign, ">>=")
    assert(kind(&a, 9) == TokenKind.Lte, "<=")
    assert(kind(&a, 10) == TokenKind.Gte, ">=")
    assert(kind(&a, 11) == TokenKind.Eq, "==")
    assert(kind(&a, 12) == TokenKind.Neq, "!=")
    assert(kind(&a, 13) == TokenKind.DoubleQuestion, "??")
    assert(kind(&a, 14) == TokenKind.QuestionDot, "?.")
    assert(kind(&a, 15) == TokenKind.PipeAssign, "|=")
    assert(kind(&a, 16) == TokenKind.CaretAssign, "^=")
    assert(kind(&a, 17) == TokenKind.PercentAssign, "%=")

    // Bare `<<` stays two `<` tokens (nested generics), NOT a shift.
    let b = toks("<<")
    assert(kind(&b, 0) == TokenKind.Lt, "bare << is Lt")
    assert(kind(&b, 1) == TokenKind.Lt, "bare << is Lt Lt")

    // Single-char operators / punctuation (no braces here — see `braces` below).
    let c = toks("& | ^ ~ ! ? < > ( ) [ ] ; , : . @")
    assert(kind(&c, 0) == TokenKind.Ampersand, "&")
    assert(kind(&c, 1) == TokenKind.Pipe, "|")
    assert(kind(&c, 2) == TokenKind.Caret, "^")
    assert(kind(&c, 3) == TokenKind.Tilde, "~")
    assert(kind(&c, 4) == TokenKind.Exclaim, "!")
    assert(kind(&c, 5) == TokenKind.Question, "?")
    assert(kind(&c, 8) == TokenKind.LParen, "(")
    assert(kind(&c, 10) == TokenKind.LBracket, "[")
    assert(kind(&c, 15) == TokenKind.Dot, ".")
    assert(kind(&c, 16) == TokenKind.At, "@")

    // Braces: source built byte-wise (a bare `{` in a literal would be read as
    // interpolation). The LBRACE/RBRACE token values are bare braces.
    var bs = StringBuilder()
    bs.append_char(123 as Int8)     // {
    bs.append_char(125 as Int8)     // }
    let br = toks(bs.build())
    assert(kind(&br, 0) == TokenKind.LBrace, "{")
    assert(kind(&br, 1) == TokenKind.RBrace, "}")
    var lb_exp = StringBuilder()
    lb_exp.append("LBRACE\t1:1\t")
    lb_exp.append_char(123 as Int8)
    assert(at(&br, 0).equals(lb_exp.build()), "LBRACE value is a bare brace")

    // Shorthand closure parameters.
    let d = toks("$0 + $12")
    assert(at(&d, 0).equals("DOLLAR_PARAM\t1:1\t$0"), "$0")
    assert(at(&d, 2).equals("DOLLAR_PARAM\t1:6\t$12"), "$12")

    // Trailing EOF token.
    let e = toks("x")
    assert(kind(&e, 1) == TokenKind.Eof, "EOF terminator")

    print("operators: ok")
}
