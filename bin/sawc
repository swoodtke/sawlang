#!/bin/sh
# `sawc` on a $PATH (design 238 unit 3, D-b1): the self-hosted compiler.
#
# The compiler is built from this checkout's own source by
# `compiler/tools/build.py`, so there is nothing to install: `make install`
# symlinks this shim onto a prefix, and it execs the checkout it lives in. Every
# run first has build.py bring the stages up to date (a cached check when
# nothing changed), so an installed `sawc` is always this tree's compiler, and
# editing or pulling the compiler changes what the name means immediately. A
# tree that cannot build its compiler fails here, naming why; Stage 0 is
# `sawc0`, and nothing reaches it through this name.
#
# It is also usable without installing anything: put `<checkout>/bin` on $PATH.
set -eu

# Resolve this script through any symlinks before taking the directory above
# it. `dirname $0` alone would name the PREFIX rather than the checkout once
# `make install` has linked it, and `readlink -f` is not portable to macOS.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
# `SAWLANG_ROOT` wins, matching the resolver's own precedence (design 238 D-b):
# what the operator named beats what was inferred.
ROOT=${SAWLANG_ROOT:-$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)}

# build.py needs only Python's standard library; the checkout's venv is
# preferred where there is one, as `sawc0` prefers it.
PY="$ROOT/.venv/bin/python"
if [ ! -x "$PY" ]; then
    PY=$(command -v python3 || true)
fi
if [ -z "$PY" ]; then
    echo "sawc: no Python found to run compiler/tools/build.py — expected $ROOT/.venv/bin/python or python3" >&2
    exit 1
fi

# This name always runs Stage 2, so a lane's stage choice in the environment is
# not handed to the build that keeps it current.
env -u SAWC_STAGE -u SAWC_BINARY "$PY" "$ROOT/compiler/tools/build.py" --quiet || exit 1
exec "$ROOT/.build/sawc-stage2" "$@"
