#!/bin/sh
# `sawc0` on a $PATH: v0.18.0's compiler, the frozen Python Stage 0, run from
# the v0 checkout the resolver names (`SAWLANG_V0_ROOT`, else v0.18.0 fetched
# and cached).
#
# `sawc` names the sawlang toolchain; `sawc0` names Stage 0 and nothing else,
# for a caller that needs it (Blade's build, the frozen sources' recipes, a
# snapshot's regeneration). This tree holds no Stage 0, so the shim always
# forwards; `make install` symlinks it onto a prefix.
set -eu

# Resolve this script through any symlinks before taking the directory above
# it. `dirname $0` alone would name the PREFIX rather than the checkout once
# `make install` has linked it, and `readlink -f` is not portable to macOS.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)

# The v0 checkout's own shim runs its own tree and venv, so `SAWLANG_ROOT` is
# handed on as that checkout.
V0=$(python3 "$ROOT/tools/toolchain.py" v0-root) || exit 1
SAWLANG_ROOT=$V0
export SAWLANG_ROOT
exec "$V0/bin/sawc0" "$@"
