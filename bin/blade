#!/bin/sh
# `blade` on a $PATH (design 238 unit 3, D-b1).
#
# Blade is a real binary, but one BUILT FROM SAW SOURCE by sawc0, so it lives in
# the checkout's `.build/` rather than anywhere a package would put it. This
# shim execs it, for the same reason the `sawc` shim execs the checkout: an
# installed `blade` should be the one this tree last built, not a copy that
# went stale the next time somebody built it.
#
# Blade is written in Stage 0's language and drives Stage 0's command line, and
# so do the packages it builds and tests here (`libs/`). It shells out to the
# command `SAWC` names, so with `SAWC` unset this shim names Stage 0, the
# `sawc0` beside it; `sawc` is the self-hosted compiler. A `SAWC` already set is
# kept.
set -eu

# Resolve through symlinks, then take the checkout above `bin/`. See bin/sawc
# for why `dirname $0` alone is not enough.
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
ROOT=${SAWLANG_ROOT:-$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)}

BLADE="$ROOT/.build/blade"
if [ ! -x "$BLADE" ]; then
    echo "blade: not built — run \`make blade\` (or \`make install\`) in $ROOT" >&2
    exit 1
fi

SAWC=${SAWC:-$ROOT/bin/sawc0}
export SAWC
exec "$BLADE" "$@"
