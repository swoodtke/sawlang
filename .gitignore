# Build output
.build/

# Blade's `blade test` scratch directory (compiled test binaries)
.blade/

# Remote test worker (design 160): job directories, created and purged per job.
# The sandbox profile grants write to exactly this path and nothing else in the
# account, so it is also where a worker's logs belong.
.worker-jobs/

# A lock file resolved inside a test FIXTURE is build output, not a package's
# committed lock (blade/Saw.lock is the real one and stays tracked). Design
# 149's runtime-provider test is the first to run `blade build` in a fixture,
# so it is the first to leave one behind.
blade/tests/fixtures/**/Saw.lock

# Built SOS process images (design 140) need no rule of their own: design 143
# puts every Blade artifact under `<package>/.build/<target>/`, which the
# `.build/` rule above already covers.
#
# Saw.lock is NOT ignored — the SOS root packages are applications, and
# applications commit their lockfiles (user policy; design 143).

# Python
__pycache__/
*.pyc
*.pyo
.venv
venv/

# Editor files
*.swp
*.swo
*~
.DS_Store

# IDE
.idea/
.vscode/

# Claude internal (settings.json is shared; everything else is local)
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/agents/
