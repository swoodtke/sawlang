// Test: the sosimg wire encoding, end to end (design 140; sos/spec.md §6).
//
// Feeds `elf_to_sosimg` a hand-built minimal ELF32 and checks the resulting
// image BYTE BY BYTE at literal offsets. Two things make this worth its length:
//
//  - The offsets are written out by hand on purpose. A test that recomputed
//    them from the structs would agree with a wrong layout as readily as a
//    right one. These are the offsets the kernel's overlay assumes.
//  - The reader below is the test's OWN module-private `Data` extension, not
//    the emitter's. Sharing one would mean a bug in the byte helpers could
//    cancel itself out.
//
// (`src/sosimg.saw`'s own `Data` extension is invisible here — design-80/82
// visibility, which is exactly what makes extending a std type from a package
// safe. Two modules can each have their own without colliding.)

import src.sosimg.{elf_to_sosimg}
import imgformat.{SosimgHeader, SosimgSeg, SegFlag, SOSIMG_MAGIC, SOSIMG_VERSION}
import std.data.{Data}

// The test's own little-endian view. Reads panic past the end: this test builds
// buffers of known size, so a miss is a broken test, not bad input.
extension Data {
    func at(&self, off: Int) -> UInt {
        (self.get(off)!) as UInt
    }

    func le16(&self, off: Int) -> UInt {
        self.at(off) | (self.at(off + 1) << 8)
    }

    func le32(&self, off: Int) -> UInt {
        self.at(off) | (self.at(off + 1) << 8) | (self.at(off + 2) << 16) | (self.at(off + 3) << 24)
    }

    func emit8(&var self, v: UInt) {
        self.push((v & 0xFF) as UInt8)
    }

    func emit16(&var self, v: UInt) {
        self.emit8(v)
        self.emit8(v >> 8)
    }

    func emit32(&var self, v: UInt) {
        self.emit8(v)
        self.emit8(v >> 8)
        self.emit8(v >> 16)
        self.emit8(v >> 24)
    }
}

static ELF_HEADER_LEN: Int = 52
static ELF_PHDR_LEN: Int = 32
static TEST_ENTRY: UInt = 0x80200000
static TEST_PRIO_MAP: UInt = 0x01010100
// `ELF_`-prefixed because these are ELF's numbering, not sosimg's — the two
// disagree about the permission bits and the prefix keeps that visible.
// (They also used to have to be prefixed to dodge DF-140f, where a
// dependency's module-private static reserved its name downstream. That is
// fixed; the names stay because they read better.)
static ELF_PT_LOAD: UInt = 1
static ELF_PF_X: UInt = 1
static ELF_PF_R: UInt = 4
static EM_RISCV: UInt = 243
static ET_EXEC: UInt = 2

/// A minimal little-endian ELF32 with one PT_LOAD segment: 4 bytes of content
/// and a 4-byte `.bss` tail (p_memsz > p_filesz), which is the shape that makes
/// the sosimg `mem_len` field earn its place.
func minimal_elf() -> Data {
    var elf = Data(capacity: 128)

    // e_ident
    elf.emit8(0x7F)
    elf.emit8(69)               // 'E'
    elf.emit8(76)               // 'L'
    elf.emit8(70)               // 'F'
    elf.emit8(1)                // ELFCLASS32
    elf.emit8(1)                // ELFDATA2LSB
    elf.emit8(1)                // EV_CURRENT
    var pad = 0
    while pad < 9 {
        elf.emit8(0)
        pad = pad + 1
    }

    elf.emit16(ET_EXEC)
    elf.emit16(EM_RISCV)
    elf.emit32(1)                               // e_version
    elf.emit32(TEST_ENTRY)                      // e_entry
    elf.emit32(ELF_HEADER_LEN as UInt)          // e_phoff
    elf.emit32(0)                               // e_shoff
    elf.emit32(0)                               // e_flags
    elf.emit16(ELF_HEADER_LEN as UInt)          // e_ehsize
    elf.emit16(ELF_PHDR_LEN as UInt)            // e_phentsize
    elf.emit16(1)                               // e_phnum
    elf.emit16(0)                               // e_shentsize
    elf.emit16(0)                               // e_shnum
    elf.emit16(0)                               // e_shstrndx

    let content_off = ELF_HEADER_LEN + ELF_PHDR_LEN
    elf.emit32(ELF_PT_LOAD)
    elf.emit32(content_off as UInt)             // p_offset
    elf.emit32(TEST_ENTRY)                      // p_vaddr
    elf.emit32(TEST_ENTRY)                      // p_paddr
    elf.emit32(4)                               // p_filesz
    elf.emit32(8)                               // p_memsz — a 4-byte .bss tail
    elf.emit32(ELF_PF_R | ELF_PF_X)             // p_flags
    elf.emit32(4)                               // p_align

    // The segment's four bytes.
    elf.emit8(0xDE)
    elf.emit8(0xAD)
    elf.emit8(0xBE)
    elf.emit8(0xEF)

    move elf
}

func check_conversion() {
    let elf = minimal_elf()
    let img = match elf_to_sosimg(&elf, TEST_PRIO_MAP) {
        case Ok(bytes) -> move bytes,
        case Err(e) -> panic("the minimal ELF should convert: {e.text()}")
    }

    // Header: 16 bytes at offset 0.
    assert(img.at(0) == 83, "magic byte 0 is 'S'")
    assert(img.at(1) == 79, "magic byte 1 is 'O'")
    assert(img.at(2) == 83, "magic byte 2 is 'S'")
    assert(img.at(3) == 73, "magic byte 3 is 'I'")
    assert(img.le32(0) == (SOSIMG_MAGIC as UInt), "magic reads back as one word")
    assert(img.le16(4) == (SOSIMG_VERSION as UInt), "version at offset 4")
    assert(img.at(6) == 1, "seg_count at offset 6")
    assert(img.at(7) == 0, "header reserved byte is zero")
    assert(img.le32(8) == TEST_ENTRY, "entry at offset 8, taken from e_entry")
    assert(img.le32(12) == TEST_PRIO_MAP, "prio_map at offset 12")

    // Segment record: 20 bytes at offset 16.
    let seg_file_off = img.le32(16)
    assert(seg_file_off == 36, "segment bytes are placed after the 16+20 table")
    assert(img.le32(20) == TEST_ENTRY, "load_addr at record offset 4")
    assert(img.le32(24) == 4, "file_len at record offset 8, from p_filesz")
    assert(img.le32(28) == 8, "mem_len at record offset 12, from p_memsz")
    // ELF says X=1,W=2,R=4; sosimg says R=1,W=2,X=4 — so PF_R|PF_X becomes R|X.
    assert(img.at(32) == (((SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8)) as UInt),
           "flags translated out of ELF order")
    assert(img.at(33) == 0, "segment reserved bytes are zero")
    assert(img.at(34) == 0, "segment reserved bytes are zero")
    assert(img.at(35) == 0, "segment reserved bytes are zero")

    // Segment content: only file_len bytes are carried; the .bss tail is the
    // loader's job, which is the whole reason mem_len exists.
    assert(img.at(36) == 0xDE, "segment content byte 0")
    assert(img.at(37) == 0xAD, "segment content byte 1")
    assert(img.at(38) == 0xBE, "segment content byte 2")
    assert(img.at(39) == 0xEF, "segment content byte 3")
    assert(img.len() == 40, "the image carries no bytes for the .bss tail")
}

func check_shared_predicates() {
    // The rules the KERNEL judges an image by, exercised from the writer's
    // side — the point of putting them in a shared package rather than in the
    // loader where only the loader could reach them.
    assert(sizeof<SosimgHeader>() == 16, "header must be 16 bytes")
    assert(sizeof<SosimgSeg>() == 20, "segment record must be 20 bytes")

    let good = SosimgHeader(
        magic: SOSIMG_MAGIC, version: SOSIMG_VERSION, seg_count: 1u8,
        reserved0: 0u8, entry: 0x80200000u32, prio_map: 0u32,
    )
    assert(good.is_wellformed(), "a header the emitter builds is well-formed")

    let wrong_magic = SosimgHeader(
        magic: 0u32, version: SOSIMG_VERSION, seg_count: 1u8,
        reserved0: 0u8, entry: 0x80200000u32, prio_map: 0u32,
    )
    assert(not wrong_magic.is_wellformed(), "a zero magic is rejected")

    let no_segments = SosimgHeader(
        magic: SOSIMG_MAGIC, version: SOSIMG_VERSION, seg_count: 0u8,
        reserved0: 0u8, entry: 0x80200000u32, prio_map: 0u32,
    )
    assert(not no_segments.is_wellformed(), "an image with no segments is not loadable")

    // mem_len < file_len cannot be loaded: the loader zero-fills the difference.
    let shrunk = SosimgSeg(
        file_off: 0u32, load_addr: 0x80200000u32, file_len: 16u32, mem_len: 8u32,
        flags: SegFlag.Read as UInt8, reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(not shrunk.mem_covers_file(), "mem_len below file_len is rejected")

    // Write-without-read is a PMP encoding RISC-V reserves.
    let write_only = SosimgSeg(
        file_off: 0u32, load_addr: 0x80200000u32, file_len: 8u32, mem_len: 8u32,
        flags: SegFlag.Write as UInt8, reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(not write_only.has_sane_perms(), "write-without-read is not a valid grant")

    let text = SosimgSeg(
        file_off: 0u32, load_addr: 0x80200000u32, file_len: 8u32, mem_len: 8u32,
        flags: (SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8),
        reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(text.is_wellformed(), "R+X is a valid text segment")
    assert(text.is_executable() && not text.is_writable(), "W^X holds for text")
}

func check_rejects_non_elf() {
    // The emitter refuses input that is not a little-endian ELF32 rather than
    // producing an image out of nonsense.
    var junk = Data(capacity: 64)
    var i = 0
    while i < 64 {
        junk.push(0u8)
        i = i + 1
    }
    match elf_to_sosimg(&junk, 0) {
        case Ok(_) -> panic("a zeroed buffer is not an ELF"),
        case Err(e) -> assert(not e.text().is_empty(), "the refusal says why")
    }
}

func main() {
    check_conversion()
    check_shared_predicates()
    check_rejects_non_elf()
    print("sosimg_wire: ok")
}
