// Test: the sosimg wire encoding, end to end (designs 140, 162; sos/spec.md §6).
//
// Feeds `elf_to_sosimg` hand-built minimal ELFs — one of EACH class, because
// SOS has a 32-bit profile and a 64-bit one — and checks the resulting images
// BYTE BY BYTE at literal offsets. Three things make this worth its length:
//
//  - The offsets are written out by hand on purpose. A test that recomputed
//    them from the structs would agree with a wrong layout as readily as a
//    right one. These are the offsets the kernel's overlay assumes.
//  - The reader below is the test's OWN module-private `Data` extension, not
//    the emitter's. Sharing one would mean a bug in the byte helpers could
//    cancel itself out.
//  - Both classes must produce the SAME 24-byte header and 24-byte records.
//    That is the whole claim of a fixed-width format: two architectures, two
//    ELF layouts, one image shape.
//
// (`src/sosimg.saw`'s own `Data` extension is invisible here — design-80/82
// visibility, which is exactly what makes extending a std type from a package
// safe. Two modules can each have their own without colliding.)

import src.sosimg.{elf_to_sosimg, arch_for_target}
import imgformat.{
    SosimgHeader, SosimgSeg, SegFlag, SosimgArch, SOSIMG_MAGIC, SOSIMG_VERSION,
    fits_target_word,
}
import std.data.{Data}

// The test's own little-endian view. Reads panic past the end: this test builds
// buffers of known size, so a miss is a broken test, not bad input.
extension Data {
    func at(&self, off: Int) -> UInt {
        (self.get(off)!) as UInt
    }

    func le16(&self, off: Int) -> UInt {
        self.at(off) | (self.at(off + 1) << 8)
    }

    func le32(&self, off: Int) -> UInt {
        self.at(off) | (self.at(off + 1) << 8) | (self.at(off + 2) << 16) | (self.at(off + 3) << 24)
    }

    /// The v3 address fields. Blade is hosted, so `UInt` carries one whole.
    func le64(&self, off: Int) -> UInt {
        self.le32(off) | (self.le32(off + 4) << 32)
    }

    func emit8(&var self, v: UInt) {
        try! self.push((v & 0xFF) as UInt8)
    }

    func emit16(&var self, v: UInt) {
        self.emit8(v)
        self.emit8(v >> 8)
    }

    func emit32(&var self, v: UInt) {
        self.emit8(v)
        self.emit8(v >> 8)
        self.emit8(v >> 16)
        self.emit8(v >> 24)
    }

    func emit64(&var self, v: UInt) {
        self.emit32(v)
        self.emit32(v >> 32)
    }
}

static ELF32_HEADER_LEN: Int = 52
static ELF32_PHDR_LEN: Int = 32
static ELF64_HEADER_LEN: Int = 64
static ELF64_PHDR_LEN: Int = 56

static TEST_ENTRY_32: UInt = 0x80200000
static TEST_ENTRY_64: UInt = 0x40200000
static TEST_PRIO_MAP: UInt = 0x01010100

// `ELF_`-prefixed because these are ELF's numbering, not sosimg's — the two
// disagree about the permission bits and the prefix keeps that visible.
// (They also used to have to be prefixed to dodge DF-140f, where a
// dependency's module-private static reserved its name downstream. That is
// fixed; the names stay because they read better.)
static ELF_PT_LOAD: UInt = 1
static ELF_PF_X: UInt = 1
static ELF_PF_R: UInt = 4
static EM_RISCV: UInt = 243
static EM_AARCH64: UInt = 183
static ET_EXEC: UInt = 2

/// The 16 identification bytes, which are the only part both classes share.
func emit_ident(elf: &var Data, class_byte: UInt) {
    elf.emit8(0x7F)
    elf.emit8(69)               // 'E'
    elf.emit8(76)               // 'L'
    elf.emit8(70)               // 'F'
    elf.emit8(class_byte)
    elf.emit8(1)                // ELFDATA2LSB
    elf.emit8(1)                // EV_CURRENT
    var pad = 0
    while pad < 9 {
        elf.emit8(0)
        pad = pad + 1
    }
}

/// A minimal little-endian ELF32 with one PT_LOAD segment: 4 bytes of content
/// and a 4-byte `.bss` tail (p_memsz > p_filesz), which is the shape that makes
/// the sosimg `mem_len` field earn its place.
func minimal_elf32() -> Data {
    var elf = try! Data(capacity: 128)
    emit_ident(&var elf, 1)                     // ELFCLASS32

    elf.emit16(ET_EXEC)
    elf.emit16(EM_RISCV)
    elf.emit32(1)                               // e_version
    elf.emit32(TEST_ENTRY_32)                   // e_entry
    elf.emit32(ELF32_HEADER_LEN as UInt)        // e_phoff
    elf.emit32(0)                               // e_shoff
    elf.emit32(0)                               // e_flags
    elf.emit16(ELF32_HEADER_LEN as UInt)        // e_ehsize
    elf.emit16(ELF32_PHDR_LEN as UInt)          // e_phentsize
    elf.emit16(1)                               // e_phnum
    elf.emit16(0)                               // e_shentsize
    elf.emit16(0)                               // e_shnum
    elf.emit16(0)                               // e_shstrndx

    let content_off = ELF32_HEADER_LEN + ELF32_PHDR_LEN
    elf.emit32(ELF_PT_LOAD)
    elf.emit32(content_off as UInt)             // p_offset
    elf.emit32(TEST_ENTRY_32)                   // p_vaddr
    elf.emit32(TEST_ENTRY_32)                   // p_paddr
    elf.emit32(4)                               // p_filesz
    elf.emit32(8)                               // p_memsz — a 4-byte .bss tail
    elf.emit32(ELF_PF_R | ELF_PF_X)             // p_flags
    elf.emit32(4)                               // p_align

    // The segment's four bytes.
    elf.emit8(0xDE)
    elf.emit8(0xAD)
    elf.emit8(0xBE)
    elf.emit8(0xEF)

    move elf
}

/// The same image as an ELF64: wider `e_entry`/`e_phoff`, a 56-byte program
/// header, and `p_flags` moved up to sit right after `p_type` so the 64-bit
/// fields stay aligned. Everything the emitter reads is in a different place,
/// which is the point.
///
/// `entry` is a parameter so one builder serves both the ordinary case and the
/// out-of-range case below.
func minimal_elf64(entry: UInt) -> Data {
    var elf = try! Data(capacity: 192)
    emit_ident(&var elf, 2)                     // ELFCLASS64

    elf.emit16(ET_EXEC)
    elf.emit16(EM_AARCH64)
    elf.emit32(1)                               // e_version
    elf.emit64(entry)                           // e_entry
    elf.emit64(ELF64_HEADER_LEN as UInt)        // e_phoff
    elf.emit64(0)                               // e_shoff
    elf.emit32(0)                               // e_flags
    elf.emit16(ELF64_HEADER_LEN as UInt)        // e_ehsize
    elf.emit16(ELF64_PHDR_LEN as UInt)          // e_phentsize
    elf.emit16(1)                               // e_phnum
    elf.emit16(0)                               // e_shentsize
    elf.emit16(0)                               // e_shnum
    elf.emit16(0)                               // e_shstrndx

    let content_off = ELF64_HEADER_LEN + ELF64_PHDR_LEN
    elf.emit32(ELF_PT_LOAD)                     // p_type
    elf.emit32(ELF_PF_R | ELF_PF_X)             // p_flags — BEFORE the offsets
    elf.emit64(content_off as UInt)             // p_offset
    elf.emit64(entry)                           // p_vaddr
    elf.emit64(entry)                           // p_paddr
    elf.emit64(4)                               // p_filesz
    elf.emit64(8)                               // p_memsz — a 4-byte .bss tail
    elf.emit64(4096)                            // p_align

    elf.emit8(0xDE)
    elf.emit8(0xAD)
    elf.emit8(0xBE)
    elf.emit8(0xEF)

    move elf
}

/// Every assertion that holds for BOTH classes. The image is the contract, so
/// the checks are the same and only the addresses and the tag differ.
func check_image(img: &Data, entry: UInt, arch: SosimgArch, content_off: Int) {
    // Header: 24 bytes at offset 0 (v3 — design 172 unit 8).
    assert(img.at(0) == 83, "magic byte 0 is 'S'")
    assert(img.at(1) == 79, "magic byte 1 is 'O'")
    assert(img.at(2) == 83, "magic byte 2 is 'S'")
    assert(img.at(3) == 73, "magic byte 3 is 'I'")
    assert(img.le32(0) == (SOSIMG_MAGIC as UInt), "magic reads back as one word")
    assert(img.le16(4) == (SOSIMG_VERSION as UInt), "version at offset 4")
    assert(img.at(6) == 1, "seg_count at offset 6")
    assert(img.at(7) == (arch.tag() as UInt), "arch tag at offset 7")
    assert(img.le32(8) == TEST_PRIO_MAP, "prio_map at offset 8")
    assert(img.le32(12) == 0, "reserved0 at offset 12 is zero")
    // The 8-byte field sits at an 8-byte boundary, which is what lets both
    // profiles overlay this struct with no interior padding.
    assert(img.le64(16) == entry, "entry at offset 16, taken from e_entry")

    // Segment record: 24 bytes at offset 24.
    assert(img.le64(24) == entry, "load_addr at record offset 0")
    assert(img.le32(32) == 48, "segment bytes are placed after the 24+24 table")
    assert(img.le32(36) == 4, "file_len at record offset 12, from p_filesz")
    assert(img.le32(40) == 8, "mem_len at record offset 16, from p_memsz")
    // ELF says X=1,W=2,R=4; sosimg says R=1,W=2,X=4 — so PF_R|PF_X becomes R|X.
    assert(img.at(44) == (((SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8)) as UInt),
           "flags translated out of ELF order")
    assert(img.at(45) == 0, "segment reserved bytes are zero")
    assert(img.at(46) == 0, "segment reserved bytes are zero")
    assert(img.at(47) == 0, "segment reserved bytes are zero")

    // Segment content: only file_len bytes are carried; the .bss tail is the
    // loader's job, which is the whole reason mem_len exists.
    assert(img.at(48) == 0xDE, "segment content byte 0")
    assert(img.at(49) == 0xAD, "segment content byte 1")
    assert(img.at(50) == 0xBE, "segment content byte 2")
    assert(img.at(51) == 0xEF, "segment content byte 3")
    assert(img.len() == 52, "the image carries no bytes for the .bss tail")
    assert(content_off > 0, "the fixture placed its content somewhere")
}

func check_conversion_32() {
    let elf = minimal_elf32()
    let img = match elf_to_sosimg(&elf, TEST_PRIO_MAP, SosimgArch.Riscv32) {
        case Ok(bytes) -> move bytes,
        case Err(e) -> panic("the minimal ELF32 should convert: {e.text()}")
    }
    check_image(&img, TEST_ENTRY_32, SosimgArch.Riscv32,
                ELF32_HEADER_LEN + ELF32_PHDR_LEN)
}

func check_conversion_64() {
    let elf = minimal_elf64(TEST_ENTRY_64)
    let img = match elf_to_sosimg(&elf, TEST_PRIO_MAP, SosimgArch.Arm64) {
        case Ok(bytes) -> move bytes,
        case Err(e) -> panic("the minimal ELF64 should convert: {e.text()}")
    }
    check_image(&img, TEST_ENTRY_64, SosimgArch.Arm64,
                ELF64_HEADER_LEN + ELF64_PHDR_LEN)
}

/// An address above 4 GiB now ROUND-TRIPS. This test used to assert the
/// opposite — that the emitter refused it — because v2's address fields were 32
/// bits wide and truncating would have placed a segment somewhere the linker
/// never meant. v3 widened them (design 172 unit 8), so the same address goes
/// out whole and comes back whole, and the check that it does is what would
/// catch a `put_u64` that only wrote four bytes.
///
/// The refusal did not disappear, it MOVED: a 32-bit kernel handed one of these
/// refuses it at load time (`imgformat.fits_target_word`), which is where the
/// question actually is — whether THIS machine can address it, not whether the
/// format can carry it.
func check_high_addresses_round_trip() {
    let high: UInt = 0x1_0000_0040
    let elf = minimal_elf64(high)
    let img = match elf_to_sosimg(&elf, TEST_PRIO_MAP, SosimgArch.Arm64) {
        case Ok(bytes) -> move bytes,
        case Err(e) -> panic("v3 carries a 64-bit address: {e.text()}")
    }
    assert(img.le64(16) == high, "an entry above 4 GiB survives the header")
    assert(img.le64(24) == high, "and survives the segment record")
    // Both halves, so a writer that emitted only the low word fails here rather
    // than passing on the strength of the bottom four bytes.
    assert(img.le32(16) == 0x40, "low half of the entry")
    assert(img.le32(20) == 1, "high half of the entry")
}

func check_arch_for_target() {
    // The tag comes from the target triple, and an unknown triple is an ERROR:
    // an image tagged for the wrong machine is worse than no image, because the
    // kernel's arch check would then wave it through.
    match arch_for_target("riscv32-unknown-none-elf") {
        case Ok(a) -> assert(a.tag() == (SosimgArch.Riscv32 as UInt8), "riscv32 triple"),
        case Err(e) -> panic("riscv32 should have a tag: {e.text()}")
    }
    match arch_for_target("aarch64-unknown-none-elf") {
        case Ok(a) -> assert(a.tag() == (SosimgArch.Arm64 as UInt8), "aarch64 triple"),
        case Err(e) -> panic("aarch64 should have a tag: {e.text()}")
    }
    match arch_for_target("x86_64-unknown-none-elf") {
        case Ok(_) -> panic("x86_64 is not an SOS profile"),
        case Err(e) -> assert(not e.text().is_empty(), "the refusal says why")
    }
}

func check_shared_predicates() {
    // The rules the KERNEL judges an image by, exercised from the writer's
    // side — the point of putting them in a shared package rather than in the
    // loader where only the loader could reach them.
    assert(sizeof<SosimgHeader>() == 24, "header must be 24 bytes")
    assert(sizeof<SosimgSeg>() == 24, "segment record must be 24 bytes")

    let good = SosimgHeader(
        magic: SOSIMG_MAGIC, version: SOSIMG_VERSION, seg_count: 1u8,
        arch: SosimgArch.Riscv32 as UInt8, prio_map: 0u32, reserved0: 0u32,
        entry: 0x80200000u64,
    )
    assert(good.is_wellformed(), "a header the emitter builds is well-formed")
    assert(good.is_for_arch(SosimgArch.Riscv32 as UInt8), "it is for the profile it says")
    assert(not good.is_for_arch(SosimgArch.Arm64 as UInt8),
           "and not for the other one — the check the kernel makes before jumping")

    let wrong_magic = SosimgHeader(
        magic: 0u32, version: SOSIMG_VERSION, seg_count: 1u8,
        arch: SosimgArch.Riscv32 as UInt8, prio_map: 0u32, reserved0: 0u32,
        entry: 0x80200000u64,
    )
    assert(not wrong_magic.is_wellformed(), "a zero magic is rejected")

    let no_segments = SosimgHeader(
        magic: SOSIMG_MAGIC, version: SOSIMG_VERSION, seg_count: 0u8,
        arch: SosimgArch.Riscv32 as UInt8, prio_map: 0u32, reserved0: 0u32,
        entry: 0x80200000u64,
    )
    assert(not no_segments.is_wellformed(), "an image with no segments is not loadable")

    // The version the loader will accept is the one the emitter writes, and a
    // header carrying any other is not this build's to read.
    let stale = SosimgHeader(
        magic: SOSIMG_MAGIC, version: (SOSIMG_VERSION - 1u16), seg_count: 1u8,
        arch: SosimgArch.Riscv32 as UInt8, prio_map: 0u32, reserved0: 0u32,
        entry: 0x80200000u64,
    )
    assert(not stale.has_known_version(), "the previous version is refused, not guessed at")
    assert(not stale.is_wellformed(), "and a stale header is not well-formed")

    // mem_len < file_len cannot be loaded: the loader zero-fills the difference.
    let shrunk = SosimgSeg(
        load_addr: 0x80200000u64, file_off: 0u32, file_len: 16u32, mem_len: 8u32,
        flags: SegFlag.Read as UInt8, reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(not shrunk.mem_covers_file(), "mem_len below file_len is rejected")

    // Write-without-read is an encoding one profile's hardware reserves.
    let write_only = SosimgSeg(
        load_addr: 0x80200000u64, file_off: 0u32, file_len: 8u32, mem_len: 8u32,
        flags: SegFlag.Write as UInt8, reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(not write_only.has_sane_perms(), "write-without-read is not a valid grant")

    let text = SosimgSeg(
        load_addr: 0x80200000u64, file_off: 0u32, file_len: 8u32, mem_len: 8u32,
        flags: (SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8),
        reserved0: 0u8, reserved1: 0u8, reserved2: 0u8,
    )
    assert(text.is_wellformed(), "R+X is a valid text segment")
    assert(text.is_executable() && not text.is_writable(), "W^X holds for text")

    // The v3 addressability boundary, from the writer's side: what a 64-bit
    // profile can place and a 32-bit one cannot. The kernel makes this exact
    // call before narrowing a field into a machine word.
    assert(fits_target_word(0x80200000u64), "a Profile A address fits any machine")
    assert(fits_target_word(0x1_0000_0000u64) == (sizeof<UInt>() >= 8),
           "an address above 4 GiB fits a 64-bit machine and no other")
}

func check_rejects_non_elf() {
    // The emitter refuses input that is not a little-endian ELF rather than
    // producing an image out of nonsense.
    var junk = try! Data(capacity: 128)
    var i = 0
    while i < 128 {
        try! junk.push(0u8)
        i = i + 1
    }
    match elf_to_sosimg(&junk, 0, SosimgArch.Riscv32) {
        case Ok(_) -> panic("a zeroed buffer is not an ELF"),
        case Err(e) -> assert(not e.text().is_empty(), "the refusal says why")
    }
}

func main() {
    check_conversion_32()
    check_conversion_64()
    check_high_addresses_round_trip()
    check_arch_for_target()
    check_shared_predicates()
    check_rejects_non_elf()
    print("sosimg_wire: ok")
}
