// Test: the `[sos]` manifest section (design 140 unit B).
//
// Covers the three shapes that matter — a fully specified image target, one
// leaning on the spec §7 defaults, and an ordinary package with no `[sos]`
// section at all (which must read as "absent", not as an error).

import blade.sosimg.{load_sos_config, pack_priorities}
import std.path.{Path}

func rt_map_of(dir: String) -> UInt {
    match load_sos_config(Path(s: dir)) {
        case Ok(found) -> {
            guard let cfg = found else {
                panic("{dir} declares [sos]")
            }
            cfg.rt_map
        },
        case Err(e) -> panic("{dir} should read: {e}")
    }
}

// The realtime keys: none named leaves the word 0; any named fills all four
// bytes, an unnamed band taking the `high` level as resolved.
func check_realtime_levels() {
    assert(rt_map_of("tests/fixtures/sosapp") == 0, "no rt key leaves rt_map 0")
    assert(rt_map_of("tests/fixtures/sosdefaults") == 0, "defaults leave rt_map 0")
    assert(rt_map_of("tests/fixtures/sosrt_all") == 0x0605_0403, "all four named, rt0 low byte")
    // high is the default 1 here, so the three unnamed bands read 1.
    assert(rt_map_of("tests/fixtures/sosrt_one") == 0x0101_0501, "one named, the rest take high")
    // A manifest that sets high: its level fills the unnamed bands.
    assert(rt_map_of("tests/fixtures/sosrt_high") == 0x0206_0606, "unnamed bands take the manifest's high")
    assert(rt_map_of("tests/fixtures/sosrt_one_dotted") == rt_map_of("tests/fixtures/sosrt_one"),
           "inline and [sos.priorities] spellings agree")
    match load_sos_config(Path(s: "tests/fixtures/sosrt_bad")) {
        case Ok(_) -> panic("rt2 = 8 should be refused"),
        case Err(e) -> {
            let said = "{e}"
            assert(said.contains("[sos] priorities.rt2: level 8 is outside 0..7"), "the refusal names rt2 and the range")
        }
    }
}

func main() {
    match load_sos_config(Path(s: "tests/fixtures/sosapp")) {
        case Ok(found) -> {
            guard let cfg = found else {
                panic("sosapp declares [sos] emit = \"sosimg\"")
            }
            assert(cfg.target.equals("riscv32-unknown-none-elf"), "target")
            assert(cfg.linker_script.equals("app.ld"), "linker-script")
            assert(cfg.native.equals("src/rt.c"), "native")
            // Unspecified: the riscv32 Profile A baseline.
            assert(cfg.march.equals("rv32imac_zicsr"), "march default")
            assert(cfg.mabi.equals("ilp32"), "mabi default")
            // background 0, low 2, normal 3, high 7 -> low byte first.
            assert(cfg.prio_map == pack_priorities(0, 2, 3, 7), "prio_map packing")
            assert(cfg.prio_map == 0x07030200, "prio_map wire layout")
            // The declared device window, both keys, parsed as HEX (design 178
            // M2 unit 4). An address written in decimal would be a manifest
            // nobody could check against a datasheet.
            assert(cfg.device_base == 0x10000000, "device-window base")
            assert(cfg.device_len == 0x2000, "device-window size")
        },
        case Err(e) -> panic("sosapp [sos] should parse: {e}")
    }

    match load_sos_config(Path(s: "tests/fixtures/sosdefaults")) {
        case Ok(found) -> {
            guard let cfg = found else {
                panic("sosdefaults declares [sos]")
            }
            // spec §7's initial map: apps cluster at levels 0-1.
            assert(cfg.prio_map == pack_priorities(0, 1, 1, 1), "default band map")
            assert(cfg.native.is_empty(), "no native translation unit")
            // NO device window, which is the answer for every program that is
            // not a driver — and the direction that matters, since a spurious
            // grant is the bug a default could introduce.
            assert(cfg.device_len == 0, "no device window unless one is asked for")
        },
        case Err(e) -> panic("sosdefaults [sos] should parse: {e}")
    }

    // `[sos.priorities]` is the same value as the inline table, and is no
    // machine: the one `[sos.<triple>]` section is the package's only target.
    match load_sos_config(Path(s: "tests/fixtures/sosdotted_priorities")) {
        case Ok(found) -> {
            guard let cfg = found else {
                panic("sosdotted_priorities declares [sos]")
            }
            assert(cfg.target.equals("xtensa-esp-unknown-elf"), "the dotted table is no machine")
            assert(cfg.prio_map == pack_priorities(0, 2, 1, 7), "dotted priorities read like inline ones")
        },
        case Err(e) -> panic("a [sos.priorities] section should read: {e}")
    }

    check_realtime_levels()

    // An unknown `[sos.<name>]` is refused by name, not counted as a machine.
    match load_sos_config(Path(s: "tests/fixtures/sosunknown_subtable")) {
        case Ok(_) -> panic("an unknown [sos] subtable should be refused"),
        case Err(e) -> {
            let said = "{e}"
            assert(said.contains("[sos.priorites]"), "the refusal names the subtable")
            assert(said.contains("neither a table [sos] owns"), "and the rule")
        }
    }

    // Both spellings of the table at once are refused.
    match load_sos_config(Path(s: "tests/fixtures/sosboth_priorities")) {
        case Ok(_) -> panic("priorities stated twice should be refused"),
        case Err(e) -> {
            let said = "{e}"
            assert(said.contains("[sos.priorities]") && said.contains("inline table"), "the refusal names the header and the inline table")
        }
    }

    // An ordinary package: absent, not an error.
    match load_sos_config(Path(s: "tests/fixtures/deps_ok")) {
        case Ok(found) -> {
            guard let _ = found else {
                print("sosimg_config: ok")
                return
            }
            panic("deps_ok has no [sos] section")
        },
        case Err(e) -> panic("a package without [sos] should not error: {e}")
    }
}
