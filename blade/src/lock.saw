// Saw.lock — the deterministic resolution lockfile (design 64 B4).
//
// Written next to Saw.toml. Packages are sorted by name and there are no
// timestamps, so the bytes are identical across runs. A `manifest_hash` records
// a digest of the manifest's [dependencies] so that editing the manifest is
// detected as drift (build errors toward `blade update` rather than silently
// re-resolving).
//
// Format (parseable by the existing toml module — one [section] per package):
//   [lock]
//   manifest_hash = "..."
//
//   [pkg.<name>]
//   version = "..."
//   source  = "path" | "git"
//   loc     = "<dir or url>"
//   rev     = "<sha or empty>"

import toml
import src.manifest.*
import src.resolver.*
import std.file.{File}
import std.path.{Path}
import std.cbor.{CborEncoder, CborDecoder}
import std.data.{Data}

// =============================================================================
// Lock data
// =============================================================================

// One locked package. This was five parallel `Vector<String>` until design 169:
// a record per package is what the data is, and it is also what the
// `@synthesize` derivation walks, so the CBOR form below costs no hand-written
// wire code.
public struct LockEntry {
    public name: String
    public version: String
    public source: String
    public loc: String
    public rev: String
}

@synthesize
extension LockEntry: Serialize {}

@synthesize
extension LockEntry: Deserialize {}

public struct LockData {
    public manifest_hash: String
    entries: Vector<LockEntry>
}

extension LockData: NoCopy {}

extension LockData {
    public init() -> LockData {
        var entries = Vector<LockEntry>()
        LockData(manifest_hash: "", entries: move entries)
    }

    public func len(&self) -> Int { self.entries.len() }

    // Each accessor reaches its entry as a PLACE and copies out one field, so
    // reading a name does not retain the other four.
    public func name(&self, i: Int) -> String {
        if i < 0 || i >= self.entries.len() { return "" }
        self.entries[i].name
    }

    public func version(&self, i: Int) -> String {
        if i < 0 || i >= self.entries.len() { return "" }
        self.entries[i].version
    }

    public func source(&self, i: Int) -> String {
        if i < 0 || i >= self.entries.len() { return "" }
        self.entries[i].source
    }

    public func loc(&self, i: Int) -> String {
        if i < 0 || i >= self.entries.len() { return "" }
        self.entries[i].loc
    }

    public func rev(&self, i: Int) -> String {
        if i < 0 || i >= self.entries.len() { return "" }
        self.entries[i].rev
    }

    public func add(&var self, entry: LockEntry) {
        self.entries.push(entry)
    }

    public func index_of(&self, name: String) -> Int {
        var i = 0
        while i < self.entries.len() {
            if self.entries[i].name.equals(name) {
                return i
            }
            i = i + 1
        }
        -1
    }
}

// =============================================================================
// Manifest-deps hash (drift detection)
// =============================================================================

// djb2 with WRAPPING arithmetic (Saw panics on overflow, so a hash must wrap).
func hash_str(s: String) -> Int {
    var h = 5381
    for byte in s.bytes() {
        h = (h &* 33) &+ (byte as Int)
    }
    h
}

// Public string digest (decimal), reused by the builder's content-hash build
// avoidance.
public func hash_string(s: String) -> String {
    "{hash_str(s)}"
}

// A stable digest of the manifest's [dependencies] (sorted name|kind|loc|version
// lines). Returns "0" if the deps cannot be read.
public func manifest_deps_hash(m: Manifest) -> String {
    let deps = match m.dependencies() {
        case Ok(d) -> move d,
        case Err(_) -> { return "0" }
    }
    var entries = Vector<String>()
    var i = 0
    while i < deps.len() {
        guard let d = deps.get(i) else {
            break
        }
        let kind = if d.is_path() { "path" } else { "git" }
        let loc = match d.source {
            case PathDep(dir) -> dir,
            case GitDep(url) -> url
        }
        entries.push("{d.name}|{kind}|{loc}|{d.version}")
        i = i + 1
    }
    entries.sort()

    var b = StringBuilder()
    for e in entries.iter() {
        b.append(e)
        b.append("\n")
    }
    let h = hash_str(b.build())
    "{h}"
}

// =============================================================================
// Serialize / write
// =============================================================================

// The exact lock text for a resolution. Deterministic: packages sorted by name,
// no timestamps.
public func serialize(res: &Resolution, manifest_hash: String) -> String {
    var names = Vector<String>()
    var i = 0
    while i < res.len() {
        names.push(res.name(i))
        i = i + 1
    }
    names.sort()

    var b = StringBuilder()
    b.append("[lock]\n")
    b.append("manifest_hash = \"")
    b.append(manifest_hash)
    b.append("\"\n")

    for n in names.iter() {
        let idx = res.index_of(n)
        b.append("\n[pkg.")
        b.append(n)
        b.append("]\n")
        b.append("version = \"")
        b.append(res.version(idx))
        b.append("\"\n")
        b.append("source = \"")
        b.append(res.kind(idx))
        b.append("\"\n")
        b.append("loc = \"")
        b.append(res.declared(idx))  // portable declared source, not the abs dir
        b.append("\"\n")
        b.append("rev = \"")
        b.append(res.rev(idx))
        b.append("\"\n")
    }
    b.build()
}

// Write the lock file. True on success.
public func write_lock(res: &Resolution, manifest_hash: String, path: Path) -> Bool {
    let text = serialize(&res, manifest_hash)
    let f = match File.create(path) {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("warning: could not create {path.as_str()}: {e}")
            return false
        }
    }
    // The write half used to be discarded, so a lock file that failed halfway
    // still reported success (design 132 unit G).
    match f.write(text.to_data()) {
        case Ok(_) -> true,
        case Err(e) -> {
            print("warning: could not write {path.as_str()}: {e}")
            false
        }
    }
}

// =============================================================================
// Parse
// =============================================================================

public func parse_lock(content: String) -> LockData? {
    let doc = match toml.TomlDoc.parse(content) {
        case Ok(d) -> move d,
        case Err(_) -> { return None }
    }

    var data = LockData()

    // A section is a PLACE in the document (it is NoCopy and stays there), so
    // the index is what a caller holds across several reads.
    guard let lock_sec = doc.index_of("lock") else {
        return None
    }
    data.manifest_hash = doc.section_at(lock_sec).get("manifest_hash") ?? ""

    let secs = doc.section_names()
    for name in secs.iter() {
        if name.starts_with("pkg.") {
            let pkg = name.substring(4, name.len())
            guard let sec = doc.index_of(name) else {
                continue
            }
            let version = doc.section_at(sec).get("version") ?? ""
            let source = doc.section_at(sec).get("source") ?? ""
            let loc = doc.section_at(sec).get("loc") ?? ""
            let rev = doc.section_at(sec).get("rev") ?? ""
            data.add(LockEntry(name: pkg, version: version, source: source,
                               loc: loc, rev: rev))
        }
    }

    move data
}

// True if the lock's manifest_hash still matches the manifest (no drift).
public func lock_is_current(lock: &LockData, m: Manifest) -> Bool {
    lock.manifest_hash.equals(manifest_deps_hash(m))
}

// =============================================================================
// CBOR (design 169 unit 6)
// =============================================================================
//
// `Saw.lock` stays TOML on disk: a lock file is read in review, and every
// package in this repo commits one. What CBOR gives the same data is a
// machine-readable form for tools that consume a resolution rather than read
// it — one array of `[manifest_hash, [entry, ...]]`, deterministic bytes, and
// no hand-written wire code, since `LockEntry` derives both directions.

/// The lock data as CBOR: `[manifest_hash, [entry, ...]]`.
///
/// Deterministic, so the same resolution always produces the same bytes.
public func to_cbor(lock: &LockData) -> Result<Data, EncodeError> {
    var enc = CborEncoder()
    try enc.begin_array(2)
    try enc.write_text(lock.manifest_hash)
    try enc.begin_array(lock.len())
    var i = 0
    while i < lock.len() {
        // Read the entry out before serializing it. Calling a method on the
        // PLACE would put `enc` inside the lowered window closure, which
        // refuses to capture a NoCopy value (DF-169h); a `LockEntry` is five
        // Strings, so the read is five retains.
        let entry = lock.entries[i]
        try entry.serialize(to: &var enc)
        i = i + 1
    }
    return enc.finish()
}

/// Reads back what `to_cbor` wrote.
///
/// `Err` names the byte it stopped at. The whole blob is validated before any
/// field is read, so a truncated or non-canonical lock never half-loads.
public func from_cbor(bytes: Data) -> Result<LockData, DecodeError> {
    var dec = try CborDecoder.open(bytes: bytes)
    try dec.expect_array(2)
    var out = LockData()
    out.manifest_hash = try dec.read_text()
    let n = try dec.begin_array()
    var i = 0
    while i < n {
        let entry = try LockEntry.deserialize(from: &var dec)
        out.add(entry)
        i = i + 1
    }
    return move out
}
