// CLI - Command line interface parsing for Blade
// Part of the Blade package manager

// =============================================================================
// Command Types
// =============================================================================

import std.env.{Env}
import std.process.{Command}
// `target` is a sawc target triple, or the empty string for the default hosted
// build (design 143). Empty is a safe way to say "unspecified" here: no triple
// is the empty string, so it can never be mistaken for one.
public enum BladeCommand {
    case Build(force: Bool, target: String),
    case Update,
    case Run(args: Vector<String>),
    case Test,
    case Clean(target: String),
    case New(name: String),
    case Tree,
    case Add(name: String, kind: String, loc: String, version: String),
    case Help,
    case Version,
    case Unknown(cmd: String)
}

// design 139: `Run` carries an owned `Vector<String>`, so the enum names its
// transfer class like any owning type. ExplicitCopy rather than NoCopy because
// `get_command` hands an owned command out of a borrowed `Cli` — that is a
// duplication, and it should be a visible one.
@synthesize
public extension BladeCommand: ExplicitCopy {}

// =============================================================================
// CLI Parsing
// =============================================================================

public struct ParseError {
    public message: String
}

public extension ParseError {
    public init(msg: String) -> ParseError {
        ParseError(message: msg)
    }
}

public struct Cli {
    public command: BladeCommand
}

// The containment cascade: `Cli` holds an ExplicitCopy field, so it picks the
// same policy its field has.
@synthesize
public extension Cli: ExplicitCopy {}

public extension Cli {
    // Parse command line arguments into a Cli struct
    public func parse() -> Result<Cli, ParseError> {
        let args = Env.args()

        if args.len() < 2 {
            return Cli(command: BladeCommand.Help)
        }

        guard let cmd = args.get(1) else {
            return ParseError(msg: "No command provided")
        }

        if cmd.equals("build") {
            var force = false
            var target = ""
            var i = 2
            while i < args.len() {
                if let a = args.get(i) {
                    if a.equals("--force") {
                        force = true
                    } else if a.equals("--target") {
                        i = i + 1
                        target = args.get(i) ?? ""
                    }
                }
                i = i + 1
            }
            Cli(command: BladeCommand.Build(force: force, target: target))
        } else if cmd.equals("clean") {
            var target = ""
            var i = 2
            while i < args.len() {
                if let a = args.get(i) {
                    if a.equals("--target") {
                        i = i + 1
                        target = args.get(i) ?? ""
                    }
                }
                i = i + 1
            }
            Cli(command: BladeCommand.Clean(target: target))
        } else if cmd.equals("update") {
            Cli(command: BladeCommand.Update)
        } else if cmd.equals("run") {
            // Collect remaining args after "run"
            var run_args = Vector<String>()
            var i = 2
            while i < args.len() {
                if let arg = args.get(i) {
                    run_args.push(arg)
                }
                i = i + 1
            }
            Cli(command: BladeCommand.Run(args: move run_args))
        } else if cmd.equals("test") {
            Cli(command: BladeCommand.Test)
        } else if cmd.equals("tree") {
            Cli(command: BladeCommand.Tree)
        } else if cmd.equals("add") {
            guard let name = args.get(2) else {
                return ParseError(msg: "blade add requires a dependency name")
            }
            var kind = ""
            var loc = ""
            var version = ""
            var i = 3
            while i < args.len() {
                if let a = args.get(i) {
                    if a.equals("--path") {
                        kind = "path"
                        i = i + 1
                        loc = args.get(i) ?? ""
                    } else if a.equals("--git") {
                        kind = "git"
                        i = i + 1
                        loc = args.get(i) ?? ""
                    } else if a.equals("--version") {
                        i = i + 1
                        version = args.get(i) ?? ""
                    }
                }
                i = i + 1
            }
            if kind.is_empty() {
                return ParseError(msg: "blade add requires --path <dir> or --git <url>")
            }
            Cli(command: BladeCommand.Add(name: name, kind: kind, loc: loc, version: version))
        } else if cmd.equals("new") {
            guard let name = args.get(2) else {
                return ParseError(msg: "blade new requires a project name")
            }
            Cli(command: BladeCommand.New(name: name))
        } else if cmd.equals("help") || cmd.equals("--help") || cmd.equals("-h") {
            Cli(command: BladeCommand.Help)
        } else if cmd.equals("version") || cmd.equals("--version") || cmd.equals("-V") {
            Cli(command: BladeCommand.Version)
        } else {
            Cli(command: BladeCommand.Unknown(cmd: cmd))
        }
    }

    // Get the parsed command. Hands out an owned copy — `self` is borrowed, so
    // the command cannot be moved out of it.
    public func get_command(&self) -> BladeCommand {
        self.command.copy()
    }
}
