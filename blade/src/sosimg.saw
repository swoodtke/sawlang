// sosimg — the SOS process-image build target (design 140 unit B; sos/spec.md §6)
//
// A package whose manifest carries `[sos] emit = "sosimg"` builds to a flat SOS
// image instead of a host executable. The kernel that loads it is a microkernel:
// it will not carry an ELF reader, so Blade does the reading here and hands the
// kernel a header it can walk with a handful of aligned loads.
//
// This module owns two things — the `[sos]` manifest section, and the ELF32 ->
// sosimg conversion. Driving the compiler, the assembler and the linker is the
// builder's job (src/builder.saw), which calls in here for both.
//
// The FORMAT is not defined here. It is the `imgformat` package — a path
// dependency shared with the kernel that loads these images — so the layout
// exists once and the two sides cannot drift. What lives here is the writing:
// ELF32 in, sosimg bytes out. The kernel does the mirror-image job by
// overlaying the same structs on the bytes this produces.

// The toml types are imported BARE by the design-150 brace form, which is the
// idiom for a library dependency: the list documents what this module uses and
// survives a rename upstream. (A `toml.` qualifier would work in every position
// too, type annotations included, since design 150 — the DF-140c limit this
// import used to work around is gone.)
import toml.{TomlDoc, TomlSection}
import imgformat.{
    SosimgHeader, SosimgSeg, SegFlag, SosimgArch, SOSIMG_MAGIC, SOSIMG_VERSION,
}
import std.data.{Data}
import std.env.{Env}
import std.file.{File}
import std.path.{Path}

// =============================================================================
// Errors
// =============================================================================

public struct SosError {
    message: String
}

public extension SosError {
    public init(msg: String) -> SosError {
        SosError(message: msg)
    }

    public func text(&self) -> String {
        self.message
    }
}

public extension SosError: Error {
    public func format(&self, into: &var StringBuilder) {
        into.append(self.message)
    }
}

// =============================================================================
// ELF constants — BOTH classes (design 162 unit 3)
// =============================================================================
//
// SOS has two profiles and they do not agree about ELF: a riscv32 image is
// ELF32 and an arm64 one is ELF64, with a different header layout, a different
// program-header size, and 64-bit offsets in place of 32-bit ones. So the
// reader takes a CLASS and looks its field offsets up, rather than assuming
// one. What comes out is the same `SosimgSeg` either way.
//
// SINCE v3 THE ADDRESSES NEED NO NARROWING (design 172 unit 8): `entry` and
// `load_addr` are 64-bit wire fields, so an ELF64 address crosses whole. What
// still narrows is what still IS 32-bit — the image offsets and lengths, which
// describe the file rather than the machine — and `narrow` below is now only
// about those.

static ELF_CLASS_OFF: Int = 4
static ELF_DATA_OFF: Int = 5
static ELF_CLASS_32: UInt = 1
static ELF_CLASS_64: UInt = 2
static ELF_DATA_LSB: UInt = 1

// ELF32: e_entry at 24, e_phoff at 28, both 4 bytes; e_phentsize/e_phnum at
// 42/44. ELF64 widens e_entry and e_phoff to 8 bytes, which pushes everything
// after them along.
static ELF32_ENTRY_OFF: Int = 24
static ELF32_PHOFF_OFF: Int = 28
static ELF32_PHENTSIZE_OFF: Int = 42
static ELF32_PHNUM_OFF: Int = 44
static ELF32_PHDR_LEN: Int = 32

static ELF64_ENTRY_OFF: Int = 24
static ELF64_PHOFF_OFF: Int = 32
static ELF64_PHENTSIZE_OFF: Int = 54
static ELF64_PHNUM_OFF: Int = 56
static ELF64_PHDR_LEN: Int = 56

// Program-header field offsets. ELF32 orders them
// type/offset/vaddr/paddr/filesz/memsz/flags/align; ELF64 moves `flags` up to
// right after `type` so the 64-bit fields stay 8-aligned. Two orders, which is
// why these cannot be one set of constants.
static ELF32_PHDR_TYPE: Int = 0
static ELF32_PHDR_OFFSET: Int = 4
static ELF32_PHDR_VADDR: Int = 8
static ELF32_PHDR_FILESZ: Int = 16
static ELF32_PHDR_MEMSZ: Int = 20
static ELF32_PHDR_FLAGS: Int = 24

static ELF64_PHDR_TYPE: Int = 0
static ELF64_PHDR_FLAGS: Int = 4
static ELF64_PHDR_OFFSET: Int = 8
static ELF64_PHDR_VADDR: Int = 16
static ELF64_PHDR_FILESZ: Int = 32
static ELF64_PHDR_MEMSZ: Int = 40

static PT_LOAD: UInt = 1
static PF_X: UInt = 1
static PF_W: UInt = 2
static PF_R: UInt = 4

/// The largest value a sosimg OFFSET or LENGTH field can carry. Addresses are
/// 64-bit since v3; these describe the image file and stay 32-bit, so a link
/// that produced a segment longer than 4 GiB is refused rather than wrapped.
static SOSIMG_SIZE_MAX: UInt = 0xFFFFFFFF

// Segment payloads are placed on this boundary so the kernel's word-granular
// copy never straddles one. Not required by the format; kindness to the loader.
static SEGMENT_ALIGN: Int = 4

// The header carries `seg_count` in ONE byte, so the format cannot describe
// more loadable segments than this. Checked where the header is built rather
// than left to the narrowing cast: a build tool owes the caller a diagnostic,
// and design 170 turned the silent truncation that used to happen here into a
// panic, which is a better failure but still not a message anyone can act on.
static SEG_COUNT_MAX: Int = 255

// spec §7: eight system priority levels, four named bands.
static PRIORITY_LEVEL_MAX: Int = 7
static BAND_COUNT: Int = 4
static BITS_PER_BAND: Int = 8

// =============================================================================
// `[sos]` manifest section
// =============================================================================

/// What `[sos]` says about how to build this package's image.
public struct SosConfig {
    public target: String
    public march: String
    public mabi: String
    /// The same extensions as `march`, in LLVM subtarget-feature form, for
    /// sawc's `--target-features`. A triple names the architecture but not
    /// which optional extensions the part has, so without this the Saw half of
    /// an image is built for the BASE ISA while the C half gets `march` — and
    /// the Saw half then emits `__divsi3` / `__atomic_*` calls into a link that
    /// has no library to satisfy them. Keeping both halves on one subtarget is
    /// the whole job of this field.
    public target_features: String
    public linker_script: String
    /// C/assembly translation units linked alongside the Saw object, as a
    /// SPACE-SEPARATED list, or "" for none. A freestanding SOS process needs
    /// at least a syscall stub, which no amount of Saw can express; in practice
    /// it names its architecture's HAL plus the shared runtime support.
    public native: String
    /// The spec §7 band -> level map, packed one byte per band, low byte first:
    /// background, low, normal, high.
    public prio_map: UInt
    /// The MMIO window this image asks to be granted, and its size in bytes —
    /// zero for a program that drives no device, which is every program that is
    /// not a driver.
    ///
    /// PER MACHINE, because a device address is: the same driver source names
    /// 0x1000_0000 on one board and 0x0900_0000 on another, so the window lives
    /// in `[sos.<triple>]` beside the linker script rather than in `[sos]`.
    public device_base: UInt
    public device_len: UInt
}

/// What a `device-window` gets when the manifest does not say how big: one page
/// on both profiles, which is the protection granularity of the coarser of the
/// two and the smallest grant either can express.
static DEFAULT_DEVICE_WINDOW_BYTES: UInt = 4096

/// Defaults matching spec §7's initial map: apps cluster at levels 0-1 and
/// levels 2-7 are headroom for drivers and services.
static DEFAULT_BACKGROUND: Int = 0
static DEFAULT_LOW: Int = 1
static DEFAULT_NORMAL: Int = 1
static DEFAULT_HIGH: Int = 1

/// The toolchain flags a profile needs when its manifest does not say.
///
/// Keyed on the TARGET TRIPLE rather than on which section the keys came from,
/// which is the difference between a default and an accident: the riscv32
/// values used to be the defaults for every target, so an arm64 image would
/// silently have been handed `-march=rv32imac_zicsr`. A profile with nothing to
/// say gets empty strings, and an empty flag is not passed at all.
///
/// All fields are plain strings, so this needs no copy policy beyond the
/// automatic Copy tier.
struct ToolchainDefaults {
    march: String
    mabi: String
    target_features: String
}

func toolchain_defaults(target: String) -> ToolchainDefaults {
    if target.starts_with("riscv32") {
        // The `virt`/ESP32-P4 Profile A baseline. `target-features` restates
        // `march` in LLVM subtarget form because a triple names the
        // architecture but not which optional extensions the part has.
        return ToolchainDefaults(march: "rv32imac_zicsr", mabi: "ilp32",
                                 target_features: "+m,+a,+c")
    }
    // Profile B needs none of the three: the base aarch64 triple already has
    // multiply, atomics and the rest, and there is no ABI variant to select.
    ToolchainDefaults(march: "", mabi: "", target_features: "")
}

// Reading a band is *about* a section, so it reads as a method on one. The
// extension is module-private (design 80/142), so nothing outside this file
// sees a `band_level` on `TomlSection`.
extension TomlSection {
    /// The level for one spec §7 priority band, or `fallback` when
    /// `[sos.priorities]` does not name it. A malformed or out-of-range level is
    /// an ERROR, never a silent fallback: a typo'd level would otherwise ship an
    /// image whose scheduling silently disagrees with its manifest.
    func band_level(&self, band: String, fallback: Int) -> Result<Int, SosError> {
        guard let raw = self.table_value("priorities", band) else {
            return fallback
        }
        guard let level = raw.to_int() else {
            return SosError(msg: "[sos] priorities.{band}: `{raw}` is not an integer")
        }
        if level < 0 || level > PRIORITY_LEVEL_MAX {
            return SosError(msg: "[sos] priorities.{band}: level {level} is outside 0..{PRIORITY_LEVEL_MAX}")
        }
        level
    }
}

// The `[sos]` priorities table, read through ONE place-window on `index`
// rather than one per band (design 212 unit 2 — `load_sos_config` used to
// spell `section_at` four times here, one per band).
func read_priorities(doc: &TomlDoc, index: Int) -> Result<UInt, SosError> {
    try priorities_from(&doc.section_at(index))
}

func priorities_from(section: &TomlSection) -> Result<UInt, SosError> {
    let background = try section.band_level("background", DEFAULT_BACKGROUND)
    let low = try section.band_level("low", DEFAULT_LOW)
    let normal = try section.band_level("normal", DEFAULT_NORMAL)
    let high = try section.band_level("high", DEFAULT_HIGH)
    pack_priorities(background, low, normal, high)
}

// The `[sos]` / `[sos.<triple>]` toolchain keys `load_sos_config` folds into
// a `SosConfig`, read through ONE place-window on `index` rather than one per
// field (design 212 unit 2 — five spellings of `section_at` before this).
// Fields stay `None` when absent: this reader has no target triple to fall
// back to, so the caller applies each field's own default
// (`""` for `linker_script`/`native`, the triple's `ToolchainDefaults` for
// the rest).
struct ToolchainFields {
    linker_script: String?
    march: String?
    mabi: String?
    target_features: String?
    native: String?
    device_window: String?
    device_window_size: String?
}

func read_toolchain_fields(doc: &TomlDoc, index: Int) -> ToolchainFields {
    toolchain_fields_from(&doc.section_at(index))
}

func toolchain_fields_from(section: &TomlSection) -> ToolchainFields {
    ToolchainFields(
        linker_script: section.get("linker-script"),
        march: section.get("march"),
        mabi: section.get("mabi"),
        target_features: section.get("target-features"),
        native: section.get("native"),
        device_window: section.get("device-window"),
        device_window_size: section.get("device-window-size"),
    )
}

/// Read an address or a size out of the manifest: `0x`-prefixed hexadecimal, or
/// plain decimal.
///
/// HEX IS ACCEPTED BECAUSE ADDRESSES ARE WRITTEN IN IT, and a manifest that had
/// to spell 0x0900_0000 as 150994944 would be a manifest nobody could check
/// against a datasheet. A value that parses as neither is an ERROR naming the
/// key, never a zero — a silently-zero device window is an image that asks for
/// a grant at address 0.
func parse_manifest_word(raw: String, key: String) -> Result<UInt, SosError> {
    if raw.starts_with("0x") {
        guard let hex = raw.substring(HEX_PREFIX_LEN, raw.len()).to_uint(radix: 16) else {
            return SosError(msg: "[sos] {key}: `{raw}` is not a hexadecimal number")
        }
        return hex
    }
    guard let dec = raw.to_uint() else {
        return SosError(msg: "[sos] {key}: `{raw}` is not a number")
    }
    dec
}

static HEX_PREFIX_LEN: Int = 2      // "0x"

/// Read the `[sos]` section of `<dir>/Saw.toml`. Returns None when the package
/// has no `[sos]` section — an ordinary host package, built the ordinary way.
///
/// TWO SPELLINGS, ONE MEANING (design 162 unit 4). A package that builds for
/// one machine states it flat:
///
///     [sos]
///     emit = "sosimg"
///     target = "riscv32-unknown-none-elf"
///     linker-script = "..."
///
/// A package that builds for SEVERAL puts the per-machine keys in a section
/// named for the triple, and `blade build --target <triple>` picks one:
///
///     [sos]
///     emit = "sosimg"
///     priorities = { ... }
///
///     [sos.riscv32-unknown-none-elf]
///     linker-script = "../hal/riscv32/user/root.ld"
///     native = "..."
///
///     [sos.aarch64-unknown-none-elf]
///     linker-script = "../hal/arm64/user/root.ld"
///     native = "..."
///
/// `emit` and `priorities` stay in `[sos]` either way, because they are
/// properties of the PROGRAM and not of the machine it is built for. A
/// `--target` the manifest has no section for is an ERROR naming the ones it
/// does have — never a build for something else, and never a silent fallback
/// to the first section, which would be a wrong-machine image with a valid
/// header.
public func load_sos_config(dir: Path, requested: String = "") -> Result<SosConfig?, Box<any Error>> {
    let manifest_path = dir.join("Saw.toml")
    // std.file surfaces its IoError on open and read alike (design 92); `try`
    // re-boxes each into the erased Result, alongside the Utf8Error and the
    // TomlError below.
    var file = try File.open(manifest_path)
    let data = try file.read()
    let content = try data.to_string()
    let doc = try TomlDoc.parse(content)

    // A `TomlSection` is NoCopy and stays IN the document, so it is reached as a
    // PLACE rather than held (design 146). The search runs once here and every
    // read below opens its own window off the index — which is exactly the
    // pairing `index_of` and `section_at` exist for when one section feeds a
    // dozen reads. (`section(name)` is the one-read spelling.)
    guard let sos = doc.index_of("sos") else {
        // The absent case is spelled through a typed local: a bare
        // `return None` from a `Result<T?, E>` is an internal compiler error
        // (DF-140d).
        let absent: SosConfig? = None
        return absent
    }

    let emit = doc.section_at(sos).get("emit") ?? ""
    if not emit.equals("sosimg") {
        return SosError(msg: "[sos] emit: expected \"sosimg\", got `{emit}`")
    }

    // `priorities` describes the PROGRAM, so it is read from `[sos]` whichever
    // spelling the per-machine keys use.
    let packed = try read_priorities(&doc, sos)

    // Which section carries the per-machine keys, and which triple it is for.
    let flat_target = doc.section_at(sos).get("target") ?? ""
    let per_target = sos_target_sections(&doc)
    var section_name = ""
    var target = ""

    if not requested.is_empty() {
        let named = "sos.{requested}"
        if doc.has_section(named) {
            section_name = named
            target = requested
        } else if flat_target.equals(requested) {
            section_name = "sos"
            target = requested
        } else {
            return SosError(msg: "[sos]: no configuration for target `{requested}` ({sos_targets_summary(&doc, flat_target)})")
        }
    } else if not flat_target.is_empty() {
        section_name = "sos"
        target = flat_target
    } else if per_target.len() == 1 {
        section_name = "sos.{per_target[0]}"
        target = per_target[0]
    } else if per_target.len() == 0 {
        return SosError(msg: "[sos] target is required (the cross-compilation triple), or a [sos.<triple>] section per machine")
    } else {
        return SosError(msg: "[sos]: this package builds for several machines — pass --target ({sos_targets_summary(&doc, flat_target)})")
    }

    guard let chosen = doc.index_of(section_name) else {
        return SosError(msg: "internal: [{section_name}] vanished")
    }

    let toolchain = read_toolchain_fields(&doc, chosen)
    let linker_script = toolchain.linker_script ?? ""
    if linker_script.is_empty() {
        return SosError(msg: "[{section_name}] linker-script is required (an SOS image has a fixed load address)")
    }

    // Toolchain flags default from the TRIPLE, so a profile that needs none
    // gets none. An explicit key always wins.
    let defaults = toolchain_defaults(target)

    // THE DEVICE WINDOW (design 178's finale constraint 1). Absent for every
    // program that is not a driver, which is why it defaults to nothing rather
    // than to a size: zero bytes means the image asks for no grant, and the
    // emitter writes no record.
    var device_base: UInt = 0
    var device_len: UInt = 0
    if let window = toolchain.device_window {
        device_base = try parse_manifest_word(window, "{section_name}.device-window")
        let stated = toolchain.device_window_size ?? ""
        if stated.is_empty() {
            device_len = DEFAULT_DEVICE_WINDOW_BYTES
        } else {
            device_len = try parse_manifest_word(
                stated, "{section_name}.device-window-size")
        }
    }

    // Typed local (DF-140d): returning the value directly would have to
    // auto-wrap twice — into the Optional and then into the Result — and that
    // is an internal compiler error.
    let found: SosConfig? = SosConfig(
        target: target,
        march: toolchain.march ?? defaults.march,
        mabi: toolchain.mabi ?? defaults.mabi,
        target_features: toolchain.target_features ?? defaults.target_features,
        linker_script: linker_script,
        native: toolchain.native ?? "",
        prio_map: packed,
        device_base: device_base,
        device_len: device_len,
    )
    return found
}

/// Every triple this manifest has a `[sos.<triple>]` section for, in document
/// order.
func sos_target_sections(doc: &TomlDoc) -> Vector<String> {
    var out = Vector<String>()
    let names = doc.section_names()
    var i = 0
    while i < names.len() {
        guard let name = names.get(i) else {
            i = i + 1
            continue
        }
        if name.starts_with("sos.") {
            out.push(name.substring(SOS_PREFIX_LEN, name.len()))
        }
        i = i + 1
    }
    move out
}

static SOS_PREFIX_LEN: Int = 4      // "sos."

/// What a refusal tells the user they COULD have asked for. A list of names is
/// the difference between an error you can act on and one you have to go read
/// the manifest for.
func sos_targets_summary(doc: &TomlDoc, flat_target: String) -> String {
    let per_target = sos_target_sections(&doc)
    if per_target.len() == 0 {
        if flat_target.is_empty() {
            return "this manifest declares no target"
        }
        return "this manifest declares `{flat_target}`"
    }
    var listed = ""
    var i = 0
    while i < per_target.len() {
        guard let name = per_target.get(i) else {
            i = i + 1
            continue
        }
        if listed.is_empty() {
            listed = name
        } else {
            listed = "{listed}, {name}"
        }
        i = i + 1
    }
    if flat_target.is_empty() {
        return "this manifest declares {listed}"
    }
    "this manifest declares {flat_target}, {listed}"
}

/// The cross-compiler driving the native translation unit. An SOS image is
/// built for a bare-metal triple, so this is never the host toolchain by
/// accident — `SOS_CLANG` names it when the default is wrong (macOS's Apple
/// clang mis-drives the riscv integrated assembler).
public func sos_clang() -> String {
    Env.get("SOS_CLANG") ?? "clang"
}

/// The linker. `SOS_LD` overrides.
public func sos_ld() -> String {
    Env.get("SOS_LD") ?? "ld.lld"
}

/// Pack the four band levels into the header's `prio_map` word, low byte first.
public func pack_priorities(background: Int, low: Int, normal: Int, high: Int) -> UInt {
    var packed = background as UInt
    packed = packed | ((low as UInt) << BITS_PER_BAND)
    packed = packed | ((normal as UInt) << (BITS_PER_BAND * 2))
    packed = packed | ((high as UInt) << (BITS_PER_BAND * 3))
    packed
}

// =============================================================================
// Little-endian byte access — a module-private extension on `Data`
// =============================================================================
//
// These read and write ONE `Data`, so they are methods on it rather than free
// functions taking it (the house idiom). Extending a std type from a package is
// safe precisely because design-80/82 visibility makes an unmarked extension
// MODULE-PRIVATE: none of this is visible outside src/sosimg.saw, so it cannot
// collide with anyone else's idea of what `Data.u32_at` should mean. If the
// pattern ever earns a wider audience it belongs in std, not `public` here.
//
// Reads are Optional because an offset past the end is a MALFORMED IMAGE, not a
// programmer error — the caller turns a None into a diagnostic naming the file.

extension Data {
    func u8_at(&self, off: Int) -> UInt? {
        guard let b = self.get(off) else {
            return None
        }
        b as UInt
    }

    func u16_at(&self, off: Int) -> UInt? {
        guard let b0 = self.get(off) else {
            return None
        }
        guard let b1 = self.get(off + 1) else {
            return None
        }
        (b0 as UInt) | ((b1 as UInt) << 8)
    }

    func u32_at(&self, off: Int) -> UInt? {
        guard let b0 = self.get(off) else {
            return None
        }
        guard let b1 = self.get(off + 1) else {
            return None
        }
        guard let b2 = self.get(off + 2) else {
            return None
        }
        guard let b3 = self.get(off + 3) else {
            return None
        }
        (b0 as UInt) | ((b1 as UInt) << 8) | ((b2 as UInt) << 16) | ((b3 as UInt) << 24)
    }

    /// The ELF64 half of the reader. Blade is a HOSTED binary and every host
    /// Saw targets is 64-bit, so `UInt` holds this; a 32-bit host would need
    /// the top half kept separately, which is a problem for the day one exists.
    func u64_at(&self, off: Int) -> UInt? {
        guard let lo = self.u32_at(off) else {
            return None
        }
        guard let hi = self.u32_at(off + 4) else {
            return None
        }
        lo | (hi << 32)
    }

    func put_u8(&var self, v: UInt) {
        self.push((v & 0xFF) as UInt8)
    }

    func put_u16(&var self, v: UInt) {
        self.put_u8(v)
        self.put_u8(v >> 8)
    }

    func put_u32(&var self, v: UInt) {
        self.put_u8(v)
        self.put_u8(v >> 8)
        self.put_u8(v >> 16)
        self.put_u8(v >> 24)
    }

    /// The v3 address fields. Blade is a HOSTED binary and every host Saw
    /// targets is 64-bit, so `UInt` carries one whole.
    func put_u64(&var self, v: UInt) {
        self.put_u32(v)
        self.put_u32(v >> 32)
    }

    /// Append the 24-byte header, field by field in declaration order — the
    /// same order `imgformat` declares and the kernel overlays.
    func put_header(&var self, h: &SosimgHeader) {
        self.put_u32(h.magic as UInt)
        self.put_u16(h.version as UInt)
        self.put_u8(h.seg_count as UInt)
        self.put_u8(h.arch as UInt)
        self.put_u32(h.prio_map as UInt)
        self.put_u32(h.reserved0 as UInt)
        self.put_u64(h.entry as UInt)
    }

    /// Append one 24-byte segment record.
    func put_seg(&var self, s: &SosimgSeg) {
        self.put_u64(s.load_addr as UInt)
        self.put_u32(s.file_off as UInt)
        self.put_u32(s.file_len as UInt)
        self.put_u32(s.mem_len as UInt)
        self.put_u8(s.flags as UInt)
        self.put_u8(s.reserved0 as UInt)
        self.put_u8(s.reserved1 as UInt)
        self.put_u8(s.reserved2 as UInt)
    }
}

// =============================================================================
// ELF32 -> sosimg
// =============================================================================

// One PT_LOAD program header, carried as the sosimg record it will become plus
// the one thing that record does NOT hold: where the bytes live in the LINKED
// ELF. `record.file_off` is an offset into the image being built and is only
// known once placement runs, so the two cannot be the same field.
// All fields are trivially copyable, so this needs no copy policy.
struct PlacedSeg {
    elf_off: Int
    record: SosimgSeg
}

func sos_flags(elf_flags: UInt) -> UInt8 {
    // ELF spells the bits X=1, W=2, R=4; sosimg spells them R=1, W=2, X=4 (to
    // match a RISC-V PMP config, so the kernel installs them untranslated).
    var f: UInt8 = 0u8
    if (elf_flags & PF_R) != 0 {
        f = f | (SegFlag.Read as UInt8)
    }
    if (elf_flags & PF_W) != 0 {
        f = f | (SegFlag.Write as UInt8)
    }
    if (elf_flags & PF_X) != 0 {
        f = f | (SegFlag.Execute as UInt8)
    }
    f
}

func align_up(v: Int, align: Int) -> Int {
    let rem = v % align
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// Where an ELF of one class keeps the handful of fields this reader needs.
///
/// Carrying the offsets as DATA rather than branching at each read is what
/// keeps the walk below identical for both classes: the class is decided once,
/// at the header, and everything after it reads the same way. All fields are
/// trivially copyable, so this needs no copy policy.
struct ElfShape {
    is_64: Bool
    entry_off: Int
    phoff_off: Int
    phentsize_off: Int
    phnum_off: Int
    phdr_len: Int
    ph_type: Int
    ph_flags: Int
    ph_offset: Int
    ph_vaddr: Int
    ph_filesz: Int
    ph_memsz: Int
}

extension ElfShape {
    /// A word-sized field: four bytes in an ELF32, eight in an ELF64.
    func word_at(&self, elf: &Data, off: Int) -> UInt? {
        if self.is_64 {
            elf.u64_at(off)
        } else {
            elf.u32_at(off)
        }
    }
}

/// Identify the linked image, or say why it is not one this can read.
func elf_shape(elf: &Data) -> Result<ElfShape, SosError> {
    if elf.len() < ELF64_PHNUM_OFF {
        return SosError(msg: "linked image is too short to be an ELF")
    }
    let m0 = elf.u8_at(0) ?? 0
    let m1 = elf.u8_at(1) ?? 0
    let m2 = elf.u8_at(2) ?? 0
    let m3 = elf.u8_at(3) ?? 0
    // 0x7F 'E' 'L' 'F'
    if m0 != 0x7F || m1 != 69 || m2 != 76 || m3 != 70 {
        return SosError(msg: "linked image is not an ELF")
    }
    if (elf.u8_at(ELF_DATA_OFF) ?? 0) != ELF_DATA_LSB {
        return SosError(msg: "linked image is not little-endian")
    }
    let class_byte = elf.u8_at(ELF_CLASS_OFF) ?? 0
    if class_byte == ELF_CLASS_32 {
        return ElfShape(
            is_64: false,
            entry_off: ELF32_ENTRY_OFF,
            phoff_off: ELF32_PHOFF_OFF,
            phentsize_off: ELF32_PHENTSIZE_OFF,
            phnum_off: ELF32_PHNUM_OFF,
            phdr_len: ELF32_PHDR_LEN,
            ph_type: ELF32_PHDR_TYPE,
            ph_flags: ELF32_PHDR_FLAGS,
            ph_offset: ELF32_PHDR_OFFSET,
            ph_vaddr: ELF32_PHDR_VADDR,
            ph_filesz: ELF32_PHDR_FILESZ,
            ph_memsz: ELF32_PHDR_MEMSZ,
        )
    }
    if class_byte == ELF_CLASS_64 {
        return ElfShape(
            is_64: true,
            entry_off: ELF64_ENTRY_OFF,
            phoff_off: ELF64_PHOFF_OFF,
            phentsize_off: ELF64_PHENTSIZE_OFF,
            phnum_off: ELF64_PHNUM_OFF,
            phdr_len: ELF64_PHDR_LEN,
            ph_type: ELF64_PHDR_TYPE,
            ph_flags: ELF64_PHDR_FLAGS,
            ph_offset: ELF64_PHDR_OFFSET,
            ph_vaddr: ELF64_PHDR_VADDR,
            ph_filesz: ELF64_PHDR_FILESZ,
            ph_memsz: ELF64_PHDR_MEMSZ,
        )
    }
    return SosError(msg: "linked image has an unknown ELF class {class_byte}")
}

/// Narrow a linked value into a 32-bit sosimg SIZE field.
///
/// Offsets and lengths stay 32-bit in v3 (`imgformat` says why), and truncating
/// one would emit an image whose segment table disagrees with its own bytes.
/// Refusing is the only answer that cannot corrupt a boot.
func narrow(value: UInt, what: String) -> Result<UInt32, SosError> {
    if value > SOSIMG_SIZE_MAX {
        return SosError(msg: "{what} is 0x{value} — past the 32-bit sosimg size field (offsets and lengths address 4 GiB of image)")
    }
    value as UInt32
}

func collect_segments(elf: &Data, shape: &ElfShape) -> Result<Vector<PlacedSeg>, SosError> {
    guard let phoff_raw = shape.word_at(&elf, shape.phoff_off) else {
        return SosError(msg: "truncated ELF header (no program-header offset)")
    }
    guard let phentsize = elf.u16_at(shape.phentsize_off) else {
        return SosError(msg: "truncated ELF header (no program-header size)")
    }
    guard let phnum = elf.u16_at(shape.phnum_off) else {
        return SosError(msg: "truncated ELF header (no program-header count)")
    }
    if phentsize != (shape.phdr_len as UInt) {
        return SosError(msg: "unexpected ELF program-header size {phentsize}")
    }

    let phoff = phoff_raw as Int
    var segments = Vector<PlacedSeg>()
    var i = 0
    while i < (phnum as Int) {
        let rec = phoff + i * shape.phdr_len
        guard let ptype = elf.u32_at(rec + shape.ph_type) else {
            return SosError(msg: "truncated ELF program header {i}")
        }
        if ptype == PT_LOAD {
            guard let p_offset = shape.word_at(&elf, rec + shape.ph_offset) else {
                return SosError(msg: "truncated ELF program header {i}")
            }
            guard let p_vaddr = shape.word_at(&elf, rec + shape.ph_vaddr) else {
                return SosError(msg: "truncated ELF program header {i}")
            }
            guard let p_filesz = shape.word_at(&elf, rec + shape.ph_filesz) else {
                return SosError(msg: "truncated ELF program header {i}")
            }
            guard let p_memsz = shape.word_at(&elf, rec + shape.ph_memsz) else {
                return SosError(msg: "truncated ELF program header {i}")
            }
            guard let p_flags = elf.u32_at(rec + shape.ph_flags) else {
                return SosError(msg: "truncated ELF program header {i}")
            }
            // A zero-length PT_LOAD carries nothing and would only cost the
            // kernel a grant.
            if p_memsz != 0 {
                // `file_off` is filled in by placement below; everything else
                // is known now.
                let record = SosimgSeg(
                    // 64-bit since v3, so an ELF64 address crosses whole and
                    // there is nothing here that can fail.
                    load_addr: p_vaddr as UInt64,
                    file_off: 0u32,
                    file_len: try narrow(p_filesz, "segment {i} file length"),
                    mem_len: try narrow(p_memsz, "segment {i} memory length"),
                    flags: sos_flags(p_flags),
                    reserved0: 0u8,
                    reserved1: 0u8,
                    reserved2: 0u8,
                )
                segments.push(PlacedSeg(elf_off: p_offset as Int, record: record))
            }
        }
        i = i + 1
    }

    if segments.len() == 0 {
        return SosError(msg: "linked image has no loadable segments")
    }
    move segments
}

/// Which profile's tag an image linked for `target` carries.
///
/// A triple this does not recognize is an ERROR, never a default: emitting an
/// image tagged for the wrong machine is worse than emitting none, because the
/// kernel's arch check would then wave it through.
public func arch_for_target(target: String) -> Result<SosimgArch, SosError> {
    if target.starts_with("riscv32") {
        return SosimgArch.Riscv32
    }
    if target.starts_with("aarch64") || target.starts_with("arm64") {
        return SosimgArch.Arm64
    }
    return SosError(msg: "[sos] target: `{target}` is not a profile sosimg has an arch tag for")
}

/// Convert a linked ELF image into a sosimg carrying `prio_map`, tagged for
/// `arch`, and asking for `device_len` bytes of MMIO at `device_base`.
///
/// A DEVICE WINDOW IS A SEGMENT RECORD WITH NO BYTES, which is what lets the
/// kernel walk one table and find both kinds. It carries `SegFlag.Device`
/// beside read and write, a `file_len` of zero, and the window's size as its
/// `mem_len` — so a loader that ignores the flag would place nothing and grant
/// a region it cannot reach, and one that reads it installs the window.
/// `device_len` of zero means the program asked for none and no record is
/// emitted at all.
public func elf_to_sosimg(elf: &Data, prio_map: UInt, arch: SosimgArch,
                          device_base: UInt = 0,
                          device_len: UInt = 0) -> Result<Data, SosError> {
    let shape = try elf_shape(&elf)
    var segments = try collect_segments(&elf, &shape)

    // LAST, after every loadable segment, so a reader that stops early has
    // still seen the whole program.
    if device_len != 0 {
        segments.push(PlacedSeg(
            elf_off: 0,
            record: SosimgSeg(
                load_addr: device_base as UInt64,
                file_off: 0u32,
                file_len: 0u32,
                mem_len: try narrow(device_len, "device window size"),
                flags: ((SegFlag.Read as UInt8) | (SegFlag.Write as UInt8)
                        | (SegFlag.Device as UInt8)),
                reserved0: 0u8,
                reserved1: 0u8,
                reserved2: 0u8,
            ),
        ))
    }

    guard let entry_raw = shape.word_at(&elf, shape.entry_off) else {
        return SosError(msg: "truncated ELF header (no entry point)")
    }
    // 64-bit since v3 — no narrowing, and so no way to refuse a high entry.
    let entry = entry_raw as UInt64

    let count = segments.len()
    if count > SEG_COUNT_MAX {
        return SosError(msg: "ELF has {count} loadable segments; a sosimg header carries at most {SEG_COUNT_MAX}")
    }
    let header_len = sizeof<SosimgHeader>()
    let seg_len = sizeof<SosimgSeg>()

    // PLACEMENT: decide where each segment's bytes land in the output — after
    // the header and the table, each on a SEGMENT_ALIGN boundary — and record
    // it in the segment's own `file_off`, which is what the table will carry.
    var cursor = header_len + count * seg_len
    var i = 0
    while i < count {
        cursor = align_up(cursor, SEGMENT_ALIGN)
        guard var placed = segments.get(i) else {
            return SosError(msg: "internal: segment {i} vanished")
        }
        // Through `narrow` like every other field of this record: an offset is
        // as much a 32-bit wire field as an address, and this is the one that
        // is computed here rather than read from the ELF, so it is the one a
        // silent `as` would truncate without anything upstream noticing.
        placed.record.file_off = try narrow(cursor as UInt, "segment {i} image offset")
        cursor = cursor + (placed.record.file_len as Int)
        segments.set(i, placed)
        i = i + 1
    }

    var out = Data(capacity: cursor)

    let header = SosimgHeader(
        magic: SOSIMG_MAGIC,
        version: SOSIMG_VERSION,
        seg_count: count as UInt8,
        arch: arch.tag(),
        prio_map: prio_map as UInt32,
        reserved0: 0u32,
        entry: entry,
    )
    out.put_header(&header)

    var t = 0
    while t < count {
        guard let placed = segments.get(t) else {
            return SosError(msg: "internal: segment {t} vanished")
        }
        out.put_seg(&placed.record)
        t = t + 1
    }

    // Segment bytes, padded out to the placements decided above.
    var s = 0
    while s < count {
        guard let placed = segments.get(s) else {
            return SosError(msg: "internal: segment {s} vanished")
        }
        let off = placed.record.file_off as Int
        let len = placed.record.file_len as Int
        while out.len() < off {
            out.put_u8(0)
        }
        var b = 0
        while b < len {
            guard let byte = elf.get(placed.elf_off + b) else {
                return SosError(msg: "segment {s} runs past the end of the linked image")
            }
            out.push(byte)
            b = b + 1
        }
        s = s + 1
    }

    move out
}

/// Read `elf_path`, convert it, and write the image to `img_path`, tagged for
/// the profile it was linked for.
public func write_sosimg(elf_path: Path, img_path: Path, prio_map: UInt,
                         arch: SosimgArch, device_base: UInt = 0,
                         device_len: UInt = 0) -> Result<Int, SosError> {
    var f = match File.open(elf_path) {
        case Ok(handle) -> move handle,
        case Err(e) -> { return SosError(msg: "could not open {elf_path.as_str()}: {e}") }
    }
    let elf = match f.read() {
        case Ok(bytes) -> move bytes,
        case Err(e) -> { return SosError(msg: "could not read {elf_path.as_str()}: {e}") }
    }
    let img = try elf_to_sosimg(&elf, prio_map, arch, device_base, device_len)
    let size = img.len()
    let out = match File.create(img_path) {
        case Ok(handle) -> move handle,
        case Err(e) -> { return SosError(msg: "could not create {img_path.as_str()}: {e}") }
    }
    let written = match out.write(move img) {
        case Ok(n) -> n,
        case Err(e) -> { return SosError(msg: "could not write {img_path.as_str()}: {e}") }
    }
    if written != size {
        return SosError(msg: "short write to {img_path.as_str()} ({written} of {size} bytes)")
    }
    size
}
