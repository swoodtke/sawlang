// Builder - Build orchestration for Blade (design 64 B6)
//
// `blade build` now runs the full dependency pipeline: resolve the graph (or
// honor an existing Saw.lock), write the lock, compile the root with its own
// `--module-path <name>=<root>/src` and one `--module-path <name>=<checkout>/src`
// per resolved dependency (B0), and skip
// the compile entirely when nothing reachable has changed (content-hash build
// avoidance; `--force` bypasses it).
//
// Design 143: every artifact lands in `.build/<target>/`, never beside the
// source, and the up-to-date stamp lives there too — so it answers for one
// target only.

import blade.cli.{BuildOptions, ModulePath}
import blade.layout.*
import blade.linkinputs.*
import blade.manifest.*
import blade.nativec.*
import blade.resolver.*
import blade.lock.*
import blade.sosimg.*
import toml.{TomlDoc, TomlPosition, key_literal, string_literal}
import std.data.{Data}
import std.directory.{Directory}
import std.env.{Env}
import std.file.{File}
import std.path.{Path}
import std.process.{Command}

// =============================================================================
// Error Types
// =============================================================================

public struct BuildError {
    message: String
    exit_code: Int32
}

extension BuildError {
    public init(msg: String) -> BuildError {
        BuildError(message: msg, exit_code: 1 as Int32)
    }

    public init(msg: String, code: Int32) -> BuildError {
        BuildError(message: msg, exit_code: code)
    }
}

// =============================================================================
// File helpers (content hashing)
// =============================================================================

// The entries of `dir` as paths, sorted: `Directory.list` answers in the order
// the system lists them, and a fingerprint must not depend on it. A directory
// that cannot be listed has none, the same as an empty one.
func sorted_entries(dir: String) -> Vector<String> {
    var paths = Vector<String>()
    match Directory.list(Path(s: dir)) {
        case Ok(entries) -> {
            var i = 0
            while i < entries.len() {
                if let e = entries.get(i) {
                    try! paths.push(e.as_string())
                }
                i = i + 1
            }
        },
        case Err(_) -> {}
    }
    paths.sort()
    move paths
}

// Append the path and contents of `path` to `b`, under the line `label`.
func append_file(b: &var StringBuilder, label: String, path: String) {
    try! b.append("\n{label}={path}\n")
    try! b.append(read_file(path))
}

// Append the contents of every `*.saw` file under `dir`, subdirectories
// included, to `b`, in sorted order: a module root's imports reach below it.
func append_tree_saw(b: &var StringBuilder, dir: String) {
    let entries = sorted_entries(dir)
    var i = 0
    while i < entries.len() {
        if let entry = entries.get(i) {
            let e = Path(s: entry)
            // Listing is the directory test (`Directory.exists` answers true
            // for a file too): opendir(3) on a regular file fails.
            let is_directory = match Directory.list(e) {
                case Ok(_) -> true,
                case Err(_) -> false
            }
            if is_directory {
                append_tree_saw(&var b, entry)
            } else if let ext = e.file_extension() {
                if ext.equals("saw") {
                    try! b.append(entry)
                    try! b.append("\n")
                    try! b.append(read_file(entry))
                }
            }
        }
        i = i + 1
    }
}

// =============================================================================
// Build avoidance (freshness stamp)
// =============================================================================

// Has nothing reachable changed since the last build, AND is `artifact`
// still where that build left it? `build` and `build_sos_image` each ran
// this exact check, closed over their own layout/hash/artifact.
func is_up_to_date(layout: &BuildLayout, hash: &String, artifact: String) -> Bool {
    // An empty hash is a build whose inputs could not all be named, and a
    // missing stamp reads as empty: neither may match.
    if hash.is_empty() || not read_file(layout.stamp()).equals(hash) {
        return false
    }
    File.exists(Path(s: artifact))
}

// Record this target's build hash beside its artifact, for the next build's
// `is_up_to_date` to find. A stamp that cannot be written only costs the
// next build its cache hit.
func record_build_stamp(layout: &BuildLayout, hash: &String) {
    match File.create(Path(s: layout.stamp())) {
        case Ok(f) -> {
            let _ = f.write(try! hash.to_data())
        },
        case Err(_) -> print("    (could not record the build hash)")
    }
}

// =============================================================================
// Editing Saw.toml
// =============================================================================

// The table `[ ... ]` a header line names, trimmed, or None for any other line.
func header_inner(line: String) -> String? {
    let t = line.trim()
    if not t.starts_with("[") || t.starts_with("[[") {
        return None
    }
    guard let close = t.index_of(93) else {
        return None
    }
    return t.substring(1, close).trim()
}

// Where `[dependencies]` is written in a manifest that reads, from the library's
// record of where the table was defined: the index of its header line, -1 when
// no header of its own exists (the table is absent, or only `[dependencies.x]`
// headers made it), or a `problem` when a line cannot be added to it.
struct DependenciesAt {
    line: Int
    problem: String
}

func locate_dependencies(doc: &TomlDoc, name: String, lines: &Vector<String>) -> DependenciesAt {
    if not doc.root().contains("dependencies") {
        return DependenciesAt(line: -1, problem: "")
    }
    var already = false
    var at = TomlPosition(line: 1, column: 1)
    if let deps = doc.root().table("dependencies") {
        already = deps.contains(name)
        at = deps.defined_at()
    } else {
        return DependenciesAt(line: -1, problem: "`dependencies` is not a table")
    }
    if already {
        return DependenciesAt(line: -1, problem: "`{name}` is already a dependency")
    }
    let text = (lines.get(at.line - 1) ?? "").trim()
    if let inner = header_inner(text) {
        if inner.equals("dependencies") || inner.equals("\"dependencies\"") || inner.equals("'dependencies'") {
            return DependenciesAt(line: at.line - 1, problem: "")
        }
        return DependenciesAt(line: -1, problem: "")
    }
    let eq = text.index_of(61) ?? 0
    if text.substring(0, eq).contains(".") {
        return DependenciesAt(line: -1, problem: "`dependencies` is written as dotted keys (`dependencies.x = ...`), which a line cannot be added to; edit it by hand")
    }
    return DependenciesAt(line: -1, problem: "`dependencies` is written as an inline table (`dependencies = \{ ... \}`), which a line cannot be added to; edit it by hand")
}

// `manifest` with the line `entry` (ending in a newline) inside its
// `[dependencies]` table, which `locate_dependencies` found at `header`: after
// the table's last entry when another table follows it, at the end of the file
// when it is last, and in a table added at the end when there is none. Comments
// and blank lines are left where they are; a line is a header when its first
// character is `[`, which a TOML key cannot start with. The scan does not read
// strings, so a multi-line string or array in the table's own body that holds a
// line beginning with `[` misplaces the entry, and `with_dependency`'s read-back
// refuses the result: that refusal is the behaviour.
func insert_dependency(manifest: String, lines: &Vector<String>, header: Int, entry: String) -> String {
    var b = StringBuilder()
    if header < 0 {
        try! b.append(manifest)
        try! b.append("\n[dependencies]\n")
        try! b.append(entry)
        return b.build()
    }

    // The next table's header, and the last line of the body that is neither
    // blank nor a comment: a comment before the next header belongs to it.
    var next = -1
    var last_entry = header
    var j = header + 1
    while j < lines.len() && next < 0 {
        let t = (lines.get(j) ?? "").trim()
        if t.starts_with("[") {
            next = j
        } else if not t.is_empty() && not t.starts_with("#") {
            last_entry = j
        }
        j = j + 1
    }
    if next < 0 {
        try! b.append(manifest)
        if not manifest.ends_with("\n") {
            try! b.append("\n")
        }
        try! b.append(entry)
        return b.build()
    }
    // The lines go back joined by the `\n` they were split on; `next` follows
    // `last_entry`, so the entry always lands between two of them.
    var k = 0
    while k < lines.len() {
        if k > 0 {
            try! b.append("\n")
        }
        try! b.append(lines.get(k) ?? "")
        if k == last_entry {
            try! b.append("\n")
            try! b.append(entry.replace("\n", ""))
        }
        k = k + 1
    }
    return b.build()
}

// `manifest` with the dependency `name` added by the line `entry`, or the
// reason it cannot be. The new text is read back before it is returned: a text
// that does not read, or that lacks `name` in `[dependencies]`, is refused, so
// the caller never writes a manifest `add` has broken.
func with_dependency(manifest: String, name: String, entry: String) -> Result<String, BuildError> {
    let lines = try! manifest.split("\n")
    let found = match TomlDoc.parse(manifest) {
        case Ok(doc) -> locate_dependencies(&doc, name, &lines),
        case Err(e) -> { return BuildError(msg: "Saw.toml: {e}") }
    }
    if not found.problem.is_empty() {
        return BuildError(msg: "Saw.toml: {found.problem}")
    }
    let text = insert_dependency(manifest, &lines, found.line, entry)
    var present = false
    match TomlDoc.parse(text) {
        case Ok(after) -> {
            if let deps = after.root().table("dependencies") {
                present = deps.contains(name)
            }
        },
        case Err(e) -> {
            return BuildError(msg: "Saw.toml: adding `{name}` would leave a manifest that does not read ({e}); Saw.toml is unchanged")
        }
    }
    if not present {
        return BuildError(msg: "Saw.toml: adding `{name}` did not put it in [dependencies]; Saw.toml is unchanged")
    }
    return text
}

// The message of a `[sos]` failure: Blade's own wording gets the `Saw.toml
// [sos]:` prefix, and one that already names the manifest's file (a TOML
// error, which is read through `in_manifest`) stands as it is.
public func sos_failure_text(manifest_path: String, error: String) -> String {
    if error.starts_with(manifest_path) {
        error
    } else {
        "Saw.toml [sos]: {error}"
    }
}

// =============================================================================
// Builder - Compiles Saw projects
// =============================================================================

public struct Builder {
    private manifest: Manifest
    private layout: BuildLayout
    // The triple `--target` asked for, kept as WRITTEN rather than only as the
    // layout's directory name: an SOS package may carry a `[sos.<triple>]`
    // section per machine, and selecting one needs the request itself.
    private requested_target: String
    // `--linker-script`, or empty: replaces the selected `[sos.<triple>]`
    // section's `linker-script` for an image build.
    private linker_script: String
    // `--module-path NAME=DIR`, passed to sawc after the dependencies' own.
    private module_paths: Vector<ModulePath>
}

@synthesize
extension Builder: ExplicitCopy {}

extension Builder {
    // A builder for the default hosted build.
    public init(m: Manifest) -> Builder {
        Builder(manifest: m, layout: BuildLayout(), requested_target: "",
                linker_script: "", module_paths: Vector<ModulePath>())
    }

    // A builder for an explicit sawc target triple; an empty `target` is the
    // hosted default, which is how a command with no `--target` spells itself.
    public init(m: Manifest, target: String) -> Builder {
        Builder(manifest: m, layout: BuildLayout(triple: target),
                requested_target: target, linker_script: "",
                module_paths: Vector<ModulePath>())
    }

    // A builder for `blade build`'s options: target, build directory, linker
    // script and module paths.
    public init(m: Manifest, options: BuildOptions) -> Builder {
        Builder(manifest: m,
                layout: BuildLayout(triple: options.target, out_dir: options.out_dir),
                requested_target: options.target,
                linker_script: options.linker_script,
                module_paths: options.module_paths.copy())
    }

    // The compiler command. Honours a `SAWC` override so an in-tree compiler can
    // drive the build (matches the tester).
    public func compiler(&self) -> String {
        if let c = (try! Env.get("SAWC")) {
            c
        } else {
            "sawc"
        }
    }

    // `SAWC` as a spawnable Command. The variable may hold a full command line
    // (`/path/to/python /path/to/sawc.py`, which is how the bootstrap drives the
    // in-tree compiler), so it is split on spaces here — the `CC="ccache gcc"`
    // convention, applied deliberately and locally to an environment variable.
    // `Command` itself never splits or interprets anything: one `arg` is one
    // argv element (design 122).
    public func compiler_command(&self) -> Command {
        let words = try! self.compiler().split(" ")
        var program = "sawc"
        if let first = words.get(0) {
            if not first.is_empty() {
                program = first
            }
        }
        var cmd = Command(program: program)
        var i = 1
        while i < words.len() {
            if let extra = words.get(i) {
                if not extra.is_empty() {
                    try! cmd.arg(extra)
                }
            }
            i = i + 1
        }
        move cmd
    }

    // Find the main source file
    public func find_source_file(&self) -> String? {
        let src_main = Path(s: "src/main.saw")
        if File.exists(src_main) {
            return "src/main.saw"
        }
        let root_main = Path(s: "main.saw")
        if File.exists(root_main) {
            return "main.saw"
        }
        let src_lib = Path(s: "src/lib.saw")
        if File.exists(src_lib) {
            return "src/lib.saw"
        }
        None
    }

    // True when this package builds a program rather than a library.
    //
    // There is no manifest field for the distinction — the source layout IS the
    // declaration: `src/main.saw` (or a root `main.saw`) is an application, a
    // package whose only entry is `src/lib.saw` is a library. Design 143 hangs
    // the lockfile policy on it: an application commits its `Saw.lock`, a
    // library does not.
    public func is_application(&self) -> Bool {
        File.exists(Path(s: "src/main.saw")) || File.exists(Path(s: "main.saw"))
    }

    // The local directory a resolved dependency lives in: the path dir itself,
    // or the git checkout under .blade/deps/.
    public func dep_dir(&self, res: &Resolution, i: Int) -> String {
        if res.kind(i).equals("git") {
            ".blade/deps/{res.name(i)}-{res.version(i)}"
        } else {
            res.loc(i)
        }
    }

    // The first line `<compiler> --version` prints, run as `compiler_command`
    // builds it; "" when the command cannot run, fails or prints nothing.
    func compiler_version(&self) -> String {
        var query = self.compiler_command()
        try! query.arg("--version")
        guard let out = try? query.output() else {
            return ""
        }
        if not out.success() {
            return ""
        }
        let lines = try! out.stdout.split("\n")
        lines.get(0) ?? ""
    }

    // What `<compiler> --build-id` prints, run as `compiler_command` builds it:
    // the one non-empty line it answers with, which names the compiler binary,
    // its std and its runtime. A compiler that refuses the flag as a usage
    // error (exit status 2, as an older `sawc` does) is identified by
    // `compiler_version()` instead. "" when the command cannot run, fails
    // otherwise, or prints anything but one line.
    func compiler_identity(&self) -> String {
        var query = self.compiler_command()
        try! query.arg("--build-id")
        guard let out = try? query.output() else {
            return ""
        }
        if out.exit_code == (2 as Int32) {
            return self.compiler_version()
        }
        if not out.success() {
            return ""
        }
        let lines = try! out.stdout.split("\n")
        var i = 1
        while i < lines.len() {
            if not (lines.get(i) ?? "").is_empty() {
                return ""
            }
            i = i + 1
        }
        lines.get(0) ?? ""
    }

    // Content hash of everything the build reads or chooses, hashing CONTENT,
    // not mtimes. One line per class of input:
    //   - the marker `blade-hash-3;`, so a stamp from another hash layout never matches
    //   - `Saw.toml` and `Saw.lock`
    //   - every `*.saw` under the package's `src` and under each dependency's
    //     `src`, subdirectories included, in sorted order
    //   - the entry file, by path and content, when it is not under `src`
    //     (a root `main.saw`)
    //   - each resolved dependency's `Saw.toml`
    //   - the target `layout` names (an out-dir is the caller's, so one stamp
    //     may be asked about by builds for different targets)
    //   - `linker_script` ("" for none), by path and content
    //   - each `--module-path` entry: NAME, DIR as written, and the `*.saw`
    //     under DIR
    //   - `native`, an image's space-separated native units, each by path and
    //     content; a header a unit includes is not tracked
    //   - `plan`, the link inputs of the `[native]` tables (nothing when there are
    //     none): each object's and archive's path and BYTES, then the library
    //     directories, libraries and frameworks by name; a named system
    //     library's contents are not tracked
    //   - `tools`, the C compiler and linker an image build will run ("" for a
    //     hosted build)
    //   - the `SAWC` command, or that it is unset
    //   - the compiler's identity, `compiler_identity()`: `sawc --build-id`,
    //     which covers the binary, its std and its runtime, or the first line
    //     of `--version` for a compiler that does not know the flag
    // Returns "" when the compiler's identity cannot be read: that build is
    // never up to date, and compiling reports the real failure.
    //
    // ENTRY POINTS:
    //   build
    //   build_sos_image
    public func build_hash(&self, res: &Resolution, layout: &BuildLayout, linker_script: String,
                           native: String, plan: &NativePlan, tools: String) -> String {
        let identity = self.compiler_identity()
        if identity.is_empty() {
            return ""
        }
        var b = StringBuilder()
        try! b.append("blade-hash-3;")
        try! b.append(read_file("Saw.toml"))
        try! b.append(read_file("Saw.lock"))
        append_tree_saw(&var b, "src")
        if let entry = self.find_source_file() {
            if not entry.starts_with("src/") {
                append_file(&var b, "entry", entry)
            }
        }
        var i = 0
        while i < res.len() {
            let dir = self.dep_dir(&res, i)
            append_tree_saw(&var b, "{dir}/src")
            append_file(&var b, "dependency-manifest", "{dir}/Saw.toml")
            i = i + 1
        }
        try! b.append("\ntarget={layout.target_name()}\n")
        if not linker_script.is_empty() {
            append_file(&var b, "linker-script", linker_script)
        }
        var m = 0
        while m < self.module_paths.len() {
            if let entry = self.module_paths.get(m) {
                try! b.append("\nmodule-path={entry.name}={entry.dir}\n")
                append_tree_saw(&var b, entry.dir)
            }
            m = m + 1
        }
        let units = try! native.split(" ")
        var u = 0
        while u < units.len() {
            if let unit = units.get(u) {
                if not unit.is_empty() {
                    append_file(&var b, "native", unit)
                }
            }
            u = u + 1
        }
        var c = 0
        while c < plan.sources.len() {
            if let one = plan.sources.find(c) {
                try! b.append("\nnative-c-key={one.object} {read_file("{one.object}.key")}\n")
            }
            c = c + 1
        }
        var f = 0
        while f < plan.files.len() {
            if let entry = plan.files.get(f) {
                try! b.append("\nnative-{entry.kind}={entry.value} {file_digest(entry.value)}\n")
            }
            f = f + 1
        }
        var d = 0
        while d < plan.library_paths.len() {
            try! b.append("\nnative-library-path={plan.library_paths.get(d) ?? ""}\n")
            d = d + 1
        }
        var l = 0
        while l < plan.libraries.len() {
            try! b.append("\nnative-library={plan.libraries.get(l) ?? ""}\n")
            l = l + 1
        }
        var w = 0
        while w < plan.frameworks.len() {
            try! b.append("\nnative-framework={plan.frameworks.get(w) ?? ""}\n")
            w = w + 1
        }
        try! b.append("\ntools={tools}\n")
        if let named = try! Env.get("SAWC") {
            try! b.append("\nsawc={named}\n")
        } else {
            try! b.append("\nsawc-unset\n")
        }
        try! b.append("\ncompiler-identity={identity}\n")
        hash_string(b.build())
    }

    // The tables of `tables` (`[native.<triple>]` names, `owners[k]` the package
    // that wrote `tables[k]`) that apply to a build for `target`, "" for the
    // host. Each name is put to the compiler: one it does not know is refused,
    // naming the package. A table applies when it names the target; for the host,
    // when `sawc tools --target NAME` reports the triple the host's does.
    func tables_applying(&self, tables: &Vector<String>, owners: &Vector<String>, target: String) -> Result<Vector<String>, NativeError> {
        var host = ""
        if target.is_empty() && tables.len() > 0 {
            var ask = self.compiler_command()
            try! ask.arg("tools")
            guard let out = try? ask.output() else {
                return NativeError(msg: "[native.<triple>] tables: could not ask the compiler for the host's triple (`sawc tools`)")
            }
            guard out.success() else {
                return NativeError(msg: "[native.<triple>] tables: `sawc tools` failed, so the host's triple is unknown")
            }
            guard let triple = recorded_tool(out.stdout, "triple") else {
                return NativeError(msg: "[native.<triple>] tables: `sawc tools` did not report the host's triple")
            }
            host = triple
        }
        var applying = Vector<String>()
        var i = 0
        while i < tables.len() {
            let name = tables.get(i) ?? ""
            let owner = owners.get(i) ?? ""
            i = i + 1
            var ask = self.compiler_command()
            try! ask.arg("tools")
            try! ask.arg("--target")
            try! ask.arg(name)
            guard let out = try? ask.output() else {
                return NativeError(msg: "package `{owner}` [native.{name}]: could not ask the compiler whether `{name}` is a target")
            }
            if out.exit_code == (2 as Int32) {
                return NativeError(msg: "package `{owner}` [native.{name}]: `{name}` is not a target the compiler knows: name a triple `--target` takes")
            }
            if target.is_empty() {
                let triple = recorded_tool(out.stdout, "triple") ?? ""
                if out.success() && not host.is_empty() && triple.equals(host) {
                    try! applying.push(name)
                }
            } else if name.equals(target) {
                try! applying.push(name)
            }
        }
        move applying
    }

    // The link inputs of every package's `[native]` for a build for `target`
    // ("" is the host): each manifest read, the triple tables that apply kept,
    // each path expanded against its own package, and the packages ordered and
    // deduplicated by `native_plan`.
    public func link_plan(&self, res: &Resolution, target: String, layout: &BuildLayout) -> Result<NativePlan, BuildError> {
        var names = Vector<String>()
        var dirs = Vector<String>()
        try! names.push(self.manifest.name())
        try! dirs.push(self.manifest.root_dir.as_string())
        var i = 0
        while i < res.len() {
            try! names.push(res.name(i))
            try! dirs.push(self.dep_dir(&res, i))
            i = i + 1
        }
        var entries = Vector<NativeEntry>()
        var owner_of = Vector<Int>()
        var p = 0
        while p < names.len() {
            let found = if p == 0 {
                self.manifest.native_entries()
            } else {
                match Manifest.load_from(Path(s: dirs.get(p) ?? "")) {
                    case Ok(m) -> m.native_entries(),
                    case Err(e) -> { return BuildError(msg: "cannot read the manifest of `{names.get(p) ?? ""}`: {e}") }
                }
            }
            match found {
                case Ok(list) -> {
                    var k = 0
                    while k < list.len() {
                        if let entry = list.get(k) {
                            try! entries.push(entry)
                            try! owner_of.push(p)
                        }
                        k = k + 1
                    }
                },
                case Err(e) -> { return BuildError(msg: "{e}") }
            }
            p = p + 1
        }
        var tables = Vector<String>()
        var owners = Vector<String>()
        var e = 0
        while e < entries.len() {
            if let entry = entries.get(e) {
                if not entry.table.is_empty() && not contains_name(&tables, entry.table) {
                    try! tables.push(entry.table)
                    try! owners.push(names.get(owner_of.get(e) ?? 0) ?? "")
                }
            }
            e = e + 1
        }
        var applying = Vector<String>()
        if tables.len() > 0 {
            match self.tables_applying(&tables, &owners, target) {
                case Ok(found) -> { applying = move found },
                case Err(err) -> { return BuildError(msg: err.text()) }
            }
        }
        // `sources` are the C sources, `includes` and `defines` what their
        // packages hand the compile, and `rows` every other link input.
        var rows = Vector<LinkEntry>()
        var sources = Vector<LinkEntry>()
        var includes = Vector<LinkEntry>()
        var defines = Vector<LinkEntry>()
        var r = 0
        while r < entries.len() {
            guard let entry = entries.get(r) else {
                break
            }
            let at = owner_of.get(r) ?? 0
            r = r + 1
            if not entry.table.is_empty() && not contains_name(&applying, entry.table) {
                continue
            }
            let package = names.get(at) ?? ""
            if entry.kind.equals("library") || entry.kind.equals("framework") {
                try! rows.push(LinkEntry(package: package, kind: entry.kind, value: entry.value))
                continue
            }
            if entry.kind.equals("define") {
                try! defines.push(LinkEntry(package: package, kind: entry.kind, value: entry.value))
                continue
            }
            match expand_native_value(package, dirs.get(at) ?? "", entry.kind, entry.value) {
                case Ok(paths) -> {
                    var q = 0
                    while q < paths.len() {
                        let found = LinkEntry(package: package, kind: entry.kind, value: paths.get(q) ?? "")
                        if entry.kind.equals("c-source") {
                            try! sources.push(found)
                        } else if entry.kind.equals("include-dir") {
                            try! includes.push(found)
                        } else {
                            try! rows.push(found)
                        }
                        q = q + 1
                    }
                },
                case Err(err) -> { return BuildError(msg: err.text()) }
            }
        }
        // Each C source's object is a link object of its package, placed
        // before the package's prebuilt ones.
        var compiled = Vector<CSource>()
        var linked = Vector<LinkEntry>()
        var s = 0
        while s < sources.len() {
            guard let found = sources.get(s) else {
                break
            }
            s = s + 1
            let object = native_object_path(layout.dir(), found.package, found.value)
            var already = false
            var c = 0
            while c < compiled.len() {
                if let seen = compiled.find(c) {
                    if seen.object.equals(object) {
                        already = true
                    }
                }
                c = c + 1
            }
            if already {
                continue
            }
            try! compiled.push(CSource(package: found.package, source: found.value, object: object,
                                       includes: values_of(&includes, found.package),
                                       defines: values_of(&defines, found.package)))
            try! linked.push(LinkEntry(package: found.package, kind: "object", value: object))
        }
        var l = 0
        while l < rows.len() {
            try! linked.push(rows.get(l) ?? LinkEntry(package: "", kind: "object", value: ""))
            l = l + 1
        }
        var requirers = Vector<String>()
        var required = Vector<String>()
        var k = 0
        while k < res.edge_count() {
            try! requirers.push(res.edge_from(k))
            try! required.push(res.edge_to(k))
            k = k + 1
        }
        let order = link_order(&names, &requirers, &required)
        var plan = native_plan(&names, &order, &linked)
        var d = 0
        while d < compiled.len() {
            if let one = compiled.find(d) {
                try! plan.sources.push(one.copy())
            }
            d = d + 1
        }
        return move plan
    }

    // Runs the C compiles `jobs` with `clang`: the objects land where the plan's
    // link inputs name them, and a failure is the build's error.
    func compile_native(&self, clang: String, jobs: &Vector<CJob>) -> Result<Void, BuildError> {
        let identity = match clang_identity(clang) {
            case Ok(found) -> found,
            case Err(e) -> { return BuildError(msg: e.text()) }
        }
        match compile_c_sources(&jobs, clang, identity) {
            case Ok(_) -> {},
            case Err(e) -> { return BuildError(msg: e.text()) }
        }
        return
    }

    // What `sawc tools` prints for `target` ("" is the host).
    func sawc_tools(&self, target: String) -> Result<String, BuildError> {
        var ask = self.compiler_command()
        try! ask.arg("tools")
        if not target.is_empty() {
            try! ask.arg("--target")
            try! ask.arg(target)
        }
        guard let out = try? ask.output() else {
            return BuildError(msg: "could not run `sawc tools` to find the C compiler")
        }
        if not out.success() {
            return BuildError(msg: "`sawc tools` failed, so the C compiler is unknown: {out.stdout}")
        }
        return out.stdout
    }

    // Compiles the C sources of `plan` for a hosted build for `target` ("" is
    // the host), the clang and triple `sawc tools` names, with the hosted
    // flags. A plan with no C sources runs nothing, not even `sawc tools`.
    public func compile_hosted(&self, plan: &NativePlan, target: String) -> Result<Void, BuildError> {
        if plan.sources.len() == 0 {
            return
        }
        let recorded = try self.sawc_tools(target)
        let tools = match hosted_c_tools(recorded) {
            case Ok(found) -> found,
            case Err(e) -> { return BuildError(msg: e.text()) }
        }
        var jobs = Vector<CJob>()
        var i = 0
        while i < plan.sources.len() {
            if let one = plan.sources.find(i) {
                let depfile = "{one.object}.d"
                let args = hosted_compile_arguments(tools.triple, one.source, one.object, depfile,
                                                    &one.includes, &one.defines)
                try! jobs.push(CJob(source: &one, arguments: move args))
            }
            i = i + 1
        }
        return try self.compile_native(tools.clang, &jobs)
    }

    // Refuse a `--module-path` before anything is compiled: a DIR that does not
    // exist, and a NAME a package of this build already has (the package
    // itself or a resolved dependency), naming both sources.
    func check_module_paths(&self, res: &Resolution) -> Result<Void, BuildError> {
        var m = 0
        while m < self.module_paths.len() {
            guard let entry = self.module_paths.get(m) else {
                break
            }
            if not Directory.exists(Path(s: entry.dir)) {
                return BuildError(msg: "blade build: `--module-path {entry.name}={entry.dir}`: no such directory `{entry.dir}`")
            }
            match Directory.list(Path(s: entry.dir)) {
                case Ok(_) -> {},
                case Err(_) -> {
                    return BuildError(msg: "blade build: `--module-path {entry.name}={entry.dir}`: `{entry.dir}` is not a directory")
                }
            }
            if entry.name.equals(self.manifest.name()) {
                return BuildError(msg: "blade build: `--module-path {entry.name}={entry.dir}` names this package, which maps `{entry.name}` to its own src")
            }
            var i = 0
            while i < res.len() {
                if res.name(i).equals(entry.name) {
                    return BuildError(msg: "blade build: `--module-path {entry.name}={entry.dir}` names a dependency already: `{entry.name}` is `{self.dep_dir(&res, i)}/src` from Saw.toml")
                }
                i = i + 1
            }
            m = m + 1
        }
        return
    }

    // Pass the `--module-path` entries on to sawc, after the package's own and
    // its dependencies'.
    func add_module_paths(&self, cmd: &var Command) {
        var m = 0
        while m < self.module_paths.len() {
            if let entry = self.module_paths.get(m) {
                try! cmd.arg("--module-path")
                try! cmd.arg("{entry.name}={entry.dir}")
            }
            m = m + 1
        }
    }

    // Resolve dependencies for a BUILD, honoring Saw.lock (design 64 B4).
    //
    // - No lock (or an unparseable one): resolve fresh and WRITE the lock.
    // - Lock present + current (its manifest-deps hash still matches Saw.toml):
    //   HONOR it — resolve to reconstruct the on-disk paths but do NOT rewrite the
    //   committed lock.
    // - Lock present + DRIFTED (deps edited in Saw.toml): refuse to silently
    //   re-resolve; error toward `blade update`.
    //
    // The write happens for an APPLICATION only (design 143). An application's
    // lockfile pins its reproducible build and is committed; a library's
    // resolution belongs to whoever consumes it, so Blade does not leave one
    // behind in a library that the author would then have to know not to commit.
    // `blade update` still writes one either way — that is the explicit ask.
    //
    // (Path deps have exactly one candidate — the depended-on package's own
    // manifest version — so an honored re-resolve is deterministic and equals the
    // lock. Pinning a git dep to its locked rev without re-resolution is future
    // work: build-from-lock needs the resolver's path reconstruction.)
    public func resolve_deps(&self) -> Result<Resolution, BuildError> {
        let lock_content = read_file("Saw.lock")
        var honor = false
        if not lock_content.is_empty() {
            guard let lock = parse_lock(lock_content) else {
                return BuildError(msg: "Saw.lock is malformed; run `blade update` to regenerate it")
            }
            if not lock_is_current(&lock, self.manifest) {
                return BuildError(msg: "Saw.lock is out of date (Saw.toml dependencies changed); run `blade update` to re-resolve")
            }
            honor = true
        }
        match resolve(self.manifest) {
            case Ok(res) -> {
                if not honor {
                    if self.is_application() {
                        let mhash = manifest_deps_hash(self.manifest)
                        let _ = write_lock(&res, mhash, Path(s: "Saw.lock"))
                    }
                }
                move res
            },
            case Err(e) -> BuildError(msg: "dependency resolution failed: {e.text()}")
        }
    }

    // `blade update`: re-resolve fresh and rewrite Saw.lock, whatever its current
    // state (design 64 B4). This is the sanctioned way to change the lock after
    // editing Saw.toml's dependencies.
    public func update(&self) -> Result<Int, BuildError> {
        match resolve(self.manifest) {
            case Ok(res) -> {
                let mhash = manifest_deps_hash(self.manifest)
                if not write_lock(&res, mhash, Path(s: "Saw.lock")) {
                    return BuildError(msg: "could not write Saw.lock")
                }
                print("    Updated Saw.lock ({res.len()} dependency package(s))")
                0
            },
            case Err(e) -> BuildError(msg: "dependency resolution failed: {e.text()}")
        }
    }

    // Run one build tool, turning a non-zero exit or a failed launch into a
    // BuildError. Used by the sosimg pipeline, which drives three of them.
    func run_tool(&self, cmd: &Command, what: String) -> Result<Void, BuildError> {
        // Both arms are STATEMENTS and the Ok result is returned below. A tail
        // `match` with one diverging arm and one bare-error arm miscompiles
        // (DF-140e) — the arms unify to the error type and the auto-wrap into
        // `Err` is dropped, so the function returns a raw BuildError.
        match cmd.wait() {
            case Ok(code) -> {
                if code != (0 as Int32) {
                    return BuildError(msg: "{what} failed", code: code)
                }
            },
            case Err(e) -> {
                return BuildError(msg: "could not launch {what}: {e}")
            }
        }
        return
    }

    // What `sawc tools --target <target>` prints, the compiler's record of the
    // tools that compile for the target; "" when both `SOS_CLANG` and `SOS_LD`
    // are set (nothing to ask), or when the query fails or the compiler has no
    // such command, so the callers fall back to their defaults.
    func recorded_tools(&self, target: String) -> String {
        if not sos_tools_wanted() {
            return ""
        }
        var query = self.compiler_command()
        try! query.arg("tools")
        try! query.arg("--target")
        try! query.arg(target)
        guard let out = try? query.output() else {
            return ""
        }
        if not out.success() {
            return ""
        }
        out.stdout
    }

    // Build an SOS process image (design 140 unit B; sos/spec.md §6).
    //
    // `sawc --freestanding` for the Saw half, the cross `clang` for the one
    // native translation unit a freestanding SOS process needs (its syscall
    // stub — no amount of Saw emits an `ecall`), `ld.lld` with the package's
    // linker script to place it at its fixed load address, then ELF -> sosimg.
    // The kernel gets a header it can walk with a handful of aligned loads and
    // never has to know what an ELF is.
    func build_sos_image(&self, cfg: &SosConfig, force: Bool) -> Result<Int, BuildError> {
        guard let source_file = self.find_source_file() else {
            return BuildError(msg: "No main.saw or lib.saw found")
        }
        let name = self.manifest.name()

        // Design 143: an SOS image is an artifact like any other, so it lands
        // in `.build/<target>/` rather than beside the source. The layout
        // accommodates this target by construction — a package cross-built for
        // two architectures gets two directories instead of two `.sosimg`
        // files fighting over one name.
        let layout = self.layout.retargeted(cfg.target)
        let image = layout.artifact("{name}.sosimg")

        // `--linker-script` replaces the manifest's; either way it must exist
        // before anything compiles, and its content is hashed.
        let script = if self.linker_script.is_empty() {
            cfg.linker_script
        } else {
            self.linker_script
        }
        if not File.exists(Path(s: script)) {
            return BuildError(msg: "blade build: linker script `{script}` does not exist")
        }
        // Listing is the directory test, as in `check_module_paths`.
        match Directory.list(Path(s: script)) {
            case Ok(_) -> {
                return BuildError(msg: "blade build: linker script `{script}` is a directory")
            },
            case Err(_) -> {}
        }

        let res = try self.resolve_deps()
        try self.check_module_paths(&res)

        // The tools the build will run, resolved once: the hash names them and
        // the compile below runs them.
        let recorded = self.recorded_tools(cfg.target)
        let clang = sos_clang(recorded)
        let linker = sos_ld(recorded)
        let plan = try self.link_plan(&res, cfg.target, &layout)
        // A framework is refused before any C compiles.
        if plan.frameworks.len() > 0 {
            var none = Vector<String>()
            match sos_link_arguments(script, "", &none, &plan) {
                case Ok(_) -> {},
                case Err(refusal) -> { return BuildError(msg: "blade build: {refusal.text()}") }
            }
        }
        // The image's C sources compile as its `[sos.<triple>] native` units do,
        // with the include directories, defines and depfile added.
        var image_jobs = Vector<CJob>()
        var j = 0
        while j < plan.sources.len() {
            if let one = plan.sources.find(j) {
                let depfile = "{one.object}.d"
                var args = native_compile_arguments(&cfg, one.source, one.object)
                let extra = c_extra_arguments(depfile, &one.includes, &one.defines)
                var x = 0
                while x < extra.len() {
                    try! args.push(extra.get(x) ?? "")
                    x = x + 1
                }
                try! image_jobs.push(CJob(source: &one, arguments: move args))
            }
            j = j + 1
        }
        if image_jobs.len() > 0 {
            try self.compile_native(clang, &image_jobs)
        }
        let hash = self.build_hash(&res, &layout, script, cfg.native, &plan,
                                   "clang={clang}\nld={linker}")
        if not force && is_up_to_date(&layout, &hash, image) {
            print("    Finished {image} (up to date)")
            return 0
        }

        print("   Compiling {name} v{self.manifest.version()} (sosimg, {cfg.target})")
        if not layout.ensure() {
            return BuildError(msg: "could not create {layout.dir()}")
        }

        let obj = layout.artifact("{name}.o")
        let elf = layout.artifact("{name}.elf")

        var saw = self.compiler_command()
        try! saw.arg(source_file)
        try! saw.arg("-o")
        try! saw.arg(obj)
        try! saw.arg("--freestanding")
        try! saw.arg("--target")
        try! saw.arg(cfg.target)
        // design 149, reaching the SOS image path (design 172 part 2): a
        // freestanding image that carries its own `__saw_rt_*` bodies says so
        // with `[package] runtime = true`, exactly as a host runtime package
        // does below in `build`. The seams may come from a DEPENDENCY — SOS
        // process images get them from `sosrt` — because the flag describes
        // the COMPILE, and a package build compiles its whole module graph
        // into one unit.
        if self.manifest.is_runtime() {
            try! saw.arg("--runtime")
        }
        if self.manifest.is_no_hidden_alloc() {
            try! saw.arg("--no-hidden-alloc")
        }
        if not self.manifest.task_frame_flag().is_empty() {
            try! saw.arg(self.manifest.task_frame_flag())
        }
        if not cfg.target_features.is_empty() {
            try! saw.arg("--target-features")
            try! saw.arg(cfg.target_features)
        }
        // The package's own name maps to its module root, so its sources may
        // import one another as `<name>.module`.
        try! saw.arg("--module-path")
        try! saw.arg(self.manifest.own_module_path())
        var i = 0
        while i < res.len() {
            try! saw.arg("--module-path")
            try! saw.arg("{res.name(i)}={self.dep_dir(&res, i)}/src")
            i = i + 1
        }
        self.add_module_paths(&var saw)
        try self.run_tool(&saw, "sawc")

        var objects = Vector<String>()
        try! objects.push(obj)

        // `[sos] native` is a space-separated list of translation units, each
        // compiled separately so a HAL file and a shared runtime file can be
        // named without either knowing about the other.
        let units = try! cfg.native.split(" ")
        var u = 0
        while u < units.len() {
            guard let unit = units.get(u) else {
                u = u + 1
                continue
            }
            if unit.is_empty() {
                u = u + 1
                continue
            }
            let native_obj = layout.artifact("{name}.native{u}.o")
            var cc = Command(program: clang)
            // The argument list is `native_compile_arguments`, so a test can
            // pin it without a toolchain.
            let cc_args = native_compile_arguments(&cfg, unit, native_obj)
            var a = 0
            while a < cc_args.len() {
                try! cc.arg(cc_args.get(a) ?? "")
                a = a + 1
            }
            try self.run_tool(&cc, "clang")
            try! objects.push(native_obj)
            u = u + 1
        }

        // Every package's `[native]` inputs follow the image's own objects: the
        // archives after the objects that need them.
        let ld_args = match sos_link_arguments(script, elf, &objects, &plan) {
            case Ok(found) -> move found,
            case Err(e) -> { return BuildError(msg: "blade build: {e.text()}") }
        }
        var ld = Command(program: linker)
        var n = 0
        while n < ld_args.len() {
            try! ld.arg(ld_args.get(n) ?? "")
            n = n + 1
        }
        try self.run_tool(&ld, "ld.lld")

        // The image is tagged for the profile it was linked for, from the one
        // place that knows which that is: the manifest's target triple. A
        // triple with no tag is a build error rather than an untagged image.
        let arch = match arch_for_target(cfg.target) {
            case Ok(found) -> found,
            case Err(e) -> { return BuildError(msg: "could not emit {image}: {e.text()}") }
        }

        match write_sosimg(Path(s: elf), Path(s: image), cfg.prio_map, arch,
                           cfg.device_base, cfg.device_len) {
            case Ok(size) -> {
                record_build_stamp(&layout, &hash)
                print("    Finished {image} ({size} bytes)")
                0
            },
            case Err(e) -> BuildError(msg: "could not emit {image}: {e.text()}")
        }
    }

    // Compile the project. `force` bypasses build avoidance.
    //
    // A package whose manifest carries `[sos]` builds to an SOS process image
    // rather than a host executable — a different linker, a different output,
    // and no host runtime at all.
    public func build(&self, force: Bool) -> Result<Int, BuildError> {
        var sos_cfg: SosConfig? = None
        match load_sos_config(self.manifest.root_dir, self.requested_target) {
            case Ok(found) -> { sos_cfg = found },
            case Err(e) -> {
                let named = self.manifest.root_dir.join("Saw.toml").as_string()
                return BuildError(msg: sos_failure_text(named, "{e}"))
            }
        }
        if let cfg = sos_cfg {
            return self.build_sos_image(&cfg, force)
        }
        if not self.linker_script.is_empty() {
            return BuildError(msg: "blade build: `--linker-script` applies to an image build ([sos] in Saw.toml), and this package builds no image for {self.layout.target_name()}")
        }

        guard let source_file = self.find_source_file() else {
            return BuildError(msg: "No main.saw or lib.saw found")
        }
        let output_name = self.manifest.name()
        let output_path = self.layout.artifact(output_name)

        // Resolve dependencies + write the lock.
        let res = try self.resolve_deps()
        try self.check_module_paths(&res)

        // Build avoidance: skip the compile when nothing reachable changed AND
        // this target's artifact is actually there. Both halves are per-target,
        // so a build for one target never reports another's work as its own —
        // and an artifact left over from an older layout, sitting beside the
        // source where Blade used to put it, is simply not consulted.
        // The C sources compile first, and their keys (which cover the headers
        // the compiles read) are part of the hash.
        let plan = try self.link_plan(&res, self.requested_target, &self.layout)
        try self.compile_hosted(&plan, self.requested_target)
        let hash = self.build_hash(&res, &self.layout, "", "", &plan, "")
        if not force && is_up_to_date(&self.layout, &hash, output_path) {
            print("    Finished {output_path} (up to date)")
            return 0
        }

        if let triple = self.layout.triple() {
            print("   Compiling {output_name} v{self.manifest.version()} (target {triple})")
        } else {
            print("   Compiling {output_name} v{self.manifest.version()}")
        }

        // sawc does not create its own output directory, so this has to exist
        // before the compiler runs — otherwise the build fails deep inside the
        // compiler, naming a path the user never wrote.
        if not self.layout.ensure() {
            return BuildError(msg: "could not create {self.layout.dir()}")
        }

        var cmd = self.compiler_command()
        try! cmd.arg(source_file)
        try! cmd.arg("-o")
        try! cmd.arg(output_path)
        if let triple = self.layout.triple() {
            try! cmd.arg("--target")
            try! cmd.arg(triple)
        }
        // design 149: `[package] runtime = true` says this package implements
        // the `__saw_rt_*` seams. sawc then permits those exports, checks each
        // signature against runtime/ABI.md, and links no runtime of its own beside it.
        if self.manifest.is_runtime() {
            try! cmd.arg("--runtime")
        }
        if self.manifest.is_no_hidden_alloc() {
            try! cmd.arg("--no-hidden-alloc")
        }
        if not self.manifest.task_frame_flag().is_empty() {
            try! cmd.arg(self.manifest.task_frame_flag())
        }
        // The package's own name maps to its module root, so its sources may
        // import one another as `<name>.module`.
        try! cmd.arg("--module-path")
        try! cmd.arg(self.manifest.own_module_path())
        var i = 0
        while i < res.len() {
            let name = res.name(i)
            try! cmd.arg("--module-path")
            try! cmd.arg("{name}={self.dep_dir(&res, i)}/src")
            i = i + 1
        }
        self.add_module_paths(&var cmd)
        let linked = plan.sawc_arguments()
        var n = 0
        while n < linked.len() {
            try! cmd.arg(linked.get(n) ?? "")
            n = n + 1
        }

        let exit_code = match cmd.wait() {
            case Ok(code) -> code,
            case Err(e) -> {
                return BuildError(msg: "could not launch compiler: {e}")
            }
        }
        if exit_code == (0 as Int32) {
            record_build_stamp(&self.layout, &hash)
            print("    Finished {output_path}")
            0
        } else {
            BuildError(msg: "sawc failed", code: exit_code)
        }
    }

    // `blade clean`: remove build output (design 143). Without a target that is
    // the whole `.build/` tree — every target this package has ever built; with
    // one it is that target's directory alone, leaving the others intact.
    //
    // Only generated files live there, so this can never take a source file
    // with it. Dependency checkouts under `.blade/deps/` are SOURCE, not output,
    // and survive — cleaning a build should not cost a re-clone.
    public func clean(&self) -> Result<Int, BuildError> {
        if let triple = self.layout.triple() {
            if not self.layout.clean() {
                return BuildError(msg: "could not clean {self.layout.dir()}")
            }
            print("     Removed {self.layout.dir()} (target {triple})")
        } else {
            if not BuildLayout.clean_all() {
                return BuildError(msg: "could not clean the build directory")
            }
            print("     Removed the build directory")
        }
        0
    }

    // Print the resolved dependency graph (design 64 B7).
    // The package line prints before resolving, so a failed resolution still
    // shows which package it was; the error is the result.
    public func tree(&self) -> Result<Int, BuildError> {
        print("{self.manifest.name()} v{self.manifest.version()}")
        match resolve(self.manifest) {
            case Ok(res) -> {
                if res.len() == 0 {
                    print("  (no dependencies)")
                }
                var i = 0
                while i < res.len() {
                    print("  {res.name(i)} v{res.version(i)} ({res.kind(i)}: {res.loc(i)})")
                    i = i + 1
                }
                0
            },
            case Err(e) -> BuildError(msg: e.text())
        }
    }

    // Append a dependency to Saw.toml and re-resolve/lock (design 64 B7).
    public func add_dep(&self, name: String, kind: String, loc: String, version: String) -> Result<Int, BuildError> {
        let content = read_file("Saw.toml")
        if content.is_empty() {
            return BuildError(msg: "Saw.toml not found")
        }

        // The name and the values are written as TOML text, so one holding a
        // quote, a backslash or a space reads back exactly.
        let key = key_literal(name)
        let source = string_literal(loc)
        let entry = if kind.equals("git") {
            if version.is_empty() {
                "{key} = \{ git = {source} \}\n"
            } else {
                "{key} = \{ git = {source}, version = {string_literal(version)} \}\n"
            }
        } else {
            "{key} = \{ path = {source} \}\n"
        }

        let text = try with_dependency(content, name, entry)
        let f = match File.create(Path(s: "Saw.toml")) {
            case Ok(handle) -> move handle,
            case Err(e) -> { return BuildError(msg: "could not write Saw.toml: {e}") }
        }
        match f.write(try! text.to_data()) {
            case Ok(_) -> print("    Updated Saw.toml"),
            case Err(e) -> { return BuildError(msg: "could not write Saw.toml: {e}") }
        }

        // Re-resolve against the freshly-written manifest and rewrite the lock.
        match Manifest.load() {
            case Ok(fresh) -> {
                match resolve(fresh) {
                    case Ok(res) -> {
                        let mhash = manifest_deps_hash(fresh)
                        let _ = write_lock(&res, mhash, Path(s: "Saw.lock"))
                    },
                    case Err(e) -> { return BuildError(msg: "resolve after add failed: {e.text()}") }
                }
            },
            case Err(_) -> {}
        }

        print("      Added `{name}` to dependencies")
        0
    }

    // Build (never avoided) then run the resulting binary.
    public func run(&self, args: Vector<String>) -> Result<Int, BuildError> {
        match self.build(true) {
            case Ok(_) -> {},
            case Err(e) -> { return e }
        }

        let binary_name = "./{self.layout.artifact(self.manifest.name())}"
        print("     Running `{binary_name}`")

        var cmd = Command(program: binary_name)
        var i = 0
        while i < args.len() {
            if let arg = args.get(i) {
                try! cmd.arg(arg)
            }
            i = i + 1
        }
        match cmd.wait() {
            case Ok(code) -> code as Int,
            case Err(e) -> BuildError(msg: "could not launch `{binary_name}`: {e}")
        }
    }
}

// The values of `rows` that belong to `package`, in order.
func values_of(rows: &Vector<LinkEntry>, package: String) -> Vector<String> {
    var out = Vector<String>()
    var i = 0
    while i < rows.len() {
        if let row = rows.get(i) {
            if row.package.equals(package) {
                try! out.push(row.value)
            }
        }
        i = i + 1
    }
    move out
}
