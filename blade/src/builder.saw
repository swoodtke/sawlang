// Builder - Build orchestration for Blade (design 64 B6)
//
// `blade build` now runs the full dependency pipeline: resolve the graph (or
// honor an existing Saw.lock), write the lock, compile the root with one
// `--module-path <name>=<checkout>/src` per resolved dependency (B0), and skip
// the compile entirely when nothing reachable has changed (content-hash build
// avoidance; `--force` bypasses it).
//
// Design 143: every artifact lands in `.build/<target>/`, never beside the
// source, and the up-to-date stamp lives there too — so it answers for one
// target only.

import src.layout.*
import src.manifest.*
import src.resolver.*
import src.lock.*
import src.sosimg.*
import std.directory.{Directory}
import std.env.{Env}
import std.file.{File}
import std.path.{Path}
import std.process.{Command}

// =============================================================================
// Error Types
// =============================================================================

public struct BuildError {
    public message: String
    public exit_code: Int32
}

public extension BuildError {
    public init(msg: String) -> BuildError {
        BuildError(message: msg, exit_code: 1 as Int32)
    }

    public init(msg: String, code: Int32) -> BuildError {
        BuildError(message: msg, exit_code: code)
    }
}

// =============================================================================
// File helpers (content hashing)
// =============================================================================

func read_file(path_str: String) -> String {
    let p = Path(s: path_str)
    if not File.exists(p) {
        return ""
    }
    var f = match File.open(p) {
        case Ok(handle) -> move handle,
        case Err(_) -> { return "" }
    }
    let data = match f.read() {
        case Ok(bytes) -> move bytes,
        case Err(_) -> { return "" }
    }
    // Same contract as the branches above: an unusable file reads as empty.
    // Design 122 unit B made the UTF-8 decode fallible, so a binary file is now
    // "unusable" for the same reason an unopenable one is.
    match data.to_string() {
        case Ok(s) -> s,
        case Err(_) -> ""
    }
}

// Append the contents of every `*.saw` file directly in `dir` to `b`.
func append_dir_saw(b: &var StringBuilder, dir: String) {
    // A directory that cannot be listed contributes nothing to the hash, the
    // same as an empty one — this is a fingerprint, not a build step.
    let entries = match Directory.list(Path(s: dir)) {
        case Ok(v) -> move v,
        case Err(_) -> { return }
    }
    var i = 0
    while i < entries.len() {
        if let e = entries.get(i) {
            if let ext = e.ext() {
                if ext.equals("saw") {
                    b.append(e.as_str())
                    b.append("\n")
                    b.append(read_file(e.as_str()))
                }
            }
        }
        i = i + 1
    }
}

// =============================================================================
// Builder - Compiles Saw projects
// =============================================================================

public struct Builder {
    manifest: Manifest
    layout: BuildLayout
    // The triple `--target` asked for, kept as WRITTEN rather than only as the
    // layout's directory name: an SOS package may carry a `[sos.<triple>]`
    // section per machine, and selecting one needs the request itself.
    requested_target: String
}

public extension Builder {
    // A builder for the default hosted build.
    public init(m: Manifest) -> Builder {
        Builder(manifest: m, layout: BuildLayout(), requested_target: "")
    }

    // A builder for an explicit sawc target triple; an empty `target` is the
    // hosted default, which is how a command with no `--target` spells itself.
    public init(m: Manifest, target: String) -> Builder {
        Builder(manifest: m, layout: BuildLayout(triple: target),
                requested_target: target)
    }

    // The compiler command. Honours a `SAWC` override so an in-tree compiler can
    // drive the build (matches the tester).
    public func compiler(&self) -> String {
        if let c = Env.get("SAWC") {
            c
        } else {
            "sawc"
        }
    }

    // `SAWC` as a spawnable Command. The variable may hold a full command line
    // (`/path/to/python /path/to/sawc.py`, which is how the bootstrap drives the
    // in-tree compiler), so it is split on spaces here — the `CC="ccache gcc"`
    // convention, applied deliberately and locally to an environment variable.
    // `Command` itself never splits or interprets anything: one `arg` is one
    // argv element (design 122).
    public func compiler_command(&self) -> Command {
        let words = self.compiler().split(" ")
        var program = "sawc"
        if let first = words.get(0) {
            if not first.is_empty() {
                program = first
            }
        }
        var cmd = Command(program: program)
        var i = 1
        while i < words.len() {
            if let extra = words.get(i) {
                if not extra.is_empty() {
                    cmd.arg(extra)
                }
            }
            i = i + 1
        }
        move cmd
    }

    // Find the main source file
    public func find_source_file(&self) -> String? {
        let src_main = Path(s: "src/main.saw")
        if File.exists(src_main) {
            return "src/main.saw"
        }
        let root_main = Path(s: "main.saw")
        if File.exists(root_main) {
            return "main.saw"
        }
        let src_lib = Path(s: "src/lib.saw")
        if File.exists(src_lib) {
            return "src/lib.saw"
        }
        None
    }

    // True when this package builds a program rather than a library.
    //
    // There is no manifest field for the distinction — the source layout IS the
    // declaration: `src/main.saw` (or a root `main.saw`) is an application, a
    // package whose only entry is `src/lib.saw` is a library. Design 143 hangs
    // the lockfile policy on it: an application commits its `Saw.lock`, a
    // library does not.
    public func is_application(&self) -> Bool {
        File.exists(Path(s: "src/main.saw")) || File.exists(Path(s: "main.saw"))
    }

    // The local directory a resolved dependency lives in: the path dir itself,
    // or the git checkout under .blade/deps/.
    public func dep_dir(&self, res: &Resolution, i: Int) -> String {
        if res.kind(i).equals("git") {
            ".blade/deps/{res.name(i)}-{res.version(i)}"
        } else {
            res.loc(i)
        }
    }

    // Content hash of everything the build reads: Saw.toml, Saw.lock, and every
    // reachable `*.saw` source (root + each dependency checkout), plus a compiler
    // marker. Hashes CONTENT, not mtimes.
    public func build_hash(&self, res: &Resolution) -> String {
        var b = StringBuilder()
        b.append("sawc-1;")
        b.append(read_file("Saw.toml"))
        b.append(read_file("Saw.lock"))
        append_dir_saw(&var b, "src")
        var i = 0
        while i < res.len() {
            append_dir_saw(&var b, "{self.dep_dir(&res, i)}/src")
            i = i + 1
        }
        hash_string(b.build())
    }

    // Resolve dependencies for a BUILD, honoring Saw.lock (design 64 B4).
    //
    // - No lock (or an unparseable one): resolve fresh and WRITE the lock.
    // - Lock present + current (its manifest-deps hash still matches Saw.toml):
    //   HONOR it — resolve to reconstruct the on-disk paths but do NOT rewrite the
    //   committed lock.
    // - Lock present + DRIFTED (deps edited in Saw.toml): refuse to silently
    //   re-resolve; error toward `blade update`.
    //
    // The write happens for an APPLICATION only (design 143). An application's
    // lockfile pins its reproducible build and is committed; a library's
    // resolution belongs to whoever consumes it, so Blade does not leave one
    // behind in a library that the author would then have to know not to commit.
    // `blade update` still writes one either way — that is the explicit ask.
    //
    // (Path deps have exactly one candidate — the depended-on package's own
    // manifest version — so an honored re-resolve is deterministic and equals the
    // lock. Pinning a git dep to its locked rev without re-resolution is future
    // work: build-from-lock needs the resolver's path reconstruction.)
    public func resolve_deps(&self) -> Result<Resolution, BuildError> {
        let lock_content = read_file("Saw.lock")
        var honor = false
        if not lock_content.is_empty() {
            guard let lock = parse_lock(lock_content) else {
                return BuildError(msg: "Saw.lock is malformed; run `blade update` to regenerate it")
            }
            if not lock_is_current(&lock, self.manifest) {
                return BuildError(msg: "Saw.lock is out of date (Saw.toml dependencies changed); run `blade update` to re-resolve")
            }
            honor = true
        }
        match resolve(self.manifest) {
            case Ok(res) -> {
                if not honor {
                    if self.is_application() {
                        let mhash = manifest_deps_hash(self.manifest)
                        let _ = write_lock(&res, mhash, Path(s: "Saw.lock"))
                    }
                }
                move res
            },
            case Err(e) -> BuildError(msg: "dependency resolution failed: {e.text()}")
        }
    }

    // `blade update`: re-resolve fresh and rewrite Saw.lock, whatever its current
    // state (design 64 B4). This is the sanctioned way to change the lock after
    // editing Saw.toml's dependencies.
    public func update(&self) -> Result<Int, BuildError> {
        match resolve(self.manifest) {
            case Ok(res) -> {
                let mhash = manifest_deps_hash(self.manifest)
                if not write_lock(&res, mhash, Path(s: "Saw.lock")) {
                    return BuildError(msg: "could not write Saw.lock")
                }
                print("    Updated Saw.lock ({res.len()} dependency package(s))")
                0
            },
            case Err(e) -> BuildError(msg: "dependency resolution failed: {e.text()}")
        }
    }

    // Run one build tool, turning a non-zero exit or a failed launch into a
    // BuildError. Used by the sosimg pipeline, which drives three of them.
    func run_tool(&self, cmd: &Command, what: String) -> Result<Void, BuildError> {
        // Both arms are STATEMENTS and the Ok result is returned below. A tail
        // `match` with one diverging arm and one bare-error arm miscompiles
        // (DF-140e) — the arms unify to the error type and the auto-wrap into
        // `Err` is dropped, so the function returns a raw BuildError.
        match cmd.run() {
            case Ok(code) -> {
                if code != (0 as Int32) {
                    return BuildError(msg: "{what} failed", code: code)
                }
            },
            case Err(e) -> {
                return BuildError(msg: "could not launch {what}: {e.program_name()}")
            }
        }
        return
    }

    // Build an SOS process image (design 140 unit B; sos/spec.md §6).
    //
    // `sawc --freestanding` for the Saw half, the cross `clang` for the one
    // native translation unit a freestanding SOS process needs (its syscall
    // stub — no amount of Saw emits an `ecall`), `ld.lld` with the package's
    // linker script to place it at its fixed load address, then ELF -> sosimg.
    // The kernel gets a header it can walk with a handful of aligned loads and
    // never has to know what an ELF is.
    func build_sos_image(&self, cfg: &SosConfig, force: Bool) -> Result<Int, BuildError> {
        guard let source_file = self.find_source_file() else {
            return BuildError(msg: "No main.saw or lib.saw found")
        }
        let name = self.manifest.name()

        // Design 143: an SOS image is an artifact like any other, so it lands
        // in `.build/<target>/` rather than beside the source. The layout
        // accommodates this target by construction — a package cross-built for
        // two architectures gets two directories instead of two `.sosimg`
        // files fighting over one name.
        let layout = BuildLayout(triple: cfg.target)
        let image = layout.artifact("{name}.sosimg")

        let res = try self.resolve_deps()

        let hash = self.build_hash(&res)
        if not force {
            if read_file(layout.stamp()).equals(hash) {
                if File.exists(Path(s: image)) {
                    print("    Finished {image} (up to date)")
                    return 0
                }
            }
        }

        print("   Compiling {name} v{self.manifest.version()} (sosimg, {cfg.target})")
        if not layout.ensure() {
            return BuildError(msg: "could not create {layout.dir()}")
        }

        let obj = layout.artifact("{name}.o")
        let elf = layout.artifact("{name}.elf")

        var saw = self.compiler_command()
        saw.arg(source_file)
        saw.arg("-o")
        saw.arg(obj)
        saw.arg("--freestanding")
        saw.arg("--target")
        saw.arg(cfg.target)
        if not cfg.target_features.is_empty() {
            saw.arg("--target-features")
            saw.arg(cfg.target_features)
        }
        var i = 0
        while i < res.len() {
            saw.arg("--module-path")
            saw.arg("{res.name(i)}={self.dep_dir(&res, i)}/src")
            i = i + 1
        }
        try self.run_tool(&saw, "sawc")

        var objects = Vector<String>()
        objects.push(obj)

        // `[sos] native` is a space-separated list of translation units, each
        // compiled separately so a HAL file and a shared runtime file can be
        // named without either knowing about the other.
        let units = cfg.native.split(" ")
        var u = 0
        while u < units.len() {
            guard let unit = units.get(u) else {
                u = u + 1
                continue
            }
            if unit.is_empty() {
                u = u + 1
                continue
            }
            let native_obj = layout.artifact("{name}.native{u}.o")
            var cc = Command(program: sos_clang())
            cc.arg("--target={cfg.target}")
            // An empty flag is NOT passed. Profile B needs neither `-march` nor
            // `-mabi`, and `-march=` with nothing after it is a clang error
            // rather than a no-op.
            if not cfg.march.is_empty() {
                cc.arg("-march={cfg.march}")
            }
            if not cfg.mabi.is_empty() {
                cc.arg("-mabi={cfg.mabi}")
            }
            cc.arg("-ffreestanding")
            // -fno-builtin matters: sos/rt/common_c/support.c DEFINES memcpy,
            // and without it LLVM may rewrite its byte loop into a call to
            // itself. See that file's header.
            cc.arg("-fno-builtin")
            cc.arg("-ffunction-sections")
            cc.arg("-fdata-sections")
            cc.arg("-nostdlib")
            cc.arg("-O2")
            cc.arg("-c")
            cc.arg(unit)
            cc.arg("-o")
            cc.arg(native_obj)
            try self.run_tool(&cc, "clang")
            objects.push(native_obj)
            u = u + 1
        }

        var ld = Command(program: sos_ld())
        ld.arg("-T")
        ld.arg(cfg.linker_script)
        ld.arg("--gc-sections")
        ld.arg("-o")
        ld.arg(elf)
        var o = 0
        while o < objects.len() {
            if let object = objects.get(o) {
                ld.arg(object)
            }
            o = o + 1
        }
        try self.run_tool(&ld, "ld.lld")

        // The image is tagged for the profile it was linked for, from the one
        // place that knows which that is: the manifest's target triple. A
        // triple with no tag is a build error rather than an untagged image.
        let arch = match arch_for_target(cfg.target) {
            case Ok(found) -> found,
            case Err(e) -> { return BuildError(msg: "could not emit {image}: {e.text()}") }
        }

        match write_sosimg(Path(s: elf), Path(s: image), cfg.prio_map, arch) {
            case Ok(size) -> {
                // A stamp we cannot write only costs the next build its cache hit.
                match File.create(Path(s: layout.stamp())) {
                    case Ok(f) -> {
                        let _ = f.write(hash.to_data())
                    },
                    case Err(_) -> print("    (could not record the build hash)")
                }
                print("    Finished {image} ({size} bytes)")
                0
            },
            case Err(e) -> BuildError(msg: "could not emit {image}: {e.text()}")
        }
    }

    // Compile the project. `force` bypasses build avoidance.
    //
    // A package whose manifest carries `[sos]` builds to an SOS process image
    // rather than a host executable — a different linker, a different output,
    // and no host runtime at all.
    public func build(&self, force: Bool) -> Result<Int, BuildError> {
        var sos_cfg: SosConfig? = None
        match load_sos_config(self.manifest.root_dir, self.requested_target) {
            case Ok(found) -> { sos_cfg = found },
            case Err(e) -> { return BuildError(msg: "Saw.toml [sos]: {e}") }
        }
        if let cfg = sos_cfg {
            return self.build_sos_image(&cfg, force)
        }

        guard let source_file = self.find_source_file() else {
            return BuildError(msg: "No main.saw or lib.saw found")
        }
        let output_name = self.manifest.name()
        let output_path = self.layout.artifact(output_name)

        // Resolve dependencies + write the lock.
        let res = try self.resolve_deps()

        // Build avoidance: skip the compile when nothing reachable changed AND
        // this target's artifact is actually there. Both halves are per-target,
        // so a build for one target never reports another's work as its own —
        // and an artifact left over from an older layout, sitting beside the
        // source where Blade used to put it, is simply not consulted.
        let hash = self.build_hash(&res)
        if not force {
            if read_file(self.layout.stamp()).equals(hash) {
                if File.exists(Path(s: output_path)) {
                    print("    Finished {output_path} (up to date)")
                    return 0
                }
            }
        }

        if let triple = self.layout.triple() {
            print("   Compiling {output_name} v{self.manifest.version()} (target {triple})")
        } else {
            print("   Compiling {output_name} v{self.manifest.version()}")
        }

        // sawc does not create its own output directory, so this has to exist
        // before the compiler runs — otherwise the build fails deep inside the
        // compiler, naming a path the user never wrote.
        if not self.layout.ensure() {
            return BuildError(msg: "could not create {self.layout.dir()}")
        }

        var cmd = self.compiler_command()
        cmd.arg(source_file)
        cmd.arg("-o")
        cmd.arg(output_path)
        if let triple = self.layout.triple() {
            cmd.arg("--target")
            cmd.arg(triple)
        }
        // design 149: `[package] runtime = true` says this package implements
        // the `__saw_rt_*` seams. sawc then permits those exports, checks each
        // signature against rt/ABI.md, and links no runtime of its own beside it.
        if self.manifest.is_runtime() {
            cmd.arg("--runtime-provider")
        }
        var i = 0
        while i < res.len() {
            let name = res.name(i)
            cmd.arg("--module-path")
            cmd.arg("{name}={self.dep_dir(&res, i)}/src")
            i = i + 1
        }

        let exit_code = match cmd.run() {
            case Ok(code) -> code,
            case Err(e) -> {
                return BuildError(msg: "could not launch compiler: {e.program_name()}")
            }
        }
        if exit_code == (0 as Int32) {
            // Record this target's build hash beside its artifact. A stamp we
            // cannot write only costs the next build its cache hit.
            match File.create(Path(s: self.layout.stamp())) {
                case Ok(f) -> {
                    let _ = f.write(hash.to_data())
                },
                case Err(_) -> print("    (could not record the build hash)")
            }
            print("    Finished {output_path}")
            0
        } else {
            BuildError(msg: "sawc failed", code: exit_code)
        }
    }

    // `blade clean`: remove build output (design 143). Without a target that is
    // the whole `.build/` tree — every target this package has ever built; with
    // one it is that target's directory alone, leaving the others intact.
    //
    // Only generated files live there, so this can never take a source file
    // with it. Dependency checkouts under `.blade/deps/` are SOURCE, not output,
    // and survive — cleaning a build should not cost a re-clone.
    public func clean(&self) -> Result<Int, BuildError> {
        if let triple = self.layout.triple() {
            if not self.layout.clean() {
                return BuildError(msg: "could not clean {self.layout.dir()}")
            }
            print("     Removed {self.layout.dir()} (target {triple})")
        } else {
            if not self.layout.clean_all() {
                return BuildError(msg: "could not clean the build directory")
            }
            print("     Removed the build directory")
        }
        0
    }

    // Print the resolved dependency graph (design 64 B7).
    public func tree(&self) {
        print("{self.manifest.name()} v{self.manifest.version()}")
        match resolve(self.manifest) {
            case Ok(res) -> {
                if res.len() == 0 {
                    print("  (no dependencies)")
                }
                var i = 0
                while i < res.len() {
                    print("  {res.name(i)} v{res.version(i)} ({res.kind(i)}: {res.loc(i)})")
                    i = i + 1
                }
            },
            case Err(e) -> print("error: {e.text()}")
        }
    }

    // Append a dependency to Saw.toml and re-resolve/lock (design 64 B7).
    public func add_dep(&self, name: String, kind: String, loc: String, version: String) -> Result<Int, BuildError> {
        let content = read_file("Saw.toml")
        if content.is_empty() {
            return BuildError(msg: "Saw.toml not found")
        }

        var b = StringBuilder()
        b.append(content)
        if not content.contains("[dependencies]") {
            b.append("\n[dependencies]\n")
        }
        if kind.equals("git") {
            if version.is_empty() {
                b.append("{name} = \{ git = \"{loc}\" \}\n")
            } else {
                b.append("{name} = \{ git = \"{loc}\", version = \"{version}\" \}\n")
            }
        } else {
            b.append("{name} = \{ path = \"{loc}\" \}\n")
        }

        let text = b.build()
        let f = match File.create(Path(s: "Saw.toml")) {
            case Ok(handle) -> move handle,
            case Err(e) -> { return BuildError(msg: "could not write Saw.toml: {e}") }
        }
        match f.write(text.to_data()) {
            case Ok(_) -> print("    Updated Saw.toml"),
            case Err(e) -> { return BuildError(msg: "could not write Saw.toml: {e}") }
        }

        // Re-resolve against the freshly-written manifest and rewrite the lock.
        match Manifest.load() {
            case Ok(fresh) -> {
                match resolve(fresh) {
                    case Ok(res) -> {
                        let mhash = manifest_deps_hash(fresh)
                        let _ = write_lock(&res, mhash, Path(s: "Saw.lock"))
                    },
                    case Err(e) -> { return BuildError(msg: "resolve after add failed: {e.text()}") }
                }
            },
            case Err(_) -> {}
        }

        print("      Added `{name}` to dependencies")
        0
    }

    // Build (never avoided) then run the resulting binary.
    public func run(&self, args: Vector<String>) -> Result<Int, BuildError> {
        match self.build(true) {
            case Ok(_) -> {},
            case Err(e) -> { return e }
        }

        let binary_name = "./{self.layout.artifact(self.manifest.name())}"
        print("     Running `{binary_name}`")

        var cmd = Command(program: binary_name)
        var i = 0
        while i < args.len() {
            if let arg = args.get(i) {
                cmd.arg(arg)
            }
            i = i + 1
        }
        match cmd.run() {
            case Ok(code) -> code as Int,
            case Err(e) -> BuildError(msg: "could not launch `{binary_name}`: {e.program_name()}")
        }
    }
}
