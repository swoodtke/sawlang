// Resolver — build the dependency graph and pick one version per package
// (design 64 B3). Path dependencies only in this cut; git candidates are wired
// in by B5.
//
// Model (the design-64 ruling): max-satisfying, ONE version per package. A path
// dependency has exactly one candidate — its own manifest's version. The
// resolver reads the transitive graph in place, dedups by name, and rejects:
//   - a name reached via two different sources (two paths) — no source
//     unification;
//   - a dependency cycle (names the cycle) and a self-dependency;
//   - a resolved version that fails a requirer's version requirement (names
//     every requirer + its requirement).

import src.manifest.*
import src.git.*
import semver.{Version, VersionReq, parse_version, parse_req}
import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}

// Version parsing / requirement matching is delegated to the libs/semver
// package (design 64 B2), imported by path — the B8 "blade depends on semver"
// dogfood. This was blocked until design 68 root-caused the cross-module
// erased-box mangling divergence (DF9(c)): `import semver` + a
// `parse_version(...)` whose `Result<Version, SemverError>` flowed
// through blade's full type population mangle-missed its registered enum and
// mis-dispatched (a `Manifest.version()` read back as `Version`). With
// that fixed, the self-contained matcher is gone; `req_ok` below is a thin
// adapter over `parse_req`/`VersionReq.matches`.

// =============================================================================
// Errors
// =============================================================================

public struct ResolveError {
    message: String
}

public extension ResolveError {
    public init(msg: String) -> ResolveError {
        ResolveError(message: msg)
    }

    public func text(&self) -> String {
        self.message
    }
}

public extension ResolveError: Error {
    public func format(&self, into: &var StringBuilder) {
        into.append(self.message)
    }
}

// =============================================================================
// Resolution table (columnar — see the DepList note in manifest.saw)
// =============================================================================

public struct Resolution {
    names: Vector<String>
    versions: Vector<String>
    kinds: Vector<String>       // "path" / "git"
    locs: Vector<String>        // resolved directory (path) / url (git) — used
                                // internally and for the build module-path
    declareds: Vector<String>   // source AS DECLARED (relative path / url) — the
                                // portable value recorded in Saw.lock
    revs: Vector<String>        // "" for path
}

extension Resolution: NoCopy {}

public extension Resolution {
    public init() -> Resolution {
        let a = Vector<String>()
        let b = Vector<String>()
        let c = Vector<String>()
        let d = Vector<String>()
        let f = Vector<String>()
        let e = Vector<String>()
        Resolution(names: move a, versions: move b, kinds: move c, locs: move d, declareds: move f, revs: move e)
    }

    public func len(&self) -> Int {
        self.names.len()
    }

    // Index of `name` in the table, or -1 if absent.
    public func index_of(&self, name: String) -> Int {
        var i = 0
        while i < self.names.len() {
            if (self.names.get(i) ?? "").equals(name) {
                return i
            }
            i = i + 1
        }
        -1
    }

    public func name(&self, i: Int) -> String { self.names.get(i) ?? "" }
    public func version(&self, i: Int) -> String { self.versions.get(i) ?? "" }
    public func kind(&self, i: Int) -> String { self.kinds.get(i) ?? "" }
    public func loc(&self, i: Int) -> String { self.locs.get(i) ?? "" }
    public func declared(&self, i: Int) -> String { self.declareds.get(i) ?? "" }
    public func rev(&self, i: Int) -> String { self.revs.get(i) ?? "" }

    public func add(&var self, name: String, version: String, kind: String, loc: String, declared: String, rev: String) {
        self.names.push(name)
        self.versions.push(version)
        self.kinds.push(kind)
        self.locs.push(loc)
        self.declareds.push(declared)
        self.revs.push(rev)
    }
}

// =============================================================================
// Requirement ledger (name, constraint, requirer) for every dependency edge
// =============================================================================

struct ReqList {
    names: Vector<String>
    constraints: Vector<String>
    requirers: Vector<String>
}

extension ReqList: NoCopy {}

extension ReqList {
    public init() -> ReqList {
        let a = Vector<String>()
        let b = Vector<String>()
        let c = Vector<String>()
        ReqList(names: move a, constraints: move b, requirers: move c)
    }

    public func len(&self) -> Int { self.names.len() }
    public func name(&self, i: Int) -> String { self.names.get(i) ?? "" }
    public func constraint(&self, i: Int) -> String { self.constraints.get(i) ?? "" }
    public func requirer(&self, i: Int) -> String { self.requirers.get(i) ?? "" }

    public func add(&var self, name: String, constraint: String, requirer: String) {
        self.names.push(name)
        self.constraints.push(constraint)
        self.requirers.push(requirer)
    }
}

// =============================================================================
// Helpers
// =============================================================================

// The relative directory of a path source ("" for a git source). Split into two
// non-optional helpers rather than one `-> String?`: an optional value produced
// in a match arm that is also the function result is not wrapped correctly by
// codegen (dogfood DF10).
func path_dir(source: DepSource) -> String {
    match source {
        case PathDep(dir) -> dir,
        case GitDep(_) -> ""
    }
}

func is_git_source(source: DepSource) -> Bool {
    match source {
        case PathDep(_) -> false,
        case GitDep(_) -> true
    }
}

func git_url(source: DepSource) -> String {
    match source {
        case PathDep(_) -> "",
        case GitDep(url) -> url
    }
}

// Create `.blade/` (self-gitignoring) and `.blade/deps/` for git checkouts.
func ensure_deps_dir() {
    let _ = Directory.create(Path(s: ".blade"))
    let gi = Path(s: ".blade/.gitignore")
    if not File.exists(gi) {
        // Best-effort: without it the checkout dir shows up in `git status`,
        // which is untidy rather than broken.
        match File.create(gi) {
            case Ok(f) -> {
                let _ = f.write("*\n".to_data())
            },
            case Err(e) -> print("warning: could not write .blade/.gitignore: {e}")
        }
    }
    let _ = Directory.create(Path(s: ".blade/deps"))
}

func stack_contains(stack: &Vector<String>, name: String) -> Bool {
    var i = 0
    while i < stack.len() {
        if (stack.get(i) ?? "").equals(name) {
            return true
        }
        i = i + 1
    }
    false
}

func stack_to_string(stack: &Vector<String>) -> String {
    var b = StringBuilder()
    var i = 0
    while i < stack.len() {
        if i > 0 {
            b.append(" -> ")
        }
        b.append(stack.get(i) ?? "")
        i = i + 1
    }
    b.build()
}

// Resolve `.`/`..` segments in a slash path so the same package reached via
// different relative paths compares equal (source identity). A leading `/`
// (absolute path — e.g. a manifest root from Directory.current()) is preserved.
func normalize_path(s: String) -> String {
    let absolute = s.starts_with("/")
    let parts = s.split("/")
    var out = Vector<String>()
    for p in parts.iter() {
        if p.is_empty() || p.equals(".") {
            continue
        }
        if p.equals("..") {
            if out.len() > 0 {
                let _ = out.pop()
            }
        } else {
            out.push(p)
        }
    }
    var b = StringBuilder()
    if absolute {
        b.append("/")
    }
    var i = 0
    while i < out.len() {
        if i > 0 {
            b.append("/")
        }
        b.append(out.get(i) ?? "")
        i = i + 1
    }
    b.build()
}

// Does `v` satisfy `constraint`? None => the constraint string is malformed.
// Empty constraint => no constraint (matches). Thin adapter over libs/semver.
func req_ok(constraint: String, v: Version) -> Bool? {
    let t = constraint.trim()
    if t.is_empty() {
        return true
    }
    guard let req = try? parse_req(t) else {
        return None
    }
    req.matches(v)
}

// =============================================================================
// Resolution
// =============================================================================

// Visit one dependency edge: record the requirement, and (first time only) read
// the dependency's manifest, add it to the table, and descend into ITS deps.
func visit(
    dep_name: String,
    source: DepSource,
    constraint: String,
    requirer: String,
    base_dir: Path,
    resolution: &var Resolution,
    reqs: &var ReqList,
    stack: &var Vector<String>,
) -> Result<Bool, ResolveError> {

    // Every edge is a requirement to validate later (so conflicts name every
    // requirer, not just the first).
    reqs.add(dep_name, constraint, requirer)

    // Self-dependency.
    if dep_name.equals(requirer) {
        return ResolveError(msg: "package `{requirer}` depends on itself")
    }

    // Source identity (the dedup + two-sources key): a normalized directory for
    // a path dep, or the URL for a git dep.
    let is_git = is_git_source(source)
    var dep_loc = ""
    var declared = ""
    if is_git {
        dep_loc = git_url(source)
        declared = dep_loc
    } else {
        // Declared: the raw relative path from the manifest (portable, recorded
        // in the lock). Loc: the normalized directory (identity + module-path).
        declared = path_dir(source)
        dep_loc = normalize_path(base_dir.join(declared).as_str())
    }

    // Cycle FIRST: if the name is on the active resolution stack it is an
    // ancestor, which must be a cycle error rather than a silent dedup (a
    // resolved-but-not-ancestor node is caught by the dedup check below).
    if stack_contains(&stack, dep_name) {
        return ResolveError(msg: "dependency cycle: {stack_to_string(&stack)} -> {dep_name}")
    }

    // Already resolved (and not an ancestor): enforce single source, then stop.
    let existing = resolution.index_of(dep_name)
    if existing >= 0 {
        let prev = resolution.loc(existing)
        if not prev.equals(dep_loc) {
            return ResolveError(msg: "package `{dep_name}` is required from two different sources: `{prev}` and `{dep_loc}`")
        }
        return true
    }

    // Materialize the dependency's directory. A path dep is read in place; a git
    // dep is resolved by tag (highest satisfying the requirement) and cloned
    // into `.blade/deps/<name>-<version>/`.
    var dep_dir = Path(s: dep_loc)
    var resolved_kind = "path"
    var resolved_version = ""
    var resolved_rev = ""

    if is_git {
        resolved_kind = "git"
        guard let cands = ls_remote_tags(dep_loc) else {
            return ResolveError(msg: "git ls-remote failed for `{dep_loc}` (dependency `{dep_name}`)")
        }
        // Pick the highest tag version satisfying the requirement.
        var best = -1
        var best_ver: Version? = None
        var k = 0
        while k < cands.len() {
            guard let cv = try? parse_version(cands.version(k)) else {
                k = k + 1
                continue
            }
            let matched = req_ok(constraint, cv) ?? false
            if matched {
                let is_better = if let bv = best_ver { cv > bv } else { true }
                if is_better {
                    best = k
                    best_ver = cv
                }
            }
            k = k + 1
        }
        if best < 0 {
            return ResolveError(msg: "no tagged version of `{dep_name}` satisfies `{constraint}` (git {dep_loc})")
        }
        resolved_version = cands.version(best)
        resolved_rev = cands.rev(best)
        let checkout = ".blade/deps/{dep_name}-{resolved_version}"
        let checkout_path = Path(s: checkout)
        if not Directory.exists(checkout_path) {
            ensure_deps_dir()
            if not clone_tag(dep_loc, cands.tag(best), checkout) {
                return ResolveError(msg: "git clone of `{dep_name}` {cands.tag(best)} failed")
            }
        }
        dep_dir = checkout_path
    }

    // Read the dependency's own manifest for its deps (and, for a path dep, its
    // version). Manifest errors are wrapped into a ResolveError (concrete error
    // type — an erased-`try` re-box across a package boundary currently ICEs
    // codegen; dogfood DF9).
    let m = match Manifest.load_from(dep_dir) {
        case Ok(x) -> x,
        case Err(_) -> { return ResolveError(msg: "cannot read manifest for `{dep_name}` at {dep_dir.as_str()}") }
    }
    if not is_git {
        resolved_version = m.version()
    }
    resolution.add(dep_name, resolved_version, resolved_kind, dep_loc, declared, resolved_rev)

    stack.push(dep_name)
    let sub = match m.dependencies() {
        case Ok(x) -> move x,
        case Err(_) -> { return ResolveError(msg: "cannot read dependencies of `{dep_name}`") }
    }
    var j = 0
    while j < sub.len() {
        guard let sd = sub.get(j) else {
            break
        }
        let _ = try visit(
            sd.name, sd.source, sd.version, dep_name, dep_dir,
            &var resolution, &var reqs, &var stack,
        )
        j = j + 1
    }
    let _ = stack.pop()

    true
}

// After the graph is built, check every resolved version against all the
// requirements recorded for its name.
func validate(resolution: &Resolution, reqs: &ReqList) -> Result<Bool, ResolveError> {
    var i = 0
    while i < resolution.len() {
        let name = resolution.name(i)
        let ver_str = resolution.version(i)

        guard let ver = try? parse_version(ver_str) else {
            return ResolveError(msg: "package `{name}` has an unparseable version `{ver_str}`")
        }

        // Does the resolved version satisfy every non-empty requirement?
        var conflict = false
        var k = 0
        while k < reqs.len() {
            if reqs.name(k).equals(name) {
                let cons = reqs.constraint(k)
                if not cons.is_empty() {
                    guard let ok = req_ok(cons, ver) else {
                        return ResolveError(msg: "invalid version requirement `{cons}` on `{name}`")
                    }
                    if not ok {
                        conflict = true
                    }
                }
            }
            k = k + 1
        }

        if conflict {
            // Build a message naming every requirer + its requirement.
            var b = StringBuilder()
            b.append("cannot satisfy version requirements for `")
            b.append(name)
            b.append("` (resolved ")
            b.append(ver_str)
            b.append("):")
            var r = 0
            while r < reqs.len() {
                if reqs.name(r).equals(name) {
                    let cons = reqs.constraint(r)
                    if not cons.is_empty() {
                        b.append("\n  `")
                        b.append(reqs.requirer(r))
                        b.append("` requires ")
                        b.append(cons)
                    }
                }
                r = r + 1
            }
            return ResolveError(msg: b.build())
        }

        i = i + 1
    }
    true
}

// Resolve the full transitive path-dependency graph of `root`.
public func resolve(root: Manifest) -> Result<Resolution, ResolveError> {
    var resolution = Resolution()
    var reqs = ReqList()
    var stack = Vector<String>()

    let deps = match root.dependencies() {
        case Ok(x) -> move x,
        case Err(_) -> { return ResolveError(msg: "cannot read root dependencies") }
    }
    var i = 0
    while i < deps.len() {
        guard let d = deps.get(i) else {
            break
        }
        let _ = try visit(
            d.name, d.source, d.version, root.name(), root.root_dir,
            &var resolution, &var reqs, &var stack,
        )
        i = i + 1
    }

    let _ = try validate(&resolution, &reqs)

    move resolution
}
