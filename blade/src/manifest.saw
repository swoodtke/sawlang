// Manifest - Saw.toml package manifest handling
// Part of the Blade package manager

import toml.{TomlDoc, TomlError, TomlKind, TomlTable, string_literal}
import std.data.{Data}
import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}

// =============================================================================
// Error Types
// =============================================================================

public struct ManifestError {
    private message: String
}

extension ManifestError {
    public init(msg: String) -> ManifestError {
        ManifestError(message: msg)
    }
}

// A manifest error is a Printable error (design 56): manifest loading returns
// `Result<Manifest, Box<any Error>>`, so a ManifestError is auto-erased into the
// box at the return boundary and `try` boxes the one `in_manifest` makes.
extension ManifestError: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self.message)
    }
}

// =============================================================================
// Package Manifest Data Structures
// =============================================================================

// =============================================================================
// Dependency Data (design 64 B1)
// =============================================================================

// Where a dependency's source comes from. v1 supports path and git sources
// only; a bare version string (no source) is rejected — there is no registry.
public enum DepSource {
    case PathDep(dir: String),
    case GitDep(url: String)
}

// A single [dependencies] entry: its name, its source, and its raw version
// requirement string (e.g. "1.2.0", "^1.0.0", or "" when unspecified — a path
// dep takes its version from the depended-on package's own manifest).
public struct Dependency {
    name: String
    source: DepSource
    version: String
}

extension Dependency {
    public func is_path(&self) -> Bool {
        match self.source {
            case PathDep(_) -> true,
            case GitDep(_) -> false
        }
    }
}

// A parsed [dependencies] table — natural rows: a `Vector<Dependency>`.
//
// (This was columnar `Vector<String>` until design 68 root-caused DF6(b): an
// erased-box default-type-arg mangling divergence made `Result<DepList,
// Box<any Error>>` register under an arity-1 `Box<any Error>` name while a
// `match`/`try` looked it up at the typechecker's arity-2 `Box<any Error,
// GlobalAllocator>`, so the mangle-miss fell back to LLVM-type matching and silently
// selected a same-sized wrong monomorphization — `deps.get(i)` returned a
// `TomlValue`/`String`-shaped value. With the erased box normalized to one
// canonical arity across registration and lookup, natural rows work.)
public struct DepList {
    private deps: Vector<Dependency>
}

extension DepList: NoCopy {}

extension DepList {
    public init() -> DepList {
        let d = Vector<Dependency>()
        DepList(deps: move d)
    }

    public func add(&var self, name: String, kind: String, loc: String, version: String) {
        let src = if kind.equals("git") {
            DepSource.GitDep(url: loc)
        } else {
            DepSource.PathDep(dir: loc)
        }
        try! self.deps.push(Dependency(name: name, source: src, version: version))
    }

    public func len(&self) -> Int {
        self.deps.len()
    }

    public func get(&self, i: Int) -> Dependency? {
        self.deps.get(i)
    }
}

public struct Package {
    private name: String
    private version: String
    // design 149: `runtime = true` declares this package a RUNTIME PROVIDER —
    // it implements the `__saw_rt_*` seams itself. Blade passes
    // `--runtime`, which permits the exports, checks each seam's
    // signature against runtime/ABI.md, and links no runtime of ours beside it.
    // Absent or any other value means false; a package is not a runtime by
    // accident.
    private runtime: Bool
    // `no-hidden-alloc = true` makes every compile of a build this package is
    // the root of refuse the allocations the compiler inserts on its own, as
    // `sawc --no-hidden-alloc` does. A dependency's key is not read when it is
    // built as a dependency. Absent means false. (design 135)
    private no_hidden_alloc: Bool
    // `max-task-frame = "64KiB"` sets the most bytes a task's frame may take
    // in every compile of a build this package is the root of, as `sawc
    // --max-task-frame=` does, in the flag's own spelling. A dependency's key
    // is not read when it is built as a dependency. Absent, "", means the
    // profile's default. (SL-1166)
    private max_task_frame: String
}

public struct Manifest {
    private package: Package
    root_dir: Path
}

// A read of a manifest's tree, with its file named: the value, or the library's
// error behind `{path}: `, which is how a dependency's manifest is told from the
// root's. The one place that text is made; every `TomlError` that can reach the
// user passes through it.
//
// ENTRY POINTS: read_manifest (a parse error), read_package, read_dependencies,
// load_sos_config, sos_config_from, read_priorities, band_level,
// toolchain_fields_from, manifest_word, manifest_size
public func in_manifest<T>(path: String, read: Result<T, TomlError>) -> Result<T, ManifestError> {
    match move read {
        case Ok(value) -> move value,
        case Err(e) -> { return ManifestError(msg: "{path}: {e}") }
    }
}

// Reads and parses the manifest at `path`; a parse error names the file, then
// the line and column.
public func read_manifest(path: Path) -> Result<TomlDoc, Box<any Error>> {
    var file = try File.open(path)
    let data = try file.read()
    let content = try data.to_string()
    let doc = try in_manifest(path.as_string(), TomlDoc.parse(content))
    move doc
}

// The `[package]` table's fields. `name` and `version` are required, and a key
// of the wrong type is an error. `path` is the manifest's.
func read_package(doc: &TomlDoc, path: String) -> Result<Package, Box<any Error>> {
    let has = try in_manifest(path, doc.root().expect("package", TomlKind.Table))
    if not has {
        return ManifestError(msg: "Missing [package] section in Saw.toml")
    }
    let name = try in_manifest(path, doc.root().table("package")!.string("name"))
    let version = try in_manifest(path, doc.root().table("package")!.string("version"))
    let runtime = try in_manifest(path, doc.root().table("package")!.optional_boolean("runtime")) ?? false
    let no_hidden_alloc = try in_manifest(path, doc.root().table("package")!.optional_boolean("no-hidden-alloc")) ?? false
    var max_task_frame = ""
    if let given = try in_manifest(path, doc.root().table("package")!.optional_string("max-task-frame")) {
        if not task_frame_spelling_ok(given) {
            return ManifestError(msg: "{path}: `max-task-frame` in [package] is \"{given}\", which is not a size: write bytes, or a whole number then `KiB`, `MiB` or `GiB`, such as \"64KiB\"")
        }
        max_task_frame = given
    }
    Package(name: name, version: version, runtime: runtime, no_hidden_alloc: no_hidden_alloc,
            max_task_frame: max_task_frame)
}

// Whether `text` is the shape `sawc --max-task-frame=` reads: digits, then
// nothing or one of `KiB`, `MiB`, `GiB`. The flag reaches a shell command
// line in `blade test`, so only this shape is passed on; sawc judges the
// size itself (zero, overflow).
func task_frame_spelling_ok(text: String) -> Bool {
    var digits = 0
    while digits < text.len() {
        let b = text.byte_at(digits) as Int
        if b < 48 || b > 57 {
            break
        }
        digits = digits + 1
    }
    let suffix = text.substring(digits, text.len())
    digits > 0 && (suffix.len() == 0 || suffix.equals("KiB") || suffix.equals("MiB") || suffix.equals("GiB"))
}

// The `[dependencies]` entries, each a table with a `path` or a `git` source.
// `manifest` is the path of the manifest they are read from.
func read_dependencies(deps: &TomlTable, manifest: String) -> Result<DepList, Box<any Error>> {
    var list = DepList()
    let names = try deps.keys()
    for name in names.iter() {
        if let dep = deps.table(name) {
            // Empty-string sentinels: a present path/git is never empty, so
            // `is_empty()` cleanly distinguishes present vs absent without the
            // nested `if let ... { return }` shape that currently ICEs codegen.
            let path_s = try in_manifest(manifest, dep.optional_string("path")) ?? ""
            let git_s = try in_manifest(manifest, dep.optional_string("git")) ?? ""
            let version = try in_manifest(manifest, dep.optional_string("version")) ?? ""
            let has_path = not path_s.is_empty()
            let has_git = not git_s.is_empty()

            if has_path && has_git {
                return ManifestError(msg: "dependency `{name}` has both path and git sources; pick one")
            } else if has_path {
                list.add(name, "path", path_s, version)
            } else if has_git {
                list.add(name, "git", git_s, version)
            } else {
                return ManifestError(msg: "dependency `{name}` has no path or git source")
            }
        } else {
            // Bare version string, e.g. `tiny = "0.3.1"`: no source, and there
            // is no registry in v1.
            return ManifestError(msg: "dependency `{name}`: no registry yet; specify path or git")
        }
    }
    move list
}

// The Saw.toml `blade new` writes for a package called `name`. The name is
// written as TOML text, so one holding a quote or a backslash reads back exactly.
public func new_package_manifest(name: String) -> String {
    "[package]\nname = {string_literal(name)}\nversion = \"0.1.0\"\n"
}

// The `src/main.saw` `blade new` writes: the name sits in a Saw string literal,
// so a backslash, a quote and a brace are escaped and the program compiles.
public func new_package_main(name: String) -> String {
    let text = name.replace("\\", "\\\\").replace("\"", "\\\"").replace("\{", "\\\{").replace("\}", "\\\}")
    "func main() \{\n    print(\"Hello, {text}!\")\n\}\n"
}

extension Manifest {
    // Load manifest from current directory.
    //
    // design 56 dogfood: this returns an ERASED Result. A `ManifestError`
    // returned here is auto-erased into the `Box<any Error>` at the return
    // boundary; the `try` on a read re-boxes the `ManifestError` `in_manifest`
    // made from a `TomlError`. Two distinct error types flow through one
    // return type without a hand-written union, and callers render either with
    // `{error}` via the Printable vtable.
    public static func load() -> Result<Manifest, Box<any Error>> {
        let manifest_path = Path(s: "Saw.toml")

        if not File.exists(manifest_path) {
            return ManifestError(msg: "Saw.toml not found in current directory")
        }

        // An IoError, a Utf8Error and a parse error all box into the erased
        // Result at `try`, beside a ManifestError (design 132 unit G).
        let doc = try read_manifest(manifest_path)
        let package = try read_package(&doc, manifest_path.as_string())

        // Get current directory as root
        let root = match Directory.current() {
            case Ok(cwd) -> cwd,
            case Err(_) -> Path(s: ".")
        }

        return Manifest(package: package, root_dir: root)
    }

    // Load manifest from a specific directory (erased Result, as `load`).
    public static func load_from(dir: Path) -> Result<Manifest, Box<any Error>> {
        let manifest_path = dir.join("Saw.toml")

        if not File.exists(manifest_path) {
            return ManifestError(msg: "Saw.toml not found in {dir.as_string()}")
        }

        let doc = try read_manifest(manifest_path)
        let package = try read_package(&doc, manifest_path.as_string())

        return Manifest(package: package, root_dir: dir)
    }

    // Read and validate the [dependencies] table from this package's manifest
    // (design 64 B1). Re-reads Saw.toml from `root_dir` so `Manifest` stays a
    // cheap copyable value. Returns an empty list when there is no
    // [dependencies] section. Errors (erased): a bare version with no source
    // ("no registry yet"), a dep with both path and git, or a dep with neither.
    public func dependencies(&self) -> Result<DepList, Box<any Error>> {
        let manifest_path = self.root_dir.join("Saw.toml")

        let doc = try read_manifest(manifest_path)

        let named = manifest_path.as_string()
        let has = try in_manifest(named, doc.root().expect("dependencies", TomlKind.Table))
        if has {
            if let deps = doc.root().table("dependencies") {
                return read_dependencies(&deps, named)
            }
        }
        DepList()
    }

    // Get the package name
    public func name(&self) -> String {
        self.package.name
    }

    // Get the package version
    public func version(&self) -> String {
        self.package.version
    }

    // The package's own `--module-path` flag value, `NAME=<root>/src`. A
    // package's module root is its `src/`, so this is what lets its sources
    // and its tests write `import <name>.layout`.
    public func own_module_path(&self) -> String {
        let root = self.root_dir.join("src")
        "{self.package.name}={root.as_string()}"
    }

    // Whether this package provides the `__saw_rt_*` runtime seams (design 149).
    public func is_runtime(&self) -> Bool {
        self.package.runtime
    }

    // Whether every compile of this package's build passes `--no-hidden-alloc`.
    public func is_no_hidden_alloc(&self) -> Bool {
        self.package.no_hidden_alloc
    }

    // The `--max-task-frame=` flag every compile of this package's build
    // passes, or "" when the package states none.
    public func task_frame_flag(&self) -> String {
        if self.package.max_task_frame.is_empty() {
            return ""
        }
        "--max-task-frame={self.package.max_task_frame}"
    }
}
