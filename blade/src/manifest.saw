// Manifest - Saw.toml package manifest handling
// Part of the Blade package manager

import toml
import std.data.{Data}
import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}

// =============================================================================
// Error Types
// =============================================================================

public struct ManifestError {
    message: String
}

public extension ManifestError {
    public init(msg: String) -> ManifestError {
        ManifestError(message: msg)
    }
}

// A manifest error is a Printable error (design 56): manifest loading returns
// `Result<Manifest, Box<any Error>>`, so a ManifestError is auto-erased into the
// box at the return boundary and a TomlError is re-boxed by `try` (below).
public extension ManifestError: Error {
    public func format(&self, into: &var StringBuilder) {
        into.append(self.message)
    }
}

// =============================================================================
// Package Manifest Data Structures
// =============================================================================

// =============================================================================
// Dependency Data (design 64 B1)
// =============================================================================

// Where a dependency's source comes from. v1 supports path and git sources
// only; a bare version string (no source) is rejected — there is no registry.
public enum DepSource {
    case PathDep(dir: String),
    case GitDep(url: String)
}

// A single [dependencies] entry: its name, its source, and its raw version
// requirement string (e.g. "1.2.0", "^1.0.0", or "" when unspecified — a path
// dep takes its version from the depended-on package's own manifest).
public struct Dependency {
    public name: String
    public source: DepSource
    public version: String
}

public extension Dependency {
    public func is_path(&self) -> Bool {
        match self.source {
            case PathDep(_) -> true,
            case GitDep(_) -> false
        }
    }
}

// A parsed [dependencies] table — natural rows: a `Vector<Dependency>`.
//
// (This was columnar `Vector<String>` until design 68 root-caused DF6(b): an
// erased-box default-type-arg mangling divergence made `Result<DepList,
// Box<any Error>>` register under an arity-1 `Box<any Error>` name while a
// `match`/`try` looked it up at the typechecker's arity-2 `Box<any Error,
// GlobalAllocator>`, so the mangle-miss fell back to LLVM-type matching and silently
// selected a same-sized wrong monomorphization — `deps.get(i)` returned a
// `TomlValue`/`String`-shaped value. With the erased box normalized to one
// canonical arity across registration and lookup, natural rows work.)
public struct DepList {
    deps: Vector<Dependency>
}

extension DepList: NoCopy {}

public extension DepList {
    public init() -> DepList {
        let d = Vector<Dependency>()
        DepList(deps: move d)
    }

    public func add(&var self, name: String, kind: String, loc: String, version: String) {
        let src = if kind.equals("git") {
            DepSource.GitDep(url: loc)
        } else {
            DepSource.PathDep(dir: loc)
        }
        self.deps.push(Dependency(name: name, source: src, version: version))
    }

    public func len(&self) -> Int {
        self.deps.len()
    }

    public func get(&self, i: Int) -> Dependency? {
        self.deps.get(i)
    }
}

public struct Package {
    name: String
    version: String
    // design 149: `runtime = true` declares this package a RUNTIME PROVIDER —
    // it implements the `__saw_rt_*` seams itself. Blade passes
    // `--runtime-provider`, which permits the exports, checks each seam's
    // signature against sawc/rt/ABI.md, and links no runtime of ours beside it.
    // Absent or any other value means false; a package is not a runtime by
    // accident.
    runtime: Bool
}

public struct Manifest {
    package: Package
    public root_dir: Path
}

public extension Manifest {
    // Load manifest from current directory.
    //
    // design 56 dogfood: this returns an ERASED Result. A `ManifestError`
    // returned here is auto-erased into the `Box<any Error>` at the return
    // boundary; the `try` on the TOML parse re-boxes a `TomlError` into the same
    // box at the propagation edge. Two distinct error types flow through one
    // return type without a hand-written union, and callers render either with
    // `{error}` via the Printable vtable.
    public static func load() -> Result<Manifest, Box<any Error>> {
        let manifest_path = Path(s: "Saw.toml")

        if not File.exists(manifest_path) {
            return ManifestError(msg: "Saw.toml not found in current directory")
        }

        // An IoError boxes into the erased Result exactly as a ManifestError
        // does, so `try` carries the errno cause straight through (design 132
        // unit G gave these Results).
        var file = try File.open(manifest_path)

        let data = try file.read()

        // Decode as UTF-8 (a Utf8Error boxes into the erased Result).
        let content = try data.to_string()

        // `try` re-boxes a TomlError into Box<any Error> on failure.
        let doc = try toml.TomlDoc.parse(content)

        // A `TomlSection` is NoCopy and lives in the document, so it is reached
        // as a PLACE rather than bound: find the index once, then read through
        // it. `doc.section("package")!.get(...)` is the same borrow spelled
        // without the index.
        guard let pkg = doc.index_of("package") else {
            return ManifestError(msg: "Missing [package] section in Saw.toml")
        }

        let name = doc.section_at(pkg).get("name") ?? "unknown"
        let version = doc.section_at(pkg).get("version") ?? "0.0.0"
        let runtime = (doc.section_at(pkg).get("runtime") ?? "false") == "true"

        // Get current directory as root
        let root = if let cwd = Directory.current() {
            cwd
        } else {
            Path(s: ".")
        }

        return Manifest(
            package: Package(name: name, version: version, runtime: runtime),
            root_dir: root)
    }

    // Load manifest from a specific directory (erased Result, as `load`).
    public static func load_from(dir: Path) -> Result<Manifest, Box<any Error>> {
        let manifest_path = dir.join("Saw.toml")

        if not File.exists(manifest_path) {
            return ManifestError(msg: "Saw.toml not found in {dir.as_str()}")
        }

        var file = try File.open(manifest_path)

        let data = try file.read()

        let content = try data.to_string()

        let doc = try toml.TomlDoc.parse(content)

        guard let pkg = doc.index_of("package") else {
            return ManifestError(msg: "Missing [package] section in Saw.toml")
        }

        let name = doc.section_at(pkg).get("name") ?? "unknown"
        let version = doc.section_at(pkg).get("version") ?? "0.0.0"
        let runtime = (doc.section_at(pkg).get("runtime") ?? "false") == "true"

        return Manifest(
            package: Package(name: name, version: version, runtime: runtime),
            root_dir: dir)
    }

    // Read and validate the [dependencies] table from this package's manifest
    // (design 64 B1). Re-reads Saw.toml from `root_dir` so `Manifest` stays a
    // cheap copyable value. Returns an empty list when there is no
    // [dependencies] section. Errors (erased): a bare version with no source
    // ("no registry yet"), a dep with both path and git, or a dep with neither.
    public func dependencies(&self) -> Result<DepList, Box<any Error>> {
        let manifest_path = self.root_dir.join("Saw.toml")

        var file = try File.open(manifest_path)
        let data = try file.read()
        let content = try data.to_string()
        let doc = try toml.TomlDoc.parse(content)

        var list = DepList()

        guard let deps = doc.index_of("dependencies") else {
            return move list
        }

        let names = doc.section_at(deps).names()
        for name in names.iter() {
            if doc.section_at(deps).is_table(name) {
                // Empty-string sentinels: a present path/git is never empty, so
                // `is_empty()` cleanly distinguishes present vs absent without the
                // nested `if let ... { return }` shape that currently ICEs codegen.
                let path_s = doc.section_at(deps).table_value(name, "path") ?? ""
                let git_s = doc.section_at(deps).table_value(name, "git") ?? ""
                let version = doc.section_at(deps).table_value(name, "version") ?? ""
                let has_path = not path_s.is_empty()
                let has_git = not git_s.is_empty()

                if has_path && has_git {
                    return ManifestError(msg: "dependency `{name}` has both path and git sources; pick one")
                } else if has_path {
                    list.add(name, "path", path_s, version)
                } else if has_git {
                    list.add(name, "git", git_s, version)
                } else {
                    return ManifestError(msg: "dependency `{name}` has no path or git source")
                }
            } else {
                // Bare version string, e.g. `tiny = "0.3.1"`: no source, and there
                // is no registry in v1.
                return ManifestError(msg: "dependency `{name}`: no registry yet; specify path or git")
            }
        }

        move list
    }

    // Get the package name
    public func name(&self) -> String {
        self.package.name
    }

    // Get the package version
    public func version(&self) -> String {
        self.package.version
    }

    // Whether this package provides the `__saw_rt_*` runtime seams (design 149).
    public func is_runtime(&self) -> Bool {
        self.package.runtime
    }
}
