// Blade - The Saw Package Manager
// Entry point

import src.cli
import src.manifest
import src.builder
import src.tester
import std.directory.{Directory}
import std.file.{File}
import std.path.{Path}

// libc exit — lets a failing command set a nonzero process exit code, so a
// script or a CI job notices. exit() terminates the process immediately.
//
// EVERY failing path must go through here. Until design 140 only `blade test`
// did: `blade build` printed "error: ..." and exited 0, so a broken build
// looked exactly like a good one to anything reading the status. That is how a
// stale lockfile silently shipped a stale image.
extern "C" {
    func exit(code: Int32)
}

/// Report a failed command and exit non-zero. Never returns.
func fail(message: String, code: Int32) {
    print("error: {message}")
    let status = if code == (0 as Int32) {
        1 as Int32
    } else {
        code
    }
    exit(status)
}

static EXIT_FAILURE: Int32 = 1

// =============================================================================
// Help and Version
// =============================================================================

func print_help() {
    print("Blade - The Saw Package Manager")
    print("")
    print("Usage: blade <command> [options]")
    print("")
    print("Commands:")
    print("  build       Compile the current project (honors Saw.lock)")
    print("              --force rebuilds; --target <triple> cross-compiles")
    print("  update      Re-resolve dependencies and rewrite Saw.lock")
    print("  run         Build and run the project")
    print("  test        Compile and run the project's tests/")
    print("  clean       Remove build output (--target <triple> for just one)")
    print("  tree        Print the resolved dependency graph")
    print("  add <name>  Add a dependency (--path <dir> | --git <url> [--version <req>])")
    print("  new <name>  Create a new Saw project")
    print("  help        Show this help message")
    print("  version     Show version information")
}

func print_version() {
    print("blade 0.1.0")
}

// =============================================================================
// Project Creation
// =============================================================================

// Create `path` and write `content` to it. False (having reported why) if
// either step failed — design 132 unit G made both halves return the cause.
func write_new_file(path: Path, content: String) -> Bool {
    let f = match File.create(path) {
        case Ok(handle) -> move handle,
        case Err(e) -> {
            print("Error: Could not create {path.as_str()}: {e}")
            return false
        }
    }
    match f.write(try! content.to_data()) {
        case Ok(_) -> true,
        case Err(e) -> {
            print("Error: Could not write {path.as_str()}: {e}")
            false
        }
    }
}

func create_new_project(name: String) -> Int {
    // Create project directory
    let project_path = Path(s: name)

    if Directory.exists(project_path) {
        print("Error: Directory '{name}' already exists")
        return 1
    }

    match Directory.create(project_path) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("Error: Could not create directory '{name}': {e}")
            return 1
        }
    }

    // Create src directory
    let src_path = project_path.join("src")
    match Directory.create(src_path) {
        case Ok(_) -> {},
        case Err(e) -> {
            print("Error: Could not create src directory: {e}")
            return 1
        }
    }

    // Create Saw.toml
    let toml_content = "[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n"
    let toml_path = project_path.join("Saw.toml")
    if not write_new_file(toml_path, toml_content) {
        return 1
    }

    // Create src/main.saw - escape literal braces with \{ and \}
    let main_content = "func main() \{\n    print(\"Hello, {name}!\")\n\}\n"
    let main_path = src_path.join("main.saw")
    if not write_new_file(main_path, main_content) {
        return 1
    }

    // Create .gitignore. A package generates two directories and neither
    // belongs in version control: `.build/` holds every build's output
    // (design 143) and `.blade/` holds Blade's dependency checkouts. A new
    // package is an application, so its `Saw.lock` IS committed — that is what
    // pins the build for everyone who checks it out.
    let ignore_content = "# Build output — one directory per target\n.build/\n\n# Blade's dependency checkouts\n.blade/\n"
    let ignore_path = project_path.join(".gitignore")
    if not write_new_file(ignore_path, ignore_content) {
        return 1
    }

    print("     Created binary (application) `{name}` package")
    print("")
    print("To get started:")
    print("  cd {name}")
    print("  blade build")
    0
}

// =============================================================================
// Main Entry Point
// =============================================================================

func main() {
    match cli.Cli.parse() {
        case Ok(parsed_cli) -> {
            match parsed_cli.command {
                case Build(force, target) -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m, target: target)
                            match b.build(force) {
                                case Ok(_) -> {},
                                case Err(e) -> fail(e.message, e.exit_code)
                            }
                        },
                        case Err(e) -> fail("{e}", EXIT_FAILURE)
                    }
                },
                case Clean(target) -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m, target: target)
                            match b.clean() {
                                case Ok(_) -> {},
                                case Err(e) -> print("error: {e.message}")
                            }
                        },
                        case Err(e) -> print("error: {e}")
                    }
                },
                case Update -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m)
                            match b.update() {
                                case Ok(_) -> {},
                                case Err(e) -> fail(e.message, e.exit_code)
                            }
                        },
                        case Err(e) -> fail("{e}", EXIT_FAILURE)
                    }
                },
                case Run(args) -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m)
                            // `args` binds a payload inside `parsed_cli`, which
                            // this match only borrows, so `move args` handed
                            // `run` a vector `parsed_cli` still owned and both
                            // released it (DF-288a). The argv vector is a
                            // handful of retained strings; copy it.
                            match b.run(args.copy()) {
                                case Ok(_) -> {},
                                case Err(e) -> fail(e.message, e.exit_code)
                            }
                        },
                        case Err(e) -> fail("{e}", EXIT_FAILURE)
                    }
                },
                case Test -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let t = tester.Tester(m: m)
                            let code = t.run_all()
                            exit(code as Int32)
                        },
                        case Err(e) -> {
                            print("error: {e}")
                            exit(1 as Int32)
                        }
                    }
                },
                case Tree -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m)
                            b.tree()
                        },
                        case Err(e) -> fail("{e}", EXIT_FAILURE)
                    }
                },
                case Add(name, kind, loc, version) -> {
                    match manifest.Manifest.load() {
                        case Ok(m) -> {
                            let b = builder.Builder(m: m)
                            match b.add_dep(name, kind, loc, version) {
                                case Ok(_) -> {},
                                case Err(e) -> fail(e.message, e.exit_code)
                            }
                        },
                        case Err(e) -> fail("{e}", EXIT_FAILURE)
                    }
                },
                case New(name) -> {
                    if create_new_project(name) != 0 {
                        exit(EXIT_FAILURE)
                    }
                },
                case Help -> {
                    print_help()
                },
                case Version -> {
                    print_version()
                },
                case Unknown(cmd) -> {
                    print("error: unknown command `{cmd}`")
                    print("")
                    print_help()
                    exit(EXIT_FAILURE)
                }
            }
        },
        case Err(e) -> {
            print("error: {e.message}")
            print_help()
            exit(EXIT_FAILURE)
        }
    }
}
