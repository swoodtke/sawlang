// Tester - `blade test` implementation for Blade (design 49 item 3).
//
// Tests are ordinary Saw programs living in `tests/*.saw`. A test PASSES when it
// compiles and exits 0; any nonzero exit (a failed `assert`, a `panic`, a normal
// nonzero return) is a FAILURE. `blade test` discovers them, compiles each with
// the same compiler invocation `blade build` uses, runs it, and reports
// per-test ok/FAILED plus a summary. Execution is sequential (parallelism is a
// later refinement). No new language surface: the test harness is just Saw.

import blade.builder.{Builder, BuildError}
import blade.layout.*
import blade.manifest.*
import blade.resolver.*
import std.directory.{Directory}
import std.env.{Env}
import std.path.{Path}
import std.process.{Command}
import std.time.{Instant}

public struct Tester {
    private manifest: Manifest
    private layout: BuildLayout
}

extension Tester {
    // Tests are compiled and RUN, so they are built for the host — the one
    // target this machine can execute.
    public init(m: Manifest) -> Tester {
        Tester(manifest: m, layout: BuildLayout())
    }

    // The compiler command. `blade build` shells out to `sawc`; the tester does
    // the same, but honours a `SAWC` override so a not-yet-installed compiler
    // (e.g. the checkout's `bin/sawc`) can drive the loop.
    public func compiler(&self) -> String {
        if let c = (try! Env.get("SAWC")) {
            c
        } else {
            "sawc"
        }
    }

    // The arguments every test compile gets, after the source and `-o`: the
    // flags `blade build` uses. A package that declares `no-hidden-alloc` has
    // `--no-hidden-alloc` first, and a `max-task-frame` its `--max-task-frame=`;
    // the package's own `--module-path` follows, so a test imports it as
    // `<name>.module`, then one per dependency (design 64 B6). When resolution
    // fails only the package's own is passed, so a test that needs a missing
    // dependency fails to compile and says so. Every package's `[native]`
    // inputs follow as sawc's `--link-*` flags, one argument each, so a path
    // with a space or a quote reaches sawc whole. The error is a `[native]`
    // input that cannot be found.
    public func compile_arguments(&self) -> Result<Vector<String>, BuildError> {
        var args = Vector<String>()
        if self.manifest.is_no_hidden_alloc() {
            try! args.push("--no-hidden-alloc")
        }
        if not self.manifest.task_frame_flag().is_empty() {
            try! args.push(self.manifest.task_frame_flag())
        }
        try! args.push("--module-path")
        try! args.push(self.manifest.own_module_path())
        match resolve(self.manifest) {
            case Ok(res) -> {
                var i = 0
                while i < res.len() {
                    let name = res.name(i)
                    let dir = if res.kind(i).equals("git") {
                        ".blade/deps/{name}-{res.version(i)}"
                    } else {
                        res.loc(i)
                    }
                    try! args.push("--module-path")
                    try! args.push("{name}={dir}/src")
                    i = i + 1
                }
                let builder = Builder(m: self.manifest)
                let plan = try builder.link_plan(&res, "", &self.layout)
                try builder.compile_hosted(&plan, "")
                let linked = plan.sawc_arguments()
                var n = 0
                while n < linked.len() {
                    try! args.push(linked.get(n) ?? "")
                    n = n + 1
                }
            },
            case Err(_) -> {}
        }
        move args
    }

    // Run `cmd` with its stdout discarded and its stderr let THROUGH, and say
    // whether it exited 0. sawc writes its "Compiled ..." line to stdout and
    // every diagnostic to stderr, and a `panic`/failed `assert` aborts to
    // stderr, so on success the report stays clean while a compile error or a
    // test's failure reason is shown, never swallowed. A signal death is a
    // nonzero code, so a `panic`'s SIGABRT fails. A program that cannot launch
    // says so. (design 97)
    func passes(&self, cmd: &Command, what: String) -> Bool {
        match cmd.output() {
            case Ok(out) -> out.success(),
            case Err(e) -> {
                print("error: could not launch {what}: {e}")
                false
            }
        }
    }

    // Compile `source` to `bin` (with `flags`, one argument each), then run
    // it. Passes iff both succeed.
    public func run_one(&self, source: Path, bin: Path, flags: &Vector<String>) -> Bool {
        var compile = Builder(m: self.manifest).compiler_command()
        try! compile.arg(source.as_string())
        try! compile.arg("-o")
        try! compile.arg(bin.as_string())
        var i = 0
        while i < flags.len() {
            try! compile.arg(flags.get(i) ?? "")
            i = i + 1
        }
        // The compile inherits stdout and stderr, so every diagnostic and
        // warning of sawc reaches the terminal as it prints, once; a nonzero
        // exit makes the caller report this test FAILED.
        match compile.wait() {
            case Ok(code) -> {
                if code != (0 as Int32) {
                    return false
                }
            },
            case Err(e) -> {
                print("error: could not launch the compiler: {e}")
                return false
            }
        }
        let run = Command(program: bin.as_string())
        self.passes(&run, bin.as_string())
    }

    // Discover tests/*.saw, run each, report. Returns the process exit code:
    // 0 when every test passed, 1 when any failed (so CI fails the build).
    public func run_all(&self) -> Int {
        // Preflight (design 97): `blade test` compiles each test with `sawc`
        // unless SAWC overrides it. If neither is available, EVERY compile would
        // fail identically — don't bury that under N mysterious FAILEDs. Say so
        // once, with the fix, and stop. (A silent fallback to a missing compiler
        // that fails the whole suite is exactly the failure this design kills.)
        let has_sawc_env = if let _c = (try! Env.get("SAWC")) { true } else { false }
        if not has_sawc_env {
            var probe = Command(program: "sawc")
            try! probe.arg("--version")
            let found = match probe.output() {
                case Ok(_) -> true,
                case Err(_) -> false
            }
            if not found {
                print("error: no Saw compiler found — `blade test` needs `sawc`.")
                print("  No `sawc` is on PATH and SAWC is not set. Point SAWC at a")
                print("  compiler and retry, e.g. from an in-tree checkout:")
                print("    SAWC=/path/to/sawlang/bin/sawc blade test")
                return 1
            }
        }

        let tests_dir = Path(s: "tests")

        let entries = match Directory.list(tests_dir) {
            case Ok(v) -> move v,
            case Err(e) -> {
                print("error: could not read tests/: {e}")
                return 1
            }
        }

        // Where the compiled test binaries go (design 143): under the same
        // per-target build directory as everything else Blade produces. sawc
        // will not create it, so a failure here has to stop the run rather than
        // become N identical compile errors.
        let out_dir = Path(s: self.layout.tests_dir())
        if not self.layout.ensure_tests_dir() {
            print("error: could not create {self.layout.tests_dir()}")
            return 1
        }

        print("   Testing {self.manifest.name()} v{self.manifest.version()}")

        // design 57 dogfood: time the whole run with the monotonic clock, and
        // collect failed test names in a Map so they can be reported in a
        // deterministic (sorted) order at the end regardless of directory order.
        let started = Instant.now()
        var failed_tests = Map<String, Bool>()

        // Resolve the compile arguments once for the whole run.
        let flags = match self.compile_arguments() {
            case Ok(found) -> move found,
            case Err(e) -> {
                print("error: {e.message}")
                return 1
            }
        }

        var total = 0
        var passed = 0

        var i = 0
        while i < entries.len() {
            if let entry = entries.get(i) {
                if let ext_str = entry.file_extension() {
                    if ext_str.equals("saw") {
                        total = total + 1
                        let name = entry.stem() ?? entry.as_string()
                        let bin = out_dir.join(name)

                        // Per-test timing (design 64 B7, std.time Duration).
                        let t0 = Instant.now()
                        let ok = self.run_one(entry, bin, &flags)
                        let dur = t0.elapsed()
                        if ok {
                            passed = passed + 1
                            print("test {name} ... ok ({dur})")
                        } else {
                            try! failed_tests.insert(name, true)
                            print("test {name} ... FAILED ({dur})")
                        }
                    }
                }
            }
            i = i + 1
        }

        let failed = total - passed
        let elapsed = started.elapsed()
        print("")
        if failed == 0 {
            print("test result: ok. {passed} passed; 0 failed ({total} total) in {elapsed}")
            0
        } else {
            // Report the failed names in sorted order (a keys() snapshot sorted
            // for deterministic output — the map's own order is unspecified).
            var names = try! failed_tests.keys()
            names.sort()
            for n in names.iter() {
                print("    failed: {n}")
            }
            print("test result: FAILED. {passed} passed; {failed} failed ({total} total) in {elapsed}")
            1
        }
    }
}
