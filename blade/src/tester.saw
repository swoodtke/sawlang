// Tester - `blade test` implementation for Blade (design 49 item 3).
//
// Tests are ordinary Saw programs living in `tests/*.saw`. A test PASSES when it
// compiles and exits 0; any nonzero exit (a failed `assert`, a `panic`, a normal
// nonzero return) is a FAILURE. `blade test` discovers them, compiles each with
// the same compiler invocation `blade build` uses, runs it, and reports
// per-test ok/FAILED plus a summary. Execution is sequential (parallelism is a
// later refinement). No new language surface: the test harness is just Saw.

import src.layout.*
import src.manifest.*
import src.resolver.*
import std.directory.{Directory}
import std.env.{Env}
import std.path.{Path}
import std.time.{Instant}

extern "C" {
    // Run a command line through the shell and return its raw wait status. A
    // test PASSES iff this is exactly 0 — that rejects a nonzero exit AND a
    // signal death (a `panic`/failed `assert` aborts with SIGABRT, which a
    // naive `status / 256` exit-code extraction would misread as 0).
    func system(command: UnsafePointer<Int8>) -> Int32
}

public struct Tester {
    manifest: Manifest
    layout: BuildLayout
}

public extension Tester {
    // Tests are compiled and RUN, so they are built for the host — the one
    // target this machine can execute.
    public init(m: Manifest) -> Tester {
        Tester(manifest: m, layout: BuildLayout())
    }

    // The compiler command. `blade build` shells out to `sawc`; the tester does
    // the same, but honours a `SAWC` override so a not-yet-installed compiler
    // (e.g. the in-tree `./.venv/bin/python sawc/sawc.py`) can drive the loop.
    public func compiler(&self) -> String {
        if let c = Env.get("SAWC") {
            c
        } else {
            "sawc"
        }
    }

    // Run `cmd` through the shell with output suppressed (so the report stays
    // clean — a test's own stdout/stderr is not what we judge, only its status).
    // Passes iff the raw wait status is exactly 0.
    public func shell_ok(&self, cmd: String) unsafe -> Bool {
        let quiet = "{cmd} > /dev/null 2>&1"
        let ptr = quiet as UnsafePointer<Int8>
        system(ptr) == (0 as Int32)
    }

    // Like `shell_ok`, but suppresses only stdout and lets stderr THROUGH. sawc
    // writes its "Compiled ..." success line to stdout and every diagnostic to
    // stderr, and a `panic`/failed `assert` aborts to stderr — so on success the
    // report stays clean, while a compile error or a test's failure reason is
    // SURFACED, never swallowed (design 97: `blade test` must not hide why a
    // test could not compile or run). Passes iff the raw wait status is exactly 0.
    public func shell_ok_loud(&self, cmd: String) unsafe -> Bool {
        let quiet = "{cmd} > /dev/null"
        let ptr = quiet as UnsafePointer<Int8>
        system(ptr) == (0 as Int32)
    }

    // Dependency `--module-path` flags for compiling tests — the same flags
    // `blade build` uses, so a test sees the project's dependencies (design 64
    // B6). Empty string when there are no deps (or resolution fails; a test that
    // needs a missing dep then fails to compile, surfacing it).
    public func dep_flags(&self) -> String {
        match resolve(self.manifest) {
            case Ok(res) -> {
                var b = StringBuilder()
                var i = 0
                while i < res.len() {
                    let name = res.name(i)
                    let dir = if res.kind(i).equals("git") {
                        ".blade/deps/{name}-{res.version(i)}"
                    } else {
                        res.loc(i)
                    }
                    b.append(" --module-path ")
                    b.append("{name}={dir}/src")
                    i = i + 1
                }
                b.build()
            },
            case Err(_) -> ""
        }
    }

    // Compile `source` to `bin` (with dependency flags), then run it. Passes iff
    // both succeed.
    public func run_one(&self, source: Path, bin: Path, flags: String) -> Bool {
        let compile_cmd = "{self.compiler()} {source.as_str()} -o {bin.as_str()}{flags}"
        if not self.shell_ok_loud(compile_cmd) {
            // The compiler's error (stderr) has already been shown; the caller
            // reports this test as FAILED. Never swallow a compile failure.
            return false
        }
        // Judge by exit status, but let the test's stderr through so a panic or a
        // failed assert explains itself when the test FAILS.
        self.shell_ok_loud(bin.as_str())
    }

    // Discover tests/*.saw, run each, report. Returns the process exit code:
    // 0 when every test passed, 1 when any failed (so CI fails the build).
    public func run_all(&self) -> Int {
        // Preflight (design 97): `blade test` compiles each test with `sawc`
        // unless SAWC overrides it. If neither is available, EVERY compile would
        // fail identically — don't bury that under N mysterious FAILEDs. Say so
        // once, with the fix, and stop. (A silent fallback to a missing compiler
        // that fails the whole suite is exactly the failure this design kills.)
        let has_sawc_env = if let _c = Env.get("SAWC") { true } else { false }
        if not has_sawc_env {
            if not self.shell_ok("command -v sawc") {
                print("error: no Saw compiler found — `blade test` needs `sawc`.")
                print("  No `sawc` is on PATH and SAWC is not set. Point SAWC at a")
                print("  compiler and retry, e.g. from an in-tree checkout:")
                print("    SAWC=\"/path/to/python /path/to/sawc/sawc.py\" blade test")
                return 1
            }
        }

        let tests_dir = Path(s: "tests")

        let entries = match Directory.list(tests_dir) {
            case Ok(v) -> move v,
            case Err(e) -> {
                print("error: could not read tests/: {e}")
                return 1
            }
        }

        // Where the compiled test binaries go (design 143): under the same
        // per-target build directory as everything else Blade produces. sawc
        // will not create it, so a failure here has to stop the run rather than
        // become N identical compile errors.
        let out_dir = Path(s: self.layout.tests_dir())
        if not self.layout.ensure_tests_dir() {
            print("error: could not create {self.layout.tests_dir()}")
            return 1
        }

        print("   Testing {self.manifest.name()} v{self.manifest.version()}")

        // design 57 dogfood: time the whole run with the monotonic clock, and
        // collect failed test names in a Map so they can be reported in a
        // deterministic (sorted) order at the end regardless of directory order.
        let started = Instant.now()
        var failed_tests = Map<String, Bool>()

        // Resolve dependency flags once for the whole run.
        let flags = self.dep_flags()

        var total = 0
        var passed = 0

        var i = 0
        while i < entries.len() {
            if let entry = entries.get(i) {
                if let ext_str = entry.ext() {
                    if ext_str.equals("saw") {
                        total = total + 1
                        let name = entry.stem() ?? entry.as_str()
                        let bin = out_dir.join(name)

                        // Per-test timing (design 64 B7, std.time Duration).
                        let t0 = Instant.now()
                        let ok = self.run_one(entry, bin, flags)
                        let dur = t0.elapsed()
                        if ok {
                            passed = passed + 1
                            print("test {name} ... ok ({dur})")
                        } else {
                            failed_tests.insert(name, true)
                            print("test {name} ... FAILED ({dur})")
                        }
                    }
                }
            }
            i = i + 1
        }

        let failed = total - passed
        let elapsed = started.elapsed()
        print("")
        if failed == 0 {
            print("test result: ok. {passed} passed; 0 failed ({total} total) in {elapsed}")
            0
        } else {
            // Report the failed names in sorted order (a keys() snapshot sorted
            // for deterministic output — the map's own order is unspecified).
            var names = failed_tests.keys()
            names.sort()
            for n in names.iter() {
                print("    failed: {n}")
            }
            print("test result: FAILED. {passed} passed; {failed} failed ({total} total) in {elapsed}")
            1
        }
    }
}
