//! `sosrt` — the SOS runtime (designs 140, 172): arch-free, role-free Saw.
//!
//! Two halves, one module, and the same argument for both: the kernel and every
//! SOS process need exactly these, and differ only in where a byte ends up.
//!
//!   - THE DIAGNOSTIC HELPERS (the public surface, first below). Turning a
//!     machine word into hex, turning a Unicode scalar into a console byte, and
//!     — since the design 172 review round — the `ConsoleSink` trait with the
//!     ONE write loop over it, plus the abort-status promotion. What stays with
//!     the side that owns the device is now only the device: two register
//!     touches per HAL, and the mechanism that stops the machine.
//!   - THE RUNTIME PROPER (second below). The four frozen `__saw_rt_*` seams
//!     every compiled Saw program calls — write, panic, alloc, dealloc, spelled
//!     out in `sawc/rt/ABI.md` — plus the bump arena behind the last two. These
//!     have no Saw callers: the COMPILER emits the calls, and this module
//!     answers them.
//!
//! ALL OF IT RESTS ON TWO PER-SIDE HOOKS AND NOTHING ELSE — where a byte goes,
//! and how the machine stops:
//!
//!     sos_rt_write(ptr, len)      // supplied per side
//!     sos_rt_abort(code)          // supplied per side, does not return
//!
//! The kernel HAL answers "the UART" and "the board's stop"
//! (`sos/hal/<arch>/kernel/lib.saw`); a process answers "a System op" to both
//! (`sos/kernel/sysapi/`). That second answer is the M/U split being real
//! rather than claimed: if `panic()` could reach a UART from userspace, it
//! would not be.
//!
//! Nothing here suspends and nothing names a target. No code here CALLS an
//! allocator either — the arena below IS the one, and it hands out a fixed
//! region it was given at link time. That is what lets one module serve an
//! M-mode kernel and a U-mode process on two architectures.

/// Hex digits in a MACHINE word on this target — eight on a 32-bit profile,
/// sixteen on a 64-bit one (spec §5b).
///
/// A function rather than a `static` because a static initializer takes plain
/// literals only, and the literal is the bug: `8` was written here when riscv32
/// was the only profile, and on arm64 it made every `write_hex` print the low
/// half of the word with no sign that the top half existed — an address
/// diagnostic that quietly lies. `sizeof<UInt>()` is the fact being asked for,
/// so it is what the code asks.
public func hex_digits_per_word() -> Int {
    sizeof<UInt>() * HEX_DIGITS_PER_BYTE
}

static HEX_DIGITS_PER_BYTE: Int = 2
static BITS_PER_HEX_DIGIT: Int = 4
static HEX_NIBBLE_MASK: UInt = 0xF
static HEX_DECIMAL_LIMIT: UInt = 10
// Plainly named again. These were `HEX_`-prefixed to dodge DF-140h, where a
// module-PRIVATE `static` inside a std file reserved its simple name for every
// program — `sawc/std/stringbuilder.saw` has its own private `ASCII_ZERO`.
// Design 145 unit A fixed it (the namespace now keys std statics by their
// design-82 module identity), so the workaround is gone.
static ASCII_ZERO: UInt = 48
static ASCII_LOWER_A_MINUS_TEN: UInt = 87
static ASCII_MAX: Int = 0x7F
static ASCII_SUBSTITUTE: UInt8 = 0x3Fu8      // '?'

/// One hex digit, lowercase.
public func hex_digit(nibble: UInt) -> UInt8 {
    let nib = nibble & HEX_NIBBLE_MASK
    if nib < HEX_DECIMAL_LIMIT {
        (ASCII_ZERO + nib) as UInt8
    } else {
        (ASCII_LOWER_A_MINUS_TEN + nib) as UInt8
    }
}

/// The `index`-th hex digit of `value`, MOST SIGNIFICANT FIRST — so a caller
/// prints `0..hex_digits_per_word()` in order and gets a full-width word with
/// no reversal buffer and no allocation.
public func hex_digit_of(value: UInt, index: Int) -> UInt8 {
    let shift = (hex_digits_per_word() - 1 - index) * BITS_PER_HEX_DIGIT
    hex_digit(value >> shift)
}

/// A Unicode scalar as a console byte.
///
/// `String.chars()` yields scalars and the console surfaces on both sides are
/// byte-oriented, so a non-ASCII scalar has to become SOMETHING. It becomes
/// `'?'` rather than a silent truncation to a plausible-looking wrong
/// character — the rule is stated once, here, instead of being re-decided by
/// each caller. A byte-oriented console service is userspace work for a later
/// milestone.
public func ascii_byte(scalar: Int) -> UInt8 {
    if scalar < 0 || scalar > ASCII_MAX {
        ASCII_SUBSTITUTE
    } else {
        scalar as UInt8
    }
}

// =============================================================================
// The console sink, and the ONE write loop over it (design 172 review round)
// =============================================================================
//
// Both kernel HALs had the same twelve lines: poll a status register, place a
// byte, advance a cursor with wrapping arithmetic, count down. Only the two
// register touches differed — a 16550 polls LSR bit 5 for "TX holding register
// empty", a PL011 polls FR bit 5 for "transmit FIFO full", opposite senses of
// opposite bits on differently-shaped blocks. That is a DEVICE difference, and
// it is the only thing that belongs in a HAL.
//
// So the device is a trait and the loop is written once, generic over it. The
// bound is static: `console_write<S: ConsoleSink>` MONOMORPHIZES per sink, one
// instantiation per architecture, and there is no vtable, no existential and no
// indirect call anywhere on the panic path.
//
// THE CHECK-FREEDOM CONTRACT COMES WITH IT, and it is the reason this is worth
// stating rather than assuming. The panic reporter runs while a panic is being
// reported, so a bounds check or an overflow check that tripped here would
// re-enter `__saw_rt_panic` and either hang or garble the one diagnostic that
// matters. The loop below earns that the same way the per-HAL copies did (see
// DF-172b): raw `UnsafeMemory` reads rather than indexing, no allocation, no
// `String`, and a cursor that advances with `&+` / `&-` so even a nonsensical
// length cannot raise an overflow trap.
//
// Generic-ness does not weaken it, and that was checked rather than hoped:
// `--emit-ir` on BOTH monomorphizations shows the trait default body and both
// accessor bodies fully inlined, leaving `ptrtoint`, a plain `load i8`, the
// device's volatile load, an `and`, an `icmp`, the volatile store, and
// `add`/`add -1` — no `llvm.uadd.with.overflow`, no bounds check, no trap block
// and no call to `__saw_rt_panic` in either. Re-read the IR of both if you
// touch this loop or either sink.

/// A byte-oriented console the kernel can reach with no allocator, no
/// interrupts and no driver state beyond the register block itself.
///
/// Two requirements, because two is what a polled transmitter is: ask whether
/// the device will take a byte, and give it one. Splitting them is what lets
/// the WAITING live here, once, instead of in each HAL.
public trait ConsoleSink {
    /// Can the device accept a byte right now?
    func can_write(&self) -> Bool

    /// Place one byte. Called only when `can_write()` has answered true.
    func put(&self, b: UInt8)

    /// Spin until the device is ready, then place one byte.
    ///
    /// A default body rather than a requirement: every polled transmitter waits
    /// the same way, and a HAL that overrode this would be saying something
    /// about its device that `can_write` should have said instead.
    func write_byte(&self, b: UInt8) {
        while not self.can_write() {
        }
        self.put(b)
    }
}

/// Write `len` bytes at `ptr` to `sink`. THE PANIC PATH'S WRITE LOOP, once.
///
/// Check-free by construction — see the section header for what that means and
/// how it is verified.
public func console_write<S: ConsoleSink>(sink: &S, ptr: UnsafePointer<Int8>,
                                          len: UInt) unsafe {
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        sink.write_byte(UnsafeMemory<UInt8, Normal>(addr).read())
        addr = addr &+ 1
        left = left &- 1
    }
}

// A failing exit must never read as a passing one, and both HALs said so in
// their own copy of these three lines.
static ABORT_CODE_MASK: UInt = 0xFF
static ABORT_CODE_MIN: UInt = 1

/// The exit status a failing abort actually carries: `code` narrowed to the
/// byte an exit status is, with zero promoted.
///
/// The promotion is the whole point. A machine-stop mechanism reports one byte,
/// and `0` is what "the run passed" looks like — so an abort raised with a code
/// that happens to be zero, or whose low byte is, would exit clean and turn a
/// failure into a green run. Deciding that ONCE is what keeps the two HALs from
/// drifting on it.
///
/// The mechanism stays per-arch: this says WHAT status, not how to stop.
public func abort_status(code: UInt) -> UInt {
    let masked = code & ABORT_CODE_MASK
    if masked == 0 {
        return ABORT_CODE_MIN
    }
    masked
}

// =============================================================================
// The runtime seams (design 172 part 2)
// =============================================================================
//
// These four `@export`s ARE the SOS runtime. `sawc/rt/ABI.md` freezes what a
// compiled Saw program calls; the compiler emits the calls under every profile
// and the environment supplies the bodies. Here is that environment.
//
// THE ONE THING THAT KEPT THEM IN C UNTIL NOW, since the file that held them
// says the move should be taken deliberately: the ABI freezes `__saw_rt_panic`
// as `noreturn`, and a Saw function could not be typed `Never` without CALLING
// something that already was — which for the panic sink is circular, since this
// IS what `panic()` reaches. Design 177 supplied the missing producer: a
// conditionless `while { }` with no `break` types `Never`, so a Saw body can
// satisfy the signature on its own. `sos_rt_abort` below is declared
// `-> Never` for the same reason it was `__attribute__((noreturn))` in C, and
// that is now a promise the type system carries rather than a comment.
//
// WHO TURNS THESE ON. `@export`ing a `__saw_rt_*` name is refused unless the
// compile declares itself a runtime provider (design 149): the kernel builds
// pass `--runtime-provider` from `tools/sos_runner.py`, and a process image
// gets it from `[package] runtime = true` in its own manifest, because the
// image's compile is where these definitions land. A compile that forgets it
// gets a clean error naming the frozen set; a LINK that never compiled this
// module gets an undefined `__saw_rt_write`. Neither failure is quiet.
//
// The signatures are machine-checked against `sawc/rt/ABI.md` (arity + machine
// width), so editing one here without editing that document is a compile error.
// Sizes and lengths are `UInt` rather than `Int` — same machine word, and the
// unsigned reading is the one the bounds arithmetic below wants.
//
// WHAT IS NOT HERE, and the answer for when it is (design 234 §2, user ruling
// Aug 22). The hosted runtime grew `__saw_rt_last_raw_code()` — the raw platform
// number behind a classification, carried beside the portable tag so std's
// `IoError` can log the errno its `kind` folded away. There is nothing here to
// stamp: this runtime has no OS-op family and does not implement
// `__saw_rt_last_syserror` either, and a seam nobody calls needs no body. When
// SOS does grow one, its answer is its NATIVE STATUS WORD — which on SOS
// numerically coincides with the SysError tag, because the status half of the
// ratified `(status, value)` syscall ABI IS that tag space (sos/spec.md §5.7).
// That coincidence is recorded rather than engineered around: SOS stores no
// second copy of the number, and `code` reads back as the same value `kind` was
// built from.

// Where a byte goes, and how the machine stops. Everything below is written
// against these two and nothing else. See the module header for who answers.
// (A plain comment, not `///`: an `extern` block is a container, and design 121
// attaches a doc block to a DECLARATION.)
extern "C" {
    func sos_rt_write(ptr: UnsafePointer<Int8>, len: UInt)
    func sos_rt_abort(code: UInt32) -> Never
}

// Abort codes the RUNTIME raises on its own behalf. A side's own exit codes
// live with that side; these two are ours, and they stay distinct so a
// transcript can tell "the program panicked" from "the arena ran dry".
//
// A closed named set is a backed enum rather than a family of statics (design
// 153), on the same terms as the kernel's `ExitCode`; the backing is the width
// `sos_rt_abort` takes, so the projection at the call is one `as`.
enum AbortCode: UInt32 {
    case Panic = 64,
    case NoMemory = 65
}

/// `print`'s output primitive: `len` bytes at `ptr`, to whatever this side
/// calls a console.
@export("__saw_rt_write")
func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    sos_rt_write(ptr, len)
}

/// The infallible-tier panic sink (design 19): report, then stop.
///
/// CHECK-FREE BY CONSTRUCTION, like the writers under it (DF-172b) — it does no
/// arithmetic at all, so there is nothing here that could raise the panic it is
/// in the middle of reporting.
@export("__saw_rt_panic")
func rt_panic(ptr: UnsafePointer<Int8>, len: UInt) unsafe -> Never {
    sos_rt_write(ptr, len)
    sos_rt_abort(AbortCode.Panic as UInt32)
}

// -----------------------------------------------------------------------------
// The bump arena
// -----------------------------------------------------------------------------
//
// SOS allocates nothing on the steady path — the kernel's diagnostics and
// root's banner are string literals walked byte by byte, and every kernel
// source builds under `--no-hidden-alloc`. The arena exists because the
// COMPILER's panic path can allocate, and an unbacked seam would turn a
// diagnosable panic into a wild jump.
//
// No reclamation: `dealloc` is a no-op and the real slab allocator arrives with
// the kernel object model (spec §4).

/// The arena's region, sized ONCE. The length lives in this type and nowhere
/// else: `arena_bytes()` reads it back with `sizeof`, and the initializer's own
/// length is checked against it, so the size cannot be edited in one place and
/// left stale in another.
type ArenaRegion = [UInt8; 65_536]

/// The region and the cursor over it — compound global state whose consistency
/// spans two words, which is what design 149's `unsafe static var` is for. The
/// serialization argument is spec §7's: SOS v1 is a uniprocessor kernel and M1
/// enables no interrupt sources, so no other agent can observe the window
/// between the bound check and the cursor store. Enabling interrupts, SMP or
/// preemption each invalidate that and take a `SpinLock` here.
///
/// An all-zero static costs no image bytes (design 149) — this is 64 KiB of
/// `.bss`, not 64 KiB of ELF.
unsafe static var ARENA: ArenaRegion = [0; 65_536]
unsafe static var ARENA_NEXT: UInt = 0

/// The arena's capacity, read off the region's own type.
func arena_bytes() -> UInt {
    sizeof<ArenaRegion>() as UInt
}

/// The region's base address.
func arena_base() unsafe -> UInt {
    ((&var ARENA) as UnsafePointer<UInt8>) as UInt
}

/// Hand out `size` bytes aligned to `align`, or stop the machine.
///
/// ALIGNMENT IS APPLIED TO THE ABSOLUTE ADDRESS, not to the offset — which is
/// where this differs from the C it replaces, and it is a fix rather than a
/// translation. The C rounded `arena_next` up and returned `&arena[p]`, which
/// only satisfies the caller if the REGION itself is at least as aligned as
/// anything asked of it; a `[UInt8; N]` has an alignment of one, and so did the
/// C array in principle. Rounding the address the caller actually receives is
/// correct whatever the region landed on.
///
/// The bound is checked as a SUBTRACTION so a hostile `size` cannot wrap past
/// it, exactly as the C did. The padding step uses `&-` because a checked one
/// would put a panic branch inside the allocator for a subtraction that cannot
/// go negative (`rem` is a remainder of `step`, so `rem < step` always) — the
/// compiler cannot see that, and the allocator is not a place to spend a trap.
@export("__saw_rt_alloc")
func rt_alloc(size: UInt, align: UInt) unsafe -> UnsafePointer<Int8> {
    var step = align
    if step < 1 {
        step = 1
    }
    let base = arena_base()
    let capacity = arena_bytes()
    var offset = ARENA_NEXT
    let rem = (base &+ offset) % step
    if rem != 0 {
        offset = offset &+ (step &- rem)
    }
    if size > capacity || offset > capacity - size {
        let msg = "sos: out of arena memory\n"
        sos_rt_write(msg, UInt.from(truncating: msg.len()))
        sos_rt_abort(AbortCode.NoMemory as UInt32)
    }
    ARENA_NEXT = offset &+ size
    (base &+ offset) as UnsafePointer<Int8>
}

/// Free a block. A bump arena reclaims nothing, so this is deliberately empty —
/// see the section header for when that changes.
@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: UInt, align: UInt) unsafe {
}
