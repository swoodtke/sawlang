//! The riscv32 kernel HAL, Saw half (designs 112, 140, 162) — QEMU `virt`, M-mode.
//!
//! Everything the SOS kernel needs from THIS machine, and nothing more. The
//! kernel core above it (`sos/kernel/core/`) names no architecture at all: it
//! reaches the board, the privilege transition and the memory-protection
//! hardware only through the surface below, which `sos/hal/arm64/kernel/`
//! implements the same way for Profile B. `ABI.md` beside this file is the
//! contract; `boot.S` and `sink.c` are the parts of it that cannot be Saw.
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 32-bit SIGNED, so a RAM address like 0x8020_0000 lands in
//! its negative half — and would mean a different number again on the 64-bit
//! profile. See DF-140a in designs/todo.md.

// The image-format registry, for this profile's arch tag. The format is shared
// with everyone who touches an image; the tag a HAL claims comes out of it
// rather than being spelled again here.
// Only the arch tag: this profile installs a segment's permission mask
// UNTRANSLATED (the format numbers its bits to match a PMP config, which is
// the whole reason it numbers them that way), so unlike the arm64 HAL there is
// no `SegFlag` case to name in code.
import imgformat.{SosimgArch}

// The arch-free half of the console and the stop: the sink trait this file's
// UART conforms to, the one write loop over it, and the exit-status promotion
// both HALs used to spell out for themselves (design 172 review round).
import sosrt.{ConsoleSink, console_write, abort_status}

// =============================================================================
// NS16550A UART (design 112's blessed MMIO idiom: register block + driver)
// =============================================================================

/// The NS16550A register block. Registers are byte-spaced; the struct's natural
/// declaration-order layout places each at its hardware offset. A `ReadOnly<T>`
/// field exposes only `.read()`; a plain field is read-write.
struct UartRegs {
    thr: UInt8,             // +0  transmit holding / receive buffer
    ier: UInt8,             // +1  interrupt enable
    iir: UInt8,             // +2  interrupt id / FIFO control
    lcr: UInt8,             // +3  line control
    mcr: UInt8,             // +4  modem control
    lsr: ReadOnly<UInt8>,   // +5  line status
    msr: ReadOnly<UInt8>,   // +6  modem status
    scr: UInt8,             // +7  scratch
}

/// The console driver. A SAFE type (unsafety is not transitive — design 130):
/// only the methods reaching through `regs` carry the `unsafe` effect.
struct Uart16550 {
    regs: UnsafeMemory<UartRegs, Device>,
}

extension Uart16550 {
    init(at: UInt) unsafe -> Uart16550 {
        Uart16550(regs: UnsafeMemory<UartRegs, Device>(at))
    }
}

/// The two register touches, and nothing else — no interrupts in M1, so the
/// transmitter is polled. Every access is a volatile Device load/store.
///
/// `write_byte` and the panic path's write LOOP are `sosrt`'s, once, generic
/// over this conformance and monomorphized here (design 172 review round). What
/// makes a 16550 a 16550 is the pair below: TX holding register empty is LSR
/// bit 5 SET, and the byte goes to THR.
extension Uart16550: ConsoleSink {
    func can_write(&self) unsafe -> Bool {
        (self.regs.lsr.read() & LSR_TX_EMPTY) != 0u8
    }

    func put(&self, b: UInt8) unsafe {
        self.regs.thr.write(b)
    }
}

// =============================================================================
// SiFive test finisher (QEMU `virt`)
// =============================================================================

struct SifiveTestRegs {
    finisher: UInt32,
}

/// Writing FINISHER_PASS exits the emulator with status 0; FINISHER_FAIL
/// carries an exit code in its upper half. (`boot.S`'s `kernel_fault` and
/// `sink.c`'s `sos_rt_abort`, which `__saw_rt_panic` calls, drive the same
/// device from asm and C.)
struct SifiveTest {
    regs: UnsafeMemory<SifiveTestRegs, Device>,
}

extension SifiveTest {
    init(at: UInt) unsafe -> SifiveTest {
        SifiveTest(regs: UnsafeMemory<SifiveTestRegs, Device>(at))
    }
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `boot.S` saves on a trap from U-mode: 32 words, where word `i`
/// holds register `x<i>` and word 0 — the slot `x0` would occupy — holds
/// `mepc`. Declaration order IS the layout (design 58), so the field offsets
/// here and the `sw x<i>, i*4(sp)` stores in boot.S are one description.
struct TrapFrame {
    mepc: UInt,             // word 0  (x0 never needs saving)
    ra: UInt,               // x1
    sp: UInt,               // x2
    gp: UInt,               // x3
    tp: UInt,               // x4
    t0: UInt,               // x5
    t1: UInt,               // x6
    t2: UInt,               // x7
    s0: UInt,               // x8
    s1: UInt,               // x9
    a0: UInt,               // x10  syscall arg 0 / status out
    a1: UInt,               // x11  syscall arg 1 / value out
    a2: UInt,               // x12
    a3: UInt,               // x13
    a4: UInt,               // x14
    a5: UInt,               // x15  syscall arg 5 (the last, per §5.7)
    a6: UInt,               // x16
    a7: UInt,               // x17  syscall op
    s2: UInt,               // x18
    s3: UInt,               // x19
    s4: UInt,               // x20
    s5: UInt,               // x21
    s6: UInt,               // x22
    s7: UInt,               // x23
    s8: UInt,               // x24
    s9: UInt,               // x25
    s10: UInt,              // x26
    s11: UInt,              // x27
    t3: UInt,               // x28
    t4: UInt,               // x29
    t5: UInt,               // x30
    t6: UInt,               // x31
}

/// Bytes in one saved context.
///
/// Public because the KERNEL reserves a slot per thread and has to know this
/// fits (design 178 M2 unit 2): a trap frame is a thread's context, so the
/// kernel owns the storage and the HAL owns the layout. The assert below is
/// what keeps the number honest on this side; the kernel's own assert is what
/// keeps its stride honest on that side.
public static FRAME_BYTES: Int = 128

/// Words in a frame, for `frame_init`'s zeroing loop.
static FRAME_WORDS: UInt = 32

// The frame boot.S writes must be the frame this file describes. A field added
// on one side and not the other would misread every register after it. (The
// stores there are `sw x<i>, i*4(sp)`; the arm64 HAL pins its own the same way.)
static_assert(sizeof<TrapFrame>() == FRAME_BYTES, "the riscv32 trap frame is 32 words")

// =============================================================================
// Board constants
// =============================================================================

static UART_BASE: UInt = 0x10000000
static TEST_BASE: UInt = 0x00100000
static LSR_TX_EMPTY: UInt8 = 0x20u8       // LSR bit 5 — TX holding register empty
static IER_TX_EMPTY: UInt8 = 0x02u8       // IER bit 1 — interrupt when TX is empty
static FINISHER_PASS: UInt32 = 0x5555u32
static FINISHER_FAIL: UInt = 0x3333
static FAIL_CODE_SHIFT: Int = 16

/// The core-local timer, whose comparator this hart's periodic tick comes from.
/// The counter is at its own address rather than at an offset from the
/// comparator — they are far apart in this block, so they are two views.
static TIMER_CMP_BASE: UInt = 0x02004000
static TIMER_COUNT_BASE: UInt = 0x0200BFF8
/// The board's timebase, as counter units per microsecond: 10 MHz on this
/// machine (`timebase-frequency` in its device tree). There is no register to
/// read it from — it is a property of the board, which is why it is here.
static TIMER_UNITS_PER_US: UInt = 10

/// The platform interrupt controller, in the four windows this kernel uses.
/// The context is the one this hart takes interrupts in; the second context
/// this board wires is for a privilege mode SOS does not run in.
static PLIC_PRIORITY_BASE: UInt = 0x0C000000
static PLIC_ENABLE_BASE: UInt = 0x0C002000
static PLIC_CONTEXT_BASE: UInt = 0x0C200000
/// Sources this board wires (`riscv,ndev`). Source 0 is reserved as "no
/// source", which is what a claim returns when it has nothing to give.
static PLIC_MAX_SOURCE: UInt = 95
/// The line the board's console sits on — the one device this kernel can make
/// interrupt on demand, which is what `irq_raise_selftest_line` spends.
static CONSOLE_IRQ: UInt = 10

// =============================================================================
// Identity (design 162)
// =============================================================================

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "riscv32 (QEMU virt)"
}

/// This profile's `sosimg` arch tag. A process image built for the other
/// profile is refused by the loader rather than jumped into.
///
/// It reads the tag out of `imgformat`'s registry rather than repeating the
/// number, so the two cannot drift — a HAL claiming a tag the format does not
/// define is not expressible.
public func arch_tag() -> UInt8 {
    SosimgArch.Riscv32.tag()
}

// =============================================================================
// Console
// =============================================================================

/// Write one byte to the kernel's console.
///
/// The kernel owns the machine, so this is the UART directly. Byte-at-a-time is
/// what the seam needs: the arch-free half above formats, this half places.
public func console_byte(b: UInt8) unsafe {
    Uart16550(at: UART_BASE).write_byte(b)
}

// =============================================================================
// Stopping the machine
// =============================================================================

/// Terminate the emulator with status 0. Never returns; if the write is somehow
/// ignored, spin rather than fall back into the caller.
public func exit_pass() unsafe {
    SifiveTest(at: TEST_BASE).regs.finisher.write(FINISHER_PASS)
    while true { }
}

/// Terminate the emulator with a NON-ZERO status.
///
/// WHAT status is `sosrt.abort_status`'s call — a zero code would make the
/// finisher report success, and the rule that a failing exit never reads as a
/// passing one is decided once, for both profiles. HOW to stop is this file's:
/// the SiFive test finisher takes the code in its upper half.
public func exit_fail(code: UInt) unsafe {
    SifiveTest(at: TEST_BASE).regs.finisher.write(
        (FINISHER_FAIL | (abort_status(code) << FAIL_CODE_SHIFT)) as UInt32)
    while true { }
}

// =============================================================================
// The runtime's two hooks (design 172 unit 4)
// =============================================================================
//
// `sosrt` (sos/rt/common/src/lib.saw) implements the frozen `__saw_rt_*` seams
// over exactly two per-side hooks: where a byte goes, and how the machine
// stops. The kernel HAL answers "the UART" and "the test finisher". Both hooks
// were C; both are Saw now, and since design 172 part 2 so is everything above
// them.

/// Stop the machine with a non-zero status, for the common runtime.
///
/// The promote-zero rule lives in `exit_fail`, so this is the seam name and
/// nothing else — there is one place that decides a failing exit never reads as
/// a passing one.
///
/// `-> Never` states in the type what the C spelled `__attribute__((noreturn))`
/// and what `sosrt` declares this hook to be. `exit_fail` diverges on its own
/// (it spins if the finisher write is somehow ignored) but is typed `Void`, so
/// the trailing loop is what carries the promise up to this signature.
@export("sos_rt_abort")
public func rt_abort(code: UInt32) unsafe -> Never {
    exit_fail(code as UInt)
    while { }
}

/// Write `len` bytes at `ptr` to the console. THE PANIC PATH'S WRITER.
///
/// The loop itself is `sosrt.console_write`, once for both profiles, and its
/// CHECK-FREEDOM contract (DF-172b) is stated there — this file supplies the
/// device it walks. What is per-arch is the sink; what is per-arch about the
/// sink is two register touches.
///
/// Verified rather than asserted, on THIS instantiation: `--emit-ir` shows the
/// generic loop, the trait's default `write_byte` and both accessor bodies
/// fully inlined, leaving `ptrtoint`, a plain `load i8`, the volatile LSR load,
/// an `and`, an `icmp`, the volatile THR store and `add`/`add -1`. No
/// `llvm.uadd.with.overflow`, no bounds check, no trap block, no call to
/// `__saw_rt_panic`. A panic inside the panic reporter is not unlikely here; it
/// is unreachable.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<Int8>, len: UInt) unsafe {
    let sink = Uart16550(at: UART_BASE)
    console_write(&sink, ptr, len)
}

// =============================================================================
// Privilege, protection and payload seams (boot.S / sink.c)
// =============================================================================

// The C half of this HAL, and since design 172 unit 1 the whole of it: a
// privilege transition, two CSR writers, and two linker symbols. What a PMP
// region MEANS is staged in Saw below; C only places a word in a numbered
// register, because a `csrw` names its CSR in the INSTRUCTION. See `sink.c`'s
// header for the reason each survivor carries.
extern "C" {
    func sos_resume_frame(frame_addr: UInt)
    func sos_pmpaddr_write(index: UInt, value: UInt)
    func sos_pmpcfg_write(lo: UInt, hi: UInt)
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
    func sos_mie_write(mask: UInt)
}

/// This target's protection granularity. PMP stores its bounds shifted right by
/// two, so a region bound is rounded to four bytes.
public static PROT_GRAIN: UInt = 4

/// How many segments a root image may ask for. One PMP region per segment plus
/// one for the stack, out of the four the board budget programs (see
/// `sink.c`'s `PMP_REGIONS`).
public static MAX_ROOT_SEGMENTS: UInt = 3

/// Root's region on this board (design 140 pin; mirrored by the root linker
/// script and recorded in `virt.ld`'s memory map). Segments load from the base;
/// the stack occupies the top `ROOT_STACK_LEN` bytes.
public static ROOT_LOAD_BASE: UInt = 0x80200000
public static ROOT_REGION_TOP: UInt = 0x80240000
public static ROOT_STACK_LEN: UInt = 0x4000

/// An address the KERNEL itself cannot reach on this target — nothing is there
/// and nothing maps it. The harness's kernel-fault case reads it to prove a
/// fault taken in kernel mode is diagnosed rather than hung on (M0's
/// discipline), and it is per-target because "unmapped" is: on a profile whose
/// kernel runs with an MMU on, low addresses are the DEVICE window and reading
/// one succeeds.
public static UNMAPPED_PROBE: UInt = 0x00000000

// =============================================================================
// PMP: the Profile A isolation primitive
// =============================================================================
//
// Spec §5.5: on Profile A an AddressSpace IS a PMP region set. RISC-V gives us
// default-deny for free — "if no PMP entry matches a U-mode access, and at
// least one entry is implemented, the access fails" — so the kernel, the UART
// and the finisher are locked away from root by SAYING NOTHING about them. The
// kernel grants root exactly its own ranges. M-mode is unconstrained because
// SOS never sets an entry's L (lock) bit.
//
// A region is a TOR pair: entry 2*idx holds the lower bound with A=OFF (a bound
// only, never matched), entry 2*idx+1 holds the upper bound with A=TOR plus the
// R/W/X bits. Bounds are stored shifted right by two — PMP's 4-byte grain. The
// M1 budget is `PMP_REGIONS` regions out of the eight entries `sink.c`'s switch
// covers; the layout is recorded in virt.ld.
//
// DESIGN 172 UNIT 1: all of that is arithmetic, so it is Saw. What stays native
// is placing a word in a NUMBERED CSR, because `csrw pmpaddr3, x` names the
// register in the instruction and an indexed write therefore has to be a switch
// in assembly. Profile B makes the same split at the same seam: descriptors in
// Saw, the activation instructions in C.

/// Regions the board budget programs, as TOR pairs out of the eight entries
/// `sink.c` can reach.
static PMP_REGIONS: UInt = 4
static PMP_A_TOR: UInt = 0x8              // cfg bits 4:3 = 1 (top-of-range)
static PMP_PERM_MASK: UInt = 0x7          // cfg bits 2:0 — R, W, X
static PMP_GRAIN_SHIFT: Int = 2           // bounds are stored >> 2
static PMP_CFGS_PER_WORD: UInt = 4
static BITS_PER_PMP_CFG: Int = 8

/// The two `pmpcfg` shadow words — entries 0-3 and 4-7.
///
/// Compound global state: staged across several `prot_region` calls and
/// published by one `prot_commit`, with no cheap way to read the hardware back.
/// That is the shape design 149's `unsafe static var` exists for, and the
/// serialization argument is spec §7's — uniprocessor, no interrupt sources in
/// M1, and only the boot path touches these.
unsafe static var PMPCFG_LO: UInt = 0
unsafe static var PMPCFG_HI: UInt = 0

/// Revoke every grant. User mode then reaches nothing at all — the default-deny
/// the grants below carve out of.
public func prot_reset() unsafe {
    PMPCFG_LO = 0
    PMPCFG_HI = 0
    sos_pmpcfg_write(0, 0)
    var i: UInt = 0
    while i < PMP_REGIONS * 2 {
        sos_pmpaddr_write(i, 0)
        i = i + 1
    }
}

/// Stage grant `idx` as [base, top) with `perms`, a mask in the `SegFlag`
/// vocabulary. On this target those bits ARE a PMP config's low three bits
/// (`imgformat` says why the format numbers them that way), so the mask
/// installs untranslated.
///
/// An out-of-budget index is ignored here and rejected by the caller, which
/// owns the diagnostic.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
    if idx >= PMP_REGIONS {
        return
    }
    let lo = idx * 2
    let hi = lo + 1
    sos_pmpaddr_write(lo, base >> PMP_GRAIN_SHIFT)
    sos_pmpaddr_write(hi, top >> PMP_GRAIN_SHIFT)
    let cfg = ((perms as UInt) & PMP_PERM_MASK) | PMP_A_TOR
    if hi < PMP_CFGS_PER_WORD {
        PMPCFG_LO = PMPCFG_LO | (cfg << (BITS_PER_PMP_CFG * (hi as Int)))
    } else {
        PMPCFG_HI = (PMPCFG_HI
                     | (cfg << (BITS_PER_PMP_CFG * ((hi - PMP_CFGS_PER_WORD) as Int))))
    }
}

/// Publish the staged grant set. Separate from `prot_region` so a partially
/// programmed set is never live.
public func prot_commit() unsafe {
    sos_pmpcfg_write(PMPCFG_LO, PMPCFG_HI)
}

/// Build a fresh user context in `frame_addr`: `entry` as the resume address,
/// `stack_top` as the stack pointer, `arg0` in the first argument register.
///
/// EVERY OTHER WORD IS ZEROED, which is the same promise the register-clearing
/// `sos_enter_user` used to make in assembly and is now made by a loop the
/// compiler can see: nothing of the kernel's, and nothing of another thread's,
/// crosses into a context this builds. The return-address register is among the
/// zeroed ones on purpose — a thread entry that RETURNS jumps to zero and takes
/// an instruction-access fault, which spec §8 turns into the death of its
/// process. That is a diagnosed stop rather than a run into whatever follows.
public func frame_init(frame_addr: UInt, entry: UInt, stack_top: UInt,
                       arg0: UInt) unsafe {
    var w: UInt = 0
    while w < FRAME_WORDS {
        UnsafeMemory<UInt, Normal>(frame_addr + w * WORD_BYTES).write(0)
        w = w + 1
    }
    let frame = frame_at(frame_addr)
    frame.mepc.write(entry)
    frame.sp.write(stack_top)
    frame.a0.write(arg0)
}

static WORD_BYTES: UInt = 4

/// Resume the context saved in `frame_addr`, in user mode. Never returns.
///
/// The FIRST entry to user mode, and the only one that is not `ktrap` handing a
/// frame back to the trap entry — which is why the assembly behind it is a
/// privilege-mode select and a branch into the trap entry's own restore path
/// rather than a second copy of it.
public func resume_frame(frame_addr: UInt) -> Never {
    sos_resume_frame(frame_addr)
    while { }
}

/// First byte of the appended payload — the `.payload` section `virt.ld`
/// bounds. Saw cannot name a linker symbol, so the bounds arrive through C.
public func payload_start() -> UInt {
    sos_payload_start()
}

/// One past the last byte of the appended payload. Equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

// =============================================================================
// Traps
// =============================================================================

/// The `mcause` exception codes M1 can take (interrupt bit clear).
///
/// Backed by `UInt` — the width of the CSR the value arrives in. The numbers are
/// RISC-V's, not ours, which is exactly why they are pinned per case: a reorder
/// here must never renumber them.
enum TrapCause: UInt {
    case InsnMisaligned = 0,
    case InsnAccessFault = 1,
    case IllegalInsn = 2,
    case Breakpoint = 3,
    case LoadMisaligned = 4,
    case LoadAccessFault = 5,
    case StoreMisaligned = 6,
    case StoreAccessFault = 7,
    case EcallFromU = 8,
}

extension TrapCause {
    /// The short symbolic name a fault line reports.
    func describe(&self) -> String {
        match self {
            case InsnMisaligned -> "instruction-address-misaligned",
            case InsnAccessFault -> "instruction-access-fault",
            case IllegalInsn -> "illegal-instruction",
            case Breakpoint -> "breakpoint",
            case LoadMisaligned -> "load-address-misaligned",
            case LoadAccessFault -> "load-access-fault",
            case StoreMisaligned -> "store-address-misaligned",
            case StoreAccessFault -> "store-access-fault",
            case EcallFromU -> "ecall-from-u-mode",
        }
    }
}

/// `ecall` is a 4-byte instruction — `mepc` points AT it, so a returning
/// syscall must step past it or the trap repeats forever. (Profile B's `svc`
/// leaves `ELR` already past, which is why advancing belongs to the HAL.)
static SYSCALL_INSN_LEN: UInt = 4

/// Did this trap come from a syscall instruction, or is it a fault?
public func is_syscall(cause: UInt) -> Bool {
    cause == (TrapCause.EcallFromU as UInt)
}

/// The high bit of a cause word says "this is an interrupt, not an exception",
/// and the rest of the word is then an INTERRUPT code with its own numbering —
/// a 7 with the flag set has nothing to do with a 7 without it.
static INTERRUPT_FLAG: UInt = 0x80000000

/// The interrupt codes this kernel can take. Numbered by the architecture, not
/// by us, so each is pinned per case; the flag above is stripped before the
/// decode, which is why these are small numbers and not high ones.
enum InterruptCause: UInt {
    case MachineTimer = 7,
    case MachineExternal = 11,
}

/// Is this trap an interrupt rather than a syscall or a fault?
///
/// Interrupts only ever arrive from USER mode (design 178 D2): this hart takes
/// them in kernel mode only with the global enable set, which SOS never sets,
/// and a trap taken in kernel mode goes to `boot.S`'s kernel-bug path anyway.
public func is_interrupt(cause: UInt) -> Bool {
    (cause & INTERRUPT_FLAG) != 0
}

/// A short symbolic name for a raw trap cause.
///
/// The decode is where an unknown code stops being a number: `from(raw:)` is
/// total, and the hardware may raise a cause this kernel does not model, so the
/// miss has its own name rather than an arm. Everything it DOES model is an
/// exhaustive `match` in `describe`, so a cause added to the enum fails to
/// compile until it is given a name.
public func cause_tag(cause: UInt) -> String {
    guard let decoded = TrapCause.from(raw: cause) else {
        return "unexpected-trap"
    }
    decoded.describe()
}

/// Overlay the saved context. One view construction, then ordinary field names.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Where the trapped context resumes — the faulting instruction on a fault, the
/// interrupted one on an interrupt. (It was `fault_pc` until interrupts had a
/// use for it too; the value never was fault-specific.)
public func trap_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).mepc.read()
}

/// §5.7: a0 = handle, a7 = op, args a1-a5.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a0.read()
}

public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a7.read()
}

public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a1.read()
}

public func syscall_arg1(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a2.read()
}

public func syscall_arg2(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).a3.read()
}

/// Place a syscall's (status, value) pair where the caller will find it and
/// step the saved PC past the trapping instruction. Resuming is the assembly's
/// job; deciding what "past" means is this file's.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.a0.write(status)
    frame.a1.write(value)
    frame.mepc.write(frame.mepc.read() + SYSCALL_INSN_LEN)
}

// =============================================================================
// Which sources may interrupt this hart (design 178 M2 unit 1)
// =============================================================================
//
// Two masks stand between a device and this kernel, and they are not
// interchangeable. THIS one is the hart's: one bit per interrupt CLASS (timer,
// external), and it is what makes a class reachable at all. The PLIC's, below,
// is per SOURCE within the external class.
//
// What is NOT here is the GLOBAL enable, and its absence is design 178's D2:
// this hart delivers a machine interrupt to a lower privilege mode
// UNCONDITIONALLY, and to itself only with the global bit set — so leaving that
// bit clear forever is exactly "interrupts are taken from user mode only". The
// kernel needs no critical sections and the trap path needs no epilogue; a
// wrongly-arrived interrupt lands on `boot.S`'s kernel-bug path, which is a
// diagnosed stop rather than a silent reentry.

/// The class mask, staged here because the register it mirrors is written
/// through a C leaf and reading it back would cost a second one. Compound
/// global state on a serialization argument the compiler cannot see (design
/// 149): uniprocessor, and only bring-up writes it.
unsafe static var IRQ_CLASSES: UInt = 0

/// Class bits, by their architectural positions.
static IRQ_CLASS_TIMER: UInt = 0x80         // bit 7
static IRQ_CLASS_EXTERNAL: UInt = 0x800     // bit 11

/// Let a class of interrupt reach this hart.
func irq_class_enable(bit: UInt) unsafe {
    IRQ_CLASSES = IRQ_CLASSES | bit
    sos_mie_write(IRQ_CLASSES)
}

// =============================================================================
// The machine timer (design 178 M2 unit 1)
// =============================================================================
//
// The periodic tick comes from the core-local timer: a free-running 64-bit
// counter and a per-hart comparator, both ordinary MMIO, so all of it is Saw
// through the design-112 driver idiom and none of it is C.
//
// The condition is a LEVEL, not an edge — the timer asserts while the counter
// is at or past the comparator — so the tick path REARMS rather than
// acknowledging: writing the next deadline is what lowers the line. That is why
// the seam has `timer_rearm` and why `irq_complete` has nothing to do for it.
//
// The counter is 64 bits on a 32-bit machine, which is the whole awkwardness
// here: each half is its own register, so a read has to survive a carry between
// them and a write has to avoid the instant where the halves describe a
// deadline that is neither the old one nor the new one.

/// The comparator, low half first.
struct TimerCmpRegs {
    lo: UInt32,
    hi: UInt32,
}

/// The counter, same shape and read-only.
struct TimerCountRegs {
    lo: ReadOnly<UInt32>,
    hi: ReadOnly<UInt32>,
}

/// The driver: this hart's comparator, and the counter it is compared against.
struct MachineTimer {
    cmp: UnsafeMemory<TimerCmpRegs, Device>,
    count: UnsafeMemory<TimerCountRegs, Device>,
}

extension MachineTimer {
    init() unsafe -> MachineTimer {
        MachineTimer(cmp: UnsafeMemory<TimerCmpRegs, Device>(TIMER_CMP_BASE),
                     count: UnsafeMemory<TimerCountRegs, Device>(TIMER_COUNT_BASE))
    }

    /// The counter, read carry-safely: the high half is read either side of the
    /// low one, and a carry between the two reads is retried. Without this a
    /// read that straddled a carry would be off by 2^32 counter units — about
    /// seven minutes here, and only ever on the one read in seven minutes that
    /// hits it.
    func now(&self) unsafe -> UInt64 {
        var hi = self.count.hi.read()
        var lo = self.count.lo.read()
        var hi2 = self.count.hi.read()
        while hi != hi2 {
            hi = hi2
            lo = self.count.lo.read()
            hi2 = self.count.hi.read()
        }
        (((hi as UInt64) << WORD_BITS) | (lo as UInt64))
    }

    func deadline(&self) unsafe -> UInt64 {
        (((self.cmp.hi.read() as UInt64) << WORD_BITS)
         | (self.cmp.lo.read() as UInt64))
    }

    /// Program the next deadline. The low half goes to all-ones FIRST, so the
    /// pair never momentarily names a deadline in the past — the classic
    /// split-comparator write order, and the reason this is a method rather
    /// than two stores at the call site.
    ///
    /// The halves are taken with `truncating:`, which is what splitting a wide
    /// value into two registers MEANS; a checked cast would be a panic edge on
    /// the one path a kernel wants free of them.
    func set_deadline(&self, at: UInt64) unsafe {
        self.cmp.lo.write(0xFFFFFFFFu32)
        self.cmp.hi.write(UInt32.from(truncating: at >> WORD_BITS))
        self.cmp.lo.write(UInt32.from(truncating: at))
    }

    /// Has the timer expired without being serviced? This IS the pending
    /// condition — the hardware asserts on exactly this comparison — so it
    /// needs no interrupt-controller state and no extra register.
    func expired(&self) unsafe -> Bool {
        self.now() >= self.deadline()
    }
}

static WORD_BITS: Int = 32

/// The tick period in counter units, staged for `timer_rearm`. Same shape and
/// same argument as `IRQ_CLASSES` above.
unsafe static var TIMER_PERIOD: UInt = 0

/// Start a periodic tick every `period_us` microseconds.
public func timer_start(period_us: UInt) unsafe {
    TIMER_PERIOD = period_us * TIMER_UNITS_PER_US
    timer_rearm()
    irq_class_enable(IRQ_CLASS_TIMER)
}

/// Schedule the next tick, which is also what lowers the line for the tick the
/// kernel is servicing.
///
/// The next deadline is measured from NOW rather than from the last one: a tick
/// the kernel was late for is one tick, never a burst of catch-up ticks whose
/// only effect would be to keep the machine in the trap handler.
public func timer_rearm() unsafe {
    let timer = MachineTimer()
    timer.set_deadline(timer.now() + (TIMER_PERIOD as UInt64))
}

/// Has the timer expired without a tick having been taken for it?
public func timer_pending() unsafe -> Bool {
    MachineTimer().expired()
}

// =============================================================================
// The platform interrupt controller (design 178 M2 unit 1, D6)
// =============================================================================
//
// Every device interrupt on this board arrives through one controller, which
// prioritizes the sources and hands the winner to a CONTEXT — a (hart,
// privilege) pair. SOS uses one context, the one this kernel runs in.
//
// The cycle is claim-then-complete: reading the claim register both says which
// source won and marks it in service, and writing the same number back releases
// it. Between the two the source cannot win again, which is what makes the
// handler non-reentrant for free.
//
// MASKING IS BY PRIORITY, NOT BY THE ENABLE BIT, and that is worth knowing:
// this controller ignores a completion for a source that is not enabled for the
// context, so masking a line by disabling it between claim and complete would
// leave it in service forever. Priority 0 means "never wins", which is the same
// mask with none of that.

/// The context window: the priority a source must beat to be delivered here,
/// and the register that claims and completes.
struct PlicContextRegs {
    threshold: UInt32,
    claim: UInt32,
}

struct Plic {
    context: UnsafeMemory<PlicContextRegs, Device>,
}

/// Priority levels this kernel uses: 0 is the architecture's "never
/// interrupt", and every unmasked line shares the one level above it — SOS
/// prioritizes in software (spec §7), not in the controller.
static PLIC_PRIORITY_MASKED: UInt32 = 0u32
static PLIC_PRIORITY_ACTIVE: UInt32 = 1u32
static PLIC_SOURCES_PER_WORD: UInt = 32
static REGISTER_BYTES: UInt = 4

extension Plic {
    init() unsafe -> Plic {
        Plic(context: UnsafeMemory<PlicContextRegs, Device>(PLIC_CONTEXT_BASE))
    }

    /// One source's priority register.
    func priority_at(&self, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(PLIC_PRIORITY_BASE + line * REGISTER_BYTES)
    }

    /// The enable word holding this source's bit, for this context.
    func enable_word_at(&self, line: UInt) unsafe -> UnsafeMemory<UInt32, Device> {
        UnsafeMemory<UInt32, Device>(
            PLIC_ENABLE_BASE + (line / PLIC_SOURCES_PER_WORD) * REGISTER_BYTES)
    }

    /// Every source masked and disabled, and the context's threshold at 0 so
    /// that an unmasked source at any priority above it gets through.
    func reset(&self) unsafe {
        var line: UInt = 1
        while line <= PLIC_MAX_SOURCE {
            self.priority_at(line).write(PLIC_PRIORITY_MASKED)
            line = line + 1
        }
        var word: UInt = 0
        while word * PLIC_SOURCES_PER_WORD <= PLIC_MAX_SOURCE {
            UnsafeMemory<UInt32, Device>(
                PLIC_ENABLE_BASE + word * REGISTER_BYTES).write(0u32)
            word = word + 1
        }
        self.context.threshold.write(0u32)
    }

    func set_priority(&self, line: UInt, priority: UInt32) unsafe {
        self.priority_at(line).write(priority)
    }

    func set_enabled(&self, line: UInt) unsafe {
        let word = self.enable_word_at(line)
        word.write(word.read() | (1u32 << ((line % PLIC_SOURCES_PER_WORD) as Int)))
    }

    /// Which source won, and mark it in service. 0 means none — the
    /// architecture reserves source 0 for exactly that.
    func claim(&self) unsafe -> UInt {
        self.context.claim.read() as UInt
    }

    /// Release the source, so it may win again once it is unmasked.
    func complete(&self, line: UInt) unsafe {
        self.context.claim.write(line as UInt32)
    }
}

/// The controller had nothing to give. Both profiles report a spurious
/// interrupt as this value, and neither ever uses it as a real line.
public static IRQ_NONE: UInt = 0

/// The line the periodic timer arrives on.
///
/// The timer is NOT one of this controller's sources here — it is a class of
/// its own at the hart — so the seam needs a number the controller can never
/// produce, and one past its last source is that number.
public static IRQ_TIMER: UInt = 1024

static_assert(IRQ_TIMER > PLIC_MAX_SOURCE,
              "the timer's line must not collide with a real interrupt source")

/// Bring the interrupt controller up with every line masked, and make the
/// external class reachable at the hart. Individual lines are opened by
/// `irq_unmask` and by nothing else.
public func intc_init() unsafe {
    Plic().reset()
    irq_class_enable(IRQ_CLASS_EXTERNAL)
}

/// Let `line` interrupt the kernel.
public func irq_unmask(line: UInt) unsafe {
    let plic = Plic()
    plic.set_enabled(line)
    plic.set_priority(line, PLIC_PRIORITY_ACTIVE)
}

/// Stop `line` interrupting the kernel — spec §9's mask-on-fire, which the
/// Interrupt object's `ack` will undo when there is one.
public func irq_mask(line: UInt) unsafe {
    Plic().set_priority(line, PLIC_PRIORITY_MASKED)
}

/// Which line is being serviced, or `IRQ_NONE`.
///
/// The class comes from the cause word and the SOURCE, for an external
/// interrupt, from the controller — which is why claiming takes the cause: on
/// this profile the timer never reaches the controller at all.
public func irq_claim(cause: UInt) unsafe -> UInt {
    let code = cause & ~INTERRUPT_FLAG
    if code == (InterruptCause.MachineTimer as UInt) {
        return IRQ_TIMER
    }
    if code == (InterruptCause.MachineExternal as UInt) {
        return Plic().claim()
    }
    IRQ_NONE
}

/// End of service for `line`.
///
/// The timer has none: its line is lowered by rearming the comparator, and this
/// controller never saw it.
public func irq_complete(line: UInt) unsafe {
    if line == IRQ_TIMER {
        return
    }
    Plic().complete(line)
}

/// Raise a line from software, for interrupt bring-up. Returns the line raised.
///
/// There is no software-trigger register on this controller, so the source is a
/// real device: the console's "transmit register is empty" interrupt, which
/// asserts as soon as it is enabled and needs no input to arrive. It is the one
/// device this kernel already owns, and the kernel masks the line in its
/// handler, so the still-asserting device does not re-fire.
///
/// This is bring-up scaffolding in the honest sense — a kernel with no Interrupt
/// object (spec §2) has no other way to reach a real claim/complete cycle — and
/// the object-model unit is where a driver takes the line over.
public func irq_raise_selftest_line() unsafe -> UInt {
    irq_unmask(CONSOLE_IRQ)
    Uart16550(at: UART_BASE).regs.ier.write(IER_TX_EMPTY)
    CONSOLE_IRQ
}
