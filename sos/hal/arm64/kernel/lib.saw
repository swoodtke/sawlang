//! The arm64 kernel HAL, Saw half (design 162) — QEMU `virt`, EL1.
//!
//! Everything the SOS kernel needs from THIS machine, and nothing more. The
//! kernel core above it (`sos/kernel/core/`) names no architecture at all: it
//! reaches the board, the privilege transition and the memory-protection
//! hardware only through the surface below, which `sos/hal/riscv32/kernel/`
//! implements the same way for Profile A. `ABI.md` beside this file is the
//! contract; `boot.S` and `sink.c` are the parts of it that cannot be Saw.
//!
//! Addresses and machine words are `UInt` throughout, never `Int`. On this
//! target `Int` is 64-bit SIGNED, so the addresses here fit either way — which
//! is exactly why the discipline has to be written down rather than tested: the
//! same code on Profile A puts 0x8020_0000 in `Int`'s negative half (DF-140a).

// The image-format registry, for this profile's arch tag. The format is shared
// with everyone who touches an image; the tag a HAL claims comes out of it
// rather than being spelled again here.
import imgformat.{SosimgArch, SegFlag}

// Arch-free, role-free formatting, shared with the kernel core and every SOS
// process build. This HAL formats its OWN diagnostics — the kernel core is
// ABOVE it and cannot be imported from here — so it reaches for the same
// helpers the kernel console does, and the two agree on what a non-ASCII scalar
// becomes and on how wide a machine word is.
import sosrt.{ascii_byte, hex_digit_of, hex_digits_per_word}

// =============================================================================
// PL011 UART (design 112's blessed MMIO idiom: register block + driver)
// =============================================================================

/// The PL011 register block, as far as a polled transmitter needs it.
/// Declaration order IS the layout (design 58), so the reserved words between
/// the data register and the flag register are spelled out rather than
/// computed — a hole in a register block is a field like any other.
struct Pl011Regs {
    dr: UInt32,             // +0x00  data
    rsr: UInt32,            // +0x04  receive status / error clear
    reserved0: UInt32,      // +0x08
    reserved1: UInt32,      // +0x0C
    reserved2: UInt32,      // +0x10
    reserved3: UInt32,      // +0x14
    fr: ReadOnly<UInt32>,   // +0x18  flag register
}

/// The console driver. A SAFE type (unsafety is not transitive — design 130):
/// only the methods reaching through `regs` carry the `unsafe` effect.
struct Pl011 {
    regs: UnsafeMemory<Pl011Regs, Device>,
}

extension Pl011 {
    init(at: UInt) unsafe -> Pl011 {
        Pl011(regs: UnsafeMemory<Pl011Regs, Device>(at))
    }

    /// Poll the transmit-FIFO-full flag, then write one byte to the data
    /// register — no interrupts in M1. QEMU's PL011 comes up transmitting, so
    /// there is no baud-rate or line-control programming to do; a real board
    /// would need it and it would go here.
    func write_byte(&self, b: UInt8) unsafe {
        while (self.regs.fr.read() & FR_TX_FULL) != 0u32 { }
        self.regs.dr.write(b as UInt32)
    }
}

// =============================================================================
// The trap frame
// =============================================================================

/// The context `boot.S` saves on a trap from EL0: 34 doublewords. Declaration
/// order IS the layout (design 58), so the field names here and the
/// `stp x<n>, x<n+1>, [sp, #...]` stores in boot.S are one description.
///
/// The three system registers come FIRST because they are what the resume path
/// reads back — and because x31 is not a register: `sp` at EL0 is `SP_EL0`, a
/// separate register the kernel saves explicitly, so there is no "slot x0 would
/// have occupied" to reuse the way Profile A does for its PC.
struct TrapFrame {
    elr: UInt,              // the PC to resume at — already PAST the `svc`
    spsr: UInt,             // saved processor state
    sp: UInt,               // SP_EL0, the user stack pointer
    x0: UInt,               // syscall handle / status out
    x1: UInt,               // syscall arg 0 / value out
    x2: UInt,
    x3: UInt,
    x4: UInt,
    x5: UInt,               // syscall arg 4 (the last, per §5.7)
    x6: UInt,
    x7: UInt,
    x8: UInt,               // syscall op
    x9: UInt,
    x10: UInt,
    x11: UInt,
    x12: UInt,
    x13: UInt,
    x14: UInt,
    x15: UInt,
    x16: UInt,
    x17: UInt,
    x18: UInt,
    x19: UInt,
    x20: UInt,
    x21: UInt,
    x22: UInt,
    x23: UInt,
    x24: UInt,
    x25: UInt,
    x26: UInt,
    x27: UInt,
    x28: UInt,
    x29: UInt,
    x30: UInt,
}

// The frame boot.S builds must be the frame this file describes. A field added
// on one side and not the other would misread every register after it.
static_assert(sizeof<TrapFrame>() == 272, "the arm64 trap frame is 34 doublewords")

// =============================================================================
// Board constants
// =============================================================================

static UART_BASE: UInt = 0x09000000
static FR_TX_FULL: UInt32 = 0x20u32       // FR bit 5 — transmit FIFO full

// =============================================================================
// Identity (design 162)
// =============================================================================

/// What this kernel says it is booting on, for the banner.
public func arch_name() -> String {
    "arm64 (QEMU virt)"
}

/// This profile's `sosimg` arch tag. A process image built for the other
/// profile is refused by the loader rather than jumped into.
///
/// It reads the tag out of `imgformat`'s registry rather than repeating the
/// number, so the two cannot drift — a HAL claiming a tag the format does not
/// define is not expressible.
public func arch_tag() -> UInt8 {
    SosimgArch.Arm64.tag()
}

// =============================================================================
// Console
// =============================================================================

/// Write one byte to the kernel's console.
///
/// The kernel owns the machine, so this is the UART directly. Byte-at-a-time is
/// what the seam needs: the arch-free half above formats, this half places.
public func console_byte(b: UInt8) unsafe {
    Pl011(at: UART_BASE).write_byte(b)
}

// =============================================================================
// Stopping the machine
// =============================================================================

// `hlt #0xf000` is not expressible in Saw and neither is the register pinning
// the semihosting call needs, so both exits go through the C half. See
// `sink.c` for why semihosting rather than PSCI.
extern "C" {
    func sos_platform_exit(code: UInt)
}

/// Stop the machine with status 0. Never returns.
public func exit_pass() {
    sos_platform_exit(0)
    while true { }
}

/// Stop the machine with a NON-ZERO status. A zero code would report success,
/// so it is promoted to `FAIL_CODE_MIN` — a failing exit never reads as a
/// passing one.
public func exit_fail(code: UInt) {
    var status = code & FAIL_CODE_MASK
    if status == 0 {
        status = FAIL_CODE_MIN
    }
    sos_platform_exit(status)
    while true { }
}

static FAIL_CODE_MASK: UInt = 0xFF
static FAIL_CODE_MIN: UInt = 1

// =============================================================================
// The runtime's two hooks (design 172 unit 4)
// =============================================================================
//
// `sos/rt/common_c/support.c` implements the frozen `__saw_rt_*` seams over
// exactly two per-side hooks: where a byte goes, and how the machine stops. The
// kernel HAL answers "the UART" and "the platform's exit". Both were C; both
// are Saw now.

/// Stop the machine with a non-zero status, for the common runtime.
///
/// The promote-zero rule lives in `exit_fail`, so this is the seam name and
/// nothing else — there is one place that decides a failing exit never reads as
/// a passing one.
@export("sos_rt_abort")
public func rt_abort(code: UInt32) {
    exit_fail(code as UInt)
}

/// Write `len` bytes at `ptr` to the console. THE PANIC PATH'S WRITER.
///
/// CHECK-FREE BY CONSTRUCTION, and that is the whole contract rather than a
/// nice property. This runs while a panic is being reported, so a bounds check
/// or an overflow check that tripped here would call `__saw_rt_panic` again and
/// either hang or garble the one diagnostic that matters. So: no indexing (raw
/// `UnsafeMemory` reads), no allocation, no `String`, and the cursor advances
/// with WRAPPING arithmetic (`&+` / `&-`) so even a nonsensical length cannot
/// raise an overflow trap.
///
/// Verified rather than asserted (DF-172b): `--emit-ir` over this function and
/// everything it calls shows `ptrtoint`, a plain `load i8`, `add`/`sub` — not
/// `llvm.uadd.with.overflow` — an `icmp`, a `getelementptr inbounds`, and the
/// driver's volatile MMIO load and store. There is no check, no trap block and
/// no call to `__saw_rt_panic` anywhere in it. A panic inside the panic
/// reporter is not unlikely here; it is unreachable.
///
/// A change to this function or to `console_byte` that introduces an index, an
/// allocation or a checked `+` silently retires that guarantee, so re-read the
/// IR if you touch either.
@export("sos_rt_write")
public func rt_write(ptr: UnsafePointer<UInt8>, len: UInt) unsafe {
    var addr = ptr as UInt
    var left = len
    while left != 0 {
        console_byte(UnsafeMemory<UInt8, Normal>(addr).read())
        addr = addr &+ 1
        left = left &- 1
    }
}

// =============================================================================
// Privilege, protection and payload seams (boot.S / sink.c)
// =============================================================================

// The native half of this HAL, and now the whole of it: an `eret`, a barrier
// pair with a TLB flush, and two linker symbols. The protection primitive's
// DESCRIPTORS are built below in Saw (design 172 unit 1) — only publishing them
// needs instructions. See `sink.c`'s header for the reason each survivor
// carries.
extern "C" {
    func sos_enter_user(entry: UInt, stack_top: UInt, boot_handle: UInt)
    func sos_prot_commit()
    func sos_payload_start() -> UInt
    func sos_payload_end() -> UInt
}

/// This target's protection granularity: a translation-table page. Profile A
/// grants at four-byte granularity, which is why a root image built for this
/// profile has to place its segments on page boundaries and the loader checks
/// that it did.
public static PROT_GRAIN: UInt = 4096

/// How many segments a root image may ask for. A page-table profile has no
/// small fixed region budget the way PMP does, so this is a sanity bound on a
/// hostile header rather than a hardware limit.
public static MAX_ROOT_SEGMENTS: UInt = 8

/// Root's region on this board. The base is 2 MiB into RAM — the same offset
/// Profile A uses, and here it is also a level-2 boundary, so root's pages come
/// out of the grant window whole. Mirrored by the root linker script.
public static ROOT_LOAD_BASE: UInt = 0x40200000
public static ROOT_REGION_TOP: UInt = 0x40240000
public static ROOT_STACK_LEN: UInt = 0x4000

/// An address the KERNEL itself cannot reach on this target. The level-1 entry
/// covering it is invalid, so a read is a translation fault taken at EL1. It is
/// NOT a low address: with the MMU on, low addresses are the device window and
/// reading one would simply succeed.
public static UNMAPPED_PROBE: UInt = 0x80000000

/// Publish the staged grant set: order the descriptor writes and flush the TLB.
/// Separate from `prot_region` so a partially programmed set is never live.
///
/// The barriers are the only part of this that is not Saw — see `sink.c`.
public func prot_commit() {
    sos_prot_commit()
}

/// Drop to user mode at `entry` with `stack_top` as the stack pointer, handing
/// over `boot_handle` in the first argument register — the boot handle set of
/// spec §12. Never returns; the next kernel code to run is `ktrap`.
public func enter_user(entry: UInt, stack_top: UInt, boot_handle: UInt) {
    sos_enter_user(entry, stack_top, boot_handle)
}

/// First byte of the appended payload — the `.payload` section `virt.ld`
/// bounds. Saw cannot name a linker symbol, so the bounds arrive through C.
public func payload_start() -> UInt {
    sos_payload_start()
}

/// One past the last byte of the appended payload. Equal to `payload_start()`
/// in an image built without one.
public func payload_end() -> UInt {
    sos_payload_end()
}

// =============================================================================
// Traps
// =============================================================================

/// The `ESR_EL1` exception classes M1 can take from EL0 or take itself.
///
/// Backed by `UInt` — the width of the register the value arrives in. The
/// numbers are the architecture's, not ours, which is exactly why they are
/// pinned per case: a reorder here must never renumber them.
enum ExceptionClass: UInt {
    case Unknown = 0,
    case SimdFpTrap = 7,
    case IllegalState = 14,
    case Svc64 = 21,
    case InsnAbortLower = 32,
    case InsnAbortSame = 33,
    case PcAlignment = 34,
    case DataAbortLower = 36,
    case DataAbortSame = 37,
    case SpAlignment = 38,
    case Breakpoint = 60,
}

extension ExceptionClass {
    /// The short symbolic name a fault line reports.
    ///
    /// The vocabulary is deliberately the SAME on both profiles — a store that
    /// user mode was not granted is a `store-access-fault` whether the hardware
    /// called it a PMP violation or a data abort — so the harness asserts one
    /// string against two architectures and a reader who knows one profile can
    /// read the other's diagnostics.
    func describe(&self, iss: UInt) -> String {
        match self {
            case Unknown -> "unknown-reason",
            case SimdFpTrap -> "fp-access-trap",
            case IllegalState -> "illegal-instruction",
            case Svc64 -> "svc-from-user",
            case InsnAbortLower -> "instruction-access-fault",
            case InsnAbortSame -> "instruction-access-fault",
            case PcAlignment -> "instruction-address-misaligned",
            // A data abort says which direction it was in ISS bit 6, which is
            // the whole difference between the two Profile A causes.
            case DataAbortLower -> abort_direction(iss),
            case DataAbortSame -> abort_direction(iss),
            case SpAlignment -> "stack-address-misaligned",
            case Breakpoint -> "breakpoint",
        }
    }
}

/// ISS bit 6 (WnR) on a data abort: set means the access was a write.
func abort_direction(iss: UInt) -> String {
    if (iss & ISS_WNR) != 0 {
        "store-access-fault"
    } else {
        "load-access-fault"
    }
}

static ESR_EC_SHIFT: Int = 26
static ESR_EC_MASK: UInt = 0x3F
static ESR_ISS_MASK: UInt = 0x1FFFFFF
static ISS_WNR: UInt = 0x40

/// Did this trap come from a syscall instruction, or is it a fault?
public func is_syscall(cause: UInt) -> Bool {
    ((cause >> ESR_EC_SHIFT) & ESR_EC_MASK) == (ExceptionClass.Svc64 as UInt)
}

/// A short symbolic name for a raw `ESR_EL1` value.
///
/// The decode is where an unknown class stops being a number: `from(raw:)` is
/// total, and the hardware may raise a class this kernel does not model, so the
/// miss has its own name rather than an arm. Everything it DOES model is an
/// exhaustive `match` in `describe`, so a class added to the enum fails to
/// compile until it is given a name.
public func cause_tag(cause: UInt) -> String {
    let ec = (cause >> ESR_EC_SHIFT) & ESR_EC_MASK
    guard let decoded = ExceptionClass.from(raw: ec) else {
        return "unexpected-trap"
    }
    decoded.describe(cause & ESR_ISS_MASK)
}

/// Overlay the saved context. One view construction, then ordinary field names.
func frame_at(frame_addr: UInt) unsafe -> UnsafeMemory<TrapFrame, Normal> {
    UnsafeMemory<TrapFrame, Normal>(frame_addr)
}

/// Where the trapped instruction was — for a fault line.
public func fault_pc(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).elr.read()
}

/// §5.7: x0 = handle, x8 = op, args x1-x5.
public func syscall_handle(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x0.read()
}

public func syscall_op(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x8.read()
}

public func syscall_arg0(frame_addr: UInt) unsafe -> UInt {
    frame_at(frame_addr).x1.read()
}

/// Place a syscall's (status, value) pair where the caller will find it.
///
/// Nothing advances the saved PC here, and that is the interesting difference
/// from Profile A: `svc` traps with `ELR_EL1` already pointing at the following
/// instruction, so a kernel that "stepped past the syscall" would skip a real
/// one. Which is precisely why advancing is the HAL's decision and not the
/// kernel's.
public func syscall_return(frame_addr: UInt, status: UInt, value: UInt) unsafe {
    let frame = frame_at(frame_addr)
    frame.x0.write(status)
    frame.x1.write(value)
}

// =============================================================================
// Diagnostics (design 172 unit 3)
// =============================================================================
//
// The kernel-bug path formats its own report. It used to be C — a `put_str` and
// a `put_hex` beside the fault handler — which was a second copy of what
// `sos/rt/common/` already does in Saw, and which printed a fixed sixteen hex
// digits whether or not that was the word width.
//
// This is NOT the panic seam. `__saw_rt_write` below has a stricter contract
// and shares none of this: these two use `String` and the ordinary runtime,
// which is fine on a path the kernel reaches having already decided to stop.

/// Write an ASCII string to the console, byte by byte.
func report_str(msg: String) {
    for scalar in msg.chars() {
        console_byte(ascii_byte(scalar))
    }
}

/// Write a machine word as `0x` + one hex digit per nibble, at THIS target's
/// width — sixteen here, eight on Profile A.
func report_hex(v: UInt) {
    report_str("0x")
    let digits = hex_digits_per_word()
    var n = 0
    while n < digits {
        console_byte(hex_digit_of(v, n))
        n = n + 1
    }
}

// =============================================================================
// The kernel-bug path (design 172 unit 3)
// =============================================================================

/// Set once a kernel fault is being reported, so a SECOND fault taken while
/// reporting exits immediately instead of looping on the console.
///
/// Compound global state resting on a serialization argument the compiler
/// cannot see, which is design 149's `unsafe static var` rather than an
/// `Atomic`: SOS v1 is a uniprocessor kernel that enables no interrupt sources
/// (spec §7), and this flag is only ever touched with the machine already
/// failing.
unsafe static var IN_KERNEL_FAULT: UInt8 = 0u8

/// A trap the KERNEL itself took, i.e. a kernel bug. Reports the exception
/// class and stops the machine with it as the status — the arm64 spelling of
/// Profile A's "cause in the finisher's code bits". Never returns, and never
/// hangs (M0's discipline, kept).
///
/// `boot.S` reads the three system registers, because `mrs` names a register at
/// assembly time and Saw cannot spell one. Everything after that is formatting.
@export("sos_kernel_fault")
public func kernel_fault(esr: UInt, elr: UInt, far: UInt) unsafe {
    let ec = (esr >> ESR_EC_SHIFT) & ESR_EC_MASK
    if IN_KERNEL_FAULT != 0u8 {
        exit_fail(ec)
    }
    IN_KERNEL_FAULT = 1u8
    report_str("SOS: kernel fault ec=")
    report_hex(ec)
    report_str(" elr=")
    report_hex(elr)
    report_str(" far=")
    report_hex(far)
    report_str("\n")
    exit_fail(ec)
}

// =============================================================================
// The static identity map: this profile's isolation primitive
// =============================================================================
//
// Spec §5b: on Profile B an AddressSpace is a page-table root. M1b implements
// the STATIC parity of Profile A's PMP and nothing more (design 162 decision
// 2): one identity map, built once at boot, whose only mutable part is the EL0
// permission bits of the pages a root image was granted. No dynamic mapping, no
// ASIDs, no address-space switch — Mapping objects are M2.
//
// The shape:
//
//   level 1 (1 GiB entries, 39-bit VA out of the low translation base)
//     [0]  0x0000_0000  device block, EL1 RW, never executable
//     [1]  0x4000_0000  -> level 2
//     rest             INVALID, which is what makes UNMAPPED_PROBE fault
//   level 2 (2 MiB entries over RAM)
//     [0], [1]         -> level 3 tables: the GRANT WINDOW, page-granular
//     rest             2 MiB blocks, EL1 RW, no EL0
//   level 3 (4 KiB pages over the first 4 MiB of RAM)
//     reset state      EL1 read/write/EXECUTE, no EL0 access at all
//     granted pages    EL0 RO or RW, never EL0-writable-and-executable
//
// The grant window covers the kernel image AND the root region, because BOTH
// need page granularity: the root region obviously, and the kernel image
// because the harness's unit-A cases grant a payload that executes in place
// inside it. Everything outside the window is EL1-only, so EL0 default-deny is
// the same property PMP gives Profile A for free — a page EL0 was never granted
// is a translation fault, not a permitted access.
//
// The kernel's own pages stay EL1-RWX: that is the arm64 spelling of "M-mode is
// unconstrained", not a claim about kernel W^X, which neither profile has yet.
//
// DESIGN 172 UNIT 1: all of the above is arithmetic and 64-bit stores, so it is
// Saw. What stays native is the ACTIVATION — four `msr`s, a barrier pair and a
// TLB flush — because a system register is named at assembly time. `sink.c` is
// that leaf and nothing else: it asks this file for a finished table and turns
// the MMU on.

/// The three translation tables, back to back: 512 level-1 descriptors, 512
/// level-2, then 1024 level-3 covering the grant window.
///
/// ONE region with a page of slack rather than three arrays, because the
/// hardware requires each table to be page-aligned and Saw has no alignment
/// attribute on a static. Rounding the base up at run time costs three
/// instructions at boot and asks nothing of the linker script — which matters,
/// because the linker script is per-profile and the shape of this is not.
///
/// THE SLACK IS EXACTLY ENOUGH, and the arithmetic is worth writing down
/// because a future edit to `GRANT_PAGES` has to redo it. The tables need
/// 512 + 512 + 1024 = 2048 descriptors (16 KiB). A `[UInt64; N]` static is
/// 8-aligned, so rounding its address up to 4096 advances the base by at most
/// 4096 - 8 = 4088 bytes, which is 511 descriptors. 2048 + 511 = 2559, and the
/// region is 2560. Add a table and the trailing 512 has to grow with it.
///
/// All-zero, so it costs no image bytes (design 149). An unwritten descriptor
/// is INVALID, which is the state a default-deny map wants anyway.
unsafe static var PAGE_TABLES: [UInt64; 512 + 512 + 1024 + 512] = [0u64; 512 + 512 + 1024 + 512]

/// Descriptors per table at the 4 KiB granule: a table is one page of 8-byte
/// entries.
static PT_ENTRIES: UInt = 512
/// Pages the level-3 tables cover — 4 MiB reachable at page granularity.
static GRANT_PAGES: UInt = 1024
static PAGE_SIZE: UInt = 4096
static DESC_BYTES: UInt = 8
/// Byte offsets of the second and third tables within `PAGE_TABLES`.
static LEVEL2_OFFSET: UInt = 4096
static LEVEL3_OFFSET: UInt = 8192

static RAM_BASE: UInt = 0x40000000
static PAGE_SHIFT: Int = 12
static BLOCK_SHIFT: Int = 21              // a level-2 block is 2 MiB
static MAIR_INDEX_SHIFT: Int = 2          // descriptor bits 4:2

// Descriptor bits (ARMv8-A VMSA, 4 KiB granule). Each is a lone architectural
// bit position — a standalone quantity, which is what a `static` is for. The
// two descriptor fields that are genuinely a CLOSED SET of alternatives are the
// enums below, where an exhaustive `match` and a pinned value are worth having.
static DESC_VALID: UInt64 = 0x1u64
static DESC_BLOCK: UInt64 = 0x0u64        // bit 1 clear at levels 1-2
static DESC_TABLE: UInt64 = 0x2u64        // bit 1 set at levels 1-2
static DESC_PAGE: UInt64 = 0x2u64         // at level 3 the same bit means "page"
static ATTR_SH_INNER: UInt64 = 0x300u64   // bits 9:8 — inner shareable
static ATTR_AF: UInt64 = 0x400u64         // bit 10 — access flag
static ATTR_PXN: UInt64 = 0x20000000000000u64   // bit 53 — no execute at EL1
static ATTR_UXN: UInt64 = 0x40000000000000u64   // bit 54 — no execute at EL0

/// The access-permission field, descriptor bits 7:6. Exactly one of the four is
/// in a descriptor, which is what makes this an enum rather than four constants
/// that could be OR-ed together by accident.
enum AccessPerm: UInt64 {
    case El1Rw = 0,          // EL1 read/write, EL0 no access
    case El0Rw = 64,         // EL1 + EL0 read/write
    case El1Ro = 128,        // EL1 read-only, EL0 no access
    case El0Ro = 192,        // EL1 + EL0 read-only
}

/// Which memory-attribute index a descriptor selects. The case VALUE is the
/// index, and `mair_value()` below builds the register those indices describe
/// out of the same cases — so a type added here cannot leave its attribute byte
/// behind.
enum MemoryType: UInt64 {
    case Device = 0,         // Device-nGnRnE
    case Normal = 1,         // Normal, write-back, read/write-allocate
}

extension MemoryType {
    /// This type as the attribute-index bits of a descriptor.
    func attr_index(&self) -> UInt64 {
        (self as UInt64) << MAIR_INDEX_SHIFT
    }
}

static MAIR_ATTR_DEVICE: UInt = 0x00
static MAIR_ATTR_NORMAL: UInt = 0xFF
static BITS_PER_MAIR_ATTR: Int = 8

/// The memory-attribute register the `MemoryType` indices describe: one byte
/// per index, low index first.
///
/// It crosses to the C activation leaf with the table address, rather than
/// being spelled again there, because it is the OTHER HALF of the descriptor
/// encoding this file owns — a memory type added above would otherwise need a
/// matching edit in C with nothing to catch a missed one.
@export("sos_mair_value")
public func mair_value() -> UInt {
    ((MAIR_ATTR_DEVICE << (BITS_PER_MAIR_ATTR * ((MemoryType.Device as UInt64) as Int)))
     | (MAIR_ATTR_NORMAL << (BITS_PER_MAIR_ATTR * ((MemoryType.Normal as UInt64) as Int))))
}

/// This HAL's own failure code, distinct from anything the kernel or root
/// chooses. A grant the window cannot express is a kernel bug, not an image
/// problem, so it does not travel through the loader's `fatal_image`.
static ABORT_GRANT_OUTSIDE_WINDOW: UInt = 66

/// Round `v` up to the next multiple of `align` (a power of two).
///
/// The kernel core has one of these too and they are deliberately not shared:
/// a HAL that had to import the kernel to build its own page tables would be
/// the wrong way round.
func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// The page-aligned base of the three tables.
func tables_base() unsafe -> UInt {
    align_up(((&var PAGE_TABLES) as UnsafePointer<UInt64>) as UInt, PAGE_SIZE)
}

/// Write descriptor `index` of the table at `table`.
func put_desc(table: UInt, index: UInt, desc: UInt64) unsafe {
    UnsafeMemory<UInt64, Normal>(table + index * DESC_BYTES).write(desc)
}

/// A grant-window page as the KERNEL sees it: read, write and execute at EL1,
/// nothing at EL0.
func kernel_page(va: UInt) -> UInt64 {
    ((va as UInt64) | DESC_VALID | DESC_PAGE | MemoryType.Normal.attr_index()
     | ATTR_AF | ATTR_SH_INNER | (AccessPerm.El1Rw as UInt64) | ATTR_UXN)
}

/// Every page of the window back to kernel-only.
func reset_window(level3: UInt) unsafe {
    var i: UInt = 0
    while i < GRANT_PAGES {
        put_desc(level3, i, kernel_page(RAM_BASE + (i << PAGE_SHIFT)))
        i = i + 1
    }
}

/// Build the identity map and hand back the level-1 table's address, which is
/// what the low translation base register wants.
///
/// Called by `sink.c`'s activation leaf before it turns the MMU on, so this
/// runs with translation OFF and physical == virtual. It must follow the `.bss`
/// zerofill, because that is where `PAGE_TABLES` lives.
@export("sos_page_tables_build")
public func page_tables_build() unsafe -> UInt {
    let level1 = tables_base()
    let level2 = level1 + LEVEL2_OFFSET
    let level3 = level1 + LEVEL3_OFFSET

    // Level 1: the device window below RAM, a table over RAM, and nothing else
    // — every other entry stays zero, i.e. INVALID.
    put_desc(level1, 0,
             DESC_VALID | DESC_BLOCK | MemoryType.Device.attr_index() | ATTR_AF
             | (AccessPerm.El1Rw as UInt64) | ATTR_PXN | ATTR_UXN)
    put_desc(level1, 1, (level2 as UInt64) | DESC_VALID | DESC_TABLE)

    // Level 2: 2 MiB blocks over RAM, EL1 only.
    var i: UInt = 0
    while i < PT_ENTRIES {
        put_desc(level2, i,
                 ((RAM_BASE + (i << BLOCK_SHIFT)) as UInt64)
                 | DESC_VALID | DESC_BLOCK | MemoryType.Normal.attr_index()
                 | ATTR_AF | ATTR_SH_INNER | (AccessPerm.El1Rw as UInt64) | ATTR_UXN)
        i = i + 1
    }

    // ...except the first few, which point at the level-3 tables instead: the
    // grant window, where permissions are editable a page at a time.
    var t: UInt = 0
    while t < GRANT_PAGES / PT_ENTRIES {
        put_desc(level2, t,
                 ((level3 + t * PT_ENTRIES * DESC_BYTES) as UInt64)
                 | DESC_VALID | DESC_TABLE)
        t = t + 1
    }

    reset_window(level3)
    level1
}

/// A grant the window cannot express. Never returns.
///
/// Skipping the page would be safe in the deny direction — EL0 simply would not
/// reach it — but it would mean the kernel silently granted LESS than it was
/// asked for, and the symptom would be a user-mode fault at some unrelated
/// later address. The only way to get here is a memory map that outgrew the
/// window, which is a kernel bug and reads as one.
func grant_outside_window(va: UInt) {
    report_str("SOS: grant outside the page-granular window: ")
    report_hex(va)
    report_str("\n")
    exit_fail(ABORT_GRANT_OUTSIDE_WINDOW)
}

/// Revoke every grant. User mode then reaches nothing at all — the default-deny
/// the grants below carve out of.
public func prot_reset() unsafe {
    reset_window(tables_base() + LEVEL3_OFFSET)
}

/// Stage grant `idx` as [base, top) with `perms`, a mask in the `SegFlag`
/// vocabulary.
///
/// `idx` is unused here: PMP has a fixed number of NUMBERED regions and this
/// profile has pages, so the index is a Profile-A budget concept the seam
/// carries for both.
///
/// A grant installs exactly the permissions the image asked for — the same
/// contract Profile A's PMP has, so the two profiles cannot disagree about what
/// an image means. (W^X is the linker script's property and the loader's
/// `has_sane_perms` validation; silently dropping a bit the image asked for
/// would be the kind of quiet no-op that hides a bad image rather than refusing
/// it.) `PXN` is the one thing added unconditionally: the kernel must not
/// execute user memory even by accident, which is a guarantee Profile A's
/// unconstrained M-mode cannot make.
public func prot_region(idx: UInt, base: UInt, top: UInt, perms: UInt8) unsafe {
    let level3 = tables_base() + LEVEL3_OFFSET
    var attrs = (DESC_VALID | DESC_PAGE | MemoryType.Normal.attr_index() | ATTR_AF
                 | ATTR_SH_INNER | ATTR_PXN)
    if (perms & (SegFlag.Write as UInt8)) != 0u8 {
        attrs = attrs | (AccessPerm.El0Rw as UInt64)
    } else {
        attrs = attrs | (AccessPerm.El0Ro as UInt64)
    }
    if (perms & (SegFlag.Execute as UInt8)) == 0u8 {
        attrs = attrs | ATTR_UXN
    }
    // The bound is tested BEFORE the subtraction that would compute the page
    // index: `va - RAM_BASE` underflows below the base, and overflow checks are
    // always on, so the order is what turns a bad map into a diagnostic rather
    // than into a panic from inside the protection primitive.
    var va = base - (base & (PAGE_SIZE - 1))
    while va < top {
        if va < RAM_BASE {
            grant_outside_window(va)
        }
        let page = (va - RAM_BASE) >> PAGE_SHIFT
        if page >= GRANT_PAGES {
            grant_outside_window(va)
        }
        put_desc(level3, page, (va as UInt64) | attrs)
        va = va + PAGE_SIZE
    }
}
