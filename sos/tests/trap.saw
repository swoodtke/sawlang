// SOS M0 trap test (design 112): a CPU fault must FAIL the run, never hang it.
//
// Reading an unmapped low address raises a load access fault; QEMU vectors to
// the boot shim's `trap_entry`, which writes the SiFive finisher with
// FINISHER_FAIL + mcause, exiting the emulator with a non-zero status. The
// harness asserts that non-zero exit (and that no banner was printed).

struct Word { v: UInt32 }

@export("kmain")
unsafe func kmain() {
    let bad = UnsafeMemory<Word, Device>(0x00000000)
    let x = bad.v.read()
    // Consume the load so it cannot be optimized away before the fault.
    let sink = UnsafeMemory<Word, Device>(0x10000000)
    sink.v.write(x)
    while true { }
}
