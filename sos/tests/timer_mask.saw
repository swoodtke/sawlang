// SOS M2 unit 1: the kernel is non-preemptible (design 178 D2).
//
// The claim under test is that a tick which comes due while the KERNEL is
// running is not taken there — it waits for the return to user mode. The
// transcript is the proof, in three lines and in this order:
//
//   kernel section begin
//   kernel section end, timer expired, ticks taken=0    <- due, and NOT taken
//   entering U-mode
//   timer tick 1 at <a user-mode address>               <- taken, once out
//
// The kernel section is a deliberate long one: it spins until the timer's own
// expiry condition holds, so the interrupt is genuinely due before the section
// ends. That it was not taken is read from the kernel's tick COUNTER, not from
// the absence of a log line — the count is what the tick path increments before
// it prints anything, so zero there means no tick ran.
//
// A syscall is the same section with a different name. Both machines mask
// interrupts on trap entry in hardware and restore the user state on the way
// back, so the masking a syscall gets is the masking this file demonstrates;
// what differs is only that a boot-time section can be made long on purpose.

import kcore.{console, align_up, timer_ticks, start_process, start_tick}
import hal
import imgformat.{SegFlag}
import sosabi.{NO_USER_STACK}

static PAYLOAD_REGION: UInt = 0
static TICK_PERIOD_US: UInt = 1000

@export("kmain")
func kmain() {
    let uart = console()
    uart.write_str("SOS M2: masking check on ")
    uart.write_str(hal.arch_name())
    uart.write_str("\n")

    hal.intc_init()
    start_tick(TICK_PERIOD_US)

    // Stay in kernel mode until the tick is due. Nothing here masks anything:
    // the kernel simply runs with interrupts off, which is D2.
    uart.write_str("SOS M2: kernel section begin\n")
    while not hal.timer_pending() {
    }
    uart.write_str("SOS M2: kernel section end, timer expired, ticks taken=")
    uart.write_hex(timer_ticks())
    uart.write_str("\n")

    let base = hal.payload_start()
    let top = align_up(hal.payload_end(), hal.PROT_GRAIN)

    hal.prot_reset()
    hal.prot_region(PAYLOAD_REGION, base, top,
                    (SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8))
    hal.prot_commit()

    uart.write_str("SOS M2: entering U-mode\n")
    start_process(base, NO_USER_STACK, base, top)
}
