// SOS M1 user-mode trap test (design 140 unit A) — the privilege split alone.
//
// Grants ONE region — the appended payload's own bytes, read+execute — and
// enters user mode at its first instruction. Everything else, the kernel image
// and every device included, is denied by the target's default-deny. The
// payload is linked in from one of `sos/tests/<arch>/payload_*.S`, so this
// single kernel covers the happy path, an illegal access, and a bad syscall.
//
// No loader, no image format: this test isolates trap entry, the privilege
// transition, memory protection and syscall dispatch from the sosimg machinery
// that unit B layers on top. It names no architecture — the payload it runs
// does, and that is the only per-arch half of the case.

import kcore.{console, align_up}
import hal
import imgformat.{SegFlag}
import sosabi.{NO_USER_STACK, ROOT_SYSTEM_HANDLE}

// The payload never touches memory, so it needs no stack region — one grant is
// the whole address space it is allowed to see.
static PAYLOAD_REGION: UInt = 0

@export("kmain")
func kmain() {
    console().write_str("SOS M1: entering U-mode\n")

    let base = hal.payload_start()
    let top = align_up(hal.payload_end(), hal.PROT_GRAIN)

    hal.prot_reset()
    hal.prot_region(PAYLOAD_REGION, base, top,
                    (SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8))
    hal.prot_commit()

    hal.enter_user(base, NO_USER_STACK, ROOT_SYSTEM_HANDLE)
}
