// SOS M2 unit 3: a thread PARKS on a Waiter and another thread's signal wakes
// it (design 178 D5; spec §2.2, §2.4).
//
// The transcript is read as an ORDER, and the order is the whole claim:
//
//   SOS wake: worker started, parking     <- the initial thread, before wait()
//   SOS wake: worker signalling           <- the OTHER thread, which could only
//                                            have run because the first parked
//   SOS wake: woke key=77 signalled=1 word=5
//   SOS wake: joined worker=99
//
// A `wait` that answered without parking would put the middle line last, since
// nothing else can move the processor: this image's kernel arms NO timer, and
// `start` only makes a thread runnable — it does not switch. So the second line
// arriving in the middle means the first thread really did block, and the third
// means the signal really did carry the key and the readiness back into its
// frame.
//
// EVERY THREAD ENTERS AT `_start` and works out which it is from the parked
// boot handle, for the reason `thread-basics` gives (DF-178c: Saw cannot name a
// function's address, so `create_thread` has no entry to be handed).
//
// HOW TWO THREADS SHARE A KERNEL OBJECT, since this is the first program that
// needs to. NOT by passing a handle word — the `sos` module offers no way to
// take one out of a typed handle, which is the ruled guarantee. By sharing the
// VALUE: an `Event` is a small plain struct, so it parks in this process's own
// memory exactly as the boot handle does, and a thread that reads it back holds
// the same object. The kernel is not involved, because the handle TABLE is the
// process's and both threads were already inside it.

import sos.{System, Process, Thread, Event, EventMode, Waiter}

/// The boot handle, parked for the worker — and the witness that says which
/// thread `_start` is running as (handle 0 names nothing, so a parked one is
/// never 0).
unsafe static var BOOT_HANDLE: UInt = 0

/// The Event both threads use. Zero-initialized, which for a handle-carrying
/// struct means "names nothing" — the same reservation that makes handle 0
/// unforgeable makes this slot safe to read before it is written.
unsafe static var SHARED_EVENT: Event

static STACK_WORDS: Int = 1024
unsafe static var STACK_W: [UInt64; STACK_WORDS] = [0u64; STACK_WORDS]

static BYTES_PER_WORD: UInt = 8
static STACK_ALIGN: UInt = 16

/// The key the initial thread attaches under, and expects back.
static ATTACH_KEY: UInt = 77

/// What the worker signals: a count, because the shared event is a counting one
/// and five is a number no bit pattern in this file could produce by accident.
static SIGNAL_TIMES: Int = 5
static ONE: UInt = 1

static WORKER_ROLE: UInt = 1
static WORKER_EXIT: UInt = 99

static YES: UInt = 1
static NO: UInt = 0
static NO_VALUE: UInt = 0xDEAD

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

func stack_top(base: UInt) -> UInt {
    let top = base + (STACK_WORDS as UInt) * BYTES_PER_WORD
    top - (top % STACK_ALIGN)
}

func worker_stack_top() unsafe -> UInt {
    stack_top(((&var STACK_W) as UnsafePointer<UInt64>) as UInt)
}

func park_boot_handle(word: UInt) unsafe {
    BOOT_HANDLE = word
}

func parked_boot_handle() unsafe -> UInt {
    BOOT_HANDLE
}

func park_event(e: Event) unsafe {
    SHARED_EVENT = e
}

func shared_event() unsafe -> Event {
    SHARED_EVENT
}

/// The worker: say so, signal, leave.
///
/// It derives its own authority off the parked boot handle rather than being
/// handed any — `System(boot_handle:)` -> `self_process()` -> `self_thread()` —
/// and reaches the Event out of the process's own memory.
func worker() {
    let system = System(boot_handle: parked_boot_handle())
    let proc = match system.self_process() {
        case Ok(p) -> p,
        case Err(_) -> { return },
    }
    let me = match proc.self_thread() {
        case Ok(t) -> t,
        case Err(_) -> { return },
    }

    let _ = system.debug_print("SOS wake: worker signalling\n")

    let event = shared_event()
    var n = 0
    while n < SIGNAL_TIMES {
        // §2.4: signalling NEVER blocks, whether or not anyone is parked. The
        // first of these is the one that wakes the sleeper; the rest simply
        // accumulate, which is what makes the drained word five and not one.
        let _ = event.signal(ONE)
        n = n + 1
    }

    let _ = me.exit(WORKER_EXIT)
}

/// The initial thread: build the wait set, start the worker, park.
func initial(boot_handle: UInt) {
    park_boot_handle(boot_handle)

    let system = System(boot_handle: boot_handle)
    let proc = match system.self_process() {
        case Ok(p) -> p,
        case Err(_) -> {
            let _ = system.debug_print("SOS wake: no process handle\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    let waiter = match proc.create_waiter() {
        case Ok(w) -> w,
        case Err(e) -> {
            print("SOS wake: no waiter: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let event = match proc.create_event(mode: EventMode.SaturatingSum) {
        case Ok(ev) -> ev,
        case Err(e) -> {
            print("SOS wake: no event: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let _ = waiter.add(&event, ATTACH_KEY)
    park_event(event)

    let w = match proc.create_thread(stack_top: worker_stack_top(),
                                     arg: WORKER_ROLE) {
        case Ok(t) -> t,
        case Err(e) -> {
            print("SOS wake: create failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let _ = w.start()

    // `start` makes the worker RUNNABLE; it does not switch to it. So this line
    // is printed by a thread that still holds the processor, and the worker
    // cannot say anything until this thread gives it up — which the wait below
    // is the only thing here that does.
    let _ = system.debug_print("SOS wake: worker started, parking\n")

    let report = match waiter.wait() {
        case Ok(r) -> r,
        case Err(e) -> {
            print("SOS wake: wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let word: UInt = match event.receive() {
        case Ok(v) -> v,
        case Err(_) -> NO_VALUE,
    }
    print("SOS wake: woke key={} signalled={} word={}\n",
          report.key, flag(report.is_signalled()), word)

    // The worker exited on its way out of `signal`, so this join answers out of
    // its slot rather than parking again.
    let code: UInt = match w.join() {
        case Ok(v) -> v,
        case Err(_) -> NO_VALUE,
    }
    print("SOS wake: joined worker={}\n", code)

    let _ = proc.exit(EXIT_OK)
}

@export("_start")
func _start(arg: UInt) {
    if parked_boot_handle() == 0 {
        initial(arg)
    } else {
        worker()
    }
}
