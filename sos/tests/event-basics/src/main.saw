// SOS M2 unit 3: Events and a Waiter, in ONE thread (design 178 D5; spec §2.2,
// §2.4).
//
// Nothing here parks, and that is the point of splitting it from `event-wake`:
// every claim below is about what an Event ACCUMULATES and what a Waiter
// REPORTS, with the scheduler held out of it. The transcript is six lines and
// each is a separate ratified sentence:
//
//   signal-then-wait key=11 at-wait=4 drained=4  <- §2.2 level-triggered: the
//                                                   signal came FIRST and was
//                                                   still there
//   second key=22 at-wait=8 drained=8            <- §2.2 the key identifies
//                                                   WHICH of two attachments
//   or key=11 at-wait=3 drained=3                <- §2.4 bitwise-OR: 1|2|1
//   detached word=8                              <- §2.2 remove: still an
//                                                   Event, no longer watched
//   counting key=33 at-wait=5 drained=5 saturated=1
//                                                <- §2.4 saturating-sum, and
//                                                   that it SATURATES
//   done
//
// `at-wait` is read out of the RECORD the kernel copied into this process's
// memory and `drained` out of a following `receive`; they agree everywhere,
// which is what says the record's payload is the real accumulated word rather
// than a flag.
//
// EVERY WAIT RETURNS IMMEDIATELY. A wait that found nothing would park the only
// thread in the system, which the kernel reports as the deadlock it is — so a
// regression in the level-triggered path fails this case in a few microseconds
// rather than at the harness timeout.

// `EventMode` is imported like any other name this module publishes: it is a
// value a PROCESS chooses and passes as a syscall argument, which is what makes
// it API rather than kernel bookkeeping. There is one declaration of it in the
// system and this is not it — see the `sos` module docstring.
import sos.{System, Process, Event, EventMode, Waiter, WaitResult, WaitPayload}

/// The keys this process attaches under. They are ITS OWN WORDS — §2.2 has the
/// kernel store one and hand it back unread, so what a key means is entirely a
/// question for whoever attached it. Here they are just distinguishable.
static KEY_A: UInt = 11
static KEY_B: UInt = 22
static KEY_C: UInt = 33

static BIT_ONE: UInt = 1
static BIT_TWO: UInt = 2
static BIT_FOUR: UInt = 4
static BIT_EIGHT: UInt = 8

/// How many times the counting event is signalled before it is read.
static COUNT_TIMES: Int = 5

/// A `UInt` 1 and 0, so a `Bool` can be printed without a literal having to
/// adopt a type through a branch (DF-178e's neighbourhood).
static YES: UInt = 1
static NO: UInt = 0

/// What a failed read reports, distinct from every value the case expects.
static NO_VALUE: UInt = 0xDEAD

static EXIT_OK: UInt = 0
static EXIT_FAILED: UInt = 1

func flag(b: Bool) -> UInt {
    if b { YES } else { NO }
}

/// Drain an event, or report the sentinel. A failure cannot happen here — this
/// process created the event and holds every right on it — so the arm exists to
/// make that visible in the transcript rather than to be taken.
func drained(e: &Event) -> UInt {
    match e.receive() {
        case Ok(word) -> word,
        case Err(_) -> NO_VALUE,
    }
}

/// The accumulated word a WAIT reported, out of the record the kernel copied
/// out. A `match` rather than a field access because the payload is per-kind by
/// construction (§2.2), and the Interrupt object made that a real choice: this
/// program attaches nothing but Events, so any other answer is a kernel that
/// reported an attachment this process never made.
///
/// It is a SNAPSHOT taken when the wait returned, so it still reads what fired
/// after the event has been drained — which is what the transcript compares.
func at_wait(r: &WaitResult) -> UInt {
    match r.what {
        case Event(word) -> word,
        case Interrupt(_) -> panic("this program attached no interrupt"),
        case Timer(_) -> panic("this program attached no timer"),
    }
}

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    let proc = match system.self_process() {
        case Ok(p) -> p,
        case Err(_) -> {
            let _ = system.debug_print("SOS events: no process handle\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    let waiter = match proc.create_waiter() {
        case Ok(w) -> w,
        case Err(e) -> {
            print("SOS events: no waiter: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let a = match proc.create_event() {
        case Ok(ev) -> ev,
        case Err(e) -> {
            print("SOS events: no event a: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    // `a` above took the DEFAULT mode and this one names it. The two events
    // behave identically below, which is the default parameter being checked
    // rather than assumed.
    let b = match proc.create_event(mode: EventMode.Or) {
        case Ok(ev) -> ev,
        case Err(e) -> {
            print("SOS events: no event b: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }

    let _ = waiter.add(&a, KEY_A)
    let _ = waiter.add(&b, KEY_B)

    // ---- §2.2 LEVEL-TRIGGERED: signal first, wait afterwards --------------
    // The order is the claim. An edge-triggered waiter would have nothing to
    // report here, because the only edge happened before anyone was listening.
    let _ = a.signal(BIT_FOUR)
    let first = match waiter.wait() {
        case Ok(r) -> r,
        case Err(e) -> {
            print("SOS events: first wait failed: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    // The two numbers are the same fact observed twice: what the WAIT reported
    // out of the copied-out record, and what the DRAIN took out of the event.
    // They agree because the record carries the accumulated word, which is what
    // makes the common case one syscall instead of two.
    let first_word = drained(&a)
    print("SOS events: signal-then-wait key={} at-wait={} drained={}\n",
          first.key, at_wait(&first), first_word)

    // ---- §2.2 WHICH one became ready ---------------------------------------
    // Two handles on one Waiter and the other one signalled: the answer has to
    // name the second attachment, and the key is how it names it.
    let _ = b.signal(BIT_EIGHT)
    let second = match waiter.wait() {
        case Ok(r) -> r,
        case Err(_) -> {
            let _ = system.debug_print("SOS events: second wait failed\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let second_word = drained(&b)
    print("SOS events: second key={} at-wait={} drained={}\n",
          second.key, at_wait(&second), second_word)

    // ---- §2.4 BITWISE-OR accumulation --------------------------------------
    // Three signals, one repeated: a flag set answers 3, not 4.
    let _ = a.signal(BIT_ONE)
    let _ = a.signal(BIT_TWO)
    let _ = a.signal(BIT_ONE)
    let third = match waiter.wait() {
        case Ok(r) -> r,
        case Err(_) -> {
            let _ = system.debug_print("SOS events: third wait failed\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let or_word = drained(&a)
    print("SOS events: or key={} at-wait={} drained={}\n",
          third.key, at_wait(&third), or_word)

    // ---- §2.2 REMOVE: the attachment goes, the object stays ----------------
    // A detached Event still accumulates and still drains; it is simply not
    // watched. Nothing waits after this, because nothing would find it.
    //
    // IT NAMES THE ATTACHMENT BY KEY, never by the waitable — detaching edits
    // the Waiter's own table, so `b` is not mentioned here at all.
    let _ = waiter.remove(KEY_B)
    let _ = b.signal(BIT_EIGHT)
    print("SOS events: detached word={}\n", drained(&b))

    // ---- §2.4 SATURATING-SUM ----------------------------------------------
    // Signalled five times BEFORE it is attached, which exercises the other
    // half of level-triggering: an attachment that is already ready is ready.
    let c = match proc.create_event(mode: EventMode.SaturatingSum) {
        case Ok(ev) -> ev,
        case Err(e) -> {
            print("SOS events: no counting event: {}\n", e)
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    var n = 0
    while n < COUNT_TIMES {
        let _ = c.signal(BIT_ONE)
        n = n + 1
    }
    let _ = waiter.add(&c, KEY_C)
    let fourth = match waiter.wait() {
        case Ok(r) -> r,
        case Err(_) -> {
            let _ = system.debug_print("SOS events: fourth wait failed\n")
            let _ = system.shutdown(EXIT_FAILED)
            return
        },
    }
    let counted = drained(&c)

    // And that it SATURATES rather than wrapping: two signals of the largest
    // word there is would wrap a plain sum straight back through zero, which is
    // the value that means "not ready".
    let _ = c.signal(UInt.max)
    let _ = c.signal(UInt.max)
    let saturated = drained(&c)
    print("SOS events: counting key={} at-wait={} drained={} saturated={}\n",
          fourth.key, at_wait(&fourth), counted, flag(saturated == UInt.max))

    let _ = system.debug_print("SOS events: done\n")

    // Process exit, so the kernel's teardown line reports what this process
    // owned: seven handles — the three it was given (System, Process, its own
    // Thread) and the four it made — one thread, three events and one waiter.
    let _ = proc.exit(EXIT_OK)
}
