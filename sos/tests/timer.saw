// SOS M2 unit 1: the periodic timer tick, taken from USER mode (design 178).
//
// Arms a periodic tick, grants the appended payload its own bytes and nothing
// else, and enters user mode at its first instruction. The payload spins in a
// register loop — it touches no memory, so one grant is the whole address space
// it can see — long enough for several ticks, then shuts the machine down.
//
// WHAT THE TRANSCRIPT PROVES. Every tick line is written by the ARCH-FREE hook
// in `sos/kernel/core/`, from inside the trap handler, after the kernel has
// stopped running: the last thing this file does is enter user mode and never
// return, so a tick that lands at all was taken from there. The address on each
// line is where user mode was interrupted, and the count comes from the kernel's
// own tick counter rather than from the log.
//
// It names no architecture: the timer, the interrupt controller, the privilege
// transition and the protection hardware are all `hal`'s, which is design 178's
// D6 — and the payload it runs is the only per-arch half of the case.

import kcore.{console, align_up}
import hal
import imgformat.{SegFlag}
import sosabi.{NO_USER_STACK, ROOT_SYSTEM_HANDLE}

/// The payload never touches memory, so it needs no stack region — one grant is
/// the whole address space it is allowed to see.
static PAYLOAD_REGION: UInt = 0

/// A millisecond. Short enough that the payload's spin covers several ticks on
/// any machine this runs on, long enough that the ticks are not the workload.
static TICK_PERIOD_US: UInt = 1000

@export("kmain")
func kmain() {
    let uart = console()
    uart.write_str("SOS M2: timer bring-up on ")
    uart.write_str(hal.arch_name())
    uart.write_str("\n")

    hal.intc_init()
    hal.timer_start(TICK_PERIOD_US)
    uart.write_str("SOS M2: timer armed\n")

    let base = hal.payload_start()
    let top = align_up(hal.payload_end(), hal.PROT_GRAIN)

    hal.prot_reset()
    hal.prot_region(PAYLOAD_REGION, base, top,
                    (SegFlag.Read as UInt8) | (SegFlag.Execute as UInt8))
    hal.prot_commit()

    uart.write_str("SOS M2: entering U-mode\n")
    hal.enter_user(base, NO_USER_STACK, ROOT_SYSTEM_HANDLE)
}
