// SOS kernel entry (designs 112, 140) — Profile A: riscv32, QEMU `virt`.
//
// `boot.S` sets up the stack, zeroes .bss, and calls `kmain`; `rt.c` supplies
// the runtime seams and the PMP/CSR helpers; `core/lib.saw` is the shared
// kernel (drivers, trap frame, `ktrap`, syscall table, sosimg loader);
// `virt.ld` links it all at RAM base 0x8000_0000. See sos/spec.md §5b and §12.
//
// The kernel's whole job at boot is to hand control to the root server: load
// the one appended image, grant it its regions, drop to U-mode. A kernel with
// no root image has nothing to run and says so — it does not exit quietly.

import kcore.{console, load_root_and_enter}

@export("kmain")
func kmain() {
    console().write_str("SOS M1: kernel up on riscv32 (QEMU virt)\n")
    load_root_and_enter()
}
