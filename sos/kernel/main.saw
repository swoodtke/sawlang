// SOS kernel entry (designs 112, 140) — Profile A: riscv32, QEMU `virt`.
//
// `boot.S` sets up the stack, zeroes .bss, and calls `kmain`; `rt.c` supplies
// the runtime seams and the PMP/CSR helpers; `core/lib.saw` is the shared
// kernel (drivers, trap frame, `ktrap`, syscall table); `virt.ld` links it all
// at RAM base 0x8000_0000. See sos/spec.md §5b and §12.

import kcore.{console, finisher}

@export("kmain")
func kmain() {
    console().write_str("SOS M0: hello from Saw on riscv32 (QEMU virt)\n")
    finisher().exit_pass()
}
