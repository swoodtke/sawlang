//! ADDRESSES AND BYTES — the arithmetic and the two byte moves everything
//! else in the kernel is written on top of.
//!
//! It names no kernel state and calls nothing, which is what puts it at the
//! bottom of the module order: the copy doors (`process`), the frame arena
//! (`threads`) and the sosimg loader all reach for these four, and none of them
//! can be reached back into.

// =============================================================================
// Arithmetic the loader needs
// =============================================================================

/// Round `v` up to the next multiple of `align` (a power of two).
public func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

/// Word alignment, from the machine rather than from a constant. A function
/// because `sizeof` does not fold in a static initializer — DF-178f, the same
/// gap `sosabi`'s `wait_record_bytes` works around, and it folds fine here.
public(package) func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

public(package) func copy_bytes(dst: UInt, src: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(UnsafeMemory<UInt8, Normal>(src + i).read())
        i = i + 1
    }
}

public(package) func zero_bytes(dst: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(0)
        i = i + 1
    }
}
