//! SOS kernel core (designs 112, 140, 162) — the arch-free kernel.
//!
//! Everything a SOS kernel image shares: the console, the trap handler `ktrap`,
//! the object-op dispatch, and the sosimg loader. An image is one per-arch
//! kernel HAL (`sos/hal/<arch>/kernel/`) + the shared runtime seams
//! (`sosrt`, sos/rt/common/src/lib.saw) + this module + one entry `.saw` defining
//! `kmain` — `sos/kernel/main.saw` for the real kernel, `sos/tests/*.saw` for
//! the harness cases. Sharing the module is what keeps every test image on the
//! SAME trap path instead of a copy of it.
//!
//! NO ARCHITECTURE APPEARS IN THIS FILE (design 162 unit 1). Registers, trap
//! causes, protection hardware, the board's console and the way the machine
//! stops are all reached through `hal`, and the harness enforces it: a scan
//! rejects an arch name anywhere in this directory, so the seam cannot erode by
//! one convenient constant at a time. Adding an architecture is writing a HAL.
//!
//! Addresses and machine words are `UInt` throughout, never `Int` — `Int` is
//! platform-width and SIGNED, so a RAM address lands in its negative half on a
//! 32-bit profile and means a different number on a 64-bit one (DF-140a).

// The per-arch kernel HAL. One import, one module name, two implementations
// selected at build time by `--module-path hal=sos/hal/<arch>/kernel`.
import hal

// The image layout itself lives in the shared `imgformat` package, so the
// loader below and the Blade target that writes the images read one definition.
import imgformat.{SosimgHeader, SosimgSeg, SegFlag, fits_target_word}

// Arch-free, role-free formatting, shared with every SOS process build.
import sosrt.{ascii_byte, hex_digit_of, hex_digits_per_word}

// The call numbers. Kernel-internal and shared with the `sos` module the kernel
// exports (sos/kernel/sysapi/) — one definition, two halves of one contract.
import sosabi.{
    ObjType, SystemHandle, ProcessHandle, ThreadHandle, EventHandle, WaiterHandle,
    InterruptHandle, ClockHandle, TimerHandle,
    SystemRight, ProcessRight, ThreadRight, EventRight, WaiterRight,
    InterruptRight, ClockRight, TimerRight,
    SystemOp, ProcessOp, ThreadOp, EventOp, WaiterOp, InterruptOp, ClockOp,
    TimerOp,
    EventMode, ClockType, WaitTag, WAIT_RECORD_WORDS, wait_record_bytes,
    CLOCK_NOW_RECORD_DOUBLEWORDS, clock_now_record_bytes,
    TIMER_ARM_RECORD_DOUBLEWORDS, timer_arm_record_bytes,
    SosStatus, FaultReason, ProcessStatusKind, process_status_word,
    root_system_rights, root_process_rights, thread_rights,
    event_rights, waiter_rights, interrupt_rights, clock_rights, timer_rights,
    ROOT_SYSTEM_HANDLE, NO_HANDLE, ENTRY_IMAGE,
}

// =============================================================================
// The console
// =============================================================================

/// The kernel's console: the arch-free half of writing a diagnostic.
///
/// It formats — a string one scalar at a time, a machine word as fixed-width
/// hex — and hands each byte to the HAL, which knows what device it is. The
/// split is deliberate: `write_hex` is the same code on every target, and the
/// only thing that ever differs is where the byte lands.
///
/// # THE UART HANDOVER PROTOCOL (ruled Aug 16, user — design 178's finale)
///
/// Both machines have ONE console UART and both the kernel and a driver process
/// can drive it. Unstated, that is a flaky-test mystery: two writers on one
/// device interleave mid-word and nothing in either is wrong.
///
/// So the ownership is stated, and it has three phases:
///
///   1. **Boot.** The kernel owns the device outright. It narrates the banner,
///      the image, and anything that goes wrong.
///   2. **Handover.** `start_process` writes ONE marker line — `SOS: console
///      handover` — as the last thing the kernel says on its own initiative.
///      After it, THE PROCESS OWNS THE DEVICE.
///   3. **Reclaim, on diagnostics only.** The kernel writes again exactly where
///      the run has already failed or ended: a fault report, a process
///      teardown, a panic, or an interrupt on a line nothing is bound to. The
///      interleaving those may cause is acceptable because there is no longer a
///      transcript to protect.
///
/// WHAT THE KERNEL STILL WRITES ON DEMAND is not a violation of this: a
/// `SystemOp.DebugPrint` is the PROCESS asking the kernel to place a byte, and
/// the process is the one sequencing it. What the protocol forbids is the
/// kernel narrating over a process that is using the device.
///
/// A KERNEL THAT ARMS A TIMER is the one exception worth knowing, and it is
/// bounded: `TICK_REPORT_LIMIT` ticks are narrated after handover before the
/// tick path goes quiet. That is why the preemption case does not assert its
/// root's banner, and why a case whose transcript matters after handover arms
/// no timer.
///
/// The DEVICE half of this — which registers, and what a second writer does to
/// them — is stated in each HAL's console section.
public struct Console {
    /// A console is a capability to write, not a device handle: the HAL owns
    /// the device. The field exists because a zero-field struct has no reason
    /// to exist either — it records which sink the writes go to, and today
    /// there is one.
    sink: UInt8,
}

public extension Console {
    /// Write one byte.
    public func write_byte(&self, b: UInt8) {
        hal.console_byte(b)
    }

    /// Write an ASCII string, byte by byte. The scalar-to-byte rule is
    /// `sosrt`'s, so the kernel console and a process console agree on what a
    /// non-ASCII scalar becomes.
    public func write_str(&self, msg: String) {
        for scalar in msg.chars() {
            hal.console_byte(ascii_byte(scalar))
        }
    }

    /// Write a machine word as `0x` + one hex digit per nibble. No allocation,
    /// no formatting machinery — the kernel has neither an allocator worth
    /// spending nor a reason to build a string.
    ///
    /// The WIDTH is the target's word, not a constant: eight digits on a
    /// 32-bit profile and sixteen on a 64-bit one. A fixed eight would print
    /// the low half of a 64-bit address and look like a complete answer.
    public func write_hex(&self, v: UInt) {
        self.write_str("0x")
        let digits = hex_digits_per_word()
        var n = 0
        while n < digits {
            hal.console_byte(hex_digit_of(v, n))
            n = n + 1
        }
    }
}

/// A console for this board. Constructing one costs nothing; a true `static`
/// singleton waits on Once/Lazy (tracker F5).
public func console() -> Console {
    Console(sink: 0)
}

// =============================================================================
// Objects, handles, rights (spec §2, §3, §5.7)
// =============================================================================
//
// EVERY syscall is an object op (ratified Aug 5). There are no bare numbered
// syscalls: a call names a HANDLE and an OP — a method id on that object's
// table, not a global number — with arguments beside them, and returns a status
// and a value. WHICH REGISTERS those are is the HAL's business (spec §5.7 gives
// the per-arch table); dispatch is §3's shape verbatim: handle-table lookup ->
// object type -> op table -> rights check -> op.
//
// M2 makes the table FIVE kinds wide: the System singleton the milestone before
// it had, plus Process and Thread (D4) and then Event and Waiter (D5). The
// SHAPE did not have to change to take any of them, which was the claim M1 made
// about it — the fifth kind cost one `struct`, one `allows`, and one arm in the
// dispatch below.
//
// The NUMBERS are not here. They are `sosabi`, imported at the top of this
// file, and the `sos` module the kernel exports to userspace imports the same
// ones — so the dispatch below and the wrappers a process calls cannot skew.
// A syscall-number skew would not be a compile error anywhere; it would be a
// working call that did the wrong thing.

/// One handle-table entry: the object a handle names, the rights its holder has
/// on it (§3), and WHICH object of that kind it is. The kernel validates all
/// three on every op.
///
/// `obj_type` is the typed tag; `rights` stays a plain `UInt32` because it is a
/// MASK — a set of bits, not one of the cases of any kind's rights enum. It is
/// deliberately NOT interpretable on its own: which enum's bits these are is
/// decided by `obj_type`, and the pairing happens below.
///
/// `target` is the object's slot in its kind's table. It was not needed while
/// the only object was a singleton; with Threads it is the whole point of the
/// entry, because "which thread" is exactly what a handle answers.
struct HandleEntry {
    obj_type: ObjType,
    rights: UInt32,
    target: Int,
}

/// A System handle the dispatch has VALIDATED (§3).
///
/// This type is the pairing of a handle kind with its rights word, and it is
/// what makes the rights check typed rather than cosmetic. The only way to get
/// one is through `dispatch`, after the table resolved the handle to a System
/// object — so the type carries the claim "validated as System", and
/// `allows` can accept a `SystemRight` and nothing else. `ProcessObject` and
/// `ThreadObject` below are the same construction with their own rights enums,
/// so testing one kind's right against another's object is a compile error, not
/// a bit comparison that quietly returns an answer.
struct SystemObject {
    handle: SystemHandle,
    rights: UInt32,
}

extension SystemObject {
    /// Whether this holder may perform an op requiring `right`.
    ///
    /// The mask arithmetic lives here rather than at each call site, so the
    /// dispatch below reads as the question it is asking and there is one place
    /// to change when rights become a wider word.
    func allows(&self, right: SystemRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Process handle the dispatch has VALIDATED, paired with its rights and the
/// process slot it names.
struct ProcessObject {
    handle: ProcessHandle,
    rights: UInt32,
    slot: Int,
}

extension ProcessObject {
    func allows(&self, right: ProcessRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Thread handle the dispatch has VALIDATED, paired with its rights and the
/// thread slot it names.
struct ThreadObject {
    handle: ThreadHandle,
    rights: UInt32,
    slot: Int,
}

extension ThreadObject {
    func allows(&self, right: ThreadRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// An Event handle the dispatch has VALIDATED, paired with its rights and the
/// event slot it names (spec §2.4).
struct EventObject {
    handle: EventHandle,
    rights: UInt32,
    slot: Int,
}

extension EventObject {
    func allows(&self, right: EventRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Waiter handle the dispatch has VALIDATED, paired with its rights and the
/// waiter slot it names (spec §2.2).
struct WaiterObject {
    handle: WaiterHandle,
    rights: UInt32,
    slot: Int,
}

extension WaiterObject {
    func allows(&self, right: WaiterRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// An Interrupt handle the dispatch has VALIDATED, paired with its rights and
/// the interrupt slot it names (spec §2 table, §9).
struct InterruptObject {
    handle: InterruptHandle,
    rights: UInt32,
    slot: Int,
}

extension InterruptObject {
    func allows(&self, right: InterruptRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Clock handle the dispatch has VALIDATED, paired with its rights and the
/// clock slot it names (spec §2 table; design 232 unit 1).
struct ClockObject {
    handle: ClockHandle,
    rights: UInt32,
    slot: Int,
}

extension ClockObject {
    func allows(&self, right: ClockRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// A Timer handle the dispatch has VALIDATED, paired with its rights and the
/// timer slot it names (spec §2 table; design 232 unit 1).
struct TimerObject {
    handle: TimerHandle,
    rights: UInt32,
    slot: Int,
}

extension TimerObject {
    func allows(&self, right: TimerRight) -> Bool {
        (self.rights & (right as UInt32)) != 0
    }
}

/// Exit codes the kernel reports through the platform's failure channel,
/// distinct from any status root chooses for itself.
///
/// A type rather than a family of `UInt`s so `fatal` cannot be handed an
/// arbitrary number: the kernel's own failure vocabulary is closed, and the
/// harness asserts on these values.
/// 3 is deliberately absent. It was `BadSyscall`, from when a bad op number
/// killed the process; under the object-op model a caller's mistake became a
/// status the process received and survived — and design 178's faults ruling
/// has since made it a kill again, under `ProcessFault`. The values are
/// per-case, so a gap costs nothing and a reused number would have made two
/// eras' transcripts read alike.
public enum ExitCode: UInt {
    case UmodeFault = 2,
    case BadImage = 4,
    case ProcessFault = 5,
}

// =============================================================================
// Arithmetic the loader needs
// =============================================================================

/// Round `v` up to the next multiple of `align` (a power of two).
public func align_up(v: UInt, align: UInt) -> UInt {
    let rem = v & (align - 1)
    if rem == 0 {
        v
    } else {
        v + (align - rem)
    }
}

// =============================================================================
// Processes, threads and the scheduler (design 178 D2/D3/D4; spec §2, §7, §8)
// =============================================================================
//
// THE TRAP FRAME IS THE THREAD CONTEXT, and that one decision is most of this
// unit. A thread's saved registers are the frame the HAL's trap entry writes on
// the way in and reads on the way out; a thread SWITCH is therefore not a
// separate save/restore at all — it is `ktrap` returning a DIFFERENT frame
// address than it was called with. Entering user mode for the first time is the
// same operation with a frame nothing has run in yet. Two seam calls carry the
// whole of it: `hal.frame_init` builds a fresh context, `hal.resume_frame`
// enters one, and the trap entry's ordinary return path does every switch after
// that.
//
// WHERE A SWITCH CAN HAPPEN is design 178's D2, and the frame model is what
// makes it free: the only place a frame address is chosen is the user-return
// boundary, because that is the only place `ktrap` returns. The kernel is never
// preempted, holds no lock, and has no half-saved context to protect — the
// state a switch reads is a table, and the tick that motivates one only sets a
// flag.
//
// THE PROTECTION-DOMAIN RELOAD IS NOT HERE, and its absence is deliberate
// rather than forgotten (design 178 D4 + the M3 memory notes). Threads of one
// process share one domain, so a same-process switch reloads nothing; the
// reload belongs at exactly one point — `pick_next` below, where the outgoing
// and incoming threads' PROCESSES are both in hand — and M3's per-process
// region sets install it there and nowhere else. Whether that reload is a
// register file or a table root is the HAL's business, which is why this
// paragraph can say it without naming either.

/// Processes the kernel can hold. ONE in M2: the kernel loads exactly one image
/// ever (§12) and every later process is loaded BY root, which needs the
/// MemoryObject/Mapping objects M3 brings. The table is indexed rather than
/// assumed throughout so that raising this number is the only edit.
static MAX_PROCESSES: Int = 1

/// Threads the kernel can hold, across all processes.
static MAX_THREADS: Int = 8

/// Events the kernel can hold, across all processes (spec §2.4).
static MAX_EVENTS: Int = 8

/// Waiters the kernel can hold, across all processes (spec §2.2). Fewer than
/// events on purpose: a Waiter is a DISPATCH POINT, and the shape §2.2 ratifies
/// — many handles per Waiter, many threads per Waiter — is one per pool of
/// workers rather than one per notification.
static MAX_WAITERS: Int = 4

/// Interrupts the kernel can hold, across all processes (spec §2 table, §9).
///
/// Small because an Interrupt is a BOUND DEVICE LINE, and a machine has as many
/// of those as it has devices with drivers — not as many as it has
/// notifications. Every one costs a masked/unmasked line in the controller,
/// which is a real resource the board fixes.
static MAX_INTERRUPTS: Int = 4

/// Clocks the kernel can hold, across all processes (spec §2 table; design 232
/// unit 1).
///
/// TINY, AND IT IS A BOUND RATHER THAN A BUDGET. `System.ClockGet` is a getter:
/// it mints a process's Clock for a domain on first ask and hands the same
/// handle back every time after, so a process can hold at most one per
/// `ClockType` and v1 declares one type. One per process is therefore the exact
/// ceiling; the spare slot is headroom for the second domain rather than for a
/// second ask.
static MAX_CLOCKS: Int = MAX_PROCESSES + 1

/// Timers the kernel can hold, across all processes (spec §2 table; design 232
/// unit 1).
///
/// Sized like Events rather than like Interrupts: a Timer is a per-DEADLINE
/// object — one per timeout a process is tracking — not a per-device one, and
/// the shape M4's select-with-timeout makes is one Timer beside each thing
/// being waited on.
static MAX_TIMERS: Int = 8

/// Attachments the kernel can hold, across all Waiters.
///
/// Sized to cover every waitable being attached at once, which is the honest
/// bound: an attachment is one (Waiter, waitable) pair and §2.2 allows a handle
/// at most one Waiter, so nothing can need more than there are waitables. The
/// Timer is the third waitable kind and joins the sum for that reason — a
/// Clock does NOT, because a Clock is not waitable.
static MAX_ATTACHMENTS: Int = MAX_EVENTS + MAX_INTERRUPTS + MAX_TIMERS

/// Handles one process's table can hold (§3).
static MAX_HANDLES: Int = 16

/// Bytes reserved per thread for its saved context.
///
/// A STRIDE, not a size: the frame layout is the HAL's and differs per profile
/// (32 words on one, 34 doublewords on the other), so the kernel reserves a
/// generous power-of-two slot and asserts the machine's real frame fits. The
/// stride is also the ALIGNMENT the arena is rounded to, which is how a frame
/// gets the 16-byte alignment one profile's stack pointer requires without the
/// kernel having to know that is why.
static THREAD_FRAME_STRIDE: Int = 512

static_assert(hal.FRAME_BYTES <= THREAD_FRAME_STRIDE,
              "this machine's trap frame does not fit the kernel's per-thread stride")
static_assert(THREAD_FRAME_STRIDE % 16 == 0,
              "a frame slot must be 16-byte aligned on every profile")

/// One extra stride of slack, so rounding the arena's base up to the stride
/// cannot run the last slot past the end.
static FRAME_ARENA_WORDS: Int = (THREAD_FRAME_STRIDE / 8) * (MAX_THREADS + 1)

/// Every thread's saved context, back to back.
///
/// All-zero, so it costs no image bytes (design 149) — and a zeroed frame is
/// also the right initial state, since `frame_init` only has to write the three
/// or four words that are not zero.
unsafe static var THREAD_FRAMES: [UInt64; FRAME_ARENA_WORDS] = [0; FRAME_ARENA_WORDS]

/// The address of thread slot `index`'s frame.
func frame_slot(index: Int) unsafe -> UInt {
    let stride = THREAD_FRAME_STRIDE as UInt
    let base = align_up(((&var THREAD_FRAMES) as UnsafePointer<UInt64>) as UInt, stride)
    base + (index as UInt) * stride
}

/// What a thread slot is doing (spec §8).
///
/// `Exited` is a state a slot STAYS IN rather than a transition to `Free`,
/// because a join arriving after the exit must still find the exit code. The
/// slot returns to the pool at process teardown; reaping it earlier needs a
/// handle-close op, which M2 does not have — and without close, no slot is ever
/// reused, which is also why handles carry no generation yet (§3's
/// stale-handle detection has nothing to detect until a slot can be reused).
enum ThreadState: UInt8 {
    case Free = 0,
    case Created = 1,
    case Runnable = 2,
    case Running = 3,
    case Blocked = 4,
    case Exited = 5,
}

/// One thread (spec §2 table row).
///
/// `link` is the ONE list pointer a thread needs, because a thread is on at
/// most one list at a time: the ready queue when it is runnable, or the joiner
/// list of the thread it is waiting for when it is blocked. Slot indices are
/// stored PLUS ONE so that zero means "no thread", which is what a zeroed
/// static already says.
struct ThreadSlot {
    state: ThreadState,
    process: Int,
    /// This thread's own handle in its process's table — what `ThreadSelf`
    /// hands back, kept here so the derivation is a read rather than a search.
    self_handle: UInt,
    exit_code: UInt,
    /// Head of the list of threads blocked joining THIS one (slot + 1).
    joiners: Int,
    /// Next slot on whichever list this thread is on (slot + 1).
    link: Int,
    /// Where a thread parked in `Waiter.Wait` wants its record written — a user
    /// address, ALREADY VALIDATED by `copy_out_check` at the call. Validating at
    /// the call rather than at the wake is what makes a bad buffer terminate the
    /// process that supplied it, while it is still the running one.
    wait_buf: UInt,
}

/// What a process slot is doing.
enum ProcessState: UInt8 {
    case Free = 0,
    case Running = 1,
    case Gone = 2,
}

/// One process (spec §2 table row): its protection domain, its handle table and
/// its threads.
///
/// The handle table is not a field: it is a slice of `HANDLES` below, indexed
/// by this slot. That is the same arrangement as the frames and for the same
/// reason — a fixed-size array of fixed-size arrays is a shape the kernel has
/// no allocator for.
///
/// `region_base`/`region_top` ARE the address-space domain in M2: one granted
/// range per process, installed by the loader through the HAL's protection
/// primitive. Real Mapping objects are M3; what this pair does today is answer
/// the one question thread creation has to ask — is this entry, is this stack,
/// inside the process at all.
/// `rw_base`/`rw_top` are the WRITABLE window inside that range, and they exist
/// because the kernel now writes into a process's memory (`copy_out`). A
/// process that asks the kernel to place a record in its own CODE has made a
/// caller-checkable mistake, and the check needs somewhere to read the answer
/// from. It is ONE window rather than a per-segment list because M2 grants a
/// contiguous image (spec §5.5's `code|rodata|rw` layout) plus a stack at the
/// region's top edge, so the writable part is the span between them — and
/// because the per-mapping answer is M3's, where a Mapping object records its
/// own permissions and this pair is replaced by a lookup rather than widened.
/// It is CONSERVATIVE in one direction only: a gap between the image's writable
/// end and the stack falls inside the span, so the kernel may write RAM the
/// process was not granted. That corrupts nothing — the process owns the whole
/// region either way, and a process that names a hole gets a record it cannot
/// read, which is its own bug.
///
/// Zero/zero means NO writable grant, and that is the honest answer for the
/// harness kernels that grant a payload its own bytes read+execute: a process
/// with nowhere to receive a record cannot receive one.
struct ProcessSlot {
    state: ProcessState,
    /// This process's own handle in its own table (what `ProcessSelf` returns).
    self_handle: UInt,
    /// The image entry, which is what `ENTRY_IMAGE` resolves to.
    entry: UInt,
    region_base: UInt,
    region_top: UInt,
    rw_base: UInt,
    rw_top: UInt,
    exit_kind: ProcessStatusKind,
    exit_code: UInt,
}

/// Whether an Event or a Waiter slot is in use.
///
/// ONE enum for both because it really is one question. Threads and processes
/// have state MACHINES — a thread is created, then runnable, then running, then
/// blocked or exited, and a join arriving after the exit still has to find the
/// code — while an Event and a Waiter are either there or not: an Event's whole
/// state is its accumulated word, and a Waiter's is its two lists.
enum SlotState: UInt8 {
    case Free = 0,
    case Live = 1,
}

/// WHICH KINDS CAN BE ATTACHED TO A WAITER — the waitable kinds, and only
/// those.
///
/// It is a SECOND enum beside `ObjType` rather than a `Bool` on it, and the
/// reason is the same one `sosabi` gives for not recording waitability there at
/// all: attaching also spends a RIGHT, and which enum's bits that right lives in
/// is decided by the kind. `waitable_slot` is where an `ObjType` becomes one of
/// these, and it is the only place — every non-waitable arm of that match
/// terminates the process instead of producing a value.
///
/// What this enum buys downstream is that the four per-kind questions below are
/// EXHAUSTIVE OVER WAITABLES rather than over object types: a fifth object kind
/// that is not waitable costs them nothing, and a fifth WAITABLE kind fails all
/// four to compile until somebody answers for it.
enum WaitableKind: UInt8 {
    case Event = 0,
    case Interrupt = 1,
    case Timer = 2,
}

/// A waitable the dispatch has resolved: which table, which slot.
struct Waitable {
    kind: WaitableKind,
    slot: Int,
}

/// One Event (spec §2.4): the accumulating non-blocking notification.
///
/// `word` IS the object. Non-zero means ready, which is what makes readiness
/// LEVEL-TRIGGERED for free (§2.2) — nothing records that a waiter has been
/// told, so every look at the word gives the same answer until somebody TAKES
/// it. There is no edge to lose because there is no edge.
///
/// TAKING IT IS READ-AND-CLEAR THROUGH EITHER DOOR (ruled Aug 17, user):
/// §2.4's `Receive` is the non-blocking poll, a `Waiter.wait` delivery is the
/// blocking one, and both hand the word to a process and reset it. So the word
/// is never reported twice, and a signal arriving after a take re-arms this
/// object with its own bits alone.
///
/// `attachment` is the ONE thing an Event knows about the wait side: which
/// attachment names it, or zero. §2.2 ratifies at most one Waiter per handle,
/// so that is a field rather than a list, and it is what makes `Signal`'s hot
/// path one load. Everything else about the attachment — which Waiter, which
/// key, what comes next on the list — lives in the attachment itself, because
/// an Interrupt has the same field and neither kind should carry a copy of the
/// wait machinery. Slot indices are stored PLUS ONE so that zero means "none",
/// which is what a zeroed static already says.
struct EventSlot {
    state: SlotState,
    process: Int,
    /// §2.4's per-Event accumulation mode, fixed at creation.
    mode: EventMode,
    /// The accumulated word. Non-zero = ready.
    word: UInt,
    /// The attachment naming this event (slot + 1); 0 = unattached.
    attachment: Int,
}

/// One Interrupt (spec §2 table, §9): an IRQ line bound to a waitable.
///
/// `pending` IS the object, exactly as an Event's word is: it is set when the
/// line fires and cleared by `Ack`, and "ready" means nothing more than that.
/// §9's at-most-one-unacked-fire invariant is therefore not maintained, it is
/// REPRESENTED — a `Bool` cannot hold two — and what makes it true rather than
/// merely representable is that the kernel MASKS the line before the hook runs
/// and only `Ack` unmasks it, so the device physically cannot fire again in
/// between.
///
/// `line` is the number the controller answers with, and it is what makes an
/// Interrupt findable from the trap path: the hook has a line and needs the
/// object. A table scan is what answers that, which at this slab size is a
/// handful of loads and is bounded by the same argument every other scan in the
/// interrupt path is (design 178 D2 — it runs with interrupts masked, so its
/// length is interrupt latency).
struct InterruptSlot {
    state: SlotState,
    process: Int,
    /// The IRQ line this object is bound to, for its whole life.
    line: UInt,
    /// Fired and not yet acked. Non-false = ready, in §2.2's sense.
    pending: Bool,
    /// The attachment naming this interrupt (slot + 1); 0 = unattached.
    attachment: Int,
}

/// One Clock (spec §2 table; design 232 unit 1): a GRANTED TIME SOURCE.
///
/// IT HOLDS NO TIME. The machine's counter is the clock (`hal.timer_now_ns`),
/// and this slot records only WHOSE it is and WHICH DOMAIN it names — so two
/// processes' Clocks cannot drift apart, because there is nothing here to
/// drift. What the object buys is the capability: a process that was never
/// granted one cannot read the counter at all, which is what makes handing a
/// child a VIRTUAL clock later a substitution rather than a redesign.
struct ClockSlot {
    state: SlotState,
    process: Int,
    /// The domain this clock answers in, fixed at the grant.
    kind: ClockType,
}

/// One Timer (spec §2 table; design 232 unit 1): a deadline on a Clock.
///
/// `fires` IS THE OBJECT, exactly as an Event's word and an Interrupt's
/// `pending` are: non-zero means ready, and that is the whole of what a Waiter
/// looks at. Readiness is level-triggered by the same absence — nothing records
/// that a waiter has been told, so the count is simply there until a wait
/// consumes it.
///
/// `deadline_ns` IS THE NEXT FIRE, NOT THE LAST ONE, and it is what makes the
/// re-arm drift-free: `fire_timer` advances it by whole intervals from ITSELF
/// rather than from the clock, so a fire the kernel was late for shortens the
/// next gap instead of pushing every later one out. That is the timerfd model
/// and it is the reason this field is absolute rather than a remaining count.
///
/// `clock` binds the Timer to the Clock that made it, for the object's whole
/// life (the M3 time notes: the timer binds its clock at creation). Today every
/// Clock reads one counter, so the binding costs nothing and decides nothing;
/// it exists because a second domain — or a virtual clock — makes "which time
/// is this deadline measured in" a real question, and a Timer that could be
/// re-pointed would answer it differently over its life.
///
/// WHAT YOU CAN DO TO ONE lives in this type's extension, down beside the ops
/// that call it: `arm`, `disarm`, `is_due`, `sooner_of`, `fire`. Those are safe
/// functions, and the `unsafe` on the ops around them is the SLAB's rather than
/// the timer's.
struct TimerSlot {
    state: SlotState,
    process: Int,
    /// The Clock slot this timer measures against, for its life.
    clock: Int,
    /// Whether a deadline is scheduled. A one-shot clears this when it fires.
    armed: Bool,
    /// The absolute deadline of the NEXT fire, in the clock's nanoseconds.
    deadline_ns: UInt64,
    /// The re-arm period; 0 is a ONE-SHOT.
    interval_ns: UInt64,
    /// Fires not yet delivered to a waiter. Non-zero = ready. Saturates.
    fires: UInt,
    /// The attachment naming this timer (slot + 1); 0 = unattached.
    attachment: Int,
}

/// One Waiter (spec §2.2): the generic wait aggregator.
///
/// TWO LISTS AND NOTHING ELSE. `attached` is the persistent subscription set —
/// §2.2 has no one-shot mode, so an attachment is removed and never consumed —
/// and `blocked` is the threads parked in `Wait`, which §2.2 allows to be
/// several. Readiness is NOT a third list: it is derived by scanning `attached`
/// for something ready, which is the level-triggered semantics stated as an
/// implementation rather than maintained beside one.
struct WaiterSlot {
    state: SlotState,
    process: Int,
    /// Head of the attachment list (attachment slot + 1).
    attached: Int,
    /// Head of the list of threads parked in `Wait` (thread slot + 1).
    blocked: Int,
}

/// ONE ATTACHMENT: a Waiter, a waitable, and the key that names the pair.
///
/// IT IS A THIRD OBJECT RATHER THAN FIELDS ON THE WAITABLE, and the second
/// waitable kind is what forced that (M2 unit 3 kept them on the Event). A
/// Waiter's set has to be ONE list — a wait scans it once and a `Remove` walks
/// it once — so a per-kind list would make both operations a matrix over kinds
/// instead of a walk, and rider 4's "the same walk, and therefore one place to
/// be wrong" would stop being true at exactly two kinds.
///
/// What each waitable still keeps is a single `attachment` field, which is the
/// answer to the only question the SIGNAL side asks: who, if anyone, is
/// watching me.
struct Attachment {
    state: SlotState,
    /// Which table `target` indexes.
    kind: WaitableKind,
    /// The waitable's slot in that table.
    target: Int,
    /// The Waiter this attachment belongs to (slot index, 0-based).
    waiter: Int,
    /// The word-sized key the attacher supplied (§2.2). The kernel stores it
    /// and hands it back; it never interprets it.
    key: UInt,
    /// Next attachment on that waiter's list (slot + 1).
    link: Int,
}

unsafe static var THREADS: [ThreadSlot; MAX_THREADS] = [
    ThreadSlot(state: ThreadState.Free, process: 0, self_handle: 0,
               exit_code: 0, joiners: 0, link: 0, wait_buf: 0); MAX_THREADS]

unsafe static var PROCESSES: [ProcessSlot; MAX_PROCESSES] = [
    ProcessSlot(state: ProcessState.Free, self_handle: 0, entry: 0,
             region_base: 0, region_top: 0, rw_base: 0, rw_top: 0,
             exit_kind: ProcessStatusKind.Running, exit_code: 0); MAX_PROCESSES]

/// Every process's handle table, back to back: process `p`'s handle `h`
/// (1-based, §3's "handle 0 names nothing") lives at `p * MAX_HANDLES + h - 1`.
unsafe static var HANDLES: [HandleEntry; MAX_PROCESSES * MAX_HANDLES] = [
    HandleEntry(obj_type: ObjType.Unbound, rights: 0, target: 0);
    MAX_PROCESSES * MAX_HANDLES]

unsafe static var EVENTS: [EventSlot; MAX_EVENTS] = [
    EventSlot(state: SlotState.Free, process: 0, mode: EventMode.Or, word: 0,
              attachment: 0); MAX_EVENTS]

unsafe static var WAITERS: [WaiterSlot; MAX_WAITERS] = [
    WaiterSlot(state: SlotState.Free, process: 0, attached: 0,
               blocked: 0); MAX_WAITERS]

unsafe static var INTERRUPTS: [InterruptSlot; MAX_INTERRUPTS] = [
    InterruptSlot(state: SlotState.Free, process: 0, line: 0, pending: false,
                  attachment: 0); MAX_INTERRUPTS]

unsafe static var ATTACHMENTS: [Attachment; MAX_ATTACHMENTS] = [
    Attachment(state: SlotState.Free, kind: WaitableKind.Event, target: 0,
               waiter: 0, key: 0, link: 0); MAX_ATTACHMENTS]

unsafe static var CLOCKS: [ClockSlot; MAX_CLOCKS] = [
    ClockSlot(state: SlotState.Free, process: 0,
              kind: ClockType.Monotonic); MAX_CLOCKS]

unsafe static var TIMERS: [TimerSlot; MAX_TIMERS] = [
    TimerSlot(state: SlotState.Free, process: 0, clock: 0, armed: false,
              deadline_ns: 0, interval_ns: 0, fires: 0,
              attachment: 0); MAX_TIMERS]

/// "No thread". Slot indices are ordinary 0-based `Int`s in the tables and
/// PLUS-ONE inside list links; this is the sentinel for the plain form.
static NO_THREAD: Int = -1

/// The same sentinel for the other tables.
static NO_EVENT: Int = -1
static NO_WAITER: Int = -1
static NO_INTERRUPT: Int = -1
static NO_ATTACHMENT: Int = -1
static NO_CLOCK: Int = -1
static NO_TIMER: Int = -1

/// The running thread's slot, or `NO_THREAD`.
///
/// It really is none before the first process exists, and it stays none for the
/// harness kernels that enter user mode without one — those cases predate
/// Thread objects and must go on working, which is what every `NO_THREAD` guard
/// below is for. Compound global state on design 149's terms: uniprocessor
/// kernel, interrupts taken from user mode only (D2), so the only writer is the
/// trap path and nothing can interleave with it.
unsafe static var CURRENT_THREAD: Int = NO_THREAD

/// The ready queue: a FIFO of runnable threads, head and tail as slot + 1.
/// The RUNNING thread is not on it — round-robin is "put the outgoing thread
/// at the tail, take the head", and both halves happen in `pick_next`.
unsafe static var READY_HEAD: Int = 0
unsafe static var READY_TAIL: Int = 0

/// Set by the tick when a thread's slice runs out, and by `Yield`. Read and
/// cleared at the user-return boundary, which is the only place it can act.
unsafe static var NEED_RESCHED: Bool = false

/// Ticks left in the running thread's slice.
unsafe static var SLICE_LEFT: UInt = 0

/// Ticks a thread runs before the timer takes the processor away (spec §7's
/// fixed timeslice). ONE tick, because M2's tick period is already the unit the
/// scheduler cares about and a longer slice would only make the preemption
/// harness wait for it.
static SLICE_TICKS: UInt = 1

// -----------------------------------------------------------------------------
// The handle table (spec §3)
// -----------------------------------------------------------------------------

/// Where process `p`'s handle `h` sits in the flat table. Callers have already
/// range-checked `h`.
func handle_index(p: Int, h: UInt) unsafe -> Int {
    p * MAX_HANDLES + (h as Int) - 1
}

/// Resolve a handle in a process's table.
///
/// An out-of-range or unbound handle resolves to `ObjType.Unbound`, and the
/// rights travel WITH the entry rather than being assumed by the op — the two
/// properties the M1 version already had, now over a real table.
func lookup_handle(p: Int, h: UInt) unsafe -> HandleEntry {
    if h == NO_HANDLE || h > (MAX_HANDLES as UInt) {
        return HandleEntry(obj_type: ObjType.Unbound, rights: 0, target: 0)
    }
    HANDLES[handle_index(p, h)]
}

/// Mint a handle naming `target` of kind `kind` with `rights`, in process `p`'s
/// table. Returns `NO_HANDLE` when the table is full — an exhaustion the caller
/// could not have known about, which is what a status is for.
func mint_handle(p: Int, kind: ObjType, rights: UInt32, target: Int) unsafe -> UInt {
    var h: Int = 0
    while h < MAX_HANDLES {
        let entry = HANDLES[p * MAX_HANDLES + h]
        match entry.obj_type {
            case Unbound -> {
                HANDLES[p * MAX_HANDLES + h] = HandleEntry(obj_type: kind,
                                                           rights: rights,
                                                           target: target)
                return (h as UInt) + 1
            },
            case _ -> {},
        }
        h = h + 1
    }
    NO_HANDLE
}

// -----------------------------------------------------------------------------
// The ready queue
// -----------------------------------------------------------------------------

func ready_push(slot: Int) unsafe {
    THREADS[slot].link = 0
    if READY_TAIL == 0 {
        READY_HEAD = slot + 1
        READY_TAIL = slot + 1
    } else {
        THREADS[READY_TAIL - 1].link = slot + 1
        READY_TAIL = slot + 1
    }
}

func ready_pop() unsafe -> Int {
    if READY_HEAD == 0 {
        return NO_THREAD
    }
    let slot = READY_HEAD - 1
    READY_HEAD = THREADS[slot].link
    if READY_HEAD == 0 {
        READY_TAIL = 0
    }
    THREADS[slot].link = 0
    slot
}

// -----------------------------------------------------------------------------
// Allocation
// -----------------------------------------------------------------------------

/// Take a free thread slot, or `NO_THREAD` when the slab is empty.
func alloc_thread() unsafe -> Int {
    var i: Int = 0
    while i < MAX_THREADS {
        match THREADS[i].state {
            case Free -> { return i },
            case _ -> {},
        }
        i = i + 1
    }
    NO_THREAD
}

/// Take a free event slot, or `NO_EVENT` when the slab is empty.
func alloc_event() unsafe -> Int {
    var i: Int = 0
    while i < MAX_EVENTS {
        match EVENTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_EVENT
}

/// Take a free waiter slot, or `NO_WAITER` when the slab is empty.
func alloc_waiter() unsafe -> Int {
    var i: Int = 0
    while i < MAX_WAITERS {
        match WAITERS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_WAITER
}

/// Take a free interrupt slot, or `NO_INTERRUPT` when the slab is empty.
func alloc_interrupt() unsafe -> Int {
    var i: Int = 0
    while i < MAX_INTERRUPTS {
        match INTERRUPTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_INTERRUPT
}

/// Take a free attachment slot, or `NO_ATTACHMENT` when the slab is empty.
func alloc_attachment() unsafe -> Int {
    var i: Int = 0
    while i < MAX_ATTACHMENTS {
        match ATTACHMENTS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_ATTACHMENT
}

/// Take a free clock slot, or `NO_CLOCK` when the slab is empty.
func alloc_clock() unsafe -> Int {
    var i: Int = 0
    while i < MAX_CLOCKS {
        match CLOCKS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_CLOCK
}

/// Take a free timer slot, or `NO_TIMER` when the slab is empty.
func alloc_timer() unsafe -> Int {
    var i: Int = 0
    while i < MAX_TIMERS {
        match TIMERS[i].state {
            case Free -> { return i },
            case Live -> {},
        }
        i = i + 1
    }
    NO_TIMER
}

// -----------------------------------------------------------------------------
// The scheduler (design 178 D3)
// -----------------------------------------------------------------------------

/// Whether the currently running thread should be left running.
func stays_running(slot: Int) unsafe -> Bool {
    match THREADS[slot].state {
        case Running -> not NEED_RESCHED,
        case _ -> false,
    }
}

/// Choose the thread to run next and return the frame to resume in.
///
/// THE ONE SWITCH POINT. `ktrap` returns whatever this returns, and the HAL's
/// trap entry resumes that frame — so every context switch in the system is
/// this function picking a different slot, and there is no second path to keep
/// in step. A kernel with no Thread objects at all (the harness cases that
/// predate this unit) never has a current thread and gets its own frame back
/// untouched.
///
/// M3's per-process protection reload goes HERE, between the outgoing thread
/// and the incoming one, and nowhere else: this is the only place both are
/// known. A same-process switch — every switch M2 can make — reloads nothing,
/// which is why the point is marked rather than occupied.
func pick_next(current_frame: UInt) unsafe -> UInt {
    let cur = CURRENT_THREAD
    if cur == NO_THREAD {
        return current_frame
    }
    if stays_running(cur) {
        return current_frame
    }

    // A thread leaving the processor while still runnable goes to the TAIL,
    // which is the whole of round-robin. One that blocked or exited is already
    // on the list it belongs to, or on none.
    match THREADS[cur].state {
        case Running -> {
            THREADS[cur].state = ThreadState.Runnable
            ready_push(cur)
        },
        case _ -> {},
    }
    NEED_RESCHED = false

    var next = ready_pop()
    if next == NO_THREAD {
        // Nothing runnable, and two readings of it (see THE IDLE PATH below).
        // With a bound IRQ line, readiness can still arrive from outside the
        // set of runnable threads, so the kernel WAITS for it; with none, every
        // thread is blocked on something no thread can now deliver, which is
        // the deadlock M2 has always reported here.
        if not has_external_wake_source() {
            fault_process(THREADS[cur].process, FaultReason.Deadlock)
        }
        idle_until_runnable()
        next = ready_pop()
    }

    CURRENT_THREAD = next
    THREADS[next].state = ThreadState.Running
    SLICE_LEFT = SLICE_TICKS
    frame_slot(next)
}

// -----------------------------------------------------------------------------
// Thread lifecycle
// -----------------------------------------------------------------------------

/// How many of a process's threads have not exited.
func live_threads(p: Int) unsafe -> Int {
    var live: Int = 0
    var i: Int = 0
    while i < MAX_THREADS {
        if THREADS[i].process == p {
            match THREADS[i].state {
                case Free -> {},
                case Exited -> {},
                case _ -> { live = live + 1 },
            }
        }
        i = i + 1
    }
    live
}

/// Retire the running thread with `code`, waking everything that joined it.
///
/// A JOINER'S RETURN IS WRITTEN HERE, into ITS frame, which is the half of the
/// blocking protocol that is easy to get wrong: a thread that blocks in a
/// syscall must not have its result written when it blocks, or the resume would
/// step over the trapping instruction twice on one profile and hand back a
/// value nobody computed on both. So `Join` writes nothing, and the wake writes
/// the pair exactly once.
func exit_thread(slot: Int, code: UInt) unsafe {
    THREADS[slot].state = ThreadState.Exited
    THREADS[slot].exit_code = code

    var j = THREADS[slot].joiners
    THREADS[slot].joiners = 0
    while j != 0 {
        let waiter = j - 1
        j = THREADS[waiter].link
        write_result(frame_slot(waiter), op_value(code))
        THREADS[waiter].state = ThreadState.Runnable
        ready_push(waiter)
    }

    // The last thread out ends the process, carrying its own exit code — the
    // ordinary way a program finishes when nobody called `Process.Exit`.
    let p = THREADS[slot].process
    if live_threads(p) == 0 {
        end_process(p, ProcessStatusKind.Exited, code, code)
    }
    NEED_RESCHED = true
}

/// Park the running thread on `target`'s joiner list.
func block_on_join(slot: Int, target: Int) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].link = THREADS[target].joiners
    THREADS[target].joiners = slot + 1
    NEED_RESCHED = true
}

// -----------------------------------------------------------------------------
// Events and Waiters (spec §2.2, §2.4; design 178 D5)
// -----------------------------------------------------------------------------
//
// THE TWO SMALLEST OBJECTS IN THE §2 TABLE, and between them the whole of
// asynchronous notification: an Event is a word that accumulates and never
// blocks, a Waiter is a set of them plus the threads parked on the set. They
// are here rather than in M3 because they are what proves the handle machinery
// generalizes past the singleton — three kinds became five with no change to
// the dispatch's shape, which is the claim §3 has been making since M1.
//
// LEVEL-TRIGGERED IS AN ABSENCE, NOT A MECHANISM (§2.2, ratified Jul 29). The
// kernel records nowhere that a waiter has been told about a ready event, so
// every look at the attachment set gives the same answer until somebody TAKES
// the word. That is what makes a signal landing BEFORE anyone waits safe: the
// word is still non-zero when the wait arrives, and the scan finds it. An
// edge-triggered design would need a "reported" flag per attachment and would
// lose exactly that.
//
// THE TAKE HAS TWO DOORS, AND BOTH CONSUME (ruled Aug 17, user). `Receive` is
// the non-blocking poll and a `Waiter.wait` is the blocking one; each hands the
// accumulated word to a process, so each clears it. A delivery that left the
// word behind would report the same bits to the next wait as well, and the
// recipient could not tell that duplicate from a real second signal — the one
// failure mode a notification must not have. Nothing is lost either way: a
// signal that lands after the take re-arms readiness with its own bits alone.
//
// WHAT WAKES WHOM, and it is a DISTRIBUTION rather than a broadcast. `Signal`
// wakes AT MOST ONE parked thread (§2.2: "a ready handle wakes one waiter"),
// and that thread's record carries the word — so with several threads parked on
// one Waiter, one signal feeds exactly one of them and the rest wait for the
// next, which is the worker-pool shape §2.2 exists for. THE RECIPIENT IS UNIQUE
// BY CONSTRUCTION and no multi-watcher caveat is owed: a waitable has at most
// ONE attachment (§2.2), so a signal reaches exactly one Waiter, which hands it
// to exactly one thread.

/// §2.4's accumulation, both modes.
///
/// THE SUM SATURATES RATHER THAN WRAPPING, which is the half of §2.4 that is a
/// correctness requirement rather than a convenience: a producer faster than
/// its consumer must not roll a full count back through zero, because zero is
/// what "not ready" means — a wrap would make a saturated event go quiet.
/// `&+` is the wrapping add (Saw's overflow checks are always on, so a plain
/// `+` would panic in the kernel), and the comparison after it is the carry.
func accumulate(slot: Int, bits: UInt) unsafe {
    match EVENTS[slot].mode {
        case Or -> {
            EVENTS[slot].word = EVENTS[slot].word | bits
        },
        case SaturatingSum -> {
            EVENTS[slot].word = saturating_add(EVENTS[slot].word, bits)
        },
    }
}

/// Add without ever rolling through zero — §2.4's counting rule, and since
/// design 232 unit 1 the Timer's fire count uses the same one.
///
/// IT IS SHARED RATHER THAN WRITTEN TWICE because the REASON is the same in both
/// places, not merely the arithmetic: zero is what "not ready" means to a
/// Waiter, so a count that wrapped would make a saturated Event or a busy Timer
/// go quiet — the one failure mode a level-triggered notification must not have.
/// `&+` is the wrapping add (Saw's overflow checks are always on, so a plain `+`
/// would panic in the kernel), and the comparison after it is the carry.
func saturating_add(a: UInt, b: UInt) -> UInt {
    let sum = a &+ b
    if sum < a { UInt.max } else { sum }
}

/// Narrow a 64-bit fire count to a machine word, SATURATING rather than
/// panicking.
///
/// A checked `as` would be a panic edge in the kernel on a number a PROCESS
/// chose — arm a one-nanosecond interval, wait long enough, and the coalesced
/// count exceeds a 32-bit word on Profile A. Saturating is the same answer the
/// count already gives at its own ceiling, so nothing new has to be explained
/// to a reader of the payload.
func fires_word(n: UInt64) -> UInt {
    if n > (UInt.max as UInt64) { UInt.max } else { n as UInt }
}

// -----------------------------------------------------------------------------
// THE PER-KIND MATRIX: four questions, one arm per waitable kind (obligation 1)
// -----------------------------------------------------------------------------
//
// Everything the wait machinery needs to know about a waitable is one of these
// five questions, and each is answered by an EXHAUSTIVE match on
// `WaitableKind`:
//
//   `waitable_attachment` / `set_waitable_attachment`   who is watching me
//   `waitable_ready`                                    am I ready
//   `waitable_answer`                                   what does a record say
//   `waitable_consume`                                  a record was delivered
//
// That is a MATRIX rather than a funnel because the answers genuinely differ
// per kind — an Event's readiness is a word, an Interrupt's is a masked line and
// a Timer's is a count of expiries — and it is written as five small functions
// in one place so the matrix is READABLE AS ONE. Adding a fourth waitable kind
// fails all five to compile, which is the property a `_` arm anywhere here would
// destroy. (The Timer, design 232 unit 1's third kind, is what added the fifth
// question and it added it to every existing row at once — which is the matrix
// working.)
//
// Everything ELSE about waiting — the list walk, the key lookup, the wake, the
// copy-out — is kind-blind and appears exactly once below.

/// Which attachment names this waitable (slot + 1), or 0.
func waitable_attachment(kind: WaitableKind, slot: Int) unsafe -> Int {
    match kind {
        case Event -> EVENTS[slot].attachment,
        case Interrupt -> INTERRUPTS[slot].attachment,
        case Timer -> TIMERS[slot].attachment,
    }
}

/// Record (or clear, with 0) which attachment names this waitable.
func set_waitable_attachment(kind: WaitableKind, slot: Int, a: Int) unsafe {
    match kind {
        case Event -> { EVENTS[slot].attachment = a },
        case Interrupt -> { INTERRUPTS[slot].attachment = a },
        case Timer -> { TIMERS[slot].attachment = a },
    }
}

/// Is this waitable ready, in §2.2's level-triggered sense?
///
/// Every answer is a READ of the object's own state and none consults a flag
/// the wait machinery maintains, which is what makes level-triggering an
/// absence rather than a mechanism: an Event is ready while its word is
/// non-zero, an Interrupt while its fire is unacked, a Timer while it has
/// expiries nobody has been told about.
func waitable_ready(kind: WaitableKind, slot: Int) unsafe -> Bool {
    match kind {
        case Event -> EVENTS[slot].word != 0,
        case Interrupt -> INTERRUPTS[slot].pending,
        case Timer -> TIMERS[slot].fires != 0,
    }
}

/// The tag and payload words a wait record carries for this waitable.
func waitable_answer(kind: WaitableKind, slot: Int) unsafe -> WaitAnswer {
    match kind {
        case Event -> WaitAnswer(tag: WaitTag.Event, payload: EVENTS[slot].word),
        case Interrupt -> WaitAnswer(tag: WaitTag.Interrupt,
                                     payload: INTERRUPTS[slot].line),
        case Timer -> WaitAnswer(tag: WaitTag.Timer,
                                 payload: TIMERS[slot].fires),
    }
}

/// A record describing this waitable HAS BEEN DELIVERED to a thread. Update
/// whatever the delivery spent.
///
/// THE THREE ANSWERS, and the differences between them are real rather than
/// accidents of how each object happens to be written:
///
///   - an EVENT's word is CONSUMED BY WHOEVER TAKES THE VALUE, through either
///     door (ruled Aug 17, user). §2.4's `receive` is the non-blocking poll and
///     a `Waiter.wait` is the blocking one; both hand the accumulated word to a
///     process, so both clear it. A delivery that left the word behind would
///     report the same bits to the next wait as well, which is a duplicate the
///     recipient cannot tell from a real second signal.
///   - an INTERRUPT's readiness is ended by the driver's `ack` and by nothing
///     else (§9), because the line stays masked until the device has actually
///     been serviced. The kernel cannot know that a record was enough.
///   - a TIMER's fire count is SPENT by the delivery, because a Timer has no
///     second op to drain with and needs none. It has no mask to hold and no
///     device to service, so the fire has done its whole job once somebody has
///     been told — which is the ack-free half of the timerfd model, and what
///     makes a periodic timer a schedule rather than a request/response.
///
/// So the ODD KIND OUT IS THE INTERRUPT, and its emptiness says what it is: the
/// only readiness in the system whose end is a DEVICE's business rather than the
/// kernel's.
func waitable_consume(kind: WaitableKind, slot: Int) unsafe {
    match kind {
        // The take is READ-AND-CLEAR, and `deliver_attachment` is what makes it
        // one act: the read happened a few lines earlier in the same
        // interrupts-masked region, so no signal can land between the two and
        // there are no bits here that the record did not carry.
        case Event -> { EVENTS[slot].word = 0 },
        case Interrupt -> {},
        case Timer -> { TIMERS[slot].fires = 0 },
    }
}

/// What `waitable_answer` produces: the two words that are not the key.
struct WaitAnswer {
    tag: WaitTag,
    payload: UInt,
}

/// The first attachment of `w` whose waitable is ready, or `NO_ATTACHMENT`.
///
/// A SCAN, and that is the level-triggered semantics implemented rather than
/// maintained: there is no ready QUEUE to keep in step with the objects, so a
/// waitable that goes back to not-ready cannot leave a stale entry behind and
/// one that stays ready is found again by the next scan. It is O(attachments),
/// which at M2's slab sizes is a handful of loads and is bounded by the same
/// argument the ready queue's is — this runs with interrupts masked, so its
/// length is interrupt latency (design 178 D2), and a Waiter with hundreds of
/// attachments is what an M3 ready-list optimisation would be for.
func waiter_ready_attachment(w: Int) unsafe -> Int {
    var cur = WAITERS[w].attached
    while cur != 0 {
        let a = cur - 1
        if waitable_ready(ATTACHMENTS[a].kind, ATTACHMENTS[a].target) {
            return a
        }
        cur = ATTACHMENTS[a].link
    }
    NO_ATTACHMENT
}

/// Park the running thread on `w`'s blocked list, remembering where its record
/// goes. `dst` has already been through `copy_out_check`.
func block_on_wait(slot: Int, w: Int, dst: UInt) unsafe {
    THREADS[slot].state = ThreadState.Blocked
    THREADS[slot].wait_buf = dst
    THREADS[slot].link = WAITERS[w].blocked
    WAITERS[w].blocked = slot + 1
    NEED_RESCHED = true
}

/// The record `Waiter.Wait` answers with, in kernel memory (spec §2.2, as
/// amended by design 178 unit 3 rider 3).
///
/// Declaration order IS the layout (design 58), so the field names here and the
/// word indices `sosabi` publishes are one description — pinned by the assert
/// below rather than by agreement.
struct WaitRecord {
    key: UInt,
    tag: UInt,
    payload: UInt,
}

static_assert(sizeof<WaitRecord>() == WAIT_RECORD_WORDS * sizeof<UInt>(),
              "the wait record must be exactly the words sosabi publishes")

/// Build one and hand it to a process. The only producer of the wire form.
func deliver_wait_record(p: Int, dst: UInt, key: UInt, tag: WaitTag,
                         payload: UInt) unsafe {
    var rec = WaitRecord(key: key, tag: tag as UInt, payload: payload)
    copy_out(p, dst, ((&var rec) as UnsafePointer<WaitRecord>) as UInt,
             wait_record_bytes() as UInt)
}

/// ANSWER ONE ATTACHMENT INTO A PROCESS'S MEMORY, and spend what the answer
/// spent (obligation 1). Its entry points, both of them:
///
///   - `waiter_wait`, when something was ALREADY ready and nothing parks;
///   - `wake_one_waiter`, handing a ready attachment to a thread that did.
///
/// A funnel rather than two call sites, because "read the answer" and "record
/// that it was delivered" have to be one step: split apart, a kind whose
/// readiness is CONSUMED by delivery — the Timer and, since Aug 17, the Event —
/// would be drained on one path and not the other, and the bug would be a
/// periodic timer that reports the same fire twice to whichever caller forgot.
/// Both paths are equally "a record reached a thread", which is exactly the
/// event `waitable_consume` is about.
///
/// THE READ AND THE CLEAR ARE ONE ACT, and this function's body is where that is
/// true: `waitable_answer` takes the value, `waitable_consume` clears it, and
/// nothing between them can run. The kernel takes no trap in kernel mode (design
/// 178 D2 — interrupts are taken from user mode only), so a signal cannot land
/// inside this window; one landing after it finds the object empty and re-arms
/// readiness with its own bits alone, which is neither a loss nor a double
/// count.
func deliver_attachment(p: Int, dst: UInt, a: Int) unsafe {
    let kind = ATTACHMENTS[a].kind
    let target = ATTACHMENTS[a].target
    let answer = waitable_answer(kind, target)
    deliver_wait_record(p, dst, ATTACHMENTS[a].key, answer.tag, answer.payload)
    waitable_consume(kind, target)
}

/// Hand attachment `a` to ONE thread parked on `w`, if any is (§2.2).
///
/// The record goes into the woken thread's own buffer and its STATUS into the
/// woken thread's frame, both HERE and nowhere else — the same discipline
/// `exit_thread` follows for a joiner: a thread that blocked in a syscall was
/// answered by nobody when it blocked, so its waker is its single writer.
///
/// THE WRITER IS A DIFFERENT THREAD from the one being answered, which is sound
/// today because M2 has one address space; `copy_out`'s docstring is where that
/// stops being free. Since the Interrupt object landed the writer need not be a
/// THREAD at all — the trap path and the idle poll both reach here — which
/// changes nothing about the write and everything about why the check that
/// validated the buffer had to happen back at the `Wait` call.
func wake_one_waiter(w: Int, a: Int) unsafe {
    let head = WAITERS[w].blocked
    if head == 0 {
        return
    }
    let slot = head - 1
    WAITERS[w].blocked = THREADS[slot].link
    THREADS[slot].link = 0

    deliver_attachment(THREADS[slot].process, THREADS[slot].wait_buf, a)
    THREADS[slot].wait_buf = 0
    write_result(frame_slot(slot), op_ok())
    THREADS[slot].state = ThreadState.Runnable
    ready_push(slot)
}

/// A waitable just became ready: tell its Waiter, if it has one.
///
/// THE ONE PLACE READINESS TURNS INTO A WAKE, reached from both producers — an
/// Event's `Signal` and an Interrupt's line firing. Neither knows anything
/// about waiters beyond the attachment field the matrix reads.
func notify_ready(kind: WaitableKind, slot: Int) unsafe {
    let a = waitable_attachment(kind, slot)
    if a == 0 {
        return
    }
    wake_one_waiter(ATTACHMENTS[a - 1].waiter, a - 1)
}

/// §2.4's signal: accumulate, NEVER block, and tell the Waiter if there is one.
func signal_event(slot: Int, bits: UInt) unsafe {
    accumulate(slot, bits)
    // A signal of nothing is not a readiness. Both modes can produce it —
    // `signal(0)` in either — and reporting it would wake a waiter for a word
    // it would then read as empty.
    if EVENTS[slot].word == 0 {
        return
    }
    notify_ready(WaitableKind.Event, slot)
}

/// The attachment on `w` under `key`, or `NO_ATTACHMENT`.
///
/// THE KEY IS THE ATTACHMENT'S NAME, which is what makes the attachment set a
/// TABLE keyed by it rather than a bag: `Remove` names an attachment this way,
/// and `Add` uses the same walk to refuse a duplicate. Both rest on keys being
/// unique per Waiter, which is exactly why the duplicate is refused.
func attached_by_key(w: Int, key: UInt) unsafe -> Int {
    var cur = WAITERS[w].attached
    while cur != 0 {
        let a = cur - 1
        if ATTACHMENTS[a].key == key {
            return a
        }
        cur = ATTACHMENTS[a].link
    }
    NO_ATTACHMENT
}

/// Take attachment `a` off waiter `w`'s list, clear the waitable's back
/// pointer, and return the slot to the slab. The caller has established that it
/// is on that list.
func detach_attachment(w: Int, a: Int) unsafe {
    var prev: Int = 0
    var cur = WAITERS[w].attached
    while cur != 0 {
        let slot = cur - 1
        let next = ATTACHMENTS[slot].link
        if slot == a {
            if prev == 0 {
                WAITERS[w].attached = next
            } else {
                ATTACHMENTS[prev - 1].link = next
            }
            set_waitable_attachment(ATTACHMENTS[a].kind, ATTACHMENTS[a].target, 0)
            ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                        kind: WaitableKind.Event, target: 0,
                                        waiter: 0, key: 0, link: 0)
            return
        }
        prev = cur
        cur = next
    }
}

// -----------------------------------------------------------------------------
// Process teardown (spec §2's Process row: close all handles, free what it owns)
// -----------------------------------------------------------------------------

/// End process `p` and stop the machine with `machine_status`. Never returns.
///
/// The teardown is the ratified one and it is unconditional: every handle in
/// the process's table is closed, every thread slot and every frame it owns
/// goes back to the kernel's pools, and only then does the machine stop. With
/// one process that last step is the run ending; with M3's several it becomes a
/// return to the scheduler, and nothing above this line changes.
///
/// `machine_status` is separate from `code` because they answer different
/// questions: `code` is what a supervisor would read out of the §8 status word,
/// and `machine_status` is what the EMULATOR exits with — which for a fault is
/// the kernel's own vocabulary rather than anything the process chose.
func end_process(p: Int, kind: ProcessStatusKind, code: UInt,
                 machine_status: UInt) unsafe -> Never {
    PROCESSES[p].state = ProcessState.Gone
    PROCESSES[p].exit_kind = kind
    PROCESSES[p].exit_code = code

    var closed: UInt = 0
    var h: Int = 0
    while h < MAX_HANDLES {
        match HANDLES[p * MAX_HANDLES + h].obj_type {
            case Unbound -> {},
            case _ -> {
                HANDLES[p * MAX_HANDLES + h] = HandleEntry(obj_type: ObjType.Unbound,
                                                           rights: 0, target: 0)
                closed = closed + 1
            },
        }
        h = h + 1
    }

    var freed: UInt = 0
    var t: Int = 0
    while t < MAX_THREADS {
        if THREADS[t].process == p {
            match THREADS[t].state {
                case Free -> {},
                case _ -> {
                    THREADS[t] = ThreadSlot(state: ThreadState.Free, process: 0,
                                            self_handle: 0, exit_code: 0,
                                            joiners: 0, link: 0, wait_buf: 0)
                    freed = freed + 1
                },
            }
        }
        t = t + 1
    }
    CURRENT_THREAD = NO_THREAD
    READY_HEAD = 0
    READY_TAIL = 0

    // Interrupts go back FIRST, and masking each line is the part that is not
    // bookkeeping: a device the dead process was driving may still be
    // asserting, and an unmasked line with no object behind it would be taken,
    // reported and masked once per fire forever. Masking here is the kernel
    // taking the line back, which is the same handover §9 describes running
    // backwards.
    var irqs_freed: UInt = 0
    var q: Int = 0
    while q < MAX_INTERRUPTS {
        if INTERRUPTS[q].process == p {
            match INTERRUPTS[q].state {
                case Free -> {},
                case Live -> {
                    hal.irq_mask(INTERRUPTS[q].line)
                    INTERRUPTS[q] = InterruptSlot(state: SlotState.Free,
                                                  process: 0, line: 0,
                                                  pending: false, attachment: 0)
                    irqs_freed = irqs_freed + 1
                },
            }
        }
        q = q + 1
    }

    // Attachments belong to a WAITER, so they are reclaimed by walking the
    // process's waiters rather than by scanning for a process field they do not
    // carry — which is also the honest ownership statement: an attachment is a
    // row in a Waiter's table and dies with it.
    var a: Int = 0
    while a < MAX_ATTACHMENTS {
        match ATTACHMENTS[a].state {
            case Free -> {},
            case Live -> {
                if WAITERS[ATTACHMENTS[a].waiter].process == p {
                    ATTACHMENTS[a] = Attachment(state: SlotState.Free,
                                                kind: WaitableKind.Event,
                                                target: 0, waiter: 0, key: 0,
                                                link: 0)
                }
            },
        }
        a = a + 1
    }

    // Events and Waiters go back to their slabs whole (spec §2's Process row:
    // free what the process owned). No unlinking is needed first — an
    // attachment only ever joins two objects of the SAME process, so freeing
    // both ends is freeing the list, and a Waiter's blocked list named threads
    // this loop's predecessor has already reclaimed.
    var events_freed: UInt = 0
    var e: Int = 0
    while e < MAX_EVENTS {
        if EVENTS[e].process == p {
            match EVENTS[e].state {
                case Free -> {},
                case Live -> {
                    EVENTS[e] = EventSlot(state: SlotState.Free, process: 0,
                                          mode: EventMode.Or, word: 0,
                                          attachment: 0)
                    events_freed = events_freed + 1
                },
            }
        }
        e = e + 1
    }

    var waiters_freed: UInt = 0
    var w: Int = 0
    while w < MAX_WAITERS {
        if WAITERS[w].process == p {
            match WAITERS[w].state {
                case Free -> {},
                case Live -> {
                    WAITERS[w] = WaiterSlot(state: SlotState.Free, process: 0,
                                            attached: 0, blocked: 0)
                    waiters_freed = waiters_freed + 1
                },
            }
        }
        w = w + 1
    }

    // Clocks and Timers go back on the same terms as everything above. The
    // TIMERS matter beyond the bookkeeping, for the reason the interrupt loop
    // does: a dead process's armed deadline is one the kernel would otherwise
    // keep waking itself for, forever, with nobody left to tell. Freeing them
    // and reprogramming is the kernel taking the comparator back.
    var clocks_freed: UInt = 0
    var c: Int = 0
    while c < MAX_CLOCKS {
        if CLOCKS[c].process == p {
            match CLOCKS[c].state {
                case Free -> {},
                case Live -> {
                    CLOCKS[c] = ClockSlot(state: SlotState.Free, process: 0,
                                          kind: ClockType.Monotonic)
                    clocks_freed = clocks_freed + 1
                },
            }
        }
        c = c + 1
    }

    var timers_freed: UInt = 0
    var tm: Int = 0
    while tm < MAX_TIMERS {
        if TIMERS[tm].process == p {
            match TIMERS[tm].state {
                case Free -> {},
                case Live -> {
                    TIMERS[tm] = TimerSlot(state: SlotState.Free, process: 0,
                                           clock: 0, armed: false,
                                           deadline_ns: 0, interval_ns: 0,
                                           fires: 0, attachment: 0)
                    timers_freed = timers_freed + 1
                },
            }
        }
        tm = tm + 1
    }
    reprogram_timer()

    let uart = console()
    uart.write_str("SOS: process teardown handles=")
    uart.write_hex(closed)
    uart.write_str(" threads=")
    uart.write_hex(freed)
    uart.write_str(" events=")
    uart.write_hex(events_freed)
    uart.write_str(" waiters=")
    uart.write_hex(waiters_freed)
    uart.write_str(" interrupts=")
    uart.write_hex(irqs_freed)
    uart.write_str(" clocks=")
    uart.write_hex(clocks_freed)
    uart.write_str(" timers=")
    uart.write_hex(timers_freed)
    uart.write_str("\n")

    if machine_status == 0 {
        hal.exit_pass()
    } else {
        hal.exit_fail(machine_status)
    }
    while { }
}

/// TERMINATE a process for a caller error it could have checked — design 178's
/// faults ruling, ratified Aug 15.
///
/// This is what an invalid handle, an unknown op, a missing right or an op
/// aimed at the wrong thread DOES. It is not a status the process receives: the
/// process is the thing that was wrong, so it ends, and the kernel stays up to
/// say so. Never returns.
func fault_process(p: Int, reason: FaultReason) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: process fault: ")
    uart.write_str(reason.describe())
    uart.write_str("\n")
    end_process(p, ProcessStatusKind.Faulted, (reason as UInt8) as UInt,
                ExitCode.ProcessFault as UInt)
}

/// The same termination, reached from a hardware fault rather than a syscall
/// (spec §8: a thread fault kills its process). The report keeps M1's wording
/// and shape, because the harness reads it and because a reader of the two eras
/// should see the same line for the same event.
func fault_trap(tag: String, cause: UInt, epc: UInt, tval: UInt) unsafe -> Never {
    let uart = console()
    uart.write_str("SOS: fault ")
    uart.write_str(tag)
    uart.write_str(" cause=")
    uart.write_hex(cause)
    uart.write_str(" epc=")
    uart.write_hex(epc)
    uart.write_str(" tval=")
    uart.write_hex(tval)
    uart.write_str("\n")
    if CURRENT_THREAD != NO_THREAD {
        end_process(THREADS[CURRENT_THREAD].process, ProcessStatusKind.Faulted, 0,
                    ExitCode.UmodeFault as UInt)
    }
    // No process object yet: the harness kernels that enter user mode directly.
    hal.exit_fail(ExitCode.UmodeFault as UInt)
    while { }
}

// =============================================================================
// Fault reporting
// =============================================================================

/// Report a fatal condition on the console and FAIL the run. Never returns —
/// M0's discipline, carried into the user-mode split: a fault is diagnosed and
/// the machine stops non-zero, never a hang.
public func fatal(tag: String, cause: UInt, epc: UInt, tval: UInt, code: ExitCode) {
    let uart = console()
    uart.write_str("SOS: fault ")
    uart.write_str(tag)
    uart.write_str(" cause=")
    uart.write_hex(cause)
    uart.write_str(" epc=")
    uart.write_hex(epc)
    uart.write_str(" tval=")
    uart.write_hex(tval)
    uart.write_str("\n")
    hal.exit_fail(code as UInt)
}

// =============================================================================
// Syscall dispatch (spec §3, §5.7)
// =============================================================================

/// What one op did: a (status, value) pair for the caller, or the news that the
/// caller is not going to receive one YET.
///
/// `blocked` is the third answer a syscall can give and it is not a failure. A
/// thread that parks in `Join` has made no mistake and gets no status; its pair
/// is written into its frame by whatever wakes it, exactly once. Modelling that
/// as a field rather than as a magic status is what keeps the return path from
/// having to know which ops can park.
struct SyscallResult {
    status: SosStatus,
    value: UInt,
    blocked: Bool,
}

func op_ok() -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: 0, blocked: false)
}

func op_value(v: UInt) -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: v, blocked: false)
}

func op_status(s: SosStatus) -> SyscallResult {
    SyscallResult(status: s, value: 0, blocked: false)
}

func op_blocked() -> SyscallResult {
    SyscallResult(status: SosStatus.Ok, value: 0, blocked: true)
}

/// THE ONE PLACE a syscall's answer is written into a thread's frame.
///
/// A funnel rather than a rule repeated per caller, because the writers are not
/// all on the return path: an op that PARKS is answered later, by whatever wakes
/// it, and "later" is a different function each time. Its ENTRY POINTS, all of
/// them:
///
///   - `ktrap`, for an op that answered immediately;
///   - `exit_thread`, waking everything that joined the thread that just left;
///   - `wake_one_waiter`, handing a ready attachment to a parked waiter (§2.2).
///
/// Each writes EXACTLY ONCE for one syscall, which is the invariant the whole
/// blocking protocol rests on: a blocked caller is skipped on the return path
/// precisely so that its waker is the only writer, and a second write would
/// step the saved PC twice on the profile that steps it at all.
///
/// It answers with a (status, value) pair and nothing wider. An op whose answer
/// does not fit — `Waiter.Wait`'s record is the first — writes the rest into the
/// caller's own memory through `copy_out` and returns a status here, which is
/// what keeps the register convention (§5.7) the same shape it was in M1.
func write_result(frame_addr: UInt, result: SyscallResult) unsafe {
    hal.syscall_return(frame_addr, (result.status as UInt8) as UInt,
                       result.value)
}

// -----------------------------------------------------------------------------
// COPY-OUT: the one door from kernel memory into a process's
// -----------------------------------------------------------------------------
//
// This is SOS's FIRST kernel-writes-userspace path, and it is built as a funnel
// on the first use rather than after the third, because the shape of what
// follows is already known: spec §2.1 has a Channel `receive` copying a message
// body into the receiver's address space, and that is the same operation with a
// bigger length.
//
// WHAT IT REFUSES, and why each is a FAULT rather than a status (design 178's
// ruling — a caller error the process could have checked ends it):
//
//   - a destination that is not word-aligned. The kernel writes machine words;
//     a misaligned store traps on one profile and is merely wrong on the other,
//     and neither is something to discover at the wake.
//   - a destination outside the process's WRITABLE window. A process asking the
//     kernel to place a record in its own code has misread its own memory map.
//
// A process knows where its own writable memory is — it linked the image — so
// both are caller-checkable in the strongest sense.
//
// M2 IS ONE ADDRESS SPACE, and that is what makes the write a plain copy: the
// writer may be a DIFFERENT thread from the one that asked (a signaller waking
// a parked waiter), and both are in the same process today. When M3 brings
// several address spaces, the mapping switch goes HERE — this function is the
// only place the kernel dereferences a user address, which is precisely the
// property that makes that a one-place change.

/// Word alignment, from the machine rather than from a constant. A function
/// because `sizeof` does not fold in a static initializer — DF-178f, the same
/// gap `sosabi`'s `wait_record_bytes` works around, and it folds fine here.
func word_bytes() -> UInt {
    sizeof<UInt>() as UInt
}

/// Validate a destination the kernel is about to write, or TERMINATE the
/// process. Never returns on a bad buffer.
///
/// Split out from `copy_out` for exactly one caller: `Waiter.Wait` validates
/// when it PARKS, so that a bad buffer ends the process that supplied it while
/// that process is still the running one, rather than at some later wake in
/// another thread's context. Every other consumer validates and copies in one
/// step, which is what `copy_out` is.
func copy_out_check(p: Int, dst: UInt, bytes: UInt) unsafe {
    if (dst % word_bytes()) != 0 {
        fault_process(p, FaultReason.BadAlign)
    }
    if dst < PROCESSES[p].rw_base {
        fault_process(p, FaultReason.BadBuffer)
    }
    // Ordered so the subtraction below cannot underflow: `rw_top - dst` is only
    // computed once `dst` is known to be inside the window. A hostile length
    // must produce a diagnostic, not a panic — the loader's own discipline.
    if dst >= PROCESSES[p].rw_top {
        fault_process(p, FaultReason.BadBuffer)
    }
    if bytes > PROCESSES[p].rw_top - dst {
        fault_process(p, FaultReason.BadBuffer)
    }
}

/// Copy `bytes` from kernel memory at `src` into process `p` at `dst`.
///
/// THE ONE DOOR. Its consumers, current and intended:
///
///   - `Waiter.Wait` (here, both paths — the ready one and the wake);
///   - the Interrupt object's wait result, when that lands;
///   - M3's Channel `receive`, which is §2.1's message body and the reason this
///     is a general copy rather than a record writer.
///
/// Nothing else in the kernel may dereference a user address. That is the whole
/// rule, and it is one function long so it stays checkable by reading.
func copy_out(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe {
    copy_out_check(p, dst, bytes)
    copy_bytes(dst, src, bytes)
}

// -----------------------------------------------------------------------------
// COPY-IN: the one door from a process's memory into the kernel's
// -----------------------------------------------------------------------------
//
// THE MIRROR TWIN OF `copy_out`, and it is built as a funnel on its first use
// for the same reason that one was: the shape of what follows is already known.
// Spec §2.1 has a Channel `send` copying a message BODY out of the sender's
// address space, and that is this operation with a bigger length — so design
// 232 unit 1 builds the door, and `Timer.Arm` is its small first consumer
// exactly as `Waiter.Wait` was for copy-out.
//
// WHY AN OP NEEDS IT AT ALL. §5.7 gives an op three argument registers. A
// nanosecond time is 64 bits — anything narrower wraps in four seconds — so
// `arm`'s (first deadline, interval) pair is FOUR words on a 32-bit profile.
// The arguments do not fit, and widening the register convention would widen it
// for every op forever to suit one.
//
// WHAT IT REFUSES, and why each is a FAULT rather than a status (design 178's
// ruling — a caller error the process could have checked ends it):
//
//   - a source that is not word-aligned. Same rule the copy-out door applies,
//     and stated once so a caller learns ONE alignment rule for kernel records
//     rather than one per direction.
//   - a source outside the process's own memory. A process asking the kernel to
//     read a record from an address it does not own has misread its own memory
//     map — and this is the check that stops it naming KERNEL memory, which is
//     the whole reason the door exists.
//
// THE WINDOW IS THE WHOLE GRANTED REGION, NOT THE WRITABLE ONE, and the
// asymmetry with `copy_out` is deliberate. A process may legitimately hand the
// kernel a record out of its own RODATA — a constant schedule is exactly the
// thing a driver would write — so demanding a writable source would refuse
// correct programs. The hazard the two doors guard against is not the same one:
// writing outside the writable window CORRUPTS the process, while reading
// outside the granted region READS SOMEBODY ELSE, so each door checks the
// window that answers its own question.
//
// M2 WAS ONE ADDRESS SPACE and M3 is about to stop being. When it does, the
// mapping switch goes HERE and in `copy_out` and nowhere else — between them
// they are the only two places the kernel dereferences a user address, which is
// precisely the property that makes that a two-place change instead of a sweep.

/// Copy `bytes` from process `p` at `src` into kernel memory at `dst`, or
/// TERMINATE the process. Never returns on a bad buffer.
///
/// THE ONE DOOR INWARD. Its consumers, current and intended:
///
///   - `timer_arm` (design 232 unit 1), the (after, interval) pair;
///   - M4's Channel `send`, which is §2.1's message body and the reason this is
///     a general copy rather than a record reader.
///
/// Nothing else in the kernel may dereference a user address for reading. That
/// is the whole rule, and it is one function long so it stays checkable by
/// reading.
///
/// There is deliberately no `copy_in_check` split beside `copy_out_check`. That
/// split exists for exactly one caller — `Waiter.Wait`, which validates a
/// destination when it PARKS and writes it much later — and no inbound op can
/// have that shape: a copy-in happens while the calling process is still the
/// running one, by construction, because its arguments are what the op is
/// about. A door that cannot be used late needs no early check.
func copy_in(p: Int, dst: UInt, src: UInt, bytes: UInt) unsafe {
    if (src % word_bytes()) != 0 {
        fault_process(p, FaultReason.BadAlign)
    }
    if src < PROCESSES[p].region_base {
        fault_process(p, FaultReason.BadBuffer)
    }
    // Ordered so the subtraction below cannot underflow, exactly as the
    // outbound door orders its own: `region_top - src` is computed only once
    // `src` is known to be inside the region. A hostile length must produce a
    // diagnostic, not a panic.
    if src >= PROCESSES[p].region_top {
        fault_process(p, FaultReason.BadBuffer)
    }
    if bytes > PROCESSES[p].region_top - src {
        fault_process(p, FaultReason.BadBuffer)
    }
    copy_bytes(dst, src, bytes)
}

/// The calling process. In M2 that is the process of the running thread, and
/// before there are threads it is the only process there is — the harness
/// kernels that enter user mode with no object model still make syscalls.
func calling_process() unsafe -> Int {
    if CURRENT_THREAD == NO_THREAD {
        return 0
    }
    THREADS[CURRENT_THREAD].process
}

/// The System object's ops (§2). Returns a status; `shutdown` does not return
/// at all.
///
/// `op` arrives as the raw register word, which a process chooses, so it is
/// DECODED rather than compared: `SystemOp.from(raw:)` accepts exactly the numbers
/// that are ops and hands back `None` for every other, which is both the range
/// check and the dispatch in one step. The `match` is then exhaustive, so adding
/// an op to `sosabi` makes this function fail to compile until it is handled —
/// which is what the old `op > OP_SYSTEM_MAX` test could never do.
///
/// AN UNKNOWN OP AND A MISSING RIGHT BOTH TERMINATE THE PROCESS (design 178's
/// faults ruling). Both are mistakes the caller could have checked: it chose
/// the number, and it knows which rights it holds.
func system_op(raw_op: UInt, obj: &SystemObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = SystemOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return system_op_decoded(op, &obj, arg0, p)
}

func system_op_decoded(op: SystemOp, obj: &SystemObject, arg0: UInt,
                       p: Int) unsafe -> SyscallResult {
    match op {
        // The rights check is per-OP, not per-object: holding the System
        // handle is not the same as being allowed to use every part of it.
        case DebugPrint -> {
            if not obj.allows(SystemRight.Debug) {
                fault_process(p, FaultReason.AccessDenied)
            }
            hal.console_byte((arg0 & BYTE_MASK) as UInt8)
            op_ok()
        },
        // Stop the machine with `arg0` as the status. NOT process exit, which
        // is `ProcessOp.Exit` — this is the whole machine, and it is what the
        // harness kernels with no Process object still use to finish a run.
        case Shutdown -> {
            if not obj.allows(SystemRight.Shutdown) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if arg0 == 0 {
                hal.exit_pass()
            } else {
                hal.exit_fail(arg0)
            }
            op_ok()
        },
        // §3's derivation rule, made real: the boot handle set is one handle
        // wide and everything else is obtained THROUGH it. A process asks the
        // System object which Process it is, and the Process object which
        // Thread — so the kernel never has to widen the entry register, and a
        // process that was given no System handle has no way to name either.
        case ProcessSelf -> {
            if not obj.allows(SystemRight.Manage) {
                fault_process(p, FaultReason.AccessDenied)
            }
            op_value(PROCESSES[p].self_handle)
        },
        // TIME IS A GRANTED CAPABILITY (design 232 unit 1, the M3 time notes).
        // A process that was not given this right cannot read the machine's
        // clock at all — which is what makes handing a child a VIRTUAL clock
        // over IPC a substitution rather than a rewrite, since a child holding
        // no kernel Clock has no second way to ask.
        case ClockGet -> {
            if not obj.allows(SystemRight.ClockGet) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_get(p, arg0)
        },
    }
}

/// Hand process `p` its Clock for the domain `raw_kind` names (§2's Clock row).
///
/// The DOMAIN arrives as a raw register word the process chose, so it is decoded
/// rather than trusted, on `event_create`'s precedent exactly: a number that is
/// not a `ClockType` is a caller error the process could have checked, which
/// under design 178's faults ruling ends it. v1 declares one domain, so every
/// number but zero lands here.
func clock_get(p: Int, raw_kind: UInt) unsafe -> SyscallResult {
    guard let kind = ClockType.from(raw: raw_kind) else { fault_process(p, FaultReason.BadArg) }
    return clock_get_typed(p, kind)
}

/// FIND OR CREATE, and the find is what makes this a getter rather than a
/// factory.
///
/// A machine has ONE monotonic clock, so two Clock objects naming it would be
/// two names for one thing — which is what §3's no-duplicate rule exists to
/// prevent. Asking twice is therefore a QUERY that answers with the same handle,
/// exactly as `ProcessSelf` does, and an op that cannot allocate on repetition
/// is one no quota row has to bound when quotas land in M3 unit 5.
func clock_get_typed(p: Int, kind: ClockType) unsafe -> SyscallResult {
    var i: Int = 0
    while i < MAX_CLOCKS {
        match CLOCKS[i].state {
            case Live -> {
                if CLOCKS[i].process == p && CLOCKS[i].kind == kind {
                    return op_value(clock_handle_of(p, i))
                }
            },
            case Free -> {},
        }
        i = i + 1
    }

    let slot = alloc_clock()
    if slot == NO_CLOCK {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Clock, clock_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }
    // Written only once BOTH allocations succeeded, so a refused handle leaves
    // the slab exactly as it found it — `event_create`'s all-or-nothing shape.
    CLOCKS[slot] = ClockSlot(state: SlotState.Live, process: p, kind: kind)
    op_value(handle)
}

/// The handle in `p`'s table naming clock slot `slot`.
///
/// A SEARCH rather than a field on the slot, and the asymmetry with
/// `ProcessSlot.self_handle` is the honest one: a process has exactly one
/// Process handle by construction, so caching it is caching a fact. A Clock's
/// handle is merely the one this table happens to hold, and a second copy of
/// it here would be a place to go stale once handles can be closed and
/// re-minted. The table is the truth; at sixteen entries the walk is cheaper
/// than the invalidation rule would be.
func clock_handle_of(p: Int, slot: Int) unsafe -> UInt {
    var h: Int = 0
    while h < MAX_HANDLES {
        let entry = HANDLES[p * MAX_HANDLES + h]
        match entry.obj_type {
            case Clock -> {
                if entry.target == slot {
                    return (h as UInt) + 1
                }
            },
            case _ -> {},
        }
        h = h + 1
    }
    NO_HANDLE
}

/// The Process object's ops (§2, §7, §8; design 178 D4).
func process_op(raw_op: UInt, obj: &ProcessObject,
                arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ProcessOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return process_op_decoded(op, &obj, arg0, arg1, arg2, p)
}

func process_op_decoded(op: ProcessOp, obj: &ProcessObject,
                        arg0: UInt, arg1: UInt, arg2: UInt,
                        p: Int) unsafe -> SyscallResult {
    match op {
        case ThreadCreate -> {
            if not obj.allows(ProcessRight.ThreadCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            thread_create(obj.slot, arg0, arg1, arg2)
        },
        case ThreadSelf -> {
            if not obj.allows(ProcessRight.Manage) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if CURRENT_THREAD == NO_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            op_value(THREADS[CURRENT_THREAD].self_handle)
        },
        // Spec §5.7, ratified Aug 5: process exit belongs HERE and not on the
        // System object. Every thread of the process goes with it (§8's
        // teardown is unconditional), so this never returns.
        case Exit -> {
            if not obj.allows(ProcessRight.Exit) {
                fault_process(p, FaultReason.AccessDenied)
            }
            // `end_process` stops the machine, so this arm diverges and owes
            // the `match` no value.
            end_process(obj.slot, ProcessStatusKind.Exited, arg0, arg0)
        },
        // §8's ONE fixed-width status word: kind in the high bits, code in the
        // low ones. A process asking about itself always reads `Running`, which
        // is the honest answer and the only one M2 can produce — the interesting
        // reader is a supervisor holding somebody else's handle, and that needs
        // the second process M3 loads.
        case GetStatus -> {
            if not obj.allows(ProcessRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            op_value(process_status_word(PROCESSES[obj.slot].exit_kind,
                                      PROCESSES[obj.slot].exit_code))
        },
        // The creation authority for §2's plain objects, answering spec §12's
        // open pin the way `ThreadCreate` already does: it flows through a
        // handle the process holds, so it is §3's derivation rule rather than a
        // new mechanism beside it. See `ProcessRight`.
        case EventCreate -> {
            if not obj.allows(ProcessRight.EventCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            event_create(obj.slot, arg0)
        },
        case WaiterCreate -> {
            if not obj.allows(ProcessRight.WaiterCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_create(obj.slot)
        },
        // Binding an IRQ line is the strongest of the creation authorities, and
        // it flows through the same handle for the same reason: the Process
        // object is what an Interrupt is charged to, and a bit is what a
        // launcher strips from everything that is not a driver.
        case InterruptBind -> {
            if not obj.allows(ProcessRight.InterruptBind) {
                fault_process(p, FaultReason.AccessDenied)
            }
            interrupt_bind(obj.slot, arg0)
        },
    }
}

/// Make an Event in process `slot` (spec §2.4).
///
/// The MODE arrives as a raw register word the process chose, so it is decoded
/// rather than trusted: a number that is not a mode is a caller error the
/// process could have checked, which under design 178's faults ruling ends it.
func event_create(p: Int, raw_mode: UInt) unsafe -> SyscallResult {
    guard let mode = EventMode.from(raw: raw_mode) else { fault_process(p, FaultReason.BadArg) }
    return event_create_moded(p, mode)
}

func event_create_moded(p: Int, mode: EventMode) unsafe -> SyscallResult {
    let slot = alloc_event()
    if slot == NO_EVENT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Event, event_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }
    // Written only once BOTH allocations succeeded, so a refused handle leaves
    // the slab exactly as it found it — the all-or-nothing shape design 123
    // asks of a `try_` op, for the same reason.
    EVENTS[slot] = EventSlot(state: SlotState.Live, process: p, mode: mode,
                             word: 0, attachment: 0)
    op_value(handle)
}

/// The Interrupt bound to `line`, or `NO_INTERRUPT`.
///
/// A SCAN over four slots, and it is what turns the trap path's line number
/// back into an object. Keeping a line -> slot map instead would be a second
/// description of the same fact — the bindings are already in the table, and
/// the table is the only place a line may be bound twice, which `interrupt_bind`
/// refuses using exactly this walk.
func interrupt_by_line(line: UInt) unsafe -> Int {
    var i: Int = 0
    while i < MAX_INTERRUPTS {
        match INTERRUPTS[i].state {
            case Live -> {
                if INTERRUPTS[i].line == line {
                    return i
                }
            },
            case Free -> {},
        }
        i = i + 1
    }
    NO_INTERRUPT
}

/// Bind `line` to a new Interrupt in process `p` (spec §2 table, §9).
///
/// THREE REFUSALS, all faults, all caller-checkable:
///
///   - a line THIS MACHINE does not have. The board's line space is documented
///     per profile and a driver names a number out of its own device's
///     description, so a number outside it is a mistake the caller could have
///     checked.
///   - the TIMER's line. It is the scheduler's, and a process holding it could
///     mask the tick and never yield — which is not a capability the object
///     model offers, so asking for it is a caller error rather than a refusal
///     to branch on. It is checked HERE, arch-free, because it is a KERNEL
///     policy: which number the timer uses is the machine's business, that it
///     is not for rent is not.
///   - a line ALREADY BOUND. Two Interrupts on one line would be two objects
///     with one `pending` between them and two acks for one fire, so the second
///     bind is refused rather than serialized.
///
/// The line is UNMASKED on success, which is the initial state §9's cycle needs:
/// mask-on-fire, ack-to-rearm, so something has to arm it first and creation is
/// that something. The DEVICE's own interrupt-enable register is not touched —
/// that is the driver's, through the window it was granted.
func interrupt_bind(p: Int, line: UInt) unsafe -> SyscallResult {
    if line == hal.IRQ_TIMER || not hal.irq_line_valid(line) {
        fault_process(p, FaultReason.BadArg)
    }
    if interrupt_by_line(line) != NO_INTERRUPT {
        fault_process(p, FaultReason.LineBound)
    }

    let slot = alloc_interrupt()
    if slot == NO_INTERRUPT {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Interrupt, interrupt_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }
    INTERRUPTS[slot] = InterruptSlot(state: SlotState.Live, process: p,
                                     line: line, pending: false, attachment: 0)
    hal.irq_unmask(line)
    op_value(handle)
}

/// Make a Waiter in process `slot` (spec §2.2).
func waiter_create(p: Int) unsafe -> SyscallResult {
    let slot = alloc_waiter()
    if slot == NO_WAITER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Waiter, waiter_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }
    WAITERS[slot] = WaiterSlot(state: SlotState.Live, process: p, attached: 0,
                               blocked: 0)
    op_value(handle)
}

/// Make a thread in process `slot`, ready to be started.
///
/// The entry and the stack are CHECKED against the process's granted region.
/// Both are caller-checkable — a process knows where its own image and its own
/// stacks are — so a bad one terminates it rather than producing a thread that
/// would fault on its first instruction and take the process down anyway, with
/// a worse diagnostic.
func thread_create(p: Int, entry: UInt, stack_top: UInt, arg: UInt) unsafe -> SyscallResult {
    let start = if entry == ENTRY_IMAGE { PROCESSES[p].entry } else { entry }
    if start < PROCESSES[p].region_base || start >= PROCESSES[p].region_top {
        fault_process(p, FaultReason.BadEntry)
    }
    if stack_top <= PROCESSES[p].region_base || stack_top > PROCESSES[p].region_top {
        fault_process(p, FaultReason.BadEntry)
    }

    let slot = alloc_thread()
    if slot == NO_THREAD {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Thread, thread_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }

    hal.frame_init(frame_slot(slot), start, stack_top, arg)
    THREADS[slot] = ThreadSlot(state: ThreadState.Created, process: p,
                               self_handle: handle, exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0)
    op_value(handle)
}

/// The Thread object's ops (§2, §8; design 178 D4).
///
/// `Exit` and `Yield` are ops a thread performs on ITSELF, so both check that
/// the handle names the caller. That check is the faults ruling's `NotSelf`:
/// driving another thread's execution is not something the object model offers,
/// and a process that tries has misread its own handles.
func thread_op(raw_op: UInt, obj: &ThreadObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ThreadOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return thread_op_decoded(op, &obj, arg0, p)
}

func thread_op_decoded(op: ThreadOp, obj: &ThreadObject, arg0: UInt,
                       p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        case Start -> {
            if not obj.allows(ThreadRight.Start) {
                fault_process(p, FaultReason.AccessDenied)
            }
            match THREADS[target].state {
                case Created -> {},
                case _ -> fault_process(p, FaultReason.BadState),
            }
            THREADS[target].state = ThreadState.Runnable
            ready_push(target)
            op_ok()
        },
        case Join -> {
            if not obj.allows(ThreadRight.Join) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target == CURRENT_THREAD {
                fault_process(p, FaultReason.BadState)
            }
            match THREADS[target].state {
                // Already gone: the answer is in the slot, so nothing parks.
                case Exited -> op_value(THREADS[target].exit_code),
                case Free -> fault_process(p, FaultReason.BadState),
                case _ -> {
                    block_on_join(CURRENT_THREAD, target)
                    op_blocked()
                },
            }
        },
        case Exit -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            exit_thread(target, arg0)
            // No pair is ever written: this thread does not resume.
            op_blocked()
        },
        case Yield -> {
            if not obj.allows(ThreadRight.Control) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if target != CURRENT_THREAD {
                fault_process(p, FaultReason.NotSelf)
            }
            // The yielder DOES resume, right after the trapping instruction, so
            // its pair is written now; the requeue is `pick_next`'s, which is
            // the one place a thread is put back on the ready queue.
            NEED_RESCHED = true
            op_ok()
        },
    }
}

/// The Event object's ops (spec §2.4; design 178 D5).
func event_op(raw_op: UInt, obj: &EventObject, arg0: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = EventOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return event_op_decoded(op, &obj, arg0, p)
}

func event_op_decoded(op: EventOp, obj: &EventObject, arg0: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // NEVER BLOCKS and never fails (§2.4): whatever the word holds, more
        // bits fit — the OR mode is idempotent and the sum saturates. That is
        // what makes it the fire-and-forget primitive, and it is why there is
        // no status here to branch on.
        case Signal -> {
            if not obj.allows(EventRight.Signal) {
                fault_process(p, FaultReason.AccessDenied)
            }
            signal_event(target, arg0)
            op_ok()
        },
        // DRAINS AND RESETS, in one operation (§2.4) — THE NON-BLOCKING DOOR of
        // the two a take can come through, and its semantics are exactly what
        // they always were. Reading an empty event answers zero rather than
        // parking: an Event is not a queue, and blocking is the Waiter's job.
        // The blocking door is a `Waiter.wait` delivery, which consumes the same
        // word the same way (`waitable_consume`); a process picks a door by
        // whether it wants to park, never by what it will be told.
        case Receive -> {
            if not obj.allows(EventRight.Receive) {
                fault_process(p, FaultReason.AccessDenied)
            }
            let word = EVENTS[target].word
            EVENTS[target].word = 0
            op_value(word)
        },
    }
}

/// The Interrupt object's ops (spec §2 table, §9; design 178 D6).
func interrupt_op(raw_op: UInt, obj: &InterruptObject) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = InterruptOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return interrupt_op_decoded(op, &obj, p)
}

func interrupt_op_decoded(op: InterruptOp, obj: &InterruptObject,
                          p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // §9's ACK: end this fire and let the device interrupt again.
        //
        // ACKING SOMETHING THAT HAS NOT FIRED IS A FAULT, and it is worth
        // saying why that is caller-checkable rather than harsh. §9 puts at
        // most one unacked fire per Interrupt, and the driver learns about that
        // fire by being told — through a wait it made. So an ack with nothing
        // pending is a driver that acked twice for one fire, or acked before it
        // waited: in both cases the NEXT ack lands on a fire nobody serviced,
        // which is a dropped byte or a wedged device somewhere downstream. A
        // tolerated no-op here would turn that into a bug with no first
        // symptom.
        //
        // THE UNMASK IS LAST, and the order is spec §9's release discipline
        // read from the kernel's side: everything that touches this object's
        // state happens before the line can fire again.
        case Ack -> {
            if not obj.allows(InterruptRight.Ack) {
                fault_process(p, FaultReason.AccessDenied)
            }
            if not INTERRUPTS[target].pending {
                fault_process(p, FaultReason.BadState)
            }
            INTERRUPTS[target].pending = false
            hal.irq_unmask(INTERRUPTS[target].line)
            op_ok()
        },
    }
}

/// The record `Clock.Now` answers with, in kernel memory (design 232 unit 1).
///
/// Declaration order IS the layout (design 58), so the field here and the
/// doubleword index `sosabi` publishes are one description — pinned by the
/// assert below rather than by agreement.
struct ClockNowRecord {
    now_ns: UInt64,
}

static_assert(sizeof<ClockNowRecord>()
              == CLOCK_NOW_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the clock reading must be exactly the doublewords sosabi publishes")

/// The record `Timer.Arm` READS out of the caller's memory. Same discipline,
/// running the other way.
struct TimerArmRecord {
    after_ns: UInt64,
    interval_ns: UInt64,
}

static_assert(sizeof<TimerArmRecord>()
              == TIMER_ARM_RECORD_DOUBLEWORDS * sizeof<UInt64>(),
              "the arm record must be exactly the doublewords sosabi publishes")

/// The Clock object's ops (spec §2 table; design 232 unit 1).
func clock_op(raw_op: UInt, obj: &ClockObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = ClockOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return clock_op_decoded(op, &obj, arg0, arg1, p)
}

func clock_op_decoded(op: ClockOp, obj: &ClockObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    match op {
        // THE ANSWER IS A RECORD, not the value register, because a nanosecond
        // count is 64 bits and one of the two profiles has 32-bit registers.
        // It rides the same copy-out door `Waiter.Wait`'s answer does — the
        // door checks the buffer, so nothing here has to.
        case Now -> {
            if not obj.allows(ClockRight.Read) {
                fault_process(p, FaultReason.AccessDenied)
            }
            clock_now(p, arg0, arg1)
        },
        // The Timer BINDS THIS CLOCK at creation (the M3 time notes), which is
        // why creation lives on the Clock rather than on the Process beside the
        // other factory ops: the authority and the binding are one act, and a
        // Timer made through a Process handle would have no domain to measure
        // against.
        case TimerCreate -> {
            if not obj.allows(ClockRight.TimerCreate) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_create(p, obj.slot)
        },
    }
}

/// Read the clock into the caller's buffer.
func clock_now(p: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is an argument outside its domain —
    // the size is published, so the caller could have checked. `Waiter.Wait`'s
    // rule, and the same diagnostic.
    if cap < (clock_now_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var rec = ClockNowRecord(now_ns: hal.timer_now_ns())
    copy_out(p, dst, ((&var rec) as UnsafePointer<ClockNowRecord>) as UInt,
             clock_now_record_bytes() as UInt)
    op_ok()
}

/// Make a Timer bound to clock `c` in process `p` (spec §2 table).
func timer_create(p: Int, c: Int) unsafe -> SyscallResult {
    let slot = alloc_timer()
    if slot == NO_TIMER {
        return op_status(SosStatus.NoResource)
    }
    let handle = mint_handle(p, ObjType.Timer, timer_rights(), slot)
    if handle == NO_HANDLE {
        return op_status(SosStatus.NoResource)
    }
    // Born DISARMED and owing nothing: a Timer is a schedule you have not
    // written yet, so it is not ready, and attaching one to a Waiter before
    // arming it parks rather than reporting.
    TIMERS[slot] = TimerSlot(state: SlotState.Live, process: p, clock: c,
                             armed: false, deadline_ns: 0, interval_ns: 0,
                             fires: 0, attachment: 0)
    op_value(handle)
}

/// The Timer object's ops (spec §2 table; design 232 unit 1).
func timer_op(raw_op: UInt, obj: &TimerObject, arg0: UInt,
              arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = TimerOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return timer_op_decoded(op, &obj, arg0, arg1, p)
}

func timer_op_decoded(op: TimerOp, obj: &TimerObject, arg0: UInt, arg1: UInt,
                      p: Int) unsafe -> SyscallResult {
    let target = obj.slot

    match op {
        // ONE RIGHT FOR BOTH, because they are one capability: the power to
        // decide when this timer fires. See `TimerRight`.
        case Arm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_arm(p, target, arg0, arg1)
        },
        case Disarm -> {
            if not obj.allows(TimerRight.Arm) {
                fault_process(p, FaultReason.AccessDenied)
            }
            timer_disarm(target)
        },
    }
}

// -----------------------------------------------------------------------------
// A TIMER'S OWN VERBS (ruled Aug 17, user; design 212's extraction idiom)
// -----------------------------------------------------------------------------
//
// EVERY MULTI-FIELD OPERATION ON A TIMER IS A METHOD ON THE SLOT, and the ops
// below index the slab and call one — `TIMERS[slot].fire(now)` where there used
// to be five `TIMERS[slot].<field>` fetches in a row. Design 212's rule (a
// 2+-hop chain spelled three times wants extraction) with a RECEIVER rather than
// a reference parameter, because a slot is a type and these are its verbs.
//
// AND THE `unsafe` EFFECT RETREATS TO THE CALL SITES. `TIMERS` is an
// `unsafe static var`, so every function that NAMES it is declared `unsafe`
// (design 130/136) — but `TimerSlot` is an ordinary safe type, so a body working
// through `self` names nothing unsafe and is a SAFE function. What is left
// inside an unsafe body is the indexing, which is where the compound global
// state actually is; the arithmetic a reviewer most wants to check is now
// outside it, and the compiler agrees rather than being asked to take it on
// trust.
//
// A SINGLE FIELD ACCESS IS LEFT ALONE (`TIMERS[t].armed` in the idle rule, the
// whole-slot writes in `timer_create` and teardown): wrapping one load in a
// method buys a name for something that already had one.
extension TimerSlot {
    /// Replace this timer's whole schedule: fire at `deadline`, then every
    /// `interval` nanoseconds (0 being a one-shot).
    ///
    /// **ARMING REPLACES, AND IT IS NOT AN ERROR** (pinned here, design 232 unit
    /// 1). Arming a timer that is already armed discards the old schedule
    /// wholesale — new deadline, new interval — AND CLEARS THE FIRE COUNT,
    /// because a count carried forward would be owed against a schedule the
    /// caller just threw away. It is deliberately not a fault: re-arming a
    /// running timer is the ordinary way to change a timeout, which is the shape
    /// M4's select-with-timeout is made of, and refusing it would make the
    /// common idiom unwritable.
    func arm(&var self, deadline: UInt64, interval: UInt64) {
        self.armed = true
        self.deadline_ns = deadline
        self.interval_ns = interval
        self.fires = 0
    }

    /// This timer is off and owes nothing.
    ///
    /// It clears the FIRE COUNT as well as the schedule, which is what makes it
    /// a clean cancel: a caller who wants the fires reads them with a wait
    /// first. Why disarming an UNARMED timer is a no-op rather than a fault is
    /// `timer_disarm`'s business, since that is the question the OP answers.
    func disarm(&var self) {
        // The `u64` suffixes are owed to DF-232a and should come off when it
        // closes: a bare literal does NOT adopt the expected fixed-width type in
        // plain assignment position (it does in an annotation, a struct literal
        // and a compound assignment), and on a 32-bit profile the mismatch is an
        // INTERNAL COMPILER ERROR rather than a diagnostic. The suffix is the
        // documented spelling for a literal no expected type reaches, which is
        // exactly what these are until the gap is fixed.
        self.armed = false
        self.deadline_ns = 0u64
        self.interval_ns = 0u64
        self.fires = 0
    }

    /// Has this timer come due by `now`? An unarmed one never has.
    func is_due(&self, now: UInt64) -> Bool {
        self.armed && self.deadline_ns <= now
    }

    /// The SOONER of `deadline` and this timer's own — the fold
    /// `earliest_timer_deadline` is written as. An unarmed timer answers
    /// `deadline` unchanged, because a schedule nobody wrote is not a deadline
    /// the hardware has to be programmed for.
    func sooner_of(&self, deadline: UInt64) -> UInt64 {
        if self.armed && self.deadline_ns < deadline { self.deadline_ns } else { deadline }
    }

    /// This timer came due: count the fire, and re-arm it if it is periodic.
    ///
    /// **DRIFT-FREE, AND THE ARITHMETIC IS WHERE THAT LIVES.** The next deadline
    /// is measured from THIS DEADLINE, never from `now` — so a fire the kernel
    /// was late for shortens the next gap instead of pushing every later one
    /// out, and a timer armed at 1 ms is still on the millisecond a thousand
    /// fires later. That is the timerfd model, and it is the exact OPPOSITE of
    /// the scheduler tick's rule (`on_timer_interrupt` measures from now)
    /// because the two want opposite things: a timeslice has no history to be
    /// faithful to, and an interval does.
    ///
    /// **MISSED FIRES COALESCE, BY DIVISION RATHER THAN BY A LOOP.** A consumer
    /// that was descheduled across several periods gets ONE wake carrying HOW
    /// MANY, which is what stops it either falling permanently behind a queue of
    /// fires or silently losing them. Computing the count with a division rather
    /// than advancing the deadline in a `while` is what keeps this bounded: an
    /// interval far shorter than the machine can serve costs one divide, not a
    /// spin — so there is no long loop here for design 232 unit 1.5's preemption
    /// points to have to cover, and no minimum interval anyone has to invent.
    func fire(&var self, now: UInt64) {
        let interval = self.interval_ns
        if interval == 0 {
            // A ONE-SHOT DISARMS ITSELF. There is no schedule left, so the
            // object goes quiet after one fire and a later `disarm` finds
            // nothing to do — which is exactly the race `timer_disarm`
            // documents.
            self.armed = false
            self.fires = saturating_add(self.fires, 1)
        } else {
            let late = now - self.deadline_ns
            let missed = (late / interval) + 1
            // The PRODUCT cannot overflow: when `interval` exceeds `late`,
            // `missed` is 1 and the product is the interval itself; otherwise
            // `missed` is bounded by `late / interval`, so the product is at
            // most `late + interval` with both terms real times.
            let step = missed * interval
            // The SUM can, and a process chose the number that makes it — an
            // interval near the end of time pushes the next deadline past it.
            // Saw's overflow checks are always on, so an unguarded `+` here
            // would PANIC THE KERNEL on a value userspace picked, which is a
            // denial of service wearing an arithmetic bug's clothes. Saturating
            // is also the honest answer: a deadline past the end of time is one
            // nothing will see fire.
            let base = self.deadline_ns
            self.deadline_ns = if step > NEVER_NS - base { NEVER_NS } else { base + step }
            self.fires = saturating_add(self.fires, fires_word(missed))
        }
    }
}

/// §2's `arm(after, interval)`, taken through the COPY-IN door.
///
/// THE OP IS THE DOOR AND THE SCHEDULE IS THE SLOT'S: everything below this line
/// is validating what a process handed over and turning a RELATIVE delay into an
/// absolute deadline. `TimerSlot.arm` is what the schedule then means, including
/// why re-arming an armed timer is legal.
func timer_arm(p: Int, slot: Int, src: UInt, bytes: UInt) unsafe -> SyscallResult {
    // The length is published, so a caller that got it wrong could have checked
    // — `Waiter.Wait`'s capacity rule, running inward. EXACT rather than
    // at-least: an inbound record is the whole of what the op was told, and a
    // caller handing over more than the kernel reads has misunderstood the
    // call rather than merely over-provisioned a buffer.
    if bytes != (timer_arm_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    var rec = TimerArmRecord(after_ns: 0, interval_ns: 0)
    copy_in(p, ((&var rec) as UnsafePointer<TimerArmRecord>) as UInt, src, bytes)

    let now = hal.timer_now_ns()
    // Saturating, because `now + after` is arithmetic on a number the PROCESS
    // chose and Saw's overflow checks are on in the kernel. A deadline that
    // would land past the end of time IS the end of time, which is a schedule
    // nothing will ever see fire — the honest answer, and not a panic.
    let deadline = if rec.after_ns > NEVER_NS - now { NEVER_NS } else { now + rec.after_ns }

    TIMERS[slot].arm(deadline, rec.interval_ns)
    reprogram_timer()
    op_ok()
}

/// §2's `disarm()`: this timer is off and owes nothing.
///
/// **DISARMING AN UNARMED TIMER IS A NO-OP, NOT A FAULT** (pinned here, design
/// 232 unit 1), and it is worth saying why that is the opposite call from §9's
/// ack-with-no-fire. An extra ACK is provably a bug: the only way to learn about
/// a fire is to be TOLD about one, so the caller had the information. A disarm's
/// precondition is not like that — a ONE-SHOT DISARMS ITSELF when it fires, so
/// "is it still armed" is kernel state that changed without the caller acting.
/// Cancelling a timeout that has just expired is the ordinary race at the heart
/// of every select-with-timeout, and faulting it would make the safe idiom
/// unwritable.
///
/// It clears the FIRE COUNT as well as the schedule, which is what makes it a
/// clean cancel: a caller who wants the fires reads them with a wait first.
func timer_disarm(slot: Int) unsafe -> SyscallResult {
    TIMERS[slot].disarm()
    reprogram_timer()
    op_ok()
}

/// The earliest deadline any armed Timer is waiting on, or `soonest` if none is
/// sooner. The Timer half of `reprogram_timer`'s question.
func earliest_timer_deadline(soonest: UInt64) unsafe -> UInt64 {
    var next = soonest
    var i: Int = 0
    while i < MAX_TIMERS {
        match TIMERS[i].state {
            case Live -> { next = TIMERS[i].sooner_of(next) },
            case Free -> {},
        }
        i = i + 1
    }
    next
}

/// Fire every Timer whose deadline `now` has reached.
func expire_timers(now: UInt64) unsafe {
    var i: Int = 0
    while i < MAX_TIMERS {
        match TIMERS[i].state {
            case Live -> {
                if TIMERS[i].is_due(now) {
                    fire_timer(i, now)
                }
            },
            case Free -> {},
        }
        i = i + 1
    }
}

/// One Timer came due: advance its schedule, and tell its Waiter.
///
/// TWO LINES, AND THE SPLIT IS THE POINT. `TimerSlot.fire` is the whole of the
/// drift-free re-arm and the coalescing division — arithmetic on one slot's own
/// fields, and a SAFE function for exactly that reason. What is left here is the
/// half that reaches the rest of the kernel: the slab index, and the wake.
func fire_timer(slot: Int, now: UInt64) unsafe {
    TIMERS[slot].fire(now)
    notify_ready(WaitableKind.Timer, slot)
}

/// Resolve `handle` as something this caller may ATTACH TO A WAITER, or
/// terminate the process.
///
/// THE ONE PLACE WAITABILITY IS DECIDED, and it decides the rights check with
/// it — because they are one question. Whether a handle may be attached depends
/// on its KIND, and which enum a rights word is read against depends on the
/// kind too (§3), so a separate `is_waitable` predicate would have to be joined
/// back to a per-kind rights check at every call site. Here the match that
/// establishes the kind is the match that spends the right.
///
/// Every case is spelled out rather than falling through a `_`, which is what
/// makes the next waitable kind — a Channel, a Timer, an Interrupt (§2.2), a
/// Thread or a Process (§8) — fail to compile until somebody answers for it.
func waitable_slot(p: Int, handle: UInt) unsafe -> Waitable {
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Event -> {
            let ev = EventObject(handle: EventHandle(handle),
                                 rights: entry.rights, slot: entry.target)
            if not ev.allows(EventRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Event, slot: entry.target)
        },
        // The second waitable kind, and the one the object model was built for:
        // §2.2 lists Interrupt among the waitables and §9's whole delivery
        // model is a driver parked on one. The right it spends is
        // `InterruptRight.Wait`, which is a different enum from the Event arm's
        // and is exactly why waitability and the rights check are one question.
        case Interrupt -> {
            let irq = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            if not irq.allows(InterruptRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Interrupt, slot: entry.target)
        },
        // The THIRD waitable kind (design 232 unit 1), and it cost this
        // function one arm and the matrix above one column — which is what the
        // M2 finale's refactor was for. The right it spends is `TimerRight.Wait`,
        // a third enum again, which is why waitability and the rights check stay
        // one question.
        case Timer -> {
            let t = TimerObject(handle: TimerHandle(handle),
                                rights: entry.rights, slot: entry.target)
            if not t.allows(TimerRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            Waitable(kind: WaitableKind.Timer, slot: entry.target)
        },
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> fault_process(p, FaultReason.NotWaitable),
        case Process -> fault_process(p, FaultReason.NotWaitable),
        case Thread -> fault_process(p, FaultReason.NotWaitable),
        case Waiter -> fault_process(p, FaultReason.NotWaitable),
        // A CLOCK IS NOT WAITABLE, and the arm is worth its line: a clock is
        // always running, so "ready" would either be permanently true or
        // meaningless. Waiting for a TIME is what the Timer it creates is for.
        case Clock -> fault_process(p, FaultReason.NotWaitable),
    }
}

/// The Waiter object's ops (spec §2.2; design 178 D5).
func waiter_op(raw_op: UInt, obj: &WaiterObject, arg0: UInt,
               arg1: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    guard let op = WaiterOp.from(raw: raw_op) else { fault_process(p, FaultReason.BadOp) }
    return waiter_op_decoded(op, &obj, arg0, arg1, p)
}

func waiter_op_decoded(op: WaiterOp, obj: &WaiterObject, arg0: UInt, arg1: UInt,
                       p: Int) unsafe -> SyscallResult {
    let w = obj.slot

    match op {
        case Add -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_add(p, w, arg0, arg1)
        },
        case Remove -> {
            if not obj.allows(WaiterRight.Attach) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_remove(p, w, arg0)
        },
        case Wait -> {
            if not obj.allows(WaiterRight.Wait) {
                fault_process(p, FaultReason.AccessDenied)
            }
            waiter_wait(p, w, arg0, arg1)
        },
    }
}

/// §2.2's `add(handle, key)`: a PERSISTENT attachment, at most one Waiter per
/// handle.
///
/// Attaching something already attached TERMINATES the process. It is the
/// ratified one-Waiter rule, and it is caller-checkable in the strongest sense
/// — the process is the only thing that attaches anything, so it knows.
func waiter_add(p: Int, w: Int, handle: UInt, key: UInt) unsafe -> SyscallResult {
    let target = waitable_slot(p, handle)
    if waitable_attachment(target.kind, target.slot) != 0 {
        fault_process(p, FaultReason.BadState)
    }
    // KEYS ARE UNIQUE PER WAITER (ruled Aug 16). A duplicate would make two
    // questions ambiguous at once — which attachment a `Remove` names, and
    // which one an answer came from — and the attacher chose both keys, so it
    // is caller-checkable in the strongest sense.
    if attached_by_key(w, key) != NO_ATTACHMENT {
        fault_process(p, FaultReason.DuplicateKey)
    }

    let a = alloc_attachment()
    if a == NO_ATTACHMENT {
        return op_status(SosStatus.NoResource)
    }
    ATTACHMENTS[a] = Attachment(state: SlotState.Live, kind: target.kind,
                                target: target.slot, waiter: w, key: key,
                                link: WAITERS[w].attached)
    WAITERS[w].attached = a + 1
    set_waitable_attachment(target.kind, target.slot, a + 1)

    // LEVEL-TRIGGERED, at the attach (§2.2). A waitable that is already ready
    // when it joins the set is ready NOW, and a thread parked on this Waiter
    // has to learn about it — otherwise the order "signal, then attach, then
    // wait" would lose the notification, which is the exact lost-edge this
    // semantics exists to rule out. It covers an Interrupt that fired before
    // anyone attached, which is the ordering a driver hits at bring-up.
    if waitable_ready(target.kind, target.slot) {
        wake_one_waiter(w, a)
    }
    op_ok()
}

/// §2.2's `remove(key)`. Removing a key this Waiter does not use is a caller
/// error, on the same terms as attaching twice.
///
/// IT NAMES THE ATTACHMENT BY KEY AND NEVER TOUCHES THE WAITABLE (ruled Aug 16,
/// user), which is why no handle is resolved here and no right on the waitable
/// is spent: detaching edits this Waiter's own table, so the Waiter handle
/// already validated by the dispatch plus the key is the whole of the authority
/// the operation needs. It is also the only form that survives M3: once handles
/// can be CLOSED, a closed waitable's stale attachment has no handle left to
/// name it with, and a handle-based remove could not reach it at all.
func waiter_remove(p: Int, w: Int, key: UInt) unsafe -> SyscallResult {
    let a = attached_by_key(w, key)
    if a == NO_ATTACHMENT {
        fault_process(p, FaultReason.BadState)
    }
    detach_attachment(w, a)
    op_ok()
}

/// §2.2's `wait(buffer, capacity)`: block until an attached handle is ready,
/// then COPY OUT a record naming the key its attacher supplied and what fired.
///
/// THE ANSWER IS A RECORD IN THE CALLER'S MEMORY, not registers, and the buffer
/// is the caller's because the kernel has no allocator and no place to put one
/// that would outlive the call. The status register still says how the call
/// went; the record says what happened.
///
/// THE BUFFER IS VALIDATED HERE, ON THE CALL, even on the path that parks and
/// will not use it for a while. That is deliberate: a bad buffer is the calling
/// process's mistake, and terminating it while it is the RUNNING process is
/// both a better diagnostic and a simpler thing to reason about than faulting
/// it out of some later thread's wake.
///
/// THE SCAN COMES FIRST, and that ordering is the level-triggered guarantee
/// doing its work: a signal that arrived before this call is still in the word,
/// so the wait returns immediately and nothing was lost. Only an empty set
/// parks.
func waiter_wait(p: Int, w: Int, dst: UInt, cap: UInt) unsafe -> SyscallResult {
    // A capacity below the record's size is an argument outside its domain —
    // the size is published, so the caller could have checked.
    if cap < (wait_record_bytes() as UInt) {
        fault_process(p, FaultReason.BadArg)
    }
    copy_out_check(p, dst, wait_record_bytes() as UInt)

    let ready = waiter_ready_attachment(w)
    if ready != NO_ATTACHMENT {
        deliver_attachment(p, dst, ready)
        return op_ok()
    }
    if CURRENT_THREAD == NO_THREAD {
        fault_process(p, FaultReason.BadState)
    }
    block_on_wait(CURRENT_THREAD, w, dst)
    op_blocked()
}

/// Handle-table lookup -> object type -> op table -> rights check -> op.
///
/// This is where a raw word becomes a TYPED handle (§3), and the order is the
/// point: the number arrives from a register, the table says what it names, and
/// only then is a `SystemHandle` / `ProcessHandle` / `ThreadHandle` constructed.
/// Below this line the kernel is no longer handling an integer a process chose —
/// it is handling an object it resolved, paired with the rights that came with
/// it and the slot it names.
///
/// AN UNBOUND HANDLE TERMINATES THE PROCESS, and it has to be decided here
/// rather than per kind: a handle that names nothing names no kind either, so
/// there is no op table to ask. That is the faults ruling's shape as much as its
/// content — the three caller errors it covers are exactly the three the
/// dispatch can raise before an op body runs.
func dispatch(handle: UInt, op: UInt,
              arg0: UInt, arg1: UInt, arg2: UInt) unsafe -> SyscallResult {
    let p = calling_process()
    let entry = lookup_handle(p, handle)
    match entry.obj_type {
        case Unbound -> fault_process(p, FaultReason.BadHandle),
        case System -> {
            let obj = SystemObject(handle: SystemHandle(handle),
                                   rights: entry.rights)
            system_op(op, &obj, arg0)
        },
        case Process -> {
            let obj = ProcessObject(handle: ProcessHandle(handle),
                                    rights: entry.rights, slot: entry.target)
            process_op(op, &obj, arg0, arg1, arg2)
        },
        case Thread -> {
            let obj = ThreadObject(handle: ThreadHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            thread_op(op, &obj, arg0)
        },
        case Event -> {
            let obj = EventObject(handle: EventHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            event_op(op, &obj, arg0)
        },
        case Waiter -> {
            let obj = WaiterObject(handle: WaiterHandle(handle),
                                   rights: entry.rights, slot: entry.target)
            waiter_op(op, &obj, arg0, arg1)
        },
        case Interrupt -> {
            let obj = InterruptObject(handle: InterruptHandle(handle),
                                      rights: entry.rights, slot: entry.target)
            interrupt_op(op, &obj)
        },
        case Clock -> {
            let obj = ClockObject(handle: ClockHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            clock_op(op, &obj, arg0, arg1)
        },
        case Timer -> {
            let obj = TimerObject(handle: TimerHandle(handle),
                                  rights: entry.rights, slot: entry.target)
            timer_op(op, &obj, arg0, arg1)
        },
    }
}

// =============================================================================
// The trap handler
// =============================================================================

/// The HAL's landing point for every trap taken from user mode. `frame_addr`
/// addresses the saved context, which this handler may rewrite: a returning
/// syscall leaves its (status, value) pair where the caller reads them and
/// resumes past the trapping instruction — both through the HAL, because both
/// are register conventions.
///
/// IT RETURNS THE FRAME TO RESUME, and that return value is the whole of the
/// context switch (design 178 D2/D3). Handing back the frame it was called with
/// resumes the interrupted thread; handing back another thread's frame resumes
/// THAT one, and the HAL's trap entry cannot tell the difference because there
/// is none to tell. So a switch has one location, it is the user-return
/// boundary by construction, and the kernel is never half-way through one.
///
/// THREE KINDS OF TRAP, and the order below is what tells them apart. An
/// INTERRUPT is not the running program's business at all — it is serviced and
/// the interrupted instruction resumes untouched, which is why it is decided
/// first and why it never reaches the syscall return path (that path steps the
/// saved PC, and stepping past an instruction that has not run yet would lose
/// it). A FAULT is fatal — spec §8 makes a thread fault kill its process. A bad
/// SYSCALL is fatal TOO since design 178's faults ruling: an unknown handle, an
/// unknown op or a missing right is a mistake the caller could have checked, so
/// it ends the process rather than handing back a word to branch on. What is
/// left as a STATUS is what the caller could not have known — a full slab, and
/// later a dead peer.
@export("ktrap")
public func ktrap(frame_addr: UInt, cause: UInt, tval: UInt) unsafe -> UInt {
    if hal.is_interrupt(cause) {
        service_irq(frame_addr, cause)
        return pick_next(frame_addr)
    }

    if not hal.is_syscall(cause) {
        fault_trap(hal.cause_tag(cause), cause, hal.trap_pc(frame_addr), tval)
    }

    let result = dispatch(hal.syscall_handle(frame_addr),
                          hal.syscall_op(frame_addr),
                          hal.syscall_arg0(frame_addr),
                          hal.syscall_arg1(frame_addr),
                          hal.syscall_arg2(frame_addr))

    // THE SYSCALL BOUNDARY: the one place the typed status becomes the number
    // the ABI specifies. `as` on a backed enum is total — the enum IS its tag —
    // so there is nothing here that can fail or disagree with `sosabi`'s table.
    //
    // A BLOCKED CALLER IS SKIPPED. Its pair belongs to whatever wakes it, and
    // writing one here would both answer a question nobody has asked yet and,
    // on the profile whose saved PC points AT the trapping instruction, step
    // that PC a second time when the wake wrote the real pair.
    if not result.blocked {
        write_result(frame_addr, result)
    }
    pick_next(frame_addr)
}

static BYTE_MASK: UInt = 0xFF

// =============================================================================
// Interrupts (design 178 D2 + D6; spec §9)
// =============================================================================
//
// THE KERNEL IS NON-PREEMPTIBLE (design 178 D2). An interrupt is taken from
// USER mode and from nowhere else: the kernel runs with them masked from boot,
// each machine masks them again on trap entry in hardware, and each machine's
// return to user mode is where they come back on. Nothing below has to arrange
// any of that — it is a property of the two HALs, and each states in its ABI.md
// that an interrupt arriving in kernel mode lands on its kernel-bug path rather
// than on this code. So there are no critical sections here, no interrupt
// masking vocabulary, and no `IntrSpinLock` (spec §9b) until SMP needs one.
//
// The cost is recorded rather than hidden: syscall latency bounds interrupt
// latency, which is design 178's M3 tripwire and the reason the hooks below say
// what they must not grow into.
//
// WHAT IS ARCH-FREE HERE: which hook a line belongs to, what the kernel does
// with it, and the ORDER of claim / service / complete. What is not: how a line
// is claimed, masked and completed, and how a timer is rearmed — all six are
// seam calls, because a controller is a machine's, not a kernel's (D6).

/// How many of the first ticks the kernel narrates on the console.
///
/// A kernel that logged every tick would BE its own workload — at a
/// millisecond period the log is the machine — so the hook says enough to prove
/// the path ran and then goes quiet. The count keeps rising either way.
static TICK_REPORT_LIMIT: UInt = 4

/// Ticks the periodic timer has delivered since boot.
///
/// Compound global state resting on a serialization argument the compiler
/// cannot see, which is design 149's `unsafe static var`: uniprocessor kernel,
/// interrupts taken from user mode only, so the tick path is the only writer
/// and nothing can interleave with it.
///
/// BOTH COUNTERS BELOW WRAP ON PURPOSE (`&+`, not `+`). Overflow checks are
/// always on, so a plain `+` would make a full counter PANIC — and a kernel
/// that stops after seven weeks of uptime, or after four billion spurious
/// interrupts, has turned a number nobody was reading into an outage. A
/// wrapped count is what every tick counter does; deltas across a wrap are
/// still right, which is what the scheduler will ask of this one.
unsafe static var TIMER_TICKS: UInt = 0

/// Interrupts the controller had nothing to give for. ONE is not an error — a
/// line can stop asserting between raising the interrupt and being asked about
/// it — but a stream of them is, so the first is reported and the rest are
/// counted.
unsafe static var SPURIOUS_IRQS: UInt = 0

/// Ticks the periodic timer has delivered since boot. The scheduler's clock
/// when there is a scheduler; today the harness's evidence that a tick was
/// taken, and when.
public func timer_ticks() unsafe -> UInt {
    TIMER_TICKS
}

// -----------------------------------------------------------------------------
// ONE HARDWARE TIMER, TWO CUSTOMERS (design 232 unit 1)
// -----------------------------------------------------------------------------
//
// Both machines have exactly ONE comparator, and from this unit onward two
// things want it: the SCHEDULER TICK (spec §7's timeslice) and the TIMER OBJECTS
// (spec §2's row) a process arms. The composition is here, arch-free, and it is
// the whole of the mechanism:
//
//   the kernel keeps every deadline it owes in nanoseconds — the next tick in
//   `NEXT_TICK_NS`, each armed Timer's in its own slot — and programs the
//   hardware with the EARLIEST of them. A fire means "something MAY be due":
//   the handler asks what actually is, services it, and programs the next
//   earliest. Nothing else touches the comparator.
//
// THE TICK IS INVIOLATE, and this arrangement is what keeps it so rather than a
// promise beside it. A Timer deadline can only ever move the hardware EARLIER
// than the tick, never later, so the tick's cadence is unchanged by any number
// of Timers — a fire that turns out to be a Timer's still checks the tick, and
// a tick that comes due while a Timer is being serviced is taken in the same
// pass. There is no ordering between the two customers to get wrong, because
// both are read out of the same `now`.
//
// WHY THE PERIOD MOVED OUT OF THE HAL. M2's seam was `timer_start(period_us)` +
// `timer_rearm()`, which can express exactly one periodic customer — the period
// lived in each HAL and the rearm was the only way to program anything. The
// seam is now `timer_now_ns()` + `timer_set_deadline_ns(at)`, which is hardware
// and nothing else, and the tick's PERIOD is scheduler policy, so it lives
// where the scheduler does.

/// Nanoseconds in a microsecond — the unit `start_tick` is written in and the
/// unit `Clock`/`Timer` speak.
static NS_PER_US: UInt64 = 1000

/// The deadline that means "nothing is due" — far enough out that no machine
/// this kernel runs on reaches it. It is a VALUE rather than an absence so that
/// `reprogram_timer` has one code path: an empty schedule programs `never`,
/// which is what stops a level-triggered comparator left in the past from
/// re-firing forever.
static NEVER_NS: UInt64 = UInt64.max

/// How far ahead of NOW the hardware is ever programmed.
///
/// THIS IS WHAT TURNS A TOO-FAST SCHEDULE INTO COALESCING INSTEAD OF A LIVELOCK,
/// and it is the one place the machine's own limits appear in the Timer's
/// semantics. A process may arm a one-nanosecond interval; without a floor the
/// comparator would be due again before the trap returned, and the machine would
/// live in the trap handler making no user-mode progress. With one, the fire
/// arrives at most this often and the intervening expiries COALESCE into the
/// fire count — which is exactly what coalescing is for, so nothing has to be
/// refused and no minimum interval has to be invented.
///
/// The LOGICAL schedule is untouched by it: a Timer's next deadline is still
/// `previous + interval` (drift-free), so lateness never accumulates and a
/// one-shot still reports exactly one fire. What the floor bounds is the
/// RESOLUTION, and 50 microseconds is two orders of magnitude below the
/// millisecond scheduler tick, so §7's cadence never notices it.
static TIMER_MIN_LEAD_NS: UInt64 = 50_000

/// The scheduler tick's period in nanoseconds; 0 means NO PERIODIC TICK.
///
/// Zero is the real kernel's state (`sos/kernel/main.saw` arms none — the
/// scheduler works without one, and a tick would narrate over the process for
/// its first few ticks, see `Console`'s handover protocol). It is a state the
/// composition has to carry rather than an edge case, because a kernel with no
/// tick and one armed Timer is exactly the shape a sleeping process makes.
unsafe static var TICK_PERIOD_NS: UInt64 = 0

/// When the next scheduler tick is due, on the same clock every deadline uses.
unsafe static var NEXT_TICK_NS: UInt64 = 0

/// Start the periodic scheduler tick (spec §7's fixed timeslice).
///
/// ARCH-FREE, and that is the move this unit made: the PERIOD is scheduler
/// policy and belongs beside the scheduler, while the hardware — a counter and
/// a comparator — is all the HAL still owns. The harness kernels that want a
/// preemptive machine call this instead of the HAL's retired `timer_start`.
public func start_tick(period_us: UInt) unsafe {
    TICK_PERIOD_NS = (period_us as UInt64) * NS_PER_US
    NEXT_TICK_NS = hal.timer_now_ns() + TICK_PERIOD_NS
    reprogram_timer()
}

/// THE ONE PLACE THE HARDWARE COMPARATOR IS PROGRAMMED (obligation 1).
///
/// Its entry points, all of them:
///
///   - `start_tick`, when a kernel decides to be preemptive;
///   - `on_timer_interrupt`, after servicing whatever came due;
///   - `timer_arm` and `timer_disarm`, when a process changes what it owes;
///   - `end_process`, whose teardown frees a dying process's Timers.
///
/// A funnel rather than a rule repeated per caller, because the question it
/// answers — what is the earliest thing this kernel owes anybody — has to be
/// asked over the WHOLE schedule every time, and a caller that programmed only
/// its own deadline would silently push somebody else's out.
func reprogram_timer() unsafe {
    var next = NEVER_NS
    if TICK_PERIOD_NS != 0 && NEXT_TICK_NS < next {
        next = NEXT_TICK_NS
    }
    next = earliest_timer_deadline(next)

    if next == NEVER_NS {
        hal.timer_set_deadline_ns(NEVER_NS)
        return
    }
    let floor = hal.timer_now_ns() + TIMER_MIN_LEAD_NS
    hal.timer_set_deadline_ns(if next < floor { floor } else { next })
}

/// THE TIMER INTERRUPT — the arch-free landing point for the one comparator.
///
/// A fire says only that SOMETHING MAY BE DUE, so every customer is asked out
/// of ONE reading of the clock, and the TICK IS ASKED FIRST — a timeslice charge
/// that a Timer's servicing delayed would be a scheduler bug wearing a Timer's
/// clothes. Programming the next deadline is last, and it is also what lowers
/// the line (both machines' timer condition is a level).
///
/// ONE `now` FOR BOTH is what makes the two customers unorderable in any way
/// that matters: the tick and every Timer are judged against the same instant,
/// so a Timer cannot be late because the tick ran first, and the tick cannot
/// slip because several Timers came due together.
///
/// `pc` is where the interrupted context resumes, or `IDLE_PC` when the fire was
/// found by the idle poll.
func on_timer_interrupt(pc: UInt) unsafe {
    let now = hal.timer_now_ns()

    if TICK_PERIOD_NS != 0 && now >= NEXT_TICK_NS {
        // Measured from NOW rather than from the deadline missed, which is M2's
        // rule kept verbatim: a tick the kernel was late for is ONE tick, never
        // a burst of catch-up ticks whose only effect would be to keep the
        // machine in the trap handler. A Timer's rule is the opposite (see
        // `fire_timer`) and deliberately so — a timeslice has no history to be
        // faithful to, and an interval does.
        NEXT_TICK_NS = now + TICK_PERIOD_NS
        on_timer_tick(pc)
    }

    expire_timers(now)
    reprogram_timer()
}

/// THE TIMER TICK — the arch-free landing point for the periodic timer.
///
/// THE TIMESLICE IS CHARGED HERE and nothing else about scheduling is: the tick
/// decrements the running thread's slice and, when it runs out, RAISES A FLAG.
/// It does not switch, does not walk the ready queue and does not touch the
/// frame. That division is design 178 D2 in one function — the tick runs with
/// interrupts masked, so its length is interrupt latency, while the switch it
/// motivates happens later at the user-return boundary where it costs nothing.
///
/// `pc` is where the interrupted context will resume, read out of the frame by
/// the caller — or `IDLE_PC` when the tick was found by the idle poll, where
/// there is no interrupted context to name.
func on_timer_tick(pc: UInt) unsafe {
    TIMER_TICKS = TIMER_TICKS &+ 1

    if CURRENT_THREAD != NO_THREAD {
        if SLICE_LEFT > 0 {
            SLICE_LEFT = SLICE_LEFT - 1
        }
        if SLICE_LEFT == 0 {
            NEED_RESCHED = true
            SLICE_LEFT = SLICE_TICKS
        }
    }

    if TIMER_TICKS > TICK_REPORT_LIMIT {
        return
    }
    let uart = console()
    uart.write_str("SOS: timer tick ")
    uart.write_hex(TIMER_TICKS)
    uart.write_str(" at ")
    uart.write_hex(pc)
    uart.write_str("\n")
}

/// What the tick report prints for a tick taken with nothing running. The
/// kernel was idle, so there is no interrupted address, and zero is the honest
/// answer rather than a stale one.
static IDLE_PC: UInt = 0

/// A DEVICE INTERRUPT — the arch-free landing point for an external line, and
/// spec §9's delivery in five lines.
///
/// THE LINE IS ALREADY MASKED when this runs (`deliver_line` below), so what is
/// left is to mark the object ready and tell its Waiter. Marking BEFORE waking
/// is what makes the level-triggered path work in both orders: a driver already
/// parked is woken with the record, and one that has not waited yet finds
/// `pending` set by its own next `Wait`.
///
/// A LINE NOTHING IS BOUND TO is reported and left MASKED, which is the only
/// safe answer: the kernel cannot service a device it has no driver for, and an
/// unmasked line with nobody to ack it would re-fire forever. That is also the
/// path the interrupt-controller bring-up case still exercises, which is what
/// keeps `irq_raise_selftest_line` meaningful with no Interrupt object involved.
func on_external_irq(line: UInt) unsafe {
    let irq = interrupt_by_line(line)
    if irq == NO_INTERRUPT {
        let uart = console()
        uart.write_str("SOS: external irq ")
        uart.write_hex(line)
        uart.write_str("\n")
        return
    }
    INTERRUPTS[irq].pending = true
    notify_ready(WaitableKind.Interrupt, irq)
}

/// SERVICE ONE CLAIMED LINE — the arch-free half of an interrupt, and the one
/// place a line number turns into work.
///
/// Its two entry points, both of which have already CLAIMED the line from the
/// controller:
///
///   - `service_irq`, from the trap path, with the interrupted PC;
///   - `idle_poll`, from `pick_next`'s idle loop, with `IDLE_PC`.
///
/// The two branches differ in exactly one step, and it is spec §9's: the timer
/// programs its NEXT DEADLINE, which is what lowers its line, while a device
/// line is MASKED, because a device goes on asserting until its driver has been
/// told.
func deliver_line(line: UInt, pc: UInt) unsafe {
    if line == hal.IRQ_NONE {
        SPURIOUS_IRQS = SPURIOUS_IRQS &+ 1
        if SPURIOUS_IRQS == 1 {
            console().write_str("SOS: spurious interrupt\n")
        }
        return
    }

    if line == hal.IRQ_TIMER {
        on_timer_interrupt(pc)
    } else {
        hal.irq_mask(line)
        on_external_irq(line)
    }
    hal.irq_complete(line)
}

/// EVERY interrupt the kernel TAKES arrives here, through `ktrap` and through
/// nothing else. (Interrupts the kernel POLLS FOR while idle arrive through
/// `idle_poll`, which is the same service over a different way of noticing.)
func service_irq(frame_addr: UInt, cause: UInt) unsafe {
    deliver_line(hal.irq_claim(cause), hal.trap_pc(frame_addr))
}

// -----------------------------------------------------------------------------
// THE IDLE PATH (spec §7; design 178 D6)
// -----------------------------------------------------------------------------
//
// "NOTHING RUNNABLE" USED TO BE A DEADLOCK, AND THE INTERRUPT OBJECT IS WHAT
// CHANGED THAT. Before it, every wake in the system came FROM a thread — an
// Event is signalled by somebody — so a system with no runnable thread had
// nobody left to signal one and the report was exact. A bound IRQ line is the
// first readiness that arrives from OUTSIDE the set of runnable threads, so the
// same state now has two readings and the kernel has to tell them apart.
//
// THE RULE: it is idle if any Interrupt is BOUND, and a deadlock otherwise. It
// is deliberately conservative — the kernel does not try to prove that a
// specific blocked thread is reachable by a specific line, which would mean
// walking attachment sets to answer a question that a wrong answer only makes
// SLOWER to diagnose (a hang at the harness timeout instead of a report). What
// it never does is call a real wait a deadlock.
//
// WHY THE IDLE LOOP POLLS INSTEAD OF TAKING THE INTERRUPT. Design 178's D2 says
// interrupts are taken from USER mode only, and that is enforced by the
// machines rather than intended by the kernel — so an interrupt that arrives
// while the kernel idles is not delivered, it is PENDING. `wait_for_irq` parks
// the core until one is pending (both machines wake from it on a pending
// interrupt whether or not it is deliverable), and `irq_poll` then asks the
// controller for it directly. So D2 is untouched: the kernel still never takes
// a trap in kernel mode, and the same `deliver_line` services the line either
// way.

/// Ask the controller for a line, and service it if there is one.
func idle_poll() unsafe {
    let line = hal.irq_poll()
    if line == hal.IRQ_NONE {
        return
    }
    deliver_line(line, IDLE_PC)
}

/// Is there a source of readiness OUTSIDE the set of runnable threads?
///
/// TWO KINDS ANSWER YES, and the second generalizes the rule rather than
/// widening it (design 232 unit 1). A BOUND IRQ LINE is readiness a device will
/// deliver; an ARMED TIMER is readiness the CLOCK will deliver. Neither needs a
/// thread to run for it to arrive, which is the whole of what this question
/// asks — so "idle iff a line is bound" was always the special case of "idle iff
/// something outside the thread set can still wake somebody".
///
/// Getting this wrong in the Timer's direction would be the worst kind of bug:
/// a process that armed a timer and parked is SLEEPING, which is the headline
/// thing this unit exists to make possible, and reporting it as a deadlock would
/// terminate exactly the program that finally works. Getting it wrong the other
/// way turns a real deadlock into a harness timeout, which is why an armed timer
/// counts and a merely EXISTING one does not: a disarmed Timer will never fire,
/// so it is not a wake source, and a system holding only those is as deadlocked
/// as one holding none.
func has_external_wake_source() unsafe -> Bool {
    var i: Int = 0
    while i < MAX_INTERRUPTS {
        match INTERRUPTS[i].state {
            case Live -> { return true },
            case Free -> {},
        }
        i = i + 1
    }
    var t: Int = 0
    while t < MAX_TIMERS {
        match TIMERS[t].state {
            case Live -> {
                if TIMERS[t].armed {
                    return true
                }
            },
            case Free -> {},
        }
        t = t + 1
    }
    false
}

/// Park the core until something is runnable again.
///
/// The exit condition is the READY QUEUE, not the poll: a serviced line wakes a
/// waiter through `deliver_line` -> `on_external_irq` -> `notify_ready`, which
/// pushes that thread onto the queue. A line that wakes nobody — one bound to
/// an Interrupt no thread is waiting on — leaves the queue empty and the loop
/// goes back to sleep, which is correct and is why the test is on the queue
/// rather than on "an interrupt happened".
func idle_until_runnable() unsafe {
    while READY_HEAD == 0 {
        hal.wait_for_irq()
        idle_poll()
    }
}

/// What a refused too-high address REPORTS: its top 32 bits. The low half is
/// what would have survived a narrowing, so it is the half that says nothing;
/// the high half is the part the machine cannot reach and is what a reader
/// needs to see. (`write_hex` prints a machine word, which on the profile that
/// can raise this is 32 bits wide.)
static HIGH_HALF_SHIFT: Int = 32

// =============================================================================
// The sosimg loader (design 140 unit B; spec §6, §7, §12)
// =============================================================================
//
// The kernel loads exactly ONE image, ever: the root server (spec §12). Every
// later process is loaded BY ROOT, so there is deliberately no second code path
// here. The image is not ELF — a microkernel-sized loader gets a flat header.
//
// The LAYOUT is not described here: it is the `imgformat` package, shared with
// the Blade target that emits it, and this loader reads it by OVERLAYING those
// structs on the appended bytes — one `UnsafeMemory` view construction per
// record, then plain field names (`seg.mem_len`). The format's alignment
// discipline (every u32 4-aligned, no interior padding, pinned there by
// `static_assert`) is what makes the overlay exact, and it is what turns a
// layout edit into a compile error instead of a silent misparse at boot.
//
// What stays HERE is everything that holds on EVERY target: the order the
// checks run in, that nothing is placed before everything validates, and that a
// malformed shape is a diagnosed FAIL rather than a hang or a partial load.
// Where root's region is, how many grants there are to spend and what a
// permission bit does to the hardware are the HAL's — which is why the numbers
// below are read from it rather than written here.

/// Overlay the header on the image's first bytes. One view construction, then
/// an ordinary safe struct — the unsafety is confined to this line.
func header_at(addr: UInt) unsafe -> SosimgHeader {
    UnsafeMemory<SosimgHeader, Normal>(addr).read()
}

/// Overlay one segment record.
func seg_at(addr: UInt) unsafe -> SosimgSeg {
    UnsafeMemory<SosimgSeg, Normal>(addr).read()
}

func copy_bytes(dst: UInt, src: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(UnsafeMemory<UInt8, Normal>(src + i).read())
        i = i + 1
    }
}

func zero_bytes(dst: UInt, len: UInt) unsafe {
    var i: UInt = 0
    while i < len {
        UnsafeMemory<UInt8, Normal>(dst + i).write(0)
        i = i + 1
    }
}

/// Reject the root image. Never returns.
public func fatal_image(reason: String, detail: UInt) {
    let uart = console()
    uart.write_str("SOS: bad root image: ")
    uart.write_str(reason)
    uart.write_str(" (")
    uart.write_hex(detail)
    uart.write_str(")\n")
    hal.exit_fail(ExitCode.BadImage as UInt)
}

/// Validate one segment record against the image bounds and the root region.
/// Checks are ordered so no bound is computed by an addition that could
/// overflow — a hostile length must produce a diagnostic, not a panic.
func check_segment(seg: &SosimgSeg, img_len: UInt) {
    let file_off = seg.file_off as UInt
    let file_len = seg.file_len as UInt
    let mem_len = seg.mem_len as UInt

    // The format's addresses are 64-bit on both profiles (design 172 unit 8),
    // so a 32-bit kernel can be handed an image it cannot address. Refusing is
    // the only answer that cannot corrupt a boot — narrowing would wrap a high
    // address into a low one and place the segment somewhere the linker never
    // meant. The test folds away entirely on a 64-bit build.
    if not fits_target_word(seg.load_addr) {
        fatal_image("segment loads past this machine's address space",
                    (seg.load_addr >> HIGH_HALF_SHIFT) as UInt)
    }
    let load_addr = seg.load_addr as UInt

    if file_off > img_len {
        fatal_image("segment starts past the image", file_off)
    }
    if file_len > img_len - file_off {
        fatal_image("segment runs past the image", file_len)
    }
    if not seg.mem_covers_file() {
        fatal_image("segment mem_len below file_len", mem_len)
    }

    // Write-without-read is not a grant any target should install, and one
    // profile's hardware RESERVES the encoding outright. `imgformat` states the
    // rule; refusing the image is the consequence. It is checked BEFORE the
    // device branch because it holds for both kinds of record.
    if not seg.has_sane_perms() {
        fatal_image("segment permissions are not a valid grant", seg.flags as UInt)
    }

    // A DEVICE WINDOW is judged against the BOARD, not against the root region
    // — it names hardware, which is nowhere near RAM — so it takes its own
    // path and returns.
    if seg.is_device_grant() {
        check_device_grant(&seg, load_addr, file_len, mem_len)
        return
    }

    if load_addr < hal.ROOT_LOAD_BASE {
        fatal_image("segment loads below the root region", load_addr)
    }
    // A grant covers whole units of the target's protection granularity, so a
    // segment starting mid-unit would be granted along with whatever shares
    // its first unit — the previous segment's tail, at the previous segment's
    // permissions. On a page-granular profile that is how root's code would
    // silently become writable; on a four-byte-granular one it never arises.
    // Refusing the image is the only answer that is right on both.
    if (load_addr & (hal.PROT_GRAIN - 1)) != 0 {
        fatal_image("segment is not aligned to the grant granularity", load_addr)
    }
    let limit = hal.ROOT_REGION_TOP - hal.ROOT_STACK_LEN
    if load_addr > limit {
        fatal_image("segment loads above the root region", load_addr)
    }
    if mem_len > limit - load_addr {
        fatal_image("segment overruns the root region", mem_len)
    }
}

/// Validate a DEVICE WINDOW record (design 178's finale constraint 1, ruled
/// Aug 16, user).
///
/// THE IMAGE DECLARES AND THE BOARD AUTHORIZES, and both halves are load-bearing.
/// A window in the image is what makes "this program drives that device" a
/// property of the program; a window the BOARD publishes is what stops an image
/// from naming any physical address it likes and being handed it. In M2 the
/// board offers exactly one — the console UART's page, which is the only device
/// a process has any business holding while the kernel owns everything else —
/// so the authorization is a comparison rather than a table.
///
/// THIS IS THE PLACEHOLDER M3'S MAPPING RETIRES. Then a device window is a
/// MemoryObject derived from a device pool root (spec §2.5), mapped by an op
/// and revocable by closing the Mapping, and the board's comparison becomes the
/// pool's contents. Everything above this line is what that migration replaces.
func check_device_grant(seg: &SosimgSeg, load_addr: UInt, file_len: UInt,
                        mem_len: UInt) {
    // A window carries no bytes: there is nothing in an image file to place at
    // a hardware address, and a record claiming otherwise has been built wrong.
    if file_len != 0 {
        fatal_image("device grant carries image bytes", file_len)
    }
    if load_addr != hal.DEVICE_GRANT_BASE {
        fatal_image("device grant names a window this board does not offer",
                    load_addr)
    }
    if mem_len != hal.DEVICE_GRANT_LEN {
        fatal_image("device grant is not the size of that window", mem_len)
    }
}

/// Parse the appended root image, place its segments, grant root exactly the
/// regions the image asks for plus a stack, and drop to user mode at its entry.
/// Never returns.
public func load_root_and_enter() unsafe {
    let base = hal.payload_start()
    let end = hal.payload_end()
    if end < base {
        fatal_image("payload bounds inverted", base)
    }
    let img_len = end - base

    // The record strides come from the shared structs, so they cannot drift
    // from the layout the reads assume.
    let header_len = sizeof<SosimgHeader>() as UInt
    let seg_len = sizeof<SosimgSeg>() as UInt

    if img_len < header_len {
        fatal_image("no root image appended", img_len)
    }

    let header = header_at(base)
    if not header.has_magic() {
        fatal_image("bad magic", header.magic as UInt)
    }
    if not header.has_known_version() {
        fatal_image("unsupported version", header.version as UInt)
    }
    // An image built for the OTHER profile is refused rather than jumped into.
    // Its instructions are not this machine's and its addresses need not be in
    // this machine's map — and before the format carried a tag, the only thing
    // that stopped one booting on the other was that nobody had tried.
    if not header.is_for_arch(hal.arch_tag()) {
        fatal_image("image is for another architecture", header.arch as UInt)
    }

    let seg_count = header.seg_count as UInt
    if seg_count == 0 {
        fatal_image("image has no segments", 0)
    }
    if seg_count > hal.MAX_ROOT_SEGMENTS {
        fatal_image("more segments than the grant budget", seg_count)
    }
    let table_len = seg_count * seg_len
    if table_len > img_len - header_len {
        fatal_image("segment table runs past the image", table_len)
    }

    // Same rule as a segment's address, at the one other place a 64-bit field
    // becomes a machine word: refuse, never narrow.
    if not fits_target_word(header.entry) {
        fatal_image("entry is past this machine's address space",
                    (header.entry >> HIGH_HALF_SHIFT) as UInt)
    }
    let entry = header.entry as UInt
    let prio_map = header.prio_map as UInt

    // Validate EVERY segment before placing any of them: a rejected image must
    // leave the root region untouched.
    var i: UInt = 0
    while i < seg_count {
        let seg = seg_at(base + header_len + i * seg_len)
        check_segment(&seg, img_len)
        i = i + 1
    }

    if entry < hal.ROOT_LOAD_BASE || entry >= hal.ROOT_REGION_TOP - hal.ROOT_STACK_LEN {
        fatal_image("entry outside the root region", entry)
    }

    let uart = console()
    uart.write_str("SOS: root image ok segments=")
    uart.write_hex(seg_count)
    uart.write_str(" entry=")
    uart.write_hex(entry)
    uart.write_str(" prio=")
    uart.write_hex(prio_map)
    uart.write_str("\n")

    hal.prot_reset()

    // The WRITABLE window, accumulated as the segments are placed. It is what
    // `copy_out` checks a kernel-written record against, and the stack below is
    // always part of it — so it starts at the region's top edge and only ever
    // grows downward, which means "no writable segment at all" still leaves the
    // stack, and a process always has somewhere to receive one.
    var rw_base = hal.ROOT_REGION_TOP - hal.ROOT_STACK_LEN

    var s: UInt = 0
    while s < seg_count {
        let seg = seg_at(base + header_len + s * seg_len)
        let load_addr = seg.load_addr as UInt
        let file_len = seg.file_len as UInt
        let mem_len = seg.mem_len as UInt

        // A DEVICE WINDOW places no bytes and joins no writable window: it is a
        // grant and nothing else. Keeping it out of `rw_base` is not tidiness —
        // a hardware address is BELOW RAM on one profile, so folding it in
        // would stretch the copy-out window from the device page to the top of
        // the region and make `copy_out`'s check accept most of the machine.
        if seg.is_device_grant() {
            hal.prot_device(s, load_addr, mem_len)
        } else {
            copy_bytes(load_addr, base + (seg.file_off as UInt), file_len)
            zero_bytes(load_addr + file_len, mem_len - file_len)

            // The sosimg flag bits ARE the protection vocabulary (imgformat
            // states the encoding; each HAL translates it into its own
            // hardware's bits), so a segment's permissions become its grant
            // with nothing in between.
            hal.prot_region(s, load_addr,
                            align_up(load_addr + mem_len, hal.PROT_GRAIN),
                            seg.flags)
            if (seg.flags & (SegFlag.Write as UInt8)) != 0 && load_addr < rw_base {
                rw_base = load_addr
            }
        }
        s = s + 1
    }

    // The stack is the kernel's grant, not the image's: root asks for code and
    // data, the kernel decides where it runs.
    hal.prot_region(seg_count, hal.ROOT_REGION_TOP - hal.ROOT_STACK_LEN,
                    hal.ROOT_REGION_TOP,
                    (SegFlag.Read as UInt8) | (SegFlag.Write as UInt8))
    hal.prot_commit()

    // spec §7: root's band map applies verbatim from its image. D3 keeps the
    // map a loader artifact for M2 — the scheduler is round-robin over one
    // level — so the kernel still parses and reports it, which is what proves
    // the Blade-emitted field arrives intact. Storing it in the Process slot is
    // the priority unit's job, not this one's.
    //
    // §12: root's boot handle set. It is still exactly one handle — System —
    // and every authority root has flows through it, now including its own
    // Process and Thread objects, which it DERIVES (`ProcessSelf` /
    // `ThreadSelf`) rather than being handed.
    start_process(entry, hal.ROOT_REGION_TOP, hal.ROOT_LOAD_BASE,
                  hal.ROOT_REGION_TOP, rw_base, hal.ROOT_REGION_TOP)
}

/// Reify a user-mode program as a Process with one Thread, mint its boot handle
/// set, and run it. Never returns.
///
/// THE ONLY WAY INTO USER MODE. The loader reaches it with a root image's entry
/// and region; the harness kernels that grant a hand-written payload its own
/// bytes reach it with theirs. There is deliberately no second path — a kernel
/// that could enter user mode without a Process would be a kernel with syscalls
/// that no handle table answers, which is exactly the shape the M1 code had and
/// exactly what this unit retired.
///
/// The three handles are minted in an order the boot ABI depends on: System
/// first, so that it comes out as `ROOT_SYSTEM_HANDLE` and the register the
/// program receives means what §12 says it means. The other two are not passed
/// anywhere — the program asks for them — so their numbers are the kernel's
/// business and stay that way.
///
/// `rw_base`/`rw_top` DEFAULT TO NONE, and that default is the right answer
/// rather than a convenience: the harness kernels that grant a hand-written
/// payload its own bytes grant them read+execute, so those processes have
/// nowhere the kernel may write and should be told so if they ask. Only the
/// loader, which grants a data segment and a stack, passes a window.
public func start_process(entry: UInt, stack_top: UInt,
                          region_base: UInt, region_top: UInt,
                          rw_base: UInt = 0, rw_top: UInt = 0) unsafe -> Never {
    let p: Int = 0
    PROCESSES[p] = ProcessSlot(state: ProcessState.Running, self_handle: 0,
                            entry: entry, region_base: region_base,
                            region_top: region_top,
                            rw_base: rw_base, rw_top: rw_top,
                            exit_kind: ProcessStatusKind.Running, exit_code: 0)

    let system = mint_handle(p, ObjType.System, root_system_rights(), 0)
    let own = mint_handle(p, ObjType.Process, root_process_rights(), p)
    PROCESSES[p].self_handle = own

    let main = alloc_thread()
    let main_handle = mint_handle(p, ObjType.Thread, thread_rights(), main)
    THREADS[main] = ThreadSlot(state: ThreadState.Running, process: p,
                               self_handle: main_handle, exit_code: 0,
                               joiners: 0, link: 0, wait_buf: 0)
    CURRENT_THREAD = main
    SLICE_LEFT = SLICE_TICKS

    if system != ROOT_SYSTEM_HANDLE {
        fatal_image("the boot handle set did not start at the System handle",
                    system)
    }

    // THE HANDOVER MARKER — the last thing the kernel says on its own
    // initiative, and the line a transcript reads everything after as the
    // PROCESS's. See `Console` for the protocol it announces.
    console().write_str("SOS: console handover\n")

    hal.frame_init(frame_slot(main), entry, stack_top, system)
    // `resume_frame` is `-> Never`: it enters the process and the kernel is
    // only ever re-entered through a trap. That is this function's divergence.
    hal.resume_frame(frame_slot(main))
}
