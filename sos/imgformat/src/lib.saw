//! The sosimg process-image format (design 140; sos/spec.md §6, §7).
//!
//! ONE definition of the format, shared by everyone who touches it: Blade
//! emits images (`blade/src/sosimg.saw`), the kernel loads them
//! (`sos/kernel/core/lib.saw`). Before this package the layout lived twice —
//! as a comment beside Blade's byte emitters and as a family of offset
//! constants in the kernel — which is exactly the arrangement where a format
//! change lands on one side only.
//!
//! DEPENDENCY-LIGHT ON PURPOSE. This module names nothing but primitives: no
//! `Data`, no `File`, no allocation. That is what lets the same source compile
//! into a freestanding riscv32 kernel and into a host binary. Each consumer
//! keeps its OWN I/O — Blade emits bytes through its module-private `Data`
//! extensions, the kernel overlays these structs with `UnsafeMemory` views —
//! and shares only the layout and the target-independent rules.
//!
//! WIRE LAYOUT. Every field is fixed-width and LITTLE-ENDIAN (the design-47
//! discipline), so the 32-bit and 64-bit SOS profiles (§5b) read identical
//! bytes. The field order is chosen so every `UInt32` sits on a 4-byte
//! boundary and the structs need no interior padding: that is what makes the
//! kernel's overlay EXACT, and what lets it read a header with one view
//! construction instead of a dozen offset computations. The `static_assert`s
//! below are the ABI pin — a field added or a width changed becomes a compile
//! error here rather than a silent misparse at boot.
//!
//! A big-endian profile would have to byte-assemble instead of overlaying;
//! riscv32 and arm64 are both little-endian, so neither does today.
//!
//! ADDRESSES ARE 64-BIT SINCE VERSION 3 (design 172 unit 8), ON BOTH PROFILES.
//! v2 spent 32 bits on `entry` and `load_addr` because both M1b boards load
//! inside the low 4 GiB — QEMU `virt` puts RAM at 0x8000_0000 on riscv32 and
//! 0x4000_0000 on arm64 — and the narrow field kept one overlay readable by a
//! 32-bit and a 64-bit kernel. That reasoning held exactly as long as no
//! 64-bit board wanted to load high, which is a property of the two machines
//! that happened to be first rather than of the format. Widening it now, while
//! there are two producers and one consumer and every one of them is in this
//! tree, costs a fixture edit; widening it later costs a migration.
//!
//! The two fields that stay 32-bit are the ones that describe the IMAGE rather
//! than the machine: `file_off` and the lengths. A 4 GiB process image is not
//! the constraint anyone will hit first, and keeping them narrow is what makes
//! the records 24 bytes instead of 40.
//!
//! A 32-BIT KERNEL REFUSES AN IMAGE IT CANNOT ADDRESS. `fits_target_word`
//! below is the boundary: an address that does not fit this build's machine
//! word is a clean load error, never a truncation into an image that loads
//! somewhere the linker never meant. That is the same rule Blade already
//! applies at the writing end.

/// The image header: 24 bytes at offset 0, followed immediately by
/// `seg_count` segment records.
///
/// FIELD ORDER IS CHOSEN FOR THE OVERLAY, not for reading order. `entry` is
/// last because it is the only 8-byte field, and putting it on an 8-byte
/// boundary is what lets both profiles read this struct with one view
/// construction and no interior padding. `reserved0` is that padding, spelled
/// out — a hole in a wire struct is a field like any other (design 58).
public struct SosimgHeader {
    /// `SOSIMG_MAGIC` — the bytes 'S','O','S','I' read as a little-endian word.
    public magic: UInt32,
    /// `SOSIMG_VERSION`. A loader refuses anything it does not know.
    public version: UInt16,
    /// How many `SosimgSeg` records follow. A loader bounds this against its
    /// own budget (the kernel's is its grant budget).
    public seg_count: UInt8,
    /// Which architecture this image's code is for — a `SosimgArch` tag.
    ///
    /// Deliberately a raw `UInt8` and not a `SosimgArch`, for the same reason
    /// `SosimgSeg.flags` is raw: this struct is overlaid on bytes the loader
    /// did not produce, and an enum-typed field would mint a tag straight from
    /// an attacker-chosen byte with no `from(raw:)` anywhere. A loader compares
    /// it against its OWN tag; a mismatch is a refused image (design 162 unit
    /// 3). Before this field the two profiles' images were byte-compatible
    /// headers wrapping incompatible instructions, and the only thing that
    /// stopped one booting on the other was that nobody had tried.
    public arch: UInt8,
    /// The §7 band -> level map, one byte per band, low byte first:
    /// background, low, normal, high. Build-time metadata and a REQUEST — the
    /// launcher may honor, clamp or override it (§7). The kernel applies
    /// root's verbatim because root is trusted by construction (§12).
    public prio_map: UInt32,
    /// Zero. Present so `entry` lands 8-aligned; a later version can spend it
    /// without moving anything.
    public reserved0: UInt32,
    /// ABSOLUTE load address of the first instruction, 64-bit since v3. Not an
    /// offset: nothing relocates on Profile A, so an offset would only be an
    /// addition every loader has to perform and re-validate.
    public entry: UInt64,
}

/// One loadable segment: 24 bytes, `seg_count` of them from offset 24.
public struct SosimgSeg {
    /// ABSOLUTE address this segment loads at, 64-bit since v3. First for the
    /// same reason `entry` is last in the header — the 8-byte field goes where
    /// it is 8-aligned.
    public load_addr: UInt64,
    /// Offset from the IMAGE BASE to this segment's bytes.
    public file_off: UInt32,
    /// Bytes present in the image.
    public file_len: UInt32,
    /// Bytes the segment occupies once loaded. `mem_len > file_len` is how a
    /// `.bss` tail is expressed; the loader zero-fills the difference.
    public mem_len: UInt32,
    /// A MASK of `SegFlag` bits.
    ///
    /// Deliberately a raw `UInt8` and not a `SegFlag`, for two reasons. A mask
    /// is a SET of bits, and no single case names `R|W`. More importantly this
    /// struct is overlaid on bytes the loader did not produce: an enum-typed
    /// field would mint a `SegFlag` straight from an attacker-chosen byte with
    /// no `from(raw:)` anywhere, and a `match` on a value that names no case
    /// still selects an arm — measured, not assumed (a byte of 6 read back as
    /// the first case). The kernel would then install a grant from a permission
    /// it never validated. Raw bytes stay raw; `has` and `has_sane_perms` below
    /// are the validating boundary.
    public flags: UInt8,
    public reserved0: UInt8,
    public reserved1: UInt8,
    public reserved2: UInt8,
}

// The ABI pin. These sizes are the format; a layout edit that skews them stops
// the build here instead of corrupting a boot. They hold on BOTH profiles —
// which is the whole claim the field order is arranged to make true.
static_assert(sizeof<SosimgHeader>() == 24, "sosimg header must be exactly 24 bytes")
static_assert(sizeof<SosimgSeg>() == 24, "sosimg segment record must be exactly 24 bytes")

/// 'S','O','S','I' as a little-endian word.
public static SOSIMG_MAGIC: UInt32 = 0x49534F53

/// Version 3 widened `entry` and `load_addr` to 64 bits, taking the header from
/// 16 bytes to 24 and each record from 20 to 24.
///
/// Every version bump so far has been a REFUSAL boundary rather than a
/// negotiation: v2 refused v1 because a v1 image made no statement about what
/// machine it was for, and v3 refuses v2 because a v2 record's address field is
/// in a different place and a different width. There is no reading of a v2
/// record that is safe to guess at, so a loader says the version is wrong and
/// stops — which is a diagnostic, where guessing would be a jump into whatever
/// the misread bytes pointed at.
public static SOSIMG_VERSION: UInt16 = 3

/// The largest address a 32-bit loader can place.
static WORD32_MAX: UInt64 = 0xFFFFFFFFu64
static BYTES_PER_64BIT_WORD: Int = 8

/// Can THIS build's machine word hold `v`?
///
/// The format's addresses are 64-bit on both profiles, so a 32-bit kernel can
/// be handed an image it cannot address. That is a refusable image, not a
/// truncation: `sizeof<UInt>()` folds at compile time, so on a 64-bit profile
/// this is the constant `true` and costs nothing, and on a 32-bit one it is the
/// bound check that keeps a high address from wrapping into a low one.
public func fits_target_word(v: UInt64) -> Bool {
    if sizeof<UInt>() >= BYTES_PER_64BIT_WORD {
        return true
    }
    v <= WORD32_MAX
}

/// Which machine an image's code is for.
///
/// The registry, in one place, because BOTH sides read it: the kernel compares
/// an image's tag against its own before jumping into it, and Blade writes the
/// tag from the target triple it linked for. A tag is not an ISA description
/// and never will be — it answers exactly one question, "would this code run
/// here", and the answer is a table lookup rather than a guess.
///
/// Fixed-width backing because these values are the wire format (design 47).
public enum SosimgArch: UInt8 {
    case Riscv32 = 1,
    case Arm64 = 2,
}

public extension SosimgArch {
    /// The tag as it appears in a header.
    public func tag(&self) -> UInt8 {
        self as UInt8
    }

    /// A short name, for a diagnostic that has to say which profile an image
    /// was built for.
    public func describe(&self) -> String {
        match self {
            case Riscv32 -> "riscv32",
            case Arm64 -> "arm64",
        }
    }
}

/// One segment permission, as the BIT it occupies in a `SosimgSeg.flags` mask.
///
/// This order — R = 1, W = 2, X = 4 — is deliberately the same as a RISC-V PMP
/// config's low three bits, so the kernel installs a segment's permissions
/// without translating them. (ELF numbers them the other way round; Blade
/// converts when it reads the linked image.) The backing is fixed-width because
/// these values are the wire format, not an implementation detail — design 47.
public enum SegFlag: UInt8 {
    case Read = 1,
    case Write = 2,
    case Execute = 4,
}

public extension SosimgHeader {
    /// Are these bytes a sosimg at all?
    public func has_magic(&self) -> Bool {
        self.magic == SOSIMG_MAGIC
    }

    /// Is this a version this build understands?
    public func has_known_version(&self) -> Bool {
        self.version == SOSIMG_VERSION
    }

    /// Was this image built for `arch`?
    ///
    /// The comparison is on the RAW byte rather than on a decoded
    /// `SosimgArch`, and that is the point: an unrecognized tag is simply not
    /// this loader's, so it fails here without ever needing a name. Decoding is
    /// for the diagnostic, not for the check.
    public func is_for_arch(&self, arch: UInt8) -> Bool {
        self.arch == arch
    }

    /// Everything a header can be judged on WITHOUT knowing where the image
    /// lives, how big it is, or what machine is reading it. A loader still has
    /// to check the arch tag, bound `seg_count` against its own budget and
    /// check every segment against its own memory map — those are target
    /// decisions and stay with the target.
    public func is_wellformed(&self) -> Bool {
        self.has_magic() && self.has_known_version() && self.seg_count > 0u8
    }
}

public extension SosimgSeg {
    /// Does this segment's mask carry `flag`?
    ///
    /// The one place the mask arithmetic lives, so a bit test reads as a
    /// question about a permission rather than as an `&` against a constant.
    public func has(&self, flag: SegFlag) -> Bool {
        (self.flags & (flag as UInt8)) != 0u8
    }

    public func is_readable(&self) -> Bool {
        self.has(SegFlag.Read)
    }

    public func is_writable(&self) -> Bool {
        self.has(SegFlag.Write)
    }

    public func is_executable(&self) -> Bool {
        self.has(SegFlag.Execute)
    }

    /// A segment's memory image can never be smaller than its file image.
    public func mem_covers_file(&self) -> Bool {
        self.mem_len >= self.file_len
    }

    /// Write-without-read is not a meaningful grant, and a segment that grants
    /// neither read nor execute is not worth a region. (RISC-V additionally
    /// RESERVES the W-without-R PMP encoding, so on Profile A this is not just
    /// tidiness — it is a configuration the hardware does not define.)
    public func has_sane_perms(&self) -> Bool {
        if self.is_writable() && not self.is_readable() {
            return false
        }
        self.is_readable() || self.is_executable()
    }

    /// Everything a segment can be judged on without a memory map.
    public func is_wellformed(&self) -> Bool {
        self.mem_covers_file() && self.has_sane_perms()
    }
}
