// SOS root server (design 140; sos/spec.md §12) — U-mode.
//
// Root is the first and only process the kernel loads. Everything else — the
// launcher, the name service, every later process — is root's job, not the
// kernel's (§12: splitting them out later must require zero kernel changes).
//
// v1 proves the boundary and nothing more: print a banner and stop the machine.
// What makes that worth booting is HOW it prints. Root holds no PMP grant for
// the UART; a character reaches the console only because root asked the System
// object to put it there, holding a handle carrying the DEBUG right. Take the
// handle away and root is mute — which is exactly the property the M/U split is
// supposed to have.
//
// NOTE WHAT IS NOT HERE: no op numbers, no `ecall`, no syscall stub, and no
// architecture. All of that belongs to the kernel package and is reached
// through the `sos` module it exports (§5.7's vDSO discipline — numbers are not
// ABI). This file would build for arm64 unchanged.

import sos.{System}

/// Root's exit status when its work is done.
static EXIT_OK: UInt = 0

@export("_start")
func _start(boot_handle: UInt) {
    let system = System(boot_handle: boot_handle)

    // The TYPED SAW altitude: a method on a handle.
    //
    // A failure here has nowhere to be reported TO — the console is the thing
    // that would have failed — so it is deliberately dropped rather than
    // dressed up as handled.
    let _ = system.debug_print("SOS root: hello from U-mode via a System op\n")

    // The TYPED C altitude, exercised rather than merely linked. `print`
    // reaches the console through the runtime's `__saw_rt_write` seam, which
    // the user HAL implements over the kernel package's `@export`ed
    // `sos_system_debug_print` — so this line runs the C chain end to end.
    //
    // It is also design 137 working in U-mode: a format argument rendered into
    // stack scratch, with no allocator anywhere in this process.
    print("SOS root: boot handle {}", boot_handle)

    let _ = system.shutdown(EXIT_OK)
}
