import src.model.*

static MAX_CALL_DEPTH: Int = 128
struct CallResult { values: Vector<Int> }
extension CallResult: NoCopy {}
struct StringEntry { value: String, refs: Int }
func runtime_error(message: String) -> ProtoError { problem(message, 0, 0) }
func overflow_error() -> ProtoError { runtime_error("runtime error: integer overflow") }

func string_entry(heap: &Vector<StringEntry>, handle: Int) -> Result<Int, ProtoError> {
    if handle <= 0 { return runtime_error("runtime error: invalid string handle") }
    let index = handle - 1
    if index >= heap.len() || heap[index].refs <= 0 {
        return runtime_error("runtime error: invalid string handle")
    }
    index
}

func string_retain(heap: &var Vector<StringEntry>, handle: Int) -> Result<Void, ProtoError> {
    if handle == 0 { return }
    let index = try string_entry(&heap, handle)
    if heap[index].refs == Int.max { return runtime_error("runtime error: string allocation failed") }
    heap[index].refs += 1
    return
}

func string_release(heap: &var Vector<StringEntry>, handle: Int) -> Result<Void, ProtoError> {
    if handle == 0 { return }
    let index = try string_entry(&heap, handle)
    heap[index].refs -= 1
    if heap[index].refs == 0 { heap[index].value = "" }
    return
}

func string_allocate(heap: &var Vector<StringEntry>, value: String) -> Result<Int, ProtoError> {
    var index = 0
    while index < heap.len() {
        if heap[index].refs == 0 {
            heap[index].value = value
            heap[index].refs = 1
            return index + 1
        }
        index += 1
    }
    try! heap.push(StringEntry(value: value, refs: 1))
    heap.len()
}

func string_assign(cells: &var Vector<Int>, dst: Int, source: Int,
                   heap: &var Vector<StringEntry>, retain: Bool) -> Result<Void, ProtoError> {
    if retain { try string_retain(&var heap, source) }
    try string_release(&var heap, cells[dst])
    cells[dst] = source
    return
}

func checked_binary(a: Int, b: Int, t: ValueType, op: Op) -> Result<Int, ProtoError> {
    if integer_signed(t) {
        let lo = integer_min(t)
        let hi = integer_max(t)
        if op == Op.Add {
            if (b > 0 && a > hi - b) || (b < 0 && a < lo - b) { return overflow_error() }
            return a + b
        }
        if op == Op.Sub {
            if (b < 0 && a > hi + b) || (b > 0 && a < lo + b) { return overflow_error() }
            return a - b
        }
        if a == 0 || b == 0 { return 0 }
        if a > 0 {
            if b > 0 { if a > hi / b { return overflow_error() } }
            else { if b < lo / a { return overflow_error() } }
        } else {
            if b > 0 { if a < lo / b { return overflow_error() } }
            else { if a < hi / b { return overflow_error() } }
        }
        return a * b
    }
    let ua = UInt.from(truncating: a)
    let ub = UInt.from(truncating: b)
    let hi = UInt.from(truncating: integer_max(t))
    var result: UInt = 0
    if op == Op.Add {
        if ub > hi || ua > hi - ub { return overflow_error() }
        result = ua + ub
    } else if op == Op.Sub {
        if ua < ub { return overflow_error() }
        result = ua - ub
    } else {
        if ua != 0 && ub > hi / ua { return overflow_error() }
        result = ua * ub
    }
    Int.from(truncating: result)
}

func wrapping_binary(a: Int, b: Int, t: ValueType, op: Op) -> Int {
    let ua = UInt.from(truncating: a)
    let ub = UInt.from(truncating: b)
    var result = ua
    if op == Op.WrapAdd { result = ua &+ ub }
    else if op == Op.WrapSub { result = ua &- ub }
    else { result = ua &* ub }
    integer_normalize(Int.from(truncating: result), t)
}

func divide(a: Int, b: Int, t: ValueType, remainder: Bool) -> Result<Int, ProtoError> {
    if b == 0 { return runtime_error("runtime error: division by zero") }
    if integer_signed(t) {
        if a == integer_min(t) && b == -1 { return overflow_error() }
        return if remainder { a % b } else { a / b }
    }
    let ua = UInt.from(truncating: a)
    let ub = UInt.from(truncating: b)
    Int.from(truncating: if remainder { ua % ub } else { ua / ub })
}

func shift(a: Int, c: Int, ct: ValueType, t: ValueType, left: Bool) -> Result<Int, ProtoError> {
    if (integer_signed(ct) && c < 0) || UInt.from(truncating: c) >= UInt.from(truncating: integer_width(t)) { return runtime_error("runtime error: shift out of range") }
    let n = Int.from(truncating: UInt.from(truncating: c))
    if left { return integer_normalize(Int.from(truncating: UInt.from(truncating: a) << n), t) }
    if integer_signed(t) { return integer_normalize(a >> n, t) }
    integer_normalize(Int.from(truncating: UInt.from(truncating: a) >> n), t)
}

func compare(a: Int, b: Int, t: ValueType, op: Op) -> Int {
    var yes = false
    if integer_signed(t) {
        if op == Op.Lt { yes = a < b } else if op == Op.Le { yes = a <= b } else if op == Op.Gt { yes = a > b } else { yes = a >= b }
    } else {
        let ua = UInt.from(truncating: a)
        let ub = UInt.from(truncating: b)
        if op == Op.Lt { yes = ua < ub } else if op == Op.Le { yes = ua <= ub } else if op == Op.Gt { yes = ua > ub } else { yes = ua >= ub }
    }
    if yes { 1 } else { 0 }
}

func valid_reference(cells: &Vector<Int>, address: Int, width: Int) -> Bool {
    address >= 0 && address <= cells.len() && width <= cells.len() - address
}

func run_function(program: &Program, function_index: Int, arguments: &Vector<Int>,
                  cells: &var Vector<Int>, heap: &var Vector<StringEntry>, remaining: &var Int,
                  depth: Int) -> Result<CallResult, ProtoError> {
    if depth > MAX_CALL_DEPTH { return runtime_error("runtime error: call depth exceeded") }
    let function = program.functions[function_index].copy()
    let base = cells.len()
    var si = 0
    while si < function.slots.len() {
        try! cells.push(0)
        si = si + 1
    }
    var ai = 0
    while ai < arguments.len() {
        if string_type(function.slots[ai]) { try string_assign(&var cells, base + ai, arguments[ai], &var heap, true) }
        else { cells[base + ai] = arguments[ai] }
        ai = ai + 1
    }
    var pc = 0
    while pc < function.code.len() {
        if remaining <= 0 { return runtime_error("runtime error: instruction budget exceeded") }
        remaining = remaining - 1
        let inst = function.code[pc].copy()
        let t = if inst.dst >= 0 { function.slots[inst.dst] } else { ValueType.Void }
        match inst.op {
            case Const -> { cells[base + inst.dst] = inst.immediate },
            case StringConst -> {
                let handle = try string_allocate(&var heap, program.strings[inst.immediate])
                try string_assign(&var cells, base + inst.dst, handle, &var heap, false)
            },
            case Copy -> {
                if string_type(t) { try string_assign(&var cells, base + inst.dst, cells[base + inst.a], &var heap, true) }
                else { cells[base + inst.dst] = cells[base + inst.a] }
            },
            case Addr -> { cells[base + inst.dst] = base + inst.a },
            case LoadRef -> {
                let address = cells[base + inst.a]
                let target = try reference_target(&program.references, function.slots[inst.a])
                let layout = try value_layout(&program.records, &program.sums, target)
                if not valid_reference(&cells, address, layout.len()) { return runtime_error("runtime error: invalid reference") }
                var values = Vector<Int>()
                var word = 0
                while word < layout.len() {
                    try! values.push(cells[address + word])
                    word += 1
                }
                word = 0
                while word < values.len() {
                    if string_type(layout[word]) { try string_retain(&var heap, values[word]) }
                    word += 1
                }
                word = 0
                while word < values.len() {
                    if string_type(layout[word]) {
                        try string_assign(&var cells, base + inst.dst + word, values[word], &var heap, false)
                    } else { cells[base + inst.dst + word] = values[word] }
                    word += 1
                }
            },
            case StoreRef -> {
                let address = cells[base + inst.a]
                let target = try reference_target(&program.references, function.slots[inst.a])
                let layout = try value_layout(&program.records, &program.sums, target)
                if not valid_reference(&cells, address, layout.len()) { return runtime_error("runtime error: invalid reference") }
                var values = Vector<Int>()
                var word = 0
                while word < layout.len() {
                    try! values.push(cells[base + inst.b + word])
                    word += 1
                }
                word = 0
                while word < values.len() {
                    if string_type(layout[word]) { try string_retain(&var heap, values[word]) }
                    word += 1
                }
                word = 0
                while word < values.len() {
                    if string_type(layout[word]) {
                        try string_assign(&var cells, address + word, values[word], &var heap, false)
                    } else { cells[address + word] = values[word] }
                    word += 1
                }
            },
            case RefField -> {
                let address = cells[base + inst.a]
                let parent = try reference_target(&program.references, function.slots[inst.a])
                let layout = try value_layout(&program.records, &program.sums, parent)
                if not valid_reference(&cells, address, layout.len()) { return runtime_error("runtime error: invalid reference") }
                match parent {
                    case Record(index) -> {
                        let offset = try record_field_offset(&program.records, &program.sums, index, inst.immediate)
                        cells[base + inst.dst] = address + offset
                    },
                    case _ -> { return runtime_error("runtime error: invalid reference") }
                }
            },
            case Add -> { cells[base + inst.dst] = try checked_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case Sub -> { cells[base + inst.dst] = try checked_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case Mul -> { cells[base + inst.dst] = try checked_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case WrapAdd -> { cells[base + inst.dst] = wrapping_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case WrapSub -> { cells[base + inst.dst] = wrapping_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case WrapMul -> { cells[base + inst.dst] = wrapping_binary(cells[base + inst.a], cells[base + inst.b], t, inst.op) },
            case Div -> { cells[base + inst.dst] = try divide(cells[base + inst.a], cells[base + inst.b], t, false) },
            case Rem -> { cells[base + inst.dst] = try divide(cells[base + inst.a], cells[base + inst.b], t, true) },
            case Neg -> {
                let a = cells[base + inst.a]
                if a == integer_min(t) { return overflow_error() }
                cells[base + inst.dst] = 0 - a
            },
            case Cast -> {
                if not integer_fits(cells[base + inst.a], function.slots[inst.a], t) { return runtime_error("runtime error: integer cast out of range") }
                cells[base + inst.dst] = integer_normalize(cells[base + inst.a], t)
            },
            case Truncate -> { cells[base + inst.dst] = integer_normalize(cells[base + inst.a], t) },
            case BitAnd -> { cells[base + inst.dst] = integer_normalize(cells[base + inst.a] & cells[base + inst.b], t) },
            case BitOr -> { cells[base + inst.dst] = integer_normalize(cells[base + inst.a] | cells[base + inst.b], t) },
            case BitXor -> { cells[base + inst.dst] = integer_normalize(cells[base + inst.a] ^ cells[base + inst.b], t) },
            case BitNot -> { cells[base + inst.dst] = integer_normalize(~cells[base + inst.a], t) },
            case Shl -> { cells[base + inst.dst] = try shift(cells[base + inst.a], cells[base + inst.b], function.slots[inst.b], t, true) },
            case Shr -> { cells[base + inst.dst] = try shift(cells[base + inst.a], cells[base + inst.b], function.slots[inst.b], t, false) },
            case Not -> { cells[base + inst.dst] = if cells[base + inst.a] == 0 { 1 } else { 0 } },
            case Eq -> {
                if string_type(function.slots[inst.a]) {
                    let left = try string_entry(&heap, cells[base + inst.a])
                    let right = try string_entry(&heap, cells[base + inst.b])
                    cells[base + inst.dst] = if heap[left].value == heap[right].value { 1 } else { 0 }
                } else { cells[base + inst.dst] = if cells[base + inst.a] == cells[base + inst.b] { 1 } else { 0 } }
            },
            case Ne -> {
                if string_type(function.slots[inst.a]) {
                    let left = try string_entry(&heap, cells[base + inst.a])
                    let right = try string_entry(&heap, cells[base + inst.b])
                    cells[base + inst.dst] = if heap[left].value != heap[right].value { 1 } else { 0 }
                } else { cells[base + inst.dst] = if cells[base + inst.a] != cells[base + inst.b] { 1 } else { 0 } }
            },
            case Lt -> { cells[base + inst.dst] = compare(cells[base + inst.a], cells[base + inst.b], function.slots[inst.a], inst.op) },
            case Le -> { cells[base + inst.dst] = compare(cells[base + inst.a], cells[base + inst.b], function.slots[inst.a], inst.op) },
            case Gt -> { cells[base + inst.dst] = compare(cells[base + inst.a], cells[base + inst.b], function.slots[inst.a], inst.op) },
            case Ge -> { cells[base + inst.dst] = compare(cells[base + inst.a], cells[base + inst.b], function.slots[inst.a], inst.op) },
            case Jump -> {
                pc = inst.target
                continue
            },
            case Branch -> {
                if cells[base + inst.a] != 0 {
                    pc = inst.target
                    continue
                }
            },
            case Call -> {
                var args = Vector<Int>()
                var i = 0
                while i < inst.args.len() {
                    try! args.push(cells[base + inst.args[i]])
                    i = i + 1
                }
                let result = try run_function(&program, inst.target, &args, &var cells, &var heap, &var remaining, depth + 1)
                var result_index = 0
                while result_index < result.values.len() {
                    if string_type(function.slots[inst.dst + result_index]) {
                        try string_assign(&var cells, base + inst.dst + result_index, result.values[result_index], &var heap, false)
                    } else { cells[base + inst.dst + result_index] = result.values[result_index] }
                    result_index = result_index + 1
                }
            },
            case Print -> {
                let pt = function.slots[inst.a]
                if string_type(pt) {
                    let index = try string_entry(&heap, cells[base + inst.a])
                    print(heap[index].value)
                }
                else if pt == ValueType.Bool { if cells[base + inst.a] == 0 { print("false") } else { print("true") } }
                else if integer_signed(pt) { print(cells[base + inst.a]) } else { print(UInt.from(truncating: cells[base + inst.a])) }
            },
            case StringLen -> {
                let index = try string_entry(&heap, cells[base + inst.a])
                cells[base + inst.dst] = heap[index].value.len()
            },
            case StringByteAt -> {
                let index = try string_entry(&heap, cells[base + inst.a])
                let offset = cells[base + inst.b]
                if offset < 0 || offset >= heap[index].value.len() { return runtime_error("runtime error: string index out of range") }
                cells[base + inst.dst] = heap[index].value.byte_at(offset) as Int
            },
            case StringSlice -> {
                let index = try string_entry(&heap, cells[base + inst.a])
                let start = cells[base + inst.b]
                let end = cells[base + inst.args[0]]
                if start < 0 || start > end || end > heap[index].value.len() { return runtime_error("runtime error: string range out of bounds") }
                let handle = try string_allocate(&var heap, heap[index].value.substring(start, end))
                try string_assign(&var cells, base + inst.dst, handle, &var heap, false)
            },
            case Drop -> {
                try string_release(&var heap, cells[base + inst.a])
                cells[base + inst.a] = 0
            },
            case Return -> {
                var values = Vector<Int>()
                let layout = try value_layout(&program.records, &program.sums, function.result)
                var result_index = 0
                while result_index < layout.len() {
                    if string_type(layout[result_index]) { try string_retain(&var heap, cells[base + inst.a + result_index]) }
                    try! values.push(cells[base + inst.a + result_index])
                    result_index = result_index + 1
                }
                var slot = 0
                while slot < function.slots.len() {
                    if string_type(function.slots[slot]) {
                        try string_release(&var heap, cells[base + slot])
                        cells[base + slot] = 0
                    }
                    slot += 1
                }
                while cells.len() > base { let _ = cells.pop() }
                return CallResult(values: move values)
            }
        }
        pc = pc + 1
    }
    runtime_error("runtime error: instruction budget exceeded")
}

public func execute(program: &Program, budget: Int) -> Result<Void, ProtoError> {
    var remaining = budget
    let arguments = Vector<Int>()
    var cells = Vector<Int>()
    var heap = Vector<StringEntry>()
    let _ = try run_function(&program, program.main_index, &arguments, &var cells, &var heap, &var remaining, 1)
    var index = 0
    while index < heap.len() {
        if heap[index].refs != 0 { return runtime_error("runtime error: live string allocation") }
        index += 1
    }
    return
}
