public enum ValueType {
    case I8, case I16, case I32, case I64,
    case U8, case U16, case U32, case U64, case Byte,
    case Bool, case Void, case String, case Record(index: Int), case Enum(index: Int), case Ref(index: Int),
    case Optional(index: Int), case Result(index: Int)
}
@synthesize
extension ValueType: Equatable {}

public enum Op {
    case Const, case Copy, case Add, case Sub, case Mul, case Div, case Rem,
    case Neg, case Not, case Eq, case Ne, case Lt, case Le, case Gt, case Ge,
    case Jump, case Branch, case Call, case Print, case Return, case Panic,
    case Cast, case Truncate, case WrapAdd, case WrapSub, case WrapMul,
    case Addr, case LoadRef, case StoreRef, case RefField,
    case StringConst, case StringLen, case StringByteAt, case StringSlice, case Drop,
    case BitAnd, case BitOr, case BitXor, case BitNot, case Shl, case Shr
}
@synthesize
extension Op: Equatable {}

public func integer_type(t: ValueType) -> Bool {
    return integer_width(t) > 0
}

public func arithmetic_type(t: ValueType) -> Bool {
    return integer_type(t) && t != ValueType.Byte
}

public func integer_signed(t: ValueType) -> Bool {
    return t == ValueType.I8 || t == ValueType.I16 || t == ValueType.I32 || t == ValueType.I64
}

public func integer_width(t: ValueType) -> Int {
    if t == ValueType.I8 || t == ValueType.U8 || t == ValueType.Byte { return 8 }
    if t == ValueType.I16 || t == ValueType.U16 { return 16 }
    if t == ValueType.I32 || t == ValueType.U32 { return 32 }
    if t == ValueType.I64 || t == ValueType.U64 { return 64 }
    return 0
}

public func integer_min(t: ValueType) -> Int {
    if not integer_signed(t) { return 0 }
    if t == ValueType.I64 { return Int.min }
    return 0 - (1 << (integer_width(t) - 1))
}

public func integer_max(t: ValueType) -> Int {
    if t == ValueType.I64 { return Int.max }
    if t == ValueType.U64 { return -1 }
    let width = integer_width(t)
    if width == 0 { return 0 }
    if integer_signed(t) { return (1 << (width - 1)) - 1 }
    return (1 << width) - 1
}

public func integer_normalize(value: Int, t: ValueType) -> Int {
    let width = integer_width(t)
    if width == 64 || width == 0 { return value }
    let mask = (1 << width) - 1
    let low = value & mask
    if integer_signed(t) && low >= (1 << (width - 1)) { return low - (1 << width) }
    return low
}

public func integer_canonical(value: Int, t: ValueType) -> Bool {
    return integer_type(t) && integer_normalize(value, t) == value
}

public func integer_fits(value: Int, source: ValueType, target: ValueType) -> Bool {
    if not integer_type(source) || not integer_type(target) { return false }
    if integer_signed(source) && value < 0 {
        return integer_signed(target) && value >= integer_min(target)
    }
    let unsigned_value = UInt.from(truncating: value)
    let maximum = UInt.from(truncating: integer_max(target))
    return unsigned_value <= maximum
}

public func integer_widens(source: ValueType, target: ValueType) -> Bool {
    if not integer_type(source) || not integer_type(target) { return false }
    if source == target { return true }
    if target == ValueType.Byte { return false }
    if source == ValueType.Byte && target == ValueType.U8 { return true }
    if integer_signed(source) == integer_signed(target) {
        return integer_width(target) > integer_width(source)
    }
    return not integer_signed(source) && integer_signed(target) && integer_width(target) > integer_width(source)
}

public struct Instruction {
    public op: Op
    public dst: Int
    public a: Int
    public b: Int
    public immediate: Int
    public target: Int
    public args: Vector<Int>
    public line: Int
    public col: Int
}

public struct FuncIR {
    public name: String
    public params: Vector<ValueType>
    public result: ValueType
    public slots: Vector<ValueType>
    public code: Vector<Instruction>
}

public struct EnumIR {
    public name: String
    public cases: Vector<String>
    public line: Int
    public col: Int
}
@synthesize
extension EnumIR: ExplicitCopy {}

public enum SumKind { case Optional, case Result }
@synthesize
extension SumKind: Equatable {}

public struct SumIR {
    public kind: SumKind
    public payload: ValueType
    public error: ValueType
}
@synthesize
extension SumIR: ExplicitCopy {}

public struct Program {
    public strings: Vector<String>
    public references: Vector<ReferenceIR>
    public enums: Vector<EnumIR>
    public records: Vector<RecordIR>
    public sums: Vector<SumIR>
    public functions: Vector<FuncIR>
    public main_index: Int
}

public struct ReferenceIR {
    public target: ValueType
    public mutable: Bool
}

public struct RecordIR {
    public name: String
    public field_names: Vector<String>
    public field_types: Vector<ValueType>
    public line: Int
    public col: Int
}
@synthesize
extension RecordIR: ExplicitCopy {}

@synthesize
extension Instruction: ExplicitCopy {}
@synthesize
extension FuncIR: ExplicitCopy {}
@synthesize
extension Program: ExplicitCopy {}

public struct ProtoError {
    public message: String
    public line: Int
    public col: Int
}
extension ProtoError: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self.message)
    }
}

public func instruction(op: Op) -> Instruction {
    Instruction(op: op, dst: -1, a: -1, b: -1, immediate: 0,
                target: -1, args: Vector<Int>(), line: 0, col: 0)
}

public func problem(message: String, line: Int, col: Int) -> ProtoError {
    ProtoError(message: message, line: line, col: col)
}

public func printable_type(t: ValueType) -> Bool {
    integer_type(t) || t == ValueType.Bool || string_type(t)
}

public func string_type(t: ValueType) -> Bool { t == ValueType.String }

public func scalar_type(t: ValueType) -> Bool {
    match t {
        case Enum(_) -> true,
        case _ -> integer_type(t) || t == ValueType.Bool
    }
}

public func reference_type(t: ValueType) -> Bool {
    match t {
        case Ref(_) -> true,
        case _ -> false
    }
}

public func optional_type(t: ValueType) -> Bool {
    match t { case Optional(_) -> true, case _ -> false }
}

public func result_type(t: ValueType) -> Bool {
    match t { case Result(_) -> true, case _ -> false }
}

public func optional_payload(sums: &Vector<SumIR>, t: ValueType) -> Result<ValueType, ProtoError> {
    match t {
        case Optional(index) -> {
            if index < 0 || index >= sums.len() { return problem("invalid optional type index", 0, 0) }
            if sums[index].kind != SumKind.Optional { return problem("optional type has mismatched descriptor kind", 0, 0) }
            return sums[index].payload
        },
        case _ -> { return problem("expected optional type", 0, 0) }
    }
}

public func result_payload(sums: &Vector<SumIR>, t: ValueType) -> Result<ValueType, ProtoError> {
    match t {
        case Result(index) -> {
            if index < 0 || index >= sums.len() { return problem("invalid result type index", 0, 0) }
            if sums[index].kind != SumKind.Result { return problem("result type has mismatched descriptor kind", 0, 0) }
            return sums[index].payload
        },
        case _ -> { return problem("expected result type", 0, 0) }
    }
}

public func result_error(sums: &Vector<SumIR>, t: ValueType) -> Result<ValueType, ProtoError> {
    match t {
        case Result(index) -> {
            if index < 0 || index >= sums.len() { return problem("invalid result type index", 0, 0) }
            if sums[index].kind != SumKind.Result { return problem("result type has mismatched descriptor kind", 0, 0) }
            return sums[index].error
        },
        case _ -> { return problem("expected result type", 0, 0) }
    }
}

public func reference_target(refs: &Vector<ReferenceIR>, t: ValueType) -> Result<ValueType, ProtoError> {
    match t {
        case Ref(index) -> {
            if index < 0 || index >= refs.len() { return problem("invalid reference type index", 0, 0) }
            return refs[index].target
        },
        case _ -> { return problem("expected reference type", 0, 0) }
    }
}

public func reference_mutable(refs: &Vector<ReferenceIR>, t: ValueType) -> Bool {
    match t {
        case Ref(index) -> {
            if index < 0 || index >= refs.len() { return false }
            return refs[index].mutable
        },
        case _ -> false
    }
}

public func reference_transfer(refs: &Vector<ReferenceIR>, source: ValueType, target: ValueType) -> Bool {
    let source_target = try reference_target(&refs, source) catch { return false }
    let target_target = try reference_target(&refs, target) catch { return false }
    source_target == target_target && (not reference_mutable(&refs, target) || reference_mutable(&refs, source))
}

public func validate_references(refs: &Vector<ReferenceIR>) -> Result<Void, ProtoError> {
    var n = 0
    while n < refs.len() {
        if not scalar_type(refs[n].target) && not string_type(refs[n].target) {
            match refs[n].target {
                case Record(_) -> {},
                case Optional(_) -> {},
                case Result(_) -> {},
                case _ -> { return problem("reference target must be a data type", 0, 0) }
            }
        }
        n += 1
    }
    return
}

public func validate_enums(enums: &Vector<EnumIR>) -> Result<Void, ProtoError> {
    var n = 0
    while n < enums.len() {
        let declaration = enums[n].copy()
        if declaration.cases.len() == 0 { return problem("enum must have at least one case", declaration.line, declaration.col) }
        var previous = 0
        while previous < n {
            if enums[previous].name == declaration.name { return problem("duplicate enum", declaration.line, declaration.col) }
            previous += 1
        }
        var current = 0
        while current < declaration.cases.len() {
            previous = 0
            while previous < current {
                if declaration.cases[previous] == declaration.cases[current] { return problem("duplicate enum case", declaration.line, declaration.col) }
                previous += 1
            }
            current += 1
        }
        n += 1
    }
    return
}

func append_layout(records: &Vector<RecordIR>, sums: &Vector<SumIR>, t: ValueType,
                   record_path: &var Vector<Int>, sum_path: &var Vector<Int>, depth: Int,
                   words: &var Vector<ValueType>) -> Result<Void, ProtoError> {
    if scalar_type(t) || string_type(t) {
        if words.len() >= 256 { return problem("record layout exceeds 256 words", 0, 0) }
        try! words.push(t)
        return
    }
    match t {
        case Record(index) -> {
            if index < 0 || index >= records.len() { return problem("invalid record type index", 0, 0) }
            let record = records[index].copy()
            if record.field_types.len() == 0 || record.field_names.len() != record.field_types.len() {
                return problem("record must have matching nonempty fields", record.line, record.col)
            }
            var n = 0
            while n < record_path.len() {
                if record_path[n] == index { return problem("recursive by-value record", record.line, record.col) }
                n += 1
            }
            if depth >= 128 { return problem("record nesting exceeds 128 levels", record.line, record.col) }
            try! record_path.push(index)
            n = 0
            while n < record.field_types.len() {
                try append_layout(&records, &sums, record.field_types[n], &var record_path, &var sum_path, depth + 1, &var words) catch {
                    if error.line == 0 { return problem(error.message, record.line, record.col) }
                    return error
                }
                n += 1
            }
            let _ = record_path.pop()
            return
        },
        case Optional(index) -> {
            let payload = try optional_payload(&sums, t)
            if payload == ValueType.Void || reference_type(payload) { return problem("optional payload must be a data type", 0, 0) }
            if sums[index].error != ValueType.Void { return problem("optional descriptor error must be Void", 0, 0) }
            var n = 0
            while n < sum_path.len() {
                if sum_path[n] == index { return problem("recursive aggregate type", 0, 0) }
                n += 1
            }
            if depth >= 128 { return problem("aggregate nesting exceeds 128 levels", 0, 0) }
            try! sum_path.push(index)
            try append_layout(&records, &sums, ValueType.Bool, &var record_path, &var sum_path, depth + 1, &var words)
            try append_layout(&records, &sums, payload, &var record_path, &var sum_path, depth + 1, &var words)
            let _ = sum_path.pop()
            return
        },
        case Result(index) -> {
            let payload = try result_payload(&sums, t)
            let error_type = try result_error(&sums, t)
            if reference_type(payload) || error_type == ValueType.Void || reference_type(error_type) {
                return problem("result alternatives must be data types", 0, 0)
            }
            var n = 0
            while n < sum_path.len() {
                if sum_path[n] == index { return problem("recursive aggregate type", 0, 0) }
                n += 1
            }
            if depth >= 128 { return problem("aggregate nesting exceeds 128 levels", 0, 0) }
            try! sum_path.push(index)
            try append_layout(&records, &sums, ValueType.Bool, &var record_path, &var sum_path, depth + 1, &var words)
            if payload != ValueType.Void {
                try append_layout(&records, &sums, payload, &var record_path, &var sum_path, depth + 1, &var words)
            }
            try append_layout(&records, &sums, error_type, &var record_path, &var sum_path, depth + 1, &var words)
            let _ = sum_path.pop()
            return
        },
        case Ref(_) -> { return problem("reference record fields are not supported", 0, 0) },
        case _ -> { return problem("Void is not a record field type", 0, 0) }
    }
}

public func value_layout(records: &Vector<RecordIR>, sums: &Vector<SumIR>, t: ValueType) -> Result<Vector<ValueType>, ProtoError> {
    var words = Vector<ValueType>()
    if reference_type(t) || string_type(t) {
        try! words.push(t)
        return move words
    }
    if t != ValueType.Void {
        var record_path = Vector<Int>()
        var sum_path = Vector<Int>()
        try append_layout(&records, &sums, t, &var record_path, &var sum_path, 0, &var words)
    }
    move words
}

public func validate_records(records: &Vector<RecordIR>, sums: &Vector<SumIR>) -> Result<Void, ProtoError> {
    var n = 0
    while n < records.len() {
        let record = records[n].copy()
        var previous = 0
        while previous < n {
            if records[previous].name == record.name { return problem("duplicate record", record.line, record.col) }
            previous += 1
        }
        var field = 0
        while field < record.field_names.len() {
            previous = 0
            while previous < field {
                if record.field_names[previous] == record.field_names[field] {
                    return problem("duplicate record field", record.line, record.col)
                }
                previous += 1
            }
            field += 1
        }
        let _ = try value_layout(&records, &sums, ValueType.Record(n))
        n += 1
    }
    return
}

public func validate_sums(records: &Vector<RecordIR>, sums: &Vector<SumIR>) -> Result<Void, ProtoError> {
    var n = 0
    while n < sums.len() {
        let t = if sums[n].kind == SumKind.Optional { ValueType.Optional(n) } else { ValueType.Result(n) }
        let _ = try value_layout(&records, &sums, t)
        n += 1
    }
    return
}

public func record_field_offset(records: &Vector<RecordIR>, sums: &Vector<SumIR>, record_index: Int,
                                field_index: Int) -> Result<Int, ProtoError> {
    let _ = try value_layout(&records, &sums, ValueType.Record(record_index))
    let record = records[record_index].copy()
    if field_index < 0 || field_index >= record.field_types.len() {
        return problem("invalid record field index", record.line, record.col)
    }
    var offset = 0
    var n = 0
    while n < field_index {
        let field = try value_layout(&records, &sums, record.field_types[n])
        offset += field.len()
        n += 1
    }
    offset
}
