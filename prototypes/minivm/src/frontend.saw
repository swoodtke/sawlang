import sawlex.src.lib.*
import src.model.*

func Some<T>(value: T) -> T? { move value }

func clone_token(t: &Token) -> Token {
    Token(kind: t.kind, value: t.value, line: t.line, col: t.col, suffix: t.suffix)
}

struct Signature {
    name: String
    param_names: Vector<String>
    params: Vector<ValueType>
    result: ValueType
    body_start: Int
    body_end: Int
    line: Int
    col: Int
}
extension Signature: NoCopy {}

struct Binding {
    name: String
    ty: ValueType
    slot: Int
    mutable: Bool
    depth: Int
}

struct ExprValue {
    ty: ValueType
    slot: Int
    call: Bool
    literal: Bool
    literal_value: UInt
    literal_negative: Bool
}

func expr_value(ty: ValueType, slot: Int, call: Bool) -> ExprValue {
    ExprValue(ty: ty, slot: slot, call: call, literal: false,
              literal_value: 0, literal_negative: false)
}

func type_name(t: ValueType) -> String {
    match t {
        case I8 -> "Int8", case I16 -> "Int16", case I32 -> "Int32", case I64 -> "Int",
        case U8 -> "UInt8", case U16 -> "UInt16", case U32 -> "UInt32", case U64 -> "UInt",
        case Byte -> "Byte", case Bool -> "Bool", case Void -> "Void"
    }
}

func named_integer_type(name: String) -> ValueType? {
    match name {
        case "Int8" -> Some(ValueType.I8), case "Int16" -> Some(ValueType.I16),
        case "Int32" -> Some(ValueType.I32), case "Int64" -> Some(ValueType.I64),
        case "Int" -> Some(ValueType.I64), case "UInt8" -> Some(ValueType.U8),
        case "UInt16" -> Some(ValueType.U16), case "UInt32" -> Some(ValueType.U32),
        case "UInt64" -> Some(ValueType.U64), case "UInt" -> Some(ValueType.U64),
        case "Byte" -> Some(ValueType.Byte), case _ -> None
    }
}

func suffix_type(s: String) -> ValueType? {
    match s {
        case "i8" -> Some(ValueType.I8), case "i16" -> Some(ValueType.I16),
        case "i32" -> Some(ValueType.I32), case "i64" -> Some(ValueType.I64),
        case "u8" -> Some(ValueType.U8), case "u16" -> Some(ValueType.U16),
        case "u32" -> Some(ValueType.U32), case "u64" -> Some(ValueType.U64),
        case _ -> None
    }
}

func literal_magnitude(value: String) -> UInt? {
    if value.starts_with("0x") { return value.substring(2, value.len()).to_uint(16) }
    if value.starts_with("0b") { return value.substring(2, value.len()).to_uint(2) }
    if value.starts_with("0o") { return value.substring(2, value.len()).to_uint(8) }
    value.to_uint()
}

struct Compiler {
    tokens: Vector<Token>
    signatures: Vector<Signature>
    pos: Int
    depth: Int
    expr_depth: Int
    paren_depth: Int
    bindings: Vector<Binding>
    slots: Vector<ValueType>
    code: Vector<Instruction>
    current_result: ValueType
}
extension Compiler: NoCopy {}

extension Compiler {
    func token(&self) -> Token { clone_token(&self.tokens[self.pos]) }

    func at(&self, kind: TokenKind) -> Bool { self.token().kind == kind }

    func fail(&self, message: String) -> ProtoError {
        problem(message, self.token().line, self.token().col)
    }

    func take(&var self) -> Token {
        let t = clone_token(&self.tokens[self.pos])
        self.pos += 1
        t
    }

    func expect(&var self, kind: TokenKind, message: String) -> Result<Token, ProtoError> {
        if not self.at(kind) { return self.fail(message) }
        self.take()
    }

    func skip_newlines(&var self) {
        while self.at(TokenKind.Newline) { let _ = self.take() }
    }

    func expr_space(&var self) {
        if self.paren_depth > 0 { self.skip_newlines() }
    }

    func literal_followed_by_cast(&self) -> Bool {
        var i = self.pos + 1
        if self.paren_depth > 0 {
            while i < self.tokens.len() && self.tokens[i].kind == TokenKind.Newline { i += 1 }
        }
        i < self.tokens.len() && self.tokens[i].kind == TokenKind.As
    }

    func parse_type(&var self) -> Result<ValueType, ProtoError> {
        let t = try self.expect(TokenKind.Ident, "expected type")
        if t.value == "Bool" { return ValueType.Bool }
        if let ty = named_integer_type(t.value) { return ty }
        problem("unsupported type `{t.value}`", t.line, t.col)
    }

    func signature_index(&self, name: String) -> Int {
        var i = 0
        while i < self.signatures.len() {
            if self.signatures[i].name == name { return i }
            i += 1
        }
        -1
    }

    func scan_signatures(&var self) -> Result<Void, ProtoError> {
        self.pos = 0
        self.skip_newlines()
        while not self.at(TokenKind.Eof) {
            let ft = try self.expect(TokenKind.Func, "only function declarations are supported at module scope")
            let name = try self.expect(TokenKind.Ident, "expected function name")
            if name.value == "print" {
                return problem("`print` is reserved by the prototype", name.line, name.col)
            }
            if self.signature_index(name.value) >= 0 {
                return problem("duplicate function `{name.value}`", name.line, name.col)
            }
            let _ = try self.expect(TokenKind.LParen, "expected `(` after function name")
            var pnames = Vector<String>()
            var ptypes = Vector<ValueType>()
            self.skip_newlines()
            if not self.at(TokenKind.RParen) {
                var more = true
                while more {
                    let pn = try self.expect(TokenKind.Ident, "expected parameter name")
                    var j = 0
                    while j < pnames.len() {
                        if pnames[j] == pn.value {
                            return problem("duplicate parameter `{pn.value}`", pn.line, pn.col)
                        }
                        j += 1
                    }
                    self.skip_newlines()
                    let _ = try self.expect(TokenKind.Colon, "expected `:` after parameter name")
                    self.skip_newlines()
                    let pt = try self.parse_type()
                    try! pnames.push(pn.value)
                    try! ptypes.push(pt)
                    self.skip_newlines()
                    if self.at(TokenKind.Comma) {
                        let _ = self.take()
                        self.skip_newlines()
                    } else { more = false }
                }
            }
            let _ = try self.expect(TokenKind.RParen, "expected `)` after parameters")
            var result = ValueType.Void
            if self.at(TokenKind.Arrow) {
                let _ = self.take()
                result = try self.parse_type()
            }
            let _ = try self.expect(TokenKind.LBrace, "expected function body")
            let start = self.pos
            var braces = 1
            while braces > 0 && not self.at(TokenKind.Eof) {
                if self.at(TokenKind.LBrace) { braces += 1 }
                if self.at(TokenKind.RBrace) { braces -= 1 }
                let _ = self.take()
            }
            if braces != 0 { return problem("unterminated function body", ft.line, ft.col) }
            let finish = self.pos - 1
            try! self.signatures.push(Signature(name: name.value, param_names: move pnames,
                params: move ptypes, result: result, body_start: start, body_end: finish,
                line: name.line, col: name.col))
            self.skip_newlines()
        }
        var mains = 0
        var main_i = -1
        var i = 0
        while i < self.signatures.len() {
            if self.signatures[i].name == "main" {
                mains += 1
                main_i = i
                if self.signatures[i].params.len() != 0 || self.signatures[i].result != ValueType.Void {
                    return problem("main must have no parameters and return Void",
                                   self.signatures[i].line, self.signatures[i].col)
                }
            }
            i += 1
        }
        if mains != 1 {
            let t = self.token()
            return problem("program must declare exactly one main function", t.line, t.col)
        }
        return
    }

    func new_slot(&var self, ty: ValueType) -> Int {
        let n = self.slots.len()
        try! self.slots.push(ty)
        n
    }

    func emit(&var self, ins: Instruction) -> Int {
        let n = self.code.len()
        try! self.code.push(move ins)
        n
    }

    func emit_at(&var self, op: Op, line: Int, col: Int) -> Int {
        var ins = instruction(op: op)
        ins.line = line
        ins.col = col
        self.emit(move ins)
    }

    func binding_index(&self, name: String) -> Int {
        var i = self.bindings.len()
        while i > 0 {
            i -= 1
            if self.bindings[i].name == name { return i }
        }
        -1
    }

    func declare(&var self, name: Token, ty: ValueType, slot: Int, mutable: Bool) -> Result<Void, ProtoError> {
        var i = self.bindings.len()
        while i > 0 {
            i -= 1
            if self.bindings[i].depth != self.depth { break }
            if self.bindings[i].name == name.value {
                return problem("duplicate declaration `{name.value}` in this scope", name.line, name.col)
            }
        }
        try! self.bindings.push(Binding(name: name.value, ty: ty, slot: slot,
                                        mutable: mutable, depth: self.depth))
        return
    }

    func leave_scope(&var self) {
        while self.bindings.len() > 0 && self.bindings[self.bindings.len() - 1].depth == self.depth {
            let _ = self.bindings.pop()
        }
    }

    func terminator(&var self) -> Result<Void, ProtoError> {
        if self.at(TokenKind.Semicolon) { return self.fail("semicolons are not supported") }
        if self.at(TokenKind.Newline) {
            self.skip_newlines()
            return
        }
        if self.at(TokenKind.RBrace) { return }
        self.fail("expected newline after statement")
    }

    func require_type(&self, got: ValueType, wanted: ValueType, t: &Token) -> Result<Void, ProtoError> {
        if got != wanted { return problem("type mismatch", t.line, t.col) }
        return
    }

    func literal_fits_target(&self, v: &ExprValue, target: ValueType) -> Bool {
        if not v.literal || not integer_type(target) || target == ValueType.Byte { return false }
        if v.literal_negative {
            if not integer_signed(target) { return false }
            return v.literal_value <= UInt.from(truncating: integer_max(target)) + 1
        }
        v.literal_value <= UInt.from(truncating: integer_max(target))
    }

    func adopt_literal(&var self, v: ExprValue, target: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        if not self.literal_fits_target(&v, target) {
            return problem("integer literal does not fit {type_name(target)}", t.line, t.col)
        }
        var bits = Int.from(truncating: v.literal_value)
        if v.literal_negative {
            if v.literal_value == UInt.from(truncating: Int.max) + 1 { bits = Int.min }
            else { bits = 0 - bits }
        }
        bits = integer_normalize(bits, target)
        self.slots[v.slot] = target
        var i = self.code.len()
        while i > 0 {
            i -= 1
            if self.code[i].op == Op.Const && self.code[i].dst == v.slot {
                self.code[i].immediate = bits
                break
            }
        }
        ExprValue(ty: target, slot: v.slot, call: false, literal: true,
                  literal_value: v.literal_value, literal_negative: v.literal_negative)
    }

    func transfer(&var self, v: ExprValue, target: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        if v.ty == target {
            if v.literal && not self.literal_fits_target(&v, target) {
                return problem("integer literal does not fit {type_name(target)}", t.line, t.col)
            }
            return v
        }
        if v.literal { return self.adopt_literal(v, target, &t) }
        if integer_widens(v.ty, target) {
            let dst = self.new_slot(target)
            let at = self.emit_at(Op.Cast, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(target, dst, false)
        }
        problem("cannot implicitly convert {type_name(v.ty)} to {type_name(target)}", t.line, t.col)
    }

    func parse_primary(&var self) -> Result<ExprValue, ProtoError> {
        if self.depth > 128 { return self.fail("expression nesting limit exceeded") }
        if self.at(TokenKind.IntLit) {
            let t = self.take()
            guard let magnitude = literal_magnitude(t.value) else { return problem("invalid integer literal", t.line, t.col) }
            var ty = ValueType.I64
            var bare = true
            if let suffix = t.suffix {
                bare = false
                guard let st = suffix_type(suffix) else { return problem("unsupported integer suffix `{suffix}`", t.line, t.col) }
                ty = st
            }
            let maximum = UInt.from(truncating: integer_max(ty))
            if not bare && integer_signed(ty) && magnitude > maximum { return problem("integer literal does not fit {type_name(ty)}", t.line, t.col) }
            let dst = self.new_slot(ty)
            let at = self.emit_at(Op.Const, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].immediate = integer_normalize(Int.from(truncating: magnitude), ty)
            return ExprValue(ty: ty, slot: dst, call: false, literal: bare,
                             literal_value: magnitude, literal_negative: false)
        }
        if self.at(TokenKind.True_) || self.at(TokenKind.False_) {
            let t = self.take()
            let dst = self.new_slot(ValueType.Bool)
            let at = self.emit_at(Op.Const, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].immediate = if t.kind == TokenKind.True_ { 1 } else { 0 }
            return expr_value(ValueType.Bool, dst, false)
        }
        if self.at(TokenKind.LParen) {
            let _ = self.take()
            self.depth += 1
            self.paren_depth += 1
            self.skip_newlines()
            let value = try self.parse_expr()
            self.skip_newlines()
            let _ = try self.expect(TokenKind.RParen, "expected `)`")
            self.paren_depth -= 1
            self.depth -= 1
            return value
        }
        if self.at(TokenKind.Ident) {
            let name = self.take()
            if let ty = named_integer_type(name.value) {
                if self.at(TokenKind.Dot) { return self.parse_integer_member(name, ty) }
                if self.at(TokenKind.LParen) && ty == ValueType.Byte { return self.parse_byte(name) }
            }
            if self.at(TokenKind.LParen) { return self.parse_call(name) }
            let bi = self.binding_index(name.value)
            if bi < 0 { return problem("unknown name `{name.value}`", name.line, name.col) }
            return expr_value(self.bindings[bi].ty, self.bindings[bi].slot, false)
        }
        self.fail("expected expression; this syntax is unsupported")
    }

    func parse_byte(&var self, name: Token) -> Result<ExprValue, ProtoError> {
        let _ = self.take()
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        var value = try self.parse_expr()
        value = try self.transfer(value, ValueType.U8, &name)
        self.skip_newlines()
        let _ = try self.expect(TokenKind.RParen, "expected `)` after Byte value")
        self.paren_depth -= 1
        self.depth -= 1
        let dst = self.new_slot(ValueType.Byte)
        let at = self.emit_at(Op.Cast, name.line, name.col)
        self.code[at].dst = dst
        self.code[at].a = value.slot
        expr_value(ValueType.Byte, dst, false)
    }

    func parse_integer_member(&var self, name: Token, ty: ValueType) -> Result<ExprValue, ProtoError> {
        let _ = self.take()
        let member = try self.expect(TokenKind.Ident, "expected numeric member")
        if member.value == "min" || member.value == "max" {
            if ty == ValueType.Byte { return problem("Byte has no numeric limit members", member.line, member.col) }
            if self.at(TokenKind.LParen) { return problem("integer limits are constants", member.line, member.col) }
            let dst = self.new_slot(ty)
            let at = self.emit_at(Op.Const, member.line, member.col)
            self.code[at].dst = dst
            self.code[at].immediate = if member.value == "min" { integer_min(ty) } else { integer_max(ty) }
            return expr_value(ty, dst, false)
        }
        if member.value != "from" { return problem("unsupported numeric member `{member.value}`", member.line, member.col) }
        let _ = try self.expect(TokenKind.LParen, "expected `(` after from")
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        let label = try self.expect(TokenKind.Ident, "only `from(truncating:)` is supported")
        if label.value != "truncating" { return problem("only `from(truncating:)` is supported", label.line, label.col) }
        let _ = try self.expect(TokenKind.Colon, "expected `:` after truncating")
        self.skip_newlines()
        var value = try self.parse_expr()
        value = try self.transfer(value, value.ty, &name)
        if not integer_type(value.ty) || ty == ValueType.Byte { return problem("truncating conversion requires integer types", name.line, name.col) }
        self.skip_newlines()
        let _ = try self.expect(TokenKind.RParen, "expected `)` after conversion")
        self.paren_depth -= 1
        self.depth -= 1
        let dst = self.new_slot(ty)
        let at = self.emit_at(Op.Truncate, name.line, name.col)
        self.code[at].dst = dst
        self.code[at].a = value.slot
        expr_value(ty, dst, false)
    }

    func parse_call(&var self, name: Token) -> Result<ExprValue, ProtoError> {
        let fi = self.signature_index(name.value)
        if fi < 0 { return problem("unknown function `{name.value}`", name.line, name.col) }
        let _ = self.take()
        var args = Vector<Int>()
        var ai = 0
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        if not self.at(TokenKind.RParen) {
            var more = true
            while more {
                var value = try self.parse_expr()
                if ai >= self.signatures[fi].params.len() {
                    return problem("too many arguments to `{name.value}`", name.line, name.col)
                }
                value = try self.transfer(value, self.signatures[fi].params[ai], &name)
                try! args.push(value.slot)
                ai += 1
                self.skip_newlines()
                if self.at(TokenKind.Comma) {
                    let _ = self.take()
                    self.skip_newlines()
                } else { more = false }
            }
        }
        let _ = try self.expect(TokenKind.RParen, "expected `)` after arguments")
        self.paren_depth -= 1
        self.depth -= 1
        if ai != self.signatures[fi].params.len() {
            return problem("wrong number of arguments to `{name.value}`", name.line, name.col)
        }
        let rt = self.signatures[fi].result
        let dst = if rt == ValueType.Void { -1 } else { self.new_slot(rt) }
        let at = self.emit_at(Op.Call, name.line, name.col)
        self.code[at].target = fi
        self.code[at].dst = dst
        self.code[at].args = move args
        expr_value(rt, dst, true)
    }

    func parse_unary_inner(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        if self.at(TokenKind.Exclaim) || self.at(TokenKind.Not_) {
            let t = self.take()
            self.expr_space()
            var v = try self.parse_unary()
            v = try self.transfer(v, v.ty, &t)
            try self.require_type(v.ty, ValueType.Bool, &t)
            let dst = self.new_slot(ValueType.Bool)
            let at = self.emit_at(Op.Not, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(ValueType.Bool, dst, false)
        }
        if self.at(TokenKind.Minus) {
            let t = self.take()
            self.expr_space()
            if self.at(TokenKind.IntLit) && not self.literal_followed_by_cast() {
                let lit = self.take()
                guard let magnitude = literal_magnitude(lit.value) else { return problem("invalid integer literal", lit.line, lit.col) }
                var ty = ValueType.I64
                var bare = true
                if let suffix = lit.suffix {
                    bare = false
                    guard let st = suffix_type(suffix) else { return problem("unsupported integer suffix `{suffix}`", lit.line, lit.col) }
                    ty = st
                }
                if not integer_signed(ty) { return problem("cannot negate an unsigned integer", t.line, t.col) }
                let limit = UInt.from(truncating: integer_max(ty)) + 1
                if magnitude > limit { return problem("integer literal does not fit {type_name(ty)}", lit.line, lit.col) }
                var bits = Int.from(truncating: magnitude)
                if magnitude == UInt.from(truncating: Int.max) + 1 { bits = Int.min }
                else { bits = 0 - bits }
                bits = integer_normalize(bits, ty)
                let dst = self.new_slot(ty)
                let at = self.emit_at(Op.Const, t.line, t.col)
                self.code[at].dst = dst
                self.code[at].immediate = bits
                let value = ExprValue(ty: ty, slot: dst, call: false, literal: bare,
                                      literal_value: magnitude, literal_negative: true)
                return value
            }
            let v = try self.parse_unary()
            if not arithmetic_type(v.ty) || not integer_signed(v.ty) { return problem("unary `-` requires a signed integer", t.line, t.col) }
            let dst = self.new_slot(v.ty)
            let at = self.emit_at(Op.Neg, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(v.ty, dst, false)
        }
        if self.at(TokenKind.Tilde) {
            let t = self.take()
            self.expr_space()
            var v = try self.parse_unary()
            v = try self.transfer(v, v.ty, &t)
            if not arithmetic_type(v.ty) { return problem("operator `~` requires an integer", t.line, t.col) }
            let dst = self.new_slot(v.ty)
            let at = self.emit_at(Op.BitNot, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(v.ty, dst, false)
        }
        self.parse_cast()
    }

    func parse_cast(&var self) -> Result<ExprValue, ProtoError> {
        let value = try self.parse_primary()
        self.parse_casts(value)
    }

    func parse_casts(&var self, initial: ExprValue) -> Result<ExprValue, ProtoError> {
        var value = initial
        self.expr_space()
        while self.at(TokenKind.As) {
            let t = self.take()
            self.expr_space()
            let target = try self.parse_type()
            value = try self.transfer(value, value.ty, &t)
            if not integer_type(value.ty) || not integer_type(target) || target == ValueType.Byte {
                return problem("`as` requires integer source and target types", t.line, t.col)
            }
            let dst = self.new_slot(target)
            let at = self.emit_at(Op.Cast, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = value.slot
            value = expr_value(target, dst, false)
            self.expr_space()
        }
        value
    }

    func parse_unary(&var self) -> Result<ExprValue, ProtoError> {
        if self.expr_depth >= 128 { return self.fail("expression nesting limit exceeded") }
        self.expr_depth += 1
        let value = try self.parse_unary_inner()
        self.expr_depth -= 1
        value
    }

    func binary(&var self, left: ExprValue, right: ExprValue, op: Op,
                result: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        let dst = self.new_slot(result)
        let at = self.emit_at(op, t.line, t.col)
        self.code[at].dst = dst
        self.code[at].a = left.slot
        self.code[at].b = right.slot
        expr_value(result, dst, false)
    }

    func common_type(&self, left: &ExprValue, right: &ExprValue,
                     t: &Token) -> Result<ValueType, ProtoError> {
        if left.ty == right.ty {
            if left.literal && not self.literal_fits_target(&left, left.ty) { return problem("integer literal does not fit {type_name(left.ty)}", t.line, t.col) }
            if right.literal && not self.literal_fits_target(&right, right.ty) { return problem("integer literal does not fit {type_name(right.ty)}", t.line, t.col) }
            return left.ty
        }
        if left.literal && not right.literal { return right.ty }
        if right.literal && not left.literal { return left.ty }
        problem("numeric operands must have the same type", t.line, t.col)
    }

    func parse_mul(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        var left = try self.parse_unary()
        self.expr_space()
        while self.at(TokenKind.Star) || self.at(TokenKind.Slash) || self.at(TokenKind.Percent) || self.at(TokenKind.WrapMul) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_unary()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("arithmetic requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Star { Op.Mul } else if t.kind == TokenKind.Slash { Op.Div } else if t.kind == TokenKind.Percent { Op.Rem } else { Op.WrapMul }
            let result = left.ty
            left = try self.binary(left, right, op, result, &t)
        }
        left
    }

    func parse_add(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_mul()
        self.expr_space()
        while self.at(TokenKind.Plus) || self.at(TokenKind.Minus) || self.at(TokenKind.WrapAdd) || self.at(TokenKind.WrapSub) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_mul()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("arithmetic requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Plus { Op.Add } else if t.kind == TokenKind.Minus { Op.Sub } else if t.kind == TokenKind.WrapAdd { Op.WrapAdd } else { Op.WrapSub }
            let result = left.ty
            left = try self.binary(left, right, op, result, &t)
        }
        left
    }

    func adjacent(&self, a: &Token, b: &Token) -> Bool {
        a.line == b.line && b.col == a.col + 1
    }

    func shift_ahead(&self, kind: TokenKind) -> Bool {
        if self.pos + 1 >= self.tokens.len() || not self.at(kind) || self.tokens[self.pos + 1].kind != kind { return false }
        let a = self.token()
        self.adjacent(&a, &self.tokens[self.pos + 1])
    }

    func parse_shift(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_add()
        self.expr_space()
        while self.shift_ahead(TokenKind.Lt) || self.shift_ahead(TokenKind.Gt) {
            let t = self.take()
            let _ = self.take()
            self.expr_space()
            var right = try self.parse_add()
            self.expr_space()
            left = try self.transfer(left, left.ty, &t)
            right = try self.transfer(right, right.ty, &t)
            if not arithmetic_type(left.ty) || not arithmetic_type(right.ty) { return problem("shift requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, if t.kind == TokenKind.Lt { Op.Shl } else { Op.Shr }, result, &t)
        }
        left
    }

    func parse_compare(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_shift()
        self.expr_space()
        if self.at(TokenKind.Lt) || self.at(TokenKind.Lte) || self.at(TokenKind.Gt) || self.at(TokenKind.Gte) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_shift()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("comparison requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Lt { Op.Lt } else if t.kind == TokenKind.Lte { Op.Le } else if t.kind == TokenKind.Gt { Op.Gt } else { Op.Ge }
            left = try self.binary(left, right, op, ValueType.Bool, &t)
        }
        left
    }

    func parse_equality(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        var left = try self.parse_compare()
        self.expr_space()
        if self.at(TokenKind.Eq) || self.at(TokenKind.Neq) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_compare()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if left.ty == ValueType.Void || left.ty != right.ty { return problem("equality operands must have the same scalar type", t.line, t.col) }
            left = try self.binary(left, right, if t.kind == TokenKind.Eq { Op.Eq } else { Op.Ne }, ValueType.Bool, &t)
        }
        left
    }

    func parse_bit_and(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_equality()
        self.expr_space()
        while self.at(TokenKind.Ampersand) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_equality()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitAnd, result, &t)
        }
        left
    }

    func parse_bit_xor(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_bit_and()
        self.expr_space()
        while self.at(TokenKind.Caret) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_bit_and()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitXor, result, &t)
        }
        left
    }

    func parse_expr(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_bit_xor()
        self.expr_space()
        while self.at(TokenKind.Pipe) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_bit_xor()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitOr, result, &t)
        }
        left
    }

    func parse_block(&var self) -> Result<Bool, ProtoError> {
        if self.depth >= 128 { return self.fail("block nesting limit exceeded") }
        self.depth += 1
        self.skip_newlines()
        var returns = false
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            let r = try self.parse_statement()
            if not returns && r { returns = true }
            try self.terminator()
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace")
        self.leave_scope()
        self.depth -= 1
        returns
    }

    func parse_statement(&var self) -> Result<Bool, ProtoError> {
        if self.at(TokenKind.Semicolon) { return self.fail("semicolons are not supported") }
        if self.at(TokenKind.Let) || self.at(TokenKind.Var) {
            let kw = self.take()
            let name = try self.expect(TokenKind.Ident, "expected local name")
            var annotated: ValueType? = None
            if self.at(TokenKind.Colon) {
                let _ = self.take()
                annotated = Some(try self.parse_type())
            }
            let _ = try self.expect(TokenKind.Assign, "local declarations require an initializer")
            var value = try self.parse_expr()
            if value.ty == ValueType.Void { return problem("cannot initialize a local with Void", name.line, name.col) }
            if let ty = annotated { value = try self.transfer(value, ty, &name) }
            else { value = try self.transfer(value, value.ty, &name) }
            let dst = self.new_slot(value.ty)
            let at = self.emit_at(Op.Copy, name.line, name.col)
            self.code[at].dst = dst
            self.code[at].a = value.slot
            try self.declare(name, value.ty, dst, kw.kind == TokenKind.Var)
            return false
        }
        if self.at(TokenKind.Return) {
            let t = self.take()
            var src = -1
            if not self.at(TokenKind.Newline) && not self.at(TokenKind.RBrace) {
                var value = try self.parse_expr()
                value = try self.transfer(value, self.current_result, &t)
                src = value.slot
            } else if self.current_result != ValueType.Void { return problem("non-Void return requires a value", t.line, t.col) }
            let at = self.emit_at(Op.Return, t.line, t.col)
            self.code[at].a = src
            return true
        }
        if self.at(TokenKind.If) {
            let t = self.take()
            let cond = try self.parse_expr()
            try self.require_type(cond.ty, ValueType.Bool, &t)
            let _ = try self.expect(TokenKind.LBrace, "expected block after if condition")
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = cond.slot
            let skip_then = self.emit_at(Op.Jump, t.line, t.col)
            self.code[branch].target = self.code.len()
            let then_returns = try self.parse_block()
            let skip_else = self.emit_at(Op.Jump, t.line, t.col)
            self.code[skip_then].target = self.code.len()
            var else_returns = false
            let before_else = self.pos
            self.skip_newlines()
            if self.at(TokenKind.Else) {
                let _ = self.take()
                let _ = try self.expect(TokenKind.LBrace, "expected block after else")
                else_returns = try self.parse_block()
            } else {
                self.pos = before_else
            }
            self.code[skip_else].target = self.code.len()
            return then_returns && else_returns
        }
        if self.at(TokenKind.While) {
            let t = self.take()
            let cond_start = self.code.len()
            let cond = try self.parse_expr()
            try self.require_type(cond.ty, ValueType.Bool, &t)
            let _ = try self.expect(TokenKind.LBrace, "expected block after while condition")
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = cond.slot
            let exit = self.emit_at(Op.Jump, t.line, t.col)
            self.code[branch].target = self.code.len()
            let _ = try self.parse_block()
            let back = self.emit_at(Op.Jump, t.line, t.col)
            self.code[back].target = cond_start
            self.code[exit].target = self.code.len()
            return false
        }
        if self.at(TokenKind.LBrace) {
            let _ = self.take()
            return self.parse_block()
        }
        if self.at(TokenKind.Ident) && self.token().value == "print" {
            let t = self.take()
            let _ = try self.expect(TokenKind.LParen, "expected `(` after print")
            self.depth += 1
            self.paren_depth += 1
            self.skip_newlines()
            var value = try self.parse_expr()
            value = try self.transfer(value, value.ty, &t)
            self.skip_newlines()
            let _ = try self.expect(TokenKind.RParen, "expected `)` after print argument")
            self.paren_depth -= 1
            self.depth -= 1
            if value.ty == ValueType.Void { return problem("cannot print Void", t.line, t.col) }
            let at = self.emit_at(Op.Print, t.line, t.col)
            self.code[at].a = value.slot
            return false
        }
        if self.at(TokenKind.Ident) && self.pos + 1 < self.tokens.len() && self.tokens[self.pos + 1].kind == TokenKind.Assign {
            let name = self.take()
            let _ = self.take()
            let bi = self.binding_index(name.value)
            if bi < 0 { return problem("unknown local `{name.value}`", name.line, name.col) }
            if not self.bindings[bi].mutable { return problem("cannot assign to immutable local `{name.value}`", name.line, name.col) }
            var value = try self.parse_expr()
            value = try self.transfer(value, self.bindings[bi].ty, &name)
            let at = self.emit_at(Op.Copy, name.line, name.col)
            self.code[at].dst = self.bindings[bi].slot
            self.code[at].a = value.slot
            return false
        }
        let start = self.token()
        let value = try self.parse_expr()
        if not value.call || value.ty != ValueType.Void {
            return problem("only Void function calls may be expression statements", start.line, start.col)
        }
        false
    }

    func compile_function(&var self, index: Int) -> Result<FuncIR, ProtoError> {
        self.pos = self.signatures[index].body_start
        self.depth = 0
        self.expr_depth = 0
        self.paren_depth = 0
        self.bindings = Vector<Binding>()
        self.slots = Vector<ValueType>()
        self.code = Vector<Instruction>()
        self.current_result = self.signatures[index].result
        var i = 0
        while i < self.signatures[index].params.len() {
            let slot = self.new_slot(self.signatures[index].params[i])
            let fake = Token(kind: TokenKind.Ident, value: self.signatures[index].param_names[i],
                             line: self.signatures[index].line, col: self.signatures[index].col, suffix: None)
            try self.declare(fake, self.signatures[index].params[i], slot, false)
            i += 1
        }
        self.skip_newlines()
        var returns = false
        while self.pos < self.signatures[index].body_end {
            let r = try self.parse_statement()
            if not returns && r { returns = true }
            try self.terminator()
        }
        if self.pos != self.signatures[index].body_end { return self.fail("malformed function body") }
        if self.current_result != ValueType.Void && not returns {
            return problem("function `{self.signatures[index].name}` may reach its end without returning a value",
                           self.signatures[index].line, self.signatures[index].col)
        }
        if self.current_result == ValueType.Void {
            let _ = self.emit_at(Op.Return, self.signatures[index].line, self.signatures[index].col)
        } else {
            // Return-path checking above proves this padding unreachable. It gives
            // end-of-block jumps a real target and leaves every emitted block terminated.
            let slot = self.new_slot(self.current_result)
            let c = self.emit_at(Op.Const, self.signatures[index].line, self.signatures[index].col)
            self.code[c].dst = slot
            self.code[c].immediate = 0
            let r = self.emit_at(Op.Return, self.signatures[index].line, self.signatures[index].col)
            self.code[r].a = slot
        }
        let slots = self.slots.copy()
        let code = self.code.copy()
        FuncIR(name: self.signatures[index].name, params: self.signatures[index].params.copy(),
               result: self.current_result, slots: move slots, code: move code)
    }
}

public func compile_source(source: String) -> Result<Program, ProtoError> {
    let tokens = match lex(source) {
        case Ok(ts) -> move ts,
        case Err(e) -> { return problem(e.message, e.line, e.col) }
    }
    var compiler = Compiler(tokens: move tokens, signatures: Vector<Signature>(), pos: 0, depth: 0,
                            expr_depth: 0, paren_depth: 0,
                            bindings: Vector<Binding>(), slots: Vector<ValueType>(),
                            code: Vector<Instruction>(), current_result: ValueType.Void)
    try compiler.scan_signatures()
    var functions = Vector<FuncIR>()
    var main_index = -1
    var i = 0
    while i < compiler.signatures.len() {
        if compiler.signatures[i].name == "main" { main_index = i }
        let f = try compiler.compile_function(i)
        try! functions.push(move f)
        i += 1
    }
    Program(functions: move functions, main_index: main_index)
}
