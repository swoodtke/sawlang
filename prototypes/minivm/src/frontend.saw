import sawlex.src.lib.*
import src.model.*

func Some<T>(value: T) -> T? { move value }

func clone_token(t: &Token) -> Token {
    Token(kind: t.kind, value: t.value, line: t.line, col: t.col, suffix: t.suffix)
}

struct Signature {
    name: String
    param_names: Vector<String>
    params: Vector<ValueType>
    result: ValueType
    body_start: Int
    body_end: Int
    line: Int
    col: Int
}
extension Signature: NoCopy {}

struct Binding {
    name: String
    ty: ValueType
    slot: Int
    mutable: Bool
    depth: Int
}

struct Place {
    ty: ValueType
    slot: Int
    mutable: Bool
    indirect: Bool
    root: Int
}

struct Borrow {
    root: Int
    mutable: Bool
}

struct StaticBinding {
    name: String
    ty: ValueType
    value: Int
    line: Int
    col: Int
}

struct ExprValue {
    ty: ValueType
    slot: Int
    call: Bool
    literal: Bool
    literal_value: UInt
    literal_negative: Bool
    always_returns: Bool
}

struct BlockValue {
    has_value: Bool
    value: ExprValue
    always_returns: Bool
}

func expr_value(ty: ValueType, slot: Int, call: Bool) -> ExprValue {
    ExprValue(ty: ty, slot: slot, call: call, literal: false,
              literal_value: 0, literal_negative: false, always_returns: false)
}

func returning_value() -> ExprValue {
    var v = expr_value(ValueType.Void, -1, false)
    v.always_returns = true
    v
}

func type_name(t: ValueType) -> String {
    match t {
        case I8 -> "Int8", case I16 -> "Int16", case I32 -> "Int32", case I64 -> "Int",
        case U8 -> "UInt8", case U16 -> "UInt16", case U32 -> "UInt32", case U64 -> "UInt",
        case Byte -> "Byte", case Bool -> "Bool", case Void -> "Void",
        case Record(_) -> "record", case Enum(_) -> "enum", case Ref(_) -> "reference"
    }
}

func named_integer_type(name: String) -> ValueType? {
    match name {
        case "Int8" -> Some(ValueType.I8), case "Int16" -> Some(ValueType.I16),
        case "Int32" -> Some(ValueType.I32), case "Int64" -> Some(ValueType.I64),
        case "Int" -> Some(ValueType.I64), case "UInt8" -> Some(ValueType.U8),
        case "UInt16" -> Some(ValueType.U16), case "UInt32" -> Some(ValueType.U32),
        case "UInt64" -> Some(ValueType.U64), case "UInt" -> Some(ValueType.U64),
        case "Byte" -> Some(ValueType.Byte), case _ -> None
    }
}

func suffix_type(s: String) -> ValueType? {
    match s {
        case "i8" -> Some(ValueType.I8), case "i16" -> Some(ValueType.I16),
        case "i32" -> Some(ValueType.I32), case "i64" -> Some(ValueType.I64),
        case "u8" -> Some(ValueType.U8), case "u16" -> Some(ValueType.U16),
        case "u32" -> Some(ValueType.U32), case "u64" -> Some(ValueType.U64),
        case _ -> None
    }
}

func literal_magnitude(value: String) -> UInt? {
    if value.starts_with("0x") { return value.substring(2, value.len()).to_uint(16) }
    if value.starts_with("0b") { return value.substring(2, value.len()).to_uint(2) }
    if value.starts_with("0o") { return value.substring(2, value.len()).to_uint(8) }
    value.to_uint()
}

struct Compiler {
    tokens: Vector<Token>
    records: Vector<RecordIR>
    enums: Vector<EnumIR>
    references: Vector<ReferenceIR>
    statics: Vector<StaticBinding>
    signatures: Vector<Signature>
    pos: Int
    depth: Int
    expr_depth: Int
    paren_depth: Int
    bindings: Vector<Binding>
    active_borrows: Vector<Borrow>
    pending_writes: Vector<Int>
    slots: Vector<ValueType>
    code: Vector<Instruction>
    current_result: ValueType
}
extension Compiler: NoCopy {}

extension Compiler {
    func token(&self) -> Token { clone_token(&self.tokens[self.pos]) }

    func at(&self, kind: TokenKind) -> Bool { self.token().kind == kind }

    func fail(&self, message: String) -> ProtoError {
        problem(message, self.token().line, self.token().col)
    }

    func take(&var self) -> Token {
        let t = clone_token(&self.tokens[self.pos])
        self.pos += 1
        t
    }

    func expect(&var self, kind: TokenKind, message: String) -> Result<Token, ProtoError> {
        if not self.at(kind) { return self.fail(message) }
        self.take()
    }

    func skip_newlines(&var self) {
        while self.at(TokenKind.Newline) { let _ = self.take() }
    }

    func expr_space(&var self) {
        if self.paren_depth > 0 { self.skip_newlines() }
    }

    func literal_followed_by_cast(&self) -> Bool {
        var i = self.pos + 1
        if self.paren_depth > 0 {
            while i < self.tokens.len() && self.tokens[i].kind == TokenKind.Newline { i += 1 }
        }
        i < self.tokens.len() && self.tokens[i].kind == TokenKind.As
    }

    func parse_type(&var self) -> Result<ValueType, ProtoError> {
        if self.at(TokenKind.Ampersand) {
            let amp = self.take()
            var mutable = false
            if self.at(TokenKind.Var) {
                let _ = self.take()
                mutable = true
            }
            if self.at(TokenKind.Ampersand) {
                let nested = self.token()
                return problem("references to references are not supported", nested.line, nested.col)
            }
            let target = try self.parse_type()
            if reference_type(target) { return problem("references to references are not supported", amp.line, amp.col) }
            if not scalar_type(target) { return problem("only scalar references are supported", amp.line, amp.col) }
            return self.intern_reference(target, mutable)
        }
        let t = try self.expect(TokenKind.Ident, "expected type")
        if t.value == "Bool" { return ValueType.Bool }
        if let ty = named_integer_type(t.value) { return ty }
        let ri = self.record_index(t.value)
        if ri >= 0 { return ValueType.Record(ri) }
        let ei = self.enum_index(t.value)
        if ei >= 0 { return ValueType.Enum(ei) }
        problem("unsupported type `{t.value}`", t.line, t.col)
    }

    func intern_reference(&var self, target: ValueType, mutable: Bool) -> ValueType {
        var i = 0
        while i < self.references.len() {
            if self.references[i].target == target && self.references[i].mutable == mutable {
                return ValueType.Ref(i)
            }
            i += 1
        }
        try! self.references.push(ReferenceIR(target: target, mutable: mutable))
        ValueType.Ref(self.references.len() - 1)
    }

    func record_index(&self, name: String) -> Int {
        var i = 0
        while i < self.records.len() {
            if self.records[i].name == name { return i }
            i += 1
        }
        -1
    }

    func static_index(&self, name: String) -> Int {
        var i = 0
        while i < self.statics.len() {
            if self.statics[i].name == name { return i }
            i += 1
        }
        -1
    }

    func enum_index(&self, name: String) -> Int {
        var i = 0
        while i < self.enums.len() {
            if self.enums[i].name == name { return i }
            i += 1
        }
        -1
    }

    func display_type(&self, ty: ValueType) -> String {
        match ty {
            case Record(index) -> {
                if index >= 0 && index < self.records.len() { return self.records[index].name }
                "record"
            },
            case Enum(index) -> {
                if index >= 0 && index < self.enums.len() { return self.enums[index].name }
                "enum"
            },
            case _ -> type_name(ty)
        }
    }

    func reserved_type_name(&self, name: String) -> Bool {
        if name == "Bool" || name == "Void" { return true }
        if let _ = named_integer_type(name) { return true }
        false
    }

    func collect_record_names(&var self) -> Result<Void, ProtoError> {
        self.pos = 0
        self.skip_newlines()
        while not self.at(TokenKind.Eof) {
            if self.at(TokenKind.Public) { let _ = self.take() }
            if self.at(TokenKind.Struct) {
                let _ = self.take()
                let name = try self.expect(TokenKind.Ident, "expected record name")
                if self.reserved_type_name(name.value) || name.value == "print" { return problem("record name `{name.value}` is reserved", name.line, name.col) }
                if self.record_index(name.value) >= 0 || self.enum_index(name.value) >= 0 || self.static_index(name.value) >= 0 { return problem("duplicate module name `{name.value}`", name.line, name.col) }
                try! self.records.push(RecordIR(name: name.value, field_names: Vector<String>(),
                                                field_types: Vector<ValueType>(), line: name.line, col: name.col))
            } else if self.at(TokenKind.Enum) {
                let _ = self.take()
                let name = try self.expect(TokenKind.Ident, "expected enum name")
                if self.reserved_type_name(name.value) || name.value == "print" { return problem("enum name `{name.value}` is reserved", name.line, name.col) }
                if self.record_index(name.value) >= 0 || self.enum_index(name.value) >= 0 || self.static_index(name.value) >= 0 { return problem("duplicate module name `{name.value}`", name.line, name.col) }
                try! self.enums.push(EnumIR(name: name.value, cases: Vector<String>(), line: name.line, col: name.col))
            } else if self.at(TokenKind.Static) {
                let _ = self.take()
                let name = try self.expect(TokenKind.Ident, "expected static name")
                if name.value == "print" || self.reserved_type_name(name.value) { return problem("static name `{name.value}` is reserved", name.line, name.col) }
                if self.record_index(name.value) >= 0 || self.enum_index(name.value) >= 0 || self.static_index(name.value) >= 0 {
                    return problem("duplicate module name `{name.value}`", name.line, name.col)
                }
                try! self.statics.push(StaticBinding(name: name.value, ty: ValueType.Void,
                                                     value: 0, line: name.line, col: name.col))
                while not self.at(TokenKind.Newline) && not self.at(TokenKind.Eof) { let _ = self.take() }
                self.skip_newlines()
                continue
            } else if not self.at(TokenKind.Func) {
                return self.fail("only function, record, enum, and static declarations are supported at module scope")
            }
            while not self.at(TokenKind.LBrace) && not self.at(TokenKind.Eof) { let _ = self.take() }
            if self.at(TokenKind.Eof) { return self.fail("expected declaration body") }
            let _ = self.take()
            var braces = 1
            while braces > 0 && not self.at(TokenKind.Eof) {
                if self.at(TokenKind.LBrace) { braces += 1 }
                if self.at(TokenKind.RBrace) { braces -= 1 }
                let _ = self.take()
            }
            if braces != 0 { return self.fail("unterminated declaration body") }
            self.skip_newlines()
        }
        return
    }

    func signature_index(&self, name: String) -> Int {
        var i = 0
        while i < self.signatures.len() {
            if self.signatures[i].name == name { return i }
            i += 1
        }
        -1
    }

    func scan_signatures(&var self) -> Result<Void, ProtoError> {
        self.pos = 0
        self.skip_newlines()
        while not self.at(TokenKind.Eof) {
            if self.at(TokenKind.Public) { let _ = self.take() }
            if self.at(TokenKind.Struct) {
                try self.scan_record()
                self.skip_newlines()
                continue
            }
            if self.at(TokenKind.Enum) {
                try self.scan_enum()
                self.skip_newlines()
                continue
            }
            if self.at(TokenKind.Static) {
                try self.scan_static()
                self.skip_newlines()
                continue
            }
            let ft = try self.expect(TokenKind.Func, "only function, record, enum, and static declarations are supported at module scope")
            let name = try self.expect(TokenKind.Ident, "expected function name")
            if name.value == "print" {
                return problem("`print` is reserved by the prototype", name.line, name.col)
            }
            if self.signature_index(name.value) >= 0 {
                return problem("duplicate function `{name.value}`", name.line, name.col)
            }
            if self.record_index(name.value) >= 0 {
                return problem("function `{name.value}` conflicts with a record name", name.line, name.col)
            }
            if self.enum_index(name.value) >= 0 {
                return problem("function `{name.value}` conflicts with an enum name", name.line, name.col)
            }
            if self.static_index(name.value) >= 0 {
                return problem("function `{name.value}` conflicts with a static name", name.line, name.col)
            }
            let _ = try self.expect(TokenKind.LParen, "expected `(` after function name")
            var pnames = Vector<String>()
            var ptypes = Vector<ValueType>()
            self.skip_newlines()
            if not self.at(TokenKind.RParen) {
                var more = true
                while more {
                    let pn = try self.expect(TokenKind.Ident, "expected parameter name")
                    var j = 0
                    while j < pnames.len() {
                        if pnames[j] == pn.value {
                            return problem("duplicate parameter `{pn.value}`", pn.line, pn.col)
                        }
                        j += 1
                    }
                    self.skip_newlines()
                    let _ = try self.expect(TokenKind.Colon, "expected `:` after parameter name")
                    self.skip_newlines()
                    let pt = try self.parse_type()
                    try! pnames.push(pn.value)
                    try! ptypes.push(pt)
                    self.skip_newlines()
                    if self.at(TokenKind.Comma) {
                        let _ = self.take()
                        self.skip_newlines()
                    } else { more = false }
                }
            }
            let _ = try self.expect(TokenKind.RParen, "expected `)` after parameters")
            var result = ValueType.Void
            if self.at(TokenKind.Arrow) {
                let _ = self.take()
                result = try self.parse_type()
                if reference_type(result) { return problem("reference results are not supported", name.line, name.col) }
            }
            let _ = try self.expect(TokenKind.LBrace, "expected function body")
            let start = self.pos
            var braces = 1
            while braces > 0 && not self.at(TokenKind.Eof) {
                if self.at(TokenKind.LBrace) { braces += 1 }
                if self.at(TokenKind.RBrace) { braces -= 1 }
                let _ = self.take()
            }
            if braces != 0 { return problem("unterminated function body", ft.line, ft.col) }
            let finish = self.pos - 1
            try! self.signatures.push(Signature(name: name.value, param_names: move pnames,
                params: move ptypes, result: result, body_start: start, body_end: finish,
                line: name.line, col: name.col))
            self.skip_newlines()
        }
        var mains = 0
        var main_i = -1
        var i = 0
        while i < self.signatures.len() {
            if self.signatures[i].name == "main" {
                mains += 1
                main_i = i
                if self.signatures[i].params.len() != 0 || self.signatures[i].result != ValueType.Void {
                    return problem("main must have no parameters and return Void",
                                   self.signatures[i].line, self.signatures[i].col)
                }
            }
            i += 1
        }
        if mains != 1 {
            let t = self.token()
            return problem("program must declare exactly one main function", t.line, t.col)
        }
        return
    }

    func static_integer_value(&self, magnitude: UInt, negative: Bool, bare: Bool,
                              source: ValueType, target: ValueType,
                              t: &Token) -> Result<Int, ProtoError> {
        if not integer_type(target) || target == ValueType.Byte {
            return problem("static integer initializer requires an integer type", t.line, t.col)
        }
        if negative && not integer_signed(source) { return problem("cannot negate an unsigned integer", t.line, t.col) }
        var bits = Int.from(truncating: magnitude)
        if negative {
            if magnitude == UInt.from(truncating: Int.max) + 1 { bits = Int.min }
            else { bits = 0 - bits }
        }
        bits = integer_normalize(bits, source)
        if bare {
            let probe = ExprValue(ty: source, slot: -1, call: false, literal: true,
                                  literal_value: magnitude, literal_negative: negative, always_returns: false)
            if not self.literal_fits_target(&probe, target) {
                return problem("integer literal does not fit {type_name(target)}", t.line, t.col)
            }
            return integer_normalize(bits, target)
        }
        if source != target && not integer_widens(source, target) {
            return problem("cannot implicitly convert {type_name(source)} to {type_name(target)}", t.line, t.col)
        }
        integer_normalize(bits, target)
    }

    func scan_static(&var self) -> Result<Void, ProtoError> {
        let _ = self.take()
        let name = try self.expect(TokenKind.Ident, "expected static name")
        let si = self.static_index(name.value)
        if si < 0 { return problem("unknown static declaration `{name.value}`", name.line, name.col) }
        let _ = try self.expect(TokenKind.Colon, "expected `:` after static name")
        let target = try self.parse_type()
        if target == ValueType.Byte || not printable_type(target) {
            return problem("static type must be an integer or Bool", name.line, name.col)
        }
        let _ = try self.expect(TokenKind.Assign, "static declaration requires an initializer")
        var value = 0
        if self.at(TokenKind.True_) || self.at(TokenKind.False_) {
            let lit = self.take()
            if target != ValueType.Bool { return problem("Bool static initializer requires Bool type", lit.line, lit.col) }
            value = if lit.kind == TokenKind.True_ { 1 } else { 0 }
        } else {
            var negative = false
            var anchor = self.token()
            if self.at(TokenKind.Minus) {
                negative = true
                anchor = self.take()
            }
            if self.at(TokenKind.IntLit) {
                let lit = self.take()
                guard let magnitude = literal_magnitude(lit.value) else { return problem("invalid integer literal", lit.line, lit.col) }
                var source = ValueType.I64
                var bare = true
                if let suffix = lit.suffix {
                    bare = false
                    guard let st = suffix_type(suffix) else { return problem("unsupported integer suffix `{suffix}`", lit.line, lit.col) }
                    source = st
                }
                if not bare {
                    let limit = if negative && integer_signed(source) {
                        UInt.from(truncating: integer_max(source)) + 1
                    } else { UInt.from(truncating: integer_max(source)) }
                    if magnitude > limit { return problem("integer literal does not fit {type_name(source)}", lit.line, lit.col) }
                }
                value = try self.static_integer_value(magnitude, negative, bare, source, target, &anchor)
            } else if not negative && self.at(TokenKind.Ident) {
                let type_token = self.take()
                guard let source = named_integer_type(type_token.value) else { return problem("unsupported static initializer", type_token.line, type_token.col) }
                if source == ValueType.Byte { return problem("unsupported static initializer", type_token.line, type_token.col) }
                let _ = try self.expect(TokenKind.Dot, "unsupported static initializer")
                let member = try self.expect(TokenKind.Ident, "unsupported static initializer")
                if member.value != "min" && member.value != "max" { return problem("unsupported static initializer", member.line, member.col) }
                let bits = if member.value == "min" { integer_min(source) } else { integer_max(source) }
                if target != source && not integer_widens(source, target) {
                    return problem("cannot implicitly convert {type_name(source)} to {type_name(target)}", type_token.line, type_token.col)
                }
                value = integer_normalize(bits, target)
            } else { return problem("unsupported static initializer", anchor.line, anchor.col) }
        }
        if not self.at(TokenKind.Newline) && not self.at(TokenKind.Eof) {
            return self.fail("unsupported static initializer expression")
        }
        self.statics[si].ty = target
        self.statics[si].value = value
        return
    }

    func scan_record(&var self) -> Result<Void, ProtoError> {
        let _ = self.take()
        let name = try self.expect(TokenKind.Ident, "expected record name")
        let ri = self.record_index(name.value)
        if ri < 0 { return problem("unknown record declaration `{name.value}`", name.line, name.col) }
        let _ = try self.expect(TokenKind.LBrace, "expected record body")
        self.skip_newlines()
        var names = Vector<String>()
        var types = Vector<ValueType>()
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            if self.at(TokenKind.Public) { let _ = self.take() }
            let field = try self.expect(TokenKind.Ident, "expected record field name")
            var i = 0
            while i < names.len() {
                if names[i] == field.value { return problem("duplicate record field `{field.value}`", field.line, field.col) }
                i += 1
            }
            let _ = try self.expect(TokenKind.Colon, "expected `:` after record field")
            let ty = try self.parse_type()
            if ty == ValueType.Void { return problem("record field cannot have Void type", field.line, field.col) }
            if reference_type(ty) { return problem("reference record fields are not supported", field.line, field.col) }
            try! names.push(field.value)
            try! types.push(ty)
            if self.at(TokenKind.Comma) {
                let _ = self.take()
                self.skip_newlines()
            } else if self.at(TokenKind.Newline) { self.skip_newlines() }
            else if not self.at(TokenKind.RBrace) { return self.fail("expected comma or newline after record field") }
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace for record")
        if names.len() == 0 { return problem("record must have at least one field", name.line, name.col) }
        self.records[ri].field_names = move names
        self.records[ri].field_types = move types
        return
    }

    func scan_enum(&var self) -> Result<Void, ProtoError> {
        let _ = self.take()
        let name = try self.expect(TokenKind.Ident, "expected enum name")
        let ei = self.enum_index(name.value)
        if ei < 0 { return problem("unknown enum declaration `{name.value}`", name.line, name.col) }
        let _ = try self.expect(TokenKind.LBrace, "expected enum body")
        self.skip_newlines()
        var cases = Vector<String>()
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            let _ = try self.expect(TokenKind.Case, "expected `case` in enum declaration")
            let item = try self.expect(TokenKind.Ident, "expected enum case name")
            if self.at(TokenKind.LParen) { return problem("payload enum cases are not supported", item.line, item.col) }
            var i = 0
            while i < cases.len() {
                if cases[i] == item.value { return problem("duplicate enum case `{item.value}`", item.line, item.col) }
                i += 1
            }
            try! cases.push(item.value)
            if self.at(TokenKind.Comma) {
                let _ = self.take()
                self.skip_newlines()
            } else if self.at(TokenKind.Newline) { self.skip_newlines() }
            else if not self.at(TokenKind.RBrace) { return self.fail("expected comma or newline after enum case") }
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace for enum")
        if cases.len() == 0 { return problem("enum must have at least one case", name.line, name.col) }
        self.enums[ei].cases = move cases
        return
    }

    func new_slot(&var self, ty: ValueType) -> Int {
        let n = self.slots.len()
        try! self.slots.push(ty)
        n
    }

    func new_value(&var self, ty: ValueType) -> Result<Int, ProtoError> {
        let layout = try value_layout(&self.records, ty)
        let start = self.slots.len()
        var i = 0
        while i < layout.len() {
            try! self.slots.push(layout[i])
            i += 1
        }
        start
    }

    func emit_copy_value(&var self, dst: Int, src: Int, ty: ValueType,
                         t: &Token) -> Result<Void, ProtoError> {
        if dst == src { return }
        let layout = try value_layout(&self.records, ty)
        var i = 0
        while i < layout.len() {
            let at = self.emit_at(Op.Copy, t.line, t.col)
            self.code[at].dst = dst + i
            self.code[at].a = src + i
            i += 1
        }
        return
    }

    func snapshot(&var self, value: ExprValue, t: &Token) -> Result<ExprValue, ProtoError> {
        if value.ty == ValueType.Void { return value }
        let dst = try self.new_value(value.ty)
        try self.emit_copy_value(dst, value.slot, value.ty, &t)
        expr_value(value.ty, dst, value.call)
    }

    func emit(&var self, ins: Instruction) -> Int {
        let n = self.code.len()
        try! self.code.push(move ins)
        n
    }

    func emit_at(&var self, op: Op, line: Int, col: Int) -> Int {
        var ins = instruction(op: op)
        ins.line = line
        ins.col = col
        self.emit(move ins)
    }

    func binding_index(&self, name: String) -> Int {
        var i = self.bindings.len()
        while i > 0 {
            i -= 1
            if self.bindings[i].name == name { return i }
        }
        -1
    }

    func check_read(&self, root: Int, t: &Token) -> Result<Void, ProtoError> {
        var i = 0
        while i < self.active_borrows.len() {
            if self.active_borrows[i].root == root && self.active_borrows[i].mutable {
                return problem("cannot read a place while it is mutably borrowed", t.line, t.col)
            }
            i += 1
        }
        return
    }

    func check_write(&self, root: Int, t: &Token) -> Result<Void, ProtoError> {
        var i = 0
        while i < self.active_borrows.len() {
            if self.active_borrows[i].root == root {
                return problem("cannot write a place while it is borrowed", t.line, t.col)
            }
            i += 1
        }
        return
    }

    func register_borrow(&var self, place: &Place, mutable: Bool,
                         t: &Token) -> Result<Void, ProtoError> {
        var pending = 0
        while pending < self.pending_writes.len() {
            if self.pending_writes[pending] == place.root {
                return problem("cannot borrow an assignment destination while evaluating its right-hand side", t.line, t.col)
            }
            pending += 1
        }
        var i = 0
        while i < self.active_borrows.len() {
            if self.active_borrows[i].root == place.root && (mutable || self.active_borrows[i].mutable) {
                return problem("overlapping arguments cannot include a mutable borrow", t.line, t.col)
            }
            i += 1
        }
        try! self.active_borrows.push(Borrow(root: place.root, mutable: mutable))
        return
    }

    func restore_borrows(&var self, count: Int) {
        while self.active_borrows.len() > count { let _ = self.active_borrows.pop() }
    }

    func restore_pending_writes(&var self, count: Int) {
        while self.pending_writes.len() > count { let _ = self.pending_writes.pop() }
    }

    func read_place(&var self, place: Place, t: &Token) -> Result<ExprValue, ProtoError> {
        try self.check_read(place.root, &t)
        if place.indirect {
            let dst = self.new_slot(place.ty)
            let at = self.emit_at(Op.LoadRef, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = place.slot
            return expr_value(place.ty, dst, false)
        }
        self.snapshot(expr_value(place.ty, place.slot, false), &t)
    }

    func store_place(&var self, place: Place, value: ExprValue,
                     t: &Token) -> Result<Void, ProtoError> {
        if place.indirect {
            let at = self.emit_at(Op.StoreRef, t.line, t.col)
            self.code[at].a = place.slot
            self.code[at].b = value.slot
            return
        }
        self.emit_copy_value(place.slot, value.slot, place.ty, &t)
    }

    func declare(&var self, name: Token, ty: ValueType, slot: Int, mutable: Bool) -> Result<Void, ProtoError> {
        var i = self.bindings.len()
        while i > 0 {
            i -= 1
            if self.bindings[i].depth != self.depth { break }
            if self.bindings[i].name == name.value {
                return problem("duplicate declaration `{name.value}` in this scope", name.line, name.col)
            }
        }
        try! self.bindings.push(Binding(name: name.value, ty: ty, slot: slot,
                                        mutable: mutable, depth: self.depth))
        return
    }

    func leave_scope(&var self) {
        while self.bindings.len() > 0 && self.bindings[self.bindings.len() - 1].depth == self.depth {
            let _ = self.bindings.pop()
        }
    }

    func terminator(&var self) -> Result<Void, ProtoError> {
        if self.at(TokenKind.Semicolon) { return self.fail("semicolons are not supported") }
        if self.at(TokenKind.Newline) {
            self.skip_newlines()
            return
        }
        if self.at(TokenKind.RBrace) { return }
        self.fail("expected newline after statement")
    }

    func require_type(&self, got: ValueType, wanted: ValueType, t: &Token) -> Result<Void, ProtoError> {
        if got != wanted { return problem("type mismatch", t.line, t.col) }
        return
    }

    func literal_fits_target(&self, v: &ExprValue, target: ValueType) -> Bool {
        if not v.literal || not integer_type(target) || target == ValueType.Byte { return false }
        if v.literal_negative {
            if not integer_signed(target) { return false }
            return v.literal_value <= UInt.from(truncating: integer_max(target)) + 1
        }
        v.literal_value <= UInt.from(truncating: integer_max(target))
    }

    func adopt_literal(&var self, v: ExprValue, target: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        if not self.literal_fits_target(&v, target) {
            return problem("integer literal does not fit {type_name(target)}", t.line, t.col)
        }
        var bits = Int.from(truncating: v.literal_value)
        if v.literal_negative {
            if v.literal_value == UInt.from(truncating: Int.max) + 1 { bits = Int.min }
            else { bits = 0 - bits }
        }
        bits = integer_normalize(bits, target)
        self.slots[v.slot] = target
        var i = self.code.len()
        while i > 0 {
            i -= 1
            if self.code[i].op == Op.Const && self.code[i].dst == v.slot {
                self.code[i].immediate = bits
                break
            }
        }
        ExprValue(ty: target, slot: v.slot, call: false, literal: true,
                  literal_value: v.literal_value, literal_negative: v.literal_negative, always_returns: false)
    }

    func transfer(&var self, v: ExprValue, target: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        if v.ty == target {
            if v.literal && not self.literal_fits_target(&v, target) {
                return problem("integer literal does not fit {type_name(target)}", t.line, t.col)
            }
            return v
        }
        if v.literal && integer_type(target) { return self.adopt_literal(v, target, &t) }
        if integer_widens(v.ty, target) {
            let dst = self.new_slot(target)
            let at = self.emit_at(Op.Cast, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(target, dst, false)
        }
        problem("cannot implicitly convert {self.display_type(v.ty)} to {self.display_type(target)}", t.line, t.col)
    }

    func parse_atom(&var self) -> Result<ExprValue, ProtoError> {
        if self.depth > 128 { return self.fail("expression nesting limit exceeded") }
        if self.at(TokenKind.If) { return self.parse_if_value(ValueType.Void, false) }
        if self.at(TokenKind.Match) { return self.parse_match_value(ValueType.Void, false) }
        if self.at(TokenKind.IntLit) {
            let t = self.take()
            guard let magnitude = literal_magnitude(t.value) else { return problem("invalid integer literal", t.line, t.col) }
            var ty = ValueType.I64
            var bare = true
            if let suffix = t.suffix {
                bare = false
                guard let st = suffix_type(suffix) else { return problem("unsupported integer suffix `{suffix}`", t.line, t.col) }
                ty = st
            }
            let maximum = UInt.from(truncating: integer_max(ty))
            if not bare && integer_signed(ty) && magnitude > maximum { return problem("integer literal does not fit {type_name(ty)}", t.line, t.col) }
            let dst = self.new_slot(ty)
            let at = self.emit_at(Op.Const, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].immediate = integer_normalize(Int.from(truncating: magnitude), ty)
            return ExprValue(ty: ty, slot: dst, call: false, literal: bare,
                             literal_value: magnitude, literal_negative: false, always_returns: false)
        }
        if self.at(TokenKind.True_) || self.at(TokenKind.False_) {
            let t = self.take()
            let dst = self.new_slot(ValueType.Bool)
            let at = self.emit_at(Op.Const, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].immediate = if t.kind == TokenKind.True_ { 1 } else { 0 }
            return expr_value(ValueType.Bool, dst, false)
        }
        if self.at(TokenKind.LParen) {
            let _ = self.take()
            self.depth += 1
            self.paren_depth += 1
            self.skip_newlines()
            let value = try self.parse_expr()
            self.skip_newlines()
            let _ = try self.expect(TokenKind.RParen, "expected `)`")
            self.paren_depth -= 1
            self.depth -= 1
            return value
        }
        if self.at(TokenKind.Ident) {
            let name = self.take()
            let ei = self.enum_index(name.value)
            if ei >= 0 && self.at(TokenKind.Dot) {
                let _ = self.take()
                let item = try self.expect(TokenKind.Ident, "expected enum case after `.`")
                let ci = self.enum_case_index(ei, item.value)
                if ci < 0 { return problem("enum `{name.value}` has no case `{item.value}`", item.line, item.col) }
                let ty = ValueType.Enum(ei)
                let dst = self.new_slot(ty)
                let at = self.emit_at(Op.Const, name.line, name.col)
                self.code[at].dst = dst
                self.code[at].immediate = ci
                return expr_value(ty, dst, false)
            }
            let ri = self.record_index(name.value)
            if ri >= 0 && self.at(TokenKind.LParen) { return self.parse_record_constructor(name, ri) }
            if let ty = named_integer_type(name.value) {
                if self.at(TokenKind.Dot) { return self.parse_integer_member(name, ty) }
                if self.at(TokenKind.LParen) && ty == ValueType.Byte { return self.parse_byte(name) }
            }
            if self.at(TokenKind.LParen) { return self.parse_call(name) }
            let bi = self.binding_index(name.value)
            if bi >= 0 {
                var place = Place(ty: self.bindings[bi].ty, slot: self.bindings[bi].slot,
                                  mutable: self.bindings[bi].mutable, indirect: false, root: bi)
                if reference_type(place.ty) {
                    place.mutable = reference_mutable(&self.references, place.ty)
                    place.ty = try reference_target(&self.references, place.ty)
                    place.indirect = true
                }
                return self.read_place(place, &name)
            }
            let si = self.static_index(name.value)
            if si >= 0 {
                let dst = self.new_slot(self.statics[si].ty)
                let at = self.emit_at(Op.Const, name.line, name.col)
                self.code[at].dst = dst
                self.code[at].immediate = self.statics[si].value
                return expr_value(self.statics[si].ty, dst, false)
            }
            return problem("unknown name `{name.value}`", name.line, name.col)
        }
        self.fail("expected expression; this syntax is unsupported")
    }

    func field_index(&self, record: Int, name: String) -> Int {
        var i = 0
        while i < self.records[record].field_names.len() {
            if self.records[record].field_names[i] == name { return i }
            i += 1
        }
        -1
    }

    func enum_case_index(&self, enum_index: Int, name: String) -> Int {
        var i = 0
        while i < self.enums[enum_index].cases.len() {
            if self.enums[enum_index].cases[i] == name { return i }
            i += 1
        }
        -1
    }

    func assignment_ahead(&self) -> Bool {
        if not self.at(TokenKind.Ident) { return false }
        var i = self.pos + 1
        while i + 1 < self.tokens.len() && self.tokens[i].kind == TokenKind.Dot && self.tokens[i + 1].kind == TokenKind.Ident { i += 2 }
        if i >= self.tokens.len() { return false }
        let kind = self.tokens[i].kind
        kind == TokenKind.Assign || kind == TokenKind.PlusAssign || kind == TokenKind.MinusAssign || kind == TokenKind.StarAssign || kind == TokenKind.SlashAssign || kind == TokenKind.PercentAssign
    }

    func parse_place(&var self) -> Result<(Token, Place), ProtoError> {
        let name = try self.expect(TokenKind.Ident, "expected assignment target")
        let bi = self.binding_index(name.value)
        if bi < 0 {
            if self.static_index(name.value) >= 0 { return problem("cannot assign to immutable static `{name.value}`", name.line, name.col) }
            return problem("unknown local `{name.value}`", name.line, name.col)
        }
        var place = Place(ty: self.bindings[bi].ty, slot: self.bindings[bi].slot,
                          mutable: self.bindings[bi].mutable, indirect: false, root: bi)
        if reference_type(place.ty) {
            place.mutable = reference_mutable(&self.references, place.ty)
            place.ty = try reference_target(&self.references, place.ty)
            place.indirect = true
        }
        while self.at(TokenKind.Dot) {
            let _ = self.take()
            let field = try self.expect(TokenKind.Ident, "expected record field after `.`")
            if place.indirect { return problem("reference parameters cannot be used as records", field.line, field.col) }
            match place.ty {
                case Record(ri) -> {
                    let fi = self.field_index(ri, field.value)
                    if fi < 0 { return problem("record `{self.records[ri].name}` has no field `{field.value}`", field.line, field.col) }
                    place.slot += try record_field_offset(&self.records, ri, fi)
                    place.ty = self.records[ri].field_types[fi]
                },
                case _ -> { return problem("field assignment requires a record", field.line, field.col) }
            }
        }
        (name, place)
    }

    func parse_primary(&var self) -> Result<ExprValue, ProtoError> {
        var value = try self.parse_atom()
        self.expr_space()
        while self.at(TokenKind.Dot) {
            let dot = self.take()
            self.expr_space()
            let field = try self.expect(TokenKind.Ident, "expected record field after `.`")
            match value.ty {
                case Record(ri) -> {
                    let fi = self.field_index(ri, field.value)
                    if fi < 0 { return problem("record `{self.records[ri].name}` has no field `{field.value}`", field.line, field.col) }
                    let offset = try record_field_offset(&self.records, ri, fi)
                    value = expr_value(self.records[ri].field_types[fi], value.slot + offset, false)
                },
                case _ -> { return problem("field access requires a record value", dot.line, dot.col) }
            }
            self.expr_space()
        }
        value
    }

    func parse_record_constructor(&var self, name: Token, ri: Int) -> Result<ExprValue, ProtoError> {
        let _ = self.take()
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        var fields = Vector<Int>()
        var values = Vector<ExprValue>()
        if not self.at(TokenKind.RParen) {
            var more = true
            while more {
                let label = try self.expect(TokenKind.Ident, "expected record field label")
                let fi = self.field_index(ri, label.value)
                if fi < 0 { return problem("unknown field `{label.value}` for record `{name.value}`", label.line, label.col) }
                var j = 0
                while j < fields.len() {
                    if fields[j] == fi { return problem("duplicate constructor field `{label.value}`", label.line, label.col) }
                    j += 1
                }
                let _ = try self.expect(TokenKind.Colon, "expected `:` after record field label")
                self.expr_space()
                var value = try self.parse_expected_expr(self.records[ri].field_types[fi])
                if value.always_returns { return problem("all-returning control flow cannot be used as an operand", label.line, label.col) }
                value = try self.snapshot(value, &label)
                try! fields.push(fi)
                try! values.push(move value)
                self.skip_newlines()
                if self.at(TokenKind.Comma) {
                    let _ = self.take()
                    self.skip_newlines()
                    if self.at(TokenKind.RParen) { more = false }
                } else { more = false }
            }
        }
        let _ = try self.expect(TokenKind.RParen, "expected `)` after record constructor")
        self.paren_depth -= 1
        self.depth -= 1
        if fields.len() != self.records[ri].field_names.len() {
            return problem("missing field in constructor for record `{name.value}`", name.line, name.col)
        }
        let ty = ValueType.Record(ri)
        let dst = try self.new_value(ty)
        var fi = 0
        while fi < self.records[ri].field_names.len() {
            var found = -1
            var j = 0
            while j < fields.len() {
                if fields[j] == fi { found = j }
                j += 1
            }
            if found < 0 { return problem("missing field `{self.records[ri].field_names[fi]}` in constructor", name.line, name.col) }
            let offset = try record_field_offset(&self.records, ri, fi)
            try self.emit_copy_value(dst + offset, values[found].slot,
                                     self.records[ri].field_types[fi], &name)
            fi += 1
        }
        expr_value(ty, dst, false)
    }

    func parse_byte(&var self, name: Token) -> Result<ExprValue, ProtoError> {
        let _ = self.take()
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        var value = try self.parse_expr()
        value = try self.transfer(value, ValueType.U8, &name)
        self.skip_newlines()
        let _ = try self.expect(TokenKind.RParen, "expected `)` after Byte value")
        self.paren_depth -= 1
        self.depth -= 1
        let dst = self.new_slot(ValueType.Byte)
        let at = self.emit_at(Op.Cast, name.line, name.col)
        self.code[at].dst = dst
        self.code[at].a = value.slot
        expr_value(ValueType.Byte, dst, false)
    }

    func parse_integer_member(&var self, name: Token, ty: ValueType) -> Result<ExprValue, ProtoError> {
        let _ = self.take()
        let member = try self.expect(TokenKind.Ident, "expected numeric member")
        if member.value == "min" || member.value == "max" {
            if ty == ValueType.Byte { return problem("Byte has no numeric limit members", member.line, member.col) }
            if self.at(TokenKind.LParen) { return problem("integer limits are constants", member.line, member.col) }
            let dst = self.new_slot(ty)
            let at = self.emit_at(Op.Const, member.line, member.col)
            self.code[at].dst = dst
            self.code[at].immediate = if member.value == "min" { integer_min(ty) } else { integer_max(ty) }
            return expr_value(ty, dst, false)
        }
        if member.value != "from" { return problem("unsupported numeric member `{member.value}`", member.line, member.col) }
        let _ = try self.expect(TokenKind.LParen, "expected `(` after from")
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        let label = try self.expect(TokenKind.Ident, "only `from(truncating:)` is supported")
        if label.value != "truncating" { return problem("only `from(truncating:)` is supported", label.line, label.col) }
        let _ = try self.expect(TokenKind.Colon, "expected `:` after truncating")
        self.skip_newlines()
        var value = try self.parse_expr()
        value = try self.transfer(value, value.ty, &name)
        if not integer_type(value.ty) || ty == ValueType.Byte { return problem("truncating conversion requires integer types", name.line, name.col) }
        self.skip_newlines()
        let _ = try self.expect(TokenKind.RParen, "expected `)` after conversion")
        self.paren_depth -= 1
        self.depth -= 1
        let dst = self.new_slot(ty)
        let at = self.emit_at(Op.Truncate, name.line, name.col)
        self.code[at].dst = dst
        self.code[at].a = value.slot
        expr_value(ty, dst, false)
    }

    func parse_call(&var self, name: Token) -> Result<ExprValue, ProtoError> {
        let fi = self.signature_index(name.value)
        if fi < 0 { return problem("unknown function `{name.value}`", name.line, name.col) }
        let _ = self.take()
        var args = Vector<Int>()
        var ai = 0
        let saved_borrows = self.active_borrows.len()
        self.depth += 1
        self.paren_depth += 1
        self.skip_newlines()
        if not self.at(TokenKind.RParen) {
            var more = true
            while more {
                if ai >= self.signatures[fi].params.len() {
                    return problem("too many arguments to `{name.value}`", name.line, name.col)
                }
                let formal = self.signatures[fi].params[ai]
                if reference_type(formal) {
                    let amp = try self.expect(TokenKind.Ampersand, "reference argument requires explicit `&`")
                    var explicit_mutable = false
                    if self.at(TokenKind.Var) {
                        let _ = self.take()
                        explicit_mutable = true
                    }
                    let parsed = try self.parse_place()
                    let place = parsed.1
                    let formal_mutable = reference_mutable(&self.references, formal)
                    let target = try reference_target(&self.references, formal)
                    if formal_mutable && not explicit_mutable {
                        return problem("mutable reference argument requires `&var`", amp.line, amp.col)
                    }
                    if place.ty != target {
                        return problem("reference argument type does not match parameter", amp.line, amp.col)
                    }
                    if explicit_mutable && not place.mutable {
                        return problem("cannot mutably borrow an immutable place", amp.line, amp.col)
                    }
                    try self.register_borrow(&place, explicit_mutable, &amp)
                    let dst = self.new_slot(formal)
                    if place.indirect {
                        let source = self.bindings[place.root].ty
                        if not reference_transfer(&self.references, source, formal) {
                            return problem("reference argument mutability does not match parameter", amp.line, amp.col)
                        }
                        let copy = self.emit_at(Op.Copy, amp.line, amp.col)
                        self.code[copy].dst = dst
                        self.code[copy].a = place.slot
                    } else {
                        let addr = self.emit_at(Op.Addr, amp.line, amp.col)
                        self.code[addr].dst = dst
                        self.code[addr].a = place.slot
                    }
                    try! args.push(dst)
                } else {
                    if self.at(TokenKind.Ampersand) {
                        let address = self.token()
                        return problem("value parameter does not accept an address argument", address.line, address.col)
                    }
                    var value = try self.parse_expected_expr(formal)
                    if value.always_returns { return problem("all-returning control flow cannot be used as an operand", name.line, name.col) }
                    value = try self.snapshot(value, &name)
                    let layout = try value_layout(&self.records, value.ty)
                    var word = 0
                    while word < layout.len() {
                        try! args.push(value.slot + word)
                        word += 1
                    }
                }
                ai += 1
                self.skip_newlines()
                if self.at(TokenKind.Comma) {
                    let _ = self.take()
                    self.skip_newlines()
                } else { more = false }
            }
        }
        let _ = try self.expect(TokenKind.RParen, "expected `)` after arguments")
        self.paren_depth -= 1
        self.depth -= 1
        if ai != self.signatures[fi].params.len() {
            return problem("wrong number of arguments to `{name.value}`", name.line, name.col)
        }
        let rt = self.signatures[fi].result
        let dst = if rt == ValueType.Void { -1 } else { try self.new_value(rt) }
        let at = self.emit_at(Op.Call, name.line, name.col)
        self.code[at].target = fi
        self.code[at].dst = dst
        self.code[at].args = move args
        self.restore_borrows(saved_borrows)
        expr_value(rt, dst, true)
    }

    func parse_unary_inner(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        if self.at(TokenKind.Exclaim) || self.at(TokenKind.Not_) {
            let t = self.take()
            self.expr_space()
            var v = try self.parse_unary()
            v = try self.transfer(v, v.ty, &t)
            try self.require_type(v.ty, ValueType.Bool, &t)
            let dst = self.new_slot(ValueType.Bool)
            let at = self.emit_at(Op.Not, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(ValueType.Bool, dst, false)
        }
        if self.at(TokenKind.Minus) {
            let t = self.take()
            self.expr_space()
            if self.at(TokenKind.IntLit) && not self.literal_followed_by_cast() {
                let lit = self.take()
                guard let magnitude = literal_magnitude(lit.value) else { return problem("invalid integer literal", lit.line, lit.col) }
                var ty = ValueType.I64
                var bare = true
                if let suffix = lit.suffix {
                    bare = false
                    guard let st = suffix_type(suffix) else { return problem("unsupported integer suffix `{suffix}`", lit.line, lit.col) }
                    ty = st
                }
                if not integer_signed(ty) { return problem("cannot negate an unsigned integer", t.line, t.col) }
                let limit = UInt.from(truncating: integer_max(ty)) + 1
                if magnitude > limit { return problem("integer literal does not fit {type_name(ty)}", lit.line, lit.col) }
                var bits = Int.from(truncating: magnitude)
                if magnitude == UInt.from(truncating: Int.max) + 1 { bits = Int.min }
                else { bits = 0 - bits }
                bits = integer_normalize(bits, ty)
                let dst = self.new_slot(ty)
                let at = self.emit_at(Op.Const, t.line, t.col)
                self.code[at].dst = dst
                self.code[at].immediate = bits
                let value = ExprValue(ty: ty, slot: dst, call: false, literal: bare,
                                      literal_value: magnitude, literal_negative: true, always_returns: false)
                return value
            }
            let v = try self.parse_unary()
            if not arithmetic_type(v.ty) || not integer_signed(v.ty) { return problem("unary `-` requires a signed integer", t.line, t.col) }
            let dst = self.new_slot(v.ty)
            let at = self.emit_at(Op.Neg, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(v.ty, dst, false)
        }
        if self.at(TokenKind.Tilde) {
            let t = self.take()
            self.expr_space()
            var v = try self.parse_unary()
            v = try self.transfer(v, v.ty, &t)
            if not arithmetic_type(v.ty) { return problem("operator `~` requires an integer", t.line, t.col) }
            let dst = self.new_slot(v.ty)
            let at = self.emit_at(Op.BitNot, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = v.slot
            return expr_value(v.ty, dst, false)
        }
        self.parse_cast()
    }

    func parse_cast(&var self) -> Result<ExprValue, ProtoError> {
        let value = try self.parse_primary()
        self.parse_casts(value)
    }

    func parse_casts(&var self, initial: ExprValue) -> Result<ExprValue, ProtoError> {
        var value = initial
        self.expr_space()
        while self.at(TokenKind.As) {
            let t = self.take()
            self.expr_space()
            let target = try self.parse_type()
            value = try self.transfer(value, value.ty, &t)
            if not integer_type(value.ty) || not integer_type(target) || target == ValueType.Byte {
                return problem("`as` requires integer source and target types", t.line, t.col)
            }
            let dst = self.new_slot(target)
            let at = self.emit_at(Op.Cast, t.line, t.col)
            self.code[at].dst = dst
            self.code[at].a = value.slot
            value = expr_value(target, dst, false)
            self.expr_space()
        }
        value
    }

    func parse_unary(&var self) -> Result<ExprValue, ProtoError> {
        if self.expr_depth >= 128 { return self.fail("expression nesting limit exceeded") }
        self.expr_depth += 1
        let value = try self.parse_unary_inner()
        self.expr_depth -= 1
        value
    }

    func binary(&var self, left: ExprValue, right: ExprValue, op: Op,
                result: ValueType, t: &Token) -> Result<ExprValue, ProtoError> {
        let dst = self.new_slot(result)
        let at = self.emit_at(op, t.line, t.col)
        self.code[at].dst = dst
        self.code[at].a = left.slot
        self.code[at].b = right.slot
        expr_value(result, dst, false)
    }

    func common_type(&self, left: &ExprValue, right: &ExprValue,
                     t: &Token) -> Result<ValueType, ProtoError> {
        if left.always_returns || right.always_returns {
            return problem("all-returning control flow cannot be used as an operand", t.line, t.col)
        }
        if left.ty == right.ty {
            if left.literal && not self.literal_fits_target(&left, left.ty) { return problem("integer literal does not fit {type_name(left.ty)}", t.line, t.col) }
            if right.literal && not self.literal_fits_target(&right, right.ty) { return problem("integer literal does not fit {type_name(right.ty)}", t.line, t.col) }
            return left.ty
        }
        if left.literal && not right.literal { return right.ty }
        if right.literal && not left.literal { return left.ty }
        problem("operands must have the same type", t.line, t.col)
    }

    func parse_mul(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        var left = try self.parse_unary()
        self.expr_space()
        while self.at(TokenKind.Star) || self.at(TokenKind.Slash) || self.at(TokenKind.Percent) || self.at(TokenKind.WrapMul) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_unary()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("arithmetic requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Star { Op.Mul } else if t.kind == TokenKind.Slash { Op.Div } else if t.kind == TokenKind.Percent { Op.Rem } else { Op.WrapMul }
            let result = left.ty
            left = try self.binary(left, right, op, result, &t)
        }
        left
    }

    func parse_add(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_mul()
        self.expr_space()
        while self.at(TokenKind.Plus) || self.at(TokenKind.Minus) || self.at(TokenKind.WrapAdd) || self.at(TokenKind.WrapSub) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_mul()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("arithmetic requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Plus { Op.Add } else if t.kind == TokenKind.Minus { Op.Sub } else if t.kind == TokenKind.WrapAdd { Op.WrapAdd } else { Op.WrapSub }
            let result = left.ty
            left = try self.binary(left, right, op, result, &t)
        }
        left
    }

    func adjacent(&self, a: &Token, b: &Token) -> Bool {
        a.line == b.line && b.col == a.col + 1
    }

    func shift_ahead(&self, kind: TokenKind) -> Bool {
        if self.pos + 1 >= self.tokens.len() || not self.at(kind) || self.tokens[self.pos + 1].kind != kind { return false }
        let a = self.token()
        self.adjacent(&a, &self.tokens[self.pos + 1])
    }

    func parse_shift(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_add()
        self.expr_space()
        while self.shift_ahead(TokenKind.Lt) || self.shift_ahead(TokenKind.Gt) {
            let t = self.take()
            let _ = self.take()
            self.expr_space()
            var right = try self.parse_add()
            self.expr_space()
            left = try self.transfer(left, left.ty, &t)
            right = try self.transfer(right, right.ty, &t)
            if not arithmetic_type(left.ty) || not arithmetic_type(right.ty) { return problem("shift requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, if t.kind == TokenKind.Lt { Op.Shl } else { Op.Shr }, result, &t)
        }
        left
    }

    func parse_compare(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_shift()
        self.expr_space()
        if self.at(TokenKind.Lt) || self.at(TokenKind.Lte) || self.at(TokenKind.Gt) || self.at(TokenKind.Gte) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_shift()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("comparison requires integer operands", t.line, t.col) }
            let op = if t.kind == TokenKind.Lt { Op.Lt } else if t.kind == TokenKind.Lte { Op.Le } else if t.kind == TokenKind.Gt { Op.Gt } else { Op.Ge }
            left = try self.binary(left, right, op, ValueType.Bool, &t)
        }
        left
    }

    func parse_equality(&var self) -> Result<ExprValue, ProtoError> {
        self.expr_space()
        var left = try self.parse_compare()
        self.expr_space()
        if self.at(TokenKind.Eq) || self.at(TokenKind.Neq) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_compare()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not scalar_type(left.ty) || left.ty != right.ty { return problem("equality operands must have the same scalar type", t.line, t.col) }
            left = try self.binary(left, right, if t.kind == TokenKind.Eq { Op.Eq } else { Op.Ne }, ValueType.Bool, &t)
        }
        left
    }

    func parse_bit_and(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_equality()
        self.expr_space()
        while self.at(TokenKind.Ampersand) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_equality()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitAnd, result, &t)
        }
        left
    }

    func parse_bit_xor(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_bit_and()
        self.expr_space()
        while self.at(TokenKind.Caret) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_bit_and()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitXor, result, &t)
        }
        left
    }

    func parse_bit_or(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_bit_xor()
        self.expr_space()
        while self.at(TokenKind.Pipe) {
            let t = self.take()
            self.expr_space()
            var right = try self.parse_bit_xor()
            self.expr_space()
            let common = try self.common_type(&left, &right, &t)
            if left.ty != common { left = try self.adopt_literal(left, common, &t) }
            if right.ty != common { right = try self.adopt_literal(right, common, &t) }
            if not arithmetic_type(left.ty) { return problem("bitwise operator requires integer operands", t.line, t.col) }
            let result = left.ty
            left = try self.binary(left, right, Op.BitOr, result, &t)
        }
        left
    }

    func parse_logical_and(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_bit_or()
        self.expr_space()
        while self.at(TokenKind.And) {
            let t = self.take()
            if left.ty != ValueType.Bool { return problem("logical operator requires Bool operands", t.line, t.col) }
            let dst = self.new_slot(ValueType.Bool)
            let initial = self.emit_at(Op.Const, t.line, t.col)
            self.code[initial].dst = dst
            self.code[initial].immediate = 0
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = left.slot
            let skip = self.emit_at(Op.Jump, t.line, t.col)
            self.code[branch].target = self.code.len()
            self.expr_space()
            let right = try self.parse_bit_or()
            self.expr_space()
            if right.ty != ValueType.Bool { return problem("logical operator requires Bool operands", t.line, t.col) }
            let copy = self.emit_at(Op.Copy, t.line, t.col)
            self.code[copy].dst = dst
            self.code[copy].a = right.slot
            self.code[skip].target = self.code.len()
            left = expr_value(ValueType.Bool, dst, false)
        }
        left
    }

    func parse_expr(&var self) -> Result<ExprValue, ProtoError> {
        var left = try self.parse_logical_and()
        self.expr_space()
        while self.at(TokenKind.Or) {
            let t = self.take()
            if left.ty != ValueType.Bool { return problem("logical operator requires Bool operands", t.line, t.col) }
            let dst = self.new_slot(ValueType.Bool)
            let initial = self.emit_at(Op.Const, t.line, t.col)
            self.code[initial].dst = dst
            self.code[initial].immediate = 1
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = left.slot
            self.expr_space()
            let right = try self.parse_logical_and()
            self.expr_space()
            if right.ty != ValueType.Bool { return problem("logical operator requires Bool operands", t.line, t.col) }
            let copy = self.emit_at(Op.Copy, t.line, t.col)
            self.code[copy].dst = dst
            self.code[copy].a = right.slot
            self.code[branch].target = self.code.len()
            left = expr_value(ValueType.Bool, dst, false)
        }
        left
    }

    func parse_expected_expr(&var self, expected: ValueType) -> Result<ExprValue, ProtoError> {
        if self.depth >= 128 { return self.fail("expression nesting limit exceeded") }
        self.expr_space()
        if self.wrapped_control_is_isolated() {
            let _ = self.take()
            self.depth += 1
            self.paren_depth += 1
            self.skip_newlines()
            let value = try self.parse_expected_expr(expected)
            self.skip_newlines()
            let _ = try self.expect(TokenKind.RParen, "expected `)`")
            self.paren_depth -= 1
            self.depth -= 1
            return value
        }
        if self.control_is_isolated() {
            if self.at(TokenKind.If) { return self.parse_if_value(expected, true) }
            if self.at(TokenKind.Match) { return self.parse_match_value(expected, true) }
        }
        let anchor = self.token()
        let value = try self.parse_expr()
        if value.always_returns { return value }
        self.transfer(value, expected, &anchor)
    }

    func value_statement_start(&self) -> Bool {
        let t = self.token()
        if t.kind == TokenKind.Let || t.kind == TokenKind.Var || t.kind == TokenKind.Return || t.kind == TokenKind.While || t.kind == TokenKind.LBrace { return true }
        if t.kind == TokenKind.Ident && t.value == "print" { return true }
        self.assignment_ahead()
    }

    func expression_is_block_tail(&self) -> Bool {
        var i = self.pos
        var parens = 0
        var braces = 0
        while i < self.tokens.len() {
            let kind = self.tokens[i].kind
            if kind == TokenKind.LParen { parens += 1 }
            else if kind == TokenKind.RParen { if parens > 0 { parens -= 1 } }
            else if kind == TokenKind.LBrace { braces += 1 }
            else if kind == TokenKind.RBrace {
                if braces > 0 { braces -= 1 }
                else { return true }
            }
            if kind == TokenKind.Newline && parens == 0 && braces == 0 {
                var j = i + 1
                while j < self.tokens.len() && self.tokens[j].kind == TokenKind.Newline { j += 1 }
                if j < self.tokens.len() && self.tokens[j].kind == TokenKind.Else { i = j }
                else { return j < self.tokens.len() && self.tokens[j].kind == TokenKind.RBrace }
            }
            i += 1
        }
        false
    }

    func control_end_from(&self, start: Int) -> Int {
        if start < 0 || start >= self.tokens.len() { return -1 }
        if self.tokens[start].kind != TokenKind.If && self.tokens[start].kind != TokenKind.Match { return -1 }
        let starts_if = self.tokens[start].kind == TokenKind.If
        var i = start
        var braces = 0
        var parens = 0
        var saw_brace = false
        while i < self.tokens.len() {
            let kind = self.tokens[i].kind
            if kind == TokenKind.LParen { parens += 1 }
            else if kind == TokenKind.RParen { if parens > 0 { parens -= 1 } }
            else if kind == TokenKind.LBrace && (saw_brace || parens == 0) {
                braces += 1
                saw_brace = true
            }
            else if kind == TokenKind.RBrace && saw_brace {
                braces -= 1
                if saw_brace && braces == 0 {
                    var j = i + 1
                    while j < self.tokens.len() && self.tokens[j].kind == TokenKind.Newline { j += 1 }
                    if starts_if && j < self.tokens.len() && self.tokens[j].kind == TokenKind.Else {
                        j += 1
                        while j < self.tokens.len() && self.tokens[j].kind == TokenKind.Newline { j += 1 }
                        i = j - 1
                        saw_brace = false
                    } else { return i + 1 }
                }
            }
            i += 1
        }
        -1
    }

    func control_is_isolated(&self) -> Bool {
        let i = self.control_end_from(self.pos)
        if i < 0 { return false }
        if i >= self.tokens.len() { return true }
        let kind = self.tokens[i].kind
        kind == TokenKind.RBrace || kind == TokenKind.RParen || kind == TokenKind.Comma || kind == TokenKind.Newline || kind == TokenKind.Eof
    }

    func if_has_else(&self) -> Bool {
        let end = self.control_end_from(self.pos)
        var i = self.pos
        var braces = 0
        var parens = 0
        while i < end {
            let kind = self.tokens[i].kind
            if kind == TokenKind.LParen { parens += 1 }
            else if kind == TokenKind.RParen { parens -= 1 }
            else if kind == TokenKind.LBrace { braces += 1 }
            else if kind == TokenKind.RBrace { braces -= 1 }
            else if kind == TokenKind.Else && braces == 0 && parens == 0 { return true }
            i += 1
        }
        false
    }

    func wrapped_control_is_isolated(&self) -> Bool {
        var start = self.pos
        var wrappers = 0
        while start < self.tokens.len() && self.tokens[start].kind == TokenKind.LParen {
            wrappers += 1
            start += 1
            while start < self.tokens.len() && self.tokens[start].kind == TokenKind.Newline { start += 1 }
        }
        if wrappers == 0 { return false }
        var finish = self.control_end_from(start)
        if finish < 0 { return false }
        var n = 0
        while n < wrappers {
            while finish < self.tokens.len() && self.tokens[finish].kind == TokenKind.Newline { finish += 1 }
            if finish >= self.tokens.len() || self.tokens[finish].kind != TokenKind.RParen { return false }
            finish += 1
            n += 1
        }
        if finish >= self.tokens.len() { return true }
        let kind = self.tokens[finish].kind
        kind == TokenKind.RBrace || kind == TokenKind.RParen || kind == TokenKind.Comma || kind == TokenKind.Newline || kind == TokenKind.Eof
    }

    func parse_value_block(&var self, expected: ValueType, has_expected: Bool) -> Result<BlockValue, ProtoError> {
        if self.depth >= 128 { return self.fail("block nesting limit exceeded") }
        self.depth += 1
        let saved_parens = self.paren_depth
        self.paren_depth = 0
        self.skip_newlines()
        var returns = false
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            let tail = self.expression_is_block_tail()
            if self.value_statement_start() || ((self.at(TokenKind.If) || self.at(TokenKind.Match)) && not tail) {
                let r = try self.parse_statement()
                if r { returns = true }
                try self.terminator()
                continue
            }
            let start = self.token()
            var value = returning_value()
            if has_expected && tail { value = try self.parse_expected_expr(expected) }
            else { value = try self.parse_expr() }
            let had_newline = self.at(TokenKind.Newline)
            if had_newline { self.skip_newlines() }
            if self.at(TokenKind.RBrace) {
                let _ = self.take()
                self.leave_scope()
                self.depth -= 1
                self.paren_depth = saved_parens
                if returns || value.always_returns {
                    return BlockValue(has_value: false, value: returning_value(), always_returns: true)
                }
                return BlockValue(has_value: true, value: value, always_returns: false)
            }
            if value.always_returns { returns = true }
            else if not value.call || value.ty != ValueType.Void {
                return problem("only Void function calls may be expression statements", start.line, start.col)
            }
            if not had_newline { return problem("expected newline after statement", start.line, start.col) }
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace")
        self.leave_scope()
        self.depth -= 1
        self.paren_depth = saved_parens
        BlockValue(has_value: false, value: returning_value(), always_returns: returns)
    }

    func merge_control_type(&self, a: &ExprValue, b: &ExprValue,
                            expected: ValueType, has_expected: Bool, t: &Token) -> Result<ValueType, ProtoError> {
        if has_expected { return expected }
        if a.ty == b.ty { return a.ty }
        if a.literal && integer_type(b.ty) { return b.ty }
        if b.literal && integer_type(a.ty) { return a.ty }
        if integer_widens(a.ty, b.ty) { return b.ty }
        if integer_widens(b.ty, a.ty) { return a.ty }
        problem("control-flow branches have incompatible types", t.line, t.col)
    }

    func append_value_exit(&var self, exit: Int, value: ExprValue, target: ValueType,
                           dst: Int, t: &Token, joins: &var Vector<Int>) -> Result<Void, ProtoError> {
        self.code[exit].target = self.code.len()
        let converted = try self.transfer(value, target, &t)
        try self.emit_copy_value(dst, converted.slot, target, &t)
        let join = self.emit_at(Op.Jump, t.line, t.col)
        try! joins.push(join)
        return
    }

    func parse_if_value(&var self, expected: ValueType, has_expected: Bool) -> Result<ExprValue, ProtoError> {
        if self.expr_depth >= 128 { return self.fail("expression nesting limit exceeded") }
        self.expr_depth += 1
        let result = try self.parse_if_value_inner(expected, has_expected)
        self.expr_depth -= 1
        result
    }

    func parse_if_value_inner(&var self, expected: ValueType, has_expected: Bool) -> Result<ExprValue, ProtoError> {
        let it = self.take()
        let condition = try self.parse_expr()
        try self.require_type(condition.ty, ValueType.Bool, &it)
        let _ = try self.expect(TokenKind.LBrace, "expected block after if condition")
        let branch = self.emit_at(Op.Branch, it.line, it.col)
        self.code[branch].a = condition.slot
        let skip_then = self.emit_at(Op.Jump, it.line, it.col)
        self.code[branch].target = self.code.len()
        let then_value = try self.parse_value_block(expected, has_expected)
        var then_exit = -1
        if not then_value.always_returns { then_exit = self.emit_at(Op.Jump, it.line, it.col) }
        self.code[skip_then].target = self.code.len()
        self.skip_newlines()
        if not self.at(TokenKind.Else) { return problem("value if requires an else", it.line, it.col) }
        let _ = self.take()
        var else_value = BlockValue(has_value: false, value: returning_value(), always_returns: false)
        if self.at(TokenKind.If) {
            let nested = try self.parse_if_value(expected, has_expected)
            else_value = BlockValue(has_value: not nested.always_returns, value: nested,
                                    always_returns: nested.always_returns)
        } else {
            let _ = try self.expect(TokenKind.LBrace, "expected block after else")
            else_value = try self.parse_value_block(expected, has_expected)
        }
        var else_exit = -1
        if not else_value.always_returns { else_exit = self.emit_at(Op.Jump, it.line, it.col) }
        if not then_value.always_returns && not then_value.has_value {
            return problem("continuing value branch requires a tail expression", it.line, it.col)
        }
        if not else_value.always_returns && not else_value.has_value {
            return problem("continuing value branch requires a tail expression", it.line, it.col)
        }
        if then_value.always_returns && else_value.always_returns { return returning_value() }
        var target = ValueType.Void
        if then_value.always_returns {
            target = else_value.value.ty
            if has_expected { target = expected }
        }
        else if else_value.always_returns {
            target = then_value.value.ty
            if has_expected { target = expected }
        }
        else { target = try self.merge_control_type(&then_value.value, &else_value.value, expected, has_expected, &it) }
        let dst = try self.new_value(target)
        var joins = Vector<Int>()
        if then_exit >= 0 { try self.append_value_exit(then_exit, then_value.value, target, dst, &it, &var joins) }
        if else_exit >= 0 { try self.append_value_exit(else_exit, else_value.value, target, dst, &it, &var joins) }
        let continuation = self.code.len()
        var j = 0
        while j < joins.len() {
            self.code[joins[j]].target = continuation
            j += 1
        }
        expr_value(target, dst, false)
    }

    func parse_match_value(&var self, expected: ValueType, has_expected: Bool) -> Result<ExprValue, ProtoError> {
        if self.expr_depth >= 128 { return self.fail("expression nesting limit exceeded") }
        self.expr_depth += 1
        let result = try self.parse_match_value_inner(expected, has_expected)
        self.expr_depth -= 1
        result
    }

    func parse_match_value_inner(&var self, expected: ValueType, has_expected: Bool) -> Result<ExprValue, ProtoError> {
        let mt = self.take()
        var subject = try self.parse_expr()
        subject = try self.snapshot(subject, &mt)
        var ei = -1
        match subject.ty {
            case Enum(index) -> { ei = index },
            case _ -> { return problem("match subject must have enum type", mt.line, mt.col) }
        }
        let _ = try self.expect(TokenKind.LBrace, "expected `\{` after match subject")
        self.skip_newlines()
        var covered = Vector<Bool>()
        var n = 0
        while n < self.enums[ei].cases.len() {
            try! covered.push(false)
            n += 1
        }
        var exits = Vector<Int>()
        var values = Vector<ExprValue>()
        var pending_false = -1
        var wildcard = false
        var arms = 0
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            if wildcard { return self.fail("match arm follows wildcard") }
            if pending_false >= 0 { self.code[pending_false].target = self.code.len() }
            let ct = try self.expect(TokenKind.Case, "expected `case` in match")
            let pattern = try self.expect(TokenKind.Ident, "expected enum case pattern")
            var ordinal = -1
            if pattern.value == "_" { wildcard = true }
            else if self.at(TokenKind.Dot) {
                let qualifier = self.enum_index(pattern.value)
                if qualifier != ei { return problem("enum qualifier `{pattern.value}` does not match subject enum `{self.enums[ei].name}`", pattern.line, pattern.col) }
                let _ = self.take()
                let item = try self.expect(TokenKind.Ident, "expected qualified enum case")
                ordinal = self.enum_case_index(ei, item.value)
                if ordinal < 0 { return problem("enum `{self.enums[ei].name}` has no case `{item.value}`", item.line, item.col) }
            } else {
                ordinal = self.enum_case_index(ei, pattern.value)
                if ordinal < 0 { return problem("enum `{self.enums[ei].name}` has no case `{pattern.value}`", pattern.line, pattern.col) }
            }
            if ordinal >= 0 {
                if covered[ordinal] { return problem("duplicate match case `{self.enums[ei].cases[ordinal]}`", pattern.line, pattern.col) }
                covered[ordinal] = true
                let constant = self.new_slot(subject.ty)
                let ci = self.emit_at(Op.Const, pattern.line, pattern.col)
                self.code[ci].dst = constant
                self.code[ci].immediate = ordinal
                let equal = self.new_slot(ValueType.Bool)
                let eq = self.emit_at(Op.Eq, pattern.line, pattern.col)
                self.code[eq].dst = equal
                self.code[eq].a = subject.slot
                self.code[eq].b = constant
                let branch = self.emit_at(Op.Branch, pattern.line, pattern.col)
                self.code[branch].a = equal
                pending_false = self.emit_at(Op.Jump, pattern.line, pattern.col)
                self.code[branch].target = self.code.len()
            } else { pending_false = -1 }
            let _ = try self.expect(TokenKind.Arrow, "expected `->` after match pattern")
            var outcome = BlockValue(has_value: false, value: returning_value(), always_returns: false)
            if self.at(TokenKind.LBrace) {
                let _ = self.take()
                outcome = try self.parse_value_block(expected, has_expected)
            } else {
                var value = returning_value()
                if has_expected { value = try self.parse_expected_expr(expected) }
                else { value = try self.parse_expr() }
                outcome = BlockValue(has_value: not value.always_returns, value: value,
                                     always_returns: value.always_returns)
            }
            if not outcome.always_returns {
                if not outcome.has_value { return problem("continuing value branch requires a tail expression", ct.line, ct.col) }
                let exit = self.emit_at(Op.Jump, ct.line, ct.col)
                try! exits.push(exit)
                try! values.push(outcome.value)
            }
            arms += 1
            self.skip_newlines()
            if self.at(TokenKind.Comma) {
                let _ = self.take()
                self.skip_newlines()
            }
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace for match")
        if arms == 0 { return problem("non-exhaustive match", mt.line, mt.col) }
        var exhaustive = wildcard
        if not exhaustive {
            exhaustive = true
            n = 0
            while n < covered.len() {
                if not covered[n] { exhaustive = false }
                n += 1
            }
        }
        if not exhaustive { return problem("non-exhaustive match", mt.line, mt.col) }
        if values.len() == 0 {
            if pending_false >= 0 { self.code[pending_false].target = self.code.len() }
            return returning_value()
        }
        var target = values[0].ty
        if has_expected { target = expected }
        if not has_expected {
            var candidate = -1
            var saw_typed = false
            n = 0
            while n < values.len() {
                if not values[n].literal {
                    saw_typed = true
                    var accepts = true
                    var j = 0
                    while j < values.len() {
                        if values[j].ty != values[n].ty && not values[j].literal && not integer_widens(values[j].ty, values[n].ty) { accepts = false }
                        j += 1
                    }
                    if accepts {
                        candidate = n
                        break
                    }
                }
                n += 1
            }
            if candidate >= 0 { target = values[candidate].ty }
            else if saw_typed { return problem("control-flow branches have incompatible types", mt.line, mt.col) }
        }
        let dst = try self.new_value(target)
        var joins = Vector<Int>()
        n = 0
        while n < values.len() {
            try self.append_value_exit(exits[n], values[n], target, dst, &mt, &var joins)
            n += 1
        }
        let continuation = self.code.len()
        if pending_false >= 0 { self.code[pending_false].target = continuation }
        n = 0
        while n < joins.len() {
            self.code[joins[n]].target = continuation
            n += 1
        }
        expr_value(target, dst, false)
    }

    func parse_block(&var self) -> Result<Bool, ProtoError> {
        if self.depth >= 128 { return self.fail("block nesting limit exceeded") }
        self.depth += 1
        self.skip_newlines()
        var returns = false
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            let r = try self.parse_statement()
            if not returns && r { returns = true }
            try self.terminator()
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace")
        self.leave_scope()
        self.depth -= 1
        returns
    }

    func parse_match_statement(&var self) -> Result<Bool, ProtoError> {
        let mt = self.take()
        var subject = try self.parse_expr()
        subject = try self.snapshot(subject, &mt)
        var ei = -1
        match subject.ty {
            case Enum(index) -> { ei = index },
            case _ -> { return problem("match subject must have enum type", mt.line, mt.col) }
        }
        let _ = try self.expect(TokenKind.LBrace, "expected `\{` after match subject")
        self.skip_newlines()
        var covered = Vector<Bool>()
        var i = 0
        while i < self.enums[ei].cases.len() {
            try! covered.push(false)
            i += 1
        }
        var joins = Vector<Int>()
        var pending_false = -1
        var wildcard = false
        var arm_count = 0
        var all_return = true
        while not self.at(TokenKind.RBrace) && not self.at(TokenKind.Eof) {
            if wildcard { return self.fail("match arm follows wildcard") }
            if pending_false >= 0 { self.code[pending_false].target = self.code.len() }
            let ct = try self.expect(TokenKind.Case, "expected `case` in match")
            let pattern = try self.expect(TokenKind.Ident, "expected enum case pattern")
            var ordinal = -1
            if pattern.value == "_" {
                wildcard = true
            } else if self.at(TokenKind.Dot) {
                let qualifier = self.enum_index(pattern.value)
                if qualifier != ei { return problem("enum qualifier `{pattern.value}` does not match subject enum `{self.enums[ei].name}`", pattern.line, pattern.col) }
                let _ = self.take()
                let item = try self.expect(TokenKind.Ident, "expected qualified enum case")
                ordinal = self.enum_case_index(ei, item.value)
                if ordinal < 0 { return problem("enum `{self.enums[ei].name}` has no case `{item.value}`", item.line, item.col) }
            } else {
                ordinal = self.enum_case_index(ei, pattern.value)
                if ordinal < 0 { return problem("enum `{self.enums[ei].name}` has no case `{pattern.value}`", pattern.line, pattern.col) }
            }
            if ordinal >= 0 {
                if covered[ordinal] { return problem("duplicate match case `{self.enums[ei].cases[ordinal]}`", pattern.line, pattern.col) }
                covered[ordinal] = true
                let constant = self.new_slot(subject.ty)
                let ci = self.emit_at(Op.Const, pattern.line, pattern.col)
                self.code[ci].dst = constant
                self.code[ci].immediate = ordinal
                let equal = self.new_slot(ValueType.Bool)
                let eq = self.emit_at(Op.Eq, pattern.line, pattern.col)
                self.code[eq].dst = equal
                self.code[eq].a = subject.slot
                self.code[eq].b = constant
                let branch = self.emit_at(Op.Branch, pattern.line, pattern.col)
                self.code[branch].a = equal
                pending_false = self.emit_at(Op.Jump, pattern.line, pattern.col)
                self.code[branch].target = self.code.len()
            } else { pending_false = -1 }
            let _ = try self.expect(TokenKind.Arrow, "expected `->` after match pattern")
            let _ = try self.expect(TokenKind.LBrace, "match arms require statement blocks")
            let returns = try self.parse_block()
            if not returns {
                all_return = false
                let join = self.emit_at(Op.Jump, ct.line, ct.col)
                try! joins.push(join)
            }
            arm_count += 1
            self.skip_newlines()
            if self.at(TokenKind.Comma) {
                let _ = self.take()
                self.skip_newlines()
            }
        }
        let _ = try self.expect(TokenKind.RBrace, "expected closing brace for match")
        if arm_count == 0 { return problem("non-exhaustive match", mt.line, mt.col) }
        var exhaustive = wildcard
        if not exhaustive {
            exhaustive = true
            i = 0
            while i < covered.len() {
                if not covered[i] { exhaustive = false }
                i += 1
            }
        }
        if not exhaustive { return problem("non-exhaustive match", mt.line, mt.col) }
        let continuation = self.code.len()
        if pending_false >= 0 { self.code[pending_false].target = continuation }
        i = 0
        while i < joins.len() {
            self.code[joins[i]].target = continuation
            i += 1
        }
        all_return
    }

    func parse_statement(&var self) -> Result<Bool, ProtoError> {
        let statement_token = self.token()
        if self.at(TokenKind.Semicolon) { return self.fail("semicolons are not supported") }
        if self.at(TokenKind.Match) { return self.parse_match_statement() }
        if self.at(TokenKind.Let) || self.at(TokenKind.Var) {
            let kw = self.take()
            let name = try self.expect(TokenKind.Ident, "expected local name")
            var annotated: ValueType? = None
            if self.at(TokenKind.Colon) {
                let _ = self.take()
                annotated = Some(try self.parse_type())
            }
            if let local_type = annotated {
                if reference_type(local_type) { return problem("reference locals are not supported", name.line, name.col) }
            }
            let _ = try self.expect(TokenKind.Assign, "local declarations require an initializer")
            var value = if let ty = annotated { try self.parse_expected_expr(ty) } else { try self.parse_expr() }
            if value.always_returns { return problem("all-returning control flow cannot be used as an operand", name.line, name.col) }
            if value.ty == ValueType.Void { return problem("cannot initialize a local with Void", name.line, name.col) }
            if reference_type(value.ty) { return problem("reference locals are not supported", name.line, name.col) }
            if let _ = annotated {} else { value = try self.transfer(value, value.ty, &name) }
            let dst = try self.new_value(value.ty)
            try self.emit_copy_value(dst, value.slot, value.ty, &name)
            try self.declare(name, value.ty, dst, kw.kind == TokenKind.Var)
            return false
        }
        if self.at(TokenKind.Return) {
            let t = self.take()
            var src = -1
            if not self.at(TokenKind.Newline) && not self.at(TokenKind.RBrace) {
                var value = try self.parse_expected_expr(self.current_result)
                if value.always_returns { return true }
                src = value.slot
            } else if self.current_result != ValueType.Void { return problem("non-Void return requires a value", t.line, t.col) }
            let at = self.emit_at(Op.Return, t.line, t.col)
            self.code[at].a = src
            return true
        }
        if self.at(TokenKind.If) {
            let t = self.take()
            let cond = try self.parse_expr()
            try self.require_type(cond.ty, ValueType.Bool, &t)
            let _ = try self.expect(TokenKind.LBrace, "expected block after if condition")
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = cond.slot
            let skip_then = self.emit_at(Op.Jump, t.line, t.col)
            self.code[branch].target = self.code.len()
            let then_returns = try self.parse_block()
            let skip_else = self.emit_at(Op.Jump, t.line, t.col)
            self.code[skip_then].target = self.code.len()
            var else_returns = false
            let before_else = self.pos
            self.skip_newlines()
            if self.at(TokenKind.Else) {
                let _ = self.take()
                if self.at(TokenKind.If) {
                    if self.depth >= 128 { return self.fail("block nesting limit exceeded") }
                    self.depth += 1
                    else_returns = try self.parse_statement()
                    self.depth -= 1
                } else {
                    let _ = try self.expect(TokenKind.LBrace, "expected block after else")
                    else_returns = try self.parse_block()
                }
            } else {
                self.pos = before_else
            }
            self.code[skip_else].target = self.code.len()
            return then_returns && else_returns
        }
        if self.at(TokenKind.While) {
            let t = self.take()
            let cond_start = self.code.len()
            let cond = try self.parse_expr()
            try self.require_type(cond.ty, ValueType.Bool, &t)
            let _ = try self.expect(TokenKind.LBrace, "expected block after while condition")
            let branch = self.emit_at(Op.Branch, t.line, t.col)
            self.code[branch].a = cond.slot
            let exit = self.emit_at(Op.Jump, t.line, t.col)
            self.code[branch].target = self.code.len()
            let _ = try self.parse_block()
            let back = self.emit_at(Op.Jump, t.line, t.col)
            self.code[back].target = cond_start
            self.code[exit].target = self.code.len()
            return false
        }
        if self.at(TokenKind.LBrace) {
            let _ = self.take()
            return self.parse_block()
        }
        if statement_token.kind == TokenKind.Ident && statement_token.value == "print" {
            let t = self.take()
            let _ = try self.expect(TokenKind.LParen, "expected `(` after print")
            self.depth += 1
            self.paren_depth += 1
            self.skip_newlines()
            var value = try self.parse_expr()
            if value.always_returns { return problem("all-returning control flow cannot be used as an operand", t.line, t.col) }
            value = try self.transfer(value, value.ty, &t)
            self.skip_newlines()
            let _ = try self.expect(TokenKind.RParen, "expected `)` after print argument")
            self.paren_depth -= 1
            self.depth -= 1
            if value.ty == ValueType.Void { return problem("cannot print Void", t.line, t.col) }
            if not printable_type(value.ty) {
                match value.ty {
                    case Enum(_) -> { return problem("cannot print an enum value", t.line, t.col) },
                    case _ -> { return problem("cannot print a record value", t.line, t.col) }
                }
            }
            let at = self.emit_at(Op.Print, t.line, t.col)
            self.code[at].a = value.slot
            return false
        }
        if self.assignment_ahead() {
            let parsed = try self.parse_place()
            let name = parsed.0
            let place = parsed.1
            let assign = self.take()
            if not place.mutable {
                if place.indirect { return problem("cannot assign through a shared reference", name.line, name.col) }
                return problem("cannot assign to immutable local `{name.value}`", name.line, name.col)
            }
            try self.check_write(place.root, &name)
            var value = returning_value()
            if assign.kind == TokenKind.Assign {
                let saved_writes = self.pending_writes.len()
                try! self.pending_writes.push(place.root)
                value = try self.parse_expected_expr(place.ty)
                self.restore_pending_writes(saved_writes)
            } else {
                if not arithmetic_type(place.ty) { return problem("compound assignment requires an arithmetic integer destination", assign.line, assign.col) }
                let left = try self.read_place(place, &name)
                let saved_writes = self.pending_writes.len()
                try! self.pending_writes.push(place.root)
                value = try self.parse_expr()
                self.restore_pending_writes(saved_writes)
                if value.always_returns { return problem("all-returning control flow cannot be used as an operand", assign.line, assign.col) }
                if value.literal { value = try self.transfer(value, place.ty, &assign) }
                else if value.ty != place.ty { return problem("compound assignment operands must have the same type", assign.line, assign.col) }
                let op = if assign.kind == TokenKind.PlusAssign { Op.Add } else if assign.kind == TokenKind.MinusAssign { Op.Sub } else if assign.kind == TokenKind.StarAssign { Op.Mul } else if assign.kind == TokenKind.SlashAssign { Op.Div } else { Op.Rem }
                value = try self.binary(left, value, op, place.ty, &assign)
            }
            if value.always_returns { return problem("all-returning control flow cannot be used as an operand", assign.line, assign.col) }
            value = try self.snapshot(value, &name)
            try self.store_place(place, value, &name)
            return false
        }
        let start = self.token()
        let value = try self.parse_expr()
        if not value.call || value.ty != ValueType.Void {
            return problem("only Void function calls may be expression statements", start.line, start.col)
        }
        false
    }

    func compile_function(&var self, index: Int) -> Result<FuncIR, ProtoError> {
        self.pos = self.signatures[index].body_start
        self.depth = 0
        self.expr_depth = 0
        self.paren_depth = 0
        self.bindings = Vector<Binding>()
        self.active_borrows = Vector<Borrow>()
        self.pending_writes = Vector<Int>()
        self.slots = Vector<ValueType>()
        self.code = Vector<Instruction>()
        self.current_result = self.signatures[index].result
        var i = 0
        while i < self.signatures[index].params.len() {
            let slot = try self.new_value(self.signatures[index].params[i])
            let fake = Token(kind: TokenKind.Ident, value: self.signatures[index].param_names[i],
                             line: self.signatures[index].line, col: self.signatures[index].col, suffix: None)
            try self.declare(fake, self.signatures[index].params[i], slot, false)
            i += 1
        }
        self.skip_newlines()
        var returns = false
        while self.pos < self.signatures[index].body_end {
            if self.current_result != ValueType.Void && self.expression_is_block_tail() && not self.value_statement_start() && (not self.at(TokenKind.If) || self.if_has_else()) {
                let tail = try self.parse_expected_expr(self.current_result)
                if tail.always_returns { returns = true }
                else {
                    let r = self.emit_at(Op.Return, self.signatures[index].line, self.signatures[index].col)
                    self.code[r].a = tail.slot
                    returns = true
                }
                self.skip_newlines()
                break
            }
            let r = try self.parse_statement()
            if not returns && r { returns = true }
            try self.terminator()
        }
        if self.pos != self.signatures[index].body_end { return self.fail("malformed function body") }
        if self.current_result != ValueType.Void && not returns {
            return problem("function `{self.signatures[index].name}` may reach its end without returning a value",
                           self.signatures[index].line, self.signatures[index].col)
        }
        if self.current_result == ValueType.Void {
            let _ = self.emit_at(Op.Return, self.signatures[index].line, self.signatures[index].col)
        } else {
            // Return-path checking above proves this padding unreachable. It gives
            // end-of-block jumps a real target and leaves every emitted block terminated.
            let slot = try self.new_value(self.current_result)
            let layout = try value_layout(&self.records, self.current_result)
            var word = 0
            while word < layout.len() {
                let c = self.emit_at(Op.Const, self.signatures[index].line, self.signatures[index].col)
                self.code[c].dst = slot + word
                self.code[c].immediate = 0
                word += 1
            }
            let r = self.emit_at(Op.Return, self.signatures[index].line, self.signatures[index].col)
            self.code[r].a = slot
        }
        let slots = self.slots.copy()
        let code = self.code.copy()
        FuncIR(name: self.signatures[index].name, params: self.signatures[index].params.copy(),
               result: self.current_result, slots: move slots, code: move code)
    }
}

public func compile_source(source: String) -> Result<Program, ProtoError> {
    let tokens = match lex(source) {
        case Ok(ts) -> move ts,
        case Err(e) -> { return problem(e.message, e.line, e.col) }
    }
    var compiler = Compiler(tokens: move tokens, records: Vector<RecordIR>(), enums: Vector<EnumIR>(), references: Vector<ReferenceIR>(), statics: Vector<StaticBinding>(),
                            signatures: Vector<Signature>(), pos: 0, depth: 0,
                            expr_depth: 0, paren_depth: 0,
                            bindings: Vector<Binding>(), active_borrows: Vector<Borrow>(), pending_writes: Vector<Int>(),
                            slots: Vector<ValueType>(),
                            code: Vector<Instruction>(), current_result: ValueType.Void)
    try compiler.collect_record_names()
    try compiler.scan_signatures()
    try validate_records(&compiler.records)
    try validate_enums(&compiler.enums)
    var functions = Vector<FuncIR>()
    var main_index = -1
    var i = 0
    while i < compiler.signatures.len() {
        if compiler.signatures[i].name == "main" { main_index = i }
        let f = try compiler.compile_function(i)
        try! functions.push(move f)
        i += 1
    }
    Program(enums: compiler.enums.copy(), records: compiler.records.copy(), references: compiler.references.copy(),
            functions: move functions, main_index: main_index)
}
