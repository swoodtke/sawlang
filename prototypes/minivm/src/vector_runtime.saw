func vector_ir(out: &var StringBuilder, text: String) { try! out.append(text) }

public func emit_vector_runtime(out: &var StringBuilder, fail_after: Int) {
    vector_ir(&var out, "@.vector_alloc_error = private unnamed_addr constant [40 x i8] c\"runtime error: vector allocation failed\\00\"\n")
    vector_ir(&var out, "@.vector_handle_error = private unnamed_addr constant [37 x i8] c\"runtime error: invalid vector handle\\00\"\n")
    vector_ir(&var out, "@.vector_index_error = private unnamed_addr constant [42 x i8] c\"runtime error: vector index out of bounds\\00\"\n")
    vector_ir(&var out, "@.vector_length_error = private unnamed_addr constant [38 x i8] c\"runtime error: vector length overflow\\00\"\n")
    vector_ir(&var out, "@.vector_live_error = private unnamed_addr constant [38 x i8] c\"runtime error: live vector allocation\\00\"\n")
    vector_ir(&var out, "@minivm_vector_live = internal global i64 0\n@minivm_vector_fail_after = internal global i64 ")
    try! out.append(fail_after)
    vector_ir(&var out, "\n\n")
    vector_ir(&var out, "define internal void @minivm_vector_fatal(ptr %message) \{\nentry:\n  call i32 @puts(ptr %message)\n  call void @exit(i32 1)\n  unreachable\n\}\n\n")
    vector_ir(&var out, "define internal ptr @minivm_vector_new() \{\nentry:\n  %header = call ptr @malloc(i64 16)\n  %null = icmp eq ptr %header, null\n  br i1 %null, label %fail, label %init\nfail:\n  call void @minivm_vector_fatal(ptr @.vector_alloc_error)\n  unreachable\ninit:\n  store i64 0, ptr %header\n  %datap = getelementptr i8, ptr %header, i64 8\n  store ptr null, ptr %datap\n  %live = load i64, ptr @minivm_vector_live\n  %next = add i64 %live, 1\n  store i64 %next, ptr @minivm_vector_live\n  ret ptr %header\n\}\n\n")
    vector_ir(&var out, "define internal i64 @minivm_vector_len(ptr %header, i64 %width) \{\nentry:\n  %null = icmp eq ptr %header, null\n  %bad_width = icmp sle i64 %width, 0\n  %bad0 = or i1 %null, %bad_width\n  br i1 %bad0, label %bad, label %load\nload:\n  %len = load i64, ptr %header\n  %negative = icmp slt i64 %len, 0\n  %limit = udiv i64 1152921504606846975, %width\n  %too_long = icmp ugt i64 %len, %limit\n  %bad_len = or i1 %negative, %too_long\n  br i1 %bad_len, label %overflow, label %done\nbad:\n  call void @minivm_vector_fatal(ptr @.vector_handle_error)\n  unreachable\noverflow:\n  call void @minivm_vector_fatal(ptr @.vector_length_error)\n  unreachable\ndone:\n  ret i64 %len\n\}\n\n")
    vector_ir(&var out, "define internal ptr @minivm_vector_get_ptr(ptr %header, i64 %index, i64 %width, i1 %checked) \{\nentry:\n  %len = call i64 @minivm_vector_len(ptr %header, i64 %width)\n  %negative = icmp slt i64 %index, 0\n  %past = icmp uge i64 %index, %len\n  %miss = or i1 %negative, %past\n  br i1 %miss, label %missing, label %address\nmissing:\n  br i1 %checked, label %trap, label %none\ntrap:\n  call void @minivm_vector_fatal(ptr @.vector_index_error)\n  unreachable\nnone:\n  ret ptr null\naddress:\n  %datap = getelementptr i8, ptr %header, i64 8\n  %data = load ptr, ptr %datap\n  %word = mul i64 %index, %width\n  %at = getelementptr i64, ptr %data, i64 %word\n  ret ptr %at\n\}\n\n")
    // Returns {success,new buffer,requested bytes}; the header remains unchanged.
    vector_ir(&var out, "define internal \{i64, ptr, i64\} @minivm_vector_prepare_push(ptr %header, i64 %width) \{\nentry:\n  %len = call i64 @minivm_vector_len(ptr %header, i64 %width)\n  %limit = udiv i64 1152921504606846975, %width\n  %full = icmp uge i64 %len, %limit\n  br i1 %full, label %overflow, label %size\noverflow:\n  call void @minivm_vector_fatal(ptr @.vector_length_error)\n  unreachable\nsize:\n  %new_len = add i64 %len, 1\n  %words = mul i64 %new_len, %width\n  %bytes = mul i64 %words, 8\n  %counter = load i64, ptr @minivm_vector_fail_after\n  %inject = icmp eq i64 %counter, 0\n  br i1 %inject, label %inject_fail, label %allocate\ninject_fail:\n  store i64 -1, ptr @minivm_vector_fail_after\n  br label %failure\nallocate:\n  %new_data = call ptr @malloc(i64 %bytes)\n  %null = icmp eq ptr %new_data, null\n  br i1 %null, label %failure, label %copy\ncopy:\n  %old_words = mul i64 %len, %width\n  %old_bytes = mul i64 %old_words, 8\n  %datap = getelementptr i8, ptr %header, i64 8\n  %old_data = load ptr, ptr %datap\n  %has_old = icmp ne i64 %old_bytes, 0\n  br i1 %has_old, label %copy_old, label %copied\ncopy_old:\n  call ptr @memcpy(ptr %new_data, ptr %old_data, i64 %old_bytes)\n  br label %copied\ncopied:\n  %positive = icmp sgt i64 %counter, 0\n  br i1 %positive, label %decrement, label %success\ndecrement:\n  %counter_next = sub i64 %counter, 1\n  store i64 %counter_next, ptr @minivm_vector_fail_after\n  br label %success\nsuccess:\n  %ok0 = insertvalue \{i64, ptr, i64\} undef, i64 1, 0\n  %ok1 = insertvalue \{i64, ptr, i64\} %ok0, ptr %new_data, 1\n  %ok2 = insertvalue \{i64, ptr, i64\} %ok1, i64 %bytes, 2\n  ret \{i64, ptr, i64\} %ok2\nfailure:\n  %no0 = insertvalue \{i64, ptr, i64\} undef, i64 0, 0\n  %no1 = insertvalue \{i64, ptr, i64\} %no0, ptr null, 1\n  %no2 = insertvalue \{i64, ptr, i64\} %no1, i64 %bytes, 2\n  ret \{i64, ptr, i64\} %no2\n\}\n\n")
    vector_ir(&var out, "define internal void @minivm_vector_commit_push(ptr %header, ptr %new_data) \{\nentry:\n  %len = load i64, ptr %header\n  %datap = getelementptr i8, ptr %header, i64 8\n  %old_data = load ptr, ptr %datap\n  %new_len = add i64 %len, 1\n  store ptr %new_data, ptr %datap\n  store i64 %new_len, ptr %header\n  call void @free(ptr %old_data)\n  ret void\n\}\n\n")
    vector_ir(&var out, "define internal void @minivm_vector_free_header(ptr %header) \{\nentry:\n  %datap = getelementptr i8, ptr %header, i64 8\n  %data = load ptr, ptr %datap\n  call void @free(ptr %data)\n  call void @free(ptr %header)\n  %live = load i64, ptr @minivm_vector_live\n  %next = sub i64 %live, 1\n  store i64 %next, ptr @minivm_vector_live\n  ret void\n\}\n\n")
    vector_ir(&var out, "define internal void @minivm_vector_check_live() \{\nentry:\n  %live = load i64, ptr @minivm_vector_live\n  %bad = icmp ne i64 %live, 0\n  br i1 %bad, label %fail, label %done\nfail:\n  call void @minivm_vector_fatal(ptr @.vector_live_error)\n  unreachable\ndone:\n  ret void\n\}\n\n")
}
