import src.model.*

func slot_type(f: &FuncIR, n: Int) -> ValueType {
    if n < 0 || n >= f.slots.len() { return ValueType.Void }
    return f.slots[n]
}

func invalid(i: &Instruction) -> ProtoError {
    return problem("internal prototype error: invalid instruction", i.line, i.col)
}

func check_type(p: &Program, t: ValueType) -> Result<Void, ProtoError> {
    match t {
        case Vector(index) -> {
            if index < 0 || index >= p.vectors.len() { return problem("internal prototype error: invalid vector type index", 0, 0) }
        },
        case Enum(index) -> {
            if index < 0 || index >= p.enums.len() { return problem("internal prototype error: invalid enum type index", 0, 0) }
        },
        case Record(index) -> {
            if index < 0 || index >= p.records.len() { return problem("internal prototype error: invalid record type index", 0, 0) }
        },
        case Ref(index) -> {
            if index < 0 || index >= p.references.len() { return problem("internal prototype error: invalid reference type index", 0, 0) }
        },
        case Optional(index) -> {
            if index < 0 || index >= p.sums.len() { return problem("internal prototype error: invalid optional type index", 0, 0) }
            if p.sums[index].kind != SumKind.Optional { return problem("internal prototype error: optional type has mismatched descriptor kind", 0, 0) }
        },
        case Result(index) -> {
            if index < 0 || index >= p.sums.len() { return problem("internal prototype error: invalid result type index", 0, 0) }
            if p.sums[index].kind != SumKind.Result { return problem("internal prototype error: result type has mismatched descriptor kind", 0, 0) }
        },
        case _ -> {}
    }
    return
}

func check_declared_types(p: &Program) -> Result<Void, ProtoError> {
    var n = 0
    while n < p.vectors.len() {
        try check_type(&p, p.vectors[n].element)
        n += 1
    }
    n = 0
    while n < p.references.len() {
        try check_type(&p, p.references[n].target)
        n += 1
    }
    n = 0
    while n < p.sums.len() {
        try check_type(&p, p.sums[n].payload)
        try check_type(&p, p.sums[n].error)
        n += 1
    }
    n = 0
    while n < p.records.len() {
        let record = p.records[n].copy()
        var e = 0
        while e < p.enums.len() {
            if record.name == p.enums[e].name { return problem("duplicate module type name", record.line, record.col) }
            e += 1
        }
        var field = 0
        while field < record.field_types.len() {
            try check_type(&p, record.field_types[field])
            field += 1
        }
        n += 1
    }
    n = 0
    while n < p.functions.len() {
        let f = p.functions[n].copy()
        try check_type(&p, f.result)
        if reference_type(f.result) { return problem("reference function results are not supported", 0, 0) }
        if builder_type(f.result) { return problem("StringBuilder function results are not supported", 0, 0) }
        var word = 0
        while word < f.params.len() {
            try check_type(&p, f.params[word])
            if builder_type(f.params[word]) { return problem("StringBuilder by-value parameters are not supported", 0, 0) }
            if not reference_type(f.params[word]) && not copyable_type(&p.records, &p.sums, f.params[word]) {
                return problem("noncopyable by-value parameters are not supported", 0, 0)
            }
            word += 1
        }
        word = 0
        while word < f.slots.len() {
            try check_type(&p, f.slots[word])
            word += 1
        }
        n += 1
    }
    return
}

func parameter_layout(p: &Program, f: &FuncIR) -> Result<Vector<ValueType>, ProtoError> {
    var words = Vector<ValueType>()
    var n = 0
    while n < f.params.len() {
        if f.params[n] == ValueType.Void { return problem("internal prototype error: Void parameter", 0, 0) }
        let layout = try value_layout(&p.records, &p.sums, f.params[n])
        var word = 0
        while word < layout.len() {
            try! words.push(layout[word])
            word += 1
        }
        n += 1
    }
    move words
}

func range_matches(f: &FuncIR, start: Int, layout: &Vector<ValueType>) -> Bool {
    if start < 0 || start > f.slots.len() || layout.len() > f.slots.len() - start { return false }
    var n = 0
    while n < layout.len() {
        if f.slots[start + n] != layout[n] { return false }
        n += 1
    }
    true
}

func builder_reference(p: &Program, t: ValueType, mutable: Bool) -> Bool {
    if not reference_type(t) { return false }
    let target = try reference_target(&p.references, t) catch { return false }
    builder_type(target) && (not mutable || reference_mutable(&p.references, t))
}

func check_builder_append(p: &Program, f: &FuncIR, i: &Instruction,
                          input: ValueType) -> Result<Void, ProtoError> {
    if not builder_reference(&p, slot_type(&f, i.a), true) || slot_type(&f, i.b) != input {
        return invalid(&i)
    }
    if i.target != -1 || i.args.len() != 0 || p.alloc_error_record < 0 {
        return invalid(&i)
    }
    if i.immediate < 0 || i.immediate >= p.sums.len() { return invalid(&i) }
    let sum = p.sums[i.immediate].copy()
    if (sum.kind != SumKind.Result || sum.payload != ValueType.Void ||
        sum.error != ValueType.Record(p.alloc_error_record)) { return invalid(&i) }
    let layout: Vector<ValueType> = [ValueType.Bool, ValueType.I64, ValueType.I64]
    if not range_matches(&f, i.dst, &layout) { return invalid(&i) }
    return
}

func check_vector_instruction(p: &Program, f: &FuncIR, i: &Instruction) -> Result<Void, ProtoError> {
    if i.target != -1 || i.args.len() != 0 { return invalid(&i) }
    if i.op == Op.VectorNew {
        if not vector_type(slot_type(&f, i.dst)) || i.a != -1 || i.b != -1 || i.immediate != 0 { return invalid(&i) }
        return
    }
    if i.op == Op.MoveVector {
        if (not vector_type(slot_type(&f, i.dst)) || slot_type(&f, i.a) != slot_type(&f, i.dst) ||
            i.a == i.dst || i.b != -1 || i.immediate != 0) { return invalid(&i) }
        return
    }
    let ref = slot_type(&f, i.a)
    if not reference_type(ref) { return invalid(&i) }
    let vector = try reference_target(&p.references, ref)
    if not vector_type(vector) { return invalid(&i) }
    let element = try vector_element(&p.vectors, vector)
    let layout = try value_layout(&p.records, &p.sums, element)
    if i.op == Op.VectorLen {
        if slot_type(&f, i.dst) != ValueType.I64 || i.b != -1 || i.immediate != 0 { return invalid(&i) }
    } else if i.op == Op.VectorIndex {
        if slot_type(&f, i.b) != ValueType.I64 || i.immediate != 0 || not range_matches(&f, i.dst, &layout) { return invalid(&i) }
    } else if i.op == Op.VectorGet {
        if slot_type(&f, i.b) != ValueType.I64 || i.immediate < 0 || i.immediate >= p.sums.len() { return invalid(&i) }
        let sum = p.sums[i.immediate].copy()
        if sum.kind != SumKind.Optional || sum.payload != element { return invalid(&i) }
        let result_layout = try value_layout(&p.records, &p.sums, ValueType.Optional(i.immediate))
        if not range_matches(&f, i.dst, &result_layout) { return invalid(&i) }
    } else {
        if not reference_mutable(&p.references, ref) || not range_matches(&f, i.b, &layout) { return invalid(&i) }
        if p.alloc_error_record < 0 || i.immediate < 0 || i.immediate >= p.sums.len() { return invalid(&i) }
        let sum = p.sums[i.immediate].copy()
        if (sum.kind != SumKind.Result || sum.payload != ValueType.Void ||
            sum.error != ValueType.Record(p.alloc_error_record)) { return invalid(&i) }
        let result_layout: Vector<ValueType> = [ValueType.Bool, ValueType.I64, ValueType.I64]
        if not range_matches(&f, i.dst, &result_layout) { return invalid(&i) }
    }
    return
}

func check_instruction(p: &Program, f: &FuncIR, i: &Instruction) -> Result<Void, ProtoError> {
    let dst = slot_type(&f, i.dst)
    let a = slot_type(&f, i.a)
    let b = slot_type(&f, i.b)
    match i.op {
        case Const -> {
            if not scalar_type(dst) { return invalid(&i) }
            if dst == ValueType.Bool && i.immediate != 0 && i.immediate != 1 { return invalid(&i) }
            if integer_type(dst) && not integer_canonical(i.immediate, dst) { return invalid(&i) }
            match dst {
                case Enum(index) -> {
                    if i.immediate < 0 || i.immediate >= p.enums[index].cases.len() { return invalid(&i) }
                },
                case _ -> {}
            }
        },
        case Copy -> {
            if reference_type(dst) {
                if not reference_transfer(&p.references, a, dst) { return invalid(&i) }
            } else if (not scalar_type(dst) && not string_type(dst)) || a != dst { return invalid(&i) }
        },
        case StringConst -> {
            if not string_type(dst) || i.immediate < 0 || i.immediate >= p.strings.len() { return invalid(&i) }
        },
        case StringLen -> {
            if not string_type(a) || dst != ValueType.I64 { return invalid(&i) }
        },
        case StringByteAt -> {
            if not string_type(a) || b != ValueType.I64 || dst != ValueType.Byte { return invalid(&i) }
        },
        case StringSlice -> {
            if not string_type(a) || b != ValueType.I64 || not string_type(dst) || i.args.len() != 1 { return invalid(&i) }
            if slot_type(&f, i.args[0]) != ValueType.I64 { return invalid(&i) }
        },
        case StringToUInt -> {
            let layout: Vector<ValueType> = [ValueType.Bool, ValueType.U64]
            if not string_type(a) || b != ValueType.I64 || not range_matches(&f, i.dst, &layout) { return invalid(&i) }
        },
        case BuilderNew -> {
            if (not builder_type(dst) || i.a != -1 || i.b != -1 || i.immediate != 0 ||
                i.target != -1 || i.args.len() != 0) { return invalid(&i) }
        },
        case BuilderBuild -> {
            if (not string_type(dst) || not builder_reference(&p, a, false) || i.b != -1 ||
                i.immediate != 0 || i.target != -1 || i.args.len() != 0) { return invalid(&i) }
        },
        case BuilderAppendString -> { try check_builder_append(&p, &f, &i, ValueType.String) },
        case BuilderAppendByte -> { try check_builder_append(&p, &f, &i, ValueType.Byte) },
        case BuilderAppendInt -> { try check_builder_append(&p, &f, &i, ValueType.I64) },
        case BuilderAppendScalar -> { try check_builder_append(&p, &f, &i, ValueType.I64) },
        case BuilderClear -> {
            if (i.dst != -1 || not builder_reference(&p, a, true) || i.b != -1 ||
                i.immediate != 0 || i.target != -1 || i.args.len() != 0) { return invalid(&i) }
        },
        case VectorNew -> { try check_vector_instruction(&p, &f, &i) },
        case VectorLen -> { try check_vector_instruction(&p, &f, &i) },
        case VectorIndex -> { try check_vector_instruction(&p, &f, &i) },
        case VectorGet -> { try check_vector_instruction(&p, &f, &i) },
        case VectorPush -> { try check_vector_instruction(&p, &f, &i) },
        case MoveVector -> { try check_vector_instruction(&p, &f, &i) },
        case Drop -> {
            if not owning_type(a) { return invalid(&i) }
        },
        case Addr -> {
            if not reference_type(dst) { return invalid(&i) }
            let target = try reference_target(&p.references, dst)
            let layout = try value_layout(&p.records, &p.sums, target)
            if not range_matches(&f, i.a, &layout) { return invalid(&i) }
        },
        case LoadRef -> {
            if not reference_type(a) { return invalid(&i) }
            let target = try reference_target(&p.references, a)
            if not copyable_type(&p.records, &p.sums, target) { return invalid(&i) }
            let layout = try value_layout(&p.records, &p.sums, target)
            if not range_matches(&f, i.dst, &layout) { return invalid(&i) }
        },
        case StoreRef -> {
            if not reference_mutable(&p.references, a) { return invalid(&i) }
            let target = try reference_target(&p.references, a)
            if not copyable_type(&p.records, &p.sums, target) { return invalid(&i) }
            let layout = try value_layout(&p.records, &p.sums, target)
            if not range_matches(&f, i.b, &layout) { return invalid(&i) }
        },
        case RefField -> {
            if not reference_type(a) || not reference_type(dst) { return invalid(&i) }
            if reference_mutable(&p.references, dst) && not reference_mutable(&p.references, a) { return invalid(&i) }
            let parent = try reference_target(&p.references, a)
            let target = try reference_target(&p.references, dst)
            match parent {
                case Record(index) -> {
                    if i.immediate < 0 || i.immediate >= p.records[index].field_types.len() { return invalid(&i) }
                    if target != p.records[index].field_types[i.immediate] { return invalid(&i) }
                },
                case _ -> { return invalid(&i) }
            }
        },
        case Add -> { try check_binary(&i, dst, a, b) },
        case Sub -> { try check_binary(&i, dst, a, b) },
        case Mul -> { try check_binary(&i, dst, a, b) },
        case Div -> { try check_binary(&i, dst, a, b) },
        case Rem -> { try check_binary(&i, dst, a, b) },
        case WrapAdd -> { try check_binary(&i, dst, a, b) },
        case WrapSub -> { try check_binary(&i, dst, a, b) },
        case WrapMul -> { try check_binary(&i, dst, a, b) },
        case BitAnd -> { try check_binary(&i, dst, a, b) },
        case BitOr -> { try check_binary(&i, dst, a, b) },
        case BitXor -> { try check_binary(&i, dst, a, b) },
        case Shl -> { if not arithmetic_type(dst) || a != dst || not arithmetic_type(b) { return invalid(&i) } },
        case Shr -> { if not arithmetic_type(dst) || a != dst || not arithmetic_type(b) { return invalid(&i) } },
        case Cast -> { if not integer_type(dst) || not integer_type(a) { return invalid(&i) } },
        case Truncate -> { if not integer_type(dst) || not integer_type(a) { return invalid(&i) } },
        case BitNot -> { if not arithmetic_type(dst) || a != dst { return invalid(&i) } },
        case Neg -> {
            if not integer_signed(dst) || a != dst { return invalid(&i) }
        },
        case Not -> {
            if dst != ValueType.Bool || a != ValueType.Bool { return invalid(&i) }
        },
        case Eq -> {
            if dst != ValueType.Bool || (not scalar_type(a) && not string_type(a)) || a != b { return invalid(&i) }
        },
        case Ne -> { if dst != ValueType.Bool || (not scalar_type(a) && not string_type(a)) || a != b { return invalid(&i) } },
        case Lt -> {
            if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) }
        },
        case Le -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Gt -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Ge -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Jump -> {
            if i.target < 0 || i.target >= f.code.len() { return invalid(&i) }
        },
        case Branch -> { if i.target < 0 || i.target >= f.code.len() || a != ValueType.Bool { return invalid(&i) } },
        case Call -> {
            if i.target < 0 || i.target >= p.functions.len() { return invalid(&i) }
            let callee = p.functions[i.target].copy()
            let params = try parameter_layout(&p, &callee)
            if i.args.len() != params.len() { return invalid(&i) }
            if callee.result == ValueType.Void {
                if i.dst != -1 { return invalid(&i) }
            } else {
                let result = try value_layout(&p.records, &p.sums, callee.result)
                if not range_matches(&f, i.dst, &result) { return invalid(&i) }
            }
            var n = 0
            while n < i.args.len() {
                if slot_type(&f, i.args[n]) != params[n] { return invalid(&i) }
                n = n + 1
            }
        },
        case Print -> {
            if not printable_type(a) { return invalid(&i) }
        },
        case Panic -> {
            if i.dst != -1 || i.a != -1 || i.b != -1 || i.immediate != 0 || i.target != -1 || i.args.len() != 0 { return invalid(&i) }
        },
        case Return -> {
            if f.result == ValueType.Void {
                if i.a != -1 { return invalid(&i) }
            } else {
                let result = try value_layout(&p.records, &p.sums, f.result)
                if not range_matches(&f, i.a, &result) { return invalid(&i) }
            }
        }
    }
    return
}

func check_binary(i: &Instruction, dst: ValueType, a: ValueType, b: ValueType) -> Result<Void, ProtoError> {
    if not arithmetic_type(dst) || a != dst || b != dst { return invalid(&i) }
    return
}

func check_function(p: &Program, f: &FuncIR) -> Result<Void, ProtoError> {
    let params = try parameter_layout(&p, &f)
    let _ = try value_layout(&p.records, &p.sums, f.result)
    if f.code.len() == 0 || f.slots.len() < params.len() {
        return problem("internal prototype error: invalid function", 0, 0)
    }
    var n = 0
    while n < f.slots.len() {
        if not scalar_type(f.slots[n]) && not reference_type(f.slots[n]) && not owning_type(f.slots[n]) { return problem("internal prototype error: non-scalar slot", 0, 0) }
        if n < params.len() && f.slots[n] != params[n] {
            return problem("internal prototype error: parameter slot mismatch", 0, 0)
        }
        n = n + 1
    }
    n = 0
    while n < f.code.len() {
        try check_instruction(&p, &f, &f.code[n]) catch { return error }
        n = n + 1
    }
    var visited = Vector<Bool>()
    n = 0
    while n < f.code.len() { try! visited.push(false) n = n + 1 }
    var pending = Vector<Int>()
    try! pending.push(0)
    while let pc = pending.pop() {
        if pc < 0 || pc >= f.code.len() {
            return problem("internal prototype error: reachable function falloff", 0, 0)
        }
        if not visited[pc] {
            visited.set(pc, true)
            let i = f.code[pc].copy()
            if i.op == Op.Jump || i.op == Op.Branch { try! pending.push(i.target) }
            if i.op != Op.Jump && i.op != Op.Return && i.op != Op.Panic { try! pending.push(pc + 1) }
        }
    }
    return
}

public func verify(program: &Program) -> Result<Void, ProtoError> {
    if program.builder_fail_after < -1 { return problem("invalid builder failure counter", 0, 0) }
    if program.vector_fail_after < -1 { return problem("invalid vector failure counter", 0, 0) }
    if program.alloc_error_record < -1 || program.alloc_error_record >= program.records.len() {
        return problem("invalid AllocError builtin identity", 0, 0)
    }
    if program.alloc_error_record >= 0 {
        let record = program.records[program.alloc_error_record].copy()
        if record.name != "AllocError" || record.field_names.len() != 2 || record.field_types.len() != 2 {
            return problem("invalid AllocError builtin declaration", 0, 0)
        }
        if (record.field_names[0] != "size" || record.field_names[1] != "align" ||
            record.field_types[0] != ValueType.I64 || record.field_types[1] != ValueType.I64) {
            return problem("invalid AllocError builtin declaration", 0, 0)
        }
    }
    try validate_enums(&program.enums)
    try validate_references(&program.references)
    try check_declared_types(&program)
    try validate_sums(&program.records, &program.sums)
    try validate_records(&program.records, &program.sums)
    try validate_vectors(&program.records, &program.sums, &program.vectors)
    if program.main_index < 0 || program.main_index >= program.functions.len() {
        return problem("internal prototype error: missing main", 0, 0)
    }
    let entry = program.functions[program.main_index].copy()
    if entry.result != ValueType.Void || entry.params.len() != 0 {
        return problem("main must take no parameters and return Void", 0, 0)
    }
    var n = 0
    while n < program.functions.len() {
        try check_function(&program, &program.functions[n]) catch { return error }
        n = n + 1
    }
    return
}
