import src.model.*

func slot_type(f: &FuncIR, n: Int) -> ValueType {
    if n < 0 || n >= f.slots.len() { return ValueType.Void }
    return f.slots[n]
}

func invalid(i: &Instruction) -> ProtoError {
    return problem("internal prototype error: invalid instruction", i.line, i.col)
}

func check_type(p: &Program, t: ValueType) -> Result<Void, ProtoError> {
    match t {
        case Enum(index) -> {
            if index < 0 || index >= p.enums.len() { return problem("internal prototype error: invalid enum type index", 0, 0) }
        },
        case Record(index) -> {
            if index < 0 || index >= p.records.len() { return problem("internal prototype error: invalid record type index", 0, 0) }
        },
        case Ref(index) -> {
            if index < 0 || index >= p.references.len() { return problem("internal prototype error: invalid reference type index", 0, 0) }
        },
        case _ -> {}
    }
    return
}

func check_declared_types(p: &Program) -> Result<Void, ProtoError> {
    var n = 0
    while n < p.references.len() {
        try check_type(&p, p.references[n].target)
        n += 1
    }
    n = 0
    while n < p.records.len() {
        let record = p.records[n].copy()
        var e = 0
        while e < p.enums.len() {
            if record.name == p.enums[e].name { return problem("duplicate module type name", record.line, record.col) }
            e += 1
        }
        var field = 0
        while field < record.field_types.len() {
            try check_type(&p, record.field_types[field])
            field += 1
        }
        n += 1
    }
    n = 0
    while n < p.functions.len() {
        let f = p.functions[n].copy()
        try check_type(&p, f.result)
        if reference_type(f.result) { return problem("reference function results are not supported", 0, 0) }
        var word = 0
        while word < f.params.len() {
            try check_type(&p, f.params[word])
            word += 1
        }
        word = 0
        while word < f.slots.len() {
            try check_type(&p, f.slots[word])
            word += 1
        }
        n += 1
    }
    return
}

func parameter_layout(p: &Program, f: &FuncIR) -> Result<Vector<ValueType>, ProtoError> {
    var words = Vector<ValueType>()
    var n = 0
    while n < f.params.len() {
        if f.params[n] == ValueType.Void { return problem("internal prototype error: Void parameter", 0, 0) }
        let layout = try value_layout(&p.records, f.params[n])
        var word = 0
        while word < layout.len() {
            try! words.push(layout[word])
            word += 1
        }
        n += 1
    }
    move words
}

func range_matches(f: &FuncIR, start: Int, layout: &Vector<ValueType>) -> Bool {
    if start < 0 || start > f.slots.len() || layout.len() > f.slots.len() - start { return false }
    var n = 0
    while n < layout.len() {
        if f.slots[start + n] != layout[n] { return false }
        n += 1
    }
    true
}

func check_instruction(p: &Program, f: &FuncIR, i: &Instruction) -> Result<Void, ProtoError> {
    let dst = slot_type(&f, i.dst)
    let a = slot_type(&f, i.a)
    let b = slot_type(&f, i.b)
    match i.op {
        case Const -> {
            if not scalar_type(dst) { return invalid(&i) }
            if dst == ValueType.Bool && i.immediate != 0 && i.immediate != 1 { return invalid(&i) }
            if integer_type(dst) && not integer_canonical(i.immediate, dst) { return invalid(&i) }
            match dst {
                case Enum(index) -> {
                    if i.immediate < 0 || i.immediate >= p.enums[index].cases.len() { return invalid(&i) }
                },
                case _ -> {}
            }
        },
        case Copy -> {
            if reference_type(dst) {
                if not reference_transfer(&p.references, a, dst) { return invalid(&i) }
            } else if (not scalar_type(dst) && not string_type(dst)) || a != dst { return invalid(&i) }
        },
        case StringConst -> {
            if not string_type(dst) || i.immediate < 0 || i.immediate >= p.strings.len() { return invalid(&i) }
        },
        case StringLen -> {
            if not string_type(a) || dst != ValueType.I64 { return invalid(&i) }
        },
        case StringByteAt -> {
            if not string_type(a) || b != ValueType.I64 || dst != ValueType.Byte { return invalid(&i) }
        },
        case StringSlice -> {
            if not string_type(a) || b != ValueType.I64 || not string_type(dst) || i.args.len() != 1 { return invalid(&i) }
            if slot_type(&f, i.args[0]) != ValueType.I64 { return invalid(&i) }
        },
        case Drop -> {
            if not string_type(a) { return invalid(&i) }
        },
        case Addr -> {
            if not reference_type(dst) { return invalid(&i) }
            let target = try reference_target(&p.references, dst)
            let layout = try value_layout(&p.records, target)
            if not range_matches(&f, i.a, &layout) { return invalid(&i) }
        },
        case LoadRef -> {
            if not reference_type(a) { return invalid(&i) }
            let target = try reference_target(&p.references, a)
            let layout = try value_layout(&p.records, target)
            if not range_matches(&f, i.dst, &layout) { return invalid(&i) }
        },
        case StoreRef -> {
            if not reference_mutable(&p.references, a) { return invalid(&i) }
            let target = try reference_target(&p.references, a)
            let layout = try value_layout(&p.records, target)
            if not range_matches(&f, i.b, &layout) { return invalid(&i) }
        },
        case RefField -> {
            if not reference_type(a) || not reference_type(dst) { return invalid(&i) }
            if reference_mutable(&p.references, dst) && not reference_mutable(&p.references, a) { return invalid(&i) }
            let parent = try reference_target(&p.references, a)
            let target = try reference_target(&p.references, dst)
            match parent {
                case Record(index) -> {
                    if i.immediate < 0 || i.immediate >= p.records[index].field_types.len() { return invalid(&i) }
                    if target != p.records[index].field_types[i.immediate] { return invalid(&i) }
                },
                case _ -> { return invalid(&i) }
            }
        },
        case Add -> { try check_binary(&i, dst, a, b) },
        case Sub -> { try check_binary(&i, dst, a, b) },
        case Mul -> { try check_binary(&i, dst, a, b) },
        case Div -> { try check_binary(&i, dst, a, b) },
        case Rem -> { try check_binary(&i, dst, a, b) },
        case WrapAdd -> { try check_binary(&i, dst, a, b) },
        case WrapSub -> { try check_binary(&i, dst, a, b) },
        case WrapMul -> { try check_binary(&i, dst, a, b) },
        case BitAnd -> { try check_binary(&i, dst, a, b) },
        case BitOr -> { try check_binary(&i, dst, a, b) },
        case BitXor -> { try check_binary(&i, dst, a, b) },
        case Shl -> { if not arithmetic_type(dst) || a != dst || not arithmetic_type(b) { return invalid(&i) } },
        case Shr -> { if not arithmetic_type(dst) || a != dst || not arithmetic_type(b) { return invalid(&i) } },
        case Cast -> { if not integer_type(dst) || not integer_type(a) { return invalid(&i) } },
        case Truncate -> { if not integer_type(dst) || not integer_type(a) { return invalid(&i) } },
        case BitNot -> { if not arithmetic_type(dst) || a != dst { return invalid(&i) } },
        case Neg -> {
            if not integer_signed(dst) || a != dst { return invalid(&i) }
        },
        case Not -> {
            if dst != ValueType.Bool || a != ValueType.Bool { return invalid(&i) }
        },
        case Eq -> {
            if dst != ValueType.Bool || (not scalar_type(a) && not string_type(a)) || a != b { return invalid(&i) }
        },
        case Ne -> { if dst != ValueType.Bool || (not scalar_type(a) && not string_type(a)) || a != b { return invalid(&i) } },
        case Lt -> {
            if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) }
        },
        case Le -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Gt -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Ge -> { if dst != ValueType.Bool || not arithmetic_type(a) || b != a { return invalid(&i) } },
        case Jump -> {
            if i.target < 0 || i.target >= f.code.len() { return invalid(&i) }
        },
        case Branch -> { if i.target < 0 || i.target >= f.code.len() || a != ValueType.Bool { return invalid(&i) } },
        case Call -> {
            if i.target < 0 || i.target >= p.functions.len() { return invalid(&i) }
            let callee = p.functions[i.target].copy()
            let params = try parameter_layout(&p, &callee)
            if i.args.len() != params.len() { return invalid(&i) }
            if callee.result == ValueType.Void {
                if i.dst != -1 { return invalid(&i) }
            } else {
                let result = try value_layout(&p.records, callee.result)
                if not range_matches(&f, i.dst, &result) { return invalid(&i) }
            }
            var n = 0
            while n < i.args.len() {
                if slot_type(&f, i.args[n]) != params[n] { return invalid(&i) }
                n = n + 1
            }
        },
        case Print -> {
            if not printable_type(a) { return invalid(&i) }
        },
        case Return -> {
            if f.result == ValueType.Void {
                if i.a != -1 { return invalid(&i) }
            } else {
                let result = try value_layout(&p.records, f.result)
                if not range_matches(&f, i.a, &result) { return invalid(&i) }
            }
        }
    }
    return
}

func check_binary(i: &Instruction, dst: ValueType, a: ValueType, b: ValueType) -> Result<Void, ProtoError> {
    if not arithmetic_type(dst) || a != dst || b != dst { return invalid(&i) }
    return
}

func check_function(p: &Program, f: &FuncIR) -> Result<Void, ProtoError> {
    let params = try parameter_layout(&p, &f)
    let _ = try value_layout(&p.records, f.result)
    if f.code.len() == 0 || f.slots.len() < params.len() {
        return problem("internal prototype error: invalid function", 0, 0)
    }
    var n = 0
    while n < f.slots.len() {
        if not scalar_type(f.slots[n]) && not reference_type(f.slots[n]) && not string_type(f.slots[n]) { return problem("internal prototype error: non-scalar slot", 0, 0) }
        if n < params.len() && f.slots[n] != params[n] {
            return problem("internal prototype error: parameter slot mismatch", 0, 0)
        }
        n = n + 1
    }
    n = 0
    while n < f.code.len() {
        try check_instruction(&p, &f, &f.code[n]) catch { return error }
        n = n + 1
    }
    var visited = Vector<Bool>()
    n = 0
    while n < f.code.len() { try! visited.push(false) n = n + 1 }
    var pending = Vector<Int>()
    try! pending.push(0)
    while let pc = pending.pop() {
        if pc < 0 || pc >= f.code.len() {
            return problem("internal prototype error: reachable function falloff", 0, 0)
        }
        if not visited[pc] {
            visited.set(pc, true)
            let i = f.code[pc].copy()
            if i.op == Op.Jump || i.op == Op.Branch { try! pending.push(i.target) }
            if i.op != Op.Jump && i.op != Op.Return { try! pending.push(pc + 1) }
        }
    }
    return
}

public func verify(program: &Program) -> Result<Void, ProtoError> {
    try validate_enums(&program.enums)
    try validate_references(&program.references)
    try check_declared_types(&program)
    try validate_records(&program.records)
    if program.main_index < 0 || program.main_index >= program.functions.len() {
        return problem("internal prototype error: missing main", 0, 0)
    }
    let entry = program.functions[program.main_index].copy()
    if entry.result != ValueType.Void || entry.params.len() != 0 {
        return problem("main must take no parameters and return Void", 0, 0)
    }
    var n = 0
    while n < program.functions.len() {
        try check_function(&program, &program.functions[n]) catch { return error }
        n = n + 1
    }
    return
}
