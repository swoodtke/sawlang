func builder_ir(out: &var StringBuilder, text: String) {
    try! out.append(text)
}

public func emit_builder_runtime(out: &var StringBuilder, fail_after: Int) {
    builder_ir(&var out, "@.builder_handle_error = private unnamed_addr constant [38 x i8] c\"runtime error: invalid builder handle\\00\"\n")
    builder_ir(&var out, "@.builder_scalar_error = private unnamed_addr constant [30 x i8] c\"runtime error: invalid scalar\\00\"\n")
    builder_ir(&var out, "@.builder_length_error = private unnamed_addr constant [39 x i8] c\"runtime error: builder length overflow\\00\"\n")
    builder_ir(&var out, "@minivm_builder_fail_after = internal global i64 ")
    try! out.append(fail_after)
    builder_ir(&var out, "\n\n")

    builder_ir(&var out, "define internal void @minivm_builder_bad_handle() \{\nentry:\n  call void @minivm_string_fatal(ptr @.builder_handle_error)\n  unreachable\n\}\n\n")
    builder_ir(&var out, "define internal void @minivm_builder_length_overflow() \{\nentry:\n  call void @minivm_string_fatal(ptr @.builder_length_error)\n  unreachable\n\}\n\n")
    builder_ir(&var out, "define internal void @minivm_builder_invalid_scalar() \{\nentry:\n  call void @minivm_string_fatal(ptr @.builder_scalar_error)\n  unreachable\n\}\n\n")

    builder_ir(&var out, "define internal ptr @minivm_builder_new() \{\nentry:\n  %empty = call ptr @minivm_string_new(ptr null, i64 0)\n  ret ptr %empty\n\}\n\n")
    builder_ir(&var out, "define internal ptr @minivm_builder_build(ptr %slot) \{\nentry:\n  %slot_null = icmp eq ptr %slot, null\n  br i1 %slot_null, label %bad, label %load\nload:\n  %value = load ptr, ptr %slot\n  %value_null = icmp eq ptr %value, null\n  br i1 %value_null, label %bad, label %ok\nbad:\n  call void @minivm_builder_bad_handle()\n  unreachable\nok:\n  call void @minivm_string_retain(ptr %value)\n  ret ptr %value\n\}\n\n")

    // The only recoverable allocator in the native builder path.  It installs
    // replacement content after both copies complete, preserving the old value
    // and every retained snapshot on failure.
    builder_ir(&var out, "define internal \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %extra, i64 %extra_len) \{\nentry:\n  %slot_null = icmp eq ptr %slot, null\n  br i1 %slot_null, label %bad, label %load\nload:\n  %old = load ptr, ptr %slot\n  %old_null = icmp eq ptr %old, null\n  br i1 %old_null, label %bad, label %check_extra\nbad:\n  call void @minivm_builder_bad_handle()\n  unreachable\ncheck_extra:\n  %extra_negative = icmp slt i64 %extra_len, 0\n  br i1 %extra_negative, label %overflow, label %empty_check\nempty_check:\n  %empty = icmp eq i64 %extra_len, 0\n  br i1 %empty, label %success_empty, label %length\nlength:\n  %old_len_ptr = getelementptr i64, ptr %old, i64 1\n  %old_len = load i64, ptr %old_len_ptr\n  %old_negative = icmp slt i64 %old_len, 0\n  %old_too_long = icmp sgt i64 %old_len, 9223372036854775791\n  %room = sub i64 9223372036854775791, %old_len\n  %too_long = icmp ugt i64 %extra_len, %room\n  %old_bad = or i1 %old_negative, %old_too_long\n  %bad_length = or i1 %old_bad, %too_long\n  br i1 %bad_length, label %overflow, label %request\noverflow:\n  call void @minivm_builder_length_overflow()\n  unreachable\nrequest:\n  %new_len = add i64 %old_len, %extra_len\n  %size = add i64 %new_len, 16\n  %counter = load i64, ptr @minivm_builder_fail_after\n  %inject = icmp eq i64 %counter, 0\n  br i1 %inject, label %inject_fail, label %allocate\ninject_fail:\n  store i64 -1, ptr @minivm_builder_fail_after\n  br label %failure\nallocate:\n  %header = call ptr @malloc(i64 %size)\n  %alloc_null = icmp eq ptr %header, null\n  br i1 %alloc_null, label %failure, label %copy_old\ncopy_old:\n  store i64 1, ptr %header\n  %new_len_ptr = getelementptr i64, ptr %header, i64 1\n  store i64 %new_len, ptr %new_len_ptr\n  %new_data = getelementptr i8, ptr %header, i64 16\n  %old_data = getelementptr i8, ptr %old, i64 16\n  call ptr @memcpy(ptr %new_data, ptr %old_data, i64 %old_len)\n  %tail = getelementptr i8, ptr %new_data, i64 %old_len\n  call ptr @memcpy(ptr %tail, ptr %extra, i64 %extra_len)\n  %live = load i64, ptr @minivm_string_live\n  %live_next = add i64 %live, 1\n  store i64 %live_next, ptr @minivm_string_live\n  store ptr %header, ptr %slot\n  call void @minivm_string_release(ptr %old)\n  %positive = icmp sgt i64 %counter, 0\n  br i1 %positive, label %decrement, label %success\ndecrement:\n  %counter_next = sub i64 %counter, 1\n  store i64 %counter_next, ptr @minivm_builder_fail_after\n  br label %success\nsuccess_empty:\n  ret \{i64, i64, i64\} \{i64 1, i64 0, i64 0\}\nsuccess:\n  ret \{i64, i64, i64\} \{i64 1, i64 0, i64 0\}\nfailure:\n  %err0 = insertvalue \{i64, i64, i64\} undef, i64 0, 0\n  %err1 = insertvalue \{i64, i64, i64\} %err0, i64 %size, 1\n  %err2 = insertvalue \{i64, i64, i64\} %err1, i64 8, 2\n  ret \{i64, i64, i64\} %err2\n\}\n\n")

    builder_ir(&var out, "define internal \{i64, i64, i64\} @minivm_builder_append_string(ptr %slot, ptr %value) \{\nentry:\n  %null = icmp eq ptr %value, null\n  br i1 %null, label %bad, label %append\nbad:\n  call void @minivm_builder_bad_handle()\n  unreachable\nappend:\n  %len = call i64 @minivm_string_len(ptr %value)\n  %data = getelementptr i8, ptr %value, i64 16\n  %result = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %data, i64 %len)\n  ret \{i64, i64, i64\} %result\n\}\n\n")
    builder_ir(&var out, "define internal \{i64, i64, i64\} @minivm_builder_append_byte(ptr %slot, i64 %value) \{\nentry:\n  %storage = alloca i8\n  %byte = trunc i64 %value to i8\n  store i8 %byte, ptr %storage\n  %result = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %storage, i64 1)\n  ret \{i64, i64, i64\} %result\n\}\n\n")

    // Decimal digits are produced from the unsigned magnitude.  `0 - Int.min`
    // intentionally wraps to 2^63, so Int.min never needs to be negated.
    builder_ir(&var out, "define internal \{i64, i64, i64\} @minivm_builder_append_int(ptr %slot, i64 %value) \{\nentry:\n  %storage = alloca [20 x i8]\n  %negative = icmp slt i64 %value, 0\n  %negated = sub i64 0, %value\n  %magnitude = select i1 %negative, i64 %negated, i64 %value\n  br label %digits\ndigits:\n  %number = phi i64 [%magnitude, %entry], [%quotient, %digit_body]\n  %cursor = phi i64 [20, %entry], [%digit_at, %digit_body]\n  %digit_at = sub i64 %cursor, 1\n  %remainder = urem i64 %number, 10\n  %digit = trunc i64 %remainder to i8\n  %ascii = add i8 %digit, 48\n  %digit_ptr = getelementptr [20 x i8], ptr %storage, i64 0, i64 %digit_at\n  store i8 %ascii, ptr %digit_ptr\n  %quotient = udiv i64 %number, 10\n  %more = icmp ne i64 %quotient, 0\n  br i1 %more, label %digit_body, label %sign\ndigit_body:\n  br label %digits\nsign:\n  br i1 %negative, label %minus, label %append\nminus:\n  %minus_at = sub i64 %digit_at, 1\n  %minus_ptr = getelementptr [20 x i8], ptr %storage, i64 0, i64 %minus_at\n  store i8 45, ptr %minus_ptr\n  br label %append\nappend:\n  %start = phi i64 [%digit_at, %sign], [%minus_at, %minus]\n  %data = getelementptr [20 x i8], ptr %storage, i64 0, i64 %start\n  %len = sub i64 20, %start\n  %result = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %data, i64 %len)\n  ret \{i64, i64, i64\} %result\n\}\n\n")

    builder_ir(&var out, "define internal \{i64, i64, i64\} @minivm_builder_append_scalar(ptr %slot, i64 %scalar) \{\nentry:\n  %negative = icmp slt i64 %scalar, 0\n  %high = icmp sgt i64 %scalar, 1114111\n  %surrogate_low = icmp sge i64 %scalar, 55296\n  %surrogate_high = icmp sle i64 %scalar, 57343\n  %surrogate = and i1 %surrogate_low, %surrogate_high\n  %range_bad = or i1 %negative, %high\n  %bad = or i1 %range_bad, %surrogate\n  br i1 %bad, label %invalid, label %encode\ninvalid:\n  call void @minivm_builder_invalid_scalar()\n  unreachable\nencode:\n  %storage = alloca [4 x i8]\n  %one = icmp ule i64 %scalar, 127\n  br i1 %one, label %encode1, label %check2\nencode1:\n  %p10 = getelementptr [4 x i8], ptr %storage, i64 0, i64 0\n  %b10 = trunc i64 %scalar to i8\n  store i8 %b10, ptr %p10\n  br label %append1\ncheck2:\n  %two = icmp ule i64 %scalar, 2047\n  br i1 %two, label %encode2, label %check3\nencode2:\n  %x20 = lshr i64 %scalar, 6\n  %x21 = and i64 %scalar, 63\n  %b20a = trunc i64 %x20 to i8\n  %b21a = trunc i64 %x21 to i8\n  %b20 = or i8 %b20a, -64\n  %b21 = or i8 %b21a, -128\n  %p20 = getelementptr [4 x i8], ptr %storage, i64 0, i64 0\n  %p21 = getelementptr [4 x i8], ptr %storage, i64 0, i64 1\n  store i8 %b20, ptr %p20\n  store i8 %b21, ptr %p21\n  br label %append2\ncheck3:\n  %three = icmp ule i64 %scalar, 65535\n  br i1 %three, label %encode3, label %encode4\nencode3:\n  %x30 = lshr i64 %scalar, 12\n  %x31s = lshr i64 %scalar, 6\n  %x31 = and i64 %x31s, 63\n  %x32 = and i64 %scalar, 63\n  %b30a = trunc i64 %x30 to i8\n  %b31a = trunc i64 %x31 to i8\n  %b32a = trunc i64 %x32 to i8\n  %b30 = or i8 %b30a, -32\n  %b31 = or i8 %b31a, -128\n  %b32 = or i8 %b32a, -128\n  %p30 = getelementptr [4 x i8], ptr %storage, i64 0, i64 0\n  %p31 = getelementptr [4 x i8], ptr %storage, i64 0, i64 1\n  %p32 = getelementptr [4 x i8], ptr %storage, i64 0, i64 2\n  store i8 %b30, ptr %p30\n  store i8 %b31, ptr %p31\n  store i8 %b32, ptr %p32\n  br label %append3\nencode4:\n  %x40 = lshr i64 %scalar, 18\n  %x41s = lshr i64 %scalar, 12\n  %x41 = and i64 %x41s, 63\n  %x42s = lshr i64 %scalar, 6\n  %x42 = and i64 %x42s, 63\n  %x43 = and i64 %scalar, 63\n  %b40a = trunc i64 %x40 to i8\n  %b41a = trunc i64 %x41 to i8\n  %b42a = trunc i64 %x42 to i8\n  %b43a = trunc i64 %x43 to i8\n  %b40 = or i8 %b40a, -16\n  %b41 = or i8 %b41a, -128\n  %b42 = or i8 %b42a, -128\n  %b43 = or i8 %b43a, -128\n  %p40 = getelementptr [4 x i8], ptr %storage, i64 0, i64 0\n  %p41 = getelementptr [4 x i8], ptr %storage, i64 0, i64 1\n  %p42 = getelementptr [4 x i8], ptr %storage, i64 0, i64 2\n  %p43 = getelementptr [4 x i8], ptr %storage, i64 0, i64 3\n  store i8 %b40, ptr %p40\n  store i8 %b41, ptr %p41\n  store i8 %b42, ptr %p42\n  store i8 %b43, ptr %p43\n  br label %append4\nappend1:\n  %r1 = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %storage, i64 1)\n  ret \{i64, i64, i64\} %r1\nappend2:\n  %r2 = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %storage, i64 2)\n  ret \{i64, i64, i64\} %r2\nappend3:\n  %r3 = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %storage, i64 3)\n  ret \{i64, i64, i64\} %r3\nappend4:\n  %r4 = call \{i64, i64, i64\} @minivm_builder_append_bytes(ptr %slot, ptr %storage, i64 4)\n  ret \{i64, i64, i64\} %r4\n\}\n\n")
}
