public func emit_string_runtime(out: &var StringBuilder) {
    try! out.append("@.string_alloc_error = private unnamed_addr constant [40 x i8] c\"runtime error: string allocation failed\\00\"\n")
    try! out.append("@.string_index_error = private unnamed_addr constant [41 x i8] c\"runtime error: string index out of range\\00\"\n")
    try! out.append("@.string_range_error = private unnamed_addr constant [42 x i8] c\"runtime error: string range out of bounds\\00\"\n")
    try! out.append("@.string_live_error = private unnamed_addr constant [38 x i8] c\"runtime error: live string allocation\\00\"\n")
    try! out.append("@minivm_string_live = internal global i64 0\n")
    try! out.append("\n")
    try! out.append("declare ptr @malloc(i64)\n")
    try! out.append("declare void @free(ptr)\n")
    try! out.append("declare ptr @memcpy(ptr, ptr, i64)\n")
    try! out.append("declare i32 @memcmp(ptr, ptr, i64)\n")
    try! out.append("declare i32 @putchar(i32)\n")
    try! out.append("\n")
    try! out.append("define internal void @minivm_string_fatal(ptr %message) \{\n")
    try! out.append("entry:\n")
    try! out.append("  call i32 @puts(ptr %message)\n")
    try! out.append("  call void @exit(i32 1)\n")
    try! out.append("  unreachable\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal ptr @minivm_string_new(ptr %bytes, i64 %len) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %too_big = icmp ugt i64 %len, 9223372036854775791\n")
    try! out.append("  br i1 %too_big, label %fail, label %allocate\n")
    try! out.append("fail:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_alloc_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("allocate:\n")
    try! out.append("  %size = add i64 %len, 16\n")
    try! out.append("  %header = call ptr @malloc(i64 %size)\n")
    try! out.append("  %null = icmp eq ptr %header, null\n")
    try! out.append("  br i1 %null, label %fail_null, label %init\n")
    try! out.append("fail_null:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_alloc_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("init:\n")
    try! out.append("  store i64 1, ptr %header\n")
    try! out.append("  %lenp = getelementptr i64, ptr %header, i64 1\n")
    try! out.append("  store i64 %len, ptr %lenp\n")
    try! out.append("  %data = getelementptr i8, ptr %header, i64 16\n")
    try! out.append("  %has_bytes = icmp ne i64 %len, 0\n")
    try! out.append("  br i1 %has_bytes, label %copy, label %done\n")
    try! out.append("copy:\n")
    try! out.append("  call ptr @memcpy(ptr %data, ptr %bytes, i64 %len)\n")
    try! out.append("  br label %done\n")
    try! out.append("done:\n")
    try! out.append("  %live = load i64, ptr @minivm_string_live\n")
    try! out.append("  %next = add i64 %live, 1\n")
    try! out.append("  store i64 %next, ptr @minivm_string_live\n")
    try! out.append("  ret ptr %header\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal void @minivm_string_retain(ptr %value) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %null = icmp eq ptr %value, null\n")
    try! out.append("  br i1 %null, label %done, label %retain\n")
    try! out.append("retain:\n")
    try! out.append("  %count = load i64, ptr %value\n")
    try! out.append("  %overflow = icmp eq i64 %count, -1\n")
    try! out.append("  br i1 %overflow, label %fail, label %increment\n")
    try! out.append("fail:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_alloc_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("increment:\n")
    try! out.append("  %next = add i64 %count, 1\n")
    try! out.append("  store i64 %next, ptr %value\n")
    try! out.append("  br label %done\n")
    try! out.append("done:\n")
    try! out.append("  ret void\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal void @minivm_string_release(ptr %value) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %null = icmp eq ptr %value, null\n")
    try! out.append("  br i1 %null, label %done, label %release\n")
    try! out.append("release:\n")
    try! out.append("  %count = load i64, ptr %value\n")
    try! out.append("  %next = sub i64 %count, 1\n")
    try! out.append("  store i64 %next, ptr %value\n")
    try! out.append("  %dead = icmp eq i64 %next, 0\n")
    try! out.append("  br i1 %dead, label %destroy, label %done\n")
    try! out.append("destroy:\n")
    try! out.append("  call void @free(ptr %value)\n")
    try! out.append("  %live = load i64, ptr @minivm_string_live\n")
    try! out.append("  %live_next = sub i64 %live, 1\n")
    try! out.append("  store i64 %live_next, ptr @minivm_string_live\n")
    try! out.append("  br label %done\n")
    try! out.append("done:\n")
    try! out.append("  ret void\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal i64 @minivm_string_len(ptr %value) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %lenp = getelementptr i64, ptr %value, i64 1\n")
    try! out.append("  %len = load i64, ptr %lenp\n")
    try! out.append("  ret i64 %len\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal i1 @minivm_string_eq(ptr %a, ptr %b) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %alen = call i64 @minivm_string_len(ptr %a)\n")
    try! out.append("  %blen = call i64 @minivm_string_len(ptr %b)\n")
    try! out.append("  %same_len = icmp eq i64 %alen, %blen\n")
    try! out.append("  br i1 %same_len, label %compare, label %different\n")
    try! out.append("compare:\n")
    try! out.append("  %adata = getelementptr i8, ptr %a, i64 16\n")
    try! out.append("  %bdata = getelementptr i8, ptr %b, i64 16\n")
    try! out.append("  %cmp = call i32 @memcmp(ptr %adata, ptr %bdata, i64 %alen)\n")
    try! out.append("  %equal = icmp eq i32 %cmp, 0\n")
    try! out.append("  ret i1 %equal\n")
    try! out.append("different:\n")
    try! out.append("  ret i1 false\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal i64 @minivm_string_byte_at(ptr %value, i64 %index) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %len = call i64 @minivm_string_len(ptr %value)\n")
    try! out.append("  %bad = icmp uge i64 %index, %len\n")
    try! out.append("  br i1 %bad, label %fail, label %read\n")
    try! out.append("fail:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_index_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("read:\n")
    try! out.append("  %data = getelementptr i8, ptr %value, i64 16\n")
    try! out.append("  %at = getelementptr i8, ptr %data, i64 %index\n")
    try! out.append("  %byte = load i8, ptr %at\n")
    try! out.append("  %wide = zext i8 %byte to i64\n")
    try! out.append("  ret i64 %wide\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal ptr @minivm_string_slice(ptr %value, i64 %start, i64 %end) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %len = call i64 @minivm_string_len(ptr %value)\n")
    try! out.append("  %reversed = icmp ugt i64 %start, %end\n")
    try! out.append("  %past_end = icmp ugt i64 %end, %len\n")
    try! out.append("  %bad = or i1 %reversed, %past_end\n")
    try! out.append("  br i1 %bad, label %fail, label %copy\n")
    try! out.append("fail:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_range_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("copy:\n")
    try! out.append("  %count = sub i64 %end, %start\n")
    try! out.append("  %data = getelementptr i8, ptr %value, i64 16\n")
    try! out.append("  %at = getelementptr i8, ptr %data, i64 %start\n")
    try! out.append("  %result = call ptr @minivm_string_new(ptr %at, i64 %count)\n")
    try! out.append("  ret ptr %result\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal void @minivm_string_print(ptr %value) \{\n")
    try! out.append("entry:\n")
    try! out.append("  %len = call i64 @minivm_string_len(ptr %value)\n")
    try! out.append("  %data = getelementptr i8, ptr %value, i64 16\n")
    try! out.append("  br label %loop\n")
    try! out.append("loop:\n")
    try! out.append("  %i = phi i64 [0, %entry], [%next, %body]\n")
    try! out.append("  %more = icmp ult i64 %i, %len\n")
    try! out.append("  br i1 %more, label %body, label %newline\n")
    try! out.append("body:\n")
    try! out.append("  %at = getelementptr i8, ptr %data, i64 %i\n")
    try! out.append("  %byte = load i8, ptr %at\n")
    try! out.append("  %wide = zext i8 %byte to i32\n")
    try! out.append("  call i32 @putchar(i32 %wide)\n")
    try! out.append("  %next = add i64 %i, 1\n")
    try! out.append("  br label %loop\n")
    try! out.append("newline:\n")
    try! out.append("  call i32 @putchar(i32 10)\n")
    try! out.append("  ret void\n")
    try! out.append("\}\n")
    try! out.append("\n")
    try! out.append("define internal void @minivm_string_check_live() \{\n")
    try! out.append("entry:\n")
    try! out.append("  %live = load i64, ptr @minivm_string_live\n")
    try! out.append("  %leaked = icmp ne i64 %live, 0\n")
    try! out.append("  br i1 %leaked, label %fail, label %done\n")
    try! out.append("fail:\n")
    try! out.append("  call void @minivm_string_fatal(ptr @.string_live_error)\n")
    try! out.append("  unreachable\n")
    try! out.append("done:\n")
    try! out.append("  ret void\n")
    try! out.append("\}\n")
    try! out.append("\n")
}
