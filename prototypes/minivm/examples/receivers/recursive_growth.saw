struct Pair { left: Int, right: Int }

func descend(depth: Int, value: &var Pair) {
    var pad = Pair(left: depth, right: depth + 1)
    if depth == 0 {
        value.left += pad.left + 40
        value.right += pad.right + 39
        return
    }
    descend(depth - 1, &var value)
}

func main() {
    var value = Pair(left: 1, right: 2)
    descend(40, &var value)
    print(value.left)
    print(value.right)
}
