// TokenKind declaration copied from selfhost/lexer/src/lib.saw.
public enum TokenKind {
    case IntLit,
    case FloatLit,
    case StringLit,
    case InterpString,
    case BoolLit,
    case Ident,
    case Func,
    case Let,
    case Var,
    case If,
    case Else,
    case Guard,
    case Return,
    case True_,
    case False_,
    case Struct,
    case Extension,
    case SelfKw,
    case Init,
    case NoneKw,
    case Enum,
    case Case,
    case Match,
    case While,
    case Break,
    case Continue,
    case Trait,
    case For,
    case In,
    case TypeKw,
    case Extern,
    case As,
    case Try,
    case Catch,
    case Static,
    case Module,
    case Import,
    case Public,
    case Export,
    case Package,
    case Parent,
    case Plus,
    case Minus,
    case Star,
    case Slash,
    case Percent,
    case Eq,
    case Neq,
    case Lt,
    case Gt,
    case Lte,
    case Gte,
    case And,
    case Or,
    case Ampersand,
    case Pipe,
    case Caret,
    case Tilde,
    case WrapAdd,
    case WrapSub,
    case WrapMul,
    case Not_,
    case Move_,
    case Unsafe_,
    case Borrows,
    case Lend,
    case Assign,
    case PlusAssign,
    case MinusAssign,
    case StarAssign,
    case SlashAssign,
    case PercentAssign,
    case AmpAssign,
    case PipeAssign,
    case CaretAssign,
    case ShlAssign,
    case ShrAssign,
    case Question,
    case DoubleQuestion,
    case Exclaim,
    case QuestionDot,
    case DotDot,
    case DotDotEq,
    case Ellipsis,
    case LParen,
    case RParen,
    case LBrace,
    case RBrace,
    case LBracket,
    case RBracket,
    case Comma,
    case Colon,
    case Semicolon,
    case Arrow,
    case Dot,
    case At,
    case HashDirective,
    case DollarParam,
    case Newline,
    case Eof
}

func classify(kind: TokenKind) -> Int {
    match kind {
        case IntLit -> { return 1 },
        case Eof -> { return 2 },
        case _ -> { return 3 }
    }
}

func main() {
    print(classify(TokenKind.IntLit))
    print(classify(TokenKind.Eof))
    print(classify(TokenKind.Ident))
    print(TokenKind.Eof == TokenKind.Eof)
}
