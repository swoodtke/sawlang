func choose() -> Int {
    if false {
        print(4)
    } else if true {
        print(5)
    } else {
        print(99)
    }
    print(6)
    7
}

func main() {
    if false {
        print(1)
    } else if true {
        print(2)
    } else {
        print(99)
    }
    print(3)
    print(choose())
}
