struct ValueBox { value: UInt16 }

func take(value: Int8) { print(value) }
func take_u8(value: UInt8) { print(value) }

func main() {
    let narrow: Int8 = if true { -128 } else { 127 }
    var assigned: UInt32 = 0
    assigned = if false { 1 } else { UInt32.max }
    take(if false { 1 } else { -7 })
    let inferred = if true { 5 } else { 6u8 }
    take_u8(inferred)
    let box = ValueBox(value: if true { 65535 } else { 0 })
    print(narrow)
    print(assigned)
    print(box.value)
}
