import src.model.*
import src.verify.*

func op(kind: Op, dst: Int, a: Int, b: Int, immediate: Int) -> Instruction {
    var result = instruction(kind)
    result.dst = dst
    result.a = a
    result.b = b
    result.immediate = immediate
    move result
}

func valid(p: &Program) -> Bool {
    try verify(&p) catch { return false }
    true
}

func program() -> Program {
    var records = Vector<RecordIR>()
    let names: Vector<String> = ["size", "align"]
    let fields: Vector<ValueType> = [ValueType.I64, ValueType.I64]
    try! records.push(RecordIR(name: "AllocError", field_names: names.copy(),
        field_types: fields.copy(), line: 1, col: 1))
    try! records.push(RecordIR(name: "Other", field_names: names.copy(),
        field_types: fields.copy(), line: 1, col: 1))
    var sums = Vector<SumIR>()
    try! sums.push(SumIR(kind: SumKind.Result, payload: ValueType.Void, error: ValueType.Record(0)))
    try! sums.push(SumIR(kind: SumKind.Result, payload: ValueType.Void, error: ValueType.Record(1)))
    try! sums.push(SumIR(kind: SumKind.Optional, payload: ValueType.Record(0), error: ValueType.Void))
    try! sums.push(SumIR(kind: SumKind.Result, payload: ValueType.I64, error: ValueType.Record(0)))
    var refs = Vector<ReferenceIR>()
    try! refs.push(ReferenceIR(target: ValueType.Builder, mutable: true))
    try! refs.push(ReferenceIR(target: ValueType.Builder, mutable: false))
    try! refs.push(ReferenceIR(target: ValueType.I64, mutable: true))
    let slots: Vector<ValueType> = [ValueType.Builder, ValueType.Ref(0), ValueType.Ref(1),
        ValueType.String, ValueType.I64, ValueType.Byte, ValueType.Bool, ValueType.I64,
        ValueType.I64, ValueType.Ref(2)]
    var code = Vector<Instruction>()
    try! code.push(op(Op.BuilderNew, 0, -1, -1, 0))
    try! code.push(op(Op.Addr, 1, 0, -1, 0))
    try! code.push(op(Op.Addr, 2, 0, -1, 0))
    try! code.push(op(Op.StringConst, 3, -1, -1, 0))
    try! code.push(op(Op.Const, 4, -1, -1, 65))
    try! code.push(op(Op.Const, 5, -1, -1, 65))
    try! code.push(op(Op.BuilderAppendString, 6, 1, 3, 0))
    try! code.push(op(Op.BuilderAppendByte, 6, 1, 5, 0))
    try! code.push(op(Op.BuilderAppendInt, 6, 1, 4, 0))
    try! code.push(op(Op.BuilderAppendScalar, 6, 1, 4, 0))
    try! code.push(op(Op.BuilderBuild, 3, 2, -1, 0))
    try! code.push(op(Op.Drop, -1, 0, -1, 0))
    try! code.push(op(Op.Drop, -1, 3, -1, 0))
    try! code.push(instruction(Op.Return))
    var functions = Vector<FuncIR>()
    try! functions.push(FuncIR(name: "main", params: Vector<ValueType>(), result: ValueType.Void,
        slots: move slots, code: move code))
    Program(strings: ["ab"], records: move records, references: move refs, sums: move sums,
        enums: Vector<EnumIR>(), functions: move functions, main_index: 0,
        alloc_error_record: 0, builder_fail_after: -1)
}

func main() {
    let p = program()
    assert(valid(&p), "all six Builder operations and shared build reference")
    var changed = p.copy()
    changed.functions[0].code[0].dst = 3
    assert(not valid(&changed), "New requires Builder destination")
    changed = p.copy()
    changed.functions[0].code[0].a = 0
    assert(not valid(&changed), "New rejects extraneous operand")
    changed = p.copy()
    changed.functions[0].code[10].a = 1
    assert(valid(&changed), "build permits mutable reference")
    changed = p.copy()
    changed.functions[0].code[10].a = 9
    assert(not valid(&changed), "build rejects reference to wrong nominal target")
    changed = p.copy()
    changed.functions[0].code[10].dst = 0
    assert(not valid(&changed), "build yields String, not Builder")
    changed = p.copy()
    changed.functions[0].code[6].a = 2
    assert(not valid(&changed), "append rejects shared reference")
    changed = p.copy()
    changed.functions[0].code[6].immediate = 1
    assert(not valid(&changed), "same-layout error record is not AllocError")
    changed = p.copy()
    changed.functions[0].code[6].immediate = 2
    assert(not valid(&changed), "append result is not Optional")
    changed = p.copy()
    changed.functions[0].code[6].immediate = 3
    assert(not valid(&changed), "append success must be Void")
    changed = p.copy()
    changed.functions[0].code[6].immediate = Int.max
    assert(not valid(&changed), "append descriptor index is checked")
    changed = p.copy()
    changed.functions[0].code[6].dst = Int.max
    assert(not valid(&changed), "append destination range arithmetic cannot overflow")
    changed = p.copy()
    changed.functions[0].code[6].dst = 8
    assert(not valid(&changed), "append requires full result range")
    changed = p.copy()
    changed.functions[0].code[7].b = 4
    assert(not valid(&changed), "Byte append rejects Int slot")
    changed = p.copy()
    changed.functions[0].code[8].b = 5
    assert(not valid(&changed), "Int append rejects Byte slot")
    changed = p.copy()
    changed.functions[0].code[9].b = 3
    assert(not valid(&changed), "Scalar append rejects String slot")
    changed = p.copy()
    changed.functions[0].code[0] = op(Op.Copy, 0, 0, -1, 0)
    assert(not valid(&changed), "Builder cannot be copied")
    changed = p.copy()
    changed.functions[0].code[0] = op(Op.LoadRef, 0, 1, -1, 0)
    assert(not valid(&changed), "Builder cannot be loaded by value")
    changed = p.copy()
    changed.functions[0].code[0] = op(Op.StoreRef, -1, 1, 0, 0)
    assert(not valid(&changed), "Builder cannot be stored by value")
    changed = p.copy()
    changed.functions[0].params = [ValueType.Builder]
    assert(not valid(&changed), "Builder by-value parameter forbidden")
    changed = p.copy()
    changed.functions[0].result = ValueType.Builder
    assert(not valid(&changed), "Builder return forbidden")
    changed = p.copy()
    changed.records[1].field_types[0] = ValueType.Builder
    assert(not valid(&changed), "Builder record field forbidden")
    changed = p.copy()
    changed.sums[2].payload = ValueType.Builder
    assert(not valid(&changed), "Builder Optional payload forbidden")
    changed = p.copy()
    changed.sums[3].payload = ValueType.Builder
    assert(not valid(&changed), "Builder Result payload forbidden")
    changed = p.copy()
    changed.alloc_error_record = -1
    assert(not valid(&changed), "append needs explicit builtin identity")
    changed = p.copy()
    changed.alloc_error_record = Int.max
    assert(not valid(&changed), "builtin index checked")
    changed = p.copy()
    changed.records[0].field_types[0] = ValueType.Bool
    assert(not valid(&changed), "builtin field layout checked")
    changed = p.copy()
    changed.builder_fail_after = -2
    assert(not valid(&changed), "failure injection configuration checked")
    print("builder verifier contract passed")
}
