// M19 canonical renderer. Assembled after the lexer and M18 parser sources.

enum CanonicalActionKind { case RenderNode, case RenderBlock, case EmitLine }

struct CanonicalAction {
    kind: CanonicalActionKind
    node: Int
    indent: Int
    text: String
    prev: Int
}

func canonical_push(actions: &var Vector<CanonicalAction>, kind: CanonicalActionKind,
                    node: Int, indent: Int, text: String, previous: Int) -> Int {
    let id = actions.len()
    try! actions.push(CanonicalAction(kind: kind, node: node, indent: indent,
                                      text: text, prev: previous))
    id
}

func canonical_line(out: &var StringBuilder, has_line: &var Bool,
                    indent: Int, text: String) {
    if has_line { try! out.append("\n") }
    var i = 0
    while i < indent {
        try! out.append("  ")
        i += 1
    }
    try! out.append(text)
    has_line = true
}

func canonical_suffix_length(text: &String) -> Int {
    let n = text.len()
    if n >= 3 {
        let tail = text.substring(n - 3, n)
        if tail == "i16" || tail == "i32" || tail == "i64" { return 3 }
        if tail == "u16" || tail == "u32" || tail == "u64" { return 3 }
    }
    if n >= 2 {
        let tail = text.substring(n - 2, n)
        if tail == "i8" || tail == "u8" { return 2 }
    }
    0
}

func canonical_digit(byte: Int) -> Int {
    if byte >= 48 && byte <= 57 { return byte - 48 }
    if byte >= 97 && byte <= 102 { return byte - 97 + 10 }
    byte - 65 + 10
}

// Multiply one arbitrary-length decimal string by a small radix and add one
// source digit. No signed machine accumulator ever holds the literal value.
func canonical_decimal_step(decimal: &String, radix: Int, add: Int) -> String {
    var reversed = StringBuilder()
    var carry = add
    var i = decimal.len() - 1
    while i >= 0 {
        let digit = (decimal.byte_at(i) as Int) - 48
        let value = digit * radix + carry
        try! reversed.append("0123456789".substring(value % 10, value % 10 + 1))
        carry = value / 10
        i -= 1
    }
    while carry > 0 {
        try! reversed.append("0123456789".substring(carry % 10, carry % 10 + 1))
        carry = carry / 10
    }
    let backwards = reversed.build()
    var result = StringBuilder()
    i = backwards.len() - 1
    while i >= 0 {
        try! result.append(backwards.substring(i, i + 1))
        i -= 1
    }
    result.build()
}

func canonical_integer(text: &String) -> String {
    let suffix = canonical_suffix_length(&text)
    let end = text.len() - suffix
    var radix = 10
    var start = 0
    if end >= 2 {
        let prefix = text.substring(0, 2)
        if prefix == "0x" {
            radix = 16
            start = 2
        } else if prefix == "0b" {
            radix = 2
            start = 2
        } else if prefix == "0o" {
            radix = 8
            start = 2
        }
    }
    var decimal = "0"
    var i = start
    while i < end {
        let digit = canonical_digit(text.byte_at(i) as Int)
        let next_decimal = canonical_decimal_step(&decimal, radix, digit)
        decimal = next_decimal
        i += 1
    }
    decimal
}

func canonical_function_header(tree: &AstTree, node: &AstNode) -> String {
    var header = StringBuilder()
    try! header.append("Function ")
    try! header.append(node.text)
    try! header.append("(")
    var i = 0
    while i < node.child_count - 2 {
        if i > 0 { try! header.append(", ") }
        let parameter = tree.nodes[tree.children[node.first_child + i]]
        let named_type = tree.nodes[tree.children[parameter.first_child]]
        try! header.append(parameter.text)
        try! header.append(": ")
        try! header.append(named_type.text)
        i += 1
    }
    let return_type = tree.nodes[tree.children[node.first_child + node.child_count - 2]]
    try! header.append(") -> ")
    try! header.append(return_type.text)
    try! header.append(" \{")
    header.build()
}

func canonical_binding_header(tree: &AstTree, node: &AstNode) -> String {
    var header = StringBuilder()
    try! header.append("LetStatement ")
    if node.kind == AstKind.Var { try! header.append("var ") }
    else { try! header.append("let ") }
    try! header.append(node.text)
    if node.child_count == 2 {
        let named_type = tree.nodes[tree.children[node.first_child]]
        try! header.append(": ")
        try! header.append(named_type.text)
    }
    try! header.append(" =")
    header.build()
}

func canonical_leaf_line(node: &AstNode) -> String {
    var line = StringBuilder()
    if node.kind == AstKind.Identifier {
        try! line.append("Identifier(")
        try! line.append(node.text)
        try! line.append(")")
    } else if node.kind == AstKind.IntegerLiteral {
        try! line.append("IntLiteral(")
        try! line.append(canonical_integer(&node.text))
        try! line.append(") : Int")
    } else if node.kind == AstKind.BooleanLiteral {
        try! line.append("BoolLiteral(")
        if node.text == "true" { try! line.append("True") }
        else { try! line.append("False") }
        try! line.append(") : Bool")
    } else {
        try! line.append("StringLiteral(\"")
        var i = 0
        while i < node.text.len() {
            let byte = node.text.byte_at(i) as Int
            if byte == 34 { try! line.append("\\\"") }
            else { try! line.append(node.text.byte_at(i)) }
            i += 1
        }
        try! line.append("\") : String")
    }
    line.build()
}

func canonical_leaf_kind(kind: AstKind) -> Bool {
    if kind == AstKind.Identifier || kind == AstKind.IntegerLiteral { return true }
    kind == AstKind.StringLiteral || kind == AstKind.BooleanLiteral
}

// Precondition: `tree` is the arena returned by parse_ast. Arbitrary fabricated
// arenas are not a supported serialization input.
public func canonical_ast(tree: &AstTree) -> Result<String, AstError> {
    var out = StringBuilder()
    var has_line = false
    var actions = Vector<CanonicalAction>()
    var top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                             tree.root, 0, "", -1)
    while top >= 0 {
        let action = actions[top]
        top = action.prev
        if action.kind == CanonicalActionKind.EmitLine {
            canonical_line(&var out, &var has_line, action.indent, action.text)
        } else {
            let node = tree.nodes[action.node]
            if action.kind == CanonicalActionKind.RenderBlock {
                var i = node.child_count - 1
                while i >= 0 {
                    let child = tree.children[node.first_child + i]
                    top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                         child, action.indent, "", top)
                    i -= 1
                }
            } else if node.kind == AstKind.Program {
                canonical_line(&var out, &var has_line, action.indent, "Program \{")
                top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                     -1, action.indent, "}", top)
                if node.child_count > 0 {
                    top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                         -1, action.indent + 1, "]", top)
                    var i = node.child_count - 1
                    while i >= 0 {
                        let child = tree.children[node.first_child + i]
                        top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                             child, action.indent + 2, "", top)
                        i -= 1
                    }
                    top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                         -1, action.indent + 1, "functions: [", top)
                }
            } else if node.kind == AstKind.Function {
                let header = canonical_function_header(&tree, &node)
                canonical_line(&var out, &var has_line, action.indent, header)
                top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                     -1, action.indent, "}", top)
                let block = tree.children[node.first_child + node.child_count - 1]
                top = canonical_push(&var actions, CanonicalActionKind.RenderBlock,
                                     block, action.indent + 1, "", top)
            } else if node.kind == AstKind.Let || node.kind == AstKind.Var {
                let header = canonical_binding_header(&tree, &node)
                canonical_line(&var out, &var has_line, action.indent, header)
                let initializer = tree.children[node.first_child + node.child_count - 1]
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     initializer, action.indent + 1, "", top)
            } else if node.kind == AstKind.Return {
                if node.child_count == 0 {
                    canonical_line(&var out, &var has_line, action.indent,
                                   "ReturnStatement (void)")
                } else {
                    canonical_line(&var out, &var has_line, action.indent, "ReturnStatement")
                    let child = tree.children[node.first_child]
                    top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                         child, action.indent + 1, "", top)
                }
            } else if node.kind == AstKind.ExpressionStatement {
                canonical_line(&var out, &var has_line, action.indent, "ExpressionStatement")
                let child = tree.children[node.first_child]
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     child, action.indent + 1, "", top)
            } else if node.kind == AstKind.FinalExpression {
                canonical_line(&var out, &var has_line, action.indent, "final_expr:")
                let child = tree.children[node.first_child]
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     child, action.indent + 1, "", top)
            } else if canonical_leaf_kind(node.kind) {
                let line = canonical_leaf_line(&node)
                canonical_line(&var out, &var has_line, action.indent, line)
            } else if node.kind == AstKind.Unary {
                var line = StringBuilder()
                try! line.append("UnaryOp(")
                try! line.append(node.text)
                try! line.append(")")
                canonical_line(&var out, &var has_line, action.indent, line.build())
                let child = tree.children[node.first_child]
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     child, action.indent + 1, "", top)
            } else if node.kind == AstKind.Binary {
                var line = StringBuilder()
                try! line.append("BinaryOp(")
                try! line.append(node.text)
                try! line.append(")")
                canonical_line(&var out, &var has_line, action.indent, line.build())
                let left = tree.children[node.first_child]
                let right = tree.children[node.first_child + 1]
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     right, action.indent + 2, "", top)
                top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                     -1, action.indent + 1, "right:", top)
                top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                     left, action.indent + 2, "", top)
                top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                     -1, action.indent + 1, "left:", top)
            } else if node.kind == AstKind.Call {
                let callee_id = tree.children[node.first_child]
                let callee = tree.nodes[callee_id]
                if callee.kind != AstKind.Identifier {
                    return AstError(message: "canonical FunctionCall requires an Identifier callee",
                                    line: node.line, col: node.col)
                }
                var line = StringBuilder()
                try! line.append("FunctionCall ")
                try! line.append(callee.text)
                try! line.append("()")
                canonical_line(&var out, &var has_line, action.indent, line.build())
                var i = node.child_count - 1
                while i >= 1 {
                    let argument = tree.children[node.first_child + i]
                    top = canonical_push(&var actions, CanonicalActionKind.RenderNode,
                                         argument, action.indent + 2, "", top)
                    var label = StringBuilder()
                    try! label.append("arg[")
                    try! label.append(i - 1)
                    try! label.append("]: ")
                    top = canonical_push(&var actions, CanonicalActionKind.EmitLine,
                                         -1, action.indent + 1, label.build(), top)
                    i -= 1
                }
            } else {
                var message = StringBuilder()
                try! message.append("canonical renderer cannot emit AstKind ")
                try! message.append(ast_kind_name(node.kind))
                try! message.append(" in this position")
                return AstError(message: message.build(), line: node.line, col: node.col)
            }
        }
    }
    return out.build()
}
