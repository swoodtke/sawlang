// OS-divergent socket helpers (design 84/90/117) — macOS.
//
// design 117: the three errno ACCESSORS (errno / errno_would_block /
// errno_connect_state) are gone from the ABI. The host errno -> portable
// SysError mapping now lives behind ONE seam, `__saw_rt_last_syserror()`, which
// reads the calling thread's errno (behind `__error()` on macOS) and returns the
// portable SysError TAG (sawc/rt/ABI.md). The status-carrying OS ops in
// sawc/rt/common/os_ops.saw call it IMMEDIATELY after a failing syscall (nothing
// runs between, so errno is never clobbered), so std never sees a raw errno.
// `sin_set_family` still stamps the OS-divergent sockaddr_in prefix.

extern "C" {
    // errno lives behind __error() on macOS (returns `int*`).
    func __error() -> UnsafePointer<Int32>
}

// The portable SysError tag space (ABI.md). A failing op returns the NEGATED tag.
// A closed named set with frozen numbers is a backed enum, not a family of
// statics (design 153); the fixed-width backing is what pins the values, and the
// tag reaches the seam's `word` return through one `as` at the boundary.
enum SysError: UInt8 {
    case Ok = 0,
    case WouldBlock = 1,
    case InProgress = 2,
    case IsConnected = 3,
    case Interrupted = 4,
    case ConnReset = 5,
    case ConnRefused = 6,
    case ConnAborted = 7,
    case BrokenPipe = 8,
    case NotConnected = 9,
    case NotFound = 10,
    case PermissionDenied = 11,
    case Exists = 12,
    case AddrInUse = 13,
    case Invalid = 14,
    case Exhausted = 15,
    case Other = 16
}

// macOS errno numbers.
static EPERM: Int = 1
static ENOENT: Int = 2
static EINTR: Int = 4
static ENOMEM: Int = 12
static EACCES: Int = 13
static EEXIST: Int = 17
static EINVAL: Int = 22
static ENFILE: Int = 23
static EMFILE: Int = 24
static ENOSPC: Int = 28
static EPIPE: Int = 32
static EAGAIN: Int = 35        // == EWOULDBLOCK
static EINPROGRESS: Int = 36
static EALREADY: Int = 37
static EADDRINUSE: Int = 48
static ECONNABORTED: Int = 53
static ECONNRESET: Int = 54
static EISCONN: Int = 56
static ENOTCONN: Int = 57
static ECONNREFUSED: Int = 61

// sockaddr_in prefix (macOS): { u8 sin_len = 16; u8 sin_family = AF_INET }.
static SIN_LEN: Int8 = 16
static AF_INET: Int8 = 2

// The current thread's errno (sign-extended to a platform word). Private helper.
func errno_value() unsafe -> Int {
    __error()[0] as Int
}

// design 117: map the current errno to a portable SysError tag. Called by the
// common status-carrying OS ops right after a failing syscall.
@export("__saw_rt_last_syserror")
func rt_last_syserror() -> Int {
    let e = errno_value()
    let tag = if e == EAGAIN {
        SysError.WouldBlock
    } else if e == EINPROGRESS || e == EALREADY {
        SysError.InProgress
    } else if e == EISCONN {
        SysError.IsConnected
    } else if e == EINTR {
        SysError.Interrupted
    } else if e == ECONNRESET {
        SysError.ConnReset
    } else if e == ECONNREFUSED {
        SysError.ConnRefused
    } else if e == ECONNABORTED {
        SysError.ConnAborted
    } else if e == EPIPE {
        SysError.BrokenPipe
    } else if e == ENOTCONN {
        SysError.NotConnected
    } else if e == ENOENT {
        SysError.NotFound
    } else if e == EACCES || e == EPERM {
        SysError.PermissionDenied
    } else if e == EEXIST {
        SysError.Exists
    } else if e == EADDRINUSE {
        SysError.AddrInUse
    } else if e == EINVAL {
        SysError.Invalid
    } else if e == EMFILE || e == ENFILE || e == ENOMEM || e == ENOSPC {
        SysError.Exhausted
    } else {
        SysError.Other
    }
    (tag as UInt8) as Int
}

// Stamp the macOS sockaddr_in prefix: sin_len at byte 0, sin_family at byte 1.
// `buf` is a pointer param (the marked unsafe domain), so the byte stores need
// no `unsafe` marker.
@export("__saw_rt_sin_set_family")
func rt_sin_set_family(buf: UnsafePointer<Int8>) unsafe {
    buf[0] = SIN_LEN
    buf[1] = AF_INET
}
