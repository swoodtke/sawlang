// OS-divergent socket helpers (design 84/90/117) — macOS.
//
// design 117: the three errno ACCESSORS (errno / errno_would_block /
// errno_connect_state) are gone from the ABI. The host errno -> portable
// SysError mapping now lives behind ONE seam, `__saw_rt_last_syserror()`, which
// reads the calling thread's errno (behind `__error()` on macOS) and returns the
// portable SysError TAG (sawc/rt/ABI.md). The status-carrying OS ops in
// sawc/rt/common/os_ops.saw call it IMMEDIATELY after a failing syscall (nothing
// runs between, so errno is never clobbered), so std never sees a raw errno.
// `sin_set_family` still stamps the OS-divergent sockaddr_in prefix.
//
// design 234 §2 adds ONE seam beside it — `__saw_rt_last_raw_code()`, the raw
// platform number the classification below folds away. See the comment over
// `RAW_CODE_KEY`; the same block lives in host_linux/net_os.saw.

extern "C" {
    // errno lives behind __error() on macOS (returns `int*`).
    func __error() -> UnsafePointer<Int32>

    // Thread-specific storage for the raw-code slot below. `pthread_key_t` is
    // `unsigned long` on macOS — register-passed and a platform word wide — so
    // the key is modelled as `Int` and `pthread_key_create` is handed a zeroed
    // 8-byte slot to write its bytes into. That is the modelling
    // rt/common/op_budget.saw already uses for the per-thread op budget.
    func pthread_key_create(key: UnsafePointer<Int8>, dtor: UnsafePointer<Int8>) -> Int32
    func pthread_key_delete(key: Int) -> Int32
    func pthread_getspecific(key: Int) -> Int
    func pthread_setspecific(key: Int, value: Int) -> Int32
}

// The portable SysError tag space (ABI.md). A failing op returns the NEGATED tag.
// A closed named set with frozen numbers is a backed enum, not a family of
// statics (design 153); the fixed-width backing is what pins the values, and the
// tag reaches the seam's `word` return through one `as` at the boundary.
enum SysError: UInt8 {
    case Ok = 0,
    case WouldBlock = 1,
    case InProgress = 2,
    case IsConnected = 3,
    case Interrupted = 4,
    case ConnReset = 5,
    case ConnRefused = 6,
    case ConnAborted = 7,
    case BrokenPipe = 8,
    case NotConnected = 9,
    case NotFound = 10,
    case PermissionDenied = 11,
    case Exists = 12,
    case AddrInUse = 13,
    case Invalid = 14,
    case Exhausted = 15,
    case Other = 16,
    // The REMOTE-reach failures (DF-215a). `Other` keeps 16 — the numbers are
    // frozen — so these sit after it rather than beside their neighbours.
    case HostUnreachable = 17,
    case NetUnreachable = 18,
    case TimedOut = 19,
    case HostDown = 20,
    case NetDown = 21
}

// macOS errno numbers.
static EPERM: Int = 1
static ENOENT: Int = 2
static EINTR: Int = 4
static ENOMEM: Int = 12
static EACCES: Int = 13
static EEXIST: Int = 17
static EINVAL: Int = 22
static ENFILE: Int = 23
static EMFILE: Int = 24
static ENOSPC: Int = 28
static EPIPE: Int = 32
static EAGAIN: Int = 35        // == EWOULDBLOCK
static EINPROGRESS: Int = 36
static EALREADY: Int = 37
static EADDRINUSE: Int = 48
static ENETDOWN: Int = 50
static ENETUNREACH: Int = 51
static ECONNABORTED: Int = 53
static ECONNRESET: Int = 54
static EISCONN: Int = 56
static ENOTCONN: Int = 57
static ETIMEDOUT: Int = 60
static ECONNREFUSED: Int = 61
static EHOSTDOWN: Int = 64
static EHOSTUNREACH: Int = 65

// sockaddr_in prefix (macOS): { u8 sin_len = 16; u8 sin_family = AF_INET }.
static SIN_LEN: Int8 = 16
static AF_INET: Int8 = 2

// The current thread's errno (sign-extended to a platform word). Private helper.
func errno_value() unsafe -> Int {
    __error()[0] as Int
}

// design 234 §2: the RAW platform code behind the classification below, kept
// beside the tag.
//
// `rt_last_syserror` folds a whole errno family into one portable tag (EACCES
// and EPERM are both `PermissionDenied`), which throws away the number a log
// wants. The tag still travels in the op's single negated-word return — design
// 117's encoding is untouched — and this slot carries the raw number alongside
// it, stamped in the same statement that classifies. It is NOT the deleted
// `__saw_rt_errno` accessor returning: that one read the live errno global
// whenever std asked, so anything between the failing syscall and the read
// clobbered it (the v1 `tcp_listen` bug — a `close()` between a failed `bind()`
// and the errno read). Nothing can clobber this one; it is frozen at
// classification time and only handed back afterwards.
//
// PER-THREAD, because errno is: a process-global slot would hand one thread's
// refusal to another, and MT TaskGroups classify on several threads at once.
// The storage is pthread thread-specific data for the reason op_budget.saw
// gives — Saw has no thread-local storage — and both encodings are biased by
// one so the all-zero initial state reads as "nothing captured yet".
static RAW_CODE_KEY: Atomic<Int> = Atomic(0)

// The pthread key, created once and published by CAS (op_budget.saw's pattern):
// create, try to publish, and if somebody else won, delete the spare and use
// theirs. Holds `key + 1`, so a genuine key of 0 is not read as "no key yet".
func raw_code_key() unsafe -> Int {
    let cur = RAW_CODE_KEY.load()
    if cur != 0 {
        return cur - 1
    }
    var fresh: Int = 0
    pthread_key_create((&fresh) as UnsafePointer<Int8>, 0 as UnsafePointer<Int8>)
    if RAW_CODE_KEY.compare_exchange(0, fresh + 1) {
        return fresh
    }
    pthread_key_delete(fresh)
    RAW_CODE_KEY.load() - 1
}

func raw_code_store(value: Int) unsafe {
    pthread_setspecific(raw_code_key(), value + 1)
}

@export("__saw_rt_last_raw_code")
func rt_last_raw_code() unsafe -> Int {
    let raw = pthread_getspecific(raw_code_key())
    if raw == 0 {
        return 0
    }
    raw - 1
}

// design 117: map the current errno to a portable SysError tag. Called by the
// common status-carrying OS ops right after a failing syscall.
@export("__saw_rt_last_syserror")
func rt_last_syserror() -> Int {
    let e = errno_value()
    raw_code_store(e)
    let tag = if e == EAGAIN {
        SysError.WouldBlock
    } else if e == EINPROGRESS || e == EALREADY {
        SysError.InProgress
    } else if e == EISCONN {
        SysError.IsConnected
    } else if e == EINTR {
        SysError.Interrupted
    } else if e == ECONNRESET {
        SysError.ConnReset
    } else if e == ECONNREFUSED {
        SysError.ConnRefused
    } else if e == ECONNABORTED {
        SysError.ConnAborted
    } else if e == EPIPE {
        SysError.BrokenPipe
    } else if e == ENOTCONN {
        SysError.NotConnected
    } else if e == ENOENT {
        SysError.NotFound
    } else if e == EACCES || e == EPERM {
        SysError.PermissionDenied
    } else if e == EEXIST {
        SysError.Exists
    } else if e == EADDRINUSE {
        SysError.AddrInUse
    } else if e == EINVAL {
        SysError.Invalid
    } else if e == EMFILE || e == ENFILE || e == ENOMEM || e == ENOSPC {
        SysError.Exhausted
    } else if e == EHOSTUNREACH {
        SysError.HostUnreachable
    } else if e == ENETUNREACH {
        SysError.NetUnreachable
    } else if e == ETIMEDOUT {
        SysError.TimedOut
    } else if e == EHOSTDOWN {
        SysError.HostDown
    } else if e == ENETDOWN {
        SysError.NetDown
    } else {
        SysError.Other
    }
    (tag as UInt8) as Int
}

// Stamp the macOS sockaddr_in prefix: sin_len at byte 0, sin_family at byte 1.
// `buf` is a pointer param (the marked unsafe domain), so the byte stores need
// no `unsafe` marker.
@export("__saw_rt_sin_set_family")
func rt_sin_set_family(buf: UnsafePointer<Int8>) unsafe {
    buf[0] = SIN_LEN
    buf[1] = AF_INET
}
