// std.time clock seams (design 113b) — macOS.
//
// On the 64-bit hosted targets `struct timespec` is { Int64 tv_sec; Int64
// tv_nsec }, which the Saw struct below matches in declaration order.
// CLOCK_MONOTONIC is 6 on macOS and 1 on Linux; that constant is why these
// seams are per-host.

extern "C" {
    func clock_gettime(clk_id: Int32, tp: UnsafePointer<Int8>) -> Int32
}

struct Timespec {
    tv_sec: Int64
    tv_nsec: Int64
}

// CLOCK_MONOTONIC (macOS) / CLOCK_REALTIME.
static CLOCK_MONOTONIC: Int32 = 6
static CLOCK_REALTIME: Int32 = 0

@export("__saw_rt_clock_monotonic_nanos")
func rt_clock_monotonic_nanos() unsafe -> Int64 {
    var ts = Timespec(tv_sec: 0, tv_nsec: 0)
    clock_gettime(CLOCK_MONOTONIC, (&ts) as UnsafePointer<Int8>)
    ts.tv_sec &* (1000000000 as Int64) &+ ts.tv_nsec
}

@export("__saw_rt_unix_timestamp_secs")
func rt_unix_timestamp_secs() unsafe -> Int64 {
    var ts = Timespec(tv_sec: 0, tv_nsec: 0)
    clock_gettime(CLOCK_REALTIME, (&ts) as UnsafePointer<Int8>)
    ts.tv_sec
}
