// Status-carrying OS operations (design 117), authored in Saw.
//
// design 117 deletes the errno accessors from the ABI. Every OS operation std
// used to pair with an errno read is now a runtime function that does the syscall
// and, on failure, returns the NEGATED portable SysError tag (>= 0 = success /
// count; < 0 = -tag). The tag is captured IMMEDIATELY after the failing syscall
// via the host `__saw_rt_last_syserror()` seam — nothing runs between, so errno
// is never clobbered — so std never sees a raw errno again.
//
// These bodies are OS-INDEPENDENT (identical libc calls on macOS + Linux); only
// the host errno->tag mapping (net_os.saw) and `sin_set_family` diverge. Hosted-
// only (libc socket/fs syscalls); a kernel/sos runtime authors its own.

extern "C" {
    func socket(domain: Int32, ty: Int32, protocol: Int32) -> Int32
    func bind(fd: Int32, addr: UnsafePointer<Int8>, len: Int32) -> Int32
    func listen(fd: Int32, backlog: Int32) -> Int32
    func accept(fd: Int32, addr: UnsafePointer<Int8>, len: UnsafePointer<Int32>) -> Int32
    func connect(fd: Int32, addr: UnsafePointer<Int8>, len: Int32) -> Int32
    func getsockname(fd: Int32, addr: UnsafePointer<Int8>, len: UnsafePointer<Int32>) -> Int32
    func read(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func write(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func close(fd: Int32) -> Int32
    // filesystem / environment ops (design 117).
    // `open` is variadic; the mode argument is read only with O_CREAT.
    func open(path: UnsafePointer<Int8>, flags: Int32, ...) -> Int32
    func lseek(fd: Int32, offset: Int64, whence: Int32) -> Int64
    func opendir(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func unlink(path: UnsafePointer<Int8>) -> Int32
    func rename(oldpath: UnsafePointer<Int8>, newpath: UnsafePointer<Int8>) -> Int32
    func mkdir(path: UnsafePointer<Int8>, mode: Int) -> Int32
    func rmdir(path: UnsafePointer<Int8>) -> Int32
    func chdir(path: UnsafePointer<Int8>) -> Int32
    func setenv(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int32) -> Int32
    func unsetenv(name: UnsafePointer<Int8>) -> Int32
    // hostname resolution (design 184). `getaddrinfo` is the platform resolver
    // and is UNBOUNDED — std declares this seam `extern blocking` and the call
    // runs on a worker thread (design 183); the body here is ordinary sync code.
    func getaddrinfo(node: UnsafePointer<Int8>, service: UnsafePointer<Int8>,
                     hints: UnsafePointer<Int8>, res: UnsafePointer<Int8>) -> Int32
    func freeaddrinfo(res: UnsafePointer<Int8>)
    // shim.c: the three `struct addrinfo` / `EAI_*` facts only C can spell (the
    // field ORDER and the failure codes both diverge by host).
    func __saw_ai_next(entry: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func __saw_ai_ipv4(entry: UnsafePointer<Int8>, out: UnsafePointer<UInt32>) -> Int
    func __saw_gai_tag(code: Int) -> Int
    // host seams: the nonblocking-socket helper (shim.c), the sockaddr prefix
    // stamp, and the errno -> portable SysError tag mapper (net_os.saw).
    // The portable open mode -> this host's O_* flag word (shim.c, design 155:
    // the O_* bits are per-host C macros).
    func __saw_open_flags(mode: Int) -> Int
    func __saw_rt_set_nonblocking(fd: Int) -> Int
    func __saw_rt_sin_set_family(buf: UnsafePointer<Int8>)
    func __saw_rt_last_syserror() -> Int
}

// SysError tags this file branches on (the full space is documented in ABI.md).
static SYS_WOULD_BLOCK: Int = 1
static SYS_IN_PROGRESS: Int = 2
static SYS_IS_CONNECTED: Int = 3
static SYS_INVALID: Int = 14
static SYS_OTHER: Int = 16

static AF_INET: Int32 = 2
static SOCK_STREAM: Int32 = 1
static PROTO_DEFAULT: Int32 = 0
static LISTEN_BACKLOG: Int32 = 16
static SOCKADDR_IN_LEN: Int32 = 16
static LOOPBACK_BE: UInt32 = 0x0100007f   // 127.0.0.1, network byte order (LE)

// A typed stack stand-in for `struct sockaddr_in` (16 bytes, natural ABI).
struct SockAddrIn {
    family: UInt16
    port: UInt16
    addr: UInt32
    zero: UInt64
}

// A typed stack stand-in for the HINTS argument of `getaddrinfo` (design 184).
// The first five fields of `struct addrinfo` are identical on macOS and Linux;
// the two pointers after them are `ai_canonname` and `ai_addr` in one order on
// macOS and the other on Linux, which is why the WALK asks shim.c for the
// fields it needs by name. A hints record sets only the prefix and requires the
// rest to be zero, so the divergence never reaches this declaration.
struct AddrInfoHints {
    flags: Int32
    family: Int32
    socktype: Int32
    protocol: Int32
    addrlen: UInt32
    hole: UInt32        // the LP64 alignment hole ahead of the first pointer
    ptr0: UInt64        // ai_canonname / ai_addr, host order of declaration
    ptr1: UInt64        // ai_addr / ai_canonname
    next: UInt64        // ai_next
}

static_assert(sizeof<AddrInfoHints>() == 48,
              "struct addrinfo is 48 bytes on every hosted (LP64) target")

// host-order port -> network byte order (htons). Targets are little-endian.
func htons(port: Int) -> UInt16 {
    (((port & 0xff) << 8) | ((port >> 8) & 0xff)) as UInt16
}

// network byte order UInt16 -> host-order port (ntohs).
func ntohs(net: UInt16) -> Int {
    let v = net as Int
    ((v & 0xff) << 8) | ((v >> 8) & 0xff)
}

// A 127.0.0.1:port sockaddr with the OS-correct family prefix.
func loopback_sockaddr(port: Int) unsafe -> SockAddrIn {
    var sa = SockAddrIn(family: 0 as UInt16, port: htons(port), addr: LOOPBACK_BE, zero: 0 as UInt64)
    __saw_rt_sin_set_family((&sa) as UnsafePointer<Int8>)
    sa
}

// Open a nonblocking listening TCP socket bound to 127.0.0.1:port (0 = ephemeral).
// Returns the listen fd (>= 0) or -tag. errno is captured BEFORE close(), which
// would otherwise clobber it.
@export("__saw_rt_tcp_listen")
func rt_tcp_listen(port: Int) unsafe -> Int {
    let fd = socket(AF_INET, SOCK_STREAM, PROTO_DEFAULT)
    if fd < (0 as Int32) {
        return -__saw_rt_last_syserror()
    }
    let _ = __saw_rt_set_nonblocking(fd as Int)
    var sa = loopback_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    if bind(fd, ap, SOCKADDR_IN_LEN) != (0 as Int32) {
        let e = __saw_rt_last_syserror()
        let _ = close(fd)
        return -e
    }
    if listen(fd, LISTEN_BACKLOG) != (0 as Int32) {
        let e = __saw_rt_last_syserror()
        let _ = close(fd)
        return -e
    }
    fd as Int
}

// The actual local port a (possibly ephemeral) listen fd is bound to.
@export("__saw_rt_tcp_local_port")
func rt_tcp_local_port(fd: Int) unsafe -> Int {
    var sa = SockAddrIn(family: 0 as UInt16, port: 0 as UInt16, addr: 0 as UInt32, zero: 0 as UInt64)
    let ap = (&sa) as UnsafePointer<Int8>
    var len: Int32 = SOCKADDR_IN_LEN
    let lp = (&len) as UnsafePointer<Int32>
    let _ = getsockname(fd as Int32, ap, lp)
    ntohs(sa.port)
}

// Nonblocking accept: a nonblocking connection fd (>= 0), or -tag
// (-SYS_WOULD_BLOCK when no client is waiting).
@export("__saw_rt_tcp_accept")
func rt_tcp_accept(listen_fd: Int) unsafe -> Int {
    var sa = SockAddrIn(family: 0 as UInt16, port: 0 as UInt16, addr: 0 as UInt32, zero: 0 as UInt64)
    let ap = (&sa) as UnsafePointer<Int8>
    var len: Int32 = SOCKADDR_IN_LEN
    let lp = (&len) as UnsafePointer<Int32>
    let c = accept(listen_fd as Int32, ap, lp)
    if c >= (0 as Int32) {
        let _ = __saw_rt_set_nonblocking(c as Int)
        return c as Int
    }
    return 0 - __saw_rt_last_syserror()
}

// Start a nonblocking connect to 127.0.0.1:port. Returns a connecting fd (>= 0;
// including the EINPROGRESS "wait for writable" case) or -tag on a real failure.
@export("__saw_rt_tcp_connect_start")
func rt_tcp_connect_start(port: Int) unsafe -> Int {
    let fd = socket(AF_INET, SOCK_STREAM, PROTO_DEFAULT)
    if fd < (0 as Int32) {
        return -__saw_rt_last_syserror()
    }
    let _ = __saw_rt_set_nonblocking(fd as Int)
    var sa = loopback_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    let r = connect(fd, ap, SOCKADDR_IN_LEN)
    if r == (0 as Int32) {
        return fd as Int
    }
    let e = __saw_rt_last_syserror()
    if e == SYS_WOULD_BLOCK || e == SYS_IN_PROGRESS {
        return fd as Int
    }
    let _ = close(fd)
    return 0 - e
}

// Re-issue the nonblocking connect() to learn the true completion state (design
// 90). Returns 0 = connected, -SYS_IN_PROGRESS = still connecting (re-park), or
// -tag = a real failure.
@export("__saw_rt_tcp_connect_check")
func rt_tcp_connect_check(fd: Int, port: Int) unsafe -> Int {
    var sa = loopback_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    let r = connect(fd as Int32, ap, SOCKADDR_IN_LEN)
    if r == (0 as Int32) {
        return 0
    }
    let e = __saw_rt_last_syserror()
    if e == SYS_IS_CONNECTED {
        return 0
    }
    if e == SYS_IN_PROGRESS || e == SYS_WOULD_BLOCK {
        return -SYS_IN_PROGRESS
    }
    return 0 - e
}

// Nonblocking read: byte count (0 = EOF), or -tag (-SYS_WOULD_BLOCK on a would-block).
@export("__saw_rt_tcp_read")
func rt_tcp_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    let n = read(fd as Int32, buf, len)
    if n >= 0 {
        return n
    }
    return 0 - __saw_rt_last_syserror()
}

// Nonblocking write: bytes written (may be < len), or -tag.
@export("__saw_rt_tcp_write")
func rt_tcp_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    let n = write(fd as Int32, buf, len)
    if n >= 0 {
        return n
    }
    return 0 - __saw_rt_last_syserror()
}

// Resolve `host` to IPv4 addresses, writing up to `max` of them (in network
// byte order, ready for `sockaddr_in.sin_addr`) to `out`. Returns the COUNT
// written — `0` when the resolver succeeded and offered no IPv4 address — or
// `-tag` when it failed.
//
// UNBOUNDED: `getaddrinfo` may consult /etc/hosts, mDNS, LDAP and the network,
// and answers in anything from microseconds to a DNS timeout. std declares this
// seam `extern blocking`, so the call runs on a worker thread and the calling
// task parks (design 183/184); the body itself is ordinary sync code, as every
// seam body must be. `host` and `out` point into the parked task's frame or the
// heap and stay valid for the whole call — design 183's pointer rule.
@export("__saw_rt_resolve_ipv4")
func rt_resolve_ipv4(host: UnsafePointer<Int8>, out: UnsafePointer<UInt32>, max: Int) unsafe -> Int {
    if max <= 0 {
        return 0 - SYS_INVALID
    }
    var hints = AddrInfoHints(flags: 0 as Int32, family: AF_INET,
                              socktype: SOCK_STREAM, protocol: PROTO_DEFAULT,
                              addrlen: 0 as UInt32, hole: 0 as UInt32,
                              ptr0: 0 as UInt64, ptr1: 0 as UInt64,
                              next: 0 as UInt64)
    var head = 0 as UnsafePointer<Int8>
    let rc = getaddrinfo(host, 0 as UnsafePointer<Int8>,
                         (&hints) as UnsafePointer<Int8>,
                         (&head) as UnsafePointer<Int8>)
    if rc != (0 as Int32) {
        // EAI_SYSTEM answers 0: its cause is in errno, read on the next line
        // with nothing in between (the design-117 discipline).
        var tag = __saw_gai_tag(rc as Int)
        if tag == 0 {
            tag = __saw_rt_last_syserror()
        }
        if tag == 0 {
            tag = SYS_OTHER
        }
        return 0 - tag
    }
    // getaddrinfo answering 0 guarantees a non-empty list, so the head is a real
    // entry; only `ai_next` can be absent.
    var cur: UnsafePointer<Int8>? = head
    var found = 0
    while found < max {
        guard let entry = cur else { break }
        var one = 0 as UInt32
        if __saw_ai_ipv4(entry, (&one) as UnsafePointer<UInt32>) != 0 {
            out[found] = one
            found = found + 1
        }
        cur = __saw_ai_next(entry)
    }
    freeaddrinfo(head)
    found
}

// =============================================================================
// Filesystem / environment status ops (design 117). Each does its libc call and
// returns 0 on success or the NEGATED SysError tag on failure — the tag captured
// right after the failing call, so std sees a tag, never a raw errno.
// =============================================================================

// design 132 unit G: the file-I/O half of the same convention. `open`/`read`/
// `write`/`lseek` used to be bare libc calls in std, where the failure cause was
// unreadable — errno is runtime-internal — so std could only answer `None`. Each
// returns its natural non-negative result (fd, byte count, offset) or -tag.

// `mode` is the PORTABLE open mode (rt/ABI.md), not a POSIX flag word: the
// `O_*` bits are per-host macros, so only C can spell them and only the shim
// can see <fcntl.h> (design 155). `perm` is the creation permission, read by
// the kernel only when the mode creates.
@export("__saw_rt_fs_open")
func rt_fs_open(path: UnsafePointer<Int8>, mode: Int, perm: Int) unsafe -> Int {
    let flags = __saw_open_flags(mode)
    if flags < 0 {
        return 0 - SYS_INVALID
    }
    let fd = open(path, flags as Int32, perm)
    if fd >= (0 as Int32) {
        return fd as Int
    }
    return 0 - __saw_rt_last_syserror()
}

@export("__saw_rt_fs_read")
func rt_fs_read(fd: Int, buf: UnsafePointer<Int8>, count: Int) unsafe -> Int {
    let n = read(fd as Int32, buf, count)
    if n >= 0 {
        return n
    }
    return 0 - __saw_rt_last_syserror()
}

@export("__saw_rt_fs_write")
func rt_fs_write(fd: Int, buf: UnsafePointer<Int8>, count: Int) unsafe -> Int {
    let n = write(fd as Int32, buf, count)
    if n >= 0 {
        return n
    }
    return 0 - __saw_rt_last_syserror()
}

// lseek's success value is an OFFSET, which can legitimately exceed the tag
// space, so a negative result is the only failure signal — as it is for lseek
// itself. The tag rides back the same way.
@export("__saw_rt_fs_lseek")
func rt_fs_lseek(fd: Int, offset: Int, whence: Int) unsafe -> Int {
    let pos = lseek(fd as Int32, offset as Int64, whence as Int32)
    if pos >= (0 as Int64) {
        return pos as Int
    }
    return 0 - __saw_rt_last_syserror()
}

// opendir yields a DIR* and cannot fold a tag into its return, so the status
// goes to an out-parameter: 0 on success, the (positive) tag on failure. The
// pointer is returned raw — an exported return may not be optional, so the
// caller's `extern` declaration does the `?`-wrapping (design 113b).
@export("__saw_rt_fs_opendir")
func rt_fs_opendir(path: UnsafePointer<Int8>, status_out: UnsafePointer<Int>) unsafe -> UnsafePointer<Int8> {
    if let dir = opendir(path) {
        status_out[0] = 0
        return dir
    }
    status_out[0] = __saw_rt_last_syserror()
    return 0 as UnsafePointer<Int8>
}

@export("__saw_rt_fs_unlink")
func rt_fs_unlink(path: UnsafePointer<Int8>) unsafe -> Int {
    if unlink(path) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_fs_rename")
func rt_fs_rename(oldpath: UnsafePointer<Int8>, newpath: UnsafePointer<Int8>) unsafe -> Int {
    if rename(oldpath, newpath) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_fs_mkdir")
func rt_fs_mkdir(path: UnsafePointer<Int8>, mode: Int) unsafe -> Int {
    if mkdir(path, mode) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_fs_rmdir")
func rt_fs_rmdir(path: UnsafePointer<Int8>) unsafe -> Int {
    if rmdir(path) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_fs_chdir")
func rt_fs_chdir(path: UnsafePointer<Int8>) unsafe -> Int {
    if chdir(path) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_env_set")
func rt_env_set(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int) unsafe -> Int {
    if setenv(name, value, overwrite as Int32) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}

@export("__saw_rt_env_unset")
func rt_env_unset(name: UnsafePointer<Int8>) unsafe -> Int {
    if unsetenv(name) == (0 as Int32) {
        0
    } else {
        0 - __saw_rt_last_syserror()
    }
}
