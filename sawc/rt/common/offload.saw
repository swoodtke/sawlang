// Blocking-extern offload seams (design 103 / 113b / 183), authored in Saw.
//
// A blocking FFI call inside a suspending task is offloaded to a thread-per-call
// (v1) so the cooperative reactor thread never blocks; the task parks on the
// job's self-pipe like any socket read. A job is a 48-byte heap record shared
// with the C offload thread thunk (sawc/rt/shim.c — DF-113b, the thunk CALLS a
// raw C function pointer). Single-owner discipline: `start` owns the job -> the
// thread fills it -> `take` joins the thread (a full happens-before barrier)
// then reads/closes/frees. `done` is atomic (release-published by the thread,
// acquire-observed here — Atomic<Int> is seq_cst, stronger and equivalent).
//
// Design 183: the word the thread passes `fn` is a pointer to the call's
// ARGUMENT SLOTS, one per parameter, and `fn` is a compiler-synthesized thunk
// that reads them back at their declared types. The slots are copied into a
// heap block the job OWNS, because the worker reads them long after `start`
// returned and the caller's copy may be a stack temporary.

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>
    func free(ptr: UnsafePointer<Int8>)
    func pipe(fds: UnsafePointer<Int8>) -> Int32
    func close(fd: Int32) -> Int32
    // thread wrappers (design 117: join is Saw; spawn is shim — DF-113b).
    func __saw_rt_thread_spawn(entry: UnsafePointer<Int8>, env: UnsafePointer<Int8>) -> Int
    func __saw_rt_thread_join(handle: Int)
    func __saw_rt_sleep_ns(ns: UInt64)
    // The offload thread thunk's address (shim). Saw cannot name a C function
    // pointer, so the shim exposes it as an opaque pointer for pthread_create.
    func __saw_offload_thread_ptr() -> UnsafePointer<Int8>
}

// MUST match `struct saw_offload_job` in shim.c (sizeof == 48). The layout is
// declaration-order natural ABI: fn@0, args@8, result@16, done@24, pipe_r@32,
// pipe_w@36, thread@40.
struct Job {
    fn: Int
    args: Int
    result: Int
    done: Atomic<Int>
    pipe_r: Int32
    pipe_w: Int32
    thread: Int
}

// Move-only, because the `done` field is an `Atomic` (design 202). A job is
// never held by value anywhere: `start` mallocs one and every seam below
// reaches it through an `UnsafePointer<Job>`, which is the single-owner
// discipline the header describes.
extension Job: NoCopy {}

static NANOS_PER_MILLI: UInt64 = 1000000

// pipe() writes fds[0]=read, fds[1]=write into two adjacent Int32s.
struct PipeFds {
    r: Int32
    w: Int32
}

static_assert(sizeof<Job>() == 48, "offload Job layout must match shim.c")

// Copy `argc` argument slots out of the caller's storage into a block the job
// owns. The worker reads them on its own thread, at a time this call cannot
// bound, so borrowing the caller's array would be a dangling read; `take` frees
// the copy. Zero arguments allocate nothing and the thunk gets a null pointer.
func copy_arg_slots(argp: Int, argc: Int) unsafe -> Int {
    if argc <= 0 {
        return 0
    }
    let src = argp as UnsafePointer<Int64>
    let dst = malloc(argc * sizeof<Int64>()) as UnsafePointer<Int64>
    var i = 0
    while i < argc {
        dst[i] = src[i]
        i = i + 1
    }
    dst as Int
}

@export("__saw_rt_offload_start")
func rt_offload_start(fn: Int, argp: Int, argc: Int) unsafe -> Int {
    let raw = malloc(sizeof<Job>())
    let p = raw as UnsafePointer<Job>
    p[0].fn = fn
    p[0].args = copy_arg_slots(argp, argc)
    p[0].result = 0
    p[0].done.store(0)
    // pipe into a local pair, then copy the two fds into the job record.
    var fds = PipeFds(r: 0, w: 0)
    pipe((&fds) as UnsafePointer<Int8>)
    p[0].pipe_r = fds.r
    p[0].pipe_w = fds.w
    // Spawn the C thunk; store the returned OS thread handle in the job (design 117).
    let thunk = __saw_offload_thread_ptr()
    p[0].thread = __saw_rt_thread_spawn(thunk, raw)
    raw as Int
}

@export("__saw_rt_offload_done")
func rt_offload_done(job: Int) unsafe -> Int {
    let p = job as UnsafePointer<Job>
    p[0].done.load()
}

@export("__saw_rt_offload_pipe_fd")
func rt_offload_pipe_fd(job: Int) unsafe -> Int {
    let p = job as UnsafePointer<Job>
    p[0].pipe_r as Int
}

@export("__saw_rt_offload_take")
func rt_offload_take(job: Int) unsafe -> Int {
    let raw = job as UnsafePointer<Int8>
    let p = job as UnsafePointer<Job>
    // Join (full barrier -> the thread's stores are visible) then read + free.
    // The join is what makes freeing the argument slots safe: the worker is done
    // reading them, cancelled caller or not.
    __saw_rt_thread_join(p[0].thread)
    let result = p[0].result
    close(p[0].pipe_r)
    close(p[0].pipe_w)
    if p[0].args != 0 {
        free(p[0].args as UnsafePointer<Int8>)
    }
    free(raw)
    result
}

// The reference blocking primitive: a real thread-blocking sleep returning its
// argument — the offload path + its tests exercise it via a `blocking func`.
// It keeps its millisecond argument: it stands in for an arbitrary blocking C
// call, and a C call is whatever shape it is.
@export("__saw_rt_blocking_sleep")
func rt_blocking_sleep(ms: Int) -> Int {
    if ms > 0 {
        __saw_rt_sleep_ns((ms as UInt64) * NANOS_PER_MILLI)
    }
    ms
}
