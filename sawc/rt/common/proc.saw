// Process spawn seams (design 122 unit C), authored in Saw.
//
// `std.process.Command` used to concatenate its arguments into ONE string and
// hand it to `system()`, so every argument was re-split by the shell and any
// metacharacter in it executed (`arg("; rm -rf ~")`). These seams replace that
// with a real argv spawn: the caller passes a NULL-terminated `char**` and the
// child is `execvp`'d directly — no shell is involved at any point, and one
// element of the array is exactly one argument no matter what bytes it holds.
//
// The shape mirrors the offload family: `spawn` returns an opaque JOB handle (a
// heap record owning the child's pid and, when capturing, the read end of its
// stdout pipe); `read_stdout` drains that pipe; `try_wait` reaps the child,
// releases the record and returns the RAW POSIX wait status (which std decodes —
// a signal death must not read as exit 0). Single-owner discipline: spawn creates
// the job, the reap destroys it.
//
// THE WAIT IS ZERO-THREAD (design 182). `try_wait` is `waitpid(WNOHANG)`, so it
// answers `-WouldBlock` while the child is alive rather than sleeping; a caller
// that has to wait asks for a DESCRIPTOR instead, and `wait_fd` hands back one
// that goes readable when the child exits, so a cooperative task parks it on the
// reactor exactly as it parks a socket. That descriptor is the ONE host-divergent
// piece (`__saw_rt_proc_exit_fd`, host_macos/host_linux); everything else in this
// file is identical POSIX on both hosts, as is the errno->tag mapping behind
// `__saw_rt_last_syserror`.
//
// `read_stdout` is the one seam here that still blocks the calling thread, and
// it has to: a pipe read has nothing else to be. std declares it `blocking`, so
// design 183's machinery runs it on a worker thread while the task parks — which
// is what closed the drain half of DF-181a (design 187 unit 11) and let the v1
// blocking reap `__saw_rt_proc_wait` be deleted outright.
//
// A kernel/sos runtime authors its own bodies for these names.

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>
    func free(ptr: UnsafePointer<Int8>)
    func pipe(fds: UnsafePointer<Int8>) -> Int32
    func close(fd: Int32) -> Int32
    func read(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func dup2(oldfd: Int32, newfd: Int32) -> Int32
    func fork() -> Int32
    func execvp(file: UnsafePointer<Int8>, argv: UnsafePointer<Int8>) -> Int32
    func _exit(code: Int32)
    func waitpid(pid: Int32, status: UnsafePointer<Int32>, options: Int32) -> Int32
    func __saw_rt_last_syserror() -> Int
    // The host-divergent child-exit descriptor (host_macos/host_linux
    // proc_wait.saw).
    func __saw_rt_proc_exit_fd(pid: Int) -> Int

    // The process environment (design 155). Saw cannot name a C global, so the
    // two accessors live in shim.c under DF-113a; see the comment there for why
    // the child sets `environ` rather than calling `execve`.
    func __saw_environ_get() -> UnsafePointer<UnsafePointer<Int8>>
    func __saw_environ_set(env: UnsafePointer<UnsafePointer<Int8>>)
}

// SysError tags this file branches on (the full space is in ABI.md).
static SYS_WOULD_BLOCK: Int = 1
static SYS_INTERRUPTED: Int = 4
static SYS_EXHAUSTED: Int = 15

// waitpid(2)'s "do not block" option — 1 on both hosts.
static WNOHANG: Int32 = 1

// `=`, the byte that ends the NAME of a `NAME=VALUE` environment entry.
static EQUALS_BYTE: Int8 = 61
// The null `char**`, as a word. Passed AS an environment it means "leave the
// child's `environ` alone"; returned BY `merge_environ` it means the array
// allocation was refused.
static NULL_ENVP: Int = 0

static STDOUT_FILENO: Int32 = 1
static STDERR_FILENO: Int32 = 2
// POSIX shell convention for "command not found / could not exec": the child
// that fails to exec exits 127, which std maps back to a launch failure.
static EXEC_FAILED_STATUS: Int32 = 127
static NO_FD: Int32 = -1

// The spawn `flags` word, one bit per redirection (ABI.md). `1` alone is what
// the capture flag has always meant, so nothing that predates the bits changes.
static FLAG_CAPTURE_STDOUT: Int = 1
static FLAG_MERGE_STDERR: Int = 2

// pipe() writes fds[0]=read, fds[1]=write into two adjacent Int32s.
struct PipeFds {
    r: Int32
    w: Int32
}

// The opaque job record handed back to std as a word.
struct ProcJob {
    pid: Int32
    stdout_fd: Int32   // the read end when capturing, NO_FD otherwise
    // The child-exit descriptor, acquired on the first `wait_fd` call and owned
    // by the job from then on. NO_FD until someone asks (a spawn nobody waits on
    // costs no descriptor) and NO_FD again if the host refuses to hand one out.
    wait_fd: Int32
}

// Close whichever descriptors this job still owns. Idempotent: each is stamped
// back to NO_FD, so the reap path and the abandon path cannot double-close.
func proc_job_close(p: UnsafePointer<ProcJob>) unsafe sync {
    let sfd = p[0].stdout_fd
    if sfd >= (0 as Int32) {
        let _ = close(sfd)
        p[0].stdout_fd = NO_FD
    }
    let wfd = p[0].wait_fd
    if wfd >= (0 as Int32) {
        let _ = close(wfd)
        p[0].wait_fd = NO_FD
    }
}

// Does the `NAME=VALUE` entry `entry` name the same variable as the override
// `spec` (also `NAME=VALUE`)? Only the NAME is compared — the bytes up to the
// override's `=` — so `PATH=/bin` and `PATHOLOGY=x` do not collide.
func same_env_name(entry: UnsafePointer<Int8>, spec: UnsafePointer<Int8>) unsafe sync -> Bool {
    var i = 0
    var same = false
    var scanning = true
    while scanning {
        let s = spec[i]
        let e = entry[i]
        if s == EQUALS_BYTE {
            // The override's NAME ends here, so the entry's must end here too.
            same = e == EQUALS_BYTE
            scanning = false
        } else if s == (0 as Int8) || e != s {
            // A spec with no `=` names no variable (std never builds one), and
            // any differing byte — the entry's own NUL included — decides it.
            scanning = false
        } else {
            i = i + 1
        }
    }
    same
}

// The child's environment: the parent's, with every `NAME=VALUE` in `overrides`
// replacing the entry of that name (appended when the parent had none).
//
// Returns a malloc'd NULL-terminated array as a word, or NULL_ENVP when the
// allocation was refused. The slots BORROW strings from two places — the
// parent's own `environ` and the caller's `overrides` array — so the result is
// valid only while both are, which is exactly the fork-then-exec window it
// exists for. The ARRAY is the caller's to free; the strings are not.
//
// This runs in the PARENT, before the fork, because it allocates: everything
// the child then does with the result is a pointer store.
func merge_environ(overrides: UnsafePointer<UnsafePointer<Int8>>) unsafe -> Int {
    let parent = __saw_environ_get()
    var n_over = 0
    while (overrides[n_over] as Int) != 0 {
        n_over = n_over + 1
    }
    var n_parent = 0
    while (parent[n_parent] as Int) != 0 {
        n_parent = n_parent + 1
    }

    let slot = sizeof<UnsafePointer<Int8>>()
    let raw = malloc((n_parent + n_over + 1) * slot)
    if (raw as Int) == NULL_ENVP {
        return NULL_ENVP
    }
    let out = raw as UnsafePointer<UnsafePointer<Int8>>

    var w = 0
    var i = 0
    while i < n_parent {
        let entry = parent[i]
        var overridden = false
        var k = 0
        while k < n_over {
            if same_env_name(entry, overrides[k]) {
                overridden = true
            }
            k = k + 1
        }
        if not overridden {
            out[w] = entry
            w = w + 1
        }
        i = i + 1
    }
    var j = 0
    while j < n_over {
        out[w] = overrides[j]
        w = w + 1
        j = j + 1
    }

    // Terminate with a NULL pointer, written as a slot of zero bytes (there is
    // no null-pointer literal, and the element type is not optional).
    let bytes = raw as UnsafePointer<Int8>
    let end = w * slot
    var b = 0
    while b < slot {
        bytes[end + b] = 0 as Int8
        b = b + 1
    }
    raw as Int
}

// The spawn body both seams share. `envp` is NULL_ENVP to inherit the parent
// environment, or a merged `char**` as a word — the child points `environ` at
// it just before `execvp`, which is what a portable `execvpe` does and the only
// way to choose the environment without giving up the PATH search.
func proc_spawn_impl(path: UnsafePointer<Int8>, argv: UnsafePointer<Int8>, envp: Int, flags: Int) unsafe -> Int {
    let capture = flags & FLAG_CAPTURE_STDOUT
    let merge_stderr = flags & FLAG_MERGE_STDERR

    var fds = PipeFds(r: NO_FD, w: NO_FD)
    if capture != 0 {
        if pipe((&fds) as UnsafePointer<Int8>) != (0 as Int32) {
            return 0 - __saw_rt_last_syserror()
        }
    }

    let pid = fork()
    if pid < (0 as Int32) {
        let e = __saw_rt_last_syserror()
        if capture != 0 {
            let _ = close(fds.r)
            let _ = close(fds.w)
        }
        return 0 - e
    }

    if pid == (0 as Int32) {
        // CHILD. Everything here is async-signal-safe (dup2/close/execvp/_exit),
        // which is the whole contract for the window between fork and exec.
        if capture != 0 {
            let _ = close(fds.r)
            let _ = dup2(fds.w, STDOUT_FILENO)
            if merge_stderr != 0 {
                let _ = dup2(fds.w, STDERR_FILENO)
            }
            let _ = close(fds.w)
        } else if merge_stderr != 0 {
            // Nothing to capture INTO, so the bit means what `2>&1` means: the
            // child's stderr goes wherever its (inherited) stdout goes.
            let _ = dup2(STDOUT_FILENO, STDERR_FILENO)
        }
        if envp != NULL_ENVP {
            __saw_environ_set(envp as UnsafePointer<UnsafePointer<Int8>>)
        }
        let _ = execvp(path, argv)
        // Only reachable when exec FAILED (bad path, not executable, ENOENT).
        _exit(EXEC_FAILED_STATUS)
        return 0
    }

    // PARENT: the write end belongs to the child now.
    if capture != 0 {
        let _ = close(fds.w)
    }
    let raw = malloc(sizeof<ProcJob>())
    let p = raw as UnsafePointer<ProcJob>
    p[0].pid = pid
    p[0].stdout_fd = fds.r
    p[0].wait_fd = NO_FD
    raw as Int
}

// Spawn `path` with `argv` (a NULL-terminated char* array whose [0] is the
// program name, exactly as execvp wants), inheriting this process's
// environment. `flags` is the redirection bit set (ABI.md): bit 0 sends the
// child's stdout into a pipe this job owns, bit 1 sends its stderr wherever its
// stdout goes. Returns the job handle (> 0) or -tag.
@export("__saw_rt_proc_spawn")
func rt_proc_spawn(path: UnsafePointer<Int8>, argv: UnsafePointer<Int8>, flags: Int) unsafe -> Int {
    proc_spawn_impl(path, argv, NULL_ENVP, flags)
}

// The same spawn with environment OVERRIDES (design 155). `envp` is a
// NULL-terminated `NAME=VALUE` array; the child gets this process's environment
// with each of those names set to the given value, and everything else
// inherited. The merge happens here, in the parent, before the fork — the child
// only stores a pointer, which is what keeps the fork-to-exec window
// async-signal-safe in a multi-threaded parent.
@export("__saw_rt_proc_spawn_env")
func rt_proc_spawn_env(path: UnsafePointer<Int8>, argv: UnsafePointer<Int8>, envp: UnsafePointer<Int8>, flags: Int) unsafe -> Int {
    let merged = merge_environ(envp as UnsafePointer<UnsafePointer<Int8>>)
    if merged == NULL_ENVP {
        return 0 - SYS_EXHAUSTED
    }
    let job = proc_spawn_impl(path, argv, merged, flags)
    // The child has its own copy of the array (fork copies the address space),
    // so the parent's is finished with either way.
    free(merged as UnsafePointer<Int8>)
    job
}

// Read up to `len` bytes of the child's captured stdout. Returns the byte count
// (0 = EOF, and 0 immediately for a job spawned without capture) or -tag.
//
// BLOCKS the calling thread until the child writes or closes: the pipe is a
// blocking descriptor, and a child may write nothing for as long as it likes. It
// is std's second `blocking` seam, so the caller is never the executor thread —
// see rt/ABI.md for the contract that puts on an implementer.
@export("__saw_rt_proc_read_stdout")
func rt_proc_read_stdout(job: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    let p = job as UnsafePointer<ProcJob>
    let fd = p[0].stdout_fd
    if fd < (0 as Int32) {
        return 0
    }
    let n = read(fd, buf, len)
    if n >= 0 {
        return n
    }
    0 - __saw_rt_last_syserror()
}

// A descriptor that becomes readable once the child has exited, so a waiting
// task parks on the reactor instead of sitting in `waitpid`. Acquired on first
// ask and cached; the JOB owns it and closes it with the rest of the record.
// Returns the fd or -tag — a caller that cannot get one still has `try_wait`,
// which is the honest degraded path (poll, never block).
@export("__saw_rt_proc_wait_fd")
func rt_proc_wait_fd(job: Int) unsafe -> Int {
    let p = job as UnsafePointer<ProcJob>
    let have = p[0].wait_fd
    if have >= (0 as Int32) {
        return have as Int
    }
    let fd = __saw_rt_proc_exit_fd(p[0].pid as Int)
    if fd < 0 {
        return fd
    }
    p[0].wait_fd = fd as Int32
    fd
}

// Reap the child if it has already exited. Returns the RAW POSIX wait status
// (>= 0, decoded by std — the exit byte and the signal bits both matter),
// `-WouldBlock` while the child is still running, or -tag.
//
// The job is DESTROYED — descriptors closed, record freed — on every answer but
// `-WouldBlock`, which leaves it intact so the caller can park and ask again.
@export("__saw_rt_proc_try_wait")
func rt_proc_try_wait(job: Int) unsafe -> Int {
    let p = job as UnsafePointer<ProcJob>
    var status: Int32 = 0
    let sp = (&status) as UnsafePointer<Int32>
    var tag = 0
    var running = false
    var waiting = true
    while waiting {
        let r = waitpid(p[0].pid, sp, WNOHANG)
        if r > (0 as Int32) {
            waiting = false
        } else if r == (0 as Int32) {
            running = true
            waiting = false
        } else {
            tag = __saw_rt_last_syserror()
            // A signal delivered to US must not lose the child's status.
            if tag != SYS_INTERRUPTED {
                waiting = false
            } else {
                tag = 0
            }
        }
    }
    if running {
        return 0 - SYS_WOULD_BLOCK
    }
    proc_job_close(p)
    free(job as UnsafePointer<Int8>)
    if tag != 0 {
        return 0 - tag
    }
    status as Int
}

// Abandon the job without waiting for the child: close its descriptors and free
// the record. One WNOHANG reap first, so a child that has already exited does not
// linger as a zombie; a child still RUNNING keeps running (design 102 — cancelling
// the wait cancels the WAIT, not the child) and this process never collects it.
@export("__saw_rt_proc_release")
func rt_proc_release(job: Int) unsafe {
    let p = job as UnsafePointer<ProcJob>
    var status: Int32 = 0
    let _ = waitpid(p[0].pid, (&status) as UnsafePointer<Int32>, WNOHANG)
    proc_job_close(p)
    free(job as UnsafePointer<Int8>)
}

// The v1 blocking reap `__saw_rt_proc_wait` lived here until design 187 unit 11.
// It is GONE, not deprecated: `Command.run` parked on `wait_fd` + `try_wait`
// from design 182, `Command.output` joined it once its drain became an offloaded
// `blocking` seam, and a seam with no callers is a seam a new runtime should not
// be asked to write. The blocking `waitpid(pid, &status, 0)` it wrapped is what
// `try_wait` does with `WNOHANG` and a park.
