// The global allocation seams (design 113 / 113b), authored in Saw.
//
// `__saw_rt_alloc`/`__saw_rt_dealloc` are the hosted default allocator: thin
// wrappers over libc malloc/free. `align` is ignored — malloc guarantees an
// alignment of at least alignof(max_align_t) (>= 16 on the hosted targets),
// which covers every Saw allocation. The seams return/free a RAW `i8*` (NULL on
// failure); the optional-wrapping (`UnsafePointer<Int8>?`) is added at the Saw
// call site by std/alloc.saw's `extern` declaration, so the ABI symbol itself
// is a plain pointer (an `@export` return cannot be optional).
//
// ALLOCATION BUDGET (design 123). The three-tier failure policy is only worth
// as much as its tests, and most of std allocates through the GLOBAL allocator
// — `String`, `StringBuilder`, `Data`, `Arc`, `Mutex`, `Channel` take no
// allocator type parameter, so the review's `Vector<T, FailAlloc>` probe
// technique cannot reach them. `__saw_rt_alloc_deny_after(n)` lets the next `n`
// allocations succeed and denies every one after that, so a test can drive any
// OOM path in the library deterministically. It is a facility of the HOSTED
// default allocator only: std never references it (a freestanding runtime need
// not provide the symbol), and a test that wants it declares the `extern`
// itself. Default is inactive, and the inactive cost is one atomic load per
// allocation — noise against malloc.

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>
    func free(ptr: UnsafePointer<Int8>)
}

// Two statics rather than one signed sentinel: a static initializer takes a
// plain literal, so "unlimited" is a separate flag rather than a negative
// budget. ACTIVE = 0 means no limit is in force and BUDGET is not consulted.
static ALLOC_LIMIT_ACTIVE: Atomic<Int> = Atomic(0)
static ALLOC_BUDGET: Atomic<Int> = Atomic(0)

// Permit the next `n` allocations and deny every one after that. Any
// non-negative `n` arms the limit; re-arming resets the budget. A NEGATIVE `n`
// disarms it, so a test can restore ordinary allocation once it has driven the
// failure path it came for.
@export("__saw_rt_alloc_deny_after")
func rt_alloc_deny_after(n: Int) {
    if n < 0 {
        ALLOC_LIMIT_ACTIVE.store(0)
        return
    }
    ALLOC_BUDGET.store(n)
    ALLOC_LIMIT_ACTIVE.store(1)
}

@export("__saw_rt_alloc")
func rt_alloc(size: Int, align: Int) -> UnsafePointer<Int8> {
    if ALLOC_LIMIT_ACTIVE.load() != 0 {
        let left = ALLOC_BUDGET.load()
        if left <= 0 {
            return 0 as UnsafePointer<Int8>
        }
        ALLOC_BUDGET.store(left - 1)
    }
    malloc(size)
}

@export("__saw_rt_dealloc")
func rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int) {
    free(ptr)
}
