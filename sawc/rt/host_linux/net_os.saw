// OS-divergent socket helpers (design 84/90/117) — Linux.
//
// design 117: the errno accessors are gone from the ABI; the host errno ->
// portable SysError mapping lives behind `__saw_rt_last_syserror()` (reads errno
// behind `__errno_location()` on Linux, returns the portable SysError TAG). See
// host_macos/net_os.saw for the shared rationale. The errno VALUES and the
// sockaddr layout are Linux-specific.

extern "C" {
    // errno lives behind __errno_location() on Linux (returns `int*`).
    func __errno_location() -> UnsafePointer<Int32>
}

// The portable SysError tag space (ABI.md). A failing op returns the NEGATED tag.
// A closed named set with frozen numbers is a backed enum, not a family of
// statics (design 153); the fixed-width backing is what pins the values, and the
// tag reaches the seam's `word` return through one `as` at the boundary.
enum SysError: UInt8 {
    case Ok = 0,
    case WouldBlock = 1,
    case InProgress = 2,
    case IsConnected = 3,
    case Interrupted = 4,
    case ConnReset = 5,
    case ConnRefused = 6,
    case ConnAborted = 7,
    case BrokenPipe = 8,
    case NotConnected = 9,
    case NotFound = 10,
    case PermissionDenied = 11,
    case Exists = 12,
    case AddrInUse = 13,
    case Invalid = 14,
    case Exhausted = 15,
    case Other = 16
}

// Linux errno numbers.
static EPERM: Int = 1
static ENOENT: Int = 2
static EINTR: Int = 4
static ENOMEM: Int = 12
static EACCES: Int = 13
static EEXIST: Int = 17
static EINVAL: Int = 22
static ENFILE: Int = 23
static EMFILE: Int = 24
static ENOSPC: Int = 28
static EPIPE: Int = 32
static EAGAIN: Int = 11        // == EWOULDBLOCK
static EADDRINUSE: Int = 98
static ECONNABORTED: Int = 103
static ECONNRESET: Int = 104
static EISCONN: Int = 106
static ENOTCONN: Int = 107
static ECONNREFUSED: Int = 111
static EALREADY: Int = 114
static EINPROGRESS: Int = 115

// sockaddr_in prefix (Linux): { u16 sin_family = AF_INET } (bytes 0-1, LE).
static AF_INET_LO: Int8 = 2
static AF_INET_HI: Int8 = 0

func errno_value() unsafe -> Int {
    __errno_location()[0] as Int
}

// design 117: map the current errno to a portable SysError tag.
@export("__saw_rt_last_syserror")
func rt_last_syserror() -> Int {
    let e = errno_value()
    let tag = if e == EAGAIN {
        SysError.WouldBlock
    } else if e == EINPROGRESS || e == EALREADY {
        SysError.InProgress
    } else if e == EISCONN {
        SysError.IsConnected
    } else if e == EINTR {
        SysError.Interrupted
    } else if e == ECONNRESET {
        SysError.ConnReset
    } else if e == ECONNREFUSED {
        SysError.ConnRefused
    } else if e == ECONNABORTED {
        SysError.ConnAborted
    } else if e == EPIPE {
        SysError.BrokenPipe
    } else if e == ENOTCONN {
        SysError.NotConnected
    } else if e == ENOENT {
        SysError.NotFound
    } else if e == EACCES || e == EPERM {
        SysError.PermissionDenied
    } else if e == EEXIST {
        SysError.Exists
    } else if e == EADDRINUSE {
        SysError.AddrInUse
    } else if e == EINVAL {
        SysError.Invalid
    } else if e == EMFILE || e == ENFILE || e == ENOMEM || e == ENOSPC {
        SysError.Exhausted
    } else {
        SysError.Other
    }
    (tag as UInt8) as Int
}

// Stamp the Linux sockaddr_in prefix: u16 sin_family = AF_INET (little-endian).
@export("__saw_rt_sin_set_family")
func rt_sin_set_family(buf: UnsafePointer<Int8>) unsafe {
    buf[0] = AF_INET_LO
    buf[1] = AF_INET_HI
}
