// `struct dirent` name projection (design 122) — Linux (glibc/musl).
//
// `d_name`'s offset is the host-specific fact this seam needs; see
// host_macos/dirent.saw.
//
// Linux `struct dirent` (64-bit):
//   d_ino    UInt64   @0
//   d_off    Int64    @8
//   d_reclen UInt16   @16
//   d_type   UInt8    @18
//   d_name   Int8[]   @19

static DIRENT_NAME_OFFSET: Int = 19

// The NUL-terminated name inside a `struct dirent` returned by `readdir`.
// `entry` must be non-NULL (std checks readdir's own result first).
@export("__saw_rt_fs_dirent_name")
func rt_fs_dirent_name(entry: UnsafePointer<Int8>) unsafe -> UnsafePointer<Int8> {
    entry + DIRENT_NAME_OFFSET
}
