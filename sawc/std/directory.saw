// Directory - Directory operations for the Saw standard library
// Part of the Saw standard library
//
// Provides directory listing, creation, and manipulation using POSIX system calls.

// =============================================================================
// FFI declarations for directory operations
// =============================================================================

extern "C" {
    // Directory operations
    func opendir(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func readdir(dirp: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func closedir(dirp: UnsafePointer<Int8>) -> Int32

    // Directory manipulation
    func mkdir(path: UnsafePointer<Int8>, mode: Int) -> Int32
    func rmdir(path: UnsafePointer<Int8>) -> Int32
    func chdir(path: UnsafePointer<Int8>) -> Int32
    func getcwd(buf: UnsafePointer<Int8>, size: Int) -> UnsafePointer<Int8>?

    // Memory
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Refcounted String runtime (defined by the compiler): copy a C string into
    // an owned String with a proper { refcount, len, bytes } header. A bare
    // `ptr as String` would produce a header-less pointer that corrupts on
    // len()/release.
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// Directory - Static methods for directory operations
// =============================================================================
// Note: Directory is a marker struct for static methods only

struct Directory {
    _unused: Int
}

extension Directory {
    // =========================================================================
    // Directory listing
    // =========================================================================

    // List files in a directory (not including . and ..)
    // Returns a Vector of Paths, or None if directory cannot be opened
    public func list(path: Path) -> Vector<Path>? {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        if let dir = unsafe opendir(path_ptr) {
            var result = Vector<Path>()

            // Read entries until we get None
            var done = false
            while not done {
                if let entry = unsafe readdir(dir) {
                    // On macOS, d_name starts at offset 21 in struct dirent
                    let name_ptr = unsafe entry + 21
                    // Copy the entry's C string into an owned String (the dirent
                    // buffer has no String header and is reused by readdir).
                    let name = __saw_string_from_bytes(name_ptr, strlen(name_ptr))

                    // Skip . and ..
                    let first_char = unsafe name_ptr[0]
                    if first_char == (46 as Int8) {  // '.'
                        let second_char = unsafe name_ptr[1]
                        if second_char == (0 as Int8) {  // "."
                            continue
                        }
                        let third_char = unsafe name_ptr[2]
                        if second_char == (46 as Int8) && third_char == (0 as Int8) {  // ".."
                            continue
                        }
                    }

                    // Create full path by joining with the directory path
                    let full_path = path.join(name)
                    result.push(full_path)
                } else {
                    done = true
                }
            }

            closedir(dir)
            move result
        } else {
            None
        }
    }

    // =========================================================================
    // Directory manipulation
    // =========================================================================

    // Create a directory with default permissions (0755)
    // Returns true if successful
    public func create(path: Path) -> Bool {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        mkdir(path_ptr, 493) == (0 as Int32)  // 0755 = 493 decimal
    }

    // Remove an empty directory
    // Returns true if successful
    public func remove(path: Path) -> Bool {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        rmdir(path_ptr) == (0 as Int32)
    }

    // Check if a path exists (works for both files and directories)
    // Note: Uses access() from file.saw
    public func exists(path: Path) -> Bool {
        let ptr = path.as_str() as UnsafePointer<Int8>
        access(ptr, 0 as Int32) == (0 as Int32)
    }

    // =========================================================================
    // Working directory
    // =========================================================================

    // Get the current working directory
    public func current() -> Path? {
        if let buf = unsafe malloc(1024) {
            if let result = unsafe getcwd(buf, 1024) {
                // Copy into an owned String, then free the scratch buffer.
                let s = __saw_string_from_bytes(result, strlen(result))
                free(buf)
                Path(s: s)
            } else {
                free(buf)
                None
            }
        } else {
            None
        }
    }

    // Change the current working directory
    // Returns true if successful
    public func set_current(path: Path) -> Bool {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        chdir(path_ptr) == (0 as Int32)
    }
}
