//! Directories: listing, creation, removal, and the working directory.
//!
//! ## Timing
//!
//! Same contract as `std.file`, and for the same reason. Every operation here is
//! synchronous and none of them suspends, so the calling thread is inside the
//! system call until it returns. Prompt on a healthy local disk; unbounded on a
//! network filesystem that has stopped answering or a FUSE mount, where a
//! cooperative task that lists a directory holds its executor thread and every
//! sibling task waits behind it. See the `std.file` module documentation for the
//! full statement and the escape hatch.
//!
//! Part of the Saw standard library. POSIX system calls behind the runtime seams.

extern "C" {
    // opendir(3) goes through the seam so its failure cause survives: the tag
    // lands in `status_out`, 0 on success (an exported return may not be
    // optional, so the `?` is declared here). readdir/closedir stay bare:
    // readdir's end-of-stream is not an error and closedir's status is not
    // actionable.
    func __saw_rt_fs_opendir(name: UnsafePointer<Int8>, status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?
    func readdir(dirp: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func closedir(dirp: UnsafePointer<Int8>) -> Int32

    // The name inside a `struct dirent`. `d_name`'s offset differs between
    // hosts (21 on macOS, 19 on Linux), so it lives behind the host split.
    func __saw_rt_fs_dirent_name(entry: UnsafePointer<Int8>) -> UnsafePointer<Int8>

    // Status-carrying: 0 on success, the negated SysError tag on failure.
    func __saw_rt_fs_mkdir(path: UnsafePointer<Int8>, mode: Int) -> Int
    func __saw_rt_fs_rmdir(path: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_chdir(path: UnsafePointer<Int8>) -> Int
    func getcwd(buf: UnsafePointer<Int8>, size: Int) -> UnsafePointer<Int8>?

    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Copies a C string into an owned String with a proper header. A bare
    // `ptr as String` would be header-less and corrupt on len() or release.
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// The first buffer `Directory.current` offers getcwd(2), and the largest it
// will grow to before giving up. The floor is the common PATH_MAX; the ceiling
// is far past any real working directory, and only bounds the retry loop.
static GETCWD_INITIAL_BYTES: Int = 1024
static GETCWD_MAX_BYTES: Int = 1048576

// A namespace for static methods; never constructed.
public struct Directory {
    private _unused: Int
}

extension Directory {
    // List the entries in a directory, excluding `.` and `..`.
    //
    // `Err` carries the errno cause of the failing opendir(3). An empty `Ok`
    // means the directory is empty.
    public static func list(path: Path) unsafe -> Result<Vector<Path>, IoError> {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        var status = 0
        let status_ptr = (&status) as UnsafePointer<Int>
        if let dir = __saw_rt_fs_opendir(path_ptr, status_ptr) {
            var result = Vector<Path>()

            var done = false
            while not done {
                if let entry = readdir(dir) {
                    let name_ptr = __saw_rt_fs_dirent_name(entry)
                    // Copy the entry's C string into an owned String (the dirent
                    // buffer has no String header and is reused by readdir).
                    let name = __saw_string_from_bytes(name_ptr, strlen(name_ptr))

                    let first_char = name_ptr[0]
                    if first_char == (46 as Int8) {  // '.'
                        let second_char = name_ptr[1]
                        if second_char == (0 as Int8) {  // "."
                            continue
                        }
                        let third_char = name_ptr[2]
                        if second_char == (46 as Int8) && third_char == (0 as Int8) {  // ".."
                            continue
                        }
                    }

                    let full_path = path.join(name)
                    // Allocator refusal is `ResourcesExhausted`; the `Err` path
                    // must close the `DIR*` too.
                    match result.push(full_path) {
                        case Ok(_) -> {},
                        case Err(_) -> {
                            closedir(dir)
                            return IoError.of("readdir",
                                              IoErrorKind.ResourcesExhausted)
                        }
                    }
                } else {
                    done = true
                }
            }

            closedir(dir)
            return move result
        }
        return IoError.of("opendir", status)
    }

    // Create a directory with permissions 0755. `Err` carries the errno cause
    // of the failing mkdir(2).
    public static func create(path: Path) unsafe -> Result<Void, IoError> {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_mkdir(path_ptr, 493)   // 0755 = 493 decimal
        if e != 0 {
            return IoError.of("mkdir", -e)
        }
        return
    }

    // Remove an empty directory. `Err` carries the errno cause of the failing
    // rmdir(2).
    public static func remove(path: Path) unsafe -> Result<Void, IoError> {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_rmdir(path_ptr)
        if e != 0 {
            return IoError.of("rmdir", -e)
        }
        return
    }

    // Works for both files and directories. `access` is declared in file.saw.
    public static func exists(path: Path) unsafe -> Bool {
        let ptr = path.as_str() as UnsafePointer<Int8>
        access(ptr, 0 as Int32) == (0 as Int32)
    }

    // Get the current working directory. The buffer grows and the call is
    // retried until the path fits, so a long path comes back whole.
    //
    // `None` means getcwd(2) failed for a reason growing the buffer cannot fix,
    // or the path exceeded `GETCWD_MAX_BYTES`. Allocator exhaustion panics
    // rather than joining that `None`.
    //
    // errno is runtime-internal (rt/ABI.md) and this is a bare libc call, so
    // the retry cannot tell ERANGE from a real failure; a failure such as
    // EACCES costs a few doublings before `None`.
    public static func current() unsafe -> Path? {
        var cap = GETCWD_INITIAL_BYTES
        while cap <= GETCWD_MAX_BYTES {
            guard let buf = malloc(cap) else {
                panic("Directory.current: allocation failed")
            }
            if let result = getcwd(buf, cap) {
                // Copy into an owned String, then free the scratch buffer.
                let s = __saw_string_from_bytes(result, strlen(result))
                free(buf)
                return Path(s: s)
            }
            free(buf)
            cap = cap * 2
        }
        None
    }

    // Change the current working directory. `Err` carries the errno cause of
    // the failing chdir(2).
    public static func set_current(path: Path) unsafe -> Result<Void, IoError> {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_chdir(path_ptr)
        if e != 0 {
            return IoError.of("chdir", -e)
        }
        return
    }
}
