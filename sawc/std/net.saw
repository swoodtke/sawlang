// std.net: nonblocking TCP over the cooperative IO reactor.
//
// Hosted only: it links libc socket calls and the runtime's socket seams, and
// is never loaded in the freestanding profile (HOSTED_STD_MODULES in sawc.py).
//
// Two layers. The owning types (`TcpListener`, `TcpStream`) park internally on
// would-block and return `Result`s. Their methods can suspend because the
// coroutine transform embeds a suspending std method as a sub-frame. Below
// them, the raw `tcp_try_*`
// primitives return a would-block sentinel and leave the park to a loop in
// the caller's own task body:
//
//     while going {
//         let r = tcp_try_read(fd, buf, 64)
//         if net_would_block(r) {
//             io_wait(fd, 0)            // register (0=read) + park the task
//         } else {
//             n = r; going = false
//         }
//     }
//
// `io_wait(fd, write)` is a compiler intrinsic, like `yield_now`: it registers
// the fd with the reactor for read (write==0) or write (write==1) interest and
// suspends the task with an io wake reason. The executor polls the reactor
// when nothing is runnable and resumes the task on readiness, so a blocked
// socket op neither stalls a runnable peer nor busy-waits.

extern "C" {
    // Raw socket calls std.net spells directly (no errno branch): the AF_UNIX
    // test pair and fd close.
    func close(fd: Int32) -> Int32
    func socketpair(domain: Int32, ty: Int32, protocol: Int32, fds: UnsafePointer<Int32>) -> Int32

    // The status-carrying network ops (rt/common/os_ops.saw). Each does its
    // syscall and returns >= 0 on success/count or the negated portable
    // SysError tag on failure (rt/ABI.md).
    func __saw_rt_tcp_listen(port: Int) -> Int
    func __saw_rt_tcp_listen_on(addr_be: Int, port: Int) -> Int
    // Bind + listen carrying the options that can only be set between
    // `socket()` and `bind()`, and the by-tag option setter for the ones a live
    // connection takes.
    func __saw_rt_tcp_listen_with(addr_be: Int, port: Int, reuse_address: Int,
                                  backlog: Int) -> Int
    func __saw_rt_socket_set_option(fd: Int, option: Int, value: Int) -> Int
    func __saw_rt_tcp_local_port(fd: Int) -> Int
    func __saw_rt_tcp_accept(listen_fd: Int) -> Int
    func __saw_rt_tcp_connect_start(addr_be: Int, port: Int) -> Int
    func __saw_rt_tcp_connect_check(fd: Int, addr_be: Int, port: Int) -> Int
    func __saw_rt_tcp_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int
    func __saw_rt_tcp_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int
    // The host errno -> portable SysError tag mapper (rt/*/net_os.saw). Its only
    // std caller is `IoError.from_errno`, which has no callers of its own.
    // rt/ABI.md calls this seam runtime-internal: read at any distance from the
    // failing op, errno may already have been overwritten (DF-215e).
    func __saw_rt_last_syserror() -> Int

    // The raw platform code the classification folded away, captured beside
    // the tag when it was produced (rt/ABI.md). Valid immediately after a
    // failing op returned `-tag`, on this thread. Its only reader is
    // `raw_code_now`, for `IoError.of(syscall:tag:)`; a tag nothing classified
    // goes through `IoError.of(syscall:kind:)` instead.
    func __saw_rt_last_raw_code() -> Int

    // Hostname resolution, declared `blocking`. `getaddrinfo` is unbounded (it
    // may consult /etc/hosts, mDNS, LDAP or the network and wait out a DNS
    // timeout), so every call is offloaded to a worker thread and the calling
    // task parks, as it does on a socket read. `blocking` is part of the
    // symbol's contract, so no other declaration of it can drop the
    // annotation and there is no way to spell a naked resolve
    // (`examples/errors/resolve_seam_must_be_blocking.saw` pins it).
    //
    // Writes up to `max` addresses (network byte order) to `out` and returns the
    // count, `0` when the name has no IPv4 address, or a negated SysError tag.
    // Both pointers must address the parked frame or the heap (design 183's
    // pointer rule): the worker reads and writes through them while the task is
    // away.
    //
    // Called from `TcpStream.resolve_first`, a static method the transform
    // embeds as a sub-frame, so the `blocking` seam runs inside a frame and is
    // offloaded; a lookup lowered as a naked call would stop the executor for
    // its whole duration (`examples/net_connect_by_name.saw`).
    blocking func __saw_rt_resolve_ipv4(host: UnsafePointer<Int8>,
                                        out: UnsafePointer<UInt32>,
                                        max: Int) -> Int

    func __saw_rt_set_nonblocking(fd: Int) -> Int

    // The cooperative op-count budget (rt/common/op_budget.saw). Each io op that
    // completes without parking charges the budget; `__saw_rt_op_budget_tick()`
    // returns non-zero when it is exhausted (and resets it), telling the
    // primitive to force a fairness `yield_now()`. `__saw_rt_op_budget_reset()`
    // restores it after a genuine park (the task already ceded to the scheduler).
    func __saw_rt_op_budget_tick() -> Int
    func __saw_rt_op_budget_reset()

    // Bytes -> owned refcounted String (a compiler-emitted helper; see
    // codegen/core.py).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String

    // The monotonic clock, for turning a caller's `Duration` into the absolute
    // instant `io_wait_until` parks against. Monotonic rather than wall-clock,
    // so setting the system clock cannot lengthen or cut short a timeout.
    func __saw_rt_clock_monotonic_nanos() -> Int64
}

// Constants for the AF_UNIX test pair. IP sockets are set up in
// rt/common/os_ops.saw.
static AF_UNIX: Int32 = 1
static SOCK_STREAM: Int32 = 1
static PROTO_DEFAULT: Int32 = 0
static READ_CHUNK: Int = 4096        // TcpStream.read chunk size
static WOULD_BLOCK: Int = -2         // the `tcp_try_*` would-block sentinel
static NET_ERROR: Int = -1           // the `tcp_*` error sentinel

// The default listen backlog: the depth of the kernel's queue of
// arrived-but-not-yet-accepted connections. The same 16 the runtime's older
// listen seams pass.
static DEFAULT_BACKLOG: Int = 16

// The portable socket-option tags (rt/ABI.md). The host maps each to its own
// `(level, name)` pair; std never names a platform constant.
static OPT_NO_DELAY: Int = 1
static OPT_KEEPALIVE: Int = 2

// The portable SysError tags std.net branches on (the full space is in
// rt/ABI.md). A failing rt op returns the negated tag; the raw `tcp_try_*`
// primitives map it back to the WOULD_BLOCK/NET_ERROR sentinels their callers
// expect, while the owning types keep the tag for `IoError`.
static SYS_WOULD_BLOCK: Int = 1
static SYS_IN_PROGRESS: Int = 2
static SYS_NOT_FOUND: Int = 10

// std's own scratch-buffer refusal, far below any negated tag, so a read loop
// can tell it from an OS refusal. The two build their `IoError` differently:
// an OS refusal carries the raw code the runtime just captured, and this one
// has no platform number behind it.
static NET_NO_SCRATCH: Int = -1000

// How many addresses a resolution asks for. `connect` dials the first answer,
// so one is all it needs; asking for more would copy words nothing reads.
// (Happy-eyeballs would want the rest, and needs dual-stack support first.)
static RESOLVE_MAX: Int = 1

// FdPair is the 8-byte `int[2]` socketpair fills.
struct FdPair {
    a: Int32
    b: Int32
}

// True for the would-block sentinel returned by the `tcp_try_*` primitives.
func net_would_block(r: Int) -> Bool {
    r == WOULD_BLOCK
}

// A heap read buffer, allocated once per stream and reused across reads (freed
// with `net_free_buffer`). The raw read/write paths (`tcp_try_read`/
// `tcp_try_write`) allocate nothing; they take this pointer.
func net_buffer(size: Int) unsafe -> UnsafePointer<Int8> {
    if let p = GlobalAllocator().alloc(size, 1) {
        return p
    }
    panic("net_buffer: out of memory")
}

func net_free_buffer(buf: UnsafePointer<Int8>, size: Int) unsafe {
    GlobalAllocator().dealloc(buf, size, 1)
}

// Bytes -> owned String (convenience for tests / text protocols).
func net_bytes_to_string(buf: UnsafePointer<Int8>, len: Int) unsafe -> String {
    __saw_string_from_bytes(buf, len)
}

// The raw `tcp_*` layer: a thin translation over the status-carrying rt ops
// (rt/common/os_ops.saw). The rt ops return >= 0 on success or a negated
// SysError tag; these wrappers map that to the WOULD_BLOCK (-2) / NET_ERROR (-1)
// sentinels the white-box tests expect. The owning TcpListener/TcpStream types
// call the rt ops directly so they keep the tag for a precise IoError.

// Fold an rt-op result into the count / WOULD_BLOCK / NET_ERROR contract.
func net_sentinel(r: Int) -> Int {
    if r >= 0 {
        r
    } else if r == -SYS_WOULD_BLOCK {
        WOULD_BLOCK
    } else {
        NET_ERROR
    }
}

// Open a nonblocking listening TCP socket bound to 127.0.0.1:port. `port == 0`
// requests an ephemeral port (read it back with `tcp_local_port`). Returns the
// listen fd (>= 0) or -1.
func tcp_listen(port: Int) -> Int {
    net_sentinel(__saw_rt_tcp_listen(port))
}

// The actual local port a (possibly ephemeral) listen fd is bound to.
func tcp_local_port(fd: Int) -> Int {
    __saw_rt_tcp_local_port(fd)
}

// Nonblocking accept: a nonblocking connection fd (>= 0), the would-block
// sentinel (-2) when no client is waiting, or -1 on error.
func tcp_try_accept(listen_fd: Int) -> Int {
    net_sentinel(__saw_rt_tcp_accept(listen_fd))
}

// Start a nonblocking connect to `addr_be`:`port`, the address in network byte
// order (`ipv4_addr` / `parse_ipv4_literal` produce it). Returns a connecting fd
// (>= 0) or -1. Then `io_wait(fd, 1)` until writable and `tcp_connect_check`.
func tcp_connect_start(addr_be: Int, port: Int) -> Int {
    let r = __saw_rt_tcp_connect_start(addr_be, port)
    if r < 0 { NET_ERROR } else { r }
}

// Re-issue the nonblocking connect() to learn the true completion state;
// `addr_be` must be the address `tcp_connect_start` was given.
// Returns 0 = connected, the would-block sentinel (-2) = still connecting
// (re-park), or -1 = failed.
func tcp_connect_check(fd: Int, addr_be: Int, port: Int) -> Int {
    let r = __saw_rt_tcp_connect_check(fd, addr_be, port)
    if r == 0 {
        0
    } else if r == -SYS_IN_PROGRESS {
        WOULD_BLOCK
    } else {
        NET_ERROR
    }
}

// Nonblocking read: byte count (0 = peer closed / EOF), the would-block sentinel
// (-2), or -1 on error.
func tcp_try_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    net_sentinel(__saw_rt_tcp_read(fd, buf, len))
}

// Nonblocking write: bytes written (may be < len), the would-block sentinel (-2),
// or -1 on error.
func tcp_try_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    net_sentinel(__saw_rt_tcp_write(fd, buf, len))
}

// Close a socket fd. An fd is an `Int32` at the C boundary and an `Int`
// everywhere in this file, so the narrowing is written: every fd here came out
// of a socket call that already answered an `Int32`, so a value out of range is
// a bug and `as` is the spelling that says so.
func tcp_close(fd: Int) {
    let _ = close(fd as Int32)
}

// A connected, nonblocking AF_UNIX stream pair for tests (no external network).
// Returns (a, b); (-1, -1) on failure.
func tcp_socketpair() unsafe -> (Int, Int) {
    var fds = FdPair(a: 0 as Int32, b: 0 as Int32)
    let fp = (&fds) as UnsafePointer<Int32>
    if socketpair(AF_UNIX, SOCK_STREAM, PROTO_DEFAULT, fp) == 0 {
        let a = fp[0]
        let b = fp[1]
        let _ = __saw_rt_set_nonblocking(a as Int)
        let _ = __saw_rt_set_nonblocking(b as Int)
        return (a as Int, b as Int)
    }
    (NET_ERROR, NET_ERROR)
}

// =============================================================================
// IPv4 literals
// =============================================================================
//
// A dotted quad is an address already, with nothing to look up, so it is
// parsed here, in Saw, and never reaches the platform resolver or leaves the
// executor thread. `connect("127.0.0.1", port)` takes this path.

static ASCII_DOT: Int = 46
static ASCII_ZERO: Int = 48
static ASCII_NINE: Int = 57
static IPV4_MIN_TEXT: Int = 7        // "0.0.0.0"
static IPV4_MAX_TEXT: Int = 15       // "255.255.255.255"
static IPV4_OCTETS: Int = 4
static OCTET_MAX: Int = 255
static OCTET_MAX_DIGITS: Int = 3

// Four octets as the `sockaddr_in.sin_addr` word: the octets sit in memory in
// the order they are written, so on a little-endian target — the only kind the
// hosted runtime builds for, the same assumption `htons` states in
// rt/common/os_ops.saw — the first octet is the low byte.
func ipv4_addr(a: UInt32, b: UInt32, c: UInt32, d: UInt32) -> UInt32 {
    a | (b << 8) | (c << 16) | (d << 24)
}

// A dotted-quad IPv4 literal as its address word, or `None` when `host` is not
// one (the caller then resolves it).
//
// Strict on purpose: exactly four octets, one to three digits each, no leading
// zero, no sign, no spaces, nothing before or after. A near-miss like
// "127.00.0.1" is not guessed at here; it falls through to the platform
// resolver, whose reading of it is the authoritative one. Guessing would mean
// picking a side in the "is a leading zero octal?" ambiguity, which is a
// source of address confusion, not a convenience.
func parse_ipv4_literal(host: String) -> UInt32? {
    let n = host.len()
    if n < IPV4_MIN_TEXT || n > IPV4_MAX_TEXT {
        return None
    }
    var octets: [UInt32; IPV4_OCTETS] = [0; IPV4_OCTETS]
    var filled = 0        // octets already stored
    var value = 0         // the octet being accumulated
    var digits = 0        // digits seen in it
    var i = 0
    while i < n {
        let b = host.byte_at(i) as Int
        if b == ASCII_DOT {
            if digits == 0 || filled == IPV4_OCTETS - 1 {
                return None                      // empty octet, or a fifth one
            }
            octets[filled] = value as UInt32
            filled = filled + 1
            value = 0
            digits = 0
        } else if b < ASCII_ZERO || b > ASCII_NINE {
            return None                          // not a digit and not a dot
        } else {
            if digits == OCTET_MAX_DIGITS {
                return None
            }
            if digits == 1 && value == 0 {
                return None                      // a leading zero
            }
            value = value * 10 + (b - ASCII_ZERO)
            if value > OCTET_MAX {
                return None
            }
            digits = digits + 1
        }
        i = i + 1
    }
    if filled != IPV4_OCTETS - 1 || digits == 0 {
        return None                              // too few octets, or a trailing dot
    }
    octets[IPV4_OCTETS - 1] = value as UInt32
    return ipv4_addr(octets[0], octets[1], octets[2], octets[3])
}

// A sentinel fd for a closed / never-opened socket handle. `tcp_close` on it is a
// harmless no-op, so it is the safe placeholder inside the owning socket types.
static INVALID_FD: Int32 = -1

// One nonblocking read of up to READ_CHUNK bytes into a scratch buffer, appended
// to `into` (grows as needed). Returns the byte count (0 = peer closed / EOF) or
// a negated SysError tag: the owning types keep the tag for a precise IoError.
// `NET_NO_SCRATCH` is the third answer: std could not get the chunk buffer,
// which is not something the OS refused. The pointer work is confined here
// (raw layer); TcpStream.read drives it behind an io_wait park.
func net_read_once(fd: Int, into: &var Data) unsafe -> Int {
    if let ptr = GlobalAllocator().alloc(READ_CHUNK, 1) {
        let r = __saw_rt_tcp_read(fd, ptr, READ_CHUNK)
        var placed = r
        if r > 0 {
            // Growing `into` can be refused, and this function returns a byte
            // count or a negated tag, so the refusal takes the same third answer
            // as a scratch failure. The callers turn `NET_NO_SCRATCH` into
            // `IoError(kind: ResourcesExhausted)`; the bytes just read are
            // dropped with the scratch buffer.
            match into.append_bytes(ptr, r) {
                case Ok(_) -> {},
                case Err(_) -> { placed = NET_NO_SCRATCH }
            }
        }
        GlobalAllocator().dealloc(ptr, READ_CHUNK, 1)
        return placed
    }
    return NET_NO_SCRATCH
}

// One nonblocking write of the tail of `s` starting at `off`. Returns bytes
// written (may be < remaining) or a negated SysError tag.
func net_write_str_once(fd: Int, s: String, off: Int) unsafe -> Int {
    let ptr = s as UnsafePointer<Int8>
    __saw_rt_tcp_write(fd, ptr + off, s.len() - off)
}

// One nonblocking write of the tail of `bytes` starting at `off`.
func net_write_data_once(fd: Int, bytes: &Data, off: Int) unsafe -> Int {
    let ptr = bytes.byte_ptr()
    __saw_rt_tcp_write(fd, ptr + off, bytes.len() - off)
}

// =============================================================================
// IoError: the OS boundary, as a portable kind plus the platform's raw code
// =============================================================================

/// What kind of failure the operating system reported.
///
/// The errno set is large, platform-dependent and open, so this is a curated
/// portable set and `Unknown` is its escape hatch. Two rules keep it honest:
///
/// - **Classification is diagnostic, not contractual.** Several platform codes
///   share one kind: `EACCES` and `EPERM` are both `PermissionDenied`. A
///   program that needs the exact number reads `IoError.code()`. Correct
///   handling of `Unknown` treats it as an opaque failure, never as "I know
///   which code this secretly is".
/// - **Growth is loud.** Promoting a code out of `Unknown` into a new case
///   breaks an exhaustive match at compile time rather than silently rerouting
///   it somewhere else.
///
/// The raw values are the portable SysError tags `sawc/rt/ABI.md` freezes, so a
/// tag a runtime returns becomes a kind through `from(raw:)` and there is no
/// second table to keep in step. A tag this vocabulary does not know — a
/// runtime newer than this std — reads as `Unknown`.
public enum IoErrorKind: UInt8 {
    /// The operation would have blocked, and the descriptor is non-blocking.
    case WouldBlock = 1,
    /// A connection is still being established.
    case InProgress = 2,
    /// The socket is already connected.
    case AlreadyConnected = 3,
    /// The call was interrupted — by a signal, or by cooperative cancellation.
    case Interrupted = 4,
    /// The peer reset the connection.
    case ConnectionReset = 5,
    /// Nothing was listening at the address.
    case ConnectionRefused = 6,
    /// The connection was aborted before it was established.
    case ConnectionAborted = 7,
    /// The write end has no reader left.
    case BrokenPipe = 8,
    /// The socket is not connected.
    case NotConnected = 9,
    /// No such file, directory or host.
    case NotFound = 10,
    /// The caller is not allowed to do this.
    case PermissionDenied = 11,
    /// The thing being created is already there.
    case AlreadyExists = 12,
    /// The address is already bound.
    case AddressInUse = 13,
    /// An argument the system rejected.
    case InvalidArgument = 14,
    /// A system resource ran out — descriptors, memory or disk space.
    case ResourcesExhausted = 15,
    /// A failure this portable vocabulary has no word for. Opaque by contract;
    /// `IoError.code()` carries the platform's own number.
    case Unknown = 16,
    /// The host cannot be reached.
    case HostUnreachable = 17,
    /// The network cannot be reached.
    case NetworkUnreachable = 18,
    /// The operation ran out of time.
    case TimedOut = 19,
    /// The host is down.
    case HostDown = 20,
    /// The network is down.
    case NetworkDown = 21
}

extension IoErrorKind {
    /// The kind a portable SysError tag names, `Unknown` for a tag this
    /// vocabulary does not know.
    public static func of(tag: Int) -> IoErrorKind {
        // Range-checked before the cast: `as UInt8` panics out of range, and a
        // tag arriving from a runtime is not this module's to trust.
        if tag < 0 || tag > 255 {
            return IoErrorKind.Unknown
        }
        IoErrorKind.from(raw: tag as UInt8) ?? IoErrorKind.Unknown
    }

    /// A short human name, the one `IoError` renders in parentheses.
    public func describe(&self) -> String {
        match self {
            case WouldBlock -> "would block",
            case InProgress -> "in progress",
            case AlreadyConnected -> "already connected",
            case Interrupted -> "interrupted",
            case ConnectionReset -> "connection reset",
            case ConnectionRefused -> "connection refused",
            case ConnectionAborted -> "connection aborted",
            case BrokenPipe -> "broken pipe",
            case NotConnected -> "not connected",
            case NotFound -> "not found",
            case PermissionDenied -> "permission denied",
            case AlreadyExists -> "already exists",
            case AddressInUse -> "address in use",
            case InvalidArgument -> "invalid argument",
            case ResourcesExhausted -> "resources exhausted",
            case Unknown -> "other error",
            // The remote-reach failures, which only happen off loopback.
            case HostUnreachable -> "host unreachable",
            case NetworkUnreachable -> "network unreachable",
            case TimedOut -> "timed out",
            case HostDown -> "host is down",
            case NetworkDown -> "network is down"
        }
    }
}

extension IoErrorKind: Printable {
    public func format(&self, into: &var StringBuilder) {
        try! into.append(self.describe())
    }
}

/// A failed operating-system operation: which call failed, what kind of refusal
/// it was, and the platform's own code for it.
///
/// Prints through the `Error` vtable as `io error: connect failed (connection
/// refused)`: the kind only, so the text reads the same on every host. The raw
/// code is for a log that wants the number, and is read explicitly.
public struct IoError {
    private syscall: String
    private kind: IoErrorKind
    private code: Int32
}

// The raw code this thread's last classification captured, as an `Int32`.
// Out-of-range is answered `0` rather than by the panicking `as`:
// the value comes from a runtime, and a diagnostic field is the last thing that
// should be able to abort the program reporting an error.
func raw_code_now() -> Int32 {
    let raw = __saw_rt_last_raw_code()
    if raw < -2147483648 || raw > 2147483647 {
        return 0
    }
    raw as Int32
}

extension IoError {
    /// The portable kind of the failure.
    ///
    /// Diagnostic, not contractual — several platform codes share one kind, so
    /// a program that must distinguish them reads `code()`. `Unknown` is opaque
    /// failure, not "some errno I could work out".
    public func kind(&self) -> IoErrorKind {
        self.kind
    }

    /// The platform's own code for the failure: the hosted errno itself, and
    /// on a freestanding target the native status. `0` where the platform has
    /// none, which includes a failure std raised on its own behalf (a cancelled
    /// park, a name with no address).
    ///
    /// This is not the portable tag, and it is not portable: `ECONNREFUSED` is
    /// 61 on macOS and 111 on Linux. Log it; branch on `kind()`.
    public func code(&self) -> Int32 {
        self.code
    }

    /// Builds an `IoError` from the calling thread's current errno.
    ///
    /// Valid only on the statement after a failing `__saw_rt_*` op: it reads
    /// errno through a seam `sawc/rt/ABI.md` documents as runtime-internal,
    /// and anything that runs in between can overwrite it. The tag a failing
    /// op returns needs no errno read; pass it to `of(syscall:tag:)` instead.
    public static func from_errno(syscall: String) -> IoError {
        IoError.of(syscall: syscall, tag: __saw_rt_last_syserror())
    }

    /// Build an `IoError` from a syscall name and the portable tag a failing
    /// runtime op just returned, capturing the platform's raw code with it.
    ///
    /// The capture is what makes this the OS-refusal factory: it reads
    /// `__saw_rt_last_raw_code()`, which is valid immediately after that op, on
    /// this thread (rt/ABI.md). A tag not produced by a classification, one
    /// std or the runtime synthesized — must not come through here; use the
    /// `kind:` factory, whose `code` is `0`.
    public static func of(syscall: String, tag: Int) -> IoError {
        IoError(syscall: syscall, kind: IoErrorKind.of(tag: tag),
                code: raw_code_now())
    }

    /// Build an `IoError` for a failure the platform did not report — a park
    /// cut short by cancellation, a name the resolver answered with no address.
    /// `code()` is `0`, because there is no platform number to carry.
    public static func of(syscall: String, kind: IoErrorKind) -> IoError {
        IoError(syscall: syscall, kind: kind, code: 0)
    }
}

extension IoError: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append("io error: ")
        try! into.append(self.syscall)
        try! into.append(" failed (")
        try! into.append(self.kind.describe())
        try! into.append(")")
    }
}

// An OS refusal: the tag the op just returned, plus the raw code behind it.
func io_error(syscall: String, tag: Int) -> IoError {
    IoError.of(syscall: syscall, tag: tag)
}

// A park cut short by cooperative cancellation. Not an OS refusal (nothing
// classified an errno), so it carries no raw code.
func io_cancelled(syscall: String) -> IoError {
    IoError.of(syscall: syscall, kind: IoErrorKind.Interrupted)
}

// A failed resolution, naming the host. The host is the failure here (an error
// that does not say which name could not be resolved is unactionable), so it
// goes in the syscall slot and prints as `io error: resolve "db.internal"
// failed (not found)`.
//
// Built through the `kind:` factory for two reasons: the resolver's tag may be
// one the runtime synthesized (a name with no IPv4 address answers `-NotFound`
// with no errno behind it), and the resolve seam is `blocking`, so whatever it
// did classify happened on an offload worker thread rather than this one
// (rt/ABI.md's freshness rule).
// The three appends force rather than report: this function's whole job is to
// describe a failure, and there is no error channel behind an error
// constructor, the same shape as a `format` body.
func resolve_error(host: String, tag: Int) -> IoError {
    var what = StringBuilder()
    try! what.append("resolve \"")
    try! what.append(host)
    try! what.append("\"")
    IoError.of(syscall: what.build(), kind: IoErrorKind.of(tag: tag))
}

// =============================================================================
// Deadlines (design 272)
// =============================================================================

/// The outcome of a network operation that was given a deadline.
///
/// A timed read has three ways to end and they are three different facts, so
/// they are three different values: bytes arrived, the peer closed, or the
/// deadline ran out first. An `Err` is the fourth — a genuine failure — and
/// stays where every other std.net failure already is.
///
/// ```saw
/// match try stream.read(timeout: Duration.secs(30)) {
///     case Value(bytes) -> {
///         if bytes.len() == 0 { break }   // the peer closed
///         try handle(bytes)
///     }
///     case TimedOut -> break              // idle too long; drop the connection
/// }
/// ```
public enum Timed<T> {
    /// The operation finished before the deadline, carrying its result.
    case Value(value: T),
    /// The deadline elapsed first. Nothing was read, accepted or connected.
    case TimedOut
}

// A caller's `Duration` as the absolute monotonic instant the park gives up at,
// which is what `io_wait_until` takes and what the executor compares against.
//
// Absolute rather than relative all the way down: a loop that re-parks after a
// spurious wake must not restart its own timeout, and a relative span
// recomputed per iteration does exactly that (a connection dribbling one byte
// every `timeout - 1` would never time out). Computing the instant once, before
// the first attempt, is what makes the deadline a deadline.
//
// Saturates at `Int.max` rather than wrapping: a span past the representable
// range means "not coming back", and a wrapped one would mean "already expired",
// which is the opposite (the `__saw_wake_nanos` rule, same reasoning).
func net_deadline_at(timeout: Duration) -> Int {
    let now = __saw_rt_clock_monotonic_nanos() as Int
    let ns = timeout.as_nanos()
    if ns >= (Int.max as UInt64) {
        return Int.max
    }
    let span = ns as Int
    if Int.max - span < now {
        return Int.max
    }
    now + span
}

// Has `at` arrived? Read fresh every time: the point of the check is that time
// has passed since the last one.
func net_deadline_passed(at: Int) -> Bool {
    (__saw_rt_clock_monotonic_nanos() as Int) >= at
}

// =============================================================================
// TcpListener: an owning listening socket
// =============================================================================
//
// NoCopy: the listen fd has exactly one owner; `Deinit` closes it exactly once
// (the move checkpoint prevents use-after-close, NoCopy prevents double-close).
// The fd is a private field; the public surface exposes no raw fds or pointers.

public struct TcpListener {
    private fd: Int
}

extension TcpListener {
    /// Binds and listens on `host`:`port`, returning the owning listener.
    ///
    /// `port` 0 requests an ephemeral port; read the one the OS chose back with
    /// `local_port`. `host` takes a dotted IPv4 literal — use "0.0.0.0" for all
    /// IPv4 interfaces — and listening never performs DNS.
    ///
    /// `reuse_address` defaults ON, so restarting a server does not lose to the
    /// dead process's lingering socket. It does not make a real collision quiet:
    /// binding an address and port another socket already holds still fails with
    /// `AddressInUse`. Pass `reuse_address: false` to require a completely
    /// unused address.
    ///
    /// `backlog` is the depth of the kernel's queue of connections that have
    /// arrived but not yet been accepted.
    public static func listen(port: Int,
                              host: String = "127.0.0.1",
                              reuse_address: Bool = true,
                              backlog: Int = DEFAULT_BACKLOG) -> Result<TcpListener, IoError> {
        if port < 0 || port > 65535 {
            return IoError.of(syscall: "listen: port must be 0..65535", kind: IoErrorKind.InvalidArgument)
        }
        if backlog < 1 {
            return IoError.of(syscall: "listen: backlog must be at least 1", kind: IoErrorKind.InvalidArgument)
        }
        guard let addr = parse_ipv4_literal(host) else {
            return IoError.of(syscall: "listen: expected an IPv4 address", kind: IoErrorKind.InvalidArgument)
        }
        let reuse = if reuse_address { 1 } else { 0 }
        let fd = __saw_rt_tcp_listen_with(addr as Int, port, reuse, backlog)
        if fd < 0 { return io_error("listen", -fd) }
        return TcpListener(fd: fd)
    }

    // The actual bound local port (resolves an ephemeral 0).
    public func local_port(&self) -> Int {
        tcp_local_port(self.fd)
    }

    // Accept the next connection, returning its owning stream or an IoError.
    // Cooperative: parks on the listen fd until a connection arrives, so a
    // runnable peer never stalls, and observes cancellation at the park. A
    // genuine accept failure is `Err(IoError)`, never something that looks
    // like a live stream.
    public func accept(&self) -> Result<TcpStream, IoError> {
        while {
            if cancelled() {
                // Leaving the loop without our event firing would strand the
                // armed registration, whose token is an address inside this
                // frame (DF-134a). Disarm before returning.
                io_unwait(self.fd, 0)
                return io_cancelled("accept")   // cancelled before a connection
            }
            let c = __saw_rt_tcp_accept(self.fd)
            if c == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)                // park until a client arrives
                __saw_rt_op_budget_reset()             // parked, so reset the budget
            } else if c < 0 {
                return io_error("accept", -c)      // a real accept error
            } else {
                if __saw_rt_op_budget_tick() != 0 {     // fairness backstop
                    yield_now()                    // ran the budget out without parking
                }
                return TcpStream(fd: c)            // got a connection
            }
        }
    }

    /// Accepts the next connection, giving up after `timeout`.
    ///
    /// Returns `Value` with the owning stream, or `TimedOut` if no client
    /// arrived in time. A genuine accept failure is still `Err`.
    ///
    /// The deadline is measured from the call, not from each park, so a wake
    /// that turns out to be spurious does not extend it. Timeouts are honoured
    /// to the nearest millisecond above the span asked for — never below it, so
    /// a deadline can arrive late but never early.
    public func accept(&self, timeout: Duration) -> Result<Timed<TcpStream>, IoError> {
        let at = net_deadline_at(timeout)
        while {
            if cancelled() {
                io_unwait(self.fd, 0)          // disarm before returning
                return io_cancelled("accept")
            }
            let c = __saw_rt_tcp_accept(self.fd)
            if c == -SYS_WOULD_BLOCK {
                // The deadline is checked before parking, so a span that has
                // already run out never parks at all, and after a wake the loop
                // re-issues `accept` first: readiness that lands in the same
                // instant as the deadline is reported as the connection it is.
                if net_deadline_passed(at) {
                    io_unwait(self.fd, 0)
                    return Timed<TcpStream>.TimedOut
                }
                io_wait_until(self.fd, 0, at)  // park until a client arrives or `at`
                __saw_rt_op_budget_reset()         // parked, so reset the budget
            } else if c < 0 {
                return io_error("accept", -c)  // a real accept error
            } else {
                if __saw_rt_op_budget_tick() != 0 {
                    yield_now()
                }
                return Timed<TcpStream>.Value(value: TcpStream(fd: c))
            }
        }
    }
}

extension TcpListener: NoCopy {
    public func deinit(&var self) {
        if self.fd >= 0 {
            tcp_close(self.fd)
        }
    }
}

// =============================================================================
// TcpStream: an owning connected socket
// =============================================================================
//
// NoCopy owning type; `Deinit` closes the conn fd exactly once. read/write park
// internally on would-block, so application code never sees io_wait, a raw fd
// or a pointer.

public struct TcpStream {
    private fd: Int
}

extension TcpStream {
    // Connect to `host`:`port`, where `host` is a dotted-quad IPv4 literal or a
    // name to resolve. Cooperative throughout: a name is resolved on a worker
    // thread while siblings run, and the dial then parks until the socket is
    // writable (connected). Returns the owning stream or an IoError, one that
    // names the host when the name is the thing that failed.
    public static func connect(host: String, port: Int) -> Result<TcpStream, IoError> {
        // The literal fast path. A dotted quad is an address already, so it is
        // parsed here, in Saw, and dialled directly: no libc, no resolver, no
        // thread hop, and no way for a literal caller to pay for the resolver's
        // existence.
        if let literal = parse_ipv4_literal(host) {
            return TcpStream.dial(literal as Int, port)
        }
        // A name. `getaddrinfo` is unbounded, so the lookup runs on a worker
        // thread and this task parks while siblings run: resolution never stops
        // the executor (design 184). `examples/net_connect_by_name.saw` pins the
        // interleave.
        let first = TcpStream.resolve_first(host)
        if first < 0 {
            return resolve_error(host, -first)
        }
        return TcpStream.dial(first, port)
    }

    // The first IPv4 address `host` resolves to, as the address word the dial
    // seam takes, or a negated SysError tag: std.net's convention for a raw op,
    // and collision-free here because every address word is >= 0. A resolver
    // that succeeds and offers no IPv4 address answers `-NotFound`: "nowhere to
    // dial" is a failure to the one caller this has.
    //
    // A static method so the transform embeds it as a sub-frame: its `blocking`
    // seam then runs inside a frame and is offloaded, instead of a naked call
    // holding the executor thread for the whole lookup. `unsafe` confines the
    // pointer work so `connect` keeps a safe signature.
    //
    // `found` is a frame local, so it lives in the parked frame for the whole
    // park and the worker may write through the pointer while this task is
    // away (design 183's pointer rule); a stack temporary would not.
    static func resolve_first(host: String) unsafe -> Int {
        var found: [UInt32; RESOLVE_MAX] = [0; RESOLVE_MAX]
        let n = __saw_rt_resolve_ipv4(host as UnsafePointer<Int8>,
                                      (&found) as UnsafePointer<UInt32>,
                                      RESOLVE_MAX)
        if n < 0 {
            return n
        }
        if n == 0 {
            return 0 - SYS_NOT_FOUND
        }
        return found[0] as Int
    }

    // Dial `addr`:`port` (the address in network byte order) and park until the
    // socket is writable. Shared by both `connect` paths, so a name and a
    // literal reach their peer through exactly the same code.
    static func dial(addr: Int, port: Int) -> Result<TcpStream, IoError> {
        let fd = __saw_rt_tcp_connect_start(addr, port)
        if fd < 0 {
            return io_error("connect", -fd)
        }
        // Park until the connect completes, re-checking after every resume
        // rather than trusting one: a resume is not proof that this socket is
        // connected. Loop like read/write/accept and re-park on would-block
        // (design 90).
        while {
            if cancelled() {
                io_unwait(fd, 1)           // disarm before the fd goes
                tcp_close(fd)              // cancelled while connecting
                return io_cancelled("connect")
            }
            let check = __saw_rt_tcp_connect_check(fd, addr, port)
            if check == -SYS_IN_PROGRESS {
                io_wait(fd, 1)             // still connecting: park until writable
                __saw_rt_op_budget_reset()      // parked, so reset the budget
            } else if check < 0 {
                tcp_close(fd)
                return io_error("connect", -check)
            } else {
                break                         // connected
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // fairness backstop
            yield_now()
        }
        return TcpStream(fd: fd)
    }

    /// Connects to `host`:`port`, giving up after `timeout`.
    ///
    /// Returns `Value` with the owning stream, or `TimedOut` if the peer did
    /// not answer in time. A refused or unreachable peer is still `Err`: a
    /// closed port is a different fact from a silent one, and only the second
    /// is a timeout.
    ///
    /// When `host` is a name, the deadline does not interrupt the lookup.
    /// Resolution runs on a worker thread and the platform resolver cannot be
    /// cancelled, so the timeout is checked once resolution returns and then
    /// governs the dial. A name that resolves slower than `timeout` therefore
    /// reports `TimedOut` after the lookup rather than during it. Pass a dotted
    /// IPv4 literal when the whole span must be bounded; that path performs no
    /// lookup at all.
    public static func connect(host: String, port: Int,
                               timeout: Duration) -> Result<Timed<TcpStream>, IoError> {
        let at = net_deadline_at(timeout)
        if let literal = parse_ipv4_literal(host) {
            return TcpStream.dial_until(literal as Int, port, at)
        }
        let first = TcpStream.resolve_first(host)
        if first < 0 {
            return resolve_error(host, -first)
        }
        // The lookup is behind us and may have eaten the whole span; say so now
        // rather than dialling against a deadline that has already passed.
        if net_deadline_passed(at) {
            return Timed<TcpStream>.TimedOut
        }
        return TcpStream.dial_until(first, port, at)
    }

    // The deadline-bounded twin of `dial`: the same re-checking park loop, with
    // the park bounded and the deadline checked on the would-block path.
    static func dial_until(addr: Int, port: Int,
                           at: Int) -> Result<Timed<TcpStream>, IoError> {
        let fd = __saw_rt_tcp_connect_start(addr, port)
        if fd < 0 {
            return io_error("connect", -fd)
        }
        while {
            if cancelled() {
                io_unwait(fd, 1)           // disarm before the fd goes
                tcp_close(fd)
                return io_cancelled("connect")
            }
            let check = __saw_rt_tcp_connect_check(fd, addr, port)
            if check == -SYS_IN_PROGRESS {
                if net_deadline_passed(at) {
                    io_unwait(fd, 1)
                    tcp_close(fd)          // the half-open socket is ours to drop
                    return Timed<TcpStream>.TimedOut
                }
                io_wait_until(fd, 1, at)   // park until writable or `at`
                __saw_rt_op_budget_reset()
            } else if check < 0 {
                tcp_close(fd)
                return io_error("connect", -check)
            } else {
                break                      // connected
            }
        }
        if __saw_rt_op_budget_tick() != 0 {
            yield_now()
        }
        return Timed<TcpStream>.Value(value: TcpStream(fd: fd))
    }

    /// Sets whether small writes are sent immediately rather than coalesced.
    ///
    /// On by default, which is what a request/response protocol wants: with
    /// coalescing on, a small reply can sit in the kernel waiting for more data
    /// to accompany it while the peer waits for the reply, and the pair resolves
    /// only when a delayed-acknowledgement timer fires. Turn it off for a
    /// stream of many small writes where throughput matters more than latency.
    public func set_no_delay(&self, on: Bool) -> Result<Void, IoError> {
        let r = __saw_rt_socket_set_option(self.fd, OPT_NO_DELAY, if on { 1 } else { 0 })
        if r < 0 { return io_error("set_no_delay", -r) }
        return
    }

    /// Sets whether the OS probes an idle connection to learn if the peer is
    /// still there.
    ///
    /// Off by default. The probe interval is the system's, not this API's — it
    /// is measured in hours on most hosts and the tuning knobs for it do not
    /// mean the same thing across platforms. For a bound an application
    /// controls, give the read a `timeout` instead.
    public func set_keepalive(&self, on: Bool) -> Result<Void, IoError> {
        let r = __saw_rt_socket_set_option(self.fd, OPT_KEEPALIVE, if on { 1 } else { 0 })
        if r < 0 { return io_error("set_keepalive", -r) }
        return
    }

    // A connected, nonblocking stream pair (AF_UNIX socketpair), for tests and
    // local IPC, with no bound port. Both ends are owning TcpStreams.
    public static func pair() -> (TcpStream, TcpStream) {
        let p = tcp_socketpair()
        (TcpStream(fd: p.0), TcpStream(fd: p.1))
    }

    // Read the next chunk of bytes. On success returns the chunk as owned Data;
    // an empty Ok means the peer closed cleanly (EOF). A genuine read failure is
    // Err(IoError), distinct from EOF. Cooperative: parks internally on
    // would-block until bytes arrive or the peer closes. `read_into` appends to
    // a caller's buffer instead.
    public func read(&self) -> Result<Data, IoError> {
        var out = Data()
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // disarm the park
                return io_cancelled("read")   // cancelled at the park
            }
            let r = net_read_once(self.fd, &var out)
            if r == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)            // park until readable
                __saw_rt_op_budget_reset()          // parked, so reset the budget
            } else if r == NET_NO_SCRATCH {
                // std's own refusal, not the OS's, so it carries no raw code.
                return IoError.of(syscall: "read",
                                  kind: IoErrorKind.ResourcesExhausted)
            } else if r < 0 {
                return io_error("read", -r)    // a real read error, not EOF
            } else {
                break                          // r >= 0: bytes read (0 = EOF)
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // fairness backstop
            yield_now()                        // always-ready read: cede periodically
        }
        return move out
    }

    /// Reads the next chunk of bytes, giving up after `timeout`.
    ///
    /// Returns `Value` with the chunk (an empty chunk still means the peer
    /// closed cleanly) or `TimedOut` if nothing arrived in time. A genuine
    /// read failure is still `Err`, so all four outcomes stay distinct: bytes,
    /// EOF, timeout, error.
    ///
    /// This is the idle-connection timeout a server wants. The deadline is
    /// measured from the call, so a peer dribbling one byte at a time cannot
    /// hold the handler open by resetting it.
    public func read(&self, timeout: Duration) -> Result<Timed<Data>, IoError> {
        var out = Data()
        let at = net_deadline_at(timeout)
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // disarm the park
                return io_cancelled("read")   // cancelled at the park
            }
            let r = net_read_once(self.fd, &var out)
            if r == -SYS_WOULD_BLOCK {
                if net_deadline_passed(at) {
                    io_unwait(self.fd, 0)
                    return Timed<Data>.TimedOut
                }
                io_wait_until(self.fd, 0, at)  // park until readable or `at`
                __saw_rt_op_budget_reset()          // parked, so reset the budget
            } else if r == NET_NO_SCRATCH {
                return IoError.of(syscall: "read",
                                  kind: IoErrorKind.ResourcesExhausted)
            } else if r < 0 {
                return io_error("read", -r)    // a real read error, not EOF
            } else {
                break                          // r >= 0: bytes read (0 = EOF)
            }
        }
        if __saw_rt_op_budget_tick() != 0 {
            yield_now()
        }
        return Timed<Data>.Value(value: move out)
    }

    // Read the next chunk of bytes and append them to the caller's `into`
    // buffer, returning the byte count (0 = the peer closed cleanly / EOF), or
    // Err(IoError) on a genuine read failure, distinct from EOF. The `&var Data`
    // is held across this method's io_wait park: a reference parameter is
    // frame-resident across a suspend, so the append after the park writes to
    // the caller's buffer. Beside the value-returning `read()`, this lets a
    // caller accumulate successive reads into one growing buffer without a
    // fresh Data per chunk. Cooperative: parks internally on would-block until
    // bytes arrive.
    public func read_into(&self, into: &var Data) -> Result<Int, IoError> {
        var count = 0
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // disarm the park
                return io_cancelled("read")   // cancelled at the park
            }
            // Forward the held `&var into` to `net_read_once`, which owns the
            // scratch buffer and the append. `into` is a frame-resident pointer
            // across the park, and this call passes that same pointer on.
            let r = net_read_once(self.fd, &var into)
            if r == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)                    // park until readable
                __saw_rt_op_budget_reset()                  // parked, so reset the budget
            } else if r == NET_NO_SCRATCH {
                // std's own refusal, not the OS's, so it carries no raw code.
                return IoError.of(syscall: "read",
                                  kind: IoErrorKind.ResourcesExhausted)
            } else if r < 0 {
                return io_error("read", -r)            // a real read error, not EOF
            } else {
                count = r                              // r >= 0: bytes read (0 = EOF)
                break
            }
        }
        if __saw_rt_op_budget_tick() != 0 {                 // fairness backstop
            yield_now()
        }
        return count
    }

    /// Reads the next chunk into `into`, giving up after `timeout`.
    ///
    /// Returns `Value` with the byte count (0 = the peer closed cleanly), or
    /// `TimedOut` if nothing arrived in time. On a timeout nothing has been
    /// appended, so the caller's buffer is exactly as it was.
    public func read_into(&self, into: &var Data,
                          timeout: Duration) -> Result<Timed<Int>, IoError> {
        var count = 0
        let at = net_deadline_at(timeout)
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // disarm the park
                return io_cancelled("read")
            }
            let r = net_read_once(self.fd, &var into)
            if r == -SYS_WOULD_BLOCK {
                if net_deadline_passed(at) {
                    io_unwait(self.fd, 0)
                    return Timed<Int>.TimedOut
                }
                io_wait_until(self.fd, 0, at)          // park until readable or `at`
                __saw_rt_op_budget_reset()
            } else if r == NET_NO_SCRATCH {
                return IoError.of(syscall: "read",
                                  kind: IoErrorKind.ResourcesExhausted)
            } else if r < 0 {
                return io_error("read", -r)
            } else {
                count = r
                break
            }
        }
        if __saw_rt_op_budget_tick() != 0 {
            yield_now()
        }
        return Timed<Int>.Value(value: count)
    }

    // Write the whole Data buffer, parking on would-block until every byte is
    // sent. Returns Ok, or the write error. Bytes-typed so it can send
    // arbitrary binary.
    public func write(&self, bytes: Data) -> Result<Void, IoError> {
        var off = 0
        let total = bytes.len()
        while off < total {
            if cancelled() {
                io_unwait(self.fd, 1)                       // disarm the park
                return io_cancelled("write")   // cancelled at the park
            }
            let w = net_write_data_once(self.fd, &bytes, off)
            if w == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 1)            // park until writable
                __saw_rt_op_budget_reset()          // parked, so reset the budget
            } else if w < 0 {
                return io_error("write", -w)
            } else {
                off = off + w
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // fairness backstop
            yield_now()
        }
        return
    }

    // Write the whole string's bytes: the text overload of `write(bytes:)`, the
    // same park-until-sent loop over the string's UTF-8. The two overloads get
    // distinct frames because the coroutine transform keys driven-method
    // frames by resolved signature.
    public func write(&self, s: String) -> Result<Void, IoError> {
        // Staging the string's bytes can be refused, and this domain's word for
        // that is `ResourcesExhausted`, the one the read path's scratch failure
        // uses.
        let bytes = match s.to_data() {
            case Ok(d) -> move d,
            case Err(_) -> {
                return IoError.of("write", IoErrorKind.ResourcesExhausted)
            }
        }
        var off = 0
        let total = bytes.len()
        while off < total {
            if cancelled() {
                io_unwait(self.fd, 1)                       // disarm the park
                return io_cancelled("write")   // cancelled at the park
            }
            let w = net_write_data_once(self.fd, &bytes, off)
            if w == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 1)            // park until writable
                __saw_rt_op_budget_reset()          // parked, so reset the budget
            } else if w < 0 {
                return io_error("write", -w)
            } else {
                off = off + w
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // fairness backstop
            yield_now()
        }
        return
    }
}

extension TcpStream: NoCopy {
    public func deinit(&var self) {
        if self.fd >= 0 {
            tcp_close(self.fd)
        }
    }
}
