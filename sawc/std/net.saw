// std.net — minimal nonblocking TCP over the design-76 cooperative IO reactor.
//
// HOSTED-ONLY: links libc socket syscalls plus the compiler reactor seams
// (codegen/core.py); never loaded in the freestanding profile (a kernel supplies
// its own reactor via interrupts/WFI — see HOSTED_STD_MODULES in sawc.py).
//
// SURFACE SHAPE (reported): the cooperative-IO surface follows the SAME idiom the
// language already ships for channels — a NON-blocking `try_*` primitive plus a
// suspension point written in the caller's own task body:
//
//     while going {
//         let r = tcp_try_read(fd, buf, 64)
//         if net_would_block(r) {
//             io_wait(fd, 0)            // register (0=read) + park the TASK
//         } else {
//             n = r; going = false
//         }
//     }
//
// `io_wait(fd, write)` is a COMPILER INTRINSIC (like `yield_now`): it registers
// the fd with the reactor for read (write==0) or write (write==1) interest and
// suspends the task with an IO-ready wake reason. The executor polls the reactor
// when nothing is runnable (poll timeout = earliest sleep deadline) and wakes the
// task on readiness — so a blocked socket op never stalls a runnable peer and
// never busy-waits. This idiom lives in the user body because the coroutine
// transform is entry-module-only (a suspending std free function cannot embed as
// a sub-frame — the same reason `Channel.receive()` is inline-lowered). A
// first-class inline-lowered `tcp_read`/`tcp_accept`/`tcp_write` (receive()-style)
// is the ergonomic follow-up.

extern "C" {
    // POSIX socket calls (identical prototypes on macOS + Linux; the OS-divergent
    // bits — O_NONBLOCK, the EAGAIN/EINPROGRESS errno values, the sockaddr_in
    // family/len layout — live in the saw_* shims below).
    func socket(domain: Int32, ty: Int32, protocol: Int32) -> Int32
    func bind(fd: Int32, addr: UnsafePointer<Int8>, len: Int32) -> Int32
    func listen(fd: Int32, backlog: Int32) -> Int32
    func accept(fd: Int32, addr: UnsafePointer<Int8>, len: UnsafePointer<Int32>) -> Int32
    func connect(fd: Int32, addr: UnsafePointer<Int8>, len: Int32) -> Int32
    func getsockname(fd: Int32, addr: UnsafePointer<Int8>, len: UnsafePointer<Int32>) -> Int32
    func read(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func write(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func close(fd: Int32) -> Int32
    func socketpair(domain: Int32, ty: Int32, protocol: Int32, fds: UnsafePointer<Int32>) -> Int32

    // OS-divergent socket helpers + the reactor register seam (compiler-defined,
    // codegen/core.py). `saw_reactor_register` is emitted by the `io_wait`
    // intrinsic lowering, so it must be a namespace-visible symbol. `token`
    // (design 91) is the parked frame's `__wake`-word address, carried as the
    // event's user-data so the reactor wakes EXACTLY this frame on readiness.
    func saw_reactor_register(fd: Int, write: Int, token: Int)
    func saw_set_nonblocking(fd: Int) -> Int
    func saw_errno_would_block() -> Int
    // design 90: classify a re-issued nonblocking connect()'s errno —
    // 0 = connected (EISCONN), 1 = still connecting (EINPROGRESS/EALREADY),
    // 2 = failed. Lets connect() re-park on a spurious reactor wake.
    func saw_errno_connect_state() -> Int
    func saw_errno() -> Int
    // The ONLY OS-divergent piece of sockaddr_in: the sin_len/sin_family prefix
    // (macOS byte layout differs from Linux). Everything else is uniform
    // network-order data filled by `SockAddrIn` below.
    func saw_sin_set_family(buf: UnsafePointer<Int8>)

    // Bytes -> owned refcounted String (compiler runtime; see codegen/core.py).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// Named socket constants (same values on macOS + Linux). Reactor interest
// directions for `io_wait(fd, dir)`: 0 = read, 1 = write.
static AF_INET: Int32 = 2
static AF_UNIX: Int32 = 1
static SOCK_STREAM: Int32 = 1
static PROTO_DEFAULT: Int32 = 0
static LISTEN_BACKLOG: Int32 = 16
static SOCKADDR_IN_LEN: Int32 = 16
static READ_CHUNK: Int = 4096        // TcpStream.read stack-buffer chunk size
static WOULD_BLOCK: Int = -2         // the `tcp_try_*` would-block sentinel
static NET_ERROR: Int = -1           // the `tcp_*` error sentinel
static LOOPBACK_BE: UInt32 = 0x0100007f   // 127.0.0.1, network byte order (LE)

// `SockAddrIn` is a typed stack stand-in for `struct sockaddr_in`
// (declaration-order natural-ABI layout, design 58: 16 bytes, align 8 from the
// UInt64 — exceeds sockaddr_in's real requirement of 4). Its address is passed to
// bind/accept/connect/getsockname via the design-42 reference->pointer cast, so
// the socket paths allocate NOTHING per call. `port`/`addr` are stored in NETWORK
// byte order directly in Saw (see `htons`); the OS-divergent `family` prefix is
// stamped by `saw_sin_set_family`. FdPair is the 8-byte `int[2]` for socketpair.
struct SockAddrIn {
    family: UInt16    // OS-divergent prefix, stamped by saw_sin_set_family
    port: UInt16      // network byte order
    addr: UInt32      // network byte order (127.0.0.1 = 0x0100007F on LE)
    zero: UInt64      // padding
}

struct FdPair {
    a: Int32
    b: Int32
}

// host-order port -> network byte order (htons) as a native UInt16 whose bytes
// are [hi, lo]. Targets are little-endian (x86-64 / aarch64).
func htons(port: Int) -> UInt16 {
    (((port & 0xff) << 8) | ((port >> 8) & 0xff)) as UInt16
}

// network byte order UInt16 -> host-order port (ntohs).
func ntohs(net: UInt16) -> Int {
    let v = net as Int
    ((v & 0xff) << 8) | ((v >> 8) & 0xff)
}

// A stack `SockAddrIn` for 127.0.0.1:port with the OS-correct family prefix.
func net_sockaddr(port: Int) -> SockAddrIn {
    var sa = SockAddrIn(family: 0 as UInt16, port: htons(port), addr: LOOPBACK_BE, zero: 0 as UInt64)
    saw_sin_set_family((&sa) as UnsafePointer<Int8>)
    sa
}

// True for the would-block sentinel returned by the `tcp_try_*` primitives.
func net_would_block(r: Int) -> Bool {
    r == WOULD_BLOCK
}

// A heap read buffer, allocated ONCE per stream and reused across reads (freed
// with `net_free_buffer`). NOT per-call: the socket read/write paths themselves
// (`tcp_try_read`/`tcp_try_write`) allocate nothing — they take this pointer.
func net_buffer(size: Int) -> UnsafePointer<Int8> {
    if let p = GlobalAllocator().alloc(size, 1) {
        return p
    }
    panic("net_buffer: out of memory")
}

func net_free_buffer(buf: UnsafePointer<Int8>, size: Int) {
    GlobalAllocator().dealloc(buf, size, 1)
}

// Bytes -> owned String (convenience for tests / text protocols).
func net_bytes_to_string(buf: UnsafePointer<Int8>, len: Int) -> String {
    __saw_string_from_bytes(buf, len)
}

// Open a nonblocking listening TCP socket bound to 127.0.0.1:port. `port == 0`
// requests an ephemeral port (read it back with `tcp_local_port`). Returns the
// listen fd (>= 0) or -1.
func tcp_listen(port: Int) -> Int {
    let fd = socket(AF_INET, SOCK_STREAM, PROTO_DEFAULT)
    if fd < 0 {
        return NET_ERROR
    }
    let _ = saw_set_nonblocking(fd as Int)
    var sa = net_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    if bind(fd, ap, SOCKADDR_IN_LEN) != 0 {
        let _ = close(fd)
        return NET_ERROR
    }
    if listen(fd, LISTEN_BACKLOG) != 0 {
        let _ = close(fd)
        return NET_ERROR
    }
    fd as Int
}

// The actual local port a (possibly ephemeral) listen fd is bound to. -1 on error.
func tcp_local_port(fd: Int) -> Int {
    var sa = SockAddrIn(family: 0 as UInt16, port: 0 as UInt16, addr: 0 as UInt32, zero: 0 as UInt64)
    let ap = (&sa) as UnsafePointer<Int8>
    var len: Int32 = SOCKADDR_IN_LEN
    let lp = (&len) as UnsafePointer<Int32>
    let _ = getsockname(fd as Int32, ap, lp)
    ntohs(sa.port)
}

// Nonblocking accept: a nonblocking connection fd (>= 0), the would-block
// sentinel (-2) when no client is waiting, or -1 on error. Pair with
// `io_wait(listen_fd, 0)` on a would-block.
func tcp_try_accept(listen_fd: Int) -> Int {
    var sa = SockAddrIn(family: 0 as UInt16, port: 0 as UInt16, addr: 0 as UInt32, zero: 0 as UInt64)
    let ap = (&sa) as UnsafePointer<Int8>
    var len: Int32 = SOCKADDR_IN_LEN
    let lp = (&len) as UnsafePointer<Int32>
    let c = accept(listen_fd as Int32, ap, lp)
    if c >= 0 {
        let _ = saw_set_nonblocking(c as Int)
        return c as Int
    }
    if saw_errno_would_block() == 1 {
        return WOULD_BLOCK
    }
    NET_ERROR
}

// Start a nonblocking connect to 127.0.0.1:port. Returns a connecting fd (>= 0)
// or -1. Then `io_wait(fd, 1)` until writable and `tcp_connect_check(fd)`.
func tcp_connect_start(port: Int) -> Int {
    let fd = socket(AF_INET, SOCK_STREAM, PROTO_DEFAULT)
    if fd < 0 {
        return NET_ERROR
    }
    let _ = saw_set_nonblocking(fd as Int)
    var sa = net_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    let r = connect(fd, ap, SOCKADDR_IN_LEN)
    if r == 0 {
        return fd as Int              // connected immediately (common on loopback)
    }
    if saw_errno_would_block() == 1 {
        return fd as Int              // EINPROGRESS: wait for writability
    }
    let _ = close(fd)
    NET_ERROR
}

// Re-issue the nonblocking connect() to learn the true completion state (the
// reactor wakes ALL io-parked frames on any event, so a connect park can be woken
// BEFORE its own socket is writable — design 90). Returns 0 = connected, the
// would-block sentinel (-2) = still connecting (re-park), or -1 = failed. A
// re-connect returns EISCONN once the handshake completed, EINPROGRESS/EALREADY
// while still pending — far more reliable than trusting a single spurious wake.
func tcp_connect_check(fd: Int, port: Int) -> Int {
    var sa = net_sockaddr(port)
    let ap = (&sa) as UnsafePointer<Int8>
    let r = connect(fd as Int32, ap, SOCKADDR_IN_LEN)
    if r == 0 {
        return 0                          // connected on this call
    }
    let st = saw_errno_connect_state()
    if st == 0 {
        return 0                          // EISCONN — handshake complete
    }
    if st == 1 {
        return WOULD_BLOCK                // EINPROGRESS/EALREADY — keep waiting
    }
    NET_ERROR                             // a real connect failure
}

// Nonblocking read: byte count (0 = peer closed / EOF), the would-block sentinel
// (-2), or -1 on error. Pair with `io_wait(fd, 0)` on a would-block.
func tcp_try_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int {
    let n = read(fd as Int32, buf, len)
    if n >= 0 {
        return n
    }
    if saw_errno_would_block() == 1 {
        return WOULD_BLOCK
    }
    NET_ERROR
}

// Nonblocking write: bytes written (may be < len), the would-block sentinel (-2),
// or -1 on error. Pair with `io_wait(fd, 1)` on a would-block.
func tcp_try_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int {
    let n = write(fd as Int32, buf, len)
    if n >= 0 {
        return n
    }
    if saw_errno_would_block() == 1 {
        return WOULD_BLOCK
    }
    NET_ERROR
}

// Close a socket fd.
func tcp_close(fd: Int) {
    let _ = close(fd)
}

// A connected, nonblocking AF_UNIX stream pair for tests (no external network).
// Returns (a, b); (-1, -1) on failure.
func tcp_socketpair() -> (Int, Int) {
    var fds = FdPair(a: 0 as Int32, b: 0 as Int32)
    let fp = (&fds) as UnsafePointer<Int32>
    if socketpair(AF_UNIX, SOCK_STREAM, PROTO_DEFAULT, fp) == 0 {
        let a = unsafe fp[0]
        let b = unsafe fp[1]
        let _ = saw_set_nonblocking(a as Int)
        let _ = saw_set_nonblocking(b as Int)
        return (a as Int, b as Int)
    }
    (NET_ERROR, NET_ERROR)
}

// A sentinel fd for a closed / never-opened socket handle. `tcp_close` on it is a
// harmless no-op, so it is the safe placeholder inside the owning socket types.
static INVALID_FD: Int32 = -1

// One nonblocking read of up to READ_CHUNK bytes into a scratch buffer, appended
// to `into` (grows as needed). Returns the byte count (0 = peer closed / EOF), the
// would-block sentinel (-2), or -1 on error. The pointer work is confined here
// (raw layer); TcpStream.read drives it behind an io_wait park.
func net_read_once(fd: Int, into: &var Data) -> Int {
    if let ptr = unsafe GlobalAllocator().alloc(READ_CHUNK, 1) {
        let r = tcp_try_read(fd, ptr, READ_CHUNK)
        if r > 0 {
            into.append_bytes(ptr, r)
        }
        GlobalAllocator().dealloc(ptr, READ_CHUNK, 1)
        return r
    }
    NET_ERROR
}

// One nonblocking write of the tail of `s` starting at `off`. Returns bytes
// written (may be < remaining), the would-block sentinel (-2), or -1 on error.
func net_write_str_once(fd: Int, s: String, off: Int) -> Int {
    let ptr = s as UnsafePointer<Int8>
    tcp_try_write(fd, unsafe ptr + off, s.len() - off)
}

// One nonblocking write of the tail of `bytes` starting at `off`.
func net_write_data_once(fd: Int, bytes: &Data, off: Int) -> Int {
    let ptr = unsafe bytes.byte_ptr()
    tcp_try_write(fd, unsafe ptr + off, bytes.len() - off)
}

// =============================================================================
// IoError — errno-shaped error conforming to `Error` (design 56 / 84)
// =============================================================================

// Carries the failing syscall name plus its errno; prints via the `Error`
// (Printable) vtable, e.g. "io error: connect failed (errno 61)".
public struct IoError {
    syscall: String
    code: Int
}

extension IoError {
    public func errno(&self) -> Int {
        self.code
    }
}

extension IoError: Error {
    public func format(&self, into: &var StringBuilder) {
        into.append("io error: ")
        into.append(self.syscall)
        into.append(" failed (errno ")
        into.append(self.code)
        into.append(")")
    }
}

func io_error(syscall: String) -> IoError {
    IoError(syscall: syscall, code: saw_errno())
}

// =============================================================================
// TcpListener — an owning listening socket (design 84)
// =============================================================================
//
// NoCopy: the listen fd has exactly one owner; `Deinit` closes it exactly once
// (the move checkpoint prevents use-after-close, NoCopy prevents double-close).
// The fd is a PRIVATE field — the public surface exposes no raw fds or pointers.

public struct TcpListener {
    fd: Int32
}

extension TcpListener {
    // Bind + listen on 127.0.0.1:port (port 0 = an ephemeral port; read it back
    // with `local_port`). Returns the owning listener or an IoError.
    public func listen(port: Int) -> Result<TcpListener, IoError> {
        let fd = tcp_listen(port)
        if fd < 0 {
            return io_error("listen")
        }
        return TcpListener(fd: fd as Int32)
    }

    // The actual bound local port (resolves an ephemeral 0).
    public func local_port(&self) -> Int {
        tcp_local_port(self.fd as Int)
    }

    // Accept the next connection, returning its owning stream. COOPERATIVE: parks
    // on the listen fd (io_wait, hidden) until a connection arrives — a runnable
    // peer never stalls. Cancellation-observing at the park (design 76 A3).
    public func accept(&self) -> TcpStream {
        var cfd = INVALID_FD as Int
        var going = true
        while going {
            if cancelled() {
                going = false
            } else {
                let c = tcp_try_accept(self.fd as Int)
                if net_would_block(c) {
                    io_wait(self.fd as Int, 0)     // park until a client arrives
                } else if c < 0 {
                    yield_now()                    // transient error — avoid a spin
                } else {
                    cfd = c
                    going = false
                }
            }
        }
        TcpStream(fd: cfd as Int32)
    }
}

extension TcpListener: NoCopy {
    public func deinit(&var self) {
        if (self.fd as Int) >= 0 {
            tcp_close(self.fd as Int)
        }
    }
}

// =============================================================================
// TcpStream — an owning connected socket (design 84)
// =============================================================================
//
// NoCopy owning type; `Deinit` closes the conn fd exactly once. read/write park
// internally on would-block — application code never sees io_wait / a raw fd /
// a pointer.

public struct TcpStream {
    fd: Int32
}

extension TcpStream {
    // Connect to 127.0.0.1:port. COOPERATIVE: parks until the socket is writable
    // (connected). Returns the owning stream or an IoError.
    public func connect(host: String, port: Int) -> Result<TcpStream, IoError> {
        let fd = tcp_connect_start(port)
        if fd < 0 {
            return io_error("connect")
        }
        // Park until the connect completes, RE-VERIFYING each wake: the reactor's
        // coarse wake-all can rouse this park before our own socket is writable
        // (design 90). Loop like read/write/accept — re-check, re-park on
        // would-block — instead of trusting a single wake (which produced ENOTCONN
        // on a spurious rouse in a multi-connection workload).
        var going = true
        while going {
            let check = tcp_connect_check(fd, port)
            if net_would_block(check) {
                io_wait(fd, 1)             // still connecting — park until writable
            } else if check < 0 {
                tcp_close(fd)
                return io_error("connect")
            } else {
                going = false             // connected
            }
        }
        return TcpStream(fd: fd as Int32)
    }

    // A connected, nonblocking stream pair (AF_UNIX socketpair) — for tests and
    // local IPC, no bound port. Both ends are owning TcpStreams.
    public func pair() -> (TcpStream, TcpStream) {
        let p = tcp_socketpair()
        (TcpStream(fd: p.0 as Int32), TcpStream(fd: p.1 as Int32))
    }

    // Read the next chunk of bytes, appending to a freshly-returned Data. An EMPTY
    // result means the peer closed (EOF). COOPERATIVE: parks internally on
    // would-block until bytes arrive or the peer closes.
    public func read(&self) -> Data {
        var out = Data()
        var going = true
        while going {
            let r = net_read_once(self.fd as Int, &var out)
            if net_would_block(r) {
                io_wait(self.fd as Int, 0)     // park until readable
            } else {
                going = false                  // r >= 0: bytes appended (0 = EOF)
            }
        }
        return move out
    }

    // Write the WHOLE string, parking on would-block until every byte is sent.
    public func write_all_str(&self, s: String) {
        var off = 0
        let total = s.len()
        var going = true
        while going {
            let w = net_write_str_once(self.fd as Int, s, off)
            if net_would_block(w) {
                io_wait(self.fd as Int, 1)     // park until writable
            } else if w < 0 {
                going = false                  // error — bail
            } else {
                off = off + w
                if off >= total {
                    going = false
                }
            }
        }
    }

    // Write the WHOLE Data buffer, parking on would-block until it is all sent.
    public func write_all(&self, bytes: Data) {
        var off = 0
        let total = bytes.len()
        var going = true
        while going {
            let w = net_write_data_once(self.fd as Int, &bytes, off)
            if net_would_block(w) {
                io_wait(self.fd as Int, 1)
            } else if w < 0 {
                going = false
            } else {
                off = off + w
                if off >= total {
                    going = false
                }
            }
        }
    }
}

extension TcpStream: NoCopy {
    public func deinit(&var self) {
        if (self.fd as Int) >= 0 {
            tcp_close(self.fd as Int)
        }
    }
}
