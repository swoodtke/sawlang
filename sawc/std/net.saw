// std.net — minimal nonblocking TCP over the design-76 cooperative IO reactor.
//
// HOSTED-ONLY: links libc socket syscalls plus the compiler reactor seams
// (codegen/core.py); never loaded in the freestanding profile (a kernel supplies
// its own reactor via interrupts/WFI — see HOSTED_STD_MODULES in sawc.py).
//
// SURFACE SHAPE (reported): the cooperative-IO surface follows the SAME idiom the
// language already ships for channels — a NON-blocking `try_*` primitive plus a
// suspension point written in the caller's own task body:
//
//     while going {
//         let r = tcp_try_read(fd, buf, 64)
//         if net_would_block(r) {
//             io_wait(fd, 0)            // register (0=read) + park the TASK
//         } else {
//             n = r; going = false
//         }
//     }
//
// `io_wait(fd, write)` is a COMPILER INTRINSIC (like `yield_now`): it registers
// the fd with the reactor for read (write==0) or write (write==1) interest and
// suspends the task with an IO-ready wake reason. The executor polls the reactor
// when nothing is runnable (poll timeout = earliest sleep deadline) and wakes the
// task on readiness — so a blocked socket op never stalls a runnable peer and
// never busy-waits. This idiom lives in the user body because the coroutine
// transform is entry-module-only (a suspending std free function cannot embed as
// a sub-frame — the same reason `Channel.receive()` is inline-lowered). A
// first-class inline-lowered `tcp_read`/`tcp_accept`/`tcp_write` (receive()-style)
// is the ergonomic follow-up.

extern "C" {
    // A couple of raw socket calls std.net still spells directly (no errno branch):
    // the AF_UNIX test pair and fd close.
    func close(fd: Int32) -> Int32
    func socketpair(domain: Int32, ty: Int32, protocol: Int32, fds: UnsafePointer<Int32>) -> Int32

    // design 117: the status-carrying network ops (rt/common/os_ops.saw). Each
    // does its syscall and returns >= 0 on success/count or the NEGATED portable
    // SysError tag on failure (rt/ABI.md) — the errno accessors are gone.
    func __saw_rt_tcp_listen(port: Int) -> Int
    func __saw_rt_tcp_local_port(fd: Int) -> Int
    func __saw_rt_tcp_accept(listen_fd: Int) -> Int
    func __saw_rt_tcp_connect_start(addr_be: Int, port: Int) -> Int
    func __saw_rt_tcp_connect_check(fd: Int, addr_be: Int, port: Int) -> Int
    func __saw_rt_tcp_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int
    func __saw_rt_tcp_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) -> Int
    // The host errno -> portable SysError tag mapper (rt/*/net_os.saw). Its one
    // std caller is `IoError.from_errno`, which has no callers of its own —
    // file/directory/env build their errors from the tag their op returned. See
    // that factory's note and DF-215e: rt/ABI.md calls this seam
    // runtime-INTERNAL, so reading it at any distance from the failing op is the
    // clobber the design-117 status convention exists to make impossible.
    func __saw_rt_last_syserror() -> Int

    // design 184: hostname resolution, and the ONLY seam in std that is
    // `blocking`. `getaddrinfo` is unbounded — it may consult /etc/hosts, mDNS,
    // LDAP or the network and wait out a DNS timeout — so every call is
    // OFFLOADED to a worker thread by design 183's machinery and the calling
    // task parks, exactly as it does on a socket read. `blocking` is part of the
    // symbol's contract, so no other declaration of it can drop the annotation:
    // there is no way to spell a naked resolve, which is design 184's law and is
    // what `examples/errors/resolve_seam_must_be_blocking.saw` pins.
    //
    // Writes up to `max` addresses (network byte order) to `out` and returns the
    // count, `0` when the name has no IPv4 address, or a NEGATED SysError tag.
    // Both pointers must address the parked frame or the heap (design 183's
    // pointer rule) — the worker reads and writes through them while the task is
    // away.
    //
    // Called from `TcpStream.resolve_first`, which is a static METHOD for
    // exactly one reason: the transform embeds a suspending std method as a
    // sub-frame and cannot reach a std free function, so a resolve written as a
    // free helper would lower to a naked call and stop the executor for the
    // whole lookup. Pin: `examples/net_connect_by_name.saw`.
    blocking func __saw_rt_resolve_ipv4(host: UnsafePointer<Int8>,
                                        out: UnsafePointer<UInt32>,
                                        max: Int) -> Int

    // design 118 stage 3: the `io_wait` intrinsic lowering now emits the Saw
    // executor entry point `__saw_exec_io_register` (std/taskgroup.saw), which arms
    // the reactor through the `Reactor` trait — so net no longer declares the raw
    // `__saw_rt_reactor_register` seam (it is called only from taskgroup.saw).
    func __saw_rt_set_nonblocking(fd: Int) -> Int

    // design 89-c: the cooperative op-count budget seam (codegen/core.py). Each io
    // op that completes WITHOUT parking charges the budget; `__saw_rt_op_budget_tick()`
    // returns non-zero when the budget is exhausted (and resets it), signalling the
    // primitive to force a fairness `yield_now()`. `__saw_rt_op_budget_reset()` restores
    // the budget after a genuine park (the task already ceded to the scheduler).
    func __saw_rt_op_budget_tick() -> Int
    func __saw_rt_op_budget_reset()

    // Bytes -> owned refcounted String (compiler runtime; see codegen/core.py).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// Constants for the AF_UNIX test pair (the only raw socket call left in this
// file). The IP socket setup moved into rt/common/os_ops.saw (design 117).
static AF_UNIX: Int32 = 1
static SOCK_STREAM: Int32 = 1
static PROTO_DEFAULT: Int32 = 0
static READ_CHUNK: Int = 4096        // TcpStream.read chunk size
static WOULD_BLOCK: Int = -2         // the `tcp_try_*` would-block sentinel
static NET_ERROR: Int = -1           // the `tcp_*` error sentinel

// design 117: the portable SysError tags std.net branches on (the full space is
// documented in rt/ABI.md). A failing rt op returns the NEGATED tag; the raw
// `tcp_try_*` primitives translate that back to the WOULD_BLOCK/NET_ERROR
// sentinels their callers expect, while the owning types keep the tag for IoError.
static SYS_WOULD_BLOCK: Int = 1
static SYS_IN_PROGRESS: Int = 2
static SYS_INTERRUPTED: Int = 4
static SYS_NOT_FOUND: Int = 10
static SYS_OTHER: Int = 16

// How many addresses a resolution asks for. `connect` dials the FIRST answer,
// so one is all it needs; asking for more would copy words nothing reads.
// (Happy-eyeballs, which is what would want the rest, needs the dual-stack
// design first — see the tracker's design-184 future-work note.)
static RESOLVE_MAX: Int = 1

// FdPair is the 8-byte `int[2]` socketpair fills.
struct FdPair {
    a: Int32
    b: Int32
}

// True for the would-block sentinel returned by the `tcp_try_*` primitives.
func net_would_block(r: Int) -> Bool {
    r == WOULD_BLOCK
}

// A heap read buffer, allocated ONCE per stream and reused across reads (freed
// with `net_free_buffer`). NOT per-call: the socket read/write paths themselves
// (`tcp_try_read`/`tcp_try_write`) allocate nothing — they take this pointer.
func net_buffer(size: Int) unsafe -> UnsafePointer<Int8> {
    if let p = GlobalAllocator().alloc(size, 1) {
        return p
    }
    panic("net_buffer: out of memory")
}

func net_free_buffer(buf: UnsafePointer<Int8>, size: Int) unsafe {
    GlobalAllocator().dealloc(buf, size, 1)
}

// Bytes -> owned String (convenience for tests / text protocols).
func net_bytes_to_string(buf: UnsafePointer<Int8>, len: Int) unsafe -> String {
    __saw_string_from_bytes(buf, len)
}

// design 117: the raw `tcp_*` layer is now a thin translation over the status-
// carrying rt ops (rt/common/os_ops.saw). The rt ops return >= 0 on success or a
// NEGATED SysError tag; these wrappers map that back to the legacy WOULD_BLOCK
// (-2) / NET_ERROR (-1) sentinels the internal std.net callers and the white-box
// tests expect. The owning TcpListener/TcpStream types call the rt ops DIRECTLY
// so they keep the tag for a precise IoError.

// Fold an rt-op result into the legacy count / WOULD_BLOCK / NET_ERROR contract.
func net_sentinel(r: Int) -> Int {
    if r >= 0 {
        r
    } else if r == -SYS_WOULD_BLOCK {
        WOULD_BLOCK
    } else {
        NET_ERROR
    }
}

// Open a nonblocking listening TCP socket bound to 127.0.0.1:port. `port == 0`
// requests an ephemeral port (read it back with `tcp_local_port`). Returns the
// listen fd (>= 0) or -1.
func tcp_listen(port: Int) -> Int {
    net_sentinel(__saw_rt_tcp_listen(port))
}

// The actual local port a (possibly ephemeral) listen fd is bound to.
func tcp_local_port(fd: Int) -> Int {
    __saw_rt_tcp_local_port(fd)
}

// Nonblocking accept: a nonblocking connection fd (>= 0), the would-block
// sentinel (-2) when no client is waiting, or -1 on error.
func tcp_try_accept(listen_fd: Int) -> Int {
    net_sentinel(__saw_rt_tcp_accept(listen_fd))
}

// Start a nonblocking connect to `addr_be`:`port`, the address in network byte
// order (`ipv4_addr` / `parse_ipv4_literal` produce it). Returns a connecting fd
// (>= 0) or -1. Then `io_wait(fd, 1)` until writable and `tcp_connect_check`.
func tcp_connect_start(addr_be: Int, port: Int) -> Int {
    let r = __saw_rt_tcp_connect_start(addr_be, port)
    if r < 0 { NET_ERROR } else { r }
}

// Re-issue the nonblocking connect() to learn the true completion state
// (design 90); `addr_be` must be the address `tcp_connect_start` was given.
// Returns 0 = connected, the would-block sentinel (-2) = still connecting
// (re-park), or -1 = failed.
func tcp_connect_check(fd: Int, addr_be: Int, port: Int) -> Int {
    let r = __saw_rt_tcp_connect_check(fd, addr_be, port)
    if r == 0 {
        0
    } else if r == -SYS_IN_PROGRESS {
        WOULD_BLOCK
    } else {
        NET_ERROR
    }
}

// Nonblocking read: byte count (0 = peer closed / EOF), the would-block sentinel
// (-2), or -1 on error.
func tcp_try_read(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    net_sentinel(__saw_rt_tcp_read(fd, buf, len))
}

// Nonblocking write: bytes written (may be < len), the would-block sentinel (-2),
// or -1 on error.
func tcp_try_write(fd: Int, buf: UnsafePointer<Int8>, len: Int) unsafe -> Int {
    net_sentinel(__saw_rt_tcp_write(fd, buf, len))
}

// Close a socket fd.
func tcp_close(fd: Int) {
    let _ = close(fd)
}

// A connected, nonblocking AF_UNIX stream pair for tests (no external network).
// Returns (a, b); (-1, -1) on failure.
func tcp_socketpair() unsafe -> (Int, Int) {
    var fds = FdPair(a: 0 as Int32, b: 0 as Int32)
    let fp = (&fds) as UnsafePointer<Int32>
    if socketpair(AF_UNIX, SOCK_STREAM, PROTO_DEFAULT, fp) == 0 {
        let a = fp[0]
        let b = fp[1]
        let _ = __saw_rt_set_nonblocking(a as Int)
        let _ = __saw_rt_set_nonblocking(b as Int)
        return (a as Int, b as Int)
    }
    (NET_ERROR, NET_ERROR)
}

// =============================================================================
// IPv4 literals (design 184 unit 1)
// =============================================================================
//
// A dotted quad is an ADDRESS already — there is nothing to look up — so it is
// parsed here, in Saw, and never reaches the platform resolver or leaves the
// executor thread. Every `connect("127.0.0.1", port)` in the tree takes this
// path.

static ASCII_DOT: Int = 46
static ASCII_ZERO: Int = 48
static ASCII_NINE: Int = 57
static IPV4_MIN_TEXT: Int = 7        // "0.0.0.0"
static IPV4_MAX_TEXT: Int = 15       // "255.255.255.255"
static IPV4_OCTETS: Int = 4
static OCTET_MAX: Int = 255
static OCTET_MAX_DIGITS: Int = 3

// Four octets as the `sockaddr_in.sin_addr` word: the octets sit in memory in
// the order they are written, so on a little-endian target — the only kind the
// hosted runtime builds for, the same assumption `htons` states in
// rt/common/os_ops.saw — the FIRST octet is the low byte.
func ipv4_addr(a: UInt32, b: UInt32, c: UInt32, d: UInt32) -> UInt32 {
    a | (b << 8) | (c << 16) | (d << 24)
}

// A dotted-quad IPv4 literal as its address word, or `None` when `host` is not
// one (the caller then resolves it).
//
// STRICT on purpose: exactly four octets, one to three digits each, no leading
// zero, no sign, no spaces, nothing before or after. A near-miss like
// "127.00.0.1" is NOT guessed at here — it falls through to the platform
// resolver, whose reading of it is the authoritative one. Guessing would mean
// picking a side in the decades-old "is a leading zero octal?" ambiguity, which
// is a source of address confusion, not a convenience.
func parse_ipv4_literal(host: String) -> UInt32? {
    let n = host.len()
    if n < IPV4_MIN_TEXT || n > IPV4_MAX_TEXT {
        return None
    }
    var octets: [UInt32; IPV4_OCTETS] = [0; IPV4_OCTETS]
    var filled = 0        // octets already stored
    var value = 0         // the octet being accumulated
    var digits = 0        // digits seen in it
    var i = 0
    while i < n {
        let b = host.byte_at(i) as Int
        if b == ASCII_DOT {
            if digits == 0 || filled == IPV4_OCTETS - 1 {
                return None                      // empty octet, or a fifth one
            }
            octets[filled] = value as UInt32
            filled = filled + 1
            value = 0
            digits = 0
        } else if b < ASCII_ZERO || b > ASCII_NINE {
            return None                          // not a digit and not a dot
        } else {
            if digits == OCTET_MAX_DIGITS {
                return None
            }
            if digits == 1 && value == 0 {
                return None                      // a leading zero
            }
            value = value * 10 + (b - ASCII_ZERO)
            if value > OCTET_MAX {
                return None
            }
            digits = digits + 1
        }
        i = i + 1
    }
    if filled != IPV4_OCTETS - 1 || digits == 0 {
        return None                              // too few octets, or a trailing dot
    }
    octets[IPV4_OCTETS - 1] = value as UInt32
    return ipv4_addr(octets[0], octets[1], octets[2], octets[3])
}

// A sentinel fd for a closed / never-opened socket handle. `tcp_close` on it is a
// harmless no-op, so it is the safe placeholder inside the owning socket types.
static INVALID_FD: Int32 = -1

// One nonblocking read of up to READ_CHUNK bytes into a scratch buffer, appended
// to `into` (grows as needed). Returns the byte count (0 = peer closed / EOF) or
// a NEGATED SysError tag (design 117): the owning types keep the tag for a
// precise IoError. The pointer work is confined here (raw layer); TcpStream.read
// drives it behind an io_wait park.
func net_read_once(fd: Int, into: &var Data) unsafe -> Int {
    if let ptr = GlobalAllocator().alloc(READ_CHUNK, 1) {
        let r = __saw_rt_tcp_read(fd, ptr, READ_CHUNK)
        if r > 0 {
            into.append_bytes(ptr, r)
        }
        GlobalAllocator().dealloc(ptr, READ_CHUNK, 1)
        return r
    }
    return 0 - SYS_OTHER
}

// One nonblocking write of the tail of `s` starting at `off`. Returns bytes
// written (may be < remaining) or a NEGATED SysError tag (design 117).
func net_write_str_once(fd: Int, s: String, off: Int) unsafe -> Int {
    let ptr = s as UnsafePointer<Int8>
    __saw_rt_tcp_write(fd, ptr + off, s.len() - off)
}

// One nonblocking write of the tail of `bytes` starting at `off`.
func net_write_data_once(fd: Int, bytes: &Data, off: Int) unsafe -> Int {
    let ptr = bytes.byte_ptr()
    __saw_rt_tcp_write(fd, ptr + off, bytes.len() - off)
}

// =============================================================================
// IoError — errno-shaped error conforming to `Error` (design 56 / 84)
// =============================================================================

// Carries the failing syscall name plus its portable SysError tag (design 117 —
// no longer a raw errno); prints via the `Error` (Printable) vtable, e.g.
// "io error: connect failed (connection refused)".
public struct IoError {
    syscall: String
    code: Int
}

// The human name of a portable SysError tag (rt/ABI.md), for IoError.format.
func sys_error_name(tag: Int) -> String {
    match tag {
        case 0 -> "ok",
        case 1 -> "would block",
        case 2 -> "in progress",
        case 3 -> "already connected",
        case 4 -> "interrupted",
        case 5 -> "connection reset",
        case 6 -> "connection refused",
        case 7 -> "connection aborted",
        case 8 -> "broken pipe",
        case 9 -> "not connected",
        case 10 -> "not found",
        case 11 -> "permission denied",
        case 12 -> "already exists",
        case 13 -> "address in use",
        case 14 -> "invalid argument",
        case 15 -> "resources exhausted",
        // The REMOTE-reach failures (DF-215a). Every one of these can only
        // happen off loopback, which is why the suite never produced one and
        // why all five read as "other error" until the map named them.
        case 17 -> "host unreachable",
        case 18 -> "network unreachable",
        case 19 -> "timed out",
        case 20 -> "host is down",
        case 21 -> "network is down",
        case _ -> "other error"
    }
}

extension IoError {
    // The portable SysError TAG of the failure — the small fixed tag space in
    // rt/ABI.md, and NOT an OS errno. The two are different numbering systems
    // that overlap: tag 16 is `Other`, errno 16 is `EBUSY`.
    //
    // This was spelled `errno()` until DF-215a, where a reader took the 16 it
    // returned for a real errno. The raw OS number is not carried across the
    // seam at all, and deliberately (design 117): a failing op returns ONE word
    // holding its result or `-tag`, which is what makes the convention map onto
    // the SOS `(status, value)` pair — and SOS has no errno to put in it. So the
    // honest fix is the name. `format` renders the same tag as its human word.
    public func code(&self) -> Int {
        self.code
    }

    // Capture the CURRENT failure as a portable SysError tag. VALID ONLY on the
    // statement after a failing `__saw_rt_*` op: it reads the calling thread's
    // errno through a seam rt/ABI.md documents as runtime-INTERNAL, and anything
    // running in between clobbers it (the v1 `tcp_listen` bug — a `close()`
    // between a failed `bind()` and the errno read).
    //
    // NO CALLERS, and the comment that used to sit here claimed the wrong job:
    // file/directory/env build their errors with `of(syscall, -e)` on the tag
    // their op already returned, which needs no errno read at all and has been
    // the shape since design 117. Whether this factory should exist is DF-215e.
    public func from_errno(syscall: String) -> IoError {
        IoError(syscall: syscall, code: __saw_rt_last_syserror())
    }

    // Build an IoError from a syscall name + a portable SysError tag.
    public func of(syscall: String, tag: Int) -> IoError {
        IoError(syscall: syscall, code: tag)
    }
}

extension IoError: Error {
    public func format(&self, into: &var StringBuilder) {
        into.append("io error: ")
        into.append(self.syscall)
        into.append(" failed (")
        into.append(sys_error_name(self.code))
        into.append(")")
    }
}

func io_error(syscall: String, tag: Int) -> IoError {
    IoError(syscall: syscall, code: tag)
}

// A failed resolution, NAMING THE HOST. The host IS the failure here — an error
// that does not say which name could not be resolved is unactionable — so it
// goes in the syscall slot and prints as `io error: resolve "db.internal"
// failed (not found)`.
func resolve_error(host: String, tag: Int) -> IoError {
    var what = StringBuilder()
    what.append("resolve \"")
    what.append(host)
    what.append("\"")
    io_error(what.build(), tag)
}

// =============================================================================
// TcpListener — an owning listening socket (design 84)
// =============================================================================
//
// NoCopy: the listen fd has exactly one owner; `Deinit` closes it exactly once
// (the move checkpoint prevents use-after-close, NoCopy prevents double-close).
// The fd is a PRIVATE field — the public surface exposes no raw fds or pointers.

public struct TcpListener {
    fd: Int
}

extension TcpListener {
    // Bind + listen on 127.0.0.1:port (port 0 = an ephemeral port; read it back
    // with `local_port`). Returns the owning listener or an IoError.
    public func listen(port: Int) -> Result<TcpListener, IoError> {
        let fd = __saw_rt_tcp_listen(port)
        if fd < 0 {
            return io_error("listen", -fd)
        }
        return TcpListener(fd: fd)
    }

    // The actual bound local port (resolves an ephemeral 0).
    public func local_port(&self) -> Int {
        tcp_local_port(self.fd)
    }

    // Accept the next connection, returning its owning stream or an IoError.
    // COOPERATIVE: parks on the listen fd (io_wait, hidden) until a connection
    // arrives — a runnable peer never stalls. Cancellation-observing at the park
    // (design 76 A3). A genuine accept failure surfaces as Err(IoError) — design
    // 92: a broken accept must NOT be indistinguishable from a live stream.
    public func accept(&self) -> Result<TcpStream, IoError> {
        while {
            if cancelled() {
                // DF-134a: leaving the loop without our event firing would strand
                // the armed registration, whose token is an address inside this
                // frame. Disarm before returning.
                io_unwait(self.fd, 0)
                return io_error("accept", SYS_INTERRUPTED)   // cancelled before a connection
            }
            let c = __saw_rt_tcp_accept(self.fd)
            if c == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)                // park until a client arrives
                __saw_rt_op_budget_reset()             // design 89-c: parked, budget reset
            } else if c < 0 {
                return io_error("accept", -c)      // a real accept error
            } else {
                if __saw_rt_op_budget_tick() != 0 {     // design 89-c: fairness backstop
                    yield_now()                    // ran the budget out without parking
                }
                return TcpStream(fd: c)            // got a connection
            }
        }
    }
}

extension TcpListener: NoCopy {
    public func deinit(&var self) {
        if self.fd >= 0 {
            tcp_close(self.fd)
        }
    }
}

// =============================================================================
// TcpStream — an owning connected socket (design 84)
// =============================================================================
//
// NoCopy owning type; `Deinit` closes the conn fd exactly once. read/write park
// internally on would-block — application code never sees io_wait / a raw fd /
// a pointer.

public struct TcpStream {
    fd: Int
}

extension TcpStream {
    // Connect to `host`:`port`, where `host` is a dotted-quad IPv4 literal or a
    // name to resolve. COOPERATIVE throughout: a name is resolved on a worker
    // thread while siblings run, and the dial then parks until the socket is
    // writable (connected). Returns the owning stream or an IoError — one that
    // NAMES THE HOST when the name is the thing that failed.
    //
    // design 184: `host` used to be ignored outright, so `connect("example.com",
    // 80)` dialled 127.0.0.1:80 and reported success (DF-181d).
    public func connect(host: String, port: Int) -> Result<TcpStream, IoError> {
        // The literal fast path (design 184 unit 1). A dotted quad is an address
        // already, so it is parsed here, in Saw, and dialled directly — no libc,
        // no resolver, no thread hop, and no way for a literal caller to pay for
        // the resolver's existence.
        if let literal = parse_ipv4_literal(host) {
            return TcpStream.dial(literal as Int, port)
        }
        // A NAME. `getaddrinfo` is unbounded, so the lookup runs on a worker
        // thread and this task PARKS while siblings run (design 183's offload
        // over design 184's `blocking` seam). Design 184's law: resolution never
        // stops the executor. `examples/net_connect_by_name.saw` pins the
        // interleave that proves it.
        let first = TcpStream.resolve_first(host)
        if first < 0 {
            return resolve_error(host, -first)
        }
        return TcpStream.dial(first, port)
    }

    // The FIRST IPv4 address `host` resolves to, as the address word the dial
    // seam takes, or a NEGATED SysError tag — std.net's house convention for a
    // raw op, and collision-free here because every address word is >= 0. A
    // resolver that succeeds and offers no IPv4 address answers `-NotFound`:
    // "nowhere to dial" is a failure to the one caller this has.
    //
    // A static METHOD, and deliberately: the transform embeds a suspending std
    // method as a sub-frame and cannot reach a std FREE function, so the same
    // code written as a free helper would run its `blocking` seam outside a
    // frame — a naked call holding the executor thread for the whole lookup.
    // `unsafe` confines the pointer work (design 130) so `connect` keeps a safe
    // signature.
    //
    // `found` is a frame local, so it is heap-resident for the whole park and
    // the worker may write through the pointer while this task is away — design
    // 183's pointer rule, which is why the buffer is not a stack temporary.
    func resolve_first(host: String) unsafe -> Int {
        var found: [UInt32; RESOLVE_MAX] = [0; RESOLVE_MAX]
        let n = __saw_rt_resolve_ipv4(host as UnsafePointer<Int8>,
                                      (&found) as UnsafePointer<UInt32>,
                                      RESOLVE_MAX)
        if n < 0 {
            return n
        }
        if n == 0 {
            return 0 - SYS_NOT_FOUND
        }
        return found[0] as Int
    }

    // Dial `addr`:`port` (the address in network byte order) and park until the
    // socket is writable. Shared by both `connect` paths, so a name and a
    // literal reach their peer through exactly the same code.
    func dial(addr: Int, port: Int) -> Result<TcpStream, IoError> {
        let fd = __saw_rt_tcp_connect_start(addr, port)
        if fd < 0 {
            return io_error("connect", -fd)
        }
        // Park until the connect completes, RE-VERIFYING each wake: the reactor's
        // coarse wake-all can rouse this park before our own socket is writable
        // (design 90). Loop like read/write/accept — re-check, re-park on
        // would-block — instead of trusting a single wake (which produced ENOTCONN
        // on a spurious rouse in a multi-connection workload).
        while {
            if cancelled() {
                io_unwait(fd, 1)           // DF-134a: disarm before the fd goes
                tcp_close(fd)              // design 102: cancelled while connecting
                return io_error("connect", SYS_INTERRUPTED)
            }
            let check = __saw_rt_tcp_connect_check(fd, addr, port)
            if check == -SYS_IN_PROGRESS {
                io_wait(fd, 1)             // still connecting — park until writable
                __saw_rt_op_budget_reset()      // design 89-c: parked, budget reset
            } else if check < 0 {
                tcp_close(fd)
                return io_error("connect", -check)
            } else {
                break                         // connected
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // design 89-c: fairness backstop
            yield_now()
        }
        return TcpStream(fd: fd)
    }

    // A connected, nonblocking stream pair (AF_UNIX socketpair) — for tests and
    // local IPC, no bound port. Both ends are owning TcpStreams.
    public func pair() -> (TcpStream, TcpStream) {
        let p = tcp_socketpair()
        (TcpStream(fd: p.0), TcpStream(fd: p.1))
    }

    // Read the next chunk of bytes. On success returns the chunk as owned Data —
    // an EMPTY Ok means the peer closed cleanly (EOF). A genuine read failure is
    // Err(IoError), DISTINCT from EOF (design 92: an empty Data can no longer mean
    // BOTH close and failure — an Err is now unmistakable). COOPERATIVE: parks
    // internally on would-block until bytes arrive or the peer closes.
    //
    // (Returns the chunk BY VALUE rather than filling a `&var Data`: an in-out
    // reference parameter cannot be held across this method's internal io_wait
    // suspension — the coroutine transform opt-encodes across-suspend locals but
    // not a live reference param, the same limitation design 84 met. The Result
    // still makes error distinct from EOF, which is the requirement.)
    public func read(&self) -> Result<Data, IoError> {
        var out = Data()
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // DF-134a: disarm the park
                return io_error("read", SYS_INTERRUPTED)   // design 102: peer-cancelled at the park
            }
            let r = net_read_once(self.fd, &var out)
            if r == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)            // park until readable
                __saw_rt_op_budget_reset()          // design 89-c: parked, budget reset
            } else if r < 0 {
                return io_error("read", -r)    // a real read error, not EOF
            } else {
                break                          // r >= 0: bytes read (0 = EOF)
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // design 89-c: fairness backstop
            yield_now()                        // always-ready read: cede periodically
        }
        return move out
    }

    // Read the next chunk of bytes and APPEND them into the caller's `into`
    // buffer, returning the byte count (0 = the peer closed cleanly / EOF), or
    // Err(IoError) on a genuine read failure (distinct from EOF, design 92). The
    // in-out `&var Data` is held across this method's internal io_wait suspension —
    // design 88 (D6): a reference parameter is frame-resident across a suspend, so
    // the append after the park writes back to the SAME caller buffer. Offered
    // ALONGSIDE the value `read()` (which allocates a fresh Data): `read_into` lets
    // a caller ACCUMULATE across successive reads into one growing buffer with no
    // per-chunk allocation (design 96 unblocked it — a `&var Data` read is a
    // suspending method, and driving one from a spawned worker or a nested frame
    // works now). COOPERATIVE: parks internally on would-block until bytes arrive.
    public func read_into(&self, into: &var Data) -> Result<Int, IoError> {
        var count = 0
        while {
            if cancelled() {
                io_unwait(self.fd, 0)                      // DF-134a: disarm the park
                return io_error("read", SYS_INTERRUPTED)   // design 102: cancelled at park
            }
            // Design 106: FORWARD the held `&var into` straight to the raw-layer
            // helper (`net_read_once` owns the scratch buffer + the append). The
            // reference param is re-borrowed onward across this method's io_wait
            // park — design 88 makes `into` a frame-resident pointer, and the
            // forwarding call passes that same pointer through with no per-chunk
            // buffer management here. (Pre-106 this had to inline net_read_once's
            // body — a reference param could not be the operand of `&var`.)
            let r = net_read_once(self.fd, &var into)
            if r == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 0)                    // park until readable
                __saw_rt_op_budget_reset()                  // design 89-c: parked, reset
            } else if r < 0 {
                return io_error("read", -r)            // a real read error, not EOF
            } else {
                count = r                              // r >= 0: bytes read (0 = EOF)
                break
            }
        }
        if __saw_rt_op_budget_tick() != 0 {                 // design 89-c: fairness backstop
            yield_now()
        }
        return count
    }

    // Write the WHOLE Data buffer, parking on would-block until every byte is
    // sent. Returns Ok on success or the write error honestly (design 92 — this
    // REPLACES the old Void `write_all`/`write_all_str` that silently swallowed a
    // hard write error). Bytes-typed so it can send arbitrary binary.
    public func write(&self, bytes: Data) -> Result<Void, IoError> {
        var off = 0
        let total = bytes.len()
        while off < total {
            if cancelled() {
                io_unwait(self.fd, 1)                       // DF-134a: disarm the park
                return io_error("write", SYS_INTERRUPTED)   // design 102: cancelled at the park
            }
            let w = net_write_data_once(self.fd, &bytes, off)
            if w == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 1)            // park until writable
                __saw_rt_op_budget_reset()          // design 89-c: parked, budget reset
            } else if w < 0 {
                return io_error("write", -w)
            } else {
                off = off + w
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // design 89-c: fairness backstop
            yield_now()
        }
        return
    }

    // Write the whole string's bytes (design 95 — the text overload of
    // `write(bytes: Data)`, re-added once the coroutine transform learned to
    // key driven-method frames by resolved signature, so the two overloads get
    // distinct frames). Same park-until-sent loop over the string's UTF-8.
    public func write(&self, s: String) -> Result<Void, IoError> {
        let bytes = s.to_data()
        var off = 0
        let total = bytes.len()
        while off < total {
            if cancelled() {
                io_unwait(self.fd, 1)                       // DF-134a: disarm the park
                return io_error("write", SYS_INTERRUPTED)   // design 102: cancelled at the park
            }
            let w = net_write_data_once(self.fd, &bytes, off)
            if w == -SYS_WOULD_BLOCK {
                io_wait(self.fd, 1)            // park until writable
                __saw_rt_op_budget_reset()          // design 89-c: parked, budget reset
            } else if w < 0 {
                return io_error("write", -w)
            } else {
                off = off + w
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // design 89-c: fairness backstop
            yield_now()
        }
        return
    }
}

extension TcpStream: NoCopy {
    public func deinit(&var self) {
        if self.fd >= 0 {
            tcp_close(self.fd)
        }
    }
}
