//! State that is computed once and read everywhere after.
//!
//! A `static` is image bytes: Saw has no life-before-main and no static
//! constructors, so a global whose initial value has to be computed cannot be a
//! static initializer in any form. `Once<T>` covers the common case: state set
//! once, at a moment the program picks, and read as a plain value from then on:
//!
//! ```saw
//! import std.once.*
//!
//! struct Limits {
//!     workers: Int,
//!     queue: Int
//! }
//!
//! static LIMITS: Once<Limits>          // zero is UNSET; bss, no image bytes
//!
//! func boot() {
//!     LIMITS.set(Limits(workers: cpu_count(), queue: cpu_count() * 64))
//! }
//!
//! func workers() -> Int {              // a SAFE function, no `unsafe` anywhere
//!     LIMITS.get().workers
//! }
//! ```
//!
//! State mutated throughout the program's life is `unsafe static var` and the
//! author's own serialization argument. A `Once` is not mutable state; it is a
//! value that has not arrived yet.
//!
//! A `Once` is an `Atomic` state word beside an interior cell holding the `T`.
//! Zero is unset, so a static needs no initializer and an unset `Once` costs no
//! image bytes. The publish/read ordering lives inside the type: storing the
//! payload and announcing it are two writes, and only a release/acquire pair
//! keeps a reader from seeing the second without the first.
//!
//! A second `set` panics, and a `get` before any `set` panics. Both are program
//! bugs (in the boot order and the call order), not conditions to branch on.
//! `try_get() -> T?` is for code that genuinely does not know yet.
//!
//! It does not block. A `get` racing the `set` that will satisfy it takes the
//! not-yet-initialized panic rather than waiting.
//!
//! A `Once` is declared, not constructed: the unset state is the zero pattern,
//! so a bare `static` is the only spelling it needs and there is no `init`. A
//! static never runs deinit, so `T` must be trivially destructible; a `Once`
//! holding a `String` would be a static that leaks one.

// Zero must be `Unset`: that is what makes a bare `static POOL: Once<T>` legal.
// `Atomic<Int>` is the only atomic, so each use site projects with `as Int`.
enum State: Int {
    case Unset = 0,
    case Setting = 1,
    case Ready = 2
}

static_assert((State.Unset as Int) == 0, "zero must mean UNSET")

/// A value written once and read many times.
///
/// `NoCopy` — a copied `Once` is a second, independent slot, so the copy would
/// silently accept its own `set` and the two would disagree forever.
///
/// A `Once` is `Sync` when `T` is both `Send` (`get` hands a copy to whichever
/// thread asked) and `Sync` (two readers may copy the stored value at once,
/// which for a refcounted payload is two retains of one control block).
public struct Once<T> {
    private state: Atomic<Int>,
    private value: UnsafeMutableInterior<T>
}

extension Once<T>: NoCopy {}
extension Once<T: Send + Sync>: UnsafeSync {}

extension Once<T> {
    /// Publishes `value`, once.
    ///
    /// Panics if this `Once` already holds a value, or if another thread is
    /// setting it at this instant: racing setters resolve rather than
    /// interleave, and every loser panics.
    public func set(&self, value: T) unsafe {
        if not self.state.compare_exchange(State.Unset as Int, State.Setting as Int) {
            panic("Once.set: already initialized (a Once is written once)")
        }
        self.value.ptr()[0] = value
        // Release-publish. Every atomic in Saw is seq_cst, so this store cannot
        // be reordered ahead of the payload write and no reader can see `Ready`
        // without also seeing the bytes.
        self.state.store(State.Ready as Int)
    }

    /// Whether a value has been published.
    ///
    /// The answer can be stale before it is read, so branching on it to decide
    /// whether to `set` is a race; `set` itself is what resolves that.
    public func is_set(&self) -> Bool {
        self.state.load() == (State.Ready as Int)
    }
}

// The readers spell `.copy()`, which the `ExplicitCopy` bound licenses; the
// whole duplicable family qualifies.
extension Once<T: ExplicitCopy> {
    /// The published value.
    ///
    /// Panics if nothing has been published yet. Reading a value that has not
    /// been computed is a bug in the call order, not a condition; `try_get` is
    /// the spelling for code that genuinely does not know.
    public func get(&self) unsafe -> T {
        // Acquire-read, pairing with `set`'s release store: seeing `Ready` here
        // means seeing the payload write that preceded it.
        if self.state.load() != (State.Ready as Int) {
            panic("Once.get: read before initialization")
        }
        self.value.ptr()[0].copy()
    }

    /// The published value, or `None` when nothing has been published yet.
    ///
    /// Reach for it where "not yet" is a real state of the program rather than
    /// a mistake: a diagnostic dump, a component that starts before the thing it
    /// reports on.
    public func try_get(&self) unsafe -> T? {
        if self.state.load() != (State.Ready as Int) {
            return None
        }
        self.value.ptr()[0].copy()
    }
}
