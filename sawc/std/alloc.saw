//! Allocation: the `Allocator` trait, `GlobalAllocator`, and `AllocError`.
//!
//! ## What happens when the allocator says no
//!
//! It tells you. Every allocating operation in the standard library returns
//! `Result<_, AllocError>` — `Vector.push`, `Box.make`, `StringBuilder.append`,
//! `Map.insert`, `Vector(capacity:)` and the rest of the constructors — and the
//! error carries the size and alignment of the request that was refused, so an
//! out-of-memory site stays loggable with context.
//!
//! ```saw
//! var frames = Vector<Frame, FrameSlab>()
//! match frames.push(Frame(id: 1)) {
//!     case Ok(_) -> print("queued"),
//!     case Err(e) -> print("out of frame memory: {e}")
//! }
//! ```
//!
//! `try!` is the spelling for code that would rather die than handle it, and it
//! panics naming the error. Nothing truncates, returns a plausible substitute,
//! or hands back an object that has quietly stopped working; and no operation
//! partially applies itself: on `Err` the container is exactly as it was. The
//! `try_` prefix means non-blocking (`try_receive`, `try_lock`), not
//! "reports allocation failure".
//!
//! Five places panic, each because the report has nowhere to go:
//!
//! - the allocations the compiler inserts (string interpolation, an escaping
//!   closure's captured environment, a coroutine frame, a spawn's control
//!   block). `--no-hidden-alloc` rejects the ones no source construct names
//!   (interpolation, an escaping closure's environment); a spawn's control
//!   block and frame are allowed because the spawn call names them;
//! - a collection literal, whose element pushes are synthesized;
//! - `copy()`, the `ExplicitCopy` hook, whose signature belongs to the trait;
//! - `Data`'s subscript, whose copy-on-write separation shares a body with the
//!   bounds check (`detached()` is the preflight that reports instead);
//! - `String` producers, which return a plain `String`.
//!
//! A type parameterized by its allocator (`Vector<T, A>`, `Box<T, A>`,
//! `Map<K, V, A>`, `Set<T, A>`) is the freestanding toolkit. Types with no
//! allocator parameter (`String`, `StringBuilder`, `Data`, `Arc`, `Channel`)
//! allocate through `GlobalAllocator`.

// Containers route every allocation through the `Allocator` trait rather than
// calling the `__saw_rt_alloc`/`__saw_rt_dealloc` seams directly, so a custom
// allocator is a distinct type end to end and `Vector<T>` fills the default.

// Hosted defaults wrap malloc/free; the freestanding profile leaves these as
// declarations the user's environment provides at link time. All std files
// share one namespace, so the container modules use these declarations.
extern "C" {
    func __saw_rt_alloc(size: Int, align: Int) -> UnsafePointer<Int8>?
    func __saw_rt_dealloc(ptr: UnsafePointer<Int8>, size: Int, align: Int)
}

/// The allocation contract every container routes through.
///
/// An implementation reports exhaustion by returning `None` from `alloc`; the
/// caller turns that into an `AllocError`. `dealloc` must be handed the same
/// `size`/`align` the block was allocated with: the seams carry no per-block
/// metadata, so the container remembers the layout.
///
/// Both requirements are `unsafe` because each names a raw pointer. `dealloc`'s
/// precondition (the pointer came from this allocator, with this layout) is
/// carried to the caller by its unsafe-typed parameter.
public trait Allocator {
    func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>?
    func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe
}

// Zero-sized: `GlobalAllocator().alloc(...)` monomorphizes to a direct call into
// the seam with no allocator value materialized at runtime.
public struct GlobalAllocator {}

extension GlobalAllocator: Allocator {
    public func alloc(&self, size: Int, align: Int) unsafe -> UnsafePointer<Int8>? {
        __saw_rt_alloc(size, align)
    }

    public func dealloc(&self, ptr: UnsafePointer<Int8>, size: Int, align: Int) unsafe {
        __saw_rt_dealloc(ptr, size, align)
    }
}

/// The error an allocating operation reports: the allocator refused a request.
///
/// `size` is the byte count that was asked for and `align` its alignment, so an
/// out-of-memory site can be logged with enough context to tell a 24-byte
/// control block apart from a doubling buffer. It conforms to `Error`, so it
/// boxes into a `Result<T, Box<any Error>>` boundary like any other error, and
/// it is `Printable`.
public struct AllocError {
    /// Byte count of the request that failed.
    public size: Int
    /// Alignment of the request that failed.
    public align: Int
}

extension AllocError: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append("allocation of ")
        try! into.append(self.size)
        try! into.append(" bytes (align ")
        try! into.append(self.align)
        try! into.append(") failed")
    }
}
