// TaskGroup — the structured-concurrency nursery (design 18 C1, design 52b).
//
// A `TaskGroup` is a local. `group.spawn(f(args))` is compiler-lowered (like
// `__saw_drive`): the coro transform turns `f` into a frame + `Resumable`
// conformance, and the synthesized `__spawn_f` helper builds the frame, boxes it
// erased (`Box<any Resumable>`, design 51), enqueues it here, and hands back a
// typed `TaskHandle<T>`. The group's `Deinit` DRAINS every child to completion
// (structured join = LIFO destruction): no global queue, no static, no forced
// destroy — the only frame drop is a Box teardown after the child is Done.
//
// The parallel vectors are the run queue and the scheduler bookkeeping:
//   * `tasks`     — the erased frames (`resume`/`__wake_reason` dispatch here).
//                   `None` once the task completes: design 134 releases the frame
//                   box AT completion, so a Done slot holds no frame at all.
//   * `cells`     — the per-task result/cancel cell (design 134), which OUTLIVES
//                   the frame: `TaskHandle` points here, never into the frame.
//   * `done`      — per-task completion; a Done frame is never resumed again (its
//                   dispatch loop is guarded but re-resuming would busy-spin).
//   * `remaining` — ms until this task should next resume: 0 = ready now (yield /
//                   channel-retry), >0 = sleeping. Earliest-deadline scheduling
//                   over relative sleeps (no wall clock needed).
//
// COEXISTENCE (design 21b): the DEFAULT `TaskGroup()` is the COOPERATIVE
// single-threaded engine — tasks are stackless coroutine frames driven on the
// current thread. The 21b `spawn { ... } -> Task<T>` engine (one OS thread per
// task) is untouched and orthogonal; the two do not share a scheduler. Cross-task
// sharing in both is `Arc`/`Mutex`/`Channel` only (references never cross a spawn —
// paper 18).
//
// MULTI-THREADED MODE (design 75 A2): `TaskGroup(threads: N)` (N>=2) runs a
// fork-join drain — a mutex-protected SHARED run queue (the sanctioned "one
// injector + N workers", simplicity over per-worker lock-free deques v1) drained
// by N OS worker threads. A drain is triggered lazily by `join()` / Deinit; it
// spawns N `Task<Int>` workers (via the 21b engine), each of which claims a
// runnable frame under the lock, resumes it OUTSIDE the lock, and records the
// outcome — then the drain joins all workers (a full barrier making every
// `__result` visible). Frames move between threads only BETWEEN suspensions (a
// claimed frame is owned by exactly one worker while it runs — paper 18's D6
// confinement); the `active` flag enforces one-worker-per-frame. Enqueue is
// main-thread-only (no worker is alive outside a drain), so the run queue never
// resizes during a drain — `tasks` is only borrowed (`with_var_ref`) or cleared
// in place (design 134's frame release) while workers run, never resized, and
// the scheduler's bookkeeping vectors are mutated only under the lock. The slot
// IDENTITY vectors (`gen`/`free`/`pin`) are the exception, reachable only from a
// handle and therefore never touched while a worker is alive — see the
// slot-identity trio below for why that holds.

extern "C" {
    // pthread mutex seam (resolves from libSystem/libc; init wrapper in codegen).
    // Same symbols std/channel.saw + std/mutex.saw use — one shared libc binding.
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<Int8>)
    func pthread_mutex_lock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_unlock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_destroy(m: UnsafePointer<Int8>) -> Int

    // design 117 / 118 stage 3: the INSTANCE-based IO reactor seams (kqueue on
    // macOS, epoll on Linux; bodies in sawc/rt/host_*/reactor.saw). All take the
    // opaque reactor instance `r` (from `__saw_rt_reactor_create`) as their first
    // argument — the executor threads it explicitly now (the compiler no longer
    // injects a process-global instance; the singleton is the Saw
    // `__saw_host_reactor()` below). The `SystemReactor` type wraps these as the
    // hosted `Reactor` trait impl.
    func __saw_rt_reactor_create() -> Int
    func __saw_rt_reactor_destroy(r: Int)
    // Arm one-shot readiness on `fd` in `r` (write==0 => read). `token` is the
    // parked frame's `__wake`-word address (design 91 precise routing).
    func __saw_rt_reactor_register(r: Int, fd: Int, write: Int, token: Int)
    // Block up to `timeout_ms` (< 0 = forever); latch each ready token; return the
    // ready-event count.
    func __saw_rt_reactor_poll(r: Int, timeout_ms: Int) -> Int
    // design 102 item 2: rouse a blocked poll by writing one byte to `r`'s self-wake
    // pipe, so an ALREADY-io-parked task's poll returns and the scheduler re-checks
    // its cancel flag.
    func __saw_rt_reactor_wake(r: Int)

    // design 45 / 118: the host timer seam. `__saw_exec_sleep` (below) wraps it as
    // the executor's OWN (non-suspending) blocking sleep — used to honour a task's
    // sleep wake reason and to nap between MT-worker re-scans.
    func __saw_rt_sleep_ms(ms: Int)
}

// =============================================================================
// The Reactor trait (design 118 stage 3)
// =============================================================================
// The executor's ONLY interface to IO readiness — register / poll / wake, token-
// based (design 91: the token is the parked frame's `__wake`-word address, latched
// to 0 when its (fd, direction) fires). The hosted concrete impl `SystemReactor`
// wraps the design-117 `__saw_rt_reactor_*` instance seams (kqueue/epoll behind the
// ABI); a future SOS-hosted runtime implements the SAME trait over its syscalls
// (the kernel Waiter's word-sized key maps 1:1 onto the token). Kept internal to the
// executor module (not `public`), so no user-facing `Reactor`/`SystemReactor` name
// collision (design 82).
trait Reactor {
    func register(&self, fd: Int, dir: Int, token: Int)
    func poll(&self, timeout_ms: Int) -> Int
    func wake(&self)
}

// The hosted reactor: a trivial value wrapping the process-global reactor INSTANCE
// (the opaque pointer from `__saw_rt_reactor_create`). Host divergence (kqueue vs
// epoll) lives in the rt/ bodies behind the seams, so ONE wrapper serves both hosts
// — the design's "per-host KqueueReactor/EpollReactor" split already exists at the
// seam layer; two identical Saw wrappers would be duplication. Consumed by static
// dispatch through the `Reactor` conformance (no per-call boxing — the reactor impl
// is selected at link/compile time, so an `any Reactor` existential would add an
// allocation with no runtime-swap benefit; the trait is the source-level contract
// the SOS runtime implements as its own conforming type).
struct SystemReactor {
    instance: Int
}

extension SystemReactor: Reactor {
    func register(&self, fd: Int, dir: Int, token: Int) {
        __saw_rt_reactor_register(self.instance, fd, dir, token)
    }
    func poll(&self, timeout_ms: Int) -> Int {
        __saw_rt_reactor_poll(self.instance, timeout_ms)
    }
    func wake(&self) {
        __saw_rt_reactor_wake(self.instance)
    }
}

// The process-global reactor instance, lazily created + race-safely published in
// Saw (design 117 policy, now fully in the executor — the compiler-synthesized
// `__saw_reactor()` getter + its call-site injection are retired). Create on first
// use; publish via CAS; a loser destroys its spare and uses the winner's. The
// instance is process-lifetime (never destroyed). Returns the hosted `Reactor`.
static __saw_reactor_instance: Atomic<Int> = Atomic(0)

func __saw_host_reactor() -> SystemReactor {
    let cur = __saw_reactor_instance.load()
    if cur != 0 {
        return SystemReactor(instance: cur)
    }
    let newp = __saw_rt_reactor_create()
    if __saw_reactor_instance.compare_exchange(0, newp) {
        return SystemReactor(instance: newp)
    }
    __saw_rt_reactor_destroy(newp)
    SystemReactor(instance: __saw_reactor_instance.load())
}

// design 118 stage 2: the executor's timer park, promoted from a codegen
// intrinsic to a real Saw function over the `__saw_rt_sleep_ms` seam. The
// single-frame entry executor (`__saw_exec_park`), the MT worker back-off, and
// the pure-sleep clock advance all call it. NOT a suspension source — the
// executor itself never suspends; it blocks the OS thread for real.
func __saw_exec_sleep(ms: Int) {
    __saw_rt_sleep_ms(ms)
}

// design 118 stage 2: the single-frame drive's park POLICY, carved out of the
// synthesized entry executor (`_make_entry_executor`) so the compiler emits no
// park body — only `resume` + this one call. Given a just-returned frame's
// `__wake` reason: a positive value is a sleep-ms deadline (there is no other
// task or timer to honour in a single-frame drive, so park the thread that
// long); a negative value is an io-park (block in the reactor until the fd the
// frame registered is ready — infinite timeout, again nothing else to honour);
// zero is a plain yield (resume at once). Stage 3 routes the reactor poll here
// through the `Reactor` trait.
func __saw_exec_park(wake: Int) {
    if wake > 0 {
        __saw_exec_sleep(wake)
    } else if wake < 0 {
        let _ = __saw_host_reactor().poll(-1)
    }
}

// design 118 stage 2: the reactor-arm entry point the coroutine transform's io_wait
// / offload park lowerings (and the outside-frame `io_wait` codegen path) call, in
// place of emitting a raw `__saw_rt_reactor_register` into synthesized IR.
// Synthesized IR cannot do Saw trait dispatch, so funnelling the arm through this
// Saw function is what lets stage 3 route it to the `Reactor` trait without touching
// any synthesized call site. `dir` is the direction word (0 = read); `token` is the
// parked frame's `__wake`-word address (design 91 precise routing).
func __saw_exec_io_register(fd: Int, dir: Int, token: Int) {
    __saw_host_reactor().register(fd, dir, token)
}

// design 118 stage 2: the reactor self-wake entry point `cancel()` calls to rouse a
// blocked poll (design 102 item 2). A thin Saw wrapper over the seam today; stage 3
// routes it through the `Reactor` trait.
func __saw_exec_reactor_wake() {
    __saw_host_reactor().wake()
}

// design 89: the per-thread AMBIENT cooperative scheduler. A single intrusive
// list of every live single-threaded TaskGroup, threaded through each group's
// `next` field; `__saw_exec_head` holds the head group's address (0 = empty).
// Every drive point — the entry executor (a suspending `main`), `TaskHandle.join`,
// and a group's `Deinit` — sweeps this ONE list (`__saw_exec_run`), so a task that
// parks (sleep / io / channel-yield) cedes to EVERY sibling across ALL groups, not
// just its own. `spawn` therefore runs eagerly whenever the scheduler runs, not
// only at join. A TaskGroup is now a membership+lifetime SCOPE over this shared
// scheduler: its Deinit drives the ambient list until ITS members are done
// (structured join), then drops exactly its own boxes (exactly-once). Nested
// groups fall out by construction (an inner group links into the SAME list).
// MT groups (workers >= 2) keep their own queue + worker pool and do NOT join this
// list (design 75 bifurcation).
static __saw_exec_head: Atomic<Int> = Atomic(0)

// =============================================================================
// The per-task cell (design 134)
// =============================================================================
// A spawned task's RESULT and CANCEL word live HERE — beside the slot, owned by
// the group — not inside the coroutine frame. That is what lets the frame box
// die the moment the task completes (design 124 item 3, blocked until now as
// DF-124c): a `TaskHandle` addresses the cell and never the frame, and
// `cancel_addr()` hands a peer an address that outlives the task it cancels.
//
// The cell is TYPED (it holds a `T?`), so the group holds it ERASED and lets the
// box teardown run the right destructor — the group itself never names `T`.
// `__carries_result` is the one thing the erased side must know: a cell with a
// result slot has to survive its task (until `join` takes the value, or until
// group teardown drops it exactly once), while a `Void` task's cell holds
// nothing joinable, so its slot is reclaimable the moment the task completes.
trait __TaskCell {
    func __carries_result(&self) sync -> Bool
}

// The cell for a task whose body returns a value. `__result` is the slot
// `TaskHandle<T>.result_ptr` addresses and `join` empties with `Optional.take`.
struct __ResultCell<T> {
    __result: T?
    __cancel: Bool
}

extension __ResultCell<T>: NoCopy {}

extension __ResultCell<T>: __TaskCell {
    func __carries_result(&self) sync -> Bool { true }
}

// The cell for a `Void` task (design 102 item 1) and for the ambient scheduler's
// root frame: a cancel word and nothing else, so no value outlives the task.
struct __VoidCell {
    __cancel: Bool
}

extension __VoidCell: __TaskCell {
    func __carries_result(&self) sync -> Bool { false }
}

struct TaskGroup {
    tasks: Vector<Box<any Resumable>?>
    // design 134: the per-task cells, parallel to `tasks`. A slot's cell outlives
    // its frame — it holds the result until `join` takes it (or until teardown)
    // and the cancel word a stale handle may still address.
    cells: Vector<Box<any __TaskCell>?>
    done: Vector<Bool>
    remaining: Vector<Int>
    // design 75 (A2): per-task "a worker is resuming this frame right now" flag,
    // so no two workers ever resume the same frame (D6 one-thread-at-a-time). Set
    // under the lock at claim, cleared under the lock at the resume's outcome.
    active: Vector<Bool>
    // design 134: the slot free-list and its generation counters. A slot with
    // nothing left to hold goes on `free` for the next `spawn` to claim, and its
    // generation retires so a handle to the task that used to live there is
    // recognisably STALE rather than silently addressing its successor. That is
    // what makes reuse safe: design 124 forbade compaction precisely because
    // indices were handles, and a generation makes an index a handle again.
    // `pin` marks a slot whose raw cancel ADDRESS escaped through `cancel_addr()`
    // — that address has to outlive the task, so the slot keeps its cell and is
    // never handed out again.
    gen: Vector<Int>
    free: Vector<Int>
    pin: Vector<Bool>
    // design 75 (A2): requested worker count. 0/1 => the single-threaded engine
    // (byte-identical to the pre-75 group); >=2 => the multi-threaded fork-join
    // drain (a mutex-protected shared queue drained by `workers` OS threads).
    workers: Int
    // design 75 (A2): the run-queue mutex (a 64-byte pthread_mutex_t slot; see
    // std/mutex.saw for the conservative-size rationale). `None` for the
    // single-threaded engine — no lock is ever taken there.
    lock: UnsafePointer<Int8>?
    // design 89: intrusive ambient-scheduler list link. `next` = address of the
    // next registered single-threaded group (0 = end); `registered` = whether this
    // group is currently in the `__saw_exec_head` list. Set/cleared by
    // `__register`/`__unregister`; unused by MT groups (they never register).
    next: Int
    registered: Bool
}

// The result of resuming one frame, carried OUT of a `with_var_ref` borrow
// (design 81). `with_var_ref<R>` needs an explicit result type (method-generic
// inference is future work) and the frame's `__Poll` is not user-nameable, so
// the executor's scoped borrow returns this trivial (Copy) struct instead of
// matching `__Poll` inside the closure. `done` = the frame finished; otherwise
// `wake` is its `__wake_reason` (0 = ready, >0 = sleep ms, <0 = io-parked).
struct __ResumeOutcome {
    done: Bool
    wake: Int
}

extension TaskGroup {
    public init() -> TaskGroup {
        let t = Vector<Box<any Resumable>?>()
        let c = Vector<Box<any __TaskCell>?>()
        let d = Vector<Bool>()
        let r = Vector<Int>()
        let a = Vector<Bool>()
        let gn = Vector<Int>()
        let fr = Vector<Int>()
        let pn = Vector<Bool>()
        TaskGroup(tasks: move t, cells: move c, done: move d, remaining: move r, active: move a, gen: move gn, free: move fr, pin: move pn, workers: 1, lock: None, next: 0, registered: false)
    }

    // design 75 (A2): opt in to multi-threaded execution with `n` worker threads.
    // `TaskGroup(threads: 1)` and the default `TaskGroup()` both run the proven
    // single-threaded engine (no OS threads spawned, no lock); `n >= 2` allocates
    // the run-queue mutex and, at drain time, spawns a worker pool. Spawning into a
    // group built this way turns on the Send-on-frames gate (a frame that crosses
    // to another worker must be Send).
    public init(threads: Int) unsafe -> TaskGroup {
        let t = Vector<Box<any Resumable>?>()
        let c = Vector<Box<any __TaskCell>?>()
        let d = Vector<Bool>()
        let r = Vector<Int>()
        let a = Vector<Bool>()
        let gn = Vector<Int>()
        let fr = Vector<Int>()
        let pn = Vector<Bool>()
        var w = threads
        if w < 1 {
            w = 1
        }
        var lk: UnsafePointer<Int8>? = None
        if w >= 2 {
            // Design 123: this used to leave `lk` None on allocator exhaustion,
            // and a multi-threaded group with no run-queue lock is INERT in the
            // worst way — `__run_all` guards on the lock and does nothing, so
            // not one spawned task runs, `Deinit` drops every frame unrun, and
            // `TaskHandle.join` then force-unwraps a result that was never
            // written. The group still reported `workers >= 2` throughout.
            if let block = GlobalAllocator().alloc(64, 16) {
                __saw_rt_pthread_mutex_init_default(block)
                lk = block
            } else {
                panic("TaskGroup(threads:): allocation failed")
            }
        }
        TaskGroup(tasks: move t, cells: move c, done: move d, remaining: move r, active: move a, gen: move gn, free: move fr, pin: move pn, workers: w, lock: lk, next: 0, registered: false)
    }

    // The number of task slots this group currently holds (design 134): live
    // tasks plus completed tasks whose result nobody has joined yet. A slot is
    // RECLAIMED when it has nothing left to hold, so a long-lived group's count
    // tracks concurrency rather than the number of tasks ever spawned.
    public func count(&self) -> Int {
        self.tasks.len() - self.free.len()
    }

    // Enqueue an erased frame together with its result/cancel cell (compiler-
    // generated `__spawn_*` calls this). Both boxes are MOVED in: the group owns
    // the frame until the task completes and the cell until its result is joined
    // or the group tears down. Returns the slot index (the `TaskHandle` records it
    // for slot-precise `join`). A single-threaded group registers itself in the
    // ambient scheduler list on first enqueue (design 89) so the shared sweep can
    // reach its frames; MT groups never register (they run their own worker pool).
    func __enqueue(&var self, task: Box<any Resumable>, cell: Box<any __TaskCell>) -> Int {
        if self.workers < 2 {
            self.__register()
        }
        let t: Box<any Resumable>? = move task
        let c: Box<any __TaskCell>? = move cell
        // design 134: claim a RECLAIMED slot if there is one, else grow. A reused
        // slot already carries the retired generation the recycle left behind, so
        // the task landing here is distinguishable from the one that left.
        var slot = -1
        if let idx = self.free.pop() {
            slot = idx
        }
        if slot < 0 {
            slot = self.tasks.len()
            self.tasks.push(None)
            self.cells.push(None)
            self.done.push(false)
            self.remaining.push(0)
            self.active.push(false)
            self.gen.push(1)     // generation 1: 0 names no task
            self.pin.push(false)
        }
        self.tasks.set(slot, move t)
        self.cells.set(slot, move c)
        self.done.set(slot, false)
        self.remaining.set(slot, 0)
        self.active.set(slot, false)
        slot
    }

    // ------------------------------------------------------------------------
    // The slot-identity trio (design 134). These four — `__gen_at`, `__stale`,
    // `__recycle`, `__pin` — read and write `gen`/`free`/`pin` WITHOUT the
    // run-queue lock, unlike the rest of the group's bookkeeping. What makes
    // that safe is that only a HANDLE reaches them, and a handle cannot leave
    // the thread that made it: `TaskHandle`/`VoidTaskHandle` hold
    // `UnsafePointer` fields, which are not `Send`, so a handle can never be
    // moved into a spawned task. Their one caller on the executor side,
    // `__saw_exec_should_stop`, runs on the joining thread — and that thread is
    // blocked inside `__run_all`/`__drain_mt`, which joins every worker before
    // returning, whenever an MT drain is in flight. So no worker is alive at any
    // point these run. A future feature that lets a cancel handle cross threads
    // has to put these under the lock.
    // ------------------------------------------------------------------------

    // This slot's current generation — half of the (index, generation) pair every
    // handle records at spawn.
    func __gen_at(&self, slot: Int) -> Int {
        self.gen.get(slot)!
    }

    // Does `(slot, generation)` still name the task it was minted for? A handle to
    // a task whose slot has been reclaimed answers `true` here, and every handle
    // operation checks it before touching the slot or the cell it points at — so
    // a stale handle is a DEFINED outcome, never a read of a successor's state.
    func __stale(&self, slot: Int, generation: Int) -> Bool {
        if slot < 0 || slot >= self.gen.len() {
            return true
        }
        self.gen.get(slot)! != generation
    }

    // Retire `slot` (design 134). Its generation always advances, so every handle
    // minted for the departing task goes stale at once. A slot whose raw cancel
    // ADDRESS escaped through `cancel_addr()` stops there: a bare `Int` carries no
    // generation for the peer to check, so the cell has to stay valid and the
    // index is never handed out again. Every other slot releases its cell and
    // joins the free list.
    func __recycle(&var self, slot: Int) {
        self.gen.set(slot, self.gen.get(slot)! + 1)
        if self.pin.get(slot)! {
            return
        }
        self.cells.set(slot, None)
        self.free.push(slot)
    }

    // `cancel_addr()` handed a peer this slot's raw cancel-word address, so the
    // slot gives up reuse for the group's lifetime (see `__recycle`).
    func __pin(&var self, slot: Int, generation: Int) {
        if self.__stale(slot, generation) {
            return
        }
        self.pin.set(slot, true)
    }

    // design 134: a task reached Done. Mark the slot and RELEASE ITS FRAME BOX
    // right here — the whole allocation, not just the values inside it. That is
    // the reclamation design 124 wanted (its item 3) and could not have: the box
    // used to hold the result and the cancel word a `TaskHandle` addressed, so
    // dropping it would have invalidated the handle. Both live in the cell now,
    // which stays, so the frame — params, across-suspend locals, embedded callee
    // sub-frames, scheduler words and all — dies with the task that owned it.
    //
    // Every scan skips a done slot before touching `tasks`, so the `None` left
    // behind is never dereferenced. The MT caller holds the run-queue lock.
    //
    // The SLOT goes too when there is nothing left to hold. A task with a
    // joinable result keeps it until `join` takes the value (or until group
    // teardown drops it once — design 124's never-joined path); a `Void` task
    // leaves nothing behind, so its slot is reclaimed right here. That is what
    // keeps an accept-loop group O(live) rather than O(tasks ever spawned).
    func __complete(&var self, slot: Int) {
        self.done.set(slot, true)
        self.remaining.set(slot, 0)
        self.active.set(slot, false)
        self.tasks.set(slot, None)
        let keeps = self.cells.with_ref<Bool>(slot, { c in c!.__carries_result() })
        if not keeps {
            self.__recycle(slot)
        }
    }

    // design 89: link this single-threaded group into the ambient scheduler list
    // (idempotent). `&self` is the group's FINAL storage address here (called on the
    // real binding via a `&var self` method / a `__group[0]` pointer deref), so the
    // recorded address stays valid until `__unregister` in Deinit.
    func __register(&var self) unsafe {
        if self.registered {
            return
        }
        self.next = __saw_exec_head.load()
        __saw_exec_head.store((&self) as UnsafePointer<TaskGroup> as Int)
        self.registered = true
    }

    // design 89: unlink this group from the ambient scheduler list (Deinit, after
    // its members have drained). Walks the intrusive list to fix the predecessor's
    // `next`. Single-threaded, so no synchronization is needed.
    func __unregister(&var self) unsafe {
        if not self.registered {
            return
        }
        let me = (&self) as UnsafePointer<TaskGroup> as Int
        let head = __saw_exec_head.load()
        if head == me {
            __saw_exec_head.store(self.next)
            self.registered = false
            return
        }
        var cur = head
        while cur != 0 {
            let cg = cur as UnsafePointer<TaskGroup>
            let nx = cg[0].next
            if nx == me {
                cg[0].next = self.next
                self.registered = false
                return
            }
            cur = nx
        }
        self.registered = false
    }

    // Multi-threaded drain entry (design 75). Single-threaded groups no longer
    // have a per-group executor: they route every drive through the AMBIENT
    // scheduler (`__saw_exec_run`, below) so siblings across ALL groups interleave.
    // This method now serves ONLY the MT fork-join drain (workers >= 2), called by
    // an MT group's `join`/`Deinit`. Idempotent (a fully-drained group is a no-op).
    func __run_all(&var self) unsafe {
        if self.workers >= 2 {
            if let _lk = self.lock {
                self.__drain_mt()
            }
        }
    }

    // design 75 (A2): the multi-threaded fork-join drain. Spawn `workers` OS
    // threads (via the 21b engine), each running `__saw_exec_worker` over this group's
    // SHARED run queue, then join them all — the join is a full barrier, so every
    // frame's `__result` is visible to the caller afterward. Idempotent: a group
    // with no live tasks spawns nothing (so a second `join()` or Deinit after a
    // full drain is a clean no-op). No task is pushed during a drain (enqueue is
    // main-thread-only and the main thread is blocked here), so the run queue is
    // size-stable and `tasks` is read-only while the workers run.
    func __drain_mt(&var self) unsafe {
        var live = 0
        var c = 0
        while c < self.tasks.len() {
            if not self.done.get(c)! {
                live = live + 1
            }
            c = c + 1
        }
        if live == 0 {
            return
        }
        let addr = (&self) as UnsafePointer<TaskGroup> as Int
        var handles = Vector<Task<Void>>()
        var i = 0
        while i < self.workers {
            var t = spawn { __saw_exec_worker(addr) }
            handles.push(move t)
            i = i + 1
        }
        while handles.len() > 0 {
            if let ht = handles.pop() {
                var h = move ht
                h.join()
            }
        }
    }
}

// design 75 (A2): one worker thread's body. Reconstruct the group pointer from the
// address (Send-safe: an Int crosses the `spawn` boundary), then loop claiming and
// resuming runnable frames until no live task remains. The mutex serializes queue
// bookkeeping (done/remaining/active); `resume()` runs OUTSIDE the lock, so
// distinct frames run in parallel while a claimed frame is owned by exactly one
// worker (D6). Returns `Void` — a `Void` spawn body (design 102 item 1) needs no
// result slot, so the old dummy-`Int` return is gone.
func __saw_exec_worker(addr: Int) unsafe {
    let g = addr as UnsafePointer<TaskGroup>
    // `g[0]` derefs the shared group through a raw pointer (this free function
    // gets the group's ADDRESS across the `spawn` boundary as a Send `Int`); each
    // access is marked `unsafe` (design 81). A deref buried in an `if`/`not`
    // condition is hoisted to a marked `let` first (the marker prefixes an
    // expression, so it cannot sit under `not`).
    if let lk = g[0].lock {
        var running = true
        while running {
            pthread_mutex_lock(lk)
            let n = g[0].tasks.len()
            var live = 0
            var idx = -1
            var anyactive = false
            var anyio = false
            var minrem = -1
            var i = 0
            while i < n {
                let done_i = g[0].done.get(i)!
                if not done_i {
                    live = live + 1
                    let active_i = g[0].active.get(i)!
                    if active_i {
                        anyactive = true
                    } else {
                        let rem = g[0].remaining.get(i)!
                        if rem == 0 {
                            if idx < 0 {
                                idx = i
                            }
                        } else if rem < 0 {
                            anyio = true          // design 76: io-parked
                        } else {
                            if minrem < 0 || rem < minrem {
                                minrem = rem
                            }
                        }
                    }
                }
                i = i + 1
            }
            if live == 0 {
                pthread_mutex_unlock(lk)
                running = false
            } else {
                if idx >= 0 {
                    // Claim frame `idx` (one worker owns it), resume OUTSIDE the lock.
                    g[0].active.set(idx, true)
                    let _ = pthread_mutex_unlock(lk)
                    let oc = g[0].tasks.with_var_ref<__ResumeOutcome>(idx, { f in
                        match f!.resume() {
                            case Pending -> __ResumeOutcome(done: false, wake: f!.__wake_reason()),
                            case Done -> __ResumeOutcome(done: true, wake: 0)
                        }
                    })
                    if oc.done {
                        pthread_mutex_lock(lk)
                        g[0].__complete(idx)
                        let _ = pthread_mutex_unlock(lk)
                    } else {
                        pthread_mutex_lock(lk)
                        g[0].active.set(idx, false)
                        g[0].remaining.set(idx, oc.wake)
                        let _ = pthread_mutex_unlock(lk)
                    }
                } else {
                    if anyactive {
                        // Nothing runnable, but a peer is mid-resume — it may make
                        // a task ready. Back off briefly and re-scan (no cond var —
                        // spin+nap keeps the executor free of lost-wakeup bugs).
                        let _ = pthread_mutex_unlock(lk)
                        __saw_exec_sleep(1)
                    } else if anyio {
                        // design 76 (A4) MT reactor integration (CHOICE: poll on an
                        // idle worker with a BOUNDED timeout — earliest sleep
                        // deadline, else a 50 ms cap). Bounded because with
                        // EV_ONESHOT + concurrent pollers only one worker gets each
                        // event, so a missed worker must retry rather than block
                        // forever (no lost-wakeup hang). Poll OUTSIDE the lock; then
                        // (design 91) wake PRECISELY the io-parked tasks the reactor
                        // latched (`__wake_reason()` >= 0), not the herd — the latch
                        // is a persistent word, so a fire that races the park is
                        // caught on the next scan. Advance sleepers only if the poll
                        // TIMED OUT (events == 0). The scan runs UNDER the lock, so
                        // the `with_var_ref` borrow never races a peer worker.
                        var tmo = minrem
                        if tmo < 0 {
                            tmo = 50
                        }
                        let _ = pthread_mutex_unlock(lk)
                        let events = __saw_host_reactor().poll(tmo)
                        pthread_mutex_lock(lk)
                        var k = 0
                        while k < n {
                            let done_k = g[0].done.get(k)!
                            if not done_k {
                                let rk = g[0].remaining.get(k)!
                                if rk < 0 {
                                    // design 102 item 2: wake a reactor-latched OR a
                                    // peer-cancelled io-parked frame (it re-checks
                                    // cancelled() and bails); non-cancelled parked
                                    // siblings stay parked.
                                    let wk = g[0].tasks.with_var_ref<Bool>(k, { f in
                                        f!.__wake_reason() >= 0 || f!.__is_cancelled()
                                    })
                                    if wk {
                                        g[0].remaining.set(k, 0)
                                    }
                                } else if rk > 0 && events == 0 && minrem > 0 {
                                    var nr = rk - minrem
                                    if nr < 0 {
                                        nr = 0
                                    }
                                    g[0].remaining.set(k, nr)
                                }
                            }
                            k = k + 1
                        }
                        let _ = pthread_mutex_unlock(lk)
                    } else {
                        // Every live task is sleeping and none is in flight: advance
                        // the clock by the earliest deadline UNDER the lock (no worker
                        // can claim while we hold it, and none is running), then
                        // subtract it from all sleepers so the shortest wakes first.
                        if minrem > 0 {
                            __saw_exec_sleep(minrem)
                        }
                        var j = 0
                        while j < n {
                            let done_j = g[0].done.get(j)!
                            if not done_j {
                                let r2 = g[0].remaining.get(j)!
                                if r2 > 0 {
                                    var nr = r2 - minrem
                                    if nr < 0 {
                                        nr = 0
                                    }
                                    g[0].remaining.set(j, nr)
                                }
                            }
                            j = j + 1
                        }
                        let _ = pthread_mutex_unlock(lk)
                    }
                }
            }
        }
    }
}

// Deinit runs the executor to completion of every child (structured join at
// scope exit), then releases whatever the slots still hold: an unfinished
// frame's box, and every cell — dropping any UNCONSUMED result exactly once (a
// joined task's result was already taken, leaving `None` behind). Declared
// before NoCopy so the `NoCopy: Deinit` supertrait is satisfied.
extension TaskGroup: NoCopy {
    public func deinit(&var self) unsafe {
        if self.workers >= 2 {
            // MT: fork-join drain over this group's own queue (design 75).
            self.__run_all()
        } else {
            // design 89: ST structured join — drive the AMBIENT scheduler until
            // every frame OF THIS GROUP is done (siblings across other groups run
            // meanwhile), then unlink from the ambient list. Frames still alive
            // elsewhere (other groups) are untouched; we drop only our own boxes.
            let me = (&self) as UnsafePointer<TaskGroup> as Int
            __saw_exec_run(me, -1, 0)
            self.__unregister()
        }
        // Release every slot explicitly, here rather than in the memberwise field
        // cleanup, so an unconsumed result drops while the group is still whole
        // (and before the run-queue mutex goes away). Clearing a slot's cell runs
        // the erased teardown (design 51 vtable dtor -> the cell's memberwise
        // cleanup), which drops an UNCONSUMED result EXACTLY ONCE — a joined
        // task's cell holds `None` by then, so it drops nothing. `tasks` is
        // already `None` for every completed task (design 134 releases the frame
        // box at completion); only a frame the drain could not finish is left.
        var s = 0
        while s < self.tasks.len() {
            self.tasks.set(s, None)
            self.cells.set(s, None)
            s = s + 1
        }
        // design 75 (A2): release the run-queue mutex (multi-threaded groups only).
        if let lk = self.lock {
            pthread_mutex_destroy(lk)
            GlobalAllocator().dealloc(lk, 64, 16)
        }
    }
}

// TaskHandle<T> — the typed result access for one spawned child (design 52b
// item 2). It owns NOTHING: three raw pointers into the group and into that
// task's group-owned CELL. `result_ptr` addresses the cell's `T?` slot and
// `cancel_ptr` its cancel word; the cell is a stable heap allocation that
// OUTLIVES the frame (design 134), so neither pointer is disturbed when the task
// completes and its frame box is released. Dropping an unjoined handle is fine
// (no-op Deinit): the result stays in the cell and is dropped once at group
// teardown — exactly-once either way.
struct TaskHandle<T> {
    result_ptr: UnsafePointer<T?>
    cancel_ptr: UnsafePointer<Bool>
    group_ptr: UnsafePointer<TaskGroup>
    // design 89 + 134: this task's slot index in its group's queue, paired with
    // the generation the slot carried when the task was spawned. `join` drives the
    // ambient scheduler until THIS slot is done, so it returns as soon as its own
    // task finishes (siblings may still run); the generation is what tells a live
    // task apart from a successor occupying the same reclaimed index.
    slot: Int
    generation: Int
}

extension TaskHandle<T> {
    // Drive the group until this task is Done, then TAKE its result. The take is
    // exactly-once: `take()` moves the payload out of the CELL and leaves `None`
    // behind, so the cell's later teardown drops nothing. Taking the result is
    // also what RECLAIMS the slot (design 134) — the cell has nothing left to
    // hold, so the index goes back on the group's free list and this handle,
    // along with any copy of the task's identity, retires with it.
    //
    // Joining twice therefore panics rather than returning a second value: there
    // is only ever one result and this call already moved it out.
    public func join(&self) unsafe -> T {
        if self.group_ptr[0].__stale(self.slot, self.generation) {
            panic("TaskHandle.join: this task's result was already joined")
        }
        if self.group_ptr[0].workers >= 2 {
            // MT: fork-join drain over the group's own queue (design 75).
            self.group_ptr[0].__run_all()
        } else {
            // design 89: drive the ambient scheduler until THIS frame's slot is
            // done. Reentrancy-safe — if the joining task is itself running on the
            // scheduler (task joins task), the sweep skips frames active on the C
            // stack and never re-enters a live coroutine.
            __saw_exec_run(self.group_ptr as Int, self.slot, self.generation)
        }
        let r = self.result_ptr[0].take()!
        self.group_ptr[0].__recycle(self.slot)
        move r
    }

    // Cooperative cancellation (design 18 C1, NO forced destroy): set the cell's
    // `__cancel` word. The task observes it where IT checks (`cancelled()`) or at
    // a cancellation-aware wait, and returns through normal control flow.
    // Cancelling a task that has already finished and been reclaimed is a defined
    // no-op (design 134) — there is nothing left to ask to stop, and the stale
    // handle must not reach a successor sharing its slot.
    public func cancel(&self) unsafe {
        if self.group_ptr[0].__stale(self.slot, self.generation) {
            return
        }
        self.cancel_ptr[0] = true
        // design 102 item 2: rouse a blocked reactor poll so an ALREADY-io-parked
        // target observes the cancel now (not only at its pre-park check).
        __saw_exec_reactor_wake()
    }

    // design 75 (A2): the cancel word's ADDRESS as a Send `Int`. A `TaskHandle` is
    // NoCopy and holds raw pointers (not Send), so it cannot be moved into another
    // task — but its cancel-word address can. A canceller task receives this Int and
    // sets the flag (`(addr as UnsafePointer<Bool>)[0] = true`) to cancel the target
    // from a worker thread; the target observes it via `cancelled()` on its next
    // check (the `__cancel` byte is set-once monotonic — race-free, eventually
    // consistent, cooperative-cancellation semantics). The address is into the
    // task's CELL (design 134), which the group keeps alive for its own lifetime,
    // so a write that lands after the task finished is defined and inert. Taking
    // the address PINS the slot: it keeps its cell and gives up reuse, because a
    // bare `Int` carries no generation for the peer to check against.
    public func cancel_addr(&self) unsafe -> Int {
        self.group_ptr[0].__pin(self.slot, self.generation)
        self.cancel_ptr as Int
    }
}

// Owns nothing (the frame + result live in the group); dropping an unjoined
// handle must not touch the group-owned result. Declared before NoCopy.
extension TaskHandle<T>: NoCopy {
    public func deinit(&var self) {
    }
}

// VoidTaskHandle — the handle for a spawned task whose body returns `Void`
// (design 102 item 1). A `Void` task carries NO result slot (a `{..., void}`
// struct field is illegal LLVM), so its cell is a `__VoidCell`: there is no
// `result_ptr` to hold and no value to take, and `join` just drives the task to
// completion and returns. Cancellation and drop-if-unjoined behave exactly like
// `TaskHandle<T>`. Distinct type (not `TaskHandle<Void>`) so the generic handle
// never has to encode a zero-size `T?` result pointer.
struct VoidTaskHandle {
    cancel_ptr: UnsafePointer<Bool>
    group_ptr: UnsafePointer<TaskGroup>
    slot: Int
    generation: Int
}

extension VoidTaskHandle {
    // Drive the group until this task is Done. No result to take — the void body
    // ran purely for its effects. A `Void` task's slot is reclaimed AT completion
    // (nothing outlives it), so joining one that already finished is a defined
    // no-op rather than a panic: the question "is it done yet" has an answer, and
    // the answer is yes.
    public func join(&self) unsafe {
        if self.group_ptr[0].__stale(self.slot, self.generation) {
            return
        }
        if self.group_ptr[0].workers >= 2 {
            self.group_ptr[0].__run_all()
        } else {
            __saw_exec_run(self.group_ptr as Int, self.slot, self.generation)
        }
    }

    // A defined no-op once the task has finished and its slot was reclaimed
    // (see `TaskHandle.cancel`).
    public func cancel(&self) unsafe {
        if self.group_ptr[0].__stale(self.slot, self.generation) {
            return
        }
        self.cancel_ptr[0] = true
        // design 102 item 2: rouse a blocked reactor poll (see TaskHandle.cancel).
        __saw_exec_reactor_wake()
    }

    // Pins the slot, exactly as `TaskHandle.cancel_addr` does.
    public func cancel_addr(&self) unsafe -> Int {
        self.group_ptr[0].__pin(self.slot, self.generation)
        self.cancel_ptr as Int
    }
}

extension VoidTaskHandle: NoCopy {
    public func deinit(&var self) {
    }
}

// =============================================================================
// The ambient cooperative scheduler (design 89)
// =============================================================================
// One sweep over the intrusive list of every live single-threaded group, reused
// verbatim at all three drive points (entry executor, join, group Deinit). It
// reuses the proven design-52b round-robin + design-76 reactor loop body, now
// spanning ALL groups and skipping frames active on the C stack (reentrancy).

// Any not-done, not-active, ready (remaining == 0) frame anywhere in the list?
func __saw_exec_any_ready() unsafe -> Bool {
    var cur = __saw_exec_head.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let n = g[0].tasks.len()
        var i = 0
        while i < n {
            let done_i = g[0].done.get(i)!
            let active_i = g[0].active.get(i)!
            let rem_i = g[0].remaining.get(i)!
            if (not done_i) && (not active_i) && rem_i == 0 {
                return true
            }
            i = i + 1
        }
        cur = g[0].next
    }
    false
}

// Does the group at `gaddr` still have a not-done frame?
func __saw_exec_group_has_live(gaddr: Int) unsafe -> Bool {
    let g = gaddr as UnsafePointer<TaskGroup>
    let n = g[0].tasks.len()
    var i = 0
    while i < n {
        let done_i = g[0].done.get(i)!
        if not done_i {
            return true
        }
        i = i + 1
    }
    false
}

// Termination predicate. term_group == 0 -> ALL (no live frame anywhere);
// term_group != 0 & term_slot < 0 -> GROUP (no live frame in that group);
// term_group != 0 & term_slot >= 0 -> FRAME (that group's slot is done, at the
// generation `term_gen` the joiner asked about — design 134: a reclaimed slot may
// already host a DIFFERENT task, and a mismatch means ours finished long ago).
func __saw_exec_should_stop(term_group: Int, term_slot: Int, term_gen: Int) unsafe -> Bool {
    if term_group != 0 {
        let g = term_group as UnsafePointer<TaskGroup>
        if term_slot >= 0 {
            if g[0].__stale(term_slot, term_gen) {
                return true
            }
            let d = g[0].done.get(term_slot)!
            return d
        }
        return not __saw_exec_group_has_live(term_group)
    }
    var cur = __saw_exec_head.load()
    while cur != 0 {
        if __saw_exec_group_has_live(cur) {
            return false
        }
        let g = cur as UnsafePointer<TaskGroup>
        cur = g[0].next
    }
    true
}

// design 91: precise reactor wakeup (wake-all retired). The reactor's poll
// latched the `__wake` word of EXACTLY the frame(s) whose (fd, direction) fired
// (from IO_PARK_WAKE = -1 to 0). Here we wake only those: an io-parked frame
// (remaining < 0) is made runnable ONLY when its `__wake_reason()` has become
// >= 0 — a frame still parked (word == -1) stays parked (no thundering herd, and
// no reliance on every op re-verifying). If the poll TIMED OUT (events == 0),
// advance sleepers by the elapsed deadline. Skips frames active on the C stack.
func __saw_exec_wake_io(events: Int, deadline: Int) unsafe {
    var cur = __saw_exec_head.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let n = g[0].tasks.len()
        var i = 0
        while i < n {
            let done_i = g[0].done.get(i)!
            let active_i = g[0].active.get(i)!
            if (not done_i) && (not active_i) {
                let r = g[0].remaining.get(i)!
                if r < 0 {
                    // Wake an io-parked frame the reactor latched (wake word >= 0)
                    // OR one a peer cancelled (design 102 item 2) — it re-checks
                    // cancelled() at its park-loop top and bails. Non-cancelled,
                    // still-parked siblings stay parked (no herd wake).
                    let woke = g[0].tasks.with_var_ref<Bool>(i, { f in
                        f!.__wake_reason() >= 0 || f!.__is_cancelled()
                    })
                    if woke {
                        g[0].remaining.set(i, 0)
                    }
                } else if r > 0 && events == 0 && deadline > 0 {
                    var nr = r - deadline
                    if nr < 0 {
                        nr = 0
                    }
                    g[0].remaining.set(i, nr)
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
}

// design 102 item 2: is any io-parked frame cancelled? A peer cancels a task via
// `cancel_addr` — it sets the frame's `__cancel` word directly, WITHOUT a reactor
// self-wake — so in the single-threaded scheduler this pre-poll scan is what keeps
// `__saw_exec_run` from blocking forever in `__saw_rt_reactor_poll` on a permanently-idle
// fd: if a parked frame is cancelled, wake it (it re-checks cancelled() at its park
// loop top and bails) instead of polling. (`cancel()` additionally self-wakes the
// reactor so an MT worker blocked in poll returns promptly rather than at its cap.)
func __saw_exec_any_cancelled_io() unsafe -> Bool {
    var cur = __saw_exec_head.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let n = g[0].tasks.len()
        var i = 0
        while i < n {
            let done_i = g[0].done.get(i)!
            let active_i = g[0].active.get(i)!
            if (not done_i) && (not active_i) {
                let r = g[0].remaining.get(i)!
                if r < 0 {
                    let c = g[0].tasks.with_var_ref<Bool>(i, { f in f!.__is_cancelled() })
                    if c {
                        return true
                    }
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
    false
}

// Lost-wakeup guard: is any io-parked frame's `__wake` word ALREADY latched
// (>= 0)? A one-shot kevent can be consumed by a poll that is not the scheduler
// sweep — an outside-frame blocking `io_wait` (a sync connect wait) polls the
// same reactor inline and latches whatever fired, including a PARKED sibling's
// event. The event is then gone (EV_ONESHOT deletes on delivery), so the
// sweep's own `poll(-1)` would block forever and `__saw_exec_wake_io` — the
// only reader of the latch — would never run. This pre-poll scan is what makes
// the design-91 "persistent latch word" promise hold in the single-threaded
// sweep (the MT worker gets the same guarantee from its bounded 50 ms poll).
func __saw_exec_any_latched_io() unsafe -> Bool {
    var cur = __saw_exec_head.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let n = g[0].tasks.len()
        var i = 0
        while i < n {
            let done_i = g[0].done.get(i)!
            let active_i = g[0].active.get(i)!
            if (not done_i) && (not active_i) {
                let r = g[0].remaining.get(i)!
                if r < 0 {
                    let latched = g[0].tasks.with_var_ref<Bool>(i, { f in f!.__wake_reason() >= 0 })
                    if latched {
                        return true
                    }
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
    false
}

// Pure-sleep advance: subtract the parked deadline from every sleeper so the
// shortest wakes first. Skips frames active on the C stack.
func __saw_exec_advance_sleep(deadline: Int) unsafe {
    var cur = __saw_exec_head.load()
    while cur != 0 {
        let g = cur as UnsafePointer<TaskGroup>
        let n = g[0].tasks.len()
        var i = 0
        while i < n {
            let done_i = g[0].done.get(i)!
            let active_i = g[0].active.get(i)!
            if (not done_i) && (not active_i) {
                let r = g[0].remaining.get(i)!
                if r > 0 {
                    var nr = r - deadline
                    if nr < 0 {
                        nr = 0
                    }
                    g[0].remaining.set(i, nr)
                }
            }
            i = i + 1
        }
        cur = g[0].next
    }
}

// The scheduler sweep. Drives ready frames round-robin across every registered
// single-threaded group until `__saw_exec_should_stop`, honoring sleep/io parks.
// Reentrancy-safe: a frame currently `active` on the C stack is skipped, so a
// nested drive (task joins task; a nested group's Deinit) never re-enters a live
// coroutine nor nests a second loop — it yields to the ONE scheduler.
func __saw_exec_run(term_group: Int, term_slot: Int, term_gen: Int) unsafe {
    while not __saw_exec_should_stop(term_group, term_slot, term_gen) {
        // Phase 1: resume every ready frame across all groups until none is ready
        // (re-checked from the head each pass, so a just-spawned frame is caught).
        while __saw_exec_any_ready() {
            var cur = __saw_exec_head.load()
            while cur != 0 {
                let g = cur as UnsafePointer<TaskGroup>
                let n = g[0].tasks.len()
                var i = 0
                while i < n {
                    let done_i = g[0].done.get(i)!
                    let active_i = g[0].active.get(i)!
                    let rem_i = g[0].remaining.get(i)!
                    if (not done_i) && (not active_i) && rem_i == 0 {
                        g[0].active.set(i, true)
                        let oc = g[0].tasks.with_var_ref<__ResumeOutcome>(i, { f in
                            match f!.resume() {
                                case Pending -> __ResumeOutcome(done: false, wake: f!.__wake_reason()),
                                case Done -> __ResumeOutcome(done: true, wake: 0)
                            }
                        })
                        g[0].active.set(i, false)
                        if oc.done {
                            g[0].__complete(i)
                        } else {
                            g[0].remaining.set(i, oc.wake)
                        }
                        if __saw_exec_should_stop(term_group, term_slot, term_gen) {
                            return
                        }
                    }
                    i = i + 1
                }
                let nx = g[0].next
                cur = nx
            }
        }
        if __saw_exec_should_stop(term_group, term_slot, term_gen) {
            return
        }
        // Phase 2: nothing ready. Scan all groups for the earliest sleep deadline
        // and whether any frame is io-parked, then park (reactor/timer).
        var deadline = -1
        var io = false
        var anylive = false
        var cur2 = __saw_exec_head.load()
        while cur2 != 0 {
            let g = cur2 as UnsafePointer<TaskGroup>
            let n = g[0].tasks.len()
            var i = 0
            while i < n {
                let done_i = g[0].done.get(i)!
                let active_i = g[0].active.get(i)!
                if (not done_i) && (not active_i) {
                    anylive = true
                    let r = g[0].remaining.get(i)!
                    if r < 0 {
                        io = true
                    } else if r > 0 {
                        if deadline < 0 || r < deadline {
                            deadline = r
                        }
                    }
                }
                i = i + 1
            }
            cur2 = g[0].next
        }
        if not anylive {
            // Every frame toward our goal is active on an OUTER sweep's stack —
            // cede to it (reentrancy: never spin, never re-enter a live coroutine).
            return
        }
        if io {
            if __saw_exec_any_latched_io() || __saw_exec_any_cancelled_io() {
                // A parked frame's event was already latched (consumed by an
                // inline poll — see __saw_exec_any_latched_io) or a peer
                // cancelled it (via cancel_addr, no self-wake) — wake it now
                // instead of blocking in poll on an event that will never come.
                __saw_exec_wake_io(1, deadline)
            } else {
                let events = __saw_host_reactor().poll(deadline)
                __saw_exec_wake_io(events, deadline)
            }
        } else {
            if deadline > 0 {
                __saw_exec_sleep(deadline)
            }
            __saw_exec_advance_sleep(deadline)
        }
    }
}

// design 89: the entry executor for a suspending `main` that uses the scheduler.
// main's frame is boxed erased and enqueued as the ROOT member of a scope that
// lives for the whole program; the ambient sweep then drives main AND every task
// it spawns (across every group) to completion. `root`'s Deinit at return drains
// any straggler and drops main's box exactly once.
func __saw_exec_run_root(rootbox: Box<any Resumable>) {
    var root = TaskGroup()
    // `main` has no handle and no joinable result, so its cell is the empty one
    // (design 134): every occupied slot carries a cell, with no special case for
    // the root.
    let _ = root.__enqueue(move rootbox, Box<any __TaskCell>.make(__VoidCell(__cancel: false)))
    __saw_exec_run(0, -1, 0)
}
