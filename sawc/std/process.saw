// Process - Command execution for the Saw standard library
// Part of the Saw standard library
//
// Provides process spawning and command execution.
// Currently targets macOS/Linux using POSIX APIs.

// =============================================================================
// FFI declarations for process operations
// =============================================================================

extern "C" {
    // Process execution (design 122 unit C). A command is spawned through the
    // runtime seams with a real argv array — never a shell command line — so an
    // argument containing spaces, quotes or `;` is ONE argument and nothing in
    // it is ever interpreted. `spawn` hands back an opaque job handle (or a
    // negated SysError tag); `wait` reaps it and returns the RAW POSIX wait
    // status, which `decode_wait_status` below turns into an exit code.
    func __saw_rt_proc_spawn(path: UnsafePointer<Int8>, argv: UnsafePointer<Int8>, flags: Int) -> Int
    // The same spawn carrying environment OVERRIDES (design 155): `envp` is a
    // NULL-terminated `NAME=VALUE` array and the child gets this process's
    // environment with those names set. Only the runtime can reach the process
    // environment, which is why the merge is behind a seam and not done here.
    func __saw_rt_proc_spawn_env(path: UnsafePointer<Int8>, argv: UnsafePointer<Int8>, envp: UnsafePointer<Int8>, flags: Int) -> Int

    // The child's stdout pipe is a BLOCKING descriptor, and a child may write
    // nothing for as long as it likes, so the drain is unbounded. `blocking`
    // makes every call an offload (design 183): the read runs on a worker thread
    // and the task parks on the job's pipe, so `output()` costs no executor
    // thread. It is part of the symbol's contract, so no declaration of it can
    // drop the annotation and get a naked drain back.
    blocking func __saw_rt_proc_read_stdout(job: Int, buf: UnsafePointer<Int8>, len: Int) -> Int

    // The zero-thread wait (design 182), which BOTH `run()` and `output()` use.
    // `try_wait` reaps only a child that has already exited and answers
    // `-WouldBlock` otherwise; `wait_fd` hands back a descriptor to PARK on,
    // readable once the child exits. The job owns that descriptor — std
    // registers it with the reactor and never closes it. `release` is the
    // cancellation exit: drop the job, leave the child alone.
    func __saw_rt_proc_wait_fd(job: Int) -> Int
    func __saw_rt_proc_try_wait(job: Int) -> Int
    func __saw_rt_proc_release(job: Int)

    // design 89-c: the cooperative op-count budget. An io op that completes
    // WITHOUT parking charges the budget; a nonzero `tick` means it ran out and
    // the primitive should force one fairness yield. A genuine park resets it.
    func __saw_rt_op_budget_tick() -> Int
    func __saw_rt_op_budget_reset()

    // Memory. Only the two `char**` arrays `execvp` wants are built by hand;
    // the stdout capture is a `Data` and grows itself.
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)

    // Refcounted String runtime (defined by the compiler, see codegen/core.py)
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// The exit code a child reports when it could not exec (POSIX convention, and
// what the spawn seam's child branch uses).
static EXEC_FAILED_CODE: Int32 = 127
// stdout drain granularity for `output()`.
static PROC_READ_CHUNK: Int = 1024
// `=`, the byte POSIX reserves to separate an environment variable's NAME from
// its VALUE — so a name may not contain one.
static EQUALS_BYTE: Byte = 61

// The spawn seam's redirection bit set (rt/ABI.md). `output()` asks for the
// stdout pipe; `merge_stderr()` adds the second bit.
//
// The bits are a closed named set, so they are a backed enum (design 153/185)
// rather than a family of statics; a bit SET is the backing integer they are
// tags for, which is what the `flags` word stays, and the enum is the single
// source of the values — projected with `as` where a bit joins the word.
enum RedirectFlag: UInt8 {
    case CaptureStdout = 1,
    case MergeStderr = 2
}

// The portable SysError tag this module branches on (the space is in rt/ABI.md;
// a failing seam returns the NEGATED tag). `-WouldBlock` from `try_wait` means
// the child is still running.
//
// Design 153 leaves this one a static: it belongs to the `SysError` set, and
// declaring that enum in a std file reserves the name `SysError` for every user
// program (DF-153b). The rt side of the seam carries the enum already.
static SYS_WOULD_BLOCK: Int = 1

// The degraded wait, in milliseconds. Reached only when the host cannot hand out
// a child-exit descriptor at all — descriptor exhaustion, or (on macOS) a child
// that turned into a zombie between the poll and the ask. Polling on a doubling
// nap keeps the executor free either way; it is slower than a park, never a
// thread block. Most children are collected on the first or second pass.
static WAIT_POLL_START_MS: UInt64 = 1
static WAIT_POLL_MAX_MS: UInt64 = 32

// =============================================================================
// Wait-status decode (design 59 A, DF2)
// =============================================================================

// `system()` and `pclose()` return the raw POSIX wait status, NOT an exit code.
// Dividing it by 256 (`status >> 8`) keeps only the normal-exit byte and DROPS
// the signal-death information: when the shell child is exec'd into the command
// and killed (a failed `assert`/`panic` raises SIGABRT, a bad access SIGSEGV),
// the raw status holds the signal in its low 7 bits and a ZERO exit byte, so the
// naive decode reads exit 0 = SUCCESS for a crash. `blade test` relies on the
// exit code, so a killed test binary MUST count as failure.
//
// Decode the way a POSIX shell does, in ONE helper used by every wait path:
//   - exited normally (low 7 bits == 0): report the 0..255 exit byte;
//   - killed by signal N (low 7 bits in 1..126): report 128 + N (shell
//     convention — that is how `$?` surfaces a signal death);
//   - stopped (low byte == 0x7f) or any other state: report nonzero.
// The result is 0 ONLY for a genuine normal exit with code 0.
func decode_wait_status(status: Int32) -> Int32 {
    let low7 = status & (0x7f as Int32)
    if low7 == (0 as Int32) {
        // WIFEXITED: the exit code lives in bits 8..15.
        (status >> (8 as Int32)) & (0xff as Int32)
    } else if low7 == (0x7f as Int32) {
        // WIFSTOPPED (low byte == 0x7f): not a normal termination -> nonzero.
        (128 as Int32) + ((status >> (8 as Int32)) & (0xff as Int32))
    } else {
        // WIFSIGNALED: killed by signal `low7` -> 128 + signum.
        (128 as Int32) + low7
    }
}

// =============================================================================
// ProcessError - a command that could not be launched (design 92 / 94)
// =============================================================================

// Returned as the Err of `Command.run()` when the command could not be started
// (the executable was not found, or a child process could not be created) — as
// distinct from the command running and exiting nonzero (that is Ok(code)).
// Conforms to `Error`, so it interpolates and boxes into `Box<any Error>`.
//
// One other thing ends a `run()` without an exit code: the task was CANCELLED
// while waiting for the child. That is a different story from a failed launch —
// the child launched fine and is still out there — so it says so rather than
// borrowing the launch wording (`cancelled()` below tells the two apart).
public struct ProcessError {
    private program: String
    // True when the wait was cancelled rather than the launch failing.
    private was_cancelled: Bool
}

extension ProcessError {
    // The program that failed to launch.
    public func program_name(&self) -> String {
        self.program
    }

    // True when this error ends a run that was CANCELLED while waiting for the
    // child, rather than one whose command never started. The child was launched
    // and keeps running (design 102 cancels the wait, not the process); its exit
    // status is simply no longer being collected.
    public func cancelled(&self) -> Bool {
        self.was_cancelled
    }
}

extension ProcessError: Error {
    public func format(&self, into: &var StringBuilder) {
        if self.was_cancelled {
            try! into.append("cancelled while waiting for process: ")
        } else {
            try! into.append("could not launch process: ")
        }
        try! into.append(self.program)
    }
}

// The two ways a `run()` ends without an exit code.
func launch_failed(program: String) -> ProcessError {
    ProcessError(program: program, was_cancelled: false)
}

func wait_cancelled(program: String) -> ProcessError {
    ProcessError(program: program, was_cancelled: true)
}

// =============================================================================
// CommandOutput - Result of running a command with output capture
// =============================================================================

public struct CommandOutput {
    public stdout: String
    public exit_code: Int32
}

extension CommandOutput {
    public func success(&self) -> Bool {
        self.exit_code == (0 as Int32)
    }
}

// =============================================================================
// Command - Builder for spawning processes
// =============================================================================

public struct Command {
    private program: String
    // One element per argument, kept SEPARATE all the way to `execvp`. The old
    // representation was a single space-joined byte buffer handed to `system()`,
    // which meant the shell re-split it: `arg("one two")` became two arguments
    // and `arg("; echo hi")` ran a second command (design 122 unit C).
    private args: Vector<String>
    // True once `merge_stderr` has been called: the child's standard error then
    // goes wherever its standard output goes.
    private merged_stderr: Bool
    // Environment OVERRIDES, one `NAME=VALUE` element per variable, in the order
    // `env` first named them. Overrides, not a replacement environment: the
    // child inherits everything this process has and these names win. Empty for
    // a Command nobody called `env` on, which then spawns through the seam that
    // knows nothing about environments at all.
    private envs: Vector<String>
}

// Does the `NAME=VALUE` entry name exactly the variable `name`? Compares the
// name only, so `PATH=/bin` does not answer for `PATHOLOGY`.
func names_variable(entry: String, name: String) -> Bool {
    let n = name.len()
    if entry.len() <= n {
        return false
    }
    if entry.byte_at(n) != EQUALS_BYTE {
        return false
    }
    var i = 0
    while i < n {
        if entry.byte_at(i) != name.byte_at(i) {
            return false
        }
        i = i + 1
    }
    true
}

extension Command {
    public init(program: String) -> Command {
        Command(program: program, args: Vector<String>(),
                merged_stderr: false, envs: Vector<String>())
    }

    // Add a single argument. Whatever bytes it holds, it arrives at the child
    // process as exactly one element of `argv` — no quoting rules to get wrong,
    // because no shell ever sees it.
    public func arg(&var self, argument: String) -> Result<Void, AllocError> {
        return try self.args.push(argument)
    }

    public func arg_count(&self) -> Int {
        self.args.len()
    }

    // Set one environment variable for the child. Same discipline as `arg`:
    // one call is exactly one variable, and both the name and the value are
    // bytes the child receives verbatim — nothing is parsed, split, expanded or
    // interpreted, because no shell is ever involved.
    //
    // The child inherits this process's environment and these names override
    // it; a name this process does not have is added. Calling `env` twice for
    // one name REPLACES the value, so the last call wins and the child never
    // sees the same variable twice.
    //
    // Panics on a name that could not be an environment variable at all — empty,
    // or containing the `=` POSIX reserves as the separator. That is a
    // programming error in the same class as an out-of-range index, not a
    // condition the child could report.
    public func env(&var self, name: String, value: String) -> Result<Void, AllocError> {
        if name.is_empty() {
            panic("Command.env: an environment variable name must not be empty")
        }
        if name.contains("=") {
            panic("Command.env: an environment variable name must not contain '='")
        }

        var spec = StringBuilder()
        let _ = try spec.append(name)
        let _ = try spec.append("=")
        let _ = try spec.append(value)
        let entry = spec.build()

        var i = 0
        while i < self.envs.len() {
            if let existing = self.envs.get(i) {
                if names_variable(existing, name) {
                    self.envs.set(i, entry)
                    return
                }
            }
            i = i + 1
        }
        return try self.envs.push(entry)
    }

    public func env_count(&self) -> Int {
        self.envs.len()
    }

    // Send the child's standard error wherever its standard output goes — into
    // the captured pipe under `output()`, and to this process's own stdout
    // under `run()` (exactly what `2>&1` means in a shell).
    //
    // Reach for it when you are running children you EXPECT some of to fail and
    // their diagnostics are not yours to print: without it `output()` captures
    // stdout while stderr keeps going to the terminal, so a tool that runs a
    // hundred compiles cannot keep its own report readable. What you capture is
    // then both streams interleaved, in the order the child wrote them.
    public func merge_stderr(&var self) {
        self.merged_stderr = true
    }

    // Build the NULL-terminated `char**` that `execvp` wants:
    // `[program, arg0, arg1, ..., NULL]`. The slots BORROW the Strings this
    // Command owns, so the array is only valid while `self` is alive and must be
    // freed by the caller; both spawn paths below use it and free it at once.
    // (Signature names a raw pointer, so this is already the design-81 marked
    // domain.)
    //
    // Panics if the array cannot be allocated. design 234 §5's boundary applies:
    // `run`/`output` report a `None` here as "could not launch process", which
    // is a different failure from the one that happened — their error channels
    // are about the CHILD, not about memory — so the refusal has nowhere honest
    // to go and says so loudly instead.
    func build_argv(&self) unsafe -> UnsafePointer<Int8> {
        let n = self.args.len()
        let slot = sizeof<UnsafePointer<Int8>>()
        let slots = n + 2                      // program + args + NULL
        guard let raw = malloc(slots * slot) else {
            panic("Command: allocation failed")
        }
        let arr = raw as UnsafePointer<UnsafePointer<Int8>>
        arr[0] = self.program as UnsafePointer<Int8>
        var i = 0
        while i < n {
            if let a = self.args.get(i) {
                arr[i + 1] = a as UnsafePointer<Int8>
            }
            i = i + 1
        }
        // Terminate with a NULL pointer, written as a slot of zero bytes (there
        // is no null-pointer literal, and the element type is not optional).
        let bytes = raw as UnsafePointer<Int8>
        let end = (slots - 1) * slot
        var k = 0
        while k < slot {
            bytes[end + k] = 0 as Int8
            k = k + 1
        }
        raw
    }

    // Build the NULL-terminated `char**` of `NAME=VALUE` overrides the
    // env-carrying spawn seam wants. Same discipline as `build_argv`: the slots
    // BORROW the Strings this Command owns, so the array is valid only while
    // `self` is alive and must be freed by the caller.
    //
    // Panics if the array cannot be allocated (design 123, infallible tier).
    func build_envp(&self) unsafe -> UnsafePointer<Int8> {
        let n = self.envs.len()
        let slot = sizeof<UnsafePointer<Int8>>()
        let slots = n + 1                      // entries + NULL
        guard let raw = malloc(slots * slot) else {
            panic("Command: allocation failed")
        }
        let arr = raw as UnsafePointer<UnsafePointer<Int8>>
        var i = 0
        while i < n {
            if let e = self.envs.get(i) {
                arr[i] = e as UnsafePointer<Int8>
            }
            i = i + 1
        }
        // Terminate with a NULL pointer, written as a slot of zero bytes (see
        // build_argv — there is no null-pointer literal).
        let bytes = raw as UnsafePointer<Int8>
        let end = (slots - 1) * slot
        var k = 0
        while k < slot {
            bytes[end + k] = 0 as Int8
            k = k + 1
        }
        raw
    }

    // Spawn the child and hand back the opaque job word (or the negated
    // SysError tag the seam reported). `capture` asks for the child's stdout in
    // a pipe the job owns; `merge_stderr()` adds the second redirection bit.
    //
    // A Command with no `env` call goes through the environment-free seam, so
    // the overwhelmingly common spawn costs exactly what it always did — no
    // envp array, no merge.
    func spawn_job(&self, capture: Bool) unsafe -> Int {
        var flags = if capture { (RedirectFlag.CaptureStdout as UInt8) as Int } else { 0 }
        if self.merged_stderr {
            flags = flags + ((RedirectFlag.MergeStderr as UInt8) as Int)
        }

        let argv = self.build_argv()
        let job = if self.envs.len() == 0 {
            __saw_rt_proc_spawn(self.program as UnsafePointer<Int8>, argv, flags)
        } else {
            let envp = self.build_envp()
            let with_env = __saw_rt_proc_spawn_env(
                self.program as UnsafePointer<Int8>, argv, envp, flags)
            free(envp)
            with_env
        }
        free(argv)
        job
    }

    // Run the command, inheriting stdin/stdout/stderr.
    //
    // Ok(code)  = the command LAUNCHED and its process exited with `code`
    //             (a signal death decodes to 128+signum via decode_wait_status,
    //             so a crashed child is a nonzero code, never a bogus 0 — DF2).
    // Err(...)  = the command could not be LAUNCHED: the spawn itself failed
    //             (no child / no argv memory), or the child could not exec and
    //             exited 127 (POSIX "command not found / could not exec"). This
    //             is the design-92 distinction — a failed launch is surfaced,
    //             not folded into a bogus exit code (never hide errors). The one
    //             other Err is a CANCELLED wait, which `ProcessError.cancelled()`
    //             tells apart.
    //
    // COOPERATIVE (design 182). Waiting for a child costs no thread: the runtime
    // hands back a descriptor that goes readable when the child exits, and this
    // parks on it exactly as a socket read parks. Sibling tasks keep running for
    // the child's whole lifetime — which they did not before, and which matters
    // most here because a child may never exit at all.
    //
    // CANCELLATION cancels the WAIT, not the CHILD. A cancelled task wakes out of
    // the park and returns `Err`, and the process it launched keeps running with
    // nobody collecting its exit status. Killing it is the caller's business, and
    // deliberately so: a `run()` whose caller lost interest is not evidence that
    // the work should stop.
    public func run(&self) unsafe -> Result<Int32, ProcessError> {
        let job = self.spawn_job(false)
        if job <= 0 {
            return launch_failed(self.program)
        }
        let w = self.reap(job)
        if w.cancelled {
            return wait_cancelled(self.program)
        }
        if w.raw < 0 {
            return launch_failed(self.program)
        }
        let code = decode_wait_status(w.raw as Int32)
        if code == EXEC_FAILED_CODE {
            return launch_failed(self.program)
        }
        code
    }

    // Wait for `job`'s child to exit and reap it, costing no thread.
    //
    // `raw` is the seam's own answer — the RAW POSIX wait status (>= 0) or a
    // NEGATED SysError tag — because the two callers report a seam failure in
    // different channels (`run` as a launch failure, `output` as `None`).
    // `cancelled` is the other way a wait ends: the TASK was cancelled, and the
    // child keeps running with nobody collecting its status (design 102 cancels
    // the wait, not the process). `raw` is meaningless then.
    //
    // A METHOD, not a free function, and that is load-bearing rather than
    // stylistic: the coroutine transform embeds a suspending std METHOD as a
    // sub-frame and cannot reach a std free function, so the same loop written
    // free would run its `io_wait` outside a frame — where the park degrades to
    // an inline reactor poll that never cedes, which is a busy wait with the
    // executor thread held. Measured, not reasoned: as a free function it
    // regressed `process_run_concurrent` and `process_cancel_during_child`.
    func reap(&self, job: Int) -> (raw: Int, cancelled: Bool) {
        var status = 0
        var nap = WAIT_POLL_START_MS
        while {
            if cancelled() {
                let wfd = __saw_rt_proc_wait_fd(job)
                if wfd >= 0 {
                    // DF-134a: leaving the loop with the registration still armed
                    // would strand a token pointing into this frame.
                    io_unwait(wfd, 0)
                }
                __saw_rt_proc_release(job)
                return (raw: 0, cancelled: true)
            }
            let r = __saw_rt_proc_try_wait(job)
            if r != -SYS_WOULD_BLOCK {
                status = r                     // exited: the raw status, or -tag
                break
            }
            let wfd = __saw_rt_proc_wait_fd(job)
            if wfd >= 0 {
                io_wait(wfd, 0)                // park until the child exits
                __saw_rt_op_budget_reset()          // design 89-c: parked, budget reset
            } else {
                // No descriptor to be had — poll on a doubling nap instead. Still
                // cooperative: `sleep` parks the TASK, never the thread.
                sleep(Duration.ms(nap))
                if nap < WAIT_POLL_MAX_MS {
                    nap = nap * 2
                }
            }
        }
        if __saw_rt_op_budget_tick() != 0 {         // design 89-c: fairness backstop
            yield_now()
        }
        (raw: status, cancelled: false)
    }

    // Run the command and capture its stdout.
    // Returns CommandOutput with stdout and exit code, or None if the child
    // could not be spawned.
    //
    // The child's STDERR is inherited — it goes to this process's own stderr —
    // unless `merge_stderr()` was called, which folds it into the captured
    // stdout instead.
    //
    // COOPERATIVE, like `run()` (DF-181a, closed). Both halves used to hold the
    // executor thread for the child's whole lifetime: the drain sat in a `read`
    // on a blocking pipe and the reap in a `waitpid`, and a sibling task's first
    // tick landed only once the child exited. Now the drain is an OFFLOADED
    // `blocking` seam — the read runs on a worker thread and this task parks on
    // the job's pipe — and the reap is the same `reap` park loop `run()` uses.
    //
    // Consequence for callers: `output()` suspends, so a `sync` function cannot
    // call it. Cancelling the task ends the WAIT, not the child, and answers
    // `None`; a child cancelled mid-drain keeps running, unreaped.
    // design 234: the two answers ride separate channels. `Ok(None)` keeps its
    // old meaning — the child could not be launched, or the wait was cancelled —
    // and `Err(AllocError)` is the collection buffer running out, which used to
    // panic inside `Data.append_bytes` and now reaches the caller that asked for
    // the output.
    public func output(&self) unsafe -> Result<CommandOutput?, AllocError> {
        let job = self.spawn_job(true)
        if job <= 0 {
            let absent: CommandOutput? = None
            return absent
        }

        // Both buffers are FRAME-RESIDENT, which is design 183's pointer rule
        // rather than a preference: the worker thread reads and writes through
        // the chunk pointer while this task is parked, so the storage has to
        // outlive the park, and a `[Int8; N]` local of a suspending body lives
        // in the heap-resident frame. It is also what keeps `output()` itself
        // spawnable into a multi-threaded group — a frame holding a raw
        // `UnsafePointer` across the park is not `Send`, and the hand-rolled
        // realloc buffer this replaced was exactly that. `Data` grows itself, so
        // the old grow loop, its capacity arithmetic and its manual NUL
        // terminator are gone with it.
        var chunk: [Int8; PROC_READ_CHUNK] = [0; PROC_READ_CHUNK]
        var collected = Data()
        var draining = true
        while draining {
            let n = __saw_rt_proc_read_stdout(
                job, (&chunk) as UnsafePointer<Int8>, PROC_READ_CHUNK)
            if n > 0 {
                let _ = try collected.append_bytes((&chunk) as UnsafePointer<Int8>, n)
            } else {
                // 0 = EOF (the child closed stdout / exited); < 0 = a read
                // error. Either way there is nothing more to collect — the
                // child is still reaped below so its status is not lost.
                draining = false
            }
        }

        // Reap the child. `raw` is the RAW wait status, decoded the same way
        // run() does (DF2): a signal death is a nonzero failure, not exit 0.
        let w = self.reap(job)
        if w.cancelled || w.raw < 0 {
            let absent: CommandOutput? = None
            return absent
        }
        let exit_code = decode_wait_status(w.raw as Int32)

        // An owned refcounted String over the collected bytes. `Data` holds no
        // String header, so this copies; an empty capture skips the seam, whose
        // pointer would be null.
        let stdout_str = if collected.len() == 0 {
            ""
        } else {
            __saw_string_from_bytes(collected.byte_ptr(), collected.len())
        }

        let out: CommandOutput? = CommandOutput(stdout: stdout_str, exit_code: exit_code)
        return out
    }
}

// Command owns its argument vector; nothing else needs releasing (the `args`
// field's own deinit runs as drop glue).
extension Command: NoCopy {
    public func deinit(&var self) {
    }
}
