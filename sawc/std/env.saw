// Env - Environment access for the Saw standard library
// Part of the Saw standard library
//
// Provides access to command-line arguments and environment variables.
// Currently targets macOS. Linux support is planned.

// =============================================================================
// FFI declarations for environment access
// =============================================================================

extern "C" {
    // Environment variables
    func getenv(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    func setenv(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int32) -> Int32
    func unsetenv(name: UnsafePointer<Int8>) -> Int32

    // macOS-specific: access to argc/argv
    // These are from <crt_externs.h> on macOS
    // We use raw pointers and manual pointer math to avoid nested generic issues
    func _NSGetArgc() -> UnsafePointer<Int8>
    func _NSGetArgv() -> UnsafePointer<Int8>

    // Memory
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Refcounted String runtime (defined by the compiler): copy a C string
    // (argv entry, getenv value) into an owned String with a proper header. A
    // bare `ptr as String` yields a header-less pointer that corrupts on
    // len()/release, and would alias memory the C library owns.
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// Env - Static methods for environment access
// =============================================================================
// Note: Env is a marker struct for static methods only

struct Env {
    _unused: Int
}

extension Env {
    // =========================================================================
    // Command-line arguments
    // =========================================================================

    // Get the number of command-line arguments
    func argc() -> Int {
        // _NSGetArgc returns int*, we read the first i32
        let argc_ptr = _NSGetArgc() as UnsafePointer<Int32>
        argc_ptr[0] as Int
    }

    // Get a specific command-line argument by index
    // Returns None if index is out of bounds
    func arg(index: Int) -> String? {
        let argc = Env.argc()
        if index < 0 || index >= argc {
            return None
        }
        // _NSGetArgv returns char***, we need argv[index]
        // First dereference to get argv (char**)
        let argv_ptr_ptr = _NSGetArgv() as UnsafePointer<UnsafePointer<Int8>>
        let argv = argv_ptr_ptr[0]  // Now we have char**
        // Get the indexed string pointer - need to treat as array of pointers
        let argv_as_ptr_array = argv as UnsafePointer<UnsafePointer<Int8>>
        let arg_ptr = argv_as_ptr_array[index]
        __saw_string_from_bytes(arg_ptr, strlen(arg_ptr))
    }

    // Get all command-line arguments as a Vector<String>
    func args() -> Vector<String> {
        var result = Vector<String>()
        let argc = Env.argc()
        var i = 0
        while i < argc {
            if let arg = Env.arg(i) {
                result.push(arg)
            }
            i = i + 1
        }
        move result
    }

    // =========================================================================
    // Environment variables
    // =========================================================================

    // Get an environment variable value
    // Returns None if the variable is not set
    func get(name: String) -> String? {
        let name_ptr = name as UnsafePointer<Int8>
        if let value_ptr = getenv(name_ptr) {
            __saw_string_from_bytes(value_ptr, strlen(value_ptr))
        } else {
            None
        }
    }

    // Set an environment variable
    // If overwrite is true, replaces existing value
    // Returns true if successful
    func set(name: String, value: String, overwrite: Bool = true) -> Bool {
        let name_ptr = name as UnsafePointer<Int8>
        let value_ptr = value as UnsafePointer<Int8>
        let overwrite_flag = if overwrite { 1 as Int32 } else { 0 as Int32 }
        setenv(name_ptr, value_ptr, overwrite_flag) == (0 as Int32)
    }

    // Remove an environment variable
    // Returns true if successful
    func unset(name: String) -> Bool {
        let name_ptr = name as UnsafePointer<Int8>
        unsetenv(name_ptr) == (0 as Int32)
    }

    // Check if an environment variable is set
    func contains(name: String) -> Bool {
        let name_ptr = name as UnsafePointer<Int8>
        if let _ = getenv(name_ptr) {
            true
        } else {
            false
        }
    }

    // =========================================================================
    // Working directory (convenience wrappers around Directory)
    // =========================================================================

    // Get current working directory
    // Note: This is a convenience wrapper around Directory.current()
    func cwd() -> Path? {
        Directory.current()
    }

    // Set current working directory
    // Note: This is a convenience wrapper around Directory.set_current()
    func set_cwd(path: Path) -> Bool {
        Directory.set_current(path)
    }
}
