// Env - Environment access for the Saw standard library
// Part of the Saw standard library
//
// Provides access to command-line arguments and environment variables.
// Command-line arguments come from the C entry `main(argc, argv)`, which the
// compiler stashes into runtime globals at startup (design 81 CI rider); the
// `__saw_rt_get_argc`/`__saw_rt_get_argv` seams read them on every platform (this
// replaced the Apple-only `_NSGetArgc`/`_NSGetArgv`, which broke the Linux link).

// =============================================================================
// FFI declarations for environment access
// =============================================================================

extern "C" {
    // Environment variables
    func getenv(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    // design 117: status-carrying env ops (0 = ok, -SysError tag on failure).
    func __saw_rt_env_set(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int) -> Int
    func __saw_rt_env_unset(name: UnsafePointer<Int8>) -> Int

    // Command-line argc/argv, captured from the C entry `main` and exposed by
    // compiler-defined seams (design 81 CI rider). `__saw_rt_get_argv` returns the
    // `char**` argv value main received; `__saw_rt_get_argc` returns the count.
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>

    // Memory
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Refcounted String runtime (defined by the compiler): copy a C string
    // (argv entry, getenv value) into an owned String with a proper header. A
    // bare `ptr as String` yields a header-less pointer that corrupts on
    // len()/release, and would alias memory the C library owns.
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// Env - Static methods for environment access
// =============================================================================
// Note: Env is a marker struct for static methods only

struct Env {
    _unused: Int
}

extension Env {
    // =========================================================================
    // Command-line arguments
    // =========================================================================

    // Get the number of command-line arguments
    public func argc() -> Int {
        __saw_rt_get_argc() as Int
    }

    // Get a specific command-line argument by index
    // Returns None if index is out of bounds
    public func arg(index: Int) unsafe -> String? {
        let argc = Env.argc()
        if index < 0 || index >= argc {
            return None
        }
        // argv is `char**`; index it directly for the C string at `index`.
        let argv = __saw_rt_get_argv()
        let arg_ptr = argv[index]
        __saw_string_from_bytes(arg_ptr, strlen(arg_ptr))
    }

    // Get all command-line arguments as a Vector<String>
    public func args() -> Vector<String> {
        var result = Vector<String>()
        let argc = Env.argc()
        var i = 0
        while i < argc {
            if let arg = Env.arg(i) {
                result.push(arg)
            }
            i = i + 1
        }
        move result
    }

    // =========================================================================
    // Environment variables
    // =========================================================================

    // Get an environment variable value
    // Returns None if the variable is not set
    public func get(name: String) unsafe -> String? {
        let name_ptr = name as UnsafePointer<Int8>
        if let value_ptr = getenv(name_ptr) {
            __saw_string_from_bytes(value_ptr, strlen(value_ptr))
        } else {
            None
        }
    }

    // Set an environment variable (replacing an existing value when overwrite is
    // true). Ok on success, Err(IoError) with the errno on failure (design 92 —
    // a Bool hid the cause, e.g. EINVAL for a malformed name).
    public func set(name: String, value: String, overwrite: Bool = true) unsafe -> Result<Void, IoError> {
        let name_ptr = name as UnsafePointer<Int8>
        let value_ptr = value as UnsafePointer<Int8>
        let overwrite_flag = if overwrite { 1 } else { 0 }
        let e = __saw_rt_env_set(name_ptr, value_ptr, overwrite_flag)
        if e != 0 {
            return IoError.of("setenv", -e)
        }
        return
    }

    // Remove an environment variable. Ok on success, Err(IoError) with the SysError.
    public func unset(name: String) unsafe -> Result<Void, IoError> {
        let name_ptr = name as UnsafePointer<Int8>
        let e = __saw_rt_env_unset(name_ptr)
        if e != 0 {
            return IoError.of("unsetenv", -e)
        }
        return
    }

    // Check if an environment variable is set
    public func contains(name: String) unsafe -> Bool {
        let name_ptr = name as UnsafePointer<Int8>
        if let _ = getenv(name_ptr) {
            true
        } else {
            false
        }
    }

    // =========================================================================
    // Working directory (convenience wrappers around Directory)
    // =========================================================================

    // Get current working directory
    // Note: This is a convenience wrapper around Directory.current()
    public func cwd() -> Path? {
        Directory.current()
    }

    // Set current working directory (convenience wrapper around
    // Directory.set_current()). Ok on success, Err(IoError) with the errno.
    public func set_cwd(path: Path) -> Result<Void, IoError> {
        Directory.set_current(path)
    }
}
