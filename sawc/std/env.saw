// Env: command-line arguments and environment variables.

extern "C" {
    func getenv(name: UnsafePointer<Int8>) -> UnsafePointer<Int8>?
    // Status-carrying: 0 on success, the negated SysError tag on failure.
    func __saw_rt_env_set(name: UnsafePointer<Int8>, value: UnsafePointer<Int8>, overwrite: Int) -> Int
    func __saw_rt_env_unset(name: UnsafePointer<Int8>) -> Int

    // The argc/argv the C entry `main` received, which the compiler stashes in
    // runtime globals at startup.
    func __saw_rt_get_argc() -> Int32
    func __saw_rt_get_argv() -> UnsafePointer<UnsafePointer<Int8>>

    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
    func strlen(s: UnsafePointer<Int8>) -> Int

    // The running executable's resolved path in a buffer the caller frees, or
    // NULL; where a host finds it is the runtime's business (rt/ABI.md, "The
    // executable's path").
    func __saw_rt_executable_path(status_out: UnsafePointer<Int>) -> UnsafePointer<Int8>?

    // Copies a C string (argv entry, getenv value) into an owned String. A bare
    // `ptr as String` would be header-less, corrupt on len() or release, and
    // alias memory the C library owns.
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// A namespace for static methods; never constructed.
public struct Env {
    private _unused: Int
}

extension Env {
    public static func argc() -> Int {
        __saw_rt_get_argc() as Int
    }

    public static func arg(index: Int) unsafe -> String? {
        let argc = Env.argc()
        if index < 0 || index >= argc {
            return None
        }
        let argv = __saw_rt_get_argv()
        let arg_ptr = argv[index]
        __saw_string_from_bytes(arg_ptr, strlen(arg_ptr))
    }

    // All command-line arguments, reporting a refused allocation.
    public static func args() -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let argc = Env.argc()
        var i = 0
        while i < argc {
            if let arg = Env.arg(i) {
                let _ = try result.push(arg)
            }
            i = i + 1
        }
        return move result
    }

    public static func get(name: String) unsafe -> String? {
        let name_ptr = name as UnsafePointer<Int8>
        if let value_ptr = getenv(name_ptr) {
            __saw_string_from_bytes(value_ptr, strlen(value_ptr))
        } else {
            None
        }
    }

    // Set an environment variable (replacing an existing value when overwrite is
    // true). `Err` carries the errno cause, e.g. EINVAL for a malformed name.
    public static func set(name: String, value: String, overwrite: Bool = true) unsafe -> Result<Void, IoError> {
        let name_ptr = name as UnsafePointer<Int8>
        let value_ptr = value as UnsafePointer<Int8>
        let overwrite_flag = if overwrite { 1 } else { 0 }
        let e = __saw_rt_env_set(name_ptr, value_ptr, overwrite_flag)
        if e != 0 {
            return IoError.of("setenv", -e)
        }
        return
    }

    // Remove an environment variable. `Err` carries the errno cause.
    public static func unset(name: String) unsafe -> Result<Void, IoError> {
        let name_ptr = name as UnsafePointer<Int8>
        let e = __saw_rt_env_unset(name_ptr)
        if e != 0 {
            return IoError.of("unsetenv", -e)
        }
        return
    }

    public static func contains(name: String) unsafe -> Bool {
        let name_ptr = name as UnsafePointer<Int8>
        if let _ = getenv(name_ptr) {
            true
        } else {
            false
        }
    }

    // The running executable's file, absolute and with every symbolic link
    // resolved, wherever the program was started from: by a bare name through
    // `PATH` or through a link, where `argv[0]` names neither. `Err` carries
    // the cause the runtime gave when the path cannot be read, resolved or
    // allocated: `NotFound` when the file was removed while the program runs
    // (on Linux its link then reads `… (deleted)`) or on a target with no
    // executable file.
    public static func executable_path() unsafe -> Result<String, IoError> {
        var status = 0
        guard let resolved = __saw_rt_executable_path((&status) as UnsafePointer<Int>) else {
            return IoError.of(syscall: "executable_path", tag: status)
        }
        let text = __saw_string_from_bytes(resolved, strlen(resolved))
        free(resolved)
        return text
    }

    // Convenience wrapper around `Directory.current()`.
    public static func cwd() -> Path? {
        Directory.current()
    }

    // Convenience wrapper around `Directory.set_current()`.
    public static func set_cwd(path: Path) -> Result<Void, IoError> {
        Directory.set_current(path)
    }
}
