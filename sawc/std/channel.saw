// Channel<T: Send> - an unbounded MPMC message queue (design 21 item 6).
//
// Go-style: Channel is an ImplicitCopy HANDLE onto a shared, internally
// refcounted queue. Cloning the handle (copy() == refcount bump) shares the
// same queue; the last handle to drop drains and frees it. `T: Send` is required
// on the type itself, so only thread-safe payloads can be enqueued.
//
// Shared block layout (allocated via __saw_rt_alloc, 16-aligned):
//     [0,   64)  pthread_mutex_t   (conservative 64-byte slot; see mutex.saw)
//     [64, 128)  pthread_cond_t    (conservative 64-byte slot; real max 48)
//     [128,136)  refcount : i64    (handle count; ImplicitCopy/Deinit)
//     [136,144)  count    : i64    (queued elements; guards head/tail validity)
//     [144,152)  head     : i8*    (first node; valid only while count > 0)
//     [152,160)  tail     : i8*    (last node;  valid only while count > 0)
// Total 160 bytes.
//
// Node layout (__saw_rt_alloc'd per send):
//     [0, 8)              next  : i8*   (valid only for non-tail nodes)
//     [8, 8+sizeof(T))    value : T
//
// A `count` field (rather than null head/tail sentinels — Saw has no null
// pointer literal) marks emptiness: head/tail are read only when count > 0, so
// no null pointer is ever dereferenced.
//
// recv() blocks the calling thread on the condvar while the queue is empty.
// DOCUMENTED: under the future cooperative engine recv becomes a suspension
// point; the API shape (`recv() -> T`) is unchanged.

extern "C" {
    // Atomic seams (see arc.saw / core.py) for the handle refcount.
    func __saw_atomic_add_i64(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_sub_i64_release(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_fence_acquire()

    // pthread primitives (resolve from libSystem/libc; init wrappers in codegen).
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<Int8>)
    func __saw_rt_pthread_cond_init_default(c: UnsafePointer<Int8>)
    func pthread_mutex_lock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_unlock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_destroy(m: UnsafePointer<Int8>) -> Int
    func pthread_cond_wait(c: UnsafePointer<Int8>, m: UnsafePointer<Int8>) -> Int
    func pthread_cond_signal(c: UnsafePointer<Int8>) -> Int
    func pthread_cond_destroy(c: UnsafePointer<Int8>) -> Int
}

struct Channel<T: Send> {
    // Shared block pointer. Always live in a constructed Channel — `init`
    // panics rather than build an inert one (design 123). The field keeps its
    // optional TYPE because the block is also reached through the refcounted
    // handle protocol below; the `None` case is unreachable.
    block: UnsafePointer<Int8>?
}

extension Channel<T: Send> {
    /// Creates a fresh empty channel.
    ///
    /// Panics if the allocator refuses the shared block (design 123,
    /// infallible tier). It used to build an INERT channel: `send` swallowed
    /// every message, `recv` force-unwrapped a `None` and `receive` looped
    /// forever. `try_make` reports the failure instead.
    public unsafe init() -> Channel<T> {
        if let block = GlobalAllocator().alloc(160, 16) {
            __saw_rt_pthread_mutex_init_default(block)
            let cond = (block + 64) as UnsafePointer<Int8>
            __saw_rt_pthread_cond_init_default(cond)
            let refcount = (block + 128) as UnsafePointer<Int>
            refcount[0] = 1
            let count = (block + 136) as UnsafePointer<Int>
            count[0] = 0
            Channel<T>(block: block)
        } else {
            panic("Channel(): allocation failed")
        }
    }

    /// Creates a fresh empty channel, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    public unsafe func try_make() -> Result<Channel<T>, AllocError> {
        if let block = GlobalAllocator().alloc(160, 16) {
            __saw_rt_pthread_mutex_init_default(block)
            let cond = (block + 64) as UnsafePointer<Int8>
            __saw_rt_pthread_cond_init_default(cond)
            let refcount = (block + 128) as UnsafePointer<Int>
            refcount[0] = 1
            let count = (block + 136) as UnsafePointer<Int>
            count[0] = 0
            return Channel<T>(block: block)
        }
        return AllocError(size: 160, align: 16)
    }

    /// Enqueues a value, waking one blocked receiver.
    ///
    /// Ownership of `v` transfers to the channel. Panics if the queue node
    /// cannot be allocated (design 123, infallible tier): this returned `Void`
    /// and wrapped the whole enqueue in an unguarded `if let`, so on allocator
    /// exhaustion the message was consumed, destroyed and never delivered —
    /// with no signal to either end. `try_send` reports the failure instead.
    public func send(&self, v: T) {
        if not self._enqueue(move v) {
            panic("Channel.send: allocation failed")
        }
    }

    /// Enqueues a value, reporting allocator exhaustion as `Err(AllocError)`.
    ///
    /// The queue is unchanged on `Err`; `v` is consumed either way.
    public func try_send(&self, v: T) -> Result<Void, AllocError> {
        if not self._enqueue(move v) {
            return AllocError(size: 8 + sizeof<T>(), align: 16)
        }
        return
    }

    // Internal: the enqueue itself. Returns whether the node was allocated and
    // linked; FALSE leaves the queue untouched (and `v`, unmoved, deinits at
    // this scope's exit rather than vanishing into a half-built node).
    unsafe func _enqueue(&self, v: T) -> Bool {
        if let block = self.block {
            pthread_mutex_lock(block)
            // Allocate and fill a node { next, value }.
            if let node = GlobalAllocator().alloc(8 + sizeof<T>(), 16) {
                let val_slot = (node + 8) as UnsafePointer<T>
                val_slot[0] = v
                let count = (block + 136) as UnsafePointer<Int>
                let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
                let tail_slot = (block + 152) as UnsafePointer<UnsafePointer<Int8>>
                if count[0] == 0 {
                    head_slot[0] = node
                    tail_slot[0] = node
                } else {
                    let old_tail = tail_slot[0]
                    let old_tail_next = old_tail as UnsafePointer<UnsafePointer<Int8>>
                    old_tail_next[0] = node
                    tail_slot[0] = node
                }
                count[0] = count[0] + 1
                let cond = (block + 64) as UnsafePointer<Int8>
                pthread_cond_signal(cond)
                pthread_mutex_unlock(block)
                return true
            }
            pthread_mutex_unlock(block)
            return false
        }
        false
    }

    // Non-blocking dequeue (design 52b): the head value if the queue is
    // non-empty, else `None` IMMEDIATELY — it NEVER blocks the thread. This is
    // the primitive the cooperative task engine builds its suspending receive on:
    // a task loops
    //     while true { if let v = ch.try_receive() { ...; break } else { yield_now() } }
    // so an empty channel suspends the TASK (not the thread) and the executor
    // reschedules it — wake-on-send folded into yield-requeue (Part 0 loop
    // suspension). The cancellation-aware form adds `if cancelled() { ... }` to the
    // loop, returning through normal control flow (NO forced destroy). The 21b
    // thread engine's blocking `recv` (below) is untouched and coexists.
    public unsafe func try_receive(&self) -> T? {
        if let block = self.block {
            pthread_mutex_lock(block)
            let count = (block + 136) as UnsafePointer<Int>
            if count[0] == 0 {
                pthread_mutex_unlock(block)
                return None
            }
            let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
            let node = head_slot[0]
            let val_slot = (node + 8) as UnsafePointer<T>
            let value = val_slot[0]
            count[0] = count[0] - 1
            if count[0] > 0 {
                let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                head_slot[0] = node_next[0]
            }
            GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
            pthread_mutex_unlock(block)
            return value
        }
        return None
    }

    // COOPERATIVE suspending receive (design 62 G3). The first-class packaging of
    // the design-52b `try_receive()` + `yield_now()` loop: it dequeues a value if
    // one is ready, else SUSPENDS THE TASK (not the thread) and is rescheduled by
    // the executor — wake-on-send folded into yield-requeue (channel-yield wake
    // reason). Distinct name from the 21b thread-engine `recv()` below (same
    // signature `(&self) -> T`, so overloading — which can't differ by effect —
    // cannot tell them apart). The coroutine transform (design 62) LOWERS a
    // `let v = ch.receive()` / `ch.receive()` call site INLINE into this loop
    // against the caller's own frame; this body is the reference semantics and the
    // effect-inference source (it reaches `yield_now`, so it — and any caller —
    // suspends), and is never itself monomorphized (every call site is rewritten).
    public func receive(&self) -> T {
        var __got: T? = None
        var __done = false
        while not __done {
            if let v = self.try_receive() {
                return v
            }
            yield_now()      // channel empty: suspend the task, retry when rescheduled
        }
        __got!               // unreachable (loop only exits via `return`)
    }

    // Dequeue a value, blocking the CALLING THREAD while the queue is empty (the
    // design-21b thread-per-task engine; untouched by the cooperative engine).
    public unsafe func recv(&self) -> T {
        if let block = self.block {
            pthread_mutex_lock(block)
            let count = (block + 136) as UnsafePointer<Int>
            let cond = (block + 64) as UnsafePointer<Int8>
            while count[0] == 0 {
                pthread_cond_wait(cond, block)
            }
            let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
            let tail_slot = (block + 152) as UnsafePointer<UnsafePointer<Int8>>
            let node = head_slot[0]
            let val_slot = (node + 8) as UnsafePointer<T>
            let value = val_slot[0]
            count[0] = count[0] - 1
            if count[0] > 0 {
                let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                head_slot[0] = node_next[0]
            }
            GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
            pthread_mutex_unlock(block)
            value
        } else {
            // Unreachable: a constructed Channel always has its block (design
            // 123). This used to be `empty!` — a force-unwrap of None whose
            // panic said nothing about what had actually gone wrong.
            panic("Channel.recv: channel has no shared block")
        }
    }
}

// A Channel handle copies by retaining the shared block, so its policy is
// ImplicitCopy and its `deinit` lives inside that conformance (design 131).
extension Channel<T: Send>: ImplicitCopy {
    public unsafe func deinit(&var self) {
        if let block = self.block {
            let refcount = (block + 128) as UnsafePointer<Int>
            let old = __saw_atomic_sub_i64_release(refcount, 1)
            if old == 1 {
                // Last handle. Order other threads' final ops, then drain the
                // queue (drop each remaining value, free each node) and tear the
                // block down. No locking needed: no other handle survives.
                __saw_atomic_fence_acquire()
                let count = (block + 136) as UnsafePointer<Int>
                let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
                while count[0] > 0 {
                    let node = head_slot[0]
                    let val_slot = (node + 8) as UnsafePointer<T>
                    __saw_deinit_in_place(val_slot)
                    count[0] = count[0] - 1
                    if count[0] > 0 {
                        let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                        head_slot[0] = node_next[0]
                    }
                    GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
                }
                let cond = (block + 64) as UnsafePointer<Int8>
                pthread_cond_destroy(cond)
                pthread_mutex_destroy(block)
                GlobalAllocator().dealloc(block, 160, 16)
            }
        }
    }

    // Retain: a live handle keeps the queue alive, so monotonic is enough.
    public unsafe func copy(&self) -> Channel<T> {
        if let block = self.block {
            let refcount = (block + 128) as UnsafePointer<Int>
            __saw_atomic_add_i64(refcount, 1)
        }
        Channel<T>(block: self.block)
    }
}
