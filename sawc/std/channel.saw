// Channel<T: Send>: an unbounded MPMC message queue. A Channel is a Copy handle
// onto a shared, refcounted block; copying the handle shares the queue, and the
// last handle to drop drains and frees it.
//
// Shared block layout (16-aligned):
//     [0,   64)  pthread_mutex_t   (conservative 64-byte slot; see mutex.saw)
//     [64, 128)  pthread_cond_t    (conservative 64-byte slot; real max 48)
//     [128,136)  refcount : i64    (handle count; Copy/Deinit)
//     [136,144)  count    : i64    (queued elements; guards head/tail validity)
//     [144,152)  head     : i8*    (first node; valid only while count > 0)
//     [152,160)  tail     : i8*    (last node;  valid only while count > 0)
//     [160,168)  ready    : i64    (the park readiness word)
//     [168,176)  closed   : i64    (set once by `close()`)
// Total 176 bytes.
//
// The readiness word is all the executor knows about a channel. A waiting task
// parks with the word's negated address as its wake reason and is resumed once
// the word is nonzero, so the scheduler needs no channel knowledge and a send
// wakes only the receivers of this channel. Invariant, kept under the block's
// mutex: `ready != 0` exactly when `count > 0` or `closed` (design 230).
//
// Disconnection is explicit. Handles have no sender/receiver split, so "the
// last sender went away" is not countable (a waiting receiver's own handle
// keeps the refcount up); any holder calls `close()` instead.
//
// Node layout (allocated per send):
//     [0, 8)              next  : i8*   (valid only for non-tail nodes)
//     [8, 8+sizeof(T))    value : T
//
// Saw has no null pointer literal, so `count` marks emptiness and head/tail are
// read only when it is positive.

extern "C" {
    // Atomic seams (see arc.saw) for the handle refcount.
    func __saw_atomic_add_i64(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_sub_i64_release(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_fence_acquire()

    // The init wrappers are runtime seams (rt/common/pthread.saw).
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<Int8>)
    func __saw_rt_pthread_cond_init_default(c: UnsafePointer<Int8>)
    func pthread_mutex_lock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_unlock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_destroy(m: UnsafePointer<Int8>) -> Int
    func pthread_cond_wait(c: UnsafePointer<Int8>, m: UnsafePointer<Int8>) -> Int
    func pthread_cond_signal(c: UnsafePointer<Int8>) -> Int
    // `close()` must release every thread blocked in `recv`, not one.
    func pthread_cond_broadcast(c: UnsafePointer<Int8>) -> Int
    func pthread_cond_destroy(c: UnsafePointer<Int8>) -> Int
}

/// Why a channel operation could not be carried out.
///
/// `Closed` is reported by `receive` once a closed channel has been drained, and
/// by `send` and `close` on a channel that is already closed. `Cancelled` is
/// reported by `receive` when the task waiting was cancelled, so a consumer
/// parked on a channel ends the same way one parked on a socket does. `Alloc`
/// carries the allocator's own refusal when a queue node cannot be made.
public enum ChannelError {
    /// The channel was closed with `close()` and, for `receive`, drained.
    case Closed,
    /// The waiting task was cancelled. `receive` reports it before it looks at
    /// the queue, so a cancelled consumer stops rather than taking one more
    /// message; nothing is dequeued and the channel is untouched.
    case Cancelled,
    /// The allocator refused the queue node a `send` needed, with the size and
    /// alignment it asked for.
    case Alloc(e: AllocError)
}

extension ChannelError {
    /// A short description of the failure.
    public func describe(&self) -> String {
        match self {
            case Closed -> "channel is closed",
            case Cancelled -> "the receiving task was cancelled",
            case Alloc(_) -> "the channel could not allocate a queue node"
        }
    }
}

extension ChannelError: Printable {
    public func format(&self, into: &var StringBuilder) {
        match self {
            // The leaf renders itself, so the report carries the refused size.
            case Alloc(e) -> {
                try! into.append(self.describe())
                try! into.append(": ")
                e.format(into: &var into)
            },
            case _ -> try! into.append(self.describe())
        }
    }
}

extension ChannelError: Error {}

// `send` maps each outcome onto a `ChannelError` case.
enum __EnqueueOutcome {
    case Sent
    case Closed
    case NoMemory
}

public struct Channel<T: Send> {
    // Always `Some` in a constructed Channel: `init` reports allocator failure
    // rather than build a channel without a block. The `None` arms below are
    // unreachable.
    private block: UnsafePointer<Int8>?
}

// The handle is an Arc-like pointer at a block whose queue is guarded by its own
// lock, so it is Send and Sync whenever the messages may cross threads.
extension Channel<T: Send>: UnsafeSend {}
extension Channel<T: Send>: UnsafeSync {}

extension Channel<T: Send> {
    /// Creates a fresh empty channel, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    public init() unsafe -> Result<Channel<T>, AllocError> {
        if let block = GlobalAllocator().alloc(176, 16) {
            __saw_rt_pthread_mutex_init_default(block)
            let cond = (block + 64) as UnsafePointer<Int8>
            __saw_rt_pthread_cond_init_default(cond)
            let refcount = (block + 128) as UnsafePointer<Int>
            refcount[0] = 1
            let count = (block + 136) as UnsafePointer<Int>
            count[0] = 0
            let ready = (block + 160) as UnsafePointer<Int>
            ready[0] = 0
            let closed = (block + 168) as UnsafePointer<Int>
            closed[0] = 0
            return Channel<T>(block: block)
        }
        return AllocError(size: 176, align: 16)
    }

    // The wake reason a task waiting on this channel parks with: the negated
    // address of the readiness word. The negative half of the executor's wake
    // word is where parks live; -1 is the io park, and a readiness word is
    // 8-aligned and never at address 0, so the two cannot collide.
    //
    // `public` only because the coroutine transform's receive lowering emits
    // this call by its plain spelling (sawc/coro_transform.py).
    //
    // For the unreachable `None` block, 0 means "ready": the task is
    // rescheduled at once rather than parked on an address that is not one.
    public func __park_word(&self) unsafe sync -> Int {
        if let block = self.block {
            let ready = (block + 160) as UnsafePointer<Int>
            return 0 - (ready as Int)
        }
        0
    }

    /// Enqueues a value, waking the receivers waiting on this channel.
    ///
    /// Ownership of `v` transfers to the channel, and `v` is consumed whatever
    /// the answer. Both ways a send can fail come back as values:
    ///
    /// - `Err(Closed)` — the channel has been closed. The queue is unchanged
    ///   and `v` is dropped here; a closed channel takes no more messages, and
    ///   the caller finding out is the point.
    /// - `Err(Alloc(e))` — the allocator refused the queue node, with the size
    ///   and alignment it was asked for. The queue is unchanged.
    public func send(&self, v: T) -> Result<Void, ChannelError> {
        match self._enqueue(move v) {
            case Sent -> { return },
            case Closed -> { return ChannelError.Closed },
            case NoMemory -> {
                return ChannelError.Alloc(e: AllocError(size: 8 + sizeof<T>(),
                                                        align: 16))
            }
        }
    }

    /// Closes the channel: no further message will be accepted, and every
    /// receiver waiting on it is woken.
    ///
    /// Any holder may call it, since a channel handle carries no sender or
    /// receiver role. By convention the producer does, once it has sent its
    /// last message.
    ///
    /// Messages already queued are not lost: a receive drains what is there
    /// before it reports `Closed`. Closing an already-closed channel returns
    /// `Err(Closed)` rather than panicking, so a close that races another one is
    /// a value to inspect and idempotent to ignore with `let _ =`.
    public func close(&self) unsafe -> Result<Void, ChannelError> {
        if let block = self.block {
            pthread_mutex_lock(block)
            let closed = (block + 168) as UnsafePointer<Int>
            if closed[0] != 0 {
                pthread_mutex_unlock(block)
                return ChannelError.Closed
            }
            closed[0] = 1
            // A closed channel is permanently ready: every parked receiver
            // has an answer, a queued message or `Closed`.
            self._publish_ready(block)
            // Broadcast, not signal: every thread blocked in `recv` must wake.
            let cond = (block + 64) as UnsafePointer<Int8>
            pthread_cond_broadcast(cond)
            pthread_mutex_unlock(block)
            __saw_exec_chan_wake()
            return
        }
        return ChannelError.Closed
    }

    // The one place the readiness invariant is written. Every change to what a
    // waiting receiver would find calls this with the block's mutex held, so
    // the word cannot drift from the queue's state. Entry points:
    //     close
    //     _enqueue (after the link)
    //     _take_one (after the unlink)
    //     recv (after the unlink)
    func _publish_ready(&self, block: UnsafePointer<Int8>) unsafe sync {
        let count = (block + 136) as UnsafePointer<Int>
        let closed = (block + 168) as UnsafePointer<Int>
        let ready = (block + 160) as UnsafePointer<Int>
        if count[0] > 0 || closed[0] != 0 {
            ready[0] = 1
        } else {
            ready[0] = 0
        }
    }

    // Callers hold the block's mutex: "closed" and "empty" must be one fact,
    // or a racing `close()` or `send` could report Closed with a message still
    // queued.
    func _closed_and_drained(&self, block: UnsafePointer<Int8>) unsafe sync -> Bool {
        let count = (block + 136) as UnsafePointer<Int>
        let closed = (block + 168) as UnsafePointer<Int>
        closed[0] != 0 && count[0] == 0
    }

    // Anything other than `Sent` leaves the queue untouched, and `v`, unmoved,
    // deinits at scope exit rather than vanishing into a half-built node.
    func _enqueue(&self, v: T) unsafe -> __EnqueueOutcome {
        if let block = self.block {
            pthread_mutex_lock(block)
            // The closed test shares the lock with the link, so a racing
            // `close()` either wins outright (nothing queued) or loses outright
            // (queued, and a receiver will drain it).
            let closed = (block + 168) as UnsafePointer<Int>
            if closed[0] != 0 {
                pthread_mutex_unlock(block)
                return __EnqueueOutcome.Closed
            }
            if let node = GlobalAllocator().alloc(8 + sizeof<T>(), 16) {
                let val_slot = (node + 8) as UnsafePointer<T>
                val_slot[0] = v
                let count = (block + 136) as UnsafePointer<Int>
                let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
                let tail_slot = (block + 152) as UnsafePointer<UnsafePointer<Int8>>
                if count[0] == 0 {
                    head_slot[0] = node
                    tail_slot[0] = node
                } else {
                    let old_tail = tail_slot[0]
                    let old_tail_next = old_tail as UnsafePointer<UnsafePointer<Int8>>
                    old_tail_next[0] = node
                    tail_slot[0] = node
                }
                count[0] = count[0] + 1
                self._publish_ready(block)
                let cond = (block + 64) as UnsafePointer<Int8>
                pthread_cond_signal(cond)
                pthread_mutex_unlock(block)
                // An engine blocked on another thread will not see the
                // published word until its wait returns; this poke ends that
                // wait. Not needed for correctness (every channel park is
                // bounded and re-scans), only for cross-thread latency.
                __saw_exec_chan_wake()
                return __EnqueueOutcome.Sent
            }
            pthread_mutex_unlock(block)
            return __EnqueueOutcome.NoMemory
        }
        __EnqueueOutcome.NoMemory
    }

    /// Takes the next message if one is already queued, and answers at once
    /// either way.
    ///
    /// - `Ok(Some(v))` — a message, dequeued.
    /// - `Ok(None)` — nothing yet. Would-block is not an error; it is the
    ///   normal answer to a poll.
    /// - `Err(Closed)` — the channel is closed and drained, so no message will
    ///   ever arrive. This is why the answer is a `Result` and not a bare `T?`:
    ///   a closed channel must not look like an empty one.
    ///
    /// Never blocks the thread and never suspends the task. `receive()` is the
    /// spelling that parks until a message arrives.
    ///
    /// In a drain loop, `try` peels off the error and leaves the optional:
    ///
    /// ```saw
    /// func drain(ch: Channel<Job>) -> Result<Int, ChannelError> {
    ///     var n = 0
    ///     while let job = try ch.try_receive() {   // ends on empty, propagates on closed
    ///         run(job)
    ///         n = n + 1
    ///     }
    ///     return n
    /// }
    /// ```
    public func try_receive(&self) unsafe -> Result<T?, ChannelError> {
        if let v = self._take_one() {
            return move v
        }
        if let block = self.block {
            pthread_mutex_lock(block)
            let drained = self._closed_and_drained(block)
            pthread_mutex_unlock(block)
            if drained {
                return ChannelError.Closed
            }
        }
        return self._nothing_yet()
    }

    // `Ok(None)`: the annotated local fixes the payload type of the `None`,
    // which is `T?` for a type parameter.
    func _nothing_yet(&self) unsafe sync -> Result<T?, ChannelError> {
        let absent: T? = None
        return absent
    }

    // The non-blocking dequeue: the head value, or `None` at once if the queue
    // is empty. It does not test `closed`; its callers (`try_receive`,
    // `__try_receive_result`) do.
    func _take_one(&self) unsafe -> T? {
        if let block = self.block {
            pthread_mutex_lock(block)
            let count = (block + 136) as UnsafePointer<Int>
            if count[0] == 0 {
                pthread_mutex_unlock(block)
                return None
            }
            let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
            let node = head_slot[0]
            let val_slot = (node + 8) as UnsafePointer<T>
            // The node is freed below, so the value's ownership leaves here.
            let value = move val_slot[0]
            count[0] = count[0] - 1
            if count[0] > 0 {
                let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                head_slot[0] = node_next[0]
            }
            self._publish_ready(block)
            GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
            pthread_mutex_unlock(block)
            return value
        }
        return None
    }

    // The non-suspending step a cooperative receive is built from:
    // `Some(Ok(v))` for a message, `Some(Err(Closed))` when closed and drained,
    // and `None`, the only answer that means "park", when empty and open. A
    // queued message is taken before the closed test, so closing loses none.
    // An Optional because the transform's inline lowering is an `if let`.
    //
    // `public` only because the coroutine transform emits this call by its
    // plain spelling (sawc/coro_transform.py).
    public func __try_receive_result(&self) unsafe -> Result<T, ChannelError>? {
        if let v = self._take_one() {
            return self._delivered(move v)
        }
        if let block = self.block {
            pthread_mutex_lock(block)
            let drained = self._closed_and_drained(block)
            pthread_mutex_unlock(block)
            if drained {
                return self._closed()
            }
        }
        None
    }

    // Separate functions because auto-wrap does not reach through two layers:
    // the caller returns `Result<T, ChannelError>?`, so each `Result` is built
    // here, at a return whose declared type is the `Result`.
    func _delivered(&self, v: T) unsafe sync -> Result<T, ChannelError> {
        return move v
    }

    func _closed(&self) unsafe sync -> Result<T, ChannelError> {
        return ChannelError.Closed
    }

    // `public` only because the transform emits this call on the receive
    // lowering's cancel arm.
    public func __cancelled_result(&self) unsafe sync -> Result<T, ChannelError> {
        return ChannelError.Cancelled
    }

    /// Waits for the next message, suspending the task rather than the thread.
    ///
    /// Returns `Err(Closed)` once the channel has been closed and everything
    /// already queued has been handed out, so a consumer loop ends when its
    /// producer says it is done. Returns `Err(Cancelled)` if the waiting task
    /// is cancelled.
    ///
    /// ```saw
    /// while true {
    ///     match inbox.receive() {
    ///         case Ok(job) -> run(job),
    ///         case Err(_) -> break
    ///     }
    /// }
    /// ```
    ///
    /// A channel nobody closes and nobody sends to is a deadlock, and the
    /// executor reports it as one rather than waiting forever.
    //
    //
    // A different name from `recv()` because overloads cannot differ by
    // effect. The coroutine transform lowers every `receive()` call site inline
    // into the caller's frame, so this body is the reference semantics and the
    // effect-inference source; the lowering in sawc/coro_transform.py must
    // agree with it step for step.
    public func receive(&self) -> Result<T, ChannelError> {
        var __got: Result<T, ChannelError>? = None
        var __done = false
        while not __done {
            // Cancellation is observed at the loop top, as in every std.net
            // park loop, and ahead of the queue read so a cancelled consumer
            // takes no more messages.
            if cancelled() {
                return ChannelError.Cancelled
            }
            if let r = self.__try_receive_result() {
                return move r
            }
            // Park on this channel's readiness word rather than yield: a
            // waiting receiver costs no CPU until a send or close publishes it.
            __saw_chan_park(self.__park_word())
        }
        move __got!          // unreachable (loop only exits via `return`)
    }

    /// Dequeues a value, blocking the calling thread while the queue is empty.
    ///
    /// This is for OS threads (`Thread.spawn`), and the block is unbounded:
    /// with no sender left to arrive, it never returns. Never call it from a
    /// cooperative task. The thread it stops is the executor's, so every
    /// sibling task on that thread stops with it, and a task that would have
    /// sent the awaited value can no longer run: the wait deadlocks the group.
    /// Nothing in the type system prevents the call.
    ///
    /// `receive()` is the cooperative twin: it suspends the task rather than
    /// the thread, and it reports a closed channel as a value instead of
    /// panicking.
    ///
    /// Panics on a channel that is closed and drained. There is no error channel
    /// in this signature to report it through, and blocking the thread forever on
    /// a channel that has said it is finished is the outcome the panic exists to
    /// replace.
    public func recv(&self) unsafe -> T {
        if let block = self.block {
            pthread_mutex_lock(block)
            let count = (block + 136) as UnsafePointer<Int>
            let closed = (block + 168) as UnsafePointer<Int>
            let cond = (block + 64) as UnsafePointer<Int8>
            // `close()` broadcasts, so a blocked thread leaves this loop with
            // an empty queue rather than waiting on.
            while count[0] == 0 && closed[0] == 0 {
                pthread_cond_wait(cond, block)
            }
            if count[0] == 0 {
                pthread_mutex_unlock(block)
                panic("Channel.recv: channel is closed and drained")
            }
            let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
            let tail_slot = (block + 152) as UnsafePointer<UnsafePointer<Int8>>
            let node = head_slot[0]
            let val_slot = (node + 8) as UnsafePointer<T>
            // The node is freed below, so the value's ownership leaves here.
            let value = move val_slot[0]
            count[0] = count[0] - 1
            if count[0] > 0 {
                let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                head_slot[0] = node_next[0]
            }
            self._publish_ready(block)
            GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
            pthread_mutex_unlock(block)
            value
        } else {
            // Unreachable: a constructed Channel always has its block.
            panic("Channel.recv: channel has no shared block")
        }
    }
}

// A handle copies by retaining the shared block, so its policy is Copy and its
// `deinit` lives inside that conformance.
extension Channel<T: Send>: Copy {
    public func deinit(&var self) unsafe {
        if let block = self.block {
            let refcount = (block + 128) as UnsafePointer<Int>
            let old = __saw_atomic_sub_i64_release(refcount, 1)
            if old < 1 {
                panic("over-release of a Channel handle (refcount underflow)")
            }
            if old == 1 {
                // Last handle. Order other threads' final ops, then drain the
                // queue (drop each remaining value, free each node) and tear the
                // block down. No locking needed: no other handle survives.
                __saw_atomic_fence_acquire()
                let count = (block + 136) as UnsafePointer<Int>
                let head_slot = (block + 144) as UnsafePointer<UnsafePointer<Int8>>
                while count[0] > 0 {
                    let node = head_slot[0]
                    let val_slot = (node + 8) as UnsafePointer<T>
                    __saw_deinit_in_place(val_slot)
                    count[0] = count[0] - 1
                    if count[0] > 0 {
                        let node_next = node as UnsafePointer<UnsafePointer<Int8>>
                        head_slot[0] = node_next[0]
                    }
                    GlobalAllocator().dealloc(node, 8 + sizeof<T>(), 16)
                }
                let cond = (block + 64) as UnsafePointer<Int8>
                pthread_cond_destroy(cond)
                pthread_mutex_destroy(block)
                GlobalAllocator().dealloc(block, 176, 16)
            }
        }
    }

    // Retain: a live handle keeps the queue alive, so monotonic is enough.
    public func copy(&self) unsafe -> Channel<T> {
        if let block = self.block {
            let refcount = (block + 128) as UnsafePointer<Int>
            __saw_atomic_add_i64(refcount, 1)
        }
        Channel<T>(block: self.block)
    }
}
