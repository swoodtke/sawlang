//! The growable array. A `Vector<T>` owns its elements and grows on demand
//! through an `Allocator`, so it works in the freestanding profile as well as
//! the hosted one.
//!
//! Indexing is a PLACE: `v[i].count += 1` mutates the element where it sits
//! rather than copying it out. Reading an element out as a value follows the
//! element's copy tier, so a move-only element is refused instead of aliased —
//! reach it through `with_ref`, or take it out with `swap_out` or `pop`.
//!
//! `Vector` is ExplicitCopy: every transfer needs `move v` or `v.copy()`.
//! Every operation that can run out of memory reports it as
//! `Result<_, AllocError>`, all-or-nothing. `copy()` is the one exception and
//! panics instead: it is the `ExplicitCopy` hook, so its signature belongs to
//! the trait.

// Vector allocates only through its `Allocator` type parameter, never libc,
// so it works freestanding. `A` is a phantom parameter (it appears in no
// field): `A()` is a zero-sized construction that monomorphizes to direct
// calls, and `Vector<T>` and `Vector<T, GlobalAllocator>` are one type.
// memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

/// A dynamically-sized array that allocates through `A`, which defaults to
/// `GlobalAllocator`.

public struct Vector<T, A: Allocator = GlobalAllocator> {
    private buffer: UnsafePointer<T>?
    private length: Int
    private capacity: Int
}

// An owning container inherits its contents' thread-safety. Structurally the
// buffer pointer would make it neither Send nor Sync, but that pointer is the
// container's own bookkeeping and `&var` access goes through the Law of
// Exclusivity, so moving (sharing) one is safe exactly when moving (sharing)
// its contents and allocator is (design 186).
//
// `Map` and `Set` derive through this one: a `Map` holds a `Vector` of slots
// and a `Set` holds a `Map`.
extension Vector<T: Send, A: Send>: UnsafeSend {}
extension Vector<T: Sync, A: Sync>: UnsafeSync {}

extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Initializes an empty vector.
    public init() -> Vector<T, A> {
        Vector<T, A>(buffer: None, length: 0, capacity: 0)
    }

    /// Creates an empty vector with room for `capacity` elements, reporting
    /// `Err(AllocError)` when the allocator refuses. A non-positive `capacity`
    /// returns an empty vector without allocating.
    public init(capacity: Int) unsafe -> Result<Vector<T, A>, AllocError> {
        if capacity <= 0 {
            return Vector<T, A>(buffer: None, length: 0, capacity: 0)
        }
        let byte_size = capacity * sizeof<T>()
        if let raw_ptr = A().alloc(byte_size, alignof<T>()) {
            let typed_ptr = raw_ptr as UnsafePointer<T>
            return Vector<T, A>(buffer: typed_ptr, length: 0, capacity: capacity)
        }
        return AllocError(size: byte_size, align: alignof<T>())
    }

    /// Returns the number of elements.
    public func len(&self) -> Int {
        self.length
    }

    /// Returns true if the vector contains no elements.
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Returns the element at `index` as a place, so it is read or written where
    /// it sits: `v[i].count += 1` mutates the element in the vector and never
    /// copies it out. Reading the place out as a value follows the element's copy
    /// tier: trivial copies bitwise, `Copy` retains, and
    /// `ExplicitCopy`/`NoCopy` is refused with the ways out named.
    ///
    /// The same `v[i]` serves a read and a write; the use site decides which.
    /// Either way the whole vector is borrowed for the length of the expression,
    /// so growing it in the middle of one — `v.push(x)` inside `v[i]` — is a
    /// compile error.
    ///
    /// Panics if `index` is outside `0..<len()`. `get` is the `None`-returning twin.
    public func [](&var self, index: Int) unsafe borrows -> &var T {
        if index < 0 || index >= self.length {
            panic("Vector.[]: index out of range: {} (len {})", index, self.length)
        }
        if let buf = self.buffer {
            lend buf[index]
        } else {
            panic("Vector.[]: buffer is empty")
        }
    }

    // `get` returns a place, not a `T?` by value: a by-value read of a
    // move-only element would be a second owner of the slot (DF-132a).
    /// Returns the element at `index` if it is in range, as an optional place:
    /// the `None`-returning twin of `[]`. The element is reached where it sits,
    /// so `v.get(i)!.count += 1` writes it in the vector, and
    /// `if let _ = v.get(i)` asks only whether it is there. When the index is out
    /// of range nothing is borrowed at all.
    ///
    /// Reading the place out as a value follows the element's copy tier: trivial
    /// copies bitwise, `Copy` retains, and `ExplicitCopy`/`NoCopy` is
    /// refused with the ways out named.
    public func get(&var self, index: Int) unsafe borrows -> &var T? {
        if index < 0 || index >= self.length {
            return None
        }
        if let buf = self.buffer {
            lend buf[index]
        } else {
            return None
        }
    }

    // The receiver holds the whole vector borrowed for the call, so the buffer
    // cannot reallocate under the element borrow. The bounds check is what
    // keeps a bad index from reaching arbitrary heap: the parameters are all
    // safe, so the function must be sound for every input. `body` is `sync`
    // because the borrow projects into a container that stays reachable: a
    // suspension would let another task `push` and dangle it, which a held
    // reference to a task-confined local cannot suffer (design 88).
    /// Provides scoped, no-copy access to the element at `index`, returning the
    /// closure's result. The closure receives the element as `&var T` and must be
    /// `sync`. Panics if `index` is outside `0..<len()`.
    public func with_var_ref<R>(&var self, index: Int, body: (&var T) sync -> R) unsafe -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_var_ref: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            body(&var buf[index])
        } else {
            panic("Vector.with_var_ref: buffer is empty")
        }
    }

    /// The shared twin of `with_var_ref`: the closure receives the element as
    /// `&T`. Bounds-checked on the same terms.
    public func with_ref<R>(&self, index: Int, body: (&T) sync -> R) unsafe -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_ref: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            body(&buf[index])
        } else {
            panic("Vector.with_ref: buffer is empty")
        }
    }

    // The slot is live, so a bare `buf[index] = value` (a placement move, which
    // does not release the prior occupant) would leak it. `swap_out` moves the
    // old element out and the `let _ =` discard drops it.
    /// Replaces the element at `index`, releasing the one it overwrites. Panics if
    /// `index` is outside `0..<len()`; `value` is consumed either way.
    public func set(&var self, index: Int, value: T) unsafe {
        if index < 0 || index >= self.length {
            panic("Vector.set: index out of range: {} (len {})", index, self.length)
        }
        let _ = self.swap_out(index, value)
    }

    // The early return on a failed `_reserve` is load-bearing: falling through
    // would write past the buffer and advance `length` past `capacity`.
    /// Appends `value` to the end, reporting `Err(AllocError)` when the buffer
    /// must grow and the allocator refuses. On error the vector is unchanged and
    /// `value` is destroyed; `reserve` is how you make a later `push`
    /// allocation-free, and how you keep `value` alive across a refusal.
    public func push(&var self, value: T) unsafe -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        // A placement move (LANGUAGE_SPEC "Placement writes"): it does not
        // release a prior occupant, which is sound only because the tail slot
        // at `self.length` is uninitialized.
        if let buf = self.buffer {
            buf[self.length] = value
            self.length = self.length + 1
        } else {
            // Unreachable: a successful `_reserve` leaves a live buffer. Never
            // return `Ok` here; that would report success and drop the element.
            panic("Vector.push: buffer is empty")
        }
        return
    }

    /// Reserves space for `additional` elements, returning `Err(AllocError)` if the
    /// allocator is exhausted. A successful call ensures the next `additional`
    /// pushes will not fail due to allocation errors. Capacity is never reduced and
    /// non-positive `additional` values are no-ops.
    public func reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        let wanted = self.length + additional
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        return
    }

    /// Removes and returns the last element, or `None` when the vector is empty.
    /// The caller owns the returned value.
    public func pop(&var self) unsafe -> T? {
        if self.length == 0 {
            None
        } else {
            self.length = self.length - 1
            if let buf = self.buffer {
                // The slot is past the new `length`, so ownership leaves here.
                move buf[self.length]
            } else {
                None
            }
        }
    }

    /// Removes all elements while retaining the current capacity.
    public func clear(&var self) {
        self.length = 0
    }

    // The escape hatch for `swap(&a[i], &a[j])` on one container, which the
    // static Law of Exclusivity must reject as possibly overlapping: behind one
    // `&var self` the question becomes a runtime bounds check. The exchange is
    // byte-level, a bitwise relocation with no element-typed temporary, so no
    // retain or deinit runs and no bound on `T` is needed.
    /// Swaps the elements at indices `i` and `j` in place. No element-level copy
    /// or deinit runs — the two live values just change slots — so it works for
    /// any element type, including NoCopy. Swapping an index with itself is a
    /// no-op; panics if either index is outside `0..<len()`.
    public func swap(&var self, i: Int, j: Int) unsafe {
        if i == j {
            return
        }
        // Checked separately so the message names the offending index.
        if i < 0 || i >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", i, self.length)
        }
        if j < 0 || j >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", j, self.length)
        }
        if let buf = self.buffer {
            let size = sizeof<T>()
            let pi = (buf + i) as UnsafePointer<Int8>
            let pj = (buf + j) as UnsafePointer<Int8>
            var k = 0
            while k < size {
                let t = pi[k]
                pi[k] = pj[k]
                pj[k] = t
                k = k + 1
            }
        }
    }

    // The old occupant is moved out before the placement move in, so the
    // exchange is refcount-neutral and nothing leaks. The bounds check guards
    // an out-of-bounds write.
    /// Replaces the element at `index` with `value` and returns the previous
    /// occupant, which the caller now owns. Panics if `index` is outside
    /// `0..<len()`.
    public func swap_out(&var self, index: Int, value: T) unsafe -> T {
        if index < 0 || index >= self.length {
            panic("Vector.swap_out: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            let old = move buf[index]
            buf[index] = value
            move old
        } else {
            panic("Vector.swap_out: buffer is empty")
        }
    }

    // The capacity a growth to `min_capacity` allocates: double (from a floor
    // of 4) unless more was asked for. Separate so a failed `_reserve` can
    // report the refused size without carrying an error payload.
    func _grow_target(&self, min_capacity: Int) -> Int {
        let doubled = if self.capacity == 0 { 4 } else { self.capacity * 2 }
        if doubled < min_capacity {
            min_capacity
        } else {
            doubled
        }
    }

    // Ensures `capacity >= min_capacity`. `false` means the allocator refused
    // and the vector is untouched (buffer, capacity and length), which callers
    // rely on to report all-or-nothing.
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)
        let new_byte_size = new_capacity * sizeof<T>()

        if let buf = self.buffer {
            // Grow: the seams expose only alloc/dealloc (no realloc), so
            // allocate a fresh buffer, copy the live bytes, and release the old.
            let raw_ptr = buf as UnsafePointer<Int8>
            let old_byte_size = self.capacity * sizeof<T>()
            if let new_raw = A().alloc(new_byte_size, alignof<T>()) {
                memcpy(new_raw, raw_ptr, old_byte_size)
                A().dealloc(raw_ptr, old_byte_size, alignof<T>())
                self.buffer = new_raw as UnsafePointer<T>
                self.capacity = new_capacity
                return true
            }
            return false
        }
        // First allocation
        if let raw_ptr = A().alloc(new_byte_size, alignof<T>()) {
            self.buffer = raw_ptr as UnsafePointer<T>
            self.capacity = new_capacity
            return true
        }
        false
    }

}

// Destruction is unconditional, so `deinit` lives on this unbounded extension
// rather than in the bounded `ExplicitCopy` conformance below: a
// `Vector<File>` has no `copy()` but still owns elements to destroy, and
// `Deinit` is not declarable on its own. Manual `deinit()` calls are banned,
// so elements go through the `__saw_deinit_in_place` intrinsic. Elements
// popped or moved out have already left `length`, so they are never visited.
extension Vector<T, A: Allocator = GlobalAllocator> {
    public func deinit(&var self) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                __saw_deinit_in_place(buf + i)
                i = i + 1
            }
            let raw_ptr = buf as UnsafePointer<Int8>
            // Frees through this vector's own `A`, never `GlobalAllocator`.
            A().dealloc(raw_ptr, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// A bitwise copy of the buffer would double-free, so duplication is always a
// visible `.copy()` that deep-copies. The bound is `ExplicitCopy` because the
// body spells `buf[i].copy()`; that admits nested vectors, while an element
// that cannot be duplicated (`Vector<File>`) makes `.copy()` a compile error.
// The `ExplicitCopy: Deinit` requirement is met by the unbounded `deinit`.
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    // The ExplicitCopy hook is infallible by the trait's signature, so this
    // panics on allocator refusal, never returns a short copy. The panics are
    // spelled by hand so the message names the method (design 234).
    /// Duplicates the vector and every element through the same allocator `A`.
    /// Panics if the allocator refuses; `try_copy` reports the failure instead.
    public func copy(&self) unsafe -> Vector<T, A> {
        var result = match Vector<T, A>(capacity: self.capacity) {
            case Ok(v) -> move v,
            case Err(e) -> panic("Vector.copy: {}", e)
        }
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                match result.push(buf[i].copy()) {
                    case Ok(_) -> {},
                    case Err(e) -> panic("Vector.copy: {}", e)
                }
            }
            i = i + 1
        }
        move result
    }
}

// The reporting twin of `copy`; its `try_` name still owes a ruling, since
// `try_` otherwise means non-blocking (DF-257b).
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the vector, returning `Err(AllocError)` if the allocator runs out
    /// of memory. The entire buffer is reserved upfront, ensuring the function
    /// returns either a complete copy or an error, never a partial vector.
    public func try_copy(&self) unsafe -> Result<Vector<T, A>, AllocError> {
        var result = Vector<T, A>()
        let _ = try result.reserve(self.length)
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                // Cannot allocate after the reserve; `try` costs one branch.
                let _ = try result.push(buf[i].copy())
            }
            i = i + 1
        }
        return move result
    }
}

// =============================================================================
// Iteration
// =============================================================================
//
// The closure methods take non-escaping closures, so a closure passed directly
// may borrow-capture enclosing locals. They lend each element as `&T`, so they
// carry no copy bound. They lend out of the buffer directly rather than through
// `with_ref`: the visitor parameter is not declared `sync`, and calling it
// inside `with_ref`'s `sync` body would impose that requirement on its type.
// (A closure body that actually suspends is refused either way.) The vector is
// held `&self` for the whole method, so exclusivity keeps a `push` from
// reallocating under a live element borrow.
extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Iterates over each element in order, lending it to `body` as a `&T`.
    /// Carries no copy bound: the element is borrowed where it sits, never
    /// copied out, so a move-only element type iterates like any other.
    public func each(&self, body: (&T) -> Void) unsafe {
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                body(&buf[i])
            }
            i = i + 1
        }
    }

    // `U` needs no copy bound: each result is moved straight into the output.
    /// Applies `transform` to each element to return a new `Vector<U>`, where the
    /// output type `U` must be explicitly specified at the call site. The element
    /// is lent to `transform` as a `&T`, so no copy bound is required of `T`.
    /// Reports `Err(AllocError)` when the result vector cannot grow.
    public func map<U>(&self, transform: (&T) -> U) unsafe -> Result<Vector<U, A>, AllocError> {
        var result = Vector<U, A>()
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                let _ = try result.push(transform(&buf[i]))
            }
            i = i + 1
        }
        return move result
    }

    // The accumulator is moved through `combine`, so an `ExplicitCopy` one is
    // never silently duplicated. It is `Acc`, not `A`, because `A` is the
    // allocator.
    /// Performs a left fold by threading an accumulator through the elements using
    /// the `combine` function. The caller provides an initial value and an explicit
    /// type parameter for the accumulator. The accumulator is moved into and out of
    /// the `combine` closure at each step; the element is lent to it as a `&T`.
    public func fold<Acc>(&self, initial: Acc, combine: (Acc, &T) -> Acc) unsafe -> Acc {
        var acc = move initial
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                acc = combine(move acc, &buf[i])
            }
            i = i + 1
        }
        move acc
    }

    /// Iterates through each element, passing the index and a `&T` borrow of the
    /// element to the closure. The closure must be non-escaping; no copy bound is
    /// required of `T`.
    public func each_indexed(&self, body: (Int, &T) -> Void) unsafe {
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                body(i, &buf[i])
            }
            i = i + 1
        }
    }
}

extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    // `next()` hands the consumer an owned element, so a bitwise read of an
    // owning element would give it two owners. The iterator borrows the vector
    // itself, not its buffer, so the `for` statement is its window and a
    // mutation in the body is an exclusivity error (design 275).
    /// Returns an iterator over the vector's elements (`for x in v.iter()`).
    /// Each element is yielded as an owned copy, which is what requires
    /// `T: Copy`. The iterator borrows the vector for the whole loop, so the
    /// body may read it but not add to it, remove from it or replace it.
    public func iter(&self) borrows -> VectorIterator<T, A> {
        VectorIterator<T, A>(vector: lends self, index: 0)
    }

    /// Returns an iterator yielding `(index, element)` pairs. Because elements
    /// are yielded by value, `T` must be `Copy`. Like `iter()`, it borrows the
    /// vector for the whole loop.
    public func enumerated(&self) borrows -> EnumeratedIterator<T, A> {
        EnumeratedIterator<T, A>(vector: lends self, index: 0)
    }
}

// =============================================================================
// Sorting
// =============================================================================
//
// Insertion sort: O(n^2) comparisons, no scratch buffer, and stable because an
// element only moves past a strictly greater predecessor. Elements move by the
// byte-level `swap`, so none is ever duplicated. `sort` reads its comparands by
// value through `_greater_at`, hence `T: Copy`.
extension Vector<T: Comparable + Copy, A: Allocator = GlobalAllocator> {
    /// Sorts elements in ascending order according to the element type's Comparable
    /// implementation. The sort is stable.
    public func sort(&var self) {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 && self._greater_at(j - 1, j) {
                self.swap(j - 1, j)
                j = j - 1
            }
            i = i + 1
        }
    }

    func _greater_at(&self, i: Int, j: Int) -> Bool {
        if let a = self.get(i) {
            if let b = self.get(j) {
                return a > b
            }
        }
        false
    }
}

// The comparands are lent as `&T` straight out of the buffer, so `sort_by`
// needs no copy bound. Stability and movement match `sort`.
extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Sorts elements in place using `compare`, which is lent the two
    /// comparands as `&T`. The sort is stable. No copy bound is required of
    /// `T`: the comparands are borrowed where they sit and elements move by
    /// byte-level swap.
    public func sort_by(&var self, compare: (&T, &T) -> Ordering) unsafe {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 {
                var should_swap = false
                if let buf = self.buffer {
                    should_swap = compare(&buf[j - 1], &buf[j]) == Ordering.Greater
                }
                if should_swap {
                    self.swap(j - 1, j)
                    j = j - 1
                } else {
                    break
                }
            }
            i = i + 1
        }
    }
}

// =============================================================================
// Iterators
// =============================================================================

// Holds the vector itself, lent, and reads `length` and `buffer` through it on
// every `next()`. Lend the root, never the buffer: a snapshot of the buffer
// pointer is what the vector can invalidate (SL-321).
//
// `public` only because `Vector.iter()` is public and a public signature may
// not name a private type; a borrowing struct cannot be held, so its only use
// is the head of a `for`.
public borrows struct VectorIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// `next()` yields an element the consumer owns, so it spells `.copy()`; a bare
// slot read would be a second owner. The bound is `ExplicitCopy` because the
// body spells the copy; `iter()` keeps the stricter `T: Copy` at the producer.
extension VectorIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = T

    public func next(&var self) unsafe -> T? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                buf[idx].copy()
            } else {
                None
            }
        } else {
            None
        }
    }
}

// Same shape and visibility reason as `VectorIterator`.
public borrows struct EnumeratedIterator<T, A: Allocator = GlobalAllocator> {
    private vector: &Vector<T, A>
    private index: Int
}

// The yielded pair owns its element: `.copy()` for the same reason as above.
extension EnumeratedIterator<T: ExplicitCopy, A: Allocator = GlobalAllocator>: Iterator {
    type Item = (Int, T)

    public func next(&var self) unsafe -> (Int, T)? {
        if self.index < self.vector.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.vector.buffer {
                (idx, buf[idx].copy())
            } else {
                None
            }
        } else {
            None
        }
    }
}
