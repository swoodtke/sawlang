// Vector<T> - Dynamic array implementation
// Part of the Saw standard library

// =============================================================================
// FFI declarations for memory management
// =============================================================================

// Vector is an alloc-layer type: it allocates through an `Allocator` (design
// 19 §4 / brief 28/37), which wraps the runtime seams — never libc directly —
// so it works in the freestanding profile over a user-provided allocator.
// Buffer alignment comes from `alignof<T>()`, so element types get a
// correctly-aligned backing store rather than a hardcoded constant.
//
// STAGE 4 (brief 37): the allocator is now a PUBLIC type parameter
// `A: Allocator = GlobalAllocator`. Hosted code writes `Vector<T>` unchanged — the
// default fills `A = GlobalAllocator` before mangling, so `Vector<T>` and
// `Vector<T, GlobalAllocator>` are one type. `A()` is a zero-sized construction that
// monomorphizes to a direct call into the concrete allocator's methods, with no
// allocator value stored per Vector (A is a phantom type parameter — it appears
// in no field). memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// Vector<T, A> - A dynamically-sized array over allocator `A`
// =============================================================================

struct Vector<T, A: Allocator = GlobalAllocator> {
    buffer: UnsafePointer<T>?
    length: Int
    capacity: Int
}

extension Vector<T, A: Allocator = GlobalAllocator> {
    // Create an empty vector
    public init() -> Vector<T, A> {
        Vector<T, A>(buffer: None, length: 0, capacity: 0)
    }

    /// Creates an empty vector with room for `capacity` elements.
    ///
    /// Panics if the allocator refuses the request (design 123, infallible
    /// tier). It used to hand back an EMPTY vector, so a caller that asked to
    /// reserve a megabyte and got nothing carried on as if it had succeeded.
    /// `try_with_capacity` is the twin that reports the failure.
    public init(capacity: Int) -> Vector<T, A> {
        if capacity <= 0 {
            Vector<T, A>(buffer: None, length: 0, capacity: 0)
        } else {
            let byte_size = capacity * sizeof<T>()
            if let raw_ptr = unsafe A().alloc(byte_size, alignof<T>()) {
                let typed_ptr = raw_ptr as UnsafePointer<T>
                Vector<T, A>(buffer: typed_ptr, length: 0, capacity: capacity)
            } else {
                panic("Vector(capacity:): allocation failed")
            }
        }
    }

    /// Creates an empty vector with room for `n` elements, reporting allocator
    /// exhaustion as `Err(AllocError)` rather than panicking.
    ///
    /// The `AllocError` carries the byte size and alignment of the request that
    /// failed. A non-positive `n` needs no allocation and succeeds with an
    /// empty vector.
    public func try_with_capacity(n: Int) -> Result<Vector<T, A>, AllocError> {
        if n <= 0 {
            return Vector<T, A>()
        }
        let byte_size = n * sizeof<T>()
        if let raw_ptr = unsafe A().alloc(byte_size, alignof<T>()) {
            let typed_ptr = raw_ptr as UnsafePointer<T>
            return Vector<T, A>(buffer: typed_ptr, length: 0, capacity: n)
        }
        // Allocator returned None -> surface the failure with size context.
        return AllocError(size: byte_size, align: alignof<T>())
    }

    // Get the number of elements
    public func len(&self) -> Int {
        self.length
    }

    // Check if the vector is empty
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    // Get element at index (returns None if out of bounds)
    public func get(&self, index: Int) -> T? {
        if index < 0 || index >= self.length {
            None
        } else {
            if let buf = self.buffer {
                buf[index]
            } else {
                None
            }
        }
    }

    // Scoped, no-copy access to element `index` (design 81) — THE
    // container borrow-projection API (it replaced the raw `ref_at`). `body`
    // receives a NON-ESCAPING `&T`/`&var T` borrow of the element in place, so a
    // NoCopy element (`Vector<Box<any Resumable>>`, design 52b) is reached
    // without a copy: `v.with_var_ref(i) { frame in frame.resume() }`. The `&var
    // self` / `&self` receiver holds the whole vector borrowed for the duration
    // of the call, so the buffer cannot be reallocated (grow) or the element
    // invalidated while the borrow is live — iterator-invalidation-proof. The
    // borrow is a LEND: nothing is retained. `R` (method-level generic, like
    // `withCString`) is the body's result, chosen at the call site; it flows
    // straight out. BOUNDS-CHECKED: an index outside `0..<len()` panics, exactly
    // like every other indexing operation in the language (design 122, RS-6).
    // The signature carries nothing unsafe, so the caller gets no signal that a
    // bad index would reach arbitrary heap — and this is the sanctioned way to
    // reach a NoCopy element, so it is the API a caller is steered TO.
    // `body` is `sync`: the borrow must not be held across a suspension (and it
    // keeps `with_var_ref` sync-usable, e.g. the executor drains it from the
    // group's `sync` Deinit).
    //
    // design 88 (D6) verdict — the `sync` STAYS. A held D6 reference is sound
    // because its referent is a task-CONFINED stack/frame local that no other task
    // can reach or mutate. A `with_var_ref` borrow is different in kind: it
    // projects INTO a container (this vector) that remains reachable and mutable.
    // If `body` suspended, the yield would hand the scheduler control while the
    // element borrow is live, and another task (or a re-entrant call) could `push`
    // this vector, reallocating the buffer and dangling the borrow — the exact
    // iterator-invalidation this API prevents. Confinement does not cover a
    // container-internal borrow, so the borrow may not span a suspension.
    public func with_var_ref<R>(&var self, index: Int, body: (&var T) sync -> R) -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_var_ref: index out of range")
        }
        if let buf = self.buffer {
            body(&var buf[index])
        } else {
            panic("Vector.with_var_ref: buffer is empty")
        }
    }

    // Immutable twin of `with_var_ref`: an in-place `&T` borrow of the element.
    // Bounds-checked on the same terms.
    public func with_ref<R>(&self, index: Int, body: (&T) sync -> R) -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_ref: index out of range")
        }
        if let buf = self.buffer {
            body(&buf[index])
        } else {
            panic("Vector.with_ref: buffer is empty")
        }
    }

    // Set element at index (no-op if out of bounds).
    //
    // The slot at `index` is LIVE, so the prior occupant must be released: a
    // bare `buf[index] = value` is the placement-move primitive (see `push`),
    // which moves the new value in WITHOUT dropping what was there — that
    // leaked every owning element a `set` overwrote (design 122 unit A).
    // `swap_out` moves the old element out and places the new one in; the
    // `let _ =` discard then consumes and drops the old value right here, so
    // exactly one deinit runs for it and nothing is duplicated.
    public func set(&var self, index: Int, value: T) {
        if index >= 0 && index < self.length {
            let _ = self.swap_out(index, value)
        }
    }

    /// Appends `value` to the end.
    ///
    /// Panics if the buffer must grow and the allocator refuses (design 123,
    /// infallible tier). `try_push` is the twin that reports the failure, and
    /// `try_reserve` is how you make a later `push` allocation-free.
    ///
    /// This was the RS-1 heap overflow: `grow()` returned silently on failure,
    /// so the placement write below landed one element PAST the buffer and
    /// `length` advanced past `capacity` — every later `get`, iteration and the
    /// final `deinit` then read and freed out of bounds, from fully safe code
    /// with no diagnostic.
    public func push(&var self, value: T) {
        if not self._reserve(self.length + 1) {
            panic("Vector.push: allocation failed")
        }
        // Add the element. `buf[self.length] = value` is the PLACEMENT-MOVE
        // primitive (see LANGUAGE_SPEC "Placement writes"): the slot at
        // `self.length` is uninitialized (length < capacity, never yet
        // written), so the store bitwise-moves `value` in and does NOT release
        // any prior occupant. `value` is consumed by the value-transfer
        // checkpoint. Writing into a slot `< length` this way would leak the
        // live element there — the loop invariant (only ever writing the fresh
        // tail slot) is what makes this sound.
        if let buf = self.buffer {
            buf[self.length] = value
            self.length = self.length + 1
        } else {
            // Unreachable: a successful `_reserve` leaves capacity >= 1, which
            // this type's invariant pairs with a live buffer. Panicking beats
            // the silent element-on-the-floor drop this branch used to be.
            panic("Vector.push: buffer is empty")
        }
    }

    /// Appends `value`, reporting allocator exhaustion as `Err(AllocError)`.
    ///
    /// The vector is unchanged on `Err`. `value` is destroyed at that point
    /// (it deinits at scope exit rather than being handed back); reserve first
    /// with `try_reserve` when the value must survive a refusal.
    public func try_push(&var self, value: T) -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        if let buf = self.buffer {
            buf[self.length] = value
            self.length = self.length + 1
        }
        return
    }

    /// Reserves room for `additional` more elements, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    ///
    /// On `Ok` the next `additional` pushes cannot allocate, so they cannot
    /// fail. Capacity is never reduced and a non-positive `additional` is a
    /// no-op.
    public func try_reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        let wanted = self.length + additional
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        return
    }

    // Remove and return the last element
    public func pop(&var self) -> T? {
        if self.length == 0 {
            None
        } else {
            self.length = self.length - 1
            if let buf = self.buffer {
                buf[self.length]
            } else {
                None
            }
        }
    }

    // Remove all elements (keeps capacity)
    public func clear(&var self) {
        self.length = 0
    }

    // Swap the elements at indices `i` and `j` (design 08 / brief 40 item 7).
    //
    // This is the stdlib escape hatch for the shape the static Law of
    // Exclusivity must reject — `swap(&a[i], &a[j])` on the SAME container with
    // dynamic indices, which the compiler conservatively treats as overlapping.
    // Doing the exchange behind one `&var self` receiver moves the aliasing
    // question inside a single mutable borrow, where it is a runtime bounds
    // check instead of a static disjointness proof.
    //
    // Refcount-neutral by construction: the exchange is done at the BYTE level
    // (`Int8`, a trivial type), so it is a pure bitwise relocation of the two
    // slots' contents — no element-level `copy()`/retain and no `deinit`/
    // release ever run. An owning element type (String, Vector, File) is
    // neither retained nor dropped; the two live values just change slots. A
    // T-level `move buf[i]` cannot express this (partial moves are forbidden,
    // design 35), hence the byte loop. No `T: Copy` bound is needed.
    public func swap(&var self, i: Int, j: Int) {
        // No-op on identical indices — swapping a slot with itself is pointless
        // and the byte loop would still be a correct identity, but short-circuit.
        if i == j {
            return
        }
        // Out-of-bounds is a no-op (mirrors `get`/`set`'s tolerant contract).
        if i < 0 || i >= self.length || j < 0 || j >= self.length {
            return
        }
        if let buf = self.buffer {
            let size = sizeof<T>()
            let pi = (buf + i) as UnsafePointer<Int8>
            let pj = (buf + j) as UnsafePointer<Int8>
            var k = 0
            while k < size {
                let t = pi[k]
                pi[k] = pj[k]
                pj[k] = t
                k = k + 1
            }
        }
    }

    // Replace the element at `index`, returning the previous occupant by MOVE
    // (design 48, for Map slot updates). The old value is bitwise-moved out
    // and the new one placement-moved in, so it is refcount-neutral: no element
    // `copy()` and no leak (the placement primitive does not release, but the
    // prior occupant was moved out first, so nothing is dropped on the floor).
    // The returned value is owned by the caller. BOUNDS-CHECKED: an index
    // outside `0..<len()` panics (design 122, RS-6). Unchecked, this was the
    // worst of the three unchecked accessors — `buf[index] = value` past the
    // end is an out-of-bounds WRITE, i.e. heap corruption reachable from fully
    // safe code. `set` filters the index before delegating here, so its
    // documented no-op-when-out-of-range contract is unchanged.
    public func swap_out(&var self, index: Int, value: T) -> T {
        if index < 0 || index >= self.length {
            panic("Vector.swap_out: index out of range")
        }
        if let buf = self.buffer {
            let old = buf[index]
            buf[index] = value
            move old
        } else {
            panic("Vector.swap_out: buffer is empty")
        }
    }

    // Internal: the capacity a growth to `min_capacity` would allocate.
    // Geometric (double, from a floor of 4) unless the caller asked for more.
    // Split out so a failed `_reserve` can report the exact byte size that was
    // refused without `_reserve` having to carry an error payload.
    func _grow_target(&self, min_capacity: Int) -> Int {
        let doubled = if self.capacity == 0 { 4 } else { self.capacity * 2 }
        if doubled < min_capacity {
            min_capacity
        } else {
            doubled
        }
    }

    // Internal: ensure `capacity >= min_capacity`. Returns whether the vector
    // now has that room — FALSE means the allocator refused and the vector is
    // untouched (old buffer, old capacity, old length), which is what lets
    // every caller choose its tier. This reporting return is the RS-1 fix:
    // the old `grow()` returned Void and left `push` to write past the end.
    func _reserve(&var self, min_capacity: Int) -> Bool {
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)
        let new_byte_size = new_capacity * sizeof<T>()

        if let buf = self.buffer {
            // Grow: the seams expose only alloc/dealloc (no realloc), so
            // allocate a fresh buffer, copy the live bytes, and release the old.
            let raw_ptr = buf as UnsafePointer<Int8>
            let old_byte_size = self.capacity * sizeof<T>()
            if let new_raw = A().alloc(new_byte_size, alignof<T>()) {
                memcpy(new_raw, raw_ptr, old_byte_size)
                A().dealloc(raw_ptr, old_byte_size, alignof<T>())
                self.buffer = new_raw as UnsafePointer<T>
                self.capacity = new_capacity
                return true
            }
            return false
        }
        // First allocation
        if let raw_ptr = A().alloc(new_byte_size, alignof<T>()) {
            self.buffer = raw_ptr as UnsafePointer<T>
            self.capacity = new_capacity
            return true
        }
        false
    }

}

// Deinit applies to EVERY element type, not just Copy ones: destroying a
// Vector must run each live element's own deinit (drop glue) before freeing
// the backing buffer, otherwise element resources leak. This conformance is
// deliberately unbounded (`<T>`, no `: Copy`) so it is instantiated even for a
// non-Copy element type like `Vector<File>` — which has no `copy()` but still
// owns elements that must be destroyed.
//
// Manual `deinit()` calls are banned language-wide, so element cleanup uses the
// compiler-internal `__saw_deinit_in_place` intrinsic (usable only inside a deinit
// body). Elements popped/moved out first decrement `length`, so the loop below
// never touches them and cannot double-free.
extension Vector<T, A: Allocator = GlobalAllocator>: Deinit {
    public func deinit(&var self) {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                __saw_deinit_in_place(buf + i)
                i = i + 1
            }
            let raw_ptr = buf as UnsafePointer<Int8>
            // Deinit routes back to THIS vector's own allocator `A` — a
            // `Vector<T, LoudAlloc>` frees through `LoudAlloc`, never `GlobalAllocator`.
            A().dealloc(raw_ptr, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// Vector is ExplicitCopy: never implicitly duplicated (a bitwise copy of the
// heap buffer would double-free). Transferring a Vector requires `move`;
// duplicating it is always a visible `.copy()`, which deep-copies the buffer.
//
// The bound `<T: Copy>` is required because copy() duplicates each element via
// T's copy path. Elements that are not Copy (e.g. Vector<File>) make
// `.copy()` a compile error naming the element type at monomorphization.
// (Deinit is provided unconditionally above; ExplicitCopy: Deinit is satisfied
// by that separate conformance.)
extension Vector<T: Copy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    /// Duplicates the vector and every element through the same allocator `A`.
    ///
    /// Panics if the allocator refuses (design 123, infallible tier); it used
    /// to return a SHORTER vector, so a "copy" could silently be missing
    /// elements. `try_copy` reports the failure instead.
    public func copy(&self) -> Vector<T, A> {
        var result = Vector<T, A>(capacity: self.capacity)
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                result.push(buf[i].copy())
            }
            i = i + 1
        }
        move result
    }
}

extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    /// Duplicates the vector, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    ///
    /// The whole buffer is reserved up front, so the element loop cannot
    /// allocate and the result is either a complete copy or an `Err` — never a
    /// partial one.
    public func try_copy(&self) -> Result<Vector<T, A>, AllocError> {
        var result = Vector<T, A>()
        let _ = try result.try_reserve(self.length)
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                result.push(buf[i].copy())
            }
            i = i + 1
        }
        return move result
    }
}

// =============================================================================
// Iteration API (design 16/29 item 6) — non-escaping closure parameters.
// =============================================================================
//
// `each`/`map`/`fold` take their closures by NON-escaping parameter (the
// default), so a closure passed directly may borrow-capture enclosing locals:
//   var sum = 0
//   vec.each { [&var sum] in sum += $0 }   // mutates the REAL sum
//
// COPY-FAMILY / BOUND: each element is handed to the closure BY VALUE (the
// signatures take `T`, not `&T`). Extraction reuses `get`, which returns `T?`
// — a value copy of the element per T's copy class (ImplicitCopy retains,
// trivial copies bitwise). The extracted element is then `move`d into the
// closure, so there is exactly ONE copy per visit and NEVER a silent duplicate
// of an ExplicitCopy element. Handing an owned `T` to a by-value closure
// parameter is a copy at the source, so this API is bound to `T: Copy` — the
// same bound `Vector`'s own `.copy()` carries. A `Vector<File>` (NoCopy
// element) therefore cannot call `each`/`map`/`fold`; a future by-reference
// (`(&T)`) overload would lift that, but is out of scope here.
extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    // Create an iterator over this vector's elements (`for x in v.iter()`).
    //
    // `T: Copy` — the SAME bound `each`/`map`/`enumerated` carry, and for the
    // same reason: `next()` hands the consumer an OWNED element, which is a
    // copy at the source. Unbounded, `next()` returned a bitwise duplicate of
    // the slot, so an owning element (`Vector<String>`, `Vector<Vector<..>>`,
    // `Vector<File>`) was owned by BOTH the loop variable and the vector and
    // deinit'd twice (design 122 unit A). This follows the `StringBytes`/
    // `StringChars` model — an iterator yields values the consumer owns
    // outright, with their own retain — rather than a scoped-borrow shape:
    // a borrow iterator would have to hold the container borrowed for the
    // whole loop, which is exactly what `with_ref`/`with_var_ref` already
    // offer per element, and it is where a NoCopy element type is reached.
    public func iter(&self) -> VectorIterator<T> {
        VectorIterator<T>(buffer: self.buffer, length: self.length, index: 0)
    }

    // Visit each element in order, passing it to `body`.
    public func each(&self, body: (T) -> Void) {
        var i = 0
        while i < self.length {
            if let elem = self.get(i) {
                body(move elem)
            }
            i = i + 1
        }
    }

    // Transform each element through `transform`, collecting the results into a
    // fresh `Vector<U>` (brief 36 item 3). `U` is a METHOD-level generic type
    // parameter — the output element type, independent of `T` — supplied
    // explicitly at the call site (`v.map<String>(...)`). The output element
    // type carries no `Copy` bound: each transformed value is `move`d straight
    // into the result (exactly one placement per element, never a silent copy),
    // and the result is `move`d out. The `T: Copy` bound is inherited from the
    // extension for the same reason `each` needs it: an element is handed to the
    // closure BY VALUE, which is a copy at the source (see the COPY-FAMILY note
    // above).
    // Panics on allocator exhaustion, through `push` (design 123, infallible
    // tier). It used to drop transformed values on the floor and hand back a
    // short result vector.
    public func map<U>(&self, transform: (T) -> U) -> Vector<U, A> {
        var result = Vector<U, A>()
        var i = 0
        while i < self.length {
            if let elem = self.get(i) {
                result.push(transform(move elem))
            }
            i = i + 1
        }
        move result
    }

    // Left fold: thread an accumulator of METHOD-level generic type `Acc`
    // through the elements, combining each with `combine` (brief 36 item 3).
    // `Acc` is supplied explicitly (`v.fold<Int>(0, ...)`). The accumulator is
    // `move`d in and out of `combine` on each step, so an `ExplicitCopy`
    // accumulator is threaded without a silent duplicate; a trivial accumulator
    // (e.g. `Int`) moves bitwise. `T: Copy` is again inherited for by-value
    // element access. (The accumulator param is named `Acc`, not `A`, because
    // `A` is now the extension's allocator type parameter — brief 37.)
    public func fold<Acc>(&self, initial: Acc, combine: (Acc, T) -> Acc) -> Acc {
        var acc = move initial
        var i = 0
        while i < self.length {
            if let elem = self.get(i) {
                acc = combine(move acc, move elem)
            }
            i = i + 1
        }
        move acc
    }

    // Visit each element with its index, passing `(index, element)` to `body`
    // (design 53). The closure twin of `enumerated()`: same non-escaping
    // discipline and same by-value / `T: Copy` element rule as `each`.
    public func each_indexed(&self, body: (Int, T) -> Void) {
        var i = 0
        while i < self.length {
            if let elem = self.get(i) {
                body(i, move elem)
            }
            i = i + 1
        }
    }

    // A concrete iterator yielding `(index, element)` pairs for `for` loops
    // (design 53). Mirrors `iter()`/VectorIterator's bounds; `T: Copy` because
    // each element is produced by value.
    public func enumerated(&self) -> EnumeratedIterator<T> {
        EnumeratedIterator<T>(buffer: self.buffer, length: self.length, index: 0)
    }
}

// =============================================================================
// Sorting (design 48) — in-place insertion sort.
// =============================================================================
//
// ALGORITHM: straight insertion sort. Chosen for "simple and correct first";
// it is O(n^2) comparisons but STABLE (equal elements keep their input order,
// because an element only bubbles past a STRICTLY greater predecessor) and
// needs no scratch buffer. A merge/quick sort is a future refinement.
//
// COPY-FAMILY / BOUND: element MOVEMENT is done with `swap` (byte-level,
// refcount-neutral — no element `copy()`/`deinit` ever runs), so no owning
// element is ever duplicated. Element COMPARISON, however, reads two elements
// by value through `get` (which returns a `T?` copy per T's copy class), so
// both entry points are bound to `T: Copy` — the same discipline `Vector.each`
// carries. A `Vector<File>` (NoCopy element) therefore cannot be sorted; a
// future by-reference comparison overload would lift that. `sort` additionally
// requires `T: Comparable` for the `<`/`>` ordering.
extension Vector<T: Comparable + Copy, A: Allocator = GlobalAllocator> {
    // Sort ascending by the element type's Comparable order. Stable.
    public func sort(&var self) {
        var i = 1
        while i < self.length {
            var j = i
            // Bubble element j left while its predecessor is strictly greater.
            // `&&` short-circuits, so `_greater_at` is only read while j > 0.
            while j > 0 && self._greater_at(j - 1, j) {
                self.swap(j - 1, j)
                j = j - 1
            }
            i = i + 1
        }
    }

    // Internal: is element `i` strictly greater than element `j`? Reads both by
    // value (the `T: Copy` bound), compares via T's Comparable `>`.
    func _greater_at(&self, i: Int, j: Int) -> Bool {
        if let a = self.get(i) {
            if let b = self.get(j) {
                return a > b
            }
        }
        false
    }
}

// sort_by takes a user comparator returning an Ordering and needs only
// `T: Copy` (no Comparable — the closure supplies the order). The closure is a
// NON-escaping parameter (the default), so a comparator passed directly may
// borrow-capture enclosing locals. Same stability and movement discipline as
// `sort` (byte-level swap; equal-or-less elements are left in place).
extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    public func sort_by(&var self, compare: (T, T) -> Ordering) {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 {
                var should_swap = false
                if let a = self.get(j - 1) {
                    if let b = self.get(j) {
                        should_swap = compare(move a, move b) == Ordering.Greater
                    }
                }
                if should_swap {
                    self.swap(j - 1, j)
                    j = j - 1
                } else {
                    break
                }
            }
            i = i + 1
        }
    }
}

// =============================================================================
// VectorIterator<T> - Iterator over vector elements
// =============================================================================

// Iterator holds a pointer and length, not the Vector itself
// This allows Vector to be NoCopy while still supporting iteration
struct VectorIterator<T> {
    buffer: UnsafePointer<T>?
    length: Int
    index: Int
}

// `T: Copy` (design 122 unit A): `next()` yields an element the CONSUMER owns,
// so it must be a real copy per T's copy class — `.copy()` retains an
// ImplicitCopy payload, deep-copies an ExplicitCopy one, and bitwise-copies a
// trivial one. Reading the slot without it minted a duplicate owner and the
// element was deinit'd twice. `Vector<T>.iter()` carries the matching bound, so
// a NoCopy element type never reaches here (use `with_ref`/`with_var_ref`).
extension VectorIterator<T: Copy>: Iterator {
    type Item = T

    public func next(&var self) -> T? {
        if self.index < self.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.buffer {
                buf[idx].copy()
            } else {
                None
            }
        } else {
            None
        }
    }
}

// =============================================================================
// EnumeratedIterator<T> - yields (index, element) pairs (design 53)
// =============================================================================

struct EnumeratedIterator<T> {
    buffer: UnsafePointer<T>?
    length: Int
    index: Int
}

// `T: Copy` + `.copy()` for the same reason as `VectorIterator` above: the
// yielded pair OWNS its element, so it must not be a bitwise duplicate of the
// slot. (`enumerated()` already carried the bound at the producer.)
extension EnumeratedIterator<T: Copy>: Iterator {
    type Item = (Int, T)

    public func next(&var self) -> (Int, T)? {
        if self.index < self.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.buffer {
                (idx, buf[idx].copy())
            } else {
                None
            }
        } else {
            None
        }
    }
}
