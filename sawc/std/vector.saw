//! The growable array. A `Vector<T>` owns its elements and grows on demand
//! through an `Allocator`, so it works in the freestanding profile as well as
//! the hosted one.
//!
//! Indexing is a PLACE: `v[i].count += 1` mutates the element where it sits
//! rather than copying it out. Reading an element out as a value follows the
//! element's copy tier, so a move-only element is refused instead of aliased —
//! reach it through `with_ref`, or take it out with `swap_out` or `pop`.
//!
//! `Vector` is ExplicitCopy: every transfer needs `move v` or `v.copy()`.
//! Every operation that can run out of memory REPORTS it —
//! `Result<_, AllocError>`, all-or-nothing (design 234). `copy()` is the one
//! exception and panics instead: it is the `ExplicitCopy` hook, so its
//! signature belongs to the trait.

// =============================================================================
// FFI declarations for memory management
// =============================================================================

// Vector is an alloc-layer type: it allocates through an `Allocator` (design
// 19 §4 / brief 28/37), which wraps the runtime seams — never libc directly —
// so it works in the freestanding profile over a user-provided allocator.
// Buffer alignment comes from `alignof<T>()`, so element types get a
// correctly-aligned backing store rather than a hardcoded constant.
//
// STAGE 4 (brief 37): the allocator is now a PUBLIC type parameter
// `A: Allocator = GlobalAllocator`. Hosted code writes `Vector<T>` unchanged — the
// default fills `A = GlobalAllocator` before mangling, so `Vector<T>` and
// `Vector<T, GlobalAllocator>` are one type. `A()` is a zero-sized construction that
// monomorphizes to a direct call into the concrete allocator's methods, with no
// allocator value stored per Vector (A is a phantom type parameter — it appears
// in no field). memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// Vector<T, A> - A dynamically-sized array over allocator `A`
// =============================================================================
/// A dynamically-sized array that uses allocator A for memory management. It
/// defaults to GlobalAllocator.

public struct Vector<T, A: Allocator = GlobalAllocator> {
    buffer: UnsafePointer<T>?
    length: Int
    capacity: Int
}

// DF-182e, RULED by the user Aug 8 ("containers are Send if T is Send") and
// SAID OUT LOUD by design 186 — it was an entry in a compiler-side list of
// names until now. An owning container inherits its contents' thread-safety.
// Structurally it cannot: the buffer pointer poisons anything holding one, so
// no std container was `Send` at all and a task carrying a `Vector` across a
// suspension could not run in a multi-threaded group. That pointer is the
// container's own bookkeeping, not state a thread can race on — `&var` access
// goes through the Law of Exclusivity — so moving one is safe exactly when
// moving its contents is, and sharing one exactly when sharing them is. The
// allocator is checked with the rest; `GlobalAllocator` is empty.
//
// `Map` and `Set` need no declaration of their own: a `Map` holds a `Vector`
// of slots and a `Set` holds a `Map`, so both DERIVE through this one.
extension Vector<T: Send, A: Send>: UnsafeSend {}
extension Vector<T: Sync, A: Sync>: UnsafeSync {}

extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Initializes an empty vector.
    public init() -> Vector<T, A> {
        Vector<T, A>(buffer: None, length: 0, capacity: 0)
    }

    // Regression guard: this used to hand back an EMPTY vector on refusal, so a
    // caller that asked to reserve a megabyte and got nothing carried on as if
    // it had succeeded (design 123, infallible tier). It then PANICKED, with
    // `try_with_capacity` beside it as the reporting twin; design 234 retires
    // that split — the constructor reports, and there is one of it.
    /// Creates an empty vector with room for `capacity` elements, reporting
    /// `Err(AllocError)` when the allocator refuses. A non-positive `capacity`
    /// returns an empty vector without allocating.
    public init(capacity: Int) unsafe -> Result<Vector<T, A>, AllocError> {
        if capacity <= 0 {
            return Vector<T, A>(buffer: None, length: 0, capacity: 0)
        }
        let byte_size = capacity * sizeof<T>()
        if let raw_ptr = A().alloc(byte_size, alignof<T>()) {
            let typed_ptr = raw_ptr as UnsafePointer<T>
            return Vector<T, A>(buffer: typed_ptr, length: 0, capacity: capacity)
        }
        // Allocator returned None -> surface the failure with size context.
        return AllocError(size: byte_size, align: alignof<T>())
    }

    /// Returns the number of elements.
    public func len(&self) -> Int {
        self.length
    }

    /// Returns true if the vector contains no elements.
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Returns the element at `index` as a place, so it is read or written where
    /// it sits: `v[i].count += 1` mutates the element in the vector and never
    /// copies it out. Reading the place out as a value follows the element's copy
    /// tier: trivial copies bitwise, `Copy` retains, and
    /// `ExplicitCopy`/`NoCopy` is refused with the ways out named.
    ///
    /// The same `v[i]` serves a read and a write; the use site decides which.
    /// Either way the whole vector is borrowed for the length of the expression,
    /// so growing it in the middle of one — `v.push(x)` inside `v[i]` — is a
    /// compile error.
    ///
    /// Panics if `index` is outside `0..<len()`. `get` is the `None`-returning twin.
    public func [](&self, index: Int) unsafe borrows -> T {
        if index < 0 || index >= self.length {
            panic("Vector.[]: index out of range: {} (len {})", index, self.length)
        }
        if let buf = self.buffer {
            lend buf[index]
        } else {
            panic("Vector.[]: buffer is empty")
        }
    }

    // Regression guard: `get` used to return `T?` BY VALUE with no bound at all,
    // so a move-only element came out as a bitwise alias the caller then owned
    // and dropped while the vector still held it — two lookups, two frees, from
    // fully safe code (DF-132a). The copy-tier refusal below is the fix.
    /// Returns the element at `index` if it is in range, as an optional place:
    /// the `None`-returning twin of `[]`. The element is reached where it sits,
    /// so `v.get(i)!.count += 1` writes it in the vector, and
    /// `if let _ = v.get(i)` asks only whether it is there. When the index is out
    /// of range nothing is borrowed at all.
    ///
    /// Reading the place out as a value follows the element's copy tier: trivial
    /// copies bitwise, `Copy` retains, and `ExplicitCopy`/`NoCopy` is
    /// refused with the ways out named.
    public func get(&self, index: Int) unsafe borrows -> T? {
        if index < 0 || index >= self.length {
            return None
        }
        if let buf = self.buffer {
            lend buf[index]
        } else {
            return None
        }
    }

    // Scoped, no-copy access to element `index` (design 81) — THE
    // container borrow-projection API (it replaced the raw `ref_at`). `body`
    // receives a NON-ESCAPING `&T`/`&var T` borrow of the element in place, so a
    // NoCopy element (`Vector<Box<any Resumable>>`, design 52b) is reached
    // without a copy: `v.with_var_ref(i) { frame in frame.resume() }`. The `&var
    // self` / `&self` receiver holds the whole vector borrowed for the duration
    // of the call, so the buffer cannot be reallocated (grow) or the element
    // invalidated while the borrow is live — iterator-invalidation-proof. The
    // borrow is a LEND: nothing is retained. `R` (method-level generic, like
    // `withCString`) is the body's result, chosen at the call site; it flows
    // straight out. BOUNDS-CHECKED: an index outside `0..<len()` panics, exactly
    // like every other indexing operation in the language (design 122, RS-6).
    // The signature carries nothing unsafe, so the caller gets no signal that a
    // bad index would reach arbitrary heap — and this is the sanctioned way to
    // reach a NoCopy element, so it is the API a caller is steered TO.
    // `body` is `sync`: the borrow must not be held across a suspension (and it
    // keeps `with_var_ref` sync-usable, e.g. the executor drains it from the
    // group's `sync` Deinit).
    //
    // design 88 (D6) verdict — the `sync` STAYS. A held D6 reference is sound
    // because its referent is a task-CONFINED stack/frame local that no other task
    // can reach or mutate. A `with_var_ref` borrow is different in kind: it
    // projects INTO a container (this vector) that remains reachable and mutable.
    // If `body` suspended, the yield would hand the scheduler control while the
    // element borrow is live, and another task (or a re-entrant call) could `push`
    // this vector, reallocating the buffer and dangling the borrow — the exact
    // iterator-invalidation this API prevents. Confinement does not cover a
    // container-internal borrow, so the borrow may not span a suspension.
    /// Provides scoped, no-copy access to the element at `index`, returning the
    /// closure's result. The closure receives the element as `&var T` and must be
    /// `sync`. Panics if `index` is outside `0..<len()`.
    public func with_var_ref<R>(&var self, index: Int, body: (&var T) sync -> R) unsafe -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_var_ref: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            body(&var buf[index])
        } else {
            panic("Vector.with_var_ref: buffer is empty")
        }
    }

    /// The shared twin of `with_var_ref`: the closure receives the element as
    /// `&T`. Bounds-checked on the same terms.
    public func with_ref<R>(&self, index: Int, body: (&T) sync -> R) unsafe -> R {
        if index < 0 || index >= self.length {
            panic("Vector.with_ref: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            body(&buf[index])
        } else {
            panic("Vector.with_ref: buffer is empty")
        }
    }

    // The slot at `index` is LIVE, so the prior occupant must be RELEASED: a bare
    // `buf[index] = value` is the placement-move primitive (see `push`), which
    // moves the new value in WITHOUT dropping what was there — that leaked every
    // owning element a `set` overwrote (design 122 unit A). `swap_out` moves the
    // old element out and the `let _ =` discard drops it here, so exactly one
    // deinit runs for it. The out-of-range case used to be a silent no-op, which
    // also dropped the caller's `value` on the floor (design 130's accessor rule).
    /// Replaces the element at `index`, releasing the one it overwrites. Panics if
    /// `index` is outside `0..<len()`; `value` is consumed either way.
    public func set(&var self, index: Int, value: T) unsafe {
        if index < 0 || index >= self.length {
            panic("Vector.set: index out of range: {} (len {})", index, self.length)
        }
        let _ = self.swap_out(index, value)
    }

    // Regression guard (RS-1 heap overflow): `grow()` used to return silently on
    // failure, so the placement write below landed one element PAST the buffer
    // and `length` advanced past `capacity`. Every later `get`, iteration and the
    // final `deinit` then read and freed out of bounds, from fully safe code with
    // no diagnostic. The early return below is what closes it — do not soften it.
    /// Appends `value` to the end, reporting `Err(AllocError)` when the buffer
    /// must grow and the allocator refuses. On error the vector is unchanged and
    /// `value` is destroyed; `reserve` is how you make a later `push`
    /// allocation-free, and how you keep `value` alive across a refusal.
    public func push(&var self, value: T) unsafe -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        // Add the element. `buf[self.length] = value` is the PLACEMENT-MOVE
        // primitive (see LANGUAGE_SPEC "Placement writes"): the slot at
        // `self.length` is uninitialized (length < capacity, never yet
        // written), so the store bitwise-moves `value` in and does NOT release
        // any prior occupant. `value` is consumed by the value-transfer
        // checkpoint. Writing into a slot `< length` this way would leak the
        // live element there — the loop invariant (only ever writing the fresh
        // tail slot) is what makes this sound.
        if let buf = self.buffer {
            buf[self.length] = value
            self.length = self.length + 1
        } else {
            // Unreachable: a successful `_reserve` leaves capacity >= 1, which
            // this type's invariant pairs with a live buffer. The retired
            // `try_push` fell through to `Ok` here, which would be a push that
            // reported success and dropped the element — the silent degradation
            // this whole file exists to refuse. The panicking `push` had this
            // guard; retiring the twin keeps the stricter of the two bodies.
            panic("Vector.push: buffer is empty")
        }
        return
    }

    /// Reserves space for `additional` elements, returning `Err(AllocError)` if the
    /// allocator is exhausted. A successful call ensures the next `additional`
    /// pushes will not fail due to allocation errors. Capacity is never reduced and
    /// non-positive `additional` values are no-ops.
    public func reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        let wanted = self.length + additional
        if not self._reserve(wanted) {
            let bytes = self._grow_target(wanted) * sizeof<T>()
            return AllocError(size: bytes, align: alignof<T>())
        }
        return
    }

    /// Removes and returns the last element, or `None` when the vector is empty.
    /// The caller owns the returned value.
    public func pop(&var self) unsafe -> T? {
        if self.length == 0 {
            None
        } else {
            self.length = self.length - 1
            if let buf = self.buffer {
                // The slot is past the new `length`, so the vector no longer
                // owns what is in it — `move` is the spelling that says the
                // element's ownership leaves here (design 219 unit A2).
                move buf[self.length]
            } else {
                None
            }
        }
    }

    /// Removes all elements while retaining the current capacity.
    public func clear(&var self) {
        self.length = 0
    }

    // Swap the elements at indices `i` and `j` (design 08 / brief 40 item 7).
    //
    // This is the stdlib escape hatch for the shape the static Law of
    // Exclusivity must reject — `swap(&a[i], &a[j])` on the SAME container with
    // dynamic indices, which the compiler conservatively treats as overlapping.
    // Doing the exchange behind one `&var self` receiver moves the aliasing
    // question inside a single mutable borrow, where it is a runtime bounds
    // check instead of a static disjointness proof.
    //
    // Refcount-neutral by construction: the exchange is done at the BYTE level
    // (`Int8`, a trivial type), so it is a pure bitwise relocation of the two
    // slots' contents — no element-level `copy()`/retain and no `deinit`/
    // release ever run. An owning element type (String, Vector, File) is
    // neither retained nor dropped; the two live values just change slots. No
    // `T: Copy` bound is needed. (A T-level `move buf[i]` became expressible in
    // design 219 unit A2 — it was a partial move before — so a three-move
    // exchange through a temporary would type-check now. The byte loop stays:
    // it is the same relocation with no element-typed temporary, and swapping
    // it out is a change that owes its own review.)
    /// Swaps the elements at indices `i` and `j` in place. No element-level copy
    /// or deinit runs — the two live values just change slots — so it works for
    /// any element type, including NoCopy. Swapping an index with itself is a
    /// no-op; panics if either index is outside `0..<len()`.
    public func swap(&var self, i: Int, j: Int) unsafe {
        // No-op on identical indices — swapping a slot with itself is pointless
        // and the byte loop would still be a correct identity, but short-circuit.
        if i == j {
            return
        }
        // Out of range panics (design 130's accessor rule). This was a silent
        // no-op, which meant a caller with a bad index got an unswapped vector
        // and no signal — the "silently does less than the name promises" case.
        // The two indices are checked SEPARATELY so the message can name the one
        // that is wrong (DF-249a's wording family reports the offending index,
        // and a joint check has two candidates and no way to choose).
        if i < 0 || i >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", i, self.length)
        }
        if j < 0 || j >= self.length {
            panic("Vector.swap: index out of range: {} (len {})", j, self.length)
        }
        if let buf = self.buffer {
            let size = sizeof<T>()
            let pi = (buf + i) as UnsafePointer<Int8>
            let pj = (buf + j) as UnsafePointer<Int8>
            var k = 0
            while k < size {
                let t = pi[k]
                pi[k] = pj[k]
                pj[k] = t
                k = k + 1
            }
        }
    }

    // Replace the element at `index`, returning the previous occupant by MOVE
    // (design 48, for Map slot updates). The old value is bitwise-moved out
    // and the new one placement-moved in, so it is refcount-neutral: no element
    // `copy()` and no leak (the placement primitive does not release, but the
    // prior occupant was moved out first, so nothing is dropped on the floor).
    // The returned value is owned by the caller. BOUNDS-CHECKED: an index
    // outside `0..<len()` panics (design 122, RS-6). Unchecked, this was the
    // worst of the three unchecked accessors — `buf[index] = value` past the
    // end is an out-of-bounds WRITE, i.e. heap corruption reachable from fully
    // safe code.
    /// Replaces the element at the specified index with the provided value and
    /// returns the previous occupant by move. The caller takes ownership of the
    /// returned value. This function panics if the index is out of bounds.
    public func swap_out(&var self, index: Int, value: T) unsafe -> T {
        if index < 0 || index >= self.length {
            panic("Vector.swap_out: index out of range: {} (len {})",
                  index, self.length)
        }
        if let buf = self.buffer {
            // Both halves of the exchange spell their transfer (design 219 unit
            // A2): the old element's ownership leaves the slot, the new one's
            // arrives in it.
            let old = move buf[index]
            buf[index] = value
            move old
        } else {
            panic("Vector.swap_out: buffer is empty")
        }
    }

    // Internal: the capacity a growth to `min_capacity` would allocate.
    // Geometric (double, from a floor of 4) unless the caller asked for more.
    // Split out so a failed `_reserve` can report the exact byte size that was
    // refused without `_reserve` having to carry an error payload.
    func _grow_target(&self, min_capacity: Int) -> Int {
        let doubled = if self.capacity == 0 { 4 } else { self.capacity * 2 }
        if doubled < min_capacity {
            min_capacity
        } else {
            doubled
        }
    }

    // Internal: ensure `capacity >= min_capacity`. Returns whether the vector
    // now has that room — FALSE means the allocator refused and the vector is
    // untouched (old buffer, old capacity, old length), which is what lets
    // every caller choose its tier. This reporting return is the RS-1 fix:
    // the old `grow()` returned Void and left `push` to write past the end.
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)
        let new_byte_size = new_capacity * sizeof<T>()

        if let buf = self.buffer {
            // Grow: the seams expose only alloc/dealloc (no realloc), so
            // allocate a fresh buffer, copy the live bytes, and release the old.
            let raw_ptr = buf as UnsafePointer<Int8>
            let old_byte_size = self.capacity * sizeof<T>()
            if let new_raw = A().alloc(new_byte_size, alignof<T>()) {
                memcpy(new_raw, raw_ptr, old_byte_size)
                A().dealloc(raw_ptr, old_byte_size, alignof<T>())
                self.buffer = new_raw as UnsafePointer<T>
                self.capacity = new_capacity
                return true
            }
            return false
        }
        // First allocation
        if let raw_ptr = A().alloc(new_byte_size, alignof<T>()) {
            self.buffer = raw_ptr as UnsafePointer<T>
            self.capacity = new_capacity
            return true
        }
        false
    }

}

// Deinit applies to EVERY element type, not just Copy ones: destroying a
// Vector must run each live element's own deinit (drop glue) before freeing
// the backing buffer, otherwise element resources leak. This conformance is
// deliberately unbounded (`<T>`, no `: Copy`) so it is instantiated even for a
// non-Copy element type like `Vector<File>` — which has no `copy()` but still
// owns elements that must be destroyed.
//
// Manual `deinit()` calls are banned language-wide, so element cleanup uses the
// compiler-internal `__saw_deinit_in_place` intrinsic (usable only inside a deinit
// body). Elements popped/moved out first decrement `length`, so the loop below
// never touches them and cannot double-free.
// design 131: Vector's copy POLICY is the bounded `ExplicitCopy` below, but its
// destruction is unconditional — a `Vector<File>` has no `copy()` and still owns
// elements that must be destroyed. So the `deinit` body lives on the plain
// unconditional extension rather than inside a conformance: `Deinit` is not
// declarable on its own, and the bounded conformance is the wrong home for a
// requirement that holds for every `T`.
extension Vector<T, A: Allocator = GlobalAllocator> {
    public func deinit(&var self) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                __saw_deinit_in_place(buf + i)
                i = i + 1
            }
            let raw_ptr = buf as UnsafePointer<Int8>
            // Deinit routes back to THIS vector's own allocator `A` — a
            // `Vector<T, LoudAlloc>` frees through `LoudAlloc`, never `GlobalAllocator`.
            A().dealloc(raw_ptr, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// Vector is ExplicitCopy: never implicitly duplicated (a bitwise copy of the
// heap buffer would double-free). Transferring a Vector requires `move`;
// duplicating it is always a visible `.copy()`, which deep-copies the buffer.
//
// The bound `<T: ExplicitCopy>` is what the body needs and what it now says
// (design 219, judgment site 2): `copy()` SPELLS `buf[i].copy()`, so the element
// must be duplicable — silently or with ceremony, either is fine here because
// the ceremony is written. This is also what keeps `Vector<Vector<Int>>.copy()`
// working after `Copy` narrowed to the silent tier: a nested vector is
// duplicable, just not silently, and the container's own conformance is exactly
// where that gets expressed.
// Elements that cannot be duplicated at all (`Vector<File>`) make `.copy()` a
// compile error naming the element type at monomorphization.
// (The `deinit` body is on the unconditional extension above, so it covers every
// `T`; the `ExplicitCopy: Deinit` requirement is satisfied by that method.)
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    // Regression guard: this used to return a SHORTER vector on refusal, so a
    // "copy" could silently be missing elements (design 123, infallible tier).
    //
    // THE ONE PLACE DESIGN 234 LEAVES A PANIC IN A NAMED OPERATION (§5,
    // conformance row A17): `copy` is the `ExplicitCopy` HOOK, so its signature
    // is the trait's and the compiler emits calls to it — a `Result` return
    // would have to change the trait, and design 219's contract says the hook is
    // infallible. The panics therefore stay, spelled by hand so they still NAME
    // the method rather than reading `try! failed` out of a std file the caller
    // never opened. `try_copy` is the reporting spelling; DF-257b records that
    // its prefix is the one §4 could not retire.
    /// Duplicates the vector and every element through the same allocator `A`.
    /// Panics if the allocator refuses; `try_copy` reports the failure instead.
    public func copy(&self) unsafe -> Vector<T, A> {
        var result = match Vector<T, A>(capacity: self.capacity) {
            case Ok(v) -> move v,
            case Err(e) -> panic("Vector.copy: {}", e)
        }
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                match result.push(buf[i].copy()) {
                    case Ok(_) -> {},
                    case Err(e) -> panic("Vector.copy: {}", e)
                }
            }
            i = i + 1
        }
        move result
    }
}

// `try_copy` carries `copy`'s bound for `copy`'s reason: it spells the same
// per-element `.copy()`.
extension Vector<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the vector, returning `Err(AllocError)` if the allocator runs out
    /// of memory. The entire buffer is reserved upfront, ensuring the function
    /// returns either a complete copy or an error, never a partial vector.
    public func try_copy(&self) unsafe -> Result<Vector<T, A>, AllocError> {
        var result = Vector<T, A>()
        let _ = try result.reserve(self.length)
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                // The reserve above bought the whole buffer, so no push here can
                // allocate — `try` is the honest spelling anyway, and costs a
                // branch on an already-successful tag.
                let _ = try result.push(buf[i].copy())
            }
            i = i + 1
        }
        return move result
    }
}

// =============================================================================
// Iteration API (design 16/29 item 6) — non-escaping closure parameters.
// =============================================================================
//
// `each`/`map`/`fold` take their closures by NON-escaping parameter (the
// default), so a closure passed directly may borrow-capture enclosing locals:
//   var sum = 0
//   vec.each { [&var sum] in sum += $0 }   // mutates the REAL sum
//
// COPY-FAMILY / BOUND (design 216): the CLOSURE methods take their element BY
// REFERENCE (`&T`), so they carry NO copy bound at all and work over every
// element type — `Vector<File>`, `Vector<Job>`, `Vector<Vector<Int>>`. The
// element is lent where it sits and the closure borrows it for the call; the
// vector still owns it afterwards. Reading a `&T` binding yields the value, so
// `{ $0 * 2 }` and `{ $0.to_string() }` are unaffected by the switch — what
// changes is FORWARDING: a closure handing its element to another `&T`
// parameter writes `&n`, not `n`.
//
// The bodies lend out of the buffer directly rather than going through
// `with_ref`, which declares its body `sync` for its own scoped-window reasons.
// A `(&T) -> U` closure parameter carries no such constraint, so a SUSPENDING
// transform works — that is why these are not written in terms of `with_ref`.
// The borrow spans the closure call and the vector is held `&self` for the
// whole method, so the Law of Exclusivity is what forbids a `push` (and its
// reallocation) from reaching the buffer underneath a live element borrow.
//
// `iter`/`enumerated`/`VectorIterator` keep `T: Copy` — see the bounded
// extension below; theirs is a real constraint, not an inherited one.
extension Vector<T, A: Allocator = GlobalAllocator> {
    /// Iterates over each element in order, lending it to `body` as a `&T`.
    /// Carries no copy bound: the element is borrowed where it sits, never
    /// copied out, so a move-only element type iterates like any other.
    public func each(&self, body: (&T) -> Void) unsafe {
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                body(&buf[i])
            }
            i = i + 1
        }
    }

    // Transform each element through `transform`, collecting the results into a
    // fresh `Vector<U>` (brief 36 item 3). `U` is a METHOD-level generic type
    // parameter — the output element type, independent of `T` — supplied
    // explicitly at the call site (`v.map<String>(...)`). The output element
    // type carries no `Copy` bound: each transformed value is `move`d straight
    // into the result (exactly one placement per element, never a silent copy),
    // and the result is `move`d out. Since design 216 the INPUT element carries
    // none either — `transform` borrows it.
    // REPORTS allocator exhaustion (design 234; it panicked through `push`
    // under design 123, and before that dropped transformed values on the floor
    // and handed back a short result vector). The error is the leaf `AllocError`
    // — `map` has exactly one failure mode of its own, so §1's narrowest-type
    // rule applies and there is no compound to build.
    /// Applies `transform` to each element to return a new `Vector<U>`, where the
    /// output type `U` must be explicitly specified at the call site. The element
    /// is lent to `transform` as a `&T`, so no copy bound is required of `T`.
    /// Reports `Err(AllocError)` when the result vector cannot grow.
    public func map<U>(&self, transform: (&T) -> U) unsafe -> Result<Vector<U, A>, AllocError> {
        var result = Vector<U, A>()
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                let _ = try result.push(transform(&buf[i]))
            }
            i = i + 1
        }
        return move result
    }

    // Left fold: thread an accumulator of METHOD-level generic type `Acc`
    // through the elements, combining each with `combine` (brief 36 item 3).
    // `Acc` is supplied explicitly (`v.fold<Int>(0, ...)`). The accumulator is
    // `move`d in and out of `combine` on each step, so an `ExplicitCopy`
    // accumulator is threaded without a silent duplicate; a trivial accumulator
    // (e.g. `Int`) moves bitwise. The ELEMENT is lent by reference (design 216).
    // (The accumulator param is named `Acc`, not `A`, because `A` is now the
    // extension's allocator type parameter — brief 37.)
    /// Performs a left fold by threading an accumulator through the elements using
    /// the `combine` function. The caller provides an initial value and an explicit
    /// type parameter for the accumulator. The accumulator is moved into and out of
    /// the `combine` closure at each step; the element is lent to it as a `&T`.
    public func fold<Acc>(&self, initial: Acc, combine: (Acc, &T) -> Acc) unsafe -> Acc {
        var acc = move initial
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                acc = combine(move acc, &buf[i])
            }
            i = i + 1
        }
        move acc
    }

    // Visit each element with its index, passing `(index, &element)` to `body`
    // (design 53). The closure twin of `enumerated()`: same non-escaping
    // discipline and, since design 216, the same by-reference element rule as
    // `each`.
    /// Iterates through each element, passing the index and a `&T` borrow of the
    /// element to the closure. The closure must be non-escaping; no copy bound is
    /// required of `T`.
    public func each_indexed(&self, body: (Int, &T) -> Void) unsafe {
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                body(i, &buf[i])
            }
            i = i + 1
        }
    }
}

extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    // Create an iterator over this vector's elements (`for x in v.iter()`).
    //
    // `T: Copy` — a REAL constraint, and since design 216 no longer shared with
    // the closure methods: `next()` hands the consumer an OWNED element, which
    // is a copy at the source. Unbounded, `next()` returned a bitwise duplicate
    // of the slot, so an owning element (`Vector<String>`, `Vector<Vector<..>>`,
    // `Vector<File>`) was owned by BOTH the loop variable and the vector and
    // deinit'd twice (design 122 unit A). This follows the `StringBytes`/
    // `StringChars` model — an iterator yields values the consumer owns
    // outright, with their own retain — rather than a scoped-borrow shape:
    // a borrow iterator would have to hold the container borrowed for the
    // whole loop, which is exactly what `with_ref`/`with_var_ref` already
    // offer per element, and where `each`/`map` reach a NoCopy element type.
    /// Returns an iterator over the vector's elements (`for x in v.iter()`).
    /// Each element is yielded as an owned copy, which is what requires
    /// `T: Copy`.
    public func iter(&self) unsafe -> VectorIterator<T> {
        VectorIterator<T>(buffer: self.buffer, length: self.length, index: 0)
    }

    // A concrete iterator yielding `(index, element)` pairs for `for` loops
    // (design 53). Mirrors `iter()`/VectorIterator's bounds; `T: Copy` because
    // each element is produced by value.
    /// Returns an iterator yielding `(index, element)` pairs. The iterator follows
    /// the bounds of `iter()`. Because elements are yielded by value, `T` must
    /// be `Copy`.
    public func enumerated(&self) unsafe -> EnumeratedIterator<T> {
        EnumeratedIterator<T>(buffer: self.buffer, length: self.length, index: 0)
    }
}

// =============================================================================
// Sorting (design 48) — in-place insertion sort.
// =============================================================================
//
// ALGORITHM: straight insertion sort. Chosen for "simple and correct first";
// it is O(n^2) comparisons but STABLE (equal elements keep their input order,
// because an element only bubbles past a STRICTLY greater predecessor) and
// needs no scratch buffer. A merge/quick sort is a future refinement.
//
// COPY-FAMILY / BOUND: element MOVEMENT is done with `swap` (byte-level,
// refcount-neutral — no element `copy()`/`deinit` ever runs), so no owning
// element is ever duplicated. Element COMPARISON, however, reads two elements
// by value through `get` (which returns a `T?` copy per T's copy class), so
// both entry points are bound to `T: Copy` — the same discipline `Vector.each`
// carries. A `Vector<File>` (NoCopy element) therefore cannot be sorted; a
// future by-reference comparison overload would lift that. `sort` additionally
// requires `T: Comparable` for the `<`/`>` ordering.
extension Vector<T: Comparable + Copy, A: Allocator = GlobalAllocator> {
    /// Sorts elements in ascending order according to the element type's Comparable
    /// implementation. The sort is stable.
    public func sort(&var self) {
        var i = 1
        while i < self.length {
            var j = i
            // Bubble element j left while its predecessor is strictly greater.
            // `&&` short-circuits, so `_greater_at` is only read while j > 0.
            while j > 0 && self._greater_at(j - 1, j) {
                self.swap(j - 1, j)
                j = j - 1
            }
            i = i + 1
        }
    }

    // Internal: is element `i` strictly greater than element `j`? Reads both by
    // value (the `T: Copy` bound), compares via T's Comparable `>`.
    func _greater_at(&self, i: Int, j: Int) -> Bool {
        if let a = self.get(i) {
            if let b = self.get(j) {
                return a > b
            }
        }
        false
    }
}

// sort_by takes a user comparator returning an Ordering and needs only
// `T: Copy` (no Comparable — the closure supplies the order). The closure is a
// NON-escaping parameter (the default), so a comparator passed directly may
// borrow-capture enclosing locals. Same stability and movement discipline as
// `sort` (byte-level swap; equal-or-less elements are left in place).
extension Vector<T: Copy, A: Allocator = GlobalAllocator> {
    public func sort_by(&var self, compare: (T, T) -> Ordering) {
        var i = 1
        while i < self.length {
            var j = i
            while j > 0 {
                var should_swap = false
                if let a = self.get(j - 1) {
                    if let b = self.get(j) {
                        should_swap = compare(move a, move b) == Ordering.Greater
                    }
                }
                if should_swap {
                    self.swap(j - 1, j)
                    j = j - 1
                } else {
                    break
                }
            }
            i = i + 1
        }
    }
}

// =============================================================================
// VectorIterator<T> - Iterator over vector elements
// =============================================================================

// Iterator holds a pointer and length, not the Vector itself
// This allows Vector to be NoCopy while still supporting iteration
// `public` because `Vector.iter()` HANDS ONE OUT: a public API needs public
// types (Aug 21), and a caller that holds the value of a `for x in v.iter()`
// must be able to name its type. The fields stay private.
public struct VectorIterator<T> {
    buffer: UnsafePointer<T>?
    length: Int
    index: Int
}

// `T: ExplicitCopy` (design 122 unit A, restated by 219): `next()` yields an
// element the CONSUMER owns, so it must be a real copy per T's tier — the
// SPELLED `buf[idx].copy()` below retains a refcounted payload, deep-copies a
// ceremony-tier one, and bitwise-copies a trivial one. Reading the slot without
// it minted a duplicate owner and the element was deinit'd twice. The bound
// names the duplicable family because the body spells the duplicate;
// `Vector<T>.iter()` keeps the stricter `T: Copy` at the producer, which every
// duplicable-family bound admits.
// A move-only element type never reaches here (use `with_ref`/`with_var_ref`,
// or the closure methods, which carry no bound at all since design 216).
extension VectorIterator<T: ExplicitCopy>: Iterator {
    type Item = T

    public func next(&var self) unsafe -> T? {
        if self.index < self.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.buffer {
                buf[idx].copy()
            } else {
                None
            }
        } else {
            None
        }
    }
}

// =============================================================================
// EnumeratedIterator<T> - yields (index, element) pairs (design 53)
// =============================================================================

// `public` for the same reason as `VectorIterator` above:
// `Vector.enumerated()` returns one.
public struct EnumeratedIterator<T> {
    buffer: UnsafePointer<T>?
    length: Int
    index: Int
}

// `T: ExplicitCopy` + `.copy()` for the same reason as `VectorIterator` above:
// the yielded pair OWNS its element, so it must not be a bitwise duplicate of
// the slot. (`enumerated()` keeps the stricter `T: Copy` at the producer.)
extension EnumeratedIterator<T: ExplicitCopy>: Iterator {
    type Item = (Int, T)

    public func next(&var self) unsafe -> (Int, T)? {
        if self.index < self.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.buffer {
                (idx, buf[idx].copy())
            } else {
                None
            }
        } else {
            None
        }
    }
}
