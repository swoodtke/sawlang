// Vector<T> - Dynamic array implementation
// Part of the Saw standard library

// =============================================================================
// FFI declarations for memory management
// =============================================================================

// Vector is an alloc-layer type: it allocates through the `Global` allocator
// (design 19 §4 / brief 28), which wraps the runtime seams — never libc
// directly — so it works in the freestanding profile over a user-provided
// allocator. Buffer alignment comes from `alignof<T>()`, so element types get a
// correctly-aligned backing store rather than a hardcoded constant. In stage 4
// the allocator becomes a public type parameter (`Vector<T, A = Global>`); the
// `Global()` calls below are the seam that exposure will thread. memcpy is a
// compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// Vector<T> - A dynamically-sized array
// =============================================================================

struct Vector<T> {
    buffer: UnsafePointer<T>?
    length: Int
    capacity: Int
}

extension Vector<T> {
    // Create an empty vector
    init() -> Vector<T> {
        Vector<T>(buffer: None, length: 0, capacity: 0)
    }

    // Create a vector with pre-allocated capacity
    init(capacity: Int) -> Vector<T> {
        if capacity <= 0 {
            Vector<T>(buffer: None, length: 0, capacity: 0)
        } else {
            let byte_size = capacity * sizeof<T>()
            if let raw_ptr = Global().alloc(byte_size, alignof<T>()) {
                let typed_ptr = raw_ptr as UnsafePointer<T>
                Vector<T>(buffer: typed_ptr, length: 0, capacity: capacity)
            } else {
                // Allocation failed, return empty vector
                Vector<T>(buffer: None, length: 0, capacity: 0)
            }
        }
    }

    // Fallible capacity factory (design 19 three-tier failure model, tier 2).
    // Where `init(capacity:)` silently degrades to an empty vector on OOM, this
    // hands the caller the failure: on allocator exhaustion it returns
    // `Err(AllocError)` carrying the byte size and alignment of the request that
    // failed, so a site that genuinely handles OOM locally can react (and log
    // context) instead of proceeding with a smaller-than-asked buffer. The
    // success path is identical to `init(capacity:)`. A non-positive request
    // needs no allocation and trivially succeeds with an empty vector.
    func try_with_capacity(n: Int) -> Result<Vector<T>, AllocError> {
        if n <= 0 {
            return Vector<T>()
        }
        let byte_size = n * sizeof<T>()
        if let raw_ptr = Global().alloc(byte_size, alignof<T>()) {
            let typed_ptr = raw_ptr as UnsafePointer<T>
            return Vector<T>(buffer: typed_ptr, length: 0, capacity: n)
        }
        // Allocator returned None -> surface the failure with size context.
        return AllocError(size: byte_size, align: alignof<T>())
    }

    // Get the number of elements
    func len(&self) -> Int {
        self.length
    }

    // Check if the vector is empty
    func is_empty(&self) -> Bool {
        self.length == 0
    }

    // Get element at index (returns None if out of bounds)
    func get(&self, index: Int) -> T? {
        if index < 0 || index >= self.length {
            None
        } else {
            if let buf = self.buffer {
                buf[index]
            } else {
                None
            }
        }
    }

    // Set element at index (no-op if out of bounds)
    func set(&var self, index: Int, value: T) {
        if index >= 0 && index < self.length {
            if let buf = self.buffer {
                buf[index] = value
            }
        }
    }

    // Add an element to the end
    func push(&var self, value: T) {
        // Grow if needed
        if self.length >= self.capacity {
            self.grow()
        }
        // Add the element. `buf[self.length] = value` is the PLACEMENT-MOVE
        // primitive (see LANGUAGE_SPEC "Placement writes"): the slot at
        // `self.length` is uninitialized (length < capacity, never yet
        // written), so the store bitwise-moves `value` in and does NOT release
        // any prior occupant. `value` is consumed by the value-transfer
        // checkpoint. Writing into a slot `< length` this way would leak the
        // live element there — the loop invariant (only ever writing the fresh
        // tail slot) is what makes this sound.
        if let buf = self.buffer {
            buf[self.length] = value
            self.length = self.length + 1
        }
    }

    // Remove and return the last element
    func pop(&var self) -> T? {
        if self.length == 0 {
            None
        } else {
            self.length = self.length - 1
            if let buf = self.buffer {
                buf[self.length]
            } else {
                None
            }
        }
    }

    // Remove all elements (keeps capacity)
    func clear(&var self) {
        self.length = 0
    }

    // Internal: grow the buffer capacity
    func grow(&var self) {
        let new_capacity = if self.capacity == 0 { 4 } else { self.capacity * 2 }
        let new_byte_size = new_capacity * sizeof<T>()

        if let buf = self.buffer {
            // Grow: the seams expose only alloc/dealloc (no realloc), so
            // allocate a fresh buffer, copy the live bytes, and release the old.
            let raw_ptr = buf as UnsafePointer<Int8>
            let old_byte_size = self.capacity * sizeof<T>()
            if let new_raw = Global().alloc(new_byte_size, alignof<T>()) {
                memcpy(new_raw, raw_ptr, old_byte_size)
                Global().dealloc(raw_ptr, old_byte_size, alignof<T>())
                self.buffer = new_raw as UnsafePointer<T>
                self.capacity = new_capacity
            }
        } else {
            // First allocation
            if let raw_ptr = Global().alloc(new_byte_size, alignof<T>()) {
                self.buffer = raw_ptr as UnsafePointer<T>
                self.capacity = new_capacity
            }
        }
    }

    // Create an iterator for this vector
    func iter(&self) -> VectorIterator<T> {
        VectorIterator<T>(buffer: self.buffer, length: self.length, index: 0)
    }
}

// Deinit applies to EVERY element type, not just Copy ones: destroying a
// Vector must run each live element's own deinit (drop glue) before freeing
// the backing buffer, otherwise element resources leak. This conformance is
// deliberately unbounded (`<T>`, no `: Copy`) so it is instantiated even for a
// non-Copy element type like `Vector<File>` — which has no `copy()` but still
// owns elements that must be destroyed.
//
// Manual `deinit()` calls are banned language-wide, so element cleanup uses the
// compiler-internal `__deinit_in_place` intrinsic (usable only inside a deinit
// body). Elements popped/moved out first decrement `length`, so the loop below
// never touches them and cannot double-free.
extension Vector<T>: Deinit {
    func deinit(&var self) {
        if let buf = self.buffer {
            var i = 0
            while i < self.length {
                __deinit_in_place(buf + i)
                i = i + 1
            }
            let raw_ptr = buf as UnsafePointer<Int8>
            Global().dealloc(raw_ptr, self.capacity * sizeof<T>(), alignof<T>())
        }
    }
}

// Vector is ExplicitCopy: never implicitly duplicated (a bitwise copy of the
// heap buffer would double-free). Transferring a Vector requires `move`;
// duplicating it is always a visible `.copy()`, which deep-copies the buffer.
//
// The bound `<T: Copy>` is required because copy() duplicates each element via
// T's copy path. Elements that are not Copy (e.g. Vector<File>) make
// `.copy()` a compile error naming the element type at monomorphization.
// (Deinit is provided unconditionally above; ExplicitCopy: Deinit is satisfied
// by that separate conformance.)
extension Vector<T: Copy>: ExplicitCopy {
    // Deep copy: allocate a fresh buffer and copy each element.
    func copy(&self) -> Vector<T> {
        var result = Vector<T>(capacity: self.capacity)
        var i = 0
        while i < self.length {
            if let buf = self.buffer {
                result.push(buf[i].copy())
            }
            i = i + 1
        }
        move result
    }
}

// =============================================================================
// VectorIterator<T> - Iterator over vector elements
// =============================================================================

// Iterator holds a pointer and length, not the Vector itself
// This allows Vector to be NoCopy while still supporting iteration
struct VectorIterator<T> {
    buffer: UnsafePointer<T>?
    length: Int
    index: Int
}

extension VectorIterator<T>: Iterator {
    type Item = T

    func next(&var self) -> T? {
        if self.index < self.length {
            let idx = self.index
            self.index = self.index + 1
            if let buf = self.buffer {
                buf[idx]
            } else {
                None
            }
        } else {
            None
        }
    }
}
