// StringBuilder: a mutable string buffer.

// StringBuilder allocates through `GlobalAllocator`, never libc directly.
// memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>

    // Refcounted String runtime (defined by the compiler).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

static ASCII_ZERO: Int = 48
static MINUS_SIGN: Byte = 45

// The truncation marker a fixed builder stamps when content does not fit: `…`
// (U+2026), whose UTF-8 encoding is these three bytes. A silently short
// message would be a hidden error.
static MARKER_LEN: Int = 3
static MARKER_BYTE_0: Byte = 226
static MARKER_BYTE_1: Byte = 128
static MARKER_BYTE_2: Byte = 166

// The smallest `capacity` a fixed builder accepts: the marker plus the NUL
// terminator plus one byte of text. Below this there is nothing to say.
static MIN_FIXED_CAPACITY: Int = 5

public struct StringBuilder {
    private buffer: UnsafePointer<Int8>?
    private length: Int
    private capacity: Int
    // Fixed mode: the buffer is caller-provided storage that is never grown and
    // never freed. Overflow truncates and marks instead of reallocating, which
    // lets `panic`, `assert` and `print` assemble a message with the allocator
    // refusing everything.
    private fixed: Bool
    private truncated: Bool
}

// The buffer pointer blocks the Send/Sync derivation, but a `StringBuilder`
// owns those bytes outright: every mutation is a `&var self` method gated by
// the Law of Exclusivity, and no `&self` method writes. In fixed mode the
// buffer is caller storage, which the caller's own borrow pins (design 186).
extension StringBuilder: UnsafeSend {}
extension StringBuilder: UnsafeSync {}

extension StringBuilder {
    public init() -> StringBuilder {
        StringBuilder(buffer: None, length: 0, capacity: 0, fixed: false,
                      truncated: false)
    }

    /// Creates an empty builder with room for `capacity` bytes, reporting
    /// allocator exhaustion as `Err(AllocError)`.
    public init(capacity: Int) unsafe -> Result<StringBuilder, AllocError> {
        if capacity <= 0 {
            return StringBuilder()
        }
        if let ptr = GlobalAllocator().alloc(capacity, 1) {
            return StringBuilder(buffer: ptr, length: 0, capacity: capacity,
                                 fixed: false, truncated: false)
        }
        return AllocError(size: capacity, align: 1)
    }

    /// Creates a builder over caller-provided storage that never allocates.
    ///
    /// `bytes` must address at least `capacity` writable bytes and must outlive
    /// the builder, which neither grows nor frees them. Content that does not
    /// fit is truncated rather than dropped silently: the text is cut on a
    /// UTF-8 boundary, the marker `…` is stamped in its place, and
    /// `is_truncated` answers yes from then on.
    ///
    /// This is the formatting path that survives an exhausted allocator, so it
    /// is what `panic`, `assert` and `print("{}", x)` assemble through. Writing
    /// a `format` body out of `append` calls — rather than out of `"{...}"`
    /// interpolation, which builds a heap String — is what makes a type
    /// printable on that path.
    ///
    /// The last four bytes of `capacity` are held back for the marker and the
    /// NUL terminator, so a builder with `capacity` bytes holds `capacity - 4`
    /// bytes of text. Panics if `capacity` is smaller than
    /// `MIN_FIXED_CAPACITY`, which leaves no room to say anything at all.
    public init(bytes: UnsafePointer<Int8>, capacity: Int) unsafe -> StringBuilder {
        if capacity < MIN_FIXED_CAPACITY {
            panic("StringBuilder(bytes:capacity:): capacity is too small to format into")
        }
        bytes[0] = 0
        StringBuilder(buffer: bytes, length: 0, capacity: capacity, fixed: true,
                      truncated: false)
    }

    /// Points a fixed builder at `bytes`, keeping its length and truncation.
    ///
    /// For storage that moved with the value holding it. A fixed builder stores
    /// the address of its buffer, and a Saw move copies bytes, so a builder that
    /// travels alongside its own storage — `FixedStringBuilder<N>`, whose buffer
    /// is a field beside it — is left pointing at where the bytes used to be.
    /// Re-aiming it before each use costs one store and makes the whole
    /// arrangement move-safe.
    ///
    /// `bytes` must address the same content, at least `capacity` bytes of it.
    /// This does not clear the buffer and does not re-check capacity; pointing a
    /// builder at unrelated storage keeps a length that describes neither.
    /// Growable builders own their buffer and have nothing to re-aim, so this
    /// does nothing to one.
    public func rebind(&var self, bytes: UnsafePointer<Int8>) unsafe {
        if self.fixed {
            self.buffer = bytes
        }
    }

    /// Whether content has been cut to fit this builder's fixed storage.
    ///
    /// Always `false` for a growable builder. Once true it stays true, and the
    /// built text ends in `…`.
    public func is_truncated(&self) -> Bool {
        self.truncated
    }

    public func len(&self) -> Int {
        self.length
    }

    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Appends the bytes of `s`.
    ///
    /// Length comes from the O(1) header, not a strlen scan, so interior NUL
    /// bytes are preserved and no libc call is made. Reports allocator
    /// exhaustion as `Err(AllocError)`; the builder is unchanged then (no
    /// partial append). A fixed builder never fails; it truncates instead.
    public func append(&var self, s: String) -> Result<Void, AllocError> {
        let s_len = s.len()
        if s_len == 0 {
            return
        }
        let needed = self.length + s_len + 1
        if not self._reserve(needed) {
            // Fixed storage has no allocator to fail, so an `AllocError` would
            // name a failure that did not happen. The overflow is reported by
            // the `…` marker and `is_truncated`.
            if self.fixed {
                self._overflow(s, s_len)
                return
            }
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place(s, s_len)
        return
    }

    // Copy `s_len` bytes of `s` into the (already reserved) buffer and
    // re-terminate.
    func _place(&var self, s: String, s_len: Int) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < s_len {
                buf[self.length + i] = self._c_char(s.byte_at(i))
                i = i + 1
            }
            self.length = self.length + s_len
            buf[self.length] = 0
        }
    }

    // Not `"{value}"`, which would build a heap String on the one formatting
    // path that must survive allocator exhaustion; the digits are emitted
    // most-significant-first by repeated division.
    /// Appends the decimal rendering of `value`.
    ///
    /// Stages nothing on the heap, so it works on a fixed builder with the
    /// allocator exhausted.
    public func append(&var self, value: Int) -> Result<Void, AllocError> {
        if value < 0 {
            let _ = try self.append(MINUS_SIGN)
        }
        // The magnitude is carried on the negative side: `0 - Int.min` overflows
        // but `Int.min` itself is representable, so every Int works here. `/`
        // and `%` truncate toward zero, which makes each `%` result the negated
        // digit.
        let n = if value < 0 { value } else { 0 - value }
        var scale = 1
        var probe = n
        while probe <= -10 {
            probe = probe / 10
            scale = scale * 10
        }
        while scale > 0 {
            let digit = 0 - ((n / scale) % 10)
            let _ = try self.append(self._scalar_byte(ASCII_ZERO + digit))
            scale = scale / 10
        }
        return
    }

    /// Appends the decimal rendering of `value`.
    ///
    /// The unsigned twin of `append(value: Int)`, equally allocation-free, for
    /// values above `Int.max`.
    public func append(&var self, value: UInt) -> Result<Void, AllocError> {
        var scale: UInt = 1
        var probe = value
        while probe >= 10 {
            probe = probe / 10
            scale = scale * 10
        }
        while scale > 0 {
            let digit = (value / scale) % 10
            let _ = try self.append(self._scalar_byte(ASCII_ZERO + (digit as Int)))
            scale = scale / 10
        }
        return
    }

    // `append(value: Float)` lives in `sawc/std/float.saw` beside the
    // shortest-round-trip machinery (design 253).
    /// Appends one raw byte, reporting allocator exhaustion as `Err(AllocError)`.
    ///
    /// Writes the byte itself, where the `Int` and `UInt` overloads write a
    /// decimal rendering. The argument's type alone decides: `append(65)` writes
    /// `65`, and `append(Byte(65))` writes `A`. The parameter is a `Byte`, not a
    /// `UInt8`, so an integer never becomes a raw byte by accident; to render a
    /// byte's digits, write `append(b as Int)`.
    ///
    /// A fixed builder that is full truncates instead of failing.
    public func append(&var self, b: Byte) -> Result<Void, AllocError> {
        let needed = self.length + 2
        if not self._reserve(needed) {
            if self.fixed {
                self._mark_truncated()
                return
            }
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place_char(b)
        return
    }

    // Fixed mode: `s` does not fit, so copy the prefix that does and stamp the
    // truncation marker after it.
    //
    // `_reserve` holds MARKER_LEN bytes back from every fit test, so `length`
    // never passes `capacity - 1 - MARKER_LEN` and the marker always has room:
    // no text already placed is overwritten or re-scanned. The cut point in `s`
    // is scanned back to a UTF-8 boundary so no half scalar is emitted.
    func _overflow(&var self, s: String, s_len: Int) unsafe {
        if self.truncated {
            return                          // already cut; the buffer is full
        }
        if let buf = self.buffer {
            // Reachable only when the content overruns, so this is < s_len.
            var n = self.capacity - 1 - MARKER_LEN - self.length
            if n > s_len {
                n = s_len
            }
            while n > 0 && self._is_continuation(s.byte_at(n)) {
                n = n - 1
            }
            var i = 0
            while i < n {
                buf[self.length + i] = self._c_char(s.byte_at(i))
                i = i + 1
            }
            self.length = self.length + n
        }
        self._mark_truncated()
    }

    // Fixed mode: stamp `…` at the current end and seal the builder. Idempotent:
    // once marked, `length` sits at the buffer's text limit, so every later
    // append re-enters here and returns.
    func _mark_truncated(&var self) unsafe {
        if self.truncated {
            return
        }
        self.truncated = true
        if let buf = self.buffer {
            buf[self.length] = self._c_char(MARKER_BYTE_0)
            buf[self.length + 1] = self._c_char(MARKER_BYTE_1)
            buf[self.length + 2] = self._c_char(MARKER_BYTE_2)
            self.length = self.length + MARKER_LEN
            buf[self.length] = 0
        }
    }

    // Whether `b` is a UTF-8 continuation byte (0b10xxxxxx).
    func _is_continuation(&self, b: Byte) -> Bool {
        b >= 128 && b < 192
    }

    // Place one byte into the (already reserved) buffer.
    func _place_char(&var self, b: Byte) unsafe {
        if let buf = self.buffer {
            buf[self.length] = self._c_char(b)
            self.length = self.length + 1
            buf[self.length] = 0
        }
    }

    // The code units are assembled with multiplication, as in the decoder in
    // `sawc/std/string.saw`: *64, *4096 and *262144 are the 6/12/18-bit shifts.
    /// Appends the UTF-8 encoding of `scalar`: the character, not its number.
    ///
    /// The inverse of `String.scalars()`, so an encode/decode round-trip is the
    /// identity on every scalar. Reports allocator exhaustion as
    /// `Err(AllocError)`; nothing else can fail, since a `Scalar` is valid by
    /// construction.
    public func append(&var self, scalar: Scalar) -> Result<Void, AllocError> {
        let code = scalar.value()
        if code < 128 {
            let _ = try self.append(self._scalar_byte(code))
            return
        }
        if code < 2048 {
            let _ = try self.append(self._scalar_byte(192 + code / 64))
            let _ = try self.append(self._scalar_byte(128 + code % 64))
            return
        }
        if code < 65536 {
            let _ = try self.append(self._scalar_byte(224 + code / 4096))
            let _ = try self.append(self._scalar_byte(128 + (code / 64) % 64))
            let _ = try self.append(self._scalar_byte(128 + code % 64))
            return
        }
        let _ = try self.append(self._scalar_byte(240 + code / 262144))
        let _ = try self.append(self._scalar_byte(128 + (code / 4096) % 64))
        let _ = try self.append(self._scalar_byte(128 + (code / 64) % 64))
        let _ = try self.append(self._scalar_byte(128 + code % 64))
        return
    }

    // A code unit 0..255 computed in `Int`, as a byte. `Byte` is built from a
    // `UInt8`, not an `Int`, so the narrowing is spelled once, here.
    func _scalar_byte(&self, u: Int) -> Byte {
        Byte(UInt8.from(truncating: u))
    }

    // The write funnel: a byte value as the C `char` with the same bit pattern.
    // A byte at or above 0x80 has no `Int8` value, so a checked `as` would panic
    // on every continuation byte (design 250). The bare `buf[...] = 0`
    // terminator writes are `Int8` literals and do not come through here.
    //
    // ENTRY POINTS: `_place`, `_place_char`, `_overflow`, `_mark_truncated`.
    func _c_char(&self, b: Byte) -> Int8 {
        Int8.from(truncating: b)
    }

    // Clear the buffer (keep capacity). A fixed builder is un-truncated by
    // this: the storage is empty again, so the old cut no longer describes it.
    public func clear(&var self) unsafe {
        self.length = 0
        self.truncated = false
        if let buf = self.buffer {
            buf[0] = 0
        }
    }

    // Produce an owned String from the bytes built so far.
    // `__saw_string_from_bytes` copies into a fresh refcount=1 block, so the
    // result never aliases the builder's buffer. `buf as String` would be a
    // header-less pointer that corrupts on len()/release.
    //
    // Panics if the String allocation is refused (the String layer panics on
    // exhaustion; design 234). The `""` below is only for a builder that was
    // never appended to.
    public func build(&self) unsafe -> String {
        if let buf = self.buffer {
            __saw_string_from_bytes(buf, self.length)
        } else {
            ""
        }
    }

    // Alias for `build()`.
    public func as_str(&self) -> String {
        self.build()
    }

    // The capacity a growth to `min_capacity` would allocate.
    func _grow_target(&self, min_capacity: Int) -> Int {
        var target = if self.capacity == 0 { 16 } else { self.capacity * 2 }
        while target < min_capacity {
            target = target * 2
        }
        target
    }

    // Ensure `capacity >= min_capacity`. Returns whether the builder now has
    // that room; `false` means the allocator refused (or fixed storage is
    // full) and the builder is untouched. Every caller must check it before
    // placing bytes.
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        if self.fixed {
            // Fixed storage never grows, and the last MARKER_LEN bytes are held
            // back so an overflow always has room to say that it overflowed.
            return min_capacity <= self.capacity - MARKER_LEN
        }
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)

        if let buf = self.buffer {
            // Grow via alloc + copy + dealloc (the seams provide no realloc).
            let old_capacity = self.capacity
            if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
                memcpy(new_buf, buf, old_capacity)
                GlobalAllocator().dealloc(buf, old_capacity, 1)
                self.buffer = new_buf
                self.capacity = new_capacity
                return true
            }
            return false
        }
        if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
            self.buffer = new_buf
            self.capacity = new_capacity
            new_buf[0] = 0  // Initialize with null terminator
            return true
        }
        false
    }
}

extension StringBuilder: NoCopy {
    public func deinit(&var self) unsafe {
        // Fixed storage is borrowed, not owned: the caller's buffer outlives
        // the builder and freeing it here would be a free of memory this type
        // never allocated.
        if self.fixed {
            return
        }
        if let buf = self.buffer {
            GlobalAllocator().dealloc(buf, self.capacity, 1)
        }
    }
}
