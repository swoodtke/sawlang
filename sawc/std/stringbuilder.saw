// StringBuilder - Mutable string buffer
// Part of the Saw standard library

// =============================================================================
// FFI declarations
// =============================================================================

// StringBuilder is an alloc-layer type: it allocates through the `GlobalAllocator`
// allocator (design 19 §4 / brief 28), which wraps the runtime seams — never
// libc directly. memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>

    // Refcounted String runtime (defined by the compiler).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// StringBuilder - A mutable string buffer
// =============================================================================

struct StringBuilder {
    buffer: UnsafePointer<Int8>?
    length: Int
    capacity: Int
}

extension StringBuilder {
    // Create an empty string builder
    public init() -> StringBuilder {
        StringBuilder(buffer: None, length: 0, capacity: 0)
    }

    /// Creates an empty builder with room for `capacity` bytes.
    ///
    /// Panics if the allocator refuses the request (design 123, infallible
    /// tier); `try_with_capacity` reports the failure instead.
    public init(capacity: Int) unsafe -> StringBuilder {
        if capacity <= 0 {
            StringBuilder(buffer: None, length: 0, capacity: 0)
        } else {
            if let ptr = GlobalAllocator().alloc(capacity, 1) {
                StringBuilder(buffer: ptr, length: 0, capacity: capacity)
            } else {
                panic("StringBuilder(capacity:): allocation failed")
            }
        }
    }

    /// Creates an empty builder with room for `n` bytes, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    public func try_with_capacity(n: Int) unsafe -> Result<StringBuilder, AllocError> {
        if n <= 0 {
            return StringBuilder()
        }
        if let ptr = GlobalAllocator().alloc(n, 1) {
            return StringBuilder(buffer: ptr, length: 0, capacity: n)
        }
        return AllocError(size: n, align: 1)
    }

    // Get current length
    public func len(&self) -> Int {
        self.length
    }

    // Check if empty
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Appends the bytes of `s`.
    ///
    /// Length comes from the O(1) header, not a strlen scan, so interior NUL
    /// bytes are preserved and no libc call is made. Panics if the buffer must
    /// grow and the allocator refuses (design 123, infallible tier); the
    /// refused grow used to leave `capacity` short and the copy below then wrote
    /// past the end of the buffer. `try_append` reports the failure instead.
    public func append(&var self, s: String) {
        let s_len = s.len()

        if s_len == 0 {
            return
        }

        // +1 for the null terminator.
        if not self._reserve(self.length + s_len + 1) {
            panic("StringBuilder.append: allocation failed")
        }
        self._place(s, s_len)
    }

    /// Appends the bytes of `s`, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    ///
    /// The builder is unchanged on `Err` — no partial append.
    public func try_append(&var self, s: String) -> Result<Void, AllocError> {
        let s_len = s.len()
        if s_len == 0 {
            return
        }
        let needed = self.length + s_len + 1
        if not self._reserve(needed) {
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place(s, s_len)
        return
    }

    // Internal: copy `s_len` bytes of `s` into the (already reserved) buffer
    // and re-terminate. Shared by `append` and `try_append` so the two tiers
    // cannot drift.
    func _place(&var self, s: String, s_len: Int) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < s_len {
                buf[self.length + i] = s.byte_at(i)
                i = i + 1
            }
            self.length = self.length + s_len
            buf[self.length] = 0
        }
    }

    // Append the decimal rendering of an Int. Overload of `append` (design 55):
    // `sb.append(42)` and `sb.append("s")` share one name, resolved by argument
    // type. Reuses the interpolation -> String path (which formats the integer)
    // rather than re-implementing itoa here. (Replaces the old `append_int`.)
    public func append(&var self, value: Int) {
        self.append("{value}")
    }

    /// Appends one byte.
    ///
    /// Panics if the buffer must grow and the allocator refuses (design 123,
    /// infallible tier); `try_append_char` reports the failure instead.
    public func append_char(&var self, c: Int8) {
        // +1 for the byte, +1 for the null terminator.
        if not self._reserve(self.length + 2) {
            panic("StringBuilder.append_char: allocation failed")
        }
        self._place_char(c)
    }

    /// Appends one byte, reporting allocator exhaustion as `Err(AllocError)`.
    public func try_append_char(&var self, c: Int8) -> Result<Void, AllocError> {
        let needed = self.length + 2
        if not self._reserve(needed) {
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place_char(c)
        return
    }

    // Internal: place one byte into the (already reserved) buffer.
    func _place_char(&var self, c: Int8) unsafe {
        if let buf = self.buffer {
            buf[self.length] = c
            self.length = self.length + 1
            buf[self.length] = 0
        }
    }

    // Append the UTF-8 encoding of a Unicode scalar value, returning the number
    // of bytes appended (1..4), or None if `scalar` is not a valid Unicode scalar
    // — negative, a UTF-16 surrogate (0xD800..0xDFFF), or greater than 0x10FFFF —
    // in which case nothing is appended. The encoding inverse of
    // `String.chars()` (design 119, closing DF-116c): a scalar that `chars()`
    // yields always re-encodes to `Some`. Assembles the code units with
    // multiplication rather than bit shifts (Saw has no bitwise operators): the
    // shifts are *64 (6 bits), *4096 (12), *262144 (18).
    //
    // The `None` answers exactly one question — "is that a scalar value?" — and
    // never doubles as an out-of-memory report: appending goes through
    // `append_char`, so allocator exhaustion panics (design 123, infallible
    // tier) rather than colliding with the invalid-scalar answer.
    public func append_scalar(&var self, scalar: Int) -> Int? {
        if scalar < 0 || scalar > 1114111 {
            return None
        }
        if scalar >= 55296 && scalar <= 57343 {
            return None                 // UTF-16 surrogate: not a scalar value
        }
        if scalar < 128 {
            self.append_char(self._scalar_byte(scalar))
            return 1
        }
        if scalar < 2048 {
            self.append_char(self._scalar_byte(192 + scalar / 64))
            self.append_char(self._scalar_byte(128 + scalar % 64))
            return 2
        }
        if scalar < 65536 {
            self.append_char(self._scalar_byte(224 + scalar / 4096))
            self.append_char(self._scalar_byte(128 + (scalar / 64) % 64))
            self.append_char(self._scalar_byte(128 + scalar % 64))
            return 3
        }
        self.append_char(self._scalar_byte(240 + scalar / 262144))
        self.append_char(self._scalar_byte(128 + (scalar / 4096) % 64))
        self.append_char(self._scalar_byte(128 + (scalar / 64) % 64))
        self.append_char(self._scalar_byte(128 + scalar % 64))
        return 4
    }

    // A byte value 0..255 as the Int8 with the same bit pattern. A direct
    // `u as Int8` for `u >= 128` is out of Int8's signed range and would panic,
    // so the high half folds through the two's-complement wrap first.
    func _scalar_byte(&self, u: Int) -> Int8 {
        if u >= 128 { (u - 256) as Int8 } else { u as Int8 }
    }

    // Clear the buffer (keep capacity)
    public func clear(&var self) unsafe {
        self.length = 0
        if let buf = self.buffer {
            buf[0] = 0
        }
    }

    // Produce an owned, independently refcounted String from the bytes built so
    // far. `__saw_string_from_bytes` COPIES into a fresh refcount=1 block, so the
    // result never aliases the builder's buffer: the builder keeps its buffer
    // (and may keep appending), and the returned String is freed on its own
    // schedule (no leak, no double-free). Returning `buf as String` would instead
    // hand back a header-less pointer that corrupts on len()/release.
    //
    // Panics if the String allocation is refused (design 123): the String layer
    // is the infallible tier, and returning `""` here — which is what a NULL
    // from the allocator used to produce — is indistinguishable from a builder
    // that legitimately has nothing in it. The `""` below is the second case
    // and only the second case: a builder that was never appended to.
    public func build(&self) unsafe -> String {
        if let buf = self.buffer {
            __saw_string_from_bytes(buf, self.length)
        } else {
            ""
        }
    }

    // Backwards-compatible alias for `build()`.
    public func as_str(&self) -> String {
        self.build()
    }

    // Internal: the capacity a growth to `min_capacity` would allocate.
    func _grow_target(&self, min_capacity: Int) -> Int {
        var target = if self.capacity == 0 { 16 } else { self.capacity * 2 }
        while target < min_capacity {
            target = target * 2
        }
        target
    }

    // Internal: ensure `capacity >= min_capacity`. Returns whether the builder
    // now has that room — FALSE means the allocator refused and the builder is
    // untouched. The old `grow` returned Void, so `append`/`append_char` copied
    // into a buffer that had never grown and wrote past its end (RS-1's shape,
    // repeated here).
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)

        if let buf = self.buffer {
            // Grow via alloc + copy + dealloc (the seams provide no realloc).
            let old_capacity = self.capacity
            if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
                memcpy(new_buf, buf, old_capacity)
                GlobalAllocator().dealloc(buf, old_capacity, 1)
                self.buffer = new_buf
                self.capacity = new_capacity
                return true
            }
            return false
        }
        if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
            self.buffer = new_buf
            self.capacity = new_capacity
            new_buf[0] = 0  // Initialize with null terminator
            return true
        }
        false
    }
}

// StringBuilder is NoCopy
extension StringBuilder: NoCopy {
    public func deinit(&var self) unsafe {
        if let buf = self.buffer {
            GlobalAllocator().dealloc(buf, self.capacity, 1)
        }
    }
}
