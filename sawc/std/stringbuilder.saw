// StringBuilder - Mutable string buffer
// Part of the Saw standard library

// =============================================================================
// FFI declarations
// =============================================================================

// StringBuilder is an alloc-layer type: it allocates through the `GlobalAllocator`
// allocator (design 19 §4 / brief 28), which wraps the runtime seams — never
// libc directly. memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>

    // Refcounted String runtime (defined by the compiler).
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// StringBuilder - A mutable string buffer
// =============================================================================

static ASCII_ZERO: Int = 48
static MINUS_SIGN: Int8 = 45

// The truncation marker a FIXED builder stamps when content does not fit: `…`
// (U+2026), whose UTF-8 encoding is these three bytes. A cut message says so —
// a silently short one is a hidden error (design 137).
static MARKER_LEN: Int = 3
static MARKER_BYTE_0: Int = 226
static MARKER_BYTE_1: Int = 128
static MARKER_BYTE_2: Int = 166

// The smallest `capacity` a fixed builder accepts: the marker plus the NUL
// terminator plus one byte of text. Below this there is nothing to say.
static MIN_FIXED_CAPACITY: Int = 5

public struct StringBuilder {
    buffer: UnsafePointer<Int8>?
    length: Int
    capacity: Int
    // Fixed mode (design 137): the buffer is caller-provided storage that is
    // never grown and never freed. Overflow truncates and marks instead of
    // reallocating, which is what lets `panic`, `assert` and `print` assemble a
    // message with the allocator refusing everything.
    fixed: Bool
    truncated: Bool
}

// design 186: the buffer pointer blocks the derivation, and a `StringBuilder`
// owns those bytes outright — nobody else can reach them, since every mutation
// is a `&var self` method and the Law of Exclusivity gates those. So moving one
// between threads is sound, and sharing one hands out reads of storage no
// `&self` method writes. In FIXED mode the buffer is caller storage, which the
// caller's own borrow already pins.
extension StringBuilder: UnsafeSend {}
extension StringBuilder: UnsafeSync {}

extension StringBuilder {
    // Create an empty string builder
    public init() -> StringBuilder {
        StringBuilder(buffer: None, length: 0, capacity: 0, fixed: false,
                      truncated: false)
    }

    /// Creates an empty builder with room for `capacity` bytes, reporting
    /// allocator exhaustion as `Err(AllocError)`.
    public init(capacity: Int) unsafe -> Result<StringBuilder, AllocError> {
        if capacity <= 0 {
            return StringBuilder()
        }
        if let ptr = GlobalAllocator().alloc(capacity, 1) {
            return StringBuilder(buffer: ptr, length: 0, capacity: capacity,
                                 fixed: false, truncated: false)
        }
        return AllocError(size: capacity, align: 1)
    }

    /// Creates a builder over caller-provided storage that never allocates.
    ///
    /// `bytes` must address at least `capacity` writable bytes and must outlive
    /// the builder, which neither grows nor frees them. Content that does not
    /// fit is TRUNCATED rather than dropped silently: the text is cut on a
    /// UTF-8 boundary, the marker `…` is stamped in its place, and
    /// `is_truncated` answers yes from then on.
    ///
    /// This is the formatting path that survives an exhausted allocator, so it
    /// is what `panic`, `assert` and `print("{}", x)` assemble through. Writing
    /// a `format` body out of `append` calls — rather than out of `"{...}"`
    /// interpolation, which builds a heap String — is what makes a type
    /// printable on that path.
    ///
    /// The last four bytes of `capacity` are held back for the marker and the
    /// NUL terminator, so a builder with `capacity` bytes holds `capacity - 4`
    /// bytes of text. Panics if `capacity` is smaller than
    /// `MIN_FIXED_CAPACITY`, which leaves no room to say anything at all.
    public init(bytes: UnsafePointer<Int8>, capacity: Int) unsafe -> StringBuilder {
        if capacity < MIN_FIXED_CAPACITY {
            panic("StringBuilder(bytes:capacity:): capacity is too small to format into")
        }
        bytes[0] = 0
        StringBuilder(buffer: bytes, length: 0, capacity: capacity, fixed: true,
                      truncated: false)
    }

    /// Points a FIXED builder at `bytes`, keeping its length and truncation.
    ///
    /// For storage that MOVED with the value holding it. A fixed builder stores
    /// the address of its buffer, and a Saw move copies bytes, so a builder that
    /// travels alongside its own storage — `FixedStringBuilder<N>`, whose buffer
    /// is a field beside it — is left pointing at where the bytes used to be.
    /// Re-aiming it before each use costs one store and makes the whole
    /// arrangement move-safe.
    ///
    /// `bytes` must address the SAME content, at least `capacity` bytes of it.
    /// This does not clear the buffer and does not re-check capacity; pointing a
    /// builder at unrelated storage keeps a length that describes neither.
    /// Growable builders own their buffer and have nothing to re-aim, so this
    /// does nothing to one.
    public func rebind(&var self, bytes: UnsafePointer<Int8>) unsafe {
        if self.fixed {
            self.buffer = bytes
        }
    }

    /// Whether content has been cut to fit this builder's fixed storage.
    ///
    /// Always `false` for a growable builder. Once true it stays true, and the
    /// built text ends in `…`.
    public func is_truncated(&self) -> Bool {
        self.truncated
    }

    // Get current length
    public func len(&self) -> Int {
        self.length
    }

    // Check if empty
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// Appends the bytes of `s`.
    ///
    /// Length comes from the O(1) header, not a strlen scan, so interior NUL
    /// bytes are preserved and no libc call is made. Reports allocator
    /// exhaustion as `Err(AllocError)`; the builder is unchanged then — no
    /// partial append. (The refused grow used to leave `capacity` short and the
    /// copy below then wrote past the end of the buffer.)
    public func append(&var self, s: String) -> Result<Void, AllocError> {
        let s_len = s.len()
        if s_len == 0 {
            return
        }
        let needed = self.length + s_len + 1
        if not self._reserve(needed) {
            // Fixed storage refuses nothing — there is no allocator to fail, so
            // an `AllocError` here would name a failure that did not happen.
            // The overflow is reported by the `…` marker and `is_truncated`.
            if self.fixed {
                self._overflow(s, s_len)
                return
            }
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place(s, s_len)
        return
    }

    // Internal: copy `s_len` bytes of `s` into the (already reserved) buffer
    // and re-terminate. Split out from `append` so the placement rule lives in
    // one place; it used to be shared with the retired `try_append` twin.
    func _place(&var self, s: String, s_len: Int) unsafe {
        if let buf = self.buffer {
            var i = 0
            while i < s_len {
                buf[self.length + i] = s.byte_at(i)
                i = i + 1
            }
            self.length = self.length + s_len
            buf[self.length] = 0
        }
    }

    /// Appends the decimal rendering of `value`.
    ///
    /// Overload of `append` (design 55): `sb.append(42)` and `sb.append("s")`
    /// share one name, resolved by argument type.
    ///
    /// Allocation-free (design 137). It used to route through `"{value}"`,
    /// which builds a heap String only to copy it straight back out — a hidden
    /// allocation in the middle of the one formatting path that has to survive
    /// allocator exhaustion. The digits are emitted most-significant-first by
    /// repeated division instead, so nothing is staged anywhere.
    public func append(&var self, value: Int) -> Result<Void, AllocError> {
        if value < 0 {
            let _ = try self.append_char(MINUS_SIGN)
        }
        // The magnitude is carried on the NEGATIVE side: `0 - Int.min` overflows
        // but `Int.min` itself is representable, so every Int works here. `/`
        // and `%` truncate toward zero, which makes each `%` result the negated
        // digit.
        let n = if value < 0 { value } else { 0 - value }
        var scale = 1
        var probe = n
        while probe <= -10 {
            probe = probe / 10
            scale = scale * 10
        }
        while scale > 0 {
            let digit = 0 - ((n / scale) % 10)
            let _ = try self.append_char(self._scalar_byte(ASCII_ZERO + digit))
            scale = scale / 10
        }
        return
    }

    /// Appends the decimal rendering of `value`.
    ///
    /// The unsigned twin of `append(value: Int)`, and equally allocation-free.
    /// It exists so an unsigned field renders across its whole range: the signed
    /// overload cannot represent anything above `Int.max`.
    public func append(&var self, value: UInt) -> Result<Void, AllocError> {
        var scale: UInt = 1
        var probe = value
        while probe >= 10 {
            probe = probe / 10
            scale = scale * 10
        }
        while scale > 0 {
            let digit = (value / scale) % 10
            let _ = try self.append_char(self._scalar_byte(ASCII_ZERO + (digit as Int)))
            scale = scale / 10
        }
        return
    }

    /// Appends one byte, reporting allocator exhaustion as `Err(AllocError)`.
    public func append_char(&var self, c: Int8) -> Result<Void, AllocError> {
        let needed = self.length + 2
        if not self._reserve(needed) {
            if self.fixed {
                self._mark_truncated()
                return
            }
            return AllocError(size: self._grow_target(needed), align: 1)
        }
        self._place_char(c)
        return
    }

    // Internal (fixed mode): `s` does not fit, so copy the prefix that does and
    // stamp the truncation marker after it.
    //
    // `_reserve` holds MARKER_LEN bytes back from every fit test, so `length`
    // never passes `capacity - 1 - MARKER_LEN` and the marker always has its
    // room waiting — no overwriting of text already placed, and no re-scan of
    // it for a UTF-8 boundary. The cut point in `s` IS scanned back to one: a
    // message ending in half a scalar is not a message.
    func _overflow(&var self, s: String, s_len: Int) unsafe {
        if self.truncated {
            return                          // already cut; the buffer is full
        }
        if let buf = self.buffer {
            // Reachable only when the content overruns, so this is < s_len.
            var n = self.capacity - 1 - MARKER_LEN - self.length
            if n > s_len {
                n = s_len
            }
            while n > 0 && self._is_continuation(s.byte_at(n)) {
                n = n - 1
            }
            var i = 0
            while i < n {
                buf[self.length + i] = s.byte_at(i)
                i = i + 1
            }
            self.length = self.length + n
        }
        self._mark_truncated()
    }

    // Internal (fixed mode): stamp `…` at the current end and seal the builder.
    // Idempotent — once marked, `length` sits at the buffer's text limit, so
    // every later append re-enters here and returns.
    func _mark_truncated(&var self) unsafe {
        if self.truncated {
            return
        }
        self.truncated = true
        if let buf = self.buffer {
            buf[self.length] = self._scalar_byte(MARKER_BYTE_0)
            buf[self.length + 1] = self._scalar_byte(MARKER_BYTE_1)
            buf[self.length + 2] = self._scalar_byte(MARKER_BYTE_2)
            self.length = self.length + MARKER_LEN
            buf[self.length] = 0
        }
    }

    // Internal: whether `b` is a UTF-8 continuation byte (0b10xxxxxx). Read as
    // an unsigned byte value, since Int8 is signed and every continuation byte
    // has its high bit set.
    func _is_continuation(&self, b: Int8) -> Bool {
        let u = if b < 0 { (b as Int) + 256 } else { b as Int }
        u >= 128 && u < 192
    }

    // Internal: place one byte into the (already reserved) buffer.
    func _place_char(&var self, c: Int8) unsafe {
        if let buf = self.buffer {
            buf[self.length] = c
            self.length = self.length + 1
            buf[self.length] = 0
        }
    }

    // Append the UTF-8 encoding of a Unicode scalar value, returning the number
    // of bytes appended (1..4), or None if `scalar` is not a valid Unicode scalar
    // — negative, a UTF-16 surrogate (0xD800..0xDFFF), or greater than 0x10FFFF —
    // in which case nothing is appended. The encoding inverse of
    // `String.chars()` (design 119, closing DF-116c): a scalar that `chars()`
    // yields always re-encodes to `Some`. Assembles the code units with
    // multiplication rather than bit shifts (Saw has no bitwise operators): the
    // shifts are *64 (6 bits), *4096 (12), *262144 (18).
    //
    // The `None` answers exactly one question — "is that a scalar value?" — and
    // never doubles as an out-of-memory report: the two answers ride separate
    // channels, `Ok(None)` for "not a scalar" and `Err(AllocError)` for the
    // allocator (design 234 §1, the same peeling `try_receive` uses). Design 123
    // kept them apart by panicking on the second, which cost the caller the
    // report entirely.
    public func append_scalar(&var self, scalar: Int) -> Result<Int?, AllocError> {
        if scalar < 0 || scalar > 1114111 {
            return None
        }
        if scalar >= 55296 && scalar <= 57343 {
            return None                 // UTF-16 surrogate: not a scalar value
        }
        if scalar < 128 {
            let _ = try self.append_char(self._scalar_byte(scalar))
            return 1
        }
        if scalar < 2048 {
            let _ = try self.append_char(self._scalar_byte(192 + scalar / 64))
            let _ = try self.append_char(self._scalar_byte(128 + scalar % 64))
            return 2
        }
        if scalar < 65536 {
            let _ = try self.append_char(self._scalar_byte(224 + scalar / 4096))
            let _ = try self.append_char(self._scalar_byte(128 + (scalar / 64) % 64))
            let _ = try self.append_char(self._scalar_byte(128 + scalar % 64))
            return 3
        }
        let _ = try self.append_char(self._scalar_byte(240 + scalar / 262144))
        let _ = try self.append_char(self._scalar_byte(128 + (scalar / 4096) % 64))
        let _ = try self.append_char(self._scalar_byte(128 + (scalar / 64) % 64))
        let _ = try self.append_char(self._scalar_byte(128 + scalar % 64))
        return 4
    }

    // A byte value 0..255 as the Int8 with the same bit pattern. `u >= 128` is
    // outside Int8's signed range, so a checked `as` would panic on every
    // continuation byte; keeping the low 8 bits is the operation, and design
    // 170 gave it a name. This used to hand-fold the high half through
    // `(u - 256) as Int8`, which computed the same thing less legibly.
    func _scalar_byte(&self, u: Int) -> Int8 {
        Int8.from(truncating: u)
    }

    // Clear the buffer (keep capacity). A fixed builder is un-truncated by
    // this: the storage is empty again, so the old cut no longer describes it.
    public func clear(&var self) unsafe {
        self.length = 0
        self.truncated = false
        if let buf = self.buffer {
            buf[0] = 0
        }
    }

    // Produce an owned, independently refcounted String from the bytes built so
    // far. `__saw_string_from_bytes` COPIES into a fresh refcount=1 block, so the
    // result never aliases the builder's buffer: the builder keeps its buffer
    // (and may keep appending), and the returned String is freed on its own
    // schedule (no leak, no double-free). Returning `buf as String` would instead
    // hand back a header-less pointer that corrupts on len()/release.
    //
    // Panics if the String allocation is refused (design 123): the String layer
    // is the infallible tier, and returning `""` here — which is what a NULL
    // from the allocator used to produce — is indistinguishable from a builder
    // that legitimately has nothing in it. The `""` below is the second case
    // and only the second case: a builder that was never appended to.
    public func build(&self) unsafe -> String {
        if let buf = self.buffer {
            __saw_string_from_bytes(buf, self.length)
        } else {
            ""
        }
    }

    // Backwards-compatible alias for `build()`.
    public func as_str(&self) -> String {
        self.build()
    }

    // Internal: the capacity a growth to `min_capacity` would allocate.
    func _grow_target(&self, min_capacity: Int) -> Int {
        var target = if self.capacity == 0 { 16 } else { self.capacity * 2 }
        while target < min_capacity {
            target = target * 2
        }
        target
    }

    // Internal: ensure `capacity >= min_capacity`. Returns whether the builder
    // now has that room — FALSE means the allocator refused and the builder is
    // untouched. The old `grow` returned Void, so `append`/`append_char` copied
    // into a buffer that had never grown and wrote past its end (RS-1's shape,
    // repeated here).
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        if self.fixed {
            // Fixed storage never grows, and the last MARKER_LEN bytes are held
            // back so an overflow always has room to say that it overflowed.
            return min_capacity <= self.capacity - MARKER_LEN
        }
        if self.capacity >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)

        if let buf = self.buffer {
            // Grow via alloc + copy + dealloc (the seams provide no realloc).
            let old_capacity = self.capacity
            if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
                memcpy(new_buf, buf, old_capacity)
                GlobalAllocator().dealloc(buf, old_capacity, 1)
                self.buffer = new_buf
                self.capacity = new_capacity
                return true
            }
            return false
        }
        if let new_buf = GlobalAllocator().alloc(new_capacity, 1) {
            self.buffer = new_buf
            self.capacity = new_capacity
            new_buf[0] = 0  // Initialize with null terminator
            return true
        }
        false
    }
}

// StringBuilder is NoCopy
extension StringBuilder: NoCopy {
    public func deinit(&var self) unsafe {
        // Fixed storage is borrowed, not owned: the caller's buffer outlives
        // the builder and freeing it here would be a free of memory this type
        // never allocated.
        if self.fixed {
            return
        }
        if let buf = self.buffer {
            GlobalAllocator().dealloc(buf, self.capacity, 1)
        }
    }
}
