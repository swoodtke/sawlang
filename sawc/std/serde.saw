//! The serialization vocabulary: `Serialize`, `Deserialize`, and the
//! `Encoder`/`Decoder` seam they travel over.
//!
//! The pair is format-agnostic. A value writes itself into an `any Encoder` and
//! reads itself back out of an `any Decoder`; the concrete format decides what
//! the bytes are. `std.cbor` is the format in the tree.
//!
//! Both traits derive structurally under `@synthesize`, the marker the
//! Equatable/Comparable/Hashable family already uses. A derived struct is
//! written as one array of its stored fields in declaration order, so the shape
//! is exact and there are no field names on the wire.
//!
//! These names are prelude-visible: nothing here needs an import, and the
//! freestanding profile keeps all of it, so a kernel can serialize into its own
//! buffer.

// =============================================================================
// Faults
// =============================================================================

// What stopped a value from being written out.
enum EncodeFault: UInt8 {
    case BufferFull = 1,
    case TooDeep = 2,
    case CountMismatch = 3,
    case Unsupported = 4
}

extension EncodeFault {
    /// A one-line description of the fault. Allocates nothing.
    public func describe(&self) -> String {
        match self {
            case BufferFull -> "the output buffer is full",
            case TooDeep -> "nesting is deeper than the encoder allows",
            case CountMismatch -> "an array or map got a different number of items than it declared",
            case Unsupported -> "the value has no representation in this format"
        }
    }
}

/// A failure raised while encoding.
struct EncodeError {
    public fault: EncodeFault
}

extension EncodeError: Printable {
    func format(&self, into: &var StringBuilder) {
        into.append("encode error: ")
        into.append(self.fault.describe())
    }
}

extension EncodeError: Error {}

// What stopped a value from being read back.
enum DecodeFault: UInt8 {
    case Truncated = 1,
    case Malformed = 2,
    case TypeMismatch = 3,
    case TooDeep = 4,
    case TooLarge = 5,
    case TooManyItems = 6,
    case NotCanonical = 7,
    case Unsupported = 8,
    case TrailingBytes = 9,
    case OutOfRange = 10,
    case UnknownCase = 11,
    case CountMismatch = 12
}

extension DecodeFault {
    /// A one-line description of the fault. Allocates nothing.
    public func describe(&self) -> String {
        match self {
            case Truncated -> "the input ended in the middle of an item",
            case Malformed -> "the bytes are not a well-formed item",
            case TypeMismatch -> "the item is not of the expected type",
            case TooDeep -> "nesting is deeper than the decoder allows",
            case TooLarge -> "the input is larger than the decoder allows",
            case TooManyItems -> "the input holds more items than the decoder allows",
            case NotCanonical -> "the item is not in the deterministic encoding",
            case Unsupported -> "the item has no representation in this language",
            case TrailingBytes -> "bytes remain after the top-level item",
            case OutOfRange -> "the value does not fit the destination type",
            case UnknownCase -> "no case of the enum carries that raw value",
            case CountMismatch -> "the array or map holds a different number of items than expected"
        }
    }
}

/// A failure raised while decoding, at the byte it was found.
///
/// `offset` counts bytes from the start of the input, so a rejected blob can be
/// examined at the position that stopped it. Malformed input always arrives
/// here; a decoder never panics on it.
struct DecodeError {
    public offset: Int
    public fault: DecodeFault
}

extension DecodeError: Printable {
    func format(&self, into: &var StringBuilder) {
        into.append("decode error at byte ")
        into.append(self.offset)
        into.append(": ")
        into.append(self.fault.describe())
    }
}

extension DecodeError: Error {}

// =============================================================================
// The seam
// =============================================================================

/// The sink a `Serialize` value writes itself into.
///
/// The methods name a data model, not a byte layout: the implementation decides
/// what the bytes are. An array or map is opened with its item count and then
/// followed by exactly that many items; a byte string is opened with
/// `begin_bytes` and followed by exactly that many `write_byte` calls.
/// Miscounting is `CountMismatch`, never a silently short item.
trait Encoder {
    /// Writes an unsigned integer.
    func write_uint(&var self, v: UInt) -> Result<Void, EncodeError>

    /// Writes a signed integer.
    func write_int(&var self, v: Int) -> Result<Void, EncodeError>

    /// Writes a boolean.
    func write_bool(&var self, v: Bool) -> Result<Void, EncodeError>

    /// Writes the null item, which is what an absent Optional becomes.
    func write_null(&var self) -> Result<Void, EncodeError>

    /// Writes a UTF-8 text string.
    func write_text(&var self, v: String) -> Result<Void, EncodeError>

    /// Opens a byte string of exactly `count` bytes.
    func begin_bytes(&var self, count: Int) -> Result<Void, EncodeError>

    /// Writes one byte of an open byte string.
    func write_byte(&var self, b: UInt8) -> Result<Void, EncodeError>

    /// Opens an array of exactly `count` items.
    func begin_array(&var self, count: Int) -> Result<Void, EncodeError>

    /// Opens a map of exactly `count` key/value pairs.
    func begin_map(&var self, count: Int) -> Result<Void, EncodeError>
}

/// The source a `Deserialize` value reads itself out of.
///
/// Every method reports malformed input as `Err(DecodeError)` carrying the byte
/// offset it stopped at, so a decoder may be pointed at bytes from anywhere.
trait Decoder {
    /// Reads an unsigned integer.
    func read_uint(&var self) -> Result<UInt, DecodeError>

    /// Reads a signed integer.
    func read_int(&var self) -> Result<Int, DecodeError>

    /// Reads a boolean.
    func read_bool(&var self) -> Result<Bool, DecodeError>

    /// Reads the null item.
    func read_null(&var self) -> Result<Void, DecodeError>

    /// Reads a UTF-8 text string.
    func read_text(&var self) -> Result<String, DecodeError>

    /// Opens a byte string, returning how many bytes follow.
    func begin_bytes(&var self) -> Result<Int, DecodeError>

    /// Reads one byte of an open byte string.
    func read_byte(&var self) -> Result<UInt8, DecodeError>

    /// Opens an array, returning how many items follow.
    func begin_array(&var self) -> Result<Int, DecodeError>

    /// Opens a map, returning how many key/value pairs follow.
    func begin_map(&var self) -> Result<Int, DecodeError>

    /// Whether the next item is null, consuming nothing.
    func at_null(&var self) -> Result<Bool, DecodeError>

    /// The byte offset reached so far.
    func offset(&self) -> Int

    /// Consumes the next item whatever it is, including its contents.
    func skip(&var self) -> Result<Void, DecodeError>

    /// Opens an array and checks it holds exactly `count` items.
    ///
    /// What a derived conformance reads: a struct is written as an array of
    /// known length, so a different length fails before any field is read.
    func expect_array(&var self, count: Int) -> Result<Void, DecodeError> {
        let n = try self.begin_array()
        if n != count {
            return DecodeError(offset: self.offset(), fault: DecodeFault.CountMismatch)
        }
        return
    }

    /// Reads a signed integer and checks it lies between `min` and `max`.
    ///
    /// How a value narrower than `Int` is read back. A narrowing cast would
    /// panic on an out-of-range value and malformed input must never panic, so
    /// the range is checked here and the cast that follows cannot trap.
    func read_int_range(&var self, min: Int, max: Int) -> Result<Int, DecodeError> {
        let v = try self.read_int()
        if v < min || v > max {
            return DecodeError(offset: self.offset(), fault: DecodeFault.OutOfRange)
        }
        return v
    }

    /// Reads an unsigned integer and checks it does not exceed `max`.
    ///
    /// The unsigned twin of `read_int_range`, and what a raw-backed enum's tag
    /// is read through.
    func read_uint_max(&var self, max: UInt) -> Result<UInt, DecodeError> {
        let v = try self.read_uint()
        if v > max {
            return DecodeError(offset: self.offset(), fault: DecodeFault.OutOfRange)
        }
        return v
    }
}

// =============================================================================
// The pair
// =============================================================================

/// A value that can write itself into any `Encoder`.
///
/// Derive it with `@synthesize extension T: Serialize {}`, which writes every
/// stored field in declaration order as one array. Write the body by hand when
/// the type carries an invariant the field walk would not preserve.
///
/// ```saw
/// @synthesize
/// extension Endpoint: Serialize {}
/// ```
trait Serialize {
    /// Writes `self` into `to`.
    func serialize(&self, to: &var any Encoder) -> Result<Void, EncodeError>
}

/// A value that can read itself back out of any `Decoder`.
///
/// The inverse of `Serialize`, derived by the same marker. `deserialize` is
/// static, so it is called on the type rather than on a value:
///
/// ```saw
/// let back = try Endpoint.deserialize(from: &var decoder)
/// ```
///
/// Returning `Self` by value keeps `Deserialize` out of `any` — it is a generic
/// bound, never an existential, the same rule the Copy family lives under.
trait Deserialize {
    /// Reads a value of this type out of `from`.
    func deserialize(from: &var any Decoder) -> Result<Self, DecodeError>
}
