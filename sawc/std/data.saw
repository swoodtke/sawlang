// Data - Raw byte buffer type with reference-counted storage
// Part of the Saw standard library
//
// =============================================================================
// TODO: Known Issues to Investigate
// =============================================================================
//
// 1. memcpy causes segfaults when used in copy()
//    - Using memcpy to copy bytes from one Data to another causes crashes
//    - Workaround: copy() uses manual byte-by-byte loop instead
//    - Need to investigate: pointer arithmetic issues? Type casting issues?
//    - The memcpy in append() may have the same issue (untested)
//
// 2. make_unique() copy-on-write causes segfaults
//    - When set() detects shared buffer (refcount > 1), calling make_unique()
//      to copy before modifying causes crashes
//    - Likely issue: ownership transfer when assigning old_data.inner to self.inner
//      while old_data is still in scope and will have deinit called
//    - Workaround: set() now directly modifies shared buffer (no COW)
//    - Users must call copy() explicitly before modifying if they need isolation
//
// 3. DataIterator doesn't hold a reference
//    - Iterator copies the inner pointer but doesn't increment refcount
//    - This means iterators can become invalid if source Data is deallocated
//    - For safety, should increment refcount in iter() and decrement in deinit
//
// =============================================================================

// =============================================================================
// FFI declarations for memory management
// =============================================================================

// Data is an alloc-layer type: it allocates through the `GlobalAllocator` allocator
// (design 19 §4 / brief 28), which wraps the runtime seams — never libc
// directly. memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// DataBuffer - Internal refcounted buffer storage
// =============================================================================

struct DataBuffer {
    buffer: UnsafePointer<UInt8>
    capacity: Int
    refcount: Int
}

// =============================================================================
// Data - A dynamically-sized byte buffer with slice support
// =============================================================================
//
// Data uses a reference-counted internal buffer, allowing efficient slicing
// without copying. The buffer is freed when the last Data referencing it
// is deinitialized.

struct Data {
    inner: UnsafePointer<DataBuffer>?
    offset: Int   // Start offset within buffer (for slices)
    length: Int   // Length of this view
}

extension Data {
    // =========================================================================
    // Constructors
    // =========================================================================

    // Create an empty Data buffer
    public init() -> Data {
        Data(inner: None, offset: 0, length: 0)
    }

    /// Creates an empty buffer with room for `capacity` bytes.
    ///
    /// Panics if the allocator refuses the request (design 123, infallible
    /// tier); it used to hand back a capacity-0 buffer, so a caller that asked
    /// to reserve and got nothing carried on as if it had succeeded.
    /// `try_with_capacity` reports the failure instead.
    public init(capacity: Int) -> Data {
        var data = Data(inner: None, offset: 0, length: 0)
        if not data._reserve(capacity) {
            panic("Data(capacity:): allocation failed")
        }
        move data
    }

    /// Creates an empty buffer with room for `n` bytes, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    public func try_with_capacity(n: Int) -> Result<Data, AllocError> {
        var data = Data(inner: None, offset: 0, length: 0)
        if not data._reserve(n) {
            return AllocError(size: data._grow_target(n), align: 1)
        }
        return move data
    }

    // =========================================================================
    // Basic Properties
    // =========================================================================

    // Get the number of bytes
    public func len(&self) -> Int {
        self.length
    }

    // Check if the buffer is empty
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    // Get the capacity of the underlying buffer
    public func capacity(&self) unsafe -> Int {
        if let inner = self.inner {
            inner[0].capacity
        } else {
            0
        }
    }

    // =========================================================================
    // Element Access
    // =========================================================================

    /// The byte at `index`, as a PLACE (design 141).
    ///
    /// `d[i] = 0` writes the byte where it sits, and `print(d[i])` reads it
    /// there. Panics if `index` is outside `0..<len()`, on the same terms as
    /// `set`.
    ///
    /// If the buffer is SHARED, a write through the window reaches every holder
    /// — call `copy()` first for copy-on-write semantics, exactly as with `set`.
    public func [](&self, index: Int) unsafe borrows -> UInt8 {
        if index < 0 || index >= self.length {
            panic("Data.[]: index out of range")
        }
        guard let inner = self.inner else {
            panic("Data.[]: buffer is empty")
        }
        let buf = inner[0].buffer
        lend buf[self.offset + index]
    }

    // Get byte at index (returns None if out of bounds)
    public func get(&self, index: Int) unsafe -> UInt8? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let inner = self.inner else {
            return None
        }
        let buf = inner[0].buffer
        buf[self.offset + index]
    }

    /// Writes `value` at `index`.
    ///
    /// Panics if `index` is outside `0..<len()`.
    ///
    /// If the buffer is SHARED this writes through to every holder — call
    /// `copy()` first for copy-on-write semantics.
    ///
    /// This returned `Bool` and wrote nothing out of range. Design 130's
    /// accessor rule made it panic instead, matching `Vector.set`: nothing in
    /// the tree ever read the flag, so a bad index silently did nothing — the
    /// ignorable-sentinel shape design 92 rules out.
    public func set(&var self, index: Int, value: UInt8) unsafe {
        if index < 0 || index >= self.length {
            panic("Data.set: index out of range")
        }
        guard let inner = self.inner else {
            panic("Data.set: buffer is empty")
        }
        let buf = inner[0].buffer
        buf[self.offset + index] = value
    }

    // =========================================================================
    // Modification Operations
    // =========================================================================

    /// Appends one byte.
    ///
    /// Panics if the buffer must grow and the allocator refuses (design 123,
    /// infallible tier). The refused grow used to leave `capacity` short and
    /// this write then landed past the end of the buffer, with `length`
    /// advancing past `capacity` — RS-1's shape. `try_push` reports the failure.
    public func push(&var self, value: UInt8) {
        if not self._reserve_unique(self.length + 1) {
            panic("Data.push: allocation failed")
        }
        self._place(value)
    }

    /// Appends one byte, reporting allocator exhaustion as `Err(AllocError)`.
    ///
    /// The buffer is unchanged on `Err`.
    public func try_push(&var self, value: UInt8) -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self._reserve_unique(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._place(value)
        return
    }

    // Internal: store one byte into the (already reserved) buffer.
    func _place(&var self, value: UInt8) unsafe {
        if let inner = self.inner {
            let buf = inner[0].buffer
            buf[self.offset + self.length] = value
            self.length = self.length + 1
        }
    }

    /// Reserves room for `additional` more bytes, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    ///
    /// On `Ok` the next `additional` pushes cannot allocate, so they cannot
    /// fail.
    public func try_reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        let wanted = self.length + additional
        if not self._reserve_unique(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        return
    }

    // Remove and return the last byte (returns None if empty)
    public func pop(&var self) unsafe -> UInt8? {
        if self.length == 0 {
            return None
        }
        guard let inner = self.inner else {
            return None
        }
        let buf = inner[0].buffer
        let value = buf[self.offset + self.length - 1]
        self.length = self.length - 1
        value
    }

    // Clear all bytes (keeps capacity)
    public func clear(&var self) {
        self.length = 0
    }

    /// Appends every byte of `other`.
    ///
    /// Panics if the buffer must grow and the allocator refuses (design 123,
    /// infallible tier); the refused grow used to leave the memcpy below running
    /// past the end of the buffer. `try_append` reports the failure.
    // TODO: This uses memcpy which may have the same issues as copy() - needs testing
    public func append(&var self, other: Data) {
        if other.length == 0 {
            return
        }
        if not self._reserve_unique(self.length + other.length) {
            panic("Data.append: allocation failed")
        }
        self._place_data(&other)
    }

    /// Appends every byte of `other`, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    ///
    /// This buffer is unchanged on `Err` — no partial append. `other` is
    /// consumed either way; reserve first with `try_reserve` when it has to
    /// survive a refusal.
    public func try_append(&var self, other: Data) -> Result<Void, AllocError> {
        if other.length == 0 {
            return
        }
        let wanted = self.length + other.length
        if not self._reserve_unique(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._place_data(&other)
        return
    }

    // Internal: copy `other`'s live bytes into the (already reserved) buffer.
    func _place_data(&var self, other: &Data) unsafe {
        if let self_inner = self.inner {
            if let other_inner = other.inner {
                let dest = self_inner[0].buffer as UnsafePointer<Int8>
                let src = other_inner[0].buffer as UnsafePointer<Int8>
                let dest_offset = dest + self.offset + self.length
                let src_offset = src + other.offset
                memcpy(dest_offset, src_offset, other.length)
                self.length = self.length + other.length
            }
        }
    }

    // Append `len` raw bytes from `src` to the end (grows as needed). The
    // pointer-typed signature is the design-81 visible marker: callers in the
    // marked domain (std.net's socket read path) fill a Data from a stack buffer
    // with no per-byte overhead. `src`/`len` must describe `len` valid bytes.
    // Panics if the buffer must grow and the allocator refuses (design 123,
    // infallible tier); `try_append_bytes` reports the failure.
    public func append_bytes(&var self, src: UnsafePointer<Int8>, len: Int) unsafe {
        if len <= 0 {
            return
        }
        if not self._reserve_unique(self.length + len) {
            panic("Data.append_bytes: allocation failed")
        }
        self._place_bytes(src, len)
    }

    // The fallible twin of `append_bytes` (design 123). The buffer is unchanged
    // on `Err`.
    public func try_append_bytes(&var self, src: UnsafePointer<Int8>, len: Int) unsafe -> Result<Void, AllocError> {
        if len <= 0 {
            return
        }
        let wanted = self.length + len
        if not self._reserve_unique(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._place_bytes(src, len)
        return
    }

    // Internal: copy `len` bytes from `src` into the (already reserved) buffer.
    func _place_bytes(&var self, src: UnsafePointer<Int8>, len: Int) unsafe {
        if let inner = self.inner {
            let dest = inner[0].buffer as UnsafePointer<Int8>
            memcpy(dest + self.offset + self.length, src, len)
            self.length = self.length + len
        }
    }

    // A pointer to this Data's first live byte (offset applied). The pointer-typed
    // signature is the design-81 visible marker; std.net's write path uses it to
    // stream bytes to a socket without copying. Empty Data yields a null pointer.
    public func byte_ptr(&self) unsafe -> UnsafePointer<Int8> {
        if let inner = self.inner {
            (inner[0].buffer as UnsafePointer<Int8>) + self.offset
        } else {
            0 as UnsafePointer<Int8>
        }
    }

    // =========================================================================
    // Slicing
    // =========================================================================

    // Create a slice of this Data (shares underlying buffer)
    // Returns None if bounds are invalid
    public func slice(&var self, start: Int, end: Int) unsafe -> Data? {
        if start < 0 || end < start || end > self.length {
            return None
        }

        // Handle empty data case
        if self.length == 0 {
            if start == 0 && end == 0 {
                return Data()
            }
            return None
        }

        guard let inner = self.inner else {
            return None
        }

        // Increment refcount
        inner[0].refcount = inner[0].refcount + 1

        Data(inner: self.inner, offset: self.offset + start, length: end - start)
    }

    // Create an independent copy of this Data
    // TODO: Using manual byte-by-byte copy because memcpy version causes segfaults
    // Original memcpy-based implementation:
    //   let dest = new_inner[0].buffer as UnsafePointer<Int8>
    //   let src = self_inner[0].buffer as UnsafePointer<Int8>
    //   memcpy(dest, src + self.offset, self.length)
    /// Duplicates the bytes into an independent buffer.
    ///
    /// Panics if the allocator refuses (design 123, infallible tier). It used
    /// to set `length` regardless of whether the reservation succeeded, so a
    /// refused copy reported `len() == N` with `capacity() == 0` and every
    /// `get` answering `None`. `try_copy` reports the failure instead.
    public func copy(&self) -> Data {
        if self.length == 0 {
            return Data()
        }

        // Allocate new buffer
        var new_data = Data()
        if not new_data._reserve(self.length) {
            panic("Data.copy: allocation failed")
        }
        new_data.length = self.length
        new_data._fill_from(&self)
        move new_data
    }

    /// Duplicates the bytes into an independent buffer, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    public func try_copy(&self) -> Result<Data, AllocError> {
        if self.length == 0 {
            return Data()
        }
        var new_data = Data()
        if not new_data._reserve(self.length) {
            return AllocError(size: new_data._grow_target(self.length), align: 1)
        }
        new_data.length = self.length
        new_data._fill_from(&self)
        return move new_data
    }

    // Internal: copy `source`'s live bytes into this (already reserved, already
    // length-set) buffer.
    // Uses a manual byte loop because the memcpy version segfaults — see the
    // TODO at the top of the file.
    func _fill_from(&var self, source: &Data) {
        var i = 0
        while i < self.length {
            if let b = source.get(i) {
                self.set(i, b)
            }
            i = i + 1
        }
    }

    // =========================================================================
    // Iteration
    // =========================================================================

    // Create an iterator over the bytes
    // TODO: Iterator doesn't increment refcount, so it can become invalid if
    // source Data is deallocated. Should add refcount management to be safe.
    public func iter(&self) unsafe -> DataIterator {
        DataIterator(inner: self.inner, offset: self.offset, length: self.length, index: 0)
    }

    // =========================================================================
    // Conversion
    // =========================================================================

    // Decode these bytes as UTF-8 into a String.
    //
    // Ok(s)  = the whole buffer is valid UTF-8.
    // Err(e) = it is not; `e.offset` is the byte index where the first
    //          malformed sequence begins (`String.fromBytes` semantics).
    //
    // A `String`'s contents are ALWAYS valid UTF-8 — literals are source-encoded
    // and `String.fromBytes` validates — and the language's own iterators rely on
    // that invariant. This used to byte-copy into a StringBuilder with no
    // validation, minting Strings that broke it: `Data` of `[0x68, 0xC8, 0x69]`
    // produced a `len() == 3` String whose `chars()` yielded ONE scalar and then
    // stopped, i.e. std silently truncated the caller's data (design 122 unit B).
    // Decoding is fallible, so it says so — through the same `Utf8Error` surface
    // `String` decoding already uses.
    public func to_string(&self) -> Result<String, Utf8Error> {
        String.fromBytes(&self)
    }

    // =========================================================================
    // Internal Helper Methods
    // =========================================================================

    // Internal: the capacity a growth to `min_capacity` would allocate.
    func _grow_target(&self, min_capacity: Int) -> Int {
        let current_cap = self.capacity()
        var target = if current_cap == 0 { 16 } else { current_cap }
        while target < min_capacity {
            target = target * 2
        }
        target
    }

    // Internal: ensure `capacity() >= min_capacity`. Returns whether the buffer
    // now has that room — FALSE means the allocator refused and the Data is
    // untouched. The old `ensure_capacity` returned Void, so `push`/`append`/
    // `append_bytes` wrote past a buffer that had never grown (RS-1's shape).
    func _reserve(&var self, min_capacity: Int) unsafe -> Bool {
        let current_cap = self.capacity()
        if current_cap >= min_capacity {
            return true
        }
        let new_capacity = self._grow_target(min_capacity)

        if let inner = self.inner {
            // Grow via alloc + copy + dealloc (the seams provide no realloc).
            let raw = inner[0].buffer as UnsafePointer<Int8>
            if let new_raw = GlobalAllocator().alloc(new_capacity, 1) {
                memcpy(new_raw, raw, current_cap)
                GlobalAllocator().dealloc(raw, current_cap, 1)
                inner[0].buffer = new_raw as UnsafePointer<UInt8>
                inner[0].capacity = new_capacity
                return true
            }
            return false
        }
        // Allocate new buffer and DataBuffer
        self._allocate_buffer(new_capacity)
    }

    // Ensure we have exclusive ownership (copy if shared)
    // TODO: This method causes segfaults and is currently unused
    // The issue is likely with ownership transfer: when we assign old_data.inner
    // to self.inner, old_data still exists and its deinit will be called at scope
    // end, causing double-free or use-after-free issues despite refcount manipulation.
    // Need to investigate proper ownership transfer patterns in Saw.
    func _make_unique(&var self) unsafe {
        guard let inner = self.inner else {
            return
        }

        if inner[0].refcount > 1 {
            // We're sharing - need to copy
            let old_data = self.copy()

            // Decrement old refcount
            inner[0].refcount = inner[0].refcount - 1

            // Take ownership of the copy's buffer
            self.inner = old_data.inner
            self.offset = old_data.offset
            self.length = old_data.length

            // Prevent old_data's deinit from freeing the buffer we just took
            // by incrementing refcount (it will be decremented in old_data's deinit)
            if let new_inner = self.inner {
                new_inner[0].refcount = new_inner[0].refcount + 1
            }
        }
    }

    // Internal: exclusive ownership plus `min_capacity` bytes of room. Returns
    // whether both were obtained; FALSE leaves the Data untouched.
    func _reserve_unique(&var self, min_capacity: Int) unsafe -> Bool {
        // First ensure we have exclusive ownership
        if let inner = self.inner {
            if inner[0].refcount > 1 {
                self._make_unique()
            }
        }

        // Then ensure capacity
        self._reserve(min_capacity)
    }

    // Internal: allocate a control block plus a `capacity`-byte buffer.
    // Returns whether both allocations succeeded; on a partial failure the
    // control block is released and the Data is left with no buffer at all.
    func _allocate_buffer(&var self, capacity: Int) unsafe -> Bool {
        // The control block's real size/alignment, not a 64-bit-only literal:
        // `DataBuffer` is 24 bytes on a 64-bit target and 12 on riscv32 — the
        // live SOS target — where the hardcoded 24 over-allocated and then told
        // the allocator the wrong size at free (design 122 unit F).
        let buffer_struct_size = sizeof<DataBuffer>()
        if let inner_raw = GlobalAllocator().alloc(buffer_struct_size, alignof<DataBuffer>()) {
            let inner = inner_raw as UnsafePointer<DataBuffer>

            // Allocate the actual byte buffer
            if let buf_raw = GlobalAllocator().alloc(capacity, 1) {
                let buf = buf_raw as UnsafePointer<UInt8>
                inner[0].buffer = buf
                inner[0].capacity = capacity
                inner[0].refcount = 1
                self.inner = inner
                self.offset = 0
                return true
            }
            // Failed to allocate buffer, free the struct
            let a = alignof<DataBuffer>()
            GlobalAllocator().dealloc(inner_raw, buffer_struct_size, a)
            return false
        }
        false
    }
}

// Data uses reference counting for memory management
extension Data: NoCopy {
    public func deinit(&var self) unsafe {
        if let inner = self.inner {
            inner[0].refcount = inner[0].refcount - 1

            if inner[0].refcount == 0 {
                // We're the last reference - free everything
                let buf = inner[0].buffer as UnsafePointer<Int8>
                GlobalAllocator().dealloc(buf, inner[0].capacity, 1)

                let inner_raw = inner as UnsafePointer<Int8>
                let block_size = sizeof<DataBuffer>()
                let block_align = alignof<DataBuffer>()
                GlobalAllocator().dealloc(inner_raw, block_size, block_align)
            }
        }
    }
}

// =============================================================================
// DataIterator - Iterator over Data bytes
// =============================================================================

struct DataIterator {
    inner: UnsafePointer<DataBuffer>?
    offset: Int
    length: Int
    index: Int
}

extension DataIterator: Iterator {
    type Item = UInt8

    public func next(&var self) unsafe -> UInt8? {
        if self.index >= self.length {
            return None
        }
        guard let inner = self.inner else {
            return None
        }
        let buf = inner[0].buffer
        let value = buf[self.offset + self.index]
        self.index = self.index + 1
        value
    }
}

// DataIterator also needs to manage refcount
extension DataIterator: NoCopy {
    public func deinit(&var self) {
        // Note: We don't increment refcount when creating iterator,
        // so we don't decrement here. The source Data object owns the reference.
        // This means iterators should not outlive their source Data.
        // For safety, we could add refcounting to iterators too.
    }
}
