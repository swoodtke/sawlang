//! Raw bytes with value semantics — `Data`, rebuilt on `Arc` (design 165).
//!
//! `Data` is a window onto `Arc`-owned storage: an offset and a length over a
//! buffer whose lifetime the `Arc` runs. Copying a `Data` — or slicing one —
//! retains that storage instead of duplicating it, and the bytes are separated
//! lazily, at the first write that finds them shared. That is copy-on-write,
//! and it is why `Data` is `Copy`: a copy costs a refcount bump.
//!
//! ```saw
//! var a = try! Data(capacity: 4)
//! let _ = try! a.push(1)
//! var b = a                     // a retain; both windows see the same byte
//! let _ = try! b.push(2)        // b is shared, so it separates here
//! print("{a.len()} {b.len()}")  // 1 2
//! ```
//!
//! Every operation that can run out of memory REPORTS it (design 234) —
//! `Result<_, AllocError>`, all-or-nothing. The one exception is the subscript
//! `d[i] = v`, whose copy-on-write separation panics: it shares a body with the
//! bounds check, and splitting one of the two failures out as a value would make
//! `d[i]` mean two different things by which failure it met. `detached()` is the
//! preflight that attempts the same allocation where a refusal has somewhere to
//! go.
//!
//! Every mutation takes the same uniqueness gate, so there is no operation that
//! writes through to a sibling and no rule to remember about which ones do. It
//! used to be otherwise: `set` wrote through shared storage while `push` and
//! `append` copied first (tracker DATA-2), which made the answer to "does my
//! slice see this?" depend on which method you called. The gate dissolves the
//! question — `Data` is a value, and values do not alias.
//!
//! This also retires the hand-rolled refcount that used to live here. `Arc`
//! owns the count now, so the buffer is freed by exactly one `deinit` in one
//! place, and an iterator that outlives its `Data` holds a real reference
//! rather than a dangling pointer (tracker DATA-1).
//!
//! The std triangle this completes: `String` is shared-immutable, `Vector` is
//! unique-mutable, `Data` is shared-until-written.

// `Data` is an alloc-layer type: it allocates through `GlobalAllocator`
// (design 19 §4 / brief 28), which wraps the runtime seams — never libc
// directly. memcpy is a compiler builtin, not a seam.
extern "C" {
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// DataBuf — the heap buffer, owned by exactly one Arc
// =============================================================================
//
// The whole unsafe surface of this file is here, and it is reachable only two
// ways: through `&self` reads (which an `Arc` forwards freely — a live strong
// reference pins the payload) and through `Arc.with_unique`, which hands out
// `&var DataBuf` exactly when nobody else holds the storage. There is no third
// way to write these bytes, which is what makes the copy-on-write discipline
// structural rather than a convention.
//
// The buffer POINTER is `Int8` because that is what the allocator and `memcpy`
// speak; every element access below views it as `UnsafePointer<Byte>` instead,
// so nothing inside this file handles a byte under a second type (design 250's
// `Data` rider: strict on reads, strict in its own internals).

struct DataBuf {
    buffer: UnsafePointer<Int8>
    capacity: Int
}

// design 186: the assertion behind `Data`'s thread-safety, made where the
// pointer actually is. The bytes are reachable exactly two ways — `&self` reads
// through a live strong reference, and `Arc.with_unique`, which hands out
// `&var DataBuf` only when nobody else holds the storage — so a buffer that two
// threads can see is a buffer neither can write. `Data` itself needs no
// declaration: it holds an `Arc<DataBuf>` and derives through this one and
// `Arc`'s.
extension DataBuf: UnsafeSend {}
extension DataBuf: UnsafeSync {}

extension DataBuf {
    // Allocate `capacity` bytes. `None` = the allocator refused.
    static func make(capacity: Int) unsafe -> DataBuf? {
        if let raw = GlobalAllocator().alloc(capacity, 1) {
            return DataBuf(buffer: raw, capacity: capacity)
        }
        None
    }

    func cap(&self) -> Int {
        self.capacity
    }

    // ---- reads: forwarded through `Arc`'s immutable borrow ----

    func at(&self, index: Int) unsafe -> Byte {
        let bytes = self.buffer as UnsafePointer<Byte>
        bytes[index]
    }

    func head(&self) unsafe -> UnsafePointer<Int8> {
        self.buffer
    }

    // ---- writes: reachable only through `Arc.with_unique` ----

    func store(&var self, index: Int, value: Byte) unsafe {
        let bytes = self.buffer as UnsafePointer<Byte>
        bytes[index] = value
    }

    func absorb(&var self, index: Int, src: UnsafePointer<Int8>, len: Int) unsafe {
        memcpy(self.buffer + index, src, len)
    }

    // Grow to `new_capacity`, carrying the first `live` bytes over. The seams
    // provide no realloc, so this is alloc + copy + dealloc. `false` = the
    // allocator refused and this buffer is untouched.
    func grow(&var self, new_capacity: Int, live: Int) unsafe -> Bool {
        if let fresh = GlobalAllocator().alloc(new_capacity, 1) {
            if live > 0 {
                memcpy(fresh, self.buffer, live)
            }
            GlobalAllocator().dealloc(self.buffer, self.capacity, 1)
            self.buffer = fresh
            self.capacity = new_capacity
            return true
        }
        false
    }
}

// The one place a Data byte buffer is freed. `Arc` runs this when the last
// strong reference goes, so no caller counts anything.
extension DataBuf: NoCopy {
    func deinit(&var self) unsafe {
        GlobalAllocator().dealloc(self.buffer, self.capacity, 1)
    }
}

// =============================================================================
// Data — a copy-on-write window onto shared storage
// =============================================================================

public struct Data {
    // `None` is the empty Data: no storage, and none allocated until the first
    // byte arrives. `offset`/`length` are then both 0.
    storage: Arc<DataBuf>?
    offset: Int   // where this window starts in the buffer
    length: Int   // how many bytes it covers
}

extension Data {
    // =========================================================================
    // Constructors
    // =========================================================================

    /// An empty buffer. Allocates nothing — storage arrives with the first byte.
    public init() -> Data {
        Data(storage: None, offset: 0, length: 0)
    }

    /// An empty buffer with room for `capacity` bytes, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    public init(capacity: Int) -> Result<Data, AllocError> {
        var data = Data(storage: None, offset: 0, length: 0)
        if not data._make_ready(capacity) {
            return AllocError(size: data._grow_target(capacity), align: 1)
        }
        return move data
    }

    // =========================================================================
    // Basic Properties
    // =========================================================================

    /// The number of bytes in this window.
    public func len(&self) -> Int {
        self.length
    }

    /// Whether this window covers no bytes.
    public func is_empty(&self) -> Bool {
        self.length == 0
    }

    /// How many bytes this `Data` can take before a mutation has to allocate.
    ///
    /// For sole ownership of a whole buffer that is the buffer's capacity. When
    /// the storage is SHARED, or this is a slice that starts partway in, the
    /// next write separates the bytes into a buffer of its own, so the answer
    /// is `len()`. Reserving against this number always reserves enough.
    public func capacity(&self) -> Int {
        if self.offset == 0 && self._is_unique() {
            return self.storage!.cap()
        }
        self.length
    }

    // =========================================================================
    // Element Access
    // =========================================================================

    /// The byte at `index`, as a PLACE (design 141) — `d[i] = 0` writes it
    /// where it sits and `d[i] += 1` reads, adds and stores in one window.
    ///
    /// Panics if `index` is outside `0..<len()`, on the same terms as `set`.
    ///
    /// A READ costs nothing and works on a `let` binding, a `&Data` parameter
    /// or a slice several `Data`s share. A WRITE separates shared storage first,
    /// so it needs a `var` root and the first one on shared bytes copies them.
    /// Both come out of this one declaration: `#lend_var` (design 179) is the
    /// compile-time constant naming the specialization being compiled, so the
    /// uniqueness gate is in the exclusive copy and simply is not in the shared
    /// one. That is what copy-on-write needs and what design 146's single
    /// use-site-decides-the-flavor rule could not express on its own.
    ///
    /// The shared copy may skip the gate safely: the bounds check above already
    /// proved `length > 0`, so the storage it reads through exists.
    ///
    /// The place type is `UInt8` and not `Byte`, deliberately (design 250 §5 Q4
    /// names the subscript in the sink list). A `borrows -> T` has ONE `T` for
    /// the read and the write, so a `Byte` place would keep `let v = d[i]`
    /// honest at the cost of `d[i] = 42` — a literal does not adopt into a
    /// distinct alias. Writing bytes is what a subscript is for, so the write
    /// wins here; `get`, `pop` and iteration carry the strict read side.
    public func [](&self, index: Int) unsafe borrows -> UInt8 {
        if index < 0 || index >= self.length {
            panic("Data.[]: index out of range: {} (len {})", index, self.length)
        }
        if #lend_var {
            if not self._make_ready(self.length) {
                panic("Data.[]: allocation failed")
            }
        }
        let bytes = self.byte_ptr() as UnsafePointer<UInt8>
        lend bytes[index]
    }

    /// The byte at `index`, or `None` when it is out of range.
    ///
    /// The `None`-returning twin of `[]`, which panics — the design-146 pairing,
    /// and the only difference between them now that a shared `d[i]` read
    /// separates nothing either. Reach for `get` where an out-of-range index is
    /// data rather than a bug.
    public func get(&self, index: Int) -> Byte? {
        if index < 0 || index >= self.length {
            return None
        }
        guard let _ = self.storage else {
            return None
        }
        self.storage!.at(self.offset + index)
    }

    /// Writes `value` at `index`.
    ///
    /// Panics if `index` is outside `0..<len()`.
    ///
    /// If the storage is shared this separates it first, so the write lands on
    /// this `Data` and no sibling sees it. That is a BEHAVIOR CHANGE ratified
    /// with design 165: `set` used to write THROUGH to every holder while
    /// `push` and `append` copied first.
    ///
    /// Only the copy-on-write separation can fail, so on shared storage this is
    /// all-or-nothing: an `Err` leaves both this `Data` and its siblings exactly
    /// as they were. An out-of-range `index` still panics — the reporting tier is
    /// about the allocator, not about bounds (design 130's accessor rule, and
    /// design 234 §5's fault line).
    /// `value` is a `UInt8` and not a `Byte` because `Data` deals in nothing but
    /// bytes, so there is no second reading for a number arriving here (design
    /// 250 §5 Q4's sink rule). One parameter takes all three arrivals: a `Byte`
    /// degrades in, a bare literal adopts, a `UInt8` passes. A computed `Int`
    /// still pays the visible `as UInt8` at the boundary.
    public func set(&var self, index: Int, value: UInt8) -> Result<Void, AllocError> {
        if index < 0 || index >= self.length {
            panic("Data.set: index out of range: {} (len {})", index, self.length)
        }
        if not self._make_ready(self.length) {
            return AllocError(size: self._grow_target(self.length), align: 1)
        }
        self._store_at(index, Byte(value))
        return
    }

    // =========================================================================
    // Modification Operations
    // =========================================================================

    /// Appends one byte.
    ///
    /// Separates shared storage first, so a sibling's bytes are never touched.
    /// Reports allocator exhaustion as `Err(AllocError)`; the buffer is
    /// unchanged then.
    /// `value` takes a `Byte`, a `UInt8` and a bare literal alike, on `set`'s
    /// terms above.
    public func push(&var self, value: UInt8) -> Result<Void, AllocError> {
        let wanted = self.length + 1
        if not self._make_ready(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._store_at(self.length, Byte(value))
        self.length = self.length + 1
        return
    }

    /// Reserves room for `additional` more bytes, reporting allocator
    /// exhaustion as `Err(AllocError)`.
    ///
    /// On `Ok` this `Data` solely owns a buffer with that much room, so the
    /// next `additional` pushes cannot allocate and cannot fail.
    public func reserve(&var self, additional: Int) -> Result<Void, AllocError> {
        let wanted = self.length + additional
        if not self._make_ready(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        return
    }

    /// Removes and returns the last byte, or `None` when there is none.
    ///
    /// Shrinking a window is not a write, so this never separates the storage
    /// and never allocates: a sibling keeps every byte it could see.
    public func pop(&var self) -> Byte? {
        if self.length == 0 {
            return None
        }
        guard let _ = self.storage else {
            return None
        }
        let value = self.storage!.at(self.offset + self.length - 1)
        self.length = self.length - 1
        value
    }

    /// Drops every byte from this window, keeping the storage for reuse.
    ///
    /// Like `pop`, this only narrows the window — siblings are untouched.
    public func clear(&var self) {
        self.length = 0
    }

    /// Appends every byte of `other`.
    ///
    /// `d.append(d)` is well defined: the argument is a retain, which makes the
    /// storage shared, so the separation happens before the copy and reads a
    /// buffer nothing is writing.
    ///
    /// Reports allocator exhaustion as `Err(AllocError)`; this buffer is
    /// unchanged then — no partial append.
    public func append(&var self, other: Data) -> Result<Void, AllocError> {
        if other.length == 0 {
            return
        }
        let wanted = self.length + other.length
        if not self._make_ready(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._place_data(&other)
        return
    }

    /// Appends `len` raw bytes from `src`.
    ///
    /// The pointer-typed signature is the design-130 visible marker: callers in
    /// the unsafe domain (std.net's socket read path) fill a `Data` from a stack
    /// buffer with no per-byte overhead. `src` and `len` must describe `len`
    /// valid bytes. Reports allocator exhaustion as `Err(AllocError)`; the
    /// buffer is unchanged then.
    public func append_bytes(&var self, src: UnsafePointer<Int8>, len: Int) unsafe -> Result<Void, AllocError> {
        if len <= 0 {
            return
        }
        let wanted = self.length + len
        if not self._make_ready(wanted) {
            return AllocError(size: self._grow_target(wanted), align: 1)
        }
        self._place_bytes(src, len)
        return
    }

    /// A pointer to this window's first byte, or a null pointer when it is
    /// empty.
    ///
    /// The pointer-typed signature is the design-130 visible marker; std.net's
    /// write path streams bytes to a socket through it without copying. It
    /// addresses SHARED storage, so it is a read pointer: writing through it
    /// would be the write-through this type no longer does.
    public func byte_ptr(&self) unsafe -> UnsafePointer<Int8> {
        guard let _ = self.storage else {
            return 0 as UnsafePointer<Int8>
        }
        self.storage!.head() + self.offset
    }

    // =========================================================================
    // Slicing and copying
    // =========================================================================

    /// A narrower window onto the same bytes, or `None` when the bounds are
    /// invalid.
    ///
    /// O(1) — the storage is retained, never copied, at any size. The slice is
    /// an independent value: writing to either it or this `Data` separates the
    /// bytes first, so neither can see the other's edits.
    public func slice(&self, start: Int, end: Int) -> Data? {
        if start < 0 || end < start || end > self.length {
            return None
        }
        if self.length == 0 {
            if start == 0 && end == 0 {
                return Data()
            }
            return None
        }
        guard let _ = self.storage else {
            return None
        }
        Data(storage: self.storage!.copy(), offset: self.offset + start, length: end - start)
    }

    /// An independent buffer holding exactly these bytes, materialized now.
    ///
    /// `copy()` already gives value semantics, lazily, and is what you want
    /// almost always. Reach for `detached` when the timing or the memory
    /// matters: it separates the bytes immediately rather than at the next
    /// write, and it sizes the new buffer to `len()` — so a small slice stops
    /// pinning the large buffer it was cut from.
    ///
    /// Reports allocator exhaustion as `Err(AllocError)`. All-or-nothing: an
    /// `Err` allocates nothing and leaves this `Data` alone.
    ///
    /// It is also the PREFLIGHT for `d[i] = v` on shared storage: the subscript's
    /// own separation panics (design 234 §5 keeps it under the accessor rule it
    /// shares a body with), and `detached()` is where that same allocation has
    /// somewhere to report to.
    public func detached(&self) unsafe -> Result<Data, AllocError> {
        if self.length == 0 {
            return Data()
        }
        guard let raw = DataBuf.make(self.length) else {
            return AllocError(size: self.length, align: 1)
        }
        var fresh = move raw
        fresh.absorb(0, self.byte_ptr(), self.length)
        match Arc<DataBuf>(value: move fresh) {
            case Ok(owner) -> {
                return Data(storage: move owner, offset: 0, length: self.length)
            },
            case Err(e) -> {
                return e
            }
        }
    }

    // =========================================================================
    // Iteration
    // =========================================================================

    /// An iterator over the bytes of this window.
    ///
    /// The iterator HOLDS this `Data` — which is to say it holds a retain — so
    /// one returned from a function outlives the binding it was made from and
    /// still reads live bytes. It used to copy a raw pointer and no count, so
    /// exactly that shape was a use-after-free reachable from safe code
    /// (tracker DATA-1).
    public func iter(&self) -> DataIterator {
        DataIterator(source: self.copy(), index: 0)
    }

    // =========================================================================
    // Conversion
    // =========================================================================

    /// Decodes these bytes as UTF-8.
    ///
    /// `Ok(s)` = the whole window is valid UTF-8. `Err(e)` = it is not, and
    /// `e.offset` is the byte index where the first malformed sequence begins
    /// (`String.fromBytes` semantics).
    ///
    /// A `String`'s contents are ALWAYS valid UTF-8 — literals are
    /// source-encoded and `String.fromBytes` validates — and the language's own
    /// iterators rely on that invariant. This used to byte-copy into a
    /// StringBuilder with no validation, minting Strings that broke it (design
    /// 122 unit B), so decoding says that it can fail.
    public func to_string(&self) -> Result<String, Utf8Error> {
        String.fromBytes(&self)
    }

    // =========================================================================
    // Internal — the uniqueness gate
    // =========================================================================

    // Whether this Data is the sole owner of its storage. An empty Data owns
    // nothing, so it answers `false` and takes the allocating path.
    //
    // Note both lookups below are BORROWS (design 131): `guard let _ =` binds
    // nothing and `self.storage!.m()` reaches through the payload in place.
    // Binding the Arc out (`if let s = self.storage`) would RETAIN it and this
    // would then never report unique.
    func _is_unique(&self) -> Bool {
        guard let _ = self.storage else {
            return false
        }
        self.storage!.strong_count() == 1
    }

    // The capacity a growth from `current` to at least `wanted` allocates:
    // doubling from a 16-byte floor.
    func _grow_target_from(&self, current: Int, wanted: Int) -> Int {
        var target = if current == 0 { 16 } else { current }
        while target < wanted {
            target = target * 2
        }
        target
    }

    // The capacity a growth to `min_capacity` would allocate.
    func _grow_target(&self, min_capacity: Int) -> Int {
        self._grow_target_from(self.capacity(), min_capacity)
    }

    // THE gate every mutation passes. Leaves this Data the sole owner of a
    // buffer that starts at offset 0 and holds at least `min_capacity` bytes.
    // `false` = the allocator refused, and NOTHING changed.
    //
    // Two conditions, not one. Sole ownership is the copy-on-write half. A zero
    // offset is the other: a window that starts partway into a buffer has room
    // measured from `offset`, and every write site here indexes from 0, so
    // re-basing a slice rather than reasoning about `offset + length` against
    // `capacity` removes a whole class of off-by-offset overruns.
    func _make_ready(&var self, min_capacity: Int) -> Bool {
        // An empty Data asked for no room needs no storage — `Data(capacity: 0)`
        // allocates nothing. Every caller that goes on to WRITE asks for at
        // least one byte, so this cannot hand a write an absent buffer.
        if min_capacity <= 0 && self.length == 0 {
            return true
        }
        if self.offset == 0 && self._is_unique() {
            if self.storage!.cap() >= min_capacity {
                return true
            }
            let target = self._grow_target_from(self.storage!.cap(), min_capacity)
            let live = self.length
            return self.storage!.with_unique({ buf in buf.grow(target, live) }) ?? false
        }
        self._rebase(min_capacity)
    }

    // Move the live bytes into a fresh, solely-owned buffer based at offset 0.
    // This is the copy in copy-on-write, and the compaction an offset window
    // needs before it can grow.
    func _rebase(&var self, min_capacity: Int) unsafe -> Bool {
        let wanted = if min_capacity < self.length { self.length } else { min_capacity }
        guard let raw = DataBuf.make(self._grow_target_from(0, wanted)) else {
            return false
        }
        var fresh = move raw
        if self.length > 0 {
            fresh.absorb(0, self.byte_ptr(), self.length)
        }
        match Arc<DataBuf>(value: move fresh) {
            case Ok(owner) -> {
                // Installing the new storage releases the old one, which frees
                // it when this was the last window onto it.
                self.storage = move owner
                self.offset = 0
                return true
            },
            case Err(_) -> {
                return false
            }
        }
    }

    // Write one byte into the buffer. Sound because `with_unique` runs the body
    // only when this Data solely owns the storage, and every caller has just
    // been through `_make_ready`.
    func _store_at(&var self, index: Int, value: Byte) {
        let at = self.offset + index
        let _ = self.storage!.with_unique({ buf in buf.store(at, value) })
    }

    // Copy `other`'s live bytes onto the end of this window. Read `other`'s
    // pointer AFTER `_make_ready`: if the two shared storage, the separation
    // has already given this Data a different buffer to write into.
    func _place_data(&var self, other: &Data) unsafe {
        self._place_bytes(other.byte_ptr(), other.length)
    }

    // Copy `len` bytes from `src` onto the end of this window.
    func _place_bytes(&var self, src: UnsafePointer<Int8>, len: Int) unsafe {
        let at = self.offset + self.length
        let _ = self.storage!.with_unique({ buf in buf.absorb(at, src, len) })
        self.length = self.length + len
    }
}

/// Copying a `Data` retains its storage — the bytes separate later, at the
/// first write that finds them shared.
///
/// So `let b = a` and `a.copy()` are refcount bumps, and both spellings still
/// give value semantics: neither `a` nor `b` can observe the other's edits.
/// `Data` was `NoCopy` before design 165, which is why the tree is full of
/// `move` on values that no longer need it — `move` still works on any type, so
/// none of it had to change.
///
/// `detached()` is the eager spelling for callers who want the bytes now.
@synthesize
extension Data: Copy {}

// =============================================================================
// DataIterator — iteration that holds its storage
// =============================================================================

public struct DataIterator {
    source: Data
    index: Int
}

extension DataIterator: Iterator {
    type Item = Byte

    public func next(&var self) -> Byte? {
        if self.index >= self.source.len() {
            return None
        }
        let value = self.source.get(self.index)
        self.index = self.index + 1
        value
    }
}

// Copying an iterator retains the same bytes and keeps its own position — the
// tier its `Data` field already carries.
@synthesize
extension DataIterator: Copy {}
