// File - File I/O operations for the Saw standard library
// Part of the Saw standard library
//
// Provides file reading, writing, and manipulation using POSIX system calls.

// =============================================================================
// FFI declarations for file operations
// =============================================================================

extern "C" {
    // File operations (POSIX)
    // Note: open() is variadic - the mode parameter is only used with O_CREAT
    func open(path: UnsafePointer<Int8>, flags: Int32, ...) -> Int32
    func read(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func write(fd: Int32, buf: UnsafePointer<Int8>, count: Int) -> Int
    func close(fd: Int32) -> Int32
    func lseek(fd: Int32, offset: Int64, whence: Int32) -> Int64

    // File info and manipulation
    func access(path: UnsafePointer<Int8>, mode: Int32) -> Int32
    // design 117: status-carrying fs ops (0 = ok, -SysError tag on failure).
    func __saw_rt_fs_unlink(path: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_rename(oldpath: UnsafePointer<Int8>, newpath: UnsafePointer<Int8>) -> Int

    // Memory
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
}

// =============================================================================
// File - A file handle with automatic cleanup
// =============================================================================

struct File {
    fd: Int32
}

extension File {
    // =========================================================================
    // Static methods for opening files
    // =========================================================================

    // Open a file for reading
    public unsafe func open(path: Path) -> File? {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        let fd = open(path_ptr, 0 as Int32, 0 as Int32)  // O_RDONLY

        if fd < (0 as Int32) {
            None
        } else {
            File(fd: fd)
        }
    }

    // Create a file for writing (truncates if exists)
    public unsafe func create(path: Path) -> File? {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        // O_WRONLY | O_CREAT | O_TRUNC = 1 | 64 | 512 = 577
        let fd = open(path_ptr, 577 as Int32, 420)  // 0644

        if fd < (0 as Int32) {
            None
        } else {
            File(fd: fd)
        }
    }

    // Open a file for appending
    public unsafe func open_append(path: Path) -> File? {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        // O_WRONLY | O_CREAT | O_APPEND = 1 | 64 | 1024 = 1089
        let fd = open(path_ptr, 1089 as Int32, 420)

        if fd < (0 as Int32) {
            None
        } else {
            File(fd: fd)
        }
    }

    // =========================================================================
    // Reading - returns Data
    // =========================================================================

    // Read bytes from the file
    // If size <= 0, reads the entire file; otherwise reads up to size bytes
    public unsafe func read(&var self, size: Int = 0) -> Data? {
        var bytes_to_read = size

        // If size <= 0, determine file size
        if bytes_to_read <= 0 {
            let current_pos = lseek(self.fd, 0 as Int64, 1 as Int32)  // SEEK_CUR
            if current_pos < (0 as Int64) {
                return None
            }
            let end_pos = lseek(self.fd, 0 as Int64, 2 as Int32)  // SEEK_END
            if end_pos < (0 as Int64) {
                return None
            }
            bytes_to_read = (end_pos - current_pos) as Int
            // Seek back to original position
            lseek(self.fd, current_pos, 0 as Int32)  // SEEK_SET
        }

        if bytes_to_read == 0 {
            return Data()
        }

        // Allocate buffer and read. `None` means the read(2) failed;
        // allocator exhaustion panics rather than joining it (design 123), and
        // the `Data` fill below is the infallible tier too, so a short buffer
        // can no longer make this return FEWER bytes than the file holds.
        guard let buf = unsafe malloc(bytes_to_read) else {
            panic("File.read: allocation failed")
        }
        let bytes_read = read(self.fd, buf, bytes_to_read)
        if bytes_read < 0 {
            free(buf)
            return None
        }

        // Create Data and copy bytes
        var data = Data(capacity: bytes_read)
        var i = 0
        while i < bytes_read {
            data.push(unsafe buf[i] as UInt8)
            i = i + 1
        }
        free(buf)
        move data
    }

    // =========================================================================
    // Writing - accepts Data
    // =========================================================================

    // Write Data to the file
    public unsafe func write(&self, data: Data) -> Int? {
        if data.len() == 0 {
            return 0
        }

        // Allocate temporary buffer for write. `None` means the write(2)
        // failed; allocator exhaustion panics rather than joining it (design
        // 123).
        guard let buf = unsafe malloc(data.len()) else {
            panic("File.write: allocation failed")
        }
        // Copy data bytes to buffer
        var i = 0
        while i < data.len() {
            if let b = data.get(i) {
                unsafe buf[i] = b as Int8
            }
            i = i + 1
        }

        let written = write(self.fd, buf, data.len())
        free(buf)

        if written < 0 {
            None
        } else {
            written
        }
    }

    // =========================================================================
    // Seeking
    // =========================================================================

    public func seek_start(&self, offset: Int) -> Int? {
        let result = lseek(self.fd, offset as Int64, 0 as Int32)
        if result < (0 as Int64) { None } else { result as Int }
    }

    public func seek_current(&self, offset: Int) -> Int? {
        let result = lseek(self.fd, offset as Int64, 1 as Int32)
        if result < (0 as Int64) { None } else { result as Int }
    }

    public func seek_end(&self, offset: Int) -> Int? {
        let result = lseek(self.fd, offset as Int64, 2 as Int32)
        if result < (0 as Int64) { None } else { result as Int }
    }

    public func position(&self) -> Int? {
        let result = lseek(self.fd, 0 as Int64, 1 as Int32)
        if result < (0 as Int64) { None } else { result as Int }
    }

    // =========================================================================
    // Static utility methods
    // =========================================================================

    public unsafe func exists(path: Path) -> Bool {
        let ptr = path.as_str() as UnsafePointer<Int8>
        access(ptr, 0 as Int32) == (0 as Int32)
    }

    // Remove a file. Returns Ok on success or the errno cause honestly (design
    // 92 — a Bool hid WHY it failed; `exists` stays a genuine boolean question).
    public unsafe func remove(path: Path) -> Result<Void, IoError> {
        let ptr = path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_unlink(ptr)
        if e != 0 {
            return IoError.of("unlink", -e)
        }
        return
    }

    // Rename/move a file. Ok on success, Err(IoError) with the SysError cause.
    public unsafe func rename(from_path: Path, to_path: Path) -> Result<Void, IoError> {
        let from_ptr = from_path.as_str() as UnsafePointer<Int8>
        let to_ptr = to_path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_rename(from_ptr, to_ptr)
        if e != 0 {
            return IoError.of("rename", -e)
        }
        return
    }
}

extension File: NoCopy {
    public func deinit(&var self) {
        if self.fd >= (0 as Int32) {
            close(self.fd)
        }
    }
}
