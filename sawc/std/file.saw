//! Files: `File`, `OpenMode`, and the byte-level read/write surface.
//!
//! ## Timing
//!
//! Every operation in this module is synchronous. None of them suspends, so none
//! of them yields to a sibling task: the thread that called stays inside the
//! system call until it returns. On a healthy local disk that is the right trade.
//! A page-cache read costs less than the thread hop an offload would add, and the
//! freestanding profile has no thread to hop to, so a file API whose correctness
//! depended on one could not exist there at all.
//!
//! Where the promise stops holding: a network filesystem whose server is not
//! answering, a FUSE mount, a device node, or a FIFO — `File.open` on a FIFO waits
//! for a writer even locally. A read on any of those is unbounded, and a
//! cooperative task that issues one holds its executor thread for however long it
//! takes, with every sibling task on that thread waiting behind it. Sockets and
//! `Command.run` do not behave this way; they park on the reactor. Files are the
//! exception, and it is a policy rather than an oversight — Rust and Go draw the
//! same line.
//!
//! There is no per-call opt-out. Code that knows it is on a network mount and
//! cannot afford the stall should do that work in a `spawn`-ed `Task`, whose own
//! thread is then the one that waits.
//!
//! Part of the Saw standard library. POSIX system calls behind the runtime seams.

// =============================================================================
// FFI declarations for file operations
// =============================================================================

extern "C" {
    func close(fd: Int32) -> Int32

    // File info and manipulation
    func access(path: UnsafePointer<Int8>, mode: Int32) -> Int32
    // design 117: status-carrying fs ops (0 = ok, -SysError tag on failure).
    func __saw_rt_fs_unlink(path: UnsafePointer<Int8>) -> Int
    func __saw_rt_fs_rename(oldpath: UnsafePointer<Int8>, newpath: UnsafePointer<Int8>) -> Int
    // design 132 unit G: the file-I/O seams, same convention — the natural
    // non-negative result (fd, byte count, offset) or the negated SysError tag.
    // They replaced bare `open`/`read`/`write`/`lseek` calls, whose failure
    // cause std had no way to read (errno is runtime-internal, rt/ABI.md).
    func __saw_rt_fs_open(path: UnsafePointer<Int8>, flags: Int, mode: Int) -> Int
    func __saw_rt_fs_read(fd: Int, buf: UnsafePointer<Int8>, count: Int) -> Int
    func __saw_rt_fs_write(fd: Int, buf: UnsafePointer<Int8>, count: Int) -> Int
    func __saw_rt_fs_lseek(fd: Int, offset: Int, whence: Int) -> Int

    // Memory
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func free(ptr: UnsafePointer<Int8>)
}

// How a file is being opened. This is a PORTABLE mode the runtime translates
// into its host's `O_*` bits, not a POSIX flag word (design 155).
//
// It used to be a flag word, written here as the decimal LINUX values and used
// on both hosts. On macOS those bits mean something else entirely: `create`
// came out as `O_WRONLY | O_ASYNC | O_CREAT` — no `O_TRUNC`, so writing 3 bytes
// over a 30-byte file left a 30-byte file with the old tail still on it — and
// `open_append` came out as `O_WRONLY | O_ASYNC | O_TRUNC`, which neither
// created a missing file nor appended to a present one. A per-host macro cannot
// be a portable literal, so std stopped trying to spell one.
enum OpenMode: UInt8 {
    /// Read an existing file.
    case Read = 0
    /// Write from the beginning, creating the file or emptying an existing one.
    case WriteTruncate = 1
    /// Write at the end, creating the file when it is absent.
    case Append = 2
}

static MODE_RW_R_R: Int = 420             // 0644
static SEEK_SET: Int = 0
static SEEK_CUR: Int = 1
static SEEK_END: Int = 2

// =============================================================================
// File - A file handle with automatic cleanup
// =============================================================================

struct File {
    fd: Int32
}

extension File {
    // =========================================================================
    // Static methods for opening files
    // =========================================================================

    // Open `path` for reading.
    //
    // `Err` carries the reason open(2) refused — ENOENT and EACCES are different
    // problems and the caller can now tell them apart (design 92).
    public func open(path: Path) unsafe -> Result<File, IoError> {
        File._opened(path, OpenMode.Read, 0, "open")
    }

    // Create `path` for writing, truncating an existing file.
    public func create(path: Path) unsafe -> Result<File, IoError> {
        File._opened(path, OpenMode.WriteTruncate, MODE_RW_R_R, "open")
    }

    // Open `path` for appending, creating it if absent.
    public func open_append(path: Path) unsafe -> Result<File, IoError> {
        File._opened(path, OpenMode.Append, MODE_RW_R_R, "open")
    }

    // The one open(2) call the three constructors share.
    func _opened(path: Path, mode: OpenMode, perm: Int, syscall: String) unsafe -> Result<File, IoError> {
        let path_ptr = path.as_str() as UnsafePointer<Int8>
        let fd = __saw_rt_fs_open(path_ptr, (mode as UInt8) as Int, perm)
        if fd < 0 {
            return IoError.of(syscall, 0 - fd)
        }
        return File(fd: fd as Int32)
    }

    // =========================================================================
    // Reading - returns Data
    // =========================================================================

    // Read bytes from the file. With `size <= 0` (the default) that is the whole
    // remainder; otherwise at most `size` bytes.
    //
    // `Err` carries the errno cause of the failing lseek(2) or read(2). An empty
    // `Ok` means the file had nothing left, which is a different answer from a
    // failure and always was — it just used to share `None` with it (design 92).
    // Allocator exhaustion panics rather than joining either (design 123), and
    // the `Data` fill below is the infallible tier too, so a short buffer cannot
    // make this return FEWER bytes than the file holds.
    public func read(&var self, size: Int = 0) unsafe -> Result<Data, IoError> {
        var bytes_to_read = size

        // If size <= 0, determine what is left from here to the end.
        if bytes_to_read <= 0 {
            let current_pos = __saw_rt_fs_lseek(self.fd as Int, 0, SEEK_CUR)
            if current_pos < 0 {
                return IoError.of("lseek", 0 - current_pos)
            }
            let end_pos = __saw_rt_fs_lseek(self.fd as Int, 0, SEEK_END)
            if end_pos < 0 {
                return IoError.of("lseek", 0 - end_pos)
            }
            bytes_to_read = end_pos - current_pos
            // Seek back to where we started.
            let restored = __saw_rt_fs_lseek(self.fd as Int, current_pos, SEEK_SET)
            if restored < 0 {
                return IoError.of("lseek", 0 - restored)
            }
        }

        if bytes_to_read == 0 {
            return Data()
        }

        guard let buf = malloc(bytes_to_read) else {
            panic("File.read: allocation failed")
        }
        let bytes_read = __saw_rt_fs_read(self.fd as Int, buf, bytes_to_read)
        if bytes_read < 0 {
            free(buf)
            return IoError.of("read", 0 - bytes_read)
        }

        // Create Data and copy bytes. The read buffer is `Int8` (C `char`) and
        // `Data` holds `UInt8`, so each byte is REINTERPRETED, not converted:
        // a file byte >= 0x80 arrives negative and a checked `as` would panic
        // on it (design 170). Same width, so this is a pure bit reinterpret.
        var data = Data(capacity: bytes_read)
        var i = 0
        while i < bytes_read {
            data.push(UInt8.from(truncating: buf[i]))
            i = i + 1
        }
        free(buf)
        return move data
    }

    // =========================================================================
    // Writing - accepts Data
    // =========================================================================

    // Write `data` to the file, returning the number of bytes written.
    //
    // `Err` carries the errno cause of the failing write(2). Allocator
    // exhaustion panics rather than joining it (design 123).
    public func write(&self, data: Data) unsafe -> Result<Int, IoError> {
        if data.len() == 0 {
            return 0
        }

        guard let buf = malloc(data.len()) else {
            panic("File.write: allocation failed")
        }
        // Copy data bytes to buffer — the `UInt8` -> `Int8` reinterpret that
        // mirrors `read` above, byte values >= 128 included (design 170).
        var i = 0
        while i < data.len() {
            if let b = data.get(i) {
                buf[i] = Int8.from(truncating: b)
            }
            i = i + 1
        }

        let written = __saw_rt_fs_write(self.fd as Int, buf, data.len())
        free(buf)

        if written < 0 {
            return IoError.of("write", 0 - written)
        }
        return written
    }

    // =========================================================================
    // Seeking
    // =========================================================================

    // Each returns the resulting absolute offset, or the errno cause of the
    // failing lseek(2) (design 92 — `None` said only "it did not work").

    public func seek_start(&self, offset: Int) unsafe -> Result<Int, IoError> {
        File._seek(self.fd, offset, SEEK_SET)
    }

    public func seek_current(&self, offset: Int) unsafe -> Result<Int, IoError> {
        File._seek(self.fd, offset, SEEK_CUR)
    }

    public func seek_end(&self, offset: Int) unsafe -> Result<Int, IoError> {
        File._seek(self.fd, offset, SEEK_END)
    }

    public func position(&self) unsafe -> Result<Int, IoError> {
        File._seek(self.fd, 0, SEEK_CUR)
    }

    func _seek(fd: Int32, offset: Int, whence: Int) unsafe -> Result<Int, IoError> {
        let result = __saw_rt_fs_lseek(fd as Int, offset, whence)
        if result < 0 {
            return IoError.of("lseek", 0 - result)
        }
        return result
    }

    // =========================================================================
    // Static utility methods
    // =========================================================================

    public func exists(path: Path) unsafe -> Bool {
        let ptr = path.as_str() as UnsafePointer<Int8>
        access(ptr, 0 as Int32) == (0 as Int32)
    }

    // Remove a file. Returns Ok on success or the errno cause honestly (design
    // 92 — a Bool hid WHY it failed; `exists` stays a genuine boolean question).
    public func remove(path: Path) unsafe -> Result<Void, IoError> {
        let ptr = path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_unlink(ptr)
        if e != 0 {
            return IoError.of("unlink", -e)
        }
        return
    }

    // Rename/move a file. Ok on success, Err(IoError) with the SysError cause.
    public func rename(from_path: Path, to_path: Path) unsafe -> Result<Void, IoError> {
        let from_ptr = from_path.as_str() as UnsafePointer<Int8>
        let to_ptr = to_path.as_str() as UnsafePointer<Int8>
        let e = __saw_rt_fs_rename(from_ptr, to_ptr)
        if e != 0 {
            return IoError.of("rename", -e)
        }
        return
    }
}

extension File: NoCopy {
    public func deinit(&var self) {
        if self.fd >= (0 as Int32) {
            close(self.fd)
        }
    }
}
