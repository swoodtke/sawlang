//! Spans of time.
//!
//! A `Duration` is a magnitude, held as whole nanoseconds in a UInt64. Build one
//! with `Duration.ns`, `us`, `ms` or `secs`; read it back with the `as_*`
//! accessors. Durations compare and print.
//!
//! `Duration` is in the prelude and needs no import, because `sleep` is a
//! prelude builtin and this is the only type it takes. `Instant`, the clock it
//! pairs with, lives in `std.time` and does need one.
//!
//! Nothing here allocates and nothing here touches the OS, so the type is
//! available in the freestanding profile as well as the hosted one.

// std.duration (design 180 unit 2). Carved out of std/time.saw, which is
// HOSTED-ONLY and import-required: `sleep(d: Duration)` is a prelude builtin, so
// its one argument type has to be reachable wherever `sleep` is, in both
// profiles and with no import. `Instant` stayed behind — it reads a clock, which
// is exactly what a kernel supplies for itself.
//
// The backing is UNSIGNED. A span has no negative values, and the whole
// u64-nanosecond range (about 584 years) is reachable from every constructor, so
// no request a caller can spell wraps into a shorter one — which is what DF-170a
// was about at the millisecond API this replaced.

// Unit conversions, named rather than spelled at each site.
static NANOS_PER_MICRO: UInt64 = 1000
static NANOS_PER_MILLI: UInt64 = 1000000
static NANOS_PER_SEC: UInt64 = 1000000000
static CENTIS_PER_SEC: UInt64 = 100
// The largest argument each constructor can scale without leaving the u64
// nanosecond range: UInt64.max divided by that constructor's unit.
static MAX_MICROS: UInt64 = 18446744073709551
static MAX_MILLIS: UInt64 = 18446744073709
static MAX_SECS: UInt64 = 18446744073

/// A span of time, held as whole nanoseconds.
///
/// Build one with `Duration.ns`, `us`, `ms` or `secs`, or get one by subtracting
/// instants. Durations compare and print.
struct Duration {
    nanos: UInt64
}

/// Construction and whole-unit readout for `Duration`.
extension Duration {
    /// Returns a span of `n` nanoseconds.
    public func ns(n: UInt64) -> Duration {
        Duration(nanos: n)
    }

    /// Returns a span of `n` whole microseconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public func us(n: UInt64) -> Duration {
        if n > MAX_MICROS {
            panic("Duration.us: {} microseconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_MICRO)
    }

    /// Returns a span of `n` whole milliseconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public func ms(n: UInt64) -> Duration {
        if n > MAX_MILLIS {
            panic("Duration.ms: {} milliseconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_MILLI)
    }

    /// Returns a span of `n` whole seconds.
    ///
    /// Panics if the span would run past the representable range, about 584
    /// years.
    public func secs(n: UInt64) -> Duration {
        if n > MAX_SECS {
            panic("Duration.secs: {} seconds is past the representable span", n)
        }
        Duration(nanos: n * NANOS_PER_SEC)
    }

    /// Returns the whole seconds in the span, truncating.
    public func as_secs(&self) -> UInt64 {
        self.nanos / NANOS_PER_SEC
    }

    /// Returns the whole milliseconds in the span, truncating.
    public func as_millis(&self) -> UInt64 {
        self.nanos / NANOS_PER_MILLI
    }

    /// Returns the whole microseconds in the span, truncating.
    public func as_micros(&self) -> UInt64 {
        self.nanos / NANOS_PER_MICRO
    }

    /// Returns the span in nanoseconds, the unit it is stored in.
    public func as_nanos(&self) -> UInt64 {
        self.nanos
    }
}

// The executor's wake-reason projection (design 180). A suspended frame carries
// its deadline in a platform-Int `__wake` word, so a span past `Int.max`
// nanoseconds — about 292 years on a 64-bit host — saturates there. Both values
// mean the task is not coming back and no observer can tell them apart, whereas
// refusing the span would make `sleep` panic on a `Duration` the type is happy
// to hold. The coroutine transform emits this call; nothing else calls it, and
// user code cannot (the lexer reserves the `__saw_` prefix).
func __saw_wake_nanos(d: Duration) -> Int {
    let ns = d.as_nanos()
    if ns >= (Int.max as UInt64) {
        return Int.max
    }
    ns as Int
}

// Duration is a trivial (POD) struct, so it auto-conforms to Equatable; the
// `@synthesize`d compare runs over the single `nanos` field, i.e. numeric order.
/// Durations order by length.
@synthesize
extension Duration: Comparable {
}

/// Durations print as a number and a unit.
extension Duration: Printable {
    /// Writes the span using the largest unit at or below its magnitude.
    ///
    /// Seconds carry two fractional digits; smaller units are whole. A span of
    /// 1_420_000_000ns writes as `1.42s`, and 230_000_000ns as `230ms`, then
    /// `5us`, then `42ns`.
    public func format(&self, into: &var StringBuilder) {
        let ns = self.nanos
        if ns >= NANOS_PER_SEC {
            let whole = ns / NANOS_PER_SEC
            let frac = (ns % NANOS_PER_SEC) / (NANOS_PER_SEC / CENTIS_PER_SEC)
            into.append(whole as UInt)
            into.append(".")
            if frac < (10 as UInt64) {
                into.append("0")
            }
            into.append(frac as UInt)
            into.append("s")
            return
        }
        if ns >= NANOS_PER_MILLI {
            into.append((ns / NANOS_PER_MILLI) as UInt)
            into.append("ms")
            return
        }
        if ns >= NANOS_PER_MICRO {
            into.append((ns / NANOS_PER_MICRO) as UInt)
            into.append("us")
            return
        }
        into.append(ns as UInt)
        into.append("ns")
    }
}
