// Box<T, A>: one `T` owned on the heap through allocator `A`. Hosted code
// writes `Box<T>`; a kernel writes `Box<Task, TaskSlab>` to place the value in
// a per-type slab. Box is NoCopy, and its `T` is released exactly once.
//
// The constructor is the static `make` so the allocator type parameter is
// named at the call site (`Box<T, TaskSlab>.make(...)`). The memberwise
// `Box(ptr:)` is a raw internal wrapper, not the API.

public struct Box<T, A: Allocator = GlobalAllocator> {
    // Always valid in a live Box: `make` returns `Err` without constructing one.
    private ptr: UnsafePointer<T>
}

extension Box<T, A: Allocator = GlobalAllocator> {
    /// Allocates one `T` through `A` and moves `value` into it, reporting
    /// allocator exhaustion as `Err(AllocError)`.
    ///
    /// On the failure path `value` is not moved anywhere, so it deinits at
    /// scope exit: the value is destroyed cleanly, never leaked.
    public static func make(value: T) unsafe -> Result<Box<T, A>, AllocError> {
        let size = sizeof<T>()
        let align = alignof<T>()
        if let raw = A().alloc(size, align) {
            let ptr = raw as UnsafePointer<T>
            // A placement move into fresh storage: no prior occupant to release
            // (LANGUAGE_SPEC "Placement writes").
            ptr[0] = move value
            return Box<T, A>(ptr: ptr)
        }
        return AllocError(size: size, align: align)
    }
}

extension Box<T, A: Allocator = GlobalAllocator>: NoCopy {
    public func deinit(&var self) unsafe {
        // Drop the payload in place, then free the chunk through this box's own
        // allocator `A`: a box with a custom allocator never falls back to
        // GlobalAllocator.
        __saw_deinit_in_place(self.ptr)
        let raw = self.ptr as UnsafePointer<Int8>
        A().dealloc(raw, sizeof<T>(), alignof<T>())
    }
}

// Lends the heap `T` where it sits, so it needs no bound and serves every
// payload, including the erased `Box<any Error>`. The use site decides the
// window: `b.value().method()` borrows, `b.value().n += 1` writes in place, and
// reading the place out as a value follows the payload's copy tier.
extension Box<T, A: Allocator = GlobalAllocator> {
    public func value(&var self) unsafe borrows -> &var T {
        lend self.ptr[0]
    }
}

// Payload method forwarding, as for Arc: a `&self` method of `T` not defined on
// Box is callable through the Box (`box.peek()` forwards to `T.peek()`). The
// compiler does it (typechecker `_resolve_arc_forward`); there is no Saw code.
// A `&var self` payload method is rejected, since aliased mutation through a
// handle is what `Mutex` exists to make safe.
