// Box<T, A> — a single owned heap allocation (design 42 item 1).
//
// `Box<T, A: Allocator = GlobalAllocator>` owns one `T` allocated through allocator `A`.
// Hosted code writes `Box<T>` (the default fills `A = GlobalAllocator`); a kernel writes
// `Box<Task, TaskSlab>` to place the value in a per-type slab — the design-19 §4
// "kernel idiom". Box is NoCopy: transferring it is a `move`, and its single
// heap `T` is released exactly once on deinit.
//
// FACTORY SURFACE (design 42 item 1, "report the surface chosen"): the
// constructor is a STATIC METHOD on Box, reached through the brief-28
// static-factory path — `Box<T>.make(v)`. Static methods
// on the generic struct were chosen over free `MakeBox`/`MakeBoxOr` functions
// because the struct's own type arguments (and their `A = GlobalAllocator` default) are
// supplied and defaulted at the call site by the same generics machinery
// `Vector(capacity:)` already uses, with no free-function type-inference gap.
// `make` IS the D4-pinned `MakeBox`; design 123's fallible twin `try_make`
// retired into it (design 234 — one operation, and it reports).
//
// There is no `init(value:)`: `make` is a static because the allocator type
// parameter is named at the call site (`Box<T, TaskSlab>.make(...)`), not
// because construction is special. A memberwise `Box(ptr:)` still exists (used
// internally) but is a raw wrapper, not the API.

public struct Box<T, A: Allocator = GlobalAllocator> {
    // Points directly at the heap `T`. Always valid in a live Box: `make`
    // returns `Err` without constructing one, so no inert/None state exists.
    ptr: UnsafePointer<T>
}

extension Box<T, A: Allocator = GlobalAllocator> {
    /// Allocates one `T` through `A` and moves `value` into it, reporting
    /// allocator exhaustion as `Err(AllocError)`.
    ///
    /// On the failure path `value` is not moved anywhere, so it deinits at
    /// scope exit: the value is destroyed cleanly, never leaked.
    public static func make(value: T) unsafe -> Result<Box<T, A>, AllocError> {
        let size = sizeof<T>()
        let align = alignof<T>()
        if let raw = A().alloc(size, align) {
            let ptr = raw as UnsafePointer<T>
            // PLACEMENT-MOVE (LANGUAGE_SPEC "Placement writes"): `ptr[0]` is an
            // uninitialized, freshly-allocated chunk, so this store bitwise-moves
            // `value` in and does NOT release any prior occupant. `value` is
            // consumed by the value-transfer checkpoint.
            ptr[0] = move value
            return Box<T, A>(ptr: ptr)
        }
        // `value` unmoved -> deinit'd at scope exit; surface the failure.
        return AllocError(size: size, align: align)
    }
}

// Deinit is registered before NoCopy so the `NoCopy: Deinit` supertrait
// requirement is already satisfied when NoCopy is checked (mirrors Task/Arc).
extension Box<T, A: Allocator = GlobalAllocator>: NoCopy {
    public func deinit(&var self) unsafe {
        // Release the LIVE payload in place (its own drop glue), THEN free the
        // chunk through THIS box's own allocator `A` — a Box<T, TaskSlab> frees
        // through the slab, never GlobalAllocator. Exactly one release of the payload.
        __saw_deinit_in_place(self.ptr)
        let raw = self.ptr as UnsafePointer<Int8>
        A().dealloc(raw, sizeof<T>(), alignof<T>())
    }
}

// Read accessor for a duplicable payload (design 42 item 1). Bounded
// `T: ExplicitCopy`: the body SPELLS `.copy()`, and that bound is the one that
// licenses the spelling (design 219). It admits the whole duplicable family —
// bitwise for a trivial T, a retain for a `String`, the type's own `copy()` for
// a `Vector` — and hands back a copy, leaving the box's own `T` intact. A
// move-only payload has no `.copy()`, so `value()` is simply unavailable there;
// reach such a payload through method forwarding (below) instead.
extension Box<T: ExplicitCopy, A: Allocator = GlobalAllocator> {
    public func value(&self) unsafe -> T {
        self.ptr[0].copy()
    }
}

// PAYLOAD METHOD FORWARDING (design 42 item 1, "like Arc"): an immutable `&self`
// method on the payload `T` that is NOT defined on Box itself is callable through
// the Box — `box.peek()` forwards to `T.peek()` — resolved and lowered by the
// compiler (typechecker `_resolve_arc_forward` keyed on struct name "Box";
// codegen borrows the payload at `ptr[0]`). A `&var self` payload method is
// REJECTED, same as through Arc: aliased mutation of owned-through-a-handle state
// is exactly what a `Mutex` payload exists to make safe. No Saw-level code is
// needed here; this comment documents where the mechanism lives.
