    /// A reinterpretation, never a conversion: `(1.0).to_bits()` is
    /// `4607182418800017408`, not `1`. This is what a float formatter, a
    /// hash, or a wire encoder needs, and it is the exact inverse of
    /// `Float.from(bits:)`.
    public func to_bits(&self) unsafe -> UInt64 {
        // Through the address of a local, which is the only reinterpretation
        // Saw offers. It folds to a single LLVM `bitcast` at every
        // optimization level, and sawc emits no aliasing metadata for one to
        // fall foul of.
        let value: Float = self
        ((&value) as UnsafePointer<UInt64>)[0]
    }

    /// The `Float` with exactly this bit pattern — `to_bits`'s inverse.
    ///
    /// Total: every one of the 2^64 patterns names a `Float`, NaNs and
    /// infinities included, so there is nothing to report.
    public static func from(bits: UInt64) unsafe -> Float {
        let value: UInt64 = bits
        ((&value) as UnsafePointer<Float>)[0]
    }

    /// Whether `self` is a NaN — the one value that is not equal to itself.
    public func is_nan(&self) -> Bool {
        self != self
    }

    /// Whether `self` is finite: neither an infinity nor a NaN.
    public func is_finite(&self) -> Bool {
        let e = self._raw_exponent()
        e != FLOAT_EXPONENT_ALL_ONES
    }

    /// Whether `self` is an infinity, of either sign.
    public func is_infinite(&self) -> Bool {
        (self._raw_exponent() == FLOAT_EXPONENT_ALL_ONES
            && self._raw_mantissa() == (0 as UInt64))
    }

    // The stored exponent field, 0..2047 — biased, and 0 for both zero and the
    // subnormals.
    func _raw_exponent(&self) -> Int {
        ((self.to_bits() >> FLOAT_MANTISSA_BITS) & FLOAT_EXPONENT_MASK) as Int
    }

    // The stored mantissa field, with no implicit leading bit restored.
    func _raw_mantissa(&self) -> UInt64 {
        self.to_bits() & FLOAT_MANTISSA_MASK
    }
}

// =============================================================================
// 128-bit integer helpers
//
// Saw has no `UInt128` and no widening multiply, so the 64x64 -> 128 product
// both algorithms rest on is assembled from 32-bit halves. No partial product
// exceeds 64 bits, so these use the ORDINARY checked operators — a wrapping
// `&*` here would hide a real overflow rather than express one.
// =============================================================================

static FLOAT_LOW_WORD_MASK: UInt64 = 0x0000_0000_FFFF_FFFF

// The high 64 bits of `a * b`.
func __float_mul_high(a: UInt64, b: UInt64) sync -> UInt64 {
    let a_lo = a & FLOAT_LOW_WORD_MASK
    let a_hi = a >> 32
    let b_lo = b & FLOAT_LOW_WORD_MASK
    let b_hi = b >> 32
    let p0 = a_lo * b_lo
    let p1 = a_lo * b_hi
    let p2 = a_hi * b_lo
    let p3 = a_hi * b_hi
    let mid = (p0 >> 32) + (p1 & FLOAT_LOW_WORD_MASK) + (p2 & FLOAT_LOW_WORD_MASK)
    p3 + (p1 >> 32) + (p2 >> 32) + (mid >> 32)
}

// The low 64 bits of `a * b`. Wrapping is the DEFINITION here — the high half
// is the caller's other question — so `&*` is the operator that says so.
func __float_mul_low(a: UInt64, b: UInt64) sync -> UInt64 {
    a &* b
}

// `(m * mul) >> shift` truncated to 64 bits, where `mul` is the 128-bit value
// `(high << 64) | low` and `shift` is in 65..127. Ryu's `mulShift64`.
//
// The product is 192 bits and only its top matters, so the low half of
// `m * low` is dropped: it can only carry into a bit the shift discards.
func __float_mul_shift(m: UInt64, low: UInt64, high: UInt64, shift: Int) sync -> UInt64 {
    let carry = __float_mul_high(m, low)
    let hi = __float_mul_high(m, high)
    let lo = __float_mul_low(m, high)
    let sum_lo = lo &+ carry
    let sum_hi = if sum_lo < lo { hi + 1 } else { hi }
    // Ryu only ever asks for 65..127 here (measured range 118..125), so the
    // `== 64` case a shift of exactly one word would need cannot arise — and
    // `x << 64` panics, so an unguarded one would be a live trap.
    let s = shift - 64
    (sum_hi << (64 - s)) | (sum_lo >> s)
}

// =============================================================================
// Ryu: the shortest decimal
// =============================================================================

// floor(log10(2^e)) for 0 <= e <= 1650.
func __float_log10_pow2(e: Int) sync -> Int {
    (e * 78913) >> 18
}

// floor(log10(5^e)) for 0 <= e <= 2620.
func __float_log10_pow5(e: Int) sync -> Int {
    (e * 732923) >> 20
}

// ceil(log2(5^e)) for 0 <= e < 3529 — the same closed form
// `tools/sawfloat.py` uses to build the tables, so the code and the data it
// indexes agree by construction.
func __float_pow5bits(e: Int) sync -> Int {
    ((e * 1217359) >> 19) + 1
}

// Whether `value` is divisible by 5^p.
func __float_multiple_of_pow5(value: UInt64, p: Int) sync -> Bool {
    var v = value
    var n = 0
    while n < p {
        if v % 5 != (0 as UInt64) {
            return false
        }
        v = v / 5
        n = n + 1
    }
    true
}

// Whether `value` is divisible by 2^p, for 0 <= p < 64.
func __float_multiple_of_pow2(value: UInt64, p: Int) sync -> Bool {
    let one: UInt64 = 1
    (value & ((one << p) - 1)) == (0 as UInt64)
}

// The number of decimal digits in `v`, which is at least 1.
func __float_decimal_length(v: UInt64) sync -> Int {
    var n = 1
    var probe = v
    while probe >= (10 as UInt64) {
        probe = probe / 10
        n = n + 1
    }
    n
}

extension Float {
    // THE SHORTEST DECIMAL: `(digits, exponent)` with `digits * 10^exponent`
    // the shortest decimal that reads back as `self`, and the nearest such
    // when several are equally short.
    //
    // Ryu's `d2d`, step for step (Adams, PLDI 2018). `self` must be finite and
    // non-zero — the renderer answers zero, the infinities and the NaNs before
    // reaching here, because none of them has a decimal interval to search.
    //
    // The three values named `vm`, `vr`, `vp` are the interval: the exact
    // value scaled into a decimal power base (`vr`) and the two halfway points
    // to its neighbours (`vm` below, `vp` above). Every decimal strictly
    // inside `[vm, vp]` reads back as `self`, so the shortest one is found by
    // dropping digits while the interval still contains a representable
    // number.
    func _shortest(&self) -> (UInt64, Int) {
        let raw_exponent = self._raw_exponent()
        let raw_mantissa = self._raw_mantissa()

        // Step 1: the exact value as `m2 * 2^e2`, with two bits of headroom so
        // the halfway points below are integers too.
        var e2 = 0
        var m2: UInt64 = 0
        if raw_exponent == 0 {
            e2 = 1 - FLOAT_EXPONENT_BIAS - FLOAT_MANTISSA_BITS - 2
            m2 = raw_mantissa
        } else {
            e2 = raw_exponent - FLOAT_EXPONENT_BIAS - FLOAT_MANTISSA_BITS - 2
            m2 = FLOAT_IMPLICIT_BIT | raw_mantissa
        }

        // An even mantissa owns its halfway points (round-half-to-even lands
        // back here), so the interval is CLOSED for it and open otherwise.
        let accept_bounds = (m2 % 2) == (0 as UInt64)

        // Step 2: the interval. `mv` is the value, `mv + 2` the upper halfway
        // point, `mv - 1 - mm_shift` the lower one — which is a half-step
        // closer when this value is the smallest of its binade, since its
        // predecessor is then twice as dense.
        let mv = 4 * m2
        let closer = raw_mantissa != (0 as UInt64) || raw_exponent <= 1
        let mm_shift: UInt64 = if closer { 1 } else { 0 }

        var vr: UInt64 = 0
        var vp: UInt64 = 0
        var vm: UInt64 = 0
        var e10 = 0
        var vm_is_trailing_zeros = false
        var vr_is_trailing_zeros = false

        // Step 3: into a decimal power base, with one 128-bit multiply per
        // interval endpoint.
        if e2 >= 0 {
            let q = __float_log10_pow2(e2) - (if e2 > 3 { 1 } else { 0 })
            e10 = q
            let k = FLOAT_POW5_INV_BITCOUNT + __float_pow5bits(q) - 1
            let shift = 0 - e2 + q + k
            let low = FLOAT_POW5_INV_SPLIT[2 * q]
            let high = FLOAT_POW5_INV_SPLIT[2 * q + 1]
            vr = __float_mul_shift(mv, low, high, shift)
            vp = __float_mul_shift(mv + 2, low, high, shift)
            vm = __float_mul_shift(mv - 1 - mm_shift, low, high, shift)
            // Past q = 21 no 55-bit value can carry 5^q, so the divisibility
            // questions below are all answered `no` and the tests are skipped.
            if q <= 21 {
                if mv % 5 == (0 as UInt64) {
                    vr_is_trailing_zeros = __float_multiple_of_pow5(mv, q)
                } else if accept_bounds {
                    vm_is_trailing_zeros = __float_multiple_of_pow5(mv - 1 - mm_shift, q)
                } else if __float_multiple_of_pow5(mv + 2, q) {
                    vp = vp - 1
                }
            }
        } else {
            let q = __float_log10_pow5(0 - e2) - (if (0 - e2) > 1 { 1 } else { 0 })
            e10 = q + e2
            let i = (0 - e2) - q
            let k = __float_pow5bits(i) - FLOAT_POW5_BITCOUNT
            let shift = q - k
            let low = FLOAT_POW5_SPLIT[2 * i]
            let high = FLOAT_POW5_SPLIT[2 * i + 1]
            vr = __float_mul_shift(mv, low, high, shift)
            vp = __float_mul_shift(mv + 2, low, high, shift)
            vm = __float_mul_shift(mv - 1 - mm_shift, low, high, shift)
            if q <= 1 {
                // {vr,vp,vm} is trailing-zero-free by construction here.
                vr_is_trailing_zeros = true
                if accept_bounds {
                    vm_is_trailing_zeros = mm_shift == (1 as UInt64)
                } else {
                    vp = vp - 1
                }
            } else if q < 63 {
                vr_is_trailing_zeros = __float_multiple_of_pow2(mv, q)
            }
        }

        // Step 4: drop digits while the interval still holds a value.
        var removed = 0
        var last_removed: UInt64 = 0
        var output: UInt64 = 0
        if vm_is_trailing_zeros || vr_is_trailing_zeros {
            // The exact-boundary case — around one value in two hundred, and
            // the only one where a dropped digit can be exactly a half.
            while vp / 10 > vm / 10 {
                vm_is_trailing_zeros = vm_is_trailing_zeros && vm % 10 == (0 as UInt64)
                vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed == (0 as UInt64)
                last_removed = vr % 10
                vr = vr / 10
                vp = vp / 10
                vm = vm / 10
                removed = removed + 1
            }
            if vm_is_trailing_zeros {
                while vm % 10 == (0 as UInt64) {
                    vr_is_trailing_zeros = vr_is_trailing_zeros && last_removed == (0 as UInt64)
                    last_removed = vr % 10
                    vr = vr / 10
                    vp = vp / 10
                    vm = vm / 10
                    removed = removed + 1
                }
            }
            let exact_half = (vr_is_trailing_zeros && last_removed == (5 as UInt64)
                              && vr % 2 == (0 as UInt64))
            if exact_half {
                // An exact half with an even digit below it: round to even,
                // which is what the reader will do coming back.
                last_removed = 4
            }
            let at_lower = (vr == vm
                            && (not accept_bounds || not vm_is_trailing_zeros))
            let round_up = at_lower || last_removed >= (5 as UInt64)
            let bump: UInt64 = if round_up { 1 } else { 0 }
            output = vr + bump
        } else {
            // The common case: no boundary is exact, so only the dropped
            // digit decides.
            var round_up = false
            if vp / 100 > vm / 100 {
                // Two digits at a time first — most values lose at least two.
                round_up = (vr % 100) >= (50 as UInt64)
                vr = vr / 100
                vp = vp / 100
                vm = vm / 100
                removed = removed + 2
            }
            while vp / 10 > vm / 10 {
                round_up = (vr % 10) >= (5 as UInt64)
                vr = vr / 10
                vp = vp / 10
                vm = vm / 10
                removed = removed + 1
            }
            let bump: UInt64 = if vr == vm || round_up { 1 } else { 0 }
            output = vr + bump
        }
        (output, e10 + removed)
    }
}

// =============================================================================
// Formatting
// =============================================================================

extension StringBuilder {
    /// Appends the shortest decimal text that reads back as `value`.
    ///
    /// THE float formatter. `Float.to_string` calls it, and so does every
    /// rendering the compiler emits — `print(f)`, `"{f}"`, `print("{}", f)`,
    /// a `panic`/`assert` format argument, and `f.format(into:)`. Adding a
    /// second one would be adding a second answer to "what does this number
    /// look like", which is how `%f` and `%g` came to disagree here before
    /// design 253.
    ///
    /// The digits are the shortest that round-trip (Ryu); the LAYOUT is
    /// CPython's `repr`, which is where this file's oracle comes from. Given
    /// those digits and `decpt` — the decimal point's place, so the value is
    /// `0.<digits> * 10^decpt`:
    ///
    ///   * zero is `0.0` or `-0.0`, keeping its sign;
    ///   * `decpt <= -4` or `decpt > 16` uses the exponent form: one leading
    ///     digit, then `.` and the rest only if there IS a rest, then `e`, a
    ///     mandatory sign, and at least two exponent digits — `1e+16`,
    ///     `5e-324`, `1.5e-07`;
    ///   * otherwise the fixed form, with `0.` and zero padding when the
    ///     point falls at or left of the first digit (`0.001`), and a
    ///     trailing `.0` when the digits run out at or before it (`100.0`);
    ///   * a NaN is `nan` and the infinities are `inf` / `-inf`. That is
    ///     Saw-facing text: JSON has no spelling for these and rejects them
    ///     (`sawc/std/JSON.md`).
    ///
    /// Allocation-free in the sense every `append` overload is: it writes
    /// bytes through the builder and stages nothing, so a FIXED builder
    /// renders a float with no allocator present. `Err(AllocError)` is the
    /// growable builder's own refusal, forwarded.
    public func append(&var self, value: Float) -> Result<Void, AllocError> {
        let bits = value.to_bits()
        let negative = (bits & FLOAT_SIGN_MASK) != (0 as UInt64)
        let raw_exponent = value._raw_exponent()
        let raw_mantissa = value._raw_mantissa()

        if raw_exponent == FLOAT_EXPONENT_ALL_ONES {
            if raw_mantissa != (0 as UInt64) {
                // Every NaN reads `nan`: the payload bits are not part of the
                // value, and no sign is shown for one either.
                return self.append("nan")
            }
            if negative {
                return self.append("-inf")
            }
            return self.append("inf")
        }
        if raw_exponent == 0 && raw_mantissa == (0 as UInt64) {
            if negative {
                return self.append("-0.0")
            }
            return self.append("0.0")
        }

        let (raw_digits, raw_exp10) = value._shortest()
        // Ryu's own loop leaves no trailing zero, but the layout below is
        // written against "digits with a decimal point somewhere in them" and
        // should not have to know that.
        var digits = raw_digits
        var exp10 = raw_exp10
        while digits >= (10 as UInt64) && digits % 10 == (0 as UInt64) {
            digits = digits / 10
            exp10 = exp10 + 1
        }

        let length = __float_decimal_length(digits)
        let decpt = exp10 + length

        // The digits, most significant first, in frame storage — the layout
        // needs them out of order (a point falls between two of them) and
        // there is no second pass over a builder.
        var text: [UInt8; 17] = [0; 17]
        var scale = digits
        var i = length - 1
        while i >= 0 {
            text[i] = UInt8.from(truncating: 48 + ((scale % 10) as Int))
            scale = scale / 10
            i = i - 1
        }

        if negative {
            let _ = try self.append(FLOAT_BYTE_MINUS)
        }

        if decpt <= FLOAT_FIXED_LOW || decpt > FLOAT_FIXED_HIGH {
            let _ = try self.append(Byte(text[0]))
            if length > 1 {
                let _ = try self.append(FLOAT_BYTE_DOT)
                var k = 1
                while k < length {
                    let _ = try self.append(Byte(text[k]))
                    k = k + 1
                }
            }
            let _ = try self.append(FLOAT_BYTE_E)
            let exponent = decpt - 1
            if exponent < 0 {
                let _ = try self.append(FLOAT_BYTE_MINUS)
            } else {
                let _ = try self.append(FLOAT_BYTE_PLUS)
            }
            let magnitude = if exponent < 0 { 0 - exponent } else { exponent }
            if magnitude < 10 {
                // At least two exponent digits, so `1e+16` and `1e-05` line up.
                let _ = try self.append(FLOAT_BYTE_ZERO)
            }
            return self.append(magnitude)
        }

        if decpt <= 0 {
            let _ = try self.append(FLOAT_BYTE_ZERO)
            let _ = try self.append(FLOAT_BYTE_DOT)
            var pad = 0
            while pad < 0 - decpt {
                let _ = try self.append(FLOAT_BYTE_ZERO)
                pad = pad + 1
            }
            var k = 0
            while k < length {
                let _ = try self.append(Byte(text[k]))
                k = k + 1
            }
            return
        }

        if decpt >= length {
            var k = 0
            while k < length {
                let _ = try self.append(Byte(text[k]))
                k = k + 1
            }
            var pad = 0
            while pad < decpt - length {
                let _ = try self.append(FLOAT_BYTE_ZERO)
                pad = pad + 1
            }
            let _ = try self.append(FLOAT_BYTE_DOT)
            return self.append(FLOAT_BYTE_ZERO)
        }

        var k = 0
        while k < decpt {
            let _ = try self.append(Byte(text[k]))
            k = k + 1
        }
        let _ = try self.append(FLOAT_BYTE_DOT)
        while k < length {
            let _ = try self.append(Byte(text[k]))
            k = k + 1
        }
        return
    }
}

// THE COMPILER'S ENTRY into the formatter above.
//
// `_value_to_string`'s FLOAT arm in `sawc/codegen/core.py` calls this by
// symbol, which is what routes `print(f)`, `"{f}"`, `print("{}", f)`, a
// `panic`/`assert` argument and `f.format(into:)` through the one formatter.
// It renders `value` into `out` — caller storage of at least `capacity` bytes,
// NUL-terminated on the way out, since the C-string shape is what the
// interpolation path already passes around — and answers the byte count.
//
// `capacity` must leave room: a fixed builder holds `capacity - 4` bytes of
// text, and the widest rendering is `FLOAT_TEXT_MAX`. Codegen passes 32.
func __float_to_chars(value: Float, out: UnsafePointer<Int8>,
                          capacity: Int) unsafe sync -> Int {
    var text = StringBuilder(bytes: out, capacity: capacity)
    let _ = try! text.append(value)
    text.len()
}

extension Float {
    /// The shortest decimal text that reads back as `self`.
    ///
    /// `(0.1 + 0.2).to_string()` is `"0.30000000000000004"` — the value, not a
    /// rounded picture of it — and `"...".to_float()` returns the identical
    /// bits. `StringBuilder.append(value: Float)` documents the layout and is
    /// the routine this calls.
    ///
    /// Allocates exactly once, for the `String`: the digits are rendered into
    /// frame storage through a fixed builder first. Like every other producer
    /// in the `String` layer, a refused allocation panics rather than
    /// returning (design 234's documented boundary).
    public func to_string(&self) unsafe -> String {
        // `FLOAT_TEXT_MAX` bytes of text plus the four a fixed builder holds
        // back for its truncation marker and terminator.
        var scratch: [Int8; 28] = [0; 28]
        var out = StringBuilder(bytes: (&var scratch) as UnsafePointer<Int8>,
                                capacity: 28)
        let _ = try! out.append(self)
        out.build()
    }
}

// =============================================================================
// Parsing
//
// Two algorithms, because one of them is fast and the other is always right.
//
// Eisel-Lemire (Lemire, "Number Parsing at a Gigabyte per Second", SPE 2021,
// after Michael Eisel) computes `significand * 10^exponent` from ONE 128-bit
// multiply against a truncated power of five, and knows when its own error
// bound leaves the answer undecided. That is the whole trick: it never guesses.
// It declines on roughly one input in a hundred and fifty here, plus every
// input with more than nineteen significant digits.
//
// What it declines to, the SIMPLE DECIMAL CONVERSION decides exactly
// (Clinger, "How to read floating point numbers accurately", PLDI 1990, over
// Steele and White's earlier machinery; Go's `strconv/decimal.go` is the
// canonical modern rendering). A decimal digit buffer is shifted by powers of
// two — doubling and halving a decimal are both exact — until the value sits
// in `[1, 2)`, and the mantissa is then read off with one rounding decision
// that has the whole remaining tail in view. No approximation enters it, so
// there is nothing left to be unsure about.
// =============================================================================

// The exponent range Eisel-Lemire's table spans. Outside it the answer needs no
// table: everything below is zero and everything above is infinite, because a
// significand is at most nineteen digits wide.
static FLOAT_LEMIRE_MIN_EXPONENT: Int = -342
static FLOAT_LEMIRE_MAX_EXPONENT: Int = 308
// `FLOAT_POW5_TRUNCATED` holds two words per entry, starting at the minimum.
static FLOAT_LEMIRE_TABLE_BASE: Int = 342
// The window where a product can land exactly on a rounding boundary, so the
// tie has to be broken toward even by hand.
static FLOAT_ROUND_EVEN_LOW: Int = -4
static FLOAT_ROUND_EVEN_HIGH: Int = 23
// The most significant digits that fit a `UInt64` (10^19 < 2^64), which is what
// the fast path's significand is.
static FLOAT_FAST_DIGITS: Int = 19
static FLOAT_ALL_ONES: UInt64 = 0xFFFF_FFFF_FFFF_FFFF
static FLOAT_LOW_NINE_BITS: UInt64 = 0x0000_0000_0000_01FF
static FLOAT_QUIET_NAN: UInt64 = 0x7FF8_0000_0000_0000
static FLOAT_INFINITY_BITS: UInt64 = 0x7FF0_0000_0000_0000

// A decimal exponent is clamped to this magnitude while it is being read. Past
// it every input is already zero or infinity, and the clamp is what keeps the
// accumulator from overflowing on `1e999999999999999999999`.
static FLOAT_EXPONENT_CLAMP: Int = 10_000_000

static FLOAT_BYTE_LOWER_E: Int = 101
static FLOAT_BYTE_UPPER_E: Int = 69
static FLOAT_BYTE_POINT: Int = 46
static FLOAT_BYTE_SIGN_MINUS: Int = 45
static FLOAT_BYTE_SIGN_PLUS: Int = 43
static FLOAT_BYTE_DIGIT_ZERO: Int = 48
static FLOAT_BYTE_DIGIT_NINE: Int = 57

// The shape of a numeric literal, as spans into the text it was read from.
// Nothing is copied out: the two digit spans are walked in place, which is what
// lets an 800-digit input cost no more than a short one until the exact path
// actually wants the digits.
struct FloatScan {
    valid: Bool,
    negative: Bool,
    integer_start: Int,
    integer_end: Int,
    fraction_start: Int,
    fraction_end: Int,
    exponent: Int
}

func __float_is_digit(b: Int) sync -> Bool {
    (b >= FLOAT_BYTE_DIGIT_ZERO && b <= FLOAT_BYTE_DIGIT_NINE)
}

// The count of leading zero bits in `v`, which must not be zero.
func __float_leading_zeros(v: UInt64) sync -> Int {
    var count = 0
    var bits = v
    while (bits & FLOAT_SIGN_MASK) == (0 as UInt64) {
        bits = bits << 1
        count = count + 1
    }
    count
}

// `significand * 10^exponent` as IEEE bits, or `None` when the 128-bit
// approximation cannot decide and the exact path has to. `significand` must be
// nonzero.
//
// Eisel-Lemire's `compute_float`. The one thing to hold onto reading it: every
// `return None` is the algorithm declining, never failing — the caller answers
// the same question exactly, just slower.
func __float_lemire(significand: UInt64, exponent: Int,
                    negative: Bool) sync -> UInt64? {
    let sign: UInt64 = if negative { FLOAT_SIGN_MASK } else { 0 }
    if exponent < FLOAT_LEMIRE_MIN_EXPONENT {
        return sign                        // below every subnormal
    }
    if exponent > FLOAT_LEMIRE_MAX_EXPONENT {
        return sign | FLOAT_INFINITY_BITS
    }

    // Normalize the significand so its top bit is bit 63, which is what makes
    // the product's error bound hold.
    let shift = __float_leading_zeros(significand)
    let normalized = significand << shift

    let index = 2 * (exponent + FLOAT_LEMIRE_TABLE_BASE)
    let table_high = FLOAT_POW5_TRUNCATED[index]
    let table_low = FLOAT_POW5_TRUNCATED[index + 1]

    var high = __float_mul_high(normalized, table_high)
    var low = __float_mul_low(normalized, table_high)
    if (high & FLOAT_LOW_NINE_BITS) == FLOAT_LOW_NINE_BITS {
        // The truncated table entry may not be enough: bring in its low half.
        if high == FLOAT_ALL_ONES {
            return None                    // the carry below has nowhere to go
        }
        let second = __float_mul_high(normalized, table_low)
        let merged = low &+ second
        if second > merged {
            high = high + 1
        }
        low = merged
    }
    if low == FLOAT_ALL_ONES && (high & FLOAT_LOW_NINE_BITS) == FLOAT_LOW_NINE_BITS {
        return None                        // undecided: the exact path decides
    }

    let upper_bit = (high >> 63) as Int
    // 52 explicit mantissa bits plus three of headroom for the rounding below.
    var mantissa = high >> (upper_bit + 64 - FLOAT_MANTISSA_BITS - 3)
    // floor(log2(10^exponent)) is `(217706 * exponent) >> 16` over this range;
    // `>>` on a negative `Int` floors, which is what a negative exponent needs.
    var power = ((217706 * exponent) >> 16) + 63 + upper_bit - shift
    power = power + FLOAT_EXPONENT_BIAS

    if power <= 0 {
        // A subnormal, or below one.
        if (0 - power) + 1 >= 64 {
            return sign
        }
        var subnormal = mantissa >> ((0 - power) + 1)
        subnormal = subnormal + (subnormal & 1)
        subnormal = subnormal >> 1
        let stored: UInt64 = if subnormal < FLOAT_IMPLICIT_BIT { 0 } else { 1 }
        return sign | (stored << FLOAT_MANTISSA_BITS) | (subnormal & FLOAT_MANTISSA_MASK)
    }

    // An exactly-halfway product, which only the round-to-even rule settles.
    // Only reachable in the narrow exponent window where 10^exponent is itself
    // exactly representable.
    let maybe_tie = (low <= (1 as UInt64) && exponent >= FLOAT_ROUND_EVEN_LOW
                     && exponent <= FLOAT_ROUND_EVEN_HIGH
                     && (mantissa & 3) == (1 as UInt64))
    if maybe_tie {
        if (mantissa << (upper_bit + 64 - FLOAT_MANTISSA_BITS - 3)) == high {
            mantissa = mantissa - (mantissa & 1)
        }
    }
    mantissa = mantissa + (mantissa & 1)
    mantissa = mantissa >> 1
    if mantissa >= (2 * FLOAT_IMPLICIT_BIT) {
        // The rounding carried into a new binade.
        mantissa = FLOAT_IMPLICIT_BIT
        power = power + 1
    }
    mantissa = mantissa - (mantissa & FLOAT_IMPLICIT_BIT)
    if power >= FLOAT_EXPONENT_ALL_ONES {
        return sign | FLOAT_INFINITY_BITS
    }
    return sign | ((power as UInt64) << FLOAT_MANTISSA_BITS) | mantissa
}

// =============================================================================
// The exact path: a decimal shifted by powers of two
// =============================================================================

// Digits kept. Go's bound, and the reasoning is the same: the widest input that
// can still change a rounding decision is bounded, and anything past this is
// recorded as "something nonzero was dropped", which is all the rounding needs.
static FLOAT_PARSE_DIGITS_MAX: Int = 800
// The largest shift one pass can take: the working accumulator is
// `digit * 2^k + carry` and must fit a `UInt64`, so `10 * 2^k` must.
static FLOAT_MAX_SHIFT: Int = 60
// How many bits to shift for a decimal point `i` places out — floor(i*log2(10)),
// so a shift moves the point toward zero without stepping past it.
static FLOAT_POWER_TABLE: [Int; 9] = [1, 3, 6, 9, 13, 16, 19, 23, 26]
static FLOAT_POWER_TABLE_TAIL: Int = 27
// Past these the answer needs no work: a decimal point 310 places right of the
// digits is infinite and 330 places left of them is zero.
static FLOAT_DECIMAL_MAX_POINT: Int = 310
static FLOAT_DECIMAL_MIN_POINT: Int = -330

// A decimal number as its digits: `0.<digits> * 10^point`, one digit VALUE
// (0..9, not ASCII) per byte.
//
// `truncated` is the whole reason the buffer may be finite. Digits past the
// end are dropped, and the flag says a nonzero one was — which is exactly the
// input the round-half-to-even rule needs to break a tie the other way.
struct FloatDecimal {
    digits: [UInt8; 800],
    count: Int,
    point: Int,
    negative: Bool,
    truncated: Bool
}

extension FloatDecimal {
    static func empty() -> FloatDecimal {
        FloatDecimal(digits: [0; 800], count: 0, point: 0, negative: false,
                     truncated: false)
    }

    func push(&var self, digit: Int) {
        if self.count < FLOAT_PARSE_DIGITS_MAX {
            self.digits[self.count] = UInt8.from(truncating: digit)
            self.count = self.count + 1
        } else if digit != 0 {
            self.truncated = true
        }
    }

    // Trailing zeros carry no information and would only lengthen every shift.
    func trim(&var self) {
        while self.count > 0 && self.digits[self.count - 1] == (0 as UInt8) {
            self.count = self.count - 1
        }
        if self.count == 0 {
            self.point = 0
        }
    }

    // Divide by 2^shift, exactly. Long division over the digits, one pass.
    //
    // The accumulator never overflows: the loop condition holds it below
    // `2^shift`, and `n * 10 + 9 < 10 * 2^60` fits a `UInt64` — which is what
    // `FLOAT_MAX_SHIFT` is.
    func halve(&var self, shift: Int) {
        var read = 0
        var write = 0
        var n: UInt64 = 0
        let one: UInt64 = 1
        while (n >> shift) == (0 as UInt64) {
            if read >= self.count {
                if n == (0 as UInt64) {
                    self.count = 0
                    return
                }
                while (n >> shift) == (0 as UInt64) {
                    n = n * 10
                    read = read + 1
                }
                break
            }
            n = n * 10 + (self.digits[read] as UInt64)
            read = read + 1
        }
        self.point = self.point - (read - 1)
        let mask = (one << shift) - 1
        while read < self.count {
            let carried = self.digits[read] as UInt64
            let digit = n >> shift
            n = n & mask
            self.digits[write] = UInt8.from(truncating: digit)
            write = write + 1
            n = n * 10 + carried
            read = read + 1
        }
        while n > (0 as UInt64) {
            let digit = n >> shift
            n = n & mask
            if write < FLOAT_PARSE_DIGITS_MAX {
                self.digits[write] = UInt8.from(truncating: digit)
                write = write + 1
            } else if digit > (0 as UInt64) {
                self.truncated = true
            }
            n = n * 10
        }
        self.count = write
        self.trim()
    }

    // Multiply by 2^shift, exactly. Written right to left, so it needs to know
    // up front how many new leading digits there will be.
    //
    // That count is `floor(shift * log10(2))` or one more, and this uses the
    // upper bound and strips the at-most-one leading zero afterwards. Go
    // carries a table of 61 decimal cutoffs to get it exactly; the bound plus a
    // strip is the same answer for one multiply and a short loop.
    func double(&var self, shift: Int) {
        let delta = ((shift * 30103) / 100000) + 1
        var read = self.count - 1
        var write = self.count + delta
        var n: UInt64 = 0
        while read >= 0 {
            n = n + ((self.digits[read] as UInt64) << shift)
            let quotient = n / 10
            let remainder = n - 10 * quotient
            write = write - 1
            // `write` cannot go negative — `delta` is an upper bound — and a
            // parser may not panic on its input, so the guard is written
            // rather than reasoned about.
            if write >= 0 && write < FLOAT_PARSE_DIGITS_MAX {
                self.digits[write] = UInt8.from(truncating: remainder)
            } else if remainder != (0 as UInt64) {
                self.truncated = true
            }
            n = quotient
            read = read - 1
        }
        while n > (0 as UInt64) {
            let quotient = n / 10
            let remainder = n - 10 * quotient
            write = write - 1
            if write >= 0 && write < FLOAT_PARSE_DIGITS_MAX {
                self.digits[write] = UInt8.from(truncating: remainder)
            } else if remainder != (0 as UInt64) {
                self.truncated = true
            }
            n = quotient
        }
        // Whatever the write did not reach is a leading zero the bound
        // over-allocated.
        while write > 0 {
            write = write - 1
            if write < FLOAT_PARSE_DIGITS_MAX {
                self.digits[write] = 0
            }
        }
        self.count = self.count + delta
        if self.count > FLOAT_PARSE_DIGITS_MAX {
            self.count = FLOAT_PARSE_DIGITS_MAX
        }
        self.point = self.point + delta
        var zeros = 0
        while zeros < self.count && self.digits[zeros] == (0 as UInt8) {
            zeros = zeros + 1
        }
        if zeros > 0 {
            var i = zeros
            while i < self.count {
                self.digits[i - zeros] = self.digits[i]
                i = i + 1
            }
            self.count = self.count - zeros
            self.point = self.point - zeros
        }
        self.trim()
    }

    // Multiply by 2^shift (or divide, for a negative one), in passes no wider
    // than the accumulator can hold.
    func shift(&var self, amount: Int) {
        if self.count == 0 {
            return
        }
        var remaining = amount
        if remaining > 0 {
            while remaining > FLOAT_MAX_SHIFT {
                self.double(FLOAT_MAX_SHIFT)
                remaining = remaining - FLOAT_MAX_SHIFT
            }
            self.double(remaining)
            return
        }
        remaining = 0 - remaining
        while remaining > FLOAT_MAX_SHIFT {
            self.halve(FLOAT_MAX_SHIFT)
            remaining = remaining - FLOAT_MAX_SHIFT
        }
        self.halve(remaining)
    }

    // Whether the digits from `at` onward round the value up.
    //
    // The tie — a lone `5` with nothing after it — is where `truncated` earns
    // its keep: a dropped nonzero digit means the value is ABOVE the halfway
    // point and rounds up, where an exact half rounds to even.
    func should_round_up(&self, at: Int) -> Bool {
        if at < 0 || at >= self.count {
            return false
        }
        if self.digits[at] == (5 as UInt8) && at + 1 == self.count {
            if self.truncated {
                return true
            }
            return (at > 0 && (self.digits[at - 1] % 2) != (0 as UInt8))
        }
        self.digits[at] >= (5 as UInt8)
    }

    // The integer part, rounded. Only ever called once the value has been
    // shifted into the mantissa's range, so it fits a `UInt64`.
    func rounded_integer(&self) -> UInt64 {
        if self.point > 20 {
            return FLOAT_ALL_ONES
        }
        var n: UInt64 = 0
        var i = 0
        while i < self.point && i < self.count {
            n = n * 10 + (self.digits[i] as UInt64)
            i = i + 1
        }
        while i < self.point {
            n = n * 10
            i = i + 1
        }
        if self.should_round_up(self.point) {
            n = n + 1
        }
        n
    }

    // The nearest `Float` to this decimal, as IEEE bits. Consumes the decimal
    // (the shifts rewrite it in place).
    func to_bits(&var self) -> UInt64 {
        let sign: UInt64 = if self.negative { FLOAT_SIGN_MASK } else { 0 }
        if self.count == 0 {
            return sign
        }
        if self.point > FLOAT_DECIMAL_MAX_POINT {
            return sign | FLOAT_INFINITY_BITS
        }
        if self.point < FLOAT_DECIMAL_MIN_POINT {
            return sign
        }

        // Scale by powers of two until the value sits in [0.5, 1).
        var power = 0
        while self.point > 0 {
            var step = FLOAT_POWER_TABLE_TAIL
            if self.point < 9 {
                step = FLOAT_POWER_TABLE[self.point]
            }
            self.shift(0 - step)
            power = power + step
        }
        var below_half = (self.point == 0 && self.digits[0] < (5 as UInt8))
        while self.point < 0 || below_half {
            let distance = 0 - self.point
            var step = FLOAT_POWER_TABLE_TAIL
            if distance < 9 {
                step = FLOAT_POWER_TABLE[distance]
            }
            self.shift(step)
            power = power - step
            below_half = (self.point == 0 && self.digits[0] < (5 as UInt8))
        }

        // [0.5, 1) is where that leaves it; a significand's range is [1, 2).
        power = power - 1

        // Below the smallest normal exponent the value is a subnormal, which is
        // spelled by shifting further right rather than by a smaller exponent.
        let minimum = 1 - FLOAT_EXPONENT_BIAS
        if power < minimum {
            let back = minimum - power
            self.shift(0 - back)
            power = power + back
        }
        if power + FLOAT_EXPONENT_BIAS >= FLOAT_EXPONENT_ALL_ONES {
            return sign | FLOAT_INFINITY_BITS
        }

        self.shift(1 + FLOAT_MANTISSA_BITS)
        var mantissa = self.rounded_integer()
        if mantissa == 2 * FLOAT_IMPLICIT_BIT {
            // The rounding carried into a new binade.
            mantissa = mantissa >> 1
            power = power + 1
            if power + FLOAT_EXPONENT_BIAS >= FLOAT_EXPONENT_ALL_ONES {
                return sign | FLOAT_INFINITY_BITS
            }
        }
        var stored = power + FLOAT_EXPONENT_BIAS
        if (mantissa & FLOAT_IMPLICIT_BIT) == (0 as UInt64) {
            stored = 0                     // subnormal: no implicit leading bit
        }
        let field = (stored as UInt64) & FLOAT_EXPONENT_MASK
        sign | (field << FLOAT_MANTISSA_BITS) | (mantissa & FLOAT_MANTISSA_MASK)
    }
}

// =============================================================================
// `String.to_float`
// =============================================================================

extension String {
    // The `k`th significand digit, reading the integer span and then the
    // fraction span as one sequence.
    func _float_digit(&self, scan: FloatScan, k: Int) -> Int {
        let integer_length = scan.integer_end - scan.integer_start
        if k < integer_length {
            return (self.byte_at(scan.integer_start + k) as Int) - FLOAT_BYTE_DIGIT_ZERO
        }
        let offset = k - integer_length
        (self.byte_at(scan.fraction_start + offset) as Int) - FLOAT_BYTE_DIGIT_ZERO
    }

    // Validate the whole string against the grammar and record where its parts
    // are. Whole-string: a trailing byte the grammar does not admit is a
    // rejection, not a place to stop.
    func _float_scan(&self) -> FloatScan {
        let rejected = FloatScan(valid: false, negative: false, integer_start: 0,
                                 integer_end: 0, fraction_start: 0,
                                 fraction_end: 0, exponent: 0)
        let length = self.len()
        if length == 0 {
            return rejected
        }
        var i = 0
        var negative = false
        let first = self.byte_at(0) as Int
        if first == FLOAT_BYTE_SIGN_MINUS {
            negative = true
            i = 1
        } else if first == FLOAT_BYTE_SIGN_PLUS {
            i = 1
        }

        let integer_start = i
        while i < length && __float_is_digit(self.byte_at(i) as Int) {
            i = i + 1
        }
        let integer_end = i

        var fraction_start = i
        var fraction_end = i
        if i < length && (self.byte_at(i) as Int) == FLOAT_BYTE_POINT {
            i = i + 1
            fraction_start = i
            while i < length && __float_is_digit(self.byte_at(i) as Int) {
                i = i + 1
            }
            fraction_end = i
        }
        if integer_end == integer_start && fraction_end == fraction_start {
            return rejected            // "", ".", "+", "e5"
        }

        var exponent = 0
        if i < length {
            let marker = self.byte_at(i) as Int
            if marker != FLOAT_BYTE_LOWER_E && marker != FLOAT_BYTE_UPPER_E {
                return rejected        // trailing junk
            }
            i = i + 1
            var exponent_negative = false
            if i < length {
                let exponent_sign = self.byte_at(i) as Int
                if exponent_sign == FLOAT_BYTE_SIGN_MINUS {
                    exponent_negative = true
                    i = i + 1
                } else if exponent_sign == FLOAT_BYTE_SIGN_PLUS {
                    i = i + 1
                }
            }
            if i >= length {
                return rejected        // `e` with no digits after it
            }
            var magnitude = 0
            while i < length {
                let b = self.byte_at(i) as Int
                if not __float_is_digit(b) {
                    return rejected
                }
                if magnitude < FLOAT_EXPONENT_CLAMP {
                    magnitude = magnitude * 10 + (b - FLOAT_BYTE_DIGIT_ZERO)
                }
                i = i + 1
            }
            exponent = if exponent_negative { 0 - magnitude } else { magnitude }
        }
        FloatScan(valid: true, negative: negative, integer_start: integer_start,
                  integer_end: integer_end, fraction_start: fraction_start,
                  fraction_end: fraction_end, exponent: exponent)
    }

    // The exact path, in its own function so that its 800-byte digit buffer is
    // a frame only the inputs that need it ever pay for.
    func _float_exact(&self, scan: FloatScan, lead: Int, total: Int,
                      exponent: Int) -> UInt64 {
        var decimal = FloatDecimal.empty()
        decimal.negative = scan.negative
        var k = lead
        while k < total {
            decimal.push(self._float_digit(scan, k))
            k = k + 1
        }
        // The point sits after every significant digit, wherever the exponent
        // then moves it — counted before trimming, since a trailing zero that
        // is dropped still held a place.
        decimal.point = (total - lead) + exponent
        decimal.trim()
        decimal.to_bits()
    }

    // The non-finite spellings `Float.to_string` produces, and only those:
    // `Infinity`, `NaN` and any other casing are not numbers here.
    func _float_nonfinite(&self) -> UInt64? {
        if self.equals("nan") || self.equals("-nan") || self.equals("+nan") {
            return FLOAT_QUIET_NAN
        }
        if self.equals("inf") || self.equals("+inf") {
            return FLOAT_INFINITY_BITS
        }
        if self.equals("-inf") {
            return FLOAT_INFINITY_BITS | FLOAT_SIGN_MASK
        }
        None
    }

    /// Parses the whole string as a `Float`, correctly rounded, or `None`.
    ///
    /// THE float parser, and the exact inverse of `Float.to_string`: every
    /// finite input maps to the NEAREST double, ties to even, with overflow
    /// saturating to an infinity and underflow to a subnormal or a signed zero,
    /// per IEEE 754. `"0.30000000000000004".to_float()` is the same bits
    /// `0.1 + 0.2` produces, and every one of the 2897 committed vectors round
    /// trips both ways.
    ///
    /// The grammar, whole-string with no trimming — the same contract
    /// `to_int`/`to_uint` keep:
    ///
    /// ```text
    /// sign? ( digits ('.' digits?)? | '.' digits ) ([eE] sign? digits)?
    /// sign? ('nan' | 'inf')
    /// ```
    ///
    /// So `"1e3"`, `"+.5"`, `"1."` and `"-inf"` are numbers; `" 1"`, `"1 "`,
    /// `"1_000"`, `"0x1p3"`, `"Infinity"` and `"NaN"` are `None`. Hex floats
    /// are not accepted.
    ///
    /// Panic-free on every input, including a hostile one: an 800-digit
    /// significand and an exponent of `1e999999999` are both ordinary answers.
    ///
    /// It used to be a naive left-to-right accumulation in `Float` arithmetic,
    /// documented as not correctly rounded — the last ULP could differ, and
    /// long or extreme inputs were simply wrong. Nothing about the signature
    /// changed.
    public func to_float(&self) -> Float? {
        if let bits = self._float_nonfinite() {
            return Float.from(bits: bits)
        }
        let scan = self._float_scan()
        if not scan.valid {
            return None
        }
        let integer_length = scan.integer_end - scan.integer_start
        let fraction_length = scan.fraction_end - scan.fraction_start
        let total = integer_length + fraction_length

        // Leading zeros are not significant digits; they only say where the
        // point is, which the exponent below already carries.
        var lead = 0
        while lead < total && self._float_digit(scan, lead) == 0 {
            lead = lead + 1
        }
        let sign: UInt64 = if scan.negative { FLOAT_SIGN_MASK } else { 0 }
        if lead == total {
            return Float.from(bits: sign)      // every digit was a zero
        }
        let exponent = scan.exponent - fraction_length
        let significant = total - lead

        // The fast path takes the first nineteen significant digits, and only
        // runs when nothing nonzero was dropped past them.
        var significand: UInt64 = 0
        var used = 0
        var truncated = false
        var k = lead
        while k < total {
            let digit = self._float_digit(scan, k)
            if used < FLOAT_FAST_DIGITS {
                significand = significand * 10 + (digit as UInt64)
                used = used + 1
            } else if digit != 0 {
                truncated = true
            }
            k = k + 1
        }
        if not truncated {
            // Digits dropped from the tail were zeros, so they scale the
            // exponent; and trailing zeros inside the significand move there
            // too, which keeps more inputs inside the table's window.
            var fast_exponent = exponent + (significant - used)
            while significand >= (10 as UInt64) && significand % 10 == (0 as UInt64) {
                significand = significand / 10
                fast_exponent = fast_exponent + 1
            }
            if let bits = __float_lemire(significand, fast_exponent, scan.negative) {
                return Float.from(bits: bits)
            }
        }
        Float.from(bits: self._float_exact(scan, lead, total, exponent))
    }
}
