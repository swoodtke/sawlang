// Arc<T> - atomic reference-counted shared ownership
// Part of the Saw standard library (design 21 item 2, design 16 Arc notes).
//
// One heap control block laid out as { i64 strong, i64 weak, T payload },
// allocated through the runtime seams (never libc directly). The weak count is
// RESERVED NOW as ABI (init 1 = the strong refs' collective weak) even though
// `Weak` does not ship in v1 - retrofitting it would change this layout.
//
// Arc is `Copy + Deinit`:
//   - copy()  = retain: atomic add (monotonic) on strong.
//   - deinit() = release: atomic sub (release) on strong; the thread that takes
//     strong to 0 issues an acquire fence, runs the payload's drop glue in
//     place, then decrements weak (release); at weak 0 it fences acquire and
//     frees the whole block. This is the two-phase protocol of design 07/16.

extern "C" {
    // Atomic seams, emitted by codegen (see core.py _declare_atomic_runtime);
    // ordering per design 07's Arc protocol.
    func __saw_atomic_add_i64(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_sub_i64_release(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_fence_acquire()
}

public struct Arc<T> {
    // Points at the control block's byte 0 (the strong count). Always live in a
    // constructed Arc — `init` panics rather than build an inert one (design
    // 123). The field keeps its optional TYPE because codegen's payload-method
    // forwarding reads this exact `{ i1, i8* }` layout out of the Arc struct;
    // the `None` case is unreachable, not a state the library can produce.
    ptr: UnsafePointer<Int8>?
}

// The thread-safety `Arc` has always had, said out loud (design 186 — it used
// to be an entry in a list of names the compiler kept). The control block's
// pointer is what blocks the derivation, and it is exactly what the unsafe
// domain owns here: the strong/weak counts are updated with atomic
// read-modify-writes, so handing a second handle to another thread is safe when
// the PAYLOAD is safe to move there and safe to share there. Both halves are
// required — an `Arc` shares its payload by construction.
extension Arc<T: Send + Sync>: UnsafeSend {}
extension Arc<T: Send + Sync>: UnsafeSync {}

extension Arc<T> {
    /// Constructs a fresh `Arc` owning `value` (strong = 1, weak = 1).
    ///
    /// Panics if the allocator refuses the control block (design 123,
    /// infallible tier). It used to build an INERT `Arc` — `value` silently
    /// dropped, `strong_count()` reporting 0, and any forwarded payload method
    /// dereferencing a null block. `try_make` reports the failure instead.
    public init(value: T) unsafe -> Arc<T> {
        let size = 16 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            let strong_ptr = block as UnsafePointer<Int>
            strong_ptr[0] = 1
            let weak_ptr = (block + 8) as UnsafePointer<Int>
            weak_ptr[0] = 1
            let payload_ptr = (block + 16) as UnsafePointer<T>
            payload_ptr[0] = value
            Arc<T>(ptr: block)
        } else {
            panic("Arc(value:): allocation failed")
        }
    }

    /// Constructs a fresh `Arc` owning `value`, reporting allocator exhaustion
    /// as `Err(AllocError)`.
    ///
    /// `value` is destroyed on the failure path rather than leaked.
    public func try_make(value: T) unsafe -> Result<Arc<T>, AllocError> {
        let size = 16 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            let strong_ptr = block as UnsafePointer<Int>
            strong_ptr[0] = 1
            let weak_ptr = (block + 8) as UnsafePointer<Int>
            weak_ptr[0] = 1
            let payload_ptr = (block + 16) as UnsafePointer<T>
            payload_ptr[0] = value
            return Arc<T>(ptr: block)
        }
        return AllocError(size: size, align: 16)
    }

    // Number of strong owners (for tests/diagnostics; a racy snapshot). The
    // `else` is unreachable — see the field comment.
    public func strong_count(&self) unsafe -> Int {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            strong_ptr[0]
        } else {
            0
        }
    }

    /// Runs `body` on a `&var` borrow of the payload when this handle is the
    /// only strong owner, and hands back what `body` returned. Answers `None`
    /// — without running `body` — when the value is shared.
    ///
    /// This is the copy-on-write gate. Mutating a shared payload through an
    /// `Arc` is otherwise impossible by construction: payload-method forwarding
    /// (design 21b) passes `&self` methods through and refuses `&var self` ones,
    /// because an aliased write is what `Mutex` exists to make safe. Uniqueness
    /// is the other sound answer — nobody else can observe a write to a value
    /// only you hold — and this method is that answer, with the test and the
    /// access fused so the count cannot go stale between them.
    ///
    /// ```saw
    /// var solo = Arc<Counter>(value: Counter(n: 0))
    /// if let n = solo.with_unique({ c in c.bump()  c.n }) { print(n) }   // 1
    ///
    /// let shared = solo.copy()
    /// solo.with_unique({ c in c.bump()  c.n })                          // None
    /// ```
    ///
    /// The `None` arm is the caller's cue to clone and write to the clone, which
    /// is how `Data` gets value semantics over shared storage.
    ///
    /// The uniqueness this reports is single-threaded. `strong_count()` alone is
    /// a racy snapshot; what makes the answer here trustworthy is the `&var
    /// self` borrow, which stops any new reference being taken from this handle
    /// while the window is open. Sharing a value across tasks still goes through
    /// `Mutex` — a count of 1 says nothing about a handle another thread holds.
    public func with_unique<R>(&var self, body: (&var T) sync -> R) unsafe -> R? {
        guard let block = self.ptr else {
            return None
        }
        let strong_ptr = block as UnsafePointer<Int>
        if strong_ptr[0] != 1 {
            return None
        }
        return body((block + 16) as UnsafePointer<T>)
    }
}

// Arc's copy policy is Copy — a copy is a refcount bump — and its
// `deinit` lives inside that conformance (design 131: `Deinit` is the policy
// hierarchy's base, inherited, never declared on its own).
extension Arc<T>: Copy {
    public func deinit(&var self) unsafe {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            let old = __saw_atomic_sub_i64_release(strong_ptr, 1)
            if old == 1 {
                // Last strong owner observed strong -> 0. Order every other
                // thread's final payload reads before we tear it down.
                __saw_atomic_fence_acquire()
                let payload_ptr = (block + 16) as UnsafePointer<T>
                __saw_deinit_in_place(payload_ptr)
                // Release the strong refs' collective weak count.
                let weak_ptr = (block + 8) as UnsafePointer<Int>
                let wold = __saw_atomic_sub_i64_release(weak_ptr, 1)
                if wold == 1 {
                    __saw_atomic_fence_acquire()
                    GlobalAllocator().dealloc(block, 16 + sizeof<T>(), 16)
                }
            }
        }
    }

    // Retain: a live reference keeps the block alive, so monotonic is enough.
    public func copy(&self) unsafe -> Arc<T> {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            __saw_atomic_add_i64(strong_ptr, 1)
        }
        Arc<T>(ptr: self.ptr)
    }
}
