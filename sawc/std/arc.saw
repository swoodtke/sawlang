// Arc<T>: atomic reference-counted shared ownership.
//
// One heap control block, { i64 strong, i64 weak, T payload }, allocated
// through the allocator (never libc directly). The weak count is reserved as ABI (init 1
// = the strong refs' collective weak) although `Weak` does not exist yet;
// adding it later must not change this layout.
//
// copy() retains: atomic add (monotonic) on strong. deinit() releases: atomic
// sub (release) on strong; the thread that takes strong to 0 fences acquire,
// drops the payload in place, then decrements weak (release); at weak 0 it
// fences acquire and frees the block.

extern "C" {
    // Atomic seams emitted by codegen (core.py `_declare_atomic_runtime`).
    func __saw_atomic_add_i64(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_sub_i64_release(ptr: UnsafePointer<Int>, delta: Int) -> Int
    func __saw_atomic_fence_acquire()
}

public struct Arc<T> {
    // Points at the control block's strong count. Always `Some` in a
    // constructed Arc: `init` reports allocator failure instead of building
    // one. The field stays optional because codegen's payload-method
    // forwarding reads this exact `{ i1, i8* }` layout; the `None` arms are
    // unreachable.
    private ptr: UnsafePointer<Int8>?
}

// The counts are updated with atomic read-modify-writes, so a handle may cross
// threads when the payload may be both moved and shared there. Both bounds are
// required: an `Arc` shares its payload by construction (design 186).
extension Arc<T: Send + Sync>: UnsafeSend {}
extension Arc<T: Send + Sync>: UnsafeSync {}

extension Arc<T> {
    /// Constructs a fresh `Arc` owning `value` (strong = 1, weak = 1),
    /// reporting allocator exhaustion as `Err(AllocError)`.
    ///
    /// `value` is destroyed on the failure path rather than leaked.
    public init(value: T) unsafe -> Result<Arc<T>, AllocError> {
        let size = 16 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            let strong_ptr = block as UnsafePointer<Int>
            strong_ptr[0] = 1
            let weak_ptr = (block + 8) as UnsafePointer<Int>
            weak_ptr[0] = 1
            let payload_ptr = (block + 16) as UnsafePointer<T>
            payload_ptr[0] = value
            return Arc<T>(ptr: block)
        }
        return AllocError(size: size, align: 16)
    }

    // Number of strong owners (for tests/diagnostics; a racy snapshot). The
    // `else` is unreachable — see the field comment.
    public func strong_count(&self) unsafe -> Int {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            strong_ptr[0]
        } else {
            0
        }
    }

    /// Runs `body` on a `&var` borrow of the payload when this handle is the
    /// only strong owner, and hands back what `body` returned. Answers `None`
    /// — without running `body` — when the value is shared.
    ///
    /// This is the copy-on-write gate. Payload-method forwarding passes `&self`
    /// methods through and refuses `&var self` ones, because an aliased write
    /// is what `Mutex` exists to make safe. Uniqueness is the other sound
    /// answer: nobody else can observe a write to a value only you hold. The
    /// test and the access are fused so the count cannot go stale between them.
    ///
    /// ```saw
    /// var solo = Arc<Counter>(value: Counter(n: 0))
    /// if let n = solo.with_unique({ c in c.bump()  c.n }) { print(n) }   // 1
    ///
    /// let shared = solo.copy()
    /// solo.with_unique({ c in c.bump()  c.n })                          // None
    /// ```
    ///
    /// The `None` arm is the caller's cue to duplicate the payload and write to
    /// the duplicate, which is how `Data` gets value semantics over shared
    /// storage.
    ///
    /// The uniqueness this reports is single-threaded. `strong_count()` alone is
    /// a racy snapshot; what makes the answer here trustworthy is the `&var
    /// self` borrow, which stops any new reference being taken from this handle
    /// while the window is open. Sharing a value across tasks still goes through
    /// `Mutex` — a count of 1 says nothing about a handle another thread holds.
    public func with_unique<R>(&var self, body: (&var T) sync -> R) unsafe -> R? {
        guard let block = self.ptr else {
            return None
        }
        let strong_ptr = block as UnsafePointer<Int>
        if strong_ptr[0] != 1 {
            return None
        }
        return body((block + 16) as UnsafePointer<T>)
    }
}

// A copy is a refcount bump. `deinit` lives inside the copy-policy
// conformance because `Deinit` is never declared on its own.
extension Arc<T>: Copy {
    public func deinit(&var self) unsafe {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            let old = __saw_atomic_sub_i64_release(strong_ptr, 1)
            if old < 1 {
                // Refcount underflow: someone released a reference nobody
                // held. The platform allocator may or may not trap on the
                // eventual double free; this panic is the deterministic report.
                panic("over-release of an Arc (refcount underflow)")
            }
            if old == 1 {
                // Last strong owner observed strong -> 0. Order every other
                // thread's final payload reads before we tear it down.
                __saw_atomic_fence_acquire()
                let payload_ptr = (block + 16) as UnsafePointer<T>
                __saw_deinit_in_place(payload_ptr)
                // Release the strong refs' collective weak count.
                let weak_ptr = (block + 8) as UnsafePointer<Int>
                let wold = __saw_atomic_sub_i64_release(weak_ptr, 1)
                if wold < 1 {
                    panic("over-release of an Arc weak count (refcount underflow)")
                }
                if wold == 1 {
                    __saw_atomic_fence_acquire()
                    GlobalAllocator().dealloc(block, 16 + sizeof<T>(), 16)
                }
            }
        }
    }

    // Retain: a live reference keeps the block alive, so monotonic is enough.
    public func copy(&self) unsafe -> Arc<T> {
        if let block = self.ptr {
            let strong_ptr = block as UnsafePointer<Int>
            __saw_atomic_add_i64(strong_ptr, 1)
        }
        Arc<T>(ptr: self.ptr)
    }
}
