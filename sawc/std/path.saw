// Path - File path manipulation for the Saw standard library
// Part of the Saw standard library
//
// Provides platform-aware path handling with methods for
// manipulating file and directory paths.

// =============================================================================
// FFI declarations
// =============================================================================

extern "C" {
    func malloc(size: Int) -> UnsafePointer<Int8>?
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// Path - A file system path
// =============================================================================

struct Path {
    value: String
}

extension Path {
    // =========================================================================
    // Constructors
    // =========================================================================

    // Create a Path from a string
    init(s: String) -> Path {
        Path(value: s)
    }

    // =========================================================================
    // Conversion
    // =========================================================================

    // Get the path as a string
    func as_str(self) -> String {
        self.value
    }

    // =========================================================================
    // Path Components
    // =========================================================================

    // Get the parent directory path
    // Returns None for root paths or paths with no parent
    func parent(self) -> Path? {
        let len = self.value.len()
        if len == 0 {
            return None
        }

        // Find the last separator
        if let last_sep = self.value.last_index_of_char(47 as Int8) {  // '/'
            if last_sep == 0 {
                // Root directory "/" - parent is itself or None
                if len == 1 {
                    return None  // "/" has no parent
                }
                return Path(value: "/")
            }

            // Extract substring up to last separator
            Path(value: self.value.substring(0, last_sep))
        } else {
            // No separator found - no parent
            None
        }
    }

    // Get the file name (last component of the path)
    // Returns None for root or empty paths
    func file_name(self) -> String? {
        let len = self.value.len()
        if len == 0 {
            return None
        }

        // Find the last separator
        if let last_sep = self.value.last_index_of_char(47 as Int8) {  // '/'
            if last_sep == len - 1 {
                // Path ends with separator (directory path)
                return None
            }
            // Extract substring after last separator
            self.value.substring(last_sep + 1, len)
        } else {
            // No separator - entire path is the file name
            self.value
        }
    }

    // Get the file extension (without the dot)
    // Returns None if no extension
    func ext(self) -> String? {
        if let name = self.file_name() {
            if let last_dot = name.last_index_of_char(46 as Int8) {  // '.'
                if last_dot == 0 {
                    // Dot at start (hidden file like .gitignore)
                    return None
                }
                let len = name.len()
                if last_dot == len - 1 {
                    // Dot at end - no extension
                    return None
                }
                // Extract substring after last dot
                name.substring(last_dot + 1, len)
            } else {
                None
            }
        } else {
            None
        }
    }

    // Get the file stem (file name without extension)
    func stem(self) -> String? {
        if let name = self.file_name() {
            if let last_dot = name.last_index_of_char(46 as Int8) {  // '.'
                if last_dot == 0 {
                    // Dot at start - entire name is stem
                    return name
                }
                // Extract substring before last dot
                name.substring(0, last_dot)
            } else {
                // No dot - entire name is stem
                name
            }
        } else {
            None
        }
    }

    // =========================================================================
    // Path Operations
    // =========================================================================

    // Join this path with another path component
    func join(self, other: String) -> Path {
        let self_len = self.value.len()
        let other_len = other.len()

        if self_len == 0 {
            return Path(value: other)
        }
        if other_len == 0 {
            return Path(value: self.value)
        }

        // Check if other is absolute
        if other.byte_at(0) == (47 as Int8) {  // '/'
            // Other is absolute - return it
            return Path(value: other)
        }

        // Check if self ends with separator
        let needs_sep = self.value.byte_at(self_len - 1) != (47 as Int8)

        let new_len = self_len + other_len + (if needs_sep { 1 } else { 0 })

        if let buf = malloc(new_len + 1) {
            let self_ptr = self.value as UnsafePointer<Int8>
            let other_ptr = other as UnsafePointer<Int8>

            // Copy self
            memcpy(buf, self_ptr, self_len)

            var offset = self_len

            // Add separator if needed
            if needs_sep {
                buf[offset] = 47 as Int8  // '/'
                offset = offset + 1
            }

            // Copy other
            memcpy(buf + offset, other_ptr, other_len)

            // Null terminate
            buf[new_len] = 0 as Int8

            Path(value: buf as String)
        } else {
            // Allocation failed - return self
            Path(value: self.value)
        }
    }

    // Join with a Path
    func join_path(self, other: Path) -> Path {
        self.join(other.value)
    }

    // =========================================================================
    // Path Queries
    // =========================================================================

    // Check if the path is absolute
    func is_absolute(self) -> Bool {
        let len = self.value.len()
        if len == 0 {
            return false
        }
        self.value.byte_at(0) == (47 as Int8)  // Starts with '/'
    }

    // Check if the path is relative
    func is_relative(self) -> Bool {
        not self.is_absolute()
    }

    // Check if the path is empty
    func is_empty(self) -> Bool {
        self.value.len() == 0
    }
}
