// Path - File path manipulation for the Saw standard library
// Part of the Saw standard library
//
// Provides platform-aware path handling with methods for
// manipulating file and directory paths.

// =============================================================================
// FFI declarations
// =============================================================================

extern "C" {
    // memcpy is a compiler/runtime builtin (not a seam) and stays available in
    // both profiles; Path does its own buffer allocation via String helpers.
    func memcpy(dest: UnsafePointer<Int8>, src: UnsafePointer<Int8>, n: Int) -> UnsafePointer<Int8>
}

// =============================================================================
// Path - A file system path
// =============================================================================

public struct Path {
    private value: String
}

extension Path {
    // =========================================================================
    // Constructors
    // =========================================================================

    public init(s: String) -> Path {
        Path(value: s)
    }

    // =========================================================================
    // Conversion
    // =========================================================================

    public func as_str(&self) -> String {
        self.value
    }

    // =========================================================================
    // Path Components
    // =========================================================================

    public func parent(&self) -> Path? {
        let len = self.value.len()
        if len == 0 {
            return None
        }

        if let last_sep = self.value.last_index_of(47) {  // '/'
            if last_sep == 0 {
                if len == 1 {
                    return None  // "/" has no parent
                }
                return Path(value: "/")
            }

            Path(value: self.value.substring(0, last_sep))
        } else {
            None
        }
    }

    public func file_name(&self) -> String? {
        let len = self.value.len()
        if len == 0 {
            return None
        }

        if let last_sep = self.value.last_index_of(47) {  // '/'
            if last_sep == len - 1 {
                // Path ends with separator (directory path)
                return None
            }
            self.value.substring(last_sep + 1, len)
        } else {
            self.value
        }
    }

    // Without the dot.
    public func ext(&self) -> String? {
        if let name = self.file_name() {
            if let last_dot = name.last_index_of(46) {  // '.'
                if last_dot == 0 {
                    // Dot at start (hidden file like .gitignore)
                    return None
                }
                let len = name.len()
                if last_dot == len - 1 {
                    return None
                }
                name.substring(last_dot + 1, len)
            } else {
                None
            }
        } else {
            None
        }
    }

    // File name without extension.
    public func stem(&self) -> String? {
        if let name = self.file_name() {
            if let last_dot = name.last_index_of(46) {  // '.'
                if last_dot == 0 {
                    return name
                }
                name.substring(0, last_dot)
            } else {
                name
            }
        } else {
            None
        }
    }

    // =========================================================================
    // Path Operations
    // =========================================================================

    /// Joins this path with another component.
    ///
    /// An absolute `other` replaces this path entirely, and an empty component
    /// on either side yields the other one. Allocator exhaustion panics inside
    /// `__saw_string_alloc` (design 123): this used to return the UN-joined
    /// parent path, so `Path("/tmp").join("data.db")` could yield `/tmp` — and
    /// the caller would then open, write or unlink the directory it meant to
    /// create a file in.
    public func join(&self, other: String) unsafe -> Path {
        let self_len = self.value.len()
        let other_len = other.len()

        if self_len == 0 {
            return Path(value: other)
        }
        if other_len == 0 {
            return Path(value: self.value)
        }

        if other.byte_at(0) == 47 {  // '/'
            return Path(value: other)
        }

        let needs_sep = self.value.byte_at(self_len - 1) != 47

        let new_len = self_len + other_len + (if needs_sep { 1 } else { 0 })

        let buf = __saw_string_alloc(new_len)
        let self_ptr = self.value as UnsafePointer<Int8>
        let other_ptr = other as UnsafePointer<Int8>

        // Copy self (memcpy returns dst — a raw pointer — so the discarded
        // call is itself a pointer producer under design 81).
        memcpy(buf, self_ptr, self_len)

        var offset = self_len

        if needs_sep {
            buf[offset] = 47 as Int8  // '/'
            offset = offset + 1
        }

        // Copy other (one marker covers both the pointer arithmetic and the
        // pointer-returning memcpy call).
        memcpy(buf + offset, other_ptr, other_len)

        buf[new_len] = 0 as Int8

        Path(value: buf as String)
    }

    public func join_path(&self, other: Path) -> Path {
        self.join(other.value)
    }

    // =========================================================================
    // Path Queries
    // =========================================================================

    public func is_absolute(&self) -> Bool {
        let len = self.value.len()
        if len == 0 {
            return false
        }
        self.value.byte_at(0) == 47  // Starts with '/'
    }

    public func is_relative(&self) -> Bool {
        not self.is_absolute()
    }

    public func is_empty(&self) -> Bool {
        self.value.len() == 0
    }
}
