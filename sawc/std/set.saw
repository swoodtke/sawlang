// Set<T, A>: an unordered hash set, a thin wrapper over `Map<T, SetMark, A>`
// whose value is a zero-field unit. Every operation delegates to the Map, so
// there is one hash implementation to trust.
//
// Order is unspecified (Map's table order): sort a `to_vector()` snapshot for
// deterministic output. Set is ExplicitCopy when its element is, riding Map's
// own conformance.

// The Map value type for a Set: a zero-field unit (trivially Copy). Private to
// this file, so a user type may carry the same name.
struct SetMark {}

public struct Set<T, A: Allocator = GlobalAllocator> {
    private map: Map<T, SetMark, A>
}

extension Set<T: Hashable + Equatable, A: Allocator = GlobalAllocator> {
    // No allocation until the first insert.
    public init() -> Set<T, A> {
        Set<T, A>(map: Map<T, SetMark, A>())
    }

    // A single-element set. The element is moved in.
    public static func of(value: T) -> Result<Set<T, A>, AllocError> {
        var s = Set<T, A>()
        let _ = try s.insert(move value)
        return move s
    }

    // Build a set from a Vector, consuming it. `pop` moves each element out, so
    // NoCopy elements work; duplicates collapse.
    public init(from: Vector<T, A>) -> Result<Set<T, A>, AllocError> {
        var v = move from
        var s = Set<T, A>()
        var draining = true
        while draining {
            if let e = v.pop() {
                let _ = try s.insert(move e)
            } else {
                draining = false
            }
        }
        return move s
    }

    public func len(&self) -> Int {
        self.map.len()
    }

    public func is_empty(&self) -> Bool {
        self.map.is_empty()
    }

    public func contains(&self, value: T) -> Bool {
        self.map.contains_key(value)
    }

    /// Inserts `value`, returning whether it was newly inserted.
    ///
    /// `Ok(false)` means it was already a member. Reports `Err(AllocError)`
    /// when the table must be rehashed and the allocator refuses; the set is
    /// untouched then, and `value` is consumed either way.
    public func insert(&var self, value: T) -> Result<Bool, AllocError> {
        if let prev = try self.map.insert(move value, SetMark()) {
            return false
        }
        return true
    }

    public func remove(&var self, value: T) -> Bool {
        if let prev = self.map.remove(move value) {
            true
        } else {
            false
        }
    }

    /// Visits each element in table order, lending it to `body` as a `&T`.
    /// Nothing is copied, so an element of any copy tier is visitable. Order
    /// is unspecified; `body` is non-escaping, and mutating this set inside the
    /// visit is a compile-time Law of Exclusivity error.
    public func each(&self, body: (&T) -> Void) {
        self.map.each_key(body)
    }
}

// Snapshots and set algebra duplicate elements while the operands stay live,
// and most bodies read elements by value through `Vector.iter()`, which only
// the silent tier licenses, so the block is bounded `T: Copy` rather than
// `ExplicitCopy`. Even `is_subset` reads by value, since `contains` takes its
// argument by value.
extension Set<T: Hashable + Equatable + Copy, A: Allocator = GlobalAllocator> {
    // Every method in this block builds a snapshot, so every one reports a
    // refused allocation, the two predicates included.
    public func to_vector(&self) -> Result<Vector<T, A>, AllocError> {
        match self.map.keys() {
            case Ok(v) -> { return move v },
            case Err(e) -> { return e }
        }
    }

    public func union(&self, other: &Set<T, A>) -> Result<Set<T, A>, AllocError> {
        var result = Set<T, A>()
        let a = match self.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        for e in a.iter() {
            let _ = try result.insert(e)
        }
        let b = match other.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        for e in b.iter() {
            let _ = try result.insert(e)
        }
        return move result
    }

    public func intersection(&self, other: &Set<T, A>) -> Result<Set<T, A>, AllocError> {
        var result = Set<T, A>()
        let a = match self.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        for e in a.iter() {
            if other.contains(e.copy()) {
                let _ = try result.insert(e)
            }
        }
        return move result
    }

    public func difference(&self, other: &Set<T, A>) -> Result<Set<T, A>, AllocError> {
        var result = Set<T, A>()
        let a = match self.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        for e in a.iter() {
            if not other.contains(e.copy()) {
                let _ = try result.insert(e)
            }
        }
        return move result
    }

    public func is_subset(&self, other: &Set<T, A>) -> Result<Bool, AllocError> {
        let a = match self.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        var ok = true
        for e in a.iter() {
            if not other.contains(e) {
                ok = false
            }
        }
        return ok
    }

    public func is_superset(&self, other: &Set<T, A>) -> Result<Bool, AllocError> {
        let b = match other.to_vector() {
            case Ok(v) -> move v,
            case Err(e) -> { return e }
        }
        var ok = true
        for e in b.iter() {
            if not self.contains(e) {
                ok = false
            }
        }
        return ok
    }
}

// Unconditional on `T`, like Map's, so every Set runs its Map's deinit. The
// empty body suffices: the compiler appends the field cleanup. It also
// satisfies `ExplicitCopy: Deinit` for the conformance below.
extension Set<T, A: Allocator = GlobalAllocator> {
    public func deinit(&var self) {
    }
}

// `SetMark` is trivially Copy, so the bound Set's copy needs is exactly `T`'s,
// the same one Map's conformance carries for its key.
extension Set<T: Hashable + Equatable + ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    /// Duplicates the set into a new table, copying each live element at its
    /// own tier. Panics if the allocator refuses (the message names
    /// `Map.copy`, which does the work); `try_copy` reports the failure
    /// instead.
    public func copy(&self) -> Set<T, A> {
        Set<T, A>(map: self.map.copy())
    }
}

// `try_copy` carries `copy`'s bound for `copy`'s reason.
extension Set<T: Hashable + Equatable + ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the set, returning `Err(AllocError)` if the allocator
    /// refuses while rehashing the new table.
    public func try_copy(&self) -> Result<Set<T, A>, AllocError> {
        match self.map.try_copy() {
            case Ok(m) -> { return Set<T, A>(map: move m) },
            case Err(e) -> { return e }
        }
    }
}
