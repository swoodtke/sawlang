// Mutex<T> - mutual-exclusion wrapper for shared mutable state.
// Part of the Saw standard library (design 21 item 4).
//
// NoCopy + Deinit. The hosted engine backs it with a pthread_mutex_t stored
// inside a __saw_rt_alloc'd block laid out as { pthread_mutex_t, T payload }.
//
// pthread opaque-buffer size: pthread_mutex_t is 64 bytes on macOS (arm64 and
// x86_64), 40 on glibc/x86_64, 48 on glibc/aarch64. We reserve a conservative
// 64-byte slot (MUTEX_BUF below) and initialize within it via
// pthread_mutex_init - never a hardcoded platform struct.
//
// lock(body) is NON-REENTRANT: locking a Mutex already held by the SAME task
// self-deadlocks. There is no try_lock/timeout in v1. The closure is invoked
// exactly once, synchronously, with &var access to the payload.

extern "C" {
    // Thin wrapper (codegen) that calls pthread_mutex_init(m, NULL).
    func __saw_rt_pthread_mutex_init_default(m: UnsafePointer<Int8>)
    func pthread_mutex_lock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_unlock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_destroy(m: UnsafePointer<Int8>) -> Int
}

struct Mutex<T> {
    // Control block: bytes [0, 64) hold the pthread_mutex_t; the payload T
    // starts at byte 64. NOT optional (design 123): `init` panics rather than
    // build a mutex that can never lock, so there is no inert state to check
    // for and no dead branch that has to invent an answer.
    block: UnsafePointer<Int8>
}

// design 186: the control-block pointer blocks both derivations, and mutual
// exclusion is what covers it. Sharing a mutex across threads is safe exactly
// when MOVING a `T` across is — the lock serializes every access, so no two
// threads ever hold the payload at once, and `T` never needs to be `Sync` in
// its own right.
extension Mutex<T: Send>: UnsafeSend {}
extension Mutex<T: Send>: UnsafeSync {}

extension Mutex<T> {
    /// Takes ownership of `value` and wraps it behind a fresh mutex.
    ///
    /// Panics if the allocator refuses the control block (design 123,
    /// infallible tier). It used to build an INERT mutex whose `lock` returned
    /// `false` without ever running the critical section. `try_make` reports
    /// the failure instead.
    public init(value: T) unsafe -> Mutex<T> {
        let size = 64 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            __saw_rt_pthread_mutex_init_default(block)
            let payload_ptr = (block + 64) as UnsafePointer<T>
            payload_ptr[0] = value
            Mutex<T>(block: block)
        } else {
            panic("Mutex(value:): allocation failed")
        }
    }

    /// Wraps `value` behind a fresh mutex, reporting allocator exhaustion as
    /// `Err(AllocError)`.
    ///
    /// `value` is destroyed on the failure path rather than leaked.
    public func try_make(value: T) unsafe -> Result<Mutex<T>, AllocError> {
        let size = 64 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            __saw_rt_pthread_mutex_init_default(block)
            let payload_ptr = (block + 64) as UnsafePointer<T>
            payload_ptr[0] = value
            return Mutex<T>(block: block)
        }
        return AllocError(size: size, align: 16)
    }

    /// Acquires the lock, runs `body` with a `&var` borrow of the payload,
    /// releases, and hands back what `body` returned.
    ///
    /// The result is the closure's own type, so a value can be computed under
    /// the lock and carried out of it:
    ///
    /// ```saw
    /// let doubled = shared.lock { &var n in n * 2 }
    /// shared.lock { &var n in n = n + 1 }     // R = Void; nothing to return
    /// ```
    ///
    /// `lock` is on `&self` (interior mutability) so it composes with Arc's
    /// immutable-borrow forwarding.
    ///
    /// NON-REENTRANT: locking a mutex already held by the same task
    /// self-deadlocks. `body` is a `sync` function type (design 22), so
    /// suspending inside the critical section is a compile error and calling
    /// `body` does not make `lock` itself suspend.
    public func lock<R>(&self, body: (&var T) sync -> R) unsafe -> R {
        let block = self.block
        pthread_mutex_lock(block)
        // The release rides a scope guard so `body` can stay in TAIL position:
        // binding its result would need a local typed `R`, and `R` is `Void` for
        // every critical section that computes nothing. `with_ref`/`with_var_ref`
        // keep their `body` calls in tail position for the same reason. The guard
        // deinits after the tail expression is evaluated, so the payload is still
        // under the lock while `body` runs.
        let held = LockRelease(block: block)
        body((block + 64) as UnsafePointer<T>)
    }
}

// Releases `block` when it goes out of scope. Private to std.mutex.
struct LockRelease {
    block: UnsafePointer<Int8>
}

extension LockRelease: NoCopy {
    func deinit(&var self) unsafe {
        pthread_mutex_unlock(self.block)
    }
}

// Deinit is registered before NoCopy so the `NoCopy: Deinit` supertrait
// requirement is already satisfied.
extension Mutex<T>: NoCopy {
    public func deinit(&var self) unsafe {
        let block = self.block
        let payload_ptr = (block + 64) as UnsafePointer<T>
        __saw_deinit_in_place(payload_ptr)
        pthread_mutex_destroy(block)
        GlobalAllocator().dealloc(block, 64 + sizeof<T>(), 16)
    }
}

// Snapshot the payload under the lock. Requires `T: Copy` so the read
// duplicates rather than moves the guarded value out.
extension Mutex<T: Copy> {
    /// Returns a copy of the payload, read under the lock.
    ///
    /// Not optional (design 123): the `None` only ever meant "this mutex was
    /// built by an allocation that failed", and construction panics now.
    public func get(&self) unsafe -> T {
        let block = self.block
        pthread_mutex_lock(block)
        let payload_ptr = (block + 64) as UnsafePointer<T>
        let result = payload_ptr[0].copy()
        pthread_mutex_unlock(block)
        result
    }
}
