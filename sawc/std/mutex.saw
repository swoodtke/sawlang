// Mutex<T> - mutual-exclusion wrapper for shared mutable state.
// Part of the Saw standard library (design 21 item 4).
//
// NoCopy + Deinit. The hosted engine backs it with a pthread_mutex_t stored
// inside a saw_alloc'd block laid out as { pthread_mutex_t, T payload }.
//
// pthread opaque-buffer size: pthread_mutex_t is 64 bytes on macOS (arm64 and
// x86_64), 40 on glibc/x86_64, 48 on glibc/aarch64. We reserve a conservative
// 64-byte slot (MUTEX_BUF below) and initialize within it via
// pthread_mutex_init - never a hardcoded platform struct.
//
// lock(body) is NON-REENTRANT: locking a Mutex already held by the SAME task
// self-deadlocks. There is no try_lock/timeout in v1. The closure is invoked
// exactly once, synchronously, with &var access to the payload.

extern "C" {
    // Thin wrapper (codegen) that calls pthread_mutex_init(m, NULL).
    func __saw_pthread_mutex_init_default(m: UnsafePointer<Int8>)
    func pthread_mutex_lock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_unlock(m: UnsafePointer<Int8>) -> Int
    func pthread_mutex_destroy(m: UnsafePointer<Int8>) -> Int
}

struct Mutex<T> {
    // Control block: bytes [0, 64) hold the pthread_mutex_t; the payload T
    // starts at byte 64. None only on the OOM path.
    block: UnsafePointer<Int8>?
}

extension Mutex<T> {
    // Take ownership of `value` and wrap it behind a fresh mutex.
    init(value: T) -> Mutex<T> {
        let size = 64 + sizeof<T>()
        if let block = GlobalAllocator().alloc(size, 16) {
            __saw_pthread_mutex_init_default(block)
            let payload_ptr = (block + 64) as UnsafePointer<T>
            payload_ptr[0] = value
            Mutex<T>(block: block)
        } else {
            Mutex<T>(block: None)
        }
    }

    // Acquire the lock, run `body` with a &var borrow of the payload, release.
    // `lock` is on `&self` (interior mutability) so it composes with Arc's
    // immutable-borrow forwarding. The Bool result is the closure's result.
    //
    // `body` is a `sync` function type (design 22): the critical section is a
    // checked suspension-free effect context. Suspending while holding the lock
    // (the async-mutex deadlock class) is therefore a COMPILE ERROR, and because
    // `body` is sync, calling it below does not make `lock` itself suspend.
    func lock(&self, body: (&var T) sync -> Bool) -> Bool {
        if let block = self.block {
            pthread_mutex_lock(block)
            let payload_ptr = (block + 64) as UnsafePointer<T>
            let result = body(payload_ptr)
            pthread_mutex_unlock(block)
            result
        } else {
            false
        }
    }
}

// Deinit is registered before NoCopy so the `NoCopy: Deinit` supertrait
// requirement is already satisfied.
extension Mutex<T>: Deinit {
    func deinit(&var self) {
        if let block = self.block {
            let payload_ptr = (block + 64) as UnsafePointer<T>
            __deinit_in_place(payload_ptr)
            pthread_mutex_destroy(block)
            GlobalAllocator().dealloc(block, 64 + sizeof<T>(), 16)
        }
    }
}

extension Mutex<T>: NoCopy {
}

// Snapshot the payload under the lock. Requires `T: Copy` so the read
// duplicates rather than moves the guarded value out.
extension Mutex<T: Copy> {
    func get(&self) -> T? {
        if let block = self.block {
            pthread_mutex_lock(block)
            let payload_ptr = (block + 64) as UnsafePointer<T>
            let result = payload_ptr[0].copy()
            pthread_mutex_unlock(block)
            result
        } else {
            None
        }
    }
}
