// String Methods - Extensions on the String primitive type

// =============================================================================
// FFI declarations
// =============================================================================

extern "C" {
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Refcounted String runtime, defined by the compiler (see codegen/core.py).
    // A String value is a pointer to the `bytes` field of a heap block laid out
    // as { i64 refcount, i64 len, bytes, NUL }; the header sits at negative
    // offsets, so `as UnsafePointer<Int8>` stays a no-op and FFI is unchanged.
    //  - __saw_string_len:  O(1) length from the header (no strlen scan)
    //  - __saw_string_alloc: allocate a fresh refcount=1 String buffer of `len`
    //    bytes (+ header + NUL); the returned bytes pointer is a valid String.
    //    It PANICS rather than returning NULL on allocator exhaustion, which is
    //    why it is declared non-optional here: every producer below returns a
    //    plain `String`, so a NULL had nowhere to go except into a plausible
    //    wrong answer. That is design 234 §5's String boundary, from inside.
    func __saw_string_len(s: UnsafePointer<Int8>) -> Int
    func __saw_string_alloc(len: Int) -> UnsafePointer<Int8>
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// =============================================================================
// The write funnel (design 250 §3)
// =============================================================================

// A byte value as the C `char` with the same bit pattern.
//
// A `String`'s storage is `UnsafePointer<Int8>` — C's `char` — and a byte at or
// above 0x80 has no `Int8` value, so a checked `as` would panic on the first
// one. Keeping the low bits IS the operation, and design 170 named it.
//
// This is the ONE place a byte value meets the character storage; the read side
// is `String.byte_at`. The parameter is `UInt8` rather than `Byte` because
// arithmetic on a byte lands in `UInt8` (`c - 32` in `to_uppercase`), and a
// `Byte` flows in unchanged.
//
// ENTRY POINTS: `_substring`, `to_uppercase`, `to_lowercase`, `replace`,
// `fromBytes`, `Vector<String>.join`.
func to_c_char(b: UInt8) -> Int8 {
    Int8.from(truncating: b)
}

// =============================================================================
// String Extension - Methods on String values
// =============================================================================

extension String {
    // Get the length of the string in bytes (O(1): reads the header `len` field)
    public func len(&self) unsafe -> Int {
        __saw_string_len(self as UnsafePointer<Int8>)
    }

    public func is_empty(&self) -> Bool {
        self.len() == 0
    }

    /// The byte at `index`.
    ///
    /// BOUNDS-CHECKED: an index outside `0..<len()` panics, exactly like every
    /// other indexing operation in the language (design 122 unit A). The
    /// signature carries nothing unsafe, so the caller gets no signal that a bad
    /// index would read arbitrary heap — reading past the end from a safe method
    /// is never acceptable, and the check is one O(1) header read.
    ///
    /// THE READ FUNNEL (design 250 §3). The storage is C `char`, so a byte at or
    /// above 0x80 arrives as a negative `Int8`; widening, masking and narrowing
    /// recovers the value, and `Byte(...)` says what it is. Every byte the String
    /// layer hands out comes through here — `bytes()`, `starts_with`, the UTF-8
    /// decoder and `to_data` all read through this one accessor — so the sign
    /// question is answered once and nowhere else.
    public func byte_at(&self, index: Int) unsafe -> Byte {
        if index < 0 || index >= self.len() {
            panic("String.byte_at: index out of range: {} (len {})",
                  index, self.len())
        }
        let ptr = self as UnsafePointer<Int8>
        Byte(UInt8.from(truncating: ptr[index]))
    }

    public func starts_with(&self, prefix: String) -> Bool {
        let self_len = self.len()
        let prefix_len = prefix.len()

        if prefix_len > self_len {
            false
        } else {
            var i = 0
            var matches = true
            while i < prefix_len && matches {
                if self.byte_at(i) != prefix.byte_at(i) {
                    matches = false
                }
                i = i + 1
            }
            matches
        }
    }

    public func ends_with(&self, suffix: String) -> Bool {
        let self_len = self.len()
        let suffix_len = suffix.len()

        if suffix_len > self_len {
            false
        } else {
            let offset = self_len - suffix_len
            var i = 0
            var matches = true
            while i < suffix_len && matches {
                if self.byte_at(offset + i) != suffix.byte_at(i) {
                    matches = false
                }
                i = i + 1
            }
            matches
        }
    }

    public func contains(&self, needle: String) -> Bool {
        let self_len = self.len()
        let needle_len = needle.len()

        if needle_len == 0 {
            true
        } else if needle_len > self_len {
            false
        } else {
            var found = false
            var i = 0
            while i <= self_len - needle_len && not found {
                var j = 0
                var matches = true
                while j < needle_len && matches {
                    if self.byte_at(i + j) != needle.byte_at(j) {
                        matches = false
                    }
                    j = j + 1
                }
                if matches {
                    found = true
                }
                i = i + 1
            }
            found
        }
    }

    // Space, tab, newline, carriage return.
    func _is_whitespace(&self, b: Byte) -> Bool {
        b == 32 || b == 9 || b == 10 || b == 13
    }

    // Trim whitespace from the start of the string
    public func trim_start(&self) -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            var start = 0
            while start < len && self._is_whitespace(self.byte_at(start)) {
                start = start + 1
            }
            if start == 0 {
                self
            } else if start == len {
                ""
            } else {
                self._substring(start, len - start)
            }
        }
    }

    // Trim whitespace from the end of the string
    public func trim_end(&self) -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            var end = len
            while end > 0 && self._is_whitespace(self.byte_at(end - 1)) {
                end = end - 1
            }
            if end == len {
                self
            } else if end == 0 {
                ""
            } else {
                self._substring(0, end)
            }
        }
    }

    // Trim whitespace from both ends
    public func trim(&self) -> String {
        self.trim_start().trim_end()
    }

    // Create a substring (allocates new memory).
    //
    // The `""` below is the empty-range answer and nothing else: allocator
    // exhaustion panics inside `__saw_string_alloc` (design 123). It used to
    // return `""` for BOTH, so `trim()` on a long string could hand back an
    // empty one and no caller could tell.
    func _substring(&self, start: Int, length: Int) unsafe -> String {
        if length <= 0 {
            ""
        } else {
            let new_ptr = __saw_string_alloc(length)
            var i = 0
            while i < length {
                new_ptr[i] = to_c_char(self.byte_at(start + i))
                i = i + 1
            }
            new_ptr[length] = 0 as Int8  // null terminate
            new_ptr as String
        }
    }

    // Convert to uppercase (ASCII only).
    //
    // Returning `self` on allocator exhaustion — the UN-cased string, which is
    // a perfectly legal result — was one of the six degradations design 123
    // removed. Exhaustion panics inside `__saw_string_alloc` now.
    public func to_uppercase(&self) unsafe -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            let new_ptr = __saw_string_alloc(len)
            var i = 0
            while i < len {
                let c = self.byte_at(i)
                // 'a' = 97, 'z' = 122
                if c >= 97 && c <= 122 {
                    new_ptr[i] = to_c_char(c - 32)
                } else {
                    new_ptr[i] = to_c_char(c)
                }
                i = i + 1
            }
            new_ptr[len] = 0 as Int8
            new_ptr as String
        }
    }

    // Convert to lowercase (ASCII only). Same tier as `to_uppercase`.
    public func to_lowercase(&self) unsafe -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            let new_ptr = __saw_string_alloc(len)
            var i = 0
            while i < len {
                let c = self.byte_at(i)
                // 'A' = 65, 'Z' = 90
                if c >= 65 && c <= 90 {
                    new_ptr[i] = to_c_char(c + 32)
                } else {
                    new_ptr[i] = to_c_char(c)
                }
                i = i + 1
            }
            new_ptr[len] = 0 as Int8
            new_ptr as String
        }
    }

    // Does `old` match starting at byte offset `i`? `replace`'s count pass
    // and copy pass both ask this at every position.
    func matches_at(&self, i: Int, old: &String) -> Bool {
        let old_len = old.len()
        if i + old_len > self.len() {
            return false
        }
        var j = 0
        while j < old_len {
            if self.byte_at(i + j) != old.byte_at(j) {
                return false
            }
            j = j + 1
        }
        true
    }

    // Replace all occurrences of old with new
    public func replace(&self, old: String, new: String) unsafe -> String {
        let self_len = self.len()
        let old_len = old.len()
        let new_len = new.len()

        if old_len == 0 || self_len == 0 {
            self
        } else {
            // First count occurrences
            var count = 0
            var i = 0
            while i <= self_len - old_len {
                if self.matches_at(i, &old) {
                    count = count + 1
                    i = i + old_len
                } else {
                    i = i + 1
                }
            }

            if count == 0 {
                self
            } else {
                // Calculate new size
                let new_size = self_len - (count * old_len) + (count * new_len)

                // Allocator exhaustion panics inside `__saw_string_alloc`
                // (design 123). Returning `self` here handed back the string
                // with NO replacements performed, identical in shape to the
                // legitimate "no match" return above.
                let new_ptr = __saw_string_alloc(new_size)
                var src_i = 0
                var dst_i = 0

                while src_i < self_len {
                    if self.matches_at(src_i, &old) {
                        // Copy replacement
                        var k = 0
                        while k < new_len {
                            new_ptr[dst_i] = to_c_char(new.byte_at(k))
                            dst_i = dst_i + 1
                            k = k + 1
                        }
                        src_i = src_i + old_len
                    } else {
                        new_ptr[dst_i] = to_c_char(self.byte_at(src_i))
                        dst_i = dst_i + 1
                        src_i = src_i + 1
                    }
                }

                new_ptr[new_size] = 0 as Int8
                new_ptr as String
            }
        }
    }

    // Compare two strings for equality.
    //
    // `other` stays BY VALUE where design 239 gave `Equatable.equals` an
    // `&Self` operand, and deliberately. `String` conforms builtin — there is
    // no `extension String: Equatable` for the requirement's signature to be
    // matched against — so this is String's own public API, and it is called
    // as `s.equals("literal")` at 200 sites in the tree. A literal has no
    // address, so `&` is not merely noisy there, it is unwritable. Nothing is
    // lost: the body READS `other`, `String` is on the Copy tier, and neither
    // of the two paths that need the requirement's shape comes through here —
    // `==` lowers via `_emit_string_equals`, and a call through an `Equatable`
    // bound lowers with the operator's emitter (`comparison_dispatch`).
    public func equals(&self, other: String) -> Bool {
        let self_len = self.len()
        let other_len = other.len()

        if self_len != other_len {
            false
        } else {
            var i = 0
            var equal = true
            while i < self_len && equal {
                if self.byte_at(i) != other.byte_at(i) {
                    equal = false
                }
                i = i + 1
            }
            equal
        }
    }

    // Byte-lexicographic comparison (design 48): String's builtin Comparable
    // conformance. Bytes are UNSIGNED, so this is code-point order for ASCII /
    // UTF-8 — a shorter string that is a prefix of a longer one is Less.
    // `< <= > >=` on String lower to this. `other` stays by value on `equals`'s
    // terms above (design 239). The `& 255` this used to carry was the signed
    // era's fold and is gone with it (design 250).
    public func compare(&self, other: String) -> Ordering {
        let self_len = self.len()
        let other_len = other.len()
        let min_len = if self_len < other_len { self_len } else { other_len }
        var i = 0
        while i < min_len {
            let a = self.byte_at(i) as Int
            let b = other.byte_at(i) as Int
            if a < b { return Ordering.Less }
            if a > b { return Ordering.Greater }
            i = i + 1
        }
        if self_len < other_len { return Ordering.Less }
        if self_len > other_len { return Ordering.Greater }
        Ordering.Equal
    }

    // Byte-streaming hash (design 48): String's builtin Hashable conformance.
    // Streams each byte (as an unsigned 0..255 Int) into the Hasher, so equal
    // string content hashes identically — upholding the hash/== contract with
    // `equals` (which also compares byte content).
    public func hash(&self, h: &var Hasher) {
        let n = self.len()
        var i = 0
        while i < n {
            let b = self.byte_at(i) as Int
            h.write_int(b)
            i = i + 1
        }
    }

    /// Returns the bytes in `start..<end` as a new String.
    ///
    /// Panics if the range is reversed (`start > end`) or reaches outside
    /// `0..len()`. An empty range is legal and yields `""`.
    ///
    /// This used to CLAMP: `"hello".substring(5, 2)` returned `""` and
    /// `"hello".substring(-9, 99)` returned `"hello"`, so a caller could not
    /// tell a bug from an empty slice — the clamped `""` collided with the
    /// legitimate `substring(2, 2)`. Design 130's accessor rule replaced the
    /// clamp with the same always-on bounds check indexing has.
    public func substring(&self, start: Int, end: Int) -> String {
        let len = self.len()
        if start < 0 || end > len || start > end {
            panic("String.substring: range out of range: {}..{} (len {})",
                  start, end, len)
        }
        if start == end {
            return ""
        }
        self._substring(start, end - start)
    }

    /// The offset of the first byte equal to `b`, or `None`.
    ///
    /// The needle is a `UInt8` rather than a `Byte` so `index_of(47)` — a
    /// literal separator — stays writable (design 250 §5 Q4's sink rule: a
    /// single-semantics byte parameter takes a `Byte`, a `UInt8` and a literal
    /// alike). It was `index_of_char(c: Int8)` before design 250: the name said
    /// "character" for a byte, which is wrong the moment a scalar exceeds one
    /// byte, and the type said signed. This is the overload set a String-needle
    /// search joins later.
    public func index_of(&self, b: UInt8) -> Int? {
        let len = self.len()
        var i = 0
        while i < len {
            if self.byte_at(i) == b {
                return i
            }
            i = i + 1
        }
        None
    }

    /// The offset of the last byte equal to `b`, or `None`. The backward twin
    /// of `index_of`, with the same needle rule.
    public func last_index_of(&self, b: UInt8) -> Int? {
        let len = self.len()
        var i = len - 1
        while i >= 0 {
            if self.byte_at(i) == b {
                return i
            }
            i = i - 1
        }
        None
    }

    // Split the string by a separator, returning a Vector of substrings. The
    // Vector is built, so a refused allocation is reported (design 234); the
    // SUBSTRINGS themselves are refcounted views and cost no allocation.
    public func split(&self, separator: String) -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let self_len = self.len()
        let sep_len = separator.len()

        if sep_len == 0 || self_len == 0 {
            // Empty separator or empty string - return single element
            let _ = try result.push(self)
            return move result
        } else {
            var start = 0
            var i = 0

            while i <= self_len - sep_len {
                // Check for match at position i
                var matches = true
                var j = 0
                while j < sep_len && matches {
                    if self.byte_at(i + j) != separator.byte_at(j) {
                        matches = false
                    }
                    j = j + 1
                }

                if matches {
                    // Found separator - extract substring from start to i
                    let part = self._substring(start, i - start)
                    let _ = try result.push(part)
                    start = i + sep_len
                    i = start
                } else {
                    i = i + 1
                }
            }

            // Add the remaining part after the last separator
            let remaining = self._substring(start, self_len - start)
            let _ = try result.push(remaining)

            return move result
        }
    }

    // Convert String bytes to Data.
    //
    // One byte type on both sides since design 250: `byte_at` hands out a
    // `Byte` and `Data.push` takes it. This used to spell a reinterpret here,
    // because `byte_at` yielded a signed `Int8` and every byte of a non-ASCII
    // scalar arrived negative.
    public func to_data(&self) -> Result<Data, AllocError> {
        var data = Data()
        var i = 0
        while i < self.len() {
            let _ = try data.push(self.byte_at(i))
            i = i + 1
        }
        return move data
    }

    // =========================================================================
    // Number parsing (design 57) — Optional results, panic-free.
    // =========================================================================
    //
    // Parse failure is DATA, not a bug, so these never panic: they return None
    // on empty input, trailing/leading junk, an invalid digit, or overflow. The
    // whole string must match (no trimming — the caller trims via `trim`; no
    // partial parse). Overflow is detected with WRAPPING arithmetic and
    // divide-back checks, so it works at any platform Int width without needing
    // an `Int.max` constant.

    // The value of an ASCII digit byte for base up to 36: '0'..'9' -> 0..9,
    // 'a'..'z' / 'A'..'Z' -> 10..35. Returns -1 for any non-alphanumeric byte.
    // `b` is an unsigned byte (0..255), as from `_ubyte_at`.
    func _digit_value(&self, b: Int) -> Int {
        if b >= 48 && b <= 57 {
            b - 48            // '0'..'9'
        } else if b >= 97 && b <= 122 {
            b - 97 + 10       // 'a'..'z'
        } else if b >= 65 && b <= 90 {
            b - 65 + 10       // 'A'..'Z'
        } else {
            -1
        }
    }

    // Parse the whole string as a signed integer in `radix` (2..=36). Digits are
    // accumulated as a NON-POSITIVE magnitude (`acc = acc*radix - d`, acc <= 0),
    // because the negative side of two's complement has one more representable
    // value than the positive — this lets Int.min parse without an intermediate
    // that overflows. Overflow at any step returns None.
    func _parse_int(&self, radix: Int) -> Int? {
        let len = self.len()
        if len == 0 {
            return None
        }
        var i = 0
        var neg = false
        let first = self._ubyte_at(0)
        if first == 45 {            // '-'
            neg = true
            i = 1
        } else if first == 43 {     // '+'
            i = 1
        }
        if i >= len {
            return None             // a lone sign is not a number
        }
        var acc = 0
        while i < len {
            let d = self._digit_value(self._ubyte_at(i))
            if d < 0 || d >= radix {
                return None         // invalid digit / trailing junk
            }
            let m = acc &* radix
            if acc != 0 && m / radix != acc {
                return None         // multiply overflowed
            }
            let n = m &- d
            if n > m {
                return None         // subtract underflowed past Int.min
            }
            acc = n
            i = i + 1
        }
        if neg {
            return acc              // already the (non-positive) result
        }
        let pos = 0 &- acc          // negate the magnitude back to positive
        if pos < 0 {
            return None             // acc was Int.min; +magnitude is unrepresentable
        }
        return pos
    }

    // Parse the whole string as a base-10 signed integer, or None.
    public func to_int(&self) -> Int? {
        self._parse_int(10)
    }

    // Parse the whole string in an explicit radix (2..=36), or None (design 55
    // overload of `to_int`). No `0x`/`0b` prefix handling — the caller strips it.
    public func to_int(&self, radix: Int) -> Int? {
        if radix < 2 || radix > 36 {
            return None
        }
        self._parse_int(radix)
    }

    // Parse the whole string as an UNSIGNED integer in `radix`, accumulating into
    // a UInt. This reaches the 2^63..2^64-1 range a signed `Int` cannot hold
    // (`UInt.max == 2**64 - 1`), the companion to `_parse_int`. Overflow past
    // `UInt.max` at any step returns None, detected with WRAPPING arithmetic plus
    // a divide-back (multiply) and carry (add) check — panic-free, and correct at
    // any platform UInt width without needing the bound as a literal.
    func _parse_uint(&self, radix: Int) -> UInt? {
        let len = self.len()
        if len == 0 {
            return None
        }
        var i = 0
        let first = self._ubyte_at(0)
        if first == 43 {            // '+'
            i = 1
        } else if first == 45 {     // '-'
            return None             // an unsigned value is never negative
        }
        if i >= len {
            return None             // a lone sign is not a number
        }
        let r = radix as UInt
        var acc: UInt = 0
        while i < len {
            let d = self._digit_value(self._ubyte_at(i))
            if d < 0 || d >= radix {
                return None         // invalid digit / trailing junk
            }
            let m = acc &* r
            if acc != (0 as UInt) && m / r != acc {
                return None         // multiply overflowed past UInt.max
            }
            let n = m &+ (d as UInt)
            if n < m {
                return None         // add carried past UInt.max
            }
            acc = n
            i = i + 1
        }
        return acc
    }

    // Parse the whole string as a base-10 UNSIGNED integer, or None (design 119).
    // The unsigned companion to `to_int`, closing the DF-116b gap: it covers the
    // full 0..UInt.max range (a `UInt64.max` magnitude a signed parse rejects).
    // Same whole-string, no-trimming, panic-free contract — overflow is None.
    public func to_uint(&self) -> UInt? {
        self._parse_uint(10)
    }

    // Parse the whole string in an explicit radix (2..=36) as UNSIGNED, or None
    // (overload of `to_uint`, mirroring `to_int(radix:)`). No `0x`/`0b` prefix
    // handling — the caller strips it.
    public func to_uint(&self, radix: Int) -> UInt? {
        if radix < 2 || radix > 36 {
            return None
        }
        self._parse_uint(radix)
    }

    // `String.to_float` IS NOT IN THIS FILE. It is declared in
    // `sawc/std/float.saw`, beside `Float.to_string` and the bit-level layer
    // both directions share (design 253) — one module owns the whole
    // `Float`<->text story, and splitting it would mean inventing a second
    // public spelling for each direction just to cross a file boundary.
    //
    // What used to be here was a naive left-to-right accumulation in `Float`
    // arithmetic, documented as NOT a correctly-rounded strtod: the last ULP
    // could differ, and a long or extreme input was simply wrong. It is
    // Eisel-Lemire over an exact decimal fallback now, and nothing about the
    // signature changed.

    // =========================================================================
    // UTF-8 decoding / validation (brief 38 items 1 & 2)
    // =========================================================================
    //
    // The byte at `i` WIDENED to an Int, which is the width the decoder and the
    // number parsers work in: scalar assembly multiplies by 4096 and 262144, and
    // `b0 - 224` would not fit a byte.
    //
    // It used to fold a NEGATIVE `Int8` back into 0..255 as well — the sign
    // correction design 250 deleted. Only the widening is left, and the name
    // still says what it hands back: the unsigned byte value.
    func _ubyte_at(&self, i: Int) -> Int {
        self.byte_at(i) as Int
    }

    // Decode ONE UTF-8 scalar starting at byte offset `i` (with `len` the total
    // byte length). Returns `(scalar, nbytes)`:
    //   - nbytes in 1..4 and `scalar` the Unicode scalar value on success;
    //   - nbytes == 0 signals a malformed sequence STARTING at `i` (invalid
    //     lead, bad/short continuation, overlong, surrogate, or > U+10FFFF).
    // This is the single source of UTF-8 truth: `_utf8_error_offset` (feeding
    // `fromBytes`) and `StringChars` (feeding `chars()`) both decode through it.
    // Scalar assembly uses multiplication rather than bit-shifts (no bitwise
    // operators in Saw): the code-unit shifts are *64 (6 bits), *4096 (12),
    // *262144 (18).
    func _decode_at(&self, i: Int, len: Int) -> (Int, Int) {
        let b0 = self._ubyte_at(i)
        if b0 < 128 {
            // 0x00..0x7F: ASCII.
            return (b0, 1)
        }
        if b0 < 194 {
            // 0x80..0xBF: a continuation byte cannot lead. 0xC0/0xC1 (192/193)
            // could only ever encode an overlong ASCII byte -> reject.
            return (0, 0)
        }
        if b0 < 224 {
            // 0xC2..0xDF: two-byte sequence.
            if i + 1 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            if b1 < 128 || b1 > 191 { return (0, 0) }       // bad continuation
            return ((b0 - 192) * 64 + (b1 - 128), 2)
        }
        if b0 < 240 {
            // 0xE0..0xEF: three-byte sequence.
            if i + 2 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            // First-continuation bounds tighten to forbid overlong (0xE0) and
            // UTF-16 surrogates D800..DFFF (0xED).
            var lo = 128
            var hi = 191
            if b0 == 224 { lo = 160 }                       // reject overlong
            if b0 == 237 { hi = 159 }                       // reject surrogate
            if b1 < lo || b1 > hi { return (0, 0) }
            let b2 = self._ubyte_at(i + 2)
            if b2 < 128 || b2 > 191 { return (0, 0) }
            return ((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128), 3)
        }
        if b0 < 245 {
            // 0xF0..0xF4: four-byte sequence.
            if i + 3 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            // Tighten to forbid overlong (0xF0) and > U+10FFFF (0xF4).
            var lo = 128
            var hi = 191
            if b0 == 240 { lo = 144 }                       // reject overlong
            if b0 == 244 { hi = 143 }                       // reject > U+10FFFF
            if b1 < lo || b1 > hi { return (0, 0) }
            let b2 = self._ubyte_at(i + 2)
            if b2 < 128 || b2 > 191 { return (0, 0) }
            let b3 = self._ubyte_at(i + 3)
            if b3 < 128 || b3 > 191 { return (0, 0) }
            return ((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128), 4)
        }
        // 0xF5..0xFF: no valid lead byte encodes a scalar <= U+10FFFF.
        return (0, 0)
    }

    // Scan the whole buffer; return the byte offset at which the FIRST malformed
    // UTF-8 sequence begins, or None if the entire buffer is valid UTF-8. The
    // offset is the start of the bad sequence (Rust's `valid_up_to()` semantics),
    // which is what `Utf8Error.offset` carries.
    func _utf8_error_offset(&self) -> Int? {
        let len = self.len()
        var i = 0
        while i < len {
            let d = self._decode_at(i, len)
            if d.1 == 0 {
                return i
            }
            i = i + d.1
        }
        None
    }

    /// Builds a validated `String` from raw bytes.
    ///
    /// `Err(Utf8Error)` carries the byte offset at which the first malformed
    /// sequence begins; the partly-built candidate is released, not leaked. The
    /// `Err` answers exactly one question — "are these bytes UTF-8?" — and
    /// allocator exhaustion panics rather than joining it (design 123): this
    /// used to return `Ok("")` on allocation failure, so the one function whose
    /// whole job is to report a decoding failure reported SUCCESS on a
    /// different failure and threw away every byte.
    ///
    /// Static: call as `String.fromBytes(&data)`.
    public static func fromBytes(data: &Data) unsafe -> Result<String, Utf8Error> {
        let n = data.len()
        if n == 0 {
            return ""                       // trivially-valid empty string (Ok)
        }
        let ptr = __saw_string_alloc(n)
        var i = 0
        while i < n {
            if let b = data.get(i) {
                // A REINTERPRET, not a conversion: this function exists to
                // accept arbitrary bytes and validate them afterwards, so a
                // lead or continuation byte >= 0x80 must reach the validator
                // rather than trapping on the way in (design 170).
                ptr[i] = to_c_char(b)
            }
            i = i + 1
        }
        ptr[n] = 0 as Int8
        let candidate = ptr as String
        if let off = candidate._utf8_error_offset() {
            // Malformed: hand back the offset; `candidate` (rc=1) is
            // released at scope exit.
            return Utf8Error(offset: off)
        }
        // `move` transfers ownership of the owned String into the Ok
        // payload. As of design 40 item 5 the plain `return candidate` also
        // works (auto-wrap retains the Copy value at the wrap site);
        // the explicit move is kept as the clearest intent — it consumes
        // `candidate` outright rather than retain-then-release.
        return move candidate               // valid: move the owned String out
    }

    // =========================================================================
    // Iterators (brief 38 item 2)
    // =========================================================================

    // Iterate the raw bytes. Element type is `Byte`, matching `byte_at`. The
    // iterator holds its OWN retain on the String (the `s` field is an
    // Copy capture), so `for b in makeString().bytes()` keeps the bytes
    // alive for the whole loop even though the temporary receiver is gone.
    public func bytes(&self) -> StringBytes {
        StringBytes(s: self, index: 0, length: self.len())
    }

    // Iterate Unicode scalar values, decoded from UTF-8, yielded as Int. There
    // is no Char type yet (brief 38 scope note), so scalars are plain Int. Like
    // `bytes()`, the iterator retains the String. String contents are always
    // valid UTF-8 (literals are source-encoded; `fromBytes` validates), so a
    // decode error is unreachable; should unsafe code ever corrupt a buffer, the
    // iterator stops (defined behavior — see `StringChars.next`).
    public func chars(&self) -> StringChars {
        StringChars(s: self, index: 0, length: self.len())
    }

    // Scoped C-string borrow (brief 38 item 3). Hands `body` an
    // `UnsafePointer<Int8>` to the String's NUL-terminated bytes, valid for the
    // duration of the call. The refcounted String payload is ALREADY
    // NUL-terminated (see codegen/core.py `_declare_string_runtime`), so the
    // bytes pointer is passed directly — no copy. `body` is a NON-ESCAPING
    // closure parameter (brief 29 default): the compiler forbids it from being
    // stored or otherwise outliving the call, which is the entire safety story —
    // the pointer cannot leak past the borrow.
    //
    // `R` is a METHOD-level generic type parameter (brief 40 item 9 / C6): the
    // borrow's result type, chosen at the call site (`s.withCString<Int> { ... }`).
    // The value flows straight out — `s.withCString<Int> { ptr in strlen(ptr) }`
    // — so a scoped C-borrow no longer needs the capture-and-write workaround.
    //
    // The slot is `unsafe` (design 130): `body` receives a raw pointer, so by
    // the trigger rule any closure written for it is an unsafe closure, and the
    // effect position is where that is declared. A caller still needs no
    // ceremony to CALL this — only the callback itself carries the obligation.
    public func withCString<R>(&self, body: (UnsafePointer<Int8>) unsafe -> R) unsafe -> R {
        body(self as UnsafePointer<Int8>)
    }
}

// =============================================================================
// Vector<String> Extension - Specialized methods for string vectors
// =============================================================================

extension Vector<String> {
    // Join all strings in the vector with a separator
    public func join(&self, separator: String) unsafe -> String {
        let count = self.len()

        if count == 0 {
            ""
        } else if count == 1 {
            if let first = self.get(0) {
                first
            } else {
                ""
            }
        } else {
            // Calculate total length needed
            let sep_len = separator.len()
            var total_len = 0
            var i = 0
            while i < count {
                if let s = self.get(i) {
                    total_len = total_len + s.len()
                }
                i = i + 1
            }
            // Add separator lengths (count - 1 separators)
            total_len = total_len + (sep_len * (count - 1))

            // Allocate buffer and build result. Allocator exhaustion panics
            // inside `__saw_string_alloc` (design 123); joining a non-empty
            // vector into `""` was a plausible wrong answer no caller could
            // detect.
            let buf = __saw_string_alloc(total_len)
            var pos = 0
            var idx = 0
            while idx < count {
                // Add separator before all but first element
                if idx > 0 {
                    var k = 0
                    while k < sep_len {
                        buf[pos] = to_c_char(separator.byte_at(k))
                        pos = pos + 1
                        k = k + 1
                    }
                }

                // Copy the string
                if let s = self.get(idx) {
                    let s_len = s.len()
                    var j = 0
                    while j < s_len {
                        buf[pos] = to_c_char(s.byte_at(j))
                        pos = pos + 1
                        j = j + 1
                    }
                }
                idx = idx + 1
            }

            buf[total_len] = 0 as Int8  // null terminate
            buf as String
        }
    }
}

// =============================================================================
// UTF-8 validation error (brief 38 item 1)
// =============================================================================

// Returned by `String.fromBytes` when the input is not valid UTF-8. `offset` is
// the byte index at which the first malformed sequence begins (the bytes before
// it decode cleanly — Rust's `Utf8Error::valid_up_to()` semantics).
public struct Utf8Error {
    public offset: Int
}

// `Error` so a decode failure propagates like any other: it interpolates
// (`"{e}"`), boxes into `Result<T, Box<any Error>>` at a `try` boundary, and is
// downcastable. `Data.to_string()` (design 122 unit B) is the caller that made
// this necessary — a byte buffer that fails to decode has to travel.
extension Utf8Error: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append("invalid UTF-8 at byte offset ")
        try! into.append(self.offset)
    }
}

// =============================================================================
// String iterators (brief 38 item 2)
// =============================================================================
//
// Both iterators store the source String by value. String is Copy, so
// the field initialization RETAINS it (refcount bump) and the struct's
// synthesized deinit RELEASES it when the iterator dies. That independent retain
// is what makes a temporary receiver safe: in `for c in makeString().chars()`
// the temporary String is released right after `chars()` returns, but the
// iterator's own reference keeps the bytes alive across every `next()`.

// `public` because `String.bytes()` HANDS ONE OUT: a public API needs public
// types (Aug 21), and a caller that holds the value of a `for b in s.bytes()`
// must be able to name its type. The fields stay private, which is where the
// internals were all along — `std.data`'s `DataIterator` was already written
// this way.
public struct StringBytes {
    private s: String
    private index: Int
    private length: Int
}

extension StringBytes: Iterator {
    type Item = Byte

    public func next(&var self) -> Byte? {
        if self.index < self.length {
            let b = self.s.byte_at(self.index)
            self.index = self.index + 1
            b
        } else {
            None
        }
    }
}

// `public` for the same reason as `StringBytes` above: `String.chars()` returns
// one.
public struct StringChars {
    private s: String
    private index: Int
    private length: Int
}

extension StringChars: Iterator {
    type Item = Int

    public func next(&var self) -> Int? {
        if self.index >= self.length {
            return None
        }
        let d = self.s._decode_at(self.index, self.length)
        if d.1 == 0 {
            // Malformed sequence. Unreachable for a validated String; if unsafe
            // code corrupted the buffer we stop cleanly rather than loop or trap.
            self.index = self.length
            return None
        }
        self.index = self.index + d.1
        d.0
    }
}
