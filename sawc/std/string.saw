// String methods: extensions on the String primitive type.

extern "C" {
    func strlen(s: UnsafePointer<Int8>) -> Int

    // Refcounted String runtime, defined by the compiler (codegen/core.py). A
    // String value points at the `bytes` field of a heap block laid out as
    // { i64 refcount, i64 len, bytes, NUL }; the header sits at negative
    // offsets, so `as UnsafePointer<Int8>` is a no-op for FFI.
    //  - __saw_string_len: O(1) length from the header.
    //  - __saw_string_alloc: a fresh refcount=1 buffer of `len` bytes (+ header
    //    + NUL). It panics on allocator exhaustion rather than return NULL, so
    //    every producer below can return a plain `String` (design 234).
    func __saw_string_len(s: UnsafePointer<Int8>) -> Int
    func __saw_string_alloc(len: Int) -> UnsafePointer<Int8>
    func __saw_string_from_bytes(src: UnsafePointer<Int8>, len: Int) -> String
}

// A byte value as the C `char` with the same bit pattern. A byte at or above
// 0x80 has no `Int8` value, so a checked `as` would panic; keeping the low bits
// is the operation. This is the one place a byte value meets the character
// storage; the read side is `String.byte_at`. The parameter is `UInt8` because
// arithmetic on a byte lands there (`c - 32` in `to_uppercase`), and a `Byte`
// flows in unchanged (design 250).
//
// ENTRY POINTS: `_substring`, `to_uppercase`, `to_lowercase`, `replace`,
// `fromBytes`, `Vector<String>.join`.
func to_c_char(b: UInt8) -> Int8 {
    Int8.from(truncating: b)
}

extension String {
    // O(1): reads the header `len` field.
    public func len(&self) unsafe -> Int {
        __saw_string_len(self as UnsafePointer<Int8>)
    }

    public func is_empty(&self) -> Bool {
        self.len() == 0
    }

    // The read funnel: the storage is C `char`, so a byte at or above 0x80
    // arrives as a negative `Int8`, and this is the one place it is converted.
    // `bytes()`, `starts_with`, the UTF-8 decoder and `to_data` all read through
    // it (design 250).
    /// Returns the byte at `index`. Panics if `index` is outside `0..<len()`.
    public func byte_at(&self, index: Int) unsafe -> Byte {
        if index < 0 || index >= self.len() {
            panic("String.byte_at: index out of range: {} (len {})",
                  index, self.len())
        }
        let ptr = self as UnsafePointer<Int8>
        Byte(UInt8.from(truncating: ptr[index]))
    }

    public func starts_with(&self, prefix: String) -> Bool {
        let self_len = self.len()
        let prefix_len = prefix.len()

        if prefix_len > self_len {
            false
        } else {
            var i = 0
            var matches = true
            while i < prefix_len && matches {
                if self.byte_at(i) != prefix.byte_at(i) {
                    matches = false
                }
                i = i + 1
            }
            matches
        }
    }

    public func ends_with(&self, suffix: String) -> Bool {
        let self_len = self.len()
        let suffix_len = suffix.len()

        if suffix_len > self_len {
            false
        } else {
            let offset = self_len - suffix_len
            var i = 0
            var matches = true
            while i < suffix_len && matches {
                if self.byte_at(offset + i) != suffix.byte_at(i) {
                    matches = false
                }
                i = i + 1
            }
            matches
        }
    }

    public func contains(&self, needle: String) -> Bool {
        let self_len = self.len()
        let needle_len = needle.len()

        if needle_len == 0 {
            true
        } else if needle_len > self_len {
            false
        } else {
            var found = false
            var i = 0
            while i <= self_len - needle_len && not found {
                var j = 0
                var matches = true
                while j < needle_len && matches {
                    if self.byte_at(i + j) != needle.byte_at(j) {
                        matches = false
                    }
                    j = j + 1
                }
                if matches {
                    found = true
                }
                i = i + 1
            }
            found
        }
    }

    // Space, tab, newline, carriage return.
    func _is_whitespace(&self, b: Byte) -> Bool {
        b == 32 || b == 9 || b == 10 || b == 13
    }

    // Trim whitespace from the start of the string
    public func trim_start(&self) -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            var start = 0
            while start < len && self._is_whitespace(self.byte_at(start)) {
                start = start + 1
            }
            if start == 0 {
                self
            } else if start == len {
                ""
            } else {
                self._substring(start, len - start)
            }
        }
    }

    // Trim whitespace from the end of the string
    public func trim_end(&self) -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            var end = len
            while end > 0 && self._is_whitespace(self.byte_at(end - 1)) {
                end = end - 1
            }
            if end == len {
                self
            } else if end == 0 {
                ""
            } else {
                self._substring(0, end)
            }
        }
    }

    // Trim whitespace from both ends
    public func trim(&self) -> String {
        self.trim_start().trim_end()
    }

    // Allocates a new String. The `""` is the empty-range answer only;
    // allocator exhaustion panics inside `__saw_string_alloc`.
    func _substring(&self, start: Int, length: Int) unsafe -> String {
        if length <= 0 {
            ""
        } else {
            let new_ptr = __saw_string_alloc(length)
            var i = 0
            while i < length {
                new_ptr[i] = to_c_char(self.byte_at(start + i))
                i = i + 1
            }
            new_ptr[length] = 0 as Int8  // null terminate
            new_ptr as String
        }
    }

    // ASCII only. Allocator exhaustion panics inside `__saw_string_alloc`.
    public func to_uppercase(&self) unsafe -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            let new_ptr = __saw_string_alloc(len)
            var i = 0
            while i < len {
                let c = self.byte_at(i)
                // 'a' = 97, 'z' = 122
                if c >= 97 && c <= 122 {
                    new_ptr[i] = to_c_char(c - 32)
                } else {
                    new_ptr[i] = to_c_char(c)
                }
                i = i + 1
            }
            new_ptr[len] = 0 as Int8
            new_ptr as String
        }
    }

    // ASCII only, like `to_uppercase`.
    public func to_lowercase(&self) unsafe -> String {
        let len = self.len()
        if len == 0 {
            self
        } else {
            let new_ptr = __saw_string_alloc(len)
            var i = 0
            while i < len {
                let c = self.byte_at(i)
                // 'A' = 65, 'Z' = 90
                if c >= 65 && c <= 90 {
                    new_ptr[i] = to_c_char(c + 32)
                } else {
                    new_ptr[i] = to_c_char(c)
                }
                i = i + 1
            }
            new_ptr[len] = 0 as Int8
            new_ptr as String
        }
    }

    // Does `old` match starting at byte offset `i`? `replace`'s count pass
    // and copy pass both ask this at every position.
    func matches_at(&self, i: Int, old: &String) -> Bool {
        let old_len = old.len()
        if i + old_len > self.len() {
            return false
        }
        var j = 0
        while j < old_len {
            if self.byte_at(i + j) != old.byte_at(j) {
                return false
            }
            j = j + 1
        }
        true
    }

    // Replace all occurrences of old with new
    public func replace(&self, old: String, new: String) unsafe -> String {
        let self_len = self.len()
        let old_len = old.len()
        let new_len = new.len()

        if old_len == 0 || self_len == 0 {
            self
        } else {
            // First count occurrences
            var count = 0
            var i = 0
            while i <= self_len - old_len {
                if self.matches_at(i, &old) {
                    count = count + 1
                    i = i + old_len
                } else {
                    i = i + 1
                }
            }

            if count == 0 {
                self
            } else {
                // Calculate new size
                let new_size = self_len - (count * old_len) + (count * new_len)

                // Allocator exhaustion panics inside `__saw_string_alloc`;
                // returning `self` would be indistinguishable from "no match".
                let new_ptr = __saw_string_alloc(new_size)
                var src_i = 0
                var dst_i = 0

                while src_i < self_len {
                    if self.matches_at(src_i, &old) {
                        // Copy replacement
                        var k = 0
                        while k < new_len {
                            new_ptr[dst_i] = to_c_char(new.byte_at(k))
                            dst_i = dst_i + 1
                            k = k + 1
                        }
                        src_i = src_i + old_len
                    } else {
                        new_ptr[dst_i] = to_c_char(self.byte_at(src_i))
                        dst_i = dst_i + 1
                        src_i = src_i + 1
                    }
                }

                new_ptr[new_size] = 0 as Int8
                new_ptr as String
            }
        }
    }

    // `other` is by value, unlike `Equatable.equals`'s `&Self` operand: String
    // conforms builtin, so this is String's own API, called as
    // `s.equals("literal")`, and a literal has no address. `==` lowers via
    // `_emit_string_equals` and an `Equatable`-bound call via
    // `comparison_dispatch`, so neither needs the requirement's shape here.
    public func equals(&self, other: String) -> Bool {
        let self_len = self.len()
        let other_len = other.len()

        if self_len != other_len {
            false
        } else {
            var i = 0
            var equal = true
            while i < self_len && equal {
                if self.byte_at(i) != other.byte_at(i) {
                    equal = false
                }
                i = i + 1
            }
            equal
        }
    }

    // Byte-lexicographic comparison, String's builtin Comparable conformance;
    // `< <= > >=` on String lower to this. Bytes are unsigned, so this is
    // code-point order for UTF-8, and a proper prefix is Less. `other` is by
    // value for the reason `equals` gives.
    public func compare(&self, other: String) -> Ordering {
        let self_len = self.len()
        let other_len = other.len()
        let min_len = if self_len < other_len { self_len } else { other_len }
        var i = 0
        while i < min_len {
            let a = self.byte_at(i) as Int
            let b = other.byte_at(i) as Int
            if a < b { return Ordering.Less }
            if a > b { return Ordering.Greater }
            i = i + 1
        }
        if self_len < other_len { return Ordering.Less }
        if self_len > other_len { return Ordering.Greater }
        Ordering.Equal
    }

    // String's builtin Hashable conformance. It hashes byte content, which is
    // what `equals` compares, so the hash/== contract holds.
    public func hash(&self, h: &var Hasher) {
        let n = self.len()
        var i = 0
        while i < n {
            let b = self.byte_at(i) as Int
            h.write_int(b)
            i = i + 1
        }
    }

    /// Returns the bytes in `start..<end` as a new String.
    ///
    /// Panics if the range is reversed (`start > end`) or reaches outside
    /// `0..len()`. An empty range is legal and yields `""`.
    public func substring(&self, start: Int, end: Int) -> String {
        let len = self.len()
        if start < 0 || end > len || start > end {
            panic("String.substring: range out of range: {}..{} (len {})",
                  start, end, len)
        }
        if start == end {
            return ""
        }
        self._substring(start, end - start)
    }

    // The needle is a `UInt8` so it takes a `Byte`, a `UInt8` and a literal
    // alike (`index_of(47)`) (design 250).
    /// Returns the offset of the first byte equal to `b`, or `None`.
    public func index_of(&self, b: UInt8) -> Int? {
        let len = self.len()
        var i = 0
        while i < len {
            if self.byte_at(i) == b {
                return i
            }
            i = i + 1
        }
        None
    }

    /// Returns the offset of the last byte equal to `b`, or `None`.
    public func last_index_of(&self, b: UInt8) -> Int? {
        let len = self.len()
        var i = len - 1
        while i >= 0 {
            if self.byte_at(i) == b {
                return i
            }
            i = i - 1
        }
        None
    }

    // A refused Vector allocation is reported; each substring is a fresh
    // String whose allocation panics on exhaustion, like `_substring`.
    public func split(&self, separator: String) -> Result<Vector<String>, AllocError> {
        var result = Vector<String>()
        let self_len = self.len()
        let sep_len = separator.len()

        if sep_len == 0 || self_len == 0 {
            // Empty separator or empty string - return single element
            let _ = try result.push(self)
            return move result
        } else {
            var start = 0
            var i = 0

            while i <= self_len - sep_len {
                // Check for match at position i
                var matches = true
                var j = 0
                while j < sep_len && matches {
                    if self.byte_at(i + j) != separator.byte_at(j) {
                        matches = false
                    }
                    j = j + 1
                }

                if matches {
                    // Found separator - extract substring from start to i
                    let part = self._substring(start, i - start)
                    let _ = try result.push(part)
                    start = i + sep_len
                    i = start
                } else {
                    i = i + 1
                }
            }

            // Add the remaining part after the last separator
            let remaining = self._substring(start, self_len - start)
            let _ = try result.push(remaining)

            return move result
        }
    }

    public func to_data(&self) -> Result<Data, AllocError> {
        var data = Data()
        var i = 0
        while i < self.len() {
            let _ = try data.push(self.byte_at(i))
            i = i + 1
        }
        return move data
    }

    // Number parsing. Parse failure is data, not a bug, so these never panic:
    // they return None on empty input, leading or trailing junk, an invalid
    // digit, or overflow. The whole string must match (no trimming, no partial
    // parse). Overflow is detected with wrapping arithmetic and divide-back
    // checks, so it works at any platform Int width without an `Int.max`
    // constant.

    // The value of an ASCII digit byte for base up to 36: '0'..'9' -> 0..9,
    // 'a'..'z' / 'A'..'Z' -> 10..35, -1 for anything else. `b` is an unsigned
    // byte (0..255), as from `_ubyte_at`.
    func _digit_value(&self, b: Int) -> Int {
        if b >= 48 && b <= 57 {
            b - 48            // '0'..'9'
        } else if b >= 97 && b <= 122 {
            b - 97 + 10       // 'a'..'z'
        } else if b >= 65 && b <= 90 {
            b - 65 + 10       // 'A'..'Z'
        } else {
            -1
        }
    }

    // Parses the whole string as a signed integer in `radix` (2..=36). Digits
    // accumulate as a non-positive magnitude (`acc = acc*radix - d`), because
    // two's complement has one more negative value than positive: Int.min
    // parses without an overflowing intermediate.
    func _parse_int(&self, radix: Int) -> Int? {
        let len = self.len()
        if len == 0 {
            return None
        }
        var i = 0
        var neg = false
        let first = self._ubyte_at(0)
        if first == 45 {            // '-'
            neg = true
            i = 1
        } else if first == 43 {     // '+'
            i = 1
        }
        if i >= len {
            return None             // a lone sign is not a number
        }
        var acc = 0
        while i < len {
            let d = self._digit_value(self._ubyte_at(i))
            if d < 0 || d >= radix {
                return None         // invalid digit / trailing junk
            }
            let m = acc &* radix
            if acc != 0 && m / radix != acc {
                return None         // multiply overflowed
            }
            let n = m &- d
            if n > m {
                return None         // subtract underflowed past Int.min
            }
            acc = n
            i = i + 1
        }
        if neg {
            return acc              // already the (non-positive) result
        }
        let pos = 0 &- acc          // negate the magnitude back to positive
        if pos < 0 {
            return None             // acc was Int.min; +magnitude is unrepresentable
        }
        return pos
    }

    // Parses the whole string as a base-10 signed integer, or None.
    public func to_int(&self) -> Int? {
        self._parse_int(10)
    }

    // Parses the whole string in `radix` (2..=36), or None. No `0x`/`0b`
    // prefix handling; the caller strips it.
    public func to_int(&self, radix: Int) -> Int? {
        if radix < 2 || radix > 36 {
            return None
        }
        self._parse_int(radix)
    }

    // Parses the whole string as an unsigned integer in `radix`, reaching the
    // range above `Int.max`. Overflow past `UInt.max` is caught by a
    // divide-back (multiply) and carry (add) check on wrapping arithmetic.
    func _parse_uint(&self, radix: Int) -> UInt? {
        let len = self.len()
        if len == 0 {
            return None
        }
        var i = 0
        let first = self._ubyte_at(0)
        if first == 43 {            // '+'
            i = 1
        } else if first == 45 {     // '-'
            return None             // an unsigned value is never negative
        }
        if i >= len {
            return None             // a lone sign is not a number
        }
        let r = radix as UInt
        var acc: UInt = 0
        while i < len {
            let d = self._digit_value(self._ubyte_at(i))
            if d < 0 || d >= radix {
                return None         // invalid digit / trailing junk
            }
            let m = acc &* r
            if acc != (0 as UInt) && m / r != acc {
                return None         // multiply overflowed past UInt.max
            }
            let n = m &+ (d as UInt)
            if n < m {
                return None         // add carried past UInt.max
            }
            acc = n
            i = i + 1
        }
        return acc
    }

    // Parses the whole string as a base-10 unsigned integer (0..UInt.max), or
    // None, on the same contract as `to_int`.
    public func to_uint(&self) -> UInt? {
        self._parse_uint(10)
    }

    // Parses the whole string in `radix` (2..=36) as unsigned, or None. No
    // `0x`/`0b` prefix handling; the caller strips it.
    public func to_uint(&self, radix: Int) -> UInt? {
        if radix < 2 || radix > 36 {
            return None
        }
        self._parse_uint(radix)
    }

    // `String.to_float` lives in `sawc/std/float.saw`, beside `Float.to_string`
    // and the bit-level layer both directions share (design 253).

    // The byte at `i` widened to Int, the width the decoder and the number
    // parsers work in: scalar assembly multiplies by 4096 and 262144, and
    // `b0 - 224` would not fit a byte.
    func _ubyte_at(&self, i: Int) -> Int {
        self.byte_at(i) as Int
    }

    // Decodes one UTF-8 scalar starting at byte offset `i` (`len` is the total
    // byte length). Returns `(scalar, nbytes)`:
    //   - nbytes in 1..4 and `scalar` the Unicode scalar value on success;
    //   - nbytes == 0 for a malformed sequence starting at `i` (invalid lead,
    //     bad/short continuation, overlong, surrogate, or > U+10FFFF).
    // The single source of UTF-8 truth: `_utf8_error_offset` (for `fromBytes`)
    // and `StringScalars` both decode through it. Scalar assembly multiplies
    // (*64, *4096, *262144) for the 6/12/18-bit shifts.
    func _decode_at(&self, i: Int, len: Int) -> (Int, Int) {
        let b0 = self._ubyte_at(i)
        if b0 < 128 {
            // 0x00..0x7F: ASCII.
            return (b0, 1)
        }
        if b0 < 194 {
            // 0x80..0xBF: a continuation byte cannot lead. 0xC0/0xC1 (192/193)
            // could only ever encode an overlong ASCII byte -> reject.
            return (0, 0)
        }
        if b0 < 224 {
            // 0xC2..0xDF: two-byte sequence.
            if i + 1 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            if b1 < 128 || b1 > 191 { return (0, 0) }       // bad continuation
            return ((b0 - 192) * 64 + (b1 - 128), 2)
        }
        if b0 < 240 {
            // 0xE0..0xEF: three-byte sequence.
            if i + 2 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            // First-continuation bounds tighten to forbid overlong (0xE0) and
            // UTF-16 surrogates D800..DFFF (0xED).
            var lo = 128
            var hi = 191
            if b0 == 224 { lo = 160 }                       // reject overlong
            if b0 == 237 { hi = 159 }                       // reject surrogate
            if b1 < lo || b1 > hi { return (0, 0) }
            let b2 = self._ubyte_at(i + 2)
            if b2 < 128 || b2 > 191 { return (0, 0) }
            return ((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128), 3)
        }
        if b0 < 245 {
            // 0xF0..0xF4: four-byte sequence.
            if i + 3 >= len { return (0, 0) }               // truncated
            let b1 = self._ubyte_at(i + 1)
            // Tighten to forbid overlong (0xF0) and > U+10FFFF (0xF4).
            var lo = 128
            var hi = 191
            if b0 == 240 { lo = 144 }                       // reject overlong
            if b0 == 244 { hi = 143 }                       // reject > U+10FFFF
            if b1 < lo || b1 > hi { return (0, 0) }
            let b2 = self._ubyte_at(i + 2)
            if b2 < 128 || b2 > 191 { return (0, 0) }
            let b3 = self._ubyte_at(i + 3)
            if b3 < 128 || b3 > 191 { return (0, 0) }
            return ((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128), 4)
        }
        // 0xF5..0xFF: no valid lead byte encodes a scalar <= U+10FFFF.
        return (0, 0)
    }

    // The byte offset at which the first malformed UTF-8 sequence begins, or
    // None if the whole buffer is valid (Rust's `valid_up_to()` semantics).
    func _utf8_error_offset(&self) -> Int? {
        let len = self.len()
        var i = 0
        while i < len {
            let d = self._decode_at(i, len)
            if d.1 == 0 {
                return i
            }
            i = i + d.1
        }
        None
    }

    /// Builds a validated `String` from raw bytes.
    ///
    /// `Err(Utf8Error)` carries the byte offset at which the first malformed
    /// sequence begins. The `Err` means only "these bytes are not UTF-8";
    /// allocator exhaustion panics.
    ///
    /// Static: call as `String.fromBytes(&data)`.
    public static func fromBytes(data: &Data) unsafe -> Result<String, Utf8Error> {
        let n = data.len()
        if n == 0 {
            return ""                       // trivially-valid empty string (Ok)
        }
        let ptr = __saw_string_alloc(n)
        var i = 0
        while i < n {
            if let b = data.get(i) {
                // A reinterpret, not a conversion: a byte >= 0x80 must reach
                // the validator rather than trap on the way in.
                ptr[i] = to_c_char(b)
            }
            i = i + 1
        }
        ptr[n] = 0 as Int8
        let candidate = ptr as String
        if let off = candidate._utf8_error_offset() {
            // `candidate` (rc=1) is released at scope exit.
            return Utf8Error(offset: off)
        }
        // `move` consumes `candidate` rather than retain-then-release.
        return move candidate
    }

    // The iterator holds its own retain on the String, so
    // `for b in makeString().bytes()` keeps the bytes alive for the whole loop.
    public func bytes(&self) -> StringBytes {
        StringBytes(s: self, index: 0, length: self.len())
    }

    // Iterates Unicode scalar values, retaining the String like `bytes()`.
    // String contents are always valid UTF-8 (literals are source-encoded;
    // `fromBytes` validates), so a decode error is unreachable; on a buffer
    // corrupted by unsafe code the iterator stops (see `StringScalars.next`).
    public func scalars(&self) -> StringScalars {
        StringScalars(s: self, index: 0, length: self.len())
    }

    // Scoped C-string borrow. The String payload is already NUL-terminated
    // (codegen/core.py `_declare_string_runtime`), so `body` gets the bytes
    // pointer directly, with no copy. `body` is a non-escaping closure
    // parameter, so the pointer cannot outlive the call. `body` is `unsafe`
    // because it receives a raw pointer (design 130); calling this needs no
    // ceremony.
    public func withCString<R>(&self, body: (UnsafePointer<Int8>) unsafe -> R) unsafe -> R {
        body(self as UnsafePointer<Int8>)
    }
}

extension Vector<String> {
    public func join(&self, separator: String) unsafe -> String {
        let count = self.len()

        if count == 0 {
            ""
        } else if count == 1 {
            if let first = self.get(0) {
                first
            } else {
                ""
            }
        } else {
            // Calculate total length needed
            let sep_len = separator.len()
            var total_len = 0
            var i = 0
            while i < count {
                if let s = self.get(i) {
                    total_len = total_len + s.len()
                }
                i = i + 1
            }
            // Add separator lengths (count - 1 separators)
            total_len = total_len + (sep_len * (count - 1))

            // Allocator exhaustion panics inside `__saw_string_alloc`.
            let buf = __saw_string_alloc(total_len)
            var pos = 0
            var idx = 0
            while idx < count {
                // Add separator before all but first element
                if idx > 0 {
                    var k = 0
                    while k < sep_len {
                        buf[pos] = to_c_char(separator.byte_at(k))
                        pos = pos + 1
                        k = k + 1
                    }
                }

                // Copy the string
                if let s = self.get(idx) {
                    let s_len = s.len()
                    var j = 0
                    while j < s_len {
                        buf[pos] = to_c_char(s.byte_at(j))
                        pos = pos + 1
                        j = j + 1
                    }
                }
                idx = idx + 1
            }

            buf[total_len] = 0 as Int8  // null terminate
            buf as String
        }
    }
}

// Returned by `String.fromBytes` when the input is not valid UTF-8. `offset` is
// the byte index at which the first malformed sequence begins (the bytes before
// it decode cleanly).
public struct Utf8Error {
    public offset: Int
}

extension Utf8Error: Error {
    public func format(&self, into: &var StringBuilder) {
        try! into.append("invalid UTF-8 at byte offset ")
        try! into.append(self.offset)
    }
}

// Both iterators store the source String by value: String is Copy, so the
// field retains it and the synthesized deinit releases it. That independent
// retain keeps a temporary receiver's bytes alive across every `next()` in
// `for c in makeString().scalars()`.
//
// Public because `String.bytes()` returns one; the fields stay private.
public struct StringBytes {
    private s: String
    private index: Int
    private length: Int
}

extension StringBytes: Iterator {
    type Item = Byte

    public func next(&var self) -> Byte? {
        if self.index < self.length {
            let b = self.s.byte_at(self.index)
            self.index = self.index + 1
            b
        } else {
            None
        }
    }
}

// Public because `String.scalars()` returns one.
public struct StringScalars {
    private s: String
    private index: Int
    private length: Int
}

extension StringScalars: Iterator {
    type Item = Scalar

    public func next(&var self) -> Scalar? {
        if self.index >= self.length {
            return None
        }
        let d = self.s._decode_at(self.index, self.length)
        if d.1 == 0 {
            // Malformed sequence. Unreachable for a validated String; if unsafe
            // code corrupted the buffer we stop cleanly rather than loop or trap.
            self.index = self.length
            return None
        }
        self.index = self.index + d.1
        // `_decode_at` rejects surrogates and anything past U+10FFFF, so this
        // construction cannot fail.
        try! Scalar(value: d.0)
    }
}
