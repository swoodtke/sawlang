// Map<K, V> - Key-Value Map implementation
// Part of the Saw standard library
//
// Current implementation: Linear search with parallel arrays
// TODO: Upgrade to hash table with Hashable interface

// =============================================================================
// Vector extension for swap_remove (used internally by Map)
// =============================================================================

extension Vector<T> {
    // Remove element at index by swapping with last element (O(1))
    // Returns the removed element, or None if out of bounds
    func swap_remove(&var self, index: Int) -> T? {
        if index < 0 || index >= self.length {
            None
        } else {
            if let buf = self.buffer {
                let removed = buf[index]
                // Move last element to this position (if not already last)
                if index < self.length - 1 {
                    buf[index] = buf[self.length - 1]
                }
                self.length = self.length - 1
                removed
            } else {
                None
            }
        }
    }
}

// =============================================================================
// Map<K, V> - A key-value map
// =============================================================================

// Map threads the allocator `A` (design 37) into both backing vectors, so a
// `Map<K, V, A>` allocates its keys and values through the SAME allocator. The
// default `A = Global` keeps hosted `Map<K, V>` unchanged (one identity with
// `Map<K, V, Global>`); the parameter falls out mechanically because Map's only
// storage is two `Vector`s, which already carry `A` (brief 37 item 2).
struct Map<K, V, A: Allocator = Global> {
    keys: Vector<K, A>
    values: Vector<V, A>
}

// A Map needs to compare keys, so its lookup/insert operations require
// `K: Equatable` (design 32). The bound rides on the whole extension; every
// Map key type used with these methods (Int, String, ...) is Equatable.
extension Map<K: Equatable, V, A: Allocator = Global> {
    // Create an empty map
    init() -> Map<K, V, A> {
        Map<K, V, A>(keys: Vector<K, A>(), values: Vector<V, A>())
    }

    // Get the number of key-value pairs
    func len(&self) -> Int {
        self.keys.len()
    }

    // Check if the map is empty
    func is_empty(&self) -> Bool {
        self.keys.is_empty()
    }

    // Insert or update a key-value pair
    // Returns the old value if key existed, None otherwise
    func insert(&var self, key: K, value: V) -> V? {
        // Search for existing key
        var i = 0
        while i < self.keys.len() {
            if let existing_key = self.keys.get(i) {
                if existing_key == key {
                    // Key exists - update value and return old
                    let old_value = self.values.get(i)
                    self.values.set(i, value)
                    return old_value
                }
            }
            i = i + 1
        }
        // Key doesn't exist - append new pair
        self.keys.push(key)
        self.values.push(value)
        None
    }

    // Get value for a key
    func get(&self, key: K) -> V? {
        var i = 0
        while i < self.keys.len() {
            if let existing_key = self.keys.get(i) {
                if existing_key == key {
                    return self.values.get(i)
                }
            }
            i = i + 1
        }
        None
    }

    // Check if map contains a key
    func contains_key(&self, key: K) -> Bool {
        var i = 0
        while i < self.keys.len() {
            if let existing_key = self.keys.get(i) {
                if existing_key == key {
                    return true
                }
            }
            i = i + 1
        }
        false
    }

    // Remove a key and return its value
    func remove(&var self, key: K) -> V? {
        var i = 0
        while i < self.keys.len() {
            if let existing_key = self.keys.get(i) {
                if existing_key == key {
                    // Found - remove by swapping with last element
                    let result = self.values.get(i)
                    self.keys.swap_remove(i)
                    self.values.swap_remove(i)
                    return result
                }
            }
            i = i + 1
        }
        None
    }

    // Remove all entries
    func clear(&var self) {
        self.keys.clear()
        self.values.clear()
    }
}

// Map is ExplicitCopy because it contains Vectors (which are ExplicitCopy):
// never implicitly duplicated, and `.copy()` deep-copies both backing vectors.
// copy() delegates to Vector.copy(), which needs each element's copy path, so
// the conformance is conditional on `<K: Copy, V: Copy>`. A Map whose keys or
// values are not Copy is still constructible and move-only; it just has no
// copy() (calling it names the unmet bound), mirroring Vector.
extension Map<K: Copy, V: Copy, A: Allocator = Global>: ExplicitCopy {
    func copy(&self) -> Map<K, V, A> {
        Map<K, V, A>(keys: self.keys.copy(), values: self.values.copy())
    }

    func deinit(&var self) {
        // Vectors will be cleaned up automatically via their deinit
    }
}
