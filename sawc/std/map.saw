// Map<K, V, A>: an open-addressing hash table with linear probing and
// tombstone deletion. Capacity is a power of two, so the bucket is
// `hash & (cap - 1)`, which relies on `Hasher.finish` folding the high half of
// its state into the low bits. The table doubles and rehashes once the load
// factor would exceed 3/4.
//
// Empty and Tombstone slots carry no payload, so a fresh table holds no
// garbage K/V to drop; the slot vector's own deinit drops occupied slots.
// Updates and removals move the old slot out with `Vector.swap_out`, so an
// owning key or value is returned or dropped exactly once.
//
// Iteration order is table order and unspecified. Map is ExplicitCopy when
// both `K` and `V` are; otherwise the conformance does not instantiate and the
// map is move-only.

enum MapSlot<K, V> {
    case Empty,
    case Tombstone,
    case Occupied(key: K, value: V)
}

// `cap` is the slot count (a power of two, 0 before the first insert); `count`
// is the number of Occupied slots.
public struct Map<K, V, A: Allocator = GlobalAllocator> {
    private slots: Vector<MapSlot<K, V>, A>
    private count: Int
    private cap: Int
}

extension Map<K: Hashable + Equatable, V, A: Allocator = GlobalAllocator> {
    // No allocation until the first insert.
    public init() -> Map<K, V, A> {
        Map<K, V, A>(slots: Vector<MapSlot<K, V>, A>(), count: 0, cap: 0)
    }

    public func len(&self) -> Int {
        self.count
    }

    public func is_empty(&self) -> Bool {
        self.count == 0
    }

    // ---- internal helpers -------------------------------------------------

    func _hash_code(&self, key: K) -> Int {
        var h = Hasher()
        key.hash(&var h)
        h.finish()
    }

    // The probing helpers match through the place `self.slots[i]`, reading the
    // tag and any payload where it sits. Nothing is copied out or dropped, so
    // they work for keys and values of any copy tier and a probe retains
    // nothing on the way past. `K` is not `Copy`, so reading a whole slot out
    // as a value is not allowed.

    // 0 = empty, 1 = occupied, 2 = tombstone.
    func _slot_state(&self, idx: Int) -> Int {
        if idx < 0 || idx >= self.slots.len() {
            return 0
        }
        match self.slots[idx] {
            case Empty -> 0,
            case Occupied(_, _) -> 1,
            case Tombstone -> 2
        }
    }

    // `k` binds the stored key in place and only compares it.
    func _key_eq(&self, idx: Int, key: K) -> Bool {
        if idx < 0 || idx >= self.slots.len() {
            return false
        }
        match self.slots[idx] {
            case Occupied(k, _) -> k == key,
            case Empty -> false,
            case Tombstone -> false
        }
    }

    // There is deliberately no helper that reads a key or value out of a slot
    // by value: at the owning tiers that read is an alias the map still owns,
    // a double free waiting for its release. Reach payloads by reference or
    // through a `borrows` accessor.

    // The bucket holding `key`, or -1 if absent. A separate function because
    // `lend` may not appear in a loop, so a searching `borrows` accessor finds
    // the bucket here and lends it there. `key` is used by value more than
    // once, a `Copy` requirement on `K` the extension header does not spell
    // (design 219).
    func _find(&self, key: K) -> Int {
        if self.cap == 0 {
            return -1
        }
        let mask = self.cap - 1
        var b = self._hash_code(key) & mask
        var probes = 0
        while probes < self.cap {
            let st = self._slot_state(b)
            if st == 0 {
                return -1
            }
            if st == 1 && self._key_eq(b, key) {
                return b
            }
            b = (b + 1) & mask
            probes = probes + 1
        }
        -1
    }

    // The value of a moved-in Occupied slot (its key is dropped), else None.
    func _take_value(&self, slot: MapSlot<K, V>) -> V? {
        match slot {
            case Occupied(k, v) -> { return v },
            case Empty -> { return None },
            case Tombstone -> { return None }
        }
    }

    // Grows to a fresh power-of-two table (8, then doubling) and rehashes the
    // live entries, dropping tombstones. A field cannot be partially moved, so
    // the new table is built in a local, each entry is moved out of the old one
    // with `swap_out`, and the local replaces `self.slots` at the end.
    //
    // `false` means the allocator refused and the map is untouched. The whole
    // table is reserved before any entry moves, so everything after the
    // reservation is allocation-free.
    func _try_grow(&var self) -> Bool {
        let new_cap = if self.cap == 0 { 8 } else { self.cap * 2 }
        let mask = new_cap - 1
        var new_slots = Vector<MapSlot<K, V>, A>()
        var reserved = false
        match new_slots.reserve(new_cap) {
            case Ok(_) -> { reserved = true },
            case Err(_) -> { reserved = false }
        }
        if not reserved {
            return false
        }
        var f = 0
        while f < new_cap {
            // Cannot refuse after the reserve; returning `false` if it did
            // still keeps the map untouched.
            match new_slots.push(MapSlot<K, V>.Empty) {
                case Ok(_) -> {},
                case Err(_) -> { return false }
            }
            f = f + 1
        }

        let old_cap = self.cap
        var j = 0
        while j < old_cap {
            let slot = self.slots.swap_out(j, MapSlot<K, V>.Empty)
            match slot {
                case Occupied(k, v) -> {
                    // Rehashed keys are unique and the new table has no
                    // tombstones, so the first empty slot is the home.
                    var b = self._hash_code(k) & mask
                    var found = false
                    while not found {
                        let is_empty = match new_slots[b] {
                            case Empty -> true,
                            case Occupied(_, _) -> false,
                            case Tombstone -> false
                        }
                        if is_empty {
                            found = true
                        } else {
                            b = (b + 1) & mask
                        }
                    }
                    new_slots.set(b, MapSlot<K, V>.Occupied(key: move k, value: move v))
                },
                case Empty -> { let _e = 0 },
                case Tombstone -> { let _t = 0 }
            }
            j = j + 1
        }
        self.slots = move new_slots
        self.cap = new_cap
        true
    }

    /// Inserts or updates, returning the previous value if the key was present.
    ///
    /// Reports `Err(AllocError)` when the table must be rehashed and the
    /// allocator refuses. On `Err` the map is unchanged: the rehash is refused
    /// before any entry moves, so every key that was in the table still is.
    /// `key` and `value` are consumed either way.
    public func insert(&var self, key: K, value: V) -> Result<V?, AllocError> {
        if self.cap == 0 || (self.count + 1) * 4 > self.cap * 3 {
            if not self._try_grow() {
                return self._grow_error()
            }
        }
        let mask = self.cap - 1
        var b = self._hash_code(key) & mask
        var first_tomb = -1
        var probes = 0
        while probes < self.cap {
            let st = self._slot_state(b)
            if st == 0 {
                // Key absent: reuse the first tombstone passed, if any.
                let target = if first_tomb >= 0 { first_tomb } else { b }
                self.slots.set(target, MapSlot<K, V>.Occupied(key: move key, value: move value))
                self.count = self.count + 1
                return None
            } else if st == 2 {
                if first_tomb < 0 {
                    first_tomb = b
                }
            } else {
                if self._key_eq(b, key) {
                    let old = self.slots.swap_out(b, MapSlot<K, V>.Occupied(key: move key, value: move value))
                    return self._take_value(move old)
                }
            }
            b = (b + 1) & mask
            probes = probes + 1
        }
        // Unreachable while the load factor keeps an empty slot; grow and
        // retry so the function stays total.
        if not self._try_grow() {
            return self._grow_error()
        }
        return self.insert(move key, move value)
    }

    // The request a refused rehash turned down. One function, so both refusal
    // points in `insert` describe the failure the same way.
    func _grow_error(&self) -> AllocError {
        let wanted = if self.cap == 0 { 8 } else { self.cap * 2 }
        AllocError(size: wanted * sizeof<MapSlot<K, V>>(),
                   align: alignof<MapSlot<K, V>>())
    }

    /// Returns the value stored under `key` as a place; this is the map's
    /// subscript.
    ///
    /// `m["k"]` names the value where it sits, so it is read or written inside
    /// the map rather than copied out: `m["k"]!.count += 1` writes the stored
    /// value, `m["k"]!.method()` borrows it, and `if let _ = m["k"]` asks only
    /// whether the key is there. An absent key opens no window, so
    /// `if let v = m["k"]` sees `None` and `m["k"]!` panics.
    ///
    /// Reading the place out as a value follows the value's copy tier: trivial
    /// copies bitwise, `Copy` retains, and `ExplicitCopy`/`NoCopy` is refused
    /// with the ways out named.
    ///
    /// `get` is the same lend under a named spelling.
    ///
    /// While the window is open the whole map is borrowed, so inserting or
    /// removing inside one is a compile error rather than an invalidated
    /// reference.
    public func [](&var self, key: K) borrows -> &var V? {
        let bucket = self._find(key)
        if bucket < 0 {
            return None
        }
        // The Empty and Tombstone arms are unreachable (the bucket is
        // occupied), but a `match` is total.
        match self.slots[bucket] {
            case Occupied(_, v) -> { lend v },
            case Empty -> { return None },
            case Tombstone -> { return None }
        }
    }

    /// Returns the value stored under `key` as a place; the named spelling of
    /// `[]`.
    ///
    /// `m.get(k)` and `m[k]` are one accessor under two names: both lend the
    /// value where it sits, both open no window for an absent key, and both
    /// follow the value's copy tier when the place is read out as a value.
    /// Reach a move-only value through the window (`m.get(k)!.method()`), or
    /// take it out with `remove`.
    public func get(&var self, key: K) borrows -> &var V? {
        let bucket = self._find(key)
        if bucket < 0 {
            return None
        }
        match self.slots[bucket] {
            case Occupied(_, v) -> { lend v },
            case Empty -> { return None },
            case Tombstone -> { return None }
        }
    }

    public func contains_key(&self, key: K) -> Bool {
        self._find(key) >= 0
    }

    // The slot becomes a tombstone so probing past it still reaches later
    // entries.
    public func remove(&var self, key: K) -> V? {
        let bucket = self._find(key)
        if bucket < 0 {
            return None
        }
        let old = self.slots.swap_out(bucket, MapSlot<K, V>.Tombstone)
        self.count = self.count - 1
        self._take_value(move old)
    }
}

// =============================================================================
// Iteration: visitors and snapshots
// =============================================================================
//
// Map has no iterator; it offers non-escaping closure visitors (no allocation)
// and Vector snapshots built on them. Visitors walk the slot array in table
// order, which is unspecified.
//
// Keys and values are lent as `&K` and `&V`: the walk reaches each slot as a
// `&MapSlot<K, V>` through `Vector.each` and matches that reference, so the
// arm bindings alias the stored entry. Nothing is retained or dropped, which
// is what makes every copy tier visitable; reading the payload out by value
// would leak at the Copy tier and alias at the owning tiers. The reference
// match is not a place window because a window's body is `sync`, which would
// force `sync` onto every visitor.
//
// `each*` borrow the map for the whole walk, so a visitor that also captures
// the map mutably is an exclusivity error (examples/map_each_mutate_error.saw).
extension Map<K: Hashable + Equatable, V, A: Allocator = GlobalAllocator> {
    /// Visits each live entry in table order, lending the key and the value to
    /// `body` as a `&K` and a `&V`. Nothing is copied and nothing is
    /// transferred — the entry is observed where the map stores it — so a key
    /// or value of any copy tier is visitable. Order is unspecified; `body` is
    /// non-escaping.
    public func each(&self, body: (&K, &V) -> Void) {
        self.slots.each({ slot in
            match slot {
                case Occupied(k, v) -> { body(&k, &v) },
                case Empty -> {},
                case Tombstone -> {}
            }
        })
    }

    /// Visits each live key in table order, lending it to `body` as a `&K`.
    /// Order is unspecified; `body` is non-escaping.
    public func each_key(&self, body: (&K) -> Void) {
        self.slots.each({ slot in
            match slot {
                case Occupied(k, _) -> { body(&k) },
                case Empty -> {},
                case Tombstone -> {}
            }
        })
    }

    /// Visits each live value in table order, lending it to `body` as a `&V`.
    /// Order is unspecified; `body` is non-escaping.
    public func each_value(&self, body: (&V) -> Void) {
        self.slots.each({ slot in
            match slot {
                case Occupied(_, v) -> { body(&v) },
                case Empty -> {},
                case Tombstone -> {}
            }
        })
    }
}

// Snapshots copy entries that stay live in the map, hence `K: Copy` for
// `keys()` and `V: Copy` for `values()`. The result uses the map's allocator.
extension Map<K: Hashable + Equatable + Copy, V, A: Allocator = GlobalAllocator> {
    // The one allocation that can fail is the up-front reserve, which is
    // reported. The visitor yields exactly `count` entries, so no `push` can
    // grow the vector; the `try!` states that in a `Void` visitor body.
    public func keys(&self) -> Result<Vector<K, A>, AllocError> {
        var out = Vector<K, A>()
        match out.reserve(self.count) {
            case Ok(_) -> {},
            case Err(e) -> { return e }
        }
        self.each_key({ [&var out] k in try! out.push(k) })
        return move out
    }
}

extension Map<K: Hashable + Equatable, V: Copy, A: Allocator = GlobalAllocator> {
    // Reserved up front for the reason given on `keys()`.
    public func values(&self) -> Result<Vector<V, A>, AllocError> {
        var out = Vector<V, A>()
        match out.reserve(self.count) {
            case Ok(_) -> {},
            case Err(e) -> { return e }
        }
        self.each_value({ [&var out] v in try! out.push(v) })
        return move out
    }
}

// Destruction is unconditional, so `deinit` lives on this unbounded extension
// rather than in the bounded `ExplicitCopy` conformance below, as in
// vector.saw. The body is empty: the compiler appends the field drops, and the
// slot vector's deinit drops every occupied entry.
extension Map<K, V, A: Allocator = GlobalAllocator> {
    public func deinit(&var self) {
    }
}

// A bitwise copy of the slots buffer would double-free, so duplication is a
// visible `.copy()` that builds a new table with each key and value copied at
// its own tier. The bounds are what the body spells (`k.copy()`, `v.copy()`,
// `insert`); every Copy-tier type satisfies `ExplicitCopy`, so one body serves
// both, and an uncopyable key or value makes `.copy()` a compile error.
extension Map<K: Hashable + Equatable + ExplicitCopy, V: ExplicitCopy, A: Allocator = GlobalAllocator>: ExplicitCopy {
    // Index-keyed read-only lends for the copy path. A match arm that binds a
    // payload and uses it is a value read, refused at the ExplicitCopy tier;
    // lending the binding lets the caller chain `.copy()` off the place. A key
    // is never writable through a lend, since its bucket depends on its hash.
    func _key_ref(&self, idx: Int) borrows -> &K? {
        match self.slots[idx] {
            case Occupied(k, _) -> { lend k },
            case Empty -> { return None },
            case Tombstone -> { return None }
        }
    }

    func _value_ref(&self, idx: Int) borrows -> &V? {
        match self.slots[idx] {
            case Occupied(_, v) -> { lend v },
            case Empty -> { return None },
            case Tombstone -> { return None }
        }
    }

    // The ExplicitCopy hook is infallible by the trait's signature, so this
    // panics on allocator refusal, never returns missing entries. The panic is
    // spelled by hand so the message names the method (design 234).
    /// Duplicates the map into a new table, copying each live key and value
    /// at its own tier. Panics if the allocator refuses; `try_copy` reports
    /// the failure instead. Iteration order and capacity are not part of the
    /// contract, only the live entries are.
    public func copy(&self) -> Map<K, V, A> {
        var result = Map<K, V, A>()
        var i = 0
        while i < self.cap {
            if self._slot_state(i) == 1 {
                let k2 = self._key_ref(i)!.copy()
                let v2 = self._value_ref(i)!.copy()
                match result.insert(move k2, move v2) {
                    case Ok(_) -> {},
                    case Err(e) -> panic("Map.copy: {}", e)
                }
            }
            i = i + 1
        }
        move result
    }
}

// The reporting twin of `copy`; its `try_` name still owes a ruling (DF-257b).
extension Map<K: Hashable + Equatable + ExplicitCopy, V: ExplicitCopy, A: Allocator = GlobalAllocator> {
    /// Duplicates the map, returning `Err(AllocError)` if the allocator
    /// refuses while rehashing the new table.
    public func try_copy(&self) -> Result<Map<K, V, A>, AllocError> {
        var result = Map<K, V, A>()
        var i = 0
        while i < self.cap {
            if self._slot_state(i) == 1 {
                let k2 = self._key_ref(i)!.copy()
                let v2 = self._value_ref(i)!.copy()
                match result.insert(move k2, move v2) {
                    case Ok(_) -> {},
                    case Err(e) -> { return e }
                }
            }
            i = i + 1
        }
        return move result
    }
}
