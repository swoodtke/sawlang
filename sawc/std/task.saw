//! Thread handles and the cooperative yield.
//!
//! `Thread.spawn { ... }` hands back a `Thread<T>` — a `VoidThread` when the
//! body returns nothing. A thread's lifetime is its handle's: dropping an
//! unjoined handle joins the thread, so it cannot outlive the scope that
//! spawned it. Nothing exposes the underlying OS thread.
//!
//! `yield_now` is the explicit cede. A task that only computes never parks on
//! I/O, so it never gives another task a turn on its own; one call per pass
//! through such a loop is enough.
//!
//! Requires `import std.task`.

// Thread<T> - the handle to a spawned OS thread (design 21 item 5, design 21b;
// renamed from `Task<T>` by design 242, which gave the cooperative engine the
// `Task` vocabulary and left this one the `Thread` namespace it always meant).
//
// `Thread.spawn { ... } -> Thread<T>` launches the closure on a fresh pthread
// (hosted engine) and hands back this NoCopy handle. The thread-launch machinery
// lives in spawn codegen; this file provides the value-level API over the
// control block.
//
// Control block (allocated by spawn codegen), laid out as:
//     { pthread_t tid (8 bytes), i8* env, T result }
// The pthread_t lives at byte 0 (design 117: spawn codegen stores the handle
// __saw_rt_thread_spawn returns there; join loads it and passes it by value to
// __saw_rt_thread_join), the closure's heap environment pointer at byte 8, and
// the task's result at byte 16 (written by the trampoline after the body returns).
//
// Structured by default: a thread's lifetime is a value's lifetime. Dropping an
// unjoined Thread JOINS it (deinit below), so a thread cannot outlive its
// handle. The engine never exposes a thread id/handle to Saw code.
//
// NOTE (deviation from the item-5 sketch): the original brief wrote
// `join(move self)`. Saw has no `move self` receiver form, so `join` takes
// `&var self` and sets a `joined` flag once joined; `deinit` only joins while
// that flag is clear. This yields the same join-once / join-on-deinit semantics
// without a consuming receiver.

extern "C" {
    // design 117: join an OS thread by its handle value (pthread_t word).
    func __saw_rt_thread_join(handle: Int)
}

// =============================================================================
// The NativeThread trait (design 118 stage 4)
// =============================================================================
// The minimal OS-thread surface the executor's Saw side consumes: JOIN by handle.
// The SPAWN half stays the compiler-emitted `__saw_rt_thread_spawn` primitive (spawn
// codegen builds a control block + a raw C-ABI trampoline pointer — DF-113b, a value
// Saw cannot express — the thread analog of the coroutine frame layout the compiler
// keeps). `PosixThread` wraps `__saw_rt_thread_join`; a future SOS-hosted runtime
// implements the SAME trait over kernel threads (its thread handle == the word). Both
// the `Thread.spawn` engine (here) and the MT `TaskGroup` drain (which joins its
// workers as `VoidThread`s) join through this surface. Consumed by static dispatch
// through the conformance — no per-join boxing; the impl is link/compile-time
// selected, so an `any NativeThread` existential would add an allocation with no
// runtime-swap benefit (same rationale as the design-118 stage-3
// `Reactor`/`SystemReactor`). Internal to the thread engine (not `public`).
//
// Design 242 renamed it from `Thread`: that name is the user-facing handle now,
// and this trait is the OS thread the handle is a handle TO.
trait NativeThread {
    func join(&self)
}

struct PosixThread {
    handle: Int
}

extension PosixThread: NativeThread {
    func join(&self) {
        __saw_rt_thread_join(self.handle)
    }
}

/// The handle to a spawned thread, carrying the result type `T`.
///
/// `Thread.spawn { ... }` returns one. Take the result with `join`; a handle
/// that goes out of scope unjoined joins the thread itself and drops the
/// result. The handle cannot be copied, so exactly one place owns the thread.
public struct Thread<T> {
    // Points at the thread control block (`None` only on the inert OOM path).
    handle: UnsafePointer<Int8>?
    // Set once the thread has been joined, so `deinit` does not double-join/free.
    joined: Bool
}

// design 186: the control-block pointer blocks both derivations. A handle is
// one owner of a block the thread engine already synchronizes, and the only
// value that crosses is the RESULT — so both directions hold exactly when `T`
// may travel.
extension Thread<T: Send>: UnsafeSend {}
extension Thread<T: Send>: UnsafeSync {}

/// Taking a thread's result.
extension Thread<T> {
    /// Waits for the thread to finish and returns its result.
    ///
    /// Blocks the calling thread. A thread yields its result once: joining a
    /// second time, or joining a handle whose thread was already joined at scope
    /// exit, panics.
    public func join(&var self) unsafe -> T {
        if self.joined {
            // Already joined (or inert): no result to hand back. Misuse —
            // panic deterministically (design 49).
            panic("Thread.join: thread already joined")
        } else {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                // design 230 unit B: the body is provably finished — the thread
                // is joined — so the quiescent report may stop counting it as
                // something this process could still run.
                __saw_exec_thread_task_ended()
                let result_ptr = (h + 16) as UnsafePointer<T>
                // The control block is freed on the next line, so the result's
                // ownership leaves it here (design 219 unit A2).
                let result = move result_ptr[0]
                GlobalAllocator().dealloc(h, 16 + sizeof<T>(), 16)
                self.joined = true
                result
            } else {
                panic("Thread.join: thread has no result handle")
            }
        }
    }
}

/// A thread handle is not copyable — one owner, one join — and joins its thread
/// when it goes out of scope.
extension Thread<T>: NoCopy {
    /// Joins the thread unless `join` already did, drops the unclaimed result,
    /// and frees the control block.
    public func deinit(&var self) unsafe {
        // An unjoined thread is joined at scope exit (structured concurrency),
        // its unclaimed result dropped, and the control block freed.
        if not self.joined {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                __saw_exec_thread_task_ended()   // design 230 unit B, as in `join`
                let result_ptr = (h + 16) as UnsafePointer<T>
                __saw_deinit_in_place(result_ptr)
                GlobalAllocator().dealloc(h, 16 + sizeof<T>(), 16)
            }
        }
    }
}

// VoidThread — the handle for a spawned thread whose body returns `Void`
// (design 242 ruling 2, the thread-engine twin of `VoidTask`). A distinct named
// type rather than `Thread<Void>` for two reasons: the visible-`Void` rule
// (designs 122/132) makes `Thread<Void>` unwritable as an annotation, so a
// handle you cannot name is a handle you cannot store; and joining one has
// nothing to hand back, so its `join` is `-> Void` where the generic one is
// `-> T`.
//
// Layout is `Thread<T>`'s: the control block's result slot is a one-byte
// placeholder that is never stored and never read, so this handle simply has
// no result to take. The `16` in the deallocations below is that same
// `16 + sizeof<T>()` at `T = Void`.
/// The handle to a spawned thread that returns nothing.
///
/// `Thread.spawn { ... }` returns one when the body's value is `Void`. `join`
/// waits for the thread and returns; a handle that goes out of scope unjoined
/// joins the thread itself.
public struct VoidThread {
    handle: UnsafePointer<Int8>?
    joined: Bool
}

extension VoidThread: UnsafeSend {}
extension VoidThread: UnsafeSync {}

/// Waiting for a thread that returns nothing.
extension VoidThread {
    /// Waits for the thread to finish.
    ///
    /// Blocks the calling thread. Joining a second time, or joining a handle
    /// whose thread was already joined at scope exit, panics.
    public func join(&var self) unsafe {
        if self.joined {
            panic("VoidThread.join: thread already joined")
        } else {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                __saw_exec_thread_task_ended()
                GlobalAllocator().dealloc(h, 16, 16)
                self.joined = true
            } else {
                panic("VoidThread.join: thread has no control block")
            }
        }
    }
}

/// A thread handle is not copyable — one owner, one join — and joins its thread
/// when it goes out of scope.
extension VoidThread: NoCopy {
    /// Joins the thread unless `join` already did and frees the control block.
    public func deinit(&var self) unsafe {
        if not self.joined {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                __saw_exec_thread_task_ended()
                GlobalAllocator().dealloc(h, 16, 16)
            }
        }
    }
}

// design 114: the public cooperative-yield primitive. `yield_now()` hands
// control back to the scheduler and is immediately re-ready — the one explicit
// cede a PURE-compute task loop needs (a task doing I/O yields implicitly when
// it parks on the reactor). This is a thin surface over the stdlib-internal
// `yield_now` cooperative-yield intrinsic; the bare intrinsic name is gated to
// std bodies, so user code reaches the yield only through this wrapper. Requires
// `import std.task` (design-82 prelude discipline — not auto-visible).
/// Hands control back to the scheduler, ready to run again immediately.
///
/// Suspends, so the caller must itself be driven by the scheduler. A loop that
/// only computes has no other place to yield, and starves every other task on
/// the thread until it calls this.
public func yield_now() {
    yield_now()
}

// design 158: the user-facing name for the in-process task dump. The walker
// itself lives beside the run queue it reads (std/taskgroup.saw, which is a
// prelude module); this is the import-gated surface, next to `yield_now`,
// because a task dump is a TASK-facing debug tool and nothing should reach it
// by accident.
/// Writes every live task's logical backtrace to standard output.
///
/// One task per entry — which group and slot holds it, and why it is not
/// running — followed by its stack innermost frame first, with the real
/// `file:line` of every suspending call between the task's entry point and the
/// place it is parked. This is what a native backtrace of a parked program
/// cannot show you: a suspended task is not on any thread stack.
///
/// ```saw
/// import std.task.{dump_tasks}
///
/// saw tasks: 2 live (as-of panic, unsynchronized)
///   task group 1 slot 0 gen 1 sleeping
///     at worker.saw:21 in leaf
///     at worker.saw:27 in middle
/// ```
///
/// Allocates nothing and needs no allocator, so it works inside a panic
/// handler, under an exhausted allocator, and in a freestanding image. The
/// panic path calls it for you: a program that dies with tasks in flight prints
/// this dump after its panic line.
///
/// The walk is unsynchronized. A multi-threaded group's worker may be resuming
/// a frame while this reads it, so treat an MT dump as a best-effort snapshot;
/// a single-threaded group is exact.
public func dump_tasks() {
    __saw_bt_dump()
}
