//! Task handles and the cooperative yield.
//!
//! `spawn { ... }` hands back a `Task<T>`. A task's lifetime is its handle's:
//! dropping an unjoined handle joins the task, so a task cannot outlive the
//! scope that spawned it. Nothing exposes the underlying thread.
//!
//! `yield_now` is the explicit cede. A task that only computes never parks on
//! I/O, so it never gives another task a turn on its own; one call per pass
//! through such a loop is enough.
//!
//! Requires `import std.task`.

// Task<T> - the handle to a spawned task (design 21 item 5, design 21b).
//
// `spawn { ... } -> Task<T>` launches the closure on a fresh pthread (hosted
// engine) and hands back this NoCopy handle. The task-launch machinery lives in
// spawn codegen; this file provides the value-level API over the control block.
//
// Control block (allocated by spawn codegen), laid out as:
//     { pthread_t tid (8 bytes), i8* env, T result }
// The pthread_t lives at byte 0 (design 117: spawn codegen stores the handle
// __saw_rt_thread_spawn returns there; join loads it and passes it by value to
// __saw_rt_thread_join), the closure's heap environment pointer at byte 8, and
// the task's result at byte 16 (written by the trampoline after the body returns).
//
// Structured by default: a task's lifetime is a value's lifetime. Dropping an
// unjoined Task JOINS it (deinit below), so a task cannot outlive its handle.
// The engine never exposes a thread id/handle to Saw code.
//
// NOTE (deviation from the item-5 sketch): the original brief wrote
// `join(move self)`. Saw has no `move self` receiver form, so `join` takes
// `&var self` and sets a `joined` flag once joined; `deinit` only joins while
// that flag is clear. This yields the same join-once / join-on-deinit semantics
// without a consuming receiver.

extern "C" {
    // design 117: join an OS thread by its handle value (pthread_t word).
    func __saw_rt_thread_join(handle: Int)
}

// =============================================================================
// The Thread trait (design 118 stage 4)
// =============================================================================
// The minimal OS-thread surface the executor's Saw side consumes: JOIN by handle.
// The SPAWN half stays the compiler-emitted `__saw_rt_thread_spawn` primitive (spawn
// codegen builds a control block + a raw C-ABI trampoline pointer — DF-113b, a value
// Saw cannot express — the thread analog of the coroutine frame layout the compiler
// keeps). `PosixThread` wraps `__saw_rt_thread_join`; a future SOS-hosted runtime
// implements the SAME trait over kernel threads (its thread handle == the word). Both
// the `spawn`/`Task` engine (here) and the MT `TaskGroup` drain (which joins its
// workers as `Task`s) join through this surface. Consumed by static dispatch through
// the conformance — no per-join boxing; the impl is link/compile-time selected, so an
// `any Thread` existential would add an allocation with no runtime-swap benefit (same
// rationale as the design-118 stage-3 `Reactor`/`SystemReactor`). Internal to the
// thread engine (not `public`) — no user-facing `Thread`/`PosixThread` collision.
trait Thread {
    func join(&self)
}

struct PosixThread {
    handle: Int
}

extension PosixThread: Thread {
    func join(&self) {
        __saw_rt_thread_join(self.handle)
    }
}

/// The handle to a spawned task, carrying the result type `T`.
///
/// `spawn { ... }` returns one. Take the result with `join`; a handle that goes
/// out of scope unjoined joins the task itself and drops the result. The handle
/// cannot be copied, so exactly one place owns the task.
struct Task<T> {
    // Points at the task control block (`None` only on the inert OOM path).
    handle: UnsafePointer<Int8>?
    // Set once the task has been joined, so `deinit` does not double-join/free.
    joined: Bool
}

/// Taking a task's result.
extension Task<T> {
    /// Waits for the task to finish and returns its result.
    ///
    /// Blocks the calling thread. A task yields its result once: joining a
    /// second time, or joining a handle whose task was already joined at scope
    /// exit, panics.
    public unsafe func join(&var self) -> T {
        if self.joined {
            // Already joined (or inert): no result to hand back. Misuse —
            // panic deterministically (design 49).
            panic("Task.join: task already joined")
        } else {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                let result_ptr = (h + 16) as UnsafePointer<T>
                let result = result_ptr[0]
                GlobalAllocator().dealloc(h, 16 + sizeof<T>(), 16)
                self.joined = true
                result
            } else {
                panic("Task.join: task has no result handle")
            }
        }
    }
}

/// A task handle is not copyable — one owner, one join — and joins its task
/// when it goes out of scope.
extension Task<T>: NoCopy {
    /// Joins the task unless `join` already did, drops the unclaimed result, and
    /// frees the control block.
    public unsafe func deinit(&var self) {
        // An unjoined task is joined at scope exit (structured concurrency), its
        // unclaimed result dropped, and the control block freed.
        if not self.joined {
            if let h = self.handle {
                PosixThread(handle: (h as UnsafePointer<Int>)[0]).join()
                let result_ptr = (h + 16) as UnsafePointer<T>
                __saw_deinit_in_place(result_ptr)
                GlobalAllocator().dealloc(h, 16 + sizeof<T>(), 16)
            }
        }
    }
}

// design 114: the public cooperative-yield primitive. `yield_now()` hands
// control back to the scheduler and is immediately re-ready — the one explicit
// cede a PURE-compute task loop needs (a task doing I/O yields implicitly when
// it parks on the reactor). This is a thin surface over the stdlib-internal
// `yield_now` cooperative-yield intrinsic; the bare intrinsic name is gated to
// std bodies, so user code reaches the yield only through this wrapper. Requires
// `import std.task` (design-82 prelude discipline — not auto-visible).
/// Hands control back to the scheduler, ready to run again immediately.
///
/// Suspends, so the caller must itself be driven by the scheduler. A loop that
/// only computes has no other place to yield, and starves every other task on
/// the thread until it calls this.
public func yield_now() {
    yield_now()
}
