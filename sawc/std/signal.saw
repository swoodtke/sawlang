//! OS signals as suspending events.
//!
//! Watching a signal gives you a handle whose `next()` suspends until the
//! signal arrives, exactly as a socket read suspends until bytes arrive. There
//! are no callbacks: a signal is something a task waits for, not something that
//! interrupts one.
//!
//! ```saw
//! import std.signal.{Signal, SignalWatch}
//!
//! func shutdown(watch: SignalWatch, work: VoidTask) {
//!     try! watch.next()        // suspends until SIGTERM arrives
//!     work.cancel()            // wakes the io-parked worker; it unwinds
//! }
//! ```
//!
//! Cleanup rides cancellation and deinits, and there is no exit registry to
//! register with. The pattern is a task that watches the signal, cancels the
//! rest of the work, and lets values deinit deterministically as the tasks
//! unwind; `main` then returns normally. `process.exit(code)` remains the
//! escape hatch that runs no cleanup at all.
//!
//! Hosted only, like `std.net`. A freestanding target has no signals to watch.

// Delivery: the runtime installs a handler that writes an 8-byte generation
// record to a pipe, and
// the watch registers the pipe's read end with the reactor, so a parked watcher
// is an ordinary io park with precise wakeup, cancellation and the op budget.
// The pipe is one mechanism on both hosts, needs no new ABI seam, and, unlike
// signalfd, does not require the signal blocked in every thread (rt/shim.c,
// design 272).
//
// SIGPIPE is not a case: the runtime suppresses it (per socket on macOS, per
// send on Linux), so a write to a
// hung-up peer is `Err(IoError)` with kind `BrokenPipe`.
//
// SIGCHLD is not a case: std.process owns child reaping (with `waitpid`), so
// its disposition is left to std.process rather than shared with a watcher.

import std.net.{IoError, IoErrorKind}

extern "C" {
    // Portable signal tag -> this host's number (rt/shim.c). The numbers
    // differ between hosts (SIGUSR1 is 30 on macOS, 10 on Linux).
    func __saw_signal_number(tag: Int) -> Int
    // Install the handler and pipe for `signo`; returns the read end, or a
    // negative refusal (-1 bad signal, -2 already watched, -3 the pipe or the
    // handler could not be installed).
    func __saw_signal_watch(signo: Int) -> Int
    // Restore the disposition this watch replaced and empty the pipe. The pipe
    // is never closed (rt/shim.c, RULE 2).
    func __saw_signal_unwatch(signo: Int)
    // Send a signal to this process.
    func __saw_signal_raise(signo: Int) -> Int
    // Take the current watch's deliveries off this signal's pipe: a positive
    // count, or -1 for nothing pending. Takes the signal rather than the fd
    // because it also checks the generation tag: a record from a handler in
    // flight across a teardown belongs to the previous watch and is discarded
    // (rt/shim.c, RULE 3).
    //
    // The read is on the C side because an `extern "C" func read(...)` is
    // program-global: std declaring one would collide with any program that
    // declares `read` differently (e.g. as `blocking`).
    func __saw_signal_drain(signo: Int) -> Int

    func __saw_rt_op_budget_tick() -> Int
    func __saw_rt_op_budget_reset()
}

/// A signal this process can watch.
///
/// Curated rather than exhaustive: every case is one a program has a reason to
/// handle. `SIGKILL` and `SIGSTOP` are absent because the OS does not let any
/// process intercept them — there is no refusal to report because there is no
/// way to spell the request.
public enum Signal {
    /// `SIGTERM` — a polite request to shut down. What service managers send.
    case Terminate,
    /// `SIGINT` — an interactive interrupt, typically Ctrl-C.
    case Interrupt,
    /// `SIGHUP` — the controlling terminal went away. Conventionally also
    /// "reload your configuration" for a long-running service.
    case Hangup,
    /// `SIGQUIT` — an interactive quit, typically Ctrl-\.
    case Quit,
    /// `SIGUSR1` — no meaning of its own; whatever the program decides.
    case User1,
    /// `SIGUSR2` — the second signal with no meaning of its own.
    case User2,
    /// `SIGWINCH` — the terminal window changed size.
    case WindowChanged
}

// The portable tag the host maps. Kept beside the enum so the two orders cannot
// drift apart, and matching the table in rt/ABI.md.
func signal_tag(which: Signal) -> Int {
    match which {
        case Terminate -> 1,
        case Interrupt -> 2,
        case Hangup -> 3,
        case Quit -> 4,
        case User1 -> 5,
        case User2 -> 6,
        case WindowChanged -> 7
    }
}

func watch_error(reason: Int) -> IoError {
    if reason == -2 {
        return IoError.of(syscall: "watch: that signal is already being watched",
                          kind: IoErrorKind.AlreadyExists)
    }
    if reason == -1 {
        return IoError.of(syscall: "watch: this host has no such signal",
                          kind: IoErrorKind.InvalidArgument)
    }
    IoError.of(syscall: "watch", kind: IoErrorKind.ResourcesExhausted)
}

/// A live watch on one signal.
///
/// While the handle exists, the signal's default action does not run — a
/// watched `SIGTERM` no longer ends the process. Destroying the handle restores
/// whatever disposition the watch replaced, so the effect is scoped to the
/// handle's lifetime rather than to the program's.
///
/// `NoCopy`: a signal's disposition is process-global state, and this handle is
/// the single owner of it.
public struct SignalWatch {
    private signo: Int
    private fd: Int
}

extension SignalWatch {
    /// Begins watching `which`, replacing its default action.
    ///
    /// Fails with `AlreadyExists` if that signal is already being watched. One
    /// owner per signal is deliberate: the disposition is process-global, and
    /// the handle is what restores it, which is only well defined if exactly
    /// one handle holds it. A program that needs several readers of one signal
    /// builds that from one watch and a `Channel`.
    ///
    /// Fails with `InvalidArgument` if this host has no such signal, and
    /// `ResourcesExhausted` if the handler or its pipe could not be installed.
    public static func watch(which: Signal) -> Result<SignalWatch, IoError> {
        let signo = __saw_signal_number(signal_tag(which))
        if signo < 0 {
            return watch_error(-1)
        }
        let fd = __saw_signal_watch(signo)
        if fd < 0 {
            return watch_error(fd)
        }
        return SignalWatch(signo: signo, fd: fd)
    }

    /// Suspends until the watched signal is delivered.
    ///
    /// Returns once at least one delivery has arrived. Deliveries coalesce: the
    /// OS does not queue ordinary signals, so three `SIGTERM`s arriving between
    /// two calls may surface as one, and a count is not reported because the
    /// platform never had one to give.
    ///
    /// Fails with `Interrupted` if the task is cancelled while parked, matching
    /// every other cooperative wait.
    public func next(&self) -> Result<Void, IoError> {
        while {
            if cancelled() {
                io_unwait(self.fd, 0)
                return IoError.of(syscall: "next", kind: IoErrorKind.Interrupted)
            }
            let n = __saw_signal_drain(self.signo)
            if n > 0 {
                break                          // at least one delivery
            }
            // Nothing pending for this watch (the drain discards bytes stamped
            // under a previous watch), so park. The write end is never closed
            // (rt/shim.c, RULE 2), so there is no end-of-pipe case.
            io_wait(self.fd, 0)
            __saw_rt_op_budget_reset()
        }
        if __saw_rt_op_budget_tick() != 0 {
            yield_now()
        }
        return
    }
}

extension SignalWatch: NoCopy {
    /// Restores the disposition this watch replaced and drops its pipe.
    public func deinit(&var self) {
        if self.fd >= 0 {
            __saw_signal_unwatch(self.signo)
        }
    }
}

extension Signal {
    /// Sends this signal to the current process.
    ///
    /// The way a program triggers its own shutdown path, and the way a test
    /// exercises a watch without needing anything outside the process. Fails
    /// with `InvalidArgument` if this host has no such signal.
    ///
    /// ```saw
    /// try! Signal.Terminate.send_to_self()
    /// ```
    // A method, not a free `raise`: a free function is emitted under its bare
    // link symbol, so a std `raise` would shadow libc's for the whole program,
    // including the runtime's own C (SL-274). A method mangles by its type.
    public func send_to_self(&self) -> Result<Void, IoError> {
        let signo = __saw_signal_number(signal_tag(self))
        if signo < 0 {
            return watch_error(-1)
        }
        if __saw_signal_raise(signo) != 0 {
            return IoError.of(syscall: "send_to_self",
                              kind: IoErrorKind.InvalidArgument)
        }
        return
    }
}
