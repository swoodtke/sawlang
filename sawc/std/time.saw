//! Monotonic and wall-clock time.
//!
//! Read the monotonic clock with `Instant.now()` and measure spans with
//! `elapsed` or `duration_since`; both hand back a `Duration`. `unix_timestamp`
//! reads the wall clock instead, which is settable and can jump, so it is a
//! timestamp rather than a way to time anything.
//!
//! An `Instant` carries Int64 nanoseconds, so its layout does not shift with the
//! platform's `Int` width. Nothing here allocates.
//!
//! Requires `import std.time`. The module links libc for its clocks and is not
//! available in the freestanding profile. The `Duration` these methods return is
//! in the prelude and needs no import of its own.

// std.time (design 57 Part 4). HOSTED-ONLY: never loaded in the freestanding
// profile (see HOSTED_STD_MODULES in sawc.py) — a kernel supplies its own timer.
//
// `Duration` used to live here; design 180 unit 2 moved it to std/duration.saw
// so it could be prelude-visible in both profiles. `sleep` takes one and `sleep`
// is a prelude builtin, so requiring an import for its argument type would have
// put `import std.time` at the top of every file that naps.

// =============================================================================
// Clock seams (defined by the compiler — see codegen/core.py)
// =============================================================================
//
// The macOS/Linux CLOCK_MONOTONIC constant difference and the `struct timespec`
// layout live inside these compiler shims, so this module stays pure Saw.
extern "C" {
    // Monotonic clock, nanoseconds since an arbitrary epoch (only differences
    // are meaningful). Backs `Instant.now()`.
    func __saw_rt_clock_monotonic_nanos() -> Int64
    // Wall clock, seconds since the Unix epoch. Backs `unix_timestamp()`.
    func __saw_rt_unix_timestamp_secs() -> Int64
}

// =============================================================================
// Instant — a point on the monotonic clock
// =============================================================================

/// A point on the monotonic clock.
///
/// The stored value counts nanoseconds from an unspecified epoch, so a single
/// instant means nothing on its own. Compare two of them through `elapsed` or
/// `duration_since`.
public struct Instant {
    nanos: Int64
}

/// Reading the monotonic clock and measuring spans on it.
extension Instant {
    /// Returns the current monotonic instant.
    public static func now() -> Instant {
        Instant(nanos: __saw_rt_clock_monotonic_nanos())
    }

    /// Returns the span from this instant to now.
    ///
    /// Panics if the monotonic clock has stepped backward, which it is
    /// specified never to do.
    public func elapsed(&self) -> Duration {
        let ns = __saw_rt_clock_monotonic_nanos() - self.nanos
        if ns < (0 as Int64) {
            panic("Instant.elapsed: the monotonic clock stepped backward")
        }
        Duration.ns(ns as UInt64)
    }

    /// Returns the span from `earlier` to this instant.
    ///
    /// Panics if `earlier` is in fact the later of the two. A `Duration` is a
    /// magnitude with no negative values, so the argument order carries the
    /// meaning rather than the result reporting it.
    public func duration_since(&self, earlier: Instant) -> Duration {
        if self.nanos < earlier.nanos {
            panic("Instant.duration_since: `earlier` is later than this instant")
        }
        Duration.ns((self.nanos - earlier.nanos) as UInt64)
    }
}

// =============================================================================
// Wall-clock timestamp
// =============================================================================

/// Returns the seconds since the Unix epoch (1970-01-01T00:00:00Z).
///
/// This reads the realtime clock, which is settable and can step backward.
/// Timing anything belongs to `Instant`.
func unix_timestamp() -> Int64 {
    __saw_rt_unix_timestamp_secs()
}
