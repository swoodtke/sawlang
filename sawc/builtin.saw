// Saw Language Built-in Definitions
// This file is automatically included by the compiler.

// =============================================================================
// Resource Management Traits
// =============================================================================

// Deinit trait - called automatically when a value goes out of scope
trait Deinit {
    func deinit(&var self)
}

// Copy umbrella trait - "this type can be duplicated via copy()". Used mainly
// as a generic bound (`T: Copy`). Satisfied implicitly by trivially-copyable
// (POD) types, and by any type declaring ImplicitCopy or ExplicitCopy; the
// compiler checks satisfaction structurally, so types need not declare `: Copy`.
trait Copy {
    func copy(&self) -> Self
}

// ImplicitCopy trait - the compiler invokes copy() automatically at every
// transfer site. Contract: cheap, O(1)-ish (e.g. Rc refcount bump).
// Implementing ImplicitCopy requires also implementing Deinit.
trait ImplicitCopy: Deinit {
    func copy(&self) -> Self
}

// ExplicitCopy trait - the compiler NEVER invokes copy() automatically;
// transfer sites demand `move`, and duplication is always a visible v1.copy().
// Contract: may be expensive/deep (e.g. Vector, Map).
// Implementing ExplicitCopy requires also implementing Deinit.
// ImplicitCopy and ExplicitCopy are mutually exclusive on one type.
trait ExplicitCopy: Deinit {
    func copy(&self) -> Self
}

// NoCopy trait - marker for move-only types that cannot be copied
// Implementing NoCopy requires also implementing Deinit
trait NoCopy: Deinit {
    // Marker trait - no additional methods
}

// =============================================================================
// Thread-safety marker traits (design 21 item 1)
// =============================================================================

// Send - "a value of this type may be transferred to another task".
// Sync - "a &-reference to this type may be shared across tasks".
// Both are COMPILER-KNOWN and auto-derived STRUCTURALLY (the auto-Copy
// pattern): a struct/enum is Send/Sync iff all its fields/payloads are.
// Explicit conformance (`extension X: Send`) is rejected - derivation only.
// They are declared here purely so they are nameable as generic bounds
// (`T: Send`); the compiler never consults a registered conformance for them.
trait Send {
    // Marker trait - structurally derived, no methods
}

trait Sync {
    // Marker trait - structurally derived, no methods
}

// =============================================================================
// Iterator Support
// =============================================================================

// Iterator trait for for-loop support
trait Iterator {
    type Item
    func next(&var self) -> Item?
}

// Range struct for range expressions (start..end)
struct Range {
    current: Int
    end: Int
}

extension Range: Iterator {
    type Item = Int

    func next(&var self) -> Int? {
        if self.current < self.end {
            let result = self.current
            self.current = self.current + 1
            result
        } else {
            None
        }
    }
}
