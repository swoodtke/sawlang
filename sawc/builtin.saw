// Saw Language Built-in Definitions
// This file is automatically included by the compiler.

// =============================================================================
// Resource Management Traits
// =============================================================================

// Deinit trait - called automatically when a value goes out of scope
trait Deinit {
    func deinit(&var self)
}

// Copy - THE silently-copyable tier (design 219). A `Copy` value is duplicated
// by the compiler at every transfer with nothing written at the site. It is
// DERIVED, not declared: trivially-copyable (POD) types are Copy, and so is any
// struct or enum whose owning members are all Copy — the automatic tier, which
// owes no declaration and is not asked for one. Whether a given type duplicates
// bitwise or by retaining a refcount is an emission detail; nothing above
// codegen distinguishes the two.
//
// A DECLARED conformance has two forms, both meaningful:
//
//   @synthesize
//   extension Point: Copy {}          // an ASSERTION: compiles iff the members
//                                     // qualify, and keeps compiling only while
//                                     // they do — a type-level API contract.
//                                     // The `@synthesize` marker is design 128's
//                                     // standing gate on every derived body.
//
//   extension Arc<T>: Copy {          // THE RETAIN HOOK: the compiler calls this
//       func copy(&self) -> Self {    // body at every silent transfer
//           ...atomic increment...
//       }
//   }
//
// The hook is the mechanism `Arc` and `Channel` are built on, in ordinary Saw
// rather than compiler magic, and it is what lets a user write their own
// Arc-alike. It is also a PERFORMANCE FOOTGUN worth stating plainly: the body
// runs at transfer sites no source construct names, so a heavy one costs on
// every silent copy. Cheap and infallible is the expected shape. The one part
// of that contract the compiler enforces is `sync` (design 219 A1) — a
// suspending `copy()` is refused at the conformance, because its suspension
// would otherwise be invisible at every site the compiler inserts it.
trait Copy {
    func copy(&self) -> Self
}

// ExplicitCopy - "this value can be duplicated, and the duplicate is SPELLED".
// An ordinary trait, and since design 219 no longer a tier: a type declaring it
// and nothing else is move-only, so every transfer needs `move` and every
// duplicate a visible `.copy()`. Contract: may be expensive or deep (Vector,
// Map). `@synthesize extension T: ExplicitCopy {}` derives the memberwise body.
//
// Every `Copy` type satisfies it — copying one for free is a valid way to
// answer `copy()` — so `<T: ExplicitCopy>` reads as "duplicable, possibly with
// ceremony" and is the bound that licenses a spelled `.copy()` on an abstract
// `T`. `<T: Copy>` is the stricter one: it admits only what duplicates
// silently.
trait ExplicitCopy: Deinit {
    func copy(&self) -> Self
}

// NoCopy trait - marker for move-only types that cannot be copied
// Conforming to NoCopy requires conforming to Deinit too
trait NoCopy: Deinit {
    // Marker trait - no additional methods
}

// NoMove trait (design 188) - marker for a type that is PINNED to the binding
// its constructor built it in. DUPLICATION and RELOCATION are separate axes:
// this one governs relocation only, and it does not imply NoCopy — it REQUIRES
// it, so a type states both properties out loud (`extension T: NoCopy {}` plus
// `extension T: NoMove {}`). Declaring it on anything but a declared-NoCopy
// type is a compile error.
//
// A NoMove value moves exactly once, from its constructor into its binding, and
// never again: `move x`, `Optional.take` of a NoMove payload and every other
// transfer position are refused. Whole-referent replacement through `&var`
// stays legal — that is destruction then construction at one address, not a
// relocation. A struct or enum with a NoMove member must declare NoMove (and
// NoCopy) itself; the cascade is DECLARED, never inherited silently.
//
// Not a generic bound, and there is no Pin/projection machinery: v1 is the
// strict point, which `NoMove + ExplicitCopy` can be relaxed toward later with
// no migration.
trait NoMove {
    // Marker trait - no additional methods
}

// =============================================================================
// Equality (design 32)
// =============================================================================

// Equatable trait - gates `==` / `!=`. `a == b` on a conforming user type
// compares via this contract (`equals`); primitives keep direct icmp/fcmp
// codegen. Trivial (POD) structs and payload-free enums auto-conform (the same
// set that auto-conforms to Copy); everything else opts in with
// `extension T: Equatable {}` (an empty body synthesizes a memberwise `==` for
// structs and a payload-deep `==` for enums; a hand-written `equals` overrides
// the synthesis). Resource types (File, Mutex, ...) never conform. `!=` is the
// negation of `==`; Float keeps IEEE semantics (NaN != NaN).
trait Equatable {
    func equals(&self, other: Self) -> Bool
}

// =============================================================================
// Ordering + Comparable (design 48)
// =============================================================================

// Ordering is the three-way result of a comparison. Its variants are declared
// in the order Less, Equal, Greater so their tags are 0, 1, 2 — the codegen for
// the `< <= > >=` desugar relies on this ordering (a tag < the Equal tag means
// "less", a tag > it means "greater").
enum Ordering {
    case Less,
    case Equal,
    case Greater
}

// Comparable gates the ordering operators `< <= > >=`, which desugar to a call
// to `compare` (design 48). Comparable REQUIRES Equatable: a type must already
// conform to Equatable (auto or opt-in) before it can be Comparable, so
// `a == b` and `a.compare(b) == .Equal` agree. Integer types, Float (IEEE; NaN
// is unordered, so every ordering operator involving a NaN is false, exactly
// like the primitive fcmp), and String (byte-lexicographic = code-point order)
// conform builtin. There is NO auto-conformance for user types — field order is
// a semantic choice — so a struct/enum opts in with an empty
// `extension T: Comparable {}`, which synthesizes a lexicographic
// field-order / payload-order compare; a hand-written `compare` overrides it.
trait Comparable {
    func compare(&self, other: Self) -> Ordering
}

// =============================================================================
// Hasher + Hashable (design 48)
// =============================================================================

// Hasher is the streaming hash accumulator (FNV-1a, 64-bit). A `hash`
// implementation feeds its fields into a Hasher via `write_int`; the map reads
// the digest with `finish`. The state is a FIXED-WIDTH `Int64`, NOT the platform
// `Int`: the hash is 64-bit by design (design 48) and the codegen FNV lowering
// is hardcoded i64, so a platform-`Int` state would (a) overflow the 32-bit word
// on riscv32 — the offset basis and FNV prime don't fit i32, erroring at the
// literal (design 47) — and (b) mismatch the i64 lowering. Using `Int64` (with
// design-53 `i64` literal suffixes) makes the constants and math 64-bit on EVERY
// target while staying byte-identical on hosted (where `Int` is already i64, and
// signed `Int64 >> 32` is the same arithmetic shift the platform-`Int` state
// used). The initial state is the FNV-1a offset basis, written as its unsigned
// value `14695981039346656037i64` (an `i64` literal takes any 0..2^64-1 bit
// pattern, here the two's-complement i64 -3750763034362895579 the platform-`Int`
// state used before); `write_int` XORs the
// input into the state then multiplies by the FNV prime 1099511628211 with
// wrapping arithmetic. `finish` folds the high half into the low bits so a
// power-of-two bucket mask still sees well-mixed bits, then narrows to `Int`.
struct Hasher {
    state: Int64
}

extension Hasher {
    public init() -> Hasher {
        Hasher(state: 14695981039346656037i64)
    }

    // FNV-1a step over one Int of input. Uses wrapping multiply (`&*`) because
    // the FNV prime overflows 64 bits by construction and the wrap is intended.
    // `n` is a platform `Int`, widened to the 64-bit hash state.
    public func write_int(&var self, n: Int) {
        self.state = (self.state ^ (n as Int64)) &* 1099511628211i64
    }

    // The finished 64-bit digest, with a final xor-shift avalanche so the low
    // bits (used by a power-of-two bucket mask) depend on the whole state, then
    // narrowed to the platform `Int` the map indexes with. The narrowing is a
    // deliberate wrap (design 170): a digest is a BIT PATTERN, so on a 32-bit
    // target keeping the low half is the operation, not an error — a checked
    // `as` there would panic on almost every key.
    public func finish(&self) -> Int {
        let h = self.state
        Int.from(truncating: h ^ (h >> 32i64))
    }
}

// Hashable gates use as a hash-map key. It REQUIRES Equatable (the hash/==
// contract: `a == b` implies `a` and `b` hash identically — synthesis streams
// exactly the fields `==` compares, so it holds for auto and synthesized
// conformers alike; a hand-written `hash` must uphold it). Conformance mirrors
// Equatable's gating exactly: trivial (POD) structs and payload-free enums
// auto-conform; everything else opts in with an empty `extension T: Hashable {}`
// (which streams each field / active payload); primitives and String conform
// builtin. `hash` feeds `self` into the streaming `h`.
trait Hashable {
    func hash(&self, h: &var Hasher)
}

// =============================================================================
// Printable (design 56)
// =============================================================================

// Printable is the streaming-formatter trait (design 56, prelude-visible like
// Equatable/Comparable). The core method `format` appends the value's rendering
// into a shared `StringBuilder` (no intermediate Strings); `to_string` rides on
// it as a default method body (design 56 N1). A user type conforms by hand
// (NO auto-conformance / synthesis — that is the deferred Debug design's job):
//
//     extension Point: Printable {
//         func format(&self, into: &var StringBuilder) {
//             into.append("(")
//             into.append(self.x)
//             into.append(", ")
//             into.append(self.y)
//             into.append(")")
//         }
//     }
//
// Int/UInt + the fixed-width integer types, Float, Bool, and String conform
// BUILTIN (the compiler emits `format`/`to_string` inline; string interpolation
// and `print` keep their existing byte-identical fast paths for these). A
// non-Printable type used in `"{...}"` interpolation is a clean compile error.
trait Printable {
    func format(&self, into: &var StringBuilder)

    func to_string(&self) -> String {
        var b = StringBuilder()
        self.format(into: &var b)
        b.build()
    }
}

// =============================================================================
// Error (design 56) — an error type is a Printable value
// =============================================================================

// Error refines Printable: any error type renders itself via `format`, so
// `"{error}"` works uniformly and `Result<T, Box<any Error>>` can carry an
// erased error whose message is recoverable through the vtable. Both conformance
// spellings are legal: a one-shot `extension E: Error { func format(...) {...} }`
// (Error inherits format from Printable), or a split `extension E: Printable
// {...}` + an empty `extension E: Error {}`.
trait Error: Printable {
}

// =============================================================================
// Thread-safety marker traits (design 21 item 1)
// =============================================================================

// Send - "a value of this type may MOVE to another task or thread".
//
// Sync - "this type's `&self` surface is safe under true parallelism: more than
// one thread may hold shared access at once".
//
// Saw has no shared references in flight, so Sync is not about `&` travelling:
// a plain `&` never crosses a spawn, and a single-threaded group never consults
// Sync at all. It is consulted where handles and statics CREATE parallel shared
// access — an `Arc` copy sent across a spawn in a `threads: N` group (which is
// why `Arc<T: Send + Sync>` demands it), a lock (`Mutex` and `SpinLock` are Sync
// BECAUSE they serialize), and a `static`, which every thread can reach (the
// `unsafe static var` exemption is the escape hatch that proves the rule).
//
// INTERIOR MUTABILITY is what makes the two separate axes. A struct with an
// `Atomic` field mutates safely through `&self`, so it is Send AND Sync. A
// struct wrapping a non-atomic interior cell moves harmlessly to another thread
// (Send) but would race under two threads' shared access (not Sync). Send
// cannot tell those apart; Sync is the record of exactly that difference.
//
// Both are COMPILER-KNOWN and auto-derived STRUCTURALLY (the auto-Copy
// pattern): a struct/enum is Send/Sync iff all its fields/payloads are.
// Explicit conformance (`extension X: Send`) is rejected - derivation only;
// `UnsafeSend`/`UnsafeSync` below are how a type asserts what the compiler
// cannot see. They are declared here purely so they are nameable as generic
// bounds (`T: Send`); the compiler never consults a registered conformance.
trait Send {
    // Marker trait - structurally derived, no methods
}

trait Sync {
    // Marker trait - structurally derived, no methods
}

// UnsafeSync / UnsafeSend (design 186) — the THREAD-SAFETY ASSERTION.
//
// `Send`/`Sync` stay derivation-only. The assertion that a type is thread-safe
// for reasons the compiler cannot see gets its own two names, and refining the
// marker traits is what makes a declared conformance satisfy every `T: Send` /
// `T: Sync` bound through the parent while generic code keeps its vocabulary.
// The `Unsafe` prefix carries the claim per design 130's idiom: the conformance
// header IS the audited, greppable assertion, and it replaced every "Sync by
// fiat" comment the compiler used to keep as a list of names.
//
//     extension Mutex<T: Send>: UnsafeSync {}
//
// LEGALITY, checked at the declaration: one is declarable only where the
// STRUCTURAL derivation failed, and only when every field that blocked it is
// UNSAFE-TYPED (an interior cell, an `UnsafePointer`, an `UnsafeMemory`). You
// may hand-assert exactly what the unsafe domain already owns — never past a
// SAFE non-Sync field, which would be a claim about someone else's invariants.
// Conditional headers are supported and are half the point.
//
// THREE FENCES. These appear in exactly one position, the conformance header:
// `T: UnsafeSync` as a BOUND and `any UnsafeSync` as an EXISTENTIAL are both
// clean errors pointing at `Sync`/`Send` (generic code asks for the property,
// never for the assertion). They are two BUILTIN traits, not a user-definable
// unsafe-trait feature — design 130's `Unsafe*` name enforcement is about
// STRUCTS and does not extend to trait declarations. And the design-142 orphan
// rule applies unchanged, so the assertion lives with the type or with the
// trait, never in a third module that merely uses both.
trait UnsafeSync: Sync {
    // Marker trait - declared, never derived, no methods
}

trait UnsafeSend: Send {
    // Marker trait - declared, never derived, no methods
}

// =============================================================================
// UnsafeMutableInterior<T> — the interior-mutability cell (design 186)
// =============================================================================

// The one primitive that makes MUTATION THROUGH A SHARED BORROW expressible by
// a type the compiler has never heard of. A cell holds an inline `T` and hands
// out its ADDRESS:
//
//     unsafe struct UnsafeMutableInterior<T>       // holds a T, inline
//     func ptr(&self) unsafe -> UnsafePointer<T>   // the only accessor
//
// That signature is the whole safety story. By design 130 every function
// touching a cell is dragged into the declared-unsafe domain with no new effect
// rules, and a safe public wrapper method takes on the all-safe-parameters
// soundness obligation exactly where `SpinLock.lock` already does.
//
// Carrying one — transitively — makes a type CELL-CARRYING, which is what the
// compiler consults instead of a list of names it knows: a cell-carrying
// receiver always travels BY POINTER (so `&self` reaches the caller's storage
// rather than a copy), a cell-carrying `static` never lands in a read-only
// segment, and structural `Sync` derivation is BLOCKED (a cell-carrying type is
// not `Sync` unless it declares `UnsafeSync`). `Send` stays structural: a cell
// moves fine, it is SHARING that needs an argument.
//
// Construction is positional (`UnsafeMutableInterior(v)`) and the cell is
// LAYOUT-TRANSPARENT — it occupies exactly its `T`, so a cell field costs no
// wrapper. Construction and `ptr()` are both intercepted by the compiler; the
// `value` field below is the representation and is never accessed at the source
// level.
//
// `NoCopy`, because a copied cell is a SECOND cell: the copy has its own
// storage, so a write through one is invisible through the other. A cell FIELD
// contributes its `T`'s copy class to its container rather than forcing
// `NoCopy` onto it — the container states its own policy, so `let c =
// self.inner` on a cell stays refused while a wrapper over a cell of a plain
// word copies for free until its author says otherwise. A wrapper that wants to
// be move-only says so (`extension Cell<T>: NoCopy {}`), exactly as any other
// wrapper does — which is what `Atomic` does one section down (design 202).
unsafe struct UnsafeMutableInterior<T> {
    value: T
}

extension UnsafeMutableInterior<T>: NoCopy {}

// =============================================================================
// Atomic<Int> — minimal interior-synchronized primitive (design 41 item 4)
// =============================================================================

// Atomic<T> is a compiler-known interior-mutable primitive (v1: Atomic<Int>).
// It is the sanctioned way to mutate global state: `static N: Atomic<Int> =
// Atomic(0)` then `N.fetch_add(1)`. Construction (`Atomic(<int>)`) and the four
// methods below are lowered directly to seq_cst LLVM atomics by codegen; the
// bodies here exist only so the methods type-check — they are never called,
// every call site is intercepted, and a body that somehow ran would be a
// compiler bug rather than a wrong answer, which is what the panics say. All
// methods take `&self` (a shared borrow): the mutation is interior, which
// is exactly what lets an immutable static be updated.
//
// design 186: the interior mutability is a real CELL now rather than a name the
// compiler checked for. `Atomic<T>` is cell-carrying because it HOLDS one, on
// the same terms as any type a user writes; what stays compiler-known is the
// ATOMICITY, which no library can express. The cell is layout-transparent, so
// `Atomic<Int>` is still exactly one word. Its `Sync` is declared below rather
// than derived, since a cell-carrying type is not `Sync` by derivation.
struct Atomic<T> {
    value: UnsafeMutableInterior<T>
}

extension Atomic<T> {
    // Atomic load (seq_cst). Returns the current value.
    public func load(&self) -> T { panic("Atomic.load: not intercepted") }
    // Atomic store (seq_cst) of `v`.
    public func store(&self, v: T) { }
    // Atomic read-modify-write add (seq_cst). Returns the PREVIOUS value.
    public func fetch_add(&self, v: T) -> T { panic("Atomic.fetch_add: not intercepted") }
    // Atomic compare-and-swap (seq_cst). Sets value to `desired` iff it currently
    // equals `expected`; returns whether the swap happened.
    public func compare_exchange(&self, expected: T, desired: T) -> Bool { true }
}

// The assertion that used to be a comment. `Atomic<T>` is cell-carrying, so it
// derives no `Sync`; what makes sharing one safe is that every operation on it
// is a seq_cst instruction, which is a fact about the codegen and not about the
// fields. `Send` still derives structurally — a cell moves fine.
extension Atomic<T>: UnsafeSync {}

// MOVE-ONLY (design 202). A copied atomic is a SECOND counter: the copy has its
// own word, so a `fetch_add` through one is invisible through the other and the
// program that meant to count once counts twice, silently. Rust says the same
// thing about `AtomicUsize`, and this is the declaration the cell clause above
// leaves to each wrapper's author — `Atomic` is a wrapper over a cell, and it
// wants to be move-only.
//
// `NoCopy` and deliberately NOT `NoMove`: nothing pins an atomic's address. The
// one word the runtime waits on is reached through a `static`, and a static is
// unaffected by either marker, so the global-counter idiom design 41 introduced
// (`static N: Atomic<Int> = Atomic(0)`, then `N.fetch_add(1)`) is exactly as it
// was. What changes is that `let b = a` and a struct holding an `Atomic` field
// with no declared policy are now errors, the second naming the field.
extension Atomic<T>: NoCopy {}

// =============================================================================
// UnsafeMemory<T, Use> — typed memory at a fixed address (design 46)
// =============================================================================

// UnsafeMemory<T, Use> is a compiler-known one-word wrapper over a fixed
// machine address (`static UART1: UnsafeMemory<UartRegs, Device> =
// UnsafeMemory(0x18003000)`). The `Use` parameter is an INTENT MARKER,
// EXPLICIT ALWAYS (no default): the compiler derives the access discipline
// from it.
//   - `Device` (register blocks): accesses lower to VOLATILE loads/stores;
//     `read()`/`write(v)` on scalar-typed views ONLY (no whole-struct access —
//     multi-register access is never atomic and reads have side effects).
//   - `Normal` (bootstrap / DMA-visible RAM): plain loads/stores; whole-struct
//     and element access allowed; region accessors `ptr()`/`len()`/`end()`.
// Member/index access PROJECTS to `UnsafeMemory<Field, Use>` at base +
// compile-time offset (no memory is ever touched). Construction, projection,
// and every accessor are intercepted by the compiler; the `addr` field below is
// the one-word representation and is never accessed at the source level.
// Sync by fiat (the Atomic precedent) — statics of this type are shared across
// all tasks. Volatile is NOT atomic (documented).
// An UNSAFE type (design 130): naming, binding, receiving or returning one makes
// a function `unsafe`. Its name already carries the required `Unsafe` prefix.
unsafe struct UnsafeMemory<T, Use> {
    addr: Int
}

// Intent markers (phantom — carried only in the `Use` type parameter).
struct Device {}
struct Normal {}

// Layout-transparent field markers gating which accessor a Device projection
// exposes: `ReadOnly<T>` fields expose `read()` only, `WriteOnly<T>` expose
// `write()` only, a plain field is read-write. A field of type `ReadOnly<T>` /
// `WriteOnly<T>` lays out IDENTICALLY to `T` (the marker adds no storage).
struct ReadOnly<T> {
    value: T
}
struct WriteOnly<T> {
    value: T
}

// =============================================================================
// FuncPointer<F> — a typed function pointer (design 226)
// =============================================================================

// One word: the ADDRESS of compiled code whose signature is `F`. It is what an
// entry point and a C callback need, and it is deliberately NOT first-class
// functions — a `FuncPointer` has no environment, so it captures nothing,
// allocates nothing, and is exactly a C function pointer at the ABI.
//
// `F` is a function TYPE and it must be `sync`. A suspending body runs out of a
// frame and a bare address has nowhere to keep one, so a suspending `F` is a
// clean error at the type — checked wherever a `FuncPointer<...>` is written.
//
// A SAFE type. Construction is CLOSED: a zero-capture closure literal COERCES
// in `FuncPointer`-expected position, and a named, non-generic function may be
// written there. Every inhabitant is therefore verified code of signature `F`,
// and code is immortal, so no inhabitant can dangle — possession and the
// indirect CALL are sound for every input (design 130's rule 7), which is why
// an API receiving one owes no `unsafe` declaration. `from_raw` is the one
// member that forges an inhabitant out of an address nothing verified, and it
// is `unsafe` for the ordinary reason: its parameter names a raw pointer.
//
// Copy tier and thread safety both fall out of the one-word `addr` field below
// with nothing declared: a code address is bitwise-copyable, so the type is
// trivial, and `Send`/`Sync` derive structurally. Construction, the call and
// `from_raw` are intercepted by the compiler; `addr` is the representation and
// is never accessed at the source level.
struct FuncPointer<F> {
    addr: Int
}

extension FuncPointer<F> {
    /// The function at `addr`, taken on faith to have signature `F`.
    ///
    /// For a C callback arriving through FFI, and for a loader reading an entry
    /// PC out of an image — the two places an address exists before any
    /// compiler has seen the code behind it. Calling the result runs whatever
    /// is there under `F`'s ABI, so the caller owes the promise that the
    /// address really is such a function.
    public static func from_raw(addr: UnsafePointer<UInt8>) unsafe -> FuncPointer<F> {
        panic("FuncPointer.from_raw: not intercepted")
    }
}

// The cooperative-task protocol — `Poll` and `Resumable` — lives in
// `std/compiler/frame.saw` since design 218 unit 1. It is the frame
// vocabulary, published beside `Slot` and `UnsafeRef` so that the signature a
// synthesized frame conforms to is one a reader can spell, types included.

// =============================================================================
// Iterator Support
// =============================================================================

// Iterator trait for for-loop support
trait Iterator {
    type Item
    func next(&var self) -> Item?
}

// Range struct for range expressions (start..end)
struct Range {
    public current: Int
    public end: Int
}

extension Range: Iterator {
    type Item = Int

    public func next(&var self) -> Int? {
        if self.current < self.end {
            let result = self.current
            self.current = self.current + 1
            result
        } else {
            None
        }
    }
}

// RangeInclusive struct for inclusive range expressions (start..=end), design
// 53. A dedicated iterator with a `done` flag — NOT a `start..(end + 1)`
// desugar — so `0..=Int.max` yields Int.max and then stops without ever
// incrementing past it (no phantom overflow panic). Empty when start > end.
struct RangeInclusive {
    public current: Int
    public last: Int
    public done: Bool
}

extension RangeInclusive: Iterator {
    type Item = Int

    public func next(&var self) -> Int? {
        if self.done {
            None
        } else if self.current < self.last {
            let result = self.current
            self.current = self.current + 1
            result
        } else if self.current == self.last {
            // Final element: yield it and latch `done` so we never increment
            // past `last` (the Int.max-safe step).
            self.done = true
            self.current
        } else {
            // start > end: an empty inclusive range.
            self.done = true
            None
        }
    }
}
